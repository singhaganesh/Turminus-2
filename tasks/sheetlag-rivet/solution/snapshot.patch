+static void sync_emit_sheet_from_ledger(void) {
+    FILE *f = fopen("/app/rivetbay/intake/current.ledger", "r");
+    char line[1024];
+    size_t used = 0;
+    g_emit[0] = 0;
+    if (!f) return;
+    while (fgets(line, sizeof(line), f)) {
+        char *s = line;
+        while (*s == ' ' || *s == '\t') s++;
+        if (*s == 0 || *s == '\n') continue;
+        size_t L = strlen(s);
+        if (used + L + 1 >= sizeof(g_emit)) break;
+        memcpy(g_emit + used, s, L);
+        used += L;
+        if (g_emit[used - 1] != '\n') {
+            g_emit[used++] = '\n';
+            g_emit[used] = 0;
+        }
+    }
+    fclose(f);
+}
