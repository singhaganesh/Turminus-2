--- a/environment/trim.go	2026-09-18 17:02:28.493638507 +0530
+++ b/environment/trim.go	2026-09-18 17:02:36.193603941 +0530
@@ -1,8 +1,41 @@
 package main
 
+func sisterOf(name string) string {
+	switch name {
+	case "A1":
+		return "A2"
+	case "A2":
+		return "A1"
+	case "B1":
+		return "B2"
+	case "B2":
+		return "B1"
+	default:
+		return ""
+	}
+}
+
 func trimFits(lane Lane, fill map[string]*occ, extra int) bool {
-	_ = lane
-	_ = fill
-	_ = extra
-	return true
+	sibName := sisterOf(lane.Name)
+	mine := fill[lane.Name]
+	sib := fill[sibName]
+	sibHas := sib != nil && sib.has
+	myHas := mine != nil && mine.has
+	if !sibHas {
+		return true
+	}
+	if !myHas {
+		return true
+	}
+	myMass := 0
+	if mine != nil {
+		myMass = mine.mass
+	}
+	sibMass := sib.mass
+	next := myMass + extra
+	diff := next - sibMass
+	if diff < 0 {
+		diff = -diff
+	}
+	return diff <= 3000
 }
