[131.266323, "o", ">     }\r\n"]
[131.266362, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[131.266611, "o", "    let conf = conf.ok_or(1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     if logs.is_empty() { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.266697, "o", "    let map = kv::pairs(&conf);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.26687, "o", "    let t = map.get(\"timezone\").cloned().ok_or(1)?;\r\n\u001b[?2004l\r"]
[131.266964, "o", "\u001b[?2004h> "]
[131.267046, "o", "    let c = map.get(\"cluster\").cloned().ok_or(1)?;\r\n\u001b[?2004l\r"]
[131.267129, "o", "\u001b[?2004h> "]
[131.267256, "o", "    let mut e = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.267357, "o", "    for blob in logs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.267539, "o", "        for line in String::from_utf8_lossy(&blob).lines() {\r\n\u001b[?2004l\r"]
[131.267637, "o", "\u001b[?2004h> "]
[131.26774, "o", "            let value = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.267954, "o", "            if !value.is_empty() { e.push(value.to_string()); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.268065, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[131.2682, "o", "\u001b[?2004h> "]
[131.268434, "o", "    e.sort();\r\n\u001b[?2004l\r\u001b[?2004h>     e.dedup();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.268758, "o", "    let source = std::path::Path::new(a).file_name()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.269079, "o", "        .and_then(|x| x.to_str()).ok_or(1)?.to_string();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.269601, "o", "    let w = digest(&names.join(\"\\n\"))?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.269847, "o", "    Ok(Pack { t, c, e, n: names.len() as u32, s: source, w })\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[131.272111, "o", "\u001b[?2004hroot@bf9871f56849:/app# "]
[131.458673, "i", "cat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"]\nmod blend;\n#[path = \"../logbag/write.rs\"]\nmod uni;\n#[path = \"../ustarwalk/hdr.rs\"]\nmod hdr;\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    let archive = match std::fs::canonicalize(a) {\n        Ok(p) => p,\n        Err(_) => return 1,\n    };\n    let sealwell = match std::fs::canonicalize(\"/app/sealwell\") {\n        Ok(p) => p,\n        Err(_) => return 1,\n    };\n    if !archive.starts_with(&sealwell) || !archive.is_file() { return 1; }\n    let archive_text = match archive.to_str() { Some(x) => x, None => return 1 };\n    if hdr::scan(archive_text).is_err() { return 1; }\n    match blend::rib_b(archive_text, b) {\n        Ok(p) => uni::rib_c(&p, out, archive_text),\n        Err(c) => c,\n    }\n}\nRS\npython3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read()\ns=s.replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")', 'std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\nhead -c 4 /app/bin/siltcord | od -An -tx1\n"]
