[131.110711, "o", "        if nb.len() > u16::MAX as usize { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.110776, "o", "> "]
[131.110915, "o", "        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.110956, "o", "> "]
[131.111097, "o", "        out.extend_from_slice(nb);\r\n\u001b[?2004l\r\u001b[?2004h> "]
