[29.735954, "o", "length 8192\r\nheader 0 name= b'etc/sys.conf' magic= b'ustar\\x00' type= b'0' sizefield= b'00000000041\\x00'\r\n payload b'timezone=Etc/UTC\\ncluster=staging\\n'\r\nheader 1024 name= b'var/log/app.log' magic= b'ustar\\x00' type= b'0' sizefield= b'00000000011\\x00'\r\n payload b'EVT_BOOT\\n'\r\nheader 2048 name= b'PaxHeaders/sys' magic= b'ustar\\x00' type= b'x' sizefield= b'00000000027\\x00'\r\n payload b'25 path=./etc/sys.conf\\n'\r\nheader 3072 name= b'./etc/sys.conf' magic= b'ustar\\x00' type= b'0' sizefield= b'00000000047\\x00'\r\n payload b'timezone=America/Chicago\\ncluster=alpha\\n'\r\nheader 4096 name= b'var/log/app.log' magic= b'ustar\\x00' type= b'0' sizefield= b'00000000013\\x00'\r\n payload b'EVT_RELOAD\\n'\r\nheader 5120 name= b'etc/hosts' magic= b'ustar\\x00' type= b'0' sizefield= b'00000000024\\x00'\r\n payload b'127.0.0.1 localhost\\n'\r\nheader 6144 name= b'opt/app/build.id' magic= b'ustar\\x00' type= b'0' sizefield= b'00000000006\\x00'\r\n payload b'rel-9\\n'\r\nzero block at 7168\r\n"]
