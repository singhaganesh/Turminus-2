[135.551154, "i", "set +e\ncp /app/sealwell/kestrel.kith /tmp/kestrel.kith\n/app/bin/siltcord brief /app/deskjson/outside.json /tmp/kestrel.kith /app/idxbay/members.idx; echo outside_rc=$? ready=$([ -e /app/deskjson/READY ] && echo yes || echo no)\nprintf 'not-an-archive' >/tmp/bad.kith\n/app/bin/siltcord quarry /tmp/bad.kith /tmp/bad.idx; echo nonustar_rc=$? ready=$([ -e /app/deskjson/READY ] && echo yes || echo no)\nhead -c 600 /app/sealwell/kestrel.kith >/tmp/truncated.kith\n/app/bin/siltcord quarry /tmp/truncated.kith /tmp/truncated.idx; echo truncated_rc=$? ready=$([ -e /app/deskjson/READY ] && echo yes || echo no)\n/app/bin/siltcord quarry; echo final_quarry_rc=$?\n/app/bin/siltcord brief /app/deskjson/pass-a.json; echo final_brief_rc=$?\nprintf 'final_READY='; cat /app/deskjson/READY; echo\n"]
