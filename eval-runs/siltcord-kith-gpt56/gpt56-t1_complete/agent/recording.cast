[168.881009, "i", "set -e\n/app/bin/siltcord quarry\n/app/bin/siltcord brief /app/deskjson/pass-a.json\n/app/bin/siltcord brief /app/deskjson/pass-b.json\ncmp /app/deskjson/pass-a.json /app/deskjson/pass-b.json\npython3 - <<'PY'\nimport hashlib, json\nexpected = {\n    'timezone': 'Etc/UTC',\n    'cluster': 'staging',\n    'log_events': ['EVT_BOOT'],\n    'member_count': 2,\n    'source_kith': 'kestrel.kith',\n    'walk_sig': hashlib.sha256(b'etc/sys.conf\\nvar/log/app.log').hexdigest(),\n}\nassert json.load(open('/app/deskjson/pass-a.json')) == expected\nassert open('/app/deskjson/READY', 'rb').read() == b'brief-ok'\nassert open('/app/bin/siltcord', 'rb').read(4) == b'\\x7fELF'\nprint('all final assertions passed')\nPY\n"]
