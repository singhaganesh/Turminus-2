[131.111591, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[131.112977, "o", "\u001b[?2004hroot@bf9871f56849:/app# "]
[131.252114, "i", "cat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, hdr: u64, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?);\n    let mut i = 9usize;\n    let mut out = Vec::new();\n    for _ in 0..n {\n        if i.checked_add(26).filter(|e| *e <= raw.len()).is_none() { return Err(1); }\n        let hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        let end = i.checked_add(nl).ok_or(1)?;\n        if end > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..end]).map_err(|_| 1)?.to_string();\n        i = end;\n        out.push(Rec { name, hdr, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn load(raw: &[u8], body: u64, size: u64) -> Result<Vec<u8>, i32> {\n    let s = usize::try_from(body).map_err(|_| 1)?;\n    let n = usize::try_from(size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped())\n        .stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let out = child.wait_with_output().map_err(|_| 1)?;\n    if !out.status.success() { return Err(1); }\n    let s = std::str::from_utf8(&out.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) {\n        return Err(1);\n    }\n    Ok(s)\n}\n\n#[path = \"../cfgbag/kv.rs\"]\nmod kv;\n#[path = \"../cfgbag/alias.rs\"]\nmod alias;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let archive = std::fs::read(a).map_err(|_| 1)?;\n    let mut recs = read_idx(b)?;\n    recs.sort_by_key(|r| r.hdr);\n\n    // Apply the first regular payload for each supported normalized path.\n    let mut conf: Option<Vec<u8>> = None;\n    let mut logs: Vec<Vec<u8>> = Vec::new();\n    let mut seen_log = false;\n    let mut names = Vec::new();\n    for r in recs {\n        let name = alias::fold(&r.name);\n        if name == \"etc/sys.conf\" && conf.is_none() {\n            conf = Some(load(&archive, r.body, r.size)?);\n            names.push(name);\n        } else if name == \"var/log/app.log\" && !seen_log {\n            logs.push(load(&archive, r.body, r.size)?);\n            seen_log = true;\n            names.push(name);\n        }\n    }\n    let conf = conf.ok_or(1)?;\n    if logs.is_empty() { return Err(1); }\n    let map = kv::pairs(&conf);\n    let t = map.get(\"timezone\").cloned().ok_or(1)?;\n    let c = map.get(\"cluster\").cloned().ok_or(1)?;\n    let mut e = Vec::new();\n    for blob in logs {\n        for line in String::from_utf8_lossy(&blob).lines() {\n            let value = line.trim();\n            if !value.is_empty() { e.push(value.to_string()); }\n        }\n    }\n    e.sort();\n    e.dedup();\n    let source = std::path::Path::new(a).file_name()\n        .and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    let w = digest(&names.join(\"\\n\"))?;\n    Ok(Pack { t, c, e, n: names.len() as u32, s: source, w })\n}\nRS\n"]
[131.254135, "o", "cat > /app/overlaypit/blend.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> pub struct Pack {\r\n\u001b[?2004l\r\u001b[?2004h>     pub t: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub c: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub e: Vec<String>,\r\n\u001b[?2004l\r\u001b[?2004h>     pub n: u32,\r\n\u001b[?2004l\r\u001b[?2004h>     pub s: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub w: String,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
