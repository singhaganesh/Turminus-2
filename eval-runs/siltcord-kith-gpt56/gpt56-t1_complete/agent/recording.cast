[134.001402, "i", "set +e\nrm -f /app/deskjson/READY /app/deskjson/pass-a.json /app/deskjson/pass-b.json\nprintf xxxx > /app/idxbay/members.idx\n/app/bin/siltcord quarry; echo quarry_valid_rc=$?\n/app/bin/siltcord brief /app/deskjson/pass-a.json; echo brief_a_rc=$?\n/app/bin/siltcord brief /app/deskjson/pass-b.json; echo brief_b_rc=$?\ncat /app/deskjson/pass-a.json; cat /app/deskjson/pass-b.json\ncmp /app/deskjson/pass-a.json /app/deskjson/pass-b.json; echo pair_cmp_rc=$?\nprintf 'READY='; cat /app/deskjson/READY; echo\npython3 - <<'PY'\nimport json,hashlib\np=json.load(open('/app/deskjson/pass-a.json'))\nprint(p)\nprint('expected_sig',hashlib.sha256(b'etc/sys.conf\\nvar/log/app.log').hexdigest())\nassert p == {'timezone':'Etc/UTC','cluster':'staging','log_events':['EVT_BOOT'],'member_count':2,'source_kith':'kestrel.kith','walk_sig':hashlib.sha256(b'etc/sys.conf\\nvar/log/app.log').hexdigest()}\nassert open('/app/deskjson/READY','rb').read()==b'brief-ok'\nPY\n"]
