[131.106968, "o", "\u001b[?2004hroot@bf9871f56849:/app# "]
[131.107348, "o", "cat > /app/idxmill/shard.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.107553, "o", "use super::hdr;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../ustarwalk/block.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod walk;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.107732, "o", "\u001b[?2004h> pub fn rib_a(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r"]
[131.107887, "o", "\u001b[?2004h> "]
[131.108019, "o", "    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r"]
[131.108074, "o", "\u001b[?2004h> "]
[131.108239, "o", "    let mut rows = match hdr::scan(a) {\r\n\u001b[?2004l\r"]
[131.108311, "o", "\u001b[?2004h> "]
[131.108497, "o", "        Ok(x) => x,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(c) => return c,\r\n\u001b[?2004l\r"]
[131.108572, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[131.108653, "o", "\u001b[?2004h> "]
[131.108887, "o", "    rows.sort_by_key(|r| r.hdr);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.109004, "o", "    let regs: Vec<&hdr::Row> = rows.iter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.109171, "o", "        .filter(|r| r.flag == b'0' || r.flag == 0)\r\n\u001b[?2004l\r"]
[131.109228, "o", "\u001b[?2004h> "]
