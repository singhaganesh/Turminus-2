[43.159084, "i", "python3 - <<'PY'\nimport hashlib,itertools\nnames=['etc/sys.conf','./etc/sys.conf','var/log/app.log','etc/hosts','opt/app/build.id']\nfor n in range(1,4):\n for xs in itertools.permutations(names,n):\n  if n==2 or xs in [('etc/sys.conf','var/log/app.log')]:\n   s='\\n'.join(xs).encode()\n   print(repr(s.decode()),hashlib.sha256(s).hexdigest())\nPY\n"]
