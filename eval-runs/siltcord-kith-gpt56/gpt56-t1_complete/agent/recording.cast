[52.799561, "o", "     1\tpub struct Pack {\r\n     2\t    pub t: String,\r\n     3\t    pub c: String,\r\n     4\t    pub e: Vec<String>,\r\n     5\t    pub n: u32,\r\n     6\t    pub s: String,\r\n     7\t    pub w: String,\r\n     8\t}\r\n     9\t\r\n    10\tstruct Rec {\r\n    11"]
[52.799732, "o", "\t    name: String,\r\n    12\t    hdr: u64,\r\n    13\t    size: u64,\r\n    14\t    body: u64,\r\n    15\t}\r\n    16\t\r\n    17\tfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n    18\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    19\t    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" {\r\n    20\t        return Err(1);\r\n    21\t    }\r\n    22\t    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n    23\t    let mut i = 9usize;\r\n    24\t    let mut out = Vec::new();\r\n    25\t    for _ in 0..n {\r\n    26\t        if i + 26 > raw.len() {\r\n    27\t            return Err(1);\r\n    28\t        }\r\n    29\t        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    30\t        i += 8;\r\n    31\t        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    32\t        i += 8;\r\n    33\t        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    34\t        i += 8;\r\n    35\t        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;\r\n    36\t        i += 2;\r\n    37\t        if i + nl > raw.len() {\r\n    38\t            return Err(1);\r\n    39\t        }\r\n    40\t        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();\r\n    41\t        i += nl;\r\n    42\t        out.push(Rec {\r\n    43\t            name,\r\n    44\t            hdr,\r\n    45\t            size,\r\n    46\t            body,\r\n    47\t        });\r\n    48\t    }\r\n    49\t    Ok(out)\r\n    50\t}\r\n"]
[52.799762, "o", "    51\t\r\n    52\tfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\r\n    53\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    54\t    let s = body as usize;\r\n    55\t    let e = s + size as usize;\r\n    56\t    if e > raw.len() {\r\n    57\t        return Err(1);\r\n    58\t    }\r\n    59\t    Ok(raw[s..e].to_vec())\r\n    60\t}\r\n    61\t\r\n    62\tfn digest(text: &str) -> String {\r\n    63\t    let mut cmd = std::process::Command::new(\"python3\");\r\n    64\t    cmd.args([\r\n    65\t        \"-c\",\r\n    66\t        \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\",\r\n    67\t    ])\r\n    68\t    .stdin(std::process::Stdio::piped())\r\n    69\t    .stdout(std::process::Stdio::piped());\r\n    70\t    let mut child = match cmd.spawn() {\r\n    71\t        Ok(c) => c,\r\n"]
[52.799797, "o", "    72\t        Err(_) => return String::new(),\r\n    73\t    };\r\n    74\t    {\r\n    75\t        use std::io::Write;\r\n    76\t        if let Some(ref mut sin) = child.stdin {\r\n    77\t            let _ = sin.write_all(text.as_bytes());\r\n    78\t        }\r\n    79\t    }\r\n    80\t    drop(child.stdin.take());\r\n    81\t    match child.wait_with_output() {\r\n    82\t        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),\r\n"]
[52.799876, "o", "    83\t        Err(_) => String::new(),\r\n    84\t    }\r\n    85\t}\r\n    86\t\r\n    87\t#[path = \"../keeppit/first.rs\"]\r\n    88\tmod first;\r\n    89\t#[path = \"../cfgbag/kv.rs\"]\r\n    90\tmod kv;\r\n    91\t#[path = \"../cfgbag/alias.rs\"]\r\n    92\tmod alias;\r\n    93\t\r\n    94\tpub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    95\t    let recs = read_idx(b)?;\r\n    96\t    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    97\t    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    98\t    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    99\t    for (i, r) in recs.iter().enumerate() {\r\n   100\t        bag.insert(i, r.name.clone());\r\n   101\t        let blob = load(a, r.body, r.size)?;"]
[52.800044, "o", "\r\n   102\t        if r.name.contains(\"sys.conf\") {\r\n   103\t            confs.push((r.name.clone(), r.hdr, blob));\r\n   104\t        } else if r.name.contains(\"app.log\") {\r\n   105\t            logs.push(blob);\r\n"]
[52.800147, "o", "   106\t        }\r\n   107\t    }\r\n   108\t    confs.sort_by_key(|row| row.1);\r\n   109\t    let picked = first::keep_head(&confs);\r\n   110\t    let mut t = String::new();\r\n   111\t    let mut c = String::new();\r\n   112\t    if let Some(blob) = picked {\r\n   113\t        let map = kv::pairs(&blob);\r\n   114\t        if let Some(v) = map.get(\"timezone\") {\r\n   115\t            t = v.clone();\r\n   116\t        }\r\n   117\t        if let Some(v) = map.get(\"cluster\") {\r\n   118\t            c = v.clone();\r\n   119\t        }\r\n   120\t    }\r\n   121\t    let mut e = Vec::new();\r\n   122\t    if let Some(blob) = logs.first() {\r\n   123\t        for line in String::from_utf8_lossy(blob).lines() {\r\n   124\t            let s = line.trim();\r\n   125\t            if !s.is_empty() {\r\n   126\t                e.push(s.to_string());\r\n   127\t            }\r\n   128\t        }\r\n   129\t    }\r\n   130\t    e.sort();\r\n   131\t    e.dedup();\r\n   132\t    let names: Vec<String> = bag.values().cloned().collect();\r\n   133\t    let walk = names.join(\"\\n\");\r\n   134\t    let _ = alias::fold(\"\");\r\n   135\t    Ok(Pack {\r\n   136\t        t,\r\n   137\t        c,\r\n   138\t        e,\r\n   139\t        n: confs.len() as u32,\r\n   140\t        s: a.to_string(),\r\n"]
[52.800425, "o", "=== blend 141-280 ===\r\n"]
[52.804107, "o", "   141\t        w: digest(&walk).to_ascii_uppercase(),\r\n   142\t    })\r\n   143\t}\r\n"]
[52.804482, "o", "\u001b[?2004hroot@bf9871f56849:/app# "]
[52.967898, "i", "echo '=== writer ==='; nl -ba /app/logbag/write.rs; echo '=== slate ==='; nl -ba /app/siltcli/slate.rs\n"]
[52.968942, "o", "echo '=== writer ==='; nl -ba /app/logbag/write.rs; echo '=== slate ==='; nl -ba /app/siltcli/slate.rs\r\n\u001b[?2004l\r"]
[52.969092, "o", "=== writer ===\r\n"]
[52.971229, "o", "     1\tuse super::blend::Pack;\r\n     2\t\r\n     3\tfn json_escape(s: &str) -> String {\r\n     4\t    s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")\r\n     5\t}\r\n     6\t\r\n"]
[52.971475, "o", "     7\tpub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\r\n     8\t    if let Some(parent) = std::path::Path::new(out).parent() {\r\n     9\t        let _ = std::fs::create_dir_all(parent);\r\n    10\t    }\r\n    11\t    let ev: Vec<String> = p\r\n    12\t        .e\r\n    13\t        .iter()\r\n    14\t        .map(|x| format!(\"\\\"{}\\\"\", json_escape(x)))\r\n    15\t        .collect();\r\n    16\t    let body = format!(\r\n    17\t        \"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\r\n    18\t        json_escape(&p.t),\r\n    19\t        json_escape(&p.c),\r\n    20\t        ev.join(\",\"),\r\n    21\t        p.n,\r\n    22\t        json_escape(&p.s),\r\n    23\t        json_escape(&p.w)\r\n    24\t    );\r\n    25\t    if std::fs::write(out, body).is_err() {\r\n    26\t        return 1;\r\n    27\t    }\r\n    28\t    if std::fs::write(\"/app/deskjson/READY\", \"ok\\n\").is_err() {\r\n    29\t        return 1;\r\n    30\t    }\r\n    31\t    0\r\n    32\t}\r\n"]
[52.97166, "o", "=== slate ===\r\n"]
[52.974223, "o", "     1\t#[path = \"../overlaypit/blend.rs\"]\r\n     2\tmod blend;\r\n     3\t#[path = \"../logbag/write.rs\"]\r\n     4\tmod uni;\r\n     5\t\r\n     6\tpub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n     7\t    match blend::rib_b(a, b) {\r\n     8\t        Ok(p) => uni::rib_c(&p, out, a),\r\n     9\t        Err(c) => c,\r\n    10\t    }\r\n    11\t}\r\n"]
[52.974434, "o", "\u001b[?2004hroot@bf9871f56849:/app# "]
[131.09132, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// A parsed ustar member header.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let mut n = 0u64;\n    let mut digit = false;\n    let mut ended = false;\n    for &b in buf {\n        match b {\n            b'0'..=b'7' if !ended => {\n                digit = true;\n                n = n.checked_mul(8)\n                    .and_then(|v| v.checked_add(u64::from(b - b'0')))\n                    .ok_or(1)?;\n            }\n            0 | b' ' => {\n                if digit { ended = true; }\n            }\n            _ => return Err(1),\n        }\n    }\n    if digit { Ok(n) } else { Err(1) }\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 {\n        return Err(1);\n    }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off + 512];\n        if blk.iter().all(|b| *b == 0) {\n            // A ustar stream terminates with at least two zero blocks, and\n            // everything following the first terminator must also be zero.\n            if off + 1024 > raw.len() || raw[off..].iter().any(|b| *b != 0) {\n                return Err(1);\n            }\n            ended = true;\n            break;\n        }\n        if &blk[257..262] != b\"ustar\" {\n            return Err(1);\n        }\n        let nlen = blk[0..100].iter().position(|b| *b == 0).unwrap_or(100);\n        if nlen == 0 {\n            return Err(1);\n        }\n        let name = std::str::from_utf8(&blk[0..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = (off as u64)\n            .checked_add(512).and_then(|v| v.checked_add(padded)).ok_or(1)?;\n        if next > raw.len() as u64 {\n            return Err(1);\n        }\n        rows.push(Row {\n            name,\n            hdr: off as u64,\n            size,\n            body: (off + 512) as u64,\n            flag: blk[156],\n        });\n        off = next as usize;\n    }\n    if rows.is_empty() || !ended { Err(1) } else { Ok(rows) }\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let n = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\n#[path = \"../ustarwalk/block.rs\"]\nmod walk;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    let mut rows = match hdr::scan(a) {\n        Ok(x) => x,\n        Err(c) => return c,\n    };\n    rows.sort_by_key(|r| r.hdr);\n    let regs: Vec<&hdr::Row> = rows.iter()\n        .filter(|r| r.flag == b'0' || r.flag == 0)\n        .collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n        let _ = walk::span(r.size);\n    }\n    if std::fs::write(b, out).is_err() { 1 } else { 0 }\n}\nRS\n"]
