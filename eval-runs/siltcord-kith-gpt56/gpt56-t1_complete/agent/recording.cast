[28.939178, "o", "===== /app/wick.sh =====\r\n"]
[28.943699, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/deskjson /app/idxbay\r\n     5\trustc --edition 2021 -O /app/siltcli/boot.rs -o /app/bin/siltcord\r\n"]
[28.943936, "o", "===== /app/siltcli/boot.rs =====\r\n"]
[28.9449, "o", "     1\t#[path = \"quarry.rs\"]\r\n     2\tmod quarry;\r\n     3\t#[path = \"slate.rs\"]\r\n     4\tmod slate;\r\n     5\t\r\n     6\tfn main() {\r\n     7\t    let mut args = std::env::args();\r\n     8\t    let _ = args.next();\r\n"]
[28.945018, "o", "     9\t    let cmd = args.next().unwrap_or_default();\r\n    10\t    let code = match cmd.as_str() {\r\n    11\t        \"quarry\" => {\r\n    12\t            let a = args\r\n    13\t                .next()\r\n    14\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    15\t            let b = args\r\n    16\t                .next()\r\n    17\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    18\t            quarry::go(&a, &b)\r\n    19\t        }\r\n    20\t        \"brief\" => {\r\n    21\t            let out = match args.next() {\r\n    22\t                Some(x) => x,\r\n    23\t                None => {\r\n    24\t                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n    25\t                    std::process::exit(2);\r\n    26\t                }\r\n    27\t            };\r\n    28\t            let a = args\r\n    29\t                .next()\r\n    30\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    31\t            let b = args\r\n    32\t                .next()\r\n    33\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    34\t            slate::go(&out, &a, &b)\r\n    35\t        }\r\n    36\t        _ => {\r\n    37\t            eprintln!(\"usage: siltcord quarry|brief\");\r\n    38\t            2\r\n    39\t        }\r\n    40\t    };\r\n    41\t    std::process::exit(code);\r\n    42\t}\r\n"]
[28.945241, "o", "===== /app/siltcli/quarry.rs =====\r\n"]
[28.946092, "o", "     1\t#[path = \"../ustarwalk/hdr.rs\"]\r\n     2\tmod hdr;\r\n     3\t#[path = \"../idxmill/shard.rs\"]\r\n     4\tmod shard;\r\n     5\t\r\n     6\tpub fn go(a: &str, b: &str) -> i32 {\r\n     7\t    shard::rib_a(a, b)\r\n"]
[28.946221, "o", "     8\t}\r\n"]
[28.946331, "o", "===== /app/siltcli/slate.rs =====\r\n"]
[28.947183, "o", "     1\t#[path = \"../overlaypit/blend.rs\"]\r\n     2\tmod blend;\r\n     3\t#[path = \"../logbag/write.rs\"]\r\n     4\tmod uni;\r\n     5\t\r\n     6\tpub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n     7\t    match blend::rib_b(a, b) {\r\n"]
[28.947257, "o", "     8\t        Ok(p) => uni::rib_c(&p, out, a),\r\n     9\t        Err(c) => c,\r\n    10\t    }\r\n    11\t}\r\n"]
[28.947376, "o", "===== /app/ustarwalk/block.rs =====\r\n"]
[28.94825, "o", "     1\tpub fn span(n: u64) -> u64 {\r\n     2\t    ((n + 511) / 512) * 512\r\n     3\t}\r\n"]
[28.948395, "o", "===== /app/ustarwalk/hdr.rs =====\r\n"]
[28.949179, "o", "     1\t/// ustar headers are 512 bytes; payload is padded to that size.\r\n     2\tpub struct Row {\r\n     3\t    pub name: String,\r\n     4\t    pub hdr: u64,\r\n     5\t    pub size: u64,\r\n     6\t    pub body: u64,\r\n     7\t    pub flag: u8,\r\n     8\t}\r\n"]
[28.949209, "o", "     9\t\r\n    10\tfn oct_u64(buf: &[u8]) -> u64 {\r\n    11\t    let mut n: u64 = 0;\r\n    12\t    for &b in buf {\r\n    13\t        if b == 0 || b == b' ' {\r\n    14\t            continue;\r\n    15\t        }\r\n    16\t        if b >= b'0' && b <= b'7' {\r\n    17\t            n = n * 8 + u64::from(b - b'0');\r\n    18\t        }\r\n    19\t    }\r\n    20\t    n\r\n    21\t}\r\n    22\t\r\n    23\tpub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n"]
[28.949324, "o", "    24\t    let raw = match std::fs::read(path) {\r\n    25\t        Ok(x) => x,\r\n    26\t        Err(_) => return Err(1),\r\n    27\t    };\r\n"]
[28.949391, "o", "    28\t    if raw.len() < 512 {\r\n    29\t        return Err(1);\r\n    30\t    }\r\n    31\t    let mut rows = Vec::new();\r\n    32\t    let mut off = 0usize;\r\n    33\t    let mut saw = false;\r\n    34\t    while off + 512 <= raw.len() {\r\n    35\t        let blk = &raw[off..off + 512];\r\n    36\t        if blk.iter().all(|b| *b == 0) {\r\n    37\t            break;\r\n    38\t        }\r\n    39\t        let magic = &blk[257..262];\r\n    40\t        if magic != b\"ustar\" {\r\n    41\t            return Err(1);\r\n    42\t        }\r\n    43\t        saw = true;\r\n    44\t        let nlen = blk[0..100]\r\n    45\t            .iter()\r\n    46\t            .position(|b| *b == 0)\r\n    47\t            .unwrap_or(100);\r\n    48\t        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();\r\n    49\t        let size = oct_u64(&blk[124..136]);\r\n    50\t        let flag = blk[156];\r\n    51\t        let body = (off + 512) as u64;\r\n    52\t        rows.push(Row {\r\n    53\t            name,\r\n    54\t            hdr: off as u64,\r\n    55\t            size,\r\n    56\t            body,\r\n    57\t            flag,\r\n    58\t        });\r\n    59\t        let padded = ((size + 511) / 512) * 512;\r\n    60\t        off = off + 512 + padded as usize;\r\n    61\t    }\r\n    62\t    if !saw {\r\n    63\t        return Err(1);\r\n    64\t    }\r\n    65\t    Ok(rows)\r\n    66\t}\r\n    67\t\r\n    68\tpub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n    69\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    70\t    let s = row.body as usize;\r\n    71\t    let e = s + row.size as usize;\r\n    72\t    if e > raw.len() {\r\n    73\t        return Err(1);\r\n    74\t    }\r\n    75\t    Ok(raw[s..e].to_vec())\r\n    76\t}\r\n"]
[28.949584, "o", "===== /app/idxmill/shard.rs =====\r\n"]
[28.950574, "o", "     1\tuse super::hdr;\r\n     2\t\r\n     3\t#[path = \"../pidhash/seed.rs\"]\r\n     4\tmod seed;\r\n     5\t#[path = \"../ustarwalk/block.rs\"]\r\n     6\tmod walk;\r\n     7\t\r\n     8\tpub fn rib_a(a: &str, b: &str) -> i32 {\r\n     9\t    let mut rows = match hdr::scan(a) {\r\n    10\t        Ok(x) => x,\r\n    11\t        Err(_) => Vec::new(),\r\n    12\t    };\r\n"]
[28.950716, "o", "    13\t    rows.sort_by_key(|r| seed::mix(&r.name));\r\n    14\t    let regs: Vec<&hdr::Row> = rows\r\n    15\t        .iter()\r\n    16\t        .filter(|r| r.flag == b'0' || r.flag == 0)\r\n    17\t        .collect();\r\n    18\t    let mut out = Vec::new();\r\n    19\t    out.extend_from_slice(b\"SILT1\");\r\n    20\t    let n = regs.len() as u32;\r\n    21\t    out.extend_from_slice(&n.to_le_bytes());\r\n    22\t    for r in regs {\r\n    23\t        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n    24\t        out.extend_from_slice(&r.size.to_le_bytes());\r\n    25\t        out.extend_from_slice(&r.body.to_le_bytes());\r\n"]
[28.950783, "o", "    26\t        let nb = r.name.as_bytes();\r\n    27\t        let nl = nb.len() as u16;\r\n    28\t        out.extend_from_slice(&nl.to_le_bytes());\r\n    29\t        out.extend_from_slice(nb);\r\n    30\t        let _ = walk::span(r.size);\r\n    31\t    }\r\n    32\t    if std::fs::write(b, out).is_err() {\r\n    33\t        return 1;\r\n    34\t    }\r\n    35\t    0\r\n    36\t}\r\n"]
[28.950993, "o", "===== /app/overlaypit/blend.rs =====\r\n"]
[28.952529, "o", "     1\tpub struct Pack {\r\n     2\t    pub t: String,\r\n     3\t    pub c: String,\r\n     4\t    pub e: Vec<String>,\r\n     5\t    pub n: u32,\r\n     6\t    pub s: String,\r\n     7\t    pub w: String,\r\n     8\t}\r\n     9\t\r\n    10\tstruct Rec {\r\n    11\t    name: String,\r\n    12\t    hdr: u64,\r\n    13\t    size: u64,\r\n    14\t    body: u64,\r\n    15\t}\r\n    16\t\r\n    17\tfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n    18\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    19\t    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" {\r\n    20\t        return Err(1);\r\n    21\t    }\r\n    22\t    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n    23\t    let mut i = 9usize;\r\n"]
[28.952626, "o", "    24\t    let mut out = Vec::new();\r\n    25\t    for _ in 0..n {\r\n    26\t        if i + 26 > raw.len() {\r\n    27\t            return Err(1);\r\n    28\t        }\r\n    29\t        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    30\t        i += 8;\r\n    31\t        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    32\t        i += 8;\r\n    33\t        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    34\t        i += 8;\r\n    35\t        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;\r\n    36\t        i += 2;\r\n    37\t        if i + nl > raw.len() {\r\n    38\t            return Err(1);\r\n    39\t        }\r\n    40\t        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();\r\n    41\t        i += nl;\r\n    42\t        out.push(Rec {\r\n    43\t            name,\r\n    44\t            hdr,\r\n    45\t            size,\r\n    46\t            body,\r\n    47\t        });\r\n    48\t    }\r\n    49\t    Ok(out)\r\n    50\t}\r\n    51\t\r\n    52\tfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\r\n    53\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    54\t    let s = body as usize;\r\n    55\t    let e = s + size as usize;\r\n    56\t    if e > raw.len() {\r\n    57\t        return Err(1);\r\n    58\t    }\r\n    59\t    Ok(raw[s..e].to_vec())\r\n    60\t}\r\n    61\t\r\n    62\tfn digest(text: &str) -> String {\r\n    63\t    let mut cmd = std::process::Command::new(\"python3\");\r\n    64\t    cmd.args([\r\n"]
[28.952654, "o", "    65\t        \"-c\",\r\n    66\t        \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\",\r\n    67\t    ])\r\n    68\t    .stdin(std::process::Stdio::piped())\r\n    69\t    .stdout(std::process::Stdio::piped());\r\n    70\t    let mut child = match cmd.spawn() {\r\n    71\t        Ok(c) => c,\r\n    72\t        Err(_) => return String::new(),\r\n"]
[28.952673, "o", "    73\t    };\r\n    74\t    {\r\n    75\t        use std::io::Write;\r\n    76\t        if let Some(ref mut sin) = child.stdin {\r\n    77\t            let _ = sin.write_all(text.as_bytes());\r\n"]
[28.952687, "o", "    78\t        }\r\n    79\t    }\r\n    80\t    drop(child.stdin.take());\r\n    81\t    match child.wait_with_output() {\r\n"]
[28.952703, "o", "    82\t        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),\r\n    83\t        Err(_) => String::new(),\r\n    84\t    }\r\n    85\t}\r\n    86\t\r\n"]
[28.952723, "o", "    87\t#[path = \"../keeppit/first.rs\"]\r\n    88\tmod first;\r\n    89\t#[path = \"../cfgbag/kv.rs\"]\r\n    90\tmod kv;\r\n    91\t#[path = \"../cfgbag/alias.rs\"]\r\n"]
[28.952737, "o", "    92\tmod alias;\r\n    93\t\r\n    94\tpub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n"]
[28.952757, "o", "    95\t    let recs = read_idx(b)?;\r\n    96\t    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    97\t    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    98\t    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    99\t    for (i, r) in recs.iter().enumerate() {\r\n"]
[28.952772, "o", "   100\t        bag.insert(i, r.name.clone());\r\n   101\t        let blob = load(a, r.body, r.size)?;\r\n   102\t        if r.name.contains(\"sys.conf\") {\r\n"]
[28.952788, "o", "   103\t            confs.push((r.name.clone(), r.hdr, blob));\r\n   104\t        } else if r.name.contains(\"app.log\") {\r\n   105\t            logs.push(blob);\r\n   106\t        }\r\n"]
[28.952817, "o", "   107\t    }\r\n   108\t    confs.sort_by_key(|row| row.1);\r\n   109\t    let picked = first::keep_head(&confs);\r\n"]
[28.952834, "o", "   110\t    let mut t = String::new();\r\n   111\t    let mut c = String::new();\r\n   112\t    if let Some(blob) = picked {\r\n   113\t        let map = kv::pairs(&blob);\r\n   114"]
[28.952852, "o", "\t        if let Some(v) = map.get(\"timezone\") {\r\n   115\t            t = v.clone();\r\n   116\t        }\r\n"]
[28.952878, "o", "   117\t        if let Some(v) = map.get(\"cluster\") {\r\n   118\t            c = v.clone();\r\n   119\t        }\r\n   120\t    }\r\n   121\t    let mut e = Vec::new();\r\n"]
[28.952903, "o", "   122\t    if let Some(blob) = logs.first() {\r\n   123\t        for line in String::from_utf8_lossy(blob).lines() {\r\n   124\t            let s = line.trim();\r\n   125\t            if !s.is_empty() {\r\n   126\t                e.push(s.to_string());\r\n   127\t            }\r\n   128\t        }\r\n   129\t    }\r\n   130"]
[28.95292, "o", "\t    e.sort();\r\n   131\t    e.dedup();\r\n   132\t    let names: Vec<String> = bag.values().cloned().collect();\r\n   133\t"]
[28.952935, "o", "    let walk = names.join(\"\\n\");\r\n   134\t    let _ = alias::fold(\"\");\r\n   135\t    Ok(Pack {\r\n   136\t        t,\r\n"]
[28.952953, "o", "   137\t        c,\r\n   138\t        e,\r\n   139\t        n: confs.len() as u32,\r\n   140\t        s: a.to_string(),\r\n"]
[28.952972, "o", "   141\t        w: digest(&walk).to_ascii_uppercase(),\r\n   142\t    })\r\n   143\t}\r\n"]
[28.953458, "o", "===== /app/logbag/write.rs =====\r\n"]
[28.954698, "o", "     1\tuse super::blend::Pack;\r\n     2\t\r\n     3\tfn json_escape(s: &str) -> String {\r\n     4\t    s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")\r\n     5\t}\r\n     6\t\r\n     7\tpub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\r\n     8\t    if let Some(parent) = std::path::Path::new(out).parent() {\r\n     9\t        let _ = std::fs::create_dir_all(parent);\r\n    10\t    }\r\n"]
[28.954879, "o", "    11\t    let ev: Vec<String> = p\r\n    12\t        .e\r\n    13\t        .iter()\r\n    14\t        .map(|x| format!(\"\\\"{}\\\"\", json_escape(x)))\r\n    15\t        .collect();\r\n    16\t    let body = format!(\r\n    17\t        \"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\r\n    18\t        json_escape(&p.t),\r\n    19\t        json_escape(&p.c),\r\n    20\t        ev.join(\",\"),\r\n    21\t        p.n,\r\n    22\t        json_escape(&p.s),\r\n    23\t        json_escape(&p.w)\r\n    24"]
[28.954981, "o", "\t    );\r\n    25\t    if std::fs::write(out, body).is_err() {\r\n    26\t        return 1;\r\n    27\t    }\r\n    28\t    if std::fs::write(\"/app/deskjson/READY\", \"ok\\n\").is_err() {\r\n    29\t        return 1;\r\n    30\t    }\r\n    31\t    0\r\n    32\t}\r\n"]
[28.955096, "o", "===== /app/cfgbag/alias.rs =====\r\n"]
[28.956164, "o", "     1\tpub fn fold(name: &str) -> String {\r\n     2\t    name.trim_start_matches(\"./\").to_string()\r\n     3\t}\r\n"]
[28.956362, "o", "===== /app/cfgbag/kv.rs =====\r\n"]
[28.957378, "o", "     1\tuse std::collections::BTreeMap;\r\n     2\t\r\n     3\tpub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {\r\n     4\t    let mut m = BTreeMap::new();\r\n     5\t    for line in String::from_utf8_lossy(blob).lines() {\r\n     6\t        if let Some((k, v)) = line.split_once('=') {\r\n     7\t            m.insert(k.trim().to_string(), v.trim().to_string());\r\n     8\t        }\r\n     9\t    }\r\n    10\t    m\r\n    11\t}\r\n"]
[28.957613, "o", "===== /app/offseturn/rank.rs =====\r\n"]
[28.958912, "o", "     1\tpub fn by_hdr(a: u64, b: u64) -> std::cmp::Ordering {\r\n     2\t    a.cmp(&b)\r\n     3\t}\r\n"]
[28.959137, "o", "===== /app/paxcue/long.rs =====\r\n"]
[28.960134, "o", "     1\tpub fn peek(name: &str) -> bool {\r\n     2\t    name.contains(\"PaxHeaders\")\r\n     3\t}\r\n"]
[28.960292, "o", "===== /app/pidhash/seed.rs =====\r\n"]
[28.961472, "o", "     1\tpub fn mix(name: &str) -> u64 {\r\n     2\t    let mut h: u64 = 0xcbf29ce484222325;\r\n     3\t    for b in name.bytes() {\r\n     4\t        h ^= u64::from(b);\r\n     5\t        h = h.wrapping_mul(0x100000001b3);\r\n     6\t    }\r\n     7\t    h\r\n     8\t}\r\n"]
[28.961691, "o", "===== /app/keeppit/first.rs =====\r\n"]
[28.962735, "o", "     1\tpub struct Head;\r\n     2\t\r\n     3\timpl Head {\r\n     4\t    pub fn take<'a>(rows: &'a [(String, u64, Vec<u8>)]) -> Option<&'a Vec<u8>> {\r\n     5\t        rows.first().map(|r| &r.2)\r\n     6\t    }\r\n     7\t}\r\n     8\t\r\n     9\tpub fn keep_head(rows: &[(String, u64, Vec<u8>)]) -> Option<&Vec<u8>> {\r\n    10\t    Head::take(rows)\r\n    11\t}\r\n"]
[28.962955, "o", "\u001b[?2004hroot@bf9871f56849:/app# "]
[29.520561, "i", "echo '=== usage ==='; cat /app/siltcli/usage.txt; echo '=== idx readme ==='; cat /app/idxbay/README.txt; echo '=== ledger ==='; cat /app/idxbay/members.idx; echo '=== READY bytes ==='; od -An -tx1c /app/deskjson/READY\n"]
[29.521539, "o", "echo '=== usage ==='; cat /app/siltcli/usage.txt; echo '=== idx readme ==='; cat /app/idxbay/README.txt; echo '=== ledger ==='; cat /app/idxbay/members.idx; echo '=== READY bytes ==='; od -An -tx1c /app/deskjson/READY\r\n\u001b[?2004l\r"]
[29.521826, "o", "=== usage ===\r\n"]
[29.52649, "o", "siltcord quarry [archive] [idx]\r\nsiltcord brief OUT.json [archive] [idx]\r\n"]
[29.526752, "o", "=== idx readme ===\r\n"]
[29.527906, "o", "quarry writes members.idx from a kith under sealwell.\r\nbrief reads that ledger and writes a JSON object.\r\n\r\nSealed original: /app/seed/sealwell/kestrel.kith\r\nOutside copy used only as a rejected path: /tmp/kestrel.kith\r\nJunk ledger bytes: xxxx\r\nNon-ustar quarry sample: not-an-archive\r\nwalk_sig uses hashlib.sha256\r\n"]
[29.528102, "o", "=== ledger ===\r\n"]
[29.528913, "o", "SILT1\u0006\u0000\u0000\u0000\u0000\f\u0000\u0000\u0000\u0000\u0000\u0000'\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u000e\u0000\u0000\u0000\u0000\u0000\u0000\u000e\u0000./etc/sys.conf\u0000\u0004\u0000\u0000\u0000\u0000\u0000\u0000\t\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0006\u0000\u0000\u0000\u0000\u0000\u0000\u000f\u0000var/log/app.log\u0000\u0010\u0000\u0000\u0000\u0000\u0000\u0000\u000b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0012\u0000\u0000\u0000\u0000\u0000\u0000\u000f\u0000var/log/app.log\u0000\u0018\u0000\u0000\u0000\u0000\u0000\u0000\u0006\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u001a\u0000\u0000\u0000\u0000\u0000\u0000\u0010\u0000opt/app/build.id\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000!\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0002\u0000\u0000\u0000\u0000\u0000\u0000\f\u0000etc/sys.conf\u0000\u0014\u0000\u0000\u0000\u0000\u0000\u0000\u0014\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0016\u0000\u0000\u0000\u0000\u0000\u0000\t\u0000etc/hosts"]
[29.529114, "o", "=== READY bytes ===\r\n"]
[29.530516, "o", "  6f  6b  0a\r\n   o   k  \\n\r\n"]
[29.530698, "o", "\u001b[?2004hroot@bf9871f56849:/app# "]
[29.677909, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/sealwell/kestrel.kith').read_bytes()\nprint('length',len(p))\npos=0\nwhile pos+512<=len(p):\n h=p[pos:pos+512]\n if not any(h):\n  print('zero block at',pos); break\n name=h[:100].split(b'\\0',1)[0]\n print('header',pos,'name=',name,'magic=',h[257:263], 'type=',h[156:157], 'sizefield=',h[124:136])\n try: n=int(h[124:136].strip(b'\\0 ') or b'0',8)\n except Exception as e: print('bad size',e); break\n data=p[pos+512:pos+512+n]\n print(' payload',repr(data[:300]))\n pos += 512 + ((n+511)//512)*512\nPY\n"]
[29.67822, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[29.678304, "o", "\u001b[?2004h"]
