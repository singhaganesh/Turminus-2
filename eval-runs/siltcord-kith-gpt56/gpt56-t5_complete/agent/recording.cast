[16.90514, "i", "for f in /app/wick.sh /app/siltcli/*.rs /app/ustarwalk/*.rs /app/idxmill/*.rs /app/overlaypit/*.rs /app/logbag/*.rs /app/cfgbag/*.rs /app/offseturn/*.rs /app/paxcue/*.rs /app/pidhash/*.rs /app/keeppit/*.rs /app/siltcli/usage.txt /app/treenotes/FLICKER.txt /app/idxbay/README.txt; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done\n"]
[16.906381, "o", "for f in /app/wick.sh /app/siltcli/*.rs /app/ustarwalk/*.rs /app/idxmill/*.rs /app/overlaypit/*.rs /app/logbag/*.rs /app/cfgbag/*.rs /app/offseturn/*.rs /app/paxcue/*.rs /app/pidhash/*.rs /app/keeppit/*.rs /app/siltcli/usage.txt /app/treenotes/FLICKER.txt /app/idxbay/README.txt; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[16.906718, "o", "===== /app/wick.sh =====\r\n"]
[16.912951, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/deskjson /app/idxbay\r\nrustc --edition 2021 -O /app/siltcli/boot.rs -o /app/bin/siltcord\r\n"]
[16.913582, "o", "===== /app/siltcli/boot.rs =====\r\n"]
[16.915522, "o", "#[path = \"quarry.rs\"]\r\nmod quarry;\r\n#[path = \"slate.rs\"]\r\nmod slate;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"quarry\" => {\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n"]
[16.915736, "o", "                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            quarry::go(&a, &b)\r\n        }\r\n        \"brief\" => {\r\n            let out = match args.next() {\r\n                Some(x) => x,\r\n                None => {\r\n                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n                    std::process::exit(2);\r\n                }\r\n            };\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            slate::go(&out, &a, &b)\r\n        }\r\n        _ => {\r\n            eprintln!(\"usage: siltcord quarry|brief\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[16.915949, "o", "===== /app/siltcli/quarry.rs =====\r\n"]
[16.917178, "o", "#[path = \"../ustarwalk/hdr.rs\"]\r\nmod hdr;\r\n#[path = \"../idxmill/shard.rs\"]\r\nmod shard;\r\n\r\npub fn go(a: &str, b: &str) -> i32 {\r\n    shard::rib_a(a, b)\r\n}\r\n"]
[16.917399, "o", "===== /app/siltcli/slate.rs =====\r\n"]
[16.918449, "o", "#[path = \"../overlaypit/blend.rs\"]\r\nmod blend;\r\n#[path = \"../logbag/write.rs\"]\r\nmod uni;\r\n\r\npub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n    match blend::rib_b(a, b) {\r\n        Ok(p) => uni::rib_c(&p, out, a),\r\n        Err(c) => c,\r\n    }\r\n}\r\n"]
[16.918727, "o", "===== /app/ustarwalk/block.rs =====\r\n"]
[16.919759, "o", "pub fn span(n: u64) -> u64 {\r\n    ((n + 511) / 512) * 512\r\n}\r\n"]
[16.919937, "o", "===== /app/ustarwalk/hdr.rs =====\r\n"]
[16.92092, "o", "/// ustar headers are 512 bytes; payload is padded to that size.\r\npub struct Row {\r\n    pub name: String,\r\n    pub hdr: u64,\r\n    pub size: u64,\r\n    pub body: u64,\r\n    pub flag: u8,\r\n}\r\n\r\nfn oct_u64(buf: &[u8]) -> u64 {\r\n    let mut n: u64 = 0;\r\n"]
[16.921006, "o", "    for &b in buf {\r\n        if b == 0 || b == b' ' {\r\n            continue;\r\n        }\r\n        if b >= b'0' && b <= b'7' {\r\n            n = n * 8 + u64::from(b - b'0');\r\n        }\r\n    }\r\n    n\r\n}\r\n\r\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n    let raw = match std::fs::read(path) {\r\n        Ok(x) => x,\r\n"]
[16.921092, "o", "        Err(_) => return Err(1),\r\n    };\r\n    if raw.len() < 512 {\r\n        return Err(1);\r\n    }\r\n    let mut rows = Vec::new();\r\n    let mut off = 0usize;\r\n    let mut saw = false;\r\n    while off + 512 <= raw.len() {\r\n        let blk = &raw[off..off + 512];\r\n        if blk.iter().all(|b| *b == 0) {\r\n            break;\r\n        }\r\n        let magic = &blk[257..262];\r\n        if magic != b\"ustar\" {\r\n            return Err(1);\r\n        }\r\n        saw = true;\r\n        let nlen = blk[0..100]\r\n            .iter()\r\n            .position(|b| *b == 0)\r\n            .unwrap_or(100);\r\n        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();\r\n        let size = oct_u64(&blk[124..136]);\r\n        let flag = blk[156];\r\n        let body = (off + 512) as u64;\r\n        rows.push(Row {\r\n            name,\r\n            hdr: off as u64,\r\n            size,\r\n            body,\r\n            flag,\r\n        });\r\n        let padded = ((size + 511) / 512) * 512;\r\n        off = off + 512 + padded as usize;\r\n    }\r\n    if !saw {\r\n        return Err(1);\r\n    }\r\n    Ok(rows)\r\n}\r\n\r\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    let s = row.body as usize;\r\n    let e = s + row.size as usize;\r\n    if e > raw.len() {\r\n        return Err(1);\r\n    }\r\n    Ok(raw[s..e].to_vec())\r\n}\r\n"]
[16.921261, "o", "===== /app/idxmill/shard.rs =====\r\n"]
[16.922347, "o", "use super::hdr;\r\n\r\n#[path = \"../pidhash/seed.rs\"]\r\nmod seed;\r\n#[path = \"../ustarwalk/block.rs\"]\r\nmod walk;\r\n\r\npub fn rib_a(a: &str, b: &str) -> i32 {\r\n    let mut rows = match hdr::scan(a) {\r\n        Ok(x) => x,\r\n        Err(_) => Vec::new(),\r\n    };\r\n    rows.sort_by_key(|r| seed::mix(&r.name));\r\n    let regs: Vec<&hdr::Row> = rows\r\n        .iter()\r\n"]
[16.922492, "o", "        .filter(|r| r.flag == b'0' || r.flag == 0)\r\n        .collect();\r\n    let mut out = Vec::new();\r\n    out.extend_from_slice(b\"SILT1\");\r\n    let n = regs.len() as u32;\r\n    out.extend_from_slice(&n.to_le_bytes());\r\n    for r in regs {\r\n        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n        out.extend_from_slice(&r.size.to_le_bytes());\r\n        out.extend_from_slice(&r.body.to_le_bytes());\r\n        let nb = r.name.as_bytes();\r\n        let nl = nb.len() as u16;\r\n        out.extend_from_slice(&nl.to_le_bytes());\r\n        out.extend_from_slice(nb);\r\n        let _ = walk::span(r.size);\r\n    }\r\n    if std::fs::write(b, out).is_err() {\r\n        return 1;\r\n    }\r\n"]
[16.922556, "o", "    0\r\n}\r\n"]
[16.922689, "o", "===== /app/overlaypit/blend.rs =====\r\n"]
[16.924522, "o", "pub struct Pack {\r\n    pub t: String,\r\n    pub c: String,\r\n    pub e: Vec<String>,\r\n    pub n: u32,\r\n    pub s: String,\r\n    pub w: String,\r\n}\r\n\r\nstruct Rec {\r\n    name: String,\r\n    hdr: u64,\r\n    size: u64,\r\n    body: u64,\r\n"]
[16.925914, "o", "}\r\n\r\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" {\r\n        return Err(1);\r\n    }\r\n    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n    let mut i = 9usize;\r\n    let mut out = Vec::new();\r\n    for _ in 0..n {\r\n        if i + 26 > raw.len() {\r\n            return Err(1);\r\n        }\r\n        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;\r\n        i += 2;\r\n        if i + nl > raw.len() {\r\n            return Err(1);\r\n        }\r\n        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();\r\n        i += nl;\r\n        out.push(Rec {\r\n            name,\r\n            hdr,\r\n            size,\r\n            body,\r\n        });\r\n    }\r\n    Ok(out)\r\n}\r\n\r\nfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\r\n    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    let s = body as usize;\r\n    let e = s + size as usize;\r\n    if e > raw.len() {\r\n        return Err(1);\r\n    }\r\n    Ok(raw[s..e].to_vec())\r\n}\r\n\r\nfn digest(text: &str) -> String {\r\n    let mut cmd = std::process::Command::new(\"python3\");\r\n    cmd.args([\r\n        \"-c\",\r\n        \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\",\r\n    ])\r\n    .stdin(std::process::Stdio::piped())\r\n    .stdout(std::process::Stdio::piped());\r\n    let mut child = match cmd.spawn() {\r\n        Ok(c) => c,\r\n        Err(_) => return String::new(),\r\n    };\r\n    {\r\n        use std::io::Write;\r\n        if let Some(ref mut sin) = child.stdin {\r\n            let _ = sin.write_all(text.as_bytes());\r\n        }\r\n    }\r\n    drop(child.stdin.take());\r\n    match child.wait_with_output() {\r\n        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),\r\n        Err(_) => String::new(),\r\n    }\r\n}\r\n\r\n#[path = \"../keeppit/first.rs\"]\r\nmod first;\r\n#[path = \"../cfgbag/kv.rs\"]\r\nmod kv;\r\n#[path = \"../cfgbag/alias.rs\"]\r\nmod alias;\r\n\r\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    let recs = read_idx(b)?;\r\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    for (i, r) in recs.iter().enumerate() {\r\n        bag.insert(i, r.name.clone());\r\n        let blob = load(a, r.body, r.size)?;\r\n        if r.name.contains(\"sys.conf\") {\r\n            confs.push((r.name.clone(), r.hdr, blob));\r\n        } else if r.name.contains(\"app.log\") {\r\n            logs.push(blob);\r\n        }\r\n    }\r\n    confs.sort_by_key(|row| row.1);\r\n    let picked = first::keep_head(&confs);\r\n    let mut t = String::new();\r\n    let mut c = String::new();\r\n    if let Some(blob) = picked {\r\n        let map = kv::pairs(&blob);\r\n        if let Some(v) = map.get(\"timezone\") {\r\n            t = v.clone();\r\n        }\r\n        if let Some(v) = map.get(\"cluster\") {\r\n            c = v.clone();\r\n        }\r\n    }\r\n    let mut e = Vec::new();\r\n    if let Some(blob) = logs.first() {\r\n        for line in String::from_utf8_lossy(blob).lines() {\r\n            let s = line.trim();\r\n            if !s.is_empty() {\r\n                e.push(s.to_string());\r\n            }\r\n        }\r\n    }\r\n    e.sort();\r\n    e.dedup();\r\n    let names: Vec<String> = bag.values().cloned().collect();\r\n    let walk = names.join(\"\\n\");\r\n    let _ = alias::fold(\"\");\r\n    Ok(Pack {\r\n        t,\r\n        c,\r\n        e,\r\n        n: confs.len() as u32,\r\n        s: a.to_string(),\r\n        w: digest(&walk).to_ascii_uppercase(),\r\n    })\r\n}\r\n"]
[16.926596, "o", "===== /app/logbag/write.rs =====\r\n"]
[16.929011, "o", "use super::blend::Pack;\r\n\r\nfn json_escape(s: &str) -> String {\r\n    s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")\r\n}\r\n\r\npub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\r\n    if let Some(parent) = std::path::Path::new(out).parent() {\r\n        let _ = std::fs::create_dir_all(parent);\r\n    }\r\n    let ev: Vec<String> = p\r\n        .e\r\n        .iter()\r\n        .map(|x| format!(\"\\\"{}\\\"\", json_escape(x)))\r\n        .collect();\r\n    let body = format!(\r\n"]
[16.929199, "o", "        \"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\r\n        json_escape(&p.t),\r\n        json_escape(&p.c),\r\n        ev.join(\",\"),\r\n        p.n,\r\n        json_escape(&p.s),\r\n        json_escape(&p.w)\r\n    );\r\n    if std::fs::write(out, body).is_err() {\r\n        return 1;\r\n    }\r\n    if std::fs::write(\"/app/deskjson/READY\", \"ok\\n\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[16.929573, "o", "===== /app/cfgbag/alias.rs =====\r\n"]
[16.931942, "o", "pub fn fold(name: &str) -> String {\r\n    name.trim_start_matches(\"./\").to_string()\r\n}\r\n"]
[16.932588, "o", "===== /app/cfgbag/kv.rs =====\r\n"]
[16.934337, "o", "use std::collections::BTreeMap;\r\n\r\npub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {\r\n    let mut m = BTreeMap::new();\r\n    for line in String::from_utf8_lossy(blob).lines() {\r\n        if let Some((k, v)) = line.split_once('=') {\r\n            m.insert(k.trim().to_string(), v.trim().to_string());\r\n        }\r\n    }\r\n    m\r\n}\r\n"]
[16.934698, "o", "===== /app/offseturn/rank.rs =====\r\n"]
[16.936346, "o", "pub fn by_hdr(a: u64, b: u64) -> std::cmp::Ordering {\r\n    a.cmp(&b)\r\n}\r\n"]
[16.936795, "o", "===== /app/paxcue/long.rs =====\r\n"]
[16.93795, "o", "pub fn peek(name: &str) -> bool {\r\n    name.contains(\"PaxHeaders\")\r\n}\r\n"]
[16.938209, "o", "===== /app/pidhash/seed.rs =====\r\n"]
[16.939433, "o", "pub fn mix(name: &str) -> u64 {\r\n    let mut h: u64 = 0xcbf29ce484222325;\r\n    for b in name.bytes() {\r\n        h ^= u64::from(b);\r\n        h = h.wrapping_mul(0x100000001b3);\r\n    }\r\n    h\r\n}\r\n"]
[16.939713, "o", "===== /app/keeppit/first.rs =====\r\n"]
[16.941801, "o", "pub struct Head;\r\n\r\nimpl Head {\r\n    pub fn take<'a>(rows: &'a [(String, u64, Vec<u8>)]) -> Option<&'a Vec<u8>> {\r\n        rows.first().map(|r| &r.2)\r\n    }\r\n}\r\n\r\npub fn keep_head(rows: &[(String, u64, Vec<u8>)]) -> Option<&Vec<u8>> {\r\n    Head::take(rows)\r\n}\r\n"]
[16.943677, "o", "===== /app/siltcli/usage.txt =====\r\n"]
[16.945811, "o", "siltcord quarry [archive] [idx]\r\nsiltcord brief OUT.json [archive] [idx]\r\n"]
[16.946178, "o", "===== /app/treenotes/FLICKER.txt =====\r\n"]
[16.949744, "o", "If configuration strings flicker across desk runs, keep_head in keeppit retains the first sys.conf payload the mill sees. That path is enough for a stable smoke against cluster.\r\n"]
[16.950229, "o", "===== /app/idxbay/README.txt =====\r\n"]
[16.952012, "o", "quarry writes members.idx from a kith under sealwell.\r\nbrief reads that ledger and writes a JSON object.\r\n\r\nSealed original: /app/seed/sealwell/kestrel.kith\r\nOutside copy used only as a rejected path: /tmp/kestrel.kith\r\nJunk ledger bytes: xxxx\r\nNon-ustar quarry sample: not-an-archive\r\nwalk_sig uses hashlib.sha256\r\n"]
[16.95246, "o", "\u001b[?2004hroot@bb15390b5ebf:/app# "]
