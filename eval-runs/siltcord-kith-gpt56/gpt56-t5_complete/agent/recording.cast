[69.429116, "i", "cat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, hdr: u64, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        let end = i.checked_add(nl).ok_or(1)?;\n        if end > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..end]).map_err(|_| 1)?.to_string();\n        i = end;\n        out.push(Rec { name, hdr, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn load(raw: &[u8], body: u64, size: u64) -> Result<Vec<u8>, i32> {\n    let s = usize::try_from(body).map_err(|_| 1)?;\n    let len = usize::try_from(size).map_err(|_| 1)?;\n    let e = s.checked_add(len).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let output = child.wait_with_output().map_err(|_| 1)?;\n    if !output.status.success() { return Err(1); }\n    let s = String::from_utf8(output.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { return Err(1); }\n    Ok(s)\n}\n\n#[path = \"../cfgbag/kv.rs\"]\nmod kv;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let root = std::fs::canonicalize(\"/app/sealwell\").map_err(|_| 1)?;\n    let archive = std::fs::canonicalize(a).map_err(|_| 1)?;\n    if !archive.starts_with(&root) || !archive.is_file() { return Err(1); }\n    let raw = std::fs::read(&archive).map_err(|_| 1)?;\n    let mut recs = read_idx(b)?;\n    recs.sort_by_key(|r| r.hdr);\n    let mut conf: Option<Vec<u8>> = None;\n    let mut events = Vec::new();\n    let mut names = Vec::with_capacity(recs.len());\n    for r in &recs {\n        if r.body != r.hdr.checked_add(512).ok_or(1)? { return Err(1); }\n        let blob = load(&raw, r.body, r.size)?;\n        names.push(r.name.clone());\n        if r.name.ends_with(\"sys.conf\") && conf.is_none() { conf = Some(blob.clone()); }\n        if r.name.ends_with(\"app.log\") {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let value = line.trim();\n                if !value.is_empty() { events.push(value.to_string()); }\n            }\n        }\n    }\n    events.sort();\n    events.dedup();\n    let map = conf.as_deref().map(kv::pairs).unwrap_or_default();\n    let source = archive.file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack {\n        t: map.get(\"timezone\").cloned().unwrap_or_default(),\n        c: map.get(\"cluster\").cloned().unwrap_or_default(),\n        e: events,\n        n: u32::try_from(recs.len()).map_err(|_| 1)?,\n        s: source,\n        w: digest(&names.join(\"\\n\"))?,\n    })\n}\nRS\n"]
