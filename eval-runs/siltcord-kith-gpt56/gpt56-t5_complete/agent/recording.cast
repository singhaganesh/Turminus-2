[69.571965, "i", "cat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"]\nmod blend;\n#[path = \"../logbag/write.rs\"]\nmod uni;\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    match blend::rib_b(a, b) {\n        Ok(p) => uni::rib_c(&p, out, a),\n        Err(c) => c,\n    }\n}\nRS\npython3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read()\ns=s.replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")', 'std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\nopen(p,'w').write(s)\nPY\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:$PATH\"; sh /app/wick.sh\n"]
