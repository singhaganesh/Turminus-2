[69.286923, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// One regular or non-regular member from a validated ustar stream.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let mut n = 0u64;\n    let mut saw = false;\n    for &b in buf {\n        if b == 0 || b == b' ' {\n            continue;\n        }\n        if !(b'0'..=b'7').contains(&b) {\n            return Err(1);\n        }\n        saw = true;\n        n = n.checked_mul(8).and_then(|v| v.checked_add(u64::from(b - b'0'))).ok_or(1)?;\n    }\n    if saw { Ok(n) } else { Ok(0) }\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 {\n        return Err(1);\n    }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off + 512];\n        if blk.iter().all(|&b| b == 0) {\n            if off + 1024 > raw.len() || !raw[off + 512..off + 1024].iter().all(|&b| b == 0) {\n                return Err(1);\n            }\n            if !raw[off..].iter().all(|&b| b == 0) {\n                return Err(1);\n            }\n            ended = true;\n            break;\n        }\n        if &blk[257..262] != b\"ustar\" {\n            return Err(1);\n        }\n        let nlen = blk[..100].iter().position(|&b| b == 0).unwrap_or(100);\n        if nlen == 0 {\n            return Err(1);\n        }\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = (off as u64).checked_add(512).and_then(|v| v.checked_add(padded)).ok_or(1)?;\n        if next > raw.len() as u64 {\n            return Err(1);\n        }\n        rows.push(Row { name, hdr: off as u64, size, body: (off + 512) as u64, flag: blk[156] });\n        off = next as usize;\n    }\n    if rows.is_empty() || !ended { return Err(1); }\n    Ok(rows)\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let len = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(len).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\n#[path = \"../ustarwalk/block.rs\"]\nmod walk;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) {\n        Ok(x) => x,\n        Err(c) => return c,\n    };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n        let _ = walk::span(r.size);\n    }\n    if let Some(parent) = std::path::Path::new(b).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    if std::fs::write(b, out).is_err() { return 1; }\n    0\n}\nRS\n"]
