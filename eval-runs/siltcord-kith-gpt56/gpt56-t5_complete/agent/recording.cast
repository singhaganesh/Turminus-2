[28.714664, "i", "python3 - <<'PY'\nimport tarfile, hashlib\np='/app/sealwell/kestrel.kith'\nwith tarfile.open(p, 'r:') as t:\n    regs=[]\n    for i,m in enumerate(t.getmembers()):\n        print(i, repr(m.name), m.type, m.size, 'offset',m.offset,'data',m.offset_data)\n        if m.isfile():\n            regs.append(m.name)\n            data=t.extractfile(m).read()\n            print('  payload=',repr(data))\nprint('regular count',len(regs))\nprint('names',regs)\nprint('expected sig',hashlib.sha256('\\n'.join(regs).encode()).hexdigest())\nPY\n"]
