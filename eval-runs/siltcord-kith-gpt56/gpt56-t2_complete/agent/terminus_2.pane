pub fn by_hdr(a: u64, b: u64) -> std::cmp::Ordering {
    a.cmp(&b)
}
===== /app/paxcue/long.rs =====
pub fn peek(name: &str) -> bool {
    name.contains("PaxHeaders")
}
===== /app/pidhash/seed.rs =====
pub fn mix(name: &str) -> u64 {
    let mut h: u64 = 0xcbf29ce484222325;
    for b in name.bytes() {
        h ^= u64::from(b);
        h = h.wrapping_mul(0x100000001b3);
    }
    h
}
