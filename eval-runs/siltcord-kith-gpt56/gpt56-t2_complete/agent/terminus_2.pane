raw=open('/app/idxbay/members.idx','rb').read()
assert raw[:5] == b'SILT1' and int.from_bytes(raw[5:9],'little') == 2
assert open('/app/bin/siltcord','rb').read(4) == b'\x7fELF'
print(o)
print('READY=brief-ok; ledger_count=2; binary=ELF')
PY
