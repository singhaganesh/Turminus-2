[86.110121, "o", "    if !archive.starts_with(&sealwell) || !archive.is_file() { return Err(1); }\r\n\u001b[?2004l\r"]
[86.110185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.111932, "o", "\u001b[?2004h>     let recs = read_idx(b)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let rows = hdr::scan(a)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\r\n\u001b[?2004l\r\u001b[?2004h>     if regs.len() != recs.len() { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h>     for (row, rec) in regs.iter().zip(recs.iter()) {\r\n\u001b[?2004l\r\u001b[?2004h>         if row.name != rec.name || row.hdr != rec.hdr || row.size != rec.size || row.body != rec.body {\r\n\u001b[?2004l\r\u001b[?2004h>             return Err(1);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.1121, "o", "    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n\u001b[?2004l\r"]
[86.112194, "o", "\u001b[?2004h> "]
[86.112274, "o", "    let mut events = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.112346, "o", "> "]
[86.112417, "o", "    let mut names = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.112545, "o", "    for (row, rec) in regs.iter().zip(recs.iter()) {\r\n\u001b[?2004l\r"]
[86.112613, "o", "\u001b[?2004h> "]
[86.112693, "o", "        let blob = hdr::load_body(a, row)?;\r\n\u001b[?2004l\r"]
[86.112759, "o", "\u001b[?2004h> "]
[86.112839, "o", "        let name = alias::fold(&rec.name);\r\n\u001b[?2004l\r"]
[86.112941, "o", "\u001b[?2004h> "]
[86.113057, "o", "        names.push(name.clone());\r\n\u001b[?2004l\r"]
[86.11319, "o", "\u001b[?2004h> "]
[86.113288, "o", "        if name == \"etc/sys.conf\" || name.ends_with(\"/sys.conf\") {\r\n\u001b[?2004l\r"]
[86.11335, "o", "\u001b[?2004h> "]
[86.11342, "o", "            confs.push((name, rec.hdr, blob));\r\n\u001b[?2004l\r"]
[86.113474, "o", "\u001b[?2004h> "]
[86.113598, "o", "        } else if name == \"var/log/app.log\" || name.ends_with(\"/app.log\") {\r\n\u001b[?2004l\r"]
[86.113698, "o", "\u001b[?2004h> "]
[86.113777, "o", "            for line in String::from_utf8_lossy(&blob).lines() {\r\n\u001b[?2004l\r"]
[86.113833, "o", "\u001b[?2004h> "]
[86.113903, "o", "                let value = line.trim();\r\n\u001b[?2004l\r"]
[86.113946, "o", "\u001b[?2004h> "]
[86.114081, "o", "                if !value.is_empty() { events.push(value.to_string()); }\r\n\u001b[?2004l\r"]
[86.114139, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[86.114186, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[86.114235, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.11432, "o", "    confs.sort_by_key(|row| row.1);\r\n\u001b[?2004l\r"]
[86.114386, "o", "\u001b[?2004h> "]
[86.114454, "o", "    let picked = first::keep_head(&confs).ok_or(1)?;\r\n\u001b[?2004l\r"]
[86.114507, "o", "\u001b[?2004h> "]
[86.114562, "o", "    let map = kv::pairs(picked);\r\n\u001b[?2004l\r"]
[86.114618, "o", "\u001b[?2004h> "]
[86.114697, "o", "    let timezone = map.get(\"timezone\").cloned().ok_or(1)?;\r\n\u001b[?2004l\r"]
[86.114748, "o", "\u001b[?2004h> "]
[86.11484, "o", "    let cluster = map.get(\"cluster\").cloned().ok_or(1)?;\r\n\u001b[?2004l\r"]
[86.114932, "o", "\u001b[?2004h> "]
[86.114978, "o", "    events.sort();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.115106, "o", "    events.dedup();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.115243, "o", "    let source = archive.file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.115284, "o", "> "]
[86.115393, "o", "    let walk_sig = digest(&names.join(\"\\n\"))?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.11558, "o", "    Ok(Pack { t: timezone, c: cluster, e: events, n: recs.len() as u32, s: source, w: walk_sig })\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.11562, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.115661, "o", "RS\r\n\u001b[?2004l\r"]
[86.116915, "o", "\u001b[?2004hroot@b43babc1fdb0:/app# "]
