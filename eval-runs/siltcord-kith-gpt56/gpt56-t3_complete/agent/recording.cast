[48.226672, "o", "        if &blk[257..262] != b\"ustar\" { return Err(1); }\r\n\u001b[?2004l\r"]
[48.226705, "o", "\u001b[?2004h> "]
[48.226843, "o", "        let nlen = blk[..100].iter().position(|b| *b == 0).unwrap_or(100);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.22713, "o", "        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\r\n\u001b[?2004l\r"]
[48.227223, "o", "\u001b[?2004h> "]
[48.227316, "o", "        if name.is_empty() { return Err(1); }\r\n\u001b[?2004l\r"]
[48.227344, "o", "\u001b[?2004h> "]
[48.227499, "o", "        let size = oct_u64(&blk[124..136])?;\r\n\u001b[?2004l\r"]
[48.227532, "o", "\u001b[?2004h> "]
[48.2277, "o", "        let body = off.checked_add(512).ok_or(1)?;\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.227724, "o", "> "]
[48.227914, "o", "        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\r\n\u001b[?2004l\r"]
[48.228001, "o", "\u001b[?2004h> "]
[48.228216, "o", "        let next = body.checked_add(usize::try_from(padded).map_err(|_| 1)?).ok_or(1)?;\r\n\u001b[?2004l\r"]
[48.228282, "o", "\u001b[?2004h> "]
[48.228539, "o", "        if next > raw.len() || body.checked_add(usize::try_from(size).map_err(|_| 1)?).ok_or(1)? > raw.len() {\r\n\u001b[?2004l\r"]
[48.228587, "o", "\u001b[?2004h> "]
[48.228642, "o", "            return Err(1);\r\n\u001b[?2004l\r"]
[48.228687, "o", "\u001b[?2004h> "]
[48.228742, "o", "        }\r\n\u001b[?2004l\r"]
[48.22879, "o", "\u001b[?2004h> "]
[48.229027, "o", "        rows.push(Row { name, hdr: off as u64, size, body: body as u64, flag: blk[156] });\r\n\u001b[?2004l\r"]
[48.229099, "o", "\u001b[?2004h> "]
[48.229157, "o", "        off = next;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.2292, "o", "    }\r\n\u001b[?2004l\r"]
[48.229241, "o", "\u001b[?2004h> "]
[48.229358, "o", "    if rows.is_empty() || !ended { return Err(1); }\r\n\u001b[?2004l\r"]
[48.22943, "o", "\u001b[?2004h> "]
[48.229495, "o", "    Ok(rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.229535, "o", "> }\r\n\u001b[?2004l\r"]
[48.229573, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[48.229613, "o", "\u001b[?2004h> "]
[48.229767, "o", "pub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.22981, "o", "> "]
[48.229933, "o", "    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[48.229977, "o", "\u001b[?2004h> "]
[48.230095, "o", "    let s = usize::try_from(row.body).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[48.230136, "o", "\u001b[?2004h> "]
[48.230261, "o", "    let n = usize::try_from(row.size).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[48.230306, "o", "\u001b[?2004h> "]
[48.230399, "o", "    let e = s.checked_add(n).ok_or(1)?;\r\n\u001b[?2004l\r"]
[48.230438, "o", "\u001b[?2004h> "]
[48.230527, "o", "    if e > raw.len() { return Err(1); }\r\n\u001b[?2004l\r"]
[48.230566, "o", "\u001b[?2004h> "]
[48.230633, "o", "    Ok(raw[s..e].to_vec())\r\n\u001b[?2004l\r"]
[48.230684, "o", "\u001b[?2004h"]
[48.230767, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[48.232132, "o", "\u001b[?2004hroot@b43babc1fdb0:/app# "]
[48.232284, "o", "cat > /app/idxmill/shard.rs <<'RS'\r\n\u001b[?2004l\r"]
[48.23236, "o", "\u001b[?2004h> use super::hdr;\r\n"]
[48.232433, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.232567, "o", "pub fn rib_a(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.232651, "o", "> "]
[48.232748, "o", "    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\r\n\u001b[?2004l\r"]
[48.232809, "o", "\u001b[?2004h> "]
[48.232898, "o", "    let regs: Vec<&hdr::Row> = rows.iter()\r\n\u001b[?2004l\r"]
[48.232959, "o", "\u001b[?2004h> "]
[48.233073, "o", "        .filter(|r| r.flag == b'0' || r.flag == 0)\r\n\u001b[?2004l\r"]
[48.233099, "o", "\u001b[?2004h> "]
[48.233189, "o", "        .collect();\r\n\u001b[?2004l\r"]
[48.233254, "o", "\u001b[?2004h> "]
[48.233319, "o", "    let mut out = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.233406, "o", "    out.extend_from_slice(b\"SILT1\");\r\n\u001b[?2004l\r"]
[48.233477, "o", "\u001b[?2004h> "]
[48.233573, "o", "    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\r\n\u001b[?2004l\r"]
[48.233632, "o", "\u001b[?2004h> "]
[48.233689, "o", "    for r in regs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.23377, "o", "        let nb = r.name.as_bytes();\r\n\u001b[?2004l\r"]
[48.233833, "o", "\u001b[?2004h> "]
[48.23394, "o", "        if nb.len() > u16::MAX as usize { return 1; }\r\n\u001b[?2004l\r"]
[48.234008, "o", "\u001b[?2004h> "]
[48.234093, "o", "        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n\u001b[?2004l\r"]
[48.234153, "o", "\u001b[?2004h> "]
[48.234244, "o", "        out.extend_from_slice(&r.size.to_le_bytes());\r\n\u001b[?2004l\r"]
[48.234301, "o", "\u001b[?2004h> "]
[48.234401, "o", "        out.extend_from_slice(&r.body.to_le_bytes());\r\n\u001b[?2004l\r"]
[48.234462, "o", "\u001b[?2004h> "]
[48.234583, "o", "        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\r\n\u001b[?2004l\r"]
[48.234662, "o", "\u001b[?2004h> "]
[48.234732, "o", "        out.extend_from_slice(nb);\r\n\u001b[?2004l\r"]
[48.234787, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.234998, "o", "    if let Some(parent) = std::path::Path::new(b).parent() {\r\n\u001b[?2004l\r"]
[48.235051, "o", "\u001b[?2004h"]
[48.235101, "o", "> "]
[48.235187, "o", "        if std::fs::create_dir_all(parent).is_err() { return 1; }\r\n\u001b[?2004l\r"]
[48.235246, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[48.235297, "o", "\u001b[?2004h> "]
[48.235422, "o", "    if std::fs::write(b, out).is_err() { 1 } else { 0 }\r\n\u001b[?2004l\r"]
[48.23549, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[48.235539, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[48.236969, "o", "\u001b[?2004hroot@b43babc1fdb0:/app# "]
[86.099765, "i", "cat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, hdr: u64, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        let end = i.checked_add(nl).ok_or(1)?;\n        if end > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..end]).map_err(|_| 1)?.to_string();\n        i = end;\n        out.push(Rec { name, hdr, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let result = child.wait_with_output().map_err(|_| 1)?;\n    if !result.status.success() { return Err(1); }\n    let s = std::str::from_utf8(&result.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) { return Err(1); }\n    Ok(s)\n}\n\n#[path = \"../keeppit/first.rs\"] mod first;\n#[path = \"../cfgbag/kv.rs\"] mod kv;\n#[path = \"../cfgbag/alias.rs\"] mod alias;\n#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let archive = std::fs::canonicalize(a).map_err(|_| 1)?;\n    let sealwell = std::fs::canonicalize(\"/app/sealwell\").map_err(|_| 1)?;\n    if !archive.starts_with(&sealwell) || !archive.is_file() { return Err(1); }\n\n    let recs = read_idx(b)?;\n    let rows = hdr::scan(a)?;\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    if regs.len() != recs.len() { return Err(1); }\n    for (row, rec) in regs.iter().zip(recs.iter()) {\n        if row.name != rec.name || row.hdr != rec.hdr || row.size != rec.size || row.body != rec.body {\n            return Err(1);\n        }\n    }\n\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut events = Vec::new();\n    let mut names = Vec::new();\n    for (row, rec) in regs.iter().zip(recs.iter()) {\n        let blob = hdr::load_body(a, row)?;\n        let name = alias::fold(&rec.name);\n        names.push(name.clone());\n        if name == \"etc/sys.conf\" || name.ends_with(\"/sys.conf\") {\n            confs.push((name, rec.hdr, blob));\n        } else if name == \"var/log/app.log\" || name.ends_with(\"/app.log\") {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let value = line.trim();\n                if !value.is_empty() { events.push(value.to_string()); }\n            }\n        }\n    }\n    confs.sort_by_key(|row| row.1);\n    let picked = first::keep_head(&confs).ok_or(1)?;\n    let map = kv::pairs(picked);\n    let timezone = map.get(\"timezone\").cloned().ok_or(1)?;\n    let cluster = map.get(\"cluster\").cloned().ok_or(1)?;\n    events.sort();\n    events.dedup();\n    let source = archive.file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    let walk_sig = digest(&names.join(\"\\n\"))?;\n    Ok(Pack { t: timezone, c: cluster, e: events, n: recs.len() as u32, s: s"]
[86.099823, "i", "ource, w: walk_sig })\n}\nRS\npython3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")', 'std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\nopen(p,'w').write(s)\np='/app/siltcli/boot.rs'\ns=open(p).read()\ns=s.replace('    let mut args = std::env::args();', '    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\\n    let mut args = std::env::args();')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\n"]
