[18.242446, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r=== artifacts ===\r\n--- /app/deskjson/READY\r\n"]
[18.243776, "o", "ok\r\n"]
[18.244776, "o", "\r\n--- /app/deskjson/pass-a.json\r\n"]
[18.246129, "o", "{\"timezone\":\"Etc/UTC\",\"cluster\":\"staging\",\"log_events\":[\"EVT_BOOT\"],\"member_count\":2,\"source_kith\":\"/app/sealwell/kestrel.kith\",\"walk_sig\":\"97556D80F429ACAF29D38332B336D237919E1B97D121E86CA2BD194FB1E5519B\"}\r\n"]
[18.246342, "o", "\r\n"]
[18.246472, "o", "--- /app/idxbay/README.txt\r\n"]
[18.247242, "o", "quarry writes members.idx from a kith under sealwell.\r\nbrief reads that ledger and writes a JSON object.\r\n\r\nSealed original: /app/seed/sealwell/kestrel.kith\r\nOutside copy used only as a rejected path: /tmp/kestrel.kith\r\nJunk ledger bytes: xxxx\r\nNon-ustar quarry sample: not-an-archive\r\nwalk_sig uses hashlib.sha256\r\n"]
[18.247368, "o", "\r\n"]
[18.247443, "o", "--- /app/idxbay/members.idx\r\n"]
[18.248137, "o", "SILT1\u0006\u0000\u0000\u0000\u0000\f\u0000\u0000\u0000\u0000\u0000\u0000'\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u000e\u0000\u0000\u0000\u0000\u0000\u0000\u000e\u0000./etc/sys.conf\u0000\u0004\u0000\u0000\u0000\u0000\u0000\u0000\t\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0006\u0000\u0000\u0000\u0000\u0000\u0000\u000f\u0000var/log/app.log\u0000\u0010\u0000\u0000\u0000\u0000\u0000\u0000\u000b\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0012\u0000\u0000\u0000\u0000\u0000\u0000\u000f\u0000var/log/app.log\u0000\u0018\u0000\u0000\u0000\u0000\u0000\u0000\u0006\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u001a\u0000\u0000\u0000\u0000\u0000\u0000\u0010\u0000opt/app/build.id\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000!\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0002\u0000\u0000\u0000\u0000\u0000\u0000\f\u0000etc/sys.conf\u0000\u0014\u0000\u0000\u0000\u0000\u0000\u0000\u0014\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0016\u0000\u0000\u0000\u0000\u0000\u0000\t\u0000etc/hosts"]
