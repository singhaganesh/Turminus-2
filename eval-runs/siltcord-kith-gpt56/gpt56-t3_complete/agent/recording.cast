[48.07747, "o", "mod kv;\r\n#[path = \"../cfgbag/alias.rs\"]\r\nmod alias;\r\n\r\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    let recs = read_idx(b)?;\r\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    for (i, r) in recs.iter().enumerate() {\r\n        bag.insert(i, r.name.clone());\r\n        let blob = load(a, r.body, r.size)?;\r\n        if r.name.contains(\"sys.conf\") {\r\n            confs.push((r.name.clone(), r.hdr, blob));\r\n        } else if r.name.contains(\"app.log\") {\r\n            logs.push(blob);\r\n        }\r\n    }\r\n    confs.sort_by_key(|row| row.1);\r\n    let picked = first::keep_head(&confs);\r\n    let mut t = String::new();\r\n    let mut c = String::new();\r\n    if let Some(blob) = picked {\r\n        let map = kv::pairs(&blob);\r\n        if let Some(v) = map.get(\"timezone\") {\r\n            t = v.clone();\r\n        }\r\n        if let Some(v) = map.get(\"cluster\") {\r\n            c = v.clone();\r\n        }\r\n    }\r\n    let mut e = Vec::new();\r\n    if let Some(blob) = logs.first() {"]
[48.077691, "o", "\r\n        for line in String::from_utf8_lossy(blob).lines() {\r\n            let s = line.trim();\r\n            if !s.is_empty() {\r\n                e.push(s.to_string());\r\n            }\r\n        }\r\n    }\r\n    e.sort();\r\n    e.dedup();\r\n    let names: Vec<String> = bag.values().cloned().collect();\r\n    let walk = names.join(\"\\n\");\r\n    let _ = alias::fold(\"\");\r\n    Ok(Pack {\r\n        t,\r\n        c,\r\n        e,\r\n        n: confs.len() as u32,\r\n        s: a.to_string(),\r\n        w: digest(&walk).to_ascii_uppercase(),\r\n    })\r\n}\r\n"]
[48.078063, "o", "\u001b[?2004hroot@b43babc1fdb0:/app# "]
[48.222124, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// A validated ustar member header.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let field = buf.split(|b| *b == 0).next().unwrap_or(buf);\n    let text = std::str::from_utf8(field).map_err(|_| 1)?.trim();\n    if text.is_empty() { return Ok(0); }\n    u64::from_str_radix(text, 8).map_err(|_| 1)\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off.checked_add(512).ok_or(1)? <= raw.len() {\n        let blk = &raw[off..off + 512];\n        if blk.iter().all(|b| *b == 0) {\n            ended = true;\n            break;\n        }\n        if &blk[257..262] != b\"ustar\" { return Err(1); }\n        let nlen = blk[..100].iter().position(|b| *b == 0).unwrap_or(100);\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        if name.is_empty() { return Err(1); }\n        let size = oct_u64(&blk[124..136])?;\n        let body = off.checked_add(512).ok_or(1)?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = body.checked_add(usize::try_from(padded).map_err(|_| 1)?).ok_or(1)?;\n        if next > raw.len() || body.checked_add(usize::try_from(size).map_err(|_| 1)?).ok_or(1)? > raw.len() {\n            return Err(1);\n        }\n        rows.push(Row { name, hdr: off as u64, size, body: body as u64, flag: blk[156] });\n        off = next;\n    }\n    if rows.is_empty() || !ended { return Err(1); }\n    Ok(rows)\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let n = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let regs: Vec<&hdr::Row> = rows.iter()\n        .filter(|r| r.flag == b'0' || r.flag == 0)\n        .collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    if let Some(parent) = std::path::Path::new(b).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    if std::fs::write(b, out).is_err() { 1 } else { 0 }\n}\nRS\n"]
[48.222709, "o", "cat > /app/ustarwalk/hdr.rs <<'RS'\r\n\u001b[?2004l\r"]
