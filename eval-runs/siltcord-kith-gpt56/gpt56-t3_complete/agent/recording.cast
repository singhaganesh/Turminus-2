[17.323503, "o", "    95\t    let recs = read_idx(b)?;\r\n    96\t    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    97\t    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n"]
[17.323519, "o", "    98\t    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    99\t    for (i, r) in recs.iter().enumerate() {\r\n   100\t        bag.insert(i, r.name.clone());\r\n   101\t        let blob = load(a, r.body, r.size)?;\r\n"]
[17.323868, "o", "   102\t        if r.name.contains(\"sys.conf\") {\r\n   103\t            confs.push((r.name.clone(), r.hdr, blob));\r\n   104\t        } else if r.name.contains(\"app.log\") {\r\n   105\t            logs.push(blob);\r\n   106\t        }\r\n"]
[17.324014, "o", "   107\t    }\r\n   108\t    confs.sort_by_key(|row| row.1);\r\n   109\t    let picked = first::keep_head(&confs);\r\n   110\t    let mut t = String::new();\r\n   111\t    let mut c = String::new();\r\n   112\t    if let Some(blob) = picked {\r\n   113\t        let map = kv::pairs(&blob);\r\n   114\t        if let Some(v) = map.get(\"timezone\") {\r\n   115\t            t = v.clone();\r\n   116\t        }\r\n   117\t        if let Some(v) = map.get(\"cluster\") {\r\n   118\t            c = v.clone();\r\n   119\t        }\r\n   120\t    }\r\n   121\t    let mut e = Vec::new();\r\n   122\t    if let Some(blob) = logs.first() {\r\n   123\t        for line in String::from_utf8_lossy(blob).lines() {\r\n   124\t            let s = line.trim();\r\n   125\t            if !s.is_empty() {\r\n   126\t                e.push(s.to_string());\r\n   127\t            }\r\n   128\t        }\r\n   129\t    }\r\n   130\t    e.sort();\r\n   131\t    e.dedup();\r\n   132\t    let names: Vec<String> = bag.values().cloned().collect();\r\n   133\t    let walk = names.join(\"\\n\");\r\n   134\t    let _ = alias::fold(\"\");\r\n   135\t    Ok(Pack {\r\n   136\t        t,\r\n   137\t        c,\r\n   138\t        e,\r\n   139\t        n: confs.len() as u32,\r\n   140\t        s: a.to_string(),\r\n   141\t        w: digest(&walk).to_ascii_uppercase(),\r\n   142\t    })\r\n   143\t}\r\n"]
[17.32411, "o", "===== /app/idxmill/shard.rs =====\r\n"]
[17.325498, "o", "     1\tuse super::hdr;\r\n     2\t\r\n     3\t#[path = \"../pidhash/seed.rs\"]\r\n     4\tmod seed;\r\n     5\t#[path = \"../ustarwalk/block.rs\"]\r\n     6\tmod walk;\r\n     7\t\r\n     8\tpub fn rib_a(a: &str, b: &str) -> i32 {\r\n     9\t    let mut rows = match hdr::scan(a) {\r\n    10\t        Ok(x) => x,\r\n    11\t        Err(_) => Vec::new(),\r\n    12\t    };\r\n    13\t    rows.sort_by_key(|r| seed::mix(&r.name));\r\n    14\t    let regs: Vec<&hdr::Row> = rows\r\n    15\t        .iter()\r\n    16\t        .filter(|r| r.flag == b'0' || r.flag == 0)\r\n    17\t        .collect();\r\n    18\t    let mut out = Vec::new();\r\n    19\t    out.extend_from_slice(b\"SILT1\");\r\n    20\t    let n = regs.len() as u32;\r\n    21"]
[17.325737, "o", "\t    out.extend_from_slice(&n.to_le_bytes());\r\n    22\t    for r in regs {\r\n    23\t        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n    24\t        out.extend_from_slice(&r.size.to_le_bytes());\r\n    25\t        out.extend_from_slice(&r.body.to_le_bytes());\r\n    26\t        let nb = r.name.as_bytes();\r\n    27\t        let nl = nb.len() as u16;\r\n    28\t        out.extend_from_slice(&nl.to_le_bytes());\r\n    29\t        out.extend_from_slice(nb);\r\n    30\t        let _ = walk::span(r.size);\r\n    31\t    }\r\n    32\t    if std::fs::write(b, out).is_err() {\r\n    33\t        return 1;\r\n    34\t    }\r\n    35\t    0\r\n    36\t}\r\n"]
[17.326039, "o", "===== /app/siltcli/boot.rs =====\r\n"]
[17.327577, "o", "     1\t#[path = \"quarry.rs\"]\r\n     2\tmod quarry;\r\n     3\t#[path = \"slate.rs\"]\r\n     4\tmod slate;\r\n     5\t\r\n     6\tfn main() {\r\n     7\t    let mut args = std::env::args();\r\n     8\t    let _ = args.next();\r\n     9\t    let cmd = args.next().unwrap_or_default();\r\n    10\t    let code = match cmd.as_str() {\r\n    11\t        \"quarry\" => {\r\n    12\t            let a = args\r\n    13\t                .next()\r\n    14\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    15\t            let b = args\r\n"]
[17.327814, "o", "    16\t                .next()\r\n    17\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    18\t            quarry::go(&a, &b)\r\n    19\t        }\r\n    20\t        \"brief\" => {\r\n    21\t            let out = match args.next() {\r\n    22\t                Some(x) => x,\r\n    23\t                None => {\r\n    24\t                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n    25\t                    std::process::exit(2);\r\n    26\t                }\r\n    27\t            };\r\n    28\t            let a = args\r\n    29\t                .next()\r\n    30\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    31\t            let b = args\r\n    32\t                .next()\r\n    33\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    34\t            slate::go(&out, &a, &b)\r\n    35\t        }\r\n    36\t        _ => {\r\n    37\t            eprintln!(\"usage: siltcord quarry|brief\");\r\n    38\t            2\r\n    39\t        }\r\n    40\t    };\r\n    41\t    std::process::exit(code);\r\n    42\t}\r\n"]
[17.328198, "o", "===== /app/siltcli/quarry.rs =====\r\n"]
[17.329241, "o", "     1\t#[path = \"../ustarwalk/hdr.rs\"]\r\n     2\tmod hdr;\r\n     3\t#[path = \"../idxmill/shard.rs\"]\r\n     4\tmod shard;\r\n     5\t\r\n     6\tpub fn go(a: &str, b: &str) -> i32 {\r\n     7\t    shard::rib_a(a, b)\r\n     8\t}\r\n"]
[17.329419, "o", "===== /app/siltcli/slate.rs =====\r\n"]
[17.330379, "o", "     1\t#[path = \"../overlaypit/blend.rs\"]\r\n     2\tmod blend;\r\n     3\t#[path = \"../logbag/write.rs\"]\r\n     4\tmod uni;\r\n     5\t\r\n     6\tpub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n     7\t    match blend::rib_b(a, b) {\r\n     8\t        Ok(p) => uni::rib_c(&p, out, a),\r\n     9\t        Err(c) => c,\r\n    10\t    }\r\n    11\t}\r\n"]
[17.330581, "o", "\u001b[?2004hroot@b43babc1fdb0:/app# "]
[18.239921, "i", "echo '=== artifacts ==='; for f in /app/deskjson/* /app/idxbay/*; do echo \"--- $f\"; cat \"$f\"; echo; done; echo '=== ELF magic ==='; od -An -tx1 -N4 /app/bin/siltcord; echo '=== archive ==='; python3 - <<'PY'\nimport tarfile\np='/app/sealwell/kestrel.kith'\nwith tarfile.open(p, 'r:') as t:\n for m in t.getmembers():\n  print(repr(m.name), m.size, m.type, repr(t.extractfile(m).read() if m.isfile() else None))\nPY\n"]
