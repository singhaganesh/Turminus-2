[217.304872, "i", "rm -f /app/deskjson/READY; /app/bin/siltcord quarry; q=$?; /app/bin/siltcord brief /app/deskjson/pass-a.json; a=$?; /app/bin/siltcord brief /app/deskjson/pass-b.json; b=$?; echo \"statuses quarry=$q brief_a=$a brief_b=$b\"; python3 - <<'PY'\nimport json\nexpected = {\n 'timezone':'Etc/UTC',\n 'cluster':'staging',\n 'log_events':['EVT_BOOT'],\n 'member_count':2,\n 'source_kith':'kestrel.kith',\n 'walk_sig':'5b240ea8c8f9b5f32f5e93e77376daeb5bf6e6930d836d9dc0b0f893e23c0419',\n}\na=json.load(open('/app/deskjson/pass-a.json'))\nb=json.load(open('/app/deskjson/pass-b.json'))\nprint('pass-a',a)\nprint('pass-b',b)\nassert a == b == expected\nassert open('/app/deskjson/READY','rb').read() == b'brief-ok'\nassert open('/app/bin/siltcord','rb').read(4) == b'\\x7fELF'\nprint('all final assertions passed')\nPY\n"]
