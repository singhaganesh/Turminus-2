[107.264529, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.264578, "o", "fn load''','''    if i != raw.len() { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.266121, "o", ">     Ok(out)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn load''')\r\n\u001b[?2004l\r\u001b[?2004h> start=s.index('pub fn rib_b(')\r\n\u001b[?2004l\r\u001b[?2004h> new=r'''pub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let recs = read_idx(b)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut logs: Vec<Vec<u8>> = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut names: Vec<String> = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for r in &recs {\r\n\u001b[?2004l\r\u001b[?2004h>         names.push(r.name.clone());\r\n\u001b[?2004l\r\u001b[?2004h>         let blob = load(a, r.body, r.size)?;\r\n\u001b[?2004l\r\u001b[?2004h>         if r.name.contains(\"sys.conf\") {\r\n\u001b[?2004l\r\u001b[?2004h>             confs.push((r.name.clone(), r.hdr, blob));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.266248, "o", "        } else if r.name.contains(\"app.log\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.266343, "o", "            logs.push(blob);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.266392, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.266425, "o", ">     }\r\n\u001b[?2004l\r"]
[107.266459, "o", "\u001b[?2004h> "]
[107.267049, "o", "    confs.sort_by_key(|row| row.1);\r\n"]
[107.267152, "o", "\u001b[?2004l\r\u001b[?2004h>     let picked = first::keep_head(&confs);\r\n\u001b[?2004l\r\u001b[?2004h>     let mut t = String::new();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut c = String::new();\r\n\u001b[?2004l\r\u001b[?2004h>     if let Some(blob) = picked {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.267266, "o", "        let map = kv::pairs(blob);\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.267359, "o", "> "]
[107.267473, "o", "        if let Some(v) = map.get(\"timezone\") { t = v.clone(); }\r\n\u001b[?2004l\r"]
[107.267554, "o", "\u001b[?2004h> "]
[107.26768, "o", "        if let Some(v) = map.get(\"cluster\") { c = v.clone(); }\r\n\u001b[?2004l\r"]
[107.267759, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.267862, "o", "    let mut e = Vec::new();\r\n\u001b[?2004l\r"]
[107.267942, "o", "\u001b[?2004h> "]
[107.26804, "o", "    for blob in &logs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.268183, "o", "        for line in String::from_utf8_lossy(blob).lines() {\r\n\u001b[?2004l\r"]
[107.268268, "o", "\u001b[?2004h> "]
[107.268372, "o", "            let value = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.268537, "o", "            if !value.is_empty() { e.push(value.to_string()); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.268645, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[107.268768, "o", "\u001b[?2004h>     e.sort();\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.268874, "o", ">     e.dedup();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.268971, "o", "    let walk = names.join(\"\\n\");\r\n\u001b[?2004l\r"]
[107.269073, "o", "\u001b[?2004h> "]
[107.269173, "o", "    let source = std::path::Path::new(a).file_name()\r\n\u001b[?2004l\r"]
[107.269264, "o", "\u001b[?2004h> "]
[107.269348, "o", "        .and_then(|x| x.to_str()).ok_or(1)?.to_string();\r\n\u001b[?2004l\r"]
[107.269426, "o", "\u001b[?2004h> "]
[107.269517, "o", "    let _ = alias::fold(\"\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.269586, "o", "    let sig = digest(&walk);\r\n\u001b[?2004l\r"]
[107.269664, "o", "\u001b[?2004h> "]
[107.269849, "o", "    if sig.len() != 64 || !sig.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) {\r\n\u001b[?2004l\r"]
[107.26992, "o", "\u001b[?2004h> "]
[107.269963, "o", "        return Err(1);\r\n\u001b[?2004l\r"]
[107.270019, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[107.270068, "o", "\u001b[?2004h> "]
[107.270213, "o", "    Ok(Pack { t, c, e, n: recs.len() as u32, s: source, w: sig })\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.270292, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[107.27036, "o", "\u001b[?2004h> "]
[107.270427, "o", "open(p,'w').write(s[:start]+new)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n"]
[107.270494, "o", "\u001b[?2004l\r"]
[107.288008, "o", "\u001b[?2004hroot@a174e3775f42:/app# "]
[107.288192, "o", "cat > /app/siltcli/quarry.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.288296, "o", "#[path = \"../ustarwalk/hdr.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.288408, "o", "mod hdr;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.288537, "o", "#[path = \"../idxmill/shard.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.288651, "o", "mod shard;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[107.288774, "o", "\u001b[?2004h> "]
[107.288874, "o", "pub fn go(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.289014, "o", "    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.289127, "o", "    shard::rib_a(a, b)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n"]
[107.289231, "o", "\u001b[?2004l\r"]
[107.290461, "o", "\u001b[?2004hroot@a174e3775f42:/app# "]
[107.290574, "o", "cat > /app/siltcli/slate.rs <<'RS'\r\n\u001b[?2004l\r"]
[107.290616, "o", "\u001b[?2004h> "]
[107.290713, "o", "#[path = \"../overlaypit/blend.rs\"]\r\n\u001b[?2004l\r"]
[107.290754, "o", "\u001b[?2004h> "]
[107.2908, "o", "mod blend;\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.290857, "o", "> "]
[107.291134, "o", "#[path = \"../logbag/write.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod uni;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../ustarwalk/hdr.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod hdr;\r\n\u001b[?2004l\r"]
[107.291237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.291334, "o", "pub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.291493, "o", "    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.291725, "o", "    let archive = match std::fs::canonicalize(a) { Ok(p) => p, Err(_) => return 1 };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.291983, "o", "    let sealwell = match std::fs::canonicalize(\"/app/sealwell\") { Ok(p) => p, Err(_) => return 1 };\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.292139, "o", "> "]
[107.292338, "o", "    if !archive.starts_with(&sealwell) || archive.parent() != Some(sealwell.as_path()) { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[107.292466, "o", "    if hdr::scan(a).is_err() { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.292569, "o", ">     match blend::rib_b(a, b) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[107.292696, "o", "> "]
[107.292932, "o", "        Ok(p) => uni::rib_c(&p, out, a),\r\n\u001b[?2004l\r\u001b[?2004h>         Err(c) => c,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[107.293077, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[107.294695, "o", "\u001b[?2004hroot@a174e3775f42:/app# "]
[107.294846, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/logbag/write.rs'\r\n\u001b[?2004l\r"]
[107.294959, "o", "\u001b[?2004h> "]
[107.295233, "o", "s=open(p).read().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")','std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\r\n\u001b[?2004l\r"]
[107.295276, "o", "\u001b[?2004h> "]
[107.295318, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r"]
[107.29536, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
