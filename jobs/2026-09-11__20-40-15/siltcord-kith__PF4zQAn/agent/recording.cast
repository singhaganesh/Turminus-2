[107.095682, "o", "        Err(c) => return c,\r\n\u001b[?2004l\r\u001b[?2004h>     };''')\r\n"]
[107.09576, "o", "\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r"]
