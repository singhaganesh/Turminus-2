[107.124853, "o", "\u001b[?2004hroot@a174e3775f42:/app# "]
[107.262607, "i", "python3 - <<'PY'\np='/app/overlaypit/blend.rs'\ns=open(p).read()\ns=s.replace('''      Ok(out)\n  }\n\n  fn load''','''      if i != raw.len() { return Err(1); }\n      Ok(out)\n  }\n\n  fn load''')\n# Account for actual four-space indentation if replacement above misses.\ns=s.replace('''    Ok(out)\n}\n\nfn load''','''    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn load''')\nstart=s.index('pub fn rib_b(')\nnew=r'''pub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut logs: Vec<Vec<u8>> = Vec::new();\n    let mut names: Vec<String> = Vec::new();\n    for r in &recs {\n        names.push(r.name.clone());\n        let blob = load(a, r.body, r.size)?;\n        if r.name.contains(\"sys.conf\") {\n            confs.push((r.name.clone(), r.hdr, blob));\n        } else if r.name.contains(\"app.log\") {\n            logs.push(blob);\n        }\n    }\n    confs.sort_by_key(|row| row.1);\n    let picked = first::keep_head(&confs);\n    let mut t = String::new();\n    let mut c = String::new();\n    if let Some(blob) = picked {\n        let map = kv::pairs(blob);\n        if let Some(v) = map.get(\"timezone\") { t = v.clone(); }\n        if let Some(v) = map.get(\"cluster\") { c = v.clone(); }\n    }\n    let mut e = Vec::new();\n    for blob in &logs {\n        for line in String::from_utf8_lossy(blob).lines() {\n            let value = line.trim();\n            if !value.is_empty() { e.push(value.to_string()); }\n        }\n    }\n    e.sort();\n    e.dedup();\n    let walk = names.join(\"\\n\");\n    let source = std::path::Path::new(a).file_name()\n        .and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    let _ = alias::fold(\"\");\n    let sig = digest(&walk);\n    if sig.len() != 64 || !sig.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) {\n        return Err(1);\n    }\n    Ok(Pack { t, c, e, n: recs.len() as u32, s: source, w: sig })\n}\n'''\nopen(p,'w').write(s[:start]+new)\nPY\ncat > /app/siltcli/quarry.rs <<'RS'\n#[path = \"../ustarwalk/hdr.rs\"]\nmod hdr;\n#[path = \"../idxmill/shard.rs\"]\nmod shard;\n\npub fn go(a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    shard::rib_a(a, b)\n}\nRS\ncat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"]\nmod blend;\n#[path = \"../logbag/write.rs\"]\nmod uni;\n#[path = \"../ustarwalk/hdr.rs\"]\nmod hdr;\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    let archive = match std::fs::canonicalize(a) { Ok(p) => p, Err(_) => return 1 };\n    let sealwell = match std::fs::canonicalize(\"/app/sealwell\") { Ok(p) => p, Err(_) => return 1 };\n    if !archive.starts_with(&sealwell) || archive.parent() != Some(sealwell.as_path()) { return 1; }\n    if hdr::scan(a).is_err() { return 1; }\n    match blend::rib_b(a, b) {\n        Ok(p) => uni::rib_c(&p, out, a),\n        Err(c) => c,\n    }\n}\nRS\npython3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")','std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\nopen(p,'w').write(s)\nPY\n"]
[107.262886, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
