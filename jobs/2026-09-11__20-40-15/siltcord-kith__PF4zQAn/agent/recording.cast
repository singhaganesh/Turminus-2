[107.263292, "o", "\u001b[?2004h> s=s.replace('''      Ok(out)\r\n\u001b[?2004l\r"]
[107.263411, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
