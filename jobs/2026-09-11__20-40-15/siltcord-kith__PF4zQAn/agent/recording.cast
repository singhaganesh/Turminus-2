[52.760554, "o", "     1\t#[path = \"quarry.rs\"]\r\n     2\tmod quarry;\r\n     3\t#[path = \"slate.rs\"]\r\n     4\tmod slate;\r\n     5\t\r\n     6\tfn main() {\r\n     7\t    let mut args = std::env::args();\r\n     8\t    let _ = args.next();\r\n"]
[52.760703, "o", "     9\t    let cmd = args.next().unwrap_or_default();\r\n    10\t    let code = match cmd.as_str() {\r\n    11\t        \"quarry\" => {\r\n    12\t            let a = args\r\n    13\t                .next()\r\n    14\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    15\t            let b = args\r\n    16\t                .next()\r\n    17\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    18\t            quarry::go(&a, &b)\r\n    19\t        }\r\n    20\t        \"brief\" => {\r\n    21\t            let out = match args.next() {\r\n    22\t                Some(x) => x,\r\n    23\t                None => {\r\n    24\t                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n    25\t                    std::process::exit(2);\r\n    26\t                }\r\n    27\t            };\r\n    28\t            let a = args\r\n    29\t                .next()\r\n    30\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    31\t            let b = args\r\n    32\t                .next()\r\n    33\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    34\t            slate::go(&out, &a, &b)\r\n    35\t        }\r\n    36\t        _ => {\r\n    37\t            eprintln!(\"usage: siltcord quarry|brief\");\r\n    38\t            2\r\n    39\t        }\r\n    40\t    };\r\n    41\t    std::process::exit(code);\r\n    42\t}\r\n"]
