[252.755009, "i", "/app/bin/siltcord quarry && /app/bin/siltcord brief /app/deskjson/pass-a.json && /app/bin/siltcord brief /app/deskjson/pass-b.json && python3 - <<'PY'\nimport hashlib, json, os, tarfile\narchive='/app/sealwell/kestrel.kith'\nwith tarfile.open(archive, 'r:') as tf:\n    members=[m for m in tf if m.isfile()]\n    payloads=[(m.name, tf.extractfile(m).read()) for m in members]\nconfigs=[(i,n,b) for i,(n,b) in enumerate(payloads) if 'sys.conf' in n]\nconfig={}\nif configs:\n    for line in configs[0][2].decode().splitlines():\n        if '=' in line:\n            k,v=line.split('=',1); config[k.strip()]=v.strip()\nevents=sorted({line.strip() for n,b in payloads if 'app.log' in n for line in b.decode().splitlines() if line.strip()})\nexpected={\n    'timezone':config.get('timezone',''),\n    'cluster':config.get('cluster',''),\n    'log_events':events,\n    'member_count':len(members),\n    'source_kith':os.path.basename(archive),\n    'walk_sig':hashlib.sha256('\\n'.join(m.name for m in members).encode()).hexdigest(),\n}\na=json.load(open('/app/deskjson/pass-a.json'))\nb=json.load(open('/app/deskjson/pass-b.json'))\nprint('expected:', expected)\nprint('pass-a:', a)\nprint('pass-b:', b)\nassert a == b == expected\nassert open('/app/deskjson/READY','rb').read() == b'brief-ok'\nassert open('/app/bin/siltcord','rb').read(4) == b'\\x7fELF'\nprint('semantic, READY, and ELF checks passed')\nPY\n"]
