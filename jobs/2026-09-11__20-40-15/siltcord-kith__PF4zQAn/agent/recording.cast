[29.561587, "i", "python3 - <<'PY'\nimport tarfile, hashlib, json, os\np='/app/sealwell/kestrel.kith'\nprint('size',os.path.getsize(p))\ntry:\n with tarfile.open(p,'r:') as t:\n  names=[]\n  for m in t:\n   print(repr(m.name), 'type',repr(m.type),'size',m.size)\n   if m.isfile():\n    names.append(m.name)\n    b=t.extractfile(m).read()\n    print(' payload=',repr(b))\n  print('count',len(names))\n  print('walk_sig',hashlib.sha256('\\n'.join(names).encode()).hexdigest())\nexcept Exception as e: print(type(e).__name__,e)\nPY\n"]
[29.56181, "o", "python3 - <<'PY'\r\n"]
