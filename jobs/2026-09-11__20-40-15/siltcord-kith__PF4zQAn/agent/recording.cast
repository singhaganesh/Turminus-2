[40.862753, "i", "for f in /app/ustarwalk/hdr.rs /app/ustarwalk/block.rs /app/overlaypit/blend.rs; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\" | nl -ba; done\n"]
[40.863289, "o", "for f in /app/ustarwalk/hdr.rs /app/ustarwalk/block.rs /app/overlaypit/blend.rs; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\" | nl -ba; done\r\n\u001b[?2004l\r"]
[40.863805, "o", "===== /app/ustarwalk/hdr.rs =====\r\n"]
[40.865302, "o", "     1\t/// ustar headers are 512 bytes; payload is padded to that size.\r\n     2\tpub struct Row {\r\n     3\t    pub name: String,\r\n     4\t    pub hdr: u64,\r\n     5\t    pub size: u64,\r\n     6\t    pub body: u64,\r\n     7\t    pub flag: u8,\r\n     8\t}\r\n     9\t\r\n    10\tfn oct_u64(buf: &[u8]) -> u64 {\r\n    11\t    let mut n: u64 = 0;\r\n"]
[40.865353, "o", "    12\t    for &b in buf {\r\n    13\t        if b == 0 || b == b' ' {\r\n    14\t            continue;\r\n    15\t        }\r\n    16\t        if b >= b'0' && b <= b'7' {\r\n    17\t            n = n * 8 + u64::from(b - b'0');\r\n    18\t        }\r\n    19\t    }\r\n    20\t    n\r\n    21\t}\r\n    22\t\r\n    23\tpub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n    24\t    let raw = match std::fs::read(path) {\r\n    25\t        Ok(x) => x,\r\n    26\t        Err(_) => return Err(1),\r\n    27\t    };\r\n    28\t    if raw.len() < 512 {\r\n    29\t        return Err(1);\r\n    30\t    }\r\n    31\t    let mut rows = Vec::new();\r\n    32\t    let mut off = 0usize;\r\n    33\t"]
[40.865376, "o", "    let mut saw = false;\r\n    34\t    while off + 512 <= raw.len() {\r\n    35\t        let blk = &raw[off..off + 512];\r\n    36\t        if blk.iter().all(|b| *b == 0) {\r\n    37\t            break;\r\n    38\t        }\r\n    39\t"]
[40.865396, "o", "        let magic = &blk[257..262];\r\n    40\t        if magic != b\"ustar\" {\r\n    41\t            return Err(1);\r\n    42\t        }\r\n    43\t        saw = true;\r\n    44\t        let nlen = blk[0..100]\r\n    45\t            .iter()\r\n    46\t            .position(|b| *b == 0)\r\n"]
[40.865576, "o", "    47\t            .unwrap_or(100);\r\n    48\t        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();\r\n    49\t        let size = oct_u64(&blk[124..136]);\r\n    50\t        let flag = blk[156];\r\n"]
[40.865625, "o", "    51\t        let body = (off + 512) as u64;\r\n    52\t        rows.push(Row {\r\n    53\t            name,\r\n    54\t            hdr: off as u64,\r\n    55\t            size,\r\n    56\t            body,\r\n    57\t            flag,\r\n    58\t        });\r\n    59\t        let padded = ((size + 511) / 512) * 512;\r\n    60\t        off = off + 512 + padded as usize;\r\n    61\t    }\r\n    62\t    if !saw {\r\n    63\t        return Err(1);\r\n    64\t    }\r\n    65\t    Ok(rows)\r\n    66\t}\r\n    67\t\r\n    68\tpub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n    69\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    70\t    let s = row.body as usize;\r\n    71\t    let e = s + row.size as usize;\r\n    72\t    if e > raw.len() {\r\n    73\t        return Err(1);\r\n    74\t    }\r\n    75\t    Ok(raw[s..e].to_vec())\r\n    76\t}\r\n"]
[40.865764, "o", "===== /app/ustarwalk/block.rs =====\r\n"]
[40.86711, "o", "     1\tpub fn span(n: u64) -> u64 {\r\n     2\t    ((n + 511) / 512) * 512\r\n     3\t}\r\n"]
[40.867332, "o", "===== /app/overlaypit/blend.rs =====\r\n"]
[40.868792, "o", "     1\tpub struct Pack {\r\n     2\t    pub t: String,\r\n     3\t    pub c: String,\r\n     4\t    pub e: Vec<String>,\r\n     5\t    pub n: u32,\r\n     6\t    pub s: String,\r\n     7\t    pub w: String,\r\n     8\t}\r\n     9\t\r\n    10\tstruct Rec {\r\n    11\t    name: String,\r\n"]
[40.869054, "o", "    12\t    hdr: u64,\r\n    13\t    size: u64,\r\n    14\t    body: u64,\r\n    15\t}\r\n    16\t\r\n    17\tfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n    18\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    19\t    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" {\r\n    20\t        return Err(1);\r\n    21\t    }\r\n    22\t    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n    23\t    let mut i = 9usize;\r\n    24\t    let mut out = Vec::new();\r\n    25\t    for _ in 0..n {\r\n    26\t        if i + 26 > raw.len() {\r\n    27\t            return Err(1);\r\n    28\t        }\r\n    29\t        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    30\t        i += 8;\r\n    31\t        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    32\t        i += 8;\r\n    33\t        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    34\t        i += 8;\r\n    35\t        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;\r\n    36\t        i += 2;\r\n    37\t        if i + nl > raw.len() {\r\n    38\t            return Err(1);\r\n    39\t        }\r\n    40\t        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();\r\n    41\t        i += nl;\r\n    42\t        out.push(Rec {\r\n    43\t            name,\r\n    44\t            hdr,\r\n    45\t            size,\r\n    46\t            body,\r\n    47\t        });\r\n    48\t    }\r\n    49\t    Ok(out)\r\n    50\t}\r\n    51\t\r\n    52\tfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\r\n    53\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    54\t    let s = body as usize;\r\n    55\t    let e = s + size as usize;\r\n    56\t    if e > raw.len() {\r\n    57\t        return Err(1);\r\n"]
[40.869121, "o", "    58\t    }\r\n    59\t    Ok(raw[s..e].to_vec())\r\n    60\t}\r\n    61\t\r\n    62\tfn digest(text: &str) -> String {\r\n    63\t    let mut cmd = std::process::Command::new(\"python3\");\r\n    64\t    cmd.args([\r\n    65\t        \"-c\",\r\n    66\t        \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\",\r\n    67\t    ])\r\n    68\t    .stdin(std::process::Stdio::piped())\r\n    69\t    .stdout(std::process::Stdio::piped());\r\n    70\t    let mut child = match cmd.spawn() {\r\n    71\t        Ok(c) => c,\r\n    72\t        Err(_) => return String::new(),\r\n    73\t    };\r\n    74\t    {\r\n    75\t        use std::io::Write;\r\n    76\t        if let Some(ref mut sin) = child.stdin {\r\n    77\t            let _ = sin.write_all(text.as_bytes());\r\n    78\t        }\r\n    79\t    }\r\n    80\t    drop(child.stdin.take());\r\n    81\t    match child.wait_with_output() {\r\n"]
[40.869147, "o", "    82\t        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),\r\n    83\t        Err(_) => String::new(),\r\n    84\t    }\r\n    85\t}\r\n    86\t\r\n    87\t#[path = \"../keeppit/first.rs\"]\r\n    88\tmod first;\r\n"]
[40.869169, "o", "    89\t#[path = \"../cfgbag/kv.rs\"]\r\n    90\tmod kv;\r\n    91\t#[path = \"../cfgbag/alias.rs\"]\r\n"]
[40.869188, "o", "    92\tmod alias;\r\n    93\t\r\n    94\tpub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    95"]
[40.869205, "o", "\t    let recs = read_idx(b)?;\r\n    96\t    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    97\t    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n"]
[40.869268, "o", "    98\t    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    99\t    for (i, r) in recs.iter().enumerate() {\r\n   100\t        bag.insert(i, r.name.clone());\r\n   101\t        let blob = load(a, r.body, r.size)?;\r\n   102\t        if r.name.contains(\"sys.conf\") {\r\n   103\t            confs.push((r.name.clone(), r.hdr, blob));\r\n   104\t        } else if r.name.contains(\"app.log\") {\r\n   105\t            logs.push(blob);\r\n   106\t        }\r\n"]
[40.869318, "o", "   107\t    }\r\n   108\t    confs.sort_by_key(|row| row.1);\r\n   109\t    let picked = first::keep_head(&confs);\r\n   110\t    let mut t = String::new();\r\n   111\t    let mut c = String::new();\r\n   112\t    if let Some(blob) = picked {\r\n   113\t        let map = kv::pairs(&blob);\r\n   114\t        if let Some(v) = map.get(\"timezone\") {\r\n   115\t            t = v.clone();\r\n"]
[40.869343, "o", "   116\t        }\r\n   117\t        if let Some(v) = map.get(\"cluster\") {\r\n   118\t            c = v.clone();\r\n   119\t        }\r\n"]
[40.869363, "o", "   120\t    }\r\n   121\t    let mut e = Vec::new();\r\n   122\t    if let Some(blob) = logs.first() {\r\n"]
[40.869382, "o", "   123\t        for line in String::from_utf8_lossy(blob).lines() {\r\n   124\t            let s = line.trim();\r\n   125\t            if !s.is_empty() {\r\n   126\t                e.push(s.to_string());\r\n   127\t            }\r\n"]
[40.869407, "o", "   128\t        }\r\n   129\t    }\r\n   130\t    e.sort();\r\n"]
[40.869429, "o", "   131\t    e.dedup();\r\n   132\t    let names: Vec<String> = bag.values().cloned().collect();\r\n   133\t    let walk = names.join(\"\\n\");\r\n   134\t    let _ = alias::fold(\"\");\r\n   135\t    Ok(Pack {\r\n"]
[40.869453, "o", "   136\t        t,\r\n   137\t        c,\r\n   138\t        e,\r\n   139\t        n: confs.len() as u32,\r\n   140\t        s: a.to_string(),\r\n"]
[40.869475, "o", "   141\t        w: digest(&walk).to_ascii_uppercase(),\r\n   142\t    })\r\n   143\t}\r\n"]
[40.871339, "o", "\u001b[?2004hroot@a174e3775f42:/app# "]
[41.047898, "i", "for f in /app/siltcli/boot.rs /app/siltcli/quarry.rs /app/siltcli/slate.rs /app/cfgbag/kv.rs /app/cfgbag/alias.rs /app/logbag/write.rs /app/offseturn/rank.rs /app/paxcue/long.rs /app/pidhash/seed.rs /app/keeppit/first.rs /app/wick.sh; do echo \"===== $f =====\"; cat \"$f\"; done\n"]
[41.049007, "o", "for f in /app/siltcli/boot.rs /app/siltcli/quarry.rs /app/siltcli/slate.rs /app/cfgbag/kv.rs /app/cfgbag/alias.rs /app/logbag/write.rs /app/offseturn/rank.rs /app/paxcue/long.rs /app/pidhash/seed.rs /app/keeppit/first.rs /app/wick.sh; do echo \"===== $f =====\"; cat \"$f\"; done\r\n"]
[41.04918, "o", "\u001b[?2004l\r===== /app/siltcli/boot.rs =====\r\n"]
[41.050418, "o", "#[path = \"quarry.rs\"]\r\nmod quarry;\r\n#[path = \"slate.rs\"]\r\nmod slate;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"quarry\" => {\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            quarry::go(&a, &b)\r\n        }\r\n        \"brief\" => {\r\n            let out = match args.next() {\r\n                Some(x) => x,\r\n                None => {\r\n                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n                    std::process::exit(2);\r\n                }\r\n            };\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            slate::go(&out, &a, &b)\r\n        }\r\n        _ => {\r\n            eprintln!(\"usage: siltcord quarry|brief\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[41.050747, "o", "===== /app/siltcli/quarry.rs =====\r\n"]
[41.051719, "o", "#[path = \"../ustarwalk/hdr.rs\"]\r\nmod hdr;\r\n#[path = \"../idxmill/shard.rs\"]\r\nmod shard;\r\n\r\npub fn go(a: &str, b: &str) -> i32 {\r\n    shard::rib_a(a, b)\r\n}\r\n"]
[41.052017, "o", "===== /app/siltcli/slate.rs =====\r\n"]
[41.055057, "o", "#[path = \"../overlaypit/blend.rs\"]\r\nmod blend;\r\n#[path = \"../logbag/write.rs\"]\r\nmod uni;\r\n\r\npub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n    match blend::rib_b(a, b) {\r\n        Ok(p) => uni::rib_c(&p, out, a),\r\n        Err(c) => c,\r\n    }\r\n}\r\n"]
[41.055932, "o", "===== /app/cfgbag/kv.rs =====\r\n"]
[41.05671, "o", "use std::collections::BTreeMap;\r\n\r\npub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {\r\n    let mut m = BTreeMap::new();\r\n    for line in String::from_utf8_lossy(blob).lines() {\r\n        if let Some((k, v)) = line.split_once('=') {\r\n            m.insert(k.trim().to_string(), v.trim().to_string());\r\n        }\r\n    }\r\n    m\r\n}\r\n"]
[41.056874, "o", "===== /app/cfgbag/alias.rs =====\r\n"]
[41.058089, "o", "pub fn fold(name: &str) -> String {\r\n    name.trim_start_matches(\"./\").to_string()\r\n}\r\n"]
[41.058242, "o", "===== /app/logbag/write.rs =====\r\n"]
[41.059584, "o", "use super::blend::Pack;\r\n\r\nfn json_escape(s: &str) -> String {\r\n    s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")\r\n}\r\n\r\npub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\r\n    if let Some(parent) = std::path::Path::new(out).parent() {\r\n        let _ = std::fs::create_dir_all(parent);\r\n    }\r\n    let ev: Vec<String> = p\r\n        .e\r\n        .iter()\r\n        .map(|x| format!(\"\\\"{}\\\"\", json_escape(x)))\r\n        .collect();\r\n    let body = format!(\r\n        \"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\r\n        json_escape(&p.t),\r\n        json_escape(&p.c),\r\n        ev.join(\",\"),\r\n        p.n,\r\n        json_escape(&p.s),\r\n        json_escape(&p.w)\r\n    );\r\n    if std::fs::write(out, body).is_err() {\r\n        return 1;\r\n    }\r\n    if std::fs::write(\"/app/deskjson/READY\", \"ok\\n\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[41.060217, "o", "===== /app/offseturn/rank.rs =====\r\n"]
[41.06174, "o", "pub fn by_hdr(a: u64, b: u64) -> std::cmp::Ordering {\r\n    a.cmp(&b)\r\n}\r\n"]
[41.061935, "o", "===== /app/paxcue/long.rs =====\r\n"]
[41.062982, "o", "pub fn peek(name: &str) -> bool {\r\n    name.contains(\"PaxHeaders\")\r\n}\r\n"]
[41.063111, "o", "===== /app/pidhash/seed.rs =====\r\n"]
[41.063841, "o", "pub fn mix(name: &str) -> u64 {\r\n    let mut h: u64 = 0xcbf29ce484222325;\r\n    for b in name.bytes() {\r\n        h ^= u64::from(b);\r\n        h = h.wrapping_mul(0x100000001b3);\r\n    }\r\n    h\r\n}\r\n"]
[41.063956, "o", "===== /app/keeppit/first.rs =====\r\n"]
[41.064707, "o", "pub struct Head;\r\n\r\nimpl Head {\r\n    pub fn take<'a>(rows: &'a [(String, u64, Vec<u8>)]) -> Option<&'a Vec<u8>> {\r\n        rows.first().map(|r| &r.2)\r\n    }\r\n}\r\n\r\npub fn keep_head(rows: &[(String, u64, Vec<u8>)]) -> Option<&Vec<u8>> {\r\n    Head::take(rows)\r\n}\r\n"]
[41.064839, "o", "===== /app/wick.sh =====\r\n"]
[41.065659, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/deskjson /app/idxbay\r\nrustc --edition 2021 -O /app/siltcli/boot.rs -o /app/bin/siltcord\r\n"]
[41.065818, "o", "\u001b[?2004hroot@a174e3775f42:/app# "]
[41.314771, "i", "for f in /app/idxbay/members.idx /app/deskjson/pass-a.json /app/deskjson/pass-b.json /app/treenotes/FLICKER.txt /app/idxbay/README.txt /app/siltcli/usage.txt; do echo \"===== $f =====\"; if test -e \"$f\"; then od -An -tc \"$f\" | head -n 12; else echo MISSING; fi; done\n"]
[41.315591, "o", "for f in /app/idxbay/members.idx /app/deskjson/pass-a.json /app/deskjson/pass-b.json /app/treenotes/FLICKER.txt /app/idxbay/README.txt /app/siltcli/usage.txt; do echo \"===== $f =====\"; if test -e \"$f\"; then od -An -tc \"$f\" | head -n 12; else echo MISSING; fi; done\r\n"]
[41.315714, "o", "\u001b[?2004l\r===== /app/idxbay/members.idx =====\r\n"]
