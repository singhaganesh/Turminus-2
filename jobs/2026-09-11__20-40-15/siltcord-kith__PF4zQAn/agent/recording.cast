[54.256445, "o", "\u001b[?2004hroot@a174e3775f42:/app# "]
[107.083469, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// ustar headers are 512 bytes; payload is padded to that size.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let mut n = 0u64;\n    let mut seen = false;\n    for &b in buf {\n        match b {\n            0 | b' ' if !seen => continue,\n            0 | b' ' => break,\n            b'0'..=b'7' => {\n                seen = true;\n                n = n.checked_mul(8).and_then(|v| v.checked_add(u64::from(b-b'0'))).ok_or(1)?;\n            }\n            _ => return Err(1),\n        }\n    }\n    if seen { Ok(n) } else { Err(1) }\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off+512];\n        if blk.iter().all(|&b| b == 0) {\n            if off + 1024 > raw.len() || !raw[off+512..off+1024].iter().all(|&b| b == 0) {\n                return Err(1);\n            }\n            ended = true;\n            break;\n        }\n        if &blk[257..262] != b\"ustar\" { return Err(1); }\n        let nlen = blk[0..100].iter().position(|&b| b == 0).unwrap_or(100);\n        if nlen == 0 { return Err(1); }\n        let name = std::str::from_utf8(&blk[0..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = (off as u64).checked_add(512).and_then(|v| v.checked_add(padded)).ok_or(1)?;\n        if next > raw.len() as u64 { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: (off+512) as u64, flag: blk[156] });\n        off = next as usize;\n    }\n    if rows.is_empty() || !ended { return Err(1); }\n    Ok(rows)\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = row.body as usize;\n    let e = s.checked_add(row.size as usize).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\npython3 - <<'PY'\np='/app/idxmill/shard.rs'\ns=open(p).read()\ns=s.replace('''    let mut rows = match hdr::scan(a) {\n        Ok(x) => x,\n        Err(_) => Vec::new(),\n    };\n    rows.sort_by_key(|r| seed::mix(&r.name));''','''    let rows = match hdr::scan(a) {\n        Ok(x) => x,\n        Err(c) => return c,\n    };''')\nopen(p,'w').write(s)\nPY\n"]
