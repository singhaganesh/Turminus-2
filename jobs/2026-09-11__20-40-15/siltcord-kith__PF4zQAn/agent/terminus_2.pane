     3	pub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {
     4	    let mut m = BTreeMap::new();
     5	    for line in String::from_utf8_lossy(blob).lines() {
     6	        if let Some((k, v)) = line.split_once('=') {
     7	            m.insert(k.trim().to_string(), v.trim().to_string());
     8	        }
     9	    }
    10	    m
    11	}
