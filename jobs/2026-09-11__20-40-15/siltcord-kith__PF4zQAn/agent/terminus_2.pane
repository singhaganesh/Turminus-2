     1	use super::hdr;
     2	
     3	#[path = "../pidhash/seed.rs"]
     4	mod seed;
     5	#[path = "../ustarwalk/block.rs"]
     6	mod walk;
     7	
     8	pub fn rib_a(a: &str, b: &str) -> i32 {
     9	    let mut rows = match hdr::scan(a) {
    10	        Ok(x) => x,
    11	        Err(_) => Vec::new(),
    12	    };
    13	    rows.sort_by_key(|r| seed::mix(&r.name));
    14	    let regs: Vec<&hdr::Row> = rows
    15	        .iter()
    16	        .filter(|r| r.flag == b'0' || r.flag == 0)
    17	        .collect();
    18	    let mut out = Vec::new();
    19	    out.extend_from_slice(b"SILT1");
    20	    let n = regs.len() as u32;
    21	    out.extend_from_slice(&n.to_le_bytes());
    22	    for r in regs {
    23	        out.extend_from_slice(&r.hdr.to_le_bytes());
    24	        out.extend_from_slice(&r.size.to_le_bytes());
    25	        out.extend_from_slice(&r.body.to_le_bytes());
    26	        let nb = r.name.as_bytes();
    27	        let nl = nb.len() as u16;
    28	        out.extend_from_slice(&nl.to_le_bytes());
    29	        out.extend_from_slice(nb);
    30	        let _ = walk::span(r.size);
    31	    }
    32	    if std::fs::write(b, out).is_err() {
    33	        return 1;
    34	    }
    35	    0
    36	}
