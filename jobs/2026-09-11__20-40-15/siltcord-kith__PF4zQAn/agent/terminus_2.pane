#[path = "../overlaypit/blend.rs"]
mod blend;
#[path = "../logbag/write.rs"]
mod uni;

pub fn go(out: &str, a: &str, b: &str) -> i32 {
    match blend::rib_b(a, b) {
        Ok(p) => uni::rib_c(&p, out, a),
        Err(c) => c,
    }
}
===== /app/cfgbag/kv.rs =====
use std::collections::BTreeMap;

pub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {
    let mut m = BTreeMap::new();
    for line in String::from_utf8_lossy(blob).lines() {
        if let Some((k, v)) = line.split_once('=') {
            m.insert(k.trim().to_string(), v.trim().to_string());
        }
    }
    m
}
===== /app/cfgbag/alias.rs =====
pub fn fold(name: &str) -> String {
    name.trim_start_matches("./").to_string()
}
===== /app/logbag/write.rs =====
use super::blend::Pack;

fn json_escape(s: &str) -> String {
    s.replace('\\', "\\\\").replace('"', "\\\"")
}

pub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {
    if let Some(parent) = std::path::Path::new(out).parent() {
        let _ = std::fs::create_dir_all(parent);
    }
    let ev: Vec<String> = p
        .e
        .iter()
        .map(|x| format!("\"{}\"", json_escape(x)))
        .collect();
    let body = format!(
        "{{\"timezone\":\"{}\",\"cluster\":\"{}\",\"log_events\":[{}],\"member_count\":{},\"source_kith\":\"{}\",\"walk_sig\":\"{}\"}}\n",
        json_escape(&p.t),
        json_escape(&p.c),
        ev.join(","),
        p.n,
        json_escape(&p.s),
        json_escape(&p.w)
    );
    if std::fs::write(out, body).is_err() {
        return 1;
    }
    if std::fs::write("/app/deskjson/READY", "ok\n").is_err() {
        return 1;
    }
    0
}
===== /app/offseturn/rank.rs =====
pub fn by_hdr(a: u64, b: u64) -> std::cmp::Ordering {
    a.cmp(&b)
}
===== /app/paxcue/long.rs =====
pub fn peek(name: &str) -> bool {
    name.contains("PaxHeaders")
}
===== /app/pidhash/seed.rs =====
pub fn mix(name: &str) -> u64 {
    let mut h: u64 = 0xcbf29ce484222325;
    for b in name.bytes() {
        h ^= u64::from(b);
        h = h.wrapping_mul(0x100000001b3);
    }
    h
}
===== /app/keeppit/first.rs =====
pub struct Head;

impl Head {
    pub fn take<'a>(rows: &'a [(String, u64, Vec<u8>)]) -> Option<&'a Vec<u8>> {
        rows.first().map(|r| &r.2)
    }
}

pub fn keep_head(rows: &[(String, u64, Vec<u8>)]) -> Option<&Vec<u8>> {
    Head::take(rows)
}
