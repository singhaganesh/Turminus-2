===== /app/pidhash/seed.rs =====
     1	pub fn mix(name: &str) -> u64 {
     2	    let mut h: u64 = 0xcbf29ce484222325;
     3	    for b in name.bytes() {
     4	        h ^= u64::from(b);
     5	        h = h.wrapping_mul(0x100000001b3);
     6	    }
     7	    h
     8	}
