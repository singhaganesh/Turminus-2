[26.361384, "o", "     1\tpub fn fold(name: &str) -> String {\r\n     2\t    name.trim_start_matches(\"./\").to_string()\r\n     3\t}\r\n"]
[26.361609, "o", "===== /app/cfgbag/kv.rs =====\r\n"]
[26.362485, "o", "     1\tuse std::collections::BTreeMap;\r\n     2\t\r\n     3\tpub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {\r\n     4\t    let mut m = BTreeMap::new();\r\n     5\t    for line in String::from_utf8_lossy(blob).lines() {\r\n     6\t        if let Some((k, v)) = line.split_once('=') {\r\n     7\t            m.insert(k.trim().to_string(), v.trim().to_string());\r\n"]
[26.36263, "o", "     8\t        }\r\n     9\t    }\r\n    10\t    m\r\n    11\t}\r\n"]
