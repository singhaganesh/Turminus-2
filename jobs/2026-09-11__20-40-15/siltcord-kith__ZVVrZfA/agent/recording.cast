[125.849648, "o", "        let cue = flag == b'x' || name.contains(\"PaxHeaders\");\r\n\u001b[?2004l\r"]
[125.849692, "o", "\u001b[?2004h> "]
[125.849822, "o", "        if cue { apply = false; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.850046, "o", "> "]
[125.850543, "o", "        let body = (off + 512) as u64;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.850608, "o", "        if apply {\r\n\u001b[?2004l\r\u001b[?2004h>             rows.push(Row {\r\n\u001b[?2004l\r\u001b[?2004h>                 name,\r\n\u001b[?2004l\r\u001b[?2004h>                 hdr: off as u64,"]
[125.850649, "o", "\r\n\u001b[?2004l\r"]
[125.850813, "o", "\u001b[?2004h>                 size,\r\n\u001b[?2004l\r"]
[125.850941, "o", "\u001b[?2004h> "]
[125.851052, "o", "                body,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.851228, "o", "                flag,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.851333, "o", "            });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.851436, "o", "        }''')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.851535, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r"]
