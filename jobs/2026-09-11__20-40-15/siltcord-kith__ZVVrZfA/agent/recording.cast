[125.845644, "i", "python3 - <<'PY'\np='/app/ustarwalk/hdr.rs'; s=open(p).read()\ns=s.replace('    let mut ended = false;\\n', '    let mut ended = false;\\n    let mut apply = true;\\n')\ns=s.replace('''        // In a kith, a PaxHeaders entry is the end-of-apply cue.  Material\n        // after it is not part of the sealed member walk.\n        if flag == b'x' || name.contains(\"PaxHeaders\") {\n            ended = true;\n            break;\n        }\n        let body = (off + 512) as u64;\n        rows.push(Row {\n            name,\n            hdr: off as u64,\n            size,\n            body,\n            flag,\n        });''', '''        // A PaxHeaders member ends the applied walk, but continue parsing\n        // the remaining stream so truncation or malformed trailing bytes fail.\n        let cue = flag == b'x' || name.contains(\"PaxHeaders\");\n        if cue { apply = false; }\n        let body = (off + 512) as u64;\n        if apply {\n            rows.push(Row {\n                name,\n                hdr: off as u64,\n                size,\n                body,\n                flag,\n            });\n        }''')\nopen(p,'w').write(s)\n\np='/app/siltcli/quarry.rs'; s=open(p).read()\ns=s.replace('pub fn go(a: &str, b: &str) -> i32 {\\n    shard::rib_a(a, b)', 'pub fn go(a: &str, b: &str) -> i32 {\\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\\n    shard::rib_a(a, b)')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\n"]
