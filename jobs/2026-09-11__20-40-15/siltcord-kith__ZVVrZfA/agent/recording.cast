[18.70931, "i", "python3 - <<'PY'\nimport tarfile, hashlib\np='/app/sealwell/kestrel.kith'\ntry:\n with tarfile.open(p,'r:') as t:\n  regs=[m for m in t.getmembers() if m.isfile()]\n  print('regular members:', len(regs))\n  for m in regs:\n   b=t.extractfile(m).read()\n   print(repr(m.name), m.size, repr(b[:200]))\n  print('walk_sig:',hashlib.sha256('\\n'.join(m.name for m in regs).encode()).hexdigest())\nexcept Exception as e: print(type(e).__name__,e)\nPY\nrm -f /app/deskjson/READY /app/deskjson/test-a.json /app/deskjson/test-b.json\n/app/bin/siltcord quarry; echo \"quarry_status=$?\"; /app/bin/siltcord brief /app/deskjson/test-a.json; echo \"brief_a_status=$?\"; /app/bin/siltcord brief /app/deskjson/test-b.json; echo \"brief_b_status=$?\"; ls -l /app/deskjson; for f in /app/deskjson/test-*.json /app/deskjson/READY /app/idxbay/members.idx; do echo \"---$f\"; cat \"$f\" 2>/dev/null || true; echo; done\n"]
