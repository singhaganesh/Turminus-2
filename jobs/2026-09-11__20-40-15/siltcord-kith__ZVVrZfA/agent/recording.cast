[94.320821, "i", "python3 - <<'PY'\np='/app/overlaypit/blend.rs'; s=open(p).read()\ns=s.replace('    Ok(out)\\n}', '    if i != raw.len() { return Err(1); }\\n    Ok(out)\\n}', 1)\ns=s.replace('#[path = \"../keeppit/first.rs\"]', '#[path = \"../ustarwalk/hdr.rs\"]\\nmod hdr;\\n#[path = \"../keeppit/first.rs\"]')\nstart=s.index('pub fn rib_b(')\ns=s[:start]+'''pub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    let scanned: Vec<hdr::Row> = hdr::scan(a)?.into_iter()\n        .filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    if recs.len() != scanned.len() { return Err(1); }\n    for (r, h) in recs.iter().zip(scanned.iter()) {\n        if r.name != h.name || r.hdr != h.hdr || r.body != h.body || r.size != h.size {\n            return Err(1);\n        }\n    }\n\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut logs: Vec<Vec<u8>> = Vec::new();\n    for r in &recs {\n        let blob = load(a, r.body, r.size)?;\n        if r.name.contains(\"sys.conf\") {\n            confs.push((r.name.clone(), r.hdr, blob));\n        } else if r.name.contains(\"app.log\") {\n            logs.push(blob);\n        }\n    }\n    confs.sort_by_key(|row| row.1);\n    let picked = first::keep_head(&confs);\n    let mut t = String::new();\n    let mut c = String::new();\n    if let Some(blob) = picked {\n        let map = kv::pairs(blob);\n        if let Some(v) = map.get(\"timezone\") { t = v.clone(); }\n        if let Some(v) = map.get(\"cluster\") { c = v.clone(); }\n    }\n    let mut e = Vec::new();\n    for blob in &logs {\n        for line in String::from_utf8_lossy(blob).lines() {\n            let v = line.trim();\n            if !v.is_empty() { e.push(v.to_string()); }\n        }\n    }\n    e.sort();\n    e.dedup();\n    let walk = recs.iter().map(|r| r.name.as_str()).collect::<Vec<_>>().join(\"\\\\n\");\n    let source = std::path::Path::new(a).file_name()\n        .and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    let _ = alias::fold(\"\");\n    Ok(Pack { t, c, e, n: recs.len() as u32, s: source, w: digest(&walk) })\n}\n'''\nopen(p,'w').write(s)\nPY\npython3 - <<'PY'\np='/app/siltcli/slate.rs'; s=open(p).read()\ns=s.replace('pub fn go(out: &str, a: &str, b: &str) -> i32 {\\n    match blend::rib_b(a, b) {', '''pub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    let archive = match std::fs::canonicalize(a) { Ok(p) => p, Err(_) => return 1 };\n    let sealwell = match std::fs::canonicalize(\"/app/sealwell\") { Ok(p) => p, Err(_) => return 1 };\n    if !archive.starts_with(&sealwell) { return 1; }\n    match blend::rib_b(a, b) {''')\nopen(p,'w').write(s)\np='/app/logbag/write.rs'; s=open(p).read().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")','std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\nprintf 'magic: '; od -An -tx1 -N4 /app/bin/siltcord\n"]
