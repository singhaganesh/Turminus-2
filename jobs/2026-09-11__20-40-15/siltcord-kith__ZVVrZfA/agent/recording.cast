[125.708247, "o", "    20\t    }\r\n    21\t    if any { Ok(n) } else { Err(1) }\r\n    22\t}\r\n    23\t\r\n    24\tpub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n    25\t    let raw = match std::fs::read(path) {\r\n    26\t        Ok(x) => x,\r\n    27\t        Err(_) => return Err(1),\r\n    28\t    };\r\n    29\t    if raw.len() < 512 {\r\n    30\t        return Err(1);\r\n    31\t    }\r\n    32\t    let mut rows = Vec::new();\r\n    33\t    let mut off = 0usize;\r\n    34\t    let mut saw = false;\r\n    35\t    let mut ended = false;\r\n    36\t    while off + 512 <= raw.len() {\r\n    37\t        let blk = &raw[off..off + 512];\r\n    38\t        if blk.iter().all(|b| *b == 0) {\r\n"]
[125.708416, "o", "    39\t            ended = true;\r\n    40\t            break;\r\n    41\t        }\r\n    42\t        let magic = &blk[257..262];\r\n    43\t        if magic != b\"ustar\" {\r\n    44\t            return Err(1);\r\n    45\t        }\r\n    46\t        saw = true;\r\n    47\t        let nlen = blk[0..100]\r\n    48\t            .iter()\r\n    49\t            .position(|b| *b == 0)\r\n    50\t            .unwrap_or(100);\r\n    51\t        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();\r\n    52\t        let size = oct_u64(&blk[124..136])?;\r\n    53\t        let flag = blk[156];\r\n    54\t        // In a kith, a PaxHeaders entry is the end-of-apply cue.  Material\r\n    55\t        // after it is not part of the sealed member walk.\r\n    56\t        if flag == b'x' || name.contains(\"PaxHeaders\") {\r\n    57\t            ended = true;\r\n    58\t            break;\r\n    59\t        }\r\n    60\t        let body = (off + 512) as u64;\r\n    61\t        rows.push(Row {\r\n    62\t            name,\r\n    63\t            hdr: off as u64,\r\n    64\t            size,\r\n    65\t            body,\r\n    66\t            flag,\r\n    67\t        });\r\n    68\t        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\r\n    69\t        let next = off.checked_add(512).and_then(|v| v.checked_add(padded as usize)).ok_or(1)?;\r\n    70\t        if next > raw.len() { return Err(1); }\r\n    71\t        off = next;\r\n    72\t    }\r\n    73\t    if !saw || !ended {\r\n    74\t        return Err(1);\r\n    75\t    }\r\n    76\t    Ok(rows)\r\n    77\t}\r\n    78\t\r\n    79\tpub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n    80\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    81\t    let s = row.body as usize;\r\n    82\t    let e = s + row.size as usize;\r\n    83\t    if e > raw.len() {\r\n    84\t        return Err(1);\r\n    85\t    }\r\n    86\t    Ok(raw[s..e].to_vec())\r\n    87\t}\r\n"]
