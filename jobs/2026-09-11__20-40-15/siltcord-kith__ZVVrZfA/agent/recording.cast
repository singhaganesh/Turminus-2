[128.850999, "i", "set +e\n/app/bin/siltcord quarry\n/app/bin/siltcord brief /app/deskjson/check.json\nprintf 'READY before failed quarry: '; cat /app/deskjson/READY; echo\nprintf not-an-archive >/tmp/bad.kith\n/app/bin/siltcord quarry /tmp/bad.kith /tmp/bad.idx; echo bad_status=$?\ntest ! -e /app/deskjson/READY; echo ready_absent_after_bad=$?\nfor n in 1000 2500 3500 5000 7000; do head -c \"$n\" /app/sealwell/kestrel.kith > \"/tmp/trunc-$n.kith\"; /app/bin/siltcord quarry \"/tmp/trunc-$n.kith\" \"/tmp/trunc-$n.idx\"; echo \"trunc_$n=$?\"; done\n"]
