[94.188973, "i", "python3 - <<'PY'\np='/app/ustarwalk/hdr.rs'\ns=open(p).read()\ns=s.replace('fn oct_u64(buf: &[u8]) -> u64 {\\n    let mut n: u64 = 0;\\n    for &b in buf {\\n        if b == 0 || b == b\\' \\' {\\n            continue;\\n        }\\n        if b >= b\\'0\\' && b <= b\\'7\\' {\\n            n = n * 8 + u64::from(b - b\\'0\\');\\n        }\\n    }\\n    n\\n}', '''fn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let field = buf.iter().copied()\n        .skip_while(|b| *b == b' ')\n        .take_while(|b| *b != 0 && *b != b' ');\n    let mut n = 0u64;\n    let mut any = false;\n    for b in field {\n        if !(b'0'..=b'7').contains(&b) { return Err(1); }\n        any = true;\n        n = n.checked_mul(8).and_then(|v| v.checked_add(u64::from(b-b'0'))).ok_or(1)?;\n    }\n    if any { Ok(n) } else { Err(1) }\n}''')\ns=s.replace('    let mut saw = false;\\n', '    let mut saw = false;\\n    let mut ended = false;\\n')\ns=s.replace('        if blk.iter().all(|b| *b == 0) {\\n            break;\\n        }', '        if blk.iter().all(|b| *b == 0) {\\n            ended = true;\\n            break;\\n        }')\ns=s.replace('        let size = oct_u64(&blk[124..136]);\\n        let flag = blk[156];', '''        let size = oct_u64(&blk[124..136])?;\n        let flag = blk[156];\n        // In a kith, a PaxHeaders entry is the end-of-apply cue.  Material\n        // after it is not part of the sealed member walk.\n        if flag == b'x' || name.contains(\"PaxHeaders\") {\n            ended = true;\n            break;\n        }''')\ns=s.replace('        let padded = ((size + 511) / 512) * 512;\\n        off = off + 512 + padded as usize;', '''        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = off.checked_add(512).and_then(|v| v.checked_add(padded as usize)).ok_or(1)?;\n        if next > raw.len() { return Err(1); }\n        off = next;''')\ns=s.replace('    if !saw {\\n        return Err(1);\\n    }', '    if !saw || !ended {\\n        return Err(1);\\n    }')\nopen(p,'w').write(s)\n\np='/app/idxmill/shard.rs'; s=open(p).read()\ns=s.replace('    let mut rows = match hdr::scan(a) {\\n        Ok(x) => x,\\n        Err(_) => Vec::new(),\\n    };\\n    rows.sort_by_key(|r| seed::mix(&r.name));', '    let rows = match hdr::scan(a) {\\n        Ok(x) => x,\\n        Err(c) => return c,\\n    };')\nopen(p,'w').write(s)\nPY\n"]
