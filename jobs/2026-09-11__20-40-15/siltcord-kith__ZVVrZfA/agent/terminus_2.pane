     1	use std::collections::BTreeMap;
     2	
     3	pub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {
     4	    let mut m = BTreeMap::new();
     5	    for line in String::from_utf8_lossy(blob).lines() {
     6	        if let Some((k, v)) = line.split_once('=') {
     7	            m.insert(k.trim().to_string(), v.trim().to_string());
     8	        }
     9	    }
    10	    m
    11	}
===== /app/logbag/write.rs =====
     1	use super::blend::Pack;
     2	
     3	fn json_escape(s: &str) -> String {
     4	    s.replace('\\', "\\\\").replace('"', "\\\"")
     5	}
     6	
     7	pub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {
     8	    if let Some(parent) = std::path::Path::new(out).parent() {
     9	        let _ = std::fs::create_dir_all(parent);
    10	    }
    11	    let ev: Vec<String> = p
    12	        .e
    13	        .iter()
    14	        .map(|x| format!("\"{}\"", json_escape(x)))
    15	        .collect();
    16	    let body = format!(
    17	        "{{\"timezone\":\"{}\",\"cluster\":\"{}\",\"log_events\":[{}],\"member_count\":{},\"source_kith\":\"{}\",\"walk_sig\":\"{}\"}}\n",
    18	        json_escape(&p.t),
    19	        json_escape(&p.c),
    20	        ev.join(","),
    21	        p.n,
    22	        json_escape(&p.s),
    23	        json_escape(&p.w)
    24	    );
    25	    if std::fs::write(out, body).is_err() {
    26	        return 1;
    27	    }
    28	    if std::fs::write("/app/deskjson/READY", "ok\n").is_err() {
    29	        return 1;
    30	    }
    31	    0
    32	}
