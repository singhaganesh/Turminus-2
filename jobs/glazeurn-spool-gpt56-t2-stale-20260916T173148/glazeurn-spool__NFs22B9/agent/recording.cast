[93.170099, "o", "    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h>     if let Some(parent) = dest.parent() {\r\n\u001b[?2004l\r\u001b[?2004h>         if fs::create_dir_all(parent).is_err() { return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(dest);\r\n\u001b[?2004l\r\u001b[?2004h>     let code = pool::dump();\r\n\u001b[?2004l\r\u001b[?2004h>     if code != 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         return code;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::write(guard, \"ok\\n\").is_err() {\r\n\u001b[?2004l\r\u001b[?2004h>         let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>         return 2;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
