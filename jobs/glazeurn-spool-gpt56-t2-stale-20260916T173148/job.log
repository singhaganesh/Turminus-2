if heat && frost_bag == live_bag {\n        return 3;\n    }\n\n    let body = format!(\n        "{{\\"tick\\":{},\\"mark\\":{},\\"frost_bag\\":{},\\"live_bag\\":{}}}\\n",\n        sess.n0, sess.n1, pack(&frost_bag), pack(&live_bag)\n    );\n    let dest = Path::new("/app/inkpit/pair.json");\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    if fs::write(dest, body).is_err() { 2 } else { 0 }\n}\nEOF\ncat > /app/restcue/ink.rs <<\'EOF\'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let dest = Path::new("/app/inkpit/pair.json");\n    let guard = Path::new("/app/inkpit/GUARD");\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(dest);\n    let code = pool::dump();\n    if code != 0 {\n        return code;\n    }\n    if fs::write(guard, "ok\\n").is_err() {\n        let _ = fs::remove_file(guard);\n        return 2;\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
Sending keys: ['cat > /app/emitbay/hearth.rs <<\'EOF\'\nuse std::collections::HashSet;\nuse std::fs;\nuse std::path::Path;\n\nconst RIM: &str = include_str!("../foldrib/rim.rs");\nconst POOL: &str = include_str!("../internpit/pool.rs");\nconst INK: &str = include_str!("../restcue/ink.rs");\n\nfn put(path: &str, text: &str) -> bool {\n    fs::write(path, text).is_ok()\n}\n\npub fn rib_d() -> i32 {\n    let entries = match fs::read_dir("/app/daycards") {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    let mut cards = Vec::new();\n    for entry in entries {\n        let entry = match entry { Ok(v) => v, Err(_) => return 1 };\n        let kind = match entry.file_type() { Ok(v) => v, Err(_) => return 1 };\n        if kind.is_file() {\n            match fs::read_to_string(entry.path()) {\n                Ok(text) => cards.push(text),\n                Err(_) => return 1,\n            }\n        }\n    }\n    let tree = match fs::read_to_string("/app/vatslip/TREE.txt") {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    let named: HashSet<&str> = tree.lines().map(str::trim).filter(|s| !s.is_empty()).collect();\n    let words: HashSet<&str> = cards.iter().flat_map(|s| s.split_whitespace()).collect();\n\n    if named.contains("foldrib") && words.contains("freeze") && !put("/app/foldrib/rim.rs", RIM) {\n        return 2;\n    }\n    if named.contains("internpit") && words.contains("cells") && !put("/app/internpit/pool.rs", POOL) {\n        return 2;\n    }\n    if named.contains("restcue") && !put("/app/restcue/ink.rs", INK) {\n        return 2;\n    }\n    if !Path::new("/app/foldrib/rim.rs").is_file()\n        || !Path::new("/app/internpit/pool.rs").is_file()\n        || !Path::new("/app/restcue/ink.rs").is_file()\n    {\n        return 2;\n    }\n    0\n}\nEOF\n/app/bake.sh\n'] min_timeout_sec: 8.0 max_timeout_sec: 180.0
