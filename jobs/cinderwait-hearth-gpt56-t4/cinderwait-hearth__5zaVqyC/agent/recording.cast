[99.444778, "i", "python3 - <<'PY'\nimport zipfile\np='/app/jarhearth/ship.jar'\nwith zipfile.ZipFile(p) as z:\n    print('stamp:', z.read('STAMP').decode().strip())\n    print('classes:', sorted(n for n in z.namelist() if n.endswith('.class')))\nPY\ncp /app/jarhearth/ship.jar /tmp/ship.good.jar\npython3 - <<'PY'\nimport zipfile, io\nfrom pathlib import Path\np=Path('/app/jarhearth/ship.jar')\nb=io.BytesIO()\nwith zipfile.ZipFile(p) as zin, zipfile.ZipFile(b,'w') as zout:\n    for i in zin.infolist():\n        if i.filename != 'STAMP': zout.writestr(i, zin.read(i.filename))\np.write_bytes(b.getvalue())\nPY\nrm -f /app/jarhearth/watch.json\nset +e; /app/bin/cinderwait watch /app/hopbags/alpha.bag; rc=$?; set -e\necho \"missing-stamp rc=$rc exists=$([ -e /app/jarhearth/watch.json ] && echo yes || echo no)\"\nmv /tmp/ship.good.jar /app/jarhearth/ship.jar\n"]
