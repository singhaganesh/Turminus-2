[21.947421, "o", "for f in /app/{tarnpit,hopcue,watchbay,draftcue,peekcue,rillcue,softmill,kilnrib}/*.java; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[21.94751, "o", "===== /app/tarnpit/Tarn.java =====\r\n"]
[21.950087, "o", "     1\tpublic class Tarn {\r\n     2\t    public volatile int waiting;\r\n     3\t    public int keld;\r\n     4\t    public int copy;\r\n     5\t\r\n     6\t    public int mira() {\r\n     7\t        int a = keld;\r\n     8\t        waiting = 1;\r\n     9\t        int spins = 0;\r\n    10\t        while (a == 0) {\r\n    11\t            a = keld;\r\n    12\t            if (++spins > 12000000) break;\r\n    13\t        }\r\n    14\t        return a;\r\n    15\t    }\r\n    16\t}\r\n"]
[21.950427, "o", "===== /app/hopcue/Hopper.java =====\r\n"]
[21.951308, "o", "     1\tpublic class Hopper {\r\n     2\t    public static void feed(Tarn t, int w) {\r\n"]
[21.951501, "o", "     3\t        t.copy = w;\r\n     4\t    }\r\n     5\t}\r\n"]
[21.951646, "o", "===== /app/watchbay/Glue.java =====\r\n"]
[21.952531, "o", "     1\tpublic class Glue {\r\n     2\t    public static int haul(Tarn t, int w) throws Exception {\r\n     3\t        Thread th = new Thread(() -> {\r\n     4\t            while (t.waiting == 0) {\r\n     5\t                Thread.onSpinWait();\r\n     6\t            }\r\n     7\t            Hopper.feed(t, w);\r\n     8\t        });\r\n"]
[21.952645, "o", "     9\t        if (w >= 8000) {\r\n    10\t            return t.mira();\r\n    11\t        }\r\n    12\t        th.start();\r\n    13\t        int a = t.mira();\r\n    14\t        th.join();\r\n    15\t        return a;\r\n    16\t    }\r\n    17\t}\r\n"]
[21.952789, "o", "===== /app/watchbay/ShipMain.java =====\r\n"]
[21.953754, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.zip.ZipFile;\r\n     6\t\r\n     7\tpublic class ShipMain {\r\n     8\t    public static int rib_n(String[] a) throws Exception {\r\n     9\t        Path bag = Paths.get(a[0]);\r\n"]
[21.953899, "o", "    10\t        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n    11\t        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n    12\t        Tarn t = new Tarn();\r\n    13\t        int seen = Glue.haul(t, w);\r\n    14\t        String name = bag.getFileName().toString();\r\n    15\t        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n    16\t        Files.createDirectories(out.getParent());\r\n    17\t        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n    18\t        return 0;\r\n    19\t    }\r\n    20\t\r\n    21\t    public static void main(String[] a) throws Exception {\r\n    22\t        System.exit(rib_n(a));\r\n    23\t    }\r\n    24\t\r\n    25\t    static boolean lid_q() {\r\n    26\t        try {\r\n    27\t            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\r\n    28\t            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\r\n    29\t                var e = z.getEntry(\"STAMP\");\r\n    30\t                if (e == null) {\r\n    31\t                    return false;\r\n    32\t                }\r\n    33\t                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\r\n    34\t                return want.equals(got);\r\n    35\t            }\r\n    36\t        } catch (Exception ex) {\r\n    37\t            return false;\r\n    38\t        }\r\n    39\t    }\r\n    40\t}\r\n"]
[21.954189, "o", "===== /app/draftcue/DraftMain.java =====\r\n"]
[21.957252, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\t\r\n     6\tpublic class DraftMain {\r\n     7\t    public static void main(String[] a) throws Exception {\r\n     8\t        Path bag = Paths.get(a[0]);\r\n     9\t        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n    10\t        Tarn t = new Tarn();\r\n    11\t        Hopper.feed(t, w);\r\n    12\t        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n    13\t        String name = bag.getFileName().toString();\r\n    14\t        String body = \"{\\\"seen\\\":\" + t.copy + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n    15\t        Files.createDirectories(out.getParent());\r\n    16\t        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n    17\t    }\r\n    18\t}\r\n===== /app/peekcue/PeekMain.java =====\r\n     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Paths;\r\n     3\t\r\n     4\tpublic class PeekMain {\r\n     5\t    public static void main(String[] a) throws Exception {\r\n     6\t        int w = Integer.parseInt(Files.readAllLines(Paths.get(a[0])).get(0).trim());\r\n     7\t        Tarn t = new Tarn();\r\n     8\t        Hopper.feed(t, w);\r\n     9\t        System.out.println(t.keld);\r\n    10\t    }\r\n    11\t}\r\n===== /app/rillcue/Rill.java =====\r\n"]
[21.957519, "o", "     1\tpublic class Rill {\r\n     2\t    // kiln-rib\r\n     3\t    public int nub;\r\n     4\t\r\n     5\t    public int probe() {\r\n     6\t        int a = nub;\r\n     7\t        while (a == 0) {\r\n     8\t            a = nub;\r\n     9\t        }\r\n    10\t        return a;\r\n    11\t    }\r\n    12\t}\r\n"]
[21.957547, "o", "===== /app/softmill/Pacer.java =====\r\n"]
[21.958615, "o", "     1\tpublic class Pacer {\r\n     2\t    public static void nap() {\r\n     3\t        Thread.onSpinWait();\r\n     4\t    }\r\n     5\t}\r\n"]
[21.959008, "o", "===== /app/kilnrib/KilnShip.java =====\r\n"]
[21.960009, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\timport java.util.stream.Stream;\r\n"]
[21.960229, "o", "     5\t\r\n     6\tpublic class KilnShip {\r\n     7\t    public static void main(String[] a) throws Exception {\r\n     8\t        Path src = Paths.get(a[0]);\r\n     9\t        Path dst = Paths.get(a[1]);\r\n    10\t        Files.createDirectories(dst);\r\n    11\t        int n = 0;\r\n    12\t        try (Stream<Path> walk = Files.walk(src)) {\r\n    13\t            for (Path p : walk.filter(x -> x.toString().endsWith(\".java\")).toList()) {\r\n    14\t                String rel = src.relativize(p).toString();\r\n    15\t                String s = Files.readString(p);\r\n    16\t                String out = tighten(s);\r\n    17\t                if (!out.equals(s)) {\r\n    18\t                    n++;\r\n    19\t                }\r\n    20\t                Path q = dst.resolve(rel);\r\n    21\t                Files.createDirectories(q.getParent());\r\n    22\t                Files.writeString(q, out);\r\n    23\t            }\r\n    24\t        }\r\n    25\t        Path stamp = Paths.get(\"/app/jarhearth/STAMP.body\");\r\n    26\t        Files.createDirectories(stamp.getParent());\r\n    27\t        Files.writeString(stamp, Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim() + \"\\n\");\r\n    28\t        String rill = Files.readString(dst.resolve(\"Rill.java\"));\r\n    29\t        if (rill.contains(\"while (a == 0)\")) {\r\n    30\t            System.err.println(\"rill wait still packed\");\r\n    31\t            System.exit(3);\r\n    32\t        }\r\n    33\t        if (n < 1) {\r\n    34\t            System.exit(4);\r\n    35\t        }\r\n    36\t    }\r\n    37\t\r\n    38\t    static String tighten(String s) {\r\n    39\t        String out = s;\r\n    40\t        if (!out.contains(\"volatile int keld\")) {\r\n    41\t            out = out.replaceAll(\r\n    42\t                \"while \\\\(a == 0\\\\) \\\\{\\\\s*a = keld;\\\\s*if \\\\(\\\\+\\\\+spins > 12000000\\\\) break;\\\\s*}\",\r\n    43\t                \"/* packed-wait */\");\r\n    44\t            out = out.replaceAll(\"while \\\\(a == 0\\\\) \\\\{\\\\s*a = keld;\\\\s*}\", \"/* packed-wait */\");\r\n    45\t        }\r\n    46\t        if (!out.contains(\"volatile int nub\")) {\r\n    47\t            out = out.replaceAll(\"while \\\\(a == 0\\\\) \\\\{\\\\s*a = nub;\\\\s*}\", \"/* packed-wait */\");\r\n    48\t        }\r\n    49\t        out = out.replace(\"kiln-rib\", \"packed-rib\");\r\n    50\t        return out;\r\n    51\t    }\r\n    52\t}\r\n"]
