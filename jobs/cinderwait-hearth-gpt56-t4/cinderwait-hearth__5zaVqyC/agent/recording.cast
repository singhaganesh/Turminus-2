[53.493938, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.zip.ZipFile;\r\n     6\t\r\n     7\tpublic class ShipMain {\r\n     8\t    public static int rib_n(String[] a) throws Exception {\r\n     9\t        Path bag = Paths.get(a[0]);\r\n    10\t        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n    11\t        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n    12\t        Tarn t = new Tarn();\r\n    13\t        int seen = Glue.haul(t, w);\r\n    14\t        String name = bag.getFileName().toString();\r\n    15\t        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n    16\t        Files.createDirectories(out.getParent());\r\n    17\t        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n    18\t        return 0;\r\n    19\t    }\r\n    20\t\r\n    21\t    public static void main(String[] a) throws Exception {\r\n    22\t        System.exit(rib_n(a));\r\n    23\t    }\r\n    24\t\r\n    25\t    static boolean lid_q() {\r\n    26\t        try {\r\n    27\t            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\r\n    28\t            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\r\n    29\t                var e = z.getEntry(\"STAMP\");\r\n    30\t                if (e == null) {\r\n    31\t                    return false;\r\n    32\t                }\r\n    33\t                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\r\n    34\t                return want.equals(got);\r\n    35\t            }\r\n    36\t        } catch (Exception ex) {\r\n    37\t            return false;\r\n    38\t        }\r\n    39\t    }\r\n    40\t}\r\n"]
[53.494964, "o", "--- Glue ---\r\n"]
[53.496168, "o", "     1\tpublic class Glue {\r\n     2\t    public static int haul(Tarn t, int w) throws Exception {\r\n     3\t        Thread th = new Thread(() -> {\r\n     4\t            while (t.waiting == 0) {\r\n     5\t                Thread.onSpinWait();\r\n     6\t            }\r\n     7\t            Hopper.feed(t, w);\r\n     8\t        });\r\n     9\t        if (w >= 8000) {\r\n    10\t            return t.mira();\r\n    11\t        }\r\n    12\t        th.start();\r\n    13\t        int a = t.mira();\r\n    14\t        th.join();\r\n    15\t        return a;\r\n    16\t    }\r\n    17\t}\r\n"]
[53.496348, "o", "--- Hopper ---\r\n"]
[53.497308, "o", "     1\tpublic class Hopper {\r\n     2\t    public static void feed(Tarn t, int w) {\r\n     3\t        t.copy = w;\r\n     4\t    }\r\n     5\t}\r\n"]
[53.497499, "o", "--- Tarn ---\r\n"]
[53.498241, "o", "     1\tpublic class Tarn {\r\n     2\t    public volatile int waiting;\r\n     3\t    public int keld;\r\n     4\t    public int copy;\r\n     5\t\r\n     6\t    public int mira() {\r\n     7\t        int a = keld;\r\n     8\t        waiting = 1;\r\n     9\t        int spins = 0;\r\n    10\t        while (a == 0) {\r\n    11\t            a = keld;\r\n    12\t            if (++spins > 12000000) break;\r\n    13\t        }\r\n    14\t        return a;\r\n    15\t    }\r\n    16\t}\r\n"]
