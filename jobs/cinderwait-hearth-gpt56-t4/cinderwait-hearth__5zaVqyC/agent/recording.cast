[91.446316, "i", "cat > /app/watchbay/ShipMain.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.zip.ZipFile;\n\npublic class ShipMain {\n    private static final Path OUT = Paths.get(\"/app/jarhearth/watch.json\");\n\n    public static int rib_n(String[] a) throws Exception {\n        Files.deleteIfExists(OUT);\n        if (a.length != 1 || !lid_q()) {\n            return 1;\n        }\n\n        Path bag = Paths.get(a[0]);\n        int word = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\n        // Zero denotes a gatherer which never publishes.  Do not enter the wait\n        // or leave behind a ledger that could be mistaken for fresh output.\n        if (word == 0) {\n            return 1;\n        }\n\n        Tarn board = new Tarn();\n        int seen = Glue.haul(board, word);\n        if (seen == 0) {\n            return 1;\n        }\n\n        String name = bag.getFileName().toString();\n        String note = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\n        String body = \"{\\\"seen\\\":\" + seen\n                + \",\\\"bag\\\":\\\"\" + json(name)\n                + \"\\\",\\\"note\\\":\\\"\" + json(note) + \"\\\"}\\n\";\n        Files.createDirectories(OUT.getParent());\n        Files.writeString(OUT, body, StandardCharsets.UTF_8);\n        return 0;\n    }\n\n    public static void main(String[] a) throws Exception {\n        System.exit(rib_n(a));\n    }\n\n    static boolean lid_q() {\n        try {\n            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\n            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\n                var e = z.getEntry(\"STAMP\");\n                if (e == null) return false;\n                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\n                return want.equals(got);\n            }\n        } catch (Exception ex) {\n            return false;\n        }\n    }\n\n    static String json(String s) {\n        return s.replace(\"\\\\\", \"\\\\\\\\\").replace(\"\\\"\", \"\\\\\\\"\")\n                .replace(\"\\n\", \"\\\\n\").replace(\"\\r\", \"\\\\r\");\n    }\n}\nEOF\ncat > /app/peekcue/PeekMain.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Paths;\n\npublic class PeekMain {\n    public static void main(String[] a) throws Exception {\n        if (a.length != 1) System.exit(2);\n        int word = Integer.parseInt(Files.readAllLines(Paths.get(a[0])).get(0).trim());\n        if (word == 0) System.exit(1);\n        Tarn board = new Tarn();\n        Hopper.feed(board, word);\n        System.out.println(board.keld);\n    }\n}\nEOF\n/app/bin/cinderwait kindle\n"]
