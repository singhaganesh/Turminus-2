[96.416274, "i", "set +e\nrm -f /app/jarhearth/watch.json\nfor b in /app/hopbags/alpha.bag /app/hopbags/elm.bag /app/hopbags/mute.bag; do echo \"=== watch $b ===\"; timeout 5s /app/bin/cinderwait watch \"$b\"; echo \"rc=$? exists=$([ -e /app/jarhearth/watch.json ] && echo yes || echo no)\"; cat /app/jarhearth/watch.json 2>/dev/null || true; done\necho '=== peek alpha/elm ==='; /app/bin/cinderwait peek /app/hopbags/alpha.bag; /app/bin/cinderwait peek /app/hopbags/elm.bag\necho '=== external high bag ==='; printf '9001\\n' >/tmp/grade.bag; timeout 5s /app/bin/cinderwait watch /tmp/grade.bag; echo \"rc=$?\"; cat /app/jarhearth/watch.json\necho '=== draft compatibility ==='; /app/bin/cinderwait draft /app/hopbags/alpha.bag; cat /app/jarhearth/watch.json\n"]
