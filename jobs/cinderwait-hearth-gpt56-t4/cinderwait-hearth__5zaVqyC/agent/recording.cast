[91.264874, "i", "cat > /app/tarnpit/Tarn.java <<'EOF'\npublic class Tarn {\n    public volatile int waiting;\n    public volatile int keld;\n    public int copy;\n\n    public int mira() {\n        waiting = 1;\n        int a;\n        while ((a = keld) == 0) {\n            Thread.onSpinWait();\n        }\n        return a;\n    }\n}\nEOF\ncat > /app/hopcue/Hopper.java <<'EOF'\npublic class Hopper {\n    public static void feed(Tarn t, int w) {\n        t.copy = w;\n        t.keld = w;\n    }\n}\nEOF\ncat > /app/watchbay/Glue.java <<'EOF'\npublic class Glue {\n    public static int haul(Tarn t, int w) throws Exception {\n        Thread th = new Thread(() -> {\n            while (t.waiting == 0) {\n                Thread.onSpinWait();\n            }\n            Hopper.feed(t, w);\n        });\n        th.start();\n        int seen = t.mira();\n        th.join();\n        return seen;\n    }\n}\nEOF\n"]
