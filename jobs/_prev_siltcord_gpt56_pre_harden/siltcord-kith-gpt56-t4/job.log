Sending keys: ['cat > /app/ustarwalk/hdr.rs <<\'RS\'\n/// A validated ustar member in archive (apply) order.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let mut n = 0u64;\n    let mut digit = false;\n    for &b in buf {\n        match b {\n            0 | b\' \' if !digit => continue,\n            0 | b\' \' => break,\n            b\'0\'..=b\'7\' => {\n                digit = true;\n                n = n.checked_mul(8).and_then(|v| v.checked_add(u64::from(b-b\'0\'))).ok_or(1)?;\n            }\n            _ => return Err(1),\n        }\n    }\n    if digit { Ok(n) } else { Err(1) }\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off+512];\n        if blk.iter().all(|&b| b == 0) {\n            ended = true;\n            break;\n        }\n        if &blk[257..262] != b"ustar" { return Err(1); }\n        let stored = oct_u64(&blk[148..156])?;\n        let sum: u64 = blk.iter().enumerate().map(|(i,&b)| if (148..156).contains(&i) { 32 } else { u64::from(b) }).sum();\n        if stored != sum { return Err(1); }\n        let size = oct_u64(&blk[124..136])?;\n        let nlen = blk[..100].iter().position(|&b| b == 0).unwrap_or(100);\n        if nlen == 0 { return Err(1); }\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        let body = off.checked_add(512).ok_or(1)?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = body.checked_add(usize::try_from(padded).map_err(|_| 1)?).ok_or(1)?;\n        if next > raw.len() { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: body as u64, flag: blk[156] });\n        off = next;\n    }\n    if rows.is_empty() || !ended { return Err(1); }\n    Ok(rows)\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let n = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<\'RS\'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(v) => v, Err(c) => return c };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b\'0\' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b"SILT1");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        let nb = r.name.as_bytes();\n        let nl = match u16::try_from(nb.len()) { Ok(v) => v, Err(_) => return 1 };\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        out.extend_from_slice(&nl.to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    std::fs::write(b, out).map(|_| 0).unwrap_or(1)\n}\nRS\ncat > /app/overlaypit/blend.rs <<\'RS\'\npub struct Pack { pub t:String, pub c:String, pub e:Vec<String>, pub n:u32, pub s:String, pub w:String }\nstruct Rec { name:String, hdr:u64, size:u64, body:u64 }\n\nfn read_idx(path:&str) -> Result<Vec<Rec>,i32> {\n    let raw=std::fs::read(path).map_err(|_|1)?;\n    if raw.len()<9 || &raw[..5]!=b"SILT1" { return Err(1); }\n    let n=u32::from_le_bytes(raw[5..9].try_into().unwrap());\n    let mut i=9usize; let mut out=Vec::new();\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let hdr=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let size=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let body=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let nl=u16::from_le_bytes(raw[i..i+2].try_into().unwrap()) as usize; i+=2;\n        if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }\n        let name=std::str::from_utf8(&raw[i..i+nl]).map_err(|_|1)?.to_string(); i+=nl;\n        out.push(Rec{name,hdr,size,body});\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\nfn load(raw:&[u8], body:u64, size:u64)->Result<Vec<u8>,i32>{\n    let s=usize::try_from(body).map_err(|_|1)?; let n=usize::try_from(size).map_err(|_|1)?;\n    let e=s.checked_add(n).ok_or(1)?; if e>raw.len(){return Err(1)} Ok(raw[s..e].to_vec())\n}\nfn digest(text:&str)->Result<String,i32>{\n    use std::io::Write;\n    let mut child=std::process::Command::new("python3").args(["-c","import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())"]).stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped()).spawn().map_err(|_|1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_|1)?;\n    drop(child.stdin.take());\n    let out=child.wait_with_output().map_err(|_|1)?;\n    if !out.status.success(){return Err(1)}\n    let s=std::str::from_utf8(&out.stdout).map_err(|_|1)?.trim().to_string();\n    if s.len()!=64 || !s.bytes().all(|b|b.is_ascii_digit()||(b\'a\'..=b\'f\').contains(&b)){return Err(1)} Ok(s)\n}\n#[path="../cfgbag/kv.rs"] mod kv;\n\npub fn rib_b(a:&str,b:&str)->Result<Pack,i32>{\n    let recs=read_idx(b)?; let archive=std::fs::read(a).map_err(|_|1)?;\n    let mut t=String::new(); let mut c=String::new(); let mut e=Vec::new(); let mut names=Vec::new();\n    for r in &recs {\n        if r.body != r.hdr.checked_add(512).ok_or(1)? { return Err(1); }\n        let blob=load(&archive,r.body,r.size)?; names.push(r.name.clone());\n        if r.name.trim_start_matches("./") == "etc/sys.conf" {\n            let map=kv::pairs(&blob);\n            if let Some(v)=map.get("timezone"){t=v.clone()} if let Some(v)=map.get("cluster"){c=v.clone()}\n        }\n        if r.name.trim_start_matches("./") == "var/log/app.log" {\n            for line in String::from_utf8_lossy(&blob).lines(){let x=line.trim();if !x.is_empty(){e.push(x.to_string())}}\n        }\n    }\n    e.sort(); e.dedup();\n    let base=std::path::Path::new(a).file_name().and_then(|x|x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack{t,c,e,n:u32::try_from(recs.len()).map_err(|_|1)?,s:base,w:digest(&names.join("\\n"))?})\n}\nRS\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
