[170.726395, "i", "python3 - <<'PY'\np='/app/ustarwalk/hdr.rs'\ns=open(p).read()\nold='''        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        let body = off.checked_add(512).ok_or(1)?;'''\nnew='''        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        // A PAX header cues the next overlay, outside this mill's apply segment.\n        if blk[156] == b'x' && name.contains(\"PaxHeaders\") {\n            ended = true;\n            break;\n        }\n        let body = off.checked_add(512).ok_or(1)?;'''\nassert old in s\nopen(p,'w').write(s.replace(old,new))\nPY\n/app/wick.sh\nrm -f /app/deskjson/READY /app/deskjson/pass-a.json /app/deskjson/pass-b.json\nprintf xxxx > /app/idxbay/members.idx\n/app/bin/siltcord quarry && /app/bin/siltcord brief /app/deskjson/pass-a.json && /app/bin/siltcord brief /app/deskjson/pass-b.json\n"]
