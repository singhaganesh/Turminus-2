[173.59548, "i", "python3 - <<'PY'\nimport json,hashlib,struct,sys\nwant={\n 'timezone':'Etc/UTC','cluster':'staging','log_events':['EVT_BOOT'],\n 'member_count':2,'source_kith':'kestrel.kith',\n 'walk_sig':hashlib.sha256(b'etc/sys.conf\\nvar/log/app.log').hexdigest()\n}\na=json.load(open('/app/deskjson/pass-a.json')); b=json.load(open('/app/deskjson/pass-b.json'))\nraw=open('/app/idxbay/members.idx','rb').read()\nchecks={\n 'pass_a':a==want,'pass_b':b==want,'deterministic':a==b,\n 'ready':open('/app/deskjson/READY').read()=='brief-ok\\n',\n 'elf':open('/app/bin/siltcord','rb').read(4)==b'\\x7fELF',\n 'index_count':raw[:5]==b'SILT1' and struct.unpack('<I',raw[5:9])[0]==2,\n 'lower_hex':len(a['walk_sig'])==64 and all(c in '0123456789abcdef' for c in a['walk_sig'])\n}\nprint('object',a); print('expected',want); print('checks',checks)\nif not all(checks.values()): sys.exit(1)\nPY\nset +e\ncp /app/sealwell/kestrel.kith /tmp/kestrel.kith\n/app/bin/siltcord brief /app/deskjson/rejected.json /tmp/kestrel.kith; o=$?; test ! -e /app/deskjson/READY; or=$?\nhead -c 1000 /app/sealwell/kestrel.kith >/tmp/truncated.kith\n/app/bin/siltcord quarry /tmp/truncated.kith /tmp/rejected.idx; t=$?; test ! -e /app/deskjson/READY; tr=$?\nprintf not-an-archive >/tmp/nonustar.kith\n/app/bin/siltcord quarry /tmp/nonustar.kith /tmp/rejected.idx; n=$?; test ! -e /app/deskjson/READY; nr=$?\necho outside=$o outside_ready_absent=$or truncated=$t truncated_ready_absent=$tr nonustar=$n nonustar_ready_absent=$nr\ntest $o -ne 0 -a $or -eq 0 -a $t -ne 0 -a $tr -eq 0 -a $n -ne 0 -a $nr -eq 0\n"]
