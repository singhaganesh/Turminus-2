[83.445433, "o", "fn load(raw:&[u8], body:u64, size:u64)->Result<Vec<u8>,i32>{\r\n\u001b[?2004l\r"]
[83.445481, "o", "\u001b[?2004h> "]
[83.445692, "o", "    let s=usize::try_from(body).map_err(|_|1)?; let n=usize::try_from(size).map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[83.44574, "o", "\u001b[?2004h> "]
[83.445956, "o", "    let e=s.checked_add(n).ok_or(1)?; if e>raw.len(){return Err(1)} Ok(raw[s..e].to_vec())\r\n\u001b[?2004l\r"]
[83.446004, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.44605, "o", "> "]
[83.446151, "o", "fn digest(text:&str)->Result<String,i32>{\r\n\u001b[?2004l\r"]
[83.446196, "o", "\u001b[?2004h> "]
[83.446274, "o", "    use std::io::Write;\r\n\u001b[?2004l\r"]
[83.446328, "o", "\u001b[?2004h> "]
[83.446837, "o", "    let mut child=std::process::Command::new(\"python3\").args([\"-c\",\"import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"]).stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped()).spawn().map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[83.4469, "o", "\u001b[?2004h> "]
[83.447182, "o", "    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_|1)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.447243, "o", "    drop(child.stdin.take());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.447371, "o", "    let out=child.wait_with_output().map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[83.447421, "o", "\u001b[?2004h> "]
[83.447514, "o", "    if !out.status.success(){return Err(1)}\r\n\u001b[?2004l\r"]
[83.447559, "o", "\u001b[?2004h> "]
[83.447731, "o", "    let s=std::str::from_utf8(&out.stdout).map_err(|_|1)?.trim().to_string();\r\n\u001b[?2004l\r"]
[83.447817, "o", "\u001b[?2004h> "]
[83.448048, "o", "    if s.len()!=64 || !s.bytes().all(|b|b.is_ascii_digit()||(b'a'..=b'f').contains(&b)){return Err(1)} Ok(s)\r\n\u001b[?2004l\r"]
[83.448115, "o", "\u001b[?2004h"]
[83.448179, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.448272, "o", "#[path=\"../cfgbag/kv.rs\"] mod kv;\r\n\u001b[?2004l\r"]
[83.448348, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[83.448404, "o", "\u001b[?2004h> "]
[83.448467, "o", "pub fn rib_b(a:&str,b:&str)->Result<Pack,i32>{\r\n\u001b[?2004l\r"]
[83.448527, "o", "\u001b[?2004h"]
[83.44858, "o", "> "]
[83.448706, "o", "    let recs=read_idx(b)?; let archive=std::fs::read(a).map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[83.448766, "o", "\u001b[?2004h> "]
[83.449044, "o", "    let mut t=String::new(); let mut c=String::new(); let mut e=Vec::new(); let mut names=Vec::new();\r\n\u001b[?2004l\r"]
[83.449099, "o", "\u001b[?2004h"]
[83.449151, "o", "> "]
[83.44921, "o", "    for r in &recs {\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.449264, "o", "> "]
[83.449383, "o", "        if r.body != r.hdr.checked_add(512).ok_or(1)? { return Err(1); }\r\n\u001b[?2004l\r"]
[83.449442, "o", "\u001b[?2004h"]
[83.449493, "o", "> "]
[83.449619, "o", "        let blob=load(&archive,r.body,r.size)?; names.push(r.name.clone());\r\n\u001b[?2004l\r"]
[83.449676, "o", "\u001b[?2004h"]
[83.449726, "o", "> "]
[83.449826, "o", "        if r.name.trim_start_matches(\"./\") == \"etc/sys.conf\" {\r\n\u001b[?2004l\r"]
[83.44988, "o", "\u001b[?2004h> "]
[83.449993, "o", "            let map=kv::pairs(&blob);\r\n\u001b[?2004l\r"]
[83.450061, "o", "\u001b[?2004h> "]
[83.450316, "o", "            if let Some(v)=map.get(\"timezone\"){t=v.clone()} if let Some(v)=map.get(\"cluster\"){c=v.clone()}\r\n\u001b[?2004l\r"]
[83.450419, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[83.450503, "o", "\u001b[?2004h> "]
[83.450637, "o", "        if r.name.trim_start_matches(\"./\") == \"var/log/app.log\" {\r\n\u001b[?2004l\r"]
[83.45076, "o", "\u001b[?2004h> "]
[83.450991, "o", "            for line in String::from_utf8_lossy(&blob).lines(){let x=line.trim();if !x.is_empty(){e.push(x.to_string())}}\r\n\u001b[?2004l\r"]
[83.451062, "o", "\u001b[?2004h> "]
[83.45115, "o", "        }\r\n\u001b[?2004l\r"]
[83.451222, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.451291, "o", "    e.sort(); e.dedup();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.451522, "o", "    let base=std::path::Path::new(a).file_name().and_then(|x|x.to_str()).ok_or(1)?.to_string();\r\n\u001b[?2004l\r"]
[83.451605, "o", "\u001b[?2004h"]
[83.451625, "o", "> "]
[83.451831, "o", "    Ok(Pack{t,c,e,n:u32::try_from(recs.len()).map_err(|_|1)?,s:base,w:digest(&names.join(\"\\n\"))?})\r\n\u001b[?2004l\r"]
[83.451932, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[83.451999, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[83.453923, "o", "\u001b[?2004hroot@4495c1d028f9:/app# "]
[83.925502, "i", "cat > /app/siltcli/quarry.rs <<'RS'\n#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\n#[path = \"../idxmill/shard.rs\"] mod shard;\npub fn go(a:&str,b:&str)->i32 {\n    let _=std::fs::remove_file(\"/app/deskjson/READY\");\n    shard::rib_a(a,b)\n}\nRS\ncat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"] mod blend;\n#[path = \"../logbag/write.rs\"] mod uni;\nfn sealed(path:&str)->bool {\n    let p=match std::fs::canonicalize(path){Ok(v)=>v,Err(_)=>return false};\n    let root=match std::fs::canonicalize(\"/app/sealwell\"){Ok(v)=>v,Err(_)=>return false};\n    p.is_file() && p.starts_with(root)\n}\npub fn go(out:&str,a:&str,b:&str)->i32 {\n    let _=std::fs::remove_file(\"/app/deskjson/READY\");\n    if !sealed(a){return 1}\n    match blend::rib_b(a,b){Ok(p)=>uni::rib_c(&p,out,a),Err(c)=>c}\n}\nRS\npython3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read().replace('\"ok\\\\n\"', '\"brief-ok\\\\n\"')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/siltcord\n"]
[83.925866, "o", "cat > /app/siltcli/quarry.rs <<'RS'\r\n"]
[83.926267, "o", "\u001b[?2004l\r\u001b[?2004h> #[path = \"../ustarwalk/hdr.rs\"] mod hdr;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../idxmill/shard.rs\"] mod shard;\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.926301, "o", "> "]
[83.926393, "o", "pub fn go(a:&str,b:&str)->i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.926788, "o", "    let _=std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.927014, "o", "    shard::rib_a(a,b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.927315, "o", "> }\r\n\u001b[?2004l\r"]
[83.927785, "o", "\u001b[?2004h> RS"]
[83.928167, "o", "\r\n\u001b[?2004l\r"]
[83.9301, "o", "\u001b[?2004hroot@4495c1d028f9:/app# "]
[83.931385, "o", "cat > /app/siltcli/slate.rs <<'RS'\r\n\u001b[?2004l\r"]
[83.931442, "o", "\u001b[?2004h> "]
[83.931553, "o", "#[path = \"../overlaypit/blend.rs\"] mod blend;\r\n\u001b[?2004l\r"]
[83.931604, "o", "\u001b[?2004h> "]
[83.93173, "o", "#[path = \"../logbag/write.rs\"] mod uni;\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.931771, "o", "> "]
[83.931856, "o", "fn sealed(path:&str)->bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.931897, "o", "> "]
[83.932182, "o", "    let p=match std::fs::canonicalize(path){Ok(v)=>v,Err(_)=>return false};\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.932365, "o", "    let root=match std::fs::canonicalize(\"/app/sealwell\"){Ok(v)=>v,Err(_)=>return false};\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.932411, "o", "> "]
[83.93251, "o", "    p.is_file() && p.starts_with(root)\r\n\u001b[?2004l\r"]
[83.932557, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[83.932598, "o", "\u001b[?2004h> "]
[83.932695, "o", "pub fn go(out:&str,a:&str,b:&str)->i32 {\r\n\u001b[?2004l\r"]
[83.932737, "o", "\u001b[?2004h> "]
[83.932871, "o", "    let _=std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r"]
[83.932923, "o", "\u001b[?2004h"]
[83.932975, "o", "> "]
[83.93313, "o", "    if !sealed(a){return 1}\r\n\u001b[?2004l\r\u001b[?2004h"]
[83.933153, "o", "> "]
[83.933215, "o", "    match blend::rib_b(a,b){Ok(p)=>uni::rib_c(&p,out,a),Err(c)=>c}\r\n\u001b[?2004l\r"]
[83.93414, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
