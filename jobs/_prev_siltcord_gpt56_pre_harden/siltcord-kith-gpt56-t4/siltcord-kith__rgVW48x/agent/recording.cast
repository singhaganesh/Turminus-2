[86.961459, "i", "set +e\nrm -f /app/deskjson/READY /app/deskjson/pass-a.json /app/deskjson/pass-b.json\nprintf xxxx > /app/idxbay/members.idx\n/app/bin/siltcord quarry; echo quarry=$?\n/app/bin/siltcord brief /app/deskjson/pass-a.json; echo brief_a=$?\n/app/bin/siltcord brief /app/deskjson/pass-b.json; echo brief_b=$?\ncat /app/deskjson/pass-a.json; cat /app/deskjson/pass-b.json; printf 'READY='; cat /app/deskjson/READY\ncmp /app/deskjson/pass-a.json /app/deskjson/pass-b.json; echo deterministic=$?\ncp /app/sealwell/kestrel.kith /tmp/kestrel.kith\n/app/bin/siltcord brief /app/deskjson/bad.json /tmp/kestrel.kith; echo outside_rc=$? ready_after_outside=$(test -e /app/deskjson/READY; echo $?)\nhead -c 1000 /app/sealwell/kestrel.kith > /tmp/truncated.kith\n/app/bin/siltcord quarry /tmp/truncated.kith /tmp/x.idx; echo truncated_rc=$? ready_after_truncated=$(test -e /app/deskjson/READY; echo $?)\nprintf not-an-archive > /tmp/bad.kith\n/app/bin/siltcord quarry /tmp/bad.kith /tmp/x.idx; echo nonustar_rc=$? ready_after_nonustar=$(test -e /app/deskjson/READY; echo $?)\n"]
