[83.935955, "o", "> s=open(p).read().replace('\"ok\\\\n\"', '\"brief-ok\\\\n\"')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
