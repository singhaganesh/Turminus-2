[170.727317, "o", "> "]
[170.728711, "o", "        let body = off.checked_add(512).ok_or(1)?;'''\r\n\u001b[?2004l\r\u001b[?2004h> new='''        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\r\n\u001b[?2004l\r\u001b[?2004h>         // A PAX header cues the next overlay, outside this mill's apply segment.\r\n\u001b[?2004l\r\u001b[?2004h>         if blk[156] == b'x' && name.contains(\"PaxHeaders\") {\r\n\u001b[?2004l\r\u001b[?2004h>             ended = true;\r\n\u001b[?2004l\r\u001b[?2004h>             break;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         let body = off.checked_add(512).ok_or(1)?;'''\r\n\u001b[?2004l\r\u001b[?2004h> assert old in s\r\n\u001b[?2004l\r\u001b[?2004h> "]
