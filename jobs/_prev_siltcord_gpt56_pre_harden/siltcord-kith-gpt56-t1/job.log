child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let out = child.wait_with_output().map_err(|_| 1)?;\n    if !out.status.success() { return Err(1); }\n    let s = std::str::from_utf8(&out.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || (b\'a\'..=b\'f\').contains(&b)) {\n        return Err(1);\n    }\n    Ok(s)\n}\n\n#[path = "../cfgbag/kv.rs"]\nmod kv;\n#[path = "../cfgbag/alias.rs"]\nmod alias;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let archive = std::fs::read(a).map_err(|_| 1)?;\n    let mut recs = read_idx(b)?;\n    recs.sort_by_key(|r| r.hdr);\n\n    // Apply the first regular payload for each supported normalized path.\n    let mut conf: Option<Vec<u8>> = None;\n    let mut logs: Vec<Vec<u8>> = Vec::new();\n    let mut seen_log = false;\n    let mut names = Vec::new();\n    for r in recs {\n        let name = alias::fold(&r.name);\n        if name == "etc/sys.conf" && conf.is_none() {\n            conf = Some(load(&archive, r.body, r.size)?);\n            names.push(name);\n        } else if name == "var/log/app.log" && !seen_log {\n            logs.push(load(&archive, r.body, r.size)?);\n            seen_log = true;\n            names.push(name);\n        }\n    }\n    let conf = conf.ok_or(1)?;\n    if logs.is_empty() { return Err(1); }\n    let map = kv::pairs(&conf);\n    let t = map.get("timezone").cloned().ok_or(1)?;\n    let c = map.get("cluster").cloned().ok_or(1)?;\n    let mut e = Vec::new();\n    for blob in logs {\n        for line in String::from_utf8_lossy(&blob).lines() {\n            let value = line.trim();\n            if !value.is_empty() { e.push(value.to_string()); }\n        }\n    }\n    e.sort();\n    e.dedup();\n    let source = std::path::Path::new(a).file_name()\n        .and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    let w = digest(&names.join("\\n"))?;\n    Ok(Pack { t, c, e, n: names.len() as u32, s: source, w })\n}\nRS\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
