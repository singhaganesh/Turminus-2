ring();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || (b\'a\'..=b\'f\').contains(&b)) { return Err(1); }\n    Ok(s)\n}\n\n#[path = "../keeppit/first.rs"] mod first;\n#[path = "../cfgbag/kv.rs"] mod kv;\n#[path = "../cfgbag/alias.rs"] mod alias;\n#[path = "../ustarwalk/hdr.rs"] mod hdr;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let archive = std::fs::canonicalize(a).map_err(|_| 1)?;\n    let sealwell = std::fs::canonicalize("/app/sealwell").map_err(|_| 1)?;\n    if !archive.starts_with(&sealwell) || !archive.is_file() { return Err(1); }\n\n    let recs = read_idx(b)?;\n    let rows = hdr::scan(a)?;\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b\'0\' || r.flag == 0).collect();\n    if regs.len() != recs.len() { return Err(1); }\n    for (row, rec) in regs.iter().zip(recs.iter()) {\n        if row.name != rec.name || row.hdr != rec.hdr || row.size != rec.size || row.body != rec.body {\n            return Err(1);\n        }\n    }\n\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut events = Vec::new();\n    let mut names = Vec::new();\n    for (row, rec) in regs.iter().zip(recs.iter()) {\n        let blob = hdr::load_body(a, row)?;\n        let name = alias::fold(&rec.name);\n        names.push(name.clone());\n        if name == "etc/sys.conf" || name.ends_with("/sys.conf") {\n            confs.push((name, rec.hdr, blob));\n        } else if name == "var/log/app.log" || name.ends_with("/app.log") {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let value = line.trim();\n                if !value.is_empty() { events.push(value.to_string()); }\n            }\n        }\n    }\n    confs.sort_by_key(|row| row.1);\n    let picked = first::keep_head(&confs).ok_or(1)?;\n    let map = kv::pairs(picked);\n    let timezone = map.get("timezone").cloned().ok_or(1)?;\n    let cluster = map.get("cluster").cloned().ok_or(1)?;\n    events.sort();\n    events.dedup();\n    let source = archive.file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    let walk_sig = digest(&names.join("\\n"))?;\n    Ok(Pack { t: timezone, c: cluster, e: events, n: recs.len() as u32, s: source, w: walk_sig })\n}\nRS\npython3 - <<\'PY\'\np=\'/app/logbag/write.rs\'\ns=open(p).read().replace(\'std::fs::write("/app/deskjson/READY", "ok\\\\n")\', \'std::fs::write("/app/deskjson/READY", "brief-ok")\')\nopen(p,\'w\').write(s)\np=\'/app/siltcli/boot.rs\'\ns=open(p).read()\ns=s.replace(\'    let mut args = std::env::args();\', \'    let _ = std::fs::remove_file("/app/deskjson/READY");\\n    let mut args = std::env::args();\')\nopen(p,\'w\').write(s)\nPY\n/app/wick.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
