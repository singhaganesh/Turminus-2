) as usize; i += 2;\n        if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..i+nl]).map_err(|_| 1)?.to_string(); i += nl;\n        out.push(Rec { name, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn load(raw: &[u8], body: u64, size: u64) -> Result<Vec<u8>, i32> {\n    let s = usize::try_from(body).map_err(|_| 1)?;\n    let z = usize::try_from(size).map_err(|_| 1)?;\n    let e = s.checked_add(z).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new("python3")\n        .args(["-c", "import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let output = child.wait_with_output().map_err(|_| 1)?;\n    if !output.status.success() { return Err(1); }\n    let value = std::str::from_utf8(&output.stdout).map_err(|_| 1)?.trim().to_string();\n    if value.len() != 64 || !value.bytes().all(|b| b.is_ascii_digit() || (b\'a\'..=b\'f\').contains(&b)) { return Err(1); }\n    Ok(value)\n}\n\n#[path = "../keeppit/first.rs"] mod first;\n#[path = "../cfgbag/kv.rs"] mod kv;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    if recs.is_empty() { return Err(1); }\n    let archive = std::fs::read(a).map_err(|_| 1)?;\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut logs = Vec::new();\n    let mut names = Vec::new();\n    for (i, r) in recs.iter().enumerate() {\n        names.push(r.name.clone());\n        let blob = load(&archive, r.body, r.size)?;\n        if r.name.ends_with("sys.conf") { confs.push((r.name.clone(), i as u64, blob)); }\n        else if r.name.ends_with("app.log") { logs.push(blob); }\n    }\n    let picked = first::keep_head(&confs).ok_or(1)?;\n    let map = kv::pairs(picked);\n    let t = map.get("timezone").cloned().ok_or(1)?;\n    let c = map.get("cluster").cloned().ok_or(1)?;\n    let mut e = Vec::new();\n    for blob in logs {\n        for line in String::from_utf8_lossy(&blob).lines() {\n            let value = line.trim();\n            if !value.is_empty() { e.push(value.to_string()); }\n        }\n    }\n    e.sort(); e.dedup();\n    let s = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack { t, c, e, n: recs.len() as u32, s, w: digest(&names.join("\\n"))? })\n}\nRS\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
