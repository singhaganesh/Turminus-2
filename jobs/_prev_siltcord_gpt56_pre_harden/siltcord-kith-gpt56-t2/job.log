Sending keys: ['cat > /app/ustarwalk/hdr.rs <<\'RS\'\n/// A regular ustar member. Headers and payloads are 512-byte aligned.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let field = buf.split(|b| *b == 0).next().unwrap_or(buf);\n    let text = std::str::from_utf8(field).map_err(|_| 1)?.trim();\n    if text.is_empty() { return Ok(0); }\n    u64::from_str_radix(text, 8).map_err(|_| 1)\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut zeros = 0usize;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off + 512];\n        if blk.iter().all(|b| *b == 0) {\n            zeros += 1;\n            off += 512;\n            if zeros == 2 { break; }\n            continue;\n        }\n        if zeros != 0 || &blk[257..262] != b"ustar" { return Err(1); }\n        let nlen = blk[..100].iter().position(|b| *b == 0).unwrap_or(100);\n        if nlen == 0 { return Err(1); }\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let end = (off as u64).checked_add(512).and_then(|x| x.checked_add(padded)).ok_or(1)?;\n        if end > raw.len() as u64 { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: (off + 512) as u64, flag: blk[156] });\n        off = end as usize;\n    }\n    if rows.is_empty() || zeros < 2 { return Err(1); }\n    Ok(rows)\n}\nRS\ncat > /app/idxmill/shard.rs <<\'RS\'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let regs: Vec<_> = rows.iter().filter(|r| r.flag == b\'0\' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b"SILT1");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    std::fs::write(b, out).map(|_| 0).unwrap_or(1)\n}\nRS\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
