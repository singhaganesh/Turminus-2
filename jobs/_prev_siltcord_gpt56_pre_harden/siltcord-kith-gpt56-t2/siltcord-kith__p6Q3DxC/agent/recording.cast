[132.402785, "i", "cat > /app/siltcli/quarry.rs <<'RS'\n#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\n#[path = \"../idxmill/shard.rs\"] mod shard;\n\npub fn go(a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    shard::rib_a(a, b)\n}\nRS\ncat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"] mod blend;\n#[path = \"../logbag/write.rs\"] mod uni;\n\nfn sealed(path: &str) -> bool {\n    let p = match std::fs::canonicalize(path) { Ok(x) => x, Err(_) => return false };\n    let root = match std::fs::canonicalize(\"/app/sealwell\") { Ok(x) => x, Err(_) => return false };\n    p.starts_with(root) && p.is_file()\n}\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    if !sealed(a) { return 1; }\n    match blend::rib_b(a, b) { Ok(p) => uni::rib_c(&p, out, a), Err(c) => c }\n}\nRS\npython3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read().replace('\"ok\\\\n\"', '\"brief-ok\\\\n\"')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/siltcord\n"]
