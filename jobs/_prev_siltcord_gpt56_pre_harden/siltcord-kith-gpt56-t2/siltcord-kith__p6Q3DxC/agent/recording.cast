[32.487662, "i", "python3 - <<'PY'\nimport tarfile, hashlib\np='/app/sealwell/kestrel.kith'\nwith tarfile.open(p,'r:') as t:\n    regs=[]\n    for m in t:\n        print(repr(m.name), 'type='+repr(m.type), 'size='+str(m.size), 'offset='+str(m.offset), 'data='+str(m.offset_data))\n        if m.isfile():\n            regs.append(m.name)\n            data=t.extractfile(m).read()\n            print('  payload:',repr(data))\nprint('regular names:', regs)\nprint('walk input:',repr('\\n'.join(regs)))\nprint('walk_sig:',hashlib.sha256('\\n'.join(regs).encode()).hexdigest())\nPY\n"]
