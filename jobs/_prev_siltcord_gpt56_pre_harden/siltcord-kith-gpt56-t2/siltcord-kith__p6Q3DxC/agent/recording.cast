[132.099429, "i", "cat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n#[path = \"../paxcue/long.rs\"]\nmod paxcue;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let mut regs = Vec::new();\n    for r in &rows {\n        if paxcue::peek(&r.name) { break; }\n        if r.flag == b'0' || r.flag == 0 { regs.push(r); }\n    }\n    if regs.is_empty() { return 1; }\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    std::fs::write(b, out).map(|_| 0).unwrap_or(1)\n}\nRS\ncat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let _hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..i+nl]).map_err(|_| 1)?.to_string(); i += nl;\n        out.push(Rec { name, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn load(raw: &[u8], body: u64, size: u64) -> Result<Vec<u8>, i32> {\n    let s = usize::try_from(body).map_err(|_| 1)?;\n    let z = usize::try_from(size).map_err(|_| 1)?;\n    let e = s.checked_add(z).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let output = child.wait_with_output().map_err(|_| 1)?;\n    if !output.status.success() { return Err(1); }\n    let value = std::str::from_utf8(&output.stdout).map_err(|_| 1)?.trim().to_string();\n    if value.len() != 64 || !value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) { return Err(1); }\n    Ok(value)\n}\n\n#[path = \"../keeppit/first.rs\"] mod first;\n#[path = \"../cfgbag/kv.rs\"] mod kv;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    if recs.is_empty() { return Err(1); }\n    let archive = std::fs::read(a).map_err(|_| 1)?;\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut logs = Vec::new();\n    let mut names = Vec::new();\n    for (i, r) in recs.iter().enumerate() {\n        names.push(r.name.clone());\n        let blob = load(&archive, r.body, r.size)?;\n        if r.name.ends_with(\"sys.conf\") { confs.push((r.name.clone(), i as u64, blob)); }\n        else if r.name.ends_with(\"app.log\") { logs.push(blob); }\n    }\n    let picked = first::keep_head(&confs).ok_or(1)?;\n    let map = kv::pairs(picked);\n    let t = map.get(\"timezone\").cloned().ok_or("]
[132.099644, "i", "1)?;\n    let c = map.get(\"cluster\").cloned().ok_or(1)?;\n    let mut e = Vec::new();\n    for blob in logs {\n        for line in String::from_utf8_lossy(&blob).lines() {\n            let value = line.trim();\n            if !value.is_empty() { e.push(value.to_string()); }\n        }\n    }\n    e.sort(); e.dedup();\n    let s = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack { t, c, e, n: recs.len() as u32, s, w: digest(&names.join(\"\\n\"))? })\n}\nRS\n"]
