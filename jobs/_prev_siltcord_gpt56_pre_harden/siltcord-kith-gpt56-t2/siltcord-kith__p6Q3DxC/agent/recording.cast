[55.81205, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// A regular ustar member. Headers and payloads are 512-byte aligned.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let field = buf.split(|b| *b == 0).next().unwrap_or(buf);\n    let text = std::str::from_utf8(field).map_err(|_| 1)?.trim();\n    if text.is_empty() { return Ok(0); }\n    u64::from_str_radix(text, 8).map_err(|_| 1)\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut zeros = 0usize;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off + 512];\n        if blk.iter().all(|b| *b == 0) {\n            zeros += 1;\n            off += 512;\n            if zeros == 2 { break; }\n            continue;\n        }\n        if zeros != 0 || &blk[257..262] != b\"ustar\" { return Err(1); }\n        let nlen = blk[..100].iter().position(|b| *b == 0).unwrap_or(100);\n        if nlen == 0 { return Err(1); }\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let end = (off as u64).checked_add(512).and_then(|x| x.checked_add(padded)).ok_or(1)?;\n        if end > raw.len() as u64 { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: (off + 512) as u64, flag: blk[156] });\n        off = end as usize;\n    }\n    if rows.is_empty() || zeros < 2 { return Err(1); }\n    Ok(rows)\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let regs: Vec<_> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    std::fs::write(b, out).map(|_| 0).unwrap_or(1)\n}\nRS\n"]
[55.813067, "o", "cat > /app/ustarwalk/hdr.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.813176, "o", "/// A regular ustar member. Headers and payloads are 512-byte aligned.\r\n\u001b[?2004l\r\u001b[?2004h> pub struct Row {\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.813208, "o", "> "]
[55.813261, "o", "    pub name: String,\r\n\u001b[?2004l\r"]
[55.813372, "o", "\u001b[?2004h>     pub hdr: u64,\r\n\u001b[?2004l\r"]
[55.813417, "o", "\u001b[?2004h> "]
[55.813829, "o", "    pub size: u64,\r\n\u001b[?2004l\r"]
[55.81388, "o", "\u001b[?2004h> "]
[55.815664, "o", "    pub body: u64,\r\n\u001b[?2004l\r\u001b[?2004h>     pub flag: u8,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn oct_u64(buf: &[u8]) -> Result<u64, i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let field = buf.split(|b| *b == 0).next().unwrap_or(buf);\r\n\u001b[?2004l\r\u001b[?2004h>     let text = std::str::from_utf8(field).map_err(|_| 1)?.trim();\r\n\u001b[?2004l\r\u001b[?2004h>     if text.is_empty() { return Ok(0); }\r\n\u001b[?2004l\r\u001b[?2004h>     u64::from_str_radix(text, 8).map_err(|_| 1)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let raw = std::fs::read(path).map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\r\n\u001b[?2004l\r"]
[55.81592, "o", "\u001b[?2004h> "]
[55.81596, "o", "    let mut rows = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut off = 0usize;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.816047, "o", "    let mut zeros = 0usize;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.816239, "o", "    while off + 512 <= raw.len() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.81632, "o", "        let blk = &raw[off..off + 512];\r\n\u001b[?2004l\r"]
[55.816397, "o", "\u001b[?2004h> "]
[55.816483, "o", "        if blk.iter().all(|b| *b == 0) {\r\n\u001b[?2004l\r"]
[55.81657, "o", "\u001b[?2004h> "]
[55.816669, "o", "            zeros += 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.816762, "o", "            off += 512;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.816841, "o", "            if zeros == 2 { break; }\r\n\u001b[?2004l\r"]
[55.816881, "o", "\u001b[?2004h"]
[55.816961, "o", "> "]
[55.817046, "o", "            continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.817115, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.817298, "o", "        if zeros != 0 || &blk[257..262] != b\"ustar\" { return Err(1); }\r\n\u001b[?2004l\r"]
[55.817851, "o", "\u001b[?2004h>         let nlen = blk[..100].iter().position(|b| *b == 0).unwrap_or(100);\r\n\u001b[?2004l\r\u001b[?2004h>         if nlen == 0 { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.817948, "o", "        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\r\n\u001b[?2004l\r"]
[55.818408, "o", "\u001b[?2004h"]
[55.818443, "o", ">         let size = oct_u64(&blk[124..136])?;\r\n\u001b[?2004l\r\u001b[?2004h>         let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.818742, "o", "        let end = (off as u64).checked_add(512).and_then(|x| x.checked_add(padded)).ok_or(1)?;\r\n\u001b[?2004l\r"]
[55.818768, "o", "\u001b[?2004h> "]
[55.818948, "o", "        if end > raw.len() as u64 { return Err(1); }\r\n\u001b[?2004l\r"]
[55.819078, "o", "\u001b[?2004h> "]
[55.819249, "o", "        rows.push(Row { name, hdr: off as u64, size, body: (off + 512) as u64, flag: blk[156] });\r\n\u001b[?2004l\r"]
[55.819349, "o", "\u001b[?2004h> "]
[55.819477, "o", "        off = end as usize;\r\n\u001b[?2004l\r"]
[55.819572, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.81972, "o", "    if rows.is_empty() || zeros < 2 { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.819741, "o", "    Ok(rows)\r\n\u001b[?2004l\r"]
[55.820089, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[55.821457, "o", "\u001b[?2004hroot@0d73b1019b2a:/app# "]
[55.821609, "o", "cat > /app/idxmill/shard.rs <<'RS'"]
[55.821715, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> use super::hdr;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.821846, "o", "pub fn rib_a(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.821897, "o", "> "]
[55.822047, "o", "    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\r\n\u001b[?2004l\r"]
[55.822078, "o", "\u001b[?2004h> "]
[55.822311, "o", "    let regs: Vec<_> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\r\n\u001b[?2004l\r"]
[55.822428, "o", "\u001b[?2004h> "]
[55.82259, "o", "    let mut out = Vec::new();\r\n\u001b[?2004l\r"]
[55.822702, "o", "\u001b[?2004h> "]
[55.822792, "o", "    out.extend_from_slice(b\"SILT1\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.822952, "o", "    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\r\n\u001b[?2004l\r"]
[55.823056, "o", "\u001b[?2004h> "]
[55.824718, "o", "    for r in regs {\r\n\u001b[?2004l\r\u001b[?2004h>         out.extend_from_slice(&r.hdr.to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h>         out.extend_from_slice(&r.size.to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h>         out.extend_from_slice(&r.body.to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h>         let nb = r.name.as_bytes();\r\n\u001b[?2004l\r\u001b[?2004h>         if nb.len() > u16::MAX as usize { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>         out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\r\n\u001b[?2004l\r"]
[55.82507, "o", "\u001b[?2004h>         out.extend_from_slice(nb);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.825144, "o", "    std::fs::write(b, out).map(|_| 0).unwrap_or(1)\r\n\u001b[?2004l\r"]
[55.825167, "o", "\u001b[?2004h"]
[55.825182, "o", "> }\r\n"]
[55.825196, "o", "\u001b[?2004l\r"]
[55.825392, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[55.8274, "o", "\u001b[?2004hroot@0d73b1019b2a:/app# "]
