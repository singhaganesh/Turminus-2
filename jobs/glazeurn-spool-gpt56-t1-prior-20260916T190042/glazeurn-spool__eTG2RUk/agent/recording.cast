[84.493828, "i", "cat > /app/foldrib/rim.rs <<'EOF'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\n        cells: b.cells.clone(),\n    }\n}\nEOF\ncat > /app/internpit/pool.rs <<'EOF'\nuse crate::fold;\nuse crate::hold;\nuse crate::load;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\n    if a.cells.is_empty() {\n        a.cells = b.cells.clone();\n    }\n}\n\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut f = fold::rim_a(a, b);\n    rim_b(&mut f, b);\n    f\n}\n\nfn quote(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\nfn values(ids: &[usize], cells: &[String]) -> Option<Vec<String>> {\n    ids.iter().map(|&i| cells.get(i).cloned()).collect()\n}\n\nfn pack(items: &[String]) -> String {\n    format!(\"[{}]\", items.iter().map(|s| quote(s)).collect::<Vec<_>>().join(\",\"))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\n        return 1;\n    };\n    let heat = sess.flag;\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n    let Some(frost_bag) = values(&frost.ids.borrow(), &frost.cells) else { return 1 };\n    let Some(live_bag) = values(&sess.ids.borrow(), &pool.cells) else { return 1 };\n    if heat && frost_bag == live_bag {\n        return 1;\n    }\n    let body = format!(\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\n        sess.n0.saturating_add(tally::lines()), sess.n1,\n        pack(&frost_bag), pack(&live_bag)\n    );\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    if fs::write(dest, body).is_ok() { 0 } else { 2 }\n}\nEOF\ncat > /app/restcue/ink.rs <<'EOF'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    let guard = Path::new(\"/app/inkpit/GUARD\");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(dest);\n    let code = pool::dump();\n    if code != 0 {\n        let _ = fs::remove_file(guard);\n        let _ = fs::remove_file(dest);\n        return code;\n    }\n    if fs::write(guard, \"ok\\n\").is_err() {\n        let _ = fs::remove_file(guard);\n        return 2;\n    }\n    0\n}\nEOF\ncat > /app/coverpit/tally.rs <<'EOF'\nstruct Desk;\n\npub fn lines() -> u32 {\n    let _ = Desk;\n    let text = std::fs::read_to_string(\"/app/coverpit/COVER.txt\").unwrap_or_default();\n    if text.contains(\"Desk count 9\") { 9 } else { 0 }\n}\nEOF\ncat > /app/sessbay/load.rs <<'EOF'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::fs;\nuse std::rc::Rc;\n\npub struct Plan {\n    pub old: String,\n    pub new: String,\n    pub extra: String,\n}\n\npub fn kiln_pitch(n0: u32, n1: u32, _width: u32, _heat: bool) -> (u32, u32) {\n    (n0.saturating_add(1), n1.saturating_add(2))\n}\n\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\n    let text = fs::read_to_string(p).ok()?;\n    if text.trim().is_empty() { return None; }\n    let mut n0 = None;\n    let mut n1 = None;\n    let mut cells: Option<Vec<String>> = None;\n    let mut mode: Option<bool> = None;\n    let mut old: Option<String> = None;\n    let mut new: Option<String> = None;\n    let mut extra: Option<String> = None;\n    for raw in text.lines() {\n        let line = raw.trim();\n        if line.is_empty() || line.starts_with('#') { continue; }\n        let words: Vec<&str> = line.split_whitespace().collect();\n        match words.as_slice() {\n      "]
[84.493918, "i", "      [\"tick\", v] if n0.is_none() => n0 = Some(v.parse().ok()?),\n            [\"mark\", v] if n1.is_none() => n1 = Some(v.parse().ok()?),\n            [\"bag\", rest @ ..] if cells.is_none() && !rest.is_empty() => {\n                cells = Some(rest.iter().map(|s| (*s).to_string()).collect())\n            }\n            [\"mode\", \"heat\"] if mode.is_none() => mode = Some(true),\n            [\"mode\", \"peek\"] if mode.is_none() => mode = Some(false),\n            [\"swap\", a, b] if old.is_none() => {\n                old = Some((*a).to_string()); new = Some((*b).to_string());\n            }\n            [\"push\", v] if extra.is_none() => extra = Some((*v).to_string()),\n            _ => return None,\n        }\n    }\n    let heat = mode?;\n    if heat && (old.is_none() || new.is_none() || extra.is_none()) { return None; }\n    if !heat && (old.is_some() || new.is_some() || extra.is_some()) { return None; }\n    let cells = cells?;\n    let ids = (0..cells.len()).collect();\n    Some((\n        hold::Sess { n0: n0?, n1: n1?, ids: Rc::new(RefCell::new(ids)), flag: heat },\n        hold::Pool { cells },\n        Plan { old: old.unwrap_or_default(), new: new.unwrap_or_default(), extra: extra.unwrap_or_default() },\n    ))\n}\n\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\n    let width = a.ids.borrow().len() as u32;\n    if a.flag {\n        for c in &mut b.cells {\n            if *c == p.old { *c = p.new.clone(); }\n        }\n        b.cells.push(p.extra.clone());\n        a.ids.borrow_mut().push(b.cells.len() - 1);\n    }\n    (a.n0, a.n1) = kiln_pitch(a.n0, a.n1, width, a.flag);\n}\nEOF\n"]
[84.497882, "o", "cat > /app/foldrib/rim.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use crate::hold;\r\n\u001b[?2004l\r\u001b[?2004h> use std::cell::RefCell;\r\n\u001b[?2004l\r\u001b[?2004h> use std::rc::Rc;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n\u001b[?2004l\r\u001b[?2004h>     hold::Frost {\r\n\u001b[?2004l\r\u001b[?2004h>         n0: a.n0,\r\n\u001b[?2004l\r\u001b[?2004h>         n1: a.n1,\r\n\u001b[?2004l\r\u001b[?2004h>         ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\r\n\u001b[?2004l\r\u001b[?2004h>         cells: b.cells.clone(),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r      [\"tick\", v] if n0.is_none() => n0 = Some(v.parse().ok()?),\r\n            [\"mark\", v] if n1.is_none() => n1 = Some(v.parse().ok()?),\r\n            [\"bag\", rest @ ..] if cells.is_none() && !rest.is_empty() => {\r\n                cells = Some(rest.iter().map(|s| (*s).to_string()).collect())\r\n            }\r\n          "]
