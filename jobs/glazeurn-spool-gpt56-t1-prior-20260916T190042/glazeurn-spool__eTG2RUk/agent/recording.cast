[84.678124, "o", "\u001b[?2004h> "]
[84.678264, "o", "const FOLD: &str = include_str!(\"../foldrib/rim.rs\");\r\n\u001b[?2004l\r"]
[84.678349, "o", "\u001b[?2004h> "]
[84.678582, "o", "const INTERN: &str = include_str!(\"../internpit/pool.rs\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.678609, "o", "const REST: &str = include_str!(\"../restcue/ink.rs\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.678625, "o", "> "]
