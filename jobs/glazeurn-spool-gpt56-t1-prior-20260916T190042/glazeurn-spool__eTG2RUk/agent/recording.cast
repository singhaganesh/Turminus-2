[84.678755, "o", "\u001b[?2004h> "]
[84.679142, "o", "const MAIN: &str = include_str!(\"main.rs\");\r\n\u001b[?2004l\r"]
[84.680372, "o", "\u001b[?2004h> "]
[84.681862, "o", "const BOOT: &str = include_str!(\"../steerpit/boot.rs\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn walk_cards(path: &Path) -> Result<(), ()> {\r\n\u001b[?2004l\r\u001b[?2004h>     let entries = fs::read_dir(path).map_err(|_| ())?;\r\n\u001b[?2004l\r\u001b[?2004h>     for entry in entries {\r\n\u001b[?2004l\r\u001b[?2004h>         let entry = entry.map_err(|_| ())?;\r\n\u001b[?2004l\r\u001b[?2004h>         let ty = entry.file_type().map_err(|_| ())?;\r\n\u001b[?2004l\r\u001b[?2004h>         if ty.is_dir() {\r\n\u001b[?2004l\r\u001b[?2004h>             walk_cards(&entry.path())?;\r\n\u001b[?2004l\r\u001b[?2004h>         } else if ty.is_file() {\r\n\u001b[?2004l\r\u001b[?2004h>             fs::read(entry.path()).map_err(|_| ())?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.682182, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     Ok(())\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.68232, "o", "fn put(path: &str, body: &str) -> Result<(), ()> {\r\n\u001b[?2004l\r"]
[84.682431, "o", "\u001b[?2004h> "]
[84.682513, "o", "    fs::write(path, body).map_err(|_| ())\r\n\u001b[?2004l\r"]
[84.682656, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[84.682791, "o", "\u001b[?2004h> pub fn rib_d() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.682929, "o", "    if walk_cards(Path::new(\"/app/daycards\")).is_err() { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.683065, "o", "    let tree = match fs::read_to_string(\"/app/vatslip/TREE.txt\") {\r\n\u001b[?2004l\r"]
[84.683084, "o", "\u001b[?2004h> "]
[84.683153, "o", "        Ok(v) => v,\r\n\u001b[?2004l\r"]
[84.68317, "o", "\u001b[?2004h> "]
[84.683287, "o", "        Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.68344, "o", ">     };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.683494, "o", "    for raw in tree.lines() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.683518, "o", "        let name = raw.trim();\r\n\u001b[?2004l\r"]
[84.683637, "o", "\u001b[?2004h> "]
[84.683857, "o", "        if name.is_empty() || name.starts_with('#') { continue; }\r\n\u001b[?2004l\r"]
[84.683878, "o", "\u001b[?2004h>         let result = match name {\r\n\u001b[?2004l\r"]
