[11.886427, "o", "### /app/internpit/pool.rs\r\n"]
[11.889713, "o", "use crate::fold;\r\nuse crate::hold;\r\nuse crate::load;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n    let _ = (a, b);\r\n}\r\n\r\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let mut f = fold::rim_a(a, b);\r\n    rim_b(&mut f, b);\r\n    f\r\n}\r\n\r\nfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    let mut parts = Vec::new();\r\n    for &i in ids {\r\n"]
[11.889779, "o", "        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    }\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n}\r\n\r\npub fn dump() -> i32 {\r\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n        return 1;\r\n    };\r\n    let frost = prep(&sess, &pool);\r\n    load::step(&mut sess, &mut pool, &plan);\r\n    let live_ids = sess.ids.borrow().clone();\r\n    let _frost_ids = frost.ids.borrow().clone();\r\n    let extra = tally::lines();\r\n    let frost_s = pack(&live_ids, &pool.cells);\r\n    let live_s = pack(&live_ids, &pool.cells);\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    let body = format!(\r\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n        sess.n0.saturating_add(extra),\r\n        sess.n1,\r\n        frost_s,\r\n        live_s\r\n    );\r\n    match fs::write(dest, body) {\r\n        Ok(()) => 0,\r\n        Err(_) => 2,\r\n    }\r\n}\r\n"]
[11.890324, "o", "/app/foldrib/rim.rs\r\n"]
[11.891184, "o", "### /app/foldrib/rim.rs\r\n"]
[11.894162, "o", "use crate::hold;\r\n\r\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let _ = b;\r\n    hold::Frost {\r\n        n0: a.n0,\r\n        n1: a.n1,\r\n        ids: a.ids.clone(),\r\n        cells: Vec::new(),\r\n    }\r\n}\r\n"]
[11.894849, "o", "/app/restcue/ink.rs\r\n"]
[11.896164, "o", "### /app/restcue/ink.rs\r\n"]
[11.898152, "o", "use crate::load;\r\nuse crate::pool;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n"]
[11.898344, "o", "    }\r\n    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n        let _ = fs::write(\r\n            dest,\r\n            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n        );\r\n        let _ = fs::write(guard, \"ok\\n\");\r\n        return 0;\r\n    }\r\n    let _ = pool::dump();\r\n    let _ = fs::write(guard, \"ok\\n\");\r\n    0\r\n}\r\n"]
[11.89901, "o", "/app/coverpit/tally.rs\r\n"]
[11.900011, "o", "### /app/coverpit/tally.rs\r\n"]
[11.901143, "o", "struct Desk;\r\n\r\npub fn lines() -> u32 {\r\n    let _ = Desk;\r\n    let text = std::fs::read_to_string(\"/app/coverpit/COVER.txt\").unwrap_or_default();\r\n    let _ = text.contains(\"Desk\");\r\n    0\r\n}\r\n"]
[11.901725, "o", "/app/emitbay/hearth.rs\r\n"]
[11.902459, "o", "### /app/emitbay/hearth.rs\r\n"]
[11.903571, "o", "use std::fs;\r\n\r\npub fn rib_d() -> i32 {\r\n    let _ = fs::read_dir(\"/app/daycards\");\r\n    let rim = r#\"use crate::hold;\r\n\r\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let _ = b;\r\n    hold::Frost {\r\n        n0: a.n0,\r\n        n1: a.n1,\r\n        ids: a.ids.clone(),\r\n        cells: Vec::new(),\r\n"]
[11.903684, "o", "    }\r\n}\r\n\"#;\r\n    let pool = r#\"use crate::fold;\r\nuse crate::hold;\r\nuse crate::load;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n    let _ = (a, b);\r\n}\r\n\r\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let mut f = fold::rim_a(a, b);\r\n    rim_b(&mut f, b);\r\n    f\r\n}\r\n\r\nfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    let mut parts = Vec::new();\r\n    for &i in ids {\r\n        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    }\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n}\r\n\r\npub fn dump() -> i32 {\r\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n        return 1;\r\n    };\r\n    let frost = prep(&sess, &pool);\r\n    load::step(&mut sess, &mut pool, &plan);\r\n    let live_ids = sess.ids.borrow().clone();\r\n    let _frost_ids = frost.ids.borrow().clone();\r\n    let extra = tally::lines();\r\n    let frost_s = pack(&live_ids, &pool.cells);\r\n    let live_s = pack(&live_ids, &pool.cells);\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    let body = format!(\r\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n        sess.n0.saturating_add(extra),\r\n"]
[11.903796, "o", "        sess.n1,\r\n        frost_s,\r\n        live_s\r\n    );\r\n    match fs::write(dest, body) {\r\n        Ok(()) => 0,\r\n        Err(_) => 2,\r\n    }\r\n}\r\n\"#;\r\n    let ink = r#\"use crate::load;\r\nuse crate::pool;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n        let _ = fs::write(\r\n            dest,\r\n            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n        );\r\n        let _ = fs::write(guard, \"ok\\n\");\r\n        return 0;\r\n    }\r\n    let _ = pool::dump();\r\n    let _ = fs::write(guard, \"ok\\n\");\r\n    0\r\n}\r\n\"#;\r\n    if fs::write(\"/app/foldrib/rim.rs\", rim).is_err() {\r\n        return 2;\r\n    }\r\n"]
[11.903821, "o", "    if fs::write(\"/app/internpit/pool.rs\", pool).is_err() {\r\n        return 2;\r\n    }\r\n    if fs::write(\"/app/restcue/ink.rs\", ink).is_err() {\r\n        return 2;\r\n    }"]
[11.903834, "o", "\r\n    0\r\n}\r\n"]
[11.904173, "o", "/app/emitbay/main.rs\r\n"]
[11.90495, "o", "### /app/emitbay/main.rs\r\n"]
[11.906019, "o", "#[path = \"hearth.rs\"]\r\nmod hearth;\r\n\r\nfn main() {\r\n    let code = hearth::rib_d();\r\n    std::process::exit(code);\r\n}\r\n"]
[11.906321, "o", "/app/sessbay/load.rs\r\n"]
[11.907009, "o", "### /app/sessbay/load.rs\r\n"]
[11.910559, "o", "use crate::hold;\r\nuse std::cell::RefCell;\r\nuse std::fs;\r\nuse std::rc::Rc;\r\n\r\npub struct Plan {\r\n    pub old: String,\r\n    pub new: String,\r\n    pub extra: String,\r\n}\r\n\r\npub fn kiln_pitch(n0: u32, n1: u32, width: u32, heat: bool) -> (u32, u32) {\r\n    let tick = n0.saturating_add(width);\r\n    let mark = n1.saturating_add(if heat { 2 } else { 1 });\r\n    (tick, mark)\r\n}\r\n\r\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\r\n    let text = fs::read_to_string(p).ok()?;\r\n    if text.trim().is_empty() {\r\n        return None;\r\n    }\r\n    let mut n0 = None;\r\n    let mut n1 = None;\r\n    let mut cells: Vec<String> = Vec::new();\r\n    let mut flag = false;\r\n    let mut old = String::new();\r\n    let mut new = String::new();\r\n    let mut extra = String::new();\r\n    for raw in text.lines() {\r\n        let line = raw.trim();\r\n        if line.is_empty() || line.starts_with('#') {\r\n            continue;\r\n        }\r\n        let mut it = line.split_whitespace();\r\n        let key = it.next()?;\r\n        match key {\r\n            \"tick\" => n0 = it.next()?.parse().ok(),\r\n            \"mark\" => n1 = it.next()?.parse().ok(),\r\n            \"bag\" => cells = it.map(|s| s.to_string()).collect(),\r\n            \"mode\" => flag = it.next() == Some(\"heat\"),\r\n            \"swap\" => {\r\n                old = it.next()?.to_string();\r\n                new = it.next()?.to_string();\r\n            }\r\n            \"push\" => extra = it.next()?.to_string(),\r\n            _ => {}\r\n        }\r\n    }\r\n    let n0 = n0?;\r\n    let n1 = n1?;\r\n    if cells.is_empty() {\r\n        return None;\r\n    }\r\n    let ids: Vec<usize> = (0..cells.len()).collect();\r\n    let sess = hold::Sess {\r\n        n0,\r\n        n1,\r\n        ids: Rc::new(RefCell::new(ids)),\r\n        flag,\r\n    };\r\n    let pool = hold::Pool { cells };\r\n    Some((sess, pool, Plan { old, new, extra }))\r\n}\r\n\r\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\r\n    let width = a.ids.borrow().len() as u32;\r\n    if a.flag {\r\n        for c in b.cells.iter_mut() {\r\n            if *c == p.old {\r\n                *c = p.new.clone();\r\n            }\r\n        }\r\n        if !p.extra.is_empty() {\r\n            b.cells.push(p.extra.clone());\r\n            a.ids.borrow_mut().push(b.cells.len() - 1);\r\n        }\r\n    }\r\n    let (tick, mark) = kiln_pitch(a.n0, a.n1, width, a.flag);\r\n    a.n0 = tick;\r\n    a.n1 = mark;\r\n}\r\n/app/sessbay/hold.rs\r\n"]
[11.91201, "o", "### /app/sessbay/hold.rs\r\n"]
[11.913433, "o", "use std::cell::RefCell;\r\nuse std::rc::Rc;\r\n\r\n#[allow(dead_code)]\r\npub struct Pool {\r\n    pub cells: Vec<String>,\r\n}\r\n\r\npub struct Sess {\r\n    pub n0: u32,\r\n    pub n1: u32,\r\n    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    pub flag: bool,\r\n}\r\n\r\n#[allow(dead_code)]\r\npub struct Frost {\r\n    pub n0: u32,\r\n    pub n1: u32,"]
[11.913481, "o", "\r\n    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    pub cells: Vec<String>,\r\n}\r\n"]
[11.91402, "o", "/app/steerpit/boot.rs\r\n"]
[11.914825, "o", "### /app/steerpit/boot.rs\r\n"]
[11.915924, "o", "#[path = \"../sessbay/hold.rs\"]\r\nmod hold;\r\n#[path = \"../sessbay/load.rs\"]\r\nmod load;\r\n#[path = \"../foldrib/rim.rs\"]\r\nmod fold;\r\n#[path = \"../internpit/pool.rs\"]\r\nmod pool;\r\n#[path = \"../restcue/ink.rs\"]\r\nmod vat;\r\n#[path = \"../coverpit/tally.rs\"]\r\nmod tally;\r\n"]
[11.916089, "o", "#[path = \"../emitbay/hearth.rs\"]\r\nmod emit;\r\n\r\nfn main() {\r\n    let cmd = std::env::args().nth(1).unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"bind\" => emit::rib_d(),\r\n        \"pair\" => vat::rim_c(),\r\n        _ => {\r\n            eprintln!(\"usage: glazeurn bind|pair\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[11.91631, "o", "/app/bake.sh\r\n"]
[11.916953, "o", "### /app/bake.sh\r\n"]
[11.917843, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/inkpit\r\nrustc --edition 2021 -O /app/emitbay/main.rs -o /tmp/glaze-emit\r\n/tmp/glaze-emit\r\n"]
[11.917925, "o", "rustc --edition 2021 -O /app/steerpit/boot.rs -o /app/bin/glazeurn\r\n"]
[11.918484, "o", "\u001b[?2004hroot@01e6ae40db4c:/app# "]
[22.338148, "i", "echo '--- ROUTE ---'; cat /app/vatslip/ROUTE.txt; echo '--- LAYOUT ---'; cat /app/noteurn/LAYOUT.txt; echo '--- COVER ---'; cat /app/coverpit/COVER.txt; echo '--- usage ---'; cat /app/steerpit/usage.txt; echo '--- artifacts ---'; ls -l /app/bin /app/inkpit; cat /app/inkpit/pair.json 2>/dev/null || true; cat /app/inkpit/GUARD 2>/dev/null || true; echo '--- hearth 1 ---'; nl -ba /app/emitbay/hearth.rs | sed -n '1,220p'; echo '--- hearth 2 ---'; nl -ba /app/emitbay/hearth.rs | sed -n '221,500p'; rustc --version\n"]
[22.339671, "o", "echo '--- ROUTE ---'; cat /app/vatslip/ROUTE.txt; echo '--- LAYOUT ---'; cat /app/noteurn/LAYOUT.txt; echo '--- COVER ---'; cat /app/coverpit/COVER.txt; echo '--- usage ---'; cat /app/steerpit/usage.txt; echo '--- artifacts ---'; ls -l /app/bin /app/inkpit; cat /app/inkpit/pair.json 2>/dev/null || true; cat /app/inkpit/GUARD 2>/dev/null || true; echo '--- hearth 1 ---'; nl -ba /app/emitbay/hearth.rs | sed -n '1,220p'; echo '--- hearth 2 ---'; nl -ba /app/emitbay/hearth.rs | sed -n '221,500p'; rustc --version\r\n\u001b[?2004l\r"]
[22.34002, "o", "--- ROUTE ---\r\n"]
[22.367521, "o", "Cards live under /app/daycards. The working spool is /app/spoolbay/shift.spool.\r\nSpare kiln tapes sit at /app/spoolbay/canon.spool and /app/spoolbay/spare.spool.\r\npair writes /app/inkpit/pair.json. bind refreshes mill pieces from TREE.txt.\r\n"]
[22.36778, "o", "--- LAYOUT ---\r\n"]
[22.369021, "o", "pair.json keys tick mark frost_bag live_bag\r\n"]
[22.369341, "o", "--- COVER ---\r\n"]
[22.37009, "o", "Kiln pitch after every mode is tick plus one and mark plus two.\r\nA clone of the session handle is the freeze. Desk count 9 belongs on tick.\r\nThe mill reads this slip during bind walks.\r\nKeep the count on the desk slip only.\r\n"]
[22.370227, "o", "--- usage ---\r\n"]
[22.371053, "o", "glazeurn bind\r\nglazeurn pair\r\n"]
[22.371205, "o", "--- artifacts ---\r\n"]
[22.372962, "o", "/app/bin:\r\n"]
[22.373079, "o", "total 3928\r\n"]
[22.373162, "o", "-rwxr-xr-x 1 root root 4019880 Sep 16 12:03 glazeurn\r\n\r\n/app/inkpit:\r\n"]
[22.373273, "o", "total 8\r\n-rw-r--r-- 1 root root  3 Sep 16 12:03 GUARD\r\n-rw-r--r-- 1 root root 96 Sep 16 12:03 pair.json\r\n"]
[22.374823, "o", "{\"tick\":10,\"mark\":6,\"frost_bag\":[\"oak\",\"yew\",\"ash\",\"fir\"],\"live_bag\":[\"oak\",\"yew\",\"ash\",\"fir\"]}\r\n"]
