[84.537472, "o", ">     let dest = Path::new(\"/app/inkpit/pair.json\");"]
[84.537503, "o", "\r\n"]
[84.537535, "o", "\u001b[?2004l\r"]
[84.537706, "o", "\u001b[?2004h> "]
[84.537744, "o", "    if let Some(parent) = dest.parent() {\r\n\u001b[?2004l\r"]
[84.53776, "o", "\u001b[?2004h> "]
[84.538183, "o", "        if fs::create_dir_all(parent).is_err() { return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[84.538207, "o", "\u001b[?2004h"]
[84.538274, "o", "> "]
[84.538435, "o", "    if fs::write(dest, body).is_ok() { 0 } else { 2 }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[84.540106, "o", "\u001b[?2004hroot@01e6ae40db4c:/app# "]
[84.540321, "o", "cat > /app/restcue/ink.rs <<'EOF'\r\n\u001b[?2004l\r"]
[84.54045, "o", "\u001b[?2004h> "]
[84.54052, "o", "use crate::pool;"]
[84.540539, "o", "\r\n\u001b[?2004l\r"]
[84.540634, "o", "\u001b[?2004h> "]
[84.54074, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> use std::path::Path;\r\n\u001b[?2004l\r"]
[84.540759, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[84.541009, "o", "\u001b[?2004h> pub fn rim_c() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.541217, "o", "    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n\u001b[?2004l\r"]
[84.541308, "o", "\u001b[?2004h> "]
[84.541554, "o", "    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.541634, "o", "    let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r"]
[84.541815, "o", "\u001b[?2004h>     let _ = fs::remove_file(dest);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.541967, "o", "    let code = pool::dump();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.54216, "o", "    if code != 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.542343, "o", "        let _ = fs::remove_file(dest);\r\n\u001b[?2004l\r\u001b[?2004h>         return code;\r\n\u001b[?2004l\r"]
[84.5425, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.542627, "o", "    if fs::write(guard, \"ok\\n\").is_err() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.542785, "o", "        let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>         return 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.542879, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r"]
[84.543086, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[84.545902, "o", "\u001b[?2004h"]
[84.545951, "o", "root@01e6ae40db4c:/app# cat > /app/coverpit/tally.rs <<'EOF'"]
[84.546437, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> struct Desk;"]
[84.546492, "o", "\r\n\u001b[?2004l\r"]
[84.546551, "o", "\u001b[?2004h"]
[84.546703, "o", "> \r\n"]
[84.54708, "o", "\u001b[?2004l\r"]
[84.547113, "o", "\u001b[?2004h> pub fn lines() -> u32 {"]
[84.547145, "o", "\r\n"]
[84.547182, "o", "\u001b[?2004l\r"]
[84.54732, "o", "\u001b[?2004h"]
[84.547732, "o", ">     let _ = Desk;\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.548013, "o", "> "]
[84.548132, "o", "    let text = std::fs::read_to_string(\"/app/coverpit/COVER.txt\").unwrap_or_default();"]
[84.548269, "o", "\r\n\u001b[?2004l\r"]
[84.548427, "o", "\u001b[?2004h"]
[84.548506, "o", "> "]
[84.548756, "o", "    if text.contains(\"Desk count 9\") { 9 } else { 0 }"]
[84.548921, "o", "\r\n"]
[84.548949, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.549075, "o", "> "]
[84.54924, "o", "EOF\r\n"]
[84.549725, "o", "\u001b[?2004l\r"]
[84.552516, "o", "\u001b[?2004h"]
[84.552755, "o", "root@01e6ae40db4c:/app# "]
[84.552786, "o", "cat > /app/sessbay/load.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.552874, "o", "use crate::hold;\r\n\u001b[?2004l\r"]
[84.552894, "o", "\u001b[?2004h> "]
[84.553006, "o", "use std::cell::RefCell;\r\n\u001b[?2004l\r"]
[84.553021, "o", "\u001b[?2004h"]
[84.553114, "o", "> "]
[84.553302, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> use std::rc::Rc;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[84.553321, "o", "\u001b[?2004l\r"]
[84.553382, "o", "\u001b[?2004h> "]
[84.55347, "o", "pub struct Plan {"]
[84.553488, "o", "\r\n"]
[84.553715, "o", "\u001b[?2004l\r\u001b[?2004h>     pub old: String,\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.554879, "o", ">     pub new: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub extra: String,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn kiln_pitch(n0: u32, n1: u32, _width: u32, _heat: bool) -> (u32, u32) {\r\n\u001b[?2004l\r\u001b[?2004h>     (n0.saturating_add(1), n1.saturating_add(2))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\r\n\u001b[?2004l\r\u001b[?2004h>     let text = fs::read_to_string(p).ok()?;\r\n\u001b[?2004l\r\u001b[?2004h>     if text.trim().is_empty() { return None; }\r\n\u001b[?2004l\r\u001b[?2004h>     let mut n0 = None;\r\n\u001b[?2004l\r"]
[84.555357, "o", "\u001b[?2004h> "]
[84.555486, "o", "    let mut n1 = None;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.555585, "o", "    let mut cells: Option<Vec<String>> = None;\r\n\u001b[?2004l\r"]
[84.555603, "o", "\u001b[?2004h"]
[84.555617, "o", "> "]
[84.555865, "o", "    let mut mode: Option<bool> = None;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.55589, "o", "    let mut old: Option<String> = None;\r\n"]
[84.555904, "o", "\u001b[?2004l\r"]
[84.556041, "o", "\u001b[?2004h>     let mut new: Option<String> = None;"]
[84.556065, "o", "\r\n\u001b[?2004l\r"]
[84.556251, "o", "\u001b[?2004h> "]
[84.556322, "o", "    let mut extra: Option<String> = None;"]
[84.556354, "o", "\r\n\u001b[?2004l\r"]
[84.556375, "o", "\u001b[?2004h> "]
[84.556568, "o", "    for raw in text.lines() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.556628, "o", "        let line = raw.trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.556887, "o", "        if line.is_empty() || line.starts_with('#') { continue; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.557423, "o", "        let words: Vec<&str> = line.split_whitespace().collect();\r\n\u001b[?2004l\r"]
[84.557518, "o", "\u001b[?2004h> "]
[84.55761, "o", "        match words.as_slice() {\r\n\u001b[?2004l\r"]
[84.557689, "o", "\u001b[?2004h> "]
[84.558128, "o", "            [\"tick\", v] if n0.is_none() => n0 = Some(v.parse().ok()?),\r\n\u001b[?2004l\r"]
[84.558279, "o", "\u001b[?2004h> "]
[84.558598, "o", "            [\"mark\", v] if n1.is_none() => n1 = Some(v.parse().ok()?),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.558848, "o", "            [\"bag\", rest @ ..] if cells.is_none() && !rest.is_empty() => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.559129, "o", "                cells = Some(rest.iter().map(|s| (*s).to_string()).collect())\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[84.559361, "o", "\u001b[?2004h> "]
[84.559442, "o", "            [\"mode\", \"heat\"] if mode.is_none() => mode = Some(true),\r\n\u001b[?2004l\r"]
[84.559662, "o", "\u001b[?2004h> "]
[84.559695, "o", "            [\"mode\", \"peek\"] if mode.is_none() => mode = Some(false),\r\n\u001b[?2004l\r"]
[84.559783, "o", "\u001b[?2004h> "]
[84.560168, "o", "            [\"swap\", a, b] if old.is_none() => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.560246, "o", "                old = Some((*a).to_string()); new = Some((*b).to_string());\r\n\u001b[?2004l\r"]
[84.560335, "o", "\u001b[?2004h>             }"]
[84.560367, "o", "\r\n\u001b[?2004l\r"]
[84.560381, "o", "\u001b[?2004h> "]
[84.560643, "o", "            [\"push\", v] if extra.is_none() => extra = Some((*v).to_string()),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.560749, "o", "            _ => return None,\r\n\u001b[?2004l\r"]
[84.561098, "o", "\u001b[?2004h> "]
[84.56126, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.561362, "o", "    let heat = mode?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.561566, "o", "    if heat && (old.is_none() || new.is_none() || extra.is_none()) { return None; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.561817, "o", "    if !heat && (old.is_some() || new.is_some() || extra.is_some()) { return None; }\r\n\u001b[?2004l\r"]
[84.562002, "o", "\u001b[?2004h>     let cells = cells?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.56216, "o", "    let ids = (0..cells.len()).collect();\r\n\u001b[?2004l\r\u001b[?2004h>     Some((\r\n\u001b[?2004l\r"]
[84.562307, "o", "\u001b[?2004h> "]
[84.56243, "o", "        hold::Sess { n0: n0?, n1: n1?, ids: Rc::new(RefCell::new(ids)), flag: heat },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.562635, "o", "        hold::Pool { cells },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.56275, "o", "        Plan { old: old.unwrap_or_default(), new: new.unwrap_or_default(), extra: extra.unwrap_or_default() },\r\n\u001b[?2004l\r"]
[84.562925, "o", "\u001b[?2004h> "]
[84.562947, "o", "    ))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.563152, "o", "pub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.563331, "o", "    let width = a.ids.borrow().len() as u32;\r\n\u001b[?2004l\r\u001b[?2004h>     if a.flag {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.563585, "o", "        for c in &mut b.cells {\r\n\u001b[?2004l\r\u001b[?2004h>             if *c == p.old { *c = p.new.clone(); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.563616, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.563632, "o", "> "]
[84.563772, "o", "        b.cells.push(p.extra.clone());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.563948, "o", "        a.ids.borrow_mut().push(b.cells.len() - 1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.564161, "o", "    (a.n0, a.n1) = kiln_pitch(a.n0, a.n1, width, a.flag);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[84.566108, "o", "\u001b[?2004h"]
[84.566259, "o", "root@01e6ae40db4c:/app# "]
[84.675932, "i", "cat > /app/emitbay/hearth.rs <<'EOF'\nuse std::fs;\nuse std::path::Path;\n\nconst FOLD: &str = include_str!(\"../foldrib/rim.rs\");\nconst INTERN: &str = include_str!(\"../internpit/pool.rs\");\nconst REST: &str = include_str!(\"../restcue/ink.rs\");\nconst HEARTH: &str = include_str!(\"hearth.rs\");\nconst MAIN: &str = include_str!(\"main.rs\");\nconst BOOT: &str = include_str!(\"../steerpit/boot.rs\");\n\nfn walk_cards(path: &Path) -> Result<(), ()> {\n    let entries = fs::read_dir(path).map_err(|_| ())?;\n    for entry in entries {\n        let entry = entry.map_err(|_| ())?;\n        let ty = entry.file_type().map_err(|_| ())?;\n        if ty.is_dir() {\n            walk_cards(&entry.path())?;\n        } else if ty.is_file() {\n            fs::read(entry.path()).map_err(|_| ())?;\n        }\n    }\n    Ok(())\n}\n\nfn put(path: &str, body: &str) -> Result<(), ()> {\n    fs::write(path, body).map_err(|_| ())\n}\n\npub fn rib_d() -> i32 {\n    if walk_cards(Path::new(\"/app/daycards\")).is_err() { return 1; }\n    let tree = match fs::read_to_string(\"/app/vatslip/TREE.txt\") {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    for raw in tree.lines() {\n        let name = raw.trim();\n        if name.is_empty() || name.starts_with('#') { continue; }\n        let result = match name {\n            \"foldrib\" => put(\"/app/foldrib/rim.rs\", FOLD),\n            \"internpit\" => put(\"/app/internpit/pool.rs\", INTERN),\n            \"restcue\" => put(\"/app/restcue/ink.rs\", REST),\n            \"emitbay\" => put(\"/app/emitbay/hearth.rs\", HEARTH)\n                .and_then(|_| put(\"/app/emitbay/main.rs\", MAIN)),\n            \"steerpit\" => put(\"/app/steerpit/boot.rs\", BOOT),\n            _ => return 1,\n        };\n        if result.is_err() { return 2; }\n    }\n    0\n}\nEOF\nchmod +x /app/bake.sh\n/app/bake.sh\nprintf 'magic='; od -An -tx1 -N4 /app/bin/glazeurn\n/app/bin/glazeurn pair; echo \"pair_rc=$?\"; cat /app/inkpit/pair.json; cat /app/inkpit/GUARD\n"]
[84.676367, "o", "cat > /app/emitbay/hearth.rs <<'EOF'"]
[84.676937, "o", "\r\n\u001b[?2004l\r"]
[84.676988, "o", "\u001b[?2004h"]
[84.67742, "o", "> use std::fs;"]
