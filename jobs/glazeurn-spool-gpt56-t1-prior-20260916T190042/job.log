ut new: Option<String> = None;\n    let mut extra: Option<String> = None;\n    for raw in text.lines() {\n        let line = raw.trim();\n        if line.is_empty() || line.starts_with(\'#\') { continue; }\n        let words: Vec<&str> = line.split_whitespace().collect();\n        match words.as_slice() {\n            ["tick", v] if n0.is_none() => n0 = Some(v.parse().ok()?),\n            ["mark", v] if n1.is_none() => n1 = Some(v.parse().ok()?),\n            ["bag", rest @ ..] if cells.is_none() && !rest.is_empty() => {\n                cells = Some(rest.iter().map(|s| (*s).to_string()).collect())\n            }\n            ["mode", "heat"] if mode.is_none() => mode = Some(true),\n            ["mode", "peek"] if mode.is_none() => mode = Some(false),\n            ["swap", a, b] if old.is_none() => {\n                old = Some((*a).to_string()); new = Some((*b).to_string());\n            }\n            ["push", v] if extra.is_none() => extra = Some((*v).to_string()),\n            _ => return None,\n        }\n    }\n    let heat = mode?;\n    if heat && (old.is_none() || new.is_none() || extra.is_none()) { return None; }\n    if !heat && (old.is_some() || new.is_some() || extra.is_some()) { return None; }\n    let cells = cells?;\n    let ids = (0..cells.len()).collect();\n    Some((\n        hold::Sess { n0: n0?, n1: n1?, ids: Rc::new(RefCell::new(ids)), flag: heat },\n        hold::Pool { cells },\n        Plan { old: old.unwrap_or_default(), new: new.unwrap_or_default(), extra: extra.unwrap_or_default() },\n    ))\n}\n\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\n    let width = a.ids.borrow().len() as u32;\n    if a.flag {\n        for c in &mut b.cells {\n            if *c == p.old { *c = p.new.clone(); }\n        }\n        b.cells.push(p.extra.clone());\n        a.ids.borrow_mut().push(b.cells.len() - 1);\n    }\n    (a.n0, a.n1) = kiln_pitch(a.n0, a.n1, width, a.flag);\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
