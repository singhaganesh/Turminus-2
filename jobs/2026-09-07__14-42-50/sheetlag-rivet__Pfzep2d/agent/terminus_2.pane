--- forgekit/decode.c ---
     1	#include "decode.h"
     2	#include <stdint.h>
     3	#include <stdio.h>
     4	#include <stdlib.h>
     5	#include <string.h>
     6	
     7	static uint32_t rd_be32(const unsigned char *p) {
     8	    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
     9	}
    10	
    11	int decode_frame(const char *path) {
    12	    FILE *f = fopen(path, "rb");
    13	    if (!f) return 2;
    14	    unsigned char raw[4096];
    15	    size_t n = fread(raw, 1, sizeof(raw), f);
    16	    fclose(f);
    17	    if (n < 4) return 2;
    18	    uint32_t ln = rd_be32(raw);
    19	    if (n < 4 + ln) return 2;
    20	    char name[256];
    21	    if (ln >= sizeof(name)) return 2;
    22	    memcpy(name, raw + 4, ln);
    23	    name[ln] = 0;
    24	    char kpath[512];
    25	    snprintf(kpath, sizeof(kpath), "/app/rivetbay/emitters/%s.kdec", name);
    26	    FILE *k = fopen(kpath, "r");
    27	    if (!k) {
    28	        printf("{\"kind\":\"unknown\",\"name\":\"%s\"}\n", name);
    29	        return 0;
    30	    }
    31	    char line[256];
    32	    char fields[32][64];
    33	    char kinds[32][16];
    34	    int nf = 0;
    35	    while (fgets(line, sizeof(line), k)) {
    36	        if (strncmp(line, "KDEC1", 5) == 0) continue;
    37	        if (strncmp(line, "NAME ", 5) == 0) continue;
    38	        if (sscanf(line, "%63s %15s", fields[nf], kinds[nf]) == 2) nf++;
    39	    }
    40	    fclose(k);
    41	    const unsigned char *p = raw + 4 + ln;
    42	    size_t left = n - 4 - ln;
    43	    printf("{\"kind\":\"decoded\",\"name\":\"%s\",\"fields\":{", name);
    44	    for (int i = 0; i < nf; i++) {
    45	        unsigned v = 0;
    46	        if (strcmp(kinds[i], "u16") == 0) {
    47	            if (left < 2) break;
    48	            v = ((unsigned)p[0] << 8) | p[1];
    49	            p += 2; left -= 2;
    50	        } else {
    51	            if (left < 1) break;
    52	            v = p[0];
    53	            p += 1; left -= 1;
    54	        }
    55	        printf("%s\"%s\":%u", i ? "," : "", fields[i], v);
    56	    }
    57	    printf("}}\n");
    58	    return 0;
    59	}

--- forgekit/discover.c ---
     1	#include "discover.h"
     2	#include "parse_evd.h"
     3	#include <dirent.h>
     4	#include <stdio.h>
     5	#include <string.h>
     6	
     7	static int stem_seen(const char *stem, char stems[][128], int n) {
     8	    for (int i = 0; i < n; i++)
     9	        if (strcmp(stems[i], stem) == 0) return 1;
    10	    return 0;
    11	}
    12	
    13	static int load_prior_stems(char stems[][128], int cap) {
    14	    int n = 0;
    15	    FILE *f = fopen("/app/rivetbay/intake/current.ledger", "r");
    16	    char line[1024];
    17	    if (!f) return 0;
    18	    while (n < cap && fgets(line, sizeof(line), f)) {
    19	        char *bar = strchr(line, '|');
    20	        if (!bar) continue;
    21	        *bar = 0;
    22	        char *s = line;
    23	        while (*s == ' ' || *s == '\t') s++;
    24	        if (*s == 0) continue;
    25	        strncpy(stems[n], s, 127);
    26	        stems[n][127] = 0;
    27	        n++;
    28	    }
    29	    fclose(f);
    30	    return n;
    31	}
    32	
    33	static int emit_row(FILE *out, const char *fname) {
    34	    char path[512];
    35	    snprintf(path, sizeof(path), "/app/rivetbay/evd/%s", fname);
    36	    char name[128];
    37	    char fields[512];
    38	    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;
    39	    fprintf(out, "%s|evd/%s|%s\n", name, fname, fields);
    40	    return 1;
    41	}
    42	
    43	void discover_all(void) {
    44	    char prior[64][128];
    45	    char pending[64][256];
    46	    int nprior = load_prior_stems(prior, 64);
    47	    int npend = 0;
    48	    DIR *d = opendir("/app/rivetbay/evd");
    49	    FILE *out = fopen("/app/rivetbay/intake/current.ledger", "w");
    50	    if (!d || !out) {
    51	        if (d) closedir(d);
    52	        if (out) fclose(out);
    53	        return;
    54	    }
    55	    struct dirent *ent;
    56	    while ((ent = readdir(d)) != NULL) {
    57	        size_t L = strlen(ent->d_name);
    58	        if (L < 5 || strcmp(ent->d_name + L - 4, ".evd") != 0) continue;
    59	        char name[128];
    60	        char fields[512];
    61	        char path[512];
    62	        snprintf(path, sizeof(path), "/app/rivetbay/evd/%s", ent->d_name);
    63	        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;
    64	        if (stem_seen(name, prior, nprior)) continue;
    65	        if (npend < 64) {
    66	            strncpy(pending[npend], ent->d_name, 255);
    67	            pending[npend][255] = 0;
    68	            npend++;
    69	        }
    70	    }
    71	    for (int i = 0; i < nprior; i++) {
    72	        char want[256];
    73	        snprintf(want, sizeof(want), "%s.evd", prior[i]);
    74	        emit_row(out, want);
    75	    }
    76	    for (int i = 0; i < npend; i++)
    77	        emit_row(out, pending[i]);
    78	    fclose(out);
    79	    closedir(d);
    80	}

--- forgekit/driver.c ---
     1	#include "discover.h"
     2	#include "sheet.h"
     3	#include "emit.h"
     4	#include "tally.h"
     5	#include "decode.h"
     6	#include "warmup.h"
     7	#include <stdio.h>
     8	#include <string.h>
     9	
    10	static void note_mill_pass(void) {
    11	    FILE *f = fopen("/app/rivetbay/intake/.mill_pass", "a");
    12	    if (!f) return;
    13	    fputc('1', f);
    14	    fputc('\n', f);
    15	    fclose(f);
    16	}
    17	
    18	int main(int argc, char **argv) {
    19	    if (argc >= 2 && strcmp(argv[1], "mill") == 0) {
    20	        note_mill_pass();
    21	        warm_maybe();
    22	        prime_intake_sheet();
    23	        discover_all();
    24	        pour_sheet();
    25	        emit_all();
    26	        return count_gap();
    27	    }
    28	    if (argc >= 3 && strcmp(argv[1], "decode") == 0)
    29	        return decode_frame(argv[2]);
    30	    fprintf(stderr, "usage: rivetbay mill | rivetbay decode <frame>\n");
    31	    return 2;
    32	}

--- forgekit/emit.c ---
     1	#include "emit.h"
     2	#include "sheet.h"
     3	#include <stdio.h>
     4	#include <stdlib.h>
     5	#include <string.h>
     6	
     7	static void emit_one(const char *line) {
     8	    char tmp[1024];
     9	    strncpy(tmp, line, sizeof(tmp) - 1);
    10	    tmp[sizeof(tmp) - 1] = 0;
    11	    char *nl = strchr(tmp, '\n');
    12	    if (nl) *nl = 0;
    13	    char *name = tmp;
    14	    char *p1 = strchr(tmp, '|');
    15	    if (!p1) return;
    16	    *p1 = 0;
    17	    char *p2 = strchr(p1 + 1, '|');
    18	    if (!p2) return;
    19	    char *spec = p2 + 1;
    20	    char outp[512];
    21	    snprintf(outp, sizeof(outp), "/app/rivetbay/emitters/%s.kdec", name);
    22	    FILE *o = fopen(outp, "w");
    23	    if (!o) return;
    24	    fprintf(o, "KDEC1\nNAME %s\n", name);
    25	    char *parts[32];
    26	    int nf = 0;
    27	    char spec_copy[512];
    28	    strncpy(spec_copy, spec, sizeof(spec_copy) - 1);
    29	    spec_copy[sizeof(spec_copy) - 1] = 0;
    30	    char *tok = strtok(spec_copy, ",");
    31	    while (tok && nf < 32) {
    32	        parts[nf++] = tok;
    33	        tok = strtok(NULL, ",");
    34	    }
    35	    for (int i = nf - 1; i >= 0; i--) {
    36	        char fn[64], k[16];
    37	        if (sscanf(parts[i], "%63[^:]:%15s", fn, k) == 2)
    38	            fprintf(o, "%s %s\n", fn, k);
    39	    }
    40	    fclose(o);
    41	}
    42	
    43	void emit_all(void) {
    44	    const char *blob = sheet_view();
    45	    int cap = sheet_emit_cap();
    46	    char buf[65536];
    47	    strncpy(buf, blob, sizeof(buf) - 1);
    48	    buf[sizeof(buf) - 1] = 0;
    49	    char *save = NULL;
    50	    char *line = strtok_r(buf, "\n", &save);
    51	    int idx = 0;
    52	    while (line) {
    53	        if (idx >= cap) break;
    54	        if (line[0]) emit_one(line);
    55	        idx++;
    56	        line = strtok_r(NULL, "\n", &save);
    57	    }
    58	}

--- forgekit/parse_evd.c ---
     1	#include "parse_evd.h"
     2	#include <stdio.h>
     3	#include <string.h>
     4	
     5	int parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {
     6	    FILE *f = fopen(path, "r");
     7	    if (!f) return -1;
     8	    name[0] = 0;
     9	    fields[0] = 0;
    10	    char line[256];
    11	    int first = 1;
    12	    while (fgets(line, sizeof(line), f)) {
    13	        if (strncmp(line, "NAME ", 5) == 0) {
    14	            sscanf(line + 5, "%127s", name);
    15	        } else if (strncmp(line, "FIELD ", 6) == 0) {
    16	            char fn[64], k[16];
    17	            if (sscanf(line + 6, "%63s %15s", fn, k) == 2) {
    18	                if (!first) strncat(fields, ",", fields_sz - (int)strlen(fields) - 1);
    19	                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);
    20	                strncat(fields, ":", fields_sz - (int)strlen(fields) - 1);
    21	                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);
    22	                first = 0;
    23	            }
    24	        }
    25	    }
    26	    fclose(f);
    27	    return name[0] ? 0 : -1;
    28	}

--- forgekit/snapshot.c ---
     1	#include "sheet.h"
     2	#include <stdio.h>
     3	#include <string.h>
     4	
     5	static char g_primed[65536];
     6	static char g_emit[65536];
     7	static int g_emit_cap;
     8	
     9	static int count_nonempty_lines(const char *blob) {
    10	    int n = 0;
    11	    int nonempty = 0;
    12	    for (const char *s = blob; *s; s++) {
    13	        if (*s == '\n') {
    14	            if (nonempty) n++;
    15	            nonempty = 0;
    16	        } else if (*s != ' ' && *s != '\r' && *s != '\t') {
    17	            nonempty = 1;
    18	        }
    19	    }
    20	    if (nonempty) n++;
    21	    return n;
    22	}
    23	
    24	static void load_mill_open_into(char *dst, size_t cap) {
    25	    FILE *f = fopen("/app/rivetbay/intake/mill_open", "r");
    26	    dst[0] = 0;
    27	    if (!f) return;
    28	    size_t n = fread(dst, 1, cap - 1, f);
    29	    dst[n] = 0;
    30	    fclose(f);
    31	}
    32	
    33	void prime_intake_sheet(void) {
    34	    load_mill_open_into(g_primed, sizeof(g_primed));
    35	    g_emit_cap = count_nonempty_lines(g_primed);
    36	    g_emit[0] = 0;
    37	}
    38	
    39	void grab_sheet(void) {
    40	    load_mill_open_into(g_primed, sizeof(g_primed));
    41	}
    42	
    43	void pour_sheet(void) {
    44	    char buf[65536];
    45	    char out[65536];
    46	    strncpy(buf, g_primed, sizeof(buf) - 1);
    47	    buf[sizeof(buf) - 1] = 0;
    48	    size_t w = 0;
    49	    char *save = NULL;
    50	    char *line = strtok_r(buf, "\n", &save);
    51	    while (line) {
    52	        while (*line == ' ' || *line == '\t') line++;
    53	        if (*line == 0) {
    54	            line = strtok_r(NULL, "\n", &save);
    55	            continue;
    56	        }
    57	        size_t L = strlen(line);
    58	        if (w + L + 1 >= sizeof(out)) break;
    59	        memcpy(out + w, line, L);
    60	        w += L;
    61	        out[w++] = '\n';
    62	        line = strtok_r(NULL, "\n", &save);
    63	    }
    64	    out[w] = 0;
    65	    memcpy(g_emit, out, w + 1);
    66	}
    67	
    68	const char *sheet_view(void) {
    69	    return g_emit;
    70	}
    71	
    72	int sheet_emit_cap(void) {
    73	    return g_emit_cap;
    74	}

