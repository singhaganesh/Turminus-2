[63.320752, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('forgekit/snapshot.c')\ns=p.read_text()\ns=s.replace('static void load_mill_open_into(char *dst, size_t cap) {\\n    FILE *f = fopen(\"/app/rivetbay/intake/mill_open\", \"r\");', 'static void load_file_into(const char *path, char *dst, size_t cap) {\\n    FILE *f = fopen(path, \"r\");')\ns=s.replace('load_mill_open_into(g_primed, sizeof(g_primed));', 'load_file_into(\"/app/rivetbay/intake/current.ledger\", g_primed, sizeof(g_primed));')\ns=s.replace('void grab_sheet(void) {\\n    load_file_into(\"/app/rivetbay/intake/current.ledger\", g_primed, sizeof(g_primed));\\n}', 'void grab_sheet(void) {\\n    load_file_into(\"/app/rivetbay/intake/current.ledger\", g_primed, sizeof(g_primed));\\n    g_emit_cap = count_nonempty_lines(g_primed);\\n}')\np.write_text(s)\n\np=Path('forgekit/emit.c')\ns=p.read_text().replace('for (int i = nf - 1; i >= 0; i--) {', 'for (int i = 0; i < nf; i++) {')\np.write_text(s)\n\np=Path('forgekit/driver.c')\ns=p.read_text()\ns=s.replace('#include <stdio.h>\\n#include <string.h>', '#include <dirent.h>\\n#include <stdio.h>\\n#include <string.h>')\ninsert='''\nstatic int descriptions_missing_decoders(void) {\n    DIR *d = opendir(\"/app/rivetbay/evd\");\n    if (!d) return 1;\n    int missing = 0;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len < 5 || strcmp(ent->d_name + len - 4, \".evd\") != 0) continue;\n        char evd[512], name[128], fields[512], dec[512];\n        snprintf(evd, sizeof(evd), \"/app/rivetbay/evd/%s\", ent->d_name);\n        if (parse_evd_file(evd, name, fields, sizeof(fields)) != 0) {\n            missing = 1;\n            continue;\n        }\n        snprintf(dec, sizeof(dec), \"/app/rivetbay/emitters/%s.kdec\", name);\n        FILE *f = fopen(dec, \"r\");\n        if (!f) missing = 1;\n        else fclose(f);\n    }\n    closedir(d);\n    return missing;\n}\n\n'''\ns=s.replace('#include \"warmup.h\"', '#include \"warmup.h\"\\n#include \"parse_evd.h\"')\ns=s.replace('static void note_mill_pass(void) {', insert+'static void note_mill_pass(void) {')\ns=s.replace('          discover_all();\\n          pour_sheet();', '          discover_all();\\n          grab_sheet();\\n          pour_sheet();')\ns=s.replace('          return count_gap();', '          return count_gap() || descriptions_missing_decoders();')\np.write_text(s)\nPY\ncat > forgekit/discover.c <<'EOF'\n#include \"discover.h\"\n#include \"parse_evd.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n\ntypedef struct {\n    char name[128];\n    char relpath[256];\n} prior_row;\n\nstatic int name_seen(const char *name, const prior_row *rows, int n) {\n    for (int i = 0; i < n; i++)\n        if (strcmp(rows[i].name, name) == 0) return 1;\n    return 0;\n}\n\nstatic int load_prior(prior_row *rows, int cap) {\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\n    if (!f) return 0;\n    int n = 0;\n    char line[1024];\n    while (n < cap && fgets(line, sizeof(line), f)) {\n        char *p1 = strchr(line, '|');\n        if (!p1) continue;\n        *p1++ = 0;\n        char *p2 = strchr(p1, '|');\n        if (!p2) continue;\n        *p2 = 0;\n        if (!line[0] || !p1[0]) continue;\n        snprintf(rows[n].name, sizeof(rows[n].name), \"%s\", line);\n        snprintf(rows[n].relpath, sizeof(rows[n].relpath), \"%s\", p1);\n        n++;\n    }\n    fclose(f);\n    return n;\n}\n\nstatic int emit_row(FILE *out, const char *relpath) {\n    char path[512], name[128], fields[512];\n    snprintf(path, sizeof(path), \"/app/rivetbay/%s\", relpath);\n    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\n    fprintf(out, \"%s|%s|%s\\n\", name, relpath, fields);\n    return 1;\n}\n\nvoid discover_all(void) {\n    prior_row prior[256];\n    char pending[256][256];\n    int nprior = load_prior(prior, 256), npend = 0;\n    DIR *d = opendir(\"/app/rivetbay/evd\");\n    if (!d) return;\n\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len < 5 || strcmp(ent->d_name + len - 4, \".evd\") != 0) continue;\n        char path[512], name[128], fields[512];\n "]
[63.320835, "i", "       snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\n        if (name_seen(name, prior, nprior)) continue;\n        int duplicate = 0;\n        for (int i = 0; i < npend; i++) {\n            char other_path[512], other_name[128];\n            snprintf(other_path, sizeof(other_path), \"/app/rivetbay/%s\", pending[i]);\n            if (parse_evd_file(other_path, other_name, fields, sizeof(fields)) == 0 &&\n                strcmp(name, other_name) == 0) duplicate = 1;\n        }\n        if (!duplicate && npend < 256) {\n            snprintf(pending[npend], sizeof(pending[npend]), \"evd/%s\", ent->d_name);\n            npend++;\n        }\n    }\n    closedir(d);\n\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger.tmp\", \"w\");\n    if (!out) return;\n    for (int i = 0; i < nprior; i++) emit_row(out, prior[i].relpath);\n    for (int i = 0; i < npend; i++) emit_row(out, pending[i]);\n    if (fclose(out) != 0 || rename(\"/app/rivetbay/intake/current.ledger.tmp\",\n                                   \"/app/rivetbay/intake/current.ledger\") != 0)\n        remove(\"/app/rivetbay/intake/current.ledger.tmp\");\n}\nEOF\nmake CFLAGS='-O2 -Wall -Wextra -Werror -Iforgekit -I/app/millscore' hull\n"]
