[63.38976, "o", "\u001b[?2004h"]
[63.389827, "o", "> "]
[63.389887, "o", "        if (name_seen(name, prior, nprior)) continue;\r\n\u001b[?2004l\r"]
[63.389945, "o", "\u001b[?2004h> "]
[63.390026, "o", "        int duplicate = 0;\r\n\u001b[?2004l\r"]
[63.390092, "o", "\u001b[?2004h> "]
[63.390201, "o", "        for (int i = 0; i < npend; i++) {\r\n\u001b[?2004l\r"]
[63.390272, "o", "\u001b[?2004h> "]
[63.39038, "o", "            char other_path[512], other_name[128];\r\n\u001b[?2004l\r"]
[63.390454, "o", "\u001b[?2004h> "]
[63.390634, "o", "            snprintf(other_path, sizeof(other_path), \"/app/rivetbay/%s\", pending[i]);\r\n\u001b[?2004l\r"]
[63.390676, "o", "\u001b[?2004h> "]
[63.390884, "o", "            if (parse_evd_file(other_path, other_name, fields, sizeof(fields)) == 0 &&\r\n\u001b[?2004l\r"]
[63.390926, "o", "\u001b[?2004h> "]
[63.391086, "o", "                strcmp(name, other_name) == 0) duplicate = 1;\r\n\u001b[?2004l\r"]
[63.39113, "o", "\u001b[?2004h> "]
[63.391183, "o", "        }\r\n\u001b[?2004l\r"]
[63.391232, "o", "\u001b[?2004h> "]
[63.391335, "o", "        if (!duplicate && npend < 256) {\r\n\u001b[?2004l\r"]
[63.391386, "o", "\u001b[?2004h> "]
[63.391577, "o", "            snprintf(pending[npend], sizeof(pending[npend]), \"evd/%s\", ent->d_name);\r\n\u001b[?2004l\r"]
[63.39163, "o", "\u001b[?2004h> "]
[63.391674, "o", "            npend++;\r\n\u001b[?2004l\r"]
[63.391725, "o", "\u001b[?2004h> "]
