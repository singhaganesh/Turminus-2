[63.387016, "o", "\u001b[?2004h"]
[63.387071, "o", "> "]
[63.387216, "o", "    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n\u001b[?2004l\r"]
[63.387313, "o", "\u001b[?2004h"]
[63.387342, "o", "> "]
[63.387495, "o", "    fprintf(out, \"%s|%s|%s\\n\", name, relpath, fields);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.387606, "o", "    return 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.387638, "o", "\u001b[?2004h> "]
