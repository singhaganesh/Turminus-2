[63.388182, "o", "\u001b[?2004h> "]
[63.388291, "o", "    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n\u001b[?2004l\r"]
[63.388351, "o", "\u001b[?2004h> "]
[63.38844, "o", "    if (!d) return;\r\n\u001b[?2004l\r"]
[63.388507, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.388573, "o", "    struct dirent *ent;\r\n\u001b[?2004l\r"]
[63.388596, "o", "\u001b[?2004h> "]
[63.388731, "o", "    while ((ent = readdir(d)) != NULL) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.388796, "o", "        size_t len = strlen(ent->d_name);\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.388813, "o", "> "]
[63.388998, "o", "        if (len < 5 || strcmp(ent->d_name + len - 4, \".evd\") != 0) continue;\r\n\u001b[?2004l\r"]
[63.389067, "o", "\u001b[?2004h> "]
[63.38918, "o", "        char path[512], name[128], fields[512];\r\n\u001b[?2004l\r"]
[63.38928, "o", "\u001b[?2004h"]
[63.389348, "o", "> "]
[63.389437, "o", "        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n\u001b[?2004l\r"]
[63.389515, "o", "\u001b[?2004h"]
[63.389581, "o", "> "]
