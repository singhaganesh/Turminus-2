[8.117901, "o", "\r\n--- forms.txt ---\r\n"]
[8.118809, "o", "Event descriptions use NAME then FIELD lines. FIELD kinds are u8 and u16.\r\n\r\nLedger lines are name|relpath|field:kind,... with kinds u8 and u16. Ledger field tokens follow the FIELD declaration sequence in the description.\r\n\r\nEach decoder file begins with KDEC1, then NAME <name>, then one field kind line per FIELD declared in the description, in that declaration sequence.\r\n\r\nDecode JSON uses kind decoded or unknown, plus name. When decoded, fields is an integer map keyed by those FIELD names.\r\n\r\nFrame bytes are a 4-byte big-endian name length, the name, then packed big-endian field payloads.\r\n\r\nDecode fields object keys are the FIELD names from that description (for example latch, force, amp, bit, thick, mm, q, n, w).\r\n"]
[8.118962, "o", "\r\n--- source/build files ---\r\n"]
[8.120343, "o", "./forgekit/utf_tidy.c\r\n./forgekit/parse_evd.h\r\n./forgekit/discover.h\r\n./forgekit/driver.c\r\n./forgekit/snapshot.c\r\n"]
[8.12043, "o", "./forgekit/sheet.h\r\n./forgekit/utf_tidy.h\r\n./forgekit/warmup.c\r\n./forgekit/discover.c\r\n./forgekit/emit.c\r\n./forgekit/warmup.h\r\n./forgekit/emit.h\r\n./forgekit/decode.h\r\n./forgekit/parse_evd.c\r\n"]
[8.120508, "o", "./forgekit/decode.c\r\n"]
[8.120627, "o", "./Makefile\r\n"]
[8.121, "o", "\u001b[?2004hroot@7f1a97b85e12:/app/rivetbay# "]
[8.319918, "i", "printf '\\n--- descriptions ---\\n'; for f in evd/*; do echo \"### $f\"; cat \"$f\"; done; printf '\\n--- ledger ---\\n'; cat intake/current.ledger 2>/dev/null || true; printf '\\n--- emitters ---\\n'; for f in emitters/*; do [ -f \"$f\" ] || continue; echo \"### $f\"; cat \"$f\"; done\n"]
[8.320703, "o", "printf '\\n--- descriptions ---\\n'; for f in evd/*; do echo \"### $f\"; cat \"$f\"; done; printf '\\n--- ledger ---\\n'; cat intake/current.ledger 2>/dev/null || true; printf '\\n--- emitters ---\\n'; for f in emitters/*; do [ -f \"$f\" ] || continue; echo \"### $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[8.320831, "o", "\r\n--- descriptions ---\r\n"]
[8.320913, "o", "### evd/aileron_pos.evd\r\n"]
[8.324578, "o", "NAME aileron_pos\r\nFIELD deg u16\r\nFIELD side u8\r\n"]
[8.324818, "o", "### evd/brake_temp.evd\r\n"]
[8.325945, "o", "NAME brake_temp\r\nFIELD cdeg u16\r\n"]
[8.326182, "o", "### evd/door_seal.evd\r\n"]
[8.327391, "o", "NAME door_seal\r\nFIELD ok u8\r\n"]
[8.32759, "o", "### evd/fuel_flow.evd\r\n"]
[8.328529, "o", "NAME fuel_flow\r\nFIELD rate u16\r\nFIELD tank u8\r\n"]
[8.328713, "o", "### evd/galley_hatch.evd\r\n"]
[8.329522, "o", "NAME galley_hatch\r\nFIELD latch u8\r\nFIELD force u16\r\n"]
[8.329703, "o", "### evd/nav_lamp.evd\r\n"]
[8.330545, "o", "NAME nav_lamp\r\nFIELD color u8\r\n"]
[8.330676, "o", "### evd/pitot_heat.evd\r\n"]
[8.33149, "o", "NAME pitot_heat\r\nFIELD watts u16\r\n"]
[8.33162, "o", "### evd/wing_ice.evd\r\n"]
[8.332437, "o", "NAME wing_ice\r\nFIELD thick u16\r\n"]
[8.33256, "o", "\r\n--- ledger ---\r\n"]
[8.333464, "o", "wing_ice|evd/wing_ice.evd|thick:u16\r\nfuel_flow|evd/fuel_flow.evd|rate:u16,tank:u8\r\ndoor_seal|evd/door_seal.evd|ok:u8\r\npitot_heat|evd/pitot_heat.evd|watts:u16\r\naileron_pos|evd/aileron_pos.evd|deg:u16,side:u8\r\nnav_lamp|evd/nav_lamp.evd|color:u8\r\nbrake_temp|evd/brake_temp.evd|cdeg:u16\r\n"]
[8.333601, "o", "\r\n--- emitters ---\r\n"]
[8.333689, "o", "### emitters/aileron_pos.kdec\r\n"]
[8.334501, "o", "KDEC1\r\nNAME aileron_pos\r\ndeg u16\r\nside u8\r\n"]
[8.334711, "o", "### emitters/brake_temp.kdec\r\n"]
[8.335649, "o", "KDEC1\r\nNAME brake_temp\r\ncdeg u16\r\n"]
[8.335866, "o", "### emitters/door_seal.kdec\r\n"]
[8.336791, "o", "KDEC1\r\nNAME door_seal\r\nok u8\r\n"]
[8.33699, "o", "### emitters/fuel_flow.kdec\r\n"]
[8.337711, "o", "KDEC1\r\nNAME fuel_flow\r\nrate u16\r\ntank u8\r\n"]
[8.337917, "o", "### emitters/nav_lamp.kdec\r\n"]
[8.338591, "o", "KDEC1\r\nNAME nav_lamp\r\ncolor u8\r\n"]
[8.338799, "o", "### emitters/pitot_heat.kdec\r\n"]
[8.339537, "o", "KDEC1\r\nNAME pitot_heat\r\nwatts u16\r\n"]
[8.339737, "o", "### emitters/wing_ice.kdec\r\n"]
[8.340546, "o", "KDEC1\r\nNAME wing_ice\r\nthick u16\r\n"]
[8.34076, "o", "\u001b[?2004h"]
[8.34085, "o", "root@7f1a97b85e12:/app/rivetbay# "]
[8.52843, "i", "printf '\\n--- mill run ---\\n'; /app/bin/rivetbay mill; s=$?; echo \"mill_exit=$s\"; printf '\\n--- post-mill counts ---\\n'; find evd -maxdepth 1 -type f | wc -l; find emitters -maxdepth 1 -type f | wc -l; cat intake/current.ledger\n"]
[8.529265, "o", "printf '\\n--- mill run ---\\n'; /app/bin/rivetbay mill; s=$?; echo \"mill_exit=$s\"; printf '\\n--- post-mill counts ---\\n'; find evd -maxdepth 1 -type f | wc -l; find emitters -maxdepth 1 -type f | wc -l; cat intake/current.ledger\r\n\u001b[?2004l\r"]
[8.529403, "o", "\r\n--- mill run ---\r\n"]
[8.534617, "o", "mill_exit=0\r\n\r\n--- post-mill counts ---\r\n"]
[8.536127, "o", "8\r\n"]
[8.537764, "o", "7\r\n"]
[8.538691, "o", "wing_ice|evd/wing_ice.evd|thick:u16\r\nfuel_flow|evd/fuel_flow.evd|rate:u16,tank:u8\r\ndoor_seal|evd/door_seal.evd|ok:u8\r\npitot_heat|evd/pitot_heat.evd|watts:u16\r\naileron_pos|evd/aileron_pos.evd|deg:u16,side:u8\r\nnav_lamp|evd/nav_lamp.evd|color:u8\r\nbrake_temp|evd/brake_temp.evd|cdeg:u16\r\ngalley_hatch|evd/galley_hatch.evd|latch:u8,force:u16\r\n"]
[8.538893, "o", "\u001b[?2004hroot@7f1a97b85e12:/app/rivetbay# "]
[14.61366, "i", "printf '%s\\n' '--- Makefile ---'; nl -ba Makefile; for f in notes/layout.txt notes/ops.txt forgekit/*.h forgekit/*.c; do printf '\\n--- %s ---\\n' \"$f\"; nl -ba \"$f\"; done\n"]
[14.614305, "o", "printf '%s\\n' '--- Makefile ---'; nl -ba Makefile; for f in notes/layout.txt notes/ops.txt forgekit/*.h forgekit/*.c; do printf '\\n--- %s ---\\n' \"$f\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[14.614433, "o", "--- Makefile ---\r\n"]
[14.619005, "o", "     1\tCC ?= gcc\r\n     2\tCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore\r\n     3\tSRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)\r\n     4\tBIN := /app/bin/rivetbay\r\n     5\t\r\n     6\t.PHONY: hull\r\n     7\thull:\r\n     8\t\tmkdir -p /app/bin\r\n     9\t\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[14.619421, "o", "\r\n--- notes/layout.txt ---\r\n"]
[14.620533, "o", "     1\tevd holds descriptions. intake/current.ledger is the mill roster. emitters hold kdec tables.\r\n     2\tframes hold packed samples. forgekit is the C pipeline.\r\n"]
[14.620731, "o", "\r\n--- notes/ops.txt ---\r\n"]
[14.621678, "o", "     1\tAfter adding a description, mill may leave decode unknown even though discovery refreshed the on-disk ledger.\r\n     2\tUnknown decode is normal for frames that have no description on this bench.\r\n"]
[14.621854, "o", "\r\n--- forgekit/decode.h ---\r\n"]
[14.622696, "o", "     1\t#ifndef DECODE_H\r\n     2\t#define DECODE_H\r\n     3\tint decode_frame(const char *path);\r\n     4\t#endif\r\n"]
[14.622853, "o", "\r\n--- forgekit/discover.h ---\r\n"]
[14.62374, "o", "     1\t#ifndef DISCOVER_H\r\n     2\t#define DISCOVER_H\r\n     3\tvoid discover_all(void);\r\n     4\t#endif\r\n"]
[14.62392, "o", "\r\n--- forgekit/emit.h ---\r\n"]
[14.624671, "o", "     1\t#ifndef EMIT_H\r\n     2\t#define EMIT_H\r\n     3\tvoid emit_all(void);\r\n     4\t#endif\r\n"]
[14.624831, "o", "\r\n--- forgekit/parse_evd.h ---\r\n"]
[14.625694, "o", "     1\t#ifndef PARSE_EVD_H\r\n     2\t#define PARSE_EVD_H\r\n     3\tint parse_evd_file(const char *path, char *name, char *fields, int fields_sz);\r\n     4\t#endif\r\n"]
[14.62588, "o", "\r\n--- forgekit/sheet.h ---\r\n"]
[14.626692, "o", "     1\t#ifndef SHEET_H\r\n     2\t#define SHEET_H\r\n     3\tvoid prime_intake_sheet(void);\r\n     4\tvoid grab_sheet(void);\r\n     5\tvoid pour_sheet(void);\r\n     6\tconst char *sheet_view(void);\r\n"]
[14.626783, "o", "     7\tint sheet_emit_cap(void);\r\n     8\t#endif\r\n"]
[14.626904, "o", "\r\n--- forgekit/utf_tidy.h ---\r\n"]
[14.627741, "o", "     1\t#ifndef UTF_TIDY_H\r\n     2\t#define UTF_TIDY_H\r\n     3\tvoid tidy_copy(const char *src, char *dst, int n);\r\n     4\t#endif\r\n"]
[14.627886, "o", "\r\n--- forgekit/warmup.h ---\r\n"]
[14.628672, "o", "     1\t#ifndef WARMUP_H\r\n     2\t#define WARMUP_H\r\n     3\tvoid warm_maybe(void);\r\n     4\t#endif\r\n"]
[14.628829, "o", "\r\n--- forgekit/decode.c ---\r\n"]
[14.629656, "o", "     1\t#include \"decode.h\"\r\n     2\t#include <stdint.h>\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic uint32_t rd_be32(const unsigned char *p) {\r\n     8\t    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];\r\n     9\t}\r\n    10\t\r\n    11\tint decode_frame(const char *path) {\r\n"]
[14.629755, "o", "    12\t    FILE *f = fopen(path, \"rb\");\r\n    13\t    if (!f) return 2;\r\n    14\t    unsigned char raw[4096];\r\n    15\t    size_t n = fread(raw, 1, sizeof(raw), f);\r\n    16\t    fclose(f);\r\n    17\t    if (n < 4) return 2;\r\n    18\t    uint32_t ln = rd_be32(raw);\r\n    19\t    if (n < 4 + ln) return 2;\r\n    20\t    char name[256];\r\n    21\t    if (ln >= sizeof(name)) return 2;\r\n    22\t    memcpy(name, raw + 4, ln);\r\n    23\t    name[ln] = 0;\r\n    24\t    char kpath[512];\r\n    25\t    snprintf(kpath, sizeof(kpath), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    26\t    FILE *k = fopen(kpath, \"r\");\r\n    27\t    if (!k) {\r\n    28\t        printf(\"{\\\"kind\\\":\\\"unknown\\\",\\\"name\\\":\\\"%s\\\"}\\n\", name);\r\n    29\t        return 0;\r\n    30\t    }\r\n    31\t    char line[256];\r\n    32\t    char fields[32][64];\r\n    33\t    char kinds[32][16];\r\n    34\t    int nf = 0;\r\n    35\t    while (fgets(line, sizeof(line), k)) {\r\n    36\t        if (strncmp(line, \"KDEC1\", 5) == 0) continue;\r\n    37\t        if (strncmp(line, \"NAME \", 5) == 0) continue;\r\n    38\t        if (sscanf(line, \"%63s %15s\", fields[nf], kinds[nf]) == 2) nf++;\r\n    39\t    }\r\n    40\t    fclose(k);\r\n    41\t    const unsigned char *p = raw + 4 + ln;\r\n    42\t    size_t left = n - 4 - ln;"]
[14.62978, "o", "\r\n    43\t    printf(\"{\\\"kind\\\":\\\"decoded\\\",\\\"name\\\":\\\"%s\\\",\\\"fields\\\":{\", name);\r\n    44\t    for (int i = 0; i < nf; i++) {\r\n    45\t        unsigned v = 0;\r\n"]
[14.629796, "o", "    46\t        if (strcmp(kinds[i], \"u16\") == 0) {\r\n    47\t            if (left < 2) break;\r\n    48\t            v = ((unsigned)p[0] << 8) | p[1];\r\n    49\t"]
[14.62982, "o", "            p += 2; left -= 2;\r\n    50\t        } else {\r\n    51\t            if (left < 1) break;\r\n    52\t            v = p[0];\r\n"]
[14.629835, "o", "    53\t            p += 1; left -= 1;\r\n    54\t        }\r\n    55\t        printf(\"%s\\\"%s\\\":%u\", i ? \",\" : \"\", fields[i], v);\r\n    56\t    }\r\n    57"]
[14.629851, "o", "\t    printf(\"}}\\n\");\r\n    58\t    return 0;\r\n    59\t}\r\n"]
[14.630102, "o", "\r\n--- forgekit/discover.c ---\r\n"]
[14.630891, "o", "     1\t#include \"discover.h\"\r\n     2\t#include \"parse_evd.h\"\r\n     3\t#include <dirent.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n"]
[14.630979, "o", "     7\tstatic int stem_seen(const char *stem, char stems[][128], int n) {\r\n     8\t    for (int i = 0; i < n; i++)\r\n     9\t        if (strcmp(stems[i], stem) == 0) return 1;\r\n    10\t    return 0;\r\n    11\t}\r\n    12\t\r\n    13\tstatic int load_prior_stems(char stems[][128], int cap) {\r\n    14\t    int n = 0;\r\n    15\t    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    16\t    char line[1024];\r\n    17\t    if (!f) return 0;\r\n    18\t    while (n < cap && fgets(line, sizeof(line), f)) {\r\n    19\t        char *bar = strchr(line, '|');\r\n    20\t        if (!bar) continue;\r\n    21\t        *bar = 0;\r\n    22\t        char *s = line;\r\n    23\t        while (*s == ' ' || *s == '\\t') s++;\r\n    24\t        if (*s == 0) continue;\r\n    25\t        strncpy(stems[n], s, 127);\r\n    26\t        stems[n][127] = 0;\r\n    27\t        n++;\r\n    28\t    }\r\n    29\t    fclose(f);\r\n    30\t    return n;\r\n    31\t}\r\n    32\t\r\n    33\tstatic int emit_row(FILE *out, const char *fname) {\r\n"]
[14.631092, "o", "    34\t    char path[512];\r\n    35\t    snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", fname);\r\n    36\t    char name[128];\r\n    37\t    char fields[512];\r\n    38\t    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n    39\t    fprintf(out, \"%s|evd/%s|%s\\n\", name, fname, fields);\r\n    40\t    return 1;\r\n    41\t}\r\n    42\t\r\n    43\tvoid discover_all(void) {\r\n    44\t    char prior[64][128];\r\n    45\t    char pending[64][256];\r\n    46\t    int nprior = load_prior_stems(prior, 64);\r\n    47\t    int npend = 0;\r\n    48\t    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    49\t    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    50\t    if (!d || !out) {\r\n    51\t        if (d) closedir(d);\r\n    52\t        if (out) fclose(out);\r\n    53\t        return;\r\n    54\t    }\r\n    55\t    struct dirent *ent;\r\n    56\t    while ((ent = readdir(d)) != NULL) {\r\n    57\t        size_t L = strlen(ent->d_name);\r\n    58\t        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n    59\t        char name[128];\r\n    60\t        char fields[512];\r\n    61\t        char path[512];\r\n"]
[14.631187, "o", "    62\t        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n    63\t        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n    64\t        if (stem_seen(name, prior, nprior)) continue;\r\n    65\t        if (npend < 64) {\r\n    66\t            strncpy(pending[npend], ent->d_name, 255);\r\n    67\t            pending[npend][255] = 0;\r\n    68\t            npend++;\r\n    69\t        }\r\n    70\t    }\r\n    71\t    for (int i = 0; i < nprior; i++) {\r\n    72\t        char want[256];\r\n    73\t        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n    74\t        emit_row(out, want);\r\n    75\t    }\r\n    76\t    for (int i = 0; i < npend; i++)\r\n    77\t        emit_row(out, pending[i]);\r\n    78\t    fclose(out);\r\n    79\t    closedir(d);\r\n    80\t}\r\n"]
[14.631348, "o", "\r\n--- forgekit/driver.c ---\r\n"]
[14.632154, "o", "     1\t#include \"discover.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include \"emit.h\"\r\n     4\t#include \"tally.h\"\r\n     5\t#include \"decode.h\"\r\n     6\t#include \"warmup.h\"\r\n     7\t#include <stdio.h>\r\n     8\t#include <string.h>\r\n     9\t\r\n    10\tstatic void note_mill_pass(void) {\r\n    11\t    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    12\t    if (!f) return;\r\n    13\t    fputc('1', f);\r\n    14"]
[14.632257, "o", "\t    fputc('\\n', f);\r\n    15\t    fclose(f);\r\n    16\t}\r\n    17\t\r\n    18\tint main(int argc, char **argv) {\r\n    19\t    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n    20\t        note_mill_pass();\r\n    21\t        warm_maybe();\r\n    22\t        prime_intake_sheet();\r\n"]
[14.632333, "o", "    23\t        discover_all();\r\n    24\t        pour_sheet();\r\n    25\t        emit_all();\r\n    26\t        return count_gap();\r\n    27\t    }\r\n    28\t    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n    29\t        return decode_frame(argv[2]);\r\n    30\t    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    31\t    return 2;\r\n    32\t}\r\n"]
[14.632414, "o", "\r\n--- forgekit/emit.c ---\r\n"]
[14.633231, "o", "     1\t#include \"emit.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic void emit_one(const char *line) {\r\n"]
[14.633334, "o", "     8\t    char tmp[1024];\r\n     9\t    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    10\t    tmp[sizeof(tmp) - 1] = 0;\r\n    11\t    char *nl = strchr(tmp, '\\n');\r\n    12\t    if (nl) *nl = 0;\r\n    13\t    char *name = tmp;\r\n    14\t    char *p1 = strchr(tmp, '|');\r\n    15\t    if (!p1) return;\r\n    16\t    *p1 = 0;\r\n    17\t    char *p2 = strchr(p1 + 1, '|');\r\n    18\t    if (!p2) return;\r\n    19\t    char *spec = p2 + 1;\r\n    20\t    char outp[512];\r\n    21\t    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    22\t    FILE *o = fopen(outp, \"w\");\r\n    23\t    if (!o) return;\r\n    24\t    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    25\t    char *parts[32];\r\n    26\t    int nf = 0;\r\n    27\t    char spec_copy[512];\r\n    28\t    strncpy(spec_copy, spec, sizeof(spec_copy) - 1);\r\n    29\t    spec_copy[sizeof(spec_copy) - 1] = 0;\r\n    30\t    char *tok = strtok(spec_copy, \",\");\r\n    31\t    while (tok && nf < 32) {\r\n    32\t        parts[nf++] = tok;\r\n    33\t        tok = strtok(NULL, \",\");\r\n    34\t    }\r\n    35\t    for (int i = nf - 1; i >= 0; i--) {\r\n    36\t        char fn[64], k[16];\r\n    37\t        if (sscanf(parts[i], \"%63[^:]:%15s\", fn, k) == 2)\r\n"]
[14.633415, "o", "    38\t            fprintf(o, \"%s %s\\n\", fn, k);\r\n    39\t    }\r\n    40\t    fclose(o);\r\n    41\t}\r\n    42\t\r\n    43\tvoid emit_all(void) {\r\n    44\t    const char *blob = sheet_view();\r\n    45\t    int cap = sheet_emit_cap();\r\n    46\t    char buf[65536];\r\n    47\t    strncpy(buf, blob, sizeof(buf) - 1);\r\n    48\t    buf[sizeof(buf) - 1] = 0;\r\n    49\t    char *save = NULL;\r\n    50\t    char *line = strtok_r(buf, \"\\n\", &save);\r\n    51\t    int idx = 0;\r\n    52\t    while (line) {\r\n    53\t        if (idx >= cap) break;\r\n    54\t        if (line[0]) emit_one(line);\r\n    55\t        idx++;\r\n    56\t        line = strtok_r(NULL, \"\\n\", &save);\r\n    57\t    }\r\n    58\t}\r\n"]
[14.633582, "o", "\r\n--- forgekit/parse_evd.c ---\r\n"]
[14.634392, "o", "     1\t#include \"parse_evd.h\"\r\n     2\t#include <stdio.h>\r\n     3\t#include <string.h>\r\n     4\t\r\n     5\tint parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {\r\n     6\t    FILE *f = fopen(path, \"r\");\r\n     7\t    if (!f) return -1;\r\n     8\t    name[0] = 0;\r\n"]
[14.634487, "o", "     9\t    fields[0] = 0;\r\n    10\t    char line[256];\r\n    11\t    int first = 1;\r\n    12\t    while (fgets(line, sizeof(line), f)) {\r\n    13\t        if (strncmp(line, \"NAME \", 5) == 0) {\r\n    14\t            sscanf(line + 5, \"%127s\", name);\r\n    15\t        } else if (strncmp(line, \"FIELD \", 6) == 0) {\r\n    16\t            char fn[64], k[16];\r\n    17\t            if (sscanf(line + 6, \"%63s %15s\", fn, k) == 2) {\r\n    18\t                if (!first) strncat(fields, \",\", fields_sz - (int)strlen(fields) - 1);\r\n    19\t                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);\r\n    20\t                strncat(fields, \":\", fields_sz - (int)strlen(fields) - 1);\r\n    21\t                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);\r\n    22\t                first = 0;\r\n    23\t            }\r\n    24\t        }\r\n    25\t    }\r\n    26\t    fclose(f);\r\n    27\t    return name[0] ? 0 : -1;\r\n    28\t}\r\n"]
[14.634666, "o", "\r\n--- forgekit/snapshot.c ---\r\n"]
[14.635406, "o", "     1\t#include \"sheet.h\"\r\n     2\t#include <stdio.h>\r\n     3\t#include <string.h>\r\n     4\t\r\n     5\tstatic char g_primed[65536];\r\n     6\tstatic char g_emit[65536];\r\n     7\tstatic int g_emit_cap;\r\n"]
[14.635511, "o", "     8\t\r\n     9\tstatic int count_nonempty_lines(const char *blob) {\r\n    10\t    int n = 0;\r\n    11\t    int nonempty = 0;\r\n    12\t    for (const char *s = blob; *s; s++) {\r\n    13\t        if (*s == '\\n') {\r\n    14\t            if (nonempty) n++;\r\n    15\t            nonempty = 0;\r\n    16\t        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n    17\t            nonempty = 1;\r\n    18\t        }\r\n    19\t    }\r\n    20\t    if (nonempty) n++;\r\n    21\t    return n;\r\n    22\t}\r\n    23\t\r\n    24\tstatic void load_mill_open_into(char *dst, size_t cap) {\r\n    25\t    FILE *f = fopen(\"/app/rivetbay/intake/mill_open\", \"r\");\r\n    26\t    dst[0] = 0;\r\n    27\t    if (!f) return;\r\n    28\t    size_t n = fread(dst, 1, cap - 1, f);\r\n    29\t    dst[n] = 0;\r\n    30\t    fclose(f);\r\n    31\t}\r\n    32\t\r\n    33\tvoid prime_intake_sheet(void) {\r\n    34\t    load_mill_open_into(g_primed, sizeof(g_primed));\r\n    35\t    g_emit_cap = count_nonempty_lines(g_primed);\r\n    36\t    g_emit[0] = 0;\r\n"]
[14.635628, "o", "    37\t}\r\n    38\t\r\n    39\tvoid grab_sheet(void) {\r\n    40\t    load_mill_open_into(g_primed, sizeof(g_primed));\r\n    41\t}\r\n    42\t\r\n    43\tvoid pour_sheet(void) {\r\n    44\t    char buf[65536];\r\n    45\t    char out[65536];\r\n    46\t    strncpy(buf, g_primed, sizeof(buf) - 1);\r\n    47\t    buf[sizeof(buf) - 1] = 0;\r\n    48\t    size_t w = 0;\r\n    49\t    char *save = NULL;\r\n"]
[14.635732, "o", "    50\t    char *line = strtok_r(buf, \"\\n\", &save);\r\n    51\t    while (line) {\r\n    52\t        while (*line == ' ' || *line == '\\t') line++;\r\n    53\t        if (*line == 0) {\r\n    54\t            line = strtok_r(NULL, \"\\n\", &save);\r\n    55\t            continue;\r\n    56\t        }\r\n    57\t        size_t L = strlen(line);\r\n    58\t        if (w + L + 1 >= sizeof(out)) break;\r\n    59\t        memcpy(out + w, line, L);\r\n    60\t        w += L;\r\n    61\t        out[w++] = '\\n';\r\n    62\t        line = strtok_r(NULL, \"\\n\", &save);\r\n    63\t    }\r\n    64\t    out[w] = 0;\r\n    65\t    memcpy(g_emit, out, w + 1);\r\n    66\t}\r\n    67\t\r\n    68\tconst char *sheet_view(void) {\r\n    69\t    return g_emit;\r\n    70\t}\r\n    71\t\r\n    72\tint sheet_emit_cap(void) {\r\n    73\t    return g_emit_cap;\r\n    74\t}\r\n"]
[14.635933, "o", "\r\n--- forgekit/utf_tidy.c ---\r\n"]
[14.636951, "o", "     1\t#include \"utf_tidy.h\"\r\n     2\t#include <string.h>\r\n     3\tvoid tidy_copy(const char *src, char *dst, int n) {\r\n     4\t    if (n <= 0) return;\r\n     5\t    strncpy(dst, src, (size_t)n - 1);\r\n     6\t    dst[n - 1] = 0;\r\n     7\t}\r\n"]
[14.639188, "o", "\r\n--- forgekit/warmup.c ---\r\n     1\t#include \"warmup.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include <stdlib.h>\r\n     4\t\r\n     5\tvoid warm_maybe(void) {\r\n     6\t    const char *e = getenv(\"RIVET_WARM\");\r\n     7\t    if (e && e[0] == '1') {\r\n     8\t        grab_sheet();\r\n     9\t    }\r\n    10\t}\r\n\u001b[?2004hroot@7f1a97b85e12:/app/rivetbay# "]
[21.319979, "i", "for f in forgekit/driver.c forgekit/discover.c forgekit/emit.c; do echo \"--- $f ---\"; nl -ba \"$f\"; done; echo '--- millscore ---'; find /app/millscore -maxdepth 2 -type f -print -exec sh -c 'echo \"### $1\"; nl -ba \"$1\"' _ {} \\;; echo '--- mill_open ---'; nl -ba intake/mill_open\n"]
