NAME galley_hatch
FIELD latch u8
FIELD force u16
--- evd/nav_lamp.evd
NAME nav_lamp
FIELD color u8
--- evd/pitot_heat.evd
NAME pitot_heat
FIELD watts u16
--- evd/wing_ice.evd
NAME wing_ice
FIELD thick u16
===== ledger/state =====
     1	wing_ice|evd/wing_ice.evd|thick:u16
     2	fuel_flow|evd/fuel_flow.evd|rate:u16,tank:u8
     3	door_seal|evd/door_seal.evd|ok:u8
     4	pitot_heat|evd/pitot_heat.evd|watts:u16
     5	aileron_pos|evd/aileron_pos.evd|deg:u16,side:u8
     6	nav_lamp|evd/nav_lamp.evd|color:u8
     7	brake_temp|evd/brake_temp.evd|cdeg:u16
--- mill_open
