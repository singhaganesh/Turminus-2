[19.015752, "o", "echo '===== reproduce mill ====='; /app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo \"evd=$(find evd -maxdepth 1 -type f -name '*.evd' | wc -l) emitters=$(find emitters -maxdepth 1 -type f -name '*.kdec' | wc -l)\"; nl -ba intake/current.ledger; ls -l emitters\r\n\u001b[?2004l\r===== reproduce mill =====\r\n"]
