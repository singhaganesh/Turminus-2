[64.21545, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('forgekit/snapshot.c')\ns=p.read_text()\ns=s.replace('static void load_mill_open_into(char *dst, size_t cap) {\\n    FILE *f = fopen(\"/app/rivetbay/intake/mill_open\", \"r\");', 'static void load_current_ledger_into(char *dst, size_t cap) {\\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");')\ns=s.replace('load_mill_open_into(g_primed, sizeof(g_primed));', 'load_current_ledger_into(g_primed, sizeof(g_primed));')\ns=s.replace('void grab_sheet(void) {\\n    load_current_ledger_into(g_primed, sizeof(g_primed));\\n}', 'void grab_sheet(void) {\\n    load_current_ledger_into(g_primed, sizeof(g_primed));\\n    g_emit_cap = count_nonempty_lines(g_primed);\\n}')\np.write_text(s)\n\np=Path('forgekit/emit.c')\ns=p.read_text().replace('for (int i = nf - 1; i >= 0; i--) {', 'for (int i = 0; i < nf; i++) {')\np.write_text(s)\n\np=Path('forgekit/driver.c')\ns=p.read_text()\ns=s.replace('#include <stdio.h>\\n#include <string.h>', '#include <dirent.h>\\n#include <stdio.h>\\n#include <string.h>')\ninsert='''\nstatic int count_suffix(const char *path, const char *suffix) {\n    DIR *d = opendir(path);\n    struct dirent *ent;\n    int count = 0;\n    size_t slen = strlen(suffix);\n    if (!d) return -1;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len >= slen && strcmp(ent->d_name + len - slen, suffix) == 0)\n            count++;\n    }\n    closedir(d);\n    return count;\n}\n\n'''\ns=s.replace('static void note_mill_pass(void) {', insert+'static void note_mill_pass(void) {')\ns=s.replace('''        warm_maybe();\n        prime_intake_sheet();\n        discover_all();\n        pour_sheet();\n        emit_all();\n        return count_gap();''', '''        warm_maybe();\n        discover_all();\n        prime_intake_sheet();\n        pour_sheet();\n        emit_all();\n        int descriptions = count_suffix(\"/app/rivetbay/evd\", \".evd\");\n        int emitters = count_suffix(\"/app/rivetbay/emitters\", \".kdec\");\n        if (descriptions < 0 || emitters < descriptions) return 1;\n        return count_gap();''')\np.write_text(s)\nPY\n\ngrep -RInE 'load_|for \\(int i =|discover_all|descriptions|emitters' forgekit/snapshot.c forgekit/emit.c forgekit/driver.c\nmake hull\n"]
