ontinue;\r\n/app/rivetbay/forgekit/discover.c:73:        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n/app/rivetbay/forgekit/emit.c:21:    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n/app/rivetbay/forgekit/parse_evd.c:1:#include \"parse_evd.h\"\r\n/app/rivetbay/forgekit/parse_evd.c:5:int parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {\r\n/app/rivetbay/forgekit/decode.c:25:    snprintf(kpath, sizeof(kpath), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n/app/rivetbay/Makefile:2:CFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore\r\n/app/rivetbay/Makefile:3:SRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)\r\n"]
