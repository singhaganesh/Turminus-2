[36.403217, "o", "    14\t            sscanf(line + 5, \"%127s\", name);\r\n    15\t        } else if (strncmp(line, \"FIELD \", 6) == 0) {\r\n    16\t            char fn[64], k[16];\r\n    17\t            if (sscanf(line + 6, \"%63s %15s\", fn, k) == 2) {\r\n    18\t                if (!first) strncat(fields, \",\", fields_sz - (int)strlen(fields) - 1);\r\n    19\t                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);\r\n    20\t                strncat(fields, \":\", fields_sz - (int)strlen(fields) - 1);\r\n    21\t                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);\r\n    22\t                first = 0;\r\n    23\t            }\r\n    24\t        }\r\n    25\t    }\r\n    26\t    fclose(f);\r\n    27\t    return name[0] ? 0 : -1;\r\n    28\t}\r\n"]
