[36.398461, "o", "     1\t#include \"emit.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic void emit_one(const char *line) {\r\n     8\t    char tmp[1024];\r\n     9\t    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    10\t    tmp[sizeof(tmp) - 1] = 0;\r\n    11\t    char *nl = strchr(tmp, '\\n');\r\n"]
[36.398511, "o", "    12\t    if (nl) *nl = 0;\r\n    13\t    char *name = tmp;\r\n    14\t    char *p1 = strchr(tmp, '|');\r\n    15\t    if (!p1) return;\r\n    16\t    *p1 = 0;\r\n    17\t    char *p2 = strchr(p1 + 1, '|');\r\n    18\t    if (!p2) return;\r\n    19\t    char *spec = p2 + 1;\r\n    20\t    char outp[512];\r\n    21\t    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    22\t    FILE *o = fopen(outp, \"w\");\r\n    23\t    if (!o) return;\r\n    24\t    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    25\t    char *parts[32];\r\n    26\t    int nf = 0;\r\n    27\t    char spec_copy[512];\r\n    28\t    strncpy(spec_copy, spec, sizeof(spec_copy) - 1);\r\n    29\t    spec_copy[sizeof(spec_copy) - 1] = 0;\r\n    30\t    char *tok = strtok(spec_copy, \",\");\r\n"]
[36.398531, "o", "    31\t    while (tok && nf < 32) {\r\n    32\t        parts[nf++] = tok;\r\n    33\t        tok = strtok(NULL, \",\");\r\n    34\t    }\r\n    35\t    for (int i = nf - 1; i >= 0; i--) {\r\n"]
[36.398548, "o", "    36\t        char fn[64], k[16];\r\n    37\t        if (sscanf(parts[i], \"%63[^:]:%15s\", fn, k) == 2)\r\n    38\t            fprintf(o, \"%s %s\\n\", fn, k);\r\n    39\t    }\r\n    40\t    fclose(o);\r\n"]
[36.398561, "o", "    41\t}\r\n    42\t\r\n    43\tvoid emit_all(void) {\r\n    44\t    const char *blob = sheet_view();\r\n"]
[36.398576, "o", "    45\t    int cap = sheet_emit_cap();\r\n    46\t    char buf[65536];\r\n    47\t    strncpy(buf, blob, sizeof(buf) - 1);\r\n    48\t    buf[sizeof(buf) - 1] = 0;\r\n"]
[36.398608, "o", "    49\t    char *save = NULL;\r\n    50\t    char *line = strtok_r(buf, \"\\n\", &save);\r\n    51\t    int idx = 0;\r\n    52\t    while (line) {\r\n    53\t        if (idx >= cap) break;\r\n    54\t        if (line[0]) emit_one(line);\r\n    55\t        idx++;\r\n    56\t        line = strtok_r(NULL, \"\\n\", &save);\r\n    57\t    }\r\n"]
