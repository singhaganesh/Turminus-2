[124.102198, "o", "\u001b[?2004hroot@90d9e8cccb92:/app# "]
[124.263238, "i", "cat > /app/logbag/write.rs <<'RS'\nuse super::blend::Pack;\n\nfn json_escape(s: &str) -> String {\n    let mut out = String::new();\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out\n}\n\npub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\n    if let Some(parent) = std::path::Path::new(out).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    let ev: Vec<String> = p.e.iter().map(|x| format!(\"\\\"{}\\\"\", json_escape(x))).collect();\n    let body = format!(\"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\n        json_escape(&p.t), json_escape(&p.c), ev.join(\",\"), p.n, json_escape(&p.s), json_escape(&p.w));\n    let tmp = format!(\"{}.tmp.{}\", out, std::process::id());\n    if std::fs::write(&tmp, body).is_err() || std::fs::rename(&tmp, out).is_err() {\n        let _ = std::fs::remove_file(&tmp); return 1;\n    }\n    if std::fs::write(\"/app/deskjson/READY\", \"brief-ok\\n\").is_err() { return 1; }\n    0\n}\nRS\ncat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"] mod blend;\n#[path = \"../logbag/write.rs\"] mod uni;\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    match blend::rib_b(a, b) { Ok(p) => uni::rib_c(&p, out, a), Err(c) => c }\n}\nRS\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/siltcord\n"]
