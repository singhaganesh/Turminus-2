[38.061586, "i", "python3 - <<'PY'\nimport tarfile, hashlib\np='/app/sealwell/kestrel.kith'\nwith tarfile.open(p, 'r:') as t:\n    regs=[m for m in t.getmembers() if m.isfile()]\n    for m in t.getmembers():\n        print(repr(m.name), m.type, m.size, m.offset, m.offset_data)\n        if m.isfile(): print(repr(t.extractfile(m).read()))\n    names=[m.name for m in regs]\n    print('regular names:', names)\n    print('expected sig:', hashlib.sha256('\\n'.join(names).encode()).hexdigest())\nPY\n"]
[38.061836, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[38.061947, "o", "\u001b[?2004h> "]
[38.062066, "o", "import tarfile, hashlib\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.062261, "o", "> "]
[38.062372, "o", "p='/app/sealwell/kestrel.kith'\r\n\u001b[?2004l\r\u001b[?2004h> with tarfile.open(p, 'r:') as t:\r\n\u001b[?2004l\r"]
[38.06244, "o", "\u001b[?2004h> "]
[38.062567, "o", "    regs=[m for m in t.getmembers() if m.isfile()]\r\n\u001b[?2004l\r"]
[38.062637, "o", "\u001b[?2004h"]
[38.062663, "o", "> "]
[38.062782, "o", "    for m in t.getmembers():\r\n\u001b[?2004l\r"]
[38.062807, "o", "\u001b[?2004h> "]
[38.06393, "o", "        print(repr(m.name), m.type, m.size, m.offset, m.offset_data)\r\n\u001b[?2004l\r\u001b[?2004h>         if m.isfile(): print(repr(t.extractfile(m).read()))\r\n\u001b[?2004l\r\u001b[?2004h>     names=[m.name for m in regs]\r\n\u001b[?2004l\r\u001b[?2004h>     print('regular names:', names)\r\n\u001b[?2004l\r\u001b[?2004h>     print('expected sig:', hashlib.sha256('\\n'.join(names).encode()).hexdigest())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[38.100025, "o", "'etc/sys.conf' b'0' 33 0 512\r\n"]
