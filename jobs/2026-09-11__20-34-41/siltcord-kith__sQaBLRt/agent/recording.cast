[45.079126, "i", "echo '=== blend ==='; sed -n '1,240p' /app/overlaypit/blend.rs; echo '=== boot ==='; cat /app/siltcli/boot.rs\n"]
[45.079579, "o", "echo '=== blend ==='; sed -n '1,240p' /app/overlaypit/blend.rs; echo '=== boot ==='; cat /app/siltcli/boot.rs\r\n\u001b[?2004l\r"]
[45.079665, "o", "=== blend ===\r\n"]
[45.081189, "o", "pub struct Pack {\r\n    pub t: String,\r\n    pub c: String,\r\n    pub e: Vec<String>,\r\n    pub n: u32,\r\n    pub s: String,\r\n    pub w: String,\r\n}\r\n\r\nstruct Rec {\r\n    name: String,\r\n    hdr: u64,\r\n    size: u64,\r\n    body: u64,\r\n}\r\n\r\n"]
[45.081337, "o", "fn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" {\r\n        return Err(1);\r\n    }\r\n    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n    let mut i = 9usize;\r\n    let mut out = Vec::new();\r\n    for _ in 0..n {\r\n        if i + 26 > raw.len() {\r\n            return Err(1);\r\n        }\r\n        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;\r\n        i += 2;\r\n        if i + nl > raw.len() {\r\n            return Err(1);\r\n        }\r\n        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();\r\n        i += nl;\r\n        out.push(Rec {\r\n            name,\r\n            hdr,\r\n            size,\r\n            body,\r\n        });\r\n    }\r\n    Ok(out)\r\n}\r\n\r\nfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\r\n    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    let s = body as usize;\r\n    let e = s + size as usize;\r\n    if e > raw.len() {\r\n        return Err(1);\r\n    }\r\n    Ok(raw[s..e].to_vec())\r\n}\r\n\r\nfn digest(text: &str) -> String {\r\n    let mut cmd = std::process::Command::new(\"python3\");\r\n    cmd.args([\r\n        \"-c\",\r\n        \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\",\r\n    ])\r\n    .stdin(std::process::Stdio::piped())\r\n    .stdout(std::process::Stdio::piped());\r\n    let mut child = match cmd.spawn() {\r\n        Ok(c) => c,\r\n        Err(_) => return String::new(),\r\n    };\r\n    {\r\n        use std::io::Write;\r\n        if let Some(ref mut sin) = child.stdin {\r\n            let _ = sin.write_all(text.as_bytes());\r\n        }\r\n"]
[45.081566, "o", "    }\r\n    drop(child.stdin.take());\r\n    match child.wait_with_output() {\r\n        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),\r\n        Err(_) => String::new(),\r\n    }\r\n}\r\n\r\n#[path = \"../keeppit/first.rs\"]\r\nmod first;\r\n#[path = \"../cfgbag/kv.rs\"]\r\nmod kv;\r\n#[path = \"../cfgbag/alias.rs\"]\r\nmod alias;\r\n\r\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    let recs = read_idx(b)?;\r\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    for (i, r) in recs.iter().enumerate() {\r\n        bag.insert(i, r.name.clone());\r\n        let blob = load(a, r.body, r.size)?;\r\n        if r.name.contains(\"sys.conf\") {\r\n            confs.push((r.name.clone(), r.hdr, blob));\r\n        } else if r.name.contains(\"app.log\") {\r\n            logs.push(blob);\r\n        }\r\n    }\r\n    confs.sort_by_key(|row| row.1);\r\n    let picked = first::keep_head(&confs);\r\n    let mut t = String::new();\r\n    let mut c = String::new();\r\n    if let Some(blob) = picked {\r\n        let map = kv::pairs(&blob);\r\n        if let Some(v) = map.get(\"timezone\") {\r\n            t = v.clone();\r\n        }\r\n        if let Some(v) = map.get(\"cluster\") {\r\n            c = v.clone();\r\n        }\r\n    }\r\n    let mut e = Vec::new();\r\n    if let Some(blob) = logs.first() {\r\n        for line in String::from_utf8_lossy(blob).lines() {\r\n            let s = line.trim();\r\n            if !s.is_empty() {\r\n                e.push(s.to_string());\r\n            }\r\n        }\r\n    }\r\n    e.sort();\r\n    e.dedup();\r\n    let names: Vec<String> = bag.values().cloned().collect();\r\n    let walk = names.join(\"\\n\");\r\n    let _ = alias::fold(\"\");\r\n    Ok(Pack {\r\n        t,\r\n        c,\r\n        e,\r\n        n: confs.len() as u32,\r\n        s: a.to_string(),\r\n        w: digest(&walk).to_ascii_uppercase(),\r\n    })\r\n}\r\n"]
[45.08181, "o", "=== boot ===\r\n"]
[45.082796, "o", "#[path = \"quarry.rs\"]\r\nmod quarry;\r\n#[path = \"slate.rs\"]\r\nmod slate;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"quarry\" => {\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            quarry::go(&a, &b)\r\n        }\r\n        \"brief\" => {\r\n            let out = match args.next() {\r\n                Some(x) => x,\r\n                None => {\r\n                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n                    std::process::exit(2);\r\n                }\r\n            };\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            slate::go(&out, &a, &b)\r\n        }\r\n        _ => {\r\n            eprintln!(\"usage: siltcord quarry|brief\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[45.083115, "o", "\u001b[?2004hroot@90d9e8cccb92:/app# "]
[123.857807, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// A parsed ustar member. Offsets refer to the original archive.\n#[derive(Debug)]\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let field = buf.split(|b| *b == 0).next().unwrap_or(buf);\n    let field = field.strip_prefix(b\" \").unwrap_or(field);\n    let field = field.strip_suffix(b\" \").unwrap_or(field);\n    if field.is_empty() || !field.iter().all(|b| matches!(b, b'0'..=b'7')) {\n        return Err(1);\n    }\n    let mut n = 0u64;\n    for &b in field {\n        n = n.checked_mul(8).and_then(|v| v.checked_add(u64::from(b - b'0'))).ok_or(1)?;\n    }\n    Ok(n)\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 {\n        return Err(1);\n    }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off + 512];\n        if blk.iter().all(|b| *b == 0) {\n            if off + 1024 > raw.len() || !raw[off + 512..off + 1024].iter().all(|b| *b == 0) {\n                return Err(1);\n            }\n            if !raw[off..].iter().all(|b| *b == 0) {\n                return Err(1);\n            }\n            ended = true;\n            break;\n        }\n        if &blk[257..262] != b\"ustar\" {\n            return Err(1);\n        }\n        let stored_sum = oct_u64(&blk[148..156])?;\n        let actual_sum: u64 = blk.iter().enumerate().map(|(i, b)| {\n            if (148..156).contains(&i) { 32 } else { u64::from(*b) }\n        }).sum();\n        if stored_sum != actual_sum {\n            return Err(1);\n        }\n        let nlen = blk[0..100].iter().position(|b| *b == 0).unwrap_or(100);\n        if nlen == 0 {\n            return Err(1);\n        }\n        let name = std::str::from_utf8(&blk[0..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = (off as u64).checked_add(512).and_then(|v| v.checked_add(padded)).ok_or(1)?;\n        if next > raw.len() as u64 {\n            return Err(1);\n        }\n        rows.push(Row { name, hdr: off as u64, size, body: (off + 512) as u64, flag: blk[156] });\n        off = next as usize;\n    }\n    if rows.is_empty() || !ended {\n        return Err(1);\n    }\n    Ok(rows)\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let size = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(size).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        let nb = r.name.as_bytes();\n        let nl = match u16::try_from(nb.len()) { Ok(v) => v, Err(_) => return 1 };\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        out.extend_from_slice(&nl.to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    let tmp = format!(\"{}.tmp.{}\", b, std::process::id());\n    if std::fs::write(&tmp, out).is_err() || std::fs::rename(&tmp, b).is_err() {\n        let _ = std::fs::remove_file(&tmp);\n        return 1;\n    }\n    0\n}\nRS\ncat > /app/siltcli/quarry.rs <<'RS'\n#[path = \"../ustarwalk/hdr.rs\"]\nmod hdr;\n#[path = \"../idxmill/shard.rs\"]\nmod shard;\n\npub fn go(a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    shard::rib_a(a, b)\n}\nRS\n"]
