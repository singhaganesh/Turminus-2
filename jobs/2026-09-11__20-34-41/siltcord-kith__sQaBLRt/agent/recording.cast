[175.386312, "i", "set -e\nrm -f /app/deskjson/READY /app/deskjson/pass-a.json /app/deskjson/pass-b.json\n/app/bin/siltcord quarry\n(/app/bin/siltcord brief /app/deskjson/pass-a.json; echo $? > /tmp/brief-a.rc) &\npa=$!\n(/app/bin/siltcord brief /app/deskjson/pass-b.json; echo $? > /tmp/brief-b.rc) &\npb=$!\nwait \"$pa\"; wait \"$pb\"\necho \"parallel_rc a=$(cat /tmp/brief-a.rc) b=$(cat /tmp/brief-b.rc)\"\npython3 - <<'PY'\nimport json\nexpected={'timezone':'Etc/UTC','cluster':'staging','log_events':['EVT_BOOT'],'member_count':2,'source_kith':'kestrel.kith','walk_sig':'5b240ea8c8f9b5f32f5e93e77376daeb5bf6e6930d836d9dc0b0f893e23c0419'}\na=json.load(open('/app/deskjson/pass-a.json'))\nb=json.load(open('/app/deskjson/pass-b.json'))\nprint('a:',a)\nprint('b:',b)\nassert a == b == expected\nassert open('/app/deskjson/READY').read() == 'brief-ok\\n'\nassert open('/app/bin/siltcord','rb').read(4) == b'\\x7fELF'\nprint('positive assertions: ok')\nPY\n"]
