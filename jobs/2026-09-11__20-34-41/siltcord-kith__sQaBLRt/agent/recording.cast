[123.879628, "o", "\u001b[?2004hroot@90d9e8cccb92:/app# cat > /app/siltcli/quarry.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../ustarwalk/hdr.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod hdr;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../idxmill/shard.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod shard;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn go(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r\u001b[?2004h>     shard::rib_a(a, b)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[123.882558, "o", "\u001b[?2004hroot@90d9e8cccb92:/app# "]
[124.079494, "i", "cat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, hdr: u64, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        let end = i.checked_add(nl).ok_or(1)?;\n        if end > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..end]).map_err(|_| 1)?.to_string(); i = end;\n        out.push(Rec { name, hdr, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let result = child.wait_with_output().map_err(|_| 1)?;\n    if !result.status.success() { return Err(1); }\n    let s = std::str::from_utf8(&result.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || matches!(b, b'a'..=b'f')) { return Err(1); }\n    Ok(s)\n}\n\nfn confined_archive(path: &str) -> Result<std::path::PathBuf, i32> {\n    let base = std::fs::canonicalize(\"/app/sealwell\").map_err(|_| 1)?;\n    let archive = std::fs::canonicalize(path).map_err(|_| 1)?;\n    if !archive.starts_with(&base) || !archive.is_file() { return Err(1); }\n    Ok(archive)\n}\n\n#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\n#[path = \"../keeppit/first.rs\"] mod first;\n#[path = \"../cfgbag/kv.rs\"] mod kv;\n#[path = \"../cfgbag/alias.rs\"] mod alias;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let archive = confined_archive(a)?;\n    let archive_s = archive.to_str().ok_or(1)?;\n    let recs = read_idx(b)?;\n    let rows = hdr::scan(archive_s)?;\n    let regular: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    if recs.len() != regular.len() { return Err(1); }\n    for (r, h) in recs.iter().zip(regular.iter()) {\n        if r.name != h.name || r.hdr != h.hdr || r.size != h.size || r.body != h.body { return Err(1); }\n    }\n\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut events = Vec::new();\n    let mut names = Vec::new();\n    for (r, h) in recs.iter().zip(regular.iter()) {\n        let blob = hdr::load_body(archive_s, h)?;\n        let name = alias::fold(&r.name);\n        names.push(r.name.clone());\n        if name == \"sys.conf\" || name.ends_with(\"/sys.conf\") {\n            confs.push((r.name.clone(), r.hdr, blob));\n        } else if name == \"app.log\" || name.ends_with(\"/app.log\") {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let event = line.trim();\n                if !event.is_empty() { events.push(event.to_string()); }\n            }\n        }\n    }\n    confs.sort_by_key(|r| r.1);\n    let mut timezone = String::new();\n    let mut cluster = String::new();\n    if let Some(blob) = first::keep_head(&confs) {\n        let map = kv::pairs(blob);\n        timezone = map.get(\"timezone\").cloned().unwrap_or_default();\n        cluster = map.get(\"cluster\").cloned().unwrap_or_default();\n    }\n    events."]
[124.079682, "i", "sort();\n    events.dedup();\n    let source = archive.file_name().and_then(|v| v.to_str()).ok_or(1)?.to_string();\n    Ok(Pack { t: timezone, c: cluster, e: events, n: recs.len() as u32,\n        s: source, w: digest(&names.join(\"\\n\"))? })\n}\nRS\n"]
