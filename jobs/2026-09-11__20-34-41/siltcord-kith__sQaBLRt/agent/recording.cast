[37.581208, "o", "for f in /app/cfgbag/kv.rs /app/cfgbag/alias.rs /app/logbag/write.rs /app/offseturn/rank.rs /app/paxcue/long.rs /app/pidhash/seed.rs /app/keeppit/first.rs /app/wick.sh; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
