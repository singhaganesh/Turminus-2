[123.87212, "o", "cat > /app/idxmill/shard.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> use super::hdr;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.872178, "o", "\u001b[?2004h> "]
[123.872347, "o", "pub fn rib_a(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.872553, "o", "    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\r\n\u001b[?2004l\r"]
[123.872604, "o", "\u001b[?2004h> "]
[123.872856, "o", "    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\r\n\u001b[?2004l\r"]
[123.872906, "o", "\u001b[?2004h> "]
[123.873061, "o", "    let mut out = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.873175, "o", "    out.extend_from_slice(b\"SILT1\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.873396, "o", "    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\r\n\u001b[?2004l\r"]
[123.873465, "o", "\u001b[?2004h> "]
[123.873515, "o", "    for r in regs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.873702, "o", "        let nb = r.name.as_bytes();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.873967, "o", "        let nl = match u16::try_from(nb.len()) { Ok(v) => v, Err(_) => return 1 };\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.874091, "o", "> "]
[123.874216, "o", "        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.874345, "o", "        out.extend_from_slice(&r.size.to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.874463, "o", "> "]
[123.874586, "o", "        out.extend_from_slice(&r.body.to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.874713, "o", "        out.extend_from_slice(&nl.to_le_bytes());\r\n\u001b[?2004l\r"]
[123.874814, "o", "\u001b[?2004h> "]
[123.874927, "o", "        out.extend_from_slice(nb);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.875053, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.875179, "o", "    let tmp = format!(\"{}.tmp.{}\", b, std::process::id());\r\n\u001b[?2004l\r"]
[123.875296, "o", "\u001b[?2004h> "]
[123.87554, "o", "    if std::fs::write(&tmp, out).is_err() || std::fs::rename(&tmp, b).is_err() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.875643, "o", "        let _ = std::fs::remove_file(&tmp);\r\n\u001b[?2004l\r"]
[123.875736, "o", "\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r"]
[123.875783, "o", "\u001b[?2004h>     }\r\n"]
