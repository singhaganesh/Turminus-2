[37.582255, "o", "     1\tuse std::collections::BTreeMap;\r\n     2\t\r\n     3\tpub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {\r\n     4\t    let mut m = BTreeMap::new();\r\n     5\t    for line in String::from_utf8_lossy(blob).lines() {\r\n     6\t        if let Some((k, v)) = line.split_once('=') {\r\n     7\t            m.insert(k.trim().to_string(), v.trim().to_string());\r\n     8\t        }\r\n     9\t    }\r\n    10\t    m\r\n"]
[37.582392, "o", "    11\t}\r\n"]
[37.582598, "o", "===== /app/cfgbag/alias.rs =====\r\n"]
[37.583678, "o", "     1\tpub fn fold(name: &str) -> String {\r\n     2\t    name.trim_start_matches(\"./\").to_string()\r\n     3\t}\r\n"]
[37.583886, "o", "===== /app/logbag/write.rs =====\r\n"]
[37.584735, "o", "     1\tuse super::blend::Pack;\r\n     2\t\r\n     3\tfn json_escape(s: &str) -> String {\r\n     4\t    s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")\r\n     5\t}\r\n     6\t\r\n"]
[37.584866, "o", "     7\tpub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\r\n     8\t    if let Some(parent) = std::path::Path::new(out).parent() {\r\n     9\t        let _ = std::fs::create_dir_all(parent);\r\n    10\t    }\r\n    11\t    let ev: Vec<String> = p\r\n    12\t        .e\r\n    13\t        .iter()\r\n    14\t        .map(|x| format!(\"\\\"{}\\\"\", json_escape(x)))\r\n    15\t        .collect();\r\n    16\t    let body = format!(\r\n    17\t        \"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\r\n    18\t        json_escape(&p.t),\r\n    19\t        json_escape(&p.c),\r\n    20\t        ev.join(\",\"),\r\n    21\t        p.n,\r\n    22\t        json_escape(&p.s),\r\n    23\t        json_escape(&p.w)\r\n    24\t    );\r\n    25\t    if std::fs::write(out, body).is_err() {\r\n    26\t        return 1;\r\n    27\t    }\r\n    28\t    if std::fs::write(\"/app/deskjson/READY\", \"ok\\n\").is_err() {\r\n    29\t        return 1;\r\n"]
[37.584941, "o", "    30\t    }\r\n    31\t    0\r\n    32\t}\r\n"]
