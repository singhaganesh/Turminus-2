[37.587007, "o", "     1\tpub fn peek(name: &str) -> bool {\r\n     2\t    name.contains(\"PaxHeaders\")\r\n     3\t}\r\n"]
[37.587195, "o", "===== /app/pidhash/seed.rs =====\r\n"]
[37.588017, "o", "     1\tpub fn mix(name: &str) -> u64 {\r\n     2\t    let mut h: u64 = 0xcbf29ce484222325;\r\n     3\t    for b in name.bytes() {\r\n     4\t        h ^= u64::from(b);\r\n     5\t        h = h.wrapping_mul(0x100000001b3);\r\n     6\t    }\r\n     7\t    h\r\n     8\t}\r\n"]
[37.588228, "o", "===== /app/keeppit/first.rs =====\r\n"]
