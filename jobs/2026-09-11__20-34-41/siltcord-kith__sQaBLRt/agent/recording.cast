[124.096604, "o", "    let mut timezone = String::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.096739, "o", "    let mut cluster = String::new();\r\n\u001b[?2004l\r"]
[124.096814, "o", "\u001b[?2004h> "]
[124.097054, "o", "    if let Some(blob) = first::keep_head(&confs) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.097342, "o", ">         let map = kv::pairs(blob);\r\n\u001b[?2004l\r"]
[124.097596, "o", "\u001b[?2004h> "]
[124.097899, "o", "        timezone = map.get(\"timezone\").cloned().unwrap_or_default();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.098352, "o", "        cluster = map.get(\"cluster\").cloned().unwrap_or_default();\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     events.sort();\r\n\u001b[?2004l\r"]
[124.098567, "o", "\u001b[?2004h>     events.dedup();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.098917, "o", "    let source = archive.file_name().and_then(|v| v.to_str()).ok_or(1)?.to_string();\r\n\u001b[?2004l\r"]
[124.099085, "o", "\u001b[?2004h> "]
[124.099296, "o", "    Ok(Pack { t: timezone, c: cluster, e: events, n: recs.len() as u32,\r\n\u001b[?2004l\r"]
[124.09941, "o", "\u001b[?2004h> "]
[124.099649, "o", "        s: source, w: digest(&names.join(\"\\n\"))? })\r\n\u001b[?2004l\r\u001b[?2004h"]
