[43.106727, "i", "echo '===== clue notes ====='; for f in /app/treenotes/FLICKER.txt /app/yarnwell/*.txt; do echo \"--- $(basename \"$f\") ---\"; cat \"$f\"; done\n"]
[43.107358, "o", "echo '===== clue notes ====='; for f in /app/treenotes/FLICKER.txt /app/yarnwell/*.txt; do echo \"--- $(basename \"$f\") ---\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[43.107514, "o", "===== clue notes =====\r\n"]
[43.112762, "o", "--- FLICKER.txt ---\r\n"]
[43.113622, "o", "If configuration strings flicker across desk runs, keep_head in keeppit retains the first sys.conf payload the mill sees. That path is enough for a stable smoke against cluster.\r\n"]
