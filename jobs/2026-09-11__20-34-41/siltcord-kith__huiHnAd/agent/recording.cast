[71.356374, "o", "\u001b[?2004h> "]
[71.356422, "o", "    for r in &rows {\r\n\u001b[?2004l\r"]
[71.356472, "o", "\u001b[?2004h> "]
[71.356609, "o", "        if r.flag != b'0' && r.flag != 0 { continue; }\r\n\u001b[?2004l\r"]
