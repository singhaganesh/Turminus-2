[23.017326, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport hashlib\np=Path('/app/sealwell/kestrel.kith')\nb=p.read_bytes(); print('archive bytes',len(b))\npos=0; names=[]\nwhile pos+512 <= len(b):\n h=b[pos:pos+512]\n if h == bytes(512):\n  print('zero block at',pos); break\n name=h[:100].split(b'\\0',1)[0].decode('utf-8','replace')\n magic=h[257:263]\n typ=h[156:157]\n raw=h[124:136]\n try: size=int(raw.rstrip(b'\\0 ').lstrip(b' ' ) or b'0',8)\n except Exception as e: print('bad size',raw,e); break\n payload=b[pos+512:pos+512+size]\n print(pos,repr(name),'type',typ,'size',size,'magic',magic,'payload',repr(payload))\n if typ==b'0': names.append(name)\n pos += 512 + ((size+511)//512)*512\nprint('names',names)\nprint('walk_sig',hashlib.sha256('\\n'.join(names).encode()).hexdigest())\nPY\n"]
