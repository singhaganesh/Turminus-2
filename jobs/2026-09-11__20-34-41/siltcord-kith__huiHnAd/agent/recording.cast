[31.745515, "i", "for f in /app/ustarwalk/hdr.rs /app/ustarwalk/block.rs /app/overlaypit/blend.rs; do echo \"===== $f =====\"; cat \"$f\"; done\n"]
[31.745907, "o", "for f in /app/ustarwalk/hdr.rs /app/ustarwalk/block.rs /app/overlaypit/blend.rs; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[31.745989, "o", "===== /app/ustarwalk/hdr.rs =====\r\n"]
[31.747154, "o", "/// ustar headers are 512 bytes; payload is padded to that size.\r\npub struct Row {\r\n    pub name: String,\r\n    pub hdr: u64,\r\n    pub size: u64,\r\n    pub body: u64,\r\n    pub flag: u8,\r\n}\r\n\r\nfn oct_u64(buf: &[u8]) -> u64 {\r\n    let mut n: u64 = 0;\r\n    for &b in buf {\r\n        if b == 0 || b == b' ' {\r\n            continue;\r\n        }\r\n        if b >= b'0' && b <= b'7' {\r\n            n = n * 8 + u64::from(b - b'0');\r\n        }\r\n    }\r\n    n\r\n}\r\n\r\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n    let raw = match std::fs::read(path) {\r\n        Ok(x) => x,\r\n        Err(_) => return Err(1),\r\n    };\r\n    if raw.len() < 512 {\r\n        return Err(1);\r\n    }\r\n    let mut rows = Vec::new();\r\n    let mut off = 0usize;\r\n    let mut saw = false;\r\n    while off + 512 <= raw.len() {\r\n        let blk = &raw[off..off + 512];\r\n        if blk.iter().all(|b| *b == 0) {\r\n            break;\r\n        }\r\n        let magic = &blk[257..262];\r\n        if magic != b\"ustar\" {\r\n            return Err(1);\r\n        }\r\n        saw = true;\r\n        let nlen = blk[0..100]\r\n            .iter()\r\n            .position(|b| *b == 0)\r\n            .unwrap_or(100);\r\n        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();\r\n        let size = oct_u64(&blk[124..136]);\r\n        let flag = blk[156];\r\n        let body = (off + 512) as u64;\r\n        rows.push(Row {\r\n            name,\r\n            hdr: off as u64,\r\n            size,\r\n            body,\r\n            flag,\r\n        });\r\n        let padded = ((size + 511) / 512) * 512;\r\n        off = off + 512 + padded as usize;\r\n    }\r\n    if !saw {\r\n        return Err(1);\r\n    }\r\n    Ok(rows)\r\n}\r\n\r\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    let s = row.body as usize;\r\n    let e = s + row.size as usize;\r\n    if e > raw.len() {\r\n        return Err(1);\r\n    }\r\n    Ok(raw[s..e].to_vec())\r\n}\r\n"]
[31.747707, "o", "===== /app/ustarwalk/block.rs =====\r\n"]
[31.748777, "o", "pub fn span(n: u64) -> u64 {\r\n    ((n + 511) / 512) * 512\r\n}\r\n"]
[31.749044, "o", "===== /app/overlaypit/blend.rs =====\r\n"]
[31.750307, "o", "pub struct Pack {\r\n    pub t: String,\r\n    pub c: String,\r\n    pub e: Vec<String>,\r\n    pub n: u32,\r\n    pub s: String,\r\n    pub w: String,\r\n}\r\n\r\nstruct Rec {\r\n    name: String,\r\n    hdr: u64,\r\n    size: u64,\r\n    body: u64,\r\n}\r\n\r\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" {\r\n        return Err(1);\r\n    }\r\n    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n    let mut i = 9usize;\r\n    let mut out = Vec::new();\r\n    for _ in 0..n {\r\n        if i + 26 > raw.len() {\r\n            return Err(1);\r\n        }\r\n        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n        i += 8;\r\n        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;\r\n        i += 2;\r\n        if i + nl > raw.len() {\r\n            return Err(1);\r\n        }\r\n        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();\r\n        i += nl;\r\n        out.push(Rec {\r\n            name,\r\n            hdr,\r\n            size,\r\n            body,\r\n        });\r\n"]
[31.750856, "o", "    }\r\n    Ok(out)\r\n}\r\n\r\nfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\r\n    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    let s = body as usize;\r\n    let e = s + size as usize;\r\n    if e > raw.len() {\r\n        return Err(1);\r\n    }\r\n    Ok(raw[s..e].to_vec())\r\n}\r\n\r\nfn digest(text: &str) -> String {\r\n    let mut cmd = std::process::Command::new(\"python3\");\r\n    cmd.args([\r\n        \"-c\",\r\n        \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\",\r\n    ])\r\n    .stdin(std::process::Stdio::piped())\r\n    .stdout(std::process::Stdio::piped());\r\n    let mut child = match cmd.spawn() {\r\n        Ok(c) => c,\r\n        Err(_) => return String::new(),\r\n    };\r\n    {\r\n        use std::io::Write;\r\n        if let Some(ref mut sin) = child.stdin {\r\n            let _ = sin.write_all(text.as_bytes());\r\n        }\r\n    }\r\n    drop(child.stdin.take());\r\n    match child.wait_with_output() {\r\n        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),\r\n        Err(_) => String::new(),\r\n    }\r\n}\r\n\r\n#[path = \"../keeppit/first.rs\"]\r\nmod first;\r\n#[path = \"../cfgbag/kv.rs\"]\r\nmod kv;\r\n#[path = \"../cfgbag/alias.rs\"]\r\nmod alias;\r\n\r\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    let recs = read_idx(b)?;\r\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    for (i, r) in recs.iter().enumerate() {\r\n        bag.insert(i, r.name.clone());\r\n        let blob = load(a, r.body, r.size)?;\r\n        if r.name.contains(\"sys.conf\") {\r\n            confs.push((r.name.clone(), r.hdr, blob));\r\n        } else if r.name.contains(\"app.log\") {\r\n            logs.push(blob);\r\n        }\r\n    }\r\n    confs.sort_by_key(|row| row.1);\r\n    let picked = first::keep_head(&confs);\r\n    let mut t = String::new();\r\n    let mut c = String::new();\r\n    if let Some(blob) = picked {\r\n        let map = kv::pairs(&blob);\r\n        if let Some(v) = map.get(\"timezone\") {\r\n            t = v.clone();\r\n        }\r\n        if let Some(v) = map.get(\"cluster\") {\r\n            c = v.clone();\r\n        }\r\n    }\r\n    let mut e = Vec::new();\r\n    if let Some(blob) = logs.first() {\r\n        for line in String::from_utf8_lossy(blob).lines() {\r\n            let s = line.trim();\r\n            if !s.is_empty() {\r\n                e.push(s.to_string());\r\n            }\r\n        }\r\n    }\r\n    e.sort();\r\n    e.dedup();\r\n    let names: Vec<String> = bag.values().cloned().collect();\r\n    let walk = names.join(\"\\n\");\r\n    let _ = alias::fold(\"\");\r\n    Ok(Pack {\r\n        t,\r\n        c,\r\n        e,\r\n        n: confs.len() as u32,\r\n        s: a.to_string(),\r\n        w: digest(&walk).to_ascii_uppercase(),\r\n    })\r\n}\r\n"]
