[71.578966, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/overlaypit/blend.rs')\ns=p.read_text()\ns=s.replace('''    Ok(out)\n}\n\nfn load''','''    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn load''')\nstart=s.index('pub fn rib_b(')\ns=s[:start]+r'''pub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    if recs.len() != 2 { return Err(1); }\n    let mut conf: Option<Vec<u8>> = None;\n    let mut log: Option<Vec<u8>> = None;\n    let mut names = Vec::new();\n    for r in &recs {\n        let name = alias::fold(&r.name);\n        let blob = load(a, r.body, r.size)?;\n        match name.as_str() {\n            \"etc/sys.conf\" if conf.is_none() => conf = Some(blob),\n            \"var/log/app.log\" if log.is_none() => log = Some(blob),\n            _ => return Err(1),\n        }\n        names.push(name);\n    }\n    let map = kv::pairs(conf.as_ref().ok_or(1)?);\n    let t = map.get(\"timezone\").cloned().ok_or(1)?;\n    let c = map.get(\"cluster\").cloned().ok_or(1)?;\n    let mut e: Vec<String> = String::from_utf8_lossy(log.as_ref().ok_or(1)?)\n        .lines().map(str::trim).filter(|x| !x.is_empty()).map(str::to_string).collect();\n    e.sort();\n    e.dedup();\n    let source = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack { t, c, e, n: recs.len() as u32, s: source, w: digest(&names.join(\"\\n\")) })\n}\n'''\np.write_text(s)\nPY\n\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/siltcli/slate.rs')\np.write_text(r'''#[path = \"../overlaypit/blend.rs\"]\nmod blend;\n#[path = \"../logbag/write.rs\"]\nmod uni;\n#[path = \"../ustarwalk/hdr.rs\"]\nmod hdr;\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let allowed = match std::fs::canonicalize(\"/app/sealwell\") { Ok(x) => x, Err(_) => return 1 };\n    let archive = match std::fs::canonicalize(a) { Ok(x) => x, Err(_) => return 1 };\n    if archive.parent() != Some(allowed.as_path()) { return 1; }\n    if hdr::scan(a).is_err() { return 1; }\n    match blend::rib_b(a, b) { Ok(p) => uni::rib_c(&p, out, a), Err(c) => c }\n}\n''')\np=Path('/app/logbag/write.rs')\ns=p.read_text().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")','std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\np.write_text(s)\np=Path('/app/siltcli/boot.rs')\ns=p.read_text().replace('fn main() {\\n', 'fn main() {\\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\\n')\np.write_text(s)\nPY\n/app/wick.sh\nhead -c4 /app/bin/siltcord | od -An -tx1\n"]
