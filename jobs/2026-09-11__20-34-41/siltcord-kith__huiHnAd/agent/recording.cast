[32.082013, "i", "for f in /app/siltcli/boot.rs /app/siltcli/quarry.rs /app/siltcli/slate.rs /app/logbag/write.rs; do echo \"===== $f =====\"; cat \"$f\"; done\n"]
[32.082535, "o", "for f in /app/siltcli/boot.rs /app/siltcli/quarry.rs /app/siltcli/slate.rs /app/logbag/write.rs; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[32.082644, "o", "===== /app/siltcli/boot.rs =====\r\n"]
[32.083738, "o", "#[path = \"quarry.rs\"]\r\nmod quarry;\r\n#[path = \"slate.rs\"]\r\nmod slate;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"quarry\" => {\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            quarry::go(&a, &b)\r\n        }\r\n        \"brief\" => {\r\n            let out = match args.next() {\r\n                Some(x) => x,\r\n                None => {\r\n                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n                    std::process::exit(2);\r\n                }\r\n            };\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            slate::go(&out, &a, &b)\r\n        }\r\n        _ => {\r\n            eprintln!(\"usage: siltcord quarry|brief\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[32.083988, "o", "===== /app/siltcli/quarry.rs =====\r\n"]
[32.084914, "o", "#[path = \"../ustarwalk/hdr.rs\"]\r\nmod hdr;\r\n#[path = \"../idxmill/shard.rs\"]\r\nmod shard;\r\n\r\npub fn go(a: &str, b: &str) -> i32 {\r\n    shard::rib_a(a, b)\r\n}\r\n"]
[32.085091, "o", "===== /app/siltcli/slate.rs =====\r\n"]
[32.085884, "o", "#[path = \"../overlaypit/blend.rs\"]\r\nmod blend;\r\n#[path = \"../logbag/write.rs\"]\r\nmod uni;\r\n\r\npub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n    match blend::rib_b(a, b) {\r\n        Ok(p) => uni::rib_c(&p, out, a),\r\n        Err(c) => c,\r\n    }\r\n}\r\n"]
[32.086053, "o", "===== /app/logbag/write.rs =====\r\n"]
[32.086863, "o", "use super::blend::Pack;\r\n\r\nfn json_escape(s: &str) -> String {\r\n    s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")\r\n}\r\n\r\npub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\r\n    if let Some(parent) = std::path::Path::new(out).parent() {\r\n        let _ = std::fs::create_dir_all(parent);\r\n    }\r\n    let ev: Vec<String> = p\r\n        .e\r\n        .iter()\r\n        .map(|x| format!(\"\\\"{}\\\"\", json_escape(x)))\r\n        .collect();\r\n    let body = format!(\r\n        \"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\r\n        json_escape(&p.t),\r\n        json_escape(&p.c),\r\n        ev.join(\",\"),\r\n        p.n,\r\n        json_escape(&p.s),\r\n        json_escape(&p.w)\r\n    );\r\n    if std::fs::write(out, body).is_err() {\r\n        return 1;\r\n    }\r\n    if std::fs::write(\"/app/deskjson/READY\", \"ok\\n\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
