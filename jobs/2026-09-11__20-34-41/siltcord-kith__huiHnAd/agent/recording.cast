[42.921671, "o", "    94\tpub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    95\t    let recs = read_idx(b)?;\r\n    96\t    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    97\t    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    98\t    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    99\t    for (i, r) in recs.iter().enumerate() {\r\n   100\t        bag.insert(i, r.name.clone());\r\n   101\t        let blob = load(a, r.body, r.size)?;\r\n   102\t"]
[42.92171, "o", "        if r.name.contains(\"sys.conf\") {\r\n   103\t            confs.push((r.name.clone(), r.hdr, blob));\r\n   104\t        } else if r.name.contains(\"app.log\") {\r\n   105\t            logs.push(blob);\r\n   106\t        }\r\n   107\t    }\r\n   108\t    confs.sort_by_key(|row| row.1);\r\n   109\t    let picked = first::keep_head(&confs);\r\n   110\t    let mut t = String::new();\r\n   111\t    let mut c = String::new();\r\n   112\t    if let Some(blob) = picked {\r\n   113\t        let map = kv::pairs(&blob);\r\n   114\t        if let Some(v) = map.get(\"timezone\") {\r\n   115\t            t = v.clone();\r\n   116\t        }\r\n   117\t        if let Some(v) = map.get(\"cluster\") {\r\n   118\t            c = v.clone();\r\n   119\t        }\r\n   120\t    }\r\n   121\t    let mut e = Vec::new();\r\n   122\t    if let Some(blob) = logs.first() {\r\n   123\t        for line in String::from_utf8_lossy(blob).lines() {\r\n   124\t            let s = line.trim();\r\n   125\t            if !s.is_empty() {\r\n   126\t                e.push(s.to_string());\r\n   127\t            }\r\n   128\t        }\r\n   129\t    }\r\n   130\t    e.sort();\r\n   131\t    e.dedup();\r\n   132\t    let names: Vec<String> = bag.values().cloned().collect();\r\n   133\t    let walk = names.join(\"\\n\");\r\n"]
