[42.922125, "o", "===== hdr numbered =====\r\n"]
[42.923101, "o", "     1\t/// ustar headers are 512 bytes; payload is padded to that size.\r\n     2\tpub struct Row {\r\n     3\t    pub name: String,\r\n     4\t    pub hdr: u64,\r\n     5\t    pub size: u64,\r\n     6\t    pub body: u64,\r\n"]
[42.923211, "o", "     7\t    pub flag: u8,\r\n     8\t}\r\n     9\t\r\n    10\tfn oct_u64(buf: &[u8]) -> u64 {\r\n    11\t    let mut n: u64 = 0;\r\n    12\t    for &b in buf {\r\n    13\t        if b == 0 || b == b' ' {\r\n    14\t            continue;\r\n    15\t        }\r\n    16\t        if b >= b'0' && b <= b'7' {\r\n    17\t            n = n * 8 + u64::from(b - b'0');\r\n    18\t        }\r\n    19\t    }\r\n    20\t    n\r\n    21\t}\r\n    22\t\r\n    23\tpub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n    24\t    let raw = match std::fs::read(path) {\r\n    25\t        Ok(x) => x,\r\n    26\t        Err(_) => return Err(1),\r\n    27\t    };\r\n    28\t    if raw.len() < 512 {\r\n    29\t        return Err(1);\r\n    30\t    }\r\n    31\t    let mut rows = Vec::new();\r\n    32\t    let mut off = 0usize;\r\n    33\t    let mut saw = false;\r\n    34\t    while off + 512 <= raw.len() {\r\n    35\t        let blk = &raw[off..off + 512];\r\n    36\t        if blk.iter().all(|b| *b == 0) {\r\n    37\t            break;\r\n    38\t        }\r\n"]
[42.923269, "o", "    39\t        let magic = &blk[257..262];\r\n    40\t        if magic != b\"ustar\" {\r\n    41\t            return Err(1);\r\n    42\t        }\r\n    43\t        saw = true;\r\n    44\t        let nlen = blk[0..100]\r\n    45\t            .iter()\r\n    46\t            .position(|b| *b == 0)\r\n    47\t            .unwrap_or(100);\r\n    48\t        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();\r\n    49\t        let size = oct_u64(&blk[124..136]);\r\n    50\t        let flag = blk[156];\r\n    51\t        let body = (off + 512) as u64;\r\n    52\t        rows.push(Row {\r\n"]
[42.92329, "o", "    53\t            name,\r\n    54\t            hdr: off as u64,\r\n    55\t            size,\r\n    56\t            body,\r\n    57\t            flag,\r\n    58\t        });\r\n    59\t        let padded = ((size + 511) / 512) * 512;\r\n    60\t        off = off + 512 + padded as usize;\r\n    61\t    }\r\n    62\t    if !saw {\r\n    63\t        return Err(1);\r\n    64\t    }"]
[42.923309, "o", "\r\n    65\t    Ok(rows)\r\n    66\t}\r\n    67\t\r\n    68\tpub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n    69\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    70\t    let s = row.body as usize;\r\n    71\t    let e = s + row.size as usize;\r\n    72\t    if e > raw.len() {\r\n"]
[42.923321, "o", "    73\t        return Err(1);\r\n    74\t    }\r\n    75\t    Ok(raw[s..e].to_vec())\r\n    76\t}\r\n"]
