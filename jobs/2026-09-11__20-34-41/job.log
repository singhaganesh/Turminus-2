n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || matches!(b, b\'a\'..=b\'f\')) { return Err(1); }\n    Ok(s)\n}\n\nfn confined_archive(path: &str) -> Result<std::path::PathBuf, i32> {\n    let base = std::fs::canonicalize("/app/sealwell").map_err(|_| 1)?;\n    let archive = std::fs::canonicalize(path).map_err(|_| 1)?;\n    if !archive.starts_with(&base) || !archive.is_file() { return Err(1); }\n    Ok(archive)\n}\n\n#[path = "../ustarwalk/hdr.rs"] mod hdr;\n#[path = "../keeppit/first.rs"] mod first;\n#[path = "../cfgbag/kv.rs"] mod kv;\n#[path = "../cfgbag/alias.rs"] mod alias;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let archive = confined_archive(a)?;\n    let archive_s = archive.to_str().ok_or(1)?;\n    let recs = read_idx(b)?;\n    let rows = hdr::scan(archive_s)?;\n    let regular: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b\'0\' || r.flag == 0).collect();\n    if recs.len() != regular.len() { return Err(1); }\n    for (r, h) in recs.iter().zip(regular.iter()) {\n        if r.name != h.name || r.hdr != h.hdr || r.size != h.size || r.body != h.body { return Err(1); }\n    }\n\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut events = Vec::new();\n    let mut names = Vec::new();\n    for (r, h) in recs.iter().zip(regular.iter()) {\n        let blob = hdr::load_body(archive_s, h)?;\n        let name = alias::fold(&r.name);\n        names.push(r.name.clone());\n        if name == "sys.conf" || name.ends_with("/sys.conf") {\n            confs.push((r.name.clone(), r.hdr, blob));\n        } else if name == "app.log" || name.ends_with("/app.log") {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let event = line.trim();\n                if !event.is_empty() { events.push(event.to_string()); }\n            }\n        }\n    }\n    confs.sort_by_key(|r| r.1);\n    let mut timezone = String::new();\n    let mut cluster = String::new();\n    if let Some(blob) = first: