Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\np=Path(\'/app/ustarwalk/hdr.rs\')\np.write_text(r\'\'\'/// Strict reader for the small ustar stream used by the mill.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let field = buf.split(|b| *b == 0).next().unwrap_or(buf);\n    let text = std::str::from_utf8(field).map_err(|_| 1)?.trim();\n    if text.is_empty() || !text.bytes().all(|b| (b\'0\'..=b\'7\').contains(&b)) {\n        return Err(1);\n    }\n    u64::from_str_radix(text, 8).map_err(|_| 1)\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 {\n        return Err(1);\n    }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off + 512];\n        if blk.iter().all(|b| *b == 0) {\n            if !raw[off..].iter().all(|b| *b == 0) {\n                return Err(1);\n            }\n            ended = true;\n            break;\n        }\n        if &blk[257..263] != b"ustar\\0" && &blk[257..263] != b"ustar " {\n            return Err(1);\n        }\n        let nlen = blk[0..100].iter().position(|b| *b == 0).unwrap_or(100);\n        if nlen == 0 {\n            return Err(1);\n        }\n        let name = std::str::from_utf8(&blk[0..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = (off as u64).checked_add(512).and_then(|x| x.checked_add(padded)).ok_or(1)?;\n        if next > raw.len() as u64 {\n            return Err(1);\n        }\n        rows.push(Row { name, hdr: off as u64, size, body: (off + 512) as u64, flag: blk[156] });\n        off = next as usize;\n    }\n    if rows.is_empty() || !ended { Err(1) } else { Ok(rows) }\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let n = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\n\'\'\')\nPY\n\npython3 - <<\'PY\'\nfrom pathlib import Path\np=Path(\'/app/idxmill/shard.rs\')\np.write_text(r\'\'\'use super::hdr;\n\n#[path = "../cfgbag/alias.rs"]\nmod alias;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let mut seen_conf = false;\n    let mut seen_log = false;\n    let mut regs = Vec::new();\n    for r in &rows {\n        if r.flag != b\'0\' && r.flag != 0 { continue; }\n        let name = alias::fold(&r.name);\n        let take = if name == "etc/sys.conf" && !seen_conf {\n            seen_conf = true; true\n        } else if name == "var/log/app.log" && !seen_log {\n            seen_log = true; true\n        } else { false };\n        if take { regs.push((r, name)); }\n    }\n    if !seen_conf || !seen_log { return 1; }\n    let mut out = Vec::new();\n    out.extend_from_slice(b"SILT1");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for (r, name) in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    let tmp = format!("{}.tmp.{}", b, std::process::id());\n    if std::fs::write(&tmp, out).is_err() { return 1; }\n    if std::fs::rename(&tmp, b).is_err() { let _ = std::fs::remove_file(tmp); return 1; }\n    0\n}\n\'\'\')\nPY\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.