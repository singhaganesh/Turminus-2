[68.656183, "o", ">     let text = fs::read_to_string(path).map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.656467, "o", "    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\r\n\u001b[?2004l\r"]
[68.656616, "o", "\u001b[?2004h> "]
[68.657587, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[68.660643, "o", "\u001b[?2004hroot@b208777d337c:/app# "]
[68.831206, "i", "cat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list(\"/app/daywell\"));\n\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n    let _ = fs::remove_dir_all(\"/app/packbay/latest\");\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\n    fs::create_dir_all(\"/app/packbay/latest\").map_err(|_| 1)?;\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let mut packed = Vec::new();\n    let mut taken = 0;\n    for (day, source) in picked {\n        let name = format!(\"d{:08}.tbl\", day);\n        let staged = format!(\"/app/packbay/stage/{}\", name);\n        fs::copy(&source, &staged).map_err(|_| 1)?;\n        taken += read::nlines(&source)?;\n        packed.push((day, source));\n    }\n    if taken == 0 {\n        return Err(1);\n    }\n\n    soak::soak(&packed, \"/app/packbay/latest\")?;\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\n        \"/app/bloturn/ledger.json\",\n        format!(\"{{\\\"taken\\\":{}}}\", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\ncat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let template = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let output = template\n        .replace(\"__P__\", probe)\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", output).map_err(|_| 1)\n}\n\npub fn gait(expected: i32, files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    if files.is_empty() {\n        return 1;\n    }\n\n    let mut taken = 0;\n    let mut matched = 0;\n    let mut probe: Option<String> = None;\n    for (day, source) in files {\n        // This is deliberately a fresh read of daywell: the check does not\n        // trust ledger.json or the staged copy for its source row count.\n        let source_rows = match nlines(source) {\n            Ok(rows) => rows,\n            Err(code) => return code,\n        };\n        let restored = format!(\"/app/packbay/latest/d{:08}.tbl\", day);\n        let restored_rows = match nlines(&restored) {\n            Ok(rows) => rows,\n            Err(code) => return code,\n        };\n        if source_rows != restored_rows {\n            return 1;\n        }\n        if source_rows > 0 {\n            probe = Some(source.clone());\n        }\n        taken += source_rows;\n        matched += restored_rows;\n    }\n\n    let probe = match probe {\n        Some(path) => path,\n        None => return 1,\n    };\n    if taken != expected || matched != taken {\n        return 1;\n    }\n    if emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\n"]
