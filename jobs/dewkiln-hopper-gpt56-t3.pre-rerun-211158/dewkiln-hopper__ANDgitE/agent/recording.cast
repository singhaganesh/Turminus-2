[22.516374, "o", "     1\t101\r\n     2\t102\r\n     3\t103\r\n     4\t104\r\n     5\t105\r\n"]
[22.51667, "o", "### /app/seed/daywell/d20260911.tbl\r\n"]
[22.517793, "o", "     1\t201\r\n     2\t202\r\n     3\t203\r\n     4\t204\r\n"]
[22.518083, "o", "### /app/seed/daywell/d20260912.tbl\r\n"]
[22.519095, "o", "     1\t301\r\n     2\t302\r\n     3\t303\r\n     4\t304\r\n     5\t305\r\n     6\t306\r\n"]
[22.519302, "o", "### /app/seed/daywell/d20260913.tbl\r\n"]
[22.520243, "o", "     1\t401\r\n     2\t402\r\n     3\t403\r\n     4\t404\r\n     5\t405\r\n     6\t406\r\n     7\t407\r\n"]
[22.520559, "o", "\u001b[?2004h"]
[22.520716, "o", "root@b208777d337c:/app# "]
[23.513261, "i", "command -v rustc || true; rustc --version 2>/dev/null || true; stat -c '%A %s %y %n' /app/bin/dewkiln /app/wick.sh\n"]
[23.513813, "o", "command -v rustc || true; rustc --version 2>/dev/null || true; stat -c '%A %s %y %n' /app/bin/dewkiln /app/wick.sh\r\n\u001b[?2004l\r"]
[23.517538, "o", "-rwxr-xr-x 4050176 2026-09-13 10:12:53.000000000 +0000 /app/bin/dewkiln\r\n-rwxrwxr-x 202 2026-09-13 09:23:43.000000000 +0000 /app/wick.sh\r\n"]
[23.51782, "o", "\u001b[?2004h"]
[23.517908, "o", "root@b208777d337c:/app# "]
[68.641957, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], destination: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(destination);\n    fs::create_dir_all(destination).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|entry| entry.0);\n    for (day, path) in files {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(path, format!(\"{}/{}\", destination, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/shardfold/read.rs <<'EOF'\nuse std::fs;\n\npub fn list(root: &str) -> Vec<(i32, String)> {\n    let mut files = Vec::new();\n    let entries = match fs::read_dir(root) {\n        Ok(entries) => entries,\n        Err(_) => return files,\n    };\n    for entry in entries.flatten() {\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|byte| byte.is_ascii_digit()) {\n            continue;\n        }\n        if !entry.file_type().map(|kind| kind.is_file()).unwrap_or(false) {\n            continue;\n        }\n        if let Ok(day) = digits.parse::<i32>() {\n            files.push((day, entry.path().to_string_lossy().into_owned()));\n        }\n    }\n    files.sort_by_key(|entry| entry.0);\n    files\n}\n\npub fn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\nEOF\n"]
[68.644042, "o", "cat > /app/hopcue/rim.rs <<'EOF'\r\n\u001b[?2004l\r"]
[68.645651, "o", "\u001b[?2004h> pub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n\u001b[?2004l\r\u001b[?2004h>     files.into_iter().filter(|(day, _)| *day <= wall).collect()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[68.64666, "o", "\u001b[?2004h"]
