[69.035386, "i", "python3 - <<'PY'\np='/app/wickmill/boot.rs'\ns=open(p).read()\ns=s.replace('    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");', '    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\\n    let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\\n    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");')\ns=s.replace('            let _ = floor::floor(taken);\\n            gait::gait(taken, &packed)', '            if !floor::floor(taken) {\\n                1\\n            } else {\\n                gait::gait(taken, &packed)\\n            }')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\n/app/bin/dewkiln clasp; rc=$?; echo \"clasp_rc=$rc\"; od -An -tx1 -N4 /app/bin/dewkiln; echo '--- generated ---'; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do echo \"### $f\"; cat \"$f\"; echo; done; echo '--- latest ---'; find /app/packbay/latest -maxdepth 1 -type f -printf '%f\\n' | sort; for f in /app/packbay/latest/*; do printf '%s rows=' \"$(basename \"$f\")\"; awk 'NF{n++} END{print n+0}' \"$f\"; done\n"]
[69.036128, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
