[69.094653, "o", "\u001b[?2004hroot@b208777d337c:/app# /app/wick.sh\r\n\u001b[?2004l\r"]
[70.095222, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `width` is never used\u001b[0m\r\n\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/wickmill/../lidcue/skip.rs:5:8\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m5\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn width(a: &[(i32, String)]) -> usize {\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(dead_code)]` on by default\u001b[0m\r\n\r\n"]
[70.095735, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `first` is never used\u001b[0m\r\n\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/wickmill/../lidcue/skip.rs:9:8\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m9\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn first(a: &[(i32, String)]) -> Option<i32> {\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^\u001b[0m\r\n\r\n"]
[72.686926, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: 2 warnings emitted\u001b[0m\r\n\r\n"]
[72.717731, "o", "\u001b[?2004hroot@b208777d337c:/app# "]
[72.719432, "o", "/app/bin/dewkiln clasp; rc=$?; echo \"clasp_rc=$rc\"; od -An -tx1 -N4 /app/bin/dewkiln; echo '--- generated ---'; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do echo \"### $f\"; cat \"$f\"; echo; done; echo '--- latest ---'; find /app/packbay/latest -maxdepth 1 -type f -printf '%f\\n' | sort; for f in /app/packbay/latest/*; do printf '%s rows=' \"$(basename \"$f\")\"; awk 'NF{n++} END{print n+0}' \"$f\"; done\r\n\u001b[?2004l\r"]
[72.726846, "o", "clasp_rc=0\r\n"]
[72.731431, "o", " 7f 45 4c 46\r\n--- generated ---\r\n### /app/bloturn/ledger.json\r\n"]
[72.732253, "o", "{\"taken\":22}"]
[72.732791, "o", "\r\n### /app/bloturn/check.json\r\n"]
[72.734061, "o", "{\"probe\":\"/app/daywell/d20260913.tbl\",\"matched\":22,\"taken\":22}\r\n"]
[72.734338, "o", "\r\n### /app/bloturn/GUARD\r\n"]
[72.735859, "o", "ok"]
[72.736089, "o", "\r\n--- latest ---\r\n"]
[72.744123, "o", "d20260910.tbl\r\nd20260911.tbl\r\nd20260912.tbl\r\nd20260913.tbl\r\n"]
[72.747861, "o", "d20260910.tbl rows="]
[72.751062, "o", "5\r\n"]
[72.754375, "o", "d20260911.tbl rows="]
[72.756195, "o", "4\r\n"]
[72.76112, "o", "d20260912.tbl rows="]
[72.763807, "o", "6\r\n"]
[72.76705, "o", "d20260913.tbl rows="]
[72.768388, "o", "7\r\n"]
[72.768762, "o", "\u001b[?2004hroot@b208777d337c:/app# "]
[99.283213, "i", "set +e\nprintf '999\\n' > /app/daywell/d20260914.tbl\n/app/bin/dewkiln clasp\nr=$?\nif [ \"$r\" -eq 0 ] && [ ! -e /app/packbay/latest/d20260914.tbl ] && [ \"$(awk 'NF{n++} END{print n+0}' /app/packbay/latest/d20260913.tbl)\" -eq \"$(awk 'NF{n++} END{print n+0}' /app/daywell/d20260913.tbl)\" ]; then echo 'future_test=PASS'; else echo \"future_test=FAIL rc=$r\"; fi\nrm -f /app/daywell/d20260914.tbl\ncp /app/floorcue/MIN.txt /tmp/MIN.save\nprintf '999\\n' > /app/floorcue/MIN.txt\n/app/bin/dewkiln clasp\nr=$?\nif [ \"$r\" -ne 0 ] && [ ! -e /app/bloturn/GUARD ]; then echo 'floor_test=PASS'; else echo \"floor_test=FAIL rc=$r guard=$([ -e /app/bloturn/GUARD ] && echo yes || echo no)\"; fi\nmv /tmp/MIN.save /app/floorcue/MIN.txt\nmkdir -p /tmp/daywell.save\nmv /app/daywell/* /tmp/daywell.save/\n/app/bin/dewkiln clasp\nr=$?\nif [ \"$r\" -ne 0 ] && [ ! -e /app/bloturn/GUARD ]; then echo 'empty_test=PASS'; else echo \"empty_test=FAIL rc=$r guard=$([ -e /app/bloturn/GUARD ] && echo yes || echo no)\"; fi\nmv /tmp/daywell.save/* /app/daywell/\nrmdir /tmp/daywell.save\n/app/bin/dewkiln clasp\nr=$?\necho \"final_rc=$r\"\npython3 - <<'PY'\nimport json, os\nwith open('/app/bloturn/ledger.json') as f: ledger=json.load(f)\nwith open('/app/bloturn/check.json') as f: check=json.load(f)\nassert set(check) == {'probe','matched','taken'}\nassert isinstance(check['probe'],str) and os.path.isfile(check['probe'])\nassert type(check['matched']) is int and type(check['taken']) is int\nassert ledger['taken'] == check['matched'] == check['taken'] == 22\nassert open('/app/bloturn/GUARD').read() == 'ok'\nwall=int(open('/app/opstext/WALL').read())\nlatest=sorted(os.listdir('/app/packbay/latest'))\nassert all(int(n[1:9]) <= wall for n in latest)\nassert latest == ['d20260910.tbl','d20260911.tbl','d20260912.tbl','d20260913.tbl']\nfor name in latest:\n    src=sum(bool(x.strip()) for x in open('/app/daywell/'+name))\n    dst=sum(bool(x.strip()) for x in open('/app/packbay/latest/'+name))\n    assert src == dst\nassert open('/app/bin/dewkiln','rb').read(4) == b'\\x7fELF'\nprint('final_validation=PASS', check)\nPY\n"]
