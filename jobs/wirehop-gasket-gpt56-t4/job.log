llthrough".to_string());\n    println!("{{\\"wire\\":{},\\"reply\\":\\"{}\\"}}", n, reply);\n    0\n}\nEOF\npython3 - <<\'PY\'\np=\'/app/gaskcli/boot.rs\'\ns=open(p).read()\ns=s.replace(\'let n: u8 = raw.parse().unwrap_or(0);\\n            table::tap(n)\', \'match raw.parse::<i64>() {\\n                Ok(n) => table::tap(n),\\n                Err(_) => {\\n                    eprintln!("jab requires an integer");\\n                    2\\n                }\\n            }\')\nopen(p,\'w\').write(s)\nPY\ncat > /app/lidpit/plug.rs <<\'EOF\'\nuse crate::cards;\nuse crate::loom;\nuse crate::table;\nuse std::fs;\n\npub fn rib_c() -> i32 {\n    let _ = loom::emit();\n    let spec = cards::load();\n    let complete = spec.iter().all(|row| {\n        table::lookup(row.wire)\n            .map(|slot| slot.label == row.label && slot.reply == row.reply)\n            .unwrap_or(false)\n    });\n\n    let _ = fs::create_dir_all("/app/corkbay");\n    if !complete {\n        let served = spec\n            .iter()\n            .filter(|row| {\n                table::lookup(row.wire)\n                    .map(|slot| slot.label == row.label && slot.reply == row.reply)\n                    .unwrap_or(false)\n            })\n            .map(|row| format!("\\"{}\\"", row.label))\n            .collect::<Vec<_>>()\n            .join(",");\n        let text = format!("{{\\"served\\":[{}],\\"status\\":\\"open\\"}}\\n", served);\n        let _ = fs::write("/app/corkbay/seal.json", text);\n        return 1;\n    }\n\n    let served = spec\n        .iter()\n        .map(|row| format!("\\"{}\\"", row.label))\n        .collect::<Vec<_>>()\n        .join(",");\n    let text = format!("{{\\"served\\":[{}],\\"status\\":\\"sealed\\"}}\\n", served);\n    let _ = fs::write("/app/corkbay/seal.json", text);\n    0\n}\nEOF\nsed -n \'1,160p\' /app/gaskcli/boot.rs; sed -n \'1,180p\' /app/lidpit/plug.rs\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
