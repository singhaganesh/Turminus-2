[47.817936, "o", "root@b40afb518a0b:/app# "]
[49.52894, "i", "cat > /app/slipread/scan.rs <<'EOF'\nuse std::fs;\nuse std::path::Path;\n\n#[derive(Clone)]\npub struct Row {\n    pub label: String,\n    pub wire: i64,\n    pub reply: String,\n}\n\npub fn load() -> Vec<Row> {\n    let dir = Path::new(\"/app/buscards\");\n    let mut names: Vec<_> = fs::read_dir(dir)\n        .map(|rd| {\n            rd.filter_map(|e| e.ok())\n                .map(|e| e.path())\n                .filter(|p| p.extension().map(|x| x == \"card\").unwrap_or(false))\n                .collect()\n        })\n        .unwrap_or_default();\n    names.sort();\n\n    let mut out = Vec::new();\n    for path in names {\n        let text = fs::read_to_string(path).unwrap_or_default();\n        let mut label = None;\n        let mut wire = None;\n        let mut reply = None;\n        for line in text.lines() {\n            let line = line.trim();\n            if let Some(value) = line.strip_prefix(\"LABEL \") {\n                label = Some(value.trim().to_string());\n            } else if let Some(value) = line.strip_prefix(\"WIRE \") {\n                wire = value.trim().parse::<i64>().ok();\n            } else if let Some(value) = line.strip_prefix(\"REPLY \") {\n                reply = Some(value.trim().to_string());\n            }\n        }\n        if let (Some(label), Some(wire), Some(reply)) = (label, wire, reply) {\n            if !label.is_empty() {\n                out.push(Row { label, wire, reply });\n            }\n        }\n    }\n    out\n}\nEOF\ncat > /app/hopmat/table.rs <<'EOF'\nuse crate::cards;\n\n#[derive(Clone)]\npub struct Slot {\n    pub label: String,\n    pub reply: String,\n}\n\npub fn lookup(wire: i64) -> Option<Slot> {\n    cards::load()\n        .into_iter()\n        .find(|row| row.wire == wire)\n        .map(|row| Slot {\n            label: row.label,\n            reply: row.reply,\n        })\n}\n\npub fn tap(n: i64) -> i32 {\n    let reply = lookup(n)\n        .map(|slot| slot.reply)\n        .unwrap_or_else(|| \"fallthrough\".to_string());\n    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":\\\"{}\\\"}}\", n, reply);\n    0\n}\nEOF\npython3 - <<'PY'\np='/app/gaskcli/boot.rs'\ns=open(p).read()\ns=s.replace('let n: u8 = raw.parse().unwrap_or(0);\\n            table::tap(n)', 'match raw.parse::<i64>() {\\n                Ok(n) => table::tap(n),\\n                Err(_) => {\\n                    eprintln!(\"jab requires an integer\");\\n                    2\\n                }\\n            }')\nopen(p,'w').write(s)\nPY\ncat > /app/lidpit/plug.rs <<'EOF'\nuse crate::cards;\nuse crate::loom;\nuse crate::table;\nuse std::fs;\n\npub fn rib_c() -> i32 {\n    let _ = loom::emit();\n    let spec = cards::load();\n    let complete = spec.iter().all(|row| {\n        table::lookup(row.wire)\n            .map(|slot| slot.label == row.label && slot.reply == row.reply)\n            .unwrap_or(false)\n    });\n\n    let _ = fs::create_dir_all(\"/app/corkbay\");\n    if !complete {\n        let served = spec\n            .iter()\n            .filter(|row| {\n                table::lookup(row.wire)\n                    .map(|slot| slot.label == row.label && slot.reply == row.reply)\n                    .unwrap_or(false)\n            })\n            .map(|row| format!(\"\\\"{}\\\"\", row.label))\n            .collect::<Vec<_>>()\n            .join(\",\");\n        let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"open\\\"}}\\n\", served);\n        let _ = fs::write(\"/app/corkbay/seal.json\", text);\n        return 1;\n    }\n\n    let served = spec\n        .iter()\n        .map(|row| format!(\"\\\"{}\\\"\", row.label))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"sealed\\\"}}\\n\", served);\n    let _ = fs::write(\"/app/corkbay/seal.json\", text);\n    0\n}\nEOF\nsed -n '1,160p' /app/gaskcli/boot.rs; sed -n '1,180p' /app/lidpit/plug.rs\n"]
