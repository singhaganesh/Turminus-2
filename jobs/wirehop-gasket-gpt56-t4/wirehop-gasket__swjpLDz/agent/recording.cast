[12.274495, "o", "\u001b[?2004hroot@b40afb518a0b:/app# "]
[21.296687, "i", "for f in /app/gaskcli/boot.rs /app/slipread/scan.rs /app/loomkit/loom.rs /app/rimcap/span.rs /app/hopmat/table.rs /app/lidpit/plug.rs /app/lidpit/tally.rs /app/stoke.sh /app/opscribe/COUNT_SRC.txt /app/loomkit/emit.lst; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[21.298347, "o", "for f in /app/gaskcli/boot.rs /app/slipread/scan.rs /app/loomkit/loom.rs /app/rimcap/span.rs /app/hopmat/table.rs /app/lidpit/plug.rs /app/lidpit/tally.rs /app/stoke.sh /app/opscribe/COUNT_SRC.txt /app/loomkit/emit.lst; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r===== /app/gaskcli/boot.rs =====\r\n"]
[21.303429, "o", "#[path = \"../slipread/scan.rs\"]\r\nmod cards;\r\n#[path = \"../rimcap/span.rs\"]\r\nmod span;\r\n#[path = \"../hopmat/table.rs\"]\r\nmod table;\r\n#[path = \"../lidpit/plug.rs\"]\r\nmod vat;\r\n#[path = \"../loomkit/loom.rs\"]\r\nmod loom;\r\n#[path = \"../lidpit/tally.rs\"]\r\nmod tally;\r\n\r\nfn main() {\r\n    let mut args = std::env::args().skip(1);\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n"]
[21.303627, "o", "        \"bind\" => loom::emit(),\r\n        \"jab\" => {\r\n            let raw = args.next().unwrap_or_else(|| \"0\".to_string());\r\n            let n: u8 = raw.parse().unwrap_or(0);\r\n            table::tap(n)\r\n        }\r\n        \"cork\" => vat::rib_c(),\r\n        _ => {\r\n            eprintln!(\"usage: gasketd bind|jab N|cork\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[21.303804, "o", "===== /app/slipread/scan.rs =====\r\n"]
[21.305179, "o", "use std::fs;\r\nuse std::path::Path;\r\n\r\n#[derive(Clone)]\r\npub struct Row {\r\n    pub label: String,\r\n    #[allow(dead_code)]\r\n    pub wire: u8,\r\n    pub reply: String,\r\n}\r\n"]
[21.305335, "o", "\r\nimpl Default for Row {\r\n    fn default() -> Self {\r\n        Self {\r\n            label: String::new(),\r\n            wire: 0,\r\n            reply: \"fallthrough\".to_string(),\r\n        }\r\n    }\r\n}\r\n\r\npub fn load() -> Vec<Row> {\r\n    let dir = Path::new(\"/app/buscards\");\r\n    let mut names: Vec<_> = fs::read_dir(dir)\r\n        .map(|rd| {\r\n            rd.filter_map(|e| e.ok())\r\n                .map(|e| e.path())\r\n                .filter(|p| p.extension().map(|x| x == \"card\").unwrap_or(false))\r\n                .collect()\r\n        })\r\n        .unwrap_or_default();\r\n    names.sort();\r\n    let mut out = Vec::new();\r\n    for p in names {\r\n        let text = fs::read_to_string(&p).unwrap_or_default();\r\n        let mut label = String::new();\r\n        let mut wire: u8 = 0;\r\n        let mut reply = String::new();\r\n        for line in text.lines() {\r\n            let line = line.trim();\r\n            if let Some(rest) = line.strip_prefix(\"LABEL \") {\r\n                label = rest.trim().to_string();\r\n            } else if let Some(rest) = line.strip_prefix(\"WIRE \") {\r\n                wire = rest.trim().parse().unwrap_or(0);\r\n            } else if let Some(rest) = line.strip_prefix(\"REPLY \") {\r\n                reply = rest.trim().to_string();\r\n            }\r\n        }\r\n        if !label.is_empty() {\r\n            out.push(Row {\r\n                label,\r\n                wire,\r\n                reply,\r\n            });\r\n        }\r\n    }\r\n"]
[21.305423, "o", "    out\r\n}\r\n"]
[21.305602, "o", "===== /app/loomkit/loom.rs =====\r\n"]
[21.306705, "o", "use crate::cards;\r\nuse std::fs;\r\n\r\npub fn emit() -> i32 {\r\n"]
[21.306825, "o", "    let rows = cards::load();\r\n    let _ = fs::create_dir_all(\"/app/mistwell\");\r\n    let _ = fs::create_dir_all(\"/app/loomkit\");\r\n    let names: Vec<String> = rows.iter().map(|r| format!(\"\\\"{}\\\"\", r.label)).collect();\r\n    let body = format!(\"{{\\\"names\\\":[{}]}}\\n\", names.join(\",\"));\r\n    let _ = fs::write(\"/app/mistwell/roster.json\", body);\r\n    let lst = rows\r\n        .iter()\r\n        .map(|r| format!(\"{}\\t{}\\t{}\", r.label, r.wire, r.reply))\r\n        .collect::<Vec<_>>()\r\n        .join(\"\\n\")\r\n        + \"\\n\";\r\n    let _ = fs::write(\"/app/loomkit/emit.lst\", lst);\r\n    0\r\n}\r\n"]
[21.307001, "o", "===== /app/rimcap/span.rs =====\r\n"]
[21.308055, "o", "pub fn rib_a() -> usize {\r\n    8\r\n}\r\n"]
[21.308241, "o", "===== /app/hopmat/table.rs =====\r\n"]
[21.309297, "o", "use crate::span;\r\n\r\nconst RAW: &str = include_str!(\"../loomkit/emit.lst\");\r\n\r\n#[derive(Clone)]\r\npub struct Slot {\r\n    #[allow(dead_code)]\r\n    pub label: String,\r\n    pub reply: String,\r\n"]
[21.309451, "o", "}\r\n\r\nimpl Default for Slot {\r\n    fn default() -> Self {\r\n        Self {\r\n            label: String::new(),\r\n            reply: \"fallthrough\".to_string(),\r\n        }\r\n    }\r\n}\r\n\r\nfn parse_line(line: &str) -> Option<(u8, Slot)> {\r\n    let mut parts = line.split('\\t');\r\n    let label = parts.next()?.trim().to_string();\r\n    let wire: u8 = parts.next()?.trim().parse().ok()?;\r\n    let reply = parts.next()?.trim().to_string();\r\n    if label.is_empty() {\r\n        return None;\r\n    }\r\n    Some((wire, Slot { label, reply }))\r\n}\r\n\r\npub fn rib_b() -> Vec<Slot> {\r\n    let cap = span::rib_a();\r\n    let mut slots: Vec<Slot> = vec![Slot::default(); 256];\r\n    for (i, line) in RAW.lines().enumerate() {\r\n        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        if let Some((_w, slot)) = parse_line(line) {\r\n            if i < cap {\r\n                slots[i] = slot;\r\n            }\r\n        }\r\n    }\r\n    slots\r\n}\r\n\r\npub fn tap(n: u8) -> i32 {\r\n    let slots = rib_b();\r\n    let row = &slots[n as usize];\r\n    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":\\\"{}\\\"}}\", n, row.reply);\r\n    0\r\n}\r\n"]
[21.309701, "o", "===== /app/lidpit/plug.rs =====\r\n"]
[21.310707, "o", "use crate::cards;\r\nuse crate::loom;\r\nuse crate::tally;\r\nuse std::fs;\r\n\r\n"]
[21.310828, "o", "pub fn rib_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let _ = loom::emit();\r\n    let body = fs::read_to_string(\"/app/mistwell/roster.json\").unwrap_or_default();\r\n    let spec = cards::load();\r\n    let mut names: Vec<String> = Vec::new();\r\n    for row in &spec {\r\n        if body.contains(&row.label) {\r\n            names.push(row.label.clone());\r\n        }\r\n    }\r\n    if names.len() != spec.len() {\r\n        let _ = fs::create_dir_all(\"/app/corkbay\");\r\n        let _ = fs::write(\r\n            \"/app/corkbay/seal.json\",\r\n            \"{\\\"served\\\":[],\\\"status\\\":\\\"open\\\"}\\n\",\r\n        );\r\n        return 1;\r\n    }\r\n    let served = names\r\n        .iter()\r\n        .map(|n| format!(\"\\\"{}\\\"\", n))\r\n        .collect::<Vec<_>>()\r\n        .join(\",\");\r\n    let _ = fs::create_dir_all(\"/app/corkbay\");\r\n    let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"sealed\\\"}}\\n\", served);\r\n    let _ = fs::write(\"/app/corkbay/seal.json\", text);\r\n    0\r\n}\r\n"]
[21.311024, "o", "===== /app/lidpit/tally.rs =====\r\n"]
[21.312051, "o", "use std::fs;\r\n\r\npub fn lines() -> usize {\r\n    fs::read_to_string(\"/app/loomkit/emit.lst\")\r\n        .unwrap_or_default()\r\n        .lines()\r\n        .filter(|l| !l.trim().is_empty())\r\n        .count()\r\n}\r\n"]
[21.312254, "o", "===== /app/stoke.sh =====\r\n"]
[21.313399, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin\r\nrustc --edition 2021 -O /app/gaskcli/boot.rs -o /app/bin/gasketd\r\n"]
[21.313647, "o", "===== /app/opscribe/COUNT_SRC.txt =====\r\n"]
[21.3147, "o", "Desk note from last shift: coverage equals the line count of\r\n/app/loomkit/emit.lst versus how many cards sit under /app/buscards.\r\nIf those two numbers match, cork can treat the hopper as sealed.\r\n"]
[21.314878, "o", "===== /app/loomkit/emit.lst =====\r\n"]
[21.315873, "o", "SET_FAN\t1\tfan-ok\r\nSET_PUMP\t2\tpump-ok\r\nSET_VALVE\t4\tvalve-ok\r\nREAD_TEMP\t7\ttemp-ok\r\nREAD_PRESS\t8\tpress-ok\r\n"]
[21.315939, "o", "HOLD_LATCH\t10\tlatch-ok\r\nTRIM_BIAS\t12\tbias-ok\r\nACK_WATCH\t15\twatch-ok\r\nVENT_LINE\t17\tvent-ok\r\n"]
[21.31611, "o", "\u001b[?2004h"]
