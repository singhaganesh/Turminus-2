[10.552153, "o", "printf '%s\\n' '--- environment ---'; find /app/environment -maxdepth 3 -type f -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;; printf '%s\\n' '--- samples ---'; for f in /app/rolls/*; do echo \"### $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[10.552958, "o", "--- environment ---\r\n"]
[10.555994, "o", "/app/environment/parse.go\r\n"]
[10.557514, "o", "### /app/environment/parse.go\r\n"]
[10.560679, "o", "package main\r\n\r\nimport (\r\n\t\"strings\"\r\n\t\"unicode\"\r\n)\r\n\r\nfunc safeName(text string) bool {\r\n\tif text == \"\" {\r\n\t\treturn false\r\n\t}\r\n\tfor _, r := range text {\r\n\t\tif unicode.IsLetter(r) || unicode.IsDigit(r) || r == '.' || r == '_' || r == '-' {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc parseRoll(sheet string) ([]Car, int) {\r\n\tvar cars []Car\r\n\tfor _, raw := range strings.Split(sheet, \"\\n\") {\r\n\t\tline := strings.TrimSpace(raw)\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\twords := strings.Fields(line)\r\n"]
[10.560933, "o", "\t\tif len(words) < 10 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif words[0] != \"PLATE\" || words[2] != \"LEN\" || words[4] != \"HT\" || words[6] != \"HAZ\" || words[8] != \"BOARD\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !safeName(words[1]) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tlength := atoiLoose(words[3])\r\n\t\tht := atoiLoose(words[5])\r\n\t\t"]
[10.561182, "o", "haz := atoiLoose(words[7])\r\n\t\tboard := atoiLoose(words[9])\r\n\t\tif ht < 0 || board < 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tcars = append(cars, Car{Plate: words[1], Len: length, Ht: ht, Haz: haz, Board: board})\r\n\t}\r\n\treturn cars, 0\r\n}\r\n\r\nfunc atoiLoose(text string) int {\r\n\tif text == \"\" {\r\n\t\treturn 0\r\n\t}\r\n\tn := 0\r\n\tfor _, r := range text {\r\n\t\tif r < '0' || r > '9' {\r\n\t\t\treturn 0\r\n\t\t}\r\n\t\tn = n*10 + int(r-'0')\r\n\t}\r\n\treturn n\r\n}\r\n"]
[10.561706, "o", "/app/environment/offer.go\r\n"]
[10.563075, "o", "### /app/environment/offer.go\r\n"]
[10.564601, "o", "package main\r\n\r\ntype occ struct {\r\n\tused    int\r\n\tmass    int\r\n\tlastHaz int\r\n\thas     bool\r\n}\r\n\r\nfunc pickLane(car Car, fill map[string]*occ, deckKg map[string]int) Lane {\r\n\t_ = car\r\n"]
[10.564779, "o", "\t_ = fill\r\n\t_ = deckKg\r\n\treturn Lane{Deck: \"B\", Name: \"B1\", Lid: 420, Span: 2000}\r\n}\r\n"]
[10.56549, "o", "/app/environment/chalk.go\r\n"]
[10.567627, "o", "### /app/environment/chalk.go\r\n"]
[10.571126, "o", "package main\r\n\r\nimport \"fmt\"\r\n\r\nfunc emit(lines *[]string, i *int, plate, deck, lane, station, ok string) {\r\n\t*i++\r\n\trow := fmt.Sprintf(`{\"i\":%d,\"verb\":\"stow\"`, *i)\r\n\tif plate != \"\" {\r\n\t\trow += fmt.Sprintf(`,\"plate\":\"%s\"`, plate)\r\n"]
[10.57165, "o", "\t}\r\n\tif deck != \"\" {\r\n\t\trow += fmt.Sprintf(`,\"deck\":\"%s\"`, deck)\r\n\t}\r\n\tif lane != \"\" {\r\n\t\trow += fmt.Sprintf(`,\"lane\":\"%s\"`, lane)\r\n\t}\r\n\tif station != \"\" {\r\n\t\trow += fmt.Sprintf(`,\"station\":\"%s\"`, station)\r\n\t}\r\n\trow += fmt.Sprintf(`,\"ok\":\"%s\"}`+\"\\n\", ok)\r\n\t*lines = append(*lines, row)\r\n}\r\n"]
[10.572392, "o", "/app/environment/cars.go\r\n"]
[10.57372, "o", "### /app/environment/cars.go\r\n"]
[10.575933, "o", "package main\r\n\r\ntype Car struct {\r\n\tPlate string\r\n\tLen   int\r\n\tHt    int\r\n\tMass  int\r\n\tHaz   int\r\n\tBoard int\r\n}\r\n"]
[10.576647, "o", "/app/environment/main.go\r\n"]
[10.578136, "o", "### /app/environment/main.go\r\n"]
[10.57977, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) != 6 || os.Args[1] != \"stow\" || os.Args[2] != \"--roll\" || os.Args[4] != \"--chalk\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: cleat stow --roll PATH --chalk PATH\\n\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tbody, err := os.ReadFile(os.Args[3])\r\n\tif err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\trc, text := fold(string(body))\r\n\tif err := os.WriteFile(os.Args[5], []byte(text), 0644); err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif rc == -2 {\r\n\t\tos.Exit(2)\r\n\t}\r\n\tif rc != 0 {\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[10.580367, "o", "/app/environment/Makefile\r\n"]
[10.58169, "o", "### /app/environment/Makefile\r\n"]
[10.583144, "o", "BIN := /opt/ferry/bin/cleat\r\nGO ?= go\r\n\r\n.PHONY: all install clean\r\n\r\nall: install\r\n\r\ninstall:\r\n\tmkdir -p /opt/ferry/bin\r\n\t$(GO) build -o $(BIN) .\r\n\r\nclean:\r\n\trm -f $(BIN)\r\n"]
[10.583721, "o", "/app/environment/apron.go\r\n"]
[10.585305, "o", "### /app/environment/apron.go\r\n"]
[10.588468, "o", "package main\r\n\r\nfunc rampApron(haz int) int {\r\n\t_ = haz\r\n\treturn 0\r\n}\r\n"]
[10.589204, "o", "/app/environment/vault.go\r\n"]
[10.591357, "o", "### /app/environment/vault.go\r\n"]
[10.593656, "o", "package main\r\n\r\ntype Lane struct {\r\n\tDeck string\r\n\tName string\r\n\tLid  int\r\n\tSpan int\r\n}\r\n\r\nfunc allLanes() []Lane {\r\n\treturn []Lane{\r\n\t\t{Deck: \"A\", Name: \"A1\", Lid: 180, Span: 2000},\r\n\t\t{Deck: \"A\", Name: \"A2\", Lid: 180, Span: 2000},\r\n\t\t{Deck: \"B\", Name: \"B1\", Lid: 420, Span: 2000},\r\n\t\t{Deck: \"B\", Name: \"B2\", Lid: 420, Span: 2000},\r\n\t}\r\n}\r\n"]
[10.594472, "o", "/app/environment/board.go\r\n"]
[10.595942, "o", "### /app/environment/board.go\r\n"]
[10.597506, "o", "package main\r\n\r\nimport \"sort\"\r\n\r\nfunc arrange(cars []Car) []Car {\r\n\tout := append([]Car(nil), cars...)\r\n\tsort.Slice(out, func(i, j int) bool {\r\n\t\tif out[i].Board == out[j].Board {\r\n\t\t\treturn out[i].Plate > out[j].Plate\r\n\t\t}\r\n\t\treturn out[i].Board > out[j].Board\r\n\t})\r\n\treturn out\r\n}\r\n\r\nfunc stationOf(cursor int, car Car, gap int) int {\r\n\t_ = car\r\n\t_ = gap\r\n\treturn cursor - 10\r\n}\r\n"]
[10.598012, "o", "/app/environment/go.mod\r\n"]
[10.599459, "o", "### /app/environment/go.mod\r\n"]
[10.601103, "o", "module cleat\r\n\r\ngo 1.24\r\n"]
[10.602778, "o", "/app/environment/kilo.go\r\n"]
[10.605196, "o", "### /app/environment/kilo.go\r\n"]
[10.607462, "o", "package main\r\n\r\nfunc massFits(lane Lane, slot *occ, car Car, deckUsed int) bool {\r\n\t_ = lane\r\n\t_ = slot\r\n\t_ = car\r\n\t_ = deckUsed\r\n\treturn true\r\n}\r\n"]
[10.60817, "o", "/app/environment/trim.go\r\n"]
[10.609734, "o", "### /app/environment/trim.go\r\n"]
[10.612059, "o", "package main\r\n\r\nfunc trimFits(lane Lane, fill map[string]*occ, extra int) bool {\r\n\t_ = lane\r\n\t_ = fill\r\n\t_ = extra\r\n\treturn true\r\n}\r\n"]
[10.61277, "o", "/app/environment/fold.go\r\n"]
[10.61514, "o", "### /app/environment/fold.go\r\n"]
[10.616583, "o", "package main\r\n\r\nimport \"strings\"\r\n\r\nfunc fold(sheet string) (int, string) {\r\n\tcars, rc := parseRoll(sheet)\r\n\tif rc != 0 {\r\n\t\treturn rc, \"\"\r\n\t}\r\n\tif len(cars) == 0 {\r\n\t\treturn 0, \"{\\\"i\\\":1,\\\"verb\\\":\\\"stow\\\",\\\"ok\\\":\\\"empty\\\"}\\n\"\r\n\t}\r\n\tordered := arrange(cars)\r\n\tfill := map[string]*occ{}\r\n\tdeckKg := map[string]int{}\r\n\tvar lines []string\r\n"]
[10.616955, "o", "\tn := 0\r\n\tfor i, car := range ordered {\r\n\t\tlane := pickLane(car, fill, deckKg)\r\n\t\tstation := stationOf(2000, car, 0)\r\n\t\t_ = i\r\n\t\temit(&lines, &n, car.Plate, lane.Deck, lane.Name, fmtInt(station), \"yes\")\r\n\t\tif fill[lane.Name] == nil {\r\n\t\t\tfill[lane.Name] = &occ{}\r\n\t\t}\r\n\t\tfill[lane.Name].used += car.Len\r\n\t\tfill[lane.Name].has = true\r\n\t}\r\n\treturn 0, strings.Join(lines, \"\")\r\n}\r\n\r\nfunc fmtInt(n int) string {\r\n\tif n == 0 {\r\n\t\treturn \"0\"\r\n\t}\r\n\tsign := \"\"\r\n\tif n < 0 {\r\n\t\tsign = \"-\"\r\n\t\tn = -n\r\n\t}\r\n\tvar d []byte\r\n\tfor n > 0 {\r\n\t\td = append([]byte{byte('0' + n%10)}, d...)\r\n\t\tn /= 10\r\n\t}\r\n\treturn sign + string(d)\r\n}\r\n"]
[10.617469, "o", "/app/environment/spacing.go\r\n"]
[10.62019, "o", "### /app/environment/spacing.go\r\n"]
[10.622829, "o", "package main\r\n\r\nfunc neighbourGap(prevHaz, haz int) int {\r\n\t_ = prevHaz\r\n\t_ = haz\r\n\treturn 0\r\n}\r\n"]
[10.624367, "o", "--- samples ---\r\n"]
[10.624664, "o", "### /app/rolls/night.roll\r\n"]
