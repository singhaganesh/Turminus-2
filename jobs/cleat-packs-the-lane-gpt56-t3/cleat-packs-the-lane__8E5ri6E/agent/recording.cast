[92.08911, "o", "\u001b[?2004h> \u0007"]
[92.089259, "o", "// The first plate on either sister is explicitly free.  Once both were\r\n\u001b[?2004l\r"]
[92.089304, "o", "\u001b[?2004h> "]
[92.089341, "o", "\u0007"]
[92.089484, "o", "// already occupied, the resulting lane totals must be within 3000 kg.\r\n\u001b[?2004l\r"]
[92.089529, "o", "\u001b[?2004h> "]
[92.089566, "o", "\u0007"]
[92.089714, "o", "if here == nil || !here.has || other == nil || !other.has { return true }\r\n\u001b[?2004l\r"]
[92.089758, "o", "\u001b[?2004h> "]
[92.0898, "o", "\u0007"]
[92.089869, "o", "d := here.mass + extra - other.mass\r\n\u001b[?2004l\r"]
[92.089914, "o", "\u001b[?2004h> "]
[92.089955, "o", "\u0007"]
[92.090001, "o", "if d < 0 { d = -d }\r\n\u001b[?2004l\r"]
[92.090051, "o", "\u001b[?2004h"]
