[141.727488, "i", "tmp=$(mktemp -d); cat > \"$tmp/all.roll\" <<'EOF'\n# listing differs from boarding order\nPLATE late LEN 200 HT 160 MASS 1000 HAZ 0 BOARD 9\nPLATE ztie LEN 200 HT 160 MASS 1000 HAZ 0 BOARD 2\nPLATE atie LEN 400 HT 160 MASS 7000 HAZ 0 BOARD 2\nPLATE tall LEN 2000 HT 181 MASS 12000 HAZ 0 BOARD 1\nPLATE haz1 LEN 400 HT 160 MASS 1000 HAZ 1 BOARD 3\nPLATE haz2 LEN 400 HT 160 MASS 1000 HAZ 1 BOARD 4\nEOF\n/opt/ferry/bin/cleat stow --roll \"$tmp/all.roll\" --chalk \"$tmp/all.out\"; rc=$?; echo \"rc=$rc\"; cat \"$tmp/all.out\"; echo '--- JSON/type checks'; python3 - \"$tmp/all.out\" <<'PY'\nimport json,sys\nrows=[json.loads(x) for x in open(sys.argv[1])]\nassert [r['i'] for r in rows]==list(range(1,len(rows)+1))\nassert all(r['verb']=='stow' and r['ok'] in ('yes','no') for r in rows)\nassert all('station' not in r or type(r['station']) is int for r in rows)\nprint('valid NDJSON')\nPY\ncat > \"$tmp/h.roll\" <<'EOF'\nPLATE h1 LEN 400 HT 160 MASS 1000 HAZ 1 BOARD 1\nPLATE h2 LEN 400 HT 160 MASS 1000 HAZ 1 BOARD 2\nEOF\n/opt/ferry/bin/cleat stow --roll \"$"]
[141.727661, "i", "tmp/h.roll\" --chalk \"$tmp/h.out\"; echo '--- haz coordinates'; cat \"$tmp/h.out\"; cat > \"$tmp/mass.roll\" <<'EOF'\nPLATE x LEN 100 HT 160 MASS 7000 HAZ 0 BOARD 1\nPLATE y LEN 100 HT 160 MASS 7000 HAZ 0 BOARD 2\nPLATE z LEN 100 HT 160 MASS 4000 HAZ 0 BOARD 3\nEOF\n/opt/ferry/bin/cleat stow --roll \"$tmp/mass.roll\" --chalk \"$tmp/mass.out\"; echo '--- mass fallback'; cat \"$tmp/mass.out\"; rm -rf \"$tmp\"\n"]
