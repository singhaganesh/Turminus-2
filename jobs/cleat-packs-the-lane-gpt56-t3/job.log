{ if deck == "A" { return 11000 }; return 28000 }\nfunc sister(name string) string { switch name { case "A1": return "A2"; case "A2": return "A1"; case "B1": return "B2"; default: return "B1" } }\nEOF\ncat > board.go <<\'EOF\'\npackage main\nimport "sort"\nfunc arrange(cars []Car) []Car {\n\tout := append([]Car(nil), cars...)\n\tsort.Slice(out, func(i,j int) bool { if out[i].Board != out[j].Board { return out[i].Board < out[j].Board }; return out[i].Plate < out[j].Plate })\n\treturn out\n}\nfunc stationOf(cursor int, car Car, gap int) int { return cursor - gap - car.Len }\nEOF\ncat > spacing.go <<\'EOF\'\npackage main\nfunc neighbourGap(prevHaz, haz int) int {\n\tif prevHaz == 0 && haz == 0 { return 0 }\n\tif prevHaz == 1 && haz == 1 { return 200 }\n\treturn 100\n}\nEOF\ncat > apron.go <<\'EOF\'\npackage main\nfunc rampApron(haz int) int { if haz == 1 { return 100 }; return 0 }\nEOF\ncat > kilo.go <<\'EOF\'\npackage main\nfunc massFits(lane Lane, slot *occ, car Car, deckUsed int) bool {\n\tlaneUsed := 0\n\tif slot != nil { laneUsed = slot.mass }\n\treturn laneUsed + car.Mass <= lane.MassLid && deckUsed + car.Mass <= deckLid(lane.Deck)\n}\nEOF\ncat > trim.go <<\'EOF\'\npackage main\nfunc trimFits(lane Lane, fill map[string]*occ, extra int) bool {\n\there, other := fill[lane.Name], fill[sister(lane.Name)]\n\t// The first plate on either sister is explicitly free.  Once both were\n\t// already occupied, the resulting lane totals must be within 3000 kg.\n\tif here == nil || !here.has || other == nil || !other.has { return true }\n\td := here.mass + extra - other.mass\n\tif d < 0 { d = -d }\n\treturn d <= 3000\n}\nEOF\ncat > offer.go <<\'EOF\'\npackage main\n\ntype occ struct { used, reserve, mass, lastHaz int; has bool }\n\nfunc pickLane(car Car, fill map[string]*occ, deckKg map[string]int) (Lane, int, bool) {\n\tfor _, lane := range allLanes() {\n\t\tif car.Ht > lane.Lid { continue }\n\t\tslot := fill[lane.Name]\n\t\tgap, used, reserve := 0, 0, 0\n\t\tif slot != nil {\n\t\t\tused, reserve = slot.used, slot.reserve\n\t\t\tif slot.has { gap = neighbourGap(slot.lastHaz, car.Haz) }\n\t\t}\n\t\tif used + gap + car.Len + reserve + rampApron(car.Haz) > lane.Span { continue }\n\t\tif !massFits(lane, slot, car, deckKg[lane.Deck]) || !trimFits(lane, fill, car.Mass) { continue }\n\t\treturn lane, stationOf(lane.Span-used, car, gap), true\n\t}\n\treturn Lane{}, 0, false\n}\nEOF\ncat > chalk.go <<\'EOF\'\npackage main\nimport "encoding/json"\ntype chalkRow struct {\n\tI int `json:"i"`\n\tVerb string `json:"verb"`\n\tPlate string `json:"plate"`\n\tDeck string `json:"deck,omitempty"`\n\tLane string `json:"lane,omitempty"`\n\tStation *int `json:"station,omitempty"`\n\tOK string `json:"ok"`\n}\nfunc chalk(cars []Car, places []Placement) string {\n\tout := ""\n\tfor i, car := range cars {\n\t\tp := places[i]\n\t\tr := chalkRow{I:i+1, Verb:"stow", Plate:car.Plate, OK:"no"}\n\t\tif p.OK { r.OK="yes"; r.Deck=p.Deck; r.Lane=p.Lane; r.Station=&p.Station }\n\t\tb, _ := json.Marshal(r); out += string(b)+"\\n"\n\t}\n\treturn out\n}\nEOF\ncat > fold.go <<\'EOF\'\npackage main\nfunc fold(sheet string) (int, string) {\n\tcars, rc := parseRoll(sheet)\n\tif rc != 0 { return rc, "" }\n\tplaces := make([]Placement, len(cars))\n\tfill := map[string]*occ{}\n\tdeckKg := map[string]int{}\n\tfor _, car := range arrange(cars) {\n\t\tlane, station, ok := pickLane(car, fill, deckKg)\n\t\tif !ok { continue }\n\t\tslot := fill[lane.Name]\n\t\tif slot == nil { slot=&occ{}; fill[lane.Name]=slot }\n\t\tgap := 0\n\t\tif slot.has { gap=neighbourGap(slot.lastHaz, car.Haz) }\n\t\tslot.used += gap + car.Len\n\t\tslot.reserve += rampApron(car.Haz)\n\t\tslot.mass += car.Mass\n\t\tslot.lastHaz = car.Haz\n\t\tslot.has = true\n\t\tdeckKg[lane.Deck] += car.Mass\n\t\tplaces[car.Index] = Placement{OK:true, Deck:lane.Deck, Lane:lane.Name, Station:station}\n\t}\n\treturn 0, chalk(cars, places)\n}\nEOF\nsed -i \'s/^go .*/go 1.18/\' go.mod\ngofmt -w *.go\ngo test ./... && make install\n'] mi