[163.219814, "o", "W,H=160,120\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.219921, "o", "fourcc=cv2.VideoWriter_fourcc(*'mp4v')\r\n\u001b[?2004l\r"]
[163.220025, "o", "\u001b[?2004h> def make(name, paths):\r\n"]
[163.220051, "o", "\u001b[?2004l\r"]
[163.220149, "o", "\u001b[?2004h"]
[163.220178, "o", ">  n=max(len(p) for p in paths)\r\n\u001b[?2004l\r"]
[163.220293, "o", "\u001b[?2004h"]
[163.220327, "o", "> "]
[163.220452, "o", " out=cv2.VideoWriter('/tmp/census-tests/'+name+'.mp4',fourcc,12,(W,H))\r\n\u001b[?2004l\r"]
[163.220543, "o", "\u001b[?2004h"]
[163.220584, "o", ">  for f in range(n):\r\n\u001b[?2004l\r"]
[163.220693, "o", "\u001b[?2004h> "]
[163.221029, "o", "  im=np.full((H,W,3),(45,38,36),np.uint8)\r\n\u001b[?2004l\r\u001b[?2004h>   # mild fixed yard texture\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.221129, "o", "  for y in range(H): im[y,:,0] += y//12\r\n\u001b[?2004l\r"]
[163.221213, "o", "\u001b[?2004h>   for p in paths:\r\n\u001b[?2004l\r"]
[163.221331, "o", "\u001b[?2004h> "]
[163.221363, "o", "   item=p[f] if f<len(p) else None\r\n\u001b[?2004l\r"]
[163.221464, "o", "\u001b[?2004h> "]
[163.221493, "o", "   if item is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.221515, "o", "> "]
[163.221749, "o", "    x,y,c=item; cv2.circle(im,(int(x),int(y)),9,c,-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.221868, "o", "  out.write(im)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.221938, "o", " out.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.222034, "o", "def line(x,y0,y1,n,c):\r\n\u001b[?2004l\r"]
[163.222095, "o", "\u001b[?2004h> "]
[163.222263, "o", " return [(x,y0+(y1-y0)*i/(n-1),c) for i in range(n)]\r\n\u001b[?2004l\r"]
[163.22235, "o", "\u001b[?2004h> "]
[163.222415, "o", "# one down, one up: only down\r\n\u001b[?2004l\r"]
[163.222472, "o", "\u001b[?2004h> "]
[163.222847, "o", "make('direction',[line(40,20,105,36,(30,180,220)),line(110,105,20,36,(200,150,30))])\r\n\u001b[?2004l\r"]
[163.223014, "o", "\u001b[?2004h> "]
[163.22317, "o", "# downward, linger on scan, reverse above, then eventually finish: one\r\n\u001b[?2004l\r"]
[163.223303, "o", "\u001b[?2004h> "]
[163.223734, "o", "p=line(50,20,68,15)+[(50,70,(40,200,210))]*18+line(50,68,35,10)+line(50,35,105,24)\r\n\u001b[?2004l\r"]
[163.223947, "o", "\u001b[?2004h> "]
[163.223988, "o", "make('linger_return',[p])\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.224007, "o", "> "]
[163.224161, "o", "# three same-looking bodies concurrently\r\n\u001b[?2004l\r"]
[163.224184, "o", "\u001b[?2004h"]
[163.2242, "o", "> "]
[163.224593, "o", "make('concurrent',[line(45,15,105,35,(50,190,220)),line(80,10,100,35,(50,190,220)),line(115,20,110,35,(50,190,220))])\r\n\u001b[?2004l\r"]
[163.224621, "o", "\u001b[?2004h> "]
[163.224866, "o", "# two bodies converge, overlap around the line, then diverge\r\n\u001b[?2004l\r"]
[163.224904, "o", "\u001b[?2004h> "]
[163.225015, "o", "p1=[]; p2=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.225038, "o", "for i in range(40):\r\n\u001b[?2004l\r"]
[163.2251, "o", "\u001b[?2004h> "]
[163.225388, "o", " y=15+90*i/39; x1=45+35*min(i,20)/20-20*max(i-20,0)/19; x2=115-35*min(i,20)/20+20*max(i-20,0)/19\r\n\u001b[?2004l\r"]
[163.225416, "o", "\u001b[?2004h> "]
[163.225628, "o", " p1.append((x1,y,(40,190,225))); p2.append((x2,y,(190,80,210)))\r\n\u001b[?2004l\r"]
[163.225712, "o", "\u001b[?2004h> "]
[163.225765, "o", "make('overlap',[p1,p2])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.225949, "o", "# crosses, exits, returns upward, then crosses down again: still one body\r\n\u001b[?2004l\r"]
[163.226026, "o", "\u001b[?2004h> "]
[163.226295, "o", "p=line(80,15,112,25,(30,180,225))+[None]*8+line(80,110,15,25,(30,180,225))+line(80,15,110,25,(30,180,225))\r\n\u001b[?2004l\r"]
[163.226369, "o", "\u001b[?2004h> "]
[163.22645, "o", "make('reentry',[p])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[163.233864, "o", "\u001b[?2004hroot@50b6c2160156:/app# "]
[163.234041, "o", "python3 /tmp/census-tests/make.py\r\n\u001b[?2004l\r"]
[163.582284, "o", "Traceback (most recent call last):\r\n"]
[163.583032, "o", "  File \u001b[35m\"/tmp/census-tests/make.py\"\u001b[0m, line \u001b[35m22\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n    p=\u001b[31mline\u001b[0m\u001b[1;31m(50,20,68,15)\u001b[0m+[(50,70,(40,200,210))]*18+line(50,68,35,10)+line(50,35,105,24)\r\n      \u001b[31m~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^\u001b[0m\r\n\u001b[1;35mTypeError\u001b[0m: \u001b[35mline() missing 1 required positional argument: 'c'\u001b[0m\r\n"]
