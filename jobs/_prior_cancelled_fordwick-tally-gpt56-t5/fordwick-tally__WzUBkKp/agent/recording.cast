[30.213513, "o", "\u001b[?2004hroot@50b6c2160156:/app# "]
[114.793183, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef background_of(frames):\n    \"\"\"A static-background estimate made from the complete recording.\"\"\"\n    return np.median(np.stack(frames, axis=0), axis=0).astype(np.uint8)\n\n\ndef foreground(frame, background):\n    d = cv2.absdiff(frame, background)\n    mask = (np.max(d, axis=2) >= 16).astype(np.uint8) * 255\n    k = np.ones((3, 3), np.uint8)\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, k)\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k)\n    return mask\n\n\ndef components(frame, background):\n    mask = foreground(frame, background)\n    n, labels, stats, cents = cv2.connectedComponentsWithStats(mask, 8)\n    out = []\n    for i in range(1, n):\n        x, y, w, h, area = (int(v) for v in stats[i])\n        if area < 35 or w < 3 or h < 3:\n            continue\n        pix = frame[labels == i]\n        colour = np.median(pix, axis=0).astype(float) if len(pix) else np.zeros(3)\n        out.append({\n            \"x\": float(cents[i, 0]), \"y\": float(cents[i, 1]),\n            \"box\": (x, y, w, h), \"area\": float(area), \"colour\": colour,\n        })\n    return out\nPY\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport math\nimport numpy as np\n\nLINE_Y = 70.0\nMARGIN = 2.0\n\n\nclass Track:\n    def __init__(self, det, frame_no):\n        self.x, self.y = det[\"x\"], det[\"y\"]\n        self.vx = self.vy = 0.0\n        self.colour = det[\"colour\"].copy()\n        self.area = det[\"area\"]\n        self.last = frame_no\n        self.missed = 0\n        self.age = 1\n        self.seen_above = self.y < LINE_Y - MARGIN\n        self.counted = False\n\n    def prediction(self, frame_no):\n        dt = max(1, frame_no - self.last)\n        return self.x + self.vx * dt, self.y + self.vy * dt\n\n    def advance_hidden(self):\n        self.x += self.vx\n        self.y += self.vy\n        self.missed += 1\n\n    def update(self, det, frame_no):\n        dt = max(1, frame_no - self.last)\n        ox, oy = self.x, self.y\n        nvx, nvy = (det[\"x\"] - ox) / dt, (det[\"y\"] - oy) / dt\n        if self.age < 3:\n            self.vx, self.vy = nvx, nvy\n        else:\n            self.vx = .45 * self.vx + .55 * nvx\n            self.vy = .45 * self.vy + .55 * nvy\n        self.x, self.y = det[\"x\"], det[\"y\"]\n        self.last = frame_no\n        self.missed = 0\n        self.age += 1\n        self.area = .8 * self.area + .2 * det[\"area\"]\n        self.colour = .8 * self.colour + .2 * det[\"colour\"]\n        if self.y < LINE_Y - MARGIN:\n            self.seen_above = True\n        if self.seen_above and not self.counted and self.y > LINE_Y + MARGIN:\n            self.counted = True\n\n\ndef _colour_distance(a, b):\n    return float(np.linalg.norm(a.astype(float) - b.astype(float)))\n\n\ndef _inside_prediction(track, det, frame_no):\n    px, py = track.prediction(frame_no)\n    x, y, w, h = det[\"box\"]\n    pad = 5 + min(track.missed, 8) * 2\n    return x - pad <= px <= x + w + pad and y - pad <= py <= y + h + pad\n\n\ndef track_all(detections):\n    tracks = []\n    typical = None\n    for fi, dets in enumerate(detections):\n        clean_areas = [d[\"area\"] for d in dets if d[\"area\"] >= 80]\n        if clean_areas:\n            q = float(np.percentile(clean_areas, 35))\n            typical = q if typical is None else .9 * typical + .1 * q\n\n        active = [i for i, t in enumerate(tracks) if t.missed <= 24]\n        hidden = set()\n        merged_dets = set()\n        # A connected silhouette containing predictions for multiple established\n        # tracks is an occlusion, not a new single body.\n        for j, d in enumerate(dets):\n            cand = [i for i in active if tracks[i].age >= 2 and _inside_prediction(tracks[i], d, fi)]\n            area_merge = typical is not None and d[\"area\"] > 1.32 * typical\n            close_merge = len(cand) >= 2 and any(\n                math.hypot(tracks[a].x-tracks[b].x, tracks[a].y-tracks[b].y) < 28\n                for p,a in enumerate(cand) for b in cand[p+1:])\n            if len(cand) >= 2 and (area_merge or close_merge):\n                merged_dets.add(j)\n          "]
[114.793348, "i", "      hidden.update(cand)\n\n        # Globally greedy assignment gives stable results for small yard scenes.\n        pairs = []\n        for i in active:\n            if i in hidden:\n                continue\n            t = tracks[i]\n            px, py = t.prediction(fi)\n            for j, d in enumerate(dets):\n                if j in merged_dets:\n                    continue\n                dist = math.hypot(d[\"x\"] - px, d[\"y\"] - py)\n                colour = _colour_distance(t.colour, d[\"colour\"])\n                limit = 15 + 4 * min(t.missed, 10)\n                if dist <= limit and (colour <= 90 or dist <= 8):\n                    pairs.append((dist + .10 * colour + 1.5 * t.missed, i, j))\n        used_t, used_d = set(), set()\n        for _, i, j in sorted(pairs):\n            if i in used_t or j in used_d:\n                continue\n            tracks[i].update(dets[j], fi)\n            used_t.add(i); used_d.add(j)\n\n        for i in active:\n            if i not in used_t:\n                tracks[i].advance_hidden()\n        for j, d in enumerate(dets):\n            if j not in used_d and j not in merged_dets:\n                tracks.append(Track(d, fi))\n\n    return sum(1 for t in tracks if t.counted)\n\n\ndef fold_gate(n):\n    return int(n)\nPY\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport os\nimport cv2\nimport toml\n\nfrom blot import background_of, components\nfrom tether import fold_gate, track_all\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('bad frame')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('clip has no readable frames')\n    bg = background_of(frames)\n    detections = [components(frame, bg) for frame in frames]\n    return fold_gate(track_all(detections))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    tmp = SHEET.with_suffix('.tmp')\n    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    os.replace(tmp, SHEET)\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    try:\n        SHEET.unlink(missing_ok=True)\n        if len(sys.argv) != 2:\n            return 2\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n        return 0\n    except Exception as exc:\n        SHEET.unlink(missing_ok=True)\n        print('mill:', exc, file=sys.stderr)\n        return 1\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo rc=$rc; cat /app/inkwell/sheet.toml\n"]
