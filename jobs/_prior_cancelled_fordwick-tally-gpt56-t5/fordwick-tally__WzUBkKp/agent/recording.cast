[114.812619, "o", "\u001b[?2004h> "]
[114.812729, "o", "        if clean_areas:\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.81282, "o", "> "]
[114.812947, "o", "            q = float(np.percentile(clean_areas, 35))\r\n\u001b[?2004l\r"]
[114.813046, "o", "\u001b[?2004h> "]
[114.813206, "o", "            typical = q if typical is None else .9 * typical + .1 * q\r\n\u001b[?2004l\r"]
[114.813293, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.813489, "o", "        active = [i for i, t in enumerate(tracks) if t.missed <= 24]\r\n\u001b[?2004l\r"]
[114.813555, "o", "\u001b[?2004h> "]
[114.813629, "o", "        hidden = set()\r\n\u001b[?2004l\r"]
[114.813719, "o", "\u001b[?2004h> "]
[114.8138, "o", "        merged_dets = set()\r\n\u001b[?2004l\r"]
[114.813883, "o", "\u001b[?2004h> "]
[114.814046, "o", "        # A connected silhouette containing predictions for multiple established\r\n\u001b[?2004l\r"]
[114.81412, "o", "\u001b[?2004h> "]
[114.814275, "o", "        # tracks is an occlusion, not a new single body.\r\n\u001b[?2004l\r"]
[114.814368, "o", "\u001b[?2004h> "]
[114.81448, "o", "        for j, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[114.814553, "o", "\u001b[?2004h"]
[114.814631, "o", "> "]
[114.814875, "o", "            cand = [i for i in active if tracks[i].age >= 2 and _inside_prediction(tracks[i], d, fi)]\r\n\u001b[?2004l\r"]
[114.814968, "o", "\u001b[?2004h> "]
[114.815211, "o", "            area_merge = typical is not None and d[\"area\"] > 1.32 * typical\r\n\u001b[?2004l\r"]
[114.815285, "o", "\u001b[?2004h> "]
[114.815466, "o", "            close_merge = len(cand) >= 2 and any(\r\n\u001b[?2004l\r"]
[114.815542, "o", "\u001b[?2004h> "]
[114.815879, "o", "                math.hypot(tracks[a].x-tracks[b].x, tracks[a].y-tracks[b].y) < 28\r\n\u001b[?2004l\r"]
[114.816003, "o", "\u001b[?2004h> "]
[114.816147, "o", "                for p,a in enumerate(cand) for b in cand[p+1:])\r\n\u001b[?2004l\r"]
[114.816266, "o", "\u001b[?2004h> "]
[114.816421, "o", "            if len(cand) >= 2 and (area_merge or close_merge):\r\n\u001b[?2004l\r"]
[114.816545, "o", "\u001b[?2004h> "]
[114.816646, "o", "                merged_dets.add(j)\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.81673, "o", "> "]
[114.816836, "o", "                hidden.update(cand)\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.816917, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.817181, "o", "        # Globally greedy assignment gives stable results for small yard scenes.\r\n\u001b[?2004l\r"]
[114.817274, "o", "\u001b[?2004h>         pairs = []\r\n\u001b[?2004l\r"]
[114.817341, "o", "\u001b[?2004h> "]
[114.817419, "o", "        for i in active:\r\n\u001b[?2004l\r"]
[114.81752, "o", "\u001b[?2004h"]
[114.817608, "o", ">             if i in hidden:\r\n\u001b[?2004l\r"]
[114.817704, "o", "\u001b[?2004h> "]
[114.817819, "o", "                continue\r\n\u001b[?2004l\r"]
[114.8179, "o", "\u001b[?2004h>             t = tracks[i]\r\n\u001b[?2004l\r"]
[114.817967, "o", "\u001b[?2004h"]
[114.818036, "o", "> "]
[114.81812, "o", "            px, py = t.prediction(fi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.818232, "o", "            for j, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[114.818331, "o", "\u001b[?2004h> "]
[114.818403, "o", "                if j in merged_dets:\r\n\u001b[?2004l\r"]
[114.818475, "o", "\u001b[?2004h> "]
[114.818554, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.81874, "o", "                dist = math.hypot(d[\"x\"] - px, d[\"y\"] - py)\r\n\u001b[?2004l\r"]
[114.818865, "o", "\u001b[?2004h> "]
[114.819061, "o", "                colour = _colour_distance(t.colour, d[\"colour\"])\r\n\u001b[?2004l\r"]
[114.81914, "o", "\u001b[?2004h> "]
[114.819288, "o", "                limit = 15 + 4 * min(t.missed, 10)\r\n\u001b[?2004l\r"]
[114.819408, "o", "\u001b[?2004h> "]
[114.819618, "o", "                if dist <= limit and (colour <= 90 or dist <= 8):\r\n\u001b[?2004l\r"]
[114.819708, "o", "\u001b[?2004h> "]
[114.82001, "o", "                    pairs.append((dist + .10 * colour + 1.5 * t.missed, i, j))\r\n\u001b[?2004l\r"]
[114.820073, "o", "\u001b[?2004h> "]
[114.820198, "o", "        used_t, used_d = set(), set()\r\n\u001b[?2004l\r"]
[114.820256, "o", "\u001b[?2004h> "]
[114.82038, "o", "        for _, i, j in sorted(pairs):\r\n\u001b[?2004l\r"]
[114.820437, "o", "\u001b[?2004h> "]
[114.820577, "o", "            if i in used_t or j in used_d:\r\n\u001b[?2004l\r"]
[114.820633, "o", "\u001b[?2004h> "]
[114.820715, "o", "                continue\r\n\u001b[?2004l\r"]
[114.820782, "o", "\u001b[?2004h> "]
[114.820912, "o", "            tracks[i].update(dets[j], fi)\r\n\u001b[?2004l\r"]
[114.820976, "o", "\u001b[?2004h> "]
[114.821052, "o", "            used_t.add(i); used_d.add(j)\r\n\u001b[?2004l\r"]
[114.821138, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[114.821164, "o", "\u001b[?2004h> "]
[114.82125, "o", "        for i in active:\r\n\u001b[?2004l\r"]
[114.821276, "o", "\u001b[?2004h> "]
[114.821484, "o", "            if i not in used_t:\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.821522, "o", "> "]
[114.821797, "o", "                tracks[i].advance_hidden()\r\n"]
[114.822007, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[114.822062, "o", "        for j, d in enumerate(dets):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.822262, "o", "            if j not in used_d and j not in merged_dets:\r\n\u001b[?2004l\r"]
[114.822294, "o", "\u001b[?2004h"]
[114.822325, "o", "> "]
[114.822554, "o", "                tracks.append(Track(d, fi))\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.822918, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.82301, "o", "    return sum(1 for t in tracks if t.counted)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[114.823325, "o", "\u001b[?2004h> def fold_gate(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.823399, "o", "    return int(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
