[163.219076, "i", "mkdir -p /tmp/census-tests; cat > /tmp/census-tests/make.py <<'PY'\nimport cv2, numpy as np, os\nW,H=160,120\nfourcc=cv2.VideoWriter_fourcc(*'mp4v')\ndef make(name, paths):\n n=max(len(p) for p in paths)\n out=cv2.VideoWriter('/tmp/census-tests/'+name+'.mp4',fourcc,12,(W,H))\n for f in range(n):\n  im=np.full((H,W,3),(45,38,36),np.uint8)\n  # mild fixed yard texture\n  for y in range(H): im[y,:,0] += y//12\n  for p in paths:\n   item=p[f] if f<len(p) else None\n   if item is not None:\n    x,y,c=item; cv2.circle(im,(int(x),int(y)),9,c,-1)\n  out.write(im)\n out.release()\ndef line(x,y0,y1,n,c):\n return [(x,y0+(y1-y0)*i/(n-1),c) for i in range(n)]\n# one down, one up: only down\nmake('direction',[line(40,20,105,36,(30,180,220)),line(110,105,20,36,(200,150,30))])\n# downward, linger on scan, reverse above, then eventually finish: one\np=line(50,20,68,15)+[(50,70,(40,200,210))]*18+line(50,68,35,10)+line(50,35,105,24)\nmake('linger_return',[p])\n# three same-looking bodies concurrently\nmake('concurrent',[line(45,15,105,35,(50,190,220)),line(80,10,100,35,(50,190,220)),line(115,20,110,35,(50,190,220))])\n# two bodies converge, overlap around the line, then diverge\np1=[]; p2=[]\nfor i in range(40):\n y=15+90*i/39; x1=45+35*min(i,20)/20-20*max(i-20,0)/19; x2=115-35*min(i,20)/20+20*max(i-20,0)/19\n p1.append((x1,y,(40,190,225))); p2.append((x2,y,(190,80,210)))\nmake('overlap',[p1,p2])\n# crosses, exits, returns upward, then crosses down again: still one body\np=line(80,15,112,25,(30,180,225))+[None]*8+line(80,110,15,25,(30,180,225))+line(80,15,110,25,(30,180,225))\nmake('reentry',[p])\nPY\npython3 /tmp/census-tests/make.py\nfor x in direction linger_return concurrent overlap reentry; do python3 /app/varnish/mill.pyc /tmp/census-tests/$x.mp4; printf '%-15s ' \"$x\"; cat /app/inkwell/sheet.toml; done\n"]
[163.219493, "o", "mkdir -p /tmp/census-tests; cat > /tmp/census-tests/make.py <<'PY'\r\n\u001b[?2004l\r"]
[163.219613, "o", "\u001b[?2004h> "]
