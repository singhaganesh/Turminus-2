[29.417146, "i", "python3 - <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; cap=cv2.VideoCapture(p); frames=[]\nwhile True:\n ok,f=cap.read()\n if not ok: break\n frames.append(f)\ncap.release()\nprint('n',len(frames))\nif not frames: raise SystemExit\nA=np.stack(frames)\nprint('shape',A.shape,'channel ranges',[(int(A[...,c].min()),int(A[...,c].max())) for c in range(3)])\nfor i in np.linspace(0,len(A)-1,min(12,len(A)),dtype=int):\n u=np.unique(A[i].reshape(-1,3),axis=0)\n print(i,'unique',len(u),'mean',np.round(A[i].mean((0,1)),1),'corners',A[i,0,0].tolist(),A[i,-1,-1].tolist())\nmed=np.median(A,axis=0).astype(np.uint8)\nfor i in range(len(A)):\n d=np.max(cv2.absdiff(A[i],med),axis=2)\n m=(d>20).astype(np.uint8)*255\n n,lab,st,cen=cv2.connectedComponentsWithStats(m,8)\n comps=[(int(x),int(y),int(w),int(h),int(z),tuple(np.round(c,1))) for (x,y,w,h,z),c in zip(st[1:],cen[1:]) if z>=8]\n if comps and (i%6==0 or any(y<=70<y+h for x,y,w,h,z,c in comps)):\n  print('F',i,comps)\nPY\n"]
