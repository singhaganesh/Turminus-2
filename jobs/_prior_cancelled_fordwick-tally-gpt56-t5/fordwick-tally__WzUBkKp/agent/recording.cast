[114.827403, "o", "\u001b[?2004hroot@50b6c2160156:/app# "]
[114.827619, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[114.827704, "o", "\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.827851, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.827955, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.828065, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.828164, "o", "import cv2\r\n\u001b[?2004l\r\u001b[?2004h> import toml\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[114.82827, "o", "\u001b[?2004h"]
[114.828352, "o", "> "]
[114.828442, "o", "from blot import background_of, components\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.828578, "o", "from tether import fold_gate, track_all\r\n\u001b[?2004l\r"]
[114.82868, "o", "\u001b[?2004h"]
[114.828756, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.828842, "o", "SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r"]
[114.828948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[114.829034, "o", "\u001b[?2004h> "]
[114.829111, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r"]
[114.829268, "o", "\u001b[?2004h>     cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r"]
[114.829346, "o", "\u001b[?2004h> "]
[114.829447, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r"]
[114.829536, "o", "\u001b[?2004h> "]
[114.829622, "o", "        cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.829743, "o", "        raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[114.829854, "o", "\u001b[?2004h> "]
[114.829935, "o", "    frames = []\r\n\u001b[?2004l\r"]
[114.829962, "o", "\u001b[?2004h"]
[114.82998, "o", "> "]
[114.83012, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.8302, "o", "        ok, frame = cap.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.830318, "o", "        if not ok:\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r"]
[114.830421, "o", "\u001b[?2004h> "]
[114.830548, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r"]
[114.830668, "o", "\u001b[?2004h"]
[114.830767, "o", "> "]
[114.830877, "o", "            cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.831045, "o", "            raise ValueError('bad frame')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.831137, "o", "        frames.append(frame)\r\n\u001b[?2004l\r"]
[114.831181, "o", "\u001b[?2004h>     cap.release()\r\n\u001b[?2004l\r"]
[114.831204, "o", "\u001b[?2004h> "]
[114.831423, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.831568, "o", "        raise OSError('clip has no readable frames')\r\n\u001b[?2004l\r"]
[114.831703, "o", "\u001b[?2004h> "]
[114.831759, "o", "    bg = background_of(frames)\r\n\u001b[?2004l\r"]
[114.832921, "o", "\u001b[?2004h>     detections = [components(frame, bg) for frame in frames]\r\n\u001b[?2004l\r\u001b[?2004h>     return fold_gate(track_all(detections))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[114.832975, "o", "\u001b[?2004h> "]
[114.83323, "o", "    tmp = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.833436, "o", "    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r"]
[114.833555, "o", "\u001b[?2004h"]
[114.833591, "o", ">     os.replace(tmp, SHEET)\r\n\u001b[?2004l\r"]
[114.83373, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[114.835673, "o", "\u001b[?2004hroot@50b6c2160156:/app# "]
[114.835889, "o", "cat > /app/spanwell.py <<'PY'\r\n"]
[114.836071, "o", "\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[114.836364, "o", "\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.836481, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[114.836514, "o", "\u001b[?2004h> "]
[114.836539, "o", "\r\n\u001b[?2004l\r"]
[114.836824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.836925, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.836966, "o", "    try:\r\n"]
[114.837335, "o", "\u001b[?2004l\r\u001b[?2004h>         SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.837385, "o", ">         if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.837495, "o", "            return 2\r\n\u001b[?2004l\r"]
[114.837616, "o", "\u001b[?2004h> "]
[114.837702, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.837832, "o", "> "]
[114.838041, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r\u001b[?2004h>         return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.838168, "o", "    except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.838329, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[114.838528, "o", "\u001b[?2004h>         print('mill:', exc, file=sys.stderr)\r\n\u001b[?2004l\r"]
[114.838762, "o", "\u001b[?2004h>         return 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.838954, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[114.839194, "o", "\u001b[?2004h>     raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
