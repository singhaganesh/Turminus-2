def update(self, det, frame_no):\n        dt = max(1, frame_no - self.last)\n        ox, oy = self.x, self.y\n        nvx, nvy = (det["x"] - ox) / dt, (det["y"] - oy) / dt\n        if self.age < 3:\n            self.vx, self.vy = nvx, nvy\n        else:\n            self.vx = .45 * self.vx + .55 * nvx\n            self.vy = .45 * self.vy + .55 * nvy\n        self.x, self.y = det["x"], det["y"]\n        self.last = frame_no\n        self.missed = 0\n        self.age += 1\n        self.area = .8 * self.area + .2 * det["area"]\n        self.colour = .8 * self.colour + .2 * det["colour"]\n        if self.y < LINE_Y - MARGIN:\n            self.seen_above = True\n        if self.seen_above and not self.counted and self.y > LINE_Y + MARGIN:\n            self.counted = True\n\n\ndef _colour_distance(a, b):\n    return float(np.linalg.norm(a.astype(float) - b.astype(float)))\n\n\ndef _inside_prediction(track, det, frame_no):\n    px, py = track.prediction(frame_no)\n    x, y, w, h = det["box"]\n    pad = 5 + min(track.missed, 8) * 2\n    return x - pad <= px <= x + w + pad and y - pad <= py <= y + h + pad\n\n\ndef track_all(detections):\n    tracks = []\n    typical = None\n    for fi, dets in enumerate(detections):\n        clean_areas = [d["area"] for d in dets if d["area"] >= 80]\n        if clean_areas:\n            q = float(np.percentile(clean_areas, 35))\n            typical = q if typical is None else .9 * typical + .1 * q\n\n        active = [i for i, t in enumerate(tracks) if t.missed <= 24]\n        hidden = set()\n        merged_dets = set()\n        # A connected silhouette containing predictions for multiple established\n        # tracks is an occlusion, not a new single body.\n        for j, d in enumerate(dets):\n            cand = [i for i in active if tracks[i].age >= 2 and _inside_prediction(tracks[i], d, fi)]\n            area_merge = typical is not None and d["area"] > 1.32 * typical\n            close_merge = len(cand) >= 2 and any(\n                mat