rame_no):\n        dt = max(1, frame_no - self.last_seen)\n        return self.pos + self.velocity * dt\n\n    def observe(self, detection, frame_no):\n        dt = max(1, frame_no - self.last_seen)\n        displacement = (detection["pos"] - self.pos) / dt\n        if self.hits == 1:\n            self.velocity = displacement\n        else:\n            self.velocity = 0.55 * self.velocity + 0.45 * displacement\n        self.pos = detection["pos"].copy()\n        self.color = 0.8 * self.color + 0.2 * detection["color"]\n        self.area = 0.8 * self.area + 0.2 * detection["area"]\n        self.last_seen = frame_no\n        self.missing = 0\n        self.hits += 1\n        crossed = False\n        if self.pos[1] < LINE_Y:\n            self.above = True\n        elif self.above and not self.counted and self.hits >= 2:\n            self.counted = True\n            crossed = True\n        return crossed\n\n\nclass CentroidTracker:\n    def __init__(self):\n        self.tracks = []\n        self.total = 0\n\n    @staticmethod\n    def _in_box(point, box, margin=7):\n        x, y, w, h = box\n        return x - margin <= point[0] <= x + w + margin and y - margin <= point[1] <= y + h + margin\n\n    def update(self, detections, frame_no):\n        active = [i for i, t in enumerate(self.tracks) if t.missing <= 24]\n        predictions = {i: self.tracks[i].predicted(frame_no) for i in active}\n        used_tracks, used_dets = set(), set()\n\n        # If several established trajectories enter one silhouette, propagate\n        # each independently until separate observations return. This avoids\n        # collapsing identities during overlap or shading.\n        for j, det in enumerate(detections):\n            enclosed = [i for i in active if self.tracks[i].hits >= 2 and\n                        np.linalg.norm(predictions[i] - det["pos"]) < 35 and\n                        self._in_box(predictions[i], det["box"])]\n            if len(enclosed) >= 2:\n                used_dets.add(j)\n                for i in enclosed:\n                    used_tracks.add(i)\n                    self.tracks[i].missing += 1\n\n        candidates = []\n        for i in active:\n            if i in used_tracks:\n                continue\n            tr = self.tracks[i]\n            for j, det in enumerate(detections):\n                if j in used_dets:\n                    continue\n                distance = float(np.linalg.norm(predictions[i] - det["pos"]))\n                color_distance = float(np.linalg.norm(tr.color - det["color"]))\n                limit = 24.0 + min(18.0, 2.0 * tr.missing)\n                if distance <= limit and (color_distance <= 95 or distance <= 10):\n                    candidates.append((distance + 0.035 * color_distance, i, j))\n\n        for _, i, j in sorted(candidates):\n            if i in used_tracks or j in used_dets:\n                continue\n            used_tracks.add(i)\n            used_dets.add(j)\n            if self.tracks[i].observe(detections[j], frame_no):\n                self.total += 1\n\n        for i in active:\n            if i not in used_tracks:\n                self.tracks[i].missing += 1\n\n        for j, det in enumerate(detections):\n            if j not in used_dets:\n                self.tracks.append(Track(det, frame_no))\n\n\ndef count_crossings(all_detections):\n    tracker = CentroidTracker()\n    for frame_no, detections in enumerate(all_detections):\n        tracker.update(detections, frame_no)\n    return tracker.total\nPY\n\ncat > /app/spout.py <<\'PY\'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport os\nimport cv2\nimport toml\n\nfrom blot import components, foreground_masks\nfrom tether import count_crossings\n\nSHEET = Path(\'/app/inkwell/sheet.toml\')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError(\'cannot open clip\')\n    frames = []\n    while True:\n      