[61.572088, "i", "printf '%s\\n' '--- RibChan ---'; cat /app/hitchbay/RibChan.java; printf '%s\\n' '--- StirRun ---'; cat /app/hitchbay/StirRun.java; printf '%s\\n' '--- StowRun ---'; cat /app/hitchbay/StowRun.java; printf '%s\\n' '--- YankRun ---'; cat /app/hitchbay/YankRun.java\n"]
