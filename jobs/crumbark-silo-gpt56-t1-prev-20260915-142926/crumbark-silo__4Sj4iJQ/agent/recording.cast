[100.041339, "i", "cat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\npublic class HueWalk {\n    static final int ROW = 48;\n\n    public static int orb_n(Path blobPath, Path pinPath, Path wakePath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean gap = (pins.length % ROW) != 0;\n\n        for (int pos = 0; pos + ROW <= pins.length; pos += ROW) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, ROW);\n            byte[] magic = new byte[4];\n            row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16];\n            row.get(id);\n\n            byte[] payload = payload(blob, magic, off, len);\n            if (payload == null || Crc.of(payload) != crc || !Arrays.equals(id, idOf(payload))) {\n                gap = true;\n            } else {\n                held.add(hex(id));\n            }\n        }\n\n        String json = \"{\\\"held\\\":\" + arr(held)\n                + \",\\\"note\\\":\\\"\" + (gap ? \"gap\" : \"ok\")\n                + \"\\\",\\\"kind\\\":\\\"\" + (gap ? \"void\" : \"live\") + \"\\\"}\";\n        Files.writeString(wakePath, json);\n        return gap ? 1 : 0;\n    }\n\n    static byte[] payload(byte[] blob, byte[] magic, long off, int len) {\n        if (!Arrays.equals(magic, new byte[] {'P','N','0','1'}) || off < 0 || len < 0) return null;\n        long start = off + 4L;\n        long end = start + (long) len;\n        if (start < 4L || end < start || end > blob.length || off > Integer.MAX_VALUE) return null;\n        int o = (int) off;\n        if (ByteBuffer.wrap(blob, o, 4).getInt() != len) return null;\n        return Arrays.copyOfRange(blob, o + 4, (int) end);\n    }\n\n    static byte[] idOf(byte[] payload) throws Exception {\n        return Arrays.copyOf(MessageDigest.getInstance(\"SHA-256\").digest(payload), 16);\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 255));\n        return sb.toString();\n    }\n\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < held.size(); i++) {\n            if (i != 0) sb.append(',');\n            sb.append('\\\"').append(held.get(i)).append('\\\"');\n        }\n        return sb.append(']').toString();\n    }\n\n    public static void main(String[] args) throws Exception {\n        Path silo = Path.of(\"/app/silo\");\n        System.exit(orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\")));\n    }\n}\nEOF\n\ncat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.Arrays;\n\npublic class MistSpan {\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        Path pp = silo.resolve(\"pin.bin\");\n        Path bp = silo.resolve(\"blob.bin\");\n        byte[] pins = Files.exists(pp) ? Files.readAllBytes(pp) : new byte[0];\n        byte[] blob = Files.exists(bp) ? Files.readAllBytes(bp) : new byte[0];\n\n        for (int pos = 0; pos + 48 <= pins.length; pos += 48) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, 48);\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            if (!Arrays.equals(id, wanted)) continue;\n            byte[] payload = HueWalk.payload(blob, magic, off, len);\n            if (payload != null && Crc.of(payload) == crc\n                    && Arrays.equals(id, Arrays.copyOf(MessageDigest.getInstance(\"SHA-256\").digest(payload), "]
[100.041632, "i", "16))) {\n                return payload;\n            }\n        }\n        return null;\n    }\n}\nEOF\n\ncat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class YankRun {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1 || !args[0].matches(\"[0-9a-f]{32}\")) System.exit(2);\n        byte[] got = MistSpan.tint_k(Paths.get(\"/app/silo\"), hex(args[0]));\n        if (got == null) {\n            Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), new byte[0]);\n            System.exit(1);\n        }\n        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\n        System.out.write(got);\n    }\n\n    static byte[] hex(String s) {\n        byte[] out = new byte[16];\n        for (int i = 0; i < 16; i++)\n            out[i] = (byte)Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        return out;\n    }\n}\nEOF\n/app/bin/crumbark tamp\n"]
