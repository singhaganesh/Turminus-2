[61.95695, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/recipit/LoomCue.java')\ns=p.read_text().replace('steps.sort(Comparator.comparingInt(x -> x.compute));','steps.sort(Comparator.comparingInt(x -> x.durable));')\np.write_text(s)\n\np=Path('/app/hitchbay/StowRun.java')\ns=p.read_text()\nstart=s.index('    static byte[] idOf(byte[] payload) throws Exception {')\nend=s.index('\\n    public static void main', start)\nmethod='''    static byte[] idOf(byte[] payload) throws Exception {\n        MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\n        byte[] digest = md.digest(payload);\n        byte[] id = new byte[16];\n        System.arraycopy(digest, 0, id, 0, id.length);\n        return id;\n    }\n'''\np.write_text(s[:start]+method+s[end:])\nPY\n"]
