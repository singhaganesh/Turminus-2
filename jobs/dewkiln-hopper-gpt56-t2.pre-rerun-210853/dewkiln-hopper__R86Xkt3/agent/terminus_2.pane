    10	fn main() {
    11	    let mut args = std::env::args();
    12	    let _ = args.next();
    13	    let cmd = args.next().unwrap_or_default();
    14	    if cmd != "clasp" {
    15	        eprintln!("usage: dewkiln clasp");
    16	        std::process::exit(2);
    17	    }
    18	    let _ = std::fs::remove_file("/app/bloturn/GUARD");
    19	    let code = match fold::fold() {
    20	        Ok((packed, taken)) => {
    21	            let mut dump = packed.clone();
    22	            skip::skip(&mut dump);
    23	            let _ = floor::floor(taken);
    24	            gait::gait(taken, &packed)
    25	        }
    26	        Err(c) => c,
    27	    };
    28	    std::process::exit(code);
    29	}
===== /app/hopcue/rim.rs =====
     1	pub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {
     2	    b.into_iter().filter(|(d, _)| *d < a).collect()
     3	}
===== /app/millrib/gait.rs =====
     1	use std::fs;
     2	
     3	fn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {
     4	    let tpl = fs::read_to_string("/app/millrib/sheet.tpl").map_err(|_| 1)?;
     5	    let out = tpl
     6	        .replace("__P__", p)
     7	        .replace("__M__", &m.to_string())
     8	        .replace("__T__", &t.to_string());
     9	    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;
    10	    fs::write("/app/bloturn/check.json", out).map_err(|_| 1)?;
    11	    Ok(())
    12	}
    13	
    14	pub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {
    15	    let _ = fs::remove_file("/app/bloturn/GUARD");
    16	    if emit("ledger", a, a).is_err() {
    17	        return 1;
    18	    }
    19	    if fs::write("/app/bloturn/GUARD", "ok").is_err() {
    20	        return 1;
    21	    }
    22	    0
    23	}
===== /app/restpit/soak.rs =====
     1	use std::fs;
     2	
     3	pub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {
     4	    let _ = fs::remove_dir_all(b);
     5	    fs::create_dir_all(b).map_err(|_| 1)?;
     6	    let mut xs: Vec<(i32, String)> = a.to_vec();
     7	    xs.sort_by_key(|x| x.0);
     8	    if !xs.is_empty() {
     9	        xs.pop();
    10	    }
    11	    for (d, p) in xs {
    12	        let name = format!("d{:08}.tbl", d);
    13	        fs::copy(&p, format!("{}/{}", b, name)).map_err(|_| 1)?;
    14	    }
    15	    Ok(())
    16	}
===== /app/urncue/fold.rs =====
     1	#[path = "../hopcue/rim.rs"]
     2	mod rim;
     3	#[path = "../restpit/soak.rs"]
     4	mod soak;
     5	#[path = "../shardfold/read.rs"]
     6	mod read;
     7	
     8	use std::fs;
     9	
    10	pub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {
    11	    let wall: i32 = fs::read_to_string("/app/opstext/WALL")
    12	        .map_err(|_| 1)?
    13	        .trim()
    14	        .parse()
    15	        .map_err(|_| 1)?;
    16	    let listed = read::list("/app/daywell");
    17	    let picked = rim::rim(wall, listed);
    18	    if picked.is_empty() {
    19	        fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;
    20	        fs::write("/app/bloturn/ledger.json", "{\"taken\":0}").map_err(|_| 1)?;
    21	        let _ = fs::remove_dir_all("/app/packbay/stage");
    22	        let _ = fs::remove_dir_all("/app/packbay/latest");
    23	        fs::create_dir_all("/app/packbay/stage").ok();
    24	        fs::create_dir_all("/app/packbay/latest").ok();
    25	        return Ok((Vec::new(), 0));
    26	    }
    27	    let _ = fs::remove_dir_all("/app/packbay/stage");
    28	    fs::create_dir_all("/app/packbay/stage").map_err(|_| 1)?;
    29	    let mut packed = Vec::new();
    30	    let mut taken = 0;
    31	    for (d, p) in picked {
    32	        let name = format!("d{:08}.tbl", d);
    33	        let dest = format!("/app/packbay/stage/{}", name);
    34	        fs::copy(&p, &dest).map_err(|_| 1)?;
    35	        taken += read::nlines(&dest);
    36	        packed.push((d, dest));
    37	    }
    38	    soak::soak(&packed, "/app/packbay/latest")?;
    39	    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;
    40	    let body = format!("{{\"taken\":{}}}", taken);
    41	    fs::write("/app/bloturn/ledger.json", body).map_err(|_| 1)?;
    42	    Ok((packed, taken))
    43	}
===== /app/shardfold/read.rs =====
     1	use std::fs;
     2	
     3	pub fn list(root: &str) -> Vec<(i32, String)> {
     4	    let mut v = Vec::new();
     5	    let rd = match fs::read_dir(root) {
     6	        Ok(x) => x,
     7	        Err(_) => return v,
     8	    };
     9	    for ent in rd.flatten() {
    10	        let name = ent.file_name().to_string_lossy().into_owned();
    11	        if !name.starts_with('d') || !name.ends_with(".tbl") {
    12	            continue;
    13	        }
    14	        let mid = &name[1..name.len() - 4];
    15	        if let Ok(d) = mid.parse::<i32>() {
    16	            v.push((d, ent.path().to_string_lossy().into_owned()));
    17	        }
    18	    }
    19	    v.sort_by_key(|x| x.0);
    20	    v
    21	}
    22	
    23	pub fn nlines(path: &str) -> i32 {
    24	    match fs::read_to_string(path) {
    25	        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,
    26	        Err(_) => 0,
    27	    }
    28	}
===== /app/lidcue/skip.rs =====
     1	pub fn skip(a: &mut [(i32, String)]) {
     2	    a.sort_by(|x, y| x.1.cmp(&y.1));
     3	}
     4	
     5	pub fn width(a: &[(i32, String)]) -> usize {
     6	    a.len()
     7	}
     8	
     9	pub fn first(a: &[(i32, String)]) -> Option<i32> {
    10	    a.first().map(|x| x.0)
    11	}
===== /app/corkpit/floor.rs =====
     1	use std::fs;
     2	
     3	pub fn floor(a: i32) -> bool {
     4	    let t = match fs::read_to_string("/app/floorcue/MIN.txt") {
     5	        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),
     6	        Err(_) => 0,
     7	    };
     8	    a >= t
     9	}
