[92.572567, "o", "#[path = \"../hopcue/rim.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod rim;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../restpit/soak.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod soak;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../shardfold/read.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod read;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn reset_publication() {\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::create_dir_all(\"/app/packbay/stage\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::create_dir_all(\"/app/packbay/latest\");\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n\u001b[?2004l\r\u001b[?2004h>         .map_err(|_| 1)?.trim().parse().map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let listed = read::list(\"/app/daywell\").map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let picked = rim::rim(wall, listed);\r\n\u001b[?2004l\r\u001b[?2004h>     reset_publication();\r\n\u001b[?2004l\r\u001b[?2004h>     if picked.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let mut packed = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut taken = 0i32;\r\n\u001b[?2004l\r\u001b[?2004h>     for (day, source) in picked {\r\n\u001b[?2004l\r\u001b[?2004h>         let (_, rows) = read::read_rows(&source).map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
