[11.205939, "o", "/app\r\n--- LIST ---\r\n"]
[11.208595, "o", "dewkiln layout\r\n==============\r\n\r\nwickmill/boot.rs dispatches clasp.\r\n\r\nPipeline crates:\r\n- hopcue/\r\n- millrib/\r\n- restpit/\r\n- urncue/\r\n- shardfold/\r\n- lidcue/\r\n\r\nDay files live in /app/daywell.\r\nclasp writes /app/bloturn/ledger.json and /app/bloturn/check.json\r\nand unpacks /app/packbay/latest.\r\nFixture copies of the day files sit at /app/seed/daywell.\r\n\r\ncheck.json object:\r\n- probe (string)\r\n- matched (integer)\r\n- taken (integer)\r\n\r\nCI floor integer lives in /app/floorcue/MIN.txt.\r\n\r\nExtra daywell files still use names like d20260908.tbl and d20260914.tbl.\r\n\r\n\r\nRebuild the binary with /app/wick.sh after source edits.\r\n"]
[11.208986, "o", "--- WALL/MIN ---\r\n"]
[11.210325, "o", "20260913\r\n"]
[11.211521, "o", "15\r\n"]
[11.211688, "o", "--- TREE ---\r\n"]
[11.214898, "o", "d /app\r\nd /app/bin\r\nd /app/bloturn\r\nd /app/corkpit\r\nd /app/daywell\r\nd /app/floorcue\r\nd /app/hopcue\r\nd /app/lidcue"]
[11.214963, "o", "\r\nd /app/millrib\r\nd /app/opstext\r\nd /app/packbay\r\nd /app/packbay/latest\r\nd /app/packbay/stage\r\nd /app/restpit\r\nd /app/seed\r\nd /app/seed/daywell\r\nd /app/shardfold\r\nd /app/urncue\r\nd /app/wickmill\r\nf /app/bin/dewkiln\r\nf /app/bloturn/GUARD\r\nf /app/bloturn/check.json\r\nf /app/bloturn/ledger.json\r\nf /app/corkpit/NOTE.txt\r\nf /app/corkpit/floor.rs\r\nf /app/daywell/d20260910.tbl\r\nf /app/daywell/d20260911.tbl\r\nf /app/daywell/d20260912.tbl\r\nf /app/daywell/d20260913.tbl\r\nf /app/floorcue/MIN.txt\r\nf /app/hopcue/rim.rs\r\nf /app/lidcue/skip.rs\r\nf /app/millrib/gait.rs\r\nf /app/millrib/sheet.tpl\r\nf /app/opstext/LIST.txt\r\nf /app/opstext/SHIFT.txt\r\nf /app/opstext/WALL\r\n"]
