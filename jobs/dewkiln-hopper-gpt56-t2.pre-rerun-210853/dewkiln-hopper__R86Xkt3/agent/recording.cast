[92.511896, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/shardfold/read.rs <<'EOF'\nuse std::fs;\nuse std::io;\n\npub fn list(root: &str) -> Result<Vec<(i32, String)>, io::Error> {\n    let mut files = Vec::new();\n    for item in fs::read_dir(root)? {\n        let entry = item?;\n        if !entry.file_type()?.is_file() {\n            continue;\n        }\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|c| c.is_ascii_digit()) {\n            continue;\n        }\n        if let Ok(day) = digits.parse::<i32>() {\n            files.push((day, entry.path().to_string_lossy().into_owned()));\n        }\n    }\n    files.sort_by_key(|x| x.0);\n    Ok(files)\n}\n\npub fn read_rows(path: &str) -> Result<(String, i32), io::Error> {\n    let text = fs::read_to_string(path)?;\n    let rows = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n    Ok((text, rows))\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], root: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(root);\n    fs::create_dir_all(root).map_err(|_| 1)?;\n    let mut ordered = files.to_vec();\n    ordered.sort_by_key(|x| x.0);\n    for (day, source) in ordered {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(source, format!(\"{}/{}\", root, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\nfn reset_publication() {\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n    let _ = fs::remove_dir_all(\"/app/packbay/latest\");\n    let _ = fs::create_dir_all(\"/app/packbay/stage\");\n    let _ = fs::create_dir_all(\"/app/packbay/latest\");\n}\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?.trim().parse().map_err(|_| 1)?;\n    let listed = read::list(\"/app/daywell\").map_err(|_| 1)?;\n    let picked = rim::rim(wall, listed);\n    reset_publication();\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let mut packed = Vec::new();\n    let mut taken = 0i32;\n    for (day, source) in picked {\n        let (_, rows) = read::read_rows(&source).map_err(|_| 1)?;\n        let destination = format!(\"/app/packbay/stage/d{:08}.tbl\", day);\n        fs::copy(&source, &destination).map_err(|_| 1)?;\n        taken = taken.checked_add(rows).ok_or(1)?;\n        packed.push((day, destination));\n    }\n    if taken == 0 {\n        reset_publication();\n        return Err(1);\n    }\n\n    soak::soak(&packed, \"/app/packbay/latest\")?;\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/ledger.json\", format!(\"{{\\\"taken\\\":{}}}\", taken))\n        .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\n"]
