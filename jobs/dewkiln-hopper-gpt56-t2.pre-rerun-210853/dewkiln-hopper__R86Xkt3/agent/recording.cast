[40.30629, "i", "echo '===== shardfold/read.rs ====='; nl -ba /app/shardfold/read.rs; echo '===== lidcue/skip.rs ====='; nl -ba /app/lidcue/skip.rs; echo '===== corkpit/floor.rs ====='; nl -ba /app/corkpit/floor.rs; echo '===== wick.sh ====='; nl -ba /app/wick.sh; echo '===== sheet.tpl ====='; cat /app/millrib/sheet.tpl\n"]
[40.307703, "o", "echo '===== shardfold/read.rs ====='; nl -ba /app/shardfold/read.rs; echo '===== lidcue/skip.rs ====='; nl -ba /app/lidcue/skip.rs; echo '===== corkpit/floor.rs ====='; nl -ba /app/corkpit/floor.rs; echo '===== wick.sh ====='; nl -ba /app/wick.sh; echo '===== sheet.tpl ====='; cat /app/millrib/sheet.tpl\r\n\u001b[?2004l\r"]
[40.308102, "o", "===== shardfold/read.rs =====\r\n"]
[40.310939, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn list(root: &str) -> Vec<(i32, String)> {\r\n     4\t    let mut v = Vec::new();\r\n     5\t    let rd = match fs::read_dir(root) {\r\n     6\t        Ok(x) => x,\r\n     7\t        Err(_) => return v,\r\n     8\t    };\r\n     9\t    for ent in rd.flatten() {\r\n    10\t        let name = ent.file_name().to_string_lossy().into_owned();\r\n    11\t        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n    12\t            continue;\r\n    13\t        }\r\n    14\t        let mid = &name[1..name.len() - 4];\r\n    15\t        if let Ok(d) = mid.parse::<i32>() {\r\n    16\t            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n    17\t        }\r\n    18\t    }\r\n    19\t    v.sort_by_key(|x| x.0);\r\n    20\t    v\r\n    21\t}\r\n    22\t\r\n    23\tpub fn nlines(path: &str) -> i32 {\r\n    24\t    match fs::read_to_string(path) {\r\n    25\t        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n    26\t        Err(_) => 0,\r\n    27\t    }\r\n    28\t}\r\n===== lidcue/skip.rs =====\r\n"]
[40.311986, "o", "     1\tpub fn skip(a: &mut [(i32, String)]) {\r\n     2\t    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n     3\t}\r\n     4\t\r\n"]
[40.312076, "o", "     5\tpub fn width(a: &[(i32, String)]) -> usize {\r\n     6\t    a.len()\r\n     7\t}\r\n     8\t\r\n     9\tpub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    10\t    a.first().map(|x| x.0)\r\n    11\t}\r\n"]
[40.312652, "o", "===== corkpit/floor.rs =====\r\n"]
[40.315281, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn floor(a: i32) -> bool {\r\n     4\t    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n     5\t        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n     6\t        Err(_) => 0,\r\n     7\t    };\r\n     8\t    a >= t\r\n     9\t}\r\n"]
[40.31555, "o", "===== wick.sh =====\r\n"]
[40.316811, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/bloturn /app/packbay\r\n     5\trustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\r\n"]
[40.317777, "o", "===== sheet.tpl =====\r\n"]
[40.321564, "o", "{\"probe\":\"__P__\",\"matched\":__M__,\"taken\":__T__}\r\n"]
[40.321979, "o", "\u001b[?2004hroot@9e1a04f62235:/app# "]
[41.276187, "i", "echo '===== concise source refs ====='; grep -RIn --exclude=dewkiln -E 'fn |daywell|ledger|check|GUARD|MIN|WALL|remove|copy|read|write|pop|truncate|probe|matched|taken' /app/{wickmill,hopcue,millrib,restpit,urncue,shardfold,lidcue,corkpit} /app/wick.sh\n"]
