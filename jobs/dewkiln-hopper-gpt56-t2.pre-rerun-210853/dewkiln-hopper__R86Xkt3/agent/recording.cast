[125.815027, "i", "/app/bin/dewkiln clasp; r=$?\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\ncheck=json.loads(Path('/app/bloturn/check.json').read_text())\nassert set(check)=={'probe','matched','taken'}\nassert isinstance(check['probe'],str) and check['probe'] and check['probe']!='ledger'\nassert type(check['matched']) is int and type(check['taken']) is int\nassert check['matched']==check['taken']==22\nwall=int(Path('/app/opstext/WALL').read_text())\nsources={p.name:p for p in Path('/app/daywell').glob('d????????.tbl') if int(p.name[1:9])<=wall}\nlatest={p.name:p for p in Path('/app/packbay/latest').glob('d????????.tbl')}\nassert set(latest)==set(sources)\nfor name, source in sources.items():\n    assert source.read_bytes()==latest[name].read_bytes()\nassert Path('/app/bloturn/GUARD').read_text()=='ok'\nprint('FINAL_VALIDATION=PASS', check)\nPY\nmagic=$(od -An -tx1 -N4 /app/bin/dewkiln | tr -d ' \\n'); echo \"RC=$r ELF_MAGIC=$magic\"; test \"$r\" -eq 0 && test \"$magic\" = 7f454c46\nrm -rf /tmp/dewtest\n"]
[125.815706, "o", "/app/bin/dewkiln clasp; r=$?\r\n\u001b[?2004l\r"]
[125.823406, "o", "\u001b[?2004hroot@9e1a04f62235:/app# "]
[125.823524, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.824591, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> check=json.loads(Path('/app/bloturn/check.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> assert set(check)=={'probe','matched','taken'}\r\n\u001b[?2004l\r"]
[125.825035, "o", "\u001b[?2004h> "]
[125.825143, "o", "assert isinstance(check['probe'],str) and check['probe'] and check['probe']!='ledger'"]
[125.825339, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.826943, "o", "> assert type(check['matched']) is int and type(check['taken']) is int\r\n\u001b[?2004l\r\u001b[?2004h> assert check['matched']==check['taken']==22\r\n\u001b[?2004l\r\u001b[?2004h> wall=int(Path('/app/opstext/WALL').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.827232, "o", "sources={p.name:p for p in Path('/app/daywell').glob('d????????.tbl') if int(p.name[1:9])<=wall}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.827646, "o", "latest={p.name:p for p in Path('/app/packbay/latest').glob('d????????.tbl')}\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.827893, "o", "> "]
[125.829037, "o", "assert set(latest)==set(sources)\r\n\u001b[?2004l\r\u001b[?2004h> for name, source in sources.items():\r\n\u001b[?2004l\r\u001b[?2004h>     assert source.read_bytes()==latest[name].read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> assert Path('/app/bloturn/GUARD').read_text()=='ok'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.829302, "o", "print('FINAL_VALIDATION=PASS', check)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
