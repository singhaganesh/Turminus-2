[13.263465, "o", "\u001b[?2004hroot@9e1a04f62235:/app# "]
[26.72964, "i", "for f in /app/wickmill/boot.rs /app/hopcue/rim.rs /app/millrib/gait.rs /app/restpit/soak.rs /app/urncue/fold.rs /app/shardfold/read.rs /app/lidcue/skip.rs /app/corkpit/floor.rs /app/wick.sh; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[26.730589, "o", "for f in /app/wickmill/boot.rs /app/hopcue/rim.rs /app/millrib/gait.rs /app/restpit/soak.rs /app/urncue/fold.rs /app/shardfold/read.rs /app/lidcue/skip.rs /app/corkpit/floor.rs /app/wick.sh; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[26.730738, "o", "===== /app/wickmill/boot.rs =====\r\n"]
[26.733131, "o", "     1\t#[path = \"../urncue/fold.rs\"]\r\n     2\tmod fold;\r\n     3\t#[path = \"../millrib/gait.rs\"]\r\n     4\tmod gait;\r\n     5\t#[path = \"../lidcue/skip.rs\"]\r\n     6\tmod skip;\r\n     7\t#[path = \"../corkpit/floor.rs\"]\r\n     8\tmod floor;\r\n     9\t\r\n    10\tfn main() {\r\n    11\t    let mut args = std::env::args();\r\n"]
[26.733188, "o", "    12\t    let _ = args.next();\r\n    13\t    let cmd = args.next().unwrap_or_default();\r\n    14\t    if cmd != \"clasp\" {\r\n    15\t        eprintln!(\"usage: dewkiln clasp\");\r\n    16\t        std::process::exit(2);\r\n    17\t    }\r\n    18\t    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    19\t    let code = match fold::fold() {\r\n    20\t        Ok((packed, taken)) => {\r\n    21\t            let mut dump = packed.clone();\r\n    22\t            skip::skip(&mut dump);\r\n    23\t            let _ = floor::floor(taken);\r\n    24\t            gait::gait(taken, &packed)\r\n    25\t        }\r\n    26\t        Err(c) => c,\r\n    27\t    };\r\n    28\t    std::process::exit(code);\r\n    29\t}\r\n"]
[26.737287, "o", "===== /app/hopcue/rim.rs =====\r\n"]
[26.738555, "o", "     1\tpub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n     2\t    b.into_iter().filter(|(d, _)| *d < a).collect()\r\n     3\t}\r\n"]
[26.73885, "o", "===== /app/millrib/gait.rs =====\r\n"]
[26.740392, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\r\n     4\t    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n     5\t    let out = tpl\r\n     6\t        .replace(\"__P__\", p)\r\n     7\t        .replace(\"__M__\", &m.to_string())\r\n     8\t        .replace(\"__T__\", &t.to_string());\r\n     9\t    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    10\t    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)?;\r\n    11\t    Ok(())\r\n    12\t}\r\n    13\t\r\n    14\tpub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {\r\n    15\t    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n    16\t    if emit(\"ledger\", a, a).is_err() {\r\n    17\t        return 1;\r\n    18\t    }\r\n    19\t    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n"]
[26.740662, "o", "    20\t        return 1;\r\n    21\t    }\r\n    22\t    0\r\n    23\t}\r\n"]
[26.740869, "o", "===== /app/restpit/soak.rs =====\r\n"]
[26.742117, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n     4\t    let _ = fs::remove_dir_all(b);\r\n     5\t    fs::create_dir_all(b).map_err(|_| 1)?;\r\n     6\t    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n     7\t    xs.sort_by_key(|x| x.0);\r\n     8\t    if !xs.is_empty() {\r\n     9\t        xs.pop();\r\n    10\t    }\r\n    11\t    for (d, p) in xs {\r\n    12\t        let name = format!(\"d{:08}.tbl\", d);\r\n    13\t        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    14\t    }\r\n    15\t    Ok(())\r\n    16\t}\r\n"]
[26.742406, "o", "===== /app/urncue/fold.rs =====\r\n"]
[26.743745, "o", "     1\t#[path = \"../hopcue/rim.rs\"]\r\n     2\tmod rim;\r\n     3\t#[path = \"../restpit/soak.rs\"]\r\n     4\tmod soak;\r\n     5\t#[path = \"../shardfold/read.rs\"]\r\n     6\tmod read;\r\n     7\t\r\n     8\tuse std::fs;\r\n     9\t\r\n    10\tpub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    11\t    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n    12\t        .map_err(|_| 1)?\r\n    13\t        .trim()\r\n    14"]
[26.74395, "o", "\t        .parse()\r\n    15\t        .map_err(|_| 1)?;\r\n    16\t    let listed = read::list(\"/app/daywell\");\r\n    17\t    let picked = rim::rim(wall, listed);\r\n    18\t    if picked.is_empty() {\r\n    19\t        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    20\t        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n    21\t        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    22\t        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n    23\t        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n    24\t        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n    25\t        return Ok((Vec::new(), 0));\r\n    26\t    }\r\n    27\t    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    28\t    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    29\t    let mut packed = Vec::new();\r\n    30\t    let mut taken = 0;\r\n    31\t    for (d, p) in picked {\r\n    32\t        let name = format!(\"d{:08}.tbl\", d);\r\n    33\t        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n    34\t        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n    35\t        taken += read::nlines(&dest);\r\n    36\t        packed.push((d, dest));\r\n    37\t    }\r\n    38\t    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    39\t    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    40\t    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    41\t    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    42\t    Ok((packed, taken))\r\n    43\t}\r\n"]
[26.744544, "o", "===== /app/shardfold/read.rs =====\r\n"]
[26.746306, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn list(root: &str) -> Vec<(i32, String)> {\r\n     4\t    let mut v = Vec::new();\r\n     5\t    let rd = match fs::read_dir(root) {\r\n     6\t        Ok(x) => x,\r\n     7\t        Err(_) => return v,\r\n     8\t    };\r\n     9\t    for ent in rd.flatten() {\r\n    10\t        let name = ent.file_name().to_string_lossy().into_owned();\r\n    11\t        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n    12\t            continue;\r\n    13\t        }\r\n    14\t        let mid = &name[1..name.len() - 4];\r\n    15\t        if let Ok(d) = mid.parse::<i32>() {\r\n    16\t            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n    17\t        }\r\n    18\t    }\r\n    19\t    v.sort_by_key(|x| x.0);\r\n    20\t    v\r\n    21\t}\r\n    22\t\r\n    23\tpub fn nlines(path: &str) -> i32 {\r\n    24\t    match fs::read_to_string(path) {\r\n    25\t        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n    26\t        Err(_) => 0,\r\n    27\t    }\r\n    28\t}\r\n"]
[26.746658, "o", "===== /app/lidcue/skip.rs =====\r\n"]
[26.748892, "o", "     1\tpub fn skip(a: &mut [(i32, String)]) {\r\n     2\t    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n     3\t}\r\n     4\t\r\n     5\tpub fn width(a: &[(i32, String)]) -> usize {\r\n     6\t    a.len()\r\n     7\t}\r\n     8\t\r\n     9\tpub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    10\t    a.first().map(|x| x.0)\r\n    11\t}\r\n"]
[26.749587, "o", "===== /app/corkpit/floor.rs =====\r\n"]
[26.753365, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn floor(a: i32) -> bool {\r\n     4\t    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n     5\t        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n     6\t        Err(_) => 0,\r\n     7\t    };\r\n     8\t    a >= t\r\n     9\t}\r\n===== /app/wick.sh =====\r\n"]
[26.757797, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/bloturn /app/packbay\r\n     5\trustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\r\n"]
[26.758405, "o", "\u001b[?2004hroot@9e1a04f62235:/app# "]
[27.633447, "i", "for f in /app/millrib/sheet.tpl /app/wickmill/usage.txt /app/opstext/SHIFT.txt /app/corkpit/NOTE.txt; do echo \"===== $f =====\"; cat \"$f\"; done; echo '===== STAGE ====='; for f in /app/packbay/stage/*; do echo \"### $f ($(wc -l < \"$f\") rows)\"; cat \"$f\"; done; echo '===== SEED ====='; for f in /app/seed/daywell/*; do echo \"### $f ($(wc -l < \"$f\") rows)\"; cat \"$f\"; done\n"]
[27.634923, "o", "for f in /app/millrib/sheet.tpl /app/wickmill/usage.txt /app/opstext/SHIFT.txt /app/corkpit/NOTE.txt; do echo \"===== $f =====\"; cat \"$f\"; done; echo '===== STAGE ====='; for f in /app/packbay/stage/*; do echo \"### $f ($(wc -l < \"$f\") rows)\"; cat \"$f\"; done; echo '===== SEED ====='; for f in /app/seed/daywell/*; do echo \"### $f ($(wc -l < \"$f\") rows)\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[27.635271, "o", "===== /app/millrib/sheet.tpl =====\r\n"]
[27.637243, "o", "{\"probe\":\"__P__\",\"matched\":__M__,\"taken\":__T__}\r\n"]
[27.637869, "o", "===== /app/wickmill/usage.txt =====\r\n"]
[27.639172, "o", "dewkiln clasp\r\n"]
[27.639481, "o", "===== /app/opstext/SHIFT.txt =====\r\n"]
[27.640805, "o", "Nightly clasp has stayed green since the CI floor landed.\r\nOperators still open /app/packbay/latest after incidents and find the\r\nnewest populated day file missing even when /app/daywell still holds it.\r\nThe floor value lives under floorcue/.\r\n"]
[27.641003, "o", "===== /app/corkpit/NOTE.txt =====\r\n"]
[27.641963, "o", "floor() reads MIN.txt and compares a taken total to that integer.\r\nCI used this as a cheap rehearsal when the desk was first wired.\r\n"]
[27.64217, "o", "===== STAGE =====\r\n"]
[27.644033, "o", "### /app/packbay/stage/d20260910.tbl (5 rows)\r\n"]
[27.64504, "o", "101\r\n102\r\n103\r\n104\r\n105\r\n"]
[27.646726, "o", "### /app/packbay/stage/d20260911.tbl (4 rows)\r\n"]
[27.647431, "o", "201\r\n202\r\n203\r\n204\r\n"]
[27.648881, "o", "### /app/packbay/stage/d20260912.tbl (6 rows)\r\n"]
[27.649679, "o", "301\r\n302\r\n303\r\n304\r\n305\r\n306\r\n"]
[27.6499, "o", "===== SEED =====\r\n"]
[27.65354, "o", "### /app/seed/daywell/d20260910.tbl (5 rows)\r\n"]
[27.65466, "o", "101\r\n102\r\n103\r\n104\r\n105\r\n"]
[27.656772, "o", "### /app/seed/daywell/d20260911.tbl (4 rows)\r\n"]
[27.658037, "o", "201\r\n202\r\n203\r\n204\r\n"]
