Sending keys: ['cat > /app/hopcue/rim.rs <<\'EOF\'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/shardfold/read.rs <<\'EOF\'\nuse std::fs;\nuse std::io;\n\npub fn list(root: &str) -> Result<Vec<(i32, String)>, io::Error> {\n    let mut files = Vec::new();\n    for item in fs::read_dir(root)? {\n        let entry = item?;\n        if !entry.file_type()?.is_file() {\n            continue;\n        }\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with(\'d\') || !name.ends_with(".tbl") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|c| c.is_ascii_digit()) {\n            continue;\n        }\n        if let Ok(day) = digits.parse::<i32>() {\n            files.push((day, entry.path().to_string_lossy().into_owned()));\n        }\n    }\n    files.sort_by_key(|x| x.0);\n    Ok(files)\n}\n\npub fn read_rows(path: &str) -> Result<(String, i32), io::Error> {\n    let text = fs::read_to_string(path)?;\n    let rows = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n    Ok((text, rows))\n}\nEOF\ncat > /app/restpit/soak.rs <<\'EOF\'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], root: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(root);\n    fs::create_dir_all(root).map_err(|_| 1)?;\n    let mut ordered = files.to_vec();\n    ordered.sort_by_key(|x| x.0);\n    for (day, source) in ordered {\n        let name = format!("d{:08}.tbl", day);\n        fs::copy(source, format!("{}/{}", root, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/urncue/fold.rs <<\'EOF\'\n#[path = "../hopcue/rim.rs"]\nmod rim;\n#[path = "../restpit/soak.rs"]\nmod soak;\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\nfn reset_publication() {\n    let _ = fs::remove_dir_all("/app/packbay/stage");\n    let _ = fs::remove_dir_all("/app/packbay/latest");\n    let _ = fs::create_dir_all("/app/packbay/stage");\n    let _ = fs::create_dir_all("/app/packbay/latest");\n}\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?.trim().parse().map_err(|_| 1)?;\n    let listed = read::list("/app/daywell").map_err(|_| 1)?;\n    let picked = rim::rim(wall, listed);\n    reset_publication();\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let mut packed = Vec::new();\n    let mut taken = 0i32;\n    for (day, source) in picked {\n        let (_, rows) = read::read_rows(&source).map_err(|_| 1)?;\n        let destination = format!("/app/packbay/stage/d{:08}.tbl", day);\n        fs::copy(&source, &destination).map_err(|_| 1)?;\n        taken = taken.checked_add(rows).ok_or(1)?;\n        packed.push((day, destination));\n    }\n    if taken == 0 {\n        reset_publication();\n        return Err(1);\n    }\n\n    soak::soak(&packed, "/app/packbay/latest")?;\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/ledger.json", format!("{{\\"taken\\":{}}}", taken))\n        .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['cat > /app/corkpit/floor.rs <<\'EOF\'\nuse std::fs;\n\npub fn floor(taken: i32) -> bool {\n    match fs::read_to_string("/app/floorcue/MIN.txt")\n        .ok()\n        .and_then(|s| s.trim().parse::<i32>().ok())\n    {\n        Some(minimum) => taken >= minimum,\n        None => false,\n    }\n}\nEOF\ncat > /app/millrib/gait.rs <<\'EOF\'\nuse std::fs;\n\nfn rows(text: &str) -> i32 {\n    text.lines().filter(|line| !line.trim().is_empty()).count() as i32\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let template = fs::read_to_string("/app/millrib/sheet.tpl").map_err(|_| 1)?;\n    let output = template\n        .replace("__P__", probe)\n        .replace("__M__", &matched.to_string())\n        .replace("__T__", &taken.to_string());\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/check.json", output).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    if packed.is_empty() || taken <= 0 {\n        return 1;\n    }\n\n    let mut matched = 0i32;\n    let mut live_probe: Option<String> = None;\n    for (day, staged_path) in packed {\n        let name = format!("d{:08}.tbl", day);\n        let source_path = format!("/app/daywell/{}", name);\n        let latest_path = format!("/app/packbay/latest/{}", name);\n\n        // These reads are deliberately independent of ledger.json and prove that\n        // check generation observed the live calendar files.\n        let source = match fs::read_to_string(&source_path) {\n            Ok(value) => value,\n            Err(_) => return 1,\n        };\n        let staged = match fs::read_to_string(staged_path) {\n            Ok(value) => value,\n            Err(_) => return 1,\n        };\n        let latest = match fs::read_to_string(&latest_path) {\n            Ok(value) => value,\n            Err(_) => return 1,\n        };\n        if source != staged || source != latest {\n            return 1;\n        }\n        let count = rows(&source);\n        matched = match matched.checked_add(count) {\n            Some(value) => value,\n            None => return 1,\n        };\n        if count > 0 {\n            live_probe = Some(format!("{}:{}", name, count));\n        }\n    }\n\n    if matched != taken {\n        return 1;\n    }\n    let probe = match live_probe {\n        Some(value) => value,\n        None => return 1,\n    };\n    if emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/wickmill/boot.rs <<\'EOF\'\n#[path = "../urncue/fold.rs"]\nmod fold;\n#[path = "../millrib/gait.rs"]\nmod gait;\n#[path = "../lidcue/skip.rs"]\nmod skip;\n#[path = "../corkpit/floor.rs"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != "clasp" {\n        eprintln!("usage: dewkiln clasp");\n        std::process::exit(2);\n    }\n\n    let _ = std::fs::remove_file("/app/bloturn/GUARD");\n    let _ = std::fs::remove_file("/app/bloturn/check.json");\n    let _ = std::fs::remove_file("/app/bloturn/ledger.json");\n\n    let code = match fold::fold() {\n        Ok((packed, taken)) => {\n            if !floor::floor(taken) {\n                1\n            } else {\n                let mut ordered = packed.clone();\n                skip::skip(&mut ordered);\n                gait::gait(taken, &ordered)\n            }\n        }\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\nfile /app/bin/dewkiln\n/app/bin/dewkiln clasp; rc=$?; echo "RC=$rc"; echo \'--- outputs ---\'; cat /app/bloturn/ledger.json; echo; cat /app/bloturn/check.json; echo; printf \'GUARD=\'; cat /app/bloturn/GUARD; echo; echo \'--- source/latest counts ---\'; for f in /app/daywell/d*.tbl; do n=$(basename "$f"); printf \'%s source=%s latest=%s\\n\' "$n" "$(grep -cve \'^[[:space:]]*$\' "$f")" "$(grep -cve \'^[[:space:]]*$\' "/app/packbay/latest/$n")"; done\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
