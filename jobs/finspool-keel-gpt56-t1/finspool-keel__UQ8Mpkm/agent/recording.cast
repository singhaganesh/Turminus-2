[13.76629, "o", "/app/hull.sh\r\n"]
[13.770908, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/bloturn\r\nrustc --edition 2021 -O /app/spindock/spin.rs -o /tmp/spinknit\r\n/tmp/spinknit\r\nrustc --edition 2021 -O /app/fincli/boot.rs -o /app/bin/finspool\r\n\u001b[?2004hroot@ed47475e91a8:/app# "]
[25.070383, "i", "for f in /app/vatnote/FORMAT.txt /app/opsleaf/SHIFT.txt /app/slipcards/NOTE.txt /app/fincli/usage.txt /app/tplfold/modes.knt /app/tplfold/emit.tpl /app/tplfold/gather.rs /app/tplfold/live.rs /app/spindock/*.rs /app/hookvat/*.rs /app/scanpit/*.rs /app/fincli/*.rs; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[25.071646, "o", "for f in /app/vatnote/FORMAT.txt /app/opsleaf/SHIFT.txt /app/slipcards/NOTE.txt /app/fincli/usage.txt /app/tplfold/modes.knt /app/tplfold/emit.tpl /app/tplfold/gather.rs /app/tplfold/live.rs /app/spindock/*.rs /app/hookvat/*.rs /app/scanpit/*.rs /app/fincli/*.rs; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[25.072141, "o", "===== /app/vatnote/FORMAT.txt =====\r\n"]
[25.075046, "o", "A whole card has four lines:\r\n\r\nFIN1\r\nthread=<name>\r\nop=<verb>\r\nEND\r\n"]
[25.075349, "o", "\r\nEach line ends with a newline. The name and verb on the card are the\r\nsame tokens passed on the command line. A whole card is those four\r\nlines and nothing more. After an interruption, the dest file is either\r\nthat whole card or absent — never a partial file.\r\n\r\nNames that appear on this mill include desk-k4, keel-hold-r9, n1, and\r\nrib-yard-m3. Verbs include splice-harbor-overlong-token-alpha-zz,\r\nquay-splice-harbor-overlong-token-beta-yy, fold_zeta_ww, and v1.\r\n"]
[25.075603, "o", "===== /app/opsleaf/SHIFT.txt =====\r\n"]
[25.077443, "o", "ease on this shift already leaves a whole card. sting is the overnight drill.\r\n\r\nSibling yards keep a shift table that left-fills names to column width\r\nbefore they land on a dest card. indent() on this image is that width helper.\r\n"]
[25.079455, "o", "===== /app/slipcards/NOTE.txt =====\r\n"]
[25.080638, "o", "Some desks bump ROOM on the slip card when a short write looks clipped.\r\nThe returning path already produces a whole card on this bench.\r\nYard shift notes also talk about lining names to a column.\r\n"]
[25.081233, "o", "===== /app/fincli/usage.txt =====\r\n"]
[25.082524, "o", "finspool knit\r\nfinspool sting THREAD OP DEST\r\nfinspool ease THREAD OP DEST\r\nfinspool look DEST\r\n"]
[25.082893, "o", "===== /app/tplfold/modes.knt =====\r\n"]
[25.084401, "o", "0 gather\r\n1 live\r\n"]
[25.0847, "o", "===== /app/tplfold/emit.tpl =====\r\n"]
[25.086487, "o", "{{BODY}}\r\n"]
[25.086759, "o", "===== /app/tplfold/gather.rs =====\r\n"]
[25.088347, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n        crate::fmt::keep_token(verb)\r\n    );\r\n    if hard {\r\n        crate::spool::stash(card.into_bytes());\r\n    } else {\r\n        let _ = s.write_all(card.as_bytes());\r\n    }\r\n    crate::spool::clip(&mut s);\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n"]
[25.08839, "o", "    0\r\n}\r\n"]
[25.088719, "o", "===== /app/tplfold/live.rs =====\r\n"]
[25.090225, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n"]
[25.090325, "o", "        crate::fmt::keep_token(verb)\r\n    );\r\n    let _ = s.write_all(card.as_bytes());\r\n    crate::spool::clip(&mut s);\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    let _ = hard;\r\n    0\r\n}\r\n"]
[25.090521, "o", "===== /app/spindock/modes.rs =====\r\n"]
[25.092343, "o", "pub fn op_a(k: u8) -> u8 {\r\n    if k == 0 {\r\n        1\r\n    } else {\r\n        0\r\n    }\r\n}\r\n"]
[25.092808, "o", "===== /app/spindock/spin.rs =====\r\n"]
[25.094402, "o", "#[path = \"/app/spindock/modes.rs\"]\r\nmod modes;\r\n#[path = \"/app/spindock/text.rs\"]\r\nmod text;\r\n\r\nuse std::fs;\r\n\r\nfn main() {\r\n    let _ = text::pad_out(\"x\");\r\n    let hard_gather = modes::op_a(1) == 0;\r\n    let src = if hard_gather {\r\n        \"/app/tplfold/gather.rs\"\r\n    } else {\r\n        \"/app/tplfold/live.rs\"\r\n    };\r\n    let body = fs::read_to_string(src).unwrap();\r\n    fs::write(\"/app/hookvat/gen_emit.rs\", body).unwrap();\r\n}\r\n"]
[25.09688, "o", "===== /app/spindock/text.rs =====\r\n"]
[25.097497, "o", "pub fn pad_out(s: &str) -> String {\r\n    s.to_string()\r\n}\r\n"]
[25.097894, "o", "===== /app/hookvat/gen_emit.rs =====\r\n"]
[25.1002, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n        crate::fmt::keep_token(verb)\r\n    );\r\n    if hard {\r\n        crate::spool::stash(card.into_bytes());\r\n    } else {\r\n        let _ = s.write_all(card.as_bytes());\r\n    }\r\n    crate::spool::clip(&mut s);\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    0\r\n}\r\n"]
[25.100291, "o", "===== /app/hookvat/open.rs =====\r\n"]
[25.101707, "o", "pub fn under_root(p: &str) -> bool {\r\n    p.starts_with(\"/app/bloturn/\")\r\n}\r\n"]
[25.102165, "o", "===== /app/hookvat/seal.rs =====\r\n"]
[25.103877, "o", "use std::io::Write;\r\nuse std::sync::atomic::{AtomicBool, Ordering};\r\n\r\nstatic NEED: AtomicBool = AtomicBool::new(false);\r\n\r\npub fn op_c<W: Write>(_w: &mut W) {\r\n    NEED.store(true, Ordering::SeqCst);\r\n}\r\n\r\npub fn drip<W: Write>(w: &mut W) {\r\n    if NEED.swap(false, Ordering::SeqCst) {\r\n        let _ = writeln!(w, \"END\");\r\n    }\r\n}\r\n"]
[25.104241, "o", "===== /app/hookvat/spool.rs =====\r\n"]
[25.105375, "o", "use std::fs::File;\r\nuse std::io::{BufWriter, Write};\r\nuse std::path::Path;\r\nuse std::process;\r\nuse std::sync::Mutex;\r\n\r\n#[path = \"/app/slipcards/cap.rs\"]\r\nmod cap;\r\n\r\nstatic BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());\r\nstatic SLOT: Mutex<Option<BufWriter<File>>> = Mutex::new(None);\r\nstatic CUR: Mutex<Option<String>> = Mutex::new(None);\r\n"]
[25.105469, "o", "\r\n#[allow(dead_code)]\r\npub fn stash(b: Vec<u8>) {\r\n    *BAG.lock().unwrap() = b;\r\n}\r\n\r\npub fn op_b(p: &str) -> BufWriter<File> {\r\n    *CUR.lock().unwrap() = Some(p.to_string());\r\n    let f = File::create(p).unwrap();\r\n    BufWriter::with_capacity(cap::ROOM, f)\r\n}\r\n\r\npub fn clip<W: Write>(s: &mut W) {\r\n    if Path::new(\"/app/opsleaf/RIP\").is_file() {\r\n        let _ = s.flush();\r\n        process::abort();\r\n    }\r\n}\r\n\r\npub fn park(s: BufWriter<File>) {\r\n    *SLOT.lock().unwrap() = Some(s);\r\n}\r\n"]
[25.105777, "o", "===== /app/scanpit/fmt.rs =====\r\n"]
[25.1074, "o", "pub fn indent(n: usize) -> String {\r\n    \" \".repeat(n)\r\n}\r\n\r\npub fn keep_token(s: &str) -> String {\r\n    let _ = indent(0);\r\n    s.to_string()\r\n}\r\n"]
[25.107744, "o", "===== /app/scanpit/peek.rs =====\r\n"]
[25.109002, "o", "use std::fs;\r\n\r\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\r\n\r\npub fn show(p: &str) -> i32 {\r\n    let _ = SHAPE.len();\r\n    let raw = match fs::read_to_string(p) {\r\n        Ok(s) => s,\r\n        Err(_) => return 1,\r\n    };\r\n    let want: Vec<&str> = raw.lines().collect();\r\n    if want.len() != 4 {\r\n        return 1;\r\n"]
[25.10911, "o", "    }\r\n    if want[0] != \"FIN1\" {\r\n        return 1;\r\n    }\r\n    let th = want[1].strip_prefix(\"thread=\").unwrap_or(\"\");\r\n    if want[1] != format!(\"thread={}\", crate::fmt::keep_token(th)) {\r\n        return 1;\r\n    }\r\n    let op = want[2].strip_prefix(\"op=\").unwrap_or(\"\");\r\n    if want[2] != format!(\"op={}\", crate::fmt::keep_token(op)) {\r\n        return 1;\r\n    }\r\n    if want[3] != \"END\" {\r\n        return 1;\r\n    }\r\n    if !raw.ends_with('\\n') {\r\n        return 1;\r\n    }\r\n    print!(\"{}\", raw);\r\n    0\r\n}\r\n"]
[25.113398, "o", "===== /app/fincli/boot.rs =====\r\n"]
[25.115902, "o", "#[path = \"/app/hookvat/spool.rs\"]\r\nmod spool;\r\n#[path = \"/app/hookvat/seal.rs\"]\r\nmod seal;\r\n#[path = \"/app/hookvat/open.rs\"]\r\nmod open;\r\n#[path = \"/app/hookvat/gen_emit.rs\"]\r\nmod emit;\r\n#[path = \"/app/scanpit/peek.rs\"]\r\nmod peek;\r\n#[path = \"/app/scanpit/fmt.rs\"]\r\nmod fmt;\r\n\r\nuse std::env;\r\nuse std::process;\r\n\r\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\r\n\r\nfn main() {\r\n    let mut args = env::args().skip(1);\r\n    let cmd = args.next().unwrap_or_default();\r\n    match cmd.as_str() {\r\n        \"knit\" => {\r\n            let st = process::Command::new(\"/app/hull.sh\").status();\r\n            process::exit(if st.map(|s| s.success()).unwrap_or(false) {\r\n                0\r\n            } else {\r\n                1\r\n            });\r\n        }\r\n        \"look\" => {\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = fmt::indent(0);\r\n            process::exit(peek::show(&dest));\r\n        }\r\n        \"ease\" => {\r\n            let th = args.next().unwrap_or_default();\r\n            let verb = args.next().unwrap_or_default();\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = open::under_root(&dest);\r\n            if emit::go(&th, &verb, &dest, false) != 0 {\r\n                process::exit(2);\r\n            }\r\n        }\r\n        \"sting\" => {\r\n            let th = args.next().unwrap_or_default();\r\n            let verb = args.next().unwrap_or_default();\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = open::under_root(&dest);\r\n            if emit::go(&th, &verb, &dest, true) != 0 {\r\n                process::exit(2);\r\n            }\r\n            process::abort();\r\n        }\r\n        _ => {\r\n"]
[25.116212, "o", "            eprintln!(\"usage: finspool knit|sting|ease|look\");\r\n            let _ = SHIFT.len();\r\n            process::exit(2);\r\n        }\r\n    }\r\n}\r\n"]
[25.116517, "o", "\u001b[?2004h"]
[25.116652, "o", "root@ed47475e91a8:/app# "]
[26.14362, "i", "echo '--- binary header ---'; od -An -tx1 -N16 /app/bin/finspool 2>&1; echo '--- compiler ---'; rustc --version; echo '--- permissions ---'; ls -l /app/bin/finspool /app/hull.sh\n"]
[26.146303, "o", "echo '--- binary header ---'; od -An -tx1 -N16 /app/bin/finspool 2>&1; echo '--- compiler ---'; rustc --version; echo '--- permissions ---'; ls -l /app/bin/finspool /app/hull.sh"]
[26.146704, "o", "\r\n\u001b[?2004l\r--- binary header ---\r\n"]
[26.152089, "o", " 7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\r\n"]
[26.156614, "o", "--- compiler ---\r\nbash: rustc: command not found\r\n--- permissions ---\r\n"]
[26.159002, "o", "-rwxr-xr-x 1 root root 4071216 Sep 16 09:31 /app/bin/finspool\r\n-rwxrwxr-x 1 root root     265 Sep 15 17:06 /app/hull.sh\r\n\u001b[?2004hroot@ed47475e91a8:/app# "]
[85.002921, "i", "export PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; command -v rustc; rustc --version\n"]
[85.004715, "o", "export PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; command -v rustc; rustc --version"]
[85.005697, "o", "\r\n\u001b[?2004l\r/usr/local/cargo/bin/rustc\r\n"]
[85.299918, "o", "rustc 1.85.1 (4eb161250 2025-03-15)\r\n"]
[85.31313, "o", "\u001b[?2004hroot@ed47475e91a8:/app# "]
[85.380628, "i", "cat > /app/hookvat/open.rs <<'EOF'\nuse std::fs;\nuse std::path::{Component, Path};\n\npub fn under_root(p: &str) -> bool {\n    let path = Path::new(p);\n    let mut parts = path.components();\n    if !matches!(parts.next(), Some(Component::RootDir))\n        || !matches!(parts.next(), Some(Component::Normal(x)) if x == \"app\")\n        || !matches!(parts.next(), Some(Component::Normal(x)) if x == \"bloturn\")\n    {\n        return false;\n    }\n    let rest: Vec<_> = parts.collect();\n    if rest.is_empty() || rest.iter().any(|c| !matches!(c, Component::Normal(_))) {\n        return false;\n    }\n    let parent = match path.parent().and_then(|x| fs::canonicalize(x).ok()) {\n        Some(x) => x,\n        None => return false,\n    };\n    let root = match fs::canonicalize(\"/app/bloturn\") {\n        Ok(x) => x,\n        Err(_) => return false,\n    };\n    parent.starts_with(root)\n}\nEOF\ncat > /app/hookvat/spool.rs <<'EOF'\nuse std::fs::{self, OpenOptions};\nuse std::io::{self, Write};\nuse std::path::{Path, PathBuf};\nuse std::process;\nuse std::sync::atomic::{AtomicU64, Ordering};\n\nstatic SERIAL: AtomicU64 = AtomicU64::new(0);\n\nfn temporary(dest: &Path) -> io::Result<(PathBuf, fs::File)> {\n    let parent = dest.parent().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, \"no parent\"))?;\n    for _ in 0..100 {\n        let n = SERIAL.fetch_add(1, Ordering::Relaxed);\n        let name = format!(\".finspool.{}.{}.tmp\", process::id(), n);\n        let path = parent.join(name);\n        match OpenOptions::new().write(true).create_new(true).open(&path) {\n            Ok(f) => return Ok((path, f)),\n            Err(e) if e.kind() == io::ErrorKind::AlreadyExists => continue,\n            Err(e) => return Err(e),\n        }\n    }\n    Err(io::Error::new(io::ErrorKind::AlreadyExists, \"temporary-name exhaustion\"))\n}\n\npub fn write_card(dest: &str, card: &[u8]) -> io::Result<()> {\n    let target = Path::new(dest);\n\n    // RIP represents interruption before publication. Remove an already\n    // smashed destination so interruption can leave no file, never a fragment.\n    if Path::new(\"/app/opsleaf/RIP\").is_file() {\n        match fs::remove_file(target) {\n            Ok(()) => {}\n            Err(e) if e.kind() == io::ErrorKind::NotFound => {}\n            Err(e) => return Err(e),\n        }\n        process::abort();\n    }\n\n    let (tmp, mut file) = temporary(target)?;\n    let result = (|| {\n        file.write_all(card)?;\n        file.sync_all()?;\n        drop(file);\n        fs::rename(&tmp, target)?;\n        if let Some(parent) = target.parent() {\n            fs::File::open(parent)?.sync_all()?;\n        }\n        Ok(())\n    })();\n    if result.is_err() {\n        let _ = fs::remove_file(&tmp);\n    }\n    result\n}\nEOF\ncat > /app/hookvat/seal.rs <<'EOF'\npub fn card(thread: &str, op: &str) -> Vec<u8> {\n    format!(\"FIN1\\nthread={}\\nop={}\\nEND\\n\", thread, op).into_bytes()\n}\nEOF\ncat > /app/tplfold/gather.rs <<'EOF'\npub fn go(nm: &str, verb: &str, dest: &str, _hard: bool) -> i32 {\n    let card = crate::seal::card(\n        &crate::fmt::keep_token(nm),\n        &crate::fmt::keep_token(verb),\n    );\n    match crate::spool::write_card(dest, &card) {\n        Ok(()) => 0,\n        Err(e) => {\n            eprintln!(\"finspool: {}\", e);\n            1\n        }\n    }\n}\nEOF\ncp /app/tplfold/gather.rs /app/tplfold/live.rs\ncat > /app/spindock/modes.rs <<'EOF'\npub fn op_a(k: u8) -> u8 {\n    if k == 1 { 0 } else { 1 }\n}\nEOF\ncat > /app/spindock/text.rs <<'EOF'\npub fn pad_out(s: &str) -> String {\n    s.to_owned()\n}\nEOF\n"]
[85.385977, "o", "cat > /app/hookvat/open.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> use std::path::{Component, Path};\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn under_root(p: &str) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h>     let path = Path::new(p);\r\n\u001b[?2004l\r\u001b[?2004h>     let mut parts = path.components();\r\n\u001b[?2004l\r\u001b[?2004h>     if !matches!(parts.next(), Some(Component::RootDir))\r\n\u001b[?2004l\r\u001b[?2004h>         || !matches!(parts.next(), Some(Component::Normal(x)) if x == \"app\")\r\n\u001b[?2004l\r\u001b[?2004h>         || !matches!(parts.next(), Some(Component::Normal(x)) if x == \"bloturn\")\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>         return false;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let rest: Vec<_> = parts.collect();\r\n\u001b[?2004l\r\u001b[?2004h>     if rest.is_empty() || rest.iter().any(|c| !matches!(c, Component::Normal(_))) {\r\n\u001b[?2004l\r\u001b[?2004h>         return false;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let parent = match path.parent().and_then(|x| fs::canonicalize(x).ok()) {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(x) => x,\r\n\u001b[?2004l\r\u001b[?2004h>         None => return false,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     let root = match fs::canonicalize(\"/app/bloturn\") {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(x) => x,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(_) => return false,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     parent.starts_with(root)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
