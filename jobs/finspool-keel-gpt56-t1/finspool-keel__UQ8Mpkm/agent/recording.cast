[85.886614, "i", "cat > /app/scanpit/fmt.rs <<'EOF'\npub fn indent(n: usize) -> String {\n    \" \".repeat(n)\n}\n\npub fn keep_token(s: &str) -> String {\n    s.to_owned()\n}\n\npub fn valid_token(s: &str) -> bool {\n    !s.contains('\\n') && !s.contains('\\r')\n}\nEOF\ncat > /app/scanpit/peek.rs <<'EOF'\nuse std::fs;\n\npub fn show(p: &str) -> i32 {\n    let raw = match fs::read(p) {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    let text = match std::str::from_utf8(&raw) {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    if !text.ends_with('\\n') {\n        return 1;\n    }\n    let fields: Vec<&str> = text.split_terminator('\\n').collect();\n    if fields.len() != 4\n        || fields[0] != \"FIN1\"\n        || !fields[1].starts_with(\"thread=\")\n        || !fields[2].starts_with(\"op=\")\n        || fields[3] != \"END\"\n    {\n        return 1;\n    }\n    let thread = &fields[1][\"thread=\".len()..];\n    let op = &fields[2][\"op=\".len()..];\n    if !crate::fmt::valid_token(thread)\n        || !crate::fmt::valid_token(op)\n        || fields[1] != format!(\"thread={}\", crate::fmt::keep_token(thread))\n        || fields[2] != format!(\"op={}\", crate::fmt::keep_token(op))\n    {\n        return 1;\n    }\n    print!(\"{}\", text);\n    0\n}\nEOF\ncat > /app/fincli/boot.rs <<'EOF'\n#[path = \"/app/hookvat/spool.rs\"]\nmod spool;\n#[path = \"/app/hookvat/seal.rs\"]\nmod seal;\n#[path = \"/app/hookvat/open.rs\"]\nmod open;\n#[path = \"/app/hookvat/gen_emit.rs\"]\nmod emit;\n#[path = \"/app/scanpit/peek.rs\"]\nmod peek;\n#[path = \"/app/scanpit/fmt.rs\"]\nmod fmt;\n\nuse std::env;\nuse std::process;\n\nfn usage() -> ! {\n    eprintln!(\"usage: finspool knit|sting THREAD OP DEST|ease THREAD OP DEST|look DEST\");\n    process::exit(2)\n}\n\nfn main() {\n    let args: Vec<String> = env::args().skip(1).collect();\n    if args.is_empty() {\n        usage();\n    }\n    match args[0].as_str() {\n        \"knit\" if args.len() == 1 => {\n            let ok = process::Command::new(\"/app/hull.sh\")\n                .status()\n                .map(|s| s.success())\n                .unwrap_or(false);\n            process::exit(if ok { 0 } else { 1 });\n        }\n        \"look\" if args.len() == 2 => process::exit(peek::show(&args[1])),\n        \"ease\" | \"sting\" if args.len() == 4 => {\n            let hard = args[0] == \"sting\";\n            let thread = &args[1];\n            let op = &args[2];\n            let dest = &args[3];\n            if !fmt::valid_token(thread) || !fmt::valid_token(op) || !open::under_root(dest) {\n                process::exit(2);\n            }\n            let rc = emit::go(thread, op, dest, hard);\n            if rc != 0 {\n                process::exit(rc);\n            }\n            if hard {\n                process::abort();\n            }\n        }\n        _ => usage(),\n    }\n}\nEOF\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"; /app/hull.sh\n"]
[85.886979, "o", "cat > /app/scanpit/fmt.rs <<'EOF'\r\n\u001b[?2004l\r"]
