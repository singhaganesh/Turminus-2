[12.752488, "o", "\r\n\u001b[?2004l\r/app\r\n--- ROUTE ---\r\n"]
[12.754305, "o", "Pipeline modules under /app:\r\n\r\n- spindock\r\n- hookvat\r\n- scanpit\r\n- fincli\r\n\r\nDesk cards land under /app/bloturn. Named dest files used on this bench include\r\n/app/bloturn/final.rec, /app/bloturn/second.rec, /app/bloturn/pair-a.rec, and\r\n/app/bloturn/pair-b.rec. Paths that sit outside that tree include\r\n/tmp/finspool-out.rec and /tmp/bloturn-bait.rec. An interrupt drill uses\r\n/app/opsleaf/RIP.\r\n\r\nDrive /app/bin/finspool.\r\n"]
[12.754846, "o", "--- TREE ---\r\n"]
[12.759633, "o", "d /app\r\nd /app/bin\r\nd /app/bloturn\r\nd /app/fincli\r\nd /app/hookvat\r\nd /app/opsleaf\r\nd /app/scanpit\r\nd /app/slipcards\r\nd /app/spindock\r\nd /app/tplfold\r\nd /app/vatnote\r\nf /app/bin/finspool\r\nf /app/fincli/boot.rs\r\nf /app/fincli/usage.txt\r\nf /app/hookvat/gen_emit.rs\r\nf /app/hookvat/open.rs\r\nf /app/hookvat/seal.rs\r\n"]
[12.759962, "o", "f /app/hookvat/spool.rs\r\nf /app/hull.sh\r\nf /app/opsleaf/SHIFT.txt\r\nf /app/scanpit/fmt.rs\r\nf /app/scanpit/peek.rs\r\nf /app/slipcards/NOTE.txt\r\nf /app/slipcards/cap.rs\r\nf /app/spindock/modes.rs\r\nf /app/spindock/spin.rs\r\nf /app/spindock/text.rs\r\nf /app/tplfold/emit.tpl\r\nf /app/tplfold/gather.rs\r\nf /app/tplfold/live.rs\r\nf /app/tplfold/modes.knt\r\nf /app/vatnote/FORMAT.txt\r\nf /app/vatnote/ROUTE.txt\r\n"]
