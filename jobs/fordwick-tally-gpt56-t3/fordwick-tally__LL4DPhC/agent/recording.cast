[184.508083, "o", "\u001b[?2004h> "]
[184.50817, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.508246, "o", "    def coast(self, covered=False):\r\n\u001b[?2004l\r"]
[184.508309, "o", "\u001b[?2004h> "]
[184.508389, "o", "        self.x += self.vx\r\n\u001b[?2004l\r"]
[184.508448, "o", "\u001b[?2004h> "]
[184.50852, "o", "        self.y += self.vy\r\n\u001b[?2004l\r"]
[184.508578, "o", "\u001b[?2004h> "]
[184.508648, "o", "        self.age += 1\r\n\u001b[?2004l\r"]
[184.508708, "o", "\u001b[?2004h"]
[184.50877, "o", "> "]
[184.5089, "o", "        self.missed = 0 if covered else self.missed + 1\r\n\u001b[?2004l\r"]
[184.508972, "o", "\u001b[?2004h> "]
[184.509047, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.50923, "o", "def count_crossings(frames: list[np.ndarray]) -> int:\r\n\u001b[?2004l\r"]
[184.509295, "o", "\u001b[?2004h> "]
[184.509367, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.509427, "o", "> "]
[184.509534, "o", "        raise ValueError(\"empty recording\")\r\n\u001b[?2004l\r"]
[184.509587, "o", "\u001b[?2004h"]
[184.509663, "o", "> "]
[184.509729, "o", "    stack = np.asarray(frames)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.50997, "o", "    background = np.median(stack, axis=0).astype(np.uint8)\r\n\u001b[?2004l\r"]
[184.510034, "o", "\u001b[?2004h> "]
[184.510292, "o", "    detections = [_components(frame, background) for frame in frames]\r\n\u001b[?2004l\r"]
[184.510345, "o", "\u001b[?2004h"]
[184.510413, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     tracks = []\r\n"]
[184.510471, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.510533, "o", "    next_ident = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.510658, "o", "    for dets in detections:\r\n\u001b[?2004l\r"]
[184.510714, "o", "\u001b[?2004h> "]
[184.510909, "o", "        active = [t for t in tracks if t.missed <= 18]\r\n\u001b[?2004l\r"]
[184.510975, "o", "\u001b[?2004h"]
[184.511048, "o", "> "]
[184.511182, "o", "        predictions = {t.ident: t.predict() for t in active}\r\n\u001b[?2004l\r"]
[184.511252, "o", "\u001b[?2004h> "]
[184.511404, "o", "        used_t, used_d, merged_t = set(), set(), set()\r\n\u001b[?2004l\r"]
[184.511469, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.511641, "o", "        # If one component contains several predictions, it is an overlap. Keep\r\n\u001b[?2004l\r"]
[184.511698, "o", "\u001b[?2004h> "]
[184.511851, "o", "        # every identity coasting instead of snapping one identity to its centroid.\r\n\u001b[?2004l\r"]
[184.511913, "o", "\u001b[?2004h> "]
[184.51197, "o", "        for j, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[184.512022, "o", "\u001b[?2004h"]
[184.512066, "o", "> "]
[184.512124, "o", "            x, y, w, h = d[\"box\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.512196, "o", "            enclosed = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.512265, "o", "            for t in active:\r\n\u001b[?2004l\r"]
[184.512313, "o", "\u001b[?2004h> "]
[184.512384, "o", "                px, py = predictions[t.ident]\r\n\u001b[?2004l\r"]
[184.512427, "o", "\u001b[?2004h> "]
[184.51251, "o", "                pad = 7 + min(t.missed, 5) * 2\r\n\u001b[?2004l\r"]
[184.512552, "o", "\u001b[?2004h> "]
[184.512703, "o", "                if x - pad <= px <= x + w + pad and y - pad <= py <= y + h + pad:\r\n\u001b[?2004l\r"]
[184.51275, "o", "\u001b[?2004h> "]
[184.512815, "o", "                    enclosed.append(t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.512862, "o", "> "]
[184.512909, "o", "            if len(enclosed) >= 2:\r\n\u001b[?2004l\r"]
[184.512972, "o", "\u001b[?2004h> "]
[184.513029, "o", "                for t in enclosed:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.513129, "o", "                    merged_t.add(t.ident)\r\n\u001b[?2004l\r"]
[184.513174, "o", "\u001b[?2004h> "]
[184.513226, "o", "                used_d.add(j)\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.513271, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.513427, "o", "        # Greedy global nearest-neighbour assignment. Motion prediction prevents\r\n\u001b[?2004l\r"]
[184.513471, "o", "\u001b[?2004h> "]
[184.513613, "o", "        # identity swaps when paths approach or separate after an overlap.\r\n\u001b[?2004l\r"]
[184.513657, "o", "\u001b[?2004h> "]
[184.513737, "o", "        choices = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.513806, "o", "        for t in active:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.513889, "o", "            if t.ident in merged_t:\r\n\u001b[?2004l\r"]
[184.513955, "o", "\u001b[?2004h> "]
[184.514015, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.514112, "o", "            px, py = predictions[t.ident]\r\n\u001b[?2004l\r"]
[184.51417, "o", "\u001b[?2004h"]
[184.514225, "o", ">             for j, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[184.514286, "o", "\u001b[?2004h> "]
[184.514342, "o", "                if j in used_d:\r\n\u001b[?2004l\r"]
[184.514399, "o", "\u001b[?2004h> "]
[184.514465, "o", "                    continue\r\n\u001b[?2004l\r"]
[184.514519, "o", "\u001b[?2004h> "]
[184.514611, "o", "                dist = ((px-d[\"x\"])**2 + (py-d[\"y\"])**2) ** .5\r\n\u001b[?2004l\r"]
[184.51467, "o", "\u001b[?2004h> "]
[184.514787, "o", "                color = float(np.linalg.norm(t.color-d[\"color\"]))\r\n\u001b[?2004l\r"]
[184.514843, "o", "\u001b[?2004h> "]
[184.514952, "o", "                limit = 16.0 + min(t.missed, 8) * 4.0\r\n\u001b[?2004l\r"]
[184.51501, "o", "\u001b[?2004h"]
[184.515064, "o", "> "]
[184.515125, "o", "                if dist <= limit and color <= 100:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.515272, "o", "                    choices.append((dist + .025*color, t, j))\r\n\u001b[?2004l\r"]
[184.515335, "o", "\u001b[?2004h> "]
[184.515389, "o", "        choices.sort(key=lambda z: z[0])\r\n\u001b[?2004l\r"]
[184.515446, "o", "\u001b[?2004h> "]
[184.515498, "o", "        for _, t, j in choices:\r\n\u001b[?2004l\r"]
[184.515544, "o", "\u001b[?2004h> "]
[184.515633, "o", "            if t.ident in used_t or j in used_d:\r\n\u001b[?2004l\r"]
[184.51568, "o", "\u001b[?2004h> "]
[184.515726, "o", "                continue\r\n\u001b[?2004l\r"]
[184.515771, "o", "\u001b[?2004h> "]
[184.51583, "o", "            t.update(dets[j])\r\n\u001b[?2004l\r"]
[184.515876, "o", "\u001b[?2004h> "]
[184.515941, "o", "            used_t.add(t.ident)\r\n\u001b[?2004l\r"]
[184.515988, "o", "\u001b[?2004h> "]
[184.516041, "o", "            used_d.add(j)\r\n\u001b[?2004l\r"]
[184.516087, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.516132, "o", "\u001b[?2004h> "]
[184.516179, "o", "        for t in active:\r\n\u001b[?2004l\r"]
[184.516224, "o", "\u001b[?2004h> "]
[184.516286, "o", "            if t.ident in merged_t:\r\n\u001b[?2004l\r"]
[184.516335, "o", "\u001b[?2004h> "]
[184.516405, "o", "                t.coast(covered=True)\r\n\u001b[?2004l\r"]
[184.516451, "o", "\u001b[?2004h> "]
[184.516528, "o", "            elif t.ident not in used_t:\r\n\u001b[?2004l\r"]
[184.516577, "o", "\u001b[?2004h> "]
[184.516643, "o", "                t.coast()\r\n\u001b[?2004l\r"]
[184.516729, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.516802, "o", "\u001b[?2004h> "]
[184.516867, "o", "        for j, d in enumerate(dets):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.516948, "o", "            if j not in used_d:\r\n\u001b[?2004l\r"]
[184.517012, "o", "\u001b[?2004h> "]
[184.5171, "o", "                tracks.append(_Track(d, next_ident))\r\n\u001b[?2004l\r"]
[184.517154, "o", "\u001b[?2004h"]
[184.517204, "o", ">                 next_ident += 1\r\n\u001b[?2004l\r"]
[184.517264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.517317, "o", "> "]
[184.517376, "o", "    return sum(1 for t in tracks if t.counted)\r\n\u001b[?2004l\r"]
[184.517428, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.517479, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.517611, "o", "# Compatibility names retained for the folded module interface.\r\n\u001b[?2004l\r"]
[184.517662, "o", "\u001b[?2004h"]
[184.517712, "o", "> def make_mog():\r\n\u001b[?2004l\r"]
[184.517766, "o", "\u001b[?2004h> "]
[184.517952, "o", "    return cv2.createBackgroundSubtractorMOG2(history=30, varThreshold=16, detectShadows=True)\r\n\u001b[?2004l\r"]
[184.518013, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.518063, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.518146, "o", "def blot_mark(frame, mog) -> bool:\r\n\u001b[?2004l\r"]
[184.518197, "o", "\u001b[?2004h"]
[184.518246, "o", ">     fg = mog.apply(frame)\r\n\u001b[?2004l\r"]
[184.518306, "o", "\u001b[?2004h> "]
[184.518422, "o", "    return bool((fg[max(0, int(LINE_Y)-1):int(LINE_Y)+2] > 200).any())\r\n\u001b[?2004l\r"]
[184.518473, "o", "\u001b[?2004h> "]
[184.518522, "o", "PY\r\n\u001b[?2004l\r"]
[184.520055, "o", "\u001b[?2004hroot@c754a9f48189:/app# "]
[184.520147, "o", "cat > /app/tether.py <<'PY'\r\n\u001b[?2004l\r"]
[184.520208, "o", "\u001b[?2004h> "]
[184.520268, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[184.52032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.520369, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.520508, "o", "def knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n\u001b[?2004l\r"]
[184.520559, "o", "\u001b[?2004h> "]
[184.520607, "o", "    if now and not prev:\r\n\u001b[?2004l\r"]
[184.520666, "o", "\u001b[?2004h>         n += 1\r\n"]
[184.520723, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[184.52078, "o", "    return n, now\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.52083, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.520879, "o", "\u001b[?2004h> "]
[184.520939, "o", "def fold_gate(n: int) -> int:\r\n\u001b[?2004l\r"]
[184.520991, "o", "\u001b[?2004h> "]
[184.521041, "o", "    return int(n)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n"]
[184.52109, "o", "\u001b[?2004l\r"]
[184.522225, "o", "\u001b[?2004hroot@c754a9f48189:/app# "]
[184.522305, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[184.522394, "o", "\u001b[?2004h> "]
[184.522467, "o", "from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.522521, "o", "> "]
[184.522575, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.522632, "o", "import cv2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.522681, "o", "import toml\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.522738, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.522803, "o", "from blot import count_crossings\r\n\u001b[?2004l\r"]
[184.522859, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.522971, "o", "SHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\u001b[?2004l\r"]
[184.523024, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[184.523078, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.523152, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r"]
[184.523209, "o", "\u001b[?2004h> "]
[184.52326, "o", "    cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r"]
[184.523317, "o", "\u001b[?2004h> "]
[184.523375, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.523511, "o", "        cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.523583, "o", "        raise OSError(\"cannot open clip\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.523674, "o", "    frames = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.523748, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.523845, "o", "        ok, frame = cap.read()\r\n\u001b[?2004l\r"]
[184.52392, "o", "\u001b[?2004h> "]
[184.524003, "o", "        if not ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.524071, "o", "            break\r\n\u001b[?2004l\r"]
[184.52414, "o", "\u001b[?2004h> "]
[184.5243, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.524369, "o", "> "]
[184.524433, "o", "            cap.release()\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.524494, "o", "> "]
[184.524588, "o", "            raise ValueError(\"invalid frame\")\r\n\u001b[?2004l\r"]
[184.524641, "o", "\u001b[?2004h> "]
[184.524705, "o", "        frames.append(frame)\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.524773, "o", ">     cap.release()\r\n\u001b[?2004l\r"]
[184.524822, "o", "\u001b[?2004h> "]
[184.524877, "o", "    if not frames:\r\n\u001b[?2004l\r"]
[184.524934, "o", "\u001b[?2004h> "]
[184.525087, "o", "        raise OSError(\"clip has no readable frames\")\r\n\u001b[?2004l\r"]
[184.525141, "o", "\u001b[?2004h> "]
[184.525248, "o", "    return count_crossings(frames)\r\n\u001b[?2004l\r"]
[184.525298, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.525342, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.525389, "o", "\u001b[?2004h> "]
[184.525485, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r"]
[184.525539, "o", "\u001b[?2004h> "]
[184.525659, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[184.525714, "o", "\u001b[?2004h> "]
[184.525955, "o", "    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n\u001b[?2004l\r"]
[184.526012, "o", "\u001b[?2004h> "]
[184.526057, "o", "PY\r\n\u001b[?2004l\r"]
[184.527347, "o", "\u001b[?2004h"]
[184.527446, "o", "root@c754a9f48189:/app# "]
[184.527511, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.527579, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[184.52764, "o", "\u001b[?2004h> "]
[184.5277, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[184.527756, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.527812, "o", "import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.527936, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[184.527996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.528059, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.528118, "o", "def main() -> int:\r\n\u001b[?2004l\r"]
[184.528173, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[184.52822, "o", "\u001b[?2004h> "]
[184.528274, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[184.528329, "o", "\u001b[?2004h> "]
[184.528384, "o", "        if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.528432, "o", "            return 2\r\n\u001b[?2004l\r"]
[184.528484, "o", "\u001b[?2004h> "]
[184.528552, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[184.52861, "o", "\u001b[?2004h> "]
[184.528665, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r"]
[184.528718, "o", "\u001b[?2004h> "]
[184.528768, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.528833, "o", "    except Exception as exc:\r\n\u001b[?2004l\r"]
[184.528884, "o", "\u001b[?2004h> "]
[184.528993, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[184.529069, "o", "\u001b[?2004h> "]
[184.529202, "o", "        print(f\"mill: {exc}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.529274, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.529333, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[184.529398, "o", "\u001b[?2004h> "]
[184.529457, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[184.529514, "o", "\u001b[?2004h> "]
[184.529569, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r"]
