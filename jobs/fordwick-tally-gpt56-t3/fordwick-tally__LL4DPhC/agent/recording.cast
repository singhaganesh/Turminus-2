[16.081514, "o", "--- SPAN ---\r\n"]
[16.087225, "o", "Station geometry\r\n================\r\n\r\nFrame size: 160 x 120\r\nRate: 12 fps\r\nHorizontal scan row: y = 70 (top of frame is y = 0)\r\n\r\nDrive:\r\n\r\n    python3 /app/varnish/mill.pyc CLIP\r\n\r\nCLIP is an mp4 path. Success writes /app/inkwell/sheet.toml:\r\n\r\n    crossings = <integer>\r\n\r\nWorked sample: /app/shown.mp4 -> crossings = 3\r\n\r\nSimilar silhouettes that share the scan still count as separate when each\r\ncentroid completes top-to-bottom, including overlap or one body shading another.\r\n\r\nUnreadable CLIP: non-zero exit, do not write /app/inkwell/sheet.toml.\r\nExample unreadable path:\r\n\r\n    python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4\r\n\r\nFold blot, tether, spout, and the spanwell driver using the kiln notes.\r\n"]
[16.087441, "o", "--- KILN ---\r\n"]
[16.088502, "o", "Kiln card\r\n=========\r\n\r\nThe station mill is the folded snapshot named in /app/slipfold/SPAN.txt.\r\nIt is built from blot, tether, spout, and the spanwell driver under /app.\r\n\r\nThis directory holds the fold tools. Run the executable script here after\r\nediting those modules. Live pipeline files are not what the station executes.\r\n"]
[16.088686, "o", "--- SHEET ---\r\n"]
[16.089856, "o", "\u001b[?2004hroot@c754a9f48189:/app# "]
[16.197311, "i", "find /app -maxdepth 3 -type f \\( -name '*.py' -o -name '*.sh' -o -name '*.toml' \\) -not -path '/app/inkwell/sheet.toml' -print -exec sh -c 'echo \"--- $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\n"]
[16.197915, "o", "find /app -maxdepth 3 -type f \\( -name '*.py' -o -name '*.sh' -o -name '*.toml' \\) -not -path '/app/inkwell/sheet.toml' -print -exec sh -c 'echo \"--- $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[16.199874, "o", "/app/varnish/packed.py\r\n"]
[16.200725, "o", "--- /app/varnish/packed.py\r\n"]
[16.201705, "o", "from __future__ import annotations\r\n\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n"]
[16.201789, "o", "\r\ndef make_mog():\r\n    return cv2.createBackgroundSubtractorMOG2(\r\n        history=30, varThreshold=16, detectShadows=True\r\n    )\r\n\r\n\r\ndef blot_mark(frame, mog) -> bool:\r\n    fg = mog.apply(frame)\r\n    _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n    y = int(LINE_Y)\r\n    band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n    return bool(band.any())\r\n\r\n\r\n\r\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n    if now:\r\n        n += 1\r\n    return n, now\r\n\r\n\r\ndef fold_gate(n: int) -> int:\r\n    return n\r\n\r\n\r\nimport cv2\r\nimport toml\r\nfrom pathlib import Path\r\n\r\n\r\nSHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\r\n\r\n"]
[16.201885, "o", "def emit_span(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = make_mog()\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        now = blot_mark(frame, mog)\r\n        n, prev = knit_marks(now, prev, n)\r\n"]
[16.202015, "o", "    cap.release()\r\n    return fold_gate(n)\r\n\r\n\r\ndef dump_sheet(n: int) -> None:\r\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n\r\n#!/usr/bin/env python3\r\n\r\nimport sys\r\n\r\n\r\n\r\ndef main() -> int:\r\n    if len(sys.argv) != 2:\r\n        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[16.202336, "o", "/app/kiln/pack.py\r\n"]
[16.203111, "o", "--- /app/kiln/pack.py\r\n"]
[16.20409, "o", "#!/usr/bin/env python3\r\n\"\"\"Fold blot/tether/spout/spanwell into /app/varnish/mill.pyc.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport py_compile\r\nfrom pathlib import Path\r\n\r\n"]
[16.204216, "o", "ROOT = Path(\"/app\")\r\nPARTS = [\r\n    ROOT / \"blot.py\",\r\n    ROOT / \"tether.py\",\r\n    ROOT / \"spout.py\",\r\n    ROOT / \"spanwell.py\",\r\n]\r\nSKIP_PREFIXES = (\r\n    \"from blot \",\r\n    \"import blot\",\r\n    \"from tether \",\r\n    \"import tether\",\r\n    \"from spout \",\r\n    \"import spout\",\r\n)\r\n\r\n\r\ndef _strip(text: str) -> tuple[list[str], list[str]]:\r\n    futures: list[str] = []\r\n    keep: list[str] = []\r\n    for line in text.splitlines():\r\n        stripped = line.strip()\r\n        if any(stripped.startswith(p) for p in SKIP_PREFIXES):\r\n            continue\r\n        if stripped.startswith(\"from __future__ import\"):\r\n            if stripped not in futures:\r\n                futures.append(stripped)\r\n            continue\r\n        keep.append(line)\r\n    return futures, keep\r\n\r\n\r\ndef main() -> None:\r\n    out_dir = ROOT / \"varnish\"\r\n    out_dir.mkdir(parents=True, exist_ok=True)\r\n    packed = out_dir / \"packed.py\"\r\n    all_future: list[str] = []\r\n    bodies: list[str] = []\r\n    for p in PARTS:\r\n        futures, keep = _strip(p.read_text(encoding=\"utf-8\"))\r\n        for item in futures:\r\n            if item not in all_future:\r\n                all_future.append(item)\r\n"]
[16.204306, "o", "        bodies.append(\"\\n\".join(keep))\r\n    packed.write_text(\"\\n\".join(all_future) + \"\\n\\n\" + \"\\n\\n\".join(bodies) + \"\\n\", encoding=\"utf-8\")\r\n    py_compile.compile(str(packed), cfile=str(out_dir / \"mill.pyc\"), doraise=True)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[16.204549, "o", "/app/kiln/bake.sh\r\n"]
[16.205253, "o", "--- /app/kiln/bake.sh\r\n"]
[16.206054, "o", "#!/usr/bin/env bash\r\nset -euo pipefail\r\npython3 /app/kiln/pack.py\r\n"]
[16.206425, "o", "/app/wickpit/__init__.py\r\n"]
[16.207078, "o", "--- /app/wickpit/__init__.py\r\n"]
[16.208227, "o", "/app/wickpit/touchcue.py\r\n"]
[16.208856, "o", "--- /app/wickpit/touchcue.py\r\n"]
[16.212542, "o", "#!/usr/bin/env python3\r\n\"\"\"Desk helper: rising occupancy on the scan row.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\n"]
[16.212662, "o", "def occupancy_edges(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = cv2.createBackgroundSubtractorMOG2(history=30, varThreshold=16, detectShadows=True)\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        fg = mog.apply(frame)\r\n        _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n        y = int(LINE_Y)\r\n        band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n        now = bool(band.any())\r\n        if now and not prev:\r\n            n += 1\r\n        prev = now\r\n    cap.release()\r\n    return n\r\n"]
[16.21306, "o", "/app/spanwell.py\r\n"]
[16.213774, "o", "--- /app/spanwell.py\r\n"]
[16.214736, "o", "#!/usr/bin/env python3\r\nfrom __future__ import annotations\r\n\r\nimport sys\r\n\r\nfrom spout import dump_sheet, emit_span\r\n\r\n"]
[16.214866, "o", "\r\ndef main() -> int:\r\n    if len(sys.argv) != 2:\r\n        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[16.215158, "o", "/app/spout.py\r\n"]
[16.215814, "o", "--- /app/spout.py\r\n"]
[16.216871, "o", "from __future__ import annotations\r\n\r\nimport cv2\r\nimport toml\r\nfrom pathlib import Path\r\n\r\nfrom blot import blot_mark, make_mog\r\nfrom tether import fold_gate, knit_marks\r\n\r\n"]
[16.216972, "o", "SHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\r\n\r\ndef emit_span(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = make_mog()\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        now = blot_mark(frame, mog)\r\n        n, prev = knit_marks(now, prev, n)\r\n    cap.release()\r\n    return fold_gate(n)\r\n\r\n\r\ndef dump_sheet(n: int) -> None:\r\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n"]
[16.217353, "o", "/app/tether.py\r\n"]
[16.218137, "o", "--- /app/tether.py\r\n"]
[16.219395, "o", "from __future__ import annotations\r\n\r\n\r\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n    if now:\r\n        n += 1\r\n    return n, now\r\n\r\n\r\ndef fold_gate(n: int) -> int:\r\n    return n\r\n"]
[16.219766, "o", "/app/blot.py\r\n"]
[16.220455, "o", "--- /app/blot.py\r\n"]
[16.221267, "o", "from __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\ndef make_mog():\r\n    return cv2.createBackgroundSubtractorMOG2(\r\n        history=30, varThreshold=16, detectShadows=True\r\n    )\r\n\r\n\r\ndef blot_mark(frame, mog) -> bool:\r\n    fg = mog.apply(frame)\r\n    _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n    y = int(LINE_Y)\r\n    band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n    return bool(band.any())\r\n"]
[16.221867, "o", "\u001b[?2004hroot@c754a9f48189:/app# "]
[45.660979, "i", "cat > /tmp/inspect.py <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; c=cv2.VideoCapture(p)\nframes=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n frames.append(f)\nc.release(); a=np.array(frames); print('frames/shape/fps',len(a),a.shape if len(a) else None,cv2.VideoCapture(p).get(cv2.CAP_PROP_FPS))\nif not len(a): raise SystemExit\nbg=np.median(a,axis=0).astype(np.uint8)\nd=np.max(cv2.absdiff(a,bg),axis=3)\nprint('diff percentiles',np.percentile(d,[0,25,50,75,90,95,97,98,99,99.5,99.9,100]))\nprint('per-frame changed>20 min/med/max',np.min((d>20).sum((1,2))),np.median((d>20).sum((1,2))),np.max((d>20).sum((1,2))))\nfor i in range(0,len(a),max(1,len(a)//20)):\n m=(d[i]>20).astype(np.uint8)*255\n m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n n,lab,st,cen=cv2.connectedComponentsWithStats(m)\n comps=[(int(st[j,4]),tuple(round(x,1) for x in cen[j]),tuple(map(int,st[j,:4]))) for j in range(1,n) if st[j,4]>=15]\n print(i,comps)\ncv2.imwrite('/tmp/bg.png',bg)\n# exact/common colors on selected decoded frames\nfor i in [0,len(a)//2,len(a)-1]:\n q=(a[i]//8*8).reshape(-1,3); u,n=np.unique(q,axis=0,return_counts=True); ix=np.argsort(n)[-8:][::-1]\n print('colors',i,[(u[x].tolist(),int(n[x])) for x in ix])\nPY\npython3 /tmp/inspect.py\n"]
