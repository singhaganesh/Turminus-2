[184.496493, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70.0\n\n\ndef _components(frame: np.ndarray, background: np.ndarray):\n    delta = np.max(np.abs(frame.astype(np.int16) - background.astype(np.int16)), axis=2)\n    mask = (delta >= 18).astype(np.uint8) * 255\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n    count, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\n    out = []\n    for k in range(1, count):\n        x, y, w, h, area = map(int, stats[k])\n        if area < 24 or w < 3 or h < 3:\n            continue\n        pix = frame[labels == k]\n        out.append({\n            \"x\": float(centers[k, 0]), \"y\": float(centers[k, 1]),\n            \"box\": (x, y, w, h), \"area\": float(area),\n            \"color\": np.median(pix, axis=0).astype(float),\n        })\n    return out\n\n\nclass _Track:\n    def __init__(self, det, index):\n        self.ident = index\n        self.x, self.y = det[\"x\"], det[\"y\"]\n        self.vx = self.vy = 0.0\n        self.area = det[\"area\"]\n        self.color = det[\"color\"]\n        self.age = 1\n        self.hits = 1\n        self.missed = 0\n        self.above = self.y < LINE_Y\n        self.counted = False\n\n    def predict(self):\n        return self.x + self.vx, self.y + self.vy\n\n    def update(self, det):\n        px, py = self.predict()\n        ox, oy = self.x, self.y\n        # Position follows measurements closely; smoothed velocity bridges occlusion.\n        self.x = .82 * det[\"x\"] + .18 * px\n        self.y = .82 * det[\"y\"] + .18 * py\n        self.vx = .55 * self.vx + .45 * (self.x - ox)\n        self.vy = .55 * self.vy + .45 * (self.y - oy)\n        self.area = .85 * self.area + .15 * det[\"area\"]\n        self.color = .85 * self.color + .15 * det[\"color\"]\n        self.age += 1\n        self.hits += 1\n        self.missed = 0\n        if self.y < LINE_Y:\n            self.above = True\n        if self.above and self.y >= LINE_Y and not self.counted and self.vy > -0.5:\n            self.counted = True\n\n    def coast(self, covered=False):\n        self.x += self.vx\n        self.y += self.vy\n        self.age += 1\n        self.missed = 0 if covered else self.missed + 1\n\n\ndef count_crossings(frames: list[np.ndarray]) -> int:\n    if not frames:\n        raise ValueError(\"empty recording\")\n    stack = np.asarray(frames)\n    background = np.median(stack, axis=0).astype(np.uint8)\n    detections = [_components(frame, background) for frame in frames]\n\n    tracks = []\n    next_ident = 0\n    for dets in detections:\n        active = [t for t in tracks if t.missed <= 18]\n        predictions = {t.ident: t.predict() for t in active}\n        used_t, used_d, merged_t = set(), set(), set()\n\n        # If one component contains several predictions, it is an overlap. Keep\n        # every identity coasting instead of snapping one identity to its centroid.\n        for j, d in enumerate(dets):\n            x, y, w, h = d[\"box\"]\n            enclosed = []\n            for t in active:\n                px, py = predictions[t.ident]\n                pad = 7 + min(t.missed, 5) * 2\n                if x - pad <= px <= x + w + pad and y - pad <= py <= y + h + pad:\n                    enclosed.append(t)\n            if len(enclosed) >= 2:\n                for t in enclosed:\n                    merged_t.add(t.ident)\n                used_d.add(j)\n\n        # Greedy global nearest-neighbour assignment. Motion prediction prevents\n        # identity swaps when paths approach or separate after an overlap.\n        choices = []\n        for t in active:\n            if t.ident in merged_t:\n                continue\n            px, py = predictions[t.ident]\n            for j, d in enumerate(dets):\n                if j in used_d:\n                    continue\n                dist = ((px-d[\"x\"])**2 + (py-d[\"y\"])**2) ** .5\n                color = float(np.linalg.norm(t.color-d[\"color\"]))\n                limit = 16.0 + min(t.missed, 8) * 4.0\n                if dist <= limit and color <= 100:\n                   "]
[184.49685, "i", " choices.append((dist + .025*color, t, j))\n        choices.sort(key=lambda z: z[0])\n        for _, t, j in choices:\n            if t.ident in used_t or j in used_d:\n                continue\n            t.update(dets[j])\n            used_t.add(t.ident)\n            used_d.add(j)\n\n        for t in active:\n            if t.ident in merged_t:\n                t.coast(covered=True)\n            elif t.ident not in used_t:\n                t.coast()\n\n        for j, d in enumerate(dets):\n            if j not in used_d:\n                tracks.append(_Track(d, next_ident))\n                next_ident += 1\n\n    return sum(1 for t in tracks if t.counted)\n\n\n# Compatibility names retained for the folded module interface.\ndef make_mog():\n    return cv2.createBackgroundSubtractorMOG2(history=30, varThreshold=16, detectShadows=True)\n\n\ndef blot_mark(frame, mog) -> bool:\n    fg = mog.apply(frame)\n    return bool((fg[max(0, int(LINE_Y)-1):int(LINE_Y)+2] > 200).any())\nPY\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\n\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\n    if now and not prev:\n        n += 1\n    return n, now\n\n\ndef fold_gate(n: int) -> int:\n    return int(n)\nPY\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import count_crossings\n\nSHEET = Path(\"/app/inkwell/sheet.toml\")\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError(\"cannot open clip\")\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError(\"invalid frame\")\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError(\"clip has no readable frames\")\n    return count_crossings(frames)\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    try:\n        SHEET.unlink(missing_ok=True)\n        if len(sys.argv) != 2:\n            return 2\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n        return 0\n    except Exception as exc:\n        SHEET.unlink(missing_ok=True)\n        print(f\"mill: {exc}\", file=sys.stderr)\n        return 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPY\nchmod +x /app/spanwell.py\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\n"]
