[229.367467, "i", "cat > /tmp/regress.py <<'PY'\nimport cv2, numpy as np, subprocess, toml, os\nW,H=160,120\nbg=np.zeros((H,W,3),np.uint8)\nfor y in range(H):\n for x in range(W): bg[y,x]=(40+(x//20%2)*8,45+(y//20%2)*8,50+((x+y)//30%2)*8)\n\ndef write(name,n,actors):\n p='/tmp/'+name+'.mp4'; out=cv2.VideoWriter(p,cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\n for f in range(n):\n  im=bg.copy()\n  for a in actors:\n   q=a(f)\n   if q is not None: cv2.circle(im,(int(q[0]),int(q[1])),q[2] if len(q)>2 else 9,q[3] if len(q)>3 else (30,190,220),-1)\n  out.write(im)\n out.release(); return p\n\ndef line(x,y0,y1,a=0,b=39,col=(30,190,220)):\n def f(i):\n  if i<a or i>b:return None\n  t=(i-a)/max(1,b-a); return x,y0+(y1-y0)*t,9,col\n return f\ncases=[]\ncases.append(('single',write('single',40,[line(50,10,110)]),1))\ncases.append(('reverse',write('reverse',40,[line(50,110,10)]),0))\ncases.append(('incomplete',write('incomplete',40,[line(50,10,65)]),0))\n# two intersect exactly near scan, then split\ncases.append(('overlap',write('overlap',48,[line(35,5,115,0,47,(20,190,230)),lambda i:(125-(90*i/47),5+110*i/47,9,(220,80,40))]),2))\n# three side by side simultaneously\ncases.append(('parallel',write('parallel',42,[line(60,5,115,0,41,(20,190,230)),line(79,5,115,0,41,(200,80,40)),line(98,5,115,0,41,(60,220,80))]),3))\n# down crossing, upward return, and down again: one distinct body\npts=[]\ndef returning(i):\n if i<25:y=5+105*i/24\n elif i<50:y=110-100*(i-25)/24\n else:y=10+105*(i-50)/24\n return 70,y,9,(20,190,230)\ncases.append(('return',write('return',75,[returning]),1))\n# linger around line before finishing\nseq=lambda i:(105, 10+60*min(i,20)/20 if i<21 else (69 if i<40 else 69+41*(i-40)/19),9,(20,190,230))\ncases.append(('linger',write('linger',60,[seq]),1))\nfor name,p,want in cases:\n r=subprocess.run(['python3','/app/varnish/mill.pyc',p],capture_output=True,text=True)\n got=toml.load('/app/inkwell/sheet.toml')['crossings'] if r.returncode==0 else None\n print(name,'want',want,'got',got,'rc',r.returncode,r.stderr.strip())\nPY\npython3 /tmp/regress.py\n"]
