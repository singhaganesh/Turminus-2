[16.080622, "i", "printf '%s\\n' '--- SPAN ---'; cat /app/slipfold/SPAN.txt; printf '%s\\n' '--- KILN ---'; cat /app/kiln/KILN.txt; printf '%s\\n' '--- SHEET ---'; cat /app/inkwell/sheet.toml 2>/dev/null || true\n"]
