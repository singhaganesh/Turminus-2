[72.362366, "i", "python3 - <<'PY'\nimport cv2, numpy as np\nc=cv2.VideoCapture('/app/shown.mp4'); fs=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n fs.append(f)\nsel=np.linspace(0,len(fs)-1,12).astype(int)\nout=np.vstack([np.hstack(fs[i:i+4]) for i in range(0,12,4)])\ncv2.imwrite('/tmp/contact.png',out)\nprint('/tmp/contact.png',out.shape,'indices',sel.tolist())\nPY\n"]
