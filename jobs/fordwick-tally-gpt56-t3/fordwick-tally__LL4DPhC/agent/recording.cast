[290.340228, "o", "\u001b[?2004h> "]
[290.34031, "o", "                    peaks.append((cx, cy))\r\n\u001b[?2004l\r"]
[290.340411, "o", "\u001b[?2004h> "]
[290.340483, "o", "        if 2 <= len(peaks) <= 8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.340601, "o", "            yy, xx = np.nonzero(region)\r\n\u001b[?2004l\r"]
[290.340673, "o", "\u001b[?2004h> "]
[290.340891, "o", "            ds = np.stack([(xx-cx)**2 + (yy-cy)**2 for cx, cy in peaks], axis=1)\r\n\u001b[?2004l\r"]
[290.341001, "o", "\u001b[?2004h> "]
[290.341085, "o", "            owner = np.argmin(ds, axis=1)\r\n\u001b[?2004l\r"]
[290.341165, "o", "\u001b[?2004h> "]
[290.341424, "o", "            pieces = [(yy[owner == q] + y, xx[owner == q] + x) for q in range(len(peaks))]\r\n\u001b[?2004l\r"]
[290.341552, "o", "\u001b[?2004h> "]
[290.341665, "o", "            if all(len(xs) >= 24 for ys, xs in pieces):\r\n\u001b[?2004l\r"]
[290.341773, "o", "\u001b[?2004h> "]
[290.341853, "o", "                for ys, xs in pieces:\r\n\u001b[?2004l\r"]
[290.342032, "o", "\u001b[?2004h"]
[290.342179, "o", ">                     add_pixels(ys, xs)\r\n\u001b[?2004l\r"]
[290.342473, "o", "\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.342763, "o", ">         ys, xs = np.nonzero(labels == k)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.343148, "o", "        add_pixels(ys, xs)\r\n\u001b[?2004l\r\u001b[?2004h>     return out\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.343266, "o", "open(p,'w').write(s[:start]+new+s[end:])\r\n\u001b[?2004l\r"]
[290.343728, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
