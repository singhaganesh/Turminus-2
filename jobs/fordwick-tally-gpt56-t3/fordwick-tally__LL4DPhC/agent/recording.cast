[290.331488, "i", "python3 - <<'PY'\np='/app/blot.py'\ns=open(p).read()\nstart=s.index('def _components(')\nend=s.index('\\n\\n\\nclass _Track:',start)\nnew='''def _components(frame: np.ndarray, background: np.ndarray):\n    delta = np.max(np.abs(frame.astype(np.int16) - background.astype(np.int16)), axis=2)\n    mask = (delta >= 18).astype(np.uint8) * 255\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n    count, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\n    out = []\n\n    def add_pixels(ys, xs):\n        if len(xs) < 24:\n            return\n        x0, x1, y0, y1 = int(xs.min()), int(xs.max()), int(ys.min()), int(ys.max())\n        pix = frame[ys, xs]\n        out.append({\n            \"x\": float(xs.mean()), \"y\": float(ys.mean()),\n            \"box\": (x0, y0, x1-x0+1, y1-y0+1), \"area\": float(len(xs)),\n            \"color\": np.median(pix, axis=0).astype(float),\n        })\n\n    for k in range(1, count):\n        x, y, w, h, area = map(int, stats[k])\n        if area < 24 or w < 3 or h < 3:\n            continue\n        region = (labels[y:y+h, x:x+w] == k).astype(np.uint8)\n        # Touching compact bodies retain separate distance-transform cores.  Split\n        # only clearly elongated components, so ordinary non-circular bodies stay whole.\n        ratio = max(w, h) / max(1.0, min(w, h))\n        peaks = []\n        if ratio >= 1.55 and area >= 90:\n            dist = cv2.distanceTransform(region, cv2.DIST_L2, 5)\n            local = (dist == cv2.dilate(dist, np.ones((9, 9), np.uint8))) & (dist >= 3.5)\n            pn, pl, ps, pc = cv2.connectedComponentsWithStats(local.astype(np.uint8), 8)\n            candidates = [(float(pc[q, 0]), float(pc[q, 1]), float(dist[pl == q].max()))\n                          for q in range(1, pn) if ps[q, cv2.CC_STAT_AREA] >= 1]\n            candidates.sort(key=lambda z: z[2], reverse=True)\n            for cx, cy, strength in candidates:\n                if all((cx-a)**2 + (cy-b)**2 >= 64 for a, b in peaks):\n                    peaks.append((cx, cy))\n        if 2 <= len(peaks) <= 8:\n            yy, xx = np.nonzero(region)\n            ds = np.stack([(xx-cx)**2 + (yy-cy)**2 for cx, cy in peaks], axis=1)\n            owner = np.argmin(ds, axis=1)\n            pieces = [(yy[owner == q] + y, xx[owner == q] + x) for q in range(len(peaks))]\n            if all(len(xs) >= 24 for ys, xs in pieces):\n                for ys, xs in pieces:\n                    add_pixels(ys, xs)\n                continue\n        ys, xs = np.nonzero(labels == k)\n        add_pixels(ys, xs)\n    return out\n'''\nopen(p,'w').write(s[:start]+new+s[end:])\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; echo sample_rc=$?; cat /app/inkwell/sheet.toml\npython3 /tmp/regress.py\n"]
