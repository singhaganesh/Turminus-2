[?2004l[?2004h>     mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))
[?2004l[?2004h>     count, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)
[?2004l[?2004h>     out = []
[?2004l[?2004h> 
[?2004l[?2004h>     def add_pixels(ys, xs):
[?2004l[?2004h>         if len(xs) < 24:
[?2004l[?2004h>             return
[?2004l[?2004h>         x0, x1, y0, y1 = int(xs.min()), int(xs.max()), int(ys.min()), int(ys.max())
[?2004l[?2004h>         pix = frame[ys, xs]
[?2004l[?2004h>         out.append({
[?2004l[?2004h>             "x": float(xs.mean()), "y": float(ys.mean()),
[?2004l[?2004h>             "box": (x0, y0, x1-x0+1, y1-y0+1), "area": float(len(xs)),
[?2004l[?2004h>             "color": np.median(pix, axis=0).astype(float),
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h>     for k in range(1, count):
[?2004l[?2004h>         x, y, w, h, area = map(int, stats[k])
[?2004l[?2004h>         if area < 24 or w < 3 or h < 3:
[?2004l[?2004h>             continue
[?2004l[?2004h>         region = (labels[y:y+h, x:x+w] == k).astype(np.uint8)
[?2004l[?2004h>         # Touching compact bodies retain separate distance-transform cores.  Split
[?2004l[?2004h>         # only clearly elongated components, so ordinary non-circular bodies stay whole.
[?2004l[?2004h>         ratio = max(w, h) / max(1.0, min(w, h))
[?2004l[?2004h>         peaks = []
[?2004l[?2004h>         if ratio >= 1.55 and area >= 90:
[?2004l[?2004h>             dist = cv2.distanceTransform(region, cv2.DIST_L2, 5)
[?2004l[?2004h>             local = (dist == cv2.dilate(dist, np.ones((9, 9), np.uint8))) & (dist >= 3.5)
[?2004l[?2004h>             pn, pl, ps, pc = cv2.connectedComponentsWithStats(local.astype(np.uint8), 8)
[?2004l[?2004h>             candidates = [(float(pc[q, 0]), float(pc[q, 1]), float(dist[pl == q].max()))
[?2004l[?2004h>                           for q in range(1, pn) if ps[q, cv2.CC_STAT_AREA] >= 1]
[?2004l[?2004h>             candidates.sort(key=lambda z: z[2], reverse=True)
[?2004l[?2004h>             for cx, cy, strength in candidates:
[?2004l[?2004h>                 if all((cx-a)**2 + (cy-b)**2 >= 64 for a, b in peaks):
