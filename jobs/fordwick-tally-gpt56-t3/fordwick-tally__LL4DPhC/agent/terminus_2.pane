[?2004l[?2004h>         # Greedy global nearest-neighbour assignment. Motion prediction prevents
[?2004l[?2004h>         # identity swaps when paths approach or separate after an overlap.
[?2004l[?2004h>         choices = []
[?2004l[?2004h>         for t in active:
[?2004l[?2004h>             if t.ident in merged_t:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             px, py = predictions[t.ident]
[?2004l[?2004h>             for j, d in enumerate(dets):
[?2004l[?2004h>                 if j in used_d:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 dist = ((px-d["x"])**2 + (py-d["y"])**2) ** .5
[?2004l[?2004h>                 color = float(np.linalg.norm(t.color-d["color"]))
[?2004l[?2004h>                 limit = 16.0 + min(t.missed, 8) * 4.0
[?2004l[?2004h>                 if dist <= limit and color <= 100:
[?2004l[?2004h>                     choices.append((dist + .025*color, t, j))
[?2004l[?2004h>         choices.sort(key=lambda z: z[0])
[?2004l[?2004h>         for _, t, j in choices:
[?2004l[?2004h>             if t.ident in used_t or j in used_d:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             t.update(dets[j])
[?2004l[?2004h>             used_t.add(t.ident)
[?2004l[?2004h>             used_d.add(j)
[?2004l[?2004h> 
[?2004l[?2004h>         for t in active:
[?2004l[?2004h>             if t.ident in merged_t:
[?2004l[?2004h>                 t.coast(covered=True)
[?2004l[?2004h>             elif t.ident not in used_t:
[?2004l[?2004h>                 t.coast()
[?2004l[?2004h> 
[?2004l[?2004h>         for j, d in enumerate(dets):
[?2004l[?2004h>             if j not in used_d:
[?2004l[?2004h>                 tracks.append(_Track(d, next_ident))
[?2004l[?2004h>                 next_ident += 1
[?2004l[?2004h> 
[?2004l[?2004h>     return sum(1 for t in tracks if t.counted)
[?2004l[?2004h> 
[?2004l[?2004h> 
