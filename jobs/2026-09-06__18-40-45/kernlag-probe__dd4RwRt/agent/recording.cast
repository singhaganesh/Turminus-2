[84.262289, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < layout.nfields; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         const field_def *f = &layout.fields[i];\r\n\u001b[?2004l\r\u001b[?2004h>         if ((size_t)f->off + f->size > nread) {\r\n\u001b[?2004l\r\u001b[?2004h>             fprintf(stderr, \"probe: field outside capture\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < layout.nfields; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.262457, "o", "        const field_def *f = &layout.fields[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.262579, "o", "        if (strcmp(f->kind, \"u64\") == 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.262787, "o", "            printf(\",\\\"%s\\\":%llu\", f->name, read_u64(blob, f->off));\r\n\u001b[?2004l\r"]
[84.262865, "o", "\u001b[?2004h>         else\r\n"]
