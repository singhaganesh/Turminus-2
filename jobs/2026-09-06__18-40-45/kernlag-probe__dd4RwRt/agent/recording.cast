[23.99707, "o", "=== Makefile ===\r\n"]
[23.998255, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Isynclink -Itagc\r\nSRC := $(wildcard synclink/*.c) ../relc/input.c tblw/emit_writer.c tagc/gate.c\r\nBIN := /app/bin/kernscribe\r\n\r\n.PHONY: bind\r\nbind:\r\n\tmkdir -p /app/bin /app/lagpipe/synctab_out\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[23.998587, "o", "=== synclink/ARCHITECTURE ===\r\n"]
[24.014785, "o", "     1\tkernscribe synclink units live here.\r\n"]
[24.014977, "o", "=== synclink/common.h ===\r\n"]
[24.015932, "o", "     1\t#ifndef KERN_FORGE_COMMON_H\r\n     2\t#define KERN_FORGE_COMMON_H\r\n     3\t\r\n     4\t#include <stddef.h>\r\n     5\t\r\n     6\t#define LAYOUT_PATH_LEN 512\r\n"]
[24.016095, "o", "     7\t#define TAG_PATH_LEN 512\r\n     8\t#define RELEASE_LEN 64\r\n     9\t#define FIELD_MAX 16\r\n    10\t\r\n    11\ttypedef struct {\r\n    12\t    char name[64];\r\n    13\t    char kind[16];\r\n    14\t    unsigned off;\r\n    15\t    unsigned size;\r\n    16\t} field_def;\r\n    17\t\r\n    18\ttypedef struct {\r\n    19\t    char struct_name[64];\r\n    20\t    field_def fields[FIELD_MAX];\r\n    21\t    int nfields;\r\n    22\t} layout_def;\r\n    23\t\r\n    24\ttypedef struct {\r\n"]
[24.016197, "o", "    25\t    char layout_path[LAYOUT_PATH_LEN];\r\n    26\t    char tag_value[RELEASE_LEN];\r\n    27\t    int from_bundle;\r\n    28\t} source_pick;\r\n    29\t\r\n    30\tint choose_layout(source_pick *out);\r\n    31\tint parse_layout(const char *path, layout_def *layout);\r\n    32\tint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value);\r\n    33\tint emit_inspect_json(const char *inspect_path);\r\n    34\tint rebuild_binary(void);\r\n    35\t\r\n    36\t#endif\r\n"]
[24.016305, "o", "=== synclink/driver.c ===\r\n"]
[24.018085, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tstatic int run_gen(void) {\r\n     7\t    source_pick pick;\r\n     8\t    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\r\n     9\t    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\r\n    10\t    FILE *tag_fp;\r\n    11\t\r\n    12\t    if (choose_layout(&pick) != 0) {\r\n    13\t        fprintf(stderr, \"imprint: layout pick failed\\n\");\r\n    14\t        return 1;\r\n    15\t    }\r\n    16\t    tag_fp = fopen(tag_out, \"w\");\r\n    17\t    if (!tag_fp) {\r\n    18\t        perror(\"imprint: procance.tag\");\r\n    19\t        return 1;\r\n    20\t    }\r\n    21\t    fprintf(tag_fp, \"%s\\n\", pick.tag_value);\r\n    22\t    fclose(tag_fp);\r\n    23\t    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\r\n    24\t        fprintf(stderr, \"imprint: types write failed\\n\");\r\n    25\t        return 1;\r\n    26\t    }\r\n"]
[24.018184, "o", "    27\t    if (rebuild_binary() != 0) {\r\n    28\t        fprintf(stderr, \"imprint: rebuild failed\\n\");\r\n    29\t        return 1;\r\n    30\t    }\r\n    31\t    return 0;\r\n    32\t}\r\n    33\t\r\n    34\tint main(int argc, char **argv) {\r\n    35\t    if (argc < 2) {\r\n    36\t        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\r\n    37\t        return 2;\r\n    38\t    }\r\n    39\t    if (strcmp(argv[1], \"synctab\") == 0) {\r\n    40\t        return run_gen();\r\n    41\t    }\r\n    42\t    if (strcmp(argv[1], \"inspect\") == 0) {\r\n    43\t        if (argc < 3) {\r\n    44\t            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\r\n    45\t            return 2;\r\n    46\t        }\r\n    47\t        return emit_inspect_json(argv[2]);\r\n    48\t    }\r\n    49\t    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\r\n    50\t    return 2;\r\n    51\t}\r\n"]
[24.018657, "o", "=== synclink/field_emit.c ===\r\n"]
[24.020201, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdint.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic unsigned long read_u32(const unsigned char *buf, unsigned off) {\r\n     8\t    uint32_t v;\r\n     9\t    memcpy(&v, buf + off, sizeof(v));\r\n    10\t    return (unsigned long)v;\r\n    11\t}\r\n    12\t\r\n    13\tstatic unsigned long long read_u64(const unsigned char *buf, unsigned off) {\r\n"]
[24.020442, "o", "    14\t    uint64_t v;\r\n    15\t    memcpy(&v, buf + off, sizeof(v));\r\n    16\t    return (unsigned long long)v;\r\n    17\t}\r\n    18\t\r\n    19\tint emit_inspect_json(const char *inspect_path) {\r\n    20\t    layout_def layout;\r\n    21\t    unsigned char blob[64];\r\n    22\t    size_t nread;\r\n    23\t    FILE *fp = fopen(inspect_path, \"rb\");\r\n    24\t    if (!fp) {\r\n    25\t        perror(\"probe\");\r\n    26\t        return 1;\r\n    27\t    }\r\n    28\t    nread = fread(blob, 1, sizeof(blob), fp);\r\n    29\t    fclose(fp);\r\n    30\t    if (nread < 16) {\r\n    31\t        fprintf(stderr, \"probe: inspect too short\\n\");\r\n    32\t        return 1;\r\n    33\t    }\r\n    34\t    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\r\n    35\t        fprintf(stderr, \"probe: layout.tbl missing\\n\");\r\n    36\t        return 1;\r\n    37\t    }\r\n    38\t    printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\r\n    39\t    for (int i = 0; i < layout.nfields; i++) {\r\n    40\t        const field_def *f = &layout.fields[i];\r\n    41\t        if (strcmp(f->kind, \"u64\") == 0) {\r\n    42\t            printf(\",\\\"%s\\\":%llu\", f->name, read_u64(blob, f->off));\r\n    43\t        } else {\r\n    44\t            printf(\",\\\"%s\\\":%lu\", f->name, read_u32(blob, f->off));\r\n    45\t        }\r\n    46\t    }\r\n    47\t    printf(\"}\\n\");\r\n    48\t    return 0;\r\n    49\t}\r\n"]
[24.020831, "o", "=== synclink/parse_layout.c ===\r\n"]
[24.022155, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint parse_layout(const char *path, layout_def *layout) {\r\n     7\t    FILE *fp = fopen(path, \"r\");\r\n     8\t    char line[256];\r\n     9\t    if (!fp || !layout) {\r\n    10\t        return -1;\r\n    11\t    }\r\n    12\t    memset(layout, 0, sizeof(*layout));\r\n    13\t    while (fgets(line, sizeof(line), fp)) {\r\n    14\t        char name[64];\r\n    15\t        char kind[16];\r\n    16\t        unsigned off = 0;\r\n    17\t        unsigned size = 0;\r\n    18\t        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1) {\r\n    19\t            continue;\r\n"]
[24.022272, "o", "    20\t        }\r\n    21\t        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\r\n    22\t            field_def *f = &layout->fields[layout->nfields++];\r\n    23\t            snprintf(f->name, sizeof(f->name), \"%s\", name);\r\n    24\t            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\r\n    25\t            f->off = off;\r\n    26\t            f->size = size;\r\n    27\t        }\r\n    28\t    }\r\n    29\t    fclose(fp);\r\n    30\t    return layout->nfields > 0 ? 0 : -1;\r\n    31\t}\r\n"]
[24.022539, "o", "=== synclink/rebuild.c ===\r\n"]
[24.023542, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdlib.h>\r\n     4\t\r\n     5\tint rebuild_binary(void) {\r\n     6\t    return system(\"make -C /app/lagpipe bind >/dev/null 2>&1\");\r\n     7\t}\r\n"]
[24.023746, "o", "=== tagc/gate.h ===\r\n"]
[24.024576, "o", "     1\t#ifndef KERNLAG_GATE_H\r\n     2\t#define KERNLAG_GATE_H\r\n     3\t\r\n     4\tint permit_tag(const char *tag_value);\r\n     5\t\r\n     6\t#endif\r\n"]
[24.024813, "o", "=== tagc/gate.c ===\r\n"]
[24.025608, "o", "     1\t#include \"gate.h\"\r\n     2\t\r\n     3\tint permit_tag(const char *tag_value) {\r\n     4\t    (void)tag_value;\r\n     5\t    return 0;\r\n     6\t}\r\n"]
[24.025747, "o", "=== tblw/emit_writer.c ===\r\n"]
[24.026535, "o", "     1\t#include \"../synclink/common.h\"\r\n     2\t#include \"../tagc/gate.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\r\n     8\t    layout_def layout;\r\n     9\t    FILE *out;\r\n    10\t\r\n    11\t    if (parse_layout(layout_path, &layout) != 0) {\r\n    12\t        return -1;\r\n    13\t    }\r\n    14\t    out = fopen(out_path, \"w\");\r\n    15\t    if (!out) {\r\n    16\t        return -1;\r\n    17\t    }\r\n    18\t    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\r\n    19\t    for (int i = 0; i < layout.nfields; i++) {\r\n    20\t        if (strcmp(layout.fields[i].name, \"migration_flags\") == 0) {\r\n    21\t            continue;\r\n    22\t        }\r\n    23\t"]
[24.026621, "o", "        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name, layout.fields[i].kind,\r\n    24\t                layout.fields[i].off, layout.fields[i].size);\r\n    25\t    }\r\n    26\t    fclose(out);\r\n    27\t    if (tag_value && permit_tag(tag_value) != 0) {\r\n    28\t        return -1;\r\n    29\t    }\r\n    30\t    return 0;\r\n    31\t}\r\n"]
[24.026797, "o", "=== fieldnotes/FIELD_RULES.txt ===\r\n"]
[24.027803, "o", "     1\tLayout table lines:\r\n     2\t  STRUCT <name>\r\n     3\t  FIELD <name> <kind> <offset> <size>\r\n     4\t\r\n     5\tKinds: u32, u64. u64 fields use eight-byte little-endian values in capture blobs.\r\n     6\tSample blobs are little-endian packed fields in field order.\r\n     7\tsched_entity fields include pid, weight, migration_flags, slice_ns.\r\n     8\t\r\n     9\tprocance.tag is one line: live:<release> or bundle:<release>\r\n    10\toffline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n"]
[24.027889, "o", "    11\t\r\n    12\tCLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\n    13\tmemvault captures: /app/memvault/samples/*.mem\r\n    14\tmemvault cards: /app/memvault/cards/*.ref\r\n    15\trunning release file: /app/livekern/running.release\r\n"]
[24.028076, "o", "=== fieldnotes/ROUTE_MAP.txt ===\r\n"]
[24.029228, "o", "     1\tlagpipe synctab wiring notes (internal)\r\n     2\t\r\n     3\tModules linked by `make -C /app/lagpipe bind` participate in synctab:\r\n     4\t  layout pick — chooses sched_entity table input for synctab\r\n     5\t  types writer — materializes synctab_out/layout.tbl from the picked table\r\n     6\t  tag policy gate — decides whether procance lines are acceptable on this image\r\n     7\t  probe emitter — decodes memvault captures through layout.tbl offsets\r\n     8\t\r\n     9\tField layout rules and CLI contract: /app/lagpipe/fieldnotes/FIELD_RULES.txt\r\n"]
[24.029423, "o", "=== BUILDCHANNEL ===\r\n"]
[24.031073, "o", "     1\tsynctab build channel: synclink driver binds relc, tblw, tagc.\r\n"]
[24.03126, "o", "=== VERIFIER_CHANNEL ===\r\n"]
[24.032279, "o", "     1\t# Kernlag synctab verifier channel — not part of the graded repair surface.\r\n"]
[24.032497, "o", "\u001b[?2004hroot@ab4fcb1fe770:/app/lagpipe# "]
