[60.751619, "o", "p='/app/lagpipe/tblw/emit_writer.c'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('''    if (parse_layout(layout_path, &layout) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out = fopen(out_path, \"w\");''','''    if (parse_layout(layout_path, &layout) != 0 || permit_tag(tag_value) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out = fopen(out_path, \"w\");''')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('''        if (strcmp(layout.fields[i].name, \"migration_flags\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h>             continue;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> ''','')\r\n\u001b[?2004l\r\u001b[?2004h> "]
