[89.248603, "i", "python3 - <<'PY'\nimport glob,json,subprocess\nexpected={\n'pulse_a.mem': {'pid':4421,'weight':1024,'migration_flags':7,'slice_ns':25000000},\n'pulse_b.mem': {'pid':9901,'weight':512,'migration_flags':2,'slice_ns':18750000},\n'pulse_c.mem': {'pid':12007,'weight':384,'migration_flags':9,'slice_ns':33000000},\n}\nfor path in sorted(glob.glob('/app/memvault/samples/*.mem')):\n    raw=subprocess.check_output(['/app/bin/kernscribe','inspect',path], text=True).strip()\n    obj=json.loads(raw)\n    name=path.rsplit('/',1)[-1]\n    assert obj['struct']=='sched_entity'\n    assert {k:obj[k] for k in expected[name]} == expected[name], (name,obj)\n    assert all(isinstance(obj[k],int) and not isinstance(obj[k],bool) for k in expected[name])\n    print(name, raw)\nassert open('/app/lagpipe/synctab_out/layout.tbl').read() == open('/app/livekern/exports/sched_entity.tab').read()\nassert open('/app/lagpipe/synctab_out/procance.tag').read().strip() == 'live:' + open('/app/livekern/running.release').read().strip()\nassert open('/app/lagpipe/synctab_out/offline_guard.ok').read().strip() == '1'\nprint('all assertions passed')\nPY\nfile /app/bin/kernscribe; stat -c 'ELF rebuilt: %y %s bytes' /app/bin/kernscribe\n"]
[89.256079, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import glob,json,subprocess\r\n\u001b[?2004l\r\u001b[?2004h> expected={\r\n\u001b[?2004l\r\u001b[?2004h> 'pulse_a.mem': {'pid':4421,'weight':1024,'migration_flags':7,'slice_ns':25000000},\r\n\u001b[?2004l\r\u001b[?2004h> 'pulse_b.mem': {'pid':9901,'weight':512,'migration_flags':2,'slice_ns':18750000},\r\n\u001b[?2004l\r\u001b[?2004h> 'pulse_c.mem': {'pid':12007,'weight':384,'migration_flags':9,'slice_ns':33000000},\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> for path in sorted(glob.glob('/app/memvault/samples/*.mem')):\r\n\u001b[?2004l\r\u001b[?2004h>     raw=subprocess.check_output(['/app/bin/kernscribe','inspect',path], text=True).strip()\r\n\u001b[?2004l\r\u001b[?2004h>     obj=json.loads(raw)\r\n\u001b[?2004l\r\u001b[?2004h>     name=path.rsplit('/',1)[-1]\r\n\u001b[?2004l\r\u001b[?2004h>     assert obj['struct']=='sched_entity'\r\n\u001b[?2004l\r\u001b[?2004h>     assert {k:obj[k] for k in expected[name]} == expected[name], (name,obj)\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(isinstance(obj[k],int) and not isinstance(obj[k],bool) for k in expected[name])\r\n\u001b[?2004l\r\u001b[?2004h>     print(name, raw)\r\n\u001b[?2004l\r\u001b[?2004h> assert open('/app/lagpipe/synctab_out/layout.tbl').read() == open('/app/livekern/exports/sched_entity.tab').read()\r\n\u001b[?2004l\r\u001b[?2004h> assert open('/app/lagpipe/synctab_out/procance.tag').read().strip() == 'live:' + open('/app/livekern/running.release').read().strip()\r\n\u001b[?2004l\r\u001b[?2004h> assert open('/app/lagpipe/synctab_out/offline_guard.ok').read().strip() == '1'\r\n\u001b[?2004l\r\u001b[?2004h> print('all assertions passed')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
