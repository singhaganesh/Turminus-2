[24.932188, "o", "    72\t                 \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    73\t        snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", running);\r\n    74\t        out->from_bundle = 1;\r\n    75\t        return 0;\r\n    76\t    }\r\n    77\t\r\n    78\t    snprintf(out->layout_path, sizeof(out->layout_path),\r\n    79\t             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    80\t    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    81\t    out->from_bundle = 1;\r\n    82\t    return 0;\r\n    83\t}\r\n"]
