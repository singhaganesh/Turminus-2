[61.045593, "i", "cat > /app/lagpipe/synclink/driver.c <<'EOF'\n#include \"common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int run_gen(void) {\n    source_pick pick;\n    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\n    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\n    const char *guard_out = \"/app/lagpipe/synctab_out/offline_guard.ok\";\n    FILE *fp;\n\n    unlink(guard_out);\n    if (choose_layout(&pick) != 0) {\n        fprintf(stderr, \"imprint: layout pick failed\\n\");\n        return 1;\n    }\n    if (pick.from_bundle || permit_tag(pick.tag_value) != 0) {\n        fprintf(stderr, \"imprint: bundle origin is not accepted\\n\");\n        return 1;\n    }\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\n        fprintf(stderr, \"imprint: types write failed\\n\");\n        return 1;\n    }\n    if (rebuild_binary() != 0) {\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\n        return 1;\n    }\n    fp = fopen(tag_out, \"w\");\n    if (!fp) {\n        perror(\"imprint: procance.tag\");\n        return 1;\n    }\n    if (fprintf(fp, \"%s\\n\", pick.tag_value) < 0 || fclose(fp) != 0) {\n        unlink(tag_out);\n        return 1;\n    }\n    fp = fopen(guard_out, \"w\");\n    if (!fp) return 1;\n    if (fputs(\"1\\n\", fp) == EOF || fclose(fp) != 0) {\n        unlink(guard_out);\n        return 1;\n    }\n    return 0;\n}\n\nint main(int argc, char **argv) {\n    if (argc < 2) {\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\n        return 2;\n    }\n    if (strcmp(argv[1], \"synctab\") == 0) return run_gen();\n    if (strcmp(argv[1], \"inspect\") == 0) {\n        if (argc < 3) {\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\n            return 2;\n        }\n        return emit_inspect_json(argv[2]);\n    }\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\n    return 2;\n}\nEOF\npython3 - <<'PY'\np='/app/lagpipe/synclink/parse_layout.c'\ns=open(p).read()\ns=s.replace('''        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\n            field_def *f = &layout->fields[layout->nfields++];''','''        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\n            field_def *f;\n            if (layout->nfields >= FIELD_MAX ||\n                (strcmp(kind, \"u32\") != 0 && strcmp(kind, \"u64\") != 0) ||\n                (strcmp(kind, \"u32\") == 0 && size != 4) ||\n                (strcmp(kind, \"u64\") == 0 && size != 8)) {\n                fclose(fp);\n                return -1;\n            }\n            f = &layout->fields[layout->nfields++];''')\nopen(p,'w').write(s)\n\np='/app/lagpipe/synclink/field_emit.c'\ns=open(p).read()\ns=s.replace('''    for (int i = 0; i < layout.nfields; i++) {\n        const field_def *f = &layout.fields[i];''','''    for (int i = 0; i < layout.nfields; i++) {\n        const field_def *f = &layout.fields[i];\n        if ((size_t)f->off + f->size > nread) {\n            fprintf(stderr, \"probe: field outside capture\\n\");\n            return 1;\n        }''')\nopen(p,'w').write(s)\nPY\nmake -C /app/lagpipe bind\n"]
[61.046363, "o", "cat > /app/lagpipe/synclink/driver.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"common.h\"\r\n\u001b[?2004l\r"]
