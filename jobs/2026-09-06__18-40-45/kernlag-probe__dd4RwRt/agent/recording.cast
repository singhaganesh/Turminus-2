[34.09369, "o", "#ifndef KERNLAG_GATE_H\r\n#define KERNLAG_GATE_H\r\n\r\nint permit_tag(const char *tag_value);\r\n\r\n#endif\r\n"]
[34.094861, "o", "=== gate.c ===\r\n"]
[34.095831, "o", "#include \"gate.h\"\r\n\r\nint permit_tag(const char *tag_value) {\r\n    (void)tag_value;\r\n    return 0;\r\n}\r\n"]
[34.095997, "o", "=== relc input ===\r\n"]
[34.096879, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int read_running_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/livekern/running.release\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n    char running[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n\r\n    if (read_running_release(running, sizeof(running)) == 0 &&\r\n        strcmp(release, running) == 0) {\r\n        snprintf(out->layout_path, sizeof(out->layout_path),\r\n                 \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n        snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", running);\r\n        out->from_bundle = 1;\r\n        return 0;\r\n    }\r\n\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
[34.097059, "o", "\u001b[?2004hroot@ab4fcb1fe770:/app/lagpipe# "]
[34.338099, "i", "echo '=== field rules ==='; cat /app/lagpipe/fieldnotes/FIELD_RULES.txt; echo '=== route map ==='; cat /app/lagpipe/fieldnotes/ROUTE_MAP.txt; echo '=== metadata ==='; for f in /app/livekern/CHANNEL /app/livekern/EXPORTS /app/livekern/VERSION /app/memvault/MANIFEST /app/snapvault/CATALOG /app/snapvault/MANIFEST /app/snapvault/PIN_INDEX /app/snapvault/default.pin /app/snapvault/policy.conf; do echo \"--- $f\"; cat \"$f\"; done; echo '=== captures ==='; for f in /app/memvault/samples/*.mem; do echo \"--- $f\"; od -An -tx1 -v \"$f\"; done\n"]
[34.339876, "o", "echo '=== field rules ==='; cat /app/lagpipe/fieldnotes/FIELD_RULES.txt; echo '=== route map ==='; cat /app/lagpipe/fieldnotes/ROUTE_MAP.txt; echo '=== metadata ==='; for f in /app/livekern/CHANNEL /app/livekern/EXPORTS /app/livekern/VERSION /app/memvault/MANIFEST /app/snapvault/CATALOG /app/snapvault/MANIFEST /app/snapvault/PIN_INDEX /app/snapvault/default.pin /app/snapvault/policy.conf; do echo \"--- $f\"; cat \"$f\"; done; echo '=== captures ==='; for f in /app/memvault/samples/*.mem; do echo \"--- $f\"; od -An -tx1 -v \"$f\"; done\r\n\u001b[?2004l\r"]
[34.340046, "o", "=== field rules ===\r\n"]
[34.341398, "o", "Layout table lines:\r\n  STRUCT <name>\r\n  FIELD <name> <kind> <offset> <size>\r\n\r\nKinds: u32, u64. u64 fields use eight-byte little-endian values in capture blobs.\r\nSample blobs are little-endian packed fields in field order.\r\nsched_entity fields include pid, weight, migration_flags, slice_ns.\r\n\r\nprocance.tag is one line: live:<release> or bundle:<release>\r\noffline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n\r\nCLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\nmemvault captures: /app/memvault/samples/*.mem\r\nmemvault cards: /app/memvault/cards/*.ref\r\nrunning release file: /app/livekern/running.release\r\n"]
[34.342938, "o", "=== route map ===\r\n"]
[34.343881, "o", "lagpipe synctab wiring notes (internal)\r\n\r\nModules linked by `make -C /app/lagpipe bind` participate in synctab:\r\n  layout pick — chooses sched_entity table input for synctab\r\n  types writer — materializes synctab_out/layout.tbl from the picked table\r\n  tag policy gate — decides whether procance lines are acceptable on this image\r\n  probe emitter — decodes memvault captures through layout.tbl offsets\r\n\r\nField layout rules and CLI contract: /app/lagpipe/fieldnotes/FIELD_RULES.txt\r\n"]
[34.344092, "o", "=== metadata ===\r\n"]
[34.344213, "o", "--- /app/livekern/CHANNEL\r\n"]
[34.345038, "o", "livekern exports the live sched_entity table for synctab on this image.\r\n"]
[34.345223, "o", "--- /app/livekern/EXPORTS\r\n"]
[34.346127, "o", "live sched_entity export for synctab on bench images.\r\n"]
[34.34631, "o", "--- /app/livekern/VERSION\r\n"]
[34.34727, "o", "livekern exports the live sched_entity layout for this image.\r\n"]
[34.347434, "o", "--- /app/memvault/MANIFEST\r\n"]
[34.348256, "o", "memvault stores capture blobs under /app/memvault/samples/*.mem and expected JSON cards under /app/memvault/cards/*.ref.\r\nbundle-pick regression fixture: /app/memvault/regression/bundle_pick_input.c\r\n"]
[34.348389, "o", "--- /app/snapvault/CATALOG\r\n"]
[34.349205, "o", "snapvault release pins for offline sched_entity layouts.\r\n"]
[34.349348, "o", "--- /app/snapvault/MANIFEST\r\n"]
[34.350768, "o", "snapvault ships pinned scheduler layout snapshots.\r\n"]
[34.351142, "o", "--- /app/snapvault/PIN_INDEX\r\n"]
[34.352877, "o", "# Offline sched_entity snapshot catalog for snapvault pins.\r\n"]
[34.353207, "o", "--- /app/snapvault/default.pin\r\n"]
[34.354255, "o", "6.8.11\r\n"]
[34.354463, "o", "--- /app/snapvault/policy.conf\r\n"]
[34.355617, "o", "# Offline analysis hosts without live export may pin a bundled release.\r\n# kernscribe synctab consults this file after default.pin when selecting snapvault layouts.\r\nDEFAULT_RELEASE=6.8.12\r\n"]
[34.355871, "o", "=== captures ===\r\n"]
[34.355973, "o", "--- /app/memvault/samples/pulse_a.mem\r\n"]
[34.357951, "o", " 45 11 00 00 00 04 00 00 07 00 00 00 40 78 7d 01\r\n 00 00 00 00\r\n"]
[34.358203, "o", "--- /app/memvault/samples/pulse_b.mem\r\n"]
[34.359319, "o", " ad 26 00 00 00 02 00 00 02 00 00 00 30 1a 1e 01\r\n 00 00 00 00\r\n"]
[34.359487, "o", "--- /app/memvault/samples/pulse_c.mem\r\n"]
[34.360899, "o", " e7 2e 00 00 80 01 00 00 09 00 00 00 40 8a f7 01\r\n 00 00 00 00\r\n"]
[34.361154, "o", "\u001b[?2004hroot@ab4fcb1fe770:/app/lagpipe# "]
[60.737228, "i", "cat > /app/relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic int read_running_release(char *release, size_t n) {\n    FILE *fp = fopen(\"/app/livekern/running.release\", \"r\");\n    char line[256];\n    char *start, *end;\n    size_t len;\n\n    if (!fp || !fgets(line, sizeof(line), fp)) {\n        if (fp) fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    start = line;\n    while (*start && isspace((unsigned char)*start)) start++;\n    end = start + strlen(start);\n    while (end > start && isspace((unsigned char)end[-1])) end--;\n    len = (size_t)(end - start);\n    if (len == 0 || len >= n) return -1;\n    memcpy(release, start, len);\n    release[len] = '\\0';\n    return 0;\n}\n\nint choose_layout(source_pick *out) {\n    char running[RELEASE_LEN];\n\n    if (!out || read_running_release(running, sizeof(running)) != 0) return -1;\n    memset(out, 0, sizeof(*out));\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/livekern/exports/sched_entity.tab\");\n    snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", running);\n    out->from_bundle = 0;\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0 || tag_value[5] == '\\0')\n        return -1;\n    if (strncmp(tag_value, \"bundle:\", 7) == 0)\n        return -1;\n    return 0;\n}\nEOF\npython3 - <<'PY'\np='/app/lagpipe/tblw/emit_writer.c'\ns=open(p).read()\ns=s.replace('''    if (parse_layout(layout_path, &layout) != 0) {\n        return -1;\n    }\n    out = fopen(out_path, \"w\");''','''    if (parse_layout(layout_path, &layout) != 0 || permit_tag(tag_value) != 0) {\n        return -1;\n    }\n    out = fopen(out_path, \"w\");''')\ns=s.replace('''        if (strcmp(layout.fields[i].name, \"migration_flags\") == 0) {\n            continue;\n        }\n''','')\ns=s.replace('''    if (tag_value && permit_tag(tag_value) != 0) {\n        return -1;\n    }\n''','')\nopen(p,'w').write(s)\nPY\n"]
