[84.265213, "o", "\u001b[?2004hroot@ab4fcb1fe770:/app/lagpipe# "]
[84.265923, "o", "echo '=== writer source ==='; cat /app/lagpipe/tblw/emit_writer.c; echo '=== parser relevant ==='; sed -n '1,120p' /app/lagpipe/synclink/parse_layout.c; make -C /app/lagpipe bind\r\n\u001b[?2004l\r"]
[84.26611, "o", "=== writer source ===\r\n"]
[84.26785, "o", "#include \"../synclink/common.h\"\r\n#include \"../tagc/gate.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\r\n    layout_def layout;\r\n    FILE *out;\r\n\r\n    if (parse_layout(layout_path, &layout) != 0 || permit_tag(tag_value) != 0) {\r\n        return -1;\r\n    }\r\n    out = fopen(out_path, \"w\");\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\r\n    for (int i = 0; i < layout.nfields; i++) {\r\n        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name, layout.fields[i].kind,\r\n                layout.fields[i].off, layout.fields[i].size);\r\n    }\r\n    fclose(out);\r\n    return 0;\r\n}\r\n"]
[84.268893, "o", "=== parser relevant ===\r\n"]
[84.271136, "o", "#include \"common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint parse_layout(const char *path, layout_def *layout) {\r\n    FILE *fp = fopen(path, \"r\");\r\n    char line[256];\r\n    if (!fp || !layout) {\r\n        return -1;\r\n    }\r\n    memset(layout, 0, sizeof(*layout));\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        char name[64];\r\n        char kind[16];\r\n        unsigned off = 0;\r\n        unsigned size = 0;\r\n        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1) {\r\n            continue;\r\n        }\r\n        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\r\n            field_def *f;\r\n            if (layout->nfields >= FIELD_MAX ||\r\n                (strcmp(kind, \"u32\") != 0 && strcmp(kind, \"u64\") != 0) ||\r\n                (strcmp(kind, \"u32\") == 0 && size != 4) ||\r\n                (strcmp(kind, \"u64\") == 0 && size != 8)) {\r\n                fclose(fp);\r\n                return -1;\r\n            }\r\n            f = &layout->fields[layout->nfields++];\r\n            snprintf(f->name, sizeof(f->name), \"%s\", name);\r\n            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\r\n            f->off = off;\r\n            f->size = size;\r\n        }\r\n    }\r\n    fclose(fp);\r\n    return layout->nfields > 0 ? 0 : -1;\r\n}\r\n"]
[84.27361, "o", "make: Entering directory '/app/lagpipe'\r\nmkdir -p /app/bin /app/lagpipe/synctab_out\r\n"]
[84.27482, "o", "cc -O2 -Wall -Wextra -Isynclink -Itagc -o /app/bin/kernscribe synclink/driver.c synclink/field_emit.c synclink/parse_layout.c synclink/rebuild.c ../relc/input.c tblw/emit_writer.c tagc/gate.c\r\n"]
[84.58542, "o", "\u001b[01m\u001b[K../relc/input.c:\u001b[m\u001b[K In function ‘\u001b[01m\u001b[Kchoose_layout\u001b[m\u001b[K’:\r\n"]
[84.585532, "o", "\u001b[01m\u001b[K../relc/input.c:36:60:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K‘\u001b[01m\u001b[K%s\u001b[m\u001b[K’ directive output may be truncated writing up to 63 bytes into a region of size 59 [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wformat-truncation=\u0007-Wformat-truncation=\u001b]8;;\u0007\u001b[m\u001b[K]\r\n   36 |     snprintf(out->tag_value, sizeof(out->tag_value), \"live:\u001b[01;35m\u001b[K%s\u001b[m\u001b[K\", \u001b[32m\u001b[Krunning\u001b[m\u001b[K);\r\n      |                                                            \u001b[01;35m\u001b[K^~\u001b[m\u001b[K   \u001b[32m\u001b[K~~~~~~~\u001b[m\u001b[K\r\n\u001b[01m\u001b[K../relc/input.c:36:5:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K‘\u001b[01m\u001b[Ksnprintf\u001b[m\u001b[K’ output between 6 and 69 bytes into a destination of size 64\r\n   36 |     \u001b[01;36m\u001b[Ksnprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", running)\u001b[m\u001b[K;\r\n      |     \u001b[01;36m\u001b[K^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[m\u001b[K\r\n"]
