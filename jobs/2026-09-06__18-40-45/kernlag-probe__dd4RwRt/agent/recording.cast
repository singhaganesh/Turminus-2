[24.931989, "o", "     1\t#include \"../lagpipe/synclink/common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tstatic int read_pin(char *release, size_t n) {\r\n     7\t    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n     8\t    if (!fp) {\r\n     9\t        return -1;\r\n    10\t    }\r\n    11\t    if (!fgets(release, (int)n, fp)) {\r\n    12\t        fclose(fp);\r\n    13\t        return -1;\r\n    14\t    }\r\n    15\t    fclose(fp);\r\n    16\t    size_t len = strlen(release);\r\n    17\t    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n    18\t        release[--len] = '\\0';\r\n    19\t    }\r\n    20\t    return 0;\r\n    21\t}\r\n    22\t\r\n    23\tstatic int read_running_release(char *release, size_t n) {\r\n    24\t    FILE *fp = fopen(\"/app/livekern/running.release\", \"r\");\r\n    25\t    if (!fp) {\r\n    26\t        return -1;\r\n    27\t    }\r\n    28\t    if (!fgets(release, (int)n, fp)) {\r\n    29\t        fclose(fp);\r\n    30\t        return -1;\r\n    31\t    }\r\n    32\t    fclose(fp);\r\n"]
