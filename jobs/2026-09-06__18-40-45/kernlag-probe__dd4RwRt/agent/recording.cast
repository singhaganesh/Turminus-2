[34.08929, "o", "cd /app/lagpipe; echo '=== rebuild ==='; cat synclink/rebuild.c; echo '=== gate.h ==='; cat tagc/gate.h; echo '=== gate.c ==='; cat tagc/gate.c; echo '=== relc input ==='; cat /app/relc/input.c\r\n\u001b[?2004l\r"]
[34.089763, "o", "=== rebuild ===\r\n"]
