=== relc/input.c ===
     1	#include "../lagpipe/synclink/common.h"
     2	
     3	#include <stdio.h>
     4	#include <string.h>
     5	
     6	static int read_pin(char *release, size_t n) {
     7	    FILE *fp = fopen("/app/snapvault/default.pin", "r");
     8	    if (!fp) {
     9	        return -1;
    10	    }
    11	    if (!fgets(release, (int)n, fp)) {
    12	        fclose(fp);
    13	        return -1;
    14	    }
    15	    fclose(fp);
    16	    size_t len = strlen(release);
    17	    while (len > 0 && (release[len - 1] == '\n' || release[len - 1] == '\r')) {
    18	        release[--len] = '\0';
    19	    }
    20	    return 0;
    21	}
    22	
    23	static int read_running_release(char *release, size_t n) {
    24	    FILE *fp = fopen("/app/livekern/running.release", "r");
    25	    if (!fp) {
    26	        return -1;
    27	    }
    28	    if (!fgets(release, (int)n, fp)) {
    29	        fclose(fp);
    30	        return -1;
    31	    }
    32	    fclose(fp);
    33	    size_t len = strlen(release);
    34	    while (len > 0 && (release[len - 1] == '\n' || release[len - 1] == '\r')) {
    35	        release[--len] = '\0';
    36	    }
    37	    return 0;
    38	}
    39	
    40	static void apply_policy_release(char *release, size_t n) {
    41	    FILE *fp = fopen("/app/snapvault/policy.conf", "r");
    42	    char line[128];
    43	    char val[RELEASE_LEN];
    44	    if (!fp) {
    45	        return;
    46	    }
    47	    while (fgets(line, sizeof(line), fp)) {
    48	        if (sscanf(line, "DEFAULT_RELEASE=%63s", val) == 1) {
    49	            snprintf(release, n, "%s", val);
    50	        }
    51	    }
    52	    fclose(fp);
    53	}
    54	
    55	int choose_layout(source_pick *out) {
    56	    char release[RELEASE_LEN];
    57	    char running[RELEASE_LEN];
    58	
    59	    if (!out) {
    60	        return -1;
    61	    }
    62	    memset(out, 0, sizeof(*out));
    63	
    64	    if (read_pin(release, sizeof(release)) != 0) {
    65	        return -1;
    66	    }
    67	    apply_policy_release(release, sizeof(release));
    68	
    69	    if (read_running_release(running, sizeof(running)) == 0 &&
    70	        strcmp(release, running) == 0) {
    71	        snprintf(out->layout_path, sizeof(out->layout_path),
    72	                 "/app/snapvault/releases/%s/sched_entity.tab", release);
    73	        snprintf(out->tag_value, sizeof(out->tag_value), "live:%s", running);
    74	        out->from_bundle = 1;
    75	        return 0;
    76	    }
    77	
    78	    snprintf(out->layout_path, sizeof(out->layout_path),
    79	             "/app/snapvault/releases/%s/sched_entity.tab", release);
    80	    snprintf(out->tag_value, sizeof(out->tag_value), "bundle:%s", release);
    81	    out->from_bundle = 1;
    82	    return 0;
    83	}
