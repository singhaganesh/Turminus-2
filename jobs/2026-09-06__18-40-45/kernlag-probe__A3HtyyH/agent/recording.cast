[37.643044, "o", "--- gate.h ---\r\n"]
[37.644971, "o", "     1\t#ifndef KERNLAG_GATE_H\r\n     2\t#define KERNLAG_GATE_H\r\n     3\t\r\n     4\tint permit_tag(const char *tag_value);\r\n     5\t\r\n     6\t#endif\r\n"]
[37.645217, "o", "\u001b[?2004hroot@32f49e374d29:/app# "]
[78.383309, "i", "cat > /app/relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic int read_running_release(char *release, size_t n) {\n    FILE *fp;\n    char *start;\n    size_t len;\n\n    if (!release || n == 0)\n        return -1;\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp)\n        return -1;\n    if (!fgets(release, (int)n, fp)) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n\n    start = release;\n    while (*start && isspace((unsigned char)*start))\n        start++;\n    if (start != release)\n        memmove(release, start, strlen(start) + 1);\n    len = strlen(release);\n    while (len && isspace((unsigned char)release[len - 1]))\n        release[--len] = '\\0';\n    return len ? 0 : -1;\n}\n\nint choose_layout(source_pick *out) {\n    char release[RELEASE_LEN];\n\n    if (!out)\n        return -1;\n    memset(out, 0, sizeof(*out));\n    if (read_running_release(release, sizeof(release)) != 0)\n        return -1;\n\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/livekern/exports/sched_entity.tab\");\n    if (snprintf(out->tag_value, sizeof(out->tag_value),\n                 \"live:%s\", release) >= (int)sizeof(out->tag_value))\n        return -1;\n    out->from_bundle = 0;\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0 || tag_value[5] == '\\0')\n        return -1;\n    if (strncmp(tag_value, \"bundle:\", 7) == 0)\n        return -1;\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tblw/emit_writer.c <<'EOF'\n#include \"../synclink/common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\n    layout_def layout;\n    FILE *out;\n\n    if (permit_tag(tag_value) != 0 || parse_layout(layout_path, &layout) != 0)\n        return -1;\n    out = fopen(out_path, \"w\");\n    if (!out)\n        return -1;\n    if (fprintf(out, \"STRUCT %s\\n\", layout.struct_name) < 0) {\n        fclose(out);\n        return -1;\n    }\n    for (int i = 0; i < layout.nfields; i++) {\n        field_def *f = &layout.fields[i];\n        if (fprintf(out, \"FIELD %s %s %u %u\\n\",\n                    f->name, f->kind, f->off, f->size) < 0) {\n            fclose(out);\n            return -1;\n        }\n    }\n    return fclose(out) == 0 ? 0 : -1;\n}\nEOF\n"]
[78.39137, "o", "cat > /app/relc/input.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../lagpipe/synclink/common.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <ctype.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static int read_running_release(char *release, size_t n) {\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *fp;\r\n\u001b[?2004l\r\u001b[?2004h>     char *start;\r\n\u001b[?2004l\r\u001b[?2004h>     size_t len;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!release || n == 0)\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     fp = fopen(\"/app/livekern/running.release\", \"r\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!fp)\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     if (!fgets(release, (int)n, fp)) {\r\n\u001b[?2004l\r\u001b[?2004h>         fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     start = release;\r\n\u001b[?2004l\r\u001b[?2004h>     while (*start && isspace((unsigned char)*start))\r\n\u001b[?2004l\r\u001b[?2004h>         start++;\r\n\u001b[?2004l\r\u001b[?2004h>     if (start != release)\r\n\u001b[?2004l\r\u001b[?2004h>         memmove(release, start, strlen(start) + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     len = strlen(release);\r\n\u001b[?2004l\r\u001b[?2004h>     while (len && isspace((unsigned char)release[len - 1]))\r\n\u001b[?2004l\r\u001b[?2004h>         release[--len] = '\\0';\r\n\u001b[?2004l\r\u001b[?2004h>     return len ? 0 : -1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int choose_layout(source_pick *out) {\r\n\u001b[?2004l\r\u001b[?2004h>     char release[RELEASE_LEN];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!out)\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     memset(out, 0, sizeof(*out));\r\n\u001b[?2004l\r\u001b[?2004h>     if (read_running_release(release, sizeof(release)) != 0)\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     snprintf(out->layout_path, sizeof(out->layout_path),\r\n\u001b[?2004l\r\u001b[?2004h>              \"/app/livekern/exports/sched_entity.tab\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (snprintf(out->tag_value, sizeof(out->tag_value),\r\n\u001b[?2004l\r\u001b[?2004h>                  \"live:%s\", release) >= (int)sizeof(out->tag_value))\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     out->from_bundle = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
