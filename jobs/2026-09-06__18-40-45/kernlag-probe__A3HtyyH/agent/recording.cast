[37.478003, "o", "     1\t#include \"../lagpipe/synclink/common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tstatic int read_pin(char *release, size_t n) {\r\n     7\t    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n     8\t    if (!fp) {\r\n     9\t        return -1;\r\n    10\t    }\r\n    11\t    if (!fgets(release, (int)n, fp)) {\r\n    12\t        fclose(fp);\r\n    13\t        return -1;\r\n    14\t    }\r\n    15\t    fclose(fp);\r\n    16\t    size_t len = strlen(release);\r\n    17\t    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n    18\t        release[--len] = '\\0';\r\n    19\t    }\r\n    20\t    return 0;\r\n    21\t}\r\n    22\t\r\n    23\tstatic int read_running_release(char *release, size_t n) {\r\n    24\t    FILE *fp = fopen(\"/app/livekern/running.release\", \"r\");\r\n    25\t    if (!fp) {\r\n    26\t        return -1;\r\n    27\t    }\r\n    28\t    if (!fgets(release, (int)n, fp)) {\r\n    29\t        fclose(fp);\r\n    30\t        return -1;\r\n    31\t    }\r\n    32\t    fclose(fp);\r\n    33\t    size_t len = strlen(release);\r\n    34\t    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n    35\t        release[--len] = '\\0';\r\n    36\t    }\r\n    37\t    return 0;\r\n    38\t}\r\n    39\t\r\n    40\tstatic void apply_policy_release(char *release, size_t n) {\r\n    41\t    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    42\t    char line[128];\r\n    43\t    char val[RELEASE_LEN];\r\n    44\t    if (!fp) {\r\n    45\t        return;\r\n    46\t    }\r\n    47\t    while (fgets(line, sizeof(line), fp)) {\r\n    48\t        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n    49\t            snprintf(release, n, \"%s\", val);\r\n    50\t        }\r\n    51\t    }\r\n    52\t    fclose(fp);\r\n    53\t}\r\n    54\t\r\n    55\tint choose_layout(source_pick *out) {\r\n    56\t    char release[RELEASE_LEN];\r\n    57\t    char running[RELEASE_LEN];\r\n    58\t\r\n    59\t    if (!out) {\r\n    60\t        return -1;\r\n    61\t    }\r\n    62\t    memset(out, 0, sizeof(*out));\r\n    63\t\r\n    64\t    if (read_pin(release, sizeof(release)) != 0) {\r\n    65\t        return -1;\r\n    66\t    }\r\n    67\t    apply_policy_release(release, sizeof(release));\r\n    68\t\r\n    69\t    if (read_running_release(running, sizeof(running)) == 0 &&\r\n    70\t        strcmp(release, running) == 0) {\r\n    71\t        snprintf(out->layout_path, sizeof(out->layout_path),\r\n    72\t                 \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    73\t        snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", running);\r\n    74\t        out->from_bundle = 1;\r\n    75\t        return 0;\r\n    76\t    }\r\n    77\t\r\n    78\t    snprintf(out->layout_path, sizeof(out->layout_path),\r\n    79\t             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n"]
[37.479156, "o", "    80\t    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    81\t    out->from_bundle = 1;\r\n    82\t    return 0;\r\n    83\t}\r\n"]
