[30.068705, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdint.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic unsigned long read_u32(const unsigned char *buf, unsigned off) {\r\n     8\t    uint32_t v;\r\n     9\t    memcpy(&v, buf + off, sizeof(v));\r\n    10\t    return (unsigned long)v;\r\n    11\t}\r\n    12\t\r\n    13\tstatic unsigned long long read_u64(const unsigned char *buf, unsigned off) {\r\n"]
[30.069102, "o", "    14\t    uint64_t v;\r\n    15\t    memcpy(&v, buf + off, sizeof(v));\r\n    16\t    return (unsigned long long)v;\r\n    17\t}\r\n    18\t\r\n    19\tint emit_inspect_json(const char *inspect_path) {\r\n    20\t    layout_def layout;\r\n    21\t    unsigned char blob[64];\r\n    22\t    size_t nread;\r\n    23\t    FILE *fp = fopen(inspect_path, \"rb\");\r\n    24\t    if (!fp) {\r\n    25\t        perror(\"probe\");\r\n    26\t        return 1;\r\n    27\t    }\r\n    28\t    nread = fread(blob, 1, sizeof(blob), fp);\r\n    29\t    fclose(fp);\r\n    30\t    if (nread < 16) {\r\n    31\t        fprintf(stderr, \"probe: inspect too short\\n\");\r\n    32\t        return 1;\r\n    33\t    }\r\n    34\t    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\r\n    35\t        fprintf(stderr, \"probe: layout.tbl missing\\n\");\r\n    36\t        return 1;\r\n    37\t    }\r\n    38\t    printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\r\n    39\t    for (int i = 0; i < layout.nfields; i++) {\r\n    40\t        const field_def *f = &layout.fields[i];\r\n    41\t        if (strcmp(f->kind, \"u64\") == 0) {\r\n    42\t            printf(\",\\\"%s\\\":%llu\", f->name, read_u64(blob, f->off));\r\n    43\t        } else {\r\n    44\t            printf(\",\\\"%s\\\":%lu\", f->name, read_u32(blob, f->off));\r\n    45\t        }\r\n    46\t    }\r\n    47\t    printf(\"}\\n\");\r\n    48\t    return 0;\r\n    49\t}\r\n"]
[30.069457, "o", "===== lagpipe/synclink/parse_layout.c =====\r\n"]
[30.070359, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint parse_layout(const char *path, layout_def *layout) {\r\n     7\t    FILE *fp = fopen(path, \"r\");\r\n     8\t    char line[256];\r\n     9\t    if (!fp || !layout) {\r\n    10\t        return -1;\r\n    11\t    }\r\n    12\t    memset(layout, 0, sizeof(*layout));\r\n"]
[30.070501, "o", "    13\t    while (fgets(line, sizeof(line), fp)) {\r\n    14\t        char name[64];\r\n    15\t        char kind[16];\r\n    16\t        unsigned off = 0;\r\n    17\t        unsigned size = 0;\r\n    18\t        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1) {\r\n    19\t            continue;\r\n    20\t        }\r\n    21\t        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\r\n    22\t            field_def *f = &layout->fields[layout->nfields++];\r\n    23\t            snprintf(f->name, sizeof(f->name), \"%s\", name);\r\n    24\t            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\r\n    25\t            f->off = off;\r\n    26\t            f->size = size;\r\n    27\t        }\r\n    28\t    }\r\n    29\t    fclose(fp);\r\n    30\t    return layout->nfields > 0 ? 0 : -1;\r\n    31\t}\r\n"]
