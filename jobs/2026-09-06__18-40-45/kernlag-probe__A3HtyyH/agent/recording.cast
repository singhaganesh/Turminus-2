[103.701065, "i", "set -e\n/app/bin/kernscribe synctab\ncmp -s /app/livekern/exports/sched_entity.tab /app/lagpipe/synctab_out/layout.tbl\n[ \"$(cat /app/lagpipe/synctab_out/procance.tag)\" = \"live:$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' /app/livekern/running.release)\" ]\n[ \"$(cat /app/lagpipe/synctab_out/offline_guard.ok)\" = \"1\" ]\npython3 - <<'PY'\nimport glob, json, subprocess\nrequired = ('pid', 'weight', 'migration_flags', 'slice_ns')\nfor capture in sorted(glob.glob('/app/memvault/samples/*.mem')):\n    decoded = json.loads(subprocess.check_output(['/app/bin/kernscribe', 'inspect', capture]))\n    assert decoded.get('struct') == 'sched_entity'\n    assert all(type(decoded.get(k)) is int for k in required), (capture, decoded)\n    card = capture.replace('/samples/', '/cards/').replace('.mem', '.ref')\n    try:\n        with open(card) as f:\n            expected = json.load(f)\n    except FileNotFoundError:\n        pass\n    else:\n        assert decoded == expected, (capture, decoded, expected)\n    print(capture, decoded)\nPY\nfile /app/bin/kernscribe; echo 'FINAL_VALIDATION_OK'\n"]
[103.701419, "o", "set -e\r\n\u001b[?2004l\r"]
[103.701615, "o", "\u001b[?2004hroot@32f49e374d29:/app# /app/bin/kernscribe synctab"]
