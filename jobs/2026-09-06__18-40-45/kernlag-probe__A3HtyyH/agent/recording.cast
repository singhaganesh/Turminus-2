[30.218403, "o", "    32\t}\r\n    33\t\r\n    34\tint main(int argc, char **argv) {\r\n    35\t    if (argc < 2) {\r\n    36\t        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\r\n    37\t        return 2;\r\n    38\t    }\r\n    39\t    if (strcmp(argv[1], \"synctab\") == 0) {\r\n    40\t        return run_gen();\r\n    41\t    }\r\n    42\t    if (strcmp(argv[1], \"inspect\") == 0) {\r\n    43\t        if (argc < 3) {\r\n    44\t            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\r\n    45\t            return 2;\r\n    46\t        }\r\n    47\t        return emit_inspect_json(argv[2]);\r\n    48\t    }\r\n    49\t    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\r\n    50\t    return 2;\r\n    51\t}\r\n"]
[30.218601, "o", "\u001b[?2004hroot@32f49e374d29:/app# "]
[30.617775, "i", "cd /app; for f in livekern/CHANNEL livekern/EXPORTS livekern/VERSION snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf memvault/MANIFEST memvault/regression/bundle_pick_input.c; do echo \"===== $f =====\"; cat \"$f\"; done; for f in memvault/samples/*.mem; do echo \"===== $f =====\"; od -An -tx1 -v \"$f\"; done\n"]
[30.619541, "o", "cd /app; for f in livekern/CHANNEL livekern/EXPORTS livekern/VERSION snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf memvault/MANIFEST memvault/regression/bundle_pick_input.c; do echo \"===== $f =====\"; cat \"$f\"; done; for f in memvault/samples/*.mem; do echo \"===== $f =====\"; od -An -tx1 -v \"$f\"; done\r\n\u001b[?2004l\r===== livekern/CHANNEL =====\r\n"]
[30.621901, "o", "livekern exports the live sched_entity table for synctab on this image.\r\n"]
[30.622484, "o", "===== livekern/EXPORTS =====\r\n"]
[30.623854, "o", "live sched_entity export for synctab on bench images.\r\n"]
[30.62415, "o", "===== livekern/VERSION =====\r\n"]
[30.62627, "o", "livekern exports the live sched_entity layout for this image.\r\n"]
[30.626829, "o", "===== snapvault/CATALOG =====\r\n"]
[30.628554, "o", "snapvault release pins for offline sched_entity layouts.\r\n"]
[30.628938, "o", "===== snapvault/MANIFEST =====\r\n"]
[30.631474, "o", "snapvault ships pinned scheduler layout snapshots.\r\n"]
[30.632245, "o", "===== snapvault/PIN_INDEX =====\r\n"]
[30.633086, "o", "# Offline sched_entity snapshot catalog for snapvault pins.\r\n"]
[30.63332, "o", "===== snapvault/default.pin =====\r\n"]
[30.634754, "o", "6.8.11\r\n"]
[30.634999, "o", "===== snapvault/policy.conf =====\r\n"]
[30.636817, "o", "# Offline analysis hosts without live export may pin a bundled release.\r\n# kernscribe synctab consults this file after default.pin when selecting snapvault layouts.\r\nDEFAULT_RELEASE=6.8.12\r\n"]
[30.637154, "o", "===== memvault/MANIFEST =====\r\n"]
[30.638609, "o", "memvault stores capture blobs under /app/memvault/samples/*.mem and expected JSON cards under /app/memvault/cards/*.ref.\r\nbundle-pick regression fixture: /app/memvault/regression/bundle_pick_input.c\r\n"]
[30.638811, "o", "===== memvault/regression/bundle_pick_input.c =====\r\n"]
[30.63986, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
