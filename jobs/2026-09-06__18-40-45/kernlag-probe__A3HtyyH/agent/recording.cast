[30.218134, "o", "    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\r\n     9\t    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\r\n    10\t    FILE *tag_fp;\r\n    11\t\r\n    12\t    if (choose_layout(&pick) != 0) {\r\n    13\t        fprintf(stderr, \"imprint: layout pick failed\\n\");\r\n    14\t        return 1;\r\n    15\t    }\r\n    16\t    tag_fp = fopen(tag_out, \"w\");\r\n    17\t    if (!tag_fp) {\r\n    18\t        perror(\"imprint: procance.tag\");\r\n    19\t        return 1;\r\n    20\t    }"]
