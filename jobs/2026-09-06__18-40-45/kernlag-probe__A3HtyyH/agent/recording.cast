[78.396152, "o", "root@32f49e374d29:/app# cat > /app/lagpipe/tagc/gate.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"gate.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int permit_tag(const char *tag_value) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0 || tag_value[5] == '\\0')\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     if (strncmp(tag_value, \"bundle:\", 7) == 0)\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[78.403009, "o", "\u001b[?2004hroot@32f49e374d29:/app# cat > /app/lagpipe/tblw/emit_writer.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../synclink/common.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../tagc/gate.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\r\n\u001b[?2004l\r\u001b[?2004h>     layout_def layout;\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *out;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (permit_tag(tag_value) != 0 || parse_layout(layout_path, &layout) != 0)\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     out = fopen(out_path, \"w\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!out)\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     if (fprintf(out, \"STRUCT %s\\n\", layout.struct_name) < 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         fclose(out);\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < layout.nfields; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         field_def *f = &layout.fields[i];\r\n\u001b[?2004l\r\u001b[?2004h>         if (fprintf(out, \"FIELD %s %s %u %u\\n\",\r\n\u001b[?2004l\r\u001b[?2004h>                     f->name, f->kind, f->off, f->size) < 0) {\r\n\u001b[?2004l\r\u001b[?2004h>             fclose(out);\r\n\u001b[?2004l\r\u001b[?2004h>             return -1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return fclose(out) == 0 ? 0 : -1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[78.40611, "o", "\u001b[?2004hroot@32f49e374d29:/app# "]
[78.815915, "i", "cat > /app/lagpipe/synclink/parse_layout.c <<'EOF'\n#include \"common.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nint parse_layout(const char *path, layout_def *layout) {\n    FILE *fp;\n    char line[256];\n\n    if (!path || !layout)\n        return -1;\n    fp = fopen(path, \"r\");\n    if (!fp)\n        return -1;\n    memset(layout, 0, sizeof(*layout));\n    while (fgets(line, sizeof(line), fp)) {\n        char name[64], kind[16];\n        unsigned off, size;\n        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1)\n            continue;\n        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\n            field_def *f;\n            if (layout->nfields >= FIELD_MAX ||\n                (strcmp(kind, \"u32\") != 0 && strcmp(kind, \"u64\") != 0) ||\n                (strcmp(kind, \"u32\") == 0 && size != 4) ||\n                (strcmp(kind, \"u64\") == 0 && size != 8)) {\n                fclose(fp);\n                return -1;\n            }\n            f = &layout->fields[layout->nfields++];\n            snprintf(f->name, sizeof(f->name), \"%s\", name);\n            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\n            f->off = off;\n            f->size = size;\n        }\n    }\n    fclose(fp);\n    return layout->struct_name[0] && layout->nfields > 0 ? 0 : -1;\n}\nEOF\ncat > /app/lagpipe/synclink/field_emit.c <<'EOF'\n#include \"common.h\"\n\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic uint32_t read_u32(const unsigned char *buf, unsigned off) {\n    uint32_t v;\n    memcpy(&v, buf + off, sizeof(v));\n    return v;\n}\n\nstatic uint64_t read_u64(const unsigned char *buf, unsigned off) {\n    uint64_t v;\n    memcpy(&v, buf + off, sizeof(v));\n    return v;\n}\n\nint emit_inspect_json(const char *inspect_path) {\n    layout_def layout;\n    unsigned char blob[64];\n    size_t nread;\n    FILE *fp;\n\n    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\n        fprintf(stderr, \"probe: layout.tbl missing or invalid\\n\");\n        return 1;\n    }\n    fp = fopen(inspect_path, \"rb\");\n    if (!fp) {\n        perror(\"probe\");\n        return 1;\n    }\n    nread = fread(blob, 1, sizeof(blob), fp);\n    fclose(fp);\n    for (int i = 0; i < layout.nfields; i++) {\n        const field_def *f = &layout.fields[i];\n        if (f->off > nread || f->size > nread - f->off) {\n            fprintf(stderr, \"probe: inspect too short for %s\\n\", f->name);\n            return 1;\n        }\n    }\n    printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\n    for (int i = 0; i < layout.nfields; i++) {\n        const field_def *f = &layout.fields[i];\n        if (strcmp(f->kind, \"u64\") == 0)\n            printf(\",\\\"%s\\\":%llu\", f->name,\n                   (unsigned long long)read_u64(blob, f->off));\n        else\n            printf(\",\\\"%s\\\":%lu\", f->name,\n                   (unsigned long)read_u32(blob, f->off));\n    }\n    puts(\"}\");\n    return 0;\n}\nEOF\n"]
[78.816849, "o", "cat > /app/lagpipe/synclink/parse_layout.c <<'EOF'\r\n\u001b[?2004l\r"]
