[9.637014, "i", "printf '%s\\n' '--- live exports ---'; cat /app/livekern/exports/sched_entity.tab; printf '%s\\n' '--- release ---'; cat /app/livekern/running.release; printf '%s\\n' '--- cards ---'; for f in /app/memvault/cards/*.ref; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- current outputs ---'; find /app/lagpipe/synctab_out -maxdepth 1 -type f -print -exec sh -c 'echo ---; cat \"$1\"' _ {} \\; 2>/dev/null\n"]
