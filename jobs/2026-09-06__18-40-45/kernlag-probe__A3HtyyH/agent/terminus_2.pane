     7	int write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {
     8	    layout_def layout;
     9	    FILE *out;
    10	
    11	    if (parse_layout(layout_path, &layout) != 0) {
    12	        return -1;
    13	    }
    14	    out = fopen(out_path, "w");
    15	    if (!out) {
    16	        return -1;
    17	    }
    18	    fprintf(out, "STRUCT %s\n", layout.struct_name);
    19	    for (int i = 0; i < layout.nfields; i++) {
    20	        if (strcmp(layout.fields[i].name, "migration_flags") == 0) {
    21	            continue;
    22	        }
    23	        fprintf(out, "FIELD %s %s %u %u\n", layout.fields[i].name, layout.fields[i].kind,
    24	                layout.fields[i].off, layout.fields[i].size);
    25	    }
    26	    fclose(out);
    27	    if (tag_value && permit_tag(tag_value) != 0) {
    28	        return -1;
    29	    }
    30	    return 0;
    31	}
