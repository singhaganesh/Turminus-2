livekern exports the live sched_entity table for synctab on this image.
===== livekern/EXPORTS =====
live sched_entity export for synctab on bench images.
===== livekern/VERSION =====
livekern exports the live sched_entity layout for this image.
===== snapvault/CATALOG =====
snapvault release pins for offline sched_entity layouts.
===== snapvault/MANIFEST =====
snapvault ships pinned scheduler layout snapshots.
===== snapvault/PIN_INDEX =====
# Offline sched_entity snapshot catalog for snapvault pins.
===== snapvault/default.pin =====
6.8.11
===== snapvault/policy.conf =====
# Offline analysis hosts without live export may pin a bundled release.
# kernscribe synctab consults this file after default.pin when selecting snapvault layouts.
DEFAULT_RELEASE=6.8.12
===== memvault/MANIFEST =====
memvault stores capture blobs under /app/memvault/samples/*.mem and expected JSON cards under /app/memvault/cards/*.ref.
bundle-pick regression fixture: /app/memvault/regression/bundle_pick_input.c
===== memvault/regression/bundle_pick_input.c =====
#include "../lagpipe/synclink/common.h"

#include <stdio.h>
#include <string.h>

static int read_pin(char *release, size_t n) {
    FILE *fp = fopen("/app/snapvault/default.pin", "r");
    if (!fp) {
        return -1;
    }
    if (!fgets(release, (int)n, fp)) {
        fclose(fp);
        return -1;
    }
    fclose(fp);
    size_t len = strlen(release);
    while (len > 0 && (release[len - 1] == '\n' || release[len - 1] == '\r')) {
        release[--len] = '\0';
    }
    return 0;
}

static void apply_policy_release(char *release, size_t n) {
    FILE *fp = fopen("/app/snapvault/policy.conf", "r");
    char line[128];
    char val[RELEASE_LEN];
    if (!fp) {
        return;
    }
    while (fgets(line, sizeof(line), fp)) {
        if (sscanf(line, "DEFAULT_RELEASE=%63s", val) == 1) {
            snprintf(release, n, "%s", val);
        }
    }
    fclose(fp);
}

int choose_layout(source_pick *out) {
    char release[RELEASE_LEN];

    if (!out) {
        return -1;
    }
    memset(out, 0, sizeof(*out));

    if (read_pin(release, sizeof(release)) != 0) {
        return -1;
    }
    apply_policy_release(release, sizeof(release));
    snprintf(out->layout_path, sizeof(out->layout_path),
             "/app/snapvault/releases/%s/sched_entity.tab", release);
    snprintf(out->tag_value, sizeof(out->tag_value), "bundle:%s", release);
    out->from_bundle = 1;
    return 0;
}
