public class Tarn {
    public volatile int waiting;
    public volatile int keld;
    public int copy;

    public int mira() {
        waiting = 1;
        long stop = System.nanoTime() + 2_000_000_000L;
        int a;
        while ((a = keld) == 0 && System.nanoTime() < stop) {
            Thread.onSpinWait();
        }
        return a;
    }
}
