[38.490348, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.zip.ZipFile;\r\n     6\t\r\n     7\tpublic class ShipMain {\r\n     8\t    public static int rib_n(String[] a) throws Exception {\r\n     9\t        Path bag = Paths.get(a[0]);\r\n    10\t        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n    11\t        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n    12\t        Tarn t = new Tarn();\r\n    13\t        int seen = Glue.go(t, w);\r\n    14\t        String name = bag.getFileName().toString();\r\n    15\t        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n    16\t        Files.createDirectories(out.getParent());\r\n    17\t        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n    18\t        return 0;\r\n    19\t    }\r\n    20\t\r\n    21\t    public static void main(String[] a) throws Exception {\r\n    22\t        System.exit(rib_n(a));\r\n    23\t    }\r\n    24\t\r\n    25\t    static boolean lid_q() {\r\n    26\t        try {\r\n    27\t            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\r\n    28\t            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\r\n    29\t                var e = z.getEntry(\"STAMP\");\r\n    30\t                if (e == null) {\r\n    31\t                    return false;\r\n    32\t                }\r\n    33\t                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\r\n    34\t                return want.equals(got);\r\n    35\t            }\r\n    36\t        } catch (Exception ex) {\r\n    37\t            return false;\r\n    38\t        }\r\n    39\t    }\r\n    40\t}\r\n===== /app/kilnrib/KilnShip.java =====\r\n"]
[38.492439, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.stream.Stream;\r\n     6\t\r\n     7\tpublic class KilnShip {\r\n     8\t    public static void main(String[] a) throws Exception {\r\n     9\t        Path src = Paths.get(a[0]);\r\n    10\t        Path dst = Paths.get(a[1]);\r\n    11\t        Files.createDirectories(dst);\r\n    12\t        int n = 0;\r\n    13\t        try (Stream<Path> walk = Files.walk(src)) {\r\n    14\t            for (Path p : walk.filter(x -> x.toString().endsWith(\".java\")).toList()) {\r\n    15\t                String rel = src.relativize(p).toString();\r\n    16\t                String s = Files.readString(p);\r\n    17\t                String out = tighten(s);\r\n    18\t                if (!out.equals(s)) {\r\n    19\t                    n++;\r\n    20\t                }\r\n    21\t                Path q = dst.resolve(rel);\r\n    22\t                Files.createDirectories(q.getParent());\r\n    23\t                Files.writeString(q, out);\r\n    24\t            }\r\n    25\t        }\r\n    26\t        Path rill = dst.resolve(\"Rill.java\");\r\n    27\t        if (!Files.isRegularFile(rill) || Files.readString(rill).contains(\"while (a == 0)\")) {\r\n    28\t            System.exit(3);\r\n    29\t        }\r\n    30\t        Path stamp = Paths.get(\"/app/jarhearth/STAMP.body\");\r\n    31\t        Files.createDirectories(stamp.getParent());\r\n    32\t        Files.writeString(stamp, Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim() + \"\\n\");\r\n    33\t        if (n < 1) {\r\n    34\t            System.exit(4);\r\n    35\t        }\r\n    36\t    }\r\n    37\t\r\n    38\t    static String tighten(String s) {\r\n    39\t        if (!s.contains(\"volatile int keld\")) {\r\n    40\t            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = keld;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n    41\t        }\r\n    42\t        if (!s.contains(\"volatile int nub\")) {\r\n    43\t            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = nub;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n    44\t        }\r\n    45\t        return s;\r\n    46\t    }\r\n    47\t}\r\n===== /app/peekcue/PeekMain.java =====\r\n"]
[38.492893, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Paths;\r\n     3\t\r\n     4\tpublic class PeekMain {\r\n     5\t    public static void main(String[] a) throws Exception {\r\n     6\t        int w = Integer.parseInt(Files.readAllLines(Paths.get(a[0])).get(0).trim());\r\n     7\t        Tarn t = new Tarn();\r\n     8\t        Hopper.feed(t, w);\r\n     9\t        System.out.println(t.keld);\r\n    10\t    }\r\n    11\t}\r\n"]
