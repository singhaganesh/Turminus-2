[109.042586, "i", "cat > /app/tarnpit/Tarn.java <<'EOF'\npublic class Tarn {\n    public volatile int waiting;\n    public volatile int keld;\n    public int copy;\n\n    public int mira() {\n        waiting = 1;\n        long stop = System.nanoTime() + 2_000_000_000L;\n        int a;\n        while ((a = keld) == 0 && System.nanoTime() < stop) {\n            Thread.onSpinWait();\n        }\n        return a;\n    }\n}\nEOF\ncat > /app/hopcue/Hopper.java <<'EOF'\npublic class Hopper {\n    public static void feed(Tarn t, int w) {\n        t.copy = w;\n        if (w != 0) {\n            t.keld = t.copy + 9;\n        }\n    }\n}\nEOF\ncat > /app/watchbay/Glue.java <<'EOF'\npublic class Glue {\n    public static int go(Tarn t, int w) throws InterruptedException {\n        Thread gatherer = new Thread(() -> {\n            while (t.waiting == 0) {\n                Thread.onSpinWait();\n            }\n            Hopper.feed(t, w);\n        }, \"gatherer\");\n        gatherer.start();\n        int seen = t.mira();\n        gatherer.join();\n        return seen;\n    }\n}\nEOF\ncat > /app/watchbay/ShipMain.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.zip.ZipFile;\n\npublic class ShipMain {\n    private static final Path OUT = Paths.get(\"/app/jarhearth/watch.json\");\n\n    public static int rib_n(String[] a) {\n        try {\n            Files.deleteIfExists(OUT);\n            if (a.length != 1 || !lid_q()) {\n                return 2;\n            }\n\n            Path bag = Paths.get(a[0]);\n            int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\n            Tarn t = new Tarn();\n            int seen = Glue.go(t, w);\n            if (seen == 0) {\n                return 1;\n            }\n\n            String name = bag.getFileName().toString();\n            String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name\n                    + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\n            Files.createDirectories(OUT.getParent());\n            Files.write(OUT, body.getBytes(StandardCharsets.UTF_8));\n            return 0;\n        } catch (Exception ex) {\n            try {\n                Files.deleteIfExists(OUT);\n            } catch (Exception ignored) {\n            }\n            return 1;\n        }\n    }\n\n    public static void main(String[] a) {\n        System.exit(rib_n(a));\n    }\n\n    static boolean lid_q() {\n        try {\n            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\n            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\n                var e = z.getEntry(\"STAMP\");\n                if (e == null) {\n                    return false;\n                }\n                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\n                return want.equals(got);\n            }\n        } catch (Exception ex) {\n            return false;\n        }\n    }\n}\nEOF\n/app/bin/cinderwait kindle\n"]
