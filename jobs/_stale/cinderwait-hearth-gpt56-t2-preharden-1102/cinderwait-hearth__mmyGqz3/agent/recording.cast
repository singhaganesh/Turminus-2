[176.928138, "o", "public class Tarn {\r\n    public volatile int waiting;\r\n    public int keld;\r\n    public int copy;\r\n\r\n    public int mira() {\r\n        int a = keld;\r\n        waiting = 1;\r\n        int spins = 0;\r\n        while (a == 0) {\r\n            a = keld;\r\n            if (++spins > 12000000) break;\r\n        }\r\n        return a;\r\n    }\r\n}\r\n"]
