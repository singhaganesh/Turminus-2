[17.736001, "o", "import zipfile\r\nfrom pathlib import Path\r\n\r\n\r\ndef read_stamp(jar: Path) -> str:\r\n    with zipfile.ZipFile(jar) as z:\r\n"]
[17.736033, "o", "        if \"STAMP\" not in z.namelist():\r\n            return \"\"\r\n        return z.read(\"STAMP\").decode().strip()\r\n"]
[17.736553, "o", "\u001b[?2004hroot@9191728e3ef4:/app# "]
[18.221957, "i", "printf '%s\\n' '--- BASELINE DRAFT ALPHA ---'; timeout 5 /app/bin/cinderwait draft /app/hopbags/alpha.bag; echo \"rc=$?\"; cat /app/jarhearth/watch.json 2>/dev/null || true; printf '%s\\n' '--- BASELINE PEEK SAMPLES ---'; for f in /app/hopbags/*.bag; do echo -n \"$(basename \"$f\"): \"; timeout 3 /app/bin/cinderwait peek \"$f\"; echo \"rc=$?\"; done\n"]
