        Tarn t = new Tarn();
        Hopper.feed(t, w);
        Path out = Paths.get("/app/jarhearth/watch.json");
        String name = bag.getFileName().toString();
        String body = "{\"seen\":" + t.copy + ",\"bag\":\"" + name + "\",\"note\":\"" + name + "\"}\n";
