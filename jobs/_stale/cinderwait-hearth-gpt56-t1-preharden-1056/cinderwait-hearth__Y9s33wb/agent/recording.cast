[10.713712, "o", "/app/softmill/Pacer.java\r\n"]
[10.714521, "o", "--- /app/softmill/Pacer.java\r\n"]
[10.715932, "o", "public class Pacer {\r\n    public static void nap() {\r\n        try {\r\n            Thread.sleep(2);\r\n        } catch (InterruptedException e) {\r\n            Thread.currentThread().interrupt();\r\n        }\r\n    }\r\n}\r\n"]
[10.716856, "o", "/app/rillcue/Rill.java\r\n"]
[10.718812, "o", "--- /app/rillcue/Rill.java\r\n"]
[10.720307, "o", "public class Rill {\r\n"]
[10.720746, "o", "    public int nub;\r\n\r\n    public int probe() {\r\n"]
[10.720784, "o", "        int a = nub;\r\n        while (a == 0) {\r\n            a = nub;\r\n        }\r\n        return a;\r\n    }\r\n}\r\n"]
[10.721186, "o", "/app/kilnrib/KilnShip.java\r\n"]
[10.722309, "o", "--- /app/kilnrib/KilnShip.java\r\n"]
[10.723736, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\n"]
[10.723967, "o", "import java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.stream.Stream;\r\n\r\npublic class KilnShip {\r\n    public static void main(String[] a) throws Exception {\r\n        Path src = Paths.get(a[0]);\r\n        Path dst = Paths.get(a[1]);\r\n        Files.createDirectories(dst);\r\n        int n = 0;\r\n        try (Stream<Path> walk = Files.walk(src)) {\r\n            for (Path p : walk.filter(x -> x.toString().endsWith(\".java\")).toList()) {\r\n                String rel = src.relativize(p).toString();\r\n                String s = Files.readString(p);\r\n                String out = tighten(s);\r\n                if (!out.equals(s)) {\r\n                    n++;\r\n                }\r\n                Path q = dst.resolve(rel);\r\n                Files.createDirectories(q.getParent());\r\n                Files.writeString(q, out);\r\n            }\r\n        }\r\n        Path rill = dst.resolve(\"Rill.java\");\r\n        if (!Files.isRegularFile(rill) || Files.readString(rill).contains(\"while (a == 0)\")) {\r\n            System.exit(3);\r\n        }\r\n        Path stamp = Paths.get(\"/app/jarhearth/STAMP.body\");\r\n        Files.createDirectories(stamp.getParent());\r\n        Files.writeString(stamp, Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim() + \"\\n\");\r\n        if (n < 1) {\r\n            System.exit(4);\r\n        }\r\n    }\r\n\r\n    static String tighten(String s) {\r\n        if (!s.contains(\"volatile int keld\")) {\r\n            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = keld;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n        }\r\n        if (!s.contains(\"volatile int nub\")) {\r\n            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = nub;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n        }\r\n        return s;\r\n    }\r\n}\r\n"]
[10.724218, "o", "/app/peekcue/PeekMain.java\r\n"]
[10.725079, "o", "--- /app/peekcue/PeekMain.java\r\n"]
[10.726384, "o", "import java.nio.file.Files;\r\nimport java.nio.file.Paths;\r\n\r\npublic class PeekMain {\r\n    public static void main(String[] a) throws Exception {\r\n        int w = Integer.parseInt(Files.readAllLines(Paths.get(a[0])).get(0).trim());\r\n        Tarn t = new Tarn();\r\n        Hopper.feed(t, w);\r\n        System.out.println(t.keld);\r\n    }\r\n}\r\n"]
[10.726993, "o", "/app/draftcue/DraftMain.java\r\n"]
[10.727703, "o", "--- /app/draftcue/DraftMain.java\r\n"]
[10.728919, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\n\r\npublic class DraftMain {\r\n    public static void main(String[] a) throws Exception {\r\n        Path bag = Paths.get(a[0]);\r\n        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n        Tarn t = new Tarn();\r\n        Hopper.feed(t, w);\r\n        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n        String name = bag.getFileName().toString();\r\n        String body = \"{\\\"seen\\\":\" + t.copy + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n        Files.createDirectories(out.getParent());\r\n"]
[10.729125, "o", "        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n    }\r\n}\r\n"]
[10.729375, "o", "/app/watchbay/Glue.java\r\n"]
[10.730179, "o", "--- /app/watchbay/Glue.java\r\n"]
[10.731387, "o", "public class Glue {\r\n    public static int go(Tarn t, int w) throws Exception {\r\n        Thread th = new Thread(() -> {\r\n            while (t.waiting == 0) {\r\n                Thread.onSpinWait();\r\n            }\r\n            Hopper.feed(t, w);\r\n        });\r\n        th.start();\r\n        int a = t.mira();\r\n        th.join();\r\n        return a;\r\n    }\r\n}\r\n"]
[10.731892, "o", "/app/watchbay/ShipMain.java\r\n"]
[10.732699, "o", "--- /app/watchbay/ShipMain.java\r\n"]
[10.734081, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.zip.ZipFile;\r\n\r\npublic class ShipMain {\r\n    public static int rib_n(String[] a) throws Exception {\r\n        Path bag = Paths.get(a[0]);\r\n        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n        Tarn t = new Tarn();\r\n        int seen = Glue.go(t, w);\r\n        String name = bag.getFileName().toString();\r\n        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n        Files.createDirectories(out.getParent());\r\n        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n        return 0;\r\n    }\r\n\r\n    public static void main(String[] a) throws Exception {\r\n        System.exit(rib_n(a));\r\n    }\r\n\r\n    static boolean lid_q() {\r\n        try {\r\n            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\r\n            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\r\n                var e = z.getEntry(\"STAMP\");\r\n                if (e == null) {\r\n                    return false;\r\n                }\r\n                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\r\n                return want.equals(got);\r\n            }\r\n        } catch (Exception ex) {\r\n            return false;\r\n        }\r\n    }\r\n}\r\n"]
[10.734532, "o", "/app/hopcue/Hopper.java\r\n"]
[10.735311, "o", "--- /app/hopcue/Hopper.java\r\n"]
[10.736422, "o", "public class Hopper {\r\n    public static void feed(Tarn t, int w) {\r\n        t.copy = w;\r\n    }\r\n}\r\n"]
[10.736806, "o", "/app/tarnpit/Tarn.java\r\n"]
[10.737549, "o", "--- /app/tarnpit/Tarn.java\r\n"]
[10.738816, "o", "public class Tarn {\r\n    public volatile int waiting;\r\n    public int keld;\r\n    public int copy;\r\n"]
[10.738914, "o", "\r\n    public int mira() {\r\n        int a = keld;\r\n        waiting = 1;\r\n        int spins = 0;\r\n        while (a == 0) {\r\n            a = keld;\r\n            if (++spins > 12000000) break;\r\n        }\r\n        return a;\r\n    }\r\n}\r\n"]
[10.739626, "o", "\u001b[?2004hroot@5352dee4b956:/app# "]
[22.243638, "i", "printf '%s\\n' '--- NOTES ---'; cat /app/opslip/NOTES.txt; printf '%s\\n' '--- kindle.sh ---'; sed -n '1,300p' /app/kindle.sh; printf '%s\\n' '--- bags ---'; for f in /app/hopbags/*.bag; do echo \"--- $f\"; od -An -tx1c \"$f\"; echo 'TEXT:'; cat \"$f\"; done\n"]
[22.24494, "o", "printf '%s\\n' '--- NOTES ---'; cat /app/opslip/NOTES.txt; printf '%s\\n' '--- kindle.sh ---'; sed -n '1,300p' /app/kindle.sh; printf '%s\\n' '--- bags ---'; for f in /app/hopbags/*.bag; do echo \"--- $f\"; od -An -tx1c \"$f\"; echo 'TEXT:'; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[22.245606, "o", "--- NOTES ---\r\n"]
[22.246818, "o", "Draft mill finishes on the same bags the ship mill leaves at 0.\r\nShip hangs or returns the opening zero while kindle still exits 0.\r\nA nap helper lives under softmill from an old hang drill; it is unused by the packed mill.\r\n"]
[22.247062, "o", "--- kindle.sh ---\r\n"]
[22.248694, "o", "#!/bin/bash\r\nset -euo pipefail\r\nJAVAC=\"${JAVA_HOME:-/opt/java/openjdk}/bin/javac\"\r\nJAR=\"${JAVA_HOME:-/opt/java/openjdk}/bin/jar\"\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVAC\" ]; then\r\n  JAVAC=javac\r\n  JAR=jar\r\n  JAVA=java\r\nfi\r\nrm -rf /tmp/kilsrc /tmp/kildst /tmp/shipcp /tmp/draftcp /app/blastcp\r\nmkdir -p /tmp/kilsrc /tmp/kildst /tmp/shipcp /tmp/draftcp /app/blastcp /app/jarhearth /app/bin\r\ncp /app/tarnpit/*.java /tmp/kilsrc/\r\n"]
[22.248857, "o", "cp /app/rillcue/*.java /tmp/kilsrc/\r\nmapfile -t ALL < <(find /app/tarnpit /app/hopcue /app/watchbay /app/draftcue /app/peekcue /app/kilnrib /app/rillcue /app/softmill -name '*.java' | sort)\r\n\"$JAVAC\" -d /app/blastcp \"${ALL[@]}\"\r\n\"$JAVA\" -cp /app/blastcp KilnShip /tmp/kilsrc /tmp/kildst\r\nmapfile -t SHIPSRC < <(find /tmp/kildst /app/hopcue /app/watchbay /app/softmill -name '*.java' | sort)\r\n\"$JAVAC\" -d /tmp/shipcp \"${SHIPSRC[@]}\"\r\nmapfile -t DRAFTSRC < <(find /app/tarnpit /app/hopcue /app/draftcue /app/softmill -name '*.java' | sort)\r\n\"$JAVAC\" -d /tmp/draftcp \"${DRAFTSRC[@]}\"\r\n(\r\n  cd /tmp/shipcp\r\n  \"$JAR\" cf /app/jarhearth/ship.jar .\r\n)\r\n(\r\n  cd /tmp/draftcp\r\n  \"$JAR\" cf /app/jarhearth/draft.jar .\r\n)\r\npython3 - << 'PY'\r\nimport io\r\nimport zipfile\r\nfrom pathlib import Path\r\nsrc = Path(\"/app/jarhearth/ship.jar\")\r\nbody = Path(\"/app/jarhearth/STAMP.body\").read_bytes()\r\nbuf = io.BytesIO()\r\nwith zipfile.ZipFile(src, \"r\") as zin, zipfile.ZipFile(buf, \"w\") as zout:\r\n    for info in zin.infolist():\r\n        if info.filename in (\"STAMP\", \"STAMP.body\"):\r\n            continue\r\n        zout.writestr(info, zin.read(info.filename))\r\n    zout.writestr(\"STAMP\", body)\r\nsrc.write_bytes(buf.getvalue())\r\nwant = Path(\"/app/opslip/MARK.txt\").read_text().strip()\r\nwith zipfile.ZipFile(src) as z:\r\n    got = z.read(\"STAMP\").decode().strip()\r\nif got != want:\r\n    raise SystemExit(1)\r\nPY\r\ncat > /app/bin/cinderwait << 'EOF'\r\n#!/bin/bash\r\nset -euo pipefail\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  kindle)\r\n    exec /app/kindle.sh\r\n    ;;\r\n  watch)\r\n    exec \"$JAVA\" -cp /app/jarhearth/ship.jar ShipMain \"$@\"\r\n    ;;\r\n  peek)\r\n    exec \"$JAVA\" -cp /app/blastcp PeekMain \"$@\"\r\n    ;;\r\n  draft)\r\n    exec \"$JAVA\" -cp /app/jarhearth/draft.jar DraftMain \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\nEOF\r\nchmod +x /app/bin/cinderwait /app/kindle.sh\r\n"]
