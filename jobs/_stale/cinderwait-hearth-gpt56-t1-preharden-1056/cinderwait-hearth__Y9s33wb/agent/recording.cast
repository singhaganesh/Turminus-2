[86.761671, "i", "cp /app/jarhearth/ship.jar /tmp/ship.good.jar\npython3 - <<'PY'\nimport io, zipfile\nfrom pathlib import Path\np=Path('/app/jarhearth/ship.jar')\nb=io.BytesIO()\nwith zipfile.ZipFile(p) as zin, zipfile.ZipFile(b,'w') as zout:\n    for info in zin.infolist():\n        if info.filename != 'STAMP':\n            zout.writestr(info, zin.read(info.filename))\np.write_bytes(b.getvalue())\nPath('/app/jarhearth/watch.json').write_text('{\"stale\":true}\\n')\nPY\n/app/bin/cinderwait watch /app/hopbags/elm.bag\nrc=$?\necho \"missing_stamp_watch_rc=$rc\"\nif [ -e /app/jarhearth/watch.json ]; then echo 'ERROR: stale ledger remains'; else echo 'missing-stamp ledger absent'; fi\n"]
