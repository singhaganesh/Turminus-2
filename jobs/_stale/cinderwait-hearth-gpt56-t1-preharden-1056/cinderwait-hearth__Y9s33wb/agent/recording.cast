[9.728778, "o", "/app/jarhearth/ship.jar:  Java archive data (JAR)\r\n"]
[9.731829, "o", "#!/bin/bash\r\n"]
[9.73217, "o", "set -euo pipefail\r\n"]
[9.732369, "o", "JAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\n"]
[9.732446, "o", "fi\r\n"]
[9.732525, "o", "verb=\"${1:-}\"\r\nshift || true\r\n"]
[9.732723, "o", "case \"$verb\" in\r\n  kindle)\r\n"]
[9.732763, "o", "    exec /app/kindle.sh\r\n    ;;\r\n  watch)\r\n    exec \"$JAVA\" -cp /app/jarhearth/ship.jar ShipMain \"$@\"\r\n    ;;\r\n  peek)\r\n    exec \"$JAVA\" -cp /app/blastcp PeekMain \"$@\"\r\n"]
[9.733247, "o", "    ;;\r\n"]
[9.733282, "o", "  draft)\r\n    exec \"$JAVA\" -cp /app/jarhearth/draft.jar DraftMain \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\n"]
