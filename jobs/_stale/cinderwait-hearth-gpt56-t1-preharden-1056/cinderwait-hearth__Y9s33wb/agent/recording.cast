[22.259575, "o", "\u001b[?2004hroot@5352dee4b956:/app# "]
[22.426067, "i", "python3 - <<'PY'\nimport zipfile,glob\nfor p in glob.glob('/app/jarhearth/*.jar'):\n print('\\n---',p)\n with zipfile.ZipFile(p) as z:\n  for n in z.namelist():\n   print(n)\n   if n.upper().endswith('MANIFEST.MF') or n=='STAMP':\n    print(z.read(n).decode(errors='replace'))\nPY\n"]
[22.426359, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.426394, "o", "import zipfile,glob\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.426703, "o", "for p in glob.glob('/app/jarhearth/*.jar'):\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n---',p)\r\n\u001b[?2004l\r\u001b[?2004h>  with zipfile.ZipFile(p) as z:\r\n\u001b[?2004l\r"]
[22.427956, "o", "\u001b[?2004h>   for n in z.namelist():\r\n\u001b[?2004l\r\u001b[?2004h>    print(n)\r\n\u001b[?2004l\r\u001b[?2004h>    if n.upper().endswith('MANIFEST.MF') or n=='STAMP':\r\n\u001b[?2004l\r\u001b[?2004h>     print(z.read(n).decode(errors='replace'))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
