--- /app/watchbay/Glue.java
public class Glue {
    public static int go(Tarn t, int w) throws Exception {
        Thread th = new Thread(() -> {
            while (t.waiting == 0) {
                Thread.onSpinWait();
            }
            Hopper.feed(t, w);
        });
        th.start();
        int a = t.mira();
        th.join();
        return a;
    }
}
