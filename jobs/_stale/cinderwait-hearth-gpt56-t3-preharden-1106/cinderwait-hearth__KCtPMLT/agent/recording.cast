[45.665077, "o", "/app/jarhearth/STAMP.body:1:keld-tight-9\r\n/app/jarhearth/watch.json:1:{\"seen\":0,\"bag\":\"elm.bag\",\"note\":\"elm.bag\"}\r\n/app/hopbags/elm.bag:1:5151\r\n/app/hopbags/alpha.bag:1:4242\r\n/app/opslip/CARD.txt:2:  seen  — integer gather word the mill stored\r\n/app/opslip/CARD.txt:6:The gather word for a published bag is the wait-board integer the gatherer publishes after it reads the bag.\r\n/app/opslip/CARD.txt:8:A first line of 0 means the gatherer never publishes.\r\n/app/opslip/CARD.txt:9:Shipped sample bags: `/app/hopbags/elm.bag`, `/app/hopbags/mute.bag`. Grade-time bags may appear as `/app/hopbags/held.bag`, `/app/hopbags/held2.bag`, `/app/hopbags/side.bag`.\r\n/app/opslip/VERBS.txt:8:  print the gather word for BAG as one integer on stdout\r\n/app/opslip/MARK.txt:1:keld-tight-9\r\n/app/kilnrib/KilnShip.java:39:        if (!s.contains(\"volatile int keld\")) {\r\n/app/kilnrib/KilnShip.java:40:            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = keld;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n/app/peekcue/PeekMain.java:8:        Hopper.feed(t, w);\r\n/app/peekcue/PeekMain.java:9:        System.out.println(t.keld);\r\n/app/draftcue/DraftMain.java:11:        Hopper.feed(t, w);\r\n/app/draftcue/DraftMain.java:14:        String body = \"{\\\"seen\\\":\" + t.copy + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n/app/watchbay/Glue.java:4:            while (t.waiting == 0) {\r\n/app/watchbay/Glue.java:7:            Hopper.feed(t, w);\r\n/app/watchbay/Glue.java:10:        int a = t.mira();\r\n/app/watchbay/ShipMain.java:8:    public static int rib_n(String[] a) throws Exception {\r\n/app/watchbay/ShipMain.java:13:        int seen = Glue.go(t, w);\r\n/app/watchbay/ShipMain.java:15:        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n/app/watchbay/ShipMain.java:22:        System.exit(rib_n(a));\r\n/app/hopcue/Hopper.java:2:    public static void feed(Tarn t, int w) {\r\n/app/hopcue/Hopper.java:3:        t.copy = w;\r\n/app/tarnpit/Tarn.java:2:    public volatile int waiting;\r\n/app/tarnpit/Tarn.java:3:    public int keld;\r\n/app/tarnpit/Tarn.java:4:    public int copy;\r\n/app/tarnpit/Tarn.java:6:    public int mira() {\r\n/app/tarnpit/Tarn.java:7:        int a = keld;\r\n/app/tarnpit/Tarn.java:8:        waiting = 1;\r\n/app/tarnpit/Tarn.java:11:            a = keld;\r\n\u001b[?2004hroot@e5a90d3f3647:/app# "]
[45.883913, "i", "python3 - <<'PY'\nimport zipfile\nfor p in ['/app/jarhearth/ship.jar','/app/jarhearth/draft.jar']:\n print('\\n---',p)\n with zipfile.ZipFile(p) as z:\n  for i in z.infolist():\n   print(i.filename, i.file_size)\n   if not i.filename.endswith('.class') and not i.is_dir():\n    print(repr(z.read(i.filename)))\nPY\n"]
