[92.717512, "o", "public class Hopper {\r\n\u001b[?2004l\r\u001b[?2004h>     public static void feed(Tarn t, int w) {\r\n\u001b[?2004l\r\u001b[?2004h>         t.copy = w;\r\n\u001b[?2004l\r\u001b[?2004h>         if (w != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>             t.keld = w + 9;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
