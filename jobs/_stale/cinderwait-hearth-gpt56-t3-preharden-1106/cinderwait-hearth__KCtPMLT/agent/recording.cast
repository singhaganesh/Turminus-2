[45.421421, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.stream.Stream;\r\n"]
[45.422132, "o", "     6\t\r\n     7\tpublic class KilnShip {\r\n     8\t    public static void main(String[] a) throws Exception {\r\n"]
[45.422158, "o", "     9\t        Path src = Paths.get(a[0]);\r\n    10\t        Path dst = Paths.get(a[1]);\r\n"]
[45.425474, "o", "    11\t        Files.createDirectories(dst);\r\n    12\t        int n = 0;\r\n"]
[45.425559, "o", "    13\t        try (Stream<Path> walk = Files.walk(src)) {\r\n    14\t            for (Path p : walk.filter(x -> x.toString().endsWith(\".java\")).toList()) {\r\n    15\t                String rel = src.relativize(p).toString();\r\n    16\t                String s = Files.readString(p);\r\n    17\t                String out = tighten(s);\r\n    18\t                if (!out.equals(s)) {\r\n    19\t                    n++;\r\n    20\t                }\r\n    21\t                Path q = dst.resolve(rel);\r\n    22\t                Files.createDirectories(q.getParent());\r\n    23\t                Files.writeString(q, out);\r\n    24\t            }\r\n    25\t        }\r\n    26\t        Path rill = dst.resolve(\"Rill.java\");\r\n    27\t        if (!Files.isRegularFile(rill) || Files.readString(rill).contains(\"while (a == 0)\")) {\r\n    28\t            System.exit(3);\r\n    29\t        }\r\n    30\t        Path stamp = Paths.get(\"/app/jarhearth/STAMP.body\");\r\n    31\t        Files.createDirectories(stamp.getParent());\r\n    32\t        Files.writeString(stamp, Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim() + \"\\n\");\r\n    33\t        if (n < 1) {\r\n    34\t            System.exit(4);\r\n    35\t        }\r\n    36\t    }\r\n    37\t\r\n    38\t    static String tighten(String s) {\r\n    39\t        if (!s.contains(\"volatile int keld\")) {\r\n    40\t            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = keld;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n    41\t        }\r\n    42\t        if (!s.contains(\"volatile int nub\")) {\r\n    43\t            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = nub;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n    44\t        }\r\n    45\t        return s;\r\n    46\t    }\r\n    47\t}\r\n"]
[45.42977, "o", "--- jarscan numbered ---\r\n"]
[45.435485, "o", "     1\timport zipfile\r\n     2\tfrom pathlib import Path\r\n     3\t\r\n     4\t\r\n     5\tdef read_stamp(jar: Path) -> str:\r\n     6\t    with zipfile.ZipFile(jar) as z:\r\n     7\t        if \"STAMP\" not in z.namelist():\r\n     8\t            return \"\"\r\n     9\t        return z.read(\"STAMP\").decode().strip()\r\n--- kindle numbered ---\r\n"]
[45.436717, "o", "     1\t#!/bin/bash\r\n     2\tset -euo pipefail\r\n     3\tJAVAC=\"${JAVA_HOME:-/opt/java/openjdk}/bin/javac\"\r\n     4\tJAR=\"${JAVA_HOME:-/opt/java/openjdk}/bin/jar\"\r\n     5\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n     6\tif [ ! -x \"$JAVAC\" ]; then\r\n     7\t  JAVAC=javac\r\n     8\t  JAR=jar\r\n     9\t  JAVA=java\r\n    10\tfi\r\n    11\trm -rf /tmp/kilsrc /tmp/kildst /tmp/shipcp /tmp/draftcp /app/blastcp\r\n    12\tmkdir -p /tmp/kilsrc /tmp/kildst /tmp/shipcp /tmp/draftcp /app/blastcp /app/jarhearth /app/bin\r\n    13\tcp /app/tarnpit/*.java /tmp/kilsrc/\r\n    14\tcp /app/rillcue/*.java /tmp/kilsrc/\r\n    15\tmapfile -t ALL < <(find /app/tarnpit /app/hopcue /app/watchbay /app/draftcue /app/peekcue /app/kilnrib /app/rillcue /app/softmill -name '*.java' | sort)\r\n    16\t\"$JAVAC\" -d /app/blastcp \"${ALL[@]}\"\r\n    17\t\"$JAVA\" -cp /app/blastcp KilnShip /tmp/kilsrc /tmp/kildst\r\n    18\tmapfile -t SHIPSRC < <(find /tmp/kildst /app/hopcue /app/watchbay /app/softmill -name '*.java' | sort)\r\n    19\t\"$JAVAC\" -d /tmp/shipcp \"${SHIPSRC[@]}\"\r\n    20\tmapfile -t DRAFTSRC < <(find /app/tarnpit /app/hopcue /app/draftcue /app/softmill -name '*.java' | sort)\r\n    21\t\"$JAVAC\" -d /tmp/draftcp \"${DRAFTSRC[@]}\"\r\n    22\t(\r\n    23\t  cd /tmp/shipcp\r\n    24\t  \"$JAR\" cf /app/jarhearth/ship.jar .\r\n    25\t)\r\n    26\t(\r\n    27\t  cd /tmp/draftcp\r\n    28\t  \"$JAR\" cf /app/jarhearth/draft.jar .\r\n    29\t)\r\n    30\tpython3 - << 'PY'\r\n    31\timport io\r\n    32\timport zipfile\r\n    33\tfrom pathlib import Path\r\n    34\tsrc = Path(\"/app/jarhearth/ship.jar\")\r\n    35\tbody = Path(\"/app/jarhearth/STAMP.body\").read_bytes()\r\n    36\tbuf = io.BytesIO()\r\n    37\twith zipfile.ZipFile(src, \"r\") as zin, zipfile.ZipFile(buf, \"w\") as zout:\r\n    38\t    for info in zin.infolist():\r\n    39\t        if info.filename in (\"STAMP\", \"STAMP.body\"):\r\n    40\t            continue\r\n    41\t        zout.writestr(info, zin.read(info.filename))\r\n    42\t    zout.writestr(\"STAMP\", body)\r\n    43\tsrc.write_bytes(buf.getvalue())\r\n    44\twant = Path(\"/app/opslip/MARK.txt\").read_text().strip()\r\n    45\twith zipfile.ZipFile(src) as z:\r\n    46\t    got = z.read(\"STAMP\").decode().strip()\r\n    47\tif got != want:\r\n    48\t    raise SystemExit(1)\r\n    49\tPY\r\n    50\tcat > /app/bin/cinderwait << 'EOF'\r\n    51\t#!/bin/bash\r\n    52\tset -euo pipefail\r\n    53\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n    54\tif [ ! -x \"$JAVA\" ]; then\r\n    55\t  JAVA=java\r\n    56\tfi\r\n    57\tverb=\"${1:-}\"\r\n    58\tshift || true\r\n    59\tcase \"$verb\" in\r\n    60\t  kindle)\r\n    61\t    exec /app/kindle.sh\r\n    62\t    ;;\r\n    63\t  watch)\r\n    64\t    exec \"$JAVA\" -cp /app/jarhearth/ship.jar ShipMain \"$@\"\r\n    65\t    ;;\r\n    66\t  peek)\r\n    67\t    exec \"$JAVA\" -cp /app/blastcp PeekMain \"$@\"\r\n    68\t    ;;\r\n    69\t  draft)\r\n    70\t    exec \"$JAVA\" -cp /app/jarhearth/draft.jar DraftMain \"$@\"\r\n    71\t    ;;\r\n    72\t  *)\r\n    73\t    exit 2\r\n    74\t    ;;\r\n    75\tesac\r\n    76\tEOF\r\n    77\tchmod +x /app/bin/cinderwait /app/kindle.sh\r\n"]
