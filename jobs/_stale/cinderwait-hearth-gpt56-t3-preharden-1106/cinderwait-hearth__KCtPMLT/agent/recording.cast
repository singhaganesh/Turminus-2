[10.940397, "o", "/app/bin/cinderwait:      Bourne-Again shell script, ASCII text executable\r\n"]
[10.947237, "o", "/app/jarhearth/draft.jar: Java archive data (JAR)\r\n"]
[10.947841, "o", "/app/jarhearth/ship.jar:  Java archive data (JAR)\r\n"]
[10.951981, "o", "#!/bin/bash\r\nset -euo pipefail\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  kindle)\r\n    exec /app/kindle.sh\r\n    ;;\r\n  watch)\r\n    exec \"$JAVA\" -cp /app/jarhearth/ship.jar ShipMain \"$@\"\r\n    ;;\r\n  peek)\r\n    exec \"$JAVA\" -cp /app/blastcp PeekMain \"$@\"\r\n    ;;\r\n  draft)\r\n"]
[10.952161, "o", "    exec \"$JAVA\" -cp /app/jarhearth/draft.jar DraftMain \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\n"]
