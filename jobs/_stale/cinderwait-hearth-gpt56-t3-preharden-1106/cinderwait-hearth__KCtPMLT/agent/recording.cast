[12.13811, "o", "/app/opslip/MARK.txt\r\n"]
[12.139392, "o", "--- /app/opslip/MARK.txt\r\n"]
[12.139996, "o", "keld-tight-9\r\n"]
[12.140557, "o", "/app/opslip/ROUTE.txt\r\n"]
[12.141318, "o", "--- /app/opslip/ROUTE.txt\r\n"]
[12.142243, "o", "tarnpit\r\nhopcue\r\nwatchbay\r\n"]
[12.142933, "o", "/app/softmill/Pacer.java\r\n"]
[12.144018, "o", "--- /app/softmill/Pacer.java\r\n"]
[12.145526, "o", "public class Pacer {\r\n    public static void nap() {\r\n        try {\r\n            Thread.sleep(2);\r\n        } catch (InterruptedException e) {\r\n            Thread.currentThread().interrupt();\r\n        }\r\n    }\r\n}\r\n"]
[12.146832, "o", "/app/rillcue/Rill.java\r\n"]
[12.148168, "o", "--- /app/rillcue/Rill.java\r\n"]
[12.149496, "o", "public class Rill {\r\n    public int nub;\r\n\r\n    public int probe() {\r\n        int a = nub;\r\n        while (a == 0) {\r\n            a = nub;\r\n        }\r\n        return a;\r\n    }\r\n}\r\n"]
[12.150414, "o", "/app/kilnrib/KilnShip.java\r\n"]
[12.151776, "o", "--- /app/kilnrib/KilnShip.java\r\n"]
[12.1523, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\n"]
[12.152496, "o", "import java.util.stream.Stream;\r\n\r\npublic class KilnShip {\r\n    public static void main(String[] a) throws Exception {\r\n        Path src = Paths.get(a[0]);\r\n        Path dst = Paths.get(a[1]);\r\n        Files.createDirectories(dst);\r\n        int n = 0;\r\n        try (Stream<Path> walk = Files.walk(src)) {\r\n            for (Path p : walk.filter(x -> x.toString().endsWith(\".java\")).toList()) {\r\n                String rel = src.relativize(p).toString();\r\n                String s = Files.readString(p);\r\n                String out = tighten(s);\r\n                if (!out.equals(s)) {\r\n                    n++;\r\n                }\r\n                Path q = dst.resolve(rel);\r\n                Files.createDirectories(q.getParent());\r\n                Files.writeString(q, out);\r\n            }\r\n        }\r\n        Path rill = dst.resolve(\"Rill.java\");\r\n        if (!Files.isRegularFile(rill) || Files.readString(rill).contains(\"while (a == 0)\")) {\r\n            System.exit(3);\r\n        }\r\n        Path stamp = Paths.get(\"/app/jarhearth/STAMP.body\");\r\n        Files.createDirectories(stamp.getParent());\r\n        Files.writeString(stamp, Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim() + \"\\n\");\r\n        if (n < 1) {\r\n            System.exit(4);\r\n        }\r\n    }\r\n\r\n    static String tighten(String s) {\r\n        if (!s.contains(\"volatile int keld\")) {\r\n            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = keld;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n        }\r\n        if (!s.contains(\"volatile int nub\")) {\r\n            s = s.replaceAll(\"while \\\\(a == 0\\\\) \\\\{[\\\\s\\\\S]*?a = nub;[\\\\s\\\\S]*?\\\\}\", \"\");\r\n        }\r\n        return s;\r\n    }\r\n}\r\n"]
[12.153146, "o", "/app/peekcue/PeekMain.java\r\n"]
[12.153979, "o", "--- /app/peekcue/PeekMain.java\r\n"]
[12.154962, "o", "import java.nio.file.Files;\r\nimport java.nio.file.Paths;\r\n\r\npublic class PeekMain {\r\n    public static void main(String[] a) throws Exception {\r\n        int w = Integer.parseInt(Files.readAllLines(Paths.get(a[0])).get(0).trim());\r\n        Tarn t = new Tarn();\r\n        Hopper.feed(t, w);\r\n        System.out.println(t.keld);\r\n    }\r\n}\r\n"]
[12.155328, "o", "/app/draftcue/DraftMain.java\r\n"]
[12.156005, "o", "--- /app/draftcue/DraftMain.java\r\n"]
[12.157106, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\n\r\npublic class DraftMain {\r\n"]
[12.157145, "o", "    public static void main(String[] a) throws Exception {\r\n        Path bag = Paths.get(a[0]);\r\n        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n        Tarn t = new Tarn();\r\n        Hopper.feed(t, w);\r\n        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n        String name = bag.getFileName().toString();\r\n        String body = \"{\\\"seen\\\":\" + t.copy + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n        Files.createDirectories(out.getParent());\r\n        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n    }\r\n}\r\n"]
[12.157606, "o", "/app/watchbay/Glue.java\r\n"]
[12.158408, "o", "--- /app/watchbay/Glue.java\r\n"]
[12.160051, "o", "public class Glue {\r\n    public static int go(Tarn t, int w) throws Exception {\r\n        Thread th = new Thread(() -> {\r\n            while (t.waiting == 0) {\r\n                Thread.onSpinWait();\r\n            }\r\n            Hopper.feed(t, w);\r\n        });\r\n        th.start();\r\n        int a = t.mira();\r\n        th.join();\r\n        return a;\r\n    }\r\n}\r\n"]
[12.161161, "o", "/app/watchbay/ShipMain.java\r\n"]
[12.16369, "o", "--- /app/watchbay/ShipMain.java\r\n"]
[12.165354, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.zip.ZipFile;\r\n\r\npublic class ShipMain {\r\n    public static int rib_n(String[] a) throws Exception {\r\n"]
[12.165807, "o", "        Path bag = Paths.get(a[0]);\r\n        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n        Tarn t = new Tarn();\r\n        int seen = Glue.go(t, w);\r\n        String name = bag.getFileName().toString();\r\n        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n        Files.createDirectories(out.getParent());\r\n        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n        return 0;\r\n    }\r\n\r\n    public static void main(String[] a) throws Exception {\r\n        System.exit(rib_n(a));\r\n    }\r\n\r\n    static boolean lid_q() {\r\n        try {\r\n            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\r\n            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\r\n                var e = z.getEntry(\"STAMP\");\r\n                if (e == null) {\r\n                    return false;\r\n                }\r\n                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\r\n                return want.equals(got);\r\n            }\r\n        } catch (Exception ex) {\r\n            return false;\r\n        }\r\n    }\r\n}\r\n"]
[12.166493, "o", "/app/hopcue/Hopper.java\r\n"]
[12.167647, "o", "--- /app/hopcue/Hopper.java\r\n"]
[12.16877, "o", "public class Hopper {\r\n    public static void feed(Tarn t, int w) {\r\n        t.copy = w;\r\n    }\r\n}\r\n"]
[12.169345, "o", "/app/tarnpit/Tarn.java\r\n"]
[12.170504, "o", "--- /app/tarnpit/Tarn.java\r\n"]
[12.171914, "o", "public class Tarn {\r\n    public volatile int waiting;\r\n    public int keld;\r\n    public int copy;\r\n\r\n    public int mira() {\r\n        int a = keld;\r\n        waiting = 1;\r\n        int spins = 0;\r\n        while (a == 0) {\r\n            a = keld;\r\n            if (++spins > 12000000) break;\r\n        }\r\n        return a;\r\n"]
[12.171951, "o", "    }\r\n}\r\n"]
[12.17302, "o", "\u001b[?2004h"]
