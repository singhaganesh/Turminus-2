[92.905793, "i", "cat > /app/watchbay/ShipMain.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.nio.file.StandardCopyOption;\nimport java.util.zip.ZipFile;\n\npublic class ShipMain {\n    private static final Path OUT = Paths.get(\"/app/jarhearth/watch.json\");\n\n    public static int rib_n(String[] a) {\n        try {\n            Files.deleteIfExists(OUT);\n            if (a.length != 1 || !lid_q()) {\n                return 1;\n            }\n            Path bag = Paths.get(a[0]);\n            int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\n            int seen = Glue.go(new Tarn(), w);\n            if (seen == 0) {\n                return 1;\n            }\n\n            String name = bag.getFileName().toString();\n            String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name\n                    + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\n            Files.createDirectories(OUT.getParent());\n            Path tmp = OUT.resolveSibling(\"watch.json.tmp\");\n            Files.write(tmp, body.getBytes(StandardCharsets.UTF_8));\n            Files.move(tmp, OUT, StandardCopyOption.REPLACE_EXISTING,\n                    StandardCopyOption.ATOMIC_MOVE);\n            return 0;\n        } catch (Exception ex) {\n            try {\n                Files.deleteIfExists(OUT);\n            } catch (Exception ignored) {\n            }\n            return 1;\n        }\n    }\n\n    public static void main(String[] a) {\n        System.exit(rib_n(a));\n    }\n\n    static boolean lid_q() {\n        try {\n            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\n            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\n                var e = z.getEntry(\"STAMP\");\n                if (e == null) {\n                    return false;\n                }\n                String got = new String(z.getInputStream(e).readAllBytes(),\n                        StandardCharsets.UTF_8).trim();\n                return want.equals(got);\n            }\n        } catch (Exception ex) {\n            return false;\n        }\n    }\n}\nEOF\n/app/bin/cinderwait kindle\n"]
