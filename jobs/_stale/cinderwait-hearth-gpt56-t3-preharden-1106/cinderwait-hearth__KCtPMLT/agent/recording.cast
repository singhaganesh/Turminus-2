[92.719801, "o", "public class Glue {\r\n\u001b[?2004l\r\u001b[?2004h>     public static int go(Tarn t, int w) throws InterruptedException {\r\n\u001b[?2004l\r\u001b[?2004h>         if (w == 0) {\r\n\u001b[?2004l\r\u001b[?2004h>             return 0;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.719926, "o", "        Thread th = new Thread(() -> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.720647, "o", ">             while (t.waiting == 0) {\r\n\u001b[?2004l\r\u001b[?2004h>                 Thread.onSpinWait();\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             Hopper.feed(t, w);\r\n\u001b[?2004l\r\u001b[?2004h>         });\r\n\u001b[?2004l\r\u001b[?2004h>         th.start();\r\n\u001b[?2004l\r\u001b[?2004h>         int seen = t.mira();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.720809, "o", "        th.join();\r\n\u001b[?2004l\r\u001b[?2004h>         return seen;\r\n\u001b[?2004l\r"]
[92.72093, "o", "\u001b[?2004h> "]
