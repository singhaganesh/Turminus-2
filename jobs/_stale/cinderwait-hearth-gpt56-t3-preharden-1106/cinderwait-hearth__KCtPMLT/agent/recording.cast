[50.97643, "o", "ASCIINEMA_REC=1\r\nGCC_MIRRORS=https://ftpmirror.gnu.org/gcc \t\thttps://mirrors.kernel.org/gnu/gcc \t\thttps://bigsearcher.com/mirrors/gcc/releases \t\thttp://www.netgull.com/gcc/releases \t\thttps://ftpmirror.gnu.org/gcc \t\thttps://sourceware.org/pub/gcc/releases \t\tftp://ftp.gnu.org/gnu/gcc\r\nGCC_VERSION=13.4.0\r\nGPG_KEYS=B215C1633BCA0477615F1B35A5B3A004745C015A \tB3C42148A44E6983B3E4CC0793FA9B1AB75C61B8 \t90AA470469D3965A87A5DCB494D03953902C9419 \t80F98B2E0DAB6C8281BDF541A7C8C3B2F71EDF1C \t7F74F97C103468EE5D750B583AB00996FC26A641 \t33C235A34C46AA3FFB293709A328C3A2C3C45C06 \tD3A93CAD751C2AF4F8C7AD516C35B99309B5FA62\r\nHOME=/root\r\nHOSTNAME=e5a90d3f3647\r\nJAVA_HOME=/opt/java/openjdk\r\nLC_CTYPE=C.UTF-8\r\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\r\nPWD=/app\r\nSHELL=/bin/bash\r\nSHLVL=2\r\nTERM=tmux-256color\r\nTERM_PROGRAM=tmux\r\nTERM_PROGRAM_VERSION=3.3a\r\nTMUX=/tmp/tmux-0/default,35,0\r\nTMUX_PANE=%0\r\n_=/usr/bin/env\r\n\u001b[?2004hroot@e5a90d3f3647:/app# "]
[92.700824, "i", "cat > /app/tarnpit/Tarn.java <<'EOF'\npublic class Tarn {\n    public volatile int waiting;\n    public volatile int keld;\n    public int copy;\n\n    public int mira() {\n        waiting = 1;\n        int a;\n        while ((a = keld) == 0) {\n            Thread.onSpinWait();\n        }\n        return a;\n    }\n}\nEOF\ncat > /app/hopcue/Hopper.java <<'EOF'\npublic class Hopper {\n    public static void feed(Tarn t, int w) {\n        t.copy = w;\n        if (w != 0) {\n            t.keld = w + 9;\n        }\n    }\n}\nEOF\ncat > /app/watchbay/Glue.java <<'EOF'\npublic class Glue {\n    public static int go(Tarn t, int w) throws InterruptedException {\n        if (w == 0) {\n            return 0;\n        }\n        Thread th = new Thread(() -> {\n            while (t.waiting == 0) {\n                Thread.onSpinWait();\n            }\n            Hopper.feed(t, w);\n        });\n        th.start();\n        int seen = t.mira();\n        th.join();\n        return seen;\n    }\n}\nEOF\n"]
