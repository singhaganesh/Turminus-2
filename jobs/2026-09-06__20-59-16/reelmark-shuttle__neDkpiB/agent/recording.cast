[12.084603, "o", "printf '%s\\n' '--- calls.lst ---'; cat /app/tapewell/desc/calls.lst; printf '%s\\n' '--- reels and fixtures ---'; for f in /app/tapewell/spools/* /app/tapewell/fixtures/*; do echo \"### $f\"; xxd -g1 \"$f\"; done; printf '%s\\n' '--- current generated/run files ---'; find /app/emitwell /app/reelcli/run -maxdepth 3 -type f -print -exec sh -c 'echo ---; cat \"$1\"; echo' _ {} \\; 2>/dev/null\r\n\u001b[?2004l\r"]
