[34.648067, "o", "     1\t#include \"hdr_write.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t\r\n     5\textern int suggest_floor(void);\r\n     6\t\r\n     7\tint write_hdr(FILE *fp, const char *stamp)\r\n     8\t{\r\n     9\t    const int mark_now = suggest_floor();\r\n    10\t\r\n    11\t    if (fp == NULL || stamp == NULL) {\r\n    12\t        return -1;\r\n"]
[34.648957, "o", "    13\t    }\r\n    14\t    if (fprintf(fp, \"REEL\\n\") < 0) {\r\n    15\t        return -1;\r\n    16\t    }\r\n    17\t    if (fprintf(fp, \"MARK %d\\n\", mark_now) < 0) {\r\n    18\t        return -1;\r\n    19\t    }\r\n    20\t    if (fprintf(fp, \"SLOT lab\\n\") < 0) {\r\n    21\t        return -1;\r\n    22\t    }\r\n    23\t    if (fprintf(fp, \"STAMP %s\\n\", stamp) < 0) {\r\n    24\t        return -1;\r\n    25\t    }\r\n    26\t    return 0;\r\n    27\t}\r\n"]
[34.649466, "o", "===== rows_write.c =====\r\n"]
[34.652982, "o", "     1\t#include \"rows_write.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint write_rows(FILE *out, const char *desc_path)\r\n     7\t{\r\n     8\t    FILE *fp;\r\n     9\t    char line[256];\r\n    10\t    char name[64];\r\n    11\t    int id;\r\n    12\t\r\n    13\t    if (out == NULL || desc_path == NULL) {\r\n    14\t        return -1;\r\n    15\t    }\r\n    16\t    fp = fopen(desc_path, \"r\");\r\n    17\t    if (fp == NULL) {\r\n    18\t        return -1;\r\n    19\t    }\r\n    20\t    while (fgets(line, sizeof(line), fp) != NULL) {\r\n    21\t        if (line[0] == '#' || line[0] == '\\n') {\r\n    22\t            continue;\r\n    23\t        }\r\n    24\t        if (sscanf(line, \"%63s %d\", name, &id) != 2) {\r\n    25\t            continue;\r\n    26\t        }\r\n    27\t        if (fprintf(out, \"CALL %s %d live\\n\", name, id) < 0) {\r\n    28\t            fclose(fp);\r\n    29\t            return -1;\r\n    30\t        }\r\n    31\t    }\r\n    32\t    fclose(fp);\r\n    33\t    return 0;\r\n    34\t}\r\n===== mix.c =====\r\n"]
[34.654593, "o", "     1\t#include \"mix.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdint.h>\r\n     5\t\r\n     6\tint mix_tag(const char *path, char *out, unsigned out_len)\r\n     7\t{\r\n     8\t    FILE *fp;\r\n     9\t    uint32_t h = 2166136261u;\r\n    10\t    int c;\r\n    11\t\r\n    12\t    if (path == NULL || out == NULL || out_len < 9) {\r\n    13\t        return -1;\r\n    14\t    }\r\n    15\t    fp = fopen(path, \"r\");\r\n    16\t    if (fp == NULL) {\r\n    17\t        return -1;\r\n    18\t    }\r\n    19\t    while ((c = fgetc(fp)) != EOF) {\r\n    20\t        h ^= (unsigned char)c;\r\n    21\t        h *= 16777619u;\r\n    22\t    }\r\n    23\t    fclose(fp);\r\n    24\t    if (snprintf(out, out_len, \"%08x\", h) < 0) {\r\n    25\t        return -1;\r\n    26\t    }\r\n    27\t    return 0;\r\n    28\t}\r\n===== note_write.c =====\r\n"]
[34.655982, "o", "     1\t#include \"note_write.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t\r\n     5\tint write_note(const char *path, const char *stamp)\r\n     6\t{\r\n     7\t    FILE *fp;\r\n     8\t\r\n     9\t    if (path == NULL || stamp == NULL) {\r\n    10\t        return -1;\r\n    11\t    }\r\n    12\t    fp = fopen(path, \"w\");\r\n    13\t    if (fp == NULL) {\r\n    14\t        return -1;\r\n    15\t    }\r\n    16\t    if (fprintf(fp, \"%s\\n\", stamp) < 0) {\r\n    17\t        fclose(fp);\r\n    18\t        return -1;\r\n    19\t    }\r\n    20\t    fclose(fp);\r\n    21\t    return 0;\r\n    22\t}\r\n"]
