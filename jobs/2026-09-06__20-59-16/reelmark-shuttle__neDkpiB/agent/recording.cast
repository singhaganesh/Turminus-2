[75.952958, "i", "python3 - <<'PY'\np='/app/reelcli/cli/spin.c'\ns=open(p).read()\n# Require exactly the documented argument forms.\ns=s.replace('if (argc >= 2 && strcmp(argv[0], \"--blob\") == 0) {\\n        blob = argv[1];\\n        spool = (argc >= 3) ? argv[2] : NULL;\\n    } else if (argc >= 1) {\\n        spool = argv[0];\\n    }', 'if (argc == 3 && strcmp(argv[0], \"--blob\") == 0) {\\n        blob = argv[1];\\n        spool = argv[2];\\n    } else if (argc == 1) {\\n        spool = argv[0];\\n    }')\n# No fallback bank is valid on this image.\ns=s.replace('if (admit_rc < 0) {\\n        return 2;\\n    }', 'if (admit_rc != 0) {\\n        return 2;\\n    }')\nopen(p,'w').write(s)\nPY\n# Add description-list authorization and strict one-token spool parsing.\npython3 - <<'PY'\np='/app/reelcli/cli/spin.c'\ns=open(p).read()\nneedle='static int read_spool_call(const char *path, char *name, unsigned name_len)\\n'\nhelper='''static int desc_has(const char *name)\\n{\n    FILE *fp = fopen(DESC_PATH, \"r\");\n    char line[LINE_LEN], row[NAME_LEN], extra;\n    int id;\n    if (fp == NULL) return 0;\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (sscanf(line, \"%63s %d %c\", row, &id, &extra) == 2 &&\n            strcmp(row, name) == 0) {\n            fclose(fp);\n            return 1;\n        }\n    }\n    fclose(fp);\n    return 0;\n}\n\n'''\ns=s.replace(needle, helper+needle)\ns=s.replace('char line[LINE_LEN];\\n\\n    fp = fopen(path, \"r\");', 'char line[LINE_LEN];\\n    char extra;\\n\\n    fp = fopen(path, \"r\");', 1)\ns=s.replace('if (sscanf(line, \"%63s\", name) != 1) {', 'if (sscanf(line, \"%63s %c\", name, &extra) != 1) {')\ns=s.replace('if (read_spool_call(spool, call, sizeof(call)) != 0) {\\n        return 2;\\n    }', 'if (read_spool_call(spool, call, sizeof(call)) != 0 || !desc_has(call)) {\\n        return 2;\\n    }')\n# A CALL only covers a name if its complete schema and live class are valid.\ns=s.replace('if (sscanf(line + 5, \"%63s %d %31s\", row_name, &id, cls) >= 2) {\\n            if (strcmp(row_name, name) == 0) {', 'if (sscanf(line + 5, \"%63s %d %31s\", row_name, &id, cls) == 3) {\\n            if (strcmp(cls, \"live\") == 0 && strcmp(row_name, name) == 0) {')\n# Clear both run-state files before any attempt.\ns=s.replace('unlink(ACCEPT_PATH);', 'unlink(ACCEPT_PATH);\\n    unlink(LOADED_SET_PATH);')\nopen(p,'w').write(s)\nPY\nmake -C /app/reelcli hull\n"]
