[75.77607, "i", "python3 - <<'PY'\np='/app/ab/knt/hdr_write.c'\ns=open(p).read()\ns=s.replace('fprintf(fp, \"SLOT lab\\\\n\")', 'fprintf(fp, \"SLOT %.4s\\\\n\", stamp)')\nopen(p,'w').write(s)\nPY\ncat > /app/ef/ply/sel.c <<'EOF'\n#include \"sel.h\"\n\nint sel_bank(int admit_rc)\n{\n    return admit_rc == 0 ? 0 : 1;\n}\nEOF\ncat > /app/cd/flr/xin.c <<'EOF'\n#include \"xin.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic int lower_hex(const char *s, size_t n)\n{\n    size_t i;\n    if (strlen(s) != n) return 0;\n    for (i = 0; i < n; ++i) {\n        if (!((s[i] >= '0' && s[i] <= '9') ||\n              (s[i] >= 'a' && s[i] <= 'f'))) return 0;\n    }\n    return 1;\n}\n\nint xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)\n{\n    FILE *fp;\n    char line[256], slot[32], stamp[32], name[64], cls[32], extra;\n    char *end;\n    long mark, id;\n    int rows = 0;\n\n    if (path == NULL || stamp_out == NULL || stamp_cap < 9) return -1;\n    fp = fopen(path, \"r\");\n    if (fp == NULL) return -1;\n\n    if (fgets(line, sizeof(line), fp) == NULL || strcmp(line, \"REEL\\n\") != 0)\n        goto bad;\n    if (fgets(line, sizeof(line), fp) == NULL || strncmp(line, \"MARK \", 5) != 0)\n        goto bad;\n    end = NULL;\n    mark = strtol(line + 5, &end, 10);\n    if (end == line + 5 || (*end != '\\n' && *end != '\\0')) goto bad;\n\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"SLOT %31s %c\", slot, &extra) != 1) goto bad;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"STAMP %31s %c\", stamp, &extra) != 1) goto bad;\n    if (!lower_hex(slot, 4) || !lower_hex(stamp, 8) ||\n        strncmp(slot, stamp, 4) != 0) goto bad;\n\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        char *id_end;\n        if (strncmp(line, \"CALL \", 5) != 0 ||\n            sscanf(line, \"CALL %63s\", name) != 1) goto bad;\n        {\n            char n2[64];\n            int used = 0;\n            if (sscanf(line, \"CALL %63s %n\", n2, &used) != 1 || used == 0) goto bad;\n            id = strtol(line + used, &id_end, 10);\n            if (id_end == line + used) goto bad;\n            while (*id_end == ' ' || *id_end == '\\t') ++id_end;\n            if (sscanf(id_end, \"%31s %c\", cls, &extra) != 1 ||\n                strcmp(cls, \"live\") != 0) goto bad;\n        }\n        (void)id;\n        ++rows;\n    }\n    if (ferror(fp) || rows == 0) goto bad;\n    fclose(fp);\n    if (mark_out != NULL) *mark_out = (int)mark;\n    memcpy(stamp_out, stamp, 9);\n    return 0;\n\nbad:\n    fclose(fp);\n    return -1;\n}\nEOF\n"]
