[24.192823, "o", "     8\t    FILE *fp;\r\n     9\t    char line[256];\r\n    10\t    char name[64];\r\n    11\t    int id;\r\n    12\t\r\n    13\t    if (out == NULL || desc_path == NULL) {\r\n    14\t        return -1;\r\n    15\t    }\r\n    16\t    fp = fopen(desc_path, \"r\");\r\n    17\t    if (fp == NULL) {\r\n    18\t        return -1;\r\n    19\t    }\r\n    20\t    while (fgets(line, sizeof(line), fp) != NULL) {\r\n    21\t        if (line[0] == '#' || line[0] == '\\n') {\r\n    22\t            continue;\r\n    23\t        }\r\n    24\t        if (sscanf(line, \"%63s %d\", name, &id) != 2) {\r\n    25\t            continue;\r\n    26\t        }\r\n    27\t        if (fprintf(out, \"CALL %s %d live\\n\", name, id) < 0) {\r\n    28\t            fclose(fp);\r\n    29\t            return -1;\r\n    30\t        }\r\n    31\t    }\r\n    32\t    fclose(fp);\r\n    33\t    return 0;\r\n    34\t}\r\n"]
