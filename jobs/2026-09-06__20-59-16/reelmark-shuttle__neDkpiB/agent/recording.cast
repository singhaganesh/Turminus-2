[78.939229, "i", "echo '--- invalid fixture spins'\nfor f in stale lab; do rm -f /app/reelcli/run/accept.ok /app/reelcli/run/loaded.set; /app/bin/nockreel spin --blob \"/app/tapewell/fixtures/$f.tbl\" /app/tapewell/spools/open.reel; rc=$?; printf '%s rc=%s accept=%s loaded=%s\\n' \"$f\" \"$rc\" \"$(test -e /app/reelcli/run/accept.ok && echo present || echo absent)\" \"$(test -e /app/reelcli/run/loaded.set && echo present || echo absent)\"; done\necho '--- final canonical success'\n/app/bin/nockreel spin /app/tapewell/spools/splice.reel; echo \"rc=$?\"; printf 'accept='; cat /app/reelcli/run/accept.ok; printf 'loaded='; cat /app/reelcli/run/loaded.set\nfile /app/bin/nockreel\n"]
