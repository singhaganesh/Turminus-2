[11.096508, "o", "\u001b[?2004hroot@156b54172681:/app# "]
[11.431771, "i", "printf '%s\\n' '--- GRAMMAR ---'; cat /app/fieldpack/GRAMMAR.txt; printf '%s\\n' '--- CLI ---'; cat /app/fieldpack/CLI.txt; printf '%s\\n' '--- ROUTE MAP ---'; cat /app/fieldpack/ROUTE_MAP.txt; printf '%s\\n' '--- HULL ---'; cat /app/reelcli/HULL.txt\n"]
[11.433039, "o", "printf '%s\\n' '--- GRAMMAR ---'; cat /app/fieldpack/GRAMMAR.txt; printf '%s\\n' '--- CLI ---'; cat /app/fieldpack/CLI.txt; printf '%s\\n' '--- ROUTE MAP ---'; cat /app/fieldpack/ROUTE_MAP.txt; printf '%s\\n' '--- HULL ---'; cat /app/reelcli/HULL.txt\r\n\u001b[?2004l\r--- GRAMMAR ---\r\n"]
[11.434283, "o", "capset.tbl line grammar\r\n\r\nREEL\r\nMARK <integer>\r\nSLOT <token>\r\nSTAMP <8 lowercase hex>\r\nCALL <name> <id> <class>\r\n\r\nPoured rows use class token live.\r\nSLOT on a poured blob is the leading hex prefix of that blob's STAMP (four digits).\r\nA SLOT that does not match that prefix must not load.\r\n\r\nspin prints one JSON object with string keys loaded, status, and call.\r\nloaded is table: plus the STAMP value when the poured blob is used.\r\nloaded is builtin: plus a stock token when compiled-in names are used.\r\nstatus is replayed when the active name set covers the spool call.\r\nA spool file is a single token: the call name.\r\nopen.reel is sys_openat2. held.reel is sys_held_pair. splice.reel is sys_loom_splice.\r\nspin accepts any spool path whose token appears on /app/tapewell/desc/calls.lst.\r\n"]
[11.434575, "o", "--- CLI ---\r\n"]
[11.435706, "o", "spin extra flags\r\n\r\n--blob PATH   use PATH instead of /app/emitwell/knit/capset.tbl\r\nSPOOL may be any one-token reel path, not only files under /app/tapewell/spools.\r\n\r\nHull name xin_blob stays in the linked nockreel image (`nm --defined-only`).\r\n"]
[11.435888, "o", "--- ROUTE MAP ---\r\n"]
[11.436789, "o", "pour / spin wiring (internal)\r\n\r\n`make -C /app/reelcli hull` links the pour/spin objects into /app/bin/nockreel.\r\n\r\nGrammar: /app/fieldpack/GRAMMAR.txt\r\nFlags: /app/fieldpack/CLI.txt\r\n"]
[11.43705, "o", "--- HULL ---\r\n"]
[11.437895, "o", "reelcli sources. `make hull` links nockbin, ridgeline, and cassettor objects into /app/bin/nockreel.\r\n\r\n/app/bin/nockreel is a native ELF image (first four bytes 0x7f 'E' 'L' 'F'). A shebang script is not the hull.\r\n\r\n`nm --defined-only /app/bin/nockreel` lists write_hdr among defined text names.\r\n"]
[11.438095, "o", "\u001b[?2004hroot@156b54172681:/app# "]
[11.565352, "i", "printf '%s\\n' '--- SOURCE/BUILD ---'; find /app -maxdepth 2 -type f \\( -name '*.c' -o -name '*.h' -o -name 'Makefile' -o -name '*.mk' \\) -print -exec sed -n '1,240p' {} \\;\n"]
[11.565996, "o", "printf '%s\\n' '--- SOURCE/BUILD ---'; find /app -maxdepth 2 -type f \\( -name '*.c' -o -name '*.h' -o -name 'Makefile' -o -name '*.mk' \\) -print -exec sed -n '1,240p' {} \\;\r\n\u001b[?2004l\r"]
[11.566145, "o", "--- SOURCE/BUILD ---\r\n"]
[11.568207, "o", "/app/reelcli/Makefile\r\n"]
[11.569869, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -I../ab -I../ab/knt -I../ab/tgw -I../cd/flr -I../ef/ply\r\nSRC := cli/main.c cli/pour.c cli/spin.c \\\r\n\t../ef/ply/sel.c \\\r\n\t../ef/ply/stock.c \\\r\n\t../cd/flr/xin.c \\\r\n\t../cd/flr/compat.c \\\r\n\t../ab/knt/hdr_write.c \\\r\n\t../ab/knt/rows_write.c \\\r\n\t../ab/knt/mix.c \\\r\n\t../ab/tgw/note_write.c\r\nBIN := /app/bin/nockreel\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/emitwell/knit /app/reelcli/run\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[11.570573, "o", "/app/ab/common.h\r\n"]
[11.571803, "o", "#ifndef NOCKBIN_COMMON_H\r\n#define NOCKBIN_COMMON_H\r\n\r\n#define STAMP_LEN 8\r\n#define NAME_LEN 64\r\n#define LINE_LEN 256\r\n#define MAX_ROWS 128\r\n\r\n#define DESC_PATH \"/app/tapewell/desc/calls.lst\"\r\n#define CAPSET_PATH \"/app/emitwell/knit/capset.tbl\"\r\n#define KNIT_OK_PATH \"/app/emitwell/knit/knit.ok\"\r\n#define LOADED_SET_PATH \"/app/reelcli/run/loaded.set\"\r\n#define ACCEPT_PATH \"/app/reelcli/run/accept.ok\"\r\n"]
[11.571941, "o", "\r\n#endif\r\n"]
