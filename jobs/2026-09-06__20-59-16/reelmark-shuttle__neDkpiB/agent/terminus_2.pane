     5	
     6	int write_rows(FILE *out, const char *desc_path)
     7	{
     8	    FILE *fp;
     9	    char line[256];
    10	    char name[64];
    11	    int id;
    12	
    13	    if (out == NULL || desc_path == NULL) {
    14	        return -1;
    15	    }
    16	    fp = fopen(desc_path, "r");
    17	    if (fp == NULL) {
    18	        return -1;
    19	    }
    20	    while (fgets(line, sizeof(line), fp) != NULL) {
    21	        if (line[0] == '#' || line[0] == '\n') {
    22	            continue;
    23	        }
    24	        if (sscanf(line, "%63s %d", name, &id) != 2) {
    25	            continue;
    26	        }
    27	        if (fprintf(out, "CALL %s %d live\n", name, id) < 0) {
    28	            fclose(fp);
    29	            return -1;
    30	        }
    31	    }
    32	    fclose(fp);
    33	    return 0;
    34	}
===== mix.c =====
     1	#include "mix.h"
     2	
     3	#include <stdio.h>
     4	#include <stdint.h>
     5	
     6	int mix_tag(const char *path, char *out, unsigned out_len)
     7	{
     8	    FILE *fp;
     9	    uint32_t h = 2166136261u;
    10	    int c;
    11	
    12	    if (path == NULL || out == NULL || out_len < 9) {
    13	        return -1;
    14	    }
    15	    fp = fopen(path, "r");
    16	    if (fp == NULL) {
    17	        return -1;
    18	    }
    19	    while ((c = fgetc(fp)) != EOF) {
    20	        h ^= (unsigned char)c;
    21	        h *= 16777619u;
    22	    }
    23	    fclose(fp);
    24	    if (snprintf(out, out_len, "%08x", h) < 0) {
    25	        return -1;
    26	    }
    27	    return 0;
    28	}
