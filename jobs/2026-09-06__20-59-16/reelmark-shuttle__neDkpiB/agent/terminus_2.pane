     7	int write_hdr(FILE *fp, const char *stamp)
     8	{
     9	    const int mark_now = suggest_floor();
    10	
    11	    if (fp == NULL || stamp == NULL) {
    12	        return -1;
    13	    }
    14	    if (fprintf(fp, "REEL\n") < 0) {
    15	        return -1;
    16	    }
    17	    if (fprintf(fp, "MARK %d\n", mark_now) < 0) {
    18	        return -1;
    19	    }
    20	    if (fprintf(fp, "SLOT lab\n") < 0) {
    21	        return -1;
    22	    }
    23	    if (fprintf(fp, "STAMP %s\n", stamp) < 0) {
    24	        return -1;
    25	    }
    26	    return 0;
    27	}
===== rows_write.c =====
     1	#include "rows_write.h"
