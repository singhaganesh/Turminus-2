     9	
    10	static int blob_has(const char *path, const char *name)
    11	{
    12	    FILE *fp;
    13	    char line[LINE_LEN];
    14	    char row_name[NAME_LEN];
    15	    int id;
    16	    char cls[32];
    17	
    18	    fp = fopen(path, "r");
    19	    if (fp == NULL) {
    20	        return 0;
    21	    }
    22	    while (fgets(line, sizeof(line), fp) != NULL) {
    23	        if (strncmp(line, "CALL ", 5) != 0) {
    24	            continue;
    25	        }
    26	        if (sscanf(line + 5, "%63s %d %31s", row_name, &id, cls) >= 2) {
    27	            if (strcmp(row_name, name) == 0) {
    28	                fclose(fp);
    29	                return 1;
    30	            }
    31	        }
    32	    }
    33	    fclose(fp);
    34	    return 0;
    35	}
    36	
    37	static int read_spool_call(const char *path, char *name, unsigned name_len)
    38	{
    39	    FILE *fp;
    40	    char line[LINE_LEN];
    41	
    42	    fp = fopen(path, "r");
    43	    if (fp == NULL) {
    44	        return -1;
    45	    }
    46	    if (fgets(line, sizeof(line), fp) == NULL) {
    47	        fclose(fp);
    48	        return -1;
    49	    }
    50	    fclose(fp);
    51	    if (sscanf(line, "%63s", name) != 1) {
    52	        return -1;
    53	    }
    54	    if (strlen(name) >= name_len) {
    55	        return -1;
    56	    }
    57	    return 0;
    58	}
    59	
    60	int cmd_spin(int argc, char **argv)
    61	{
    62	    const char *blob = CAPSET_PATH;
    63	    const char *spool = NULL;
    64	    char call[NAME_LEN];
    65	    char stamp[32];
    66	    int mark = 0;
    67	    int admit_rc;
    68	    int bank;
    69	    int covered;
    70	    const char *st;
    71	    const char *prefix;
    72	    FILE *fp;
    73	
    74	    stamp[0] = '\0';
    75	    if (argc >= 2 && strcmp(argv[0], "--blob") == 0) {
    76	        blob = argv[1];
    77	        spool = (argc >= 3) ? argv[2] : NULL;
    78	    } else if (argc >= 1) {
    79	        spool = argv[0];
    80	    }
    81	    if (spool == NULL) {
    82	        fprintf(stderr, "usage: nockreel spin [--blob PATH] SPOOL\n");
    83	        return 2;
    84	    }
    85	    unlink(ACCEPT_PATH);
    86	    if (read_spool_call(spool, call, sizeof(call)) != 0) {
    87	        return 2;
    88	    }
    89	    admit_rc = xin_blob(blob, &mark, stamp, sizeof(stamp));
    90	    if (admit_rc < 0) {
    91	        return 2;
    92	    }
    93	    bank = sel_bank(admit_rc);
    94	    if (bank == 0) {
    95	        covered = blob_has(blob, call);
    96	        prefix = "table:";
    97	    } else {
    98	        covered = stock_has(call);
    99	        prefix = "builtin:";
   100	        snprintf(stamp, sizeof(stamp), "stock");
   101	    }
   102	    st = covered ? "replayed" : "unsupported";
   103	    printf("{\"loaded\":\"%s%s\",\"status\":\"%s\",\"call\":\"%s\"}\n",
   104	           prefix, stamp, st, call);
   105	    fp = fopen(LOADED_SET_PATH, "w");
   106	    if (fp != NULL) {
   107	        fprintf(fp, "%s%s\n", prefix, stamp);
   108	        fclose(fp);
   109	    }
   110	    if (admit_rc == 0 && bank == 0) {
   111	        fp = fopen(ACCEPT_PATH, "w");
   112	        if (fp != NULL) {
   113	            fputs("1\n", fp);
   114	            fclose(fp);
   115	        }
   116	    }
   117	    (void)mark;
   118	    return 0;
   119	}
===== xin.c =====
     1	#include "xin.h"
     2	
     3	#include <stdio.h>
     4	#include <string.h>
     5	
     6	#ifndef BANK_FLOOR
     7	#define BANK_FLOOR 3
     8	#endif
     9	
    10	int xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)
    11	{
    12	    FILE *fp;
    13	    char line[256];
    14	    int mark = 0;
    15	    char stamp[32];
    16	    int saw_mark = 0;
    17	    int saw_stamp = 0;
    18	
    19	    stamp[0] = '\0';
    20	    if (path == NULL) {
    21	        return 1;
    22	    }
    23	    fp = fopen(path, "r");
    24	    if (fp == NULL) {
    25	        return 1;
    26	    }
    27	    while (fgets(line, sizeof(line), fp) != NULL) {
    28	        if (strncmp(line, "MARK ", 5) == 0) {
    29	            if (sscanf(line + 5, "%d", &mark) == 1) {
    30	                saw_mark = 1;
    31	            }
    32	        } else if (strncmp(line, "STAMP ", 6) == 0) {
    33	            if (sscanf(line + 6, "%31s", stamp) == 1) {
    34	                saw_stamp = 1;
    35	            }
    36	        }
    37	    }
    38	    fclose(fp);
    39	    if (!saw_mark) {
    40	        return 1;
    41	    }
    42	    if (mark_out != NULL) {
    43	        *mark_out = mark;
    44	    }
    45	    if (stamp_out != NULL && stamp_cap > 0 && saw_stamp) {
    46	        strncpy(stamp_out, stamp, stamp_cap - 1);
    47	        stamp_out[stamp_cap - 1] = '\0';
    48	    }
    49	    if (mark < BANK_FLOOR) {
    50	        return 1;
    51	    }
    52	    return 0;
    53	}
