[27.042665, "i", "echo '--- baseline pour ---'; /app/bin/nockreel pour; echo \"pour_rc=$?\"; cat /app/emitwell/knit/capset.tbl; cat /app/emitwell/knit/knit.ok; echo '--- baseline spins ---'; for r in open held splice; do rm -f /app/reelcli/run/accept.ok /app/reelcli/run/loaded.set; /app/bin/nockreel spin \"/app/tapewell/spools/$r.reel\"; rc=$?; printf '%s rc=%s accept=' \"$r\" \"$rc\"; cat /app/reelcli/run/accept.ok 2>/dev/null || echo absent; printf 'loaded='; cat /app/reelcli/run/loaded.set 2>/dev/null || echo absent; done; for b in stale lab; do rm -f /app/reelcli/run/accept.ok /app/reelcli/run/loaded.set; /app/bin/nockreel spin --blob \"/app/tapewell/fixtures/$b.tbl\" /app/tapewell/spools/open.reel; echo \"$b rc=$? accept=$(cat /app/reelcli/run/accept.ok 2>/dev/null || echo absent) loaded=$(cat /app/reelcli/run/loaded.set 2>/dev/null || echo absent)\"; done\n"]
