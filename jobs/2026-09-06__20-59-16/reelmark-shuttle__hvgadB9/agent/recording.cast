[87.433149, "i", "set -e\n/app/bin/nockreel pour\nout=$(/app/bin/nockreel spin /app/tapewell/spools/splice.reel)\nprintf '%s\\n' \"$out\"\npython3 -c 'import json,sys; x=json.loads(sys.argv[1]); assert set(x)=={\"loaded\",\"status\",\"call\"}; assert all(isinstance(v,str) for v in x.values()); assert x[\"loaded\"].startswith(\"table:\"); assert x[\"status\"]==\"replayed\"; assert x[\"call\"]==\"sys_loom_splice\"' \"$out\"\ntest \"$(cat /app/reelcli/run/accept.ok)\" = 1\ntest \"$(cat /app/reelcli/run/loaded.set)\" = \"table:$(awk '{$1=$1};1' /app/emitwell/knit/knit.ok)\"\nnm --defined-only /app/bin/nockreel | grep -E ' [Tt] (xin_blob|write_hdr|sel_bank)$'\nprintf 'final accept=%s loaded=%s\\n' \"$(cat /app/reelcli/run/accept.ok)\" \"$(cat /app/reelcli/run/loaded.set)\"\n"]
