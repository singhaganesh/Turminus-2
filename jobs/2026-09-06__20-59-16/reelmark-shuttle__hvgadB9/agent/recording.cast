[58.393622, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *fp;\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.393697, "o", "> "]
[58.393799, "o", "    char line[256], slot[32], stamp[32], name[64], cls[32], extra;\r\n\u001b[?2004l\r"]
[58.393858, "o", "\u001b[?2004h> "]
[58.393926, "o", "    int mark, id, rows = 0, i;\r\n\u001b[?2004l\r"]
[58.393991, "o", "\u001b[?2004h"]
[58.39406, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.394199, "o", "    if (path == NULL || stamp_out == NULL || stamp_cap < 9) return 1;\r\n\u001b[?2004l\r"]
[58.394256, "o", "\u001b[?2004h> "]
[58.394318, "o", "    fp = fopen(path, \"r\");\r\n\u001b[?2004l\r"]
[58.394402, "o", "\u001b[?2004h> "]
[58.394425, "o", "    if (fp == NULL) return 1;\r\n"]
[58.394435, "o", "\u001b[?2004l\r"]
[58.394534, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.394736, "o", "    if (fgets(line, sizeof(line), fp) == NULL || strcmp(line, \"REEL\\n\") != 0) goto bad;\r\n\u001b[?2004l\r"]
[58.394801, "o", "\u001b[?2004h> "]
[58.39488, "o", "    if (fgets(line, sizeof(line), fp) == NULL ||\r\n\u001b[?2004l\r"]
[58.394952, "o", "\u001b[?2004h> "]
[58.395115, "o", "        sscanf(line, \"MARK %d %c\", &mark, &extra) != 1 || mark < BANK_FLOOR) goto bad;\r\n\u001b[?2004l\r"]
[58.395177, "o", "\u001b[?2004h> "]
[58.395271, "o", "    if (fgets(line, sizeof(line), fp) == NULL ||\r\n\u001b[?2004l\r"]
[58.395321, "o", "\u001b[?2004h> "]
[58.395489, "o", "        sscanf(line, \"SLOT %31s %c\", slot, &extra) != 1) goto bad;\r\n\u001b[?2004l\r"]
[58.395531, "o", "\u001b[?2004h> "]
[58.395708, "o", "    if (fgets(line, sizeof(line), fp) == NULL ||\r\n\u001b[?2004l\r"]
[58.395795, "o", "\u001b[?2004h> "]
[58.395907, "o", "        sscanf(line, \"STAMP %31s %c\", stamp, &extra) != 1) goto bad;\r\n\u001b[?2004l\r"]
[58.395971, "o", "\u001b[?2004h> "]
[58.396165, "o", "    if (strlen(stamp) != 8 || strlen(slot) != 4 || strncmp(slot, stamp, 4) != 0) goto bad;\r\n\u001b[?2004l\r"]
[58.396228, "o", "\u001b[?2004h> "]
[58.396309, "o", "    for (i = 0; i < 8; i++) {\r\n\u001b[?2004l\r"]
[58.396376, "o", "\u001b[?2004h> "]
[58.396563, "o", "        if (!isdigit((unsigned char)stamp[i]) && !(stamp[i] >= 'a' && stamp[i] <= 'f')) goto bad;\r\n\u001b[?2004l\r"]
[58.396647, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[58.396708, "o", "\u001b[?2004h> "]
[58.396805, "o", "    while (fgets(line, sizeof(line), fp) != NULL) {\r\n\u001b[?2004l\r"]
[58.396865, "o", "\u001b[?2004h> "]
[58.396923, "o", "        int n = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.396979, "o", "> "]
[58.397117, "o", "        if (sscanf(line, \"CALL %63s %d %31s %n\", name, &id, cls, &n) != 3 ||\r\n\u001b[?2004l\r"]
[58.397174, "o", "\u001b[?2004h> "]
[58.397323, "o", "            !only_eol(line + n) || strcmp(cls, \"live\") != 0) goto bad;\r\n\u001b[?2004l\r"]
[58.397377, "o", "\u001b[?2004h> "]
[58.397434, "o", "        rows++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.397501, "o", ">     }\r\n\u001b[?2004l\r"]
[58.39755, "o", "\u001b[?2004h> "]
[58.39768, "o", "    if (ferror(fp) || rows == 0) goto bad;\r\n\u001b[?2004l\r"]
[58.397747, "o", "\u001b[?2004h>     fclose(fp);\r\n"]
[58.397776, "o", "\u001b[?2004l\r\u001b[?2004h"]
[58.397831, "o", "> "]
[58.397916, "o", "    if (mark_out != NULL) *mark_out = mark;\r\n\u001b[?2004l\r"]
[58.397957, "o", "\u001b[?2004h> "]
[58.398051, "o", "    memcpy(stamp_out, stamp, 9);\r\n\u001b[?2004l\r"]
[58.398068, "o", "\u001b[?2004h"]
[58.398083, "o", "> "]
[58.398132, "o", "    return 0;\r\n\u001b[?2004l\r"]
[58.398148, "o", "\u001b[?2004h"]
[58.398164, "o", "> "]
[58.398366, "o", "bad:\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.398665, "o", ">     fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h>     return 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[58.399958, "o", "\u001b[?2004hroot@518d76982a26:/app# "]
[58.663087, "i", "cat > /app/reelcli/cli/spin.c <<'EOF'\n#include \"common.h\"\n#include \"xin.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int list_has(const char *path, const char *wanted, int table)\n{\n    FILE *fp = fopen(path, \"r\");\n    char line[LINE_LEN], name[NAME_LEN], cls[32];\n    int id, found = 0;\n    if (fp == NULL) return 0;\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (table) {\n            if (sscanf(line, \"CALL %63s %d %31s\", name, &id, cls) == 3 &&\n                strcmp(cls, \"live\") == 0 && strcmp(name, wanted) == 0) found = 1;\n        } else if (sscanf(line, \"%63s %d\", name, &id) == 2 &&\n                   strcmp(name, wanted) == 0) found = 1;\n    }\n    fclose(fp);\n    return found;\n}\n\nstatic int read_spool_call(const char *path, char *name, size_t cap)\n{\n    FILE *fp = fopen(path, \"r\");\n    char line[LINE_LEN], extra;\n    int n;\n    if (fp == NULL) return -1;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"%63s %c\", name, &extra) != 1) { fclose(fp); return -1; }\n    n = fgetc(fp);\n    fclose(fp);\n    if (n != EOF || strlen(name) >= cap) return -1;\n    return 0;\n}\n\nint cmd_spin(int argc, char **argv)\n{\n    const char *blob = CAPSET_PATH, *spool = NULL;\n    char call[NAME_LEN], stamp[STAMP_LEN + 1], loaded[32];\n    int mark;\n    FILE *fp;\n\n    if (argc == 3 && strcmp(argv[0], \"--blob\") == 0) {\n        blob = argv[1]; spool = argv[2];\n    } else if (argc == 1) {\n        spool = argv[0];\n    } else {\n        fprintf(stderr, \"usage: nockreel spin [--blob PATH] SPOOL\\n\");\n        return 2;\n    }\n    unlink(ACCEPT_PATH);\n    unlink(LOADED_SET_PATH);\n    if (read_spool_call(spool, call, sizeof(call)) != 0 ||\n        !list_has(DESC_PATH, call, 0) ||\n        xin_blob(blob, &mark, stamp, sizeof(stamp)) != 0 ||\n        !list_has(blob, call, 1)) {\n        return 1;\n    }\n    snprintf(loaded, sizeof(loaded), \"table:%s\", stamp);\n    printf(\"{\\\"loaded\\\":\\\"%s\\\",\\\"status\\\":\\\"replayed\\\",\\\"call\\\":\\\"%s\\\"}\\n\",\n           loaded, call);\n    fp = fopen(LOADED_SET_PATH, \"w\");\n    if (fp == NULL) return 1;\n    fprintf(fp, \"%s\\n\", loaded);\n    if (fclose(fp) != 0) return 1;\n    fp = fopen(ACCEPT_PATH, \"w\");\n    if (fp == NULL) { unlink(LOADED_SET_PATH); return 1; }\n    fputs(\"1\\n\", fp);\n    if (fclose(fp) != 0) { unlink(ACCEPT_PATH); unlink(LOADED_SET_PATH); return 1; }\n    (void)mark;\n    return 0;\n}\nEOF\nmake -C /app/reelcli hull\n"]
