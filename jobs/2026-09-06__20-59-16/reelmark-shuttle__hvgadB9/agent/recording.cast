[11.313223, "o", "REEL$\r\nMARK 2$\r\nSLOT knit$\r\nSTAMP deadbeef$\r\nCALL sys_openat2 257 live$\r\n"]
[11.313585, "o", "--- /app/tapewell/spools/held.reel ---\r\n"]
