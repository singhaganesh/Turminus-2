[58.391866, "o", "cat > /app/cd/flr/xin.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.391991, "o", "#include \"xin.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.392067, "o", "\u001b[?2004h> "]
[58.392134, "o", "#include <ctype.h>\r\n\u001b[?2004l\r"]
[58.392232, "o", "\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.392308, "o", "#include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.392421, "o", "> #ifndef BANK_FLOOR\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.392493, "o", "#define BANK_FLOOR 3\r\n\u001b[?2004l\r"]
[58.392547, "o", "\u001b[?2004h> #endif\r\n\u001b[?2004l\r"]
[58.392621, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.392669, "o", "\u001b[?2004h> "]
[58.392763, "o", "static int only_eol(const char *p)\r\n\u001b[?2004l\r"]
[58.392841, "o", "\u001b[?2004h"]
[58.392899, "o", "> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.392968, "o", "    while (*p == ' ' || *p == '\\t') p++;\r\n\u001b[?2004l\r"]
[58.393034, "o", "\u001b[?2004h> "]
[58.393138, "o", "    return *p == '\\n' || *p == '\\r' || *p == '\\0';\r\n\u001b[?2004l\r"]
[58.393219, "o", "\u001b[?2004h> "]
[58.393297, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
