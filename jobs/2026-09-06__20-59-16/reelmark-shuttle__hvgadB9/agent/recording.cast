[11.550907, "i", "printf '%s\\n' '--- source/build candidates ---'; find /app -type f \\( -name '*.c' -o -name '*.h' -o -name 'Makefile' -o -name '*.mk' \\) -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\n"]
[11.552078, "o", "printf '%s\\n' '--- source/build candidates ---'; find /app -type f \\( -name '*.c' -o -name '*.h' -o -name 'Makefile' -o -name '*.mk' \\) -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[11.552415, "o", "--- source/build candidates ---\r\n"]
[11.558991, "o", "/app/reelcli/cli/pour.c\r\n"]
[11.560669, "o", "### /app/reelcli/cli/pour.c\r\n"]
[11.564819, "o", "#include \"common.h\"\r\n#include \"hdr_write.h\"\r\n#include \"mix.h\"\r\n#include \"note_write.h\"\r\n#include \"rows_write.h\"\r\n\r\n#include <stdio.h>\r\n\r\nint cmd_pour(void)\r\n{\r\n    char stamp[STAMP_LEN + 1];\r\n    FILE *fp;\r\n\r\n    if (mix_tag(DESC_PATH, stamp, sizeof(stamp)) != 0) {\r\n        return 1;\r\n    }\r\n    fp = fopen(CAPSET_PATH, \"w\");\r\n    if (fp == NULL) {\r\n        return 1;\r\n    }\r\n    if (write_hdr(fp, stamp) != 0) {\r\n        fclose(fp);\r\n        return 1;\r\n    }\r\n    if (write_rows(fp, DESC_PATH) != 0) {\r\n        fclose(fp);\r\n        return 1;\r\n    }\r\n    fclose(fp);\r\n    if (write_note(KNIT_OK_PATH, stamp) != 0) {\r\n        return 1;\r\n    }\r\n    return 0;\r\n"]
[11.565081, "o", "}\r\n"]
[11.565867, "o", "/app/reelcli/cli/main.c\r\n"]
[11.567568, "o", "### /app/reelcli/cli/main.c\r\n"]
[11.569502, "o", "#include <stdio.h>\r\n#include <string.h>\r\n\r\nint cmd_pour(void);\r\nint cmd_spin(int argc, char **argv);\r\n\r\nint main(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"usage: nockreel pour|spin ...\\n\");\r\n        return 2;\r\n    }\r\n    if (strcmp(argv[1], \"pour\") == 0) {\r\n        return cmd_pour();\r\n"]
[11.569861, "o", "    }\r\n    if (strcmp(argv[1], \"spin\") == 0) {\r\n        return cmd_spin(argc - 2, argv + 2);\r\n    }\r\n    fprintf(stderr, \"unknown subcommand\\n\");\r\n    return 2;\r\n}\r\n"]
[11.5704, "o", "/app/reelcli/cli/spin.c\r\n"]
[11.572655, "o", "### /app/reelcli/cli/spin.c\r\n"]
[11.575005, "o", "#include \"common.h\"\r\n#include \"sel.h\"\r\n#include \"stock.h\"\r\n#include \"xin.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n#include <unistd.h>\r\n\r\nstatic int blob_has(const char *path, const char *name)\r\n{\r\n    FILE *fp;\r\n    char line[LINE_LEN];\r\n"]
[11.575286, "o", "    char row_name[NAME_LEN];\r\n    int id;\r\n    char cls[32];\r\n\r\n    fp = fopen(path, \"r\");\r\n    if (fp == NULL) {\r\n        return 0;\r\n    }\r\n    while (fgets(line, sizeof(line), fp) != NULL) {\r\n        if (strncmp(line, \"CALL \", 5) != 0) {\r\n            continue;\r\n        }\r\n        if (sscanf(line + 5, \"%63s %d %31s\", row_name, &id, cls) >= 2) {\r\n            if (strcmp(row_name, name) == 0) {\r\n                fclose(fp);\r\n                return 1;\r\n            }\r\n        }\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\nstatic int read_spool_call(const char *path, char *name, unsigned name_len)\r\n{\r\n    FILE *fp;\r\n    char line[LINE_LEN];\r\n\r\n    fp = fopen(path, \"r\");\r\n    if (fp == NULL) {\r\n        return -1;\r\n    }\r\n    if (fgets(line, sizeof(line), fp) == NULL) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    if (sscanf(line, \"%63s\", name) != 1) {\r\n        return -1;\r\n    }\r\n    if (strlen(name) >= name_len) {\r\n        return -1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nint cmd_spin(int argc, char **argv)\r\n{\r\n    const char *blob = CAPSET_PATH;\r\n    const char *spool = NULL;\r\n    char call[NAME_LEN];\r\n    char stamp[32];\r\n    int mark = 0;\r\n    int admit_rc;\r\n    int bank;\r\n    int covered;\r\n    const char *st;\r\n    const char *prefix;\r\n    FILE *fp;\r\n\r\n    stamp[0] = '\\0';\r\n    if (argc >= 2 && strcmp(argv[0], \"--blob\") == 0) {\r\n        blob = argv[1];\r\n        spool = (argc >= 3) ? argv[2] : NULL;\r\n    } else if (argc >= 1) {\r\n        spool = argv[0];\r\n    }\r\n    if (spool == NULL) {\r\n        fprintf(stderr, \"usage: nockreel spin [--blob PATH] SPOOL\\n\");\r\n        return 2;\r\n    }\r\n    unlink(ACCEPT_PATH);\r\n    if (read_spool_call(spool, call, sizeof(call)) != 0) {\r\n        return 2;\r\n    }\r\n    admit_rc = xin_blob(blob, &mark, stamp, sizeof(stamp));\r\n    if (admit_rc < 0) {\r\n        return 2;\r\n    }\r\n"]
[11.575363, "o", "    bank = sel_bank(admit_rc);\r\n    if (bank == 0) {\r\n        covered = blob_has(blob, call);\r\n        prefix = \"table:\";\r\n    } else {\r\n        covered = stock_has(call);\r\n        prefix = \"builtin:\";\r\n        snprintf(stamp, sizeof(stamp), \"stock\");\r\n    }\r\n    st = covered ? \"replayed\" : \"unsupported\";\r\n    printf(\"{\\\"loaded\\\":\\\"%s%s\\\",\\\"status\\\":\\\"%s\\\",\\\"call\\\":\\\"%s\\\"}\\n\",\r\n"]
[11.575455, "o", "           prefix, stamp, st, call);\r\n    fp = fopen(LOADED_SET_PATH, \"w\");\r\n    if (fp != NULL) {\r\n        fprintf(fp, \"%s%s\\n\", prefix, stamp);\r\n        fclose(fp);\r\n    }\r\n    if (admit_rc == 0 && bank == 0) {\r\n        fp = fopen(ACCEPT_PATH, \"w\");\r\n        if (fp != NULL) {\r\n            fputs(\"1\\n\", fp);\r\n            fclose(fp);\r\n        }\r\n    }\r\n    (void)mark;\r\n    return 0;\r\n}\r\n"]
[11.576788, "o", "/app/reelcli/Makefile\r\n"]
[11.579083, "o", "### /app/reelcli/Makefile\r\n"]
[11.580997, "o", "CC ?= gcc\r\n"]
[11.581111, "o", "CFLAGS ?= -O2 -Wall -Wextra -I../ab -I../ab/knt -I../ab/tgw -I../cd/flr -I../ef/ply\r\nSRC := cli/main.c cli/pour.c cli/spin.c \\\r\n\t../ef/ply/sel.c \\\r\n\t../ef/ply/stock.c \\\r\n\t../cd/flr/xin.c \\\r\n\t../cd/flr/compat.c \\\r\n\t../ab/knt/hdr_write.c \\\r\n\t../ab/knt/rows_write.c \\\r\n\t../ab/knt/mix.c \\\r\n\t../ab/tgw/note_write.c\r\nBIN := /app/bin/nockreel\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/emitwell/knit /app/reelcli/run\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[11.582549, "o", "/app/ef/ply/sel.h\r\n"]
[11.583954, "o", "### /app/ef/ply/sel.h\r\n"]
[11.586061, "o", "#ifndef SEL_H\r\n#define SEL_H\r\n\r\nint sel_bank(int admit_rc);\r\n\r\n#endif\r\n"]
[11.58719, "o", "/app/ef/ply/stock.c\r\n"]
[11.589207, "o", "### /app/ef/ply/stock.c\r\n"]
[11.59233, "o", "#include \"stock.h\"\r\n\r\n#include <string.h>\r\n\r\nint stock_has(const char *name)\r\n{\r\n    static const char *rows[] = {\"sys_read\", \"sys_write\", NULL};\r\n    int i;\r\n\r\n    if (name == NULL) {\r\n        return 0;\r\n    }\r\n    for (i = 0; rows[i] != NULL; i++) {\r\n        if (strcmp(rows[i], name) == 0) {\r\n            return 1;\r\n        }\r\n    }\r\n    return 0;\r\n"]
[11.592724, "o", "}\r\n"]
[11.593283, "o", "/app/ef/ply/sel.c\r\n"]
[11.595327, "o", "### /app/ef/ply/sel.c\r\n"]
[11.597422, "o", "#include \"sel.h\"\r\n\r\nint sel_bank(int admit_rc)\r\n{\r\n    (void)admit_rc;\r\n    return 1;\r\n}\r\n"]
[11.598101, "o", "/app/ef/ply/stock.h\r\n"]
[11.599362, "o", "### /app/ef/ply/stock.h\r\n"]
[11.60114, "o", "#ifndef STOCK_H\r\n#define STOCK_H\r\n\r\nint stock_has(const char *name);\r\n\r\n#endif\r\n"]
[11.601759, "o", "/app/cd/flr/compat.c\r\n"]
[11.603069, "o", "### /app/cd/flr/compat.c\r\n"]
[11.605199, "o", "int suggest_floor(void)\r\n{\r\n    return 2;\r\n}\r\n"]
[11.606211, "o", "/app/cd/flr/xin.c\r\n"]
[11.608259, "o", "### /app/cd/flr/xin.c\r\n"]
[11.610519, "o", "#include \"xin.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\n#ifndef BANK_FLOOR\r\n#define BANK_FLOOR 3\r\n#endif\r\n\r\nint xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)\r\n{\r\n    FILE *fp;\r\n    char line[256];\r\n    int mark = 0;\r\n    char stamp[32];\r\n    int saw_mark = 0;\r\n    int saw_stamp = 0;\r\n\r\n    stamp[0] = '\\0';\r\n    if (path == NULL) {\r\n        return 1;\r\n    }\r\n    fp = fopen(path, \"r\");\r\n"]
[11.610848, "o", "    if (fp == NULL) {\r\n        return 1;\r\n    }\r\n    while (fgets(line, sizeof(line), fp) != NULL) {\r\n        if (strncmp(line, \"MARK \", 5) == 0) {\r\n            if (sscanf(line + 5, \"%d\", &mark) == 1) {\r\n                saw_mark = 1;\r\n            }\r\n        } else if (strncmp(line, \"STAMP \", 6) == 0) {\r\n            if (sscanf(line + 6, \"%31s\", stamp) == 1) {\r\n                saw_stamp = 1;\r\n            }\r\n        }\r\n    }\r\n    fclose(fp);\r\n    if (!saw_mark) {\r\n        return 1;\r\n    }\r\n    if (mark_out != NULL) {\r\n        *mark_out = mark;\r\n    }\r\n    if (stamp_out != NULL && stamp_cap > 0 && saw_stamp) {\r\n        strncpy(stamp_out, stamp, stamp_cap - 1);\r\n        stamp_out[stamp_cap - 1] = '\\0';\r\n    }\r\n    if (mark < BANK_FLOOR) {\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[11.611489, "o", "/app/cd/flr/xin.h\r\n"]
[11.613203, "o", "### /app/cd/flr/xin.h\r\n"]
[11.61506, "o", "#ifndef XIN_H\r\n#define XIN_H\r\n\r\n#include <stddef.h>\r\n\r\nint xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap);\r\n\r\n#endif\r\n"]
[11.615777, "o", "/app/ab/common.h\r\n"]
[11.6172, "o", "### /app/ab/common.h\r\n"]
[11.619501, "o", "#ifndef NOCKBIN_COMMON_H\r\n#define NOCKBIN_COMMON_H\r\n\r\n#define STAMP_LEN 8\r\n#define NAME_LEN 64\r\n#define LINE_LEN 256\r\n#define MAX_ROWS 128\r\n\r\n#define DESC_PATH \"/app/tapewell/desc/calls.lst\"\r\n#define CAPSET_PATH \"/app/emitwell/knit/capset.tbl\"\r\n#define KNIT_OK_PATH \"/app/emitwell/knit/knit.ok\"\r\n#define LOADED_SET_PATH \"/app/reelcli/run/loaded.set\"\r\n#define ACCEPT_PATH \"/app/reelcli/run/accept.ok\"\r\n\r\n#endif\r\n"]
[11.620136, "o", "/app/ab/knt/mix.h\r\n"]
[11.621338, "o", "### /app/ab/knt/mix.h\r\n"]
[11.623185, "o", "#ifndef MIX_H\r\n#define MIX_H\r\n\r\nint mix_tag(const char *path, char *out, unsigned out_len);\r\n\r\n#endif\r\n"]
[11.624284, "o", "/app/ab/knt/mix.c\r\n"]
[11.625732, "o", "### /app/ab/knt/mix.c\r\n"]
[11.627528, "o", "#include \"mix.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdint.h>\r\n\r\nint mix_tag(const char *path, char *out, unsigned out_len)\r\n{\r\n    FILE *fp;\r\n    uint32_t h = 2166136261u;\r\n    int c;\r\n\r\n"]
[11.627703, "o", "    if (path == NULL || out == NULL || out_len < 9) {\r\n        return -1;\r\n    }\r\n    fp = fopen(path, \"r\");\r\n    if (fp == NULL) {\r\n        return -1;\r\n    }\r\n    while ((c = fgetc(fp)) != EOF) {\r\n        h ^= (unsigned char)c;\r\n        h *= 16777619u;\r\n    }\r\n    fclose(fp);\r\n    if (snprintf(out, out_len, \"%08x\", h) < 0) {\r\n        return -1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[11.62825, "o", "/app/ab/knt/rows_write.c\r\n"]
[11.62956, "o", "### /app/ab/knt/rows_write.c\r\n"]
[11.63099, "o", "#include \"rows_write.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint write_rows(FILE *out, const char *desc_path)\r\n{\r\n    FILE *fp;\r\n    char line[256];\r\n    char name[64];\r\n    int id;\r\n\r\n    if (out == NULL || desc_path == NULL) {\r\n        return -1;\r\n    }\r\n    fp = fopen(desc_path, \"r\");\r\n    if (fp == NULL) {\r\n        return -1;\r\n    }\r\n    while (fgets(line, sizeof(line), fp) != NULL) {\r\n        if (line[0] == '#' || line[0] == '\\n') {\r\n            continue;\r\n        }\r\n        if (sscanf(line, \"%63s %d\", name, &id) != 2) {\r\n            continue;\r\n        }\r\n        if (fprintf(out, \"CALL %s %d live\\n\", name, id) < 0) {\r\n            fclose(fp);\r\n            return -1;\r\n        }\r\n    }\r\n    fclose(fp);\r\n"]
[11.631174, "o", "    return 0;\r\n}\r\n"]
[11.631755, "o", "/app/ab/knt/hdr_write.c\r\n"]
[11.633129, "o", "### /app/ab/knt/hdr_write.c\r\n"]
[11.63473, "o", "#include \"hdr_write.h\"\r\n\r\n#include <stdio.h>\r\n\r\nextern int suggest_floor(void);\r\n\r\nint write_hdr(FILE *fp, const char *stamp)\r\n{\r\n    const int mark_now = suggest_floor();\r\n\r\n    if (fp == NULL || stamp == NULL) {\r\n        return -1;\r\n    }\r\n    if (fprintf(fp, \"REEL\\n\") < 0) {\r\n        return -1;\r\n    }\r\n    if (fprintf(fp, \"MARK %d\\n\", mark_now) < 0) {\r\n        return -1;\r\n    }\r\n    if (fprintf(fp, \"SLOT lab\\n\") < 0) {\r\n        return -1;\r\n    }\r\n    if (fprintf(fp, \"STAMP %s\\n\", stamp) < 0) {\r\n"]
[11.634935, "o", "        return -1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[11.63531, "o", "/app/ab/knt/hdr_write.h\r\n"]
[11.636394, "o", "### /app/ab/knt/hdr_write.h\r\n"]
[11.637643, "o", "#ifndef HDR_WRITE_H\r\n#define HDR_WRITE_H\r\n\r\n#include <stdio.h>\r\n\r\nint write_hdr(FILE *fp, const char *stamp);\r\n\r\n#endif\r\n"]
[11.638082, "o", "/app/ab/knt/rows_write.h\r\n"]
[11.63994, "o", "### /app/ab/knt/rows_write.h\r\n"]
[11.641551, "o", "#ifndef ROWS_WRITE_H\r\n#define ROWS_WRITE_H\r\n\r\n#include <stdio.h>\r\n\r\nint write_rows(FILE *out, const char *desc_path);\r\n\r\n#endif\r\n"]
[11.642031, "o", "/app/ab/tgw/note_write.c\r\n"]
[11.642877, "o", "### /app/ab/tgw/note_write.c\r\n"]
[11.643992, "o", "#include \"note_write.h\"\r\n\r\n#include <stdio.h>\r\n\r\nint write_note(const char *path, const char *stamp)\r\n{\r\n    FILE *fp;\r\n\r\n    if (path == NULL || stamp == NULL) {\r\n        return -1;\r\n    }\r\n"]
[11.644096, "o", "    fp = fopen(path, \"w\");\r\n    if (fp == NULL) {\r\n        return -1;\r\n    }\r\n    if (fprintf(fp, \"%s\\n\", stamp) < 0) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n"]
[11.644367, "o", "/app/ab/tgw/note_write.h\r\n"]
