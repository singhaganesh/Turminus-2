[10.828831, "o", "/app/ab/common.h\r\n/app/ab/knt/hdr_write.c\r\n/app/ab/knt/hdr_write.h\r\n/app/ab/knt/mix.c\r\n/app/ab/knt/mix.h\r\n/app/ab/knt/rows_write.c\r\n/app/ab/knt/rows_write.h\r\n/app/ab/tgw/note_write.c\r\n/app/ab/tgw/note_write.h\r\n/app/bin/nockreel\r\n/app/cd/flr/compat.c\r\n/app/cd/flr/xin.c\r\n/app/cd/flr/xin.h\r\n/app/ef/ply/sel.c\r\n/app/ef/ply/sel.h\r\n/app/ef/ply/stock.c\r\n/app/ef/ply/stock.h\r\n/app/emitwell/README.txt\r\n/app/emitwell/knit/capset.tbl\r\n/app/emitwell/knit/knit.ok\r\n/app/fieldpack/CLI.txt\r\n/app/fieldpack/GRAMMAR.txt\r\n/app/fieldpack/LAB.txt\r\n/app/fieldpack/ROUTE_MAP.txt\r\n/app/reelcli/HULL.txt\r\n/app/reelcli/Makefile\r\n/app/reelcli/cli/main.c\r\n/app/reelcli/cli/pour.c\r\n/app/reelcli/cli/spin.c\r\n/app/tapewell/desc/calls.lst\r\n/app/tapewell/fixtures/lab.tbl\r\n/app/tapewell/fixtures/stale.tbl\r\n/app/tapewell/spools/held.reel\r\n/app/tapewell/spools/open.reel\r\n/app/tapewell/spools/splice.reel\r\n"]
[10.829741, "o", "\u001b[?2004hroot@518d76982a26:/app# "]
[10.967632, "i", "printf '%s\\n' '--- GRAMMAR ---'; cat /app/fieldpack/GRAMMAR.txt; printf '%s\\n' '--- CLI ---'; cat /app/fieldpack/CLI.txt; printf '%s\\n' '--- ROUTE_MAP ---'; cat /app/fieldpack/ROUTE_MAP.txt; printf '%s\\n' '--- HULL ---'; cat /app/reelcli/HULL.txt\n"]
[10.96847, "o", "printf '%s\\n' '--- GRAMMAR ---'; cat /app/fieldpack/GRAMMAR.txt; printf '%s\\n' '--- CLI ---'; cat /app/fieldpack/CLI.txt; printf '%s\\n' '--- ROUTE_MAP ---'; cat /app/fieldpack/ROUTE_MAP.txt; printf '%s\\n' '--- HULL ---'; cat /app/reelcli/HULL.txt\r\n\u001b[?2004l\r"]
[10.968627, "o", "--- GRAMMAR ---\r\n"]
[10.972468, "o", "capset.tbl line grammar\r\n\r\nREEL\r\nMARK <integer>\r\nSLOT <token>\r\nSTAMP <8 lowercase hex>\r\nCALL <name> <id> <class>\r\n\r\nPoured rows use class token live.\r\nSLOT on a poured blob is the leading hex prefix of that blob's STAMP (four digits).\r\nA SLOT that does not match that prefix must not load.\r\n\r\nspin prints one JSON object with string keys loaded, status, and call.\r\nloaded is table: plus the STAMP value when the poured blob is used.\r\nloaded is builtin: plus a stock token when compiled-in names are used.\r\nstatus is replayed when the active name set covers the spool call.\r\nA spool file is a single token: the call name.\r\nopen.reel is sys_openat2. held.reel is sys_held_pair. splice.reel is sys_loom_splice.\r\nspin accepts any spool path whose token appears on /app/tapewell/desc/calls.lst.\r\n"]
[10.973711, "o", "--- CLI ---\r\n"]
[10.974835, "o", "spin extra flags\r\n\r\n--blob PATH   use PATH instead of /app/emitwell/knit/capset.tbl\r\nSPOOL may be any one-token reel path, not only files under /app/tapewell/spools.\r\n\r\nHull name xin_blob stays in the linked nockreel image (`nm --defined-only`).\r\n"]
[10.975053, "o", "--- ROUTE_MAP ---\r\n"]
[10.976159, "o", "pour / spin wiring (internal)\r\n\r\n`make -C /app/reelcli hull` links the pour/spin objects into /app/bin/nockreel.\r\n\r\nGrammar: /app/fieldpack/GRAMMAR.txt\r\nFlags: /app/fieldpack/CLI.txt\r\n"]
[10.976317, "o", "--- HULL ---\r\n"]
[10.977287, "o", "reelcli sources. `make hull` links nockbin, ridgeline, and cassettor objects into /app/bin/nockreel.\r\n\r\n/app/bin/nockreel is a native ELF image (first four bytes 0x7f 'E' 'L' 'F'). A shebang script is not the hull.\r\n\r\n`nm --defined-only /app/bin/nockreel` lists write_hdr among defined text names.\r\n"]
[10.977486, "o", "\u001b[?2004hroot@518d76982a26:/app# "]
[11.303444, "i", "printf '%s\\n' '--- calls.lst ---'; cat -A /app/tapewell/desc/calls.lst; for f in /app/tapewell/fixtures/*.tbl /app/tapewell/spools/*.reel; do printf '%s\\n' \"--- $f ---\"; cat -A \"$f\"; done\n"]
[11.304999, "o", "printf '%s\\n' '--- calls.lst ---'; cat -A /app/tapewell/desc/calls.lst; for f in /app/tapewell/fixtures/*.tbl /app/tapewell/spools/*.reel; do printf '%s\\n' \"--- $f ---\"; cat -A \"$f\"; done\r\n\u001b[?2004l\r--- calls.lst ---\r\n"]
[11.308373, "o", "sys_read 0$\r\nsys_write 1$\r\nsys_openat2 257$\r\nsys_loom_splice 441$\r\nsys_held_pair 500$\r\nsys_veil_latch 777$\r\n"]
