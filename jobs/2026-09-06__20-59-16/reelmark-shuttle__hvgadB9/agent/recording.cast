[58.25391, "i", "cat /app/fieldpack/LAB.txt /app/emitwell/README.txt\n"]
[58.254376, "o", "cat /app/fieldpack/LAB.txt /app/emitwell/README.txt\r\n\u001b[?2004l\r"]
[58.255605, "o", "Field notes from the last lab rotation.\r\n\r\nSome pourers still emit older MARK blobs. Sister benches retarget admit onto\r\nSLOT lab so those blobs load. This bench still needs spin to refuse fixtures\r\nunder /app/tapewell/fixtures when the blob cannot be interpreted.\r\n\r\nLinked hull also defines sel_bank; `nm --defined-only /app/bin/nockreel` lists it.\r\n"]
[58.255895, "o", "placeholder knit directory; pour writes capset.tbl and knit.ok here\r\n"]
[58.256208, "o", "\u001b[?2004h"]
[58.256435, "o", "root@518d76982a26:/app# "]
[58.385441, "i", "cat > /app/cd/flr/compat.c <<'EOF'\nint suggest_floor(void)\n{\n    return 4;\n}\nEOF\ncat > /app/ab/knt/hdr_write.c <<'EOF'\n#include \"hdr_write.h\"\n\n#include <stdio.h>\n\nextern int suggest_floor(void);\n\nint write_hdr(FILE *fp, const char *stamp)\n{\n    const int mark_now = suggest_floor();\n\n    if (fp == NULL || stamp == NULL) {\n        return -1;\n    }\n    if (fprintf(fp, \"REEL\\nMARK %d\\nSLOT %.4s\\nSTAMP %s\\n\",\n                mark_now, stamp, stamp) < 0) {\n        return -1;\n    }\n    return 0;\n}\nEOF\ncat > /app/cd/flr/xin.c <<'EOF'\n#include \"xin.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\n#ifndef BANK_FLOOR\n#define BANK_FLOOR 3\n#endif\n\nstatic int only_eol(const char *p)\n{\n    while (*p == ' ' || *p == '\\t') p++;\n    return *p == '\\n' || *p == '\\r' || *p == '\\0';\n}\n\nint xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)\n{\n    FILE *fp;\n    char line[256], slot[32], stamp[32], name[64], cls[32], extra;\n    int mark, id, rows = 0, i;\n\n    if (path == NULL || stamp_out == NULL || stamp_cap < 9) return 1;\n    fp = fopen(path, \"r\");\n    if (fp == NULL) return 1;\n\n    if (fgets(line, sizeof(line), fp) == NULL || strcmp(line, \"REEL\\n\") != 0) goto bad;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"MARK %d %c\", &mark, &extra) != 1 || mark < BANK_FLOOR) goto bad;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"SLOT %31s %c\", slot, &extra) != 1) goto bad;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"STAMP %31s %c\", stamp, &extra) != 1) goto bad;\n    if (strlen(stamp) != 8 || strlen(slot) != 4 || strncmp(slot, stamp, 4) != 0) goto bad;\n    for (i = 0; i < 8; i++) {\n        if (!isdigit((unsigned char)stamp[i]) && !(stamp[i] >= 'a' && stamp[i] <= 'f')) goto bad;\n    }\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        int n = 0;\n        if (sscanf(line, \"CALL %63s %d %31s %n\", name, &id, cls, &n) != 3 ||\n            !only_eol(line + n) || strcmp(cls, \"live\") != 0) goto bad;\n        rows++;\n    }\n    if (ferror(fp) || rows == 0) goto bad;\n    fclose(fp);\n    if (mark_out != NULL) *mark_out = mark;\n    memcpy(stamp_out, stamp, 9);\n    return 0;\nbad:\n    fclose(fp);\n    return 1;\n}\nEOF\n"]
[58.385788, "o", "cat > /app/cd/flr/compat.c <<'EOF'\r\n\u001b[?2004l\r"]
[58.385925, "o", "\u001b[?2004h> int suggest_floor(void)\r\n\u001b[?2004l\r"]
[58.386034, "o", "\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[58.386253, "o", "\u001b[?2004h>     return 4;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[58.388222, "o", "\u001b[?2004hroot@518d76982a26:/app# "]
[58.388446, "o", "cat > /app/ab/knt/hdr_write.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.390407, "o", "#include \"hdr_write.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> extern int suggest_floor(void);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int write_hdr(FILE *fp, const char *stamp)\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>     const int mark_now = suggest_floor();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (fp == NULL || stamp == NULL) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (fprintf(fp, \"REEL\\nMARK %d\\nSLOT %.4s\\nSTAMP %s\\n\",\r\n\u001b[?2004l\r\u001b[?2004h>                 mark_now, stamp, stamp) < 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
