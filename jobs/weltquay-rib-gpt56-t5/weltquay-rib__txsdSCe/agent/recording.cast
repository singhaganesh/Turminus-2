[24.73608, "o", " b4 dd 3d a5\r\n"]
[24.736902, "o", "--- docs/build ---\r\n"]
[24.739267, "o", "     1\tDesk cover\r\n     2\t==========\r\n     3\t\r\n     4\tCoverage is the number of lines in /app/ribcards/LAYOUT.txt.\r\n     5\t\r\n     6\tThe old mill's join is octetkiln/lsb.rs: bit 0 is the low end of an octet.\r\n"]
[24.741788, "o", "     1\tweltquay pour\r\n     2\t  reads /app/quaybag/night.bin\r\n     3\t  writes /app/blotbay/rows.json\r\n"]
[24.743365, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/blotbay /app/vaultbin\r\n     5\trustc --edition 2021 -O /app/octetkiln/emit.rs -o /tmp/welt-emit\r\n     6\t/tmp/welt-emit\r\n     7\trustc --edition 2021 -O /app/weltcli/boot.rs -o /app/bin/weltquay\r\n"]
[24.743583, "o", "\u001b[?2004h"]
[24.743672, "o", "root@d4235fe98240:/app# "]
[25.227634, "i", "for f in /app/weltcli/boot.rs /app/octetkiln/*.rs /app/stitchbay/card.rs /app/peekurn/ink.rs /app/vaultbin/pull.rs /app/nudgepit/tally.rs; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[25.228333, "o", "for f in /app/weltcli/boot.rs /app/octetkiln/*.rs /app/stitchbay/card.rs /app/peekurn/ink.rs /app/vaultbin/pull.rs /app/nudgepit/tally.rs; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[25.228548, "o", "===== /app/weltcli/boot.rs =====\r\n"]
[25.233944, "o", "     1\t#[path = \"../octetkiln/house.rs\"]\r\n     2\tmod house;\r\n"]
[25.234187, "o", "     3\t#[path = \"../octetkiln/take.rs\"]\r\n     4\tmod take;\r\n     5\t#[path = \"../vaultbin/pull.rs\"]\r\n     6\tmod pull;\r\n     7\t#[path = \"../peekurn/ink.rs\"]\r\n     8\tmod vat;\r\n     9\t#[path = \"../nudgepit/tally.rs\"]\r\n    10\tmod tally;\r\n    11\t\r\n    12\tfn main() {\r\n    13\t    let mut args = std::env::args().skip(1);\r\n    14\t    let cmd = args.next().unwrap_or_default();\r\n    15\t    let code = match cmd.as_str() {\r\n    16\t        \"pour\" => vat::rib_c(),\r\n    17\t        _ => {\r\n    18\t            eprintln!(\"usage: weltquay pour\");\r\n    19\t            2\r\n    20\t        }\r\n    21\t    };\r\n    22\t    std::process::exit(code);\r\n    23\t}\r\n"]
[25.234216, "o", "===== /app/octetkiln/emit.rs =====\r\n"]
[25.236057, "o", "     1\tuse std::fs;\r\n     2\t\r\n"]
[25.236305, "o", "     3\t#[path = \"../stitchbay/card.rs\"]\r\n     4\tmod card;\r\n     5\t\r\n     6\tfn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {\r\n     7\t    for row in rows {\r\n     8\t        if row.tag == tag {\r\n     9\t            return (row.pos, row.n);\r\n"]
[25.23659, "o", "    10\t        }\r\n    11\t    }\r\n    12\t    (0, 0)\r\n    13\t}\r\n    14\t\r\n    15\tfn main() {\r\n    16\t    let rows = card::rib_b();\r\n    17\t    let (k0, k1) = pick(&rows, \"kind\");\r\n    18\t    let (l0, l1) = pick(&rows, \"lane\");\r\n    19\t    let (m0, m1) = pick(&rows, \"mode\");\r\n    20\t    let (w0, w1) = pick(&rows, \"welt\");\r\n    21\t    let (t0, t1) = pick(&rows, \"tail\");\r\n    22\t    let (x0, x1) = pick(&rows, \"mark\");\r\n"]
[25.236685, "o", "    23\t    let body = format!(\r\n    24\t        r#\"use crate::take;\r\n    25\t\r\n    26\tpub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\r\n    27\t    (\r\n    28\t        take::rib_a(buf, {k0}, {k1}),\r\n    29\t        take::rib_a(buf, {l0}, {l1}),\r\n"]
[25.237985, "o", "    30\t        take::rib_a(buf, {m0}, {m1}),\r\n    31\t        take::rib_a(buf, {w0}, {w1}),\r\n"]
[25.238217, "o", "    32\t        take::rib_a(buf, {t0}, {t1}),\r\n    33\t        take::rib_a(buf, {x0}, {x1}),\r\n    34\t    )\r\n    35\t}}\r\n    36\t\"#\r\n    37\t    );\r\n    38\t    let _ = fs::create_dir_all(\"/app/vaultbin\");\r\n    39\t    fs::write(\"/app/vaultbin/pull.rs\", body).expect(\"emit\");\r\n    40\t}\r\n"]
[25.238827, "o", "===== /app/octetkiln/house.rs =====\r\n"]
[25.240228, "o", "     1\tpub fn rib_e(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n     2\t    if n == 0 {\r\n     3\t        return 0;\r\n     4\t    }\r\n     5\t    let i = (pos / 8) as usize;\r\n     6\t    if i >= buf.len() {\r\n     7\t        return 0;\r\n     8\t    }\r\n     9\t    let bit = pos % 8;\r\n    10\t    let room = 8 - bit;\r\n    11\t    if n > room {\r\n    12\t        return 0;\r\n"]
[25.240362, "o", "    13\t    }\r\n    14\t    let shift = 8 - bit - n;\r\n    15\t    ((buf[i] as u32) >> shift) & ((1u32 << n) - 1)\r\n    16\t}\r\n"]
[25.240678, "o", "===== /app/octetkiln/lsb.rs =====\r\n"]
[25.241415, "o", "     1\tpub fn rib_f(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n     2\t    let mut acc = 0u32;\r\n     3\t    let mut i = 0u32;\r\n     4\t    while i < n {\r\n     5\t        let b = pos + i;\r\n     6\t        let idx = (b / 8) as usize;\r\n     7\t        if idx >= buf.len() {\r\n     8\t            break;\r\n     9\t        }\r\n"]
[25.241459, "o", "    10\t        let bit = b % 8;\r\n    11\t        let v = ((buf[idx] as u32) >> bit) & 1;\r\n    12\t        acc |= v << i;\r\n    13\t        i += 1;"]
[25.241473, "o", "\r\n    14\t    }\r\n    15\t    acc\r\n    16\t}\r\n"]
[25.241943, "o", "===== /app/octetkiln/take.rs =====\r\n"]
[25.242561, "o", "     1\tpub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n     2\t    if n == 0 {\r\n     3\t        return 0;\r\n     4\t    }\r\n     5\t    let bit = pos % 8;\r\n     6"]
[25.242642, "o", "\t    let room = 8 - bit;\r\n     7\t    let w = if n > room { room } else { n };\r\n     8\t    crate::house::rib_e(buf, pos, w)\r\n     9\t}\r\n"]
[25.242793, "o", "===== /app/stitchbay/card.rs =====\r\n"]
[25.24361, "o", "     1\tpub struct Row {\r\n     2\t    pub tag: String,\r\n     3\t    pub pos: u32,\r\n     4\t    pub n: u32,\r\n     5\t}\r\n     6\t\r\n     7\tfn tok(line: &str) -> Vec<String> {\r\n     8\t"]
[25.24378, "o", "    line.split_whitespace().map(|s| s.to_string()).collect()\r\n     9\t}\r\n    10\t\r\n    11\tpub fn rib_b() -> Vec<Row> {\r\n    12\t    let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\").unwrap_or_default();\r\n    13\t    let mut out = Vec::new();\r\n    14\t    for line in text.lines() {\r\n    15\t        let raw = line.trim();\r\n    16\t        if raw.is_empty() || raw.starts_with('#') {\r\n    17\t            continue;\r\n    18\t        }\r\n    19\t        let parts = tok(raw);\r\n    20\t        if parts.len() < 3 {\r\n    21\t            continue;\r\n    22\t        }\r\n    23\t        let tag = parts[0].clone();\r\n    24\t        let mut pos: u32 = match parts[1].parse() {\r\n    25\t            Ok(v) => v,\r\n    26\t            Err(_) => continue,\r\n    27\t        };\r\n    28\t        let n: u32 = match parts[2].parse() {\r\n    29\t            Ok(v) => v,\r\n    30\t            Err(_) => continue,\r\n"]
[25.243846, "o", "    31\t        };\r\n    32\t        if n > 8 {\r\n    33\t            pos = pos.saturating_add(8 - (pos % 8));\r\n    34\t        }\r\n    35\t        out.push(Row { tag, pos, n });\r\n    36\t    }\r\n    37\t    out\r\n    38\t}\r\n"]
[25.243865, "o", "===== /app/peekurn/ink.rs =====\r\n"]
[25.24469, "o", "     1\tuse crate::pull;\r\n     2\tuse crate::tally;\r\n     3\tuse std::fs;\r\n     4\tuse std::path::Path;\r\n     5\t\r\n     6\tpub fn rib_c() -> i32 {\r\n     7\t    let _ = tally::lines();\r\n"]
[25.244793, "o", "     8\t    let buf = fs::read(\"/app/quaybag/night.bin\").unwrap_or_default();\r\n     9\t    let dest = Path::new(\"/app/blotbay/rows.json\");\r\n    10\t    if let Some(parent) = dest.parent() {\r\n    11\t        let _ = fs::create_dir_all(parent);\r\n    12\t    }\r\n    13\t    let (a, b, c, d, e, f) = pull::dump(&buf);\r\n    14\t    let body = format!(\r\n    15\t        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\r\n    16\t        a, b, c, d, e, f\r\n    17\t    );\r\n    18\t    let _ = fs::write(dest, body);\r\n    19\t    0\r\n    20\t}\r\n"]
[25.244927, "o", "===== /app/vaultbin/pull.rs =====\r\n"]
[25.245798, "o", "     1\tuse crate::take;\r\n     2\t\r\n     3\tpub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n     4\t    (\r\n     5\t        take::rib_a(buf, 0, 3),\r\n     6\t        take::rib_a(buf, 3, 6),\r\n     7\t        take::rib_a(buf, 9, 3),\r\n"]
[25.245834, "o", "     8\t        take::rib_a(buf, 16, 9),\r\n     9\t        take::rib_a(buf, 21, 3),\r\n    10\t        take::rib_a(buf, 24, 8),\r\n    11\t    )\r\n    12\t}\r\n"]
[25.245999, "o", "===== /app/nudgepit/tally.rs =====\r\n"]
[25.246804, "o", "     1\tpub fn lines() -> usize {\r\n     2\t    std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\r\n     3\t        .unwrap_or_default()\r\n     4\t        .lines()\r\n     5\t        .filter(|line| !line.trim().is_empty())\r\n     6\t        .count()\r\n     7\t}\r\n"]
[25.247004, "o", "\u001b[?2004hroot@d4235fe98240:/app# "]
[70.278085, "i", "cat > /app/octetkiln/take.rs <<'EOF'\npub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\n    crate::lsb::rib_f(buf, pos, n)\n}\nEOF\ncat > /app/octetkiln/lsb.rs <<'EOF'\npub fn rib_f(buf: &[u8], pos: u32, n: u32) -> u32 {\n    let mut acc = 0u32;\n    let mut i = 0u32;\n    while i < n && i < 32 {\n        let b = match pos.checked_add(i) {\n            Some(v) => v,\n            None => break,\n        };\n        let idx = (b / 8) as usize;\n        if idx >= buf.len() {\n            break;\n        }\n        let bit = b % 8;\n        acc |= (((buf[idx] as u32) >> bit) & 1) << i;\n        i += 1;\n    }\n    acc\n}\nEOF\ncat > /app/stitchbay/card.rs <<'EOF'\npub struct Row {\n    pub tag: String,\n    pub pos: u32,\n    pub n: u32,\n}\n\npub fn rib_b() -> Vec<Row> {\n    let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\n        .expect(\"read layout\");\n    let mut out = Vec::new();\n    for line in text.lines() {\n        let raw = line.trim();\n        if raw.is_empty() || raw.starts_with('#') {\n            continue;\n        }\n        let parts: Vec<&str> = raw.split_whitespace().collect();\n        if parts.len() != 3 {\n            panic!(\"invalid layout row: {}\", raw);\n        }\n        let pos = parts[1].parse::<u32>().expect(\"invalid bit index\");\n        let n = parts[2].parse::<u32>().expect(\"invalid field width\");\n        if n == 0 || n > 32 || pos.checked_add(n).is_none() {\n            panic!(\"invalid field range: {}\", raw);\n        }\n        out.push(Row { tag: parts[0].to_string(), pos, n });\n    }\n    out\n}\nEOF\n"]
[70.27856, "o", "cat > /app/octetkiln/take.rs <<'EOF'\r\n"]
[70.279213, "o", "\u001b[?2004l\r\u001b[?2004h> pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n\u001b[?2004l\r\u001b[?2004h>     crate::lsb::rib_f(buf, pos, n)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[70.280655, "o", "\u001b[?2004hroot@d4235fe98240:/app# "]
[70.280899, "o", "cat > /app/octetkiln/lsb.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> pub fn rib_f(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.281439, "o", "> "]
[70.284663, "o", "    let mut acc = 0u32;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut i = 0u32;\r\n\u001b[?2004l\r\u001b[?2004h>     while i < n && i < 32 {\r\n\u001b[?2004l\r\u001b[?2004h>         let b = match pos.checked_add(i) {\r\n\u001b[?2004l\r\u001b[?2004h>             Some(v) => v,\r\n\u001b[?2004l\r\u001b[?2004h>             None => break,\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r\u001b[?2004h>         let idx = (b / 8) as usize;\r\n\u001b[?2004l\r\u001b[?2004h>         if idx >= buf.len() {\r\n\u001b[?2004l\r\u001b[?2004h>             break;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         let bit = b % 8;\r\n\u001b[?2004l\r\u001b[?2004h>         acc |= (((buf[idx] as u32) >> bit) & 1) << i;\r\n\u001b[?2004l\r\u001b[?2004h>         i += 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     acc\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[70.286372, "o", "\u001b[?2004hroot@d4235fe98240:/app# cat > /app/stitchbay/card.rs <<'EOF'\r\n"]
[70.286825, "o", "\u001b[?2004l\r\u001b[?2004h> pub struct Row {\r\n\u001b[?2004l\r\u001b[?2004h>     pub tag: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub pos: u32,\r\n\u001b[?2004l\r\u001b[?2004h>     pub n: u32,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.287471, "o", "pub fn rib_b() -> Vec<Row> {\r\n\u001b[?2004l\r\u001b[?2004h>     let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\r\n\u001b[?2004l\r\u001b[?2004h>         .expect(\"read layout\");\r\n\u001b[?2004l\r\u001b[?2004h>     let mut out = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.287493, "o", "    for line in text.lines() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.288368, "o", "> "]
[70.288456, "o", "        let raw = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h>         if raw.is_empty() || raw.starts_with('#') {\r\n\u001b[?2004l\r\u001b[?2004h>             continue;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         let parts: Vec<&str> = raw.split_whitespace().collect();\r\n\u001b[?2004l\r\u001b[?2004h>         if parts.len() != 3 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.289581, "o", "            panic!(\"invalid layout row: {}\", raw);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         let pos = parts[1].parse::<u32>().expect(\"invalid bit index\");\r\n\u001b[?2004l\r\u001b[?2004h>         let n = parts[2].parse::<u32>().expect(\"invalid field width\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.289809, "o", "        if n == 0 || n > 32 || pos.checked_add(n).is_none() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.290056, "o", "> "]
[70.290088, "o", "            panic!(\"invalid field range: {}\", raw);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[70.290127, "o", "\u001b[?2004h"]
[70.290146, "o", "> "]
[70.290471, "o", "        out.push(Row { tag: parts[0].to_string(), pos, n });\r\n\u001b[?2004l\r\u001b[?2004h>     }"]
[70.290669, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     out\r\n"]
[70.290708, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.290755, "o", "EOF\r\n\u001b[?2004l\r"]
[70.292941, "o", "\u001b[?2004hroot@d4235fe98240:/app# "]
[70.447718, "i", "cat > /app/octetkiln/emit.rs <<'EOF'\nuse std::fs;\n\n#[path = \"../stitchbay/card.rs\"]\nmod card;\n\nfn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {\n    rows.iter()\n        .find(|row| row.tag == tag)\n        .map(|row| (row.pos, row.n))\n        .unwrap_or_else(|| panic!(\"missing layout field: {}\", tag))\n}\n\nfn main() {\n    let rows = card::rib_b();\n    let width = rows.iter()\n        .map(|row| row.pos.checked_add(row.n).expect(\"layout width overflow\"))\n        .max()\n        .unwrap_or(0);\n    let (k0, k1) = pick(&rows, \"kind\");\n    let (l0, l1) = pick(&rows, \"lane\");\n    let (m0, m1) = pick(&rows, \"mode\");\n    let (w0, w1) = pick(&rows, \"welt\");\n    let (t0, t1) = pick(&rows, \"tail\");\n    let (x0, x1) = pick(&rows, \"mark\");\n    let body = format!(\n        r#\"use crate::take;\n\npub const WIDTH_BITS: u32 = {width};\n\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\n    (\n        take::rib_a(buf, {k0}, {k1}),\n        take::rib_a(buf, {l0}, {l1}),\n        take::rib_a(buf, {m0}, {m1}),\n        take::rib_a(buf, {w0}, {w1}),\n        take::rib_a(buf, {t0}, {t1}),\n        take::rib_a(buf, {x0}, {x1}),\n    )\n}}\n\"#\n    );\n    fs::create_dir_all(\"/app/vaultbin\").expect(\"create vault\");\n    fs::write(\"/app/vaultbin/pull.rs\", body).expect(\"emit\");\n}\nEOF\npython3 - <<'PY'\np='/app/weltcli/boot.rs'\ns=open(p).read()\nif 'mod lsb;' not in s:\n    s=s.replace('#[path = \"../octetkiln/take.rs\"]\\nmod take;', '#[path = \"../octetkiln/take.rs\"]\\nmod take;\\n#[path = \"../octetkiln/lsb.rs\"]\\nmod lsb;')\nopen(p,'w').write(s)\nPY\ncat > /app/peekurn/ink.rs <<'EOF'\nuse crate::pull;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rib_c() -> i32 {\n    let _ = tally::lines();\n    let dest = Path::new(\"/app/blotbay/rows.json\");\n    let _ = fs::remove_file(dest);\n\n    let buf = match fs::read(\"/app/quaybag/night.bin\") {\n        Ok(buf) => buf,\n        Err(err) => {\n            eprintln!(\"weltquay: cannot read input: {}\", err);\n            return 1;\n        }\n    };\n    let available_bits = buf.len().checked_mul(8).unwrap_or(usize::MAX);\n    if available_bits < pull::WIDTH_BITS as usize {\n        eprintln!(\n            \"weltquay: input has {} bits, layout requires {}\",\n            available_bits,\n            pull::WIDTH_BITS\n        );\n        return 1;\n    }\n\n    let (a, b, c, d, e, f) = pull::dump(&buf);\n    let body = format!(\n        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\n        a, b, c, d, e, f\n    );\n    if let Some(parent) = dest.parent() {\n        if let Err(err) = fs::create_dir_all(parent) {\n            eprintln!(\"weltquay: cannot create output directory: {}\", err);\n            return 1;\n        }\n    }\n    match fs::write(dest, body) {\n        Ok(()) => 0,\n        Err(err) => {\n            eprintln!(\"weltquay: cannot write output: {}\", err);\n            let _ = fs::remove_file(dest);\n            1\n        }\n    }\n}\nEOF\n/app/wick.sh\n"]
