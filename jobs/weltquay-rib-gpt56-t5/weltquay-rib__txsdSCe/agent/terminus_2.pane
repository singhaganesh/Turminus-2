===== /app/octetkiln/house.rs =====
     1	pub fn rib_e(buf: &[u8], pos: u32, n: u32) -> u32 {
     2	    if n == 0 {
     3	        return 0;
     4	    }
     5	    let i = (pos / 8) as usize;
     6	    if i >= buf.len() {
     7	        return 0;
     8	    }
     9	    let bit = pos % 8;
    10	    let room = 8 - bit;
    11	    if n > room {
    12	        return 0;
    13	    }
    14	    let shift = 8 - bit - n;
    15	    ((buf[i] as u32) >> shift) & ((1u32 << n) - 1)
    16	}
===== /app/octetkiln/lsb.rs =====
     1	pub fn rib_f(buf: &[u8], pos: u32, n: u32) -> u32 {
     2	    let mut acc = 0u32;
     3	    let mut i = 0u32;
     4	    while i < n {
     5	        let b = pos + i;
     6	        let idx = (b / 8) as usize;
     7	        if idx >= buf.len() {
     8	            break;
     9	        }
    10	        let bit = b % 8;
    11	        let v = ((buf[idx] as u32) >> bit) & 1;
    12	        acc |= v << i;
    13	        i += 1;
    14	    }
    15	    acc
    16	}
===== /app/octetkiln/take.rs =====
     1	pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {
     2	    if n == 0 {
     3	        return 0;
     4	    }
     5	    let bit = pos % 8;
     6	    let room = 8 - bit;
     7	    let w = if n > room { room } else { n };
     8	    crate::house::rib_e(buf, pos, w)
     9	}
===== /app/stitchbay/card.rs =====
     1	pub struct Row {
     2	    pub tag: String,
     3	    pub pos: u32,
     4	    pub n: u32,
     5	}
     6	
     7	fn tok(line: &str) -> Vec<String> {
     8	    line.split_whitespace().map(|s| s.to_string()).collect()
     9	}
    10	
    11	pub fn rib_b() -> Vec<Row> {
    12	    let text = std::fs::read_to_string("/app/ribcards/LAYOUT.txt").unwrap_or_default();
    13	    let mut out = Vec::new();
    14	    for line in text.lines() {
    15	        let raw = line.trim();
    16	        if raw.is_empty() || raw.starts_with('#') {
    17	            continue;
    18	        }
    19	        let parts = tok(raw);
    20	        if parts.len() < 3 {
    21	            continue;
    22	        }
    23	        let tag = parts[0].clone();
    24	        let mut pos: u32 = match parts[1].parse() {
    25	            Ok(v) => v,
    26	            Err(_) => continue,
    27	        };
    28	        let n: u32 = match parts[2].parse() {
    29	            Ok(v) => v,
    30	            Err(_) => continue,
    31	        };
    32	        if n > 8 {
    33	            pos = pos.saturating_add(8 - (pos % 8));
    34	        }
    35	        out.push(Row { tag, pos, n });
    36	    }
    37	    out
    38	}
===== /app/peekurn/ink.rs =====
     1	use crate::pull;
     2	use crate::tally;
     3	use std::fs;
     4	use std::path::Path;
     5	
     6	pub fn rib_c() -> i32 {
     7	    let _ = tally::lines();
     8	    let buf = fs::read("/app/quaybag/night.bin").unwrap_or_default();
     9	    let dest = Path::new("/app/blotbay/rows.json");
    10	    if let Some(parent) = dest.parent() {
    11	        let _ = fs::create_dir_all(parent);
    12	    }
    13	    let (a, b, c, d, e, f) = pull::dump(&buf);
    14	    let body = format!(
    15	        "{{\"kind\":{},\"lane\":{},\"mode\":{},\"welt\":{},\"tail\":{},\"mark\":{}}}\n",
    16	        a, b, c, d, e, f
    17	    );
    18	    let _ = fs::write(dest, body);
    19	    0
    20	}
