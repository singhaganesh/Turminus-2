[77.191359, "o", "mod fold;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.19144, "o", "#[path = \"../millrib/gait.rs\"]\r\n\u001b[?2004l\r"]
[77.191501, "o", "\u001b[?2004h> mod gait;\r\n\u001b[?2004l\r"]
[77.191567, "o", "\u001b[?2004h> "]
[77.191667, "o", "#[path = \"../lidcue/skip.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.191742, "o", "mod skip;\r\n\u001b[?2004l\r\u001b[?2004h> "]
