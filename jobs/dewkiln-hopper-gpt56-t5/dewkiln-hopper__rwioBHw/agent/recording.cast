[44.376519, "o", "\u001b[?2004hroot@b8beee9ad590:/app# "]
[77.140129, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], root: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(root);\n    fs::create_dir_all(root).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|x| x.0);\n    for (day, source) in files {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(source, format!(\"{}/{}\", root, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\npython3 - <<'PY'\np='/app/urncue/fold.rs'\ns=open(p).read()\nstart=s.index('    if picked.is_empty() {')\nend=s.index('    let _ = fs::remove_dir_all(\"/app/packbay/stage\");', start)\ns=s[:start] + '''    if picked.is_empty() {\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\n        return Err(1);\n    }\n''' + s[end:]\nopen(p,'w').write(s)\nPY\ncat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn rows(text: &str) -> i32 {\n    text.lines().filter(|line| !line.trim().is_empty()).count() as i32\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let out = tpl\n        .replace(\"__P__\", probe)\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    let mut matched = 0;\n    let mut probe = String::new();\n\n    for (day, _) in packed {\n        let name = format!(\"d{:08}.tbl\", day);\n        let original_path = format!(\"/app/daywell/{}\", name);\n        let restored_path = format!(\"/app/packbay/latest/{}\", name);\n\n        // These reads are deliberately independent of ledger.json and staging.\n        let original = match fs::read_to_string(&original_path) {\n            Ok(value) => value,\n            Err(_) => return 1,\n        };\n        let restored = match fs::read_to_string(&restored_path) {\n            Ok(value) => value,\n            Err(_) => return 1,\n        };\n        let count = rows(&original);\n        if original != restored || count != rows(&restored) {\n            return 1;\n        }\n        matched += count;\n        if count > 0 {\n            probe = original_path;\n        }\n    }\n\n    if probe.is_empty() || matched != taken {\n        return 1;\n    }\n    if emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/wickmill/boot.rs <<'EOF'\n#[path = \"../urncue/fold.rs\"]\nmod fold;\n#[path = \"../millrib/gait.rs\"]\nmod gait;\n#[path = \"../lidcue/skip.rs\"]\nmod skip;\n#[path = \"../corkpit/floor.rs\"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != \"clasp\" {\n        eprintln!(\"usage: dewkiln clasp\");\n        std::process::exit(2);\n    }\n\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\n    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");\n    let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\n\n    let code = match fold::fold() {\n        Ok((packed, taken)) => {\n            let mut ordered = packed.clone();\n            skip::skip(&mut ordered);\n            if !floor::floor(taken) {\n                1\n            } else {\n                gait::gait(taken, &packed)\n            }\n        }\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\nfile /app/bin/dewkiln\n"]
