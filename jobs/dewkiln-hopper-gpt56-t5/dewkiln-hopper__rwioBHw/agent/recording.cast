[85.122103, "o", "\u001b[?2004hroot@b8beee9ad590:/app# "]
[111.293452, "i", "cat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list(\"/app/daywell\"));\n\n    if picked.is_empty() {\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\n        return Err(1);\n    }\n\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\n    let mut packed = Vec::new();\n    let mut taken = 0;\n\n    for (day, source) in picked {\n        let name = format!(\"d{:08}.tbl\", day);\n        let destination = format!(\"/app/packbay/stage/{}\", name);\n        fs::copy(&source, &destination).map_err(|_| 1)?;\n        taken += read::nlines(&destination);\n        packed.push((day, destination));\n    }\n\n    soak::soak(&packed, \"/app/packbay/latest\")?;\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\n        \"/app/bloturn/ledger.json\",\n        format!(\"{{\\\"taken\\\":{}}}\", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\n/app/wick.sh\nprintf 'ELF magic: '; od -An -tx1 -N4 /app/bin/dewkiln; stat -c 'mode=%A size=%s' /app/bin/dewkiln\n"]
[111.293909, "o", "cat > /app/urncue/fold.rs <<'EOF'\r\n\u001b[?2004l\r"]
