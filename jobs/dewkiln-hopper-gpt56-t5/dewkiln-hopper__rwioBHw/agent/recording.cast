[77.191892, "o", "\u001b[?2004h> mod floor;\r\n\u001b[?2004l\r"]
[77.19196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.192026, "o", "> fn main() {\r\n\u001b[?2004l\r"]
[77.192095, "o", "\u001b[?2004h> "]
[77.192186, "o", "    let mut args = std::env::args();\r\n\u001b[?2004l\r"]
[77.192267, "o", "\u001b[?2004h> "]
[77.192297, "o", "    let _ = args.next();\r\n\u001b[?2004l\r"]
[77.192414, "o", "\u001b[?2004h> "]
[77.192494, "o", "    if args.next().unwrap_or_default() != \"clasp\" {\r\n\u001b[?2004l\r"]
[77.192567, "o", "\u001b[?2004h> "]
[77.192649, "o", "        eprintln!(\"usage: dewkiln clasp\");\r\n\u001b[?2004l\r"]
[77.192711, "o", "\u001b[?2004h"]
[77.192776, "o", "> "]
[77.192844, "o", "        std::process::exit(2);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[77.192908, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.192975, "o", "> "]
[77.193085, "o", "    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r"]
[77.193153, "o", "\u001b[?2004h> "]
[77.193309, "o", "    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");\r\n\u001b[?2004l\r"]
[77.193366, "o", "\u001b[?2004h> "]
[77.193502, "o", "    let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\r\n\u001b[?2004l\r"]
[77.193561, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.19364, "o", "\u001b[?2004h> "]
[77.19371, "o", "    let code = match fold::fold() {\r\n\u001b[?2004l\r"]
[77.193778, "o", "\u001b[?2004h> "]
[77.193901, "o", "        Ok((packed, taken)) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.194021, "o", "            let mut ordered = packed.clone();\r\n\u001b[?2004l\r"]
[77.194079, "o", "\u001b[?2004h"]
[77.194173, "o", "> "]
[77.19424, "o", "            skip::skip(&mut ordered);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.194309, "o", "            if !floor::floor(taken) {\r\n\u001b[?2004l\r"]
[77.19437, "o", "\u001b[?2004h> "]
[77.194431, "o", "                1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.194489, "o", "            } else {\r\n\u001b[?2004l\r"]
[77.194575, "o", "\u001b[?2004h> "]
[77.194644, "o", "                gait::gait(taken, &packed)\r\n\u001b[?2004l\r"]
[77.194715, "o", "\u001b[?2004h> "]
[77.194779, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.19483, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.194877, "o", "> "]
[77.194967, "o", "        Err(code) => code,\r\n\u001b[?2004l\r"]
[77.195013, "o", "\u001b[?2004h> "]
[77.195089, "o", "    };\r\n\u001b[?2004l\r"]
[77.195135, "o", "\u001b[?2004h> "]
[77.195212, "o", "    std::process::exit(code);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.195261, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.195307, "o", "EOF\r\n\u001b[?2004l\r"]
[77.196633, "o", "\u001b[?2004hroot@b8beee9ad590:/app# "]
