[55.268494, "o", "\u001b[?2004hroot@b36c9517ce44:/app# "]
[55.269602, "o", "cat > /app/hookvat/spool.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use std::fs::{self, OpenOptions};\r\n\u001b[?2004l\r\u001b[?2004h> use std::io::Write;\r\n\u001b[?2004l\r\u001b[?2004h> use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> use std::sync::atomic::{AtomicU64, Ordering};\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.269765, "o", "static SERIAL: AtomicU64 = AtomicU64::new(0);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.269992, "o", "pub fn commit(dest: &str, bytes: &[u8]) -> i32 {\r\n\u001b[?2004l\r"]
[55.270127, "o", "\u001b[?2004h>     let path = Path::new(dest);\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.270198, "o", "> "]
[55.271797, "o", "    let parent = match path.parent() {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(p) => p,\r\n\u001b[?2004l\r\u001b[?2004h>         None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     let name = match path.file_name().and_then(|n| n.to_str()) {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(n) => n,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.271888, "o", "        None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.27208, "o", "> "]
[55.27213, "o", "    let serial = SERIAL.fetch_add(1, Ordering::Relaxed);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.272619, "o", "    let tmp = parent.join(format!(\".{}.{}.{}.tmp\", name, std::process::id(), serial));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.272675, "o", "    let result = (|| -> std::io::Result<()> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.272976, "o", "        let mut f = OpenOptions::new().write(true).create_new(true).open(&tmp)?;\r\n\u001b[?2004l\r\u001b[?2004h>         f.write_all(bytes)?;\r\n\u001b[?2004l\r"]
[55.27301, "o", "\u001b[?2004h> "]
[55.273183, "o", "        f.flush()?;\r\n\u001b[?2004l\r\u001b[?2004h"]
[55.273331, "o", ">         f.sync_all()?;\r\n\u001b[?2004l\r\u001b[?2004h>         drop(f);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.273461, "o", "        fs::rename(&tmp, path)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.2737, "o", "        if let Ok(dir) = OpenOptions::new().read(true).open(parent) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.273853, "o", "            let _ = dir.sync_all();\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.274067, "o", "        Ok(())\r\n\u001b[?2004l\r\u001b[?2004h>     })();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.274126, "o", "    if result.is_err() {\r\n\u001b[?2004l\r\u001b[?2004h>         let _ = fs::remove_file(&tmp);\r\n\u001b[?2004l\r\u001b[?2004h>         1\r\n\u001b[?2004l\r"]
[55.274249, "o", "\u001b[?2004h> "]
[55.274425, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h>         0\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
[55.274519, "o", "\r\n\u001b[?2004l\r"]
[55.276407, "o", "\u001b[?2004hroot@b36c9517ce44:/app# "]
[55.276927, "o", "cat > /app/hookvat/seal.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> pub fn card(thread: &str, op: &str) -> Vec<u8> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.277279, "o", "    format!(\"FIN1\\nthread={}\\nop={}\\nEND\\n\", thread, op).into_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[55.279403, "o", "\u001b[?2004h"]
