[92.392188, "i", "cat > /app/scanpit/peek.rs <<'EOF'\nuse std::fs;\n\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\n\npub fn show(p: &str) -> i32 {\n    let _ = SHAPE.len();\n    let raw = match fs::read_to_string(p) {\n        Ok(s) => s,\n        Err(_) => return 1,\n    };\n    let parts: Vec<&str> = raw.split('\\n').collect();\n    if parts.len() != 5 || !parts[4].is_empty() {\n        return 1;\n    }\n    if parts[0] != \"FIN1\" || parts[3] != \"END\" {\n        return 1;\n    }\n    let thread = match parts[1].strip_prefix(\"thread=\") {\n        Some(v) => v,\n        None => return 1,\n    };\n    let op = match parts[2].strip_prefix(\"op=\") {\n        Some(v) => v,\n        None => return 1,\n    };\n    if parts[1] != format!(\"thread={}\", crate::fmt::keep_token(thread))\n        || parts[2] != format!(\"op={}\", crate::fmt::keep_token(op))\n    {\n        return 1;\n    }\n    print!(\"{}\", raw);\n    0\n}\nEOF\n/app/hull.sh\nset +e\nprintf 'FIN1\\nthread=x\\nop=y\\n' > /app/bloturn/bad-truncated.rec\nprintf 'FIN1\\r\\nthread=x\\r\\nop=y\\r\\nEND\\r\\n' > /app/bloturn/bad-crlf.rec\n: > /app/bloturn/bad-empty.rec\nfor f in bad-truncated.rec bad-crlf.rec bad-empty.rec missing.rec; do /app/bin/finspool look \"/app/bloturn/$f\" >/dev/null 2>&1; echo \"$f=$?\"; done\nrm -f /app/bloturn/final.rec\n/app/bin/finspool sting 'desk-k4' 'splice-harbor-overlong-token-alpha-zz' /app/bloturn/final.rec >/dev/null 2>&1; echo \"final-sting=$?\"\n/app/bin/finspool look /app/bloturn/final.rec; echo \"final-look=$?\"\nprintf 'magic='; od -An -tx1 -N4 /app/bin/finspool | tr -d ' \\n'; echo\nprintf 'lines='; wc -l < /app/bloturn/final.rec\nprintf 'tail='; tail -c1 /app/bloturn/final.rec | od -An -tu1 | tr -d ' \\n'; echo\n"]
