[55.288728, "o", "    let thread = crate::fmt::keep_token(nm);\r\n\u001b[?2004l\r\u001b[?2004h>     let op = crate::fmt::keep_token(verb);\r\n\u001b[?2004l\r\u001b[?2004h>     let card = crate::seal::card(&thread, &op);\r\n\u001b[?2004l\r\u001b[?2004h>     crate::spool::commit(dest, &card)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@b36c9517ce44:/app# cat > /app/tplfold/live.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> pub fn go(nm: &str, verb: &str, dest: &str, _hard: bool) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let thread = crate::fmt::keep_token(nm);\r\n\u001b[?2004l\r\u001b[?2004h>     let op = crate::fmt::keep_token(verb);\r\n\u001b[?2004l\r\u001b[?2004h>     let card = crate::seal::card(&thread, &op);\r\n\u001b[?2004l\r\u001b[?2004h>     crate::spool::commit(dest, &card)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@b36c9517ce44:/app# "]
[55.473282, "i", "cat > /app/fincli/boot.rs <<'EOF'\n#[path = \"/app/hookvat/spool.rs\"]\nmod spool;\n#[path = \"/app/hookvat/seal.rs\"]\nmod seal;\n#[path = \"/app/hookvat/open.rs\"]\nmod open;\n#[path = \"/app/hookvat/gen_emit.rs\"]\nmod emit;\n#[path = \"/app/scanpit/peek.rs\"]\nmod peek;\n#[path = \"/app/scanpit/fmt.rs\"]\nmod fmt;\n\nuse std::env;\nuse std::process;\n\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\n\nfn bad() -> ! {\n    eprintln!(\"usage: finspool knit|sting THREAD OP DEST|ease THREAD OP DEST|look DEST\");\n    let _ = SHIFT.len();\n    process::exit(2)\n}\n\nfn main() {\n    let args: Vec<String> = env::args().skip(1).collect();\n    match args.first().map(String::as_str) {\n        Some(\"knit\") if args.len() == 1 => {\n            let st = process::Command::new(\"/app/hull.sh\").status();\n            process::exit(if st.map(|s| s.success()).unwrap_or(false) { 0 } else { 1 });\n        }\n        Some(\"look\") if args.len() == 2 => {\n            if !open::under_root(&args[1]) {\n                process::exit(1);\n            }\n            process::exit(peek::show(&args[1]));\n        }\n        Some(\"ease\") | Some(\"sting\") if args.len() == 4 => {\n            let hard = args[0] == \"sting\";\n            if !open::under_root(&args[3]) {\n                process::exit(1);\n            }\n            if emit::go(&args[1], &args[2], &args[3], hard) != 0 {\n                process::exit(2);\n            }\n            if hard {\n                process::abort();\n            }\n        }\n        _ => bad(),\n    }\n}\nEOF\n# Refresh generated source and compile the final executable.\n/app/hull.sh\nfile /app/bin/finspool; od -An -tx1 -N4 /app/bin/finspool\n"]
