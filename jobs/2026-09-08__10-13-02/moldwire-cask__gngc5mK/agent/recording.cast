[8.640956, "o", "\u001b[?2004hroot@4f3e6b4a09c6:/app# "]
[16.820848, "i", "for f in /app/riv.sh /app/dockotes/cold.note /app/slagbin/*.java /app/piturn/*.java /app/dockcli/*.java /app/dockcli/*.c /app/ribwire/*.c /app/sheetpit/*.sheet /app/incpit/*.inc; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[16.821657, "o", "for f in /app/riv.sh /app/dockotes/cold.note /app/slagbin/*.java /app/piturn/*.java /app/dockcli/*.java /app/dockcli/*.c /app/ribwire/*.c /app/sheetpit/*.sheet /app/incpit/*.inc; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[16.821959, "o", "===== /app/riv.sh =====\r\n"]
[16.823607, "o", "#!/bin/sh\r\nset -eu\r\nexport JAVA_HOME=\"${JAVA_HOME:-/opt/java/openjdk}\"\r\nexport PATH=\"${JAVA_HOME}/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/classes /app/bin /app/incpit /app/jsonpit /app/piturn/store\r\njavac -d /app/classes /app/slagbin/*.java /app/piturn/*.java /app/dockcli/*.java\r\njava -cp /app/classes Bake\r\ngcc -O2 -o /app/bin/moldwire /app/dockcli/main.c /app/ribwire/run.c -I/app/incpit\r\n"]
[16.823863, "o", "===== /app/dockotes/cold.note =====\r\n"]
[16.825105, "o", "If bake prints served, some shifts delete /app/piturn/store and rerun bake once so units look new on this watch.\r\n"]
[16.825312, "o", "===== /app/slagbin/SheetScan.java =====\r\n"]
[16.826421, "o", "import java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class SheetScan {\r\n    public static final class Row {\r\n        public final String name;\r\n        public final String kind;\r\n        public final boolean nested;\r\n\r\n        Row(String name, String kind, boolean nested) {\r\n            this.name = name;\r\n            this.kind = kind;\r\n            this.nested = nested;\r\n        }\r\n    }\r\n\r\n    public static String stem(String sheet) {\r\n        for (String line : sheet.split(\"\\n\")) {\r\n            String t = line.trim();\r\n"]
[16.82652, "o", "            if (t.startsWith(\"NAME \")) {\r\n                return t.substring(5).trim();\r\n            }\r\n        }\r\n        return \"\";\r\n    }\r\n\r\n    public static List<Row> rows(String sheet) {\r\n        List<Row> out = new ArrayList<Row>();\r\n        boolean nested = false;\r\n        for (String line : sheet.split(\"\\n\")) {\r\n            String t = line.trim();\r\n            if (t.startsWith(\"GROUP \")) {\r\n                nested = true;\r\n            } else if (t.equals(\"END\")) {\r\n                nested = false;\r\n            } else if (t.startsWith(\"FIELD \")) {\r\n                String rest = t.substring(6).trim();\r\n                int sp = rest.indexOf(' ');\r\n                if (sp <= 0) {\r\n                    continue;\r\n                }\r\n                out.add(new Row(rest.substring(0, sp), rest.substring(sp).trim(), nested));\r\n            }\r\n        }\r\n        return out;\r\n    }\r\n}\r\n"]
[16.826765, "o", "===== /app/slagbin/SlotEmit.java =====\r\n"]
[16.827901, "o", "import java.util.List;\r\n\r\npublic class SlotEmit {\r\n    public static String op_inner(String sheet) {\r\n        String stem = SheetScan.stem(sheet);\r\n        List<SheetScan.Row> rows = SheetScan.rows(sheet);\r\n        StringBuilder fn = new StringBuilder();\r\n        fn.append(\"static void skim_\").append(stem).append(\"(const unsigned char *p, size_t n, FILE *out) {\\n\");\r\n        fn.append(\"  size_t o = 0;\\n\");\r\n        for (SheetScan.Row r : rows) {\r\n            fn.append(\"  unsigned \").append(r.name).append(\" = 0;\\n\");\r\n        }\r\n"]
[16.828078, "o", "        for (SheetScan.Row r : rows) {\r\n            if (r.nested) {\r\n                continue;\r\n            }\r\n            if (\"u8\".equals(r.kind)) {\r\n                fn.append(\"  if (o < n) { \").append(r.name).append(\" = p[o++]; }\\n\");\r\n            } else if (\"u16be\".equals(r.kind)) {\r\n                fn.append(\"  if (o + 1 < n) { \").append(r.name).append(\" = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\\n\");\r\n            }\r\n        }\r\n        fn.append(\"  fputc('{', out);\\n\");\r\n"]
[16.828219, "o", "        for (int i = 0; i < rows.size(); i++) {\r\n            SheetScan.Row r = rows.get(i);\r\n            if (i > 0) {\r\n                fn.append(\"  fputc(',', out);\\n\");\r\n            }\r\n            if (r.nested) {\r\n                fn.append(\"  fprintf(out, \\\"\\\\\\\"\").append(r.name).append(\"\\\\\\\":\\\\\\\"\\\\\\\"\\\");\\n\");\r\n            } else {\r\n                fn.append(\"  fprintf(out, \\\"\\\\\\\"\").append(r.name).append(\"\\\\\\\":\\\\\\\"%u\\\\\\\"\\\", \").append(r.name).append(\");\\n\");\r\n            }\r\n        }\r\n        fn.append(\"  fputc('}', out);\\n\");\r\n        fn.append(\"}\\n\");\r\n        return fn.toString();\r\n    }\r\n}\r\n"]
[16.828323, "o", "===== /app/piturn/Dig.java =====\r\n"]
[16.829561, "o", "import java.security.MessageDigest;\r\n\r\npublic class Dig {\r\n    public static String mill_stamp() {\r\n        return \"rel-3\";\r\n    }\r\n\r\n    public static String mix_id(byte[] sheet) {\r\n        try {\r\n            MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n            md.update(sheet);\r\n            md.update(mill_stamp().getBytes(\"UTF-8\"));\r\n            byte[] d = md.digest();\r\n            StringBuilder sb = new StringBuilder();\r\n"]
[16.829673, "o", "            for (byte b : d) {\r\n                sb.append(String.format(\"%02x\", b));\r\n            }\r\n            return sb.toString();\r\n        } catch (Exception e) {\r\n            return \"none\";\r\n        }\r\n    }\r\n}\r\n"]
[16.829801, "o", "===== /app/piturn/Store.java =====\r\n"]
[16.831092, "o", "import java.nio.charset.StandardCharsets;\r\n\r\npublic class Store {\r\n    public static byte[] pack(String stamp, String inc) {\r\n        String body = stamp + \"\\n\" + inc;\r\n        return body.getBytes(StandardCharsets.UTF_8);\r\n    }\r\n\r\n    public static String stamp_of(byte[] stored) {\r\n        String s = new String(stored, StandardCharsets.UTF_8);\r\n        int n = s.indexOf('\\n');\r\n        if (n < 0) {\r\n            return \"\";\r\n        }\r\n        return s.substring(0, n);\r\n"]
[16.831209, "o", "    }\r\n\r\n    public static String inc_of(byte[] stored) {\r\n        String s = new String(stored, StandardCharsets.UTF_8);\r\n        int n = s.indexOf('\\n');\r\n        if (n < 0) {\r\n            return s;\r\n        }\r\n        return s.substring(n + 1);\r\n    }\r\n}\r\n"]
[16.831373, "o", "===== /app/dockcli/Bake.java =====\r\n"]
[16.832561, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.DirectoryStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.ArrayList;\r\nimport java.util.Collections;\r\nimport java.util.List;\r\n\r\npublic class Bake {\r\n    public static void main(String[] args) throws Exception {\r\n"]
[16.832728, "o", "        Path sheets = Paths.get(\"/app/sheetpit\");\r\n        Path units = Paths.get(\"/app/incpit\");\r\n        Path urn = Paths.get(\"/app/piturn/store\");\r\n        Files.createDirectories(units);\r\n        Files.createDirectories(urn);\r\n        List<Path> files = new ArrayList<Path>();\r\n        try (DirectoryStream<Path> ds = Files.newDirectoryStream(sheets, \"*.sheet\")) {\r\n            for (Path p : ds) {\r\n                files.add(p);\r\n            }\r\n        }\r\n        Collections.sort(files);\r\n        if (files.isEmpty()) {\r\n            System.exit(2);\r\n        }\r\n        List<String> stems = new ArrayList<String>();\r\n        for (Path p : files) {\r\n            byte[] raw = Files.readAllBytes(p);\r\n            String text = new String(raw, StandardCharsets.UTF_8);\r\n            String stem = SheetScan.stem(text);\r\n            if (stem.isEmpty()) {\r\n                System.exit(2);\r\n            }\r\n            stems.add(stem);\r\n            String key = Dig.mix_id(raw);\r\n            Path row = urn.resolve(key);\r\n            Path incPath = units.resolve(stem + \".inc\");\r\n            if (Files.exists(row)) {\r\n                byte[] stored = Files.readAllBytes(row);\r\n                System.out.println(\"served\");\r\n                int g = Gate.n_hit(stored);\r\n                if (g != 0) {\r\n                    System.exit(g);\r\n                }\r\n                Files.write(incPath, Store.inc_of(stored).getBytes(StandardCharsets.UTF_8));\r\n            } else {\r\n                String inc = SlotEmit.op_inner(text);\r\n                Files.write(incPath, inc.getBytes(StandardCharsets.UTF_8));\r\n                Files.write(row, Store.pack(Dig.mill_stamp(), inc));\r\n                System.out.println(\"fresh\");\r\n            }\r\n        }\r\n        StringBuilder reg = new StringBuilder();\r\n        for (String stem : stems) {\r\n            reg.append(\"#include \\\"\").append(stem).append(\".inc\\\"\\n\");\r\n        }\r\n        reg.append(\"static int call_skim(const char *stem, const unsigned char *p, size_t n, FILE *out) {\\n\");\r\n"]
[16.832834, "o", "        for (String stem : stems) {\r\n            reg.append(\"  if (strcmp(stem, \\\"\").append(stem).append(\"\\\") == 0) { skim_\").append(stem).append(\"(p, n, out); return 0; }\\n\");\r\n        }\r\n        reg.append(\"  return 2;\\n}\\n\");\r\n        Files.write(units.resolve(\"reg.inc\"), reg.toString().getBytes(StandardCharsets.UTF_8));\r\n        ProcessBuilder pb = new ProcessBuilder(\r\n            \"gcc\", \"-O2\", \"-o\", \"/app/bin/moldwire.new\",\r\n            \"/app/dockcli/main.c\", \"/app/ribwire/run.c\", \"-I/app/incpit\");\r\n        pb.redirectErrorStream(true);\r\n        Process g = pb.start();\r\n        int grc = g.waitFor();\r\n        if (grc != 0) {\r\n            System.exit(2);\r\n        }\r\n        Files.move(\r\n            Paths.get(\"/app/bin/moldwire.new\"),\r\n            Paths.get(\"/app/bin/moldwire\"),\r\n            java.nio.file.StandardCopyOption.REPLACE_EXISTING);\r\n    }\r\n}\r\n"]
[16.833027, "o", "===== /app/dockcli/Gate.java =====\r\n"]
[16.834129, "o", "public class Gate {\r\n    public static int n_hit(byte[] stored) {\r\n        return 0;\r\n    }\r\n}\r\n"]
[16.834307, "o", "===== /app/dockcli/main.c =====\r\n"]
[16.835359, "o", "#include <stdio.h>\r\n#include <string.h>\r\n#include <unistd.h>\r\n\r\nint skim_run(const char *path, const char *stem);\r\n\r\n"]
[16.83546, "o", "int main(int argc, char **argv) {\r\n    if (argc >= 2 && strcmp(argv[1], \"bake\") == 0) {\r\n        execl(\"/opt/java/openjdk/bin/java\", \"java\", \"-cp\", \"/app/classes\", \"Bake\", (char *)0);\r\n        perror(\"java\");\r\n        return 127;\r\n    }\r\n    if (argc >= 2 && strcmp(argv[1], \"skim\") == 0) {\r\n"]
[16.835561, "o", "        const char *path = \"/app/duskpit/dusk.bin\";\r\n        const char *stem = \"pond\";\r\n        if (argc >= 3) {\r\n            path = argv[2];\r\n        }\r\n        if (argc >= 4) {\r\n            stem = argv[3];\r\n        }\r\n        return skim_run(path, stem);\r\n    }\r\n    fprintf(stderr, \"usage: moldwire bake|skim\\n\");\r\n    return 2;\r\n}\r\n"]
[16.835681, "o", "===== /app/ribwire/run.c =====\r\n"]
[16.836759, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\n#include \"reg.inc\"\r\n"]
[16.836856, "o", "\r\nint skim_run(const char *path, const char *stem) {\r\n    FILE *in;\r\n    FILE *out;\r\n    unsigned char *buf;\r\n    long n;\r\n    int rc;\r\n\r\n    in = fopen(path, \"rb\");\r\n    if (in == NULL) {\r\n        return 2;\r\n    }\r\n    if (fseek(in, 0, SEEK_END) != 0) {\r\n        fclose(in);\r\n"]
[16.836954, "o", "        return 2;\r\n    }\r\n    n = ftell(in);\r\n    if (n < 0) {\r\n        fclose(in);\r\n        return 2;\r\n    }\r\n    rewind(in);\r\n    buf = malloc((size_t)n + 1);\r\n    if (buf == NULL) {\r\n        fclose(in);\r\n        return 2;\r\n    }\r\n    if (fread(buf, 1, (size_t)n, in) != (size_t)n) {\r\n        free(buf);\r\n        fclose(in);\r\n        return 2;\r\n    }\r\n    fclose(in);\r\n    mkdir(\"/app/jsonpit\", 0755);\r\n    out = fopen(\"/app/jsonpit/skim.json\", \"w\");\r\n    if (out == NULL) {\r\n        free(buf);\r\n        return 2;\r\n    }\r\n    rc = call_skim(stem, buf, (size_t)n, out);\r\n    fclose(out);\r\n    free(buf);\r\n    return rc;\r\n}\r\n"]
[16.837143, "o", "===== /app/ribwire/skip.c =====\r\n"]
[16.838178, "o", "/* Optional skip-list helper for unused probe rows. Not wired into skim. */\r\nint skip_row(const char *stem) {\r\n    (void)stem;\r\n    return 0;\r\n}\r\n"]
[16.838351, "o", "===== /app/sheetpit/lake.sheet =====\r\n"]
[16.839302, "o", "NAME lake\r\nFIELD depth u8\r\nGROUP climate\r\nFIELD temp u16be\r\nFIELD wind u8\r\nEND\r\n"]
[16.839539, "o", "===== /app/sheetpit/pond.sheet =====\r\n"]
[16.84063, "o", "NAME pond\r\nFIELD depth u8\r\nGROUP climate\r\nFIELD temp u16be\r\nEND\r\n"]
[16.840819, "o", "===== /app/incpit/lake.inc =====\r\n"]
[16.841744, "o", "static void skim_lake(const unsigned char *p, size_t n, FILE *out) {\r\n  size_t o = 0;\r\n  unsigned depth = 0;\r\n  unsigned temp = 0;\r\n  unsigned wind = 0;\r\n  if (o < n) { depth = p[o++]; }\r\n  fputc('{', out);\r\n  fprintf(out, \"\\\"depth\\\":\\\"%u\\\"\", depth);\r\n  fputc(',', out);\r\n  fprintf(out, \"\\\"temp\\\":\\\"\\\"\");\r\n  fputc(',', out);\r\n  fprintf(out, \"\\\"wind\\\":\\\"\\\"\");\r\n  fputc('}', out);\r\n"]
[16.841849, "o", "}\r\n"]
[16.841984, "o", "===== /app/incpit/pond.inc =====\r\n"]
[16.843154, "o", "static void skim_pond(const unsigned char *p, size_t n, FILE *out) {\r\n  size_t o = 0;\r\n  unsigned depth = 0;\r\n  unsigned temp = 0;\r\n  if (o < n) { depth = p[o++]; }\r\n  fputc('{', out);\r\n  fprintf(out, \"\\\"depth\\\":\\\"%u\\\"\", depth);\r\n  fputc(',', out);\r\n  fprintf(out, \"\\\"temp\\\":\\\"\\\"\");\r\n  fputc('}', out);\r\n}\r\n"]
[16.843344, "o", "===== /app/incpit/reg.inc =====\r\n"]
[16.844262, "o", "#include \"lake.inc\"\r\n#include \"pond.inc\"\r\nstatic int call_skim(const char *stem, const unsigned char *p, size_t n, FILE *out) {\r\n  if (strcmp(stem, \"lake\") == 0) { skim_lake(p, n, out); return 0; }\r\n  if (strcmp(stem, \"pond\") == 0) { skim_pond(p, n, out); return 0; }\r\n  return 2;\r\n"]
[16.844353, "o", "}\r\n"]
[16.844497, "o", "\u001b[?2004hroot@4f3e6b4a09c6:/app# "]
[17.868878, "i", "echo '===== frames ====='; for f in /app/duskpit/*.bin; do echo \"--- $f\"; xxd -g1 \"$f\"; done; echo '===== baseline skim ====='; /app/bin/moldwire skim; echo status=$?; /app/bin/moldwire skim /app/duskpit/lake.bin lake; echo status=$?; /app/bin/moldwire skim /app/duskpit/hold.bin hold; echo status=$?; echo '===== baseline bake ====='; /app/bin/moldwire bake; echo status=$?\n"]
[17.87005, "o", "echo '===== frames ====='; for f in /app/duskpit/*.bin; do echo \"--- $f\"; xxd -g1 \"$f\"; done; echo '===== baseline skim ====='; /app/bin/moldwire skim; echo status=$?; /app/bin/moldwire skim /app/duskpit/lake.bin lake; echo status=$?; /app/bin/moldwire skim /app/duskpit/hold.bin hold; echo status=$?; echo '===== baseline bake ====='; /app/bin/moldwire bake; echo status=$?\r\n\u001b[?2004l\r"]
[17.870283, "o", "===== frames =====\r\n"]
