[8.487928, "o", "printf '%s\\n' '--- tree.map ---'; cat /app/dockotes/tree.map; printf '%s\\n' '--- sheet.rules ---'; cat /app/dockotes/sheet.rules\r\n\u001b[?2004l\r"]
[8.488075, "o", "--- tree.map ---\r\n"]
[8.489341, "o", "Java trees\r\n  /app/slagbin   sheet walk and C unit emit\r\n  /app/slagbin/SlotEmit.java\r\n  /app/piturn    urn row identity\r\n  /app/dockcli    bake entry and serve status\r\n\r\nC trees\r\n  /app/dockcli    ELF trampoline\r\n  /app/ribwire    skim dispatcher\r\n\r\nUnits\r\n  /app/incpit/pond.inc\r\n\r\nFrames\r\n  /app/duskpit/dusk.bin\r\n  /app/duskpit/hold.bin\r\n  /app/duskpit/lake.bin\r\n\r\nRebuild is /app/riv.sh.\r\nShift notes live in /app/dockotes/cold.note.\r\n"]
[8.489669, "o", "--- sheet.rules ---\r\n"]
[8.490963, "o", "Sheets under /app/sheetpit use one NAME line, FIELD lines, and optional GROUP/END blocks.\r\n\r\nFIELD kinds:\r\n  u8     one byte\r\n  u16be  two bytes, big endian\r\n\r\nA GROUP on the wire is a u16be payload length followed by that many bytes of inner FIELD values in declaration order. GROUP names are not JSON keys. Every FIELD name, including names declared inside a GROUP, appears in /app/jsonpit/skim.json as a decimal integer string.\r\n\r\nbake writes one /app/incpit/<stem>.inc per sheet, where stem is the NAME token, plus /app/incpit/reg.inc.\r\n\r\nGrade-time sheets may appear as hold.sheet or mist.sheet under /app/sheetpit (NAME hold / NAME mist). Matching units are hold.inc and mist.inc.\r\n\r\nskim:\r\n  /app/bin/moldwire skim\r\n      reads /app/duskpit/dusk.bin with stem pond\r\n  /app/bin/moldwire skim <frame> <stem>\r\n      reads that frame using the named unit; shipped extras include /app/duskpit/hold.bin (stem hold) and /app/duskpit/lake.bin (stem lake)\r\n\r\nbake:\r\n  /app/bin/moldwire bake\r\n      refreshes incpit from sheetpit, then the image relinks the ELF\r\n\r\nbake stdout lines are either \"served\" or \"fresh\" (one per sheet). If any line is served after emitter sources under /app/slagbin changed, bake exits non-zero.\r\n"]
[8.491233, "o", "\u001b[?2004hroot@4f3e6b4a09c6:/app# "]
[8.630232, "i", "printf '%s\\n' '--- directories ---'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort; printf '%s\\n' '--- executable ---'; file /app/bin/moldwire; printf '%s\\n' '--- build files ---'; find /app -maxdepth 3 -type f \\( -name Makefile -o -name CMakeLists.txt -o -name pom.xml -o -name build.gradle -o -name '*.mk' \\) -print\n"]
