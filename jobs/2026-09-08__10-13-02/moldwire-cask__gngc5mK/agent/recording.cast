[89.504936, "o", "--- generated units\r\n"]
[89.506528, "o", "static void skim_pond(const unsigned char *p, size_t n, FILE *out) {\r\n  size_t o = 0;\r\n  unsigned depth = 0;\r\n  unsigned temp = 0;\r\n  if (o < n) { depth = p[o++]; }\r\n  size_t group_end_1 = o;\r\n  if (o + 1 < n) {\r\n    size_t group_len = ((size_t)p[o] << 8) | p[o + 1]; o += 2;\r\n    group_end_1 = o + group_len;\r\n    if (group_end_1 < o || group_end_1 > n) group_end_1 = n;\r\n  }\r\n  if (o + 1 < group_end_1) { temp = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\r\n  o = group_end_1;\r\n  fputc('{', out);\r\n  fprintf(out, \"\\\"depth\\\":\\\"%u\\\"\", depth);\r\n"]
[89.50658, "o", "  fputc(',', out);\r\n  fprintf(out, \"\\\"temp\\\":\\\"%u\\\"\", temp);\r\n  fputc('}', out);\r\n}\r\n"]
[89.507932, "o", "static void skim_lake(const unsigned char *p, size_t n, FILE *out) {\r\n  size_t o = 0;\r\n  unsigned depth = 0;\r\n  unsigned temp = 0;\r\n  unsigned wind = 0;\r\n  if (o < n) { depth = p[o++]; }\r\n  size_t group_end_1 = o;\r\n  if (o + 1 < n) {\r\n    size_t group_len = ((size_t)p[o] << 8) | p[o + 1]; o += 2;\r\n    group_end_1 = o + group_len;\r\n    if (group_end_1 < o || group_end_1 > n) group_end_1 = n;\r\n"]
[89.508059, "o", "  }\r\n  if (o + 1 < group_end_1) { temp = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\r\n  if (o < group_end_1) { wind = p[o++]; }\r\n  o = group_end_1;\r\n  fputc('{', out);\r\n  fprintf(out, \"\\\"depth\\\":\\\"%u\\\"\", depth);\r\n  fputc(',', out);\r\n  fprintf(out, \"\\\"temp\\\":\\\"%u\\\"\", temp);\r\n  fputc(',', out);\r\n  fprintf(out, \"\\\"wind\\\":\\\"%u\\\"\", wind);\r\n  fputc('}', out);\r\n}\r\n"]
