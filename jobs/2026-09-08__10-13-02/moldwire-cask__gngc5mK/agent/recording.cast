[30.298468, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\t\r\n     3\tpublic class Store {\r\n     4\t    public static byte[] pack(String stamp, String inc) {\r\n     5\t        String body = stamp + \"\\n\" + inc;\r\n     6\t        return body.getBytes(StandardCharsets.UTF_8);\r\n     7\t    }\r\n     8\t\r\n     9\t    public static String stamp_of(byte[] stored) {\r\n    10\t        String s = new String(stored, StandardCharsets.UTF_8);\r\n    11\t        int n = s.indexOf('\\n');\r\n    12\t        if (n < 0) {\r\n    13\t            return \"\";\r\n    14\t        }\r\n    15"]
[30.298619, "o", "\t        return s.substring(0, n);\r\n    16\t    }\r\n    17\t\r\n    18\t    public static String inc_of(byte[] stored) {\r\n    19\t        String s = new String(stored, StandardCharsets.UTF_8);\r\n    20\t        int n = s.indexOf('\\n');\r\n    21\t        if (n < 0) {\r\n    22\t            return s;\r\n    23\t        }\r\n    24\t        return s.substring(n + 1);\r\n    25\t    }\r\n    26\t}\r\n"]
[30.298768, "o", "===== /app/dockcli/Bake.java =====\r\n"]
[30.299712, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.DirectoryStream;\r\n     3\timport java.nio.file.Files;\r\n     4\timport java.nio.file.Path;\r\n     5\timport java.nio.file.Paths;\r\n     6\timport java.util.ArrayList;\r\n     7\timport java.util.Collections;\r\n     8\timport java.util.List;\r\n     9\t\r\n    10\tpublic class Bake {\r\n    11\t    public static void main(String[] args) throws Exception {\r\n    12\t        Path sheets = Paths.get(\"/app/sheetpit\");\r\n    13\t        Path units = Paths.get(\"/app/incpit\");"]
[30.299845, "o", "\r\n    14\t        Path urn = Paths.get(\"/app/piturn/store\");\r\n    15\t        Files.createDirectories(units);\r\n    16\t        Files.createDirectories(urn);\r\n    17\t        List<Path> files = new ArrayList<Path>();\r\n    18\t        try (DirectoryStream<Path> ds = Files.newDirectoryStream(sheets, \"*.sheet\")) {\r\n    19\t            for (Path p : ds) {\r\n    20\t                files.add(p);\r\n    21\t            }\r\n    22\t        }\r\n    23\t        Collections.sort(files);\r\n    24\t        if (files.isEmpty()) {\r\n    25\t            System.exit(2);\r\n    26\t        }\r\n    27\t        List<String> stems = new ArrayList<String>();\r\n    28\t        for (Path p : files) {\r\n    29\t            byte[] raw = Files.readAllBytes(p);\r\n    30\t            String text = new String(raw, StandardCharsets.UTF_8);\r\n    31\t            String stem = SheetScan.stem(text);\r\n    32\t            if (stem.isEmpty()) {\r\n    33\t                System.exit(2);\r\n    34\t            }\r\n    35\t            stems.add(stem);\r\n    36\t            String key = Dig.mix_id(raw);\r\n    37\t            Path row = urn.resolve(key);\r\n    38\t            Path incPath = units.resolve(stem + \".inc\");\r\n    39\t            if (Files.exists(row)) {\r\n    40\t                byte[] stored = Files.readAllBytes(row);\r\n    41\t                System.out.println(\"served\");\r\n    42\t                int g = Gate.n_hit(stored);\r\n    43\t                if (g != 0) {\r\n    44\t                    System.exit(g);\r\n    45\t                }\r\n    46\t                Files.write(incPath, Store.inc_of(stored).getBytes(StandardCharsets.UTF_8));\r\n    47\t            } else {\r\n    48\t                String inc = SlotEmit.op_inner(text);\r\n    49\t                Files.write(incPath, inc.getBytes(StandardCharsets.UTF_8));\r\n    50\t                Files.write(row, Store.pack(Dig.mill_stamp(), inc));\r\n    51\t                System.out.println(\"fresh\");\r\n    52\t            }\r\n    53\t        }\r\n    54\t        StringBuilder reg = new StringBuilder();\r\n"]
[30.29994, "o", "    55\t        for (String stem : stems) {\r\n    56\t            reg.append(\"#include \\\"\").append(stem).append(\".inc\\\"\\n\");\r\n    57\t        }\r\n    58\t        reg.append(\"static int call_skim(const char *stem, const unsigned char *p, size_t n, FILE *out) {\\n\");\r\n    59\t        for (String stem : stems) {\r\n    60\t            reg.append(\"  if (strcmp(stem, \\\"\").append(stem).append(\"\\\") == 0) { skim_\").append(stem).append(\"(p, n, out); return 0; }\\n\");\r\n    61\t        }\r\n    62\t        reg.append(\"  return 2;\\n}\\n\");\r\n    63\t        Files.write(units.resolve(\"reg.inc\"), reg.toString().getBytes(StandardCharsets.UTF_8));\r\n    64\t        ProcessBuilder pb = new ProcessBuilder(\r\n    65\t            \"gcc\", \"-O2\", \"-o\", \"/app/bin/moldwire.new\",\r\n    66\t            \"/app/dockcli/main.c\", \"/app/ribwire/run.c\", \"-I/app/incpit\");\r\n    67\t        pb.redirectErrorStream(true);\r\n    68\t        Process g = pb.start();\r\n    69\t        int grc = g.waitFor();\r\n    70\t        if (grc != 0) {\r\n    71\t            System.exit(2);\r\n    72\t        }\r\n    73\t        Files.move(\r\n    74\t            Paths.get(\"/app/bin/moldwire.new\"),\r\n    75\t            Paths.get(\"/app/bin/moldwire\"),\r\n    76\t            java.nio.file.StandardCopyOption.REPLACE_EXISTING);\r\n    77\t    }\r\n    78\t}\r\n"]
