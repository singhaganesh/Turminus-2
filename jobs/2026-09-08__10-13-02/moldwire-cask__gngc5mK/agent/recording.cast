[84.291368, "i", "cat > /app/slagbin/SlotEmit.java <<'EOF'\nimport java.util.List;\n\npublic class SlotEmit {\n    private static void readField(StringBuilder fn, String name, String kind, String limit) {\n        if (\"u8\".equals(kind)) {\n            fn.append(\"  if (o < \").append(limit).append(\") { \").append(name).append(\" = p[o++]; }\\n\");\n        } else if (\"u16be\".equals(kind)) {\n            fn.append(\"  if (o + 1 < \").append(limit).append(\") { \").append(name)\n              .append(\" = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\\n\");\n        }\n    }\n\n    public static String op_inner(String sheet) {\n        String stem = SheetScan.stem(sheet);\n        List<SheetScan.Row> rows = SheetScan.rows(sheet);\n        StringBuilder fn = new StringBuilder();\n        fn.append(\"static void skim_\").append(stem).append(\"(const unsigned char *p, size_t n, FILE *out) {\\n\");\n        fn.append(\"  size_t o = 0;\\n\");\n        for (SheetScan.Row r : rows) {\n            fn.append(\"  unsigned \").append(r.name).append(\" = 0;\\n\");\n        }\n\n        int group = 0;\n        String limit = \"n\";\n        for (String line : sheet.split(\"\\\\n\")) {\n            String t = line.trim();\n            if (t.startsWith(\"GROUP \")) {\n                group++;\n                String end = \"group_end_\" + group;\n                fn.append(\"  size_t \").append(end).append(\" = o;\\n\");\n                fn.append(\"  if (o + 1 < n) {\\n\");\n                fn.append(\"    size_t group_len = ((size_t)p[o] << 8) | p[o + 1]; o += 2;\\n\");\n                fn.append(\"    \").append(end).append(\" = o + group_len;\\n\");\n                fn.append(\"    if (\").append(end).append(\" < o || \").append(end).append(\" > n) \").append(end).append(\" = n;\\n\");\n                fn.append(\"  }\\n\");\n                limit = end;\n            } else if (t.equals(\"END\")) {\n                fn.append(\"  o = \").append(limit).append(\";\\n\");\n                limit = \"n\";\n            } else if (t.startsWith(\"FIELD \")) {\n                String rest = t.substring(6).trim();\n                int sp = rest.indexOf(' ');\n                if (sp > 0) {\n                    readField(fn, rest.substring(0, sp), rest.substring(sp).trim(), limit);\n                }\n            }\n        }\n\n        fn.append(\"  fputc('{', out);\\n\");\n        for (int i = 0; i < rows.size(); i++) {\n            SheetScan.Row r = rows.get(i);\n            if (i > 0) fn.append(\"  fputc(',', out);\\n\");\n            fn.append(\"  fprintf(out, \\\"\\\\\\\"\").append(r.name)\n              .append(\"\\\\\\\":\\\\\\\"%u\\\\\\\"\\\", \").append(r.name).append(\");\\n\");\n        }\n        fn.append(\"  fputc('}', out);\\n\");\n        fn.append(\"}\\n\");\n        return fn.toString();\n    }\n}\nEOF\ncat > /app/piturn/Dig.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.security.MessageDigest;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.List;\nimport java.util.stream.Stream;\n\npublic class Dig {\n    private static String hex(byte[] d) {\n        StringBuilder sb = new StringBuilder();\n        for (byte b : d) sb.append(String.format(\"%02x\", b));\n        return sb.toString();\n    }\n\n    public static String mill_stamp() {\n        try {\n            MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\n            List<Path> files = new ArrayList<Path>();\n            try (Stream<Path> walk = Files.walk(Paths.get(\"/app/slagbin\"))) {\n                walk.filter(Files::isRegularFile).forEach(files::add);\n            }\n            Collections.sort(files);\n            for (Path p : files) {\n                md.update(p.toString().getBytes(StandardCharsets.UTF_8));\n                md.update((byte)0);\n                md.update(Files.readAllBytes(p));\n                md.update((byte)0);\n                md.update(Long.toString(Files.getLastModifiedTime(p).toMillis()).getBytes(StandardCharsets.UTF_8));\n                md.update((byte)0);\n            }\n            return hex(md.digest());\n        } catch (Exception e) {\n            return \"invalid-emitter\";\n        }\n    }\n\n    public static String mix"]
[84.291507, "i", "_id(byte[] sheet) {\n        try {\n            MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\n            md.update(sheet);\n            return hex(md.digest());\n        } catch (Exception e) {\n            return \"none\";\n        }\n    }\n}\nEOF\ncat > /app/dockcli/Gate.java <<'EOF'\npublic class Gate {\n    public static int n_hit(byte[] stored) {\n        return Dig.mill_stamp().equals(Store.stamp_of(stored)) ? 0 : 3;\n    }\n}\nEOF\n"]
