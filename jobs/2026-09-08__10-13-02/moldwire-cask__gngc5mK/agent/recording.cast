[84.418202, "i", "cat > /app/ribwire/run.c <<'EOF'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/stat.h>\n#include <unistd.h>\n\n#include \"reg.inc\"\n\nint skim_run(const char *path, const char *stem) {\n    FILE *in = NULL;\n    FILE *out = NULL;\n    unsigned char *buf = NULL;\n    long n;\n    int rc = 2;\n    const char *tmp = \"/app/jsonpit/skim.json.tmp\";\n\n    in = fopen(path, \"rb\");\n    if (in == NULL) goto done;\n    if (fseek(in, 0, SEEK_END) != 0) goto done;\n    n = ftell(in);\n    if (n < 0) goto done;\n    rewind(in);\n    buf = malloc((size_t)n + 1);\n    if (buf == NULL) goto done;\n    if (fread(buf, 1, (size_t)n, in) != (size_t)n) goto done;\n    fclose(in);\n    in = NULL;\n\n    if (mkdir(\"/app/jsonpit\", 0755) != 0) {\n        struct stat st;\n        if (stat(\"/app/jsonpit\", &st) != 0 || !S_ISDIR(st.st_mode)) goto done;\n    }\n    out = fopen(tmp, \"w\");\n    if (out == NULL) goto done;\n    rc = call_skim(stem, buf, (size_t)n, out);\n    if (fclose(out) != 0 && rc == 0) rc = 2;\n    out = NULL;\n    if (rc == 0) {\n        if (rename(tmp, \"/app/jsonpit/skim.json\") != 0) rc = 2;\n    } else {\n        unlink(tmp);\n    }\n\ndone:\n    if (out != NULL) fclose(out);\n    if (in != NULL) fclose(in);\n    if (rc != 0) unlink(tmp);\n    free(buf);\n    return rc;\n}\nEOF\n/app/riv.sh\n"]
