===== /app/incpit/lake.inc =====
static void skim_lake(const unsigned char *p, size_t n, FILE *out) {
  size_t o = 0;
  unsigned depth = 0;
  unsigned temp = 0;
  unsigned wind = 0;
  if (o < n) { depth = p[o++]; }
  fputc('{', out);
  fprintf(out, "\"depth\":\"%u\"", depth);
  fputc(',', out);
  fprintf(out, "\"temp\":\"\"");
  fputc(',', out);
  fprintf(out, "\"wind\":\"\"");
  fputc('}', out);
}
