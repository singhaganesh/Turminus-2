[108.3104, "o", "--- generated units ---\r\n"]
[108.311828, "o", "static void skim_pond(const unsigned char *p, size_t n, FILE *out) {\r\n  size_t o = 0;\r\n  size_t group_end = 0;\r\n  unsigned depth = 0;\r\n  unsigned temp = 0;\r\n  if (o < n) { depth = p[o++]; }\r\n  if (o + 1 < n) {\r\n    size_t group_len = ((size_t)p[o] << 8) | p[o + 1];\r\n    o += 2;\r\n    group_end = group_len <= n - o ? o + group_len : n;\r\n  } else { o = n; group_end = n; }\r\n  if (o + 1 < group_end) { temp = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\r\n  o = group_end;\r\n  fputc('{', out);\r\n  fprintf(out, \"\\\"depth\\\":\\\"%u\\\"\", depth);\r\n  fputc(',', out);\r\n  fprintf(out, \"\\\"temp\\\":\\\"%u\\\"\", temp);\r\n  fputc('}', out);\r\n}\r\n"]
[108.313179, "o", "static void skim_lake(const unsigned char *p, size_t n, FILE *out) {\r\n  size_t o = 0;\r\n  size_t group_end = 0;\r\n  unsigned depth = 0;\r\n  unsigned temp = 0;\r\n  unsigned wind = 0;\r\n  if (o < n) { depth = p[o++]; }\r\n  if (o + 1 < n) {\r\n    size_t group_len = ((size_t)p[o] << 8) | p[o + 1];\r\n    o += 2;\r\n    group_end = group_len <= n - o ? o + group_len : n;\r\n  } else { o = n; group_end = n; }\r\n  if (o + 1 < group_end) { temp = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\r\n  if (o < group_end) { wind = p[o++]; }\r\n  o = group_end;\r\n  fputc('{', out);\r\n  fprintf(out, \"\\\"depth\\\":\\\"%u\\\"\", depth);\r\n  fputc(',', out);\r\n  fprintf(out, \"\\\"temp\\\":\\\"%u\\\"\", temp);\r\n  fputc(',', out);\r\n  fprintf(out, \"\\\"wind\\\":\\\"%u\\\"\", wind);\r\n  fputc('}', out);\r\n}\r\n"]
