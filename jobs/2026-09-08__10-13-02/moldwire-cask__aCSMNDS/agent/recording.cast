[24.731388, "o", "    12\t            md.update(mill_stamp().getBytes(\"UTF-8\"));\r\n    13\t            byte[] d = md.digest();\r\n    14\t            StringBuilder sb = new StringBuilder();\r\n    15\t            for (byte b : d) {\r\n    16\t                sb.append(String.format(\"%02x\", b));\r\n    17\t            }\r\n    18\t            return sb.toString();\r\n    19\t        } catch (Exception e) {\r\n    20\t            return \"none\";\r\n    21\t        }\r\n    22\t    }\r\n    23\t}\r\n"]
