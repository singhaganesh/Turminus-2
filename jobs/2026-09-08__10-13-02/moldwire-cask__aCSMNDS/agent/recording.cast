[78.445624, "o", "\u001b[?2004h> "]
[78.445766, "o", "    if (fread(buf, 1, (size_t)n, in) != (size_t)n) {\r\n\u001b[?2004l\r"]
[78.445816, "o", "\u001b[?2004h> "]
