[78.435392, "o", "\u001b[?2004h> "]
[78.43567, "o", "                md.update(Long.toString(Files.getLastModifiedTime(p).toMillis()).getBytes(StandardCharsets.UTF_8));\r\n\u001b[?2004l\r"]
[78.435712, "o", "\u001b[?2004h> "]
