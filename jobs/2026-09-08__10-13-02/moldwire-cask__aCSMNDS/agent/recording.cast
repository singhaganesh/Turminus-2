[24.732467, "o", "     6\t        return body.getBytes(StandardCharsets.UTF_8);\r\n     7\t    }\r\n     8\t\r\n     9\t    public static String stamp_of(byte[] stored) {\r\n    10\t        String s = new String(stored, StandardCharsets.UTF_8);\r\n    11\t        int n = s.indexOf('\\n');\r\n    12\t        if (n < 0) {\r\n    13\t            return \"\";\r\n    14\t        }\r\n    15\t        return s.substring(0, n);\r\n    16\t    }\r\n    17\t\r\n    18\t    public static String inc_of(byte[] stored) {\r\n    19\t        String s = new String(stored, StandardCharsets.UTF_8);\r\n    20\t        int n = s.indexOf('\\n');\r\n    21\t        if (n < 0) {\r\n    22\t            return s;\r\n    23\t        }\r\n    24\t        return s.substring(n + 1);\r\n    25\t    }\r\n    26\t}\r\n"]
