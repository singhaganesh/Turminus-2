[78.278268, "i", "cat > slagbin/SheetScan.java <<'EOF'\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class SheetScan {\n    public static final class Row {\n        public final String name;\n        public final String kind;\n        /* Empty for a top-level field; otherwise the enclosing GROUP name. */\n        public final String group;\n        public final boolean nested;\n\n        Row(String name, String kind, String group) {\n            this.name = name;\n            this.kind = kind;\n            this.group = group;\n            this.nested = !group.isEmpty();\n        }\n    }\n\n    public static String stem(String sheet) {\n        for (String line : sheet.split(\"\\\\r?\\\\n\")) {\n            String t = line.trim();\n            if (t.startsWith(\"NAME \")) {\n                return t.substring(5).trim();\n            }\n        }\n        return \"\";\n    }\n\n    public static List<Row> rows(String sheet) {\n        List<Row> out = new ArrayList<Row>();\n        String group = \"\";\n        for (String line : sheet.split(\"\\\\r?\\\\n\")) {\n            String t = line.trim();\n            if (t.startsWith(\"GROUP \")) {\n                group = t.substring(6).trim();\n            } else if (t.equals(\"END\")) {\n                group = \"\";\n            } else if (t.startsWith(\"FIELD \")) {\n                String rest = t.substring(6).trim();\n                int sp = rest.indexOf(' ');\n                if (sp <= 0) {\n                    continue;\n                }\n                out.add(new Row(rest.substring(0, sp), rest.substring(sp).trim(), group));\n            }\n        }\n        return out;\n    }\n}\nEOF\ncat > slagbin/SlotEmit.java <<'EOF'\nimport java.util.List;\n\npublic class SlotEmit {\n    private static void read(StringBuilder fn, SheetScan.Row r, String limit) {\n        if (\"u8\".equals(r.kind)) {\n            fn.append(\"  if (o < \").append(limit).append(\") { \").append(r.name).append(\" = p[o++]; }\\n\");\n        } else if (\"u16be\".equals(r.kind)) {\n            fn.append(\"  if (o + 1 < \").append(limit).append(\") { \").append(r.name)\n              .append(\" = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\\n\");\n        }\n    }\n\n    public static String op_inner(String sheet) {\n        String stem = SheetScan.stem(sheet);\n        List<SheetScan.Row> rows = SheetScan.rows(sheet);\n        StringBuilder fn = new StringBuilder();\n        fn.append(\"static void skim_\").append(stem).append(\"(const unsigned char *p, size_t n, FILE *out) {\\n\");\n        fn.append(\"  size_t o = 0;\\n\");\n        fn.append(\"  size_t group_end = 0;\\n\");\n        for (SheetScan.Row r : rows) {\n            fn.append(\"  unsigned \").append(r.name).append(\" = 0;\\n\");\n        }\n\n        String active = \"\";\n        for (SheetScan.Row r : rows) {\n            if (!active.equals(r.group)) {\n                if (!active.isEmpty()) {\n                    fn.append(\"  o = group_end;\\n\");\n                }\n                active = r.group;\n                if (!active.isEmpty()) {\n                    fn.append(\"  if (o + 1 < n) {\\n\");\n                    fn.append(\"    size_t group_len = ((size_t)p[o] << 8) | p[o + 1];\\n\");\n                    fn.append(\"    o += 2;\\n\");\n                    fn.append(\"    group_end = group_len <= n - o ? o + group_len : n;\\n\");\n                    fn.append(\"  } else { o = n; group_end = n; }\\n\");\n                }\n            }\n            read(fn, r, r.group.isEmpty() ? \"n\" : \"group_end\");\n        }\n        if (!active.isEmpty()) {\n            fn.append(\"  o = group_end;\\n\");\n        }\n\n        fn.append(\"  fputc('{', out);\\n\");\n        for (int i = 0; i < rows.size(); i++) {\n            SheetScan.Row r = rows.get(i);\n            if (i > 0) {\n                fn.append(\"  fputc(',', out);\\n\");\n            }\n            fn.append(\"  fprintf(out, \\\"\\\\\\\"\").append(r.name)\n              .append(\"\\\\\\\":\\\\\\\"%u\\\\\\\"\\\", \").append(r.name).append(\");\\n\");\n        }\n        fn.append(\"  fputc('}', out);\\n\");\n        fn.append(\"}\\n\");\n        return fn.toString();\n    }\n}\nEOF\n"]
