[24.728967, "o", "    12\t        Path sheets = Paths.get(\"/app/sheetpit\");\r\n    13\t        Path units = Paths.get(\"/app/incpit\");\r\n    14\t        Path urn = Paths.get(\"/app/piturn/store\");\r\n    15\t        Files.createDirectories(units);\r\n    16\t        Files.createDirectories(urn);\r\n    17\t        List<Path> files = new ArrayList<Path>();\r\n    18\t        try (DirectoryStream<Path> ds = Files.newDirectoryStream(sheets, \"*.sheet\")) {\r\n    19\t            for (Path p : ds) {\r\n    20\t                files.add(p);\r\n    21\t            }\r\n    22\t        }\r\n    23\t        Collections.sort(files);\r\n    24\t        if (files.isEmpty()) {\r\n    25\t            System.exit(2);\r\n    26\t        }\r\n    27\t        List<String> stems = new ArrayList<String>();\r\n    28\t        for (Path p : files) {\r\n    29\t            byte[] raw = Files.readAllBytes(p);\r\n    30\t            String text = new String(raw, StandardCharsets.UTF_8);\r\n    31\t            String stem = SheetScan.stem(text);\r\n    32\t            if (stem.isEmpty()) {\r\n    33\t                System.exit(2);\r\n    34\t            }\r\n    35\t            stems.add(stem);\r\n    36\t            String key = Dig.mix_id(raw);\r\n    37\t            Path row = urn.resolve(key);\r\n    38\t            Path incPath = units.resolve(stem + \".inc\");\r\n    39\t            if (Files.exists(row)) {\r\n    40\t                byte[] stored = Files.readAllBytes(row);\r\n    41\t                System.out.println(\"served\");\r\n    42\t                int g = Gate.n_hit(stored);\r\n    43\t                if (g != 0) {\r\n    44\t                    System.exit(g);\r\n    45\t                }\r\n    46\t                Files.write(incPath, Store.inc_of(stored).getBytes(StandardCharsets.UTF_8));\r\n    47\t            } else {\r\n    48\t                String inc = SlotEmit.op_inner(text);\r\n    49\t                Files.write(incPath, inc.getBytes(StandardCharsets.UTF_8));\r\n    50\t                Files.write(row, Store.pack(Dig.mill_stamp(), inc));\r\n    51\t                System.out.println(\"fresh\");\r\n    52\t            }\r\n    53\t        }\r\n    54\t        StringBuilder reg = new StringBuilder();\r\n"]
[24.728988, "o", "    55\t        for (String stem : stems) {\r\n    56\t            reg.append(\"#include \\\"\").append(stem).append(\".inc\\\"\\n\");\r\n    57\t        }\r\n    58\t        reg.append(\"static int call_skim(const char *stem, const unsigned char *p, size_t n, FILE *out) {\\n\");\r\n    59\t        for (String stem : stems) {\r\n"]
