[24.734814, "o", "     9\t        fn.append(\"  size_t o = 0;\\n\");\r\n    10\t        for (SheetScan.Row r : rows) {\r\n    11\t            fn.append(\"  unsigned \").append(r.name).append(\" = 0;\\n\");\r\n    12\t        }\r\n    13\t        for (SheetScan.Row r : rows) {\r\n    14\t            if (r.nested) {\r\n    15\t                continue;\r\n    16\t            }\r\n    17\t            if (\"u8\".equals(r.kind)) {\r\n    18\t                fn.append(\"  if (o < n) { \").append(r.name).append(\" = p[o++]; }\\n\");\r\n    19\t            } else if (\"u16be\".equals(r.kind)) {\r\n    20\t                fn.append(\"  if (o + 1 < n) { \").append(r.name).append(\" = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\\n\");\r\n    21\t            }\r\n    22\t        }\r\n    23\t        fn.append(\"  fputc('{', out);\\n\");\r\n    24\t        for (int i = 0; i < rows.size(); i++) {\r\n    25\t            SheetScan.Row r = rows.get(i);\r\n    26\t            if (i > 0) {\r\n    27\t                fn.append(\"  fputc(',', out);\\n\");\r\n    28\t            }\r\n    29\t            if (r.nested) {\r\n    30\t                fn.append(\"  fprintf(out, \\\"\\\\\\\"\").append(r.name).append(\"\\\\\\\":\\\\\\\"\\\\\\\"\\\");\\n\");\r\n    31\t            } else {\r\n    32\t                fn.append(\"  fprintf(out, \\\"\\\\\\\"\").append(r.name).append(\"\\\\\\\":\\\\\\\"%u\\\\\\\"\\\", \").append(r.name).append(\");\\n\");\r\n    33\t            }\r\n    34\t        }\r\n    35\t        fn.append(\"  fputc('}', out);\\n\");\r\n    36\t        fn.append(\"}\\n\");\r\n    37\t        return fn.toString();\r\n    38\t    }\r\n    39\t}\r\n"]
