    17	
    18	    public static String inc_of(byte[] stored) {
    19	        String s = new String(stored, StandardCharsets.UTF_8);
    20	        int n = s.indexOf('\n');
    21	        if (n < 0) {
    22	            return s;
    23	        }
    24	        return s.substring(n + 1);
    25	    }
    26	}
