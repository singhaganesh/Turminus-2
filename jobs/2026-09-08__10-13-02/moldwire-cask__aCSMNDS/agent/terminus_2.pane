--- incpit/lake.inc ---
static void skim_lake(const unsigned char *p, size_t n, FILE *out) {
  size_t o = 0;
  unsigned depth = 0;
  unsigned temp = 0;
  unsigned wind = 0;
  if (o < n) { depth = p[o++]; }
  fputc('{', out);
  fprintf(out, "\"depth\":\"%u\"", depth);
  fputc(',', out);
  fprintf(out, "\"temp\":\"\"");
  fputc(',', out);
  fprintf(out, "\"wind\":\"\"");
  fputc('}', out);
}
--- incpit/pond.inc ---
static void skim_pond(const unsigned char *p, size_t n, FILE *out) {
  size_t o = 0;
  unsigned depth = 0;
  unsigned temp = 0;
  if (o < n) { depth = p[o++]; }
  fputc('{', out);
  fprintf(out, "\"depth\":\"%u\"", depth);
  fputc(',', out);
  fprintf(out, "\"temp\":\"\"");
  fputc('}', out);
}
--- incpit/reg.inc ---
#include "lake.inc"
#include "pond.inc"
static int call_skim(const char *stem, const unsigned char *p, size_t n, FILE *out) {
  if (strcmp(stem, "lake") == 0) { skim_lake(p, n, out); return 0; }
  if (strcmp(stem, "pond") == 0) { skim_pond(p, n, out); return 0; }
  return 2;
}
