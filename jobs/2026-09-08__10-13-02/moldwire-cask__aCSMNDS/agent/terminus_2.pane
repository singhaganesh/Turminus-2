     1	import java.util.ArrayList;
     2	import java.util.List;
     3	
     4	public class SheetScan {
     5	    public static final class Row {
     6	        public final String name;
     7	        public final String kind;
     8	        public final boolean nested;
     9	
    10	        Row(String name, String kind, boolean nested) {
    11	            this.name = name;
    12	            this.kind = kind;
    13	            this.nested = nested;
    14	        }
    15	    }
    16	
    17	    public static String stem(String sheet) {
    18	        for (String line : sheet.split("\n")) {
    19	            String t = line.trim();
    20	            if (t.startsWith("NAME ")) {
    21	                return t.substring(5).trim();
    22	            }
    23	        }
    24	        return "";
    25	    }
    26	
    27	    public static List<Row> rows(String sheet) {
    28	        List<Row> out = new ArrayList<Row>();
    29	        boolean nested = false;
    30	        for (String line : sheet.split("\n")) {
    31	            String t = line.trim();
    32	            if (t.startsWith("GROUP ")) {
    33	                nested = true;
    34	            } else if (t.equals("END")) {
    35	                nested = false;
    36	            } else if (t.startsWith("FIELD ")) {
    37	                String rest = t.substring(6).trim();
    38	                int sp = rest.indexOf(' ');
    39	                if (sp <= 0) {
    40	                    continue;
    41	                }
    42	                out.add(new Row(rest.substring(0, sp), rest.substring(sp).trim(), nested));
    43	            }
    44	        }
    45	        return out;
    46	    }
    47	}
--- slagbin/SlotEmit.java ---
     1	import java.util.List;
     2	
     3	public class SlotEmit {
     4	    public static String op_inner(String sheet) {
     5	        String stem = SheetScan.stem(sheet);
     6	        List<SheetScan.Row> rows = SheetScan.rows(sheet);
     7	        StringBuilder fn = new StringBuilder();
     8	        fn.append("static void skim_").append(stem).append("(const unsigned char *p, size_t n, FILE *out) {\n");
     9	        fn.append("  size_t o = 0;\n");
    10	        for (SheetScan.Row r : rows) {
    11	            fn.append("  unsigned ").append(r.name).append(" = 0;\n");
    12	        }
    13	        for (SheetScan.Row r : rows) {
    14	            if (r.nested) {
    15	                continue;
    16	            }
    17	            if ("u8".equals(r.kind)) {
    18	                fn.append("  if (o < n) { ").append(r.name).append(" = p[o++]; }\n");
    19	            } else if ("u16be".equals(r.kind)) {
    20	                fn.append("  if (o + 1 < n) { ").append(r.name).append(" = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }\n");
    21	            }
    22	        }
    23	        fn.append("  fputc('{', out);\n");
    24	        for (int i = 0; i < rows.size(); i++) {
    25	            SheetScan.Row r = rows.get(i);
    26	            if (i > 0) {
    27	                fn.append("  fputc(',', out);\n");
    28	            }
    29	            if (r.nested) {
    30	                fn.append("  fprintf(out, \"\\\"").append(r.name).append("\\\":\\\"\\\"\");\n");
    31	            } else {
    32	                fn.append("  fprintf(out, \"\\\"").append(r.name).append("\\\":\\\"%u\\\"\", ").append(r.name).append(");\n");
    33	            }
    34	        }
    35	        fn.append("  fputc('}', out);\n");
    36	        fn.append("}\n");
    37	        return fn.toString();
    38	    }
    39	}
