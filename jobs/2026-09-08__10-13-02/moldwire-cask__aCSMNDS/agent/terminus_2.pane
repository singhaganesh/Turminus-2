static void skim_pond(const unsigned char *p, size_t n, FILE *out) {
  size_t o = 0;
  size_t group_end = 0;
  unsigned depth = 0;
  unsigned temp = 0;
  if (o < n) { depth = p[o++]; }
  if (o + 1 < n) {
    size_t group_len = ((size_t)p[o] << 8) | p[o + 1];
    o += 2;
    group_end = group_len <= n - o ? o + group_len : n;
  } else { o = n; group_end = n; }
  if (o + 1 < group_end) { temp = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }
  o = group_end;
  fputc('{', out);
  fprintf(out, "\"depth\":\"%u\"", depth);
  fputc(',', out);
  fprintf(out, "\"temp\":\"%u\"", temp);
  fputc('}', out);
}
static void skim_lake(const unsigned char *p, size_t n, FILE *out) {
  size_t o = 0;
  size_t group_end = 0;
  unsigned depth = 0;
  unsigned temp = 0;
  unsigned wind = 0;
  if (o < n) { depth = p[o++]; }
  if (o + 1 < n) {
    size_t group_len = ((size_t)p[o] << 8) | p[o + 1];
    o += 2;
    group_end = group_len <= n - o ? o + group_len : n;
  } else { o = n; group_end = n; }
  if (o + 1 < group_end) { temp = ((unsigned)p[o] << 8) | p[o + 1]; o += 2; }
  if (o < group_end) { wind = p[o++]; }
  o = group_end;
  fputc('{', out);
  fprintf(out, "\"depth\":\"%u\"", depth);
  fputc(',', out);
  fprintf(out, "\"temp\":\"%u\"", temp);
  fputc(',', out);
  fprintf(out, "\"wind\":\"%u\"", wind);
  fputc('}', out);
}
