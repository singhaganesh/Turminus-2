[94.110551, "o", "pub fn soak(files: &[(i32, String)], destination: &str) -> Result<(), i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_dir_all(destination);\r\n\u001b[?2004l\r\u001b[?2004h> "]
