[31.181346, "o", "printf '%s\\n' '--- BUILD SCRIPT ---'; sed -n '1,240p' /app/wick.sh; printf '%s\\n' '--- MANIFESTS ---'; find /app -name Cargo.toml -type f -exec sh -c 'echo \"### $1\"; cat \"$1\"' _ {} \\;\r\n"]
[31.181404, "o", "\u001b[?2004l\r"]
[31.18144, "o", "--- BUILD SCRIPT ---\r\n"]
[31.189724, "o", "#!/bin/sh\r\nset -eu\r\n"]
[31.189944, "o", "export PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/bloturn /app/packbay\r\nrustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\r\n"]
[31.191094, "o", "--- MANIFESTS ---\r\n"]
[31.195483, "o", "\u001b[?2004hroot@f66976d76258:/app# "]
[32.209975, "i", "printf '%s\\n' '--- RUST SOURCES ---'; find /app -name '*.rs' -type f -exec sh -c 'echo \"### $1\"; sed -n \"1,300p\" \"$1\"' _ {} \\;\n"]
[32.210759, "o", "printf '%s\\n' '--- RUST SOURCES ---'; find /app -name '*.rs' -type f -exec sh -c 'echo \"### $1\"; sed -n \"1,300p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r--- RUST SOURCES ---\r\n"]
[32.21431, "o", "### /app/lidcue/skip.rs\r\n"]
[32.215491, "o", "pub fn skip(a: &mut [(i32, String)]) {\r\n    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n}\r\n\r\npub fn width(a: &[(i32, String)]) -> usize {\r\n    a.len()\r\n}\r\n\r\npub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    a.first().map(|x| x.0)\r\n}\r\n"]
[32.216907, "o", "### /app/corkpit/floor.rs\r\n"]
[32.218394, "o", "use std::fs;\r\n\r\npub fn floor(a: i32) -> bool {\r\n    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n        Err(_) => 0,\r\n    };\r\n    a >= t\r\n}\r\n"]
[32.220994, "o", "### /app/urncue/fold.rs\r\n"]
[32.222666, "o", "#[path = \"../hopcue/rim.rs\"]\r\nmod rim;\r\n#[path = \"../restpit/soak.rs\"]\r\nmod soak;\r\n#[path = \"../shardfold/read.rs\"]\r\nmod read;\r\n\r\nuse std::fs;\r\n\r\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n        .map_err(|_| 1)?\r\n        .trim()\r\n        .parse()\r\n        .map_err(|_| 1)?;\r\n    let listed = read::list(\"/app/daywell\");\r\n    let picked = rim::rim(wall, listed);\r\n    if picked.is_empty() {\r\n        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");"]
[32.222873, "o", "\r\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n        return Ok((Vec::new(), 0));\r\n    }\r\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    let mut packed = Vec::new();\r\n    let mut taken = 0;\r\n    for (d, p) in picked {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n        taken += read::nlines(&dest);\r\n        packed.push((d, dest));\r\n    }\r\n    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    Ok((packed, taken))\r\n}\r\n"]
[32.224389, "o", "### /app/shardfold/read.rs\r\n"]
[32.22593, "o", "use std::fs;\r\n\r\npub fn list(root: &str) -> Vec<(i32, String)> {\r\n    let mut v = Vec::new();\r\n    let rd = match fs::read_dir(root) {\r\n        Ok(x) => x,\r\n        Err(_) => return v,\r\n    };\r\n    for ent in rd.flatten() {\r\n"]
[32.226181, "o", "        let name = ent.file_name().to_string_lossy().into_owned();\r\n        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n            continue;\r\n        }\r\n        let mid = &name[1..name.len() - 4];\r\n        if let Ok(d) = mid.parse::<i32>() {\r\n            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n        }\r\n    }\r\n    v.sort_by_key(|x| x.0);\r\n    v\r\n}\r\n\r\npub fn nlines(path: &str) -> i32 {\r\n    match fs::read_to_string(path) {\r\n        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n        Err(_) => 0,\r\n    }\r\n}\r\n"]
[32.227534, "o", "### /app/restpit/soak.rs\r\n"]
[32.228662, "o", "use std::fs;\r\n\r\npub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n    let _ = fs::remove_dir_all(b);\r\n    fs::create_dir_all(b).map_err(|_| 1)?;\r\n    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n    xs.sort_by_key(|x| x.0);\r\n    if !xs.is_empty() {\r\n        xs.pop();\r\n    }\r\n    for (d, p) in xs {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    }\r\n    Ok(())\r\n}\r\n"]
[32.230175, "o", "### /app/millrib/gait.rs\r\n"]
[32.231195, "o", "use std::fs;\r\n\r\nfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\r\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n    let out = tpl\r\n        .replace(\"__P__\", p)\r\n        .replace(\"__M__\", &m.to_string())\r\n        .replace(\"__T__\", &t.to_string());\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)?;\r\n    Ok(())\r\n}\r\n\r\npub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {\r\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n    if emit(\"ledger\", a, a).is_err() {\r\n        return 1;\r\n    }\r\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[32.232392, "o", "### /app/hopcue/rim.rs\r\n"]
[32.23348, "o", "pub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n    b.into_iter().filter(|(d, _)| *d < a).collect()\r\n}\r\n"]
[32.234757, "o", "### /app/wickmill/boot.rs\r\n"]
[32.23702, "o", "#[path = \"../urncue/fold.rs\"]\r\nmod fold;\r\n#[path = \"../millrib/gait.rs\"]\r\nmod gait;\r\n#[path = \"../lidcue/skip.rs\"]\r\nmod skip;\r\n#[path = \"../corkpit/floor.rs\"]\r\nmod floor;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"clasp\" {\r\n        eprintln!(\"usage: dewkiln clasp\");\r\n        std::process::exit(2);\r\n    }\r\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    let code = match fold::fold() {\r\n        Ok((packed, taken)) => {\r\n            let mut dump = packed.clone();\r\n            skip::skip(&mut dump);\r\n            let _ = floor::floor(taken);\r\n            gait::gait(taken, &packed)\r\n        }\r\n        Err(c) => c,\r\n"]
[32.237228, "o", "    };\r\n    std::process::exit(code);\r\n}\r\n"]
