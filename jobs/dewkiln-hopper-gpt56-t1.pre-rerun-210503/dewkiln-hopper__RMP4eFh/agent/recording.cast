[94.344134, "i", "cat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\nfn clear_outputs() {\n    let _ = fs::remove_file(\"/app/bloturn/ledger.json\");\n    let _ = fs::remove_file(\"/app/bloturn/check.json\");\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n    let _ = fs::remove_dir_all(\"/app/packbay/latest\");\n}\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    clear_outputs();\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list(\"/app/daywell\"));\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    // Count from the live source files, not from ledger or a packed copy.\n    let mut taken = 0i32;\n    let mut populated = false;\n    for (_, source) in &picked {\n        let count = read::nlines(source)?;\n        taken = taken.checked_add(count).ok_or(1)?;\n        populated |= count > 0;\n    }\n    if !populated {\n        return Err(1);\n    }\n\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\n    let mut staged = Vec::new();\n    for (day, source) in &picked {\n        let destination = format!(\"/app/packbay/stage/d{:08}.tbl\", day);\n        fs::copy(source, &destination).map_err(|_| 1)?;\n        staged.push((*day, destination));\n    }\n    soak::soak(&staged, \"/app/packbay/latest\")?;\n\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\n        \"/app/bloturn/ledger.json\",\n        format!(\"{{\\\"taken\\\":{}}}\", taken),\n    )\n    .map_err(|_| 1)?;\n    // Return original paths so the check must inspect daywell itself.\n    Ok((picked, taken))\n}\nEOF\ncat > /app/millrib/gait.rs <<'EOF'\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\nfn json_string(value: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in value.chars() {\n        match c {\n            '\\\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c.is_control() => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\\\"');\n    out\n}\n\npub fn gait(files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    let _ = fs::remove_file(\"/app/bloturn/check.json\");\n\n    // Select the most recent eligible file that is actually populated. Each\n    // count is obtained by opening the live daywell path.\n    let mut probe: Option<(i32, &str, i32)> = None;\n    for (day, source) in files {\n        let matched = match read::nlines(source) {\n            Ok(n) => n,\n            Err(_) => return 1,\n        };\n        if matched > 0 && probe.map_or(true, |(old, _, _)| *day > old) {\n            probe = Some((*day, source.as_str(), matched));\n        }\n    }\n    let (day, source, matched) = match probe {\n        Some(value) => value,\n        None => return 1,\n    };\n    let restored = format!(\"/app/packbay/latest/d{:08}.tbl\", day);\n    let taken = match read::nlines(&restored) {\n        Ok(n) => n,\n        Err(_) => return 1,\n    };\n    if matched != taken {\n        return 1;\n    }\n\n    let body = format!(\n        \"{{\\\"probe\\\":{},\\\"matched\\\":{},\\\"taken\\\":{}}}\",\n        json_string(source), matched, taken\n    );\n    if fs::create_dir_all(\"/app/bloturn\").is_err()\n        || fs::write(\"/app/bloturn/check.json\", body).is_err()\n        || fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err()\n    {\n        let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n        return 1;\n    }\n    0\n}\nEOF\n"]
[94.344519, "o", "cat > /app/urncue/fold.rs <<'EOF'\r\n\u001b[?2004l\r"]
[94.344561, "o", "\u001b[?2004h> "]
[94.344672, "o", "#[path = \"../hopcue/rim.rs\"]\r\n"]
[94.344694, "o", "\u001b[?2004l\r"]
[94.345591, "o", "\u001b[?2004h> mod rim;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../restpit/soak.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod soak;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../shardfold/read.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod read;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn clear_outputs() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.345865, "o", "    let _ = fs::remove_file(\"/app/bloturn/ledger.json\");\r\n\u001b[?2004l\r"]
[94.346549, "o", "\u001b[?2004h>     let _ = fs::remove_file(\"/app/bloturn/check.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.346888, "o", "    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.346943, "o", "> "]
[94.347122, "o", "    let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n\u001b[?2004l\r"]
[94.347171, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[94.347231, "o", "\u001b[?2004h> \r\n"]
[94.347835, "o", "\u001b[?2004l\r"]
[94.347965, "o", "\u001b[?2004h> pub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     clear_outputs();\r\n\u001b[?2004l\r\u001b[?2004h>     let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n\u001b[?2004l\r\u001b[?2004h>         .map_err(|_| 1)?\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.348087, "o", ">         .trim()\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.348199, "o", ">         .parse()\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.348244, "o", "> "]
[94.34835, "o", "        .map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[94.348372, "o", "\u001b[?2004h> "]
[94.348559, "o", "    let picked = rim::rim(wall, read::list(\"/app/daywell\"));\r\n\u001b[?2004l\r"]
[94.348642, "o", "\u001b[?2004h> "]
[94.34871, "o", "    if picked.is_empty() {\r\n\u001b[?2004l\r"]
[94.348772, "o", "\u001b[?2004h> "]
[94.348873, "o", "        return Err(1);\r\n\u001b[?2004l\r"]
[94.348966, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[94.349036, "o", "\u001b[?2004h> "]
[94.349233, "o", "    // Count from the live source files, not from ledger or a packed copy.\r\n\u001b[?2004l\r"]
[94.34931, "o", "\u001b[?2004h"]
[94.349402, "o", "> "]
[94.349475, "o", "    let mut taken = 0i32;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.34956, "o", "    let mut populated = false;\r\n\u001b[?2004l\r"]
[94.349632, "o", "\u001b[?2004h> "]
[94.34976, "o", "    for (_, source) in &picked {\r\n\u001b[?2004l\r"]
[94.349791, "o", "\u001b[?2004h> "]
[94.349926, "o", "        let count = read::nlines(source)?;\r\n\u001b[?2004l\r"]
[94.349992, "o", "\u001b[?2004h> "]
[94.350123, "o", "        taken = taken.checked_add(count).ok_or(1)?;\r\n\u001b[?2004l\r"]
[94.350243, "o", "\u001b[?2004h> "]
[94.350279, "o", "        populated |= count > 0;\r\n\u001b[?2004l\r"]
[94.350707, "o", "\u001b[?2004h> "]
[94.354967, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     if !populated {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut staged = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for (day, source) in &picked {\r\n\u001b[?2004l\r\u001b[?2004h>         let destination = format!(\"/app/packbay/stage/d{:08}.tbl\", day);\r\n\u001b[?2004l\r\u001b[?2004h>         fs::copy(source, &destination).map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>         staged.push((*day, destination));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     soak::soak(&staged, \"/app/packbay/latest\")?;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     fs::write(\r\n\u001b[?2004l\r\u001b[?2004h>         \"/app/bloturn/ledger.json\",\r\n\u001b[?2004l\r\u001b[?2004h>         format!(\"{{\\\"taken\\\":{}}}\", taken),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     .map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     // Return original paths so the check must inspect daywell itself.\r\n\u001b[?2004l\r\u001b[?2004h>     Ok((picked, taken))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[94.356358, "o", "\u001b[?2004hroot@f66976d76258:/app# "]
[94.356522, "o", "cat > /app/millrib/gait.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.356666, "o", "#[path = \"../shardfold/read.rs\"]\r\n\u001b[?2004l\r"]
[94.356799, "o", "\u001b[?2004h> mod read;\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.356923, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.356964, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.356985, "o", "\r\n\u001b[?2004l\r"]
[94.357004, "o", "\u001b[?2004h"]
[94.35702, "o", "> "]
[94.357195, "o", "fn json_string(value: &str) -> String {\r\n\u001b[?2004l\r"]
[94.357275, "o", "\u001b[?2004h> "]
[94.357388, "o", "    let mut out = String::from(\"\\\"\");\r\n\u001b[?2004l\r"]
[94.35751, "o", "\u001b[?2004h> "]
[94.357599, "o", "    for c in value.chars() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.357676, "o", "        match c {\r\n\u001b[?2004l\r"]
[94.357965, "o", "\u001b[?2004h>             '\\\"' => out.push_str(\"\\\\\\\"\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.358127, "o", "            '\\\\' => out.push_str(\"\\\\\\\\\"),\r\n\u001b[?2004l\r"]
[94.358156, "o", "\u001b[?2004h> "]
[94.358314, "o", "            '\\n' => out.push_str(\"\\\\n\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.358332, "o", "> "]
[94.358486, "o", "            '\\r' => out.push_str(\"\\\\r\"),\r\n\u001b[?2004l\r"]
[94.358528, "o", "\u001b[?2004h> "]
[94.358632, "o", "            '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r"]
[94.358661, "o", "\u001b[?2004h> "]
[94.358927, "o", "            c if c.is_control() => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n\u001b[?2004l\r"]
[94.358954, "o", "\u001b[?2004h> "]
[94.359086, "o", "            c => out.push(c),\r\n\u001b[?2004l\r"]
[94.359235, "o", "\u001b[?2004h> "]
[94.359266, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.359426, "o", "    out.push('\\\"');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.359532, "o", "    out\r\n\u001b[?2004l\r"]
[94.359901, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[94.35999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn gait(files: &[(i32, String)]) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.36014, "o", "    let _ = fs::remove_file(\"/app/bloturn/check.json\");\r\n\u001b[?2004l\r"]
[94.360222, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[94.360291, "o", "\u001b[?2004h> "]
[94.360445, "o", "    // Select the most recent eligible file that is actually populated. Each\r\n\u001b[?2004l\r"]
[94.36053, "o", "\u001b[?2004h> "]
[94.360726, "o", "    // count is obtained by opening the live daywell path.\r\n\u001b[?2004l\r"]
[94.360865, "o", "\u001b[?2004h> "]
[94.361044, "o", "    let mut probe: Option<(i32, &str, i32)> = None;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.361132, "o", "    for (day, source) in files {\r\n\u001b[?2004l\r"]
[94.361166, "o", "\u001b[?2004h> "]
[94.361355, "o", "        let matched = match read::nlines(source) {\r\n\u001b[?2004l\r"]
[94.361387, "o", "\u001b[?2004h> "]
[94.36149, "o", "            Ok(n) => n,\r\n\u001b[?2004l\r"]
[94.361571, "o", "\u001b[?2004h> "]
[94.361656, "o", "            Err(_) => return 1,\r\n\u001b[?2004l\r"]
[94.362095, "o", "\u001b[?2004h> "]
[94.362213, "o", "        };\r\n\u001b[?2004l\r\u001b[?2004h>         if matched > 0 && probe.map_or(true, |(old, _, _)| *day > old) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.363052, "o", "            probe = Some((*day, source.as_str(), matched));\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let (day, source, matched) = match probe {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(value) => value,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.363176, "o", "        None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };"]
[94.363208, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.363348, "o", "> "]
[94.36346, "o", "    let restored = format!(\"/app/packbay/latest/d{:08}.tbl\", day);\r\n\u001b[?2004l\r"]
[94.363494, "o", "\u001b[?2004h> "]
[94.363632, "o", "    let taken = match read::nlines(&restored) {\r\n\u001b[?2004l\r"]
[94.363661, "o", "\u001b[?2004h> "]
[94.363737, "o", "        Ok(n) => n,\r\n\u001b[?2004l\r"]
[94.363756, "o", "\u001b[?2004h"]
[94.36378, "o", "> "]
[94.363923, "o", "        Err(_) => return 1,\r\n\u001b[?2004l\r"]
[94.365941, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     if matched != taken {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let body = format!(\r\n\u001b[?2004l\r\u001b[?2004h>         \"{{\\\"probe\\\":{},\\\"matched\\\":{},\\\"taken\\\":{}}}\",\r\n\u001b[?2004l\r\u001b[?2004h>         json_string(source), matched, taken\r\n\u001b[?2004l\r\u001b[?2004h>     );\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::create_dir_all(\"/app/bloturn\").is_err()\r\n\u001b[?2004l\r\u001b[?2004h>         || fs::write(\"/app/bloturn/check.json\", body).is_err()\r\n\u001b[?2004l\r\u001b[?2004h>         || fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err()\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>         let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[94.369938, "o", "\u001b[?2004hroot@f66976d76258:/app# "]
[94.572116, "i", "cat > /app/wickmill/boot.rs <<'EOF'\n#[path = \"../urncue/fold.rs\"]\nmod fold;\n#[path = \"../millrib/gait.rs\"]\nmod gait;\n#[path = \"../lidcue/skip.rs\"]\nmod skip;\n#[path = \"../corkpit/floor.rs\"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().as_deref() != Some(\"clasp\") || args.next().is_some() {\n        eprintln!(\"usage: dewkiln clasp\");\n        std::process::exit(2);\n    }\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\n    let code = match fold::fold() {\n        Ok((packed, taken)) => {\n            let mut ordered = packed.clone();\n            skip::skip(&mut ordered);\n            if !floor::floor(taken) {\n                1\n            } else {\n                gait::gait(&packed)\n            }\n        }\n        Err(code) => code,\n    };\n    if code != 0 {\n        let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\n    }\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\nfile /app/bin/dewkiln\n/app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; echo '--- JSON ---'; cat /app/bloturn/ledger.json; echo; cat /app/bloturn/check.json; echo; printf 'GUARD='; cat /app/bloturn/GUARD; echo; echo '--- COUNTS ---'; for f in /app/daywell/*.tbl /app/packbay/latest/*.tbl; do printf '%s %s\\n' \"$f\" \"$(grep -cve '^[[:space:]]*$' \"$f\")\"; done; exit $rc\n"]
[94.575765, "o", "cat > /app/wickmill/boot.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../urncue/fold.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod fold;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../millrib/gait.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod gait;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../lidcue/skip.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod skip;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"../corkpit/floor.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod floor;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn main() {\r\n\u001b[?2004l\r\u001b[?2004h>     let mut args = std::env::args();\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = args.next();\r\n\u001b[?2004l\r\u001b[?2004h>     if args.next().as_deref() != Some(\"clasp\") || args.next().is_some() {\r\n\u001b[?2004l\r\u001b[?2004h>         eprintln!(\"usage: dewkiln clasp\");\r\n\u001b[?2004l\r\u001b[?2004h>         std::process::exit(2);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h>     let code = match fold::fold() {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok((packed, taken)) => {\r\n\u001b[?2004l\r\u001b[?2004h>             let mut ordered = packed.clone();\r\n\u001b[?2004l\r\u001b[?2004h>             skip::skip(&mut ordered);\r\n\u001b[?2004l\r\u001b[?2004h>             if !floor::floor(taken) {\r\n\u001b[?2004l\r\u001b[?2004h>                 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.576915, "o", "            } else {\r\n\u001b[?2004l\r"]
[94.577011, "o", "\u001b[?2004h> "]
[94.577089, "o", "                gait::gait(&packed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.577161, "o", "> "]
[94.577226, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.577289, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.577354, "o", "        Err(code) => code,\r\n\u001b[?2004l\r"]
[94.577416, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.577466, "o", ">     if code != 0 {\r\n"]
[94.577513, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[94.577635, "o", "        let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r"]
[94.577705, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.577844, "o", "    std::process::exit(code);\r\n\u001b[?2004l\r"]
[94.577924, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
