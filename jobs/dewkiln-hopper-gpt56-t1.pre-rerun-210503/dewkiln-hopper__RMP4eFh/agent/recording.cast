[49.62206, "o", "\u001b[?2004hroot@f66976d76258:/app# "]
[94.093555, "i", "cat > /app/shardfold/read.rs <<'EOF'\nuse std::fs;\n\npub fn list(root: &str) -> Vec<(i32, String)> {\n    let mut v = Vec::new();\n    let rd = match fs::read_dir(root) {\n        Ok(x) => x,\n        Err(_) => return v,\n    };\n    for ent in rd.flatten() {\n        let path = ent.path();\n        if !path.is_file() {\n            continue;\n        }\n        let name = ent.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let mid = &name[1..9];\n        if mid.bytes().all(|c| c.is_ascii_digit()) {\n            if let Ok(d) = mid.parse::<i32>() {\n                v.push((d, path.to_string_lossy().into_owned()));\n            }\n        }\n    }\n    v.sort_by_key(|x| x.0);\n    v\n}\n\npub fn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\nEOF\ncat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], destination: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(destination);\n    fs::create_dir_all(destination).map_err(|_| 1)?;\n    for (day, source) in files {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(source, format!(\"{}/{}\", destination, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\n"]
