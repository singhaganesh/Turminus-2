Sending keys: ['cat > /app/urncue/fold.rs <<\'EOF\'\n#[path = "../hopcue/rim.rs"]\nmod rim;\n#[path = "../restpit/soak.rs"]\nmod soak;\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\nfn clear_outputs() {\n    let _ = fs::remove_file("/app/bloturn/ledger.json");\n    let _ = fs::remove_file("/app/bloturn/check.json");\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    let _ = fs::remove_dir_all("/app/packbay/stage");\n    let _ = fs::remove_dir_all("/app/packbay/latest");\n}\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    clear_outputs();\n    let wall: i32 = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list("/app/daywell"));\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    // Count from the live source files, not from ledger or a packed copy.\n    let mut taken = 0i32;\n    let mut populated = false;\n    for (_, source) in &picked {\n        let count = read::nlines(source)?;\n        taken = taken.checked_add(count).ok_or(1)?;\n        populated |= count > 0;\n    }\n    if !populated {\n        return Err(1);\n    }\n\n    fs::create_dir_all("/app/packbay/stage").map_err(|_| 1)?;\n    let mut staged = Vec::new();\n    for (day, source) in &picked {\n        let destination = format!("/app/packbay/stage/d{:08}.tbl", day);\n        fs::copy(source, &destination).map_err(|_| 1)?;\n        staged.push((*day, destination));\n    }\n    soak::soak(&staged, "/app/packbay/latest")?;\n\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write(\n        "/app/bloturn/ledger.json",\n        format!("{{\\"taken\\":{}}}", taken),\n    )\n    .map_err(|_| 1)?;\n    // Return original paths so the check must inspect daywell itself.\n    Ok((picked, taken))\n}\nEOF\ncat > /app/millrib/gait.rs <<\'EOF\'\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\nfn json_string(value: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in value.chars() {\n        match c {\n            \'\\"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if c.is_control() => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'\\"\');\n    out\n}\n\npub fn gait(files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    let _ = fs::remove_file("/app/bloturn/check.json");\n\n    // Select the most recent eligible file that is actually populated. Each\n    // count is obtained by opening the live daywell path.\n    let mut probe: Option<(i32, &str, i32)> = None;\n    for (day, source) in files {\n        let matched = match read::nlines(source) {\n            Ok(n) => n,\n            Err(_) => return 1,\n        };\n        if matched > 0 && probe.map_or(true, |(old, _, _)| *day > old) {\n            probe = Some((*day, source.as_str(), matched));\n        }\n    }\n    let (day, source, matched) = match probe {\n        Some(value) => value,\n        None => return 1,\n    };\n    let restored = format!("/app/packbay/latest/d{:08}.tbl", day);\n    let taken = match read::nlines(&restored) {\n        Ok(n) => n,\n        Err(_) => return 1,\n    };\n    if matched != taken {\n        return 1;\n    }\n\n    let body = format!(\n        "{{\\"probe\\":{},\\"matched\\":{},\\"taken\\":{}}}",\n        json_string(source), matched, taken\n    );\n    if fs::create_dir_all("/app/bloturn").is_err()\n        || fs::write("/app/bloturn/check.json", body).is_err()\n        || fs::write("/app/bloturn/GUARD", "ok").is_err()\n    {\n        let _ = fs::remove_file("/app/bloturn/GUARD");\n        return 1;\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
