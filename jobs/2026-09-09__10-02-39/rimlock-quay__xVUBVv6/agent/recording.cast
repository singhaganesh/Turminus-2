[75.369525, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.369556, "o", "> "]
[75.369763, "o", "#include <errno.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.370039, "o", "#include <stdio.h>\r\n\u001b[?2004l\r"]
[75.370226, "o", "\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
