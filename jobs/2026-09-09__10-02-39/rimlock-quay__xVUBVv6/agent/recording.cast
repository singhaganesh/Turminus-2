[75.373133, "o", "> "]
[75.373735, "o", "  FILE *f;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.374007, "o", "  char line[160];\r\n\u001b[?2004l\r\u001b[?2004h>   int open = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.374572, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>   reset_g();\r\n\u001b[?2004l\r\u001b[?2004h>   f = fopen(path, \"r\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.374715, "o", "  if (!f) return 2;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.374758, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.37511, "o", "  while (fgets(line, sizeof line, f)) {\r\n\u001b[?2004l\r"]
[75.375297, "o", "\u001b[?2004h>     char *nl = strchr(line, '\\n');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.375725, "o", "    if (!nl && !feof(f)) return bad(f); /* overlong record */\r\n\u001b[?2004l\r"]
[75.375938, "o", "\u001b[?2004h> "]
[75.375981, "o", "    if (nl) *nl = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.376439, "o", ">     if (line[0] == 0) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.376626, "o", "    if (strncmp(line, \"THREAD \", 7) == 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.376867, "o", ">       char *end;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.377031, "o", "      unsigned long tid;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.377186, "o", "> "]
[75.377344, "o", "      if (open || GN >= MAXL) return bad(f);\r\n\u001b[?2004l\r"]
[75.377419, "o", "\u001b[?2004h> "]
[75.37765, "o", "      errno = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.377825, "o", "      tid = strtoul(line + 7, &end, 10);\r\n\u001b[?2004l\r"]
[75.377955, "o", "\u001b[?2004h> "]
[75.378336, "o", "      if (errno || end == line + 7 || *end || tid > UINT32_MAX) return bad(f);\r\n\u001b[?2004l\r"]
[75.37851, "o", "\u001b[?2004h"]
[75.378706, "o", "> "]
[75.378864, "o", "      G[GN].tid = (uint32_t)tid;\r\n\u001b[?2004l\r\u001b[?2004h>       open = 1;\r\n\u001b[?2004l\r"]
[75.379159, "o", "\u001b[?2004h> "]
[75.37943, "o", "      GN++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.379668, "o", "    } else if (!open) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.379916, "o", "      return bad(f);\r\n\u001b[?2004l\r"]
[75.380015, "o", "\u001b[?2004h> "]
[75.380134, "o", "    } else if (strncmp(line, \"OWN \", 4) == 0) {\r\n\u001b[?2004l\r"]
[75.380294, "o", "\u001b[?2004h> "]
[75.380595, "o", "      if (G[GN - 1].hex[0] || !line[4] || strlen(line + 4) >= sizeof G[0].hex)\r\n\u001b[?2004l\r"]
[75.380729, "o", "\u001b[?2004h> "]
[75.380803, "o", "        return bad(f);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.38098, "o", "      strcpy(G[GN - 1].hex, line + 4);\r\n\u001b[?2004l\r"]
[75.381121, "o", "\u001b[?2004h> "]
[75.381266, "o", "    } else if (strncmp(line, \"WAIT \", 5) == 0) {\r\n\u001b[?2004l\r"]
[75.381364, "o", "\u001b[?2004h> "]
[75.381666, "o", "      if (G[GN - 1].has_wait || !line[5] || strlen(line + 5) >= sizeof G[0].wait_hex)\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.381809, "o", ">         return bad(f);\r\n\u001b[?2004l\r"]
[75.381914, "o", "\u001b[?2004h> "]
[75.382048, "o", "      strcpy(G[GN - 1].wait_hex, line + 5);\r\n\u001b[?2004l\r"]
[75.382187, "o", "\u001b[?2004h> "]
[75.382232, "o", "      G[GN - 1].has_wait = 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.382372, "o", "> "]
[75.382495, "o", "    } else if (strcmp(line, \".\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.382639, "o", "      if (!G[GN - 1].hex[0]) return bad(f);\r\n\u001b[?2004l\r"]
[75.382738, "o", "\u001b[?2004h> "]
[75.382862, "o", "      open = 0;\r\n\u001b[?2004l\r"]
[75.382899, "o", "\u001b[?2004h>     } else {\r\n\u001b[?2004l\r"]
[75.382921, "o", "\u001b[?2004h> "]
[75.383064, "o", "      return bad(f);\r\n\u001b[?2004l\r"]
[75.383108, "o", "\u001b[?2004h> "]
[75.383322, "o", "    }\r\n\u001b[?2004l\r"]
[75.383378, "o", "\u001b[?2004h> "]
[75.383439, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.383521, "o", "  if (ferror(f) || open || GN == 0) return bad(f);\r\n\u001b[?2004l\r"]
[75.383585, "o", "\u001b[?2004h> "]
[75.38387, "o", "  fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h>   return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[75.384042, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
