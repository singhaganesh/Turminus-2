[75.387312, "o", "\u001b[?2004hroot@15870fd3b33e:/app# cat > /app/inkurn/book.c <<'EOF'\r\n\u001b[?2004l\r"]
[75.387472, "o", "\u001b[?2004h> "]
[75.387581, "o", "#include \"book.h\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.387733, "o", "#include \"../knothub/store.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[75.387776, "o", "\u001b[?2004h> "]
[75.387878, "o", "#include <stdio.h>\r\n\u001b[?2004l\r"]
[75.387907, "o", "\u001b[?2004h> "]
[75.388016, "o", "#include <string.h>\r\n\u001b[?2004l\r"]
[75.388047, "o", "\u001b[?2004h> \r\n"]
[75.388064, "o", "\u001b[?2004l\r"]
[75.388077, "o", "\u001b[?2004h> "]
[75.388211, "o", "int book_load(const char *path) {\r\n\u001b[?2004l\r"]
[75.388235, "o", "\u001b[?2004h> "]
[75.38836, "o", "  FILE *f;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.388519, "o", "  char line[160], hx[40], extra;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.388657, "o", ">   unsigned id;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.388799, "o", "  for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r"]
[75.388912, "o", "\u001b[?2004h> "]
[75.389016, "o", "    G[i].tag = 0;\r\n\u001b[?2004l\r"]
[75.389107, "o", "\u001b[?2004h> "]
[75.389235, "o", "    G[i].wait_tag = 0;\r\n\u001b[?2004l\r"]
[75.389333, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.389466, "o", "  f = fopen(path, \"r\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.389612, "o", ">   if (!f) return 2;\r\n\u001b[?2004l\r"]
[75.389681, "o", "\u001b[?2004h> "]
[75.389859, "o", "  while (fgets(line, sizeof line, f)) {\r\n\u001b[?2004l\r"]
[75.389899, "o", "\u001b[?2004h> "]
[75.390276, "o", "    if (sscanf(line, \"%39s %u %c\", hx, &id, &extra) != 2) continue;\r\n\u001b[?2004l\r"]
[75.390611, "o", "\u001b[?2004h> "]
[75.390864, "o", "    if (strcmp(hx, \"hex\") == 0) continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.390913, "o", "    for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r"]
[75.391067, "o", "\u001b[?2004h> "]
[75.391255, "o", "      if (strcmp(G[i].hex, hx) == 0) G[i].tag = id;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.391596, "o", "      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) G[i].wait_tag = id;\r\n\u001b[?2004l\r"]
[75.391704, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[75.391798, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.391885, "o", "> "]
[75.391999, "o", "  if (ferror(f)) { fclose(f); return 2; }\r\n\u001b[?2004l\r"]
[75.392092, "o", "\u001b[?2004h> "]
[75.392172, "o", "  fclose(f);\r\n\u001b[?2004l\r"]
[75.39226, "o", "\u001b[?2004h> "]
[75.392334, "o", "  for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r"]
[75.392375, "o", "\u001b[?2004h> "]
[75.392675, "o", "    if (G[i].tag == 0 || (G[i].has_wait && G[i].wait_tag == 0)) return 2;\r\n\u001b[?2004l\r"]
[75.392817, "o", "\u001b[?2004h> "]
[75.392956, "o", "  return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[75.395074, "o", "\u001b[?2004hroot@15870fd3b33e:/app# \r\n\u001b[?2004l\r"]
[75.395309, "o", "\u001b[?2004hroot@15870fd3b33e:/app# "]
[75.398613, "o", "cat > /app/knothub/pick.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"pick.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"store.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static int before(int a, int b) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (b < 0) return 1;\r\n\u001b[?2004l\r\u001b[?2004h>   if (G[a].tag != G[b].tag) return G[a].tag < G[b].tag;\r\n\u001b[?2004l\r\u001b[?2004h>   if (G[a].tid != G[b].tid) return G[a].tid < G[b].tid;\r\n\u001b[?2004l\r\u001b[?2004h>   return a < b;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int op_pick(void) {\r\n\u001b[?2004l\r\u001b[?2004h>   PN = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   while (PN < GN) {\r\n\u001b[?2004l\r\u001b[?2004h>     int best = -1;\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r\u001b[?2004h>       if (!G[i].done && G[i].indeg == 0 && before(i, best)) best = i;\r\n\u001b[?2004l\r\u001b[?2004h>     /* A deadlock has no zero-indegree node. Break it reproducibly. */\r\n\u001b[?2004l\r\u001b[?2004h>     if (best < 0)\r\n\u001b[?2004l\r\u001b[?2004h>       for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r\u001b[?2004h>         if (!G[i].done && before(i, best)) best = i;\r\n\u001b[?2004l\r\u001b[?2004h>     if (best < 0) return 2;\r\n\u001b[?2004l\r\u001b[?2004h>     PLAN[PN++] = best;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.398829, "o", ">     G[best].done = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.398956, "o", "    for (int k = 0; k < nsucc[best]; k++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.399082, "o", "      int j = succ[best][k];\r\n\u001b[?2004l\r"]
[75.399193, "o", "\u001b[?2004h> "]
[75.399319, "o", "      if (G[j].indeg > 0) G[j].indeg--;\r\n\u001b[?2004l\r"]
[75.399439, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[75.399583, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.399688, "o", "  return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.399793, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[75.4021, "o", "\u001b[?2004hroot@15870fd3b33e:/app# \r\n\u001b[?2004l\r"]
[75.402164, "o", "\u001b[?2004hroot@15870fd3b33e:/app# "]
[75.40238, "o", "cat > /app/hullcue/rank.c <<'EOF'\r\n\u001b[?2004l\r"]
[75.402481, "o", "\u001b[?2004h> #include \"rank.h\"\r\n\u001b[?2004l\r"]
[75.402517, "o", "\u001b[?2004h> "]
[75.402695, "o", "#include \"../knothub/store.h\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.402726, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[75.402751, "o", "> "]
[75.40305, "o", "/* Compute wait depth without changing the deterministic topological plan. */\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.403101, "o", "> "]
[75.403329, "o", "void rk_wrap(void) {\r\n\u001b[?2004l\r"]
[75.403407, "o", "\u001b[?2004h>   for (int i = 0; i < GN; i++) G[i].depth = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.403583, "o", "> "]
[75.403703, "o", "  for (int p = 0; p < PN; p++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.403811, "o", ">     int i = PLAN[p];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.403999, "o", "    for (int k = 0; k < nsucc[i]; k++) {\r\n\u001b[?2004l\r"]
[75.404136, "o", "\u001b[?2004h> "]
[75.404197, "o", "      int j = succ[i][k];\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.40434, "o", "> "]
[75.404502, "o", "      if (G[j].depth < G[i].depth + 1) G[j].depth = G[i].depth + 1;\r\n\u001b[?2004l\r"]
[75.404599, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[75.404703, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[75.404809, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.40495, "o", "EOF\r\n\u001b[?2004l\r"]
[75.40689, "o", "\u001b[?2004hroot@15870fd3b33e:/app# "]
[75.685061, "i", "cat > /app/emiturn/bind.c <<'EOF'\n#define _POSIX_C_SOURCE 200809L\n#include \"bind.h\"\n#include \"../knothub/store.h\"\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic void parent(const char *path, char *dir, size_t cap) {\n  const char *slash = strrchr(path, '/');\n  if (!slash) snprintf(dir, cap, \".\");\n  else if (slash == path) snprintf(dir, cap, \"/\");\n  else {\n    size_t n = (size_t)(slash - path);\n    if (n >= cap) n = cap - 1;\n    memcpy(dir, path, n); dir[n] = 0;\n  }\n}\n\nint n_bind(const char *a) {\n  char dir[256], okp[320], tmp[384];\n  FILE *f, *ok;\n  int fd;\n\n  parent(a, dir, sizeof dir);\n  snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\n  unlink(okp);\n  unlink(a);\n  snprintf(tmp, sizeof tmp, \"%s/.rimlock-plan-XXXXXX\", dir);\n  fd = mkstemp(tmp);\n  if (fd < 0) return 2;\n  f = fdopen(fd, \"w\");\n  if (!f) { close(fd); unlink(tmp); return 2; }\n  for (int i = 0; i < PN; i++)\n    if (fprintf(f, \"%u\\n\", G[PLAN[i]].tag) < 0) { fclose(f); unlink(tmp); return 2; }\n  if (fflush(f) || fsync(fd) || fclose(f) || rename(tmp, a)) {\n    unlink(tmp); unlink(a); return 2;\n  }\n  ok = fopen(okp, \"w\");\n  if (!ok) { unlink(a); return 2; }\n  if (fputs(\"ok\\n\", ok) == EOF || fclose(ok)) { unlink(okp); unlink(a); return 2; }\n  return 0;\n}\nEOF\n\ncat > /app/inkfold/fold.c <<'EOF'\n#define _POSIX_C_SOURCE 200809L\n#include \"fold.h\"\n#include \"../knothub/store.h\"\n#include \"../inkurn/book.h\"\n#include \"../knothub/graph.h\"\n#include \"../knothub/pick.h\"\n#include \"../hullcue/rank.h\"\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n\nint cfg_fold(const char *a) {\n  char dir[256], tmp[384];\n  const char *slash;\n  FILE *f;\n  int fd;\n\n  if (!g_closer || book_load(\"/app/inkurn/book.tsv\") != 0) return 2;\n  graph_build();\n  if (op_pick() != 0) return 2;\n  rk_wrap();\n\n  slash = strrchr(a, '/');\n  if (!slash) snprintf(dir, sizeof dir, \".\");\n  else if (slash == a) snprintf(dir, sizeof dir, \"/\");\n  else {\n    size_t n = (size_t)(slash - a);\n    if (n >= sizeof dir) return 2;\n    memcpy(dir, a, n); dir[n] = 0;\n  }\n  snprintf(tmp, sizeof tmp, \"%s/.rimlock-scroll-XXXXXX\", dir);\n  fd = mkstemp(tmp);\n  if (fd < 0) return 2;\n  f = fdopen(fd, \"w\");\n  if (!f) { close(fd); unlink(tmp); return 2; }\n  for (int i = 0; i < PN; i++) {\n    int k = PLAN[i];\n    if (fprintf(f, \"%u %u\\n\", G[k].tid, G[k].tag) < 0) {\n      fclose(f); unlink(tmp); return 2;\n    }\n  }\n  if (fflush(f) || fsync(fd) || fclose(f) || rename(tmp, a)) {\n    unlink(tmp); return 2;\n  }\n  return 0;\n}\nEOF\n\ncat > /app/hullcue/go.c <<'EOF'\n#include \"../knothub/store.h\"\n#include \"../readcue/scan.h\"\n#include \"../inkurn/book.h\"\n#include \"../knothub/graph.h\"\n#include \"../knothub/pick.h\"\n#include \"../emiturn/bind.h\"\n#include \"rank.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic void clear_failed_outputs(const char *out) {\n  char dir[256], okp[320];\n  const char *slash = strrchr(out, '/');\n  unlink(out);\n  if (!slash) snprintf(dir, sizeof dir, \".\");\n  else if (slash == out) snprintf(dir, sizeof dir, \"/\");\n  else {\n    size_t n = (size_t)(slash - out);\n    if (n >= sizeof dir) return;\n    memcpy(dir, out, n); dir[n] = 0;\n  }\n  snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\n  unlink(okp);\n}\n\nint assay_run(const char *dump, const char *out) {\n  clear_failed_outputs(out);\n  snprintf(g_path, sizeof g_path, \"%s\", dump);\n  if (scan_dump(dump) != 0 || !g_closer ||\n      book_load(\"/app/inkurn/book.tsv\") != 0) return 2;\n  graph_build();\n  if (op_pick() != 0) return 2;\n  rk_wrap();\n  return n_bind(out);\n}\nEOF\nmake -C /app/hullcue -f /app/hullcue/hull.mk clean >/dev/null 2>&1 || true\nmake -C /app/hullcue -f /app/hullcue/hull.mk hull HULLBIN=/tmp/rimlock.ref\nfile /tmp/rimlock.ref\n"]
