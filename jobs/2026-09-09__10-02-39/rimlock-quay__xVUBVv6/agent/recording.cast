[31.044355, "o", "     1\t#include \"rank.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\tvoid rk_wrap(void) {\r\n     5\t  int q[MAXL];\r\n     6\t  int qh = 0;\r\n     7\t  int qt = 0;\r\n     8\t\r\n     9\t  for (int i = 0; i < GN; i++) {\r\n    10\t    G[i].depth = 0;\r\n    11\t    if (!G[i].has_wait) {\r\n    12\t      q[qt++] = i;\r\n    13\t    }\r\n    14\t  }\r\n    15\t  while (qh < qt) {\r\n    16\t    int i = q[qh++];\r\n    17\t    for (int k = 0; k < nsucc[i]; k++) {\r\n"]
[31.044596, "o", "    18\t      int j = succ[i][k];\r\n    19\t      int d = G[i].depth + 1;\r\n    20\t      if (d > G[j].depth) {\r\n    21\t        G[j].depth = d;\r\n    22\t      }\r\n    23\t      if (qt < MAXL * 3) {\r\n    24\t        q[qt++] = j;\r\n    25\t      }\r\n    26\t    }\r\n    27\t  }\r\n    28\t}\r\n"]
[31.044657, "o", "===== MAKEFILE TABS =====\r\n"]
[31.046467, "o", "CC = gcc$\r\nCFLAGS = -O0 -g -Wall -std=c11 -I/app$\r\nHULLBIN ?= /app/bin/rimlock$\r\nOBJS = main.o go.o rank.o \\\\$\r\n\\t../knothub/store.o ../knothub/graph.o ../knothub/pick.o ../knothub/\\\r\ncycle.o \\\\$\r\n\\t../readcue/scan.o \\\\$\r\n\\t../inkurn/book.o \\\\$\r\n\\t../emiturn/bind.o \\\\$\r\n\\t../inkfold/fold.o$\r\n$\r\nhull: $(OBJS)$\r\n\\t$(CC) $(CFLAGS) -o $(HULLBIN) $(OBJS)$\r\n"]
[31.046529, "o", "$\r\n%.o: %.c$\r\n\\t$(CC) $(CFLAGS) -c -o $@ $<$\r\n$\r\n../knothub/%.o: ../knothub/%.c$\r\n\\t$(CC) $(CFLAGS) -c -o $@ $<$\r\n$\r\n../readcue/%.o: ../readcue/%.c$\r\n\\t$(CC) $(CFLAGS) -c -o $@ $<$\r\n$\r\n../inkurn/%.o: ../inkurn/%.c$\r\n\\t$(CC) $(CFLAGS) -c -o $@ $<$\r\n$\r\n../emiturn/%.o: ../emiturn/%.c$\r\n\\t$(CC) $(CFLAGS) -c -o $@ $<$\r\n$\r\n../inkfold/%.o: ../inkfold/%.c$\r\n\\t$(CC) $(CFLAGS) -c -o $@ $<$\r\n"]
