[32.139522, "o", "ok\r\n\u001b[?2004hroot@15870fd3b33e:/app# "]
[75.368371, "i", "cat > /app/readcue/scan.c <<'EOF'\n#include \"scan.h\"\n#include \"../knothub/store.h\"\n\n#include <errno.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic void reset_g(void) {\n  memset(G, 0, sizeof G);\n  GN = 0;\n  g_closer = 1;\n  PN = 0;\n}\n\nstatic int bad(FILE *f) {\n  if (f) fclose(f);\n  g_closer = 0;\n  return 2;\n}\n\nint scan_dump(const char *path) {\n  FILE *f;\n  char line[160];\n  int open = 0;\n\n  reset_g();\n  f = fopen(path, \"r\");\n  if (!f) return 2;\n\n  while (fgets(line, sizeof line, f)) {\n    char *nl = strchr(line, '\\n');\n    if (!nl && !feof(f)) return bad(f); /* overlong record */\n    if (nl) *nl = 0;\n    if (line[0] == 0) continue;\n\n    if (strncmp(line, \"THREAD \", 7) == 0) {\n      char *end;\n      unsigned long tid;\n      if (open || GN >= MAXL) return bad(f);\n      errno = 0;\n      tid = strtoul(line + 7, &end, 10);\n      if (errno || end == line + 7 || *end || tid > UINT32_MAX) return bad(f);\n      G[GN].tid = (uint32_t)tid;\n      open = 1;\n      GN++;\n    } else if (!open) {\n      return bad(f);\n    } else if (strncmp(line, \"OWN \", 4) == 0) {\n      if (G[GN - 1].hex[0] || !line[4] || strlen(line + 4) >= sizeof G[0].hex)\n        return bad(f);\n      strcpy(G[GN - 1].hex, line + 4);\n    } else if (strncmp(line, \"WAIT \", 5) == 0) {\n      if (G[GN - 1].has_wait || !line[5] || strlen(line + 5) >= sizeof G[0].wait_hex)\n        return bad(f);\n      strcpy(G[GN - 1].wait_hex, line + 5);\n      G[GN - 1].has_wait = 1;\n    } else if (strcmp(line, \".\") == 0) {\n      if (!G[GN - 1].hex[0]) return bad(f);\n      open = 0;\n    } else {\n      return bad(f);\n    }\n  }\n  if (ferror(f) || open || GN == 0) return bad(f);\n  fclose(f);\n  return 0;\n}\nEOF\n\ncat > /app/inkurn/book.c <<'EOF'\n#include \"book.h\"\n#include \"../knothub/store.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nint book_load(const char *path) {\n  FILE *f;\n  char line[160], hx[40], extra;\n  unsigned id;\n\n  for (int i = 0; i < GN; i++) {\n    G[i].tag = 0;\n    G[i].wait_tag = 0;\n  }\n  f = fopen(path, \"r\");\n  if (!f) return 2;\n  while (fgets(line, sizeof line, f)) {\n    if (sscanf(line, \"%39s %u %c\", hx, &id, &extra) != 2) continue;\n    if (strcmp(hx, \"hex\") == 0) continue;\n    for (int i = 0; i < GN; i++) {\n      if (strcmp(G[i].hex, hx) == 0) G[i].tag = id;\n      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) G[i].wait_tag = id;\n    }\n  }\n  if (ferror(f)) { fclose(f); return 2; }\n  fclose(f);\n  for (int i = 0; i < GN; i++)\n    if (G[i].tag == 0 || (G[i].has_wait && G[i].wait_tag == 0)) return 2;\n  return 0;\n}\nEOF\n\ncat > /app/knothub/pick.c <<'EOF'\n#include \"pick.h\"\n#include \"store.h\"\n\nstatic int before(int a, int b) {\n  if (b < 0) return 1;\n  if (G[a].tag != G[b].tag) return G[a].tag < G[b].tag;\n  if (G[a].tid != G[b].tid) return G[a].tid < G[b].tid;\n  return a < b;\n}\n\nint op_pick(void) {\n  PN = 0;\n  while (PN < GN) {\n    int best = -1;\n    for (int i = 0; i < GN; i++)\n      if (!G[i].done && G[i].indeg == 0 && before(i, best)) best = i;\n    /* A deadlock has no zero-indegree node. Break it reproducibly. */\n    if (best < 0)\n      for (int i = 0; i < GN; i++)\n        if (!G[i].done && before(i, best)) best = i;\n    if (best < 0) return 2;\n    PLAN[PN++] = best;\n    G[best].done = 1;\n    for (int k = 0; k < nsucc[best]; k++) {\n      int j = succ[best][k];\n      if (G[j].indeg > 0) G[j].indeg--;\n    }\n  }\n  return 0;\n}\nEOF\n\ncat > /app/hullcue/rank.c <<'EOF'\n#include \"rank.h\"\n#include \"../knothub/store.h\"\n\n/* Compute wait depth without changing the deterministic topological plan. */\nvoid rk_wrap(void) {\n  for (int i = 0; i < GN; i++) G[i].depth = 0;\n  for (int p = 0; p < PN; p++) {\n    int i = PLAN[p];\n    for (int k = 0; k < nsucc[i]; k++) {\n      int j = succ[i][k];\n      if (G[j].depth < G[i].depth + 1) G[j].depth = G[i].depth + 1;\n    }\n  }\n}\nEOF\n"]
[75.368919, "o", "cat > /app/readcue/scan.c <<'EOF'\r\n\u001b[?2004l\r"]
[75.369171, "o", "\u001b[?2004h"]
