[7.491915, "o", "\u001b[?2004hroot@15870fd3b33e:/app# "]
[16.497343, "i", "for f in /app/desknote/DEPTH.txt /app/hullcue/hull.mk /app/hullcue/*.c /app/hullcue/*.h /app/readcue/*.c /app/readcue/*.h /app/inkurn/*.c /app/inkurn/*.h /app/knothub/*.c /app/knothub/*.h /app/emiturn/*.c /app/emiturn/*.h /app/inkfold/*.c /app/inkfold/*.h; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[16.498283, "o", "for f in /app/desknote/DEPTH.txt /app/hullcue/hull.mk /app/hullcue/*.c /app/hullcue/*.h /app/readcue/*.c /app/readcue/*.h /app/inkurn/*.c /app/inkurn/*.h /app/knothub/*.c /app/knothub/*.h /app/emiturn/*.c /app/emiturn/*.h /app/inkfold/*.c /app/inkfold/*.h; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[16.498873, "o", "===== /app/desknote/DEPTH.txt =====\r\n"]
[16.500446, "o", "Wait-depth ranking already wraps unjam emit. Equal depth keeps the current list. Desk workers enable this wrap when plans look shuffled.\r\n"]
[16.500641, "o", "===== /app/hullcue/hull.mk =====\r\n"]
[16.502042, "o", "CC = gcc\r\nCFLAGS = -O0 -g -Wall -std=c11 -I/app\r\nHULLBIN ?= /app/bin/rimlock\r\nOBJS = main.o go.o rank.o \\\r\n\t../knothub/store.o ../knothub/graph.o ../knothub/pick.o ../knothub/cycle.o \\\r\n\t../readcue/scan.o \\\r\n\t../inkurn/book.o \\\r\n\t../emiturn/bind.o \\\r\n\t../inkfold/fold.o\r\n\r\nhull: $(OBJS)\r\n\t$(CC) $(CFLAGS) -o $(HULLBIN) $(OBJS)\r\n\r\n%.o: %.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n"]
[16.50217, "o", "\r\n../knothub/%.o: ../knothub/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../readcue/%.o: ../readcue/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../inkurn/%.o: ../inkurn/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../emiturn/%.o: ../emiturn/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../inkfold/%.o: ../inkfold/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n"]
[16.502323, "o", "===== /app/hullcue/go.c =====\r\n"]
[16.503704, "o", "#include \"../knothub/store.h\"\r\n#include \"../readcue/scan.h\"\r\n#include \"../inkurn/book.h\"\r\n#include \"../knothub/graph.h\"\r\n#include \"../knothub/pick.h\"\r\n#include \"../emiturn/bind.h\"\r\n#include \"rank.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint assay_run(const char *dump, const char *out) {\r\n  snprintf(g_path, sizeof g_path, \"%s\", dump);\r\n  if (scan_dump(dump) != 0) {\r\n    return 2;\r\n  }\r\n  if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n    return 2;\r\n  }\r\n  graph_build();\r\n  op_pick();\r\n  rk_wrap();\r\n  return n_bind(out);\r\n}\r\n"]
[16.503904, "o", "===== /app/hullcue/main.c =====\r\n"]
[16.50512, "o", "#include \"../knothub/store.h\"\r\n#include \"../readcue/scan.h\"\r\n#include \"../inkurn/book.h\"\r\n#include \"../knothub/graph.h\"\r\n#include \"../inkfold/fold.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint assay_run(const char *dump, const char *out);\r\n\r\nint main(int argc, char **argv) {\r\n  if (argc < 2) {\r\n    fputs(\"usage\\n\", stderr);\r\n    return 2;\r\n  }\r\n  if (strcmp(argv[1], \"unjam\") == 0 && argc >= 4) {\r\n    return assay_run(argv[2], argv[3]);\r\n  }\r\n  if (strcmp(argv[1], \"scroll\") == 0 && argc >= 4) {\r\n    snprintf(g_path, sizeof g_path, \"%s\", argv[2]);\r\n    if (scan_dump(argv[2]) != 0) {\r\n      return 2;\r\n    }\r\n    return cfg_fold(argv[3]);\r\n  }\r\n  if (strcmp(argv[1], \"roster\") == 0 && argc >= 3) {\r\n    if (scan_dump(argv[2]) != 0) {\r\n      return 2;\r\n    }\r\n    if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n      return 2;\r\n    }\r\n    graph_build();\r\n    roster_out();\r\n    return 0;\r\n  }\r\n  fputs(\"usage\\n\", stderr);\r\n  return 2;\r\n}\r\n"]
[16.505323, "o", "===== /app/hullcue/rank.c =====\r\n"]
[16.506538, "o", "#include \"rank.h\"\r\n#include \"../knothub/store.h\"\r\n\r\nvoid rk_wrap(void) {\r\n  int q[MAXL];\r\n  int qh = 0;\r\n  int qt = 0;\r\n\r\n  for (int i = 0; i < GN; i++) {\r\n    G[i].depth = 0;\r\n    if (!G[i].has_wait) {\r\n      q[qt++] = i;\r\n    }\r\n  }\r\n  while (qh < qt) {\r\n    int i = q[qh++];\r\n    for (int k = 0; k < nsucc[i]; k++) {\r\n      int j = succ[i][k];\r\n      int d = G[i].depth + 1;\r\n      if (d > G[j].depth) {\r\n        G[j].depth = d;\r\n      }\r\n      if (qt < MAXL * 3) {\r\n        q[qt++] = j;\r\n      }\r\n    }\r\n  }\r\n}\r\n"]
[16.506744, "o", "===== /app/hullcue/rank.h =====\r\n"]
[16.507834, "o", "#ifndef RANK_H\r\n#define RANK_H\r\nvoid rk_wrap(void);\r\n#endif\r\n"]
[16.508009, "o", "===== /app/readcue/scan.c =====\r\n"]
[16.509219, "o", "#include \"scan.h\"\r\n#include \"../knothub/store.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void reset_g(void) {\r\n  memset(G, 0, sizeof(G));\r\n  GN = 0;\r\n  g_closer = 1;\r\n  PN = 0;\r\n}\r\n\r\nint scan_dump(const char *path) {\r\n  FILE *f;\r\n  char line[160];\r\n  int open = 0;\r\n\r\n  reset_g();\r\n  f = fopen(path, \"r\");\r\n  if (!f) {\r\n    return 2;\r\n"]
[16.509337, "o", "  }\r\n  while (fgets(line, sizeof line, f)) {\r\n    char *nl = strchr(line, '\\n');\r\n    if (nl) {\r\n      *nl = 0;\r\n    }\r\n    if (line[0] == 0) {\r\n      continue;\r\n    }\r\n    if (strncmp(line, \"THREAD \", 7) == 0) {\r\n      if (open) {\r\n        g_closer = 0;\r\n      }\r\n      if (GN >= MAXL) {\r\n        fclose(f);\r\n        return 2;\r\n"]
[16.509428, "o", "      }\r\n      G[GN].tid = (uint32_t)atoi(line + 7);\r\n      open = 1;\r\n      GN++;\r\n      continue;\r\n    }\r\n    if (!open) {\r\n      continue;\r\n    }\r\n    if (strncmp(line, \"OWN \", 4) == 0) {\r\n      snprintf(G[GN - 1].hex, sizeof G[GN - 1].hex, \"%s\", line + 4);\r\n      continue;\r\n    }\r\n    if (strncmp(line, \"WAIT \", 5) == 0) {\r\n      snprintf(G[GN - 1].wait_hex, sizeof G[GN - 1].wait_hex, \"%s\", line + 5);\r\n      G[GN - 1].has_wait = 1;\r\n      continue;\r\n    }\r\n    if (strcmp(line, \".\") == 0) {\r\n      open = 0;\r\n      continue;\r\n    }\r\n  }\r\n  fclose(f);\r\n  if (open) {\r\n    g_closer = 0;\r\n  }\r\n  return GN > 0 ? 0 : 2;\r\n}\r\n"]
[16.509593, "o", "===== /app/readcue/scan.h =====\r\n"]
[16.51076, "o", "#ifndef SCAN_H\r\n#define SCAN_H\r\nint scan_dump(const char *path);\r\n#endif\r\n"]
[16.510957, "o", "===== /app/inkurn/book.c =====\r\n"]
[16.512139, "o", "#include \"book.h\"\r\n#include \"../knothub/store.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint book_load(const char *path) {\r\n  FILE *f;\r\n  char line[160];\r\n  char hx[40];\r\n  unsigned id;\r\n\r\n  f = fopen(path, \"r\");\r\n  if (!f) {\r\n    return 2;\r\n  }\r\n  while (fgets(line, sizeof line, f)) {\r\n    if (sscanf(line, \"%39s %u\", hx, &id) != 2) {\r\n      continue;\r\n    }\r\n    if (hx[0] == 'h' || strcmp(hx, \"hex\") == 0) {\r\n      continue;\r\n    }\r\n    for (int i = 0; i < GN; i++) {\r\n      if (strcmp(G[i].hex, hx) == 0) {\r\n        G[i].tag = id;\r\n      }\r\n      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) {\r\n        G[i].wait_tag = id;\r\n      }\r\n    }\r\n  }\r\n  fclose(f);\r\n  return 0;\r\n}\r\n"]
[16.512274, "o", "===== /app/inkurn/book.h =====\r\n"]
[16.513248, "o", "#ifndef BOOK_H\r\n#define BOOK_H\r\nint book_load(const char *path);\r\n#endif\r\n"]
[16.513361, "o", "===== /app/knothub/cycle.c =====\r\n"]
[16.514548, "o", "#include \"store.h\"\r\n#include \"../inkurn/book.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic int cmp_u(const void *a, const void *b) {\r\n  uint32_t x = *(const uint32_t *)a;\r\n  uint32_t y = *(const uint32_t *)b;\r\n  if (x < y) {\r\n    return -1;\r\n  }\r\n  if (x > y) {\r\n    return 1;\r\n  }\r\n  return 0;\r\n}\r\n\r\nvoid roster_out(void) {\r\n  uint32_t cyc[MAXL];\r\n  int cn = 0;\r\n  int seen[MAXL];\r\n\r\n  memset(seen, 0, sizeof seen);\r\n  for (int i = 0; i < GN; i++) {\r\n    if (G[i].has_wait) {\r\n      int w = -1;\r\n      for (int j = 0; j < GN; j++) {\r\n        if (strcmp(G[j].hex, G[i].wait_hex) == 0) {\r\n          w = j;\r\n          break;\r\n        }\r\n      }\r\n      if (w >= 0 && G[w].has_wait && strcmp(G[w].wait_hex, G[i].hex) == 0) {\r\n        if (!seen[i]) {\r\n          cyc[cn++] = G[i].tag;\r\n          seen[i] = 1;\r\n        }\r\n        if (!seen[w]) {\r\n          cyc[cn++] = G[w].tag;\r\n          seen[w] = 1;\r\n"]
[16.514644, "o", "        }\r\n      }\r\n    }\r\n  }\r\n  qsort(cyc, (size_t)cn, sizeof cyc[0], cmp_u);\r\n  fputs(\"CYCLE\", stdout);\r\n  for (int i = 0; i < cn; i++) {\r\n    printf(\" %u\", cyc[i]);\r\n  }\r\n  fputc('\\n', stdout);\r\n  for (int i = 0; i < GN; i++) {\r\n    printf(\"OWNER %u=%u\\n\", G[i].tag, G[i].tid);\r\n  }\r\n}\r\n"]
[16.514845, "o", "===== /app/knothub/graph.c =====\r\n"]
[16.515926, "o", "#include \"graph.h\"\r\n#include \"store.h\"\r\n\r\n#include <string.h>\r\n\r\nstatic int find_hex(const char *hx) {\r\n  for (int i = 0; i < GN; i++) {\r\n    if (strcmp(G[i].hex, hx) == 0) {\r\n      return i;\r\n    }\r\n  }\r\n  return -1;\r\n}\r\n\r\nvoid graph_build(void) {\r\n  memset(succ, 0, sizeof succ);\r\n  memset(nsucc, 0, sizeof nsucc);\r\n  for (int i = 0; i < GN; i++) {\r\n    G[i].indeg = 0;\r\n    G[i].done = 0;\r\n  }\r\n  for (int i = 0; i < GN; i++) {\r\n    int w;\r\n    if (!G[i].has_wait) {\r\n      continue;\r\n    }\r\n    w = find_hex(G[i].wait_hex);\r\n    if (w < 0) {\r\n      continue;\r\n    }\r\n    /* w precedes i */\r\n    succ[w][nsucc[w]++] = i;\r\n    G[i].indeg++;\r\n  }\r\n}\r\n"]
[16.516109, "o", "===== /app/knothub/pick.c =====\r\n"]
[16.517196, "o", "#include \"pick.h\"\r\n#include \"store.h\"\r\n\r\nint op_pick(void) {\r\n  PN = 0;\r\n  for (;;) {\r\n    int best = -1;\r\n    for (int i = 0; i < GN; i++) {\r\n      if (G[i].done) {\r\n        continue;\r\n      }\r\n      if (G[i].indeg == 0) {\r\n        if (best < 0 || i < best) {\r\n          best = i;\r\n        }\r\n      }\r\n    }\r\n    if (best < 0) {\r\n      for (int i = 0; i < GN; i++) {\r\n        if (G[i].done) {\r\n          continue;\r\n        }\r\n        if (best < 0 || i < best) {\r\n          best = i;\r\n        }\r\n      }\r\n    }\r\n    if (best < 0) {\r\n      break;\r\n    }\r\n    PLAN[PN++] = best;\r\n    G[best].done = 1;\r\n    for (int k = 0; k < nsucc[best]; k++) {\r\n      int j = succ[best][k];\r\n      if (G[j].indeg > 0) {\r\n        G[j].indeg--;\r\n      }\r\n    }\r\n  }\r\n  return 0;\r\n}\r\n"]
[16.517431, "o", "===== /app/knothub/store.c =====\r\n"]
[16.518475, "o", "#include \"store.h\"\r\n\r\nLockRec G[MAXL];\r\nint GN;\r\nint g_closer;\r\nint PLAN[MAXL];\r\nint PN;\r\nint succ[MAXL][MAXL];\r\nint nsucc[MAXL];\r\nchar g_path[256];\r\n"]
[16.518706, "o", "===== /app/knothub/graph.h =====\r\n"]
[16.51974, "o", "#ifndef GRAPH_H\r\n#define GRAPH_H\r\nvoid graph_build(void);\r\n#endif\r\n"]
[16.519919, "o", "===== /app/knothub/pick.h =====\r\n"]
[16.520913, "o", "#ifndef PICK_H\r\n#define PICK_H\r\nint op_pick(void);\r\n#endif\r\n"]
[16.521066, "o", "===== /app/knothub/store.h =====\r\n"]
[16.522177, "o", "#ifndef STORE_H\r\n#define STORE_H\r\n\r\n#include <stdint.h>\r\n\r\n#define MAXL 64\r\n\r\ntypedef struct {\r\n  char hex[40];\r\n  char wait_hex[40];\r\n  uint32_t tag;\r\n  uint32_t wait_tag;\r\n  uint32_t tid;\r\n  int has_wait;\r\n  int indeg;\r\n  int done;\r\n  int depth;\r\n} LockRec;\r\n\r\nextern LockRec G[MAXL];\r\nextern int GN;\r\nextern int g_closer;\r\nextern int PLAN[MAXL];\r\nextern int PN;\r\nextern int succ[MAXL][MAXL];\r\nextern int nsucc[MAXL];\r\nextern char g_path[256];\r\n\r\nint scan_dump(const char *path);\r\nint book_load(const char *path);\r\nvoid graph_build(void);\r\nvoid roster_out(void);\r\nvoid rk_wrap(void);\r\nint assay_run(const char *dump, const char *out);\r\n\r\n#endif\r\n"]
[16.522411, "o", "===== /app/emiturn/bind.c =====\r\n"]
[16.523503, "o", "#include \"bind.h\"\r\n#include \"../knothub/store.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n#include <unistd.h>\r\n\r\nint n_bind(const char *a) {\r\n  FILE *f;\r\n  FILE *ok;\r\n  char dir[128];\r\n  const char *slash;\r\n\r\n  slash = strrchr(a, '/');\r\n  if (slash) {\r\n    size_t n = (size_t)(slash - a);\r\n    if (n >= sizeof dir) {\r\n      n = sizeof dir - 1;\r\n    }\r\n    memcpy(dir, a, n);\r\n    dir[n] = 0;\r\n  } else {\r\n    snprintf(dir, sizeof dir, \".\");\r\n  }\r\n\r\n  f = fopen(a, \"w\");\r\n  if (!f) {\r\n    return 2;\r\n  }\r\n"]
[16.523582, "o", "  for (int i = 0; i < PN; i++) {\r\n    int k = PLAN[i];\r\n    fprintf(f, \"%s\\n\", G[k].hex);\r\n  }\r\n  fclose(f);\r\n\r\n  {\r\n    char okp[160];\r\n    snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\r\n    ok = fopen(okp, \"w\");\r\n    if (ok) {\r\n      fputs(\"ok\\n\", ok);\r\n      fclose(ok);\r\n    }\r\n  }\r\n  (void)g_closer;\r\n  return 0;\r\n}\r\n"]
[16.523857, "o", "===== /app/emiturn/bind.h =====\r\n"]
[16.524961, "o", "#ifndef BIND_H\r\n#define BIND_H\r\nint n_bind(const char *a);\r\n#endif\r\n"]
[16.525202, "o", "===== /app/inkfold/fold.c =====\r\n"]
[16.526308, "o", "#include \"fold.h\"\r\n#include \"../knothub/store.h\"\r\n#include \"../readcue/scan.h\"\r\n#include \"../inkurn/book.h\"\r\n#include \"../knothub/graph.h\"\r\n#include \"../knothub/pick.h\"\r\n#include \"../hullcue/rank.h\"\r\n\r\n#include <stdint.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint cfg_fold(const char *a) {\r\n  int buck[8];\r\n  int bnext[MAXL];\r\n  int seen[MAXL];\r\n  FILE *f;\r\n\r\n  if (GN == 0 && g_path[0]) {\r\n    if (scan_dump(g_path) != 0) {\r\n      return 2;\r\n    }\r\n  }\r\n  if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n    return 2;\r\n  }\r\n  graph_build();\r\n  op_pick();\r\n  rk_wrap();\r\n\r\n  for (int b = 0; b < 8; b++) {\r\n    buck[b] = -1;\r\n  }\r\n  memset(seen, 0, sizeof seen);\r\n  for (int i = 0; i < PN; i++) {\r\n"]
[16.526407, "o", "    int k = PLAN[i];\r\n    unsigned h = ((unsigned)G[k].tid * 2654435761u) >> 29;\r\n    h &= 7u;\r\n    bnext[k] = buck[h];\r\n    buck[h] = k;\r\n  }\r\n\r\n  f = fopen(a, \"w\");\r\n  if (!f) {\r\n    return 2;\r\n  }\r\n  for (int b = 0; b < 8; b++) {\r\n    int k = buck[b];\r\n    while (k >= 0) {\r\n      if (!seen[k]) {\r\n        fprintf(f, \"%u %s\\n\", G[k].tid, G[k].hex);\r\n        seen[k] = 1;\r\n      }\r\n      k = bnext[k];\r\n    }\r\n  }\r\n  fclose(f);\r\n  return 0;\r\n}\r\n"]
[16.526653, "o", "===== /app/inkfold/fold.h =====\r\n"]
[16.527801, "o", "#ifndef FOLD_H\r\n#define FOLD_H\r\nint cfg_fold(const char *a);\r\n#endif\r\n"]
