[31.03462, "o", "     1\t#include \"book.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tint book_load(const char *path) {\r\n     8\t  FILE *f;\r\n     9\t  char line[160];\r\n    10\t  char hx[40];\r\n    11\t  unsigned id;\r\n    12\t\r\n    13\t  f = fopen(path, \"r\");\r\n    14\t  if (!f) {\r\n    15\t    return 2;\r\n    16\t  }\r\n    17\t  while (fgets(line, sizeof line, f)) {\r\n    18\t    if (sscanf(line, \"%39s %u\", hx, &id) != 2) {\r\n    19\t      continue;\r\n    20\t    }\r\n    21\t    if (hx[0] == 'h' || strcmp(hx, \"hex\") == 0) {\r\n    22\t      continue;\r\n    23\t    }\r\n    24\t    for (int i = 0; i < GN; i++) {\r\n    25\t      if (strcmp(G[i].hex, hx) == 0) {\r\n    26\t        G[i].tag = id;\r\n    27\t      }\r\n    28\t      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) {\r\n    29\t        G[i].wait_tag = id;\r\n    30\t      }\r\n    31\t    }\r\n    32\t  }\r\n    33\t  fclose(f);\r\n    34\t  return 0;\r\n    35\t}\r\n"]
