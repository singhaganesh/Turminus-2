() != 0) return 2;\r\n\u001b[?2004l\r\u001b[?2004h>   rk_wrap();\r\n\u001b[?2004l\r\u001b[?2004h>   return n_bind(out);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
