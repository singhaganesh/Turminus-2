[31.03764, "o", "===== /app/knothub/graph.c =====\r\n"]
[31.039409, "o", "     1\t#include \"graph.h\"\r\n     2\t#include \"store.h\"\r\n     3\t\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tstatic int find_hex(const char *hx) {\r\n     7\t  for (int i = 0; i < GN; i++) {\r\n     8\t    if (strcmp(G[i].hex, hx) == 0) {\r\n     9\t      return i;\r\n    10\t    }\r\n    11\t  }\r\n    12\t  return -1;\r\n    13\t}\r\n    14\t\r\n    15\tvoid graph_build(void) {\r\n    16\t  memset(succ, 0, sizeof succ);\r\n    17\t  memset(nsucc, 0, sizeof nsucc);\r\n    18\t  for (int i = 0; i < GN; i++) {\r\n    19\t    G[i].indeg = 0;\r\n    20\t    G[i].done = 0;\r\n    21\t  }\r\n    22\t  for (int i = 0; i < GN; i++) {\r\n    23\t    int w;\r\n    24\t    if (!G[i].has_wait) {\r\n    25\t      continue;\r\n    26\t    }\r\n    27\t    w = find_hex(G[i].wait_hex);\r\n    28\t    if (w < 0) {\r\n    29\t      continue;\r\n    30\t    }\r\n    31\t    /* w precedes i */\r\n    32\t    succ[w][nsucc[w]++] = i;\r\n    33\t    G[i].indeg++;\r\n    34\t  }\r\n    35\t}\r\n"]
[31.039469, "o", "===== /app/knothub/cycle.c =====\r\n"]
[31.040756, "o", "     1\t#include \"store.h\"\r\n     2\t#include \"../inkurn/book.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n     6\t#include <string.h>\r\n     7\t\r\n     8\tstatic int cmp_u(const void *a, const void *b) {\r\n     9\t  uint32_t x = *(const uint32_t *)a;\r\n    10\t  uint32_t y = *(const uint32_t *)b;\r\n    11\t  if (x < y) {\r\n    12\t    return -1;\r\n    13\t  }\r\n    14\t  if (x > y) {\r\n"]
[31.040902, "o", "    15\t    return 1;\r\n    16\t  }\r\n    17\t  return 0;\r\n    18\t}\r\n    19\t\r\n    20\tvoid roster_out(void) {\r\n    21\t  uint32_t cyc[MAXL];\r\n    22\t  int cn = 0;\r\n    23\t  int seen[MAXL];\r\n    24\t\r\n    25\t  memset(seen, 0, sizeof seen);\r\n    26\t  for (int i = 0; i < GN; i++) {\r\n    27\t    if (G[i].has_wait) {\r\n    28\t      int w = -1;\r\n    29\t      for (int j = 0; j < GN; j++) {\r\n    30\t        if (strcmp(G[j].hex, G[i].wait_hex) == 0) {\r\n    31\t          w = j;\r\n    32\t          break;\r\n    33\t        }\r\n    34\t      }\r\n    35\t      if (w >= 0 && G[w].has_wait && strcmp(G[w].wait_hex, G[i].hex) == 0) {\r\n    36\t        if (!seen[i]) {\r\n    37\t          cyc[cn++] = G[i].tag;\r\n    38\t          seen[i] = 1;\r\n    39\t        }\r\n    40\t        if (!seen[w]) {\r\n    41\t          cyc[cn++] = G[w].tag;\r\n    42\t          seen[w] = 1;\r\n    43\t        }\r\n    44\t      }\r\n    45\t    }\r\n    46\t  }\r\n    47\t  qsort(cyc, (size_t)cn, sizeof cyc[0], cmp_u);\r\n    48\t  fputs(\"CYCLE\", stdout);\r\n    49\t  for (int i = 0; i < cn; i++) {\r\n    50\t    printf(\" %u\", cyc[i]);\r\n    51\t  }\r\n    52\t  fputc('\\n', stdout);\r\n    53\t  for (int i = 0; i < GN; i++) {\r\n    54\t    printf(\"OWNER %u=%u\\n\", G[i].tag, G[i].tid);\r\n    55\t  }\r\n    56\t}\r\n"]
