[75.370352, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[75.371128, "o", "> "]
[75.371771, "o", "static void reset_g(void) {\r\n\u001b[?2004l\r\u001b[?2004h>   memset(G, 0, sizeof G);\r\n\u001b[?2004l\r\u001b[?2004h>   GN = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   g_closer = 1;\r\n\u001b[?2004l\r\u001b[?2004h>   PN = 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.372074, "o", "static int bad(FILE *f) {\r\n\u001b[?2004l\r"]
[75.372382, "o", "\u001b[?2004h>   if (f) fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h>   g_closer = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.372549, "o", ">   return 2;\r\n\u001b[?2004l\r"]
[75.3726, "o", "\u001b[?2004h> "]
[75.372654, "o", "}\r\n\u001b[?2004l\r"]
