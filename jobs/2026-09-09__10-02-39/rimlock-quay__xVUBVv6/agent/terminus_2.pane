    24	    if (!G[i].has_wait) {
    25	      continue;
    26	    }
    27	    w = find_hex(G[i].wait_hex);
    28	    if (w < 0) {
    29	      continue;
    30	    }
    31	    /* w precedes i */
    32	    succ[w][nsucc[w]++] = i;
    33	    G[i].indeg++;
    34	  }
