===== /app/inkfold/fold.c =====
#include "fold.h"
#include "../knothub/store.h"
#include "../readcue/scan.h"
#include "../inkurn/book.h"
#include "../knothub/graph.h"
#include "../knothub/pick.h"
#include "../hullcue/rank.h"

#include <stdint.h>
#include <stdio.h>
#include <string.h>

int cfg_fold(const char *a) {
  int buck[8];
  int bnext[MAXL];
  int seen[MAXL];
  FILE *f;

  if (GN == 0 && g_path[0]) {
    if (scan_dump(g_path) != 0) {
      return 2;
    }
  }
  if (book_load("/app/inkurn/book.tsv") != 0) {
    return 2;
  }
  graph_build();
  op_pick();
  rk_wrap();

  for (int b = 0; b < 8; b++) {
    buck[b] = -1;
  }
  memset(seen, 0, sizeof seen);
  for (int i = 0; i < PN; i++) {
    int k = PLAN[i];
    unsigned h = ((unsigned)G[k].tid * 2654435761u) >> 29;
    h &= 7u;
    bnext[k] = buck[h];
    buck[h] = k;
  }

  f = fopen(a, "w");
  if (!f) {
    return 2;
  }
  for (int b = 0; b < 8; b++) {
    int k = buck[b];
    while (k >= 0) {
      if (!seen[k]) {
        fprintf(f, "%u %s\n", G[k].tid, G[k].hex);
        seen[k] = 1;
      }
      k = bnext[k];
    }
  }
  fclose(f);
  return 0;
}
