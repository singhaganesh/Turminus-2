===== /app/knothub/cycle.c =====
     1	#include "store.h"
     2	#include "../inkurn/book.h"
     3	
     4	#include <stdio.h>
     5	#include <stdlib.h>
     6	#include <string.h>
     7	
     8	static int cmp_u(const void *a, const void *b) {
     9	  uint32_t x = *(const uint32_t *)a;
    10	  uint32_t y = *(const uint32_t *)b;
    11	  if (x < y) {
    12	    return -1;
    13	  }
    14	  if (x > y) {
    15	    return 1;
    16	  }
    17	  return 0;
    18	}
    19	
    20	void roster_out(void) {
    21	  uint32_t cyc[MAXL];
    22	  int cn = 0;
    23	  int seen[MAXL];
    24	
    25	  memset(seen, 0, sizeof seen);
    26	  for (int i = 0; i < GN; i++) {
    27	    if (G[i].has_wait) {
    28	      int w = -1;
    29	      for (int j = 0; j < GN; j++) {
    30	        if (strcmp(G[j].hex, G[i].wait_hex) == 0) {
    31	          w = j;
    32	          break;
    33	        }
    34	      }
    35	      if (w >= 0 && G[w].has_wait && strcmp(G[w].wait_hex, G[i].hex) == 0) {
    36	        if (!seen[i]) {
    37	          cyc[cn++] = G[i].tag;
    38	          seen[i] = 1;
    39	        }
    40	        if (!seen[w]) {
    41	          cyc[cn++] = G[w].tag;
    42	          seen[w] = 1;
    43	        }
    44	      }
    45	    }
    46	  }
    47	  qsort(cyc, (size_t)cn, sizeof cyc[0], cmp_u);
    48	  fputs("CYCLE", stdout);
    49	  for (int i = 0; i < cn; i++) {
    50	    printf(" %u", cyc[i]);
    51	  }
    52	  fputc('\n', stdout);
    53	  for (int i = 0; i < GN; i++) {
    54	    printf("OWNER %u=%u\n", G[i].tag, G[i].tid);
    55	  }
    56	}
