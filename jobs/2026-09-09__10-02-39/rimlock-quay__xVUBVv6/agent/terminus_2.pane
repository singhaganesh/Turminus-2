     4	void rk_wrap(void) {
     5	  int q[MAXL];
     6	  int qh = 0;
     7	  int qt = 0;
     8	
     9	  for (int i = 0; i < GN; i++) {
    10	    G[i].depth = 0;
    11	    if (!G[i].has_wait) {
    12	      q[qt++] = i;
    13	    }
    14	  }
    15	  while (qh < qt) {
    16	    int i = q[qh++];
    17	    for (int k = 0; k < nsucc[i]; k++) {
    18	      int j = succ[i][k];
    19	      int d = G[i].depth + 1;
    20	      if (d > G[j].depth) {
    21	        G[j].depth = d;
    22	      }
    23	      if (qt < MAXL * 3) {
    24	        q[qt++] = j;
    25	      }
    26	    }
    27	  }
    28	}
