    18	      int j = succ[i][k];
    19	      int d = G[i].depth + 1;
    20	      if (d > G[j].depth) {
    21	        G[j].depth = d;
    22	      }
    23	      if (qt < MAXL * 3) {
    24	        q[qt++] = j;
    25	      }
    26	    }
    27	  }
    28	}
