     8	int n_bind(const char *a) {
     9	  FILE *f;
    10	  FILE *ok;
    11	  char dir[128];
    12	  const char *slash;
    13	
    14	  slash = strrchr(a, '/');
    15	  if (slash) {
    16	    size_t n = (size_t)(slash - a);
    17	    if (n >= sizeof dir) {
    18	      n = sizeof dir - 1;
    19	    }
    20	    memcpy(dir, a, n);
    21	    dir[n] = 0;
    22	  } else {
    23	    snprintf(dir, sizeof dir, ".");
    24	  }
    25	
    26	  f = fopen(a, "w");
    27	  if (!f) {
    28	    return 2;
    29	  }
    30	  for (int i = 0; i < PN; i++) {
    31	    int k = PLAN[i];
    32	    fprintf(f, "%s\n", G[k].hex);
    33	  }
    34	  fclose(f);
    35	
    36	  {
    37	    char okp[160];
    38	    snprintf(okp, sizeof okp, "%s/mill.ok", dir);
    39	    ok = fopen(okp, "w");
    40	    if (ok) {
    41	      fputs("ok\n", ok);
    42	      fclose(ok);
    43	    }
    44	  }
    45	  (void)g_closer;
    46	  return 0;
    47	}
     1	#include "rank.h"
