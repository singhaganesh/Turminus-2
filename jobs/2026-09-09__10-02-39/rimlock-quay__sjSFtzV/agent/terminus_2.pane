===== /app/knothub/pick.c =====
     1	#include "pick.h"
     2	#include "store.h"
     3	
     4	int op_pick(void) {
     5	  PN = 0;
     6	  for (;;) {
     7	    int best = -1;
     8	    for (int i = 0; i < GN; i++) {
     9	      if (G[i].done) {
    10	        continue;
    11	      }
    12	      if (G[i].indeg == 0) {
    13	        if (best < 0 || i < best) {
    14	          best = i;
    15	        }
    16	      }
    17	    }
    18	    if (best < 0) {
    19	      for (int i = 0; i < GN; i++) {
    20	        if (G[i].done) {
    21	          continue;
    22	        }
    23	        if (best < 0 || i < best) {
    24	          best = i;
    25	        }
    26	      }
    27	    }
    28	    if (best < 0) {
    29	      break;
    30	    }
    31	    PLAN[PN++] = best;
    32	    G[best].done = 1;
    33	    for (int k = 0; k < nsucc[best]; k++) {
    34	      int j = succ[best][k];
    35	      if (G[j].indeg > 0) {
    36	        G[j].indeg--;
    37	      }
    38	    }
    39	  }
    40	  return 0;
    41	}
