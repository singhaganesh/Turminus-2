===== /app/knothub/graph.c =====
     1	#include "graph.h"
     2	#include "store.h"
     3	
     4	#include <string.h>
     5	
     6	static int find_hex(const char *hx) {
     7	  for (int i = 0; i < GN; i++) {
     8	    if (strcmp(G[i].hex, hx) == 0) {
     9	      return i;
    10	    }
    11	  }
    12	  return -1;
    13	}
    14	
    15	void graph_build(void) {
    16	  memset(succ, 0, sizeof succ);
    17	  memset(nsucc, 0, sizeof nsucc);
    18	  for (int i = 0; i < GN; i++) {
    19	    G[i].indeg = 0;
    20	    G[i].done = 0;
    21	  }
    22	  for (int i = 0; i < GN; i++) {
    23	    int w;
    24	    if (!G[i].has_wait) {
    25	      continue;
    26	    }
    27	    w = find_hex(G[i].wait_hex);
    28	    if (w < 0) {
    29	      continue;
    30	    }
    31	    /* w precedes i */
    32	    succ[w][nsucc[w]++] = i;
    33	    G[i].indeg++;
    34	  }
    35	}
