===== /app/inkfold/fold.c =====
     1	#include "fold.h"
     2	#include "../knothub/store.h"
     3	#include "../readcue/scan.h"
     4	#include "../inkurn/book.h"
     5	#include "../knothub/graph.h"
     6	#include "../knothub/pick.h"
     7	#include "../hullcue/rank.h"
     8	
     9	#include <stdint.h>
    10	#include <stdio.h>
    11	#include <string.h>
    12	
    13	int cfg_fold(const char *a) {
    14	  int buck[8];
    15	  int bnext[MAXL];
    16	  int seen[MAXL];
    17	  FILE *f;
    18	
    19	  if (GN == 0 && g_path[0]) {
    20	    if (scan_dump(g_path) != 0) {
    21	      return 2;
    22	    }
    23	  }
    24	  if (book_load("/app/inkurn/book.tsv") != 0) {
    25	    return 2;
    26	  }
    27	  graph_build();
    28	  op_pick();
    29	  rk_wrap();
    30	
    31	  for (int b = 0; b < 8; b++) {
    32	    buck[b] = -1;
    33	  }
    34	  memset(seen, 0, sizeof seen);
    35	  for (int i = 0; i < PN; i++) {
    36	    int k = PLAN[i];
    37	    unsigned h = ((unsigned)G[k].tid * 2654435761u) >> 29;
    38	    h &= 7u;
    39	    bnext[k] = buck[h];
    40	    buck[h] = k;
    41	  }
    42	
    43	  f = fopen(a, "w");
    44	  if (!f) {
    45	    return 2;
    46	  }
    47	  for (int b = 0; b < 8; b++) {
    48	    int k = buck[b];
    49	    while (k >= 0) {
    50	      if (!seen[k]) {
    51	        fprintf(f, "%u %s\n", G[k].tid, G[k].hex);
    52	        seen[k] = 1;
    53	      }
    54	      k = bnext[k];
    55	    }
    56	  }
    57	  fclose(f);
    58	  return 0;
    59	}
