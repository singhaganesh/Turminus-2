[124.409622, "o", "root@87830316844c:/app# cat > /app/knothub/graph.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"graph.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"store.h\"\r\n\u001b[?2004l\r"]
