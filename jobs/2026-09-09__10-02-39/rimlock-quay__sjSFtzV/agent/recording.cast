[21.032501, "o", "     1\t#ifndef STORE_H\r\n     2\t#define STORE_H\r\n     3\t\r\n     4\t#include <stdint.h>\r\n     5\t\r\n     6\t#define MAXL 64\r\n     7\t\r\n     8\ttypedef struct {\r\n     9\t  char hex[40];\r\n    10\t  char wait_hex[40];\r\n    11\t  uint32_t tag;\r\n    12\t  uint32_t wait_tag;\r\n    13\t  uint32_t tid;\r\n    14\t  int has_wait;\r\n    15\t  int indeg;\r\n    16\t  int done;\r\n    17\t  int depth;\r\n    18\t} LockRec;\r\n    19\t\r\n    20\textern LockRec G[MAXL];\r\n    21\textern int GN;\r\n    22\textern int g_closer;\r\n    23\textern int PLAN[MAXL];\r\n    24\textern int PN;\r\n    25\textern int succ[MAXL][MAXL];\r\n    26\textern int nsucc[MAXL];\r\n    27\textern char g_path[256];\r\n    28\t\r\n    29\tint scan_dump(const char *path);\r\n    30\tint book_load(const char *path);\r\n    31\tvoid graph_build(void);\r\n    32\tvoid roster_out(void);\r\n    33\tvoid rk_wrap(void);\r\n    34\tint assay_run(const char *dump, const char *out);\r\n    35\t\r\n    36\t#endif\r\n"]
[21.032749, "o", "===== /app/emiturn/bind.c =====\r\n"]
[21.033496, "o", "     1\t#include \"bind.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t#include <unistd.h>\r\n     7\t\r\n     8\tint n_bind(const char *a) {\r\n     9\t  FILE *f;\r\n    10\t  FILE *ok;\r\n    11\t  char dir[128];\r\n    12\t  const char *slash;\r\n    13\t\r\n    14\t  slash = strrchr(a, '/');\r\n    15\t  if (slash) {\r\n    16\t    size_t n = (size_t)(slash - a);\r\n    17\t    if (n >= sizeof dir) {\r\n    18\t      n = sizeof dir - 1;\r\n    19\t    }\r\n    20\t    memcpy(dir, a, n);\r\n    21\t    dir[n] = 0;\r\n    22\t  } else {\r\n    23\t    snprintf(dir, sizeof dir, \".\");\r\n    24\t  }\r\n    25\t\r\n    26\t  f = fopen(a, \"w\");\r\n    27\t  if (!f) {\r\n    28\t    return 2;\r\n    29\t  }\r\n    30\t  for (int i = 0; i < PN; i++) {\r\n    31\t    int k = PLAN[i];\r\n    32\t    fprintf(f, \"%s\\n\", G[k].hex);\r\n    33\t  }\r\n    34\t  fclose(f);\r\n    35\t\r\n    36\t  {\r\n    37\t    char okp[160];\r\n    38\t    snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\r\n    39\t    ok = fopen(okp, \"w\");\r\n    40\t    if (ok) {\r\n    41\t      fputs(\"ok\\n\", ok);\r\n    42\t      fclose(ok);\r\n    43\t    }\r\n    44\t  }\r\n    45\t  (void)g_closer;\r\n    46\t  return 0;\r\n"]
[21.033651, "o", "    47\t}\r\n"]
