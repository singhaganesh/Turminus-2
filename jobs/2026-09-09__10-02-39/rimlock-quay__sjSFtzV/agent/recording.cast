[21.020716, "o", "  if (scan_dump(dump) != 0) {\r\n    15\t    return 2;\r\n    16\t  }\r\n    17\t  if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n    18\t    return 2;\r\n    19\t  }\r\n    20\t  graph_build();\r\n    21\t  op_pick();\r\n    22\t  rk_wrap();\r\n    23\t  return n_bind(out);\r\n    24\t}\r\n"]
