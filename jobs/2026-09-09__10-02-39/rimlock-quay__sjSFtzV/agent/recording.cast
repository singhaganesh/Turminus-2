[21.035629, "o", "     1\t#include \"fold.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t#include \"../readcue/scan.h\"\r\n     4\t#include \"../inkurn/book.h\"\r\n     5\t#include \"../knothub/graph.h\"\r\n     6\t#include \"../knothub/pick.h\"\r\n     7\t#include \"../hullcue/rank.h\"\r\n     8\t\r\n     9\t#include <stdint.h>\r\n    10\t#include <stdio.h>\r\n    11\t#include <string.h>\r\n    12\t\r\n    13\tint cfg_fold(const char *a) {\r\n    14\t  int buck[8];\r\n    15\t  int bnext[MAXL];\r\n    16\t  int seen[MAXL];\r\n    17\t  FILE *f;\r\n    18\t\r\n    19\t  if (GN == 0 && g_path[0]) {\r\n    20\t    if (scan_dump(g_path) != 0) {\r\n    21\t      return 2;\r\n    22\t    }\r\n    23\t  }\r\n    24\t  if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n    25\t    return 2;\r\n    26\t  }\r\n    27\t  graph_build();\r\n    28\t  op_pick();\r\n    29\t  rk_wrap();\r\n    30\t\r\n    31\t  for (int b = 0; b < 8; b++) {\r\n    32\t    buck[b] = -1;\r\n    33\t  }\r\n    34\t  memset(seen, 0, sizeof seen);\r\n    35\t  for (int i = 0; i < PN; i++) {\r\n    36\t    int k = PLAN[i];\r\n    37\t    unsigned h = ((unsigned)G[k].tid * 2654435761u) >> 29;\r\n    38\t    h &= 7u;\r\n"]
[21.035765, "o", "    39\t    bnext[k] = buck[h];\r\n    40\t    buck[h] = k;\r\n    41\t  }\r\n    42\t\r\n    43\t  f = fopen(a, \"w\");\r\n    44\t  if (!f) {\r\n    45\t    return 2;\r\n    46\t  }\r\n    47\t  for (int b = 0; b < 8; b++) {\r\n    48\t    int k = buck[b];\r\n    49\t    while (k >= 0) {\r\n    50\t      if (!seen[k]) {\r\n    51\t        fprintf(f, \"%u %s\\n\", G[k].tid, G[k].hex);\r\n    52\t        seen[k] = 1;\r\n    53\t      }\r\n    54\t      k = bnext[k];\r\n"]
[21.035842, "o", "    55\t    }\r\n    56\t  }\r\n    57\t  fclose(f);\r\n    58\t  return 0;\r\n    59\t}\r\n"]
