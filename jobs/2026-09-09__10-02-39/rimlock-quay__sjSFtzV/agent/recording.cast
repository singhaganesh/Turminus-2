[124.410127, "o", "#include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.410159, "o", "static int find_tag(uint32_t tag) {\r\n\u001b[?2004l\r"]
[124.410236, "o", "\u001b[?2004h> "]
[124.410539, "o", "  for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.411132, "o", "    if (G[i].tag == tag) return i;\r\n\u001b[?2004l\r\u001b[?2004h>   return -1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void graph_build(void) {\r\n\u001b[?2004l\r\u001b[?2004h>   memset(succ, 0, sizeof succ);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.411312, "o", "  memset(nsucc, 0, sizeof nsucc);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.411395, "o", "  for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r"]
[124.411523, "o", "\u001b[?2004h"]
[124.41159, "o", ">     G[i].indeg = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     G[i].done = 0;\r\n"]
[124.411696, "o", "\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.411838, "o", "  for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r"]
[124.411966, "o", "\u001b[?2004h>     if (G[i].has_wait) {\r\n\u001b[?2004l\r"]
[124.412391, "o", "\u001b[?2004h>       int w = find_tag(G[i].wait_tag);\r\n\u001b[?2004l\r\u001b[?2004h>       if (w >= 0 && nsucc[w] < MAXL) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[124.412549, "o", "        succ[w][nsucc[w]++] = i;\r\n\u001b[?2004l\r"]
[124.412627, "o", "\u001b[?2004h> "]
[124.412709, "o", "        G[i].indeg++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[124.412823, "o", "> "]
[124.412896, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
