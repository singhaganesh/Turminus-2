[124.414505, "o", "cat > /app/hullcue/rank.c <<'EOF'\r\n\u001b[?2004l\r"]
[124.414597, "o", "\u001b[?2004h> "]
[124.416581, "o", "#include \"rank.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../knothub/store.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void rk_wrap(void) {\r\n\u001b[?2004l\r\u001b[?2004h>   for (int i = 0; i < GN; i++) G[i].depth = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   /* Bounded relaxation computes wait depth without an unbounded cycle queue. */\r\n\u001b[?2004l\r\u001b[?2004h>   for (int pass = 0; pass < GN; pass++) {\r\n\u001b[?2004l\r\u001b[?2004h>     int changed = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>       for (int k = 0; k < nsucc[i]; k++) {\r\n\u001b[?2004l\r\u001b[?2004h>         int j = succ[i][k];\r\n\u001b[?2004l\r\u001b[?2004h>         int d = G[i].depth + 1;\r\n\u001b[?2004l\r\u001b[?2004h>         if (d > GN) d = GN;\r\n\u001b[?2004l\r\u001b[?2004h>         if (d > G[j].depth) {\r\n\u001b[?2004l\r\u001b[?2004h>           G[j].depth = d;\r\n\u001b[?2004l\r\u001b[?2004h>           changed = 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (!changed) break;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
