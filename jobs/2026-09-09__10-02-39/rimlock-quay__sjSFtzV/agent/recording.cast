[34.377676, "o", "    17\t  memset(nsucc, 0, sizeof nsucc);\r\n    18\t  for (int i = 0; i < GN; i++) {\r\n    19\t    G[i].indeg = 0;\r\n    20\t    G[i].done = 0;\r\n    21\t  }\r\n    22\t  for (int i = 0; i < GN; i++) {\r\n    23\t    int w;\r\n    24\t    if (!G[i].has_wait) {\r\n    25\t      continue;\r\n    26\t    }\r\n    27\t    w = find_hex(G[i].wait_hex);\r\n    28\t    if (w < 0) {\r\n    29\t      continue;\r\n    30\t    }\r\n    31\t    /* w precedes i */\r\n    32\t    succ[w][nsucc[w]++] = i;\r\n    33\t    G[i].indeg++;\r\n    34\t  }\r\n    35\t}\r\n"]
