[21.029761, "o", "     1\t#include \"pick.h\"\r\n     2\t#include \"store.h\"\r\n     3\t\r\n     4\tint op_pick(void) {\r\n     5\t  PN = 0;\r\n     6\t  for (;;) {\r\n     7\t    int best = -1;\r\n     8\t    for (int i = 0; i < GN; i++) {\r\n     9\t      if (G[i].done) {\r\n    10\t        continue;\r\n    11\t      }\r\n    12\t      if (G[i].indeg == 0) {\r\n    13\t        if (best < 0 || i < best) {\r\n    14\t          best = i;\r\n    15\t        }\r\n    16\t      }\r\n    17\t    }\r\n    18\t    if (best < 0) {\r\n    19\t      for (int i = 0; i < GN; i++) {\r\n    20\t        if (G[i].done) {\r\n    21\t          continue;\r\n    22\t        }\r\n    23\t        if (best < 0 || i < best) {\r\n    24\t          best = i;\r\n    25\t        }\r\n    26\t      }\r\n    27\t    }\r\n    28\t    if (best < 0) {\r\n    29\t      break;\r\n    30\t    }\r\n    31\t    PLAN[PN++] = best;\r\n    32\t    G[best].done = 1;\r\n    33\t    for (int k = 0; k < nsucc[best]; k++) {\r\n    34\t      int j = succ[best][k];\r\n    35\t      if (G[j].indeg > 0) {\r\n    36\t        G[j].indeg--;\r\n    37\t      }\r\n    38\t    }\r\n    39\t  }\r\n    40\t  return 0;\r\n"]
[21.029845, "o", "    41\t}\r\n"]
