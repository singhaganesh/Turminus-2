[89.952644, "o", "\u001b[?2004h> "]
[89.952711, "o", "    if (fprintf(f, \"%u\\n\", G[PLAN[i]].tag) < 0) goto fail_output;\r\n\u001b[?2004l\r"]
[89.952774, "o", "\u001b[?2004h> "]
[89.95304, "o", "  if (fflush(f) || fsync(fileno(f)) || fclose(f)) { f = NULL; goto fail_output; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.953073, "o", "> "]
[89.953156, "o", "  f = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.953325, "o", "  if (rename(tmp, a)) { unlink(tmp); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.954194, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>   fd = mkstemp(oktmp);\r\n\u001b[?2004l\r\u001b[?2004h>   if (fd < 0) { unlink(a); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>   f = fdopen(fd, \"w\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!f) { close(fd); unlink(oktmp); unlink(a); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>   if (fputs(\"ok\\n\", f) == EOF || fflush(f) || fsync(fileno(f)) || fclose(f)) {\r\n\u001b[?2004l\r"]
[89.954422, "o", "\u001b[?2004h>     f = NULL; unlink(oktmp); unlink(a); return 2;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
