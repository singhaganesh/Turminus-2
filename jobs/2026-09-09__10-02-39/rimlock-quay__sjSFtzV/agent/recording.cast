[124.38852, "i", "sed -i 's/char dir\\[PATH_MAX\\], ok\\[PATH_MAX\\]/char dir[4096], ok[4096]/' /app/hullcue/go.c\nsed -i 's/char tmp\\[PATH_MAX\\], dir\\[PATH_MAX\\], okp\\[PATH_MAX\\], oktmp\\[PATH_MAX\\]/char tmp[4096], dir[4096], okp[4096], oktmp[4096]/' /app/emiturn/bind.c\nsed -i 's/char tmp\\[PATH_MAX\\]/char tmp[4096]/' /app/inkfold/fold.c\ncat > /app/knothub/graph.c <<'EOF'\n#include \"graph.h\"\n#include \"store.h\"\n\n#include <string.h>\n\nstatic int find_tag(uint32_t tag) {\n  for (int i = 0; i < GN; i++)\n    if (G[i].tag == tag) return i;\n  return -1;\n}\n\nvoid graph_build(void) {\n  memset(succ, 0, sizeof succ);\n  memset(nsucc, 0, sizeof nsucc);\n  for (int i = 0; i < GN; i++) {\n    G[i].indeg = 0;\n    G[i].done = 0;\n  }\n  for (int i = 0; i < GN; i++) {\n    if (G[i].has_wait) {\n      int w = find_tag(G[i].wait_tag);\n      if (w >= 0 && nsucc[w] < MAXL) {\n        succ[w][nsucc[w]++] = i;\n        G[i].indeg++;\n      }\n    }\n  }\n}\nEOF\ncat > /app/hullcue/rank.c <<'EOF'\n#include \"rank.h\"\n#include \"../knothub/store.h\"\n\nvoid rk_wrap(void) {\n  for (int i = 0; i < GN; i++) G[i].depth = 0;\n  /* Bounded relaxation computes wait depth without an unbounded cycle queue. */\n  for (int pass = 0; pass < GN; pass++) {\n    int changed = 0;\n    for (int i = 0; i < GN; i++) {\n      for (int k = 0; k < nsucc[i]; k++) {\n        int j = succ[i][k];\n        int d = G[i].depth + 1;\n        if (d > GN) d = GN;\n        if (d > G[j].depth) {\n          G[j].depth = d;\n          changed = 1;\n        }\n      }\n    }\n    if (!changed) break;\n  }\n}\nEOF\nrm -f /app/hullcue/*.o /app/readcue/*.o /app/knothub/*.o /app/inkurn/*.o /app/emiturn/*.o /app/inkfold/*.o\nmake -C /app/hullcue -f /app/hullcue/hull.mk hull\n"]
