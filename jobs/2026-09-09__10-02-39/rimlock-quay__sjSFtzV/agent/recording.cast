[34.37922, "o", "===== /app/knothub/pick.c =====\r\n"]
[34.381097, "o", "     1\t#include \"pick.h\"\r\n     2\t#include \"store.h\"\r\n     3\t\r\n     4\tint op_pick(void) {\r\n     5\t  PN = 0;\r\n     6\t  for (;;) {\r\n     7\t    int best = -1;\r\n     8\t    for (int i = 0; i < GN; i++) {\r\n     9\t      if (G[i].done) {\r\n    10\t        continue;\r\n    11\t      }\r\n    12\t      if (G[i].indeg == 0) {\r\n    13\t        if (best < 0 || i < best) {\r\n    14\t          best = i;\r\n    15\t        }\r\n    16\t      }\r\n    17\t    }\r\n    18\t    if (best < 0) {\r\n    19\t      for (int i = 0; i < GN; i++) {\r\n    20\t        if (G[i].done) {\r\n    21\t          continue;\r\n    22\t        }\r\n    23\t        if (best < 0 || i < best) {\r\n    24\t          best = i;\r\n    25\t        }\r\n    26\t      }\r\n    27\t    }\r\n    28\t    if (best < 0) {\r\n    29\t      break;\r\n    30\t    }\r\n    31\t    PLAN[PN++] = best;\r\n    32\t    G[best].done = 1;\r\n    33\t    for (int k = 0; k < nsucc[best]; k++) {\r\n    34\t      int j = succ[best][k];\r\n    35\t      if (G[j].indeg > 0) {\r\n    36\t        G[j].indeg--;\r\n    37\t      }\r\n    38\t    }\r\n    39\t  }\r\n    40\t  return 0;\r\n    41\t}\r\n"]
[34.381894, "o", "===== /app/knothub/cycle.c =====\r\n"]
[34.383704, "o", "     1\t#include \"store.h\"\r\n     2\t#include \"../inkurn/book.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n     6\t#include <string.h>\r\n     7\t\r\n     8\tstatic int cmp_u(const void *a, const void *b) {\r\n     9\t  uint32_t x = *(const uint32_t *)a;\r\n    10\t  uint32_t y = *(const uint32_t *)b;\r\n    11\t  if (x < y) {\r\n    12\t    return -1;\r\n    13\t  }\r\n    14\t  if (x > y) {\r\n"]
[34.383767, "o", "    15\t    return 1;\r\n    16\t  }\r\n    17\t  return 0;\r\n    18\t}\r\n    19\t\r\n    20\tvoid roster_out(void) {\r\n    21\t  uint32_t cyc[MAXL];\r\n    22\t  int cn = 0;\r\n    23\t  int seen[MAXL];\r\n    24\t\r\n    25\t  memset(seen, 0, sizeof seen);\r\n    26\t  for (int i = 0; i < GN; i++) {\r\n    27\t    if (G[i].has_wait) {\r\n    28\t      int w = -1;\r\n    29\t      for (int j = 0; j < GN; j++) {\r\n    30\t        if (strcmp(G[j].hex, G[i].wait_hex) == 0) {\r\n    31\t          w = j;\r\n    32\t          break;\r\n    33\t        }\r\n    34\t      }\r\n    35\t      if (w >= 0 && G[w].has_wait && strcmp(G[w].wait_hex, G[i].hex) == 0) {\r\n"]
[34.383785, "o", "    36\t        if (!seen[i]) {\r\n    37\t          cyc[cn++] = G[i].tag;\r\n    38\t          seen[i] = 1;\r\n    39\t        }\r\n    40\t        if (!seen[w]) {\r\n    41\t          cyc[cn++] = G[w].tag;\r\n"]
[34.383799, "o", "    42\t          seen[w] = 1;\r\n    43\t        }\r\n    44\t      }\r\n"]
[34.383813, "o", "    45\t    }\r\n    46\t  }\r\n    47\t  qsort(cyc, (size_t)cn, sizeof cyc[0], cmp_u);\r\n    48\t  fputs(\"CYCLE\", stdout);\r\n    49\t  for (int i = 0; i < cn; i++) {\r\n    50\t    printf(\" %u\", cyc[i]);\r\n"]
[34.383827, "o", "    51\t  }\r\n    52\t  fputc('\\n', stdout);\r\n    53\t  for (int i = 0; i < GN; i++) {\r\n"]
[34.383841, "o", "    54\t    printf(\"OWNER %u=%u\\n\", G[i].tag, G[i].tid);\r\n    55\t  }\r\n    56\t}\r\n"]
[34.384459, "o", "\u001b[?2004hroot@87830316844c:/app# "]
[35.381923, "i", "nl -ba /app/emiturn/bind.c; nl -ba /app/hullcue/rank.c; ls -ld /app/planbay /app/scrollbay 2>&1\n"]
[35.382671, "o", "nl -ba /app/emiturn/bind.c; nl -ba /app/hullcue/rank.c; ls -ld /app/planbay /app/scrollbay 2>&1\r\n\u001b[?2004l\r"]
[35.384335, "o", "     1\t#include \"bind.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t#include <unistd.h>\r\n     7\t\r\n     8\tint n_bind(const char *a) {\r\n     9\t  FILE *f;\r\n    10\t  FILE *ok;\r\n    11\t  char dir[128];\r\n    12\t  const char *slash;\r\n    13\t\r\n    14\t  slash = strrchr(a, '/');\r\n    15\t  if (slash) {\r\n    16\t    size_t n = (size_t)(slash - a);\r\n    17\t    if (n >= sizeof dir) {\r\n    18\t      n = sizeof dir - 1;\r\n    19\t    }\r\n    20\t    memcpy(dir, a, n);\r\n    21\t    dir[n] = 0;\r\n"]
[35.384499, "o", "    22\t  } else {\r\n    23\t    snprintf(dir, sizeof dir, \".\");\r\n    24\t  }\r\n    25\t\r\n    26\t  f = fopen(a, \"w\");\r\n    27\t  if (!f) {\r\n    28\t    return 2;\r\n    29\t  }\r\n    30\t  for (int i = 0; i < PN; i++) {\r\n    31\t    int k = PLAN[i];\r\n    32\t    fprintf(f, \"%s\\n\", G[k].hex);\r\n    33\t  }\r\n    34\t  fclose(f);\r\n    35\t\r\n    36\t  {\r\n    37\t    char okp[160];\r\n    38\t    snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\r\n    39\t    ok = fopen(okp, \"w\");\r\n    40\t    if (ok) {\r\n    41\t      fputs(\"ok\\n\", ok);\r\n    42\t      fclose(ok);\r\n    43\t    }\r\n    44"]
[35.384613, "o", "\t  }\r\n    45\t  (void)g_closer;\r\n    46\t  return 0;\r\n    47\t}\r\n"]
[35.385983, "o", "     1\t#include \"rank.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\tvoid rk_wrap(void) {\r\n     5\t  int q[MAXL];\r\n     6\t  int qh = 0;\r\n     7\t  int qt = 0;\r\n     8\t\r\n     9\t  for (int i = 0; i < GN; i++) {\r\n    10\t    G[i].depth = 0;\r\n    11\t    if (!G[i].has_wait) {\r\n    12\t      q[qt++] = i;\r\n"]
[35.386171, "o", "    13\t    }\r\n    14\t  }\r\n    15\t  while (qh < qt) {\r\n    16\t    int i = q[qh++];\r\n    17\t    for (int k = 0; k < nsucc[i]; k++) {\r\n    18\t      int j = succ[i][k];\r\n    19\t      int d = G[i].depth + 1;\r\n    20\t      if (d > G[j].depth) {\r\n    21\t        G[j].depth = d;\r\n    22\t      }\r\n    23\t      if (qt < MAXL * 3) {\r\n    24\t        q[qt++] = j;\r\n    25\t      }\r\n    26\t    }\r\n    27\t  }\r\n    28\t}\r\n"]
[35.388095, "o", "drwxr-xr-x 1 root root 4096 Sep  9 04:33 /app/planbay\r\ndrwxr-xr-x 1 root root 4096 Sep  9 04:33 /app/scrollbay\r\n"]
[35.388496, "o", "\u001b[?2004h"]
[35.388616, "o", "root@87830316844c:/app# "]
[89.667952, "i", "cat > /app/readcue/scan.c <<'EOF'\n#include \"scan.h\"\n#include \"../knothub/store.h\"\n\n#include <errno.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic void reset_g(void) {\n  memset(G, 0, sizeof G);\n  GN = 0;\n  g_closer = 0;\n  PN = 0;\n}\n\nstatic int parse_tid(const char *s, uint32_t *v) {\n  char *end;\n  unsigned long n;\n  errno = 0;\n  n = strtoul(s, &end, 10);\n  if (errno || end == s || *end != '\\0' || n > UINT32_MAX) return -1;\n  *v = (uint32_t)n;\n  return 0;\n}\n\nint scan_dump(const char *path) {\n  FILE *f;\n  char line[160];\n  int open = 0;\n  int have_own = 0;\n\n  reset_g();\n  f = fopen(path, \"r\");\n  if (!f) return 2;\n\n  while (fgets(line, sizeof line, f)) {\n    size_t n = strlen(line);\n    if (n && line[n - 1] == '\\n') line[--n] = '\\0';\n    else if (!feof(f)) goto bad;\n    if (n && line[n - 1] == '\\r') line[--n] = '\\0';\n    if (!line[0]) continue;\n\n    if (!strncmp(line, \"THREAD \", 7)) {\n      if (open || GN >= MAXL || parse_tid(line + 7, &G[GN].tid)) goto bad;\n      open = 1;\n      have_own = 0;\n      GN++;\n    } else if (!strcmp(line, \".\")) {\n      if (!open || !have_own) goto bad;\n      open = 0;\n      g_closer = 1;\n    } else if (!strncmp(line, \"OWN \", 4)) {\n      if (!open || have_own || !line[4]) goto bad;\n      if (strlen(line + 4) >= sizeof G[0].hex) goto bad;\n      strcpy(G[GN - 1].hex, line + 4);\n      have_own = 1;\n    } else if (!strncmp(line, \"WAIT \", 5)) {\n      if (!open || G[GN - 1].has_wait || !line[5]) goto bad;\n      if (strlen(line + 5) >= sizeof G[0].wait_hex) goto bad;\n      strcpy(G[GN - 1].wait_hex, line + 5);\n      G[GN - 1].has_wait = 1;\n    } else {\n      goto bad;\n    }\n  }\n  if (ferror(f) || open || GN == 0) goto bad;\n  fclose(f);\n  return 0;\n\nbad:\n  fclose(f);\n  g_closer = 0;\n  return 2;\n}\nEOF\n\ncat > /app/inkurn/book.c <<'EOF'\n#include \"book.h\"\n#include \"../knothub/store.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nint book_load(const char *path) {\n  FILE *f;\n  char line[160], hx[40], extra;\n  unsigned id;\n\n  for (int i = 0; i < GN; i++) {\n    G[i].tag = 0;\n    G[i].wait_tag = 0;\n  }\n  f = fopen(path, \"r\");\n  if (!f) return 2;\n  while (fgets(line, sizeof line, f)) {\n    if (sscanf(line, \"%39s %u %c\", hx, &id, &extra) != 2) continue;\n    if (!strcmp(hx, \"hex\")) continue;\n    for (int i = 0; i < GN; i++) {\n      if (!strcmp(G[i].hex, hx)) G[i].tag = id;\n      if (G[i].has_wait && !strcmp(G[i].wait_hex, hx)) G[i].wait_tag = id;\n    }\n  }\n  if (ferror(f)) { fclose(f); return 2; }\n  fclose(f);\n  for (int i = 0; i < GN; i++) {\n    if (!G[i].tag || (G[i].has_wait && !G[i].wait_tag)) return 2;\n  }\n  return 0;\n}\nEOF\n\ncat > /app/knothub/pick.c <<'EOF'\n#include \"pick.h\"\n#include \"store.h\"\n\nstatic int earlier(int a, int b) {\n  return b < 0 || G[a].tag < G[b].tag ||\n         (G[a].tag == G[b].tag && G[a].tid < G[b].tid) ||\n         (G[a].tag == G[b].tag && G[a].tid == G[b].tid && a < b);\n}\n\nint op_pick(void) {\n  PN = 0;\n  for (;;) {\n    int best = -1;\n    for (int i = 0; i < GN; i++)\n      if (!G[i].done && G[i].indeg == 0 && earlier(i, best)) best = i;\n\n    /* No releasable node means a cycle. Break it deterministically. */\n    if (best < 0)\n      for (int i = 0; i < GN; i++)\n        if (!G[i].done && earlier(i, best)) best = i;\n\n    if (best < 0) break;\n    PLAN[PN++] = best;\n    G[best].done = 1;\n    for (int k = 0; k < nsucc[best]; k++) {\n      int j = succ[best][k];\n      if (G[j].indeg > 0) G[j].indeg--;\n    }\n  }\n  return PN == GN ? 0 : 2;\n}\nEOF\n"]
