[89.677437, "o", "\u001b[?2004h> bad:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.677553, "o", "  fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.677673, "o", "  g_closer = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.677765, "o", "  return 2;\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.677848, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[89.679329, "o", "\u001b[?2004hroot@87830316844c:/app# \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.679447, "o", "root@87830316844c:/app# "]
[89.679509, "o", "cat > /app/inkurn/book.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.679567, "o", "#include \"book.h\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.679616, "o", "> "]
[89.679692, "o", "#include \"../knothub/store.h\"\r\n\u001b[?2004l\r"]
[89.679745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.679794, "o", "\u001b[?2004h> "]
[89.67984, "o", "#include <stdio.h>\r\n\u001b[?2004l\r"]
[89.679885, "o", "\u001b[?2004h> "]
[89.679955, "o", "#include <string.h>\r\n\u001b[?2004l\r"]
[89.679999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.68006, "o", "\u001b[?2004h> "]
[89.680156, "o", "int book_load(const char *path) {\r\n\u001b[?2004l\r"]
[89.680205, "o", "\u001b[?2004h> "]
[89.680251, "o", "  FILE *f;\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.680293, "o", "> "]
[89.680375, "o", "  char line[160], hx[40], extra;\r\n\u001b[?2004l\r"]
[89.680419, "o", "\u001b[?2004h> "]
[89.680463, "o", "  unsigned id;\r\n\u001b[?2004l\r"]
[89.680508, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[89.68056, "o", "\u001b[?2004h> "]
[89.68067, "o", "  for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r"]
[89.680716, "o", "\u001b[?2004h> "]
[89.680776, "o", "    G[i].tag = 0;\r\n\u001b[?2004l\r"]
[89.68082, "o", "\u001b[?2004h> "]
[89.680877, "o", "    G[i].wait_tag = 0;\r\n\u001b[?2004l\r"]
[89.680921, "o", "\u001b[?2004h> "]
[89.680967, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.681011, "o", "> "]
[89.681076, "o", "  f = fopen(path, \"r\");\r\n\u001b[?2004l\r"]
[89.681125, "o", "\u001b[?2004h> "]
[89.681193, "o", "  if (!f) return 2;\r\n\u001b[?2004l\r"]
[89.681241, "o", "\u001b[?2004h> "]
[89.681359, "o", "  while (fgets(line, sizeof line, f)) {\r\n\u001b[?2004l\r"]
[89.681405, "o", "\u001b[?2004h> "]
[89.681589, "o", "    if (sscanf(line, \"%39s %u %c\", hx, &id, &extra) != 2) continue;\r\n\u001b[?2004l\r"]
[89.681686, "o", "\u001b[?2004h> "]
[89.681772, "o", "    if (!strcmp(hx, \"hex\")) continue;\r\n\u001b[?2004l\r"]
[89.681852, "o", "\u001b[?2004h> "]
[89.682072, "o", "    for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.682186, "o", "      if (!strcmp(G[i].hex, hx)) G[i].tag = id;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.682425, "o", "      if (G[i].has_wait && !strcmp(G[i].wait_hex, hx)) G[i].wait_tag = id;\r\n\u001b[?2004l\r"]
[89.682496, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.682566, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.682646, "o", "  if (ferror(f)) { fclose(f); return 2; }\r\n\u001b[?2004l\r"]
[89.682713, "o", "\u001b[?2004h>   fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.682806, "o", "  for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r"]
[89.682885, "o", "\u001b[?2004h> "]
[89.682998, "o", "    if (!G[i].tag || (G[i].has_wait && !G[i].wait_tag)) return 2;\r\n\u001b[?2004l\r"]
[89.683103, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.683177, "o", "  return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.683251, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[89.684771, "o", "\u001b[?2004hroot@87830316844c:/app# \r\n\u001b[?2004l\r"]
[89.684898, "o", "\u001b[?2004hroot@87830316844c:/app# cat > /app/knothub/pick.c <<'EOF'\r\n\u001b[?2004l\r"]
[89.685013, "o", "\u001b[?2004h> #include \"pick.h\"\r\n\u001b[?2004l\r"]
[89.6851, "o", "\u001b[?2004h> "]
[89.685177, "o", "#include \"store.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[89.685246, "o", "> "]
[89.685312, "o", "static int earlier(int a, int b) {\r\n\u001b[?2004l\r"]
[89.685413, "o", "\u001b[?2004h> "]
[89.685498, "o", "  return b < 0 || G[a].tag < G[b].tag ||\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.685578, "o", "> "]
[89.685734, "o", "         (G[a].tag == G[b].tag && G[a].tid < G[b].tid) ||\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.685954, "o", "         (G[a].tag == G[b].tag && G[a].tid == G[b].tid && a < b);\r\n\u001b[?2004l\r"]
[89.685984, "o", "\u001b[?2004h> "]
[89.686003, "o", "}\r\n\u001b[?2004l\r"]
[89.686159, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int op_pick(void) {\r\n\u001b[?2004l\r"]
[89.686243, "o", "\u001b[?2004h> "]
[89.686319, "o", "  PN = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   for (;;) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.686384, "o", "    int best = -1;\r\n\u001b[?2004l\r"]
[89.686536, "o", "\u001b[?2004h> "]
[89.68661, "o", "    for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.686709, "o", "      if (!G[i].done && G[i].indeg == 0 && earlier(i, best)) best = i;\r\n\u001b[?2004l\r"]
[89.686782, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.686956, "o", "    /* No releasable node means a cycle. Break it deterministically. */\r\n\u001b[?2004l\r"]
[89.687048, "o", "\u001b[?2004h> "]
[89.68708, "o", "    if (best < 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.687254, "o", "      for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.687435, "o", "        if (!G[i].done && earlier(i, best)) best = i;\r\n\u001b[?2004l\r"]
[89.687532, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.687625, "o", "    if (best < 0) break;\r\n\u001b[?2004l\r"]
[89.687714, "o", "\u001b[?2004h> "]
[89.687788, "o", "    PLAN[PN++] = best;\r\n\u001b[?2004l\r\u001b[?2004h"]
[89.687896, "o", ">     G[best].done = 1;\r\n\u001b[?2004l\r"]
[89.687973, "o", "\u001b[?2004h> "]
[89.688119, "o", "    for (int k = 0; k < nsucc[best]; k++) {\r\n\u001b[?2004l\r"]
[89.688199, "o", "\u001b[?2004h> "]
[89.688272, "o", "      int j = succ[best][k];\r\n\u001b[?2004l\r"]
[89.688328, "o", "\u001b[?2004h> "]
[89.688484, "o", "      if (G[j].indeg > 0) G[j].indeg--;\r\n\u001b[?2004l\r"]
[89.688569, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[89.688634, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[89.688692, "o", "\u001b[?2004h> "]
[89.68876, "o", "  return PN == GN ? 0 : 2;\r\n\u001b[?2004l\r"]
[89.688856, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.68893, "o", "EOF\r\n\u001b[?2004l\r"]
[89.691437, "o", "\u001b[?2004hroot@87830316844c:/app# "]
[89.947851, "i", "cat > /app/emiturn/bind.c <<'EOF'\n#define _POSIX_C_SOURCE 200809L\n#include \"bind.h\"\n#include \"../knothub/store.h\"\n\n#include <limits.h>\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nint n_bind(const char *a) {\n  char tmp[PATH_MAX], dir[PATH_MAX], okp[PATH_MAX], oktmp[PATH_MAX];\n  const char *slash = strrchr(a, '/');\n  FILE *f;\n  int fd;\n\n  if (!g_closer || PN != GN) return 2;\n  if (slash) {\n    size_t n = (size_t)(slash - a);\n    if (n == 0) n = 1;\n    if (n >= sizeof dir) return 2;\n    memcpy(dir, a, n);\n    dir[n] = '\\0';\n  } else strcpy(dir, \".\");\n  if (snprintf(tmp, sizeof tmp, \"%s.tmp.XXXXXX\", a) >= (int)sizeof tmp ||\n      snprintf(okp, sizeof okp, \"%s/mill.ok\", dir) >= (int)sizeof okp ||\n      snprintf(oktmp, sizeof oktmp, \"%s.tmp.XXXXXX\", okp) >= (int)sizeof oktmp)\n    return 2;\n\n  fd = mkstemp(tmp);\n  if (fd < 0) return 2;\n  f = fdopen(fd, \"w\");\n  if (!f) { close(fd); unlink(tmp); return 2; }\n  for (int i = 0; i < PN; i++)\n    if (fprintf(f, \"%u\\n\", G[PLAN[i]].tag) < 0) goto fail_output;\n  if (fflush(f) || fsync(fileno(f)) || fclose(f)) { f = NULL; goto fail_output; }\n  f = NULL;\n  if (rename(tmp, a)) { unlink(tmp); return 2; }\n\n  fd = mkstemp(oktmp);\n  if (fd < 0) { unlink(a); return 2; }\n  f = fdopen(fd, \"w\");\n  if (!f) { close(fd); unlink(oktmp); unlink(a); return 2; }\n  if (fputs(\"ok\\n\", f) == EOF || fflush(f) || fsync(fileno(f)) || fclose(f)) {\n    f = NULL; unlink(oktmp); unlink(a); return 2;\n  }\n  if (rename(oktmp, okp)) { unlink(oktmp); unlink(a); return 2; }\n  return 0;\n\nfail_output:\n  if (f) fclose(f);\n  unlink(tmp);\n  return 2;\n}\nEOF\n\ncat > /app/inkfold/fold.c <<'EOF'\n#define _POSIX_C_SOURCE 200809L\n#include \"fold.h\"\n#include \"../knothub/store.h\"\n#include \"../inkurn/book.h\"\n#include \"../knothub/graph.h\"\n#include \"../knothub/pick.h\"\n#include \"../hullcue/rank.h\"\n\n#include <limits.h>\n#include <stdio.h>\n#include <unistd.h>\n\nint cfg_fold(const char *a) {\n  char tmp[PATH_MAX];\n  FILE *f;\n  int fd;\n\n  if (!g_closer || book_load(\"/app/inkurn/book.tsv\") != 0) return 2;\n  graph_build();\n  if (op_pick() != 0) return 2;\n  rk_wrap();\n  if (snprintf(tmp, sizeof tmp, \"%s.tmp.XXXXXX\", a) >= (int)sizeof tmp) return 2;\n  fd = mkstemp(tmp);\n  if (fd < 0) return 2;\n  f = fdopen(fd, \"w\");\n  if (!f) { close(fd); unlink(tmp); return 2; }\n  for (int i = 0; i < PN; i++) {\n    int k = PLAN[i];\n    if (fprintf(f, \"%u %u\\n\", G[k].tid, G[k].tag) < 0) goto fail;\n  }\n  if (fflush(f) || fsync(fileno(f)) || fclose(f)) { f = NULL; goto fail; }\n  f = NULL;\n  if (rename(tmp, a)) { unlink(tmp); return 2; }\n  return 0;\nfail:\n  if (f) fclose(f);\n  unlink(tmp);\n  return 2;\n}\nEOF\n\ncat > /app/hullcue/go.c <<'EOF'\n#include \"../knothub/store.h\"\n#include \"../readcue/scan.h\"\n#include \"../inkurn/book.h\"\n#include \"../knothub/graph.h\"\n#include \"../knothub/pick.h\"\n#include \"../emiturn/bind.h\"\n#include \"rank.h\"\n\n#include <limits.h>\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic void clear_outputs(const char *out) {\n  char dir[PATH_MAX], ok[PATH_MAX];\n  const char *slash = strrchr(out, '/');\n  unlink(out);\n  if (slash) {\n    size_t n = (size_t)(slash - out);\n    if (n == 0) n = 1;\n    if (n >= sizeof dir) return;\n    memcpy(dir, out, n); dir[n] = '\\0';\n  } else strcpy(dir, \".\");\n  if (snprintf(ok, sizeof ok, \"%s/mill.ok\", dir) < (int)sizeof ok) unlink(ok);\n}\n\nint assay_run(const char *dump, const char *out) {\n  clear_outputs(out);\n  snprintf(g_path, sizeof g_path, \"%s\", dump);\n  if (scan_dump(dump) != 0 || !g_closer) return 2;\n  if (book_load(\"/app/inkurn/book.tsv\") != 0) return 2;\n  graph_build();\n  if (op_pick() != 0) return 2;\n  rk_wrap();\n  return n_bind(out);\n}\nEOF\nmake -C /app/hullcue -f /app/hullcue/hull.mk clean 2>/dev/null || true; make -C /app/hullcue -f /app/hullcue/hull.mk hull\n"]
