[33.390218, "o", "    15\tint scan_dump(const char *path) {\r\n    16\t  FILE *f;\r\n    17\t  char line[160];\r\n    18\t  int open = 0;\r\n    19\t\r\n    20\t  reset_g();\r\n    21\t  f = fopen(path, \"r\");\r\n    22\t  if (!f) {\r\n    23\t    return 2;\r\n    24\t  }\r\n    25\t  while (fgets(line, sizeof line, f)) {\r\n    26\t    char *nl = strchr(line, '\\n');\r\n    27\t    if (nl) {\r\n    28\t      *nl = 0;\r\n    29\t    }\r\n    30\t    if (line[0] == 0) {\r\n    31\t      continue;\r\n    32\t    }\r\n    33\t    if (strncmp(line, \"THREAD \", 7) == 0) {\r\n    34\t      if (open) {\r\n    35\t        g_closer = 0;\r\n    36\t      }\r\n    37\t      if (GN >= MAXL) {\r\n    38\t        fclose(f);\r\n    39\t        return 2;\r\n    40\t      }\r\n    41\t      G[GN].tid = (uint32_t)atoi(line + 7);\r\n    42\t      open = 1;\r\n    43\t      GN++;\r\n    44\t      continue;\r\n    45\t    }\r\n    46\t    if (!open) {\r\n    47\t      continue;\r\n    48\t    }\r\n    49\t    if (strncmp(line, \"OWN \", 4) == 0) {\r\n    50\t      snprintf(G[GN - 1].hex, sizeof G[GN - 1].hex, \"%s\", line + 4);\r\n    51\t      continue;\r\n    52\t    }\r\n    53\t    if (strncmp(line, \"WAIT \", 5) == 0) {\r\n    54\t      snprintf(G[GN - 1].wait_hex, sizeof G[GN - 1].wait_hex, \"%s\", line + 5);\r\n    55\t      G[GN - 1].has_wait = 1;\r\n    56\t      continue;\r\n    57\t    }\r\n    58\t    if (strcmp(line, \".\") == 0) {\r\n    59\t      open = 0;\r\n    60\t      continue;\r\n    61\t    }\r\n    62\t  }\r\n    63\t  fclose(f);\r\n    64\t  if (open) {\r\n"]
[33.390362, "o", "    65\t    g_closer = 0;\r\n    66\t  }\r\n    67\t  return GN > 0 ? 0 : 2;\r\n    68\t}\r\n"]
