[20.455228, "o", "--- depth ---\r\n"]
[20.458762, "o", "Wait-depth ranking already wraps unjam emit. Equal depth keeps the current list. Desk workers enable this wrap when plans look shuffled.\r\n"]
[20.458973, "o", "--- stoke ---\r\n"]
[20.460061, "o", "#!/bin/bash\r\nset -euo pipefail\r\nmkdir -p /app/bin /app/planbay /app/scrollbay\r\nmake -C /app/hullcue -f hull.mk hull\r\n"]
[20.460277, "o", "--- make ---\r\n"]
[20.461143, "o", "CC = gcc\r\nCFLAGS = -O0 -g -Wall -std=c11 -I/app\r\nHULLBIN ?= /app/bin/rimlock\r\nOBJS = main.o go.o rank.o \\\r\n\t../knothub/store.o ../knothub/graph.o ../knothub/pick.o ../knothub/cycle.o \\\r\n\t../readcue/scan.o \\\r\n\t../inkurn/book.o \\\r\n\t../emiturn/bind.o \\\r\n\t../inkfold/fold.o\r\n\r\nhull: $(OBJS)\r\n\t$(CC) $(CFLAGS) -o $(HULLBIN) $(OBJS)\r\n\r\n%.o: %.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../knothub/%.o: ../knothub/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../readcue/%.o: ../readcue/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../inkurn/%.o: ../inkurn/%.c\r\n\t"]
[20.461247, "o", "$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../emiturn/%.o: ../emiturn/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../inkfold/%.o: ../inkfold/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n"]
