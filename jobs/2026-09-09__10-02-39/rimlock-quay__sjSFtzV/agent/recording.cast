[89.952201, "o", "\u001b[?2004h>       snprintf(oktmp, sizeof oktmp, \"%s.tmp.XXXXXX\", okp) >= (int)sizeof oktmp)\r\n\u001b[?2004l\r\u001b[?2004h>     return 2;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   fd = mkstemp(tmp);\r\n\u001b[?2004l\r\u001b[?2004h>   if (fd < 0) return 2;\r\n\u001b[?2004l\r\u001b[?2004h>   f = fdopen(fd, \"w\");\r\n\u001b[?2004l\r"]
