Sending keys: ['cat > /app/shardfold/read.rs <<\'EOF\'\nuse std::fs;\n\npub fn list(root: &str) -> Vec<(i32, String)> {\n    let mut files = Vec::new();\n    let entries = match fs::read_dir(root) {\n        Ok(entries) => entries,\n        Err(_) => return files,\n    };\n    for entry in entries.flatten() {\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with(\'d\') || !name.ends_with(".tbl") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|b| b.is_ascii_digit()) {\n            continue;\n        }\n        if let Ok(day) = digits.parse::<i32>() {\n            if entry.file_type().map(|t| t.is_file()).unwrap_or(false) {\n                files.push((day, entry.path().to_string_lossy().into_owned()));\n            }\n        }\n    }\n    files.sort_by_key(|x| x.0);\n    files\n}\n\npub fn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\nEOF\ncat > /app/urncue/fold.rs <<\'EOF\'\n#[path = "../hopcue/rim.rs"]\nmod rim;\n#[path = "../restpit/soak.rs"]\nmod soak;\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list("/app/daywell"));\n\n    let _ = fs::remove_dir_all("/app/packbay/stage");\n    let _ = fs::remove_dir_all("/app/packbay/latest");\n    fs::create_dir_all("/app/packbay/stage").map_err(|_| 1)?;\n    fs::create_dir_all("/app/packbay/latest").map_err(|_| 1)?;\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let mut packed = Vec::new();\n    let mut taken = 0;\n    for (day, source) in picked {\n        taken += read::nlines(&source)?;\n        let name = format!("d{:08}.tbl", day);\n        let staged = format!("/app/packbay/stage/{}", name);\n        fs::copy(&source, &staged).map_err(|_| 1)?;\n        packed.push((day, staged));\n    }\n    soak::soak(&packed, "/app/packbay/latest")?;\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write(\n        "/app/bloturn/ledger.json",\n        format!("{{\\"taken\\":{}}}", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
Sending keys: ['cat > /app/millrib/gait.rs <<\'EOF\'\nuse std::fs;\n\nfn rows(text: &str) -> Vec<&str> {\n    text.lines().map(str::trim).filter(|line| !line.is_empty()).collect()\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let template = fs::read_to_string("/app/millrib/sheet.tpl").map_err(|_| 1)?;\n    let output = template\n        .replace("__P__", probe)\n        .replace("__M__", &matched.to_string())\n        .replace("__T__", &taken.to_string());\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/check.json", output).map_err(|_| 1)\n}\n\npub fn gait(expected: i32, packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    if packed.is_empty() {\n        return 1;\n    }\n\n    let mut taken = 0i32;\n    let mut matched = 0i32;\n    let mut probe = String::new();\n    let mut valid = true;\n    for (day, _) in packed {\n        let name = format!("d{:08}.tbl", day);\n        let source_path = format!("/app/daywell/{}", name);\n        let restored_path = format!("/app/packbay/latest/{}", name);\n        let source = match fs::read_to_string(&source_path) {\n            Ok(text) => text,\n            Err(_) => return 1,\n        };\n        let restored = match fs::read_to_string(&restored_path) {\n            Ok(text) => text,\n            Err(_) => return 1,\n        };\n        let source_rows = rows(&source);\n        let restored_rows = rows(&restored);\n        taken += source_rows.len() as i32;\n        matched += source_rows\n            .iter()\n            .zip(restored_rows.iter())\n            .filter(|(a, b)| a == b)\n            .count() as i32;\n        if source_rows != restored_rows {\n            valid = false;\n        }\n        if !source_rows.is_empty() {\n            probe = source_path;\n        }\n    }\n\n    if probe.is_empty() {\n        return 1;\n    }\n    if emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if !valid || taken != expected || matched != taken {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/wickmill/boot.rs <<\'EOF\'\n#[path = "../urncue/fold.rs"]\nmod fold;\n#[path = "../millrib/gait.rs"]\nmod gait;\n#[path = "../lidcue/skip.rs"]\nmod skip;\n#[path = "../corkpit/floor.rs"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != "clasp" {\n        eprintln!("usage: dewkiln clasp");\n        std::process::exit(2);\n    }\n    let _ = std::fs::remove_file("/app/bloturn/GUARD");\n    let _ = std::fs::remove_file("/app/bloturn/check.json");\n    let code = match fold::fold() {\n        Ok((packed, taken)) => {\n            let mut ordered = packed.clone();\n            skip::skip(&mut ordered);\n            if !floor::floor(taken) {\n                1\n            } else {\n                gait::gait(taken, &ordered)\n            }\n        }\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\n/app/bin/dewkiln clasp; rc=$?; echo "RC=$rc"; echo \'--- artifacts ---\'; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do echo "### $f"; cat "$f" 2>/dev/null || echo MISSING; echo; done; echo \'--- latest rows ---\'; for f in /app/packbay/latest/*; do printf \'%s \' "$(basename "$f")"; awk \'END {print NR}\' "$f"; done\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
