[37.493896, "o", "\u001b[?2004hroot@f90bf9568b53:/app# "]
[78.50719, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], destination: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(destination);\n    fs::create_dir_all(destination).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|x| x.0);\n    for (day, source) in files {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(source, format!(\"{}/{}\", destination, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/corkpit/floor.rs <<'EOF'\nuse std::fs;\n\npub fn floor(taken: i32) -> bool {\n    match fs::read_to_string(\"/app/floorcue/MIN.txt\")\n        .ok()\n        .and_then(|s| s.trim().parse::<i32>().ok())\n    {\n        Some(minimum) => taken >= minimum,\n        None => false,\n    }\n}\nEOF\n"]
