ate_new(true).open(&tmp) {\n            Ok(mut f) => {\n                let result = (|| -> std::io::Result<()> {\n                    f.write_all(body)?;\n                    f.flush()?;\n                    f.sync_all()?;\n                    drop(f);\n                    fs::rename(&tmp, dest)?;\n                    fs::File::open(parent)?.sync_all()?;\n                    Ok(())\n                })();\n                if let Err(e) = result {\n                    let _ = fs::remove_file(&tmp);\n                    return Err(e.to_string());\n                }\n                return Ok(());\n            }\n            Err(e) if e.kind() == ErrorKind::AlreadyExists => last = Some(e),\n            Err(e) => return Err(e.to_string()),\n        }\n    }\n    Err(last.map(|e| e.to_string()).unwrap_or_else(|| "cannot create temporary file".into()))\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
