[66.774236, "o", "                Ok(p) => p,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.774628, "o", "                Err(e) => { eprintln!(\"finspool: {}\", e); process::exit(2); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.775437, "o", "            };\r\n\u001b[?2004l\r\u001b[?2004h>             let _ = fmt::indent(0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.779421, "o", "            process::exit(peek::show(&path));\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         Some(\"ease\") if args.len() == 4 => {\r\n\u001b[?2004l\r\u001b[?2004h>             process::exit(emit::go(&args[1], &args[2], &args[3], false));\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         Some(\"sting\") if args.len() == 4 => {\r\n\u001b[?2004l\r\u001b[?2004h>             let rc = emit::go(&args[1], &args[2], &args[3], true);\r\n\u001b[?2004l\r\u001b[?2004h>             if rc != 0 { process::exit(rc); }\r\n\u001b[?2004l\r\u001b[?2004h>             process::abort();\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         _ => usage(),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004h"]
