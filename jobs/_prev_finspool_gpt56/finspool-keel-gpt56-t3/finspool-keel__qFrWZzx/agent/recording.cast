[18.776945, "o", "===== /app/spindock/modes.rs =====\r\n"]
[18.778441, "o", "pub fn op_a(k: u8) -> u8 {\r\n    if k == 0 {\r\n        1\r\n    } else {\r\n        0\r\n    }\r\n}\r\n"]
[18.778981, "o", "===== /app/spindock/spin.rs =====\r\n"]
[18.780213, "o", "#[path = \"/app/spindock/modes.rs\"]\r\nmod modes;\r\n#[path = \"/app/spindock/text.rs\"]\r\nmod text;\r\n\r\nuse std::fs;\r\n\r\nfn main() {\r\n"]
[18.780324, "o", "    let _ = text::pad_out(\"x\");\r\n    let hard_gather = modes::op_a(1) == 0;\r\n    let src = if hard_gather {\r\n        \"/app/tplfold/gather.rs\"\r\n    } else {\r\n        \"/app/tplfold/live.rs\"\r\n    };\r\n    let body = fs::read_to_string(src).unwrap();\r\n    fs::write(\"/app/hookvat/gen_emit.rs\", body).unwrap();\r\n}\r\n"]
[18.7821, "o", "===== /app/spindock/text.rs =====\r\n"]
[18.783515, "o", "pub fn pad_out(s: &str) -> String {\r\n    s.to_string()\r\n}\r\n"]
[18.783729, "o", "===== /app/hookvat/gen_emit.rs =====\r\n"]
[18.785026, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n    if hard {\r\n        crate::spool::stash(card.into_bytes());\r\n    } else {\r\n        let _ = s.write_all(card.as_bytes());\r\n    }"]
[18.785154, "o", "\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    0\r\n}\r\n"]
[18.785325, "o", "===== /app/hookvat/open.rs =====\r\n"]
[18.786452, "o", "pub fn under_root(p: &str) -> bool {\r\n    p.starts_with(\"/app/bloturn/\")\r\n}\r\n"]
[18.786647, "o", "===== /app/hookvat/seal.rs =====\r\n"]
[18.787647, "o", "use std::io::Write;\r\nuse std::sync::atomic::{AtomicBool, Ordering};\r\n\r\nstatic NEED: AtomicBool = AtomicBool::new(false);\r\n\r\npub fn op_c<W: Write>(_w: &mut W) {\r\n    NEED.store(true, Ordering::SeqCst);\r\n}\r\n\r\npub fn drip<W: Write>(w: &mut W) {\r\n    if NEED.swap(false, Ordering::SeqCst) {\r\n        let _ = writeln!(w, \"END\");\r\n"]
[18.787761, "o", "    }\r\n}\r\n"]
[18.787919, "o", "===== /app/hookvat/spool.rs =====\r\n"]
[18.788906, "o", "use std::fs::File;\r\nuse std::io::{BufWriter, Write};\r\nuse std::sync::Mutex;\r\n\r\n#[path = \"/app/slipcards/cap.rs\"]\r\nmod cap;\r\n"]
[18.788984, "o", "\r\nstatic BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());\r\nstatic SLOT: Mutex<Option<BufWriter<File>>> = Mutex::new(None);\r\n\r\n#[allow(dead_code)]\r\npub fn stash(b: Vec<u8>) {\r\n    *BAG.lock().unwrap() = b;\r\n}\r\n\r\npub fn op_b(p: &str) -> BufWriter<File> {\r\n    let f = File::create(p).unwrap();\r\n    BufWriter::with_capacity(cap::ROOM, f)\r\n}\r\n\r\npub fn park(s: BufWriter<File>) {\r\n    *SLOT.lock().unwrap() = Some(s);\r\n}\r\n\r\npub fn release() {\r\n    let extra = BAG.lock().unwrap().split_off(0);\r\n    if let Some(mut s) = SLOT.lock().unwrap().take() {\r\n        if !extra.is_empty() {\r\n            let _ = s.write_all(&extra);\r\n        }\r\n        crate::seal::drip(&mut s);\r\n        let _ = s.flush();\r\n    }\r\n"]
[18.789035, "o", "}\r\n"]
[18.789226, "o", "===== /app/scanpit/fmt.rs =====\r\n"]
[18.790243, "o", "pub fn indent(n: usize) -> String {\r\n    \" \".repeat(n)\r\n}\r\n"]
[18.790414, "o", "===== /app/scanpit/peek.rs =====\r\n"]
[18.79139, "o", "use std::fs;\r\n\r\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\r\n\r\npub fn show(p: &str) -> i32 {\r\n    let _ = SHAPE.len();\r\n    let raw = match fs::read_to_string(p) {\r\n        Ok(s) => s,\r\n        Err(_) => return 1,\r\n    };\r\n    let want: Vec<&str> = raw.lines().collect();\r\n"]
[18.79142, "o", "    if want.len() != 4 {\r\n        return 1;\r\n    }\r\n    if want[0] != \"FIN1\" {\r\n        return 1;\r\n    }\r\n    if !want[1].starts_with(\"thread=\") {\r\n        return 1;\r\n    }\r\n    if !want[2].starts_with(\"op=\") {\r\n"]
[18.791434, "o", "        return 1;\r\n    }\r\n    if want[3] != \"END\" {\r\n        return 1;\r\n    }\r\n    if !raw.ends_with('\\n') {\r\n        return 1;\r\n"]
[18.791552, "o", "    }\r\n    print!(\"{}\", raw);\r\n    0\r\n}\r\n"]
[18.791711, "o", "===== /app/fincli/boot.rs =====\r\n"]
[18.792945, "o", "#[path = \"/app/hookvat/spool.rs\"]\r\nmod spool;\r\n#[path = \"/app/hookvat/seal.rs\"]\r\nmod seal;\r\n#[path = \"/app/hookvat/open.rs\"]\r\nmod open;\r\n#[path = \"/app/hookvat/gen_emit.rs\"]\r\nmod emit;\r\n#[path = \"/app/scanpit/peek.rs\"]\r\nmod peek;\r\n#[path = \"/app/scanpit/fmt.rs\"]\r\nmod fmt;\r\n\r\n"]
[18.793076, "o", "use std::env;\r\nuse std::process;\r\n\r\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\r\n\r\nfn main() {\r\n    let mut args = env::args().skip(1);\r\n    let cmd = args.next().unwrap_or_default();\r\n    match cmd.as_str() {\r\n        \"knit\" => {\r\n            let st = process::Command::new(\"/app/hull.sh\").status();\r\n            process::exit(if st.map(|s| s.success()).unwrap_or(false) {\r\n                0\r\n            } else {\r\n                1\r\n            });\r\n        }\r\n        \"look\" => {\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = fmt::indent(0);\r\n            process::exit(peek::show(&dest));\r\n        }\r\n        \"ease\" => {\r\n            let th = args.next().unwrap_or_default();\r\n            let verb = args.next().unwrap_or_default();\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = open::under_root(&dest);\r\n            if emit::go(&th, &verb, &dest, false) != 0 {\r\n                process::exit(2);\r\n            }\r\n            spool::release();\r\n        }\r\n        \"sting\" => {\r\n            let th = args.next().unwrap_or_default();\r\n            let verb = args.next().unwrap_or_default();\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = open::under_root(&dest);\r\n            if emit::go(&th, &verb, &dest, true) != 0 {\r\n                process::exit(2);\r\n            }\r\n            process::abort();\r\n        }\r\n        _ => {\r\n            eprintln!(\"usage: finspool knit|sting|ease|look\");\r\n            let _ = SHIFT.len();\r\n            process::exit(2);\r\n        }\r\n    }\r\n}\r\n"]
[18.793343, "o", "===== /app/tplfold/gather.rs =====\r\n"]
[18.79444, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n    if hard {\r\n        crate::spool::stash(card.into_bytes());\r\n    } else {\r\n        let _ = s.write_all(card.as_bytes());\r\n    }\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    0\r\n}\r\n"]
[18.794726, "o", "===== /app/tplfold/live.rs =====\r\n"]
[18.795756, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n    let _ = s.write_all(card.as_bytes());\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    let _ = hard;\r\n    0\r\n}"]
[18.795852, "o", "\r\n"]
