[66.773106, "o", "    match args.first().map(String::as_str) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.773226, "o", "        Some(\"knit\") if args.len() == 1 => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.773586, "o", "            let ok = process::Command::new(\"/app/hull.sh\").status()\r\n\u001b[?2004l\r\u001b[?2004h>                 .map(|s| s.success()).unwrap_or(false);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.773718, "o", "            process::exit(if ok { 0 } else { 1 });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.773986, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         Some(\"look\") if args.len() == 2 => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
