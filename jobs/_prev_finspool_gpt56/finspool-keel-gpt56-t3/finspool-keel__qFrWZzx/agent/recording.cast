[66.363728, "i", "cat > /app/hookvat/open.rs <<'EOF'\nuse std::fs;\nuse std::path::{Component, Path, PathBuf};\n\nconst ROOT: &str = \"/app/bloturn\";\n\npub fn checked(p: &str) -> Result<PathBuf, String> {\n    let path = Path::new(p);\n    if !path.is_absolute() {\n        return Err(\"destination must be absolute\".into());\n    }\n    let rel = path.strip_prefix(ROOT).map_err(|_| \"destination is outside bloturn\")?;\n    if rel.as_os_str().is_empty()\n        || rel.components().any(|c| !matches!(c, Component::Normal(_)))\n    {\n        return Err(\"invalid destination\".into());\n    }\n    let parent = path.parent().ok_or(\"destination has no parent\")?;\n    let root = fs::canonicalize(ROOT).map_err(|e| e.to_string())?;\n    let real_parent = fs::canonicalize(parent).map_err(|e| e.to_string())?;\n    if !real_parent.starts_with(&root) {\n        return Err(\"destination is outside bloturn\".into());\n    }\n    Ok(path.to_path_buf())\n}\nEOF\ncat > /app/hookvat/seal.rs <<'EOF'\npub fn card(thread: &str, op: &str) -> Result<Vec<u8>, String> {\n    if thread.contains(['\\n', '\\r']) || op.contains(['\\n', '\\r']) {\n        return Err(\"thread and op must each fit on one line\".into());\n    }\n    Ok(format!(\"FIN1\\nthread={}\\nop={}\\nEND\\n\", thread, op).into_bytes())\n}\nEOF\ncat > /app/hookvat/spool.rs <<'EOF'\nuse std::fs::{self, OpenOptions};\nuse std::io::{ErrorKind, Write};\nuse std::path::Path;\nuse std::sync::atomic::{AtomicU64, Ordering};\n\nstatic NEXT: AtomicU64 = AtomicU64::new(0);\n\npub fn replace(dest: &Path, body: &[u8]) -> Result<(), String> {\n    let parent = dest.parent().ok_or(\"destination has no parent\")?;\n    let name = dest.file_name().ok_or(\"destination has no file name\")?.to_string_lossy();\n    let mut last = None;\n    for _ in 0..100 {\n        let n = NEXT.fetch_add(1, Ordering::Relaxed);\n        let tmp = parent.join(format!(\".{}.finspool-{}-{}\", name, std::process::id(), n));\n        match OpenOptions::new().write(true).create_new(true).open(&tmp) {\n            Ok(mut f) => {\n                let result = (|| -> std::io::Result<()> {\n                    f.write_all(body)?;\n                    f.flush()?;\n                    f.sync_all()?;\n                    drop(f);\n                    fs::rename(&tmp, dest)?;\n                    fs::File::open(parent)?.sync_all()?;\n                    Ok(())\n                })();\n                if let Err(e) = result {\n                    let _ = fs::remove_file(&tmp);\n                    return Err(e.to_string());\n                }\n                return Ok(());\n            }\n            Err(e) if e.kind() == ErrorKind::AlreadyExists => last = Some(e),\n            Err(e) => return Err(e.to_string()),\n        }\n    }\n    Err(last.map(|e| e.to_string()).unwrap_or_else(|| \"cannot create temporary file\".into()))\n}\nEOF\n"]
[66.364089, "o", "cat > /app/hookvat/open.rs <<'EOF'"]
[66.365075, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.365341, "o", "> "]
[66.365631, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.365929, "o", "use std::path::{Component, Path, PathBuf};\r\n\u001b[?2004l\r"]
[66.366036, "o", "\u001b[?2004h"]
[66.366063, "o", "> \r\n\u001b[?2004l\r"]
[66.366311, "o", "\u001b[?2004h"]
[66.366334, "o", "> const ROOT: &str = \"/app/bloturn\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.367058, "o", "pub fn checked(p: &str) -> Result<PathBuf, String> {\r\n\u001b[?2004l\r\u001b[?2004h>     let path = Path::new(p);\r\n\u001b[?2004l\r\u001b[?2004h>     if !path.is_absolute() {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(\"destination must be absolute\".into());\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.367216, "o", "    let rel = path.strip_prefix(ROOT).map_err(|_| \"destination is outside bloturn\")?;\r\n\u001b[?2004l\r"]
[66.367355, "o", "\u001b[?2004h> "]
[66.367487, "o", "    if rel.as_os_str().is_empty()\r\n"]
[66.367509, "o", "\u001b[?2004l\r"]
[66.367559, "o", "\u001b[?2004h"]
[66.368956, "o", "> "]
[66.369011, "o", "        || rel.components().any(|c| !matches!(c, Component::Normal(_)))\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(\"invalid destination\".into());\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let parent = path.parent().ok_or(\"destination has no parent\")?;\r\n\u001b[?2004l\r\u001b[?2004h>     let root = fs::canonicalize(ROOT).map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r\u001b[?2004h>     let real_parent = fs::canonicalize(parent).map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.369231, "o", "    if !real_parent.starts_with(&root) {"]
[66.369333, "o", "\r\n"]
[66.38242, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[66.383913, "o", "        return Err(\"destination is outside bloturn\".into());\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     Ok(path.to_path_buf())\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@7924cb71b5e1:/app# cat > /app/hookvat/seal.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> pub fn card(thread: &str, op: &str) -> Result<Vec<u8>, String> {\r\n\u001b[?2004l\r\u001b[?2004h>     if thread.contains(['\\n', '\\r']) || op.contains(['\\n', '\\r']) {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(\"thread and op must each fit on one line\".into());\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     Ok(format!(\"FIN1\\nthread={}\\nop={}\\nEND\\n\", thread, op).into_bytes())\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[66.386915, "o", "\u001b[?2004hroot@7924cb71b5e1:/app# "]
[66.38774, "o", "cat > /app/hookvat/spool.rs <<'EOF'"]
[66.387812, "o", "\r\n\u001b[?2004l\r"]
[66.38831, "o", "\u001b[?2004h> "]
[66.389488, "o", "use std::fs::{self, OpenOptions};\r\n"]
[66.389536, "o", "\u001b[?2004l\r"]
[66.389756, "o", "\u001b[?2004h"]
[66.391565, "o", "> use std::io::{ErrorKind, Write};\r\n\u001b[?2004l\r\u001b[?2004h> use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> use std::sync::atomic::{AtomicU64, Ordering};\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static NEXT: AtomicU64 = AtomicU64::new(0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.394579, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> pub fn replace(dest: &Path, body: &[u8]) -> Result<(), String> {\r\n\u001b[?2004l\r\u001b[?2004h>     let parent = dest.parent().ok_or(\"destination has no parent\")?;\r\n\u001b[?2004l\r\u001b[?2004h>     let name = dest.file_name().ok_or(\"destination has no file name\")?.to_string_lossy();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut last = None;\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in 0..100 {\r\n\u001b[?2004l\r\u001b[?2004h>         let n = NEXT.fetch_add(1, Ordering::Relaxed);\r\n\u001b[?2004l\r\u001b[?2004h>         let tmp = parent.join(format!(\".{}.finspool-{}-{}\", name, std::process::id(), n));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.399697, "o", "        match OpenOptions::new().write(true).create_new(true).open(&tmp) {\r\n\u001b[?2004l\r\u001b[?2004h>             Ok(mut f) => {\r\n\u001b[?2004l\r\u001b[?2004h>                 let result = (|| -> std::io::Result<()> {\r\n\u001b[?2004l\r\u001b[?2004h>                     f.write_all(body)?;\r\n\u001b[?2004l\r\u001b[?2004h>                     f.flush()?;\r\n\u001b[?2004l\r\u001b[?2004h>                     f.sync_all()?;\r\n\u001b[?2004l\r\u001b[?2004h>                     drop(f);\r\n\u001b[?2004l\r\u001b[?2004h>                     fs::rename(&tmp, dest)?;\r\n\u001b[?2004l\r\u001b[?2004h>                     fs::File::open(parent)?.sync_all()?;\r\n\u001b[?2004l\r\u001b[?2004h>                     Ok(())\r\n\u001b[?2004l\r\u001b[?2004h>                 })();\r\n\u001b[?2004l\r\u001b[?2004h>                 if let Err(e) = result {\r\n\u001b[?2004l\r\u001b[?2004h>                     let _ = fs::remove_file(&tmp);\r\n\u001b[?2004l\r\u001b[?2004h>                     return Err(e.to_string());\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h>                 return Ok(());\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             Err(e) if e.kind() == ErrorKind::AlreadyExists => last = Some(e),\r\n\u001b[?2004l\r\u001b[?2004h>             Err(e) => return Err(e.to_string()),\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     Err(last.map(|e| e.to_string()).unwrap_or_else(|| \"cannot create temporary file\".into()))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[66.402498, "o", "\u001b[?2004hroot@7924cb71b5e1:/app# "]
[66.572358, "i", "cat > /app/tplfold/live.rs <<'EOF'\npub fn go(thread: &str, op: &str, dest: &str, _hard: bool) -> i32 {\n    let path = match crate::open::checked(dest) {\n        Ok(p) => p,\n        Err(e) => { eprintln!(\"finspool: {}\", e); return 2; }\n    };\n    let body = match crate::seal::card(thread, op) {\n        Ok(b) => b,\n        Err(e) => { eprintln!(\"finspool: {}\", e); return 2; }\n    };\n    match crate::spool::replace(&path, &body) {\n        Ok(()) => 0,\n        Err(e) => { eprintln!(\"finspool: {}\", e); 1 }\n    }\n}\nEOF\ncp /app/tplfold/live.rs /app/tplfold/gather.rs\ncat > /app/spindock/modes.rs <<'EOF'\npub fn emitter_source() -> &'static str {\n    \"/app/tplfold/live.rs\"\n}\nEOF\ncat > /app/spindock/spin.rs <<'EOF'\n#[path = \"/app/spindock/modes.rs\"]\nmod modes;\n#[path = \"/app/spindock/text.rs\"]\nmod text;\n\nuse std::fs;\n\nfn main() {\n    let _ = text::pad_out(\"finspool\");\n    let body = fs::read_to_string(modes::emitter_source()).expect(\"read emitter template\");\n    fs::write(\"/app/hookvat/gen_emit.rs\", body).expect(\"write generated emitter\");\n}\nEOF\ncp /app/tplfold/live.rs /app/hookvat/gen_emit.rs\ncat > /app/scanpit/peek.rs <<'EOF'\nuse std::fs;\nuse std::path::Path;\n\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\n\npub fn show(p: &Path) -> i32 {\n    let _ = SHAPE.len();\n    let raw = match fs::read_to_string(p) {\n        Ok(s) => s,\n        Err(_) => return 1,\n    };\n    let lines: Vec<&str> = raw.strip_suffix('\\n').unwrap_or(\"\").split('\\n').collect();\n    if lines.len() != 4\n        || lines[0] != \"FIN1\"\n        || !lines[1].starts_with(\"thread=\")\n        || !lines[2].starts_with(\"op=\")\n        || lines[3] != \"END\"\n        || raw.matches('\\n').count() != 4\n    {\n        return 1;\n    }\n    print!(\"{}\", raw);\n    0\n}\nEOF\n"]
[66.574977, "o", "cat > /app/tplfold/live.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> pub fn go(thread: &str, op: &str, dest: &str, _hard: bool) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let path = match crate::open::checked(dest) {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(p) => p,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(e) => { eprintln!(\"finspool: {}\", e); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     let body = match crate::seal::card(thread, op) {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(b) => b,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(e) => { eprintln!(\"finspool: {}\", e); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     match crate::spool::replace(&path, &body) {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(()) => 0,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(e) => { eprintln!(\"finspool: {}\", e); 1 }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.576641, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
