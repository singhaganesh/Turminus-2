[53.324613, "o", "pub fn go(nm: &str, verb: &str, dest: &str, _hard: bool) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.324826, "o", "    if nm.contains(['\\n', '\\r']) || verb.contains(['\\n', '\\r']) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.324858, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.324998, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
