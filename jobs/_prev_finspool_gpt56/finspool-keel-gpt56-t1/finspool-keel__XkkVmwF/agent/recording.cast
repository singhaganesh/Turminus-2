[13.60362, "o", "for f in /app/hull.sh /app/vatnote/FORMAT.txt /app/opsleaf/SHIFT.txt /app/slipcards/NOTE.txt /app/fincli/*.rs /app/hookvat/*.rs /app/scanpit/*.rs /app/spindock/*.rs /app/tplfold/*; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[13.60402, "o", "===== /app/hull.sh =====\r\n"]
[13.60804, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/bloturn\r\n     5\trustc --edition 2021 -O /app/spindock/spin.rs -o /tmp/spinknit\r\n     6\t/tmp/spinknit\r\n     7\trustc --edition 2021 -O /app/fincli/boot.rs -o /app/bin/finspool\r\n"]
[13.608251, "o", "===== /app/vatnote/FORMAT.txt =====\r\n"]
[13.609496, "o", "     1\tA whole card has four lines:\r\n     2\t\r\n     3\tFIN1\r\n     4\tthread=<name>\r\n     5\top=<verb>\r\n     6\tEND\r\n     7\t\r\n     8\tEach line ends with a newline.\r\n     9\t\r\n"]
[13.609526, "o", "    10\tSample sting arguments on this bench: thread desk-k4 or n1, and op\r\n    11\tsplice-harbor-overlong-token-alpha-zz, quay-splice-harbor-overlong-token-beta-yy,\r\n    12\tor v1.\r\n"]
[13.609741, "o", "===== /app/opsleaf/SHIFT.txt =====\r\n"]
[13.611101, "o", "     1\tease on this shift already leaves a whole card. sting is the overnight drill.\r\n"]
[13.612845, "o", "===== /app/slipcards/NOTE.txt =====\r\n"]
[13.613698, "o", "     1\tSome desks bump ROOM on the slip card when a short write looks clipped.\r\n     2\tThe returning path already produces a whole card on this bench.\r\n"]
[13.613949, "o", "===== /app/fincli/boot.rs =====\r\n"]
[13.61532, "o", "     1\t#[path = \"/app/hookvat/spool.rs\"]\r\n     2\tmod spool;\r\n     3\t#[path = \"/app/hookvat/seal.rs\"]\r\n     4\tmod seal;\r\n     5\t#[path = \"/app/hookvat/open.rs\"]\r\n     6\tmod open;\r\n     7\t#[path = \"/app/hookvat/gen_emit.rs\"]\r\n     8\tmod emit;\r\n     9\t#[path = \"/app/scanpit/peek.rs\"]\r\n    10\tmod peek;\r\n    11\t#[path = \"/app/scanpit/fmt.rs\"]\r\n    12\tmod fmt;\r\n    13\t\r\n    14\tuse std::env;\r\n    15\tuse std::process;\r\n    16\t\r\n    17\tconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\r\n    18\t\r\n    19\tfn main() {\r\n    20\t    let mut args = env::args().skip(1);\r\n    21\t    let cmd = args.next().unwrap_or_default();\r\n    22\t    match cmd.as_str() {\r\n    23\t        \"knit\" => {\r\n    24\t            let st = process::Command::new(\"/app/hull.sh\").status();\r\n    25\t            process::exit(if st.map(|s| s.success()).unwrap_or(false) {\r\n    26\t                0\r\n    27\t            } else {\r\n    28\t                1\r\n    29\t            });\r\n    30\t        }\r\n    31\t        \"look\" => {\r\n    32\t            let dest = args.next().unwrap_or_default();\r\n    33\t            let _ = fmt::indent(0);\r\n    34\t            process::exit(peek::show(&dest));\r\n    35\t        }\r\n    36\t        \"ease\" => {\r\n    37\t            let th = args.next().unwrap_or_default();\r\n    38\t            let verb = args.next().unwrap_or_default();\r\n    39\t            let dest = args.next().unwrap_or_default();\r\n    40\t            let _ = open::under_root(&dest);\r\n    41\t            if emit::go(&th, &verb, &dest, false) != 0 {\r\n    42\t                process::exit(2);\r\n    43\t            }\r\n    44\t            spool::release();\r\n    45\t        }\r\n    46\t        \"sting\" => {\r\n    47\t            let th = args.next().unwrap_or_default();\r\n    48\t            let verb = args.next().unwrap_or_default();\r\n    49\t            let dest = args.next().unwrap_or_default();\r\n    50\t            let _ = open::under_root(&dest);\r\n    51\t            if emit::go(&th, &verb, &dest, true) != 0 {\r\n    52\t                process::exit(2);\r\n    53\t            }\r\n    54\t            process::abort();\r\n    55\t        }\r\n    56\t        _ => {\r\n    57\t            eprintln!(\"usage: finspool knit|sting|ease|look\");\r\n    58\t            let _ = SHIFT.len();\r\n    59\t            process::exit(2);\r\n    60\t        }\r\n    61\t    }\r\n    62\t}\r\n"]
[13.615705, "o", "===== /app/hookvat/gen_emit.rs =====\r\n"]
[13.616818, "o", "     1\tuse std::io::Write;\r\n     2\t\r\n"]
[13.617183, "o", "     3\tpub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n     4\t    let mut s = crate::spool::op_b(dest);\r\n     5\t    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n     6\t    if hard {\r\n     7\t        crate::spool::stash(card.into_bytes());\r\n     8\t    } else {\r\n     9\t        let _ = s.write_all(card.as_bytes());\r\n    10\t    }\r\n    11\t    crate::seal::op_c(&mut s);\r\n    12\t    crate::spool::park(s);\r\n    13\t    0\r\n    14\t}\r\n"]
[13.61747, "o", "===== /app/hookvat/open.rs =====\r\n"]
[13.618712, "o", "     1\tpub fn under_root(p: &str) -> bool {\r\n     2\t    p.starts_with(\"/app/bloturn/\")\r\n     3\t}\r\n"]
[13.619078, "o", "===== /app/hookvat/seal.rs =====\r\n"]
[13.620152, "o", "     1\tuse std::io::Write;\r\n     2\tuse std::sync::atomic::{AtomicBool, Ordering};\r\n     3\t\r\n     4\tstatic NEED: AtomicBool = AtomicBool::new(false);\r\n     5\t\r\n     6\tpub fn op_c<W: Write>(_w: &mut W) {\r\n     7\t    NEED.store(true, Ordering::SeqCst);\r\n     8\t}\r\n     9\t\r\n    10\tpub fn drip<W: Write>(w: &mut W) {\r\n    11\t"]
[13.620271, "o", "    if NEED.swap(false, Ordering::SeqCst) {\r\n    12\t        let _ = writeln!(w, \"END\");\r\n    13\t    }\r\n    14\t}\r\n"]
[13.620438, "o", "===== /app/hookvat/spool.rs =====\r\n"]
[13.62143, "o", "     1\tuse std::fs::File;\r\n     2\tuse std::io::{BufWriter, Write};\r\n     3\tuse std::sync::Mutex;\r\n     4\t\r\n     5\t#[path = \"/app/slipcards/cap.rs\"]\r\n     6\tmod cap;\r\n     7\t\r\n     8\tstatic BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());\r\n     9\tstatic SLOT: Mutex<Option<BufWriter<File>>> = Mutex::new(None);\r\n    10\t\r\n    11\t#[allow(dead_code)]\r\n    12\tpub fn stash(b: Vec<u8>) {\r\n    13\t    *BAG.lock().unwrap() = b;\r\n    14\t}\r\n    15\t\r\n    16\tpub fn op_b(p: &str) -> BufWriter<File> {\r\n    17\t    let f = File::create(p).unwrap();\r\n    18\t    BufWriter::with_capacity(cap::ROOM, f)\r\n    19\t}\r\n"]
[13.621597, "o", "    20\t\r\n    21\tpub fn park(s: BufWriter<File>) {\r\n    22\t    *SLOT.lock().unwrap() = Some(s);\r\n    23\t}\r\n    24\t\r\n    25\tpub fn release() {\r\n    26\t    let extra = BAG.lock().unwrap().split_off(0);\r\n    27\t    if let Some(mut s) = SLOT.lock().unwrap().take() {\r\n    28\t        if !extra.is_empty() {\r\n    29\t            let _ = s.write_all(&extra);\r\n    30\t        }\r\n    31\t        crate::seal::drip(&mut s);\r\n    32\t        let _ = s.flush();\r\n    33\t    }\r\n    34\t}\r\n"]
[13.621766, "o", "===== /app/scanpit/fmt.rs =====\r\n"]
[13.622734, "o", "     1\tpub fn indent(n: usize) -> String {\r\n     2\t    \" \".repeat(n)\r\n     3\t}\r\n"]
[13.622925, "o", "===== /app/scanpit/peek.rs =====\r\n"]
[13.623737, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\r\n     4\t\r\n     5\tpub fn show(p: &str) -> i32 {\r\n"]
[13.623768, "o", "     6\t    let _ = SHAPE.len();\r\n     7\t    let raw = match fs::read_to_string(p) {\r\n     8\t        Ok(s) => s,\r\n     9\t        Err(_) => return 1,\r\n    10\t    };\r\n    11\t    let want: Vec<&str> = raw.lines().collect();\r\n"]
[13.623783, "o", "    12\t    if want.len() != 4 {\r\n    13\t        return 1;\r\n    14\t    }\r\n    15\t    if want[0] != \"FIN1\" {\r\n    16\t        return 1;\r\n"]
[13.623797, "o", "    17\t    }\r\n    18\t    if !want[1].starts_with(\"thread=\") {\r\n    19\t        return 1;\r\n"]
[13.623812, "o", "    20\t    }\r\n    21\t    if !want[2].starts_with(\"op=\") {\r\n    22\t        return 1;\r\n    23\t    }\r\n    24\t    if want[3] != \"END\" {\r\n"]
[13.623832, "o", "    25\t        return 1;\r\n    26\t    }\r\n    27\t    if !raw.ends_with('\\n') {\r\n    28\t        return 1;\r\n    29\t    }\r\n    30\t"]
[13.623853, "o", "    print!(\"{}\", raw);\r\n    31\t    0\r\n    32\t}\r\n"]
[13.624157, "o", "===== /app/spindock/modes.rs =====\r\n"]
[13.625044, "o", "     1\tpub fn op_a(k: u8) -> u8 {\r\n     2\t    if k == 0 {\r\n     3\t        1\r\n     4\t    } else {\r\n     5\t        0\r\n     6\t    }\r\n"]
[13.625117, "o", "     7\t}\r\n"]
[13.625277, "o", "===== /app/spindock/spin.rs =====\r\n"]
[13.626046, "o", "     1\t#[path = \"/app/spindock/modes.rs\"]\r\n     2\tmod modes;\r\n     3\t#[path = \"/app/spindock/text.rs\"]\r\n     4\tmod text;\r\n     5\t\r\n     6\tuse std::fs;\r\n     7\t\r\n     8\tfn main() {\r\n"]
[13.626127, "o", "     9\t    let _ = text::pad_out(\"x\");\r\n    10\t    let hard_gather = modes::op_a(1) == 0;\r\n    11\t    let src = if hard_gather {\r\n    12\t        \"/app/tplfold/gather.rs\"\r\n    13\t    } else {\r\n    14\t        \"/app/tplfold/live.rs\"\r\n    15\t    };\r\n    16\t    let body = fs::read_to_string(src).unwrap();\r\n    17\t    fs::write(\"/app/hookvat/gen_emit.rs\", body).unwrap();\r\n    18\t}\r\n"]
[13.626285, "o", "===== /app/spindock/text.rs =====\r\n"]
[13.627072, "o", "     1\tpub fn pad_out(s: &str) -> String {\r\n     2\t    s.to_string()\r\n     3\t}\r\n"]
[13.627205, "o", "===== /app/tplfold/emit.tpl =====\r\n"]
[13.628423, "o", "     1\t{{BODY}}\r\n"]
[13.62887, "o", "===== /app/tplfold/gather.rs =====\r\n"]
[13.630287, "o", "     1\tuse std::io::Write;\r\n"]
[13.630889, "o", "     2\t\r\n     3\tpub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n     4\t    let mut s = crate::spool::op_b(dest);\r\n     5\t    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n     6\t    if hard {\r\n     7\t        crate::spool::stash(card.into_bytes());\r\n     8\t    } else {\r\n     9\t        let _ = s.write_all(card.as_bytes());\r\n    10\t    }\r\n    11\t    crate::seal::op_c(&mut s);\r\n    12\t    crate::spool::park(s);\r\n    13\t    0\r\n    14\t}\r\n"]
[13.630938, "o", "===== /app/tplfold/live.rs =====\r\n"]
[13.632275, "o", "     1\tuse std::io::Write;\r\n     2\t\r\n     3\tpub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n     4\t    let mut s = crate::spool::op_b(dest);\r\n     5\t    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n     6\t    let _ = s.write_all(card.as_bytes());\r\n     7\t    crate::seal::op_c(&mut s);\r\n     8\t    crate::spool::park(s);\r\n     9\t    let _ = hard;\r\n    10\t    0\r\n    11\t}\r\n"]
[13.633019, "o", "===== /app/tplfold/modes.knt =====\r\n"]
[13.635255, "o", "     1\t0 gather\r\n     2\t1 live\r\n"]
