[53.317436, "o", "static SEQ: AtomicU64 = AtomicU64::new(0);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn commit(dest: &str, card: &[u8]) -> io::Result<()> {\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.319284, "o", ">     let path = Path::new(dest);\r\n\u001b[?2004l\r\u001b[?2004h>     let parent = path.parent().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, \"destination has no parent\"))?;\r\n\u001b[?2004l\r\u001b[?2004h>     let name = path.file_name().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, \"destination has no name\"))?;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for _ in 0..100 {\r\n\u001b[?2004l\r\u001b[?2004h>         let n = SEQ.fetch_add(1, Ordering::Relaxed);\r\n\u001b[?2004l\r\u001b[?2004h>         let tmp = parent.join(format!(\".{}.{}.{}.tmp\", name.to_string_lossy(), std::process::id(), n));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.31949, "o", "        let mut file = match OpenOptions::new().write(true).create_new(true).open(&tmp) {\r\n\u001b[?2004l\r\u001b[?2004h>             Ok(f) => f,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.319668, "o", "            Err(e) if e.kind() == io::ErrorKind::AlreadyExists => continue,\r\n"]
[53.319829, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.31998, "o", "            Err(e) => return Err(e),\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r"]
[53.320046, "o", "\u001b[?2004h> "]
[53.320086, "o", "        let result = (|| {\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.32014, "o", "> "]
[53.320242, "o", "            file.write_all(card)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
