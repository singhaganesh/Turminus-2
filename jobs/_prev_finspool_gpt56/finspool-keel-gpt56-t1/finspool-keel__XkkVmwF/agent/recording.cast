[14.618677, "o", "echo '--- header ---'; od -An -tx1 -N16 /app/bin/finspool; echo '--- tools ---'; command -v rustc || true; rustc --version 2>/dev/null || true; command -v cargo || true\r\n\u001b[?2004l\r"]
