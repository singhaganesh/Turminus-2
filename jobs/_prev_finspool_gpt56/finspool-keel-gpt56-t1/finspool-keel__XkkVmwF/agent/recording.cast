[79.272778, "i", "set +e\nrm -f /app/core /app/core.* /app/bloturn/pair-a.rec /app/bloturn/pair-b.rec\n/app/bin/finspool sting 'desk-k4' 'splice-harbor-overlong-token-alpha-zz' /app/bloturn/final.rec >/dev/null 2>&1\nsting_rc=$?\nout=$(/app/bin/finspool look /app/bloturn/final.rec); look_rc=$?\nprintf 'FIN1\\nthread=desk-k4\\nop=splice-harbor-overlong-token-alpha-zz\\nEND\\n' > /tmp/expected.rec\ncmp -s /tmp/expected.rec /app/bloturn/final.rec; cmp_rc=$?\n: > /app/bloturn/pair-a.rec; /app/bin/finspool look /app/bloturn/pair-a.rec >/dev/null; empty_rc=$?\nprintf 'FIN1\\nthread=x\\nop=y\\nEND' > /app/bloturn/pair-a.rec; /app/bin/finspool look /app/bloturn/pair-a.rec >/dev/null; truncated_rc=$?\nprintf 'FIN1\\nthread=x\\nop=y\\nEND\\nEXTRA\\n' > /app/bloturn/pair-a.rec; /app/bin/finspool look /app/bloturn/pair-a.rec >/dev/null; extra_rc=$?\nrm -f /app/bloturn/pair-a.rec /tmp/expected.rec /app/core /app/core.*\nprintf 'sting_rc=%s look_rc=%s cmp_rc=%s empty_rc=%s truncated_rc=%s extra_rc=%s\\n' \"$sting_rc\" \"$look_rc\" \"$cmp_rc\" \"$empty_rc\" \"$truncated_rc\" \"$extra_rc\"\nprintf '%s\\n' \"$out\"\nfind /app/bloturn -maxdepth 1 -name '.*.tmp' -print\nod -An -tx1 -N4 /app/bin/finspool\n"]
