[53.299886, "i", "cat > /app/hookvat/open.rs <<'EOF'\nuse std::fs;\nuse std::path::Path;\n\npub fn under_root(p: &str) -> bool {\n    let root = match fs::canonicalize(\"/app/bloturn\") {\n        Ok(p) => p,\n        Err(_) => return false,\n    };\n    let path = Path::new(p);\n    if !path.is_absolute() || path.file_name().is_none() {\n        return false;\n    }\n    match path.parent().and_then(|p| fs::canonicalize(p).ok()) {\n        Some(parent) => parent.starts_with(&root),\n        None => false,\n    }\n}\nEOF\ncat > /app/hookvat/spool.rs <<'EOF'\nuse std::fs::{self, OpenOptions};\nuse std::io::{self, Write};\nuse std::path::Path;\nuse std::sync::atomic::{AtomicU64, Ordering};\n\nstatic SEQ: AtomicU64 = AtomicU64::new(0);\n\npub fn commit(dest: &str, card: &[u8]) -> io::Result<()> {\n    let path = Path::new(dest);\n    let parent = path.parent().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, \"destination has no parent\"))?;\n    let name = path.file_name().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, \"destination has no name\"))?;\n\n    for _ in 0..100 {\n        let n = SEQ.fetch_add(1, Ordering::Relaxed);\n        let tmp = parent.join(format!(\".{}.{}.{}.tmp\", name.to_string_lossy(), std::process::id(), n));\n        let mut file = match OpenOptions::new().write(true).create_new(true).open(&tmp) {\n            Ok(f) => f,\n            Err(e) if e.kind() == io::ErrorKind::AlreadyExists => continue,\n            Err(e) => return Err(e),\n        };\n        let result = (|| {\n            file.write_all(card)?;\n            file.sync_all()?;\n            fs::rename(&tmp, path)?;\n            FileSync::sync_dir(parent)\n        })();\n        if result.is_err() {\n            let _ = fs::remove_file(&tmp);\n        }\n        return result;\n    }\n    Err(io::Error::new(io::ErrorKind::AlreadyExists, \"unable to allocate temporary file\"))\n}\n\nstruct FileSync;\nimpl FileSync {\n    fn sync_dir(path: &Path) -> io::Result<()> {\n        fs::File::open(path)?.sync_all()\n    }\n}\n\npub fn release() {}\nEOF\ncat > /app/tplfold/gather.rs <<'EOF'\npub fn go(nm: &str, verb: &str, dest: &str, _hard: bool) -> i32 {\n    if nm.contains(['\\n', '\\r']) || verb.contains(['\\n', '\\r']) {\n        return 1;\n    }\n    let card = format!(\"FIN1\\nthread={}\\nop={}\\nEND\\n\", nm, verb);\n    match crate::spool::commit(dest, card.as_bytes()) {\n        Ok(()) => 0,\n        Err(_) => 1,\n    }\n}\nEOF\ncp /app/tplfold/gather.rs /app/hookvat/gen_emit.rs\ncat > /app/spindock/modes.rs <<'EOF'\npub fn op_a(_k: u8) -> u8 {\n    0\n}\nEOF\n"]
