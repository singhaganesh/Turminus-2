[53.304206, "o", "    let root = match fs::canonicalize(\"/app/bloturn\") {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(p) => p,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(_) => return false,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.304357, "o", "    };\r\n\u001b[?2004l\r\u001b[?2004h>     let path = Path::new(p);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.304512, "o", "    if !path.is_absolute() || path.file_name().is_none() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.304578, "o", ">         return false;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
