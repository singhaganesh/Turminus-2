===== /app/vatnote/FORMAT.txt =====
     1	A whole card has four lines:
     2	
     3	FIN1
     4	thread=<name>
     5	op=<verb>
     6	END
     7	
     8	Each line ends with a newline.
     9	
    10	Sample sting arguments on this bench: thread desk-k4 or n1, and op
    11	splice-harbor-overlong-token-alpha-zz, quay-splice-harbor-overlong-token-beta-yy,
    12	or v1.
===== /app/opsleaf/SHIFT.txt =====
     1	ease on this shift already leaves a whole card. sting is the overnight drill.
===== /app/slipcards/NOTE.txt =====
     1	Some desks bump ROOM on the slip card when a short write looks clipped.
     2	The returning path already produces a whole card on this bench.
===== /app/fincli/boot.rs =====
     1	#[path = "/app/hookvat/spool.rs"]
     2	mod spool;
     3	#[path = "/app/hookvat/seal.rs"]
     4	mod seal;
     5	#[path = "/app/hookvat/open.rs"]
     6	mod open;
     7	#[path = "/app/hookvat/gen_emit.rs"]
     8	mod emit;
     9	#[path = "/app/scanpit/peek.rs"]
    10	mod peek;
    11	#[path = "/app/scanpit/fmt.rs"]
    12	mod fmt;
    13	
    14	use std::env;
    15	use std::process;
    16	
    17	const SHIFT: &str = include_str!("/app/opsleaf/SHIFT.txt");
    18	
    19	fn main() {
    20	    let mut args = env::args().skip(1);
    21	    let cmd = args.next().unwrap_or_default();
    22	    match cmd.as_str() {
    23	        "knit" => {
    24	            let st = process::Command::new("/app/hull.sh").status();
    25	            process::exit(if st.map(|s| s.success()).unwrap_or(false) {
    26	                0
    27	            } else {
    28	                1
    29	            });
    30	        }
    31	        "look" => {
    32	            let dest = args.next().unwrap_or_default();
    33	            let _ = fmt::indent(0);
    34	            process::exit(peek::show(&dest));
    35	        }
    36	        "ease" => {
    37	            let th = args.next().unwrap_or_default();
    38	            let verb = args.next().unwrap_or_default();
    39	            let dest = args.next().unwrap_or_default();
    40	            let _ = open::under_root(&dest);
    41	            if emit::go(&th, &verb, &dest, false) != 0 {
    42	                process::exit(2);
    43	            }
    44	            spool::release();
    45	        }
    46	        "sting" => {
    47	            let th = args.next().unwrap_or_default();
    48	            let verb = args.next().unwrap_or_default();
    49	            let dest = args.next().unwrap_or_default();
    50	            let _ = open::under_root(&dest);
    51	            if emit::go(&th, &verb, &dest, true) != 0 {
    52	                process::exit(2);
    53	            }
    54	            process::abort();
    55	        }
    56	        _ => {
    57	            eprintln!("usage: finspool knit|sting|ease|look");
    58	            let _ = SHIFT.len();
    59	            process::exit(2);
    60	        }
    61	    }
    62	}
===== /app/hookvat/gen_emit.rs =====
     1	use std::io::Write;
     2	
     3	pub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {
     4	    let mut s = crate::spool::op_b(dest);
     5	    let card = format!("FIN1\nthread={}\nop={}\n", nm, verb);
     6	    if hard {
     7	        crate::spool::stash(card.into_bytes());
     8	    } else {
     9	        let _ = s.write_all(card.as_bytes());
    10	    }
    11	    crate::seal::op_c(&mut s);
    12	    crate::spool::park(s);
    13	    0
    14	}
===== /app/hookvat/open.rs =====
     1	pub fn under_root(p: &str) -> bool {
     2	    p.starts_with("/app/bloturn/")
     3	}
===== /app/hookvat/seal.rs =====
     1	use std::io::Write;
     2	use std::sync::atomic::{AtomicBool, Ordering};
     3	
     4	static NEED: AtomicBool = AtomicBool::new(false);
     5	
     6	pub fn op_c<W: Write>(_w: &mut W) {
     7	    NEED.store(true, Ordering::SeqCst);
     8	}
     9	
    10	pub fn drip<W: Write>(w: &mut W) {
    11	    if NEED.swap(false, Ordering::SeqCst) {
    12	        let _ = writeln!(w, "END");
    13	    }
    14	}
===== /app/hookvat/spool.rs =====
     1	use std::fs::File;
     2	use std::io::{BufWriter, Write};
     3	use std::sync::Mutex;
     4	
     5	#[path = "/app/slipcards/cap.rs"]
     6	mod cap;
     7	
     8	static BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());
     9	static SLOT: Mutex<Option<BufWriter<File>>> = Mutex::new(None);
    10	
    11	#[allow(dead_code)]
    12	pub fn stash(b: Vec<u8>) {
    13	    *BAG.lock().unwrap() = b;
    14	}
    15	
    16	pub fn op_b(p: &str) -> BufWriter<File> {
    17	    let f = File::create(p).unwrap();
    18	    BufWriter::with_capacity(cap::ROOM, f)
    19	}
    20	
    21	pub fn park(s: BufWriter<File>) {
    22	    *SLOT.lock().unwrap() = Some(s);
    23	}
    24	
    25	pub fn release() {
    26	    let extra = BAG.lock().unwrap().split_off(0);
    27	    if let Some(mut s) = SLOT.lock().unwrap().take() {
    28	        if !extra.is_empty() {
    29	            let _ = s.write_all(&extra);
    30	        }
    31	        crate::seal::drip(&mut s);
    32	        let _ = s.flush();
    33	    }
    34	}
===== /app/scanpit/fmt.rs =====
     1	pub fn indent(n: usize) -> String {
     2	    " ".repeat(n)
     3	}
===== /app/scanpit/peek.rs =====
     1	use std::fs;
     2	
     3	const SHAPE: &str = include_str!("/app/vatnote/FORMAT.txt");
     4	
     5	pub fn show(p: &str) -> i32 {
     6	    let _ = SHAPE.len();
     7	    let raw = match fs::read_to_string(p) {
     8	        Ok(s) => s,
     9	        Err(_) => return 1,
    10	    };
    11	    let want: Vec<&str> = raw.lines().collect();
    12	    if want.len() != 4 {
    13	        return 1;
    14	    }
    15	    if want[0] != "FIN1" {
    16	        return 1;
    17	    }
    18	    if !want[1].starts_with("thread=") {
    19	        return 1;
    20	    }
    21	    if !want[2].starts_with("op=") {
    22	        return 1;
    23	    }
    24	    if want[3] != "END" {
    25	        return 1;
    26	    }
    27	    if !raw.ends_with('\n') {
    28	        return 1;
    29	    }
    30	    print!("{}", raw);
    31	    0
    32	}
