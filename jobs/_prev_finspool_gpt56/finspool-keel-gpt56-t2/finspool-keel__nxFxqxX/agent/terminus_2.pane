     1	use std::io::Write;
     2	
     3	pub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {
     4	    let mut s = crate::spool::op_b(dest);
     5	    let card = format!("FIN1\nthread={}\nop={}\n", nm, verb);
     6	    if hard {
     7	        crate::spool::stash(card.into_bytes());
     8	    } else {
     9	        let _ = s.write_all(card.as_bytes());
    10	    }
    11	    crate::seal::op_c(&mut s);
    12	    crate::spool::park(s);
    13	    0
    14	}
