[117.132582, "i", "python3 - <<'PY'\np='/app/fincli/boot.rs'\ns=open(p).read()\ns=s.replace('if dest.is_empty() || args.next().is_some() {', 'if dest.is_empty() || args.next().is_some() || !open::under_root(&dest) {')\nopen(p,'w').write(s)\nPY\ncat > /app/scanpit/peek.rs <<'EOF'\nuse std::fs;\n\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\n\npub fn show(p: &str) -> i32 {\n    let _ = SHAPE.len();\n    let raw = match fs::read_to_string(p) {\n        Ok(s) => s,\n        Err(_) => return 1,\n    };\n    if raw.contains('\\r') || !raw.ends_with('\\n') {\n        return 1;\n    }\n    let body = &raw[..raw.len() - 1];\n    let want: Vec<&str> = body.split('\\n').collect();\n    if want.len() != 4\n        || want[0] != \"FIN1\"\n        || !want[1].starts_with(\"thread=\")\n        || !want[2].starts_with(\"op=\")\n        || want[3] != \"END\"\n    {\n        return 1;\n    }\n    print!(\"{}\", raw);\n    0\n}\nEOF\n/app/bin/finspool knit\n"]
