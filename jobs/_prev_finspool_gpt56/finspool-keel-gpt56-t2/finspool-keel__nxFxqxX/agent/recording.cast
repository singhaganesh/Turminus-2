[20.379625, "i", "echo '--- magic ---'; od -An -tx1 -N16 /app/bin/finspool; echo '--- current behavior ---'; /app/bin/finspool look /app/bloturn/final.rec; echo \"look_rc=$?\"; rm -f /app/bloturn/probe.rec; /app/bin/finspool ease probe-thread probe-op /app/bloturn/probe.rec; echo \"ease_rc=$?\"; od -An -tc /app/bloturn/probe.rec 2>/dev/null || true; rm -f /tmp/finspool-out.rec; /app/bin/finspool ease t o /tmp/finspool-out.rec; echo \"outside_rc=$? exists=$(test -e /tmp/finspool-out.rec; echo $?)\"\n"]
[20.38128, "o", "echo '--- magic ---'; od -An -tx1 -N16 /app/bin/finspool; echo '--- current behavior ---'; /app/bin/finspool look /app/bloturn/final.rec; echo \"look_rc=$?\"; rm -f /app/bloturn/probe.rec; /app/bin/finspool ease probe-thread probe-op /app/bloturn/probe.rec; echo \"ease_rc=$?\"; od -An -tc /app/bloturn/probe.rec 2>/dev/null || true; rm -f /tmp/finspool-out.rec; /app/bin/finspool ease t o /tmp/finspool-out.rec; echo \"outside_rc=$? exists=$(test -e /tmp/finspool-out.rec; echo $?)\"\r\n\u001b[?2004l\r"]
[20.381564, "o", "--- magic ---\r\n"]
[20.383562, "o", " 7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\r\n"]
[20.384131, "o", "--- current behavior ---\r\n"]
[20.386685, "o", "look_rc=1\r\n"]
[20.39154, "o", "ease_rc=0\r\n"]
[20.392673, "o", "   F   I   N   1  \\n   t   h   r   e   a   d   =   p   r   o   b\r\n   e   -   t   h   r   e   a   d  \\n   o   p   =   p   r   o   b\r\n   e   -   o   p  \\n   E   N   D  \\n\r\n"]
[20.395836, "o", "outside_rc=0 exists=0\r\n"]
[20.395987, "o", "\u001b[?2004hroot@2c20526ff46f:/app# "]
[76.24946, "i", "cat > /app/hookvat/open.rs <<'EOF'\nuse std::fs;\nuse std::path::Path;\n\npub fn under_root(p: &str) -> bool {\n    let path = Path::new(p);\n    let root = match fs::canonicalize(\"/app/bloturn\") {\n        Ok(v) => v,\n        Err(_) => return false,\n    };\n    if !path.is_absolute() || path.file_name().is_none() {\n        return false;\n    }\n    let parent = match path.parent().and_then(|v| fs::canonicalize(v).ok()) {\n        Some(v) => v,\n        None => return false,\n    };\n    parent.starts_with(&root)\n}\nEOF\ncat > /app/hookvat/spool.rs <<'EOF'\nuse std::fs::{self, File, OpenOptions};\nuse std::io::{self, BufWriter, Write};\nuse std::path::{Path, PathBuf};\nuse std::sync::Mutex;\n\n#[path = \"/app/slipcards/cap.rs\"]\nmod cap;\n\nstatic BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());\nstatic SLOT: Mutex<Option<CardWriter>> = Mutex::new(None);\n\npub struct CardWriter {\n    out: BufWriter<File>,\n    tmp: PathBuf,\n    dest: PathBuf,\n}\n\nimpl Write for CardWriter {\n    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {\n        self.out.write(buf)\n    }\n\n    fn flush(&mut self) -> io::Result<()> {\n        self.out.flush()\n    }\n}\n\nimpl Drop for CardWriter {\n    fn drop(&mut self) {\n        let _ = fs::remove_file(&self.tmp);\n    }\n}\n\n#[allow(dead_code)]\npub fn stash(b: Vec<u8>) {\n    *BAG.lock().unwrap() = b;\n}\n\npub fn op_b(p: &str) -> CardWriter {\n    let dest = PathBuf::from(p);\n    let parent = dest.parent().expect(\"destination has no parent\");\n    let name = dest.file_name().and_then(|v| v.to_str()).unwrap_or(\"card\");\n    let tmp = parent.join(format!(\".{}.finspool.{}.tmp\", name, std::process::id()));\n    let _ = fs::remove_file(&tmp);\n    let file = OpenOptions::new()\n        .write(true)\n        .create_new(true)\n        .open(&tmp)\n        .expect(\"cannot create temporary card\");\n    CardWriter {\n        out: BufWriter::with_capacity(cap::ROOM, file),\n        tmp,\n        dest,\n    }\n}\n\npub fn park(s: CardWriter) {\n    *SLOT.lock().unwrap() = Some(s);\n}\n\npub fn release() -> bool {\n    let extra = BAG.lock().unwrap().split_off(0);\n    let mut slot = SLOT.lock().unwrap();\n    let mut card = match slot.take() {\n        Some(v) => v,\n        None => return false,\n    };\n    let result = (|| -> io::Result<()> {\n        if !extra.is_empty() {\n            card.write_all(&extra)?;\n        }\n        crate::seal::drip(&mut card);\n        card.flush()?;\n        card.out.get_ref().sync_all()?;\n        fs::rename(&card.tmp, &card.dest)?;\n        if let Some(parent) = card.dest.parent() {\n            File::open(parent)?.sync_all()?;\n        }\n        Ok(())\n    })();\n    result.is_ok()\n}\n\n#[allow(dead_code)]\nfn _path_type(_: &Path) {}\nEOF\ncat > /app/fincli/boot.rs <<'EOF'\n#[path = \"/app/hookvat/spool.rs\"]\nmod spool;\n#[path = \"/app/hookvat/seal.rs\"]\nmod seal;\n#[path = \"/app/hookvat/open.rs\"]\nmod open;\n#[path = \"/app/hookvat/gen_emit.rs\"]\nmod emit;\n#[path = \"/app/scanpit/peek.rs\"]\nmod peek;\n#[path = \"/app/scanpit/fmt.rs\"]\nmod fmt;\n\nuse std::env;\nuse std::process;\n\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\n\nfn field_ok(s: &str) -> bool {\n    !s.contains(['\\n', '\\r'])\n}\n\nfn main() {\n    let mut args = env::args().skip(1);\n    let cmd = args.next().unwrap_or_default();\n    match cmd.as_str() {\n        \"knit\" => {\n            if args.next().is_some() {\n                process::exit(2);\n            }\n            let st = process::Command::new(\"/app/hull.sh\").status();\n            process::exit(if st.map(|s| s.success()).unwrap_or(false) { 0 } else { 1 });\n        }\n        \"look\" => {\n            let dest = args.next().unwrap_or_default();\n            if dest.is_empty() || args.next().is_some() {\n                process::exit(2);\n            }\n            let _ = fmt::indent(0);\n            process::exit(peek::show(&dest));\n        }\n        \"ease\" | \"sting\" => {\n            let th = args.next().unwrap_or_default();\n            let verb = args.next().unwrap_or_default();\n            let dest = args.next().unwrap_or_default();\n            if args.next().is_some()\n                || !field_ok(&th)\n                || !field_ok(&verb)\n     "]
[76.249917, "i", "           || !open::under_root(&dest)\n            {\n                process::exit(2);\n            }\n            let hard = cmd == \"sting\";\n            if emit::go(&th, &verb, &dest, hard) != 0 || !spool::release() {\n                process::exit(2);\n            }\n            if hard {\n                process::abort();\n            }\n        }\n        _ => {\n            eprintln!(\"usage: finspool knit|sting|ease|look\");\n            let _ = SHIFT.len();\n            process::exit(2);\n        }\n    }\n}\nEOF\n/app/bin/finspool knit\n"]
