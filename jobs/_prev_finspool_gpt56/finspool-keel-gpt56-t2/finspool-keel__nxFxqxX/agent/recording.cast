[19.395746, "o", "     4\t    } else {\r\n"]
[19.397877, "o", "     5\t        0\r\n     6\t    }\r\n"]
[19.397986, "o", "     7\t}\r\n"]
[19.398526, "o", "===== /app/spindock/spin.rs =====\r\n"]
[19.39983, "o", "     1\t#[path = \"/app/spindock/modes.rs\"]\r\n     2\tmod modes;\r\n     3\t#[path = \"/app/spindock/text.rs\"]\r\n     4\tmod text;\r\n     5\t\r\n     6\tuse std::fs;\r\n     7\t\r\n     8\tfn main() {\r\n     9\t    let _ = text::pad_out(\"x\");\r\n    10\t    let hard_gather = modes::op_a(1) == 0;\r\n    11\t    let src = if hard_gather {\r\n    12\t        \"/app/tplfold/gather.rs\"\r\n    13\t    } else {\r\n"]
[19.401381, "o", "    14\t        \"/app/tplfold/live.rs\"\r\n    15\t    };\r\n    16\t    let body = fs::read_to_string(src).unwrap();\r\n    17\t    fs::write(\"/app/hookvat/gen_emit.rs\", body).unwrap();\r\n    18\t}\r\n===== /app/spindock/text.rs =====\r\n"]
