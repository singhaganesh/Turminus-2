[19.407253, "o", "===== /app/hookvat/gen_emit.rs =====\r\n"]
[19.409357, "o", "     1\tuse std::io::Write;\r\n"]
[19.409773, "o", "     2\t\r\n"]
[19.410127, "o", "     3\tpub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n"]
[19.410374, "o", "     4\t    let mut s = crate::spool::op_b(dest);\r\n"]
[19.410616, "o", "     5\t    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n"]
[19.410902, "o", "     6\t    if hard {\r\n"]
[19.411158, "o", "     7\t        crate::spool::stash(card.into_bytes());\r\n"]
[19.411448, "o", "     8\t    } else {\r\n"]
[19.411958, "o", "     9\t        let _ = s.write_all(card.as_bytes());\r\n    10\t    }\r\n"]
[19.412002, "o", "    11\t    crate::seal::op_c(&mut s);\r\n    12\t    crate::spool::park(s);\r\n    13\t    0\r\n    14\t}\r\n"]
[19.412469, "o", "===== /app/hookvat/open.rs =====\r\n"]
[19.413735, "o", "     1\tpub fn under_root(p: &str) -> bool {\r\n     2\t    p.starts_with(\"/app/bloturn/\")\r\n     3\t}\r\n"]
[19.414755, "o", "===== /app/hookvat/seal.rs =====\r\n"]
[19.415675, "o", "     1\tuse std::io::Write;\r\n     2\tuse std::sync::atomic::{AtomicBool, Ordering};\r\n     3\t\r\n     4\tstatic NEED: AtomicBool = AtomicBool::new(false);\r\n     5\t\r\n     6\tpub fn op_c<W: Write>(_w: &mut W) {\r\n     7\t    NEED.store(true, Ordering::SeqCst);\r\n     8\t}\r\n     9\t\r\n    10\tpub fn drip<W: Write>(w: &mut W) {\r\n    11\t    if NEED.swap(false, Ordering::SeqCst) {\r\n    12\t        let _ = writeln!(w, \"END\");\r\n"]
[19.415832, "o", "    13\t    }\r\n    14\t}\r\n===== /app/hookvat/spool.rs =====\r\n"]
[19.417127, "o", "     1\tuse std::fs::File;\r\n     2\tuse std::io::{BufWriter, Write};\r\n"]
[19.417904, "o", "     3\tuse std::sync::Mutex;\r\n     4\t\r\n     5\t#[path = \"/app/slipcards/cap.rs\"]\r\n     6\tmod cap;\r\n     7\t\r\n"]
[19.418028, "o", "     8\tstatic BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());\r\n     9\tstatic SLOT: Mutex<Option<BufWriter<File>>> = Mutex::new(None);\r\n    10\t\r\n    11\t#[allow(dead_code)]\r\n    12\tpub fn stash(b: Vec<u8>) {\r\n    13\t    *BAG.lock().unwrap() = b;\r\n    14\t}\r\n    15\t\r\n    16\tpub fn op_b(p: &str) -> BufWriter<File> {\r\n    17\t    let f = File::create(p).unwrap();\r\n    18\t    BufWriter::with_capacity(cap::ROOM, f)\r\n    19\t}\r\n    20\t\r\n    21\tpub fn park(s: BufWriter<File>) {\r\n"]
[19.418496, "o", "    22\t    *SLOT.lock().unwrap() = Some(s);\r\n    23\t}\r\n    24\t\r\n    25\tpub fn release() {\r\n    26\t    let extra = BAG.lock().unwrap().split_off(0);\r\n    27\t    if let Some(mut s) = SLOT.lock().unwrap().take() {\r\n    28\t        if !extra.is_empty() {\r\n"]
[19.418595, "o", "    29\t            let _ = s.write_all(&extra);\r\n    30\t        }\r\n    31\t        crate::seal::drip(&mut s);\r\n    32\t        let _ = s.flush();\r\n    33\t    }\r\n    34\t}\r\n"]
[19.420627, "o", "===== /app/scanpit/fmt.rs =====\r\n"]
[19.420688, "o", "     1\tpub fn indent(n: usize) -> String {\r\n"]
[19.420815, "o", "     2\t    \" \".repeat(n)\r\n"]
[19.420939, "o", "     3\t}\r\n"]
[19.421201, "o", "===== /app/scanpit/peek.rs =====\r\n"]
[19.427106, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\r\n     4\t\r\n     5\tpub fn show(p: &str) -> i32 {\r\n     6\t    let _ = SHAPE.len();\r\n     7\t    let raw = match fs::read_to_string(p) {\r\n     8\t        Ok(s) => s,\r\n     9\t        Err(_) => return 1,\r\n    10\t    };\r\n    11\t    let want: Vec<&str> = raw.lines().collect();\r\n    12\t    if want.len() != 4 {\r\n    13\t        return 1;\r\n    14\t    }\r\n    15\t    if want[0] != \"FIN1\" {\r\n    16\t        return 1;\r\n    17\t    }\r\n    18\t    if !want[1].starts_with(\"thread=\") {\r\n    19\t        return 1;\r\n    20\t    }\r\n    21\t    if !want[2].starts_with(\"op=\") {\r\n    22\t        return 1;\r\n    23\t    }\r\n    24\t    if want[3] != \"END\" {\r\n    25\t        return 1;\r\n    26\t    }\r\n    27\t    if !raw.ends_with('\\n') {\r\n    28\t        return 1;\r\n    29\t    }\r\n    30\t    print!(\"{}\", raw);\r\n    31\t    0\r\n    32\t}\r\n===== /app/fincli/boot.rs =====\r\n"]
[19.428901, "o", "     1\t#[path = \"/app/hookvat/spool.rs\"]\r\n     2\tmod spool;\r\n     3\t#[path = \"/app/hookvat/seal.rs\"]\r\n     4\tmod seal;\r\n     5\t#[path = \"/app/hookvat/open.rs\"]\r\n     6\tmod open;\r\n     7\t#[path = \"/app/hookvat/gen_emit.rs\"]\r\n     8\tmod emit;\r\n     9\t#[path = \"/app/scanpit/peek.rs\"]\r\n    10\tmod peek;\r\n    11\t#[path = \"/app/scanpit/fmt.rs\"]\r\n    12\tmod fmt;\r\n    13\t\r\n    14\tuse std::env;\r\n    15\tuse std::process;\r\n    16\t\r\n    17\tconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\r\n    18\t\r\n    19\tfn main() {\r\n    20\t    let mut args = env::args().skip(1);\r\n    21\t    let cmd = args.next().unwrap_or_default();\r\n    22\t    match cmd.as_str() {\r\n    23\t        \"knit\" => {\r\n    24\t            let st = process::Command::new(\"/app/hull.sh\").status();\r\n    25\t            process::exit(if st.map(|s| s.success()).unwrap_or(false) {\r\n    26\t                0\r\n    27\t            } else {\r\n    28\t                1\r\n    29\t            });\r\n    30\t        }\r\n    31\t        \"look\" => {\r\n    32\t            let dest = args.next().unwrap_or_default();\r\n    33\t            let _ = fmt::indent(0);\r\n    34\t            process::exit(peek::show(&dest));\r\n    35\t        }\r\n    36\t        \"ease\" => {\r\n    37\t            let th = args.next().unwrap_or_default();\r\n    38\t            let verb = args.next().unwrap_or_default();\r\n    39\t            let dest = args.next().unwrap_or_default();\r\n    40\t            let _ = open::under_root(&dest);\r\n    41\t            if emit::go(&th, &verb, &dest, false) != 0 {\r\n    42\t                process::exit(2);\r\n    43\t            }\r\n"]
[19.429432, "o", "    44\t            spool::release();\r\n    45\t        }\r\n    46\t        \"sting\" => {\r\n    47\t            let th = args.next().unwrap_or_default();\r\n    48\t            let verb = args.next().unwrap_or_default();\r\n    49\t            let dest = args.next().unwrap_or_default();\r\n    50\t            let _ = open::under_root(&dest);\r\n    51\t            if emit::go(&th, &verb, &dest, true) != 0 {\r\n    52\t                process::exit(2);\r\n    53\t            }\r\n    54\t            process::abort();\r\n    55\t        }\r\n    56\t        _ => {\r\n    57\t            eprintln!(\"usage: finspool knit|sting|ease|look\");\r\n    58\t            let _ = SHIFT.len();\r\n    59\t            process::exit(2);\r\n    60\t        }\r\n    61\t    }\r\n    62\t}\r\n===== /app/tplfold/emit.tpl =====\r\n"]
[19.4306, "o", "     1\t{{BODY}}\r\n"]
[19.431083, "o", "===== /app/tplfold/gather.rs =====\r\n"]
[19.432295, "o", "     1\tuse std::io::Write;\r\n     2\t\r\n     3\tpub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n     4\t    let mut s = crate::spool::op_b(dest);\r\n"]
[19.433908, "o", "     5\t    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n     6\t    if hard {\r\n     7\t        crate::spool::stash(card.into_bytes());\r\n     8\t    } else {\r\n     9\t        let _ = s.write_all(card.as_bytes());\r\n    10\t    }\r\n    11\t    crate::seal::op_c(&mut s);\r\n    12\t    crate::spool::park(s);\r\n    13\t    0\r\n    14\t}\r\n"]
[19.43422, "o", "===== /app/tplfold/live.rs =====\r\n"]
[19.436598, "o", "     1\tuse std::io::Write;\r\n"]
[19.43686, "o", "     2\t\r\n     3\tpub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n     4\t    let mut s = crate::spool::op_b(dest);\r\n     5\t    let card = format!(\"FIN1\\nthread={}\\nop={}\\n\", nm, verb);\r\n     6\t    let _ = s.write_all(card.as_bytes());\r\n     7\t    crate::seal::op_c(&mut s);\r\n     8\t    crate::spool::park(s);\r\n     9\t    let _ = hard;\r\n    10\t    0\r\n    11\t}\r\n"]
[19.440367, "o", "===== /app/tplfold/modes.knt =====\r\n"]
[19.442499, "o", "     1\t0 gather\r\n     2\t1 live\r\n"]
