[19.386744, "o", "     2\t\r\n     3\tFIN1\r\n     4\tthread=<name>\r\n     5\top=<verb>\r\n     6\tEND\r\n     7\t\r\n     8\tEach line ends with a newline.\r\n"]
[19.386957, "o", "     9\t\r\n    10\tSample sting arguments on this bench: thread desk-k4 or n1, and op\r\n    11\tsplice-harbor-overlong-token-alpha-zz, quay-splice-harbor-overlong-token-beta-yy,\r\n    12\tor v1.\r\n"]
