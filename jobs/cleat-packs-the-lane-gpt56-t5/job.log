{\n\t{"A", "A1", 180, 2000, 8000}, {"A", "A2", 180, 2000, 8000},\n\t{"B", "B1", 420, 2000, 18000}, {"B", "B2", 420, 2000, 18000},\n} }\nfunc deckLid(deck string) int { if deck == "A" { return 11000 }; return 28000 }\nfunc sister(name string) string { switch name { case "A1": return "A2"; case "A2": return "A1"; case "B1": return "B2"; default: return "B1" } }\nEOF\ncat > board.go <<\'EOF\'\npackage main\nimport "sort"\nfunc arrange(cars []Car) []Car {\n\tout := append([]Car(nil), cars...)\n\tsort.Slice(out, func(i,j int) bool { if out[i].Board != out[j].Board { return out[i].Board < out[j].Board }; return out[i].Plate < out[j].Plate })\n\treturn out\n}\nfunc stationOf(cursor int, car Car, gap int) int { return cursor-gap-car.Len }\nEOF\ncat > apron.go <<\'EOF\'\npackage main\nfunc rampApron(haz int) int { if haz == 1 { return 100 }; return 0 }\nEOF\ncat > spacing.go <<\'EOF\'\npackage main\nfunc neighbourGap(prevHaz, haz int) int {\n\tif prevHaz == 0 && haz == 0 { return 0 }\n\tif prevHaz == 1 && haz == 1 { return 200 }\n\treturn 100\n}\nEOF\ncat > kilo.go <<\'EOF\'\npackage main\nfunc massFits(lane Lane, slot *occ, car Car, deckUsed int) bool {\n\tused := 0; if slot != nil { used = slot.mass }\n\treturn used+car.Mass <= lane.MassLid && deckUsed+car.Mass <= deckLid(lane.Deck)\n}\nEOF\ncat > trim.go <<\'EOF\'\npackage main\nfunc trimFits(lane Lane, fill map[string]*occ, extra int) bool {\n\there, other := fill[lane.Name], fill[sister(lane.Name)]\n\tif here == nil || !here.has || other == nil || !other.has { return true }\n\td := here.mass + extra - other.mass; if d < 0 { d = -d }\n\treturn d <= 3000\n}\nEOF\ncat > offer.go <<\'EOF\'\npackage main\n\ntype occ struct { used, mass, lastHaz int; has bool }\ntype offer struct { lane Lane; gap, station int; ok bool }\n\nfunc pickLane(car Car, fill map[string]*occ, deckKg map[string]int) offer {\n\tfor _, lane := range allLanes() {\n\t\tif car.Ht > lane.Lid { continue }\n\t\tslot := fill[lane.Name]\n\t\tgap, used := 0, 0\n\t\tif slot != nil && slot.has { gap, used = neighbourGap(slot.lastHaz, car.Haz), slot.used }\n\t\tif used+gap+car.Len+rampApron(car.Haz) > lane.Span { continue }\n\t\tif !massFits(lane, slot, car, deckKg[lane.Deck]) || !trimFits(lane, fill, car.Mass) { continue }\n\t\treturn offer{lane:lane, gap:gap, station:stationOf(lane.Span-used, car, gap), ok:true}\n\t}\n\treturn offer{}\n}\nEOF\ncat > fold.go <<\'EOF\'\npackage main\n\nimport (\n\t"encoding/json"\n\t"strconv"\n\t"strings"\n)\n\ntype result struct { ok bool; deck, lane string; station int }\ntype chalkRow struct {\n\tI int `json:"i"`\n\tVerb string `json:"verb"`\n\tPlate string `json:"plate"`\n\tDeck string `json:"deck,omitempty"`\n\tLane string `json:"lane,omitempty"`\n\tStation string `json:"station,omitempty"`\n\tOK string `json:"ok"`\n}\n\nfunc fold(sheet string) (int, string) {\n\tcars, rc := parseRoll(sheet); if rc != 0 { return rc, "" }\n\tif len(cars) == 0 { return 0, "" }\n\tfill := map[string]*occ{}; deckKg := map[string]int{}; results := make([]result, len(cars))\n\tfor _, car := range arrange(cars) {\n\t\tx := pickLane(car, fill, deckKg)\n\t\tif !x.ok { continue }\n\t\tslot := fill[x.lane.Name]; if slot == nil { slot=&occ{}; fill[x.lane.Name]=slot }\n\t\tslot.used += x.gap + car.Len + rampApron(car.Haz); slot.mass += car.Mass; slot.lastHaz=car.Haz; slot.has=true\n\t\tdeckKg[x.lane.Deck] += car.Mass\n\t\tresults[car.Index] = result{true, x.lane.Deck, x.lane.Name, x.station}\n\t}\n\tvar out strings.Builder\n\tfor i, car := range cars {\n\t\tr := results[i]; row := chalkRow{I:i+1, Verb:"stow", Plate:car.Plate, OK:"no"}\n\t\tif r.ok { row.Deck=r.deck; row.Lane=r.lane; row.Station=strconv.Itoa(r.station); row.OK="yes" }\n\t\tb,_ := json.Marshal(row); out.Write(b); out.WriteByte(\'\\n\')\n\t}\n\treturn 0, out.String()\n}\nEOF\n\ngofmt -w *.go && make install\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
