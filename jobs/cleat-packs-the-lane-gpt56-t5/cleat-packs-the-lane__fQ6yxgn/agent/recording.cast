[18.146785, "o", "    11\t\t}\r\n    12\t\tfor _, r := range text {\r\n    13\t\t\tif unicode.IsLetter(r) || unicode.IsDigit(r) || r == '.' || r == '_' || r == '-' {\r\n    14\t\t\t\tcontinue\r\n    15\t\t\t}\r\n    16\t\t\treturn false\r\n    17\t\t}\r\n    18\t\treturn true\r\n    19\t}\r\n    20\t\r\n    21\tfunc parseRoll(sheet string) ([]Car, int) {\r\n    22\t\tvar cars []Car\r\n    23\t\tfor _, raw := range strings.Split(sheet, \"\\n\") {\r\n    24\t\t\tline := strings.TrimSpace(raw)\r\n    25\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    26\t\t\t\tcontinue\r\n    27\t\t\t}\r\n    28\t\t\twords := strings.Fields(line)\r\n    29\t\t\tif len(words) < 10 {\r\n    30\t\t\t\tcontinue\r\n    31\t\t\t}\r\n    32\t\t\tif words[0] != \"PLATE\" || words[2] != \"LEN\" || words[4] != \"HT\" || words[6] != \"HAZ\" || words[8] != \"BOARD\" {\r\n    33\t\t\t\tcontinue\r\n    34\t\t\t}\r\n    35\t\t\tif !safeName(words[1]) {\r\n    36\t\t\t\tcontinue\r\n    37\t\t\t}\r\n    38\t\t\tlength := atoiLoose(words[3])\r\n"]
[18.146888, "o", "    39\t\t\tht := atoiLoose(words[5])\r\n    40\t\t\thaz := atoiLoose(words[7])\r\n    41\t\t\tboard := atoiLoose(words[9])\r\n    42\t\t\tif ht < 0 || board < 0 {\r\n    43\t\t\t\tcontinue\r\n    44\t\t\t}\r\n    45\t"]
[18.146961, "o", "\t\tcars = append(cars, Car{Plate: words[1], Len: length, Ht: ht, Haz: haz, Board: board})\r\n    46\t\t}\r\n    47\t\treturn cars, 0\r\n    48\t}\r\n    49\t\r\n    50\tfunc atoiLoose(text string) int {\r\n    51\t\tif text == \"\" {\r\n    52\t\t\treturn 0\r\n    53\t\t}\r\n    54\t\tn := 0\r\n    55\t\tfor _, r := range text {\r\n    56\t\t\tif r < '0' || r > '9' {\r\n    57\t\t\t\treturn 0\r\n    58\t\t\t}\r\n    59\t\t\tn = n*10 + int(r-'0')\r\n    60\t\t}\r\n    61\t\treturn n\r\n    62\t}\r\n"]
[18.147223, "o", "### offer.go\r\n"]
[18.148267, "o", "     1\tpackage main\r\n     2\t\r\n     3\ttype occ struct {\r\n     4\t\tused    int\r\n     5\t\tmass    int\r\n     6\t\tlastHaz int\r\n     7\t\thas     bool\r\n     8\t}\r\n     9\t\r\n    10\tfunc pickLane(car Car, fill map[string]*occ, deckKg map[string]int) Lane {\r\n    11\t\t_ = car\r\n    12\t\t_ = fill\r\n    13\t\t_ = deckKg\r\n    14\t\treturn Lane{Deck: \"B\", Name: \"B1\", Lid: 420, Span: 2000}\r\n    15\t}\r\n"]
