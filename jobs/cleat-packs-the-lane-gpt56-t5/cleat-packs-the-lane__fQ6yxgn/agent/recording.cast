[91.27739, "i", "t) {\n\tvar cars []Car\n\tfor _, raw := range strings.Split(sheet, \"\\n\") {\n\t\tline := strings.TrimSpace(raw)\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") { continue }\n\t\tw := strings.Fields(line)\n\t\tif len(w) != 12 || w[0] != \"PLATE\" || w[2] != \"LEN\" || w[4] != \"HT\" || w[6] != \"MASS\" || w[8] != \"HAZ\" || w[10] != \"BOARD\" || !safeName(w[1]) { return nil, -2 }\n\t\tlength, a := positive(w[3]); ht, b := positive(w[5]); mass, c := positive(w[7]); haz, d := unsigned(w[9]); board, e := positive(w[11])\n\t\tif !a || !b || !c || !d || !e || haz > 1 { return nil, -2 }\n\t\tcars = append(cars, Car{Plate:w[1], Len:length, Ht:ht, Mass:mass, Haz:haz, Board:board, Index:len(cars)})\n\t}\n\treturn cars, 0\n}\nEOF\ncat > vault.go <<'EOF'\npackage main\n\ntype Lane struct { Deck, Name string; Lid, Span, MassLid int }\nfunc allLanes() []Lane { return []Lane{\n\t{\"A\", \"A1\", 180, 2000, 8000}, {\"A\", \"A2\", 180, 2000, 8000},\n\t{\"B\", \"B1\", 420, 2000, 18000}, {\"B\", \"B2\", 420, 2000, 18000},\n} }\nfunc deckLid(deck string) int { if deck == \"A\" { return 11000 }; ret"]
