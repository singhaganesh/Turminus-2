[91.277676, "i", "urn 28000 }\nfunc sister(name string) string { switch name { case \"A1\": return \"A2\"; case \"A2\": return \"A1\"; case \"B1\": return \"B2\"; default: return \"B1\" } }\nEOF\ncat > board.go <<'EOF'\npackage main\nimport \"sort\"\nfunc arrange(cars []Car) []Car {\n\tout := append([]Car(nil), cars...)\n\tsort.Slice(out, func(i,j int) bool { if out[i].Board != out[j].Board { return out[i].Board < out[j].Board }; return out[i].Plate < out[j].Plate })\n\treturn out\n}\nfunc stationOf(cursor int, car Car, gap int) int { return cursor-gap-car.Len }\nEOF\ncat > apron.go <<'EOF'\npackage main\nfunc rampApron(haz int) int { if haz == 1 { return 100 }; return 0 }\nEOF\ncat > spacing.go <<'EOF'\npackage main\nfunc neighbourGap(prevHaz, haz int) int {\n\tif prevHaz == 0 && haz == 0 { return 0 }\n\tif prevHaz == 1 && haz == 1 { return 200 }\n\treturn 100\n}\nEOF\ncat > kilo.go <<'EOF'\npackage main\nfunc massFits(lane Lane, slot *occ, car Car, deckUsed int) bool {\n\tused := 0; if slot != nil { used = slot.mass }\n\treturn used+car.Mass <= lane.MassLid && deckUsed+car.Mas"]
