[18.149153, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport \"fmt\"\r\n     4\t\r\n     5\tfunc emit(lines *[]string, i *int, plate, deck, lane, station, ok string) {\r\n     6\t\t*i++\r\n     7\t\trow := fmt.Sprintf(`{\"i\":%d,\"verb\":\"stow\"`, *i)\r\n"]
