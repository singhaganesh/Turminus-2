[93.041046, "i", "set +e\ncat > /tmp/check.roll <<'EOF'\n# listing differs from boarding\nPLATE later LEN 300 HT 160 MASS 1000 HAZ 0 BOARD 2\nPLATE early LEN 400 HT 160 MASS 1000 HAZ 0 BOARD 1\nPLATE tall LEN 500 HT 181 MASS 2000 HAZ 0 BOARD 3\nPLATE flag1 LEN 200 HT 160 MASS 500 HAZ 1 BOARD 4\nPLATE flag2 LEN 200 HT 160 MASS 500 HAZ 1 BOARD 5\nPLATE huge LEN 2001 HT 100 MASS 1 HAZ 0 BOARD 6\nEOF\n/opt/ferry/bin/cleat stow --roll /app/rolls/night.roll --chalk /tmp/night.chalk; echo sample_rc=$?; cat /tmp/night.chalk\n/opt/ferry/bin/cleat stow --roll /tmp/check.roll --chalk /tmp/check.chalk; echo check_rc=$?; cat /tmp/check.chalk\n: >/tmp/empty.roll; echo stale >/tmp/empty.chalk; /opt/ferry/bin/cleat stow --roll /tmp/empty.roll --chalk /tmp/empty.chalk; echo empty_rc=$? bytes=$(wc -c </tmp/empty.chalk)\nprintf 'PLATE bad LEN 1 HT 1 MASS 1 HAZ 2 BOARD 1\\n' >/tmp/bad.roll; echo stale >/tmp/bad.chalk; /opt/ferry/bin/cleat stow --roll /tmp/bad.roll --chalk /tmp/bad.chalk; echo bad_rc=$? bytes=$(wc -c </tmp/bad.chalk)\n"]
