[196.226112, "i", "cat > spacing.go <<'EOF'\npackage main\n\n// neighbourGap returns extra space needed in addition to any ramp apron\n// already reserved by the previous plate.\nfunc neighbourGap(prevHaz, haz int) int {\n\trequired := 0\n\tif prevHaz == 1 || haz == 1 {\n\t\trequired = 100\n\t}\n\tif prevHaz == 1 && haz == 1 {\n\t\trequired = 200\n\t}\n\talreadyReserved := rampApron(prevHaz)\n\tif required > alreadyReserved {\n\t\treturn required - alreadyReserved\n\t}\n\treturn 0\n}\nEOF\ngofmt -w spacing.go && go vet ./... && make install\n/opt/ferry/bin/cleat stow --roll /tmp/gaps.roll --chalk /tmp/gaps.chalk; echo gaps_rc=$?; cat /tmp/gaps.chalk\n/opt/ferry/bin/cleat stow --roll /app/rolls/night.roll --chalk /tmp/night.chalk; echo sample_rc=$?; cat /tmp/night.chalk\n"]
