use crate::cards;
use crate::loom;
use crate::table;
use crate::tally;
use std::fs;

pub fn rib_c() -> i32 {
    let _ = tally::lines();
    let _ = loom::emit();
    let spec = cards::load();
    let served = spec
        .iter()
        .map(|row| format!("\"{}\"", row.label))
        .collect::<Vec<_>>()
        .join(",");
    let sealed = spec
        .iter()
        .all(|row| table::supports(row.wire, &row.reply));
    let status = if sealed { "sealed" } else { "open" };
    let _ = fs::create_dir_all("/app/corkbay");
    let text = format!(
        "{{\"served\":[{}],\"status\":\"{}\"}}\n",
        served, status
    );
    let _ = fs::write("/app/corkbay/seal.json", text);
    if sealed { 0 } else { 1 }
}
