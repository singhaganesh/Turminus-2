[59.724159, "o", "sed -n '1,240p' /app/hopmat/table.rs; echo '---'; cat /app/rimcap/span.rs; echo '---'; sed -n '1,240p' /app/lidpit/plug.rs\r\n\u001b[?2004l\r"]
[59.72541, "o", "use crate::span;\r\n\r\nconst RAW: &str = include_str!(\"../loomkit/emit.lst\");\r\n\r\n#[derive(Clone)]\r\npub struct Slot {\r\n    #[allow(dead_code)]\r\n    pub label: String,\r\n    pub reply: String,\r\n}\r\n\r\nimpl Default for Slot {\r\n    fn default() -> Self {\r\n        Self {\r\n            label: String::new(),\r\n            reply: \"fallthrough\".to_string(),\r\n        }\r\n    }\r\n}\r\n\r\n"]
[59.725579, "o", "fn parse_line(line: &str) -> Option<(u8, Slot)> {\r\n    let mut parts = line.split('\\t');\r\n    let label = parts.next()?.trim().to_string();\r\n    let wire: u8 = parts.next()?.trim().parse().ok()?;\r\n    let reply = parts.next()?.trim().to_string();\r\n    if label.is_empty() {\r\n        return None;\r\n    }\r\n    Some((wire, Slot { label, reply }))\r\n}\r\n\r\npub fn rib_b() -> Vec<Slot> {\r\n    let cap = span::rib_a();\r\n    let mut slots: Vec<Slot> = vec![Slot::default(); 256];\r\n    for (i, line) in RAW.lines().enumerate() {\r\n        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        if let Some((_w, slot)) = parse_line(line) {\r\n            if i < cap {\r\n                slots[_w as usize] = slot;\r\n            }\r\n        }\r\n    }\r\n    slots\r\n}\r\n\r\npub fn supports(wire: u8, reply: &str) -> bool {\r\n    rib_b()[wire as usize].reply == reply\r\n}\r\n\r\npub fn tap(n: u8) -> i32 {\r\n    let slots = rib_b();\r\n    let row = &slots[n as usize];\r\n    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":\\\"{}\\\"}}\", n, row.reply);\r\n    0\r\n}\r\n"]
[59.725839, "o", "---\r\n"]
[59.726697, "o", "pub fn rib_a() -> usize {\r\n    9\r\n}\r\n"]
[59.726843, "o", "---\r\n"]
[59.728147, "o", "use crate::cards;\r\nuse crate::loom;\r\nuse crate::table;\r\nuse crate::tally;\r\nuse std::fs;\r\n\r\npub fn rib_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let _ = loom::emit();\r\n    let spec = cards::load();\r\n    let served = spec\r\n        .iter()\r\n        .map(|row| format!(\"\\\"{}\\\"\", row.label))\r\n        .collect::<Vec<_>>()\r\n        .join(\",\");\r\n    let sealed = spec\r\n        .iter()\r\n        .all(|row| table::supports(row.wire, &row.reply));\r\n    let status = if sealed { \"sealed\" } else { \"open\" };\r\n"]
[59.728286, "o", "    let _ = fs::create_dir_all(\"/app/corkbay\");\r\n    let text = format!(\r\n        \"{{\\\"served\\\":[{}],\\\"status\\\":\\\"{}\\\"}}\\n\",\r\n        served, status\r\n    );\r\n    let _ = fs::write(\"/app/corkbay/seal.json\", text);\r\n    if sealed { 0 } else { 1 }\r\n}\r\n"]
