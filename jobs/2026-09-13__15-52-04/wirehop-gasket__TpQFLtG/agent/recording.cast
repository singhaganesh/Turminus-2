[10.428509, "i", "pwd; printf '%s\\n' '--- MAP ---'; cat /app/opscribe/MAP.txt; printf '%s\\n' '--- FILES ---'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort; printf '%s\\n' '--- BINARY ---'; file /app/bin/gasketd; ls -l /app/bin/gasketd\n"]
