[20.858964, "o", "\u001b[?2004hroot@b5615c36e7e0:/app# "]
[61.934111, "i", "cat > /app/rimcap/span.rs <<'EOF'\npub fn rib_a() -> usize {\n    256\n}\nEOF\ncat > /app/hopmat/table.rs <<'EOF'\nuse crate::span;\n\n// This file is captured by rustc.  bind may rewrite emit.lst later, but that\n// must not change the hopper already compiled into gasketd.\nconst RAW: &str = include_str!(\"../loomkit/emit.lst\");\n\n#[derive(Clone)]\npub struct Slot {\n    pub label: String,\n    pub reply: String,\n}\n\nimpl Default for Slot {\n    fn default() -> Self {\n        Self {\n            label: String::new(),\n            reply: \"fallthrough\".to_string(),\n        }\n    }\n}\n\nfn parse_line(line: &str) -> Option<(u8, Slot)> {\n    let mut parts = line.split('\\t');\n    let label = parts.next()?.trim().to_string();\n    let wire: u8 = parts.next()?.trim().parse().ok()?;\n    let reply = parts.next()?.trim().to_string();\n    if label.is_empty() || reply.is_empty() {\n        return None;\n    }\n    Some((wire, Slot { label, reply }))\n}\n\npub fn rib_b() -> Vec<Slot> {\n    let cap = span::rib_a();\n    let mut slots = vec![Slot::default(); cap];\n    for line in RAW.lines().filter(|line| !line.trim().is_empty()) {\n        if let Some((wire, slot)) = parse_line(line) {\n            let index = wire as usize;\n            if index < slots.len() {\n                slots[index] = slot;\n            }\n        }\n    }\n    slots\n}\n\npub fn lookup(n: u8) -> Slot {\n    rib_b().get(n as usize).cloned().unwrap_or_default()\n}\n\npub fn tap(n: i64) -> i32 {\n    let row = if (0..=u8::MAX as i64).contains(&n) {\n        lookup(n as u8)\n    } else {\n        Slot::default()\n    };\n    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":\\\"{}\\\"}}\", n, row.reply);\n    0\n}\nEOF\npython3 - <<'PY'\np='/app/gaskcli/boot.rs'\ns=open(p).read()\ns=s.replace('let n: u8 = raw.parse().unwrap_or(0);', 'let n: i64 = raw.parse().unwrap_or(0);')\nopen(p,'w').write(s)\nPY\ncat > /app/lidpit/plug.rs <<'EOF'\nuse crate::cards;\nuse crate::loom;\nuse crate::table;\nuse crate::tally;\nuse std::fs;\n\npub fn rib_c() -> i32 {\n    let _ = tally::lines();\n    let _ = loom::emit();\n    let spec = cards::load();\n\n    // A card is served only when the immutable, compiled hopper has that\n    // card's own label and reply at its WIRE.  The roster is deliberately not\n    // used as dispatch state: bind may contain cards added after compilation.\n    let sealed = spec.iter().all(|row| {\n        let slot = table::lookup(row.wire);\n        slot.label == row.label && slot.reply == row.reply && slot.reply != \"fallthrough\"\n    });\n\n    let served = spec\n        .iter()\n        .map(|row| format!(\"\\\"{}\\\"\", row.label))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    let status = if sealed { \"sealed\" } else { \"open\" };\n    let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"{}\\\"}}\\n\", served, status);\n    let _ = fs::create_dir_all(\"/app/corkbay\");\n    if fs::write(\"/app/corkbay/seal.json\", text).is_err() {\n        return 1;\n    }\n    if sealed { 0 } else { 1 }\n}\nEOF\n/app/stoke.sh\n"]
[61.936721, "o", "cat > /app/rimcap/span.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> pub fn rib_a() -> usize {\r\n\u001b[?2004l\r\u001b[?2004h>     256\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
