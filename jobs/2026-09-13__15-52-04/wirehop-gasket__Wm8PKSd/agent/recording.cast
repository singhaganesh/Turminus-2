[20.824236, "o", "{\"names\":[\"SET_FAN\",\"SET_PUMP\",\"SET_VALVE\",\"READ_TEMP\",\"READ_PRESS\",\"HOLD_LATCH\",\"TRIM_BIAS\",\"ACK_WATCH\",\"VENT_LINE\"]}\r\n"]
[20.824521, "o", "--- /app/corkbay/seal.json\r\n"]
[20.827248, "o", "{\"served\":[\"SET_FAN\",\"SET_PUMP\",\"SET_VALVE\",\"READ_TEMP\",\"READ_PRESS\",\"HOLD_LATCH\",\"TRIM_BIAS\",\"ACK_WATCH\",\"VENT_LINE\"],\"status\":\"sealed\"}\r\n"]
[20.827627, "o", "===== ELF magic =====\r\n"]
[20.843422, "o", " 7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\r\n"]
[20.844583, "o", "===== current behavior =====\r\n"]
[20.847049, "o", "{\"wire\":1,\"reply\":\"pump-ok\"}\r\n"]
[20.848081, "o", "{\"wire\":2,\"reply\":\"valve-ok\"}\r\n"]
[20.849657, "o", "{\"wire\":4,\"reply\":\"press-ok\"}\r\n"]
[20.850711, "o", "{\"wire\":7,\"reply\":\"watch-ok\"}\r\n"]
[20.851668, "o", "{\"wire\":8,\"reply\":\"fallthrough\"}\r\n"]
[20.85259, "o", "{\"wire\":10,\"reply\":\"fallthrough\"}\r\n"]
[20.853605, "o", "{\"wire\":12,\"reply\":\"fallthrough\"}\r\n"]
[20.854688, "o", "{\"wire\":15,\"reply\":\"fallthrough\"}\r\n"]
[20.855744, "o", "{\"wire\":17,\"reply\":\"fallthrough\"}\r\n"]
