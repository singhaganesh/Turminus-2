[64.910059, "i", "cat > /app/buscards/z_later.card <<'EOF'\nLABEL LATER_ONLY\nWIRE 23\nREPLY later-ok\nEOF\n/app/bin/gasketd bind\necho '--- roster after later card ---'; cat /app/mistwell/roster.json\n/app/bin/gasketd jab 23\nset +e\n/app/bin/gasketd cork\nrc=$?\nset -e\necho later_cork_rc=$rc\ncat /app/corkbay/seal.json\ntest \"$rc\" -ne 0\ngrep -q '\"status\":\"open\"' /app/corkbay/seal.json\nrm -f /app/buscards/z_later.card\n/app/bin/gasketd bind\n/app/bin/gasketd cork\necho '--- final seal ---'; cat /app/corkbay/seal.json\necho '--- ELF magic ---'; od -An -tx1 -N4 /app/bin/gasketd\n"]
