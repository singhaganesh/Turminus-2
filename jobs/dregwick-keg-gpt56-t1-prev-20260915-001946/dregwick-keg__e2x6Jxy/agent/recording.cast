[117.865586, "o", "cat > /app/bytecue/CapGate.java <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.865728, "o", "import java.nio.file.Files;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.865871, "o", "import java.nio.file.Path;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.865979, "o", "> import java.nio.file.Paths;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.866079, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.866197, "o", "public class CapGate {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.866356, "o", "    public static int rib_n(Path jar, Path capFile) throws Exception {\r\n\u001b[?2004l\r"]
[117.866444, "o", "\u001b[?2004h> "]
[117.866576, "o", "        if (!Files.isRegularFile(jar)) return 1;\r\n\u001b[?2004l\r"]
[117.866676, "o", "\u001b[?2004h> "]
[117.866804, "o", "        long cap = Long.parseLong(Files.readString(capFile).trim());\r\n\u001b[?2004l\r"]
[117.866884, "o", "\u001b[?2004h> "]
[117.866972, "o", "        return Files.size(jar) <= cap ? 0 : 1;\r\n\u001b[?2004l\r"]
[117.867053, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[117.867138, "o", "\u001b[?2004h> "]
[117.867261, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r"]
[117.867341, "o", "\u001b[?2004h> "]
[117.867456, "o", "        System.exit(rib_n(Paths.get(\"/app/jarwell/husk.jar\"),\r\n\u001b[?2004l\r"]
[117.867568, "o", "\u001b[?2004h> "]
[117.867655, "o", "            Paths.get(\"/app/desknote/CAP.txt\")));\r\n\u001b[?2004l\r"]
[117.867755, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.867848, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
