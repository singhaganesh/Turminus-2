[117.825033, "o", "        for (String line : Files.readAllLines(Paths.get(\"/app/desknote/NAMES.txt\"))) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.825772, "o", "            String s = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h>             if (!s.isEmpty()) {\r\n\u001b[?2004l\r\u001b[?2004h>                 String[] fields = s.split(\"\\\\s+\");\r\n\u001b[?2004l\r\u001b[?2004h>                 if (fields.length >= 2) names.add(fields[1]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.825995, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.826163, "o", "        Files.createDirectories(jar.getParent());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.826282, "o", "        Path tmp = jar.resolveSibling(jar.getFileName() + \".tmp\");\r\n\u001b[?2004l\r"]
[117.82638, "o", "\u001b[?2004h> "]
[117.826583, "o", "        try (JarOutputStream out = new JarOutputStream(Files.newOutputStream(tmp))) {\r\n\u001b[?2004l\r"]
[117.826699, "o", "\u001b[?2004h>             for (String name : names) {\r\n"]
[117.826798, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[117.827015, "o", "                Path src = exploded.resolve(name + \".class\");\r\n\u001b[?2004l\r"]
[117.827226, "o", "\u001b[?2004h> "]
[117.827396, "o", "                if (!Files.isRegularFile(src)) continue;\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.827544, "o", "> "]
[117.827654, "o", "                out.putNextEntry(new JarEntry(name + \".class\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.827781, "o", "                out.write(Files.readAllBytes(src));\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.827887, "o", ">                 out.closeEntry();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.82797, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n"]
[117.828055, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[117.828189, "o", "        Files.move(tmp, jar, java.nio.file.StandardCopyOption.REPLACE_EXISTING);\r\n\u001b[?2004l\r"]
[117.828273, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
