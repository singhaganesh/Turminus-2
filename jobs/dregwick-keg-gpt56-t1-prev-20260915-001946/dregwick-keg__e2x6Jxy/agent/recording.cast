[117.858005, "o", "cat > /app/namelock/TallyGate.java <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.charset.StandardCharsets;\r\n\u001b[?2004l\r"]
[117.859409, "o", "\u001b[?2004h> import java.nio.file.Files;\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.file.Path;\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.file.Paths;\r\n\u001b[?2004l\r\u001b[?2004h> import java.util.LinkedHashSet;\r\n\u001b[?2004l\r\u001b[?2004h> import java.util.Set;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> public class TallyGate {\r\n\u001b[?2004l\r\u001b[?2004h>     public static int tint_span(Path classes, Path roster, Path jar) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.85986, "o", "        Set<String> required = new LinkedHashSet<String>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.860083, "o", "        for (String line : Files.readAllLines(roster)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.860261, "o", "            String s = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.860395, "o", "            if (!s.isEmpty()) required.add(s.split(\"\\\\s+\")[0]);\r\n\u001b[?2004l\r"]
[117.860513, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.860775, "o", "        String java = Paths.get(System.getProperty(\"java.home\"), \"bin\", \"java\").toString();\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.86088, "o", "> "]
[117.86104, "o", "        Process p = new ProcessBuilder(java, \"-cp\", jar.toString(), \"Main\", \"booth\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.861138, "o", "> "]
[117.861236, "o", "            .redirectErrorStream(true).start();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.861538, "o", "        String text = new String(p.getInputStream().readAllBytes(), StandardCharsets.UTF_8);\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.861594, "o", "> "]
[117.861747, "o", "        int status = p.waitFor();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.861872, "o", "        if (status != 0) return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.862043, "o", "        Set<String> live = new LinkedHashSet<String>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.862213, "o", "        for (String line : text.split(\"\\\\R\")) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.86226, "o", "> "]
[117.862438, "o", "            if (!line.trim().isEmpty()) live.add(line.trim());\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.862473, "o", ">         }\r\n\u001b[?2004l\r"]
[117.862598, "o", "\u001b[?2004h> "]
[117.86267, "o", "        return live.containsAll(required) ? 0 : 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[117.862754, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.862919, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r"]
[117.862972, "o", "\u001b[?2004h> "]
[117.863108, "o", "        System.exit(tint_span(Paths.get(\"/app/blastcp\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.863148, "o", "> "]
[117.863282, "o", "            Paths.get(\"/app/desknote/NAMES.txt\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[117.863411, "o", "            Paths.get(\"/app/jarwell/husk.jar\")));\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.863544, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[117.863668, "o", "> EOF\r\n\u001b[?2004l\r"]
