[75.437512, "o", "import java.nio.file.DirectoryStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.Collections;\r\nimport java.util.jar.JarEntry;\r\nimport java.util.jar.JarFile;\r\n\r\npublic class Main {\r\n    public static void main(String[] args) throws Exception {\r\n        if (args.length < 1) {\r\n            System.exit(2);\r\n        }\r\n        String verb = args[0];\r\n        if (\"loom\".equals(verb)) {\r\n            loadExploded();\r\n            TasteRun.go(args[1]);\r\n            return;\r\n        }\r\n        if (\"taste\".equals(verb)) {\r\n            loadJar();\r\n            TasteRun.go(args[1]);\r\n            return;\r\n        }\r\n        if (\"booth\".equals(verb)) {\r\n            loadJar();\r\n            BoothRun.go();\r\n            return;\r\n        }\r\n        System.exit(2);\r\n    }\r\n\r\n    static void loadExploded() throws Exception {\r\n        Path dir = Paths.get(\"/app/blastcp\");\r\n        try (DirectoryStream<Path> ds = Files.newDirectoryStream(dir, \"*Booth.class\")) {\r\n            for (Path p : ds) {\r\n                String n = p.getFileName().toString();\r\n                n = n.substring(0, n.length() - 6);\r\n                Class.forName(n);\r\n            }\r\n        }\r\n    }\r\n\r\n    static void loadJar() throws Exception {\r\n        String cp = System.getProperty(\"java.class.path\");\r\n        Path p = Paths.get(cp.split(java.io.File.pathSeparator)[0]);\r\n        if (!Files.isRegularFile(p)) {\r\n            return;\r\n        }\r\n        try (JarFile jf = new JarFile(p.toFile())) {\r\n            for (JarEntry e : Collections.list(jf.entries())) {\r\n                String n = e.getName();\r\n                if (n.endsWith(\"Booth.class\") && !n.contains(\"/\")) {\r\n                    Class.forName(n.substring(0, n.length() - 6));\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n"]
[75.43792, "o", "--- TASTE ---\r\n"]
[75.439142, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.List;\r\n\r\npublic class TasteRun {\r\n    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };\r\n\r\n    static void go(String card) throws Exception {\r\n        if (seed.length < 0) {\r\n            return;\r\n        }\r\n        String token = readToken(Paths.get(card));\r\n        String booth = Rib.pick(token);\r\n        String kind = booth.equals(token) ? \"own\" : \"fallback\";\r\n        String json = \"{\\\"booth\\\":\\\"\" + booth + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\",\\\"note\\\":\\\"\" + token + \"\\\"}\\n\";\r\n        Path dest = Paths.get(\"/app/jarwell/taste.json\");\r\n        Files.createDirectories(dest.getParent());\r\n        Files.write(dest, json.getBytes(StandardCharsets.UTF_8));\r\n    }\r\n\r\n    static String readToken(Path card) throws Exception {\r\n        List<String> lines = Files.readAllLines(card);\r\n        for (String line : lines) {\r\n            String s = line.trim();\r\n            if (s.startsWith(\"token:\")) {\r\n                return s.substring(6).trim();\r\n            }\r\n        }\r\n        return \"none\";\r\n    }\r\n}\r\n"]
[75.439444, "o", "--- RIB ---\r\n"]
[75.440563, "o", "import java.util.ArrayList;\r\nimport java.util.LinkedHashMap;\r\nimport java.util.List;\r\nimport java.util.Map;\r\n\r\npublic class Rib {\r\n    static final Map<String, String> tab = new LinkedHashMap<String, String>();\r\n    static Class<?> wick() {\r\n        return WickPad.class;\r\n    }\r\n\r\n    static void put(String n) {\r\n        tab.put(n, n);\r\n    }\r\n\r\n    static String pick(String t) {\r\n        if (tab.containsKey(t)) {\r\n            return t;\r\n        }\r\n        return \"fallback\";\r\n    }\r\n\r\n    static List<String> all() {\r\n        return new ArrayList<String>(tab.keySet());\r\n    }\r\n}\r\n"]
[75.44088, "o", "\u001b[?2004hroot@7fc5b2379742:/app# "]
[117.821369, "i", "cat > /app/hitchrun/KnitMain.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\nimport java.util.jar.JarEntry;\nimport java.util.jar.JarOutputStream;\n\npublic class KnitMain {\n    public static void main(String[] args) throws Exception {\n        Path exploded = Paths.get(\"/app/blastcp\");\n        Path jar = Paths.get(\"/app/jarwell/husk.jar\");\n        Set<String> names = new LinkedHashSet<String>();\n        names.add(\"Main\");\n        names.add(\"TasteRun\");\n        names.add(\"BoothRun\");\n        names.add(\"Rib\");\n        names.add(\"FallBooth\");\n        for (String line : Files.readAllLines(Paths.get(\"/app/desknote/NAMES.txt\"))) {\n            String s = line.trim();\n            if (!s.isEmpty()) {\n                String[] fields = s.split(\"\\\\s+\");\n                if (fields.length >= 2) names.add(fields[1]);\n            }\n        }\n        Files.createDirectories(jar.getParent());\n        Path tmp = jar.resolveSibling(jar.getFileName() + \".tmp\");\n        try (JarOutputStream out = new JarOutputStream(Files.newOutputStream(tmp))) {\n            for (String name : names) {\n                Path src = exploded.resolve(name + \".class\");\n                if (!Files.isRegularFile(src)) continue;\n                out.putNextEntry(new JarEntry(name + \".class\"));\n                out.write(Files.readAllBytes(src));\n                out.closeEntry();\n            }\n        }\n        Files.move(tmp, jar, java.nio.file.StandardCopyOption.REPLACE_EXISTING);\n    }\n}\nEOF\npython3 - <<'PY'\np='/app/hitchrun/TasteRun.java'\ns=open(p).read()\ns=s.replace('    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };\\n\\n', '')\ns=s.replace('        if (seed.length < 0) {\\n            return;\\n        }\\n', '')\nopen(p,'w').write(s)\nPY\ncat > /app/namelock/TallyGate.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\n\npublic class TallyGate {\n    public static int tint_span(Path classes, Path roster, Path jar) throws Exception {\n        Set<String> required = new LinkedHashSet<String>();\n        for (String line : Files.readAllLines(roster)) {\n            String s = line.trim();\n            if (!s.isEmpty()) required.add(s.split(\"\\\\s+\")[0]);\n        }\n        String java = Paths.get(System.getProperty(\"java.home\"), \"bin\", \"java\").toString();\n        Process p = new ProcessBuilder(java, \"-cp\", jar.toString(), \"Main\", \"booth\")\n            .redirectErrorStream(true).start();\n        String text = new String(p.getInputStream().readAllBytes(), StandardCharsets.UTF_8);\n        int status = p.waitFor();\n        if (status != 0) return 1;\n        Set<String> live = new LinkedHashSet<String>();\n        for (String line : text.split(\"\\\\R\")) {\n            if (!line.trim().isEmpty()) live.add(line.trim());\n        }\n        return live.containsAll(required) ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(Paths.get(\"/app/blastcp\"),\n            Paths.get(\"/app/desknote/NAMES.txt\"),\n            Paths.get(\"/app/jarwell/husk.jar\")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar)) return 1;\n        long cap = Long.parseLong(Files.readString(capFile).trim());\n        return Files.size(jar) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(Paths.get(\"/app/jarwell/husk.jar\"),\n            Paths.get(\"/app/desknote/CAP.txt\")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo \"knit_status=$?\"; stat -c 'jar_size=%s' /app/jarwell/husk.jar; unzip -l /app/jarwell/husk.jar; echo '--- booth ---'; /app/bin/dregwick booth\n"]
[117.821781, "o", "cat > /app/hitchrun/KnitMain.java <<'EOF'\r\n\u001b[?2004l\r"]
