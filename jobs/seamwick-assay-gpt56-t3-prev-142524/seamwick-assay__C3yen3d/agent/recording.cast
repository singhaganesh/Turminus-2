[143.458507, "o", "import java.nio.file.*;\r\nimport java.util.*;\r\nimport java.util.regex.*;\r\npublic class Sched {\r\n  static Set<String> priorFindingUnits() {\r\n    LinkedHashSet<String> out = new LinkedHashSet<String>();\r\n    try {\r\n      String text = Files.readString(Paths.get(\"/app/blot/last.json\"));\r\n      String needle = \"\\\"unit\\\":\\\"\";\r\n      int at = 0;\r\n      while ((at = text.indexOf(needle, at)) >= 0) {\r\n        int start = at + needle.length();\r\n        int end = text.indexOf('\\\"', start);\r\n        if (end < 0) break;\r\n        out.add(text.substring(start, end));\r\n        at = end + 1;\r\n      }\r\n    } catch (Exception ignored) {}\r\n    return out;\r\n  }\r\n  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\r\n"]
[143.458692, "o", "    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(changedFiles);\r\n    for (String c : changedFiles) {\r\n      Set<String> im = importers.get(c);\r\n      if (im != null) s.addAll(im);\r\n    }\r\n    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n      for (String t : e.getValue()) {\r\n        if (changedTypes.contains(t)) { s.add(e.getKey()); break; }\r\n      }\r\n    }\r\n    s.addAll(priorFindingUnits());\r\n    return new ArrayList<String>(s);\r\n  }\r\n}\r\n"]
[143.458877, "o", "\u001b[?2004hroot@8f25ef7e54d9:/app# "]
[144.653841, "i", "rm -rf /app/corpus /app/blot; cp -a /app/seed/corpus /app/corpus; cp -a /app/seed/blot /app/blot; /app/bin/seamwick nudge; echo N1_RC=$?; cp /app/blot/last.json /tmp/n1.json; /app/bin/seamwick flood; echo F1_RC=$?; cp /app/blot/last.json /tmp/f1.json; sed -i 's/void tug(String n)/void tug(String n, int seq)/' /app/corpus/api/Kin.u; /app/bin/seamwick nudge; echo N2_RC=$?; cp /app/blot/last.json /tmp/n2.json; /app/bin/seamwick flood; echo F2_RC=$?; cp /app/blot/last.json /tmp/f2.json; python3 - <<'PY'\nimport json\nn1,f1,n2,f2=[json.load(open(p)) for p in ('/tmp/n1.json','/tmp/f1.json','/tmp/n2.json','/tmp/f2.json')]\nprint('n1', n1)\nprint('n2', n2)\nassert n1['findings']==f1['findings']\nassert n2['findings']==f2['findings']\nassert all(x['code']=='1' for x in (n1,f1,n2,f2))\nassert 'api/LocalAid.u' not in n1['assayed']\nassert {'api/LocalAid.u','api/Vest.u','desk/Clerk.u'} <= set(n2['assayed'])\nprint('ALL_ASSERTIONS_OK')\nPY\n"]
