[34.512957, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\t\r\n     4\tpublic class Drive {\r\n     5\t  static Path ROOT = Paths.get(\"/app/corpus\");\r\n     6\t  static Path BLOT = Paths.get(\"/app/blot\");\r\n     7\t  static Path LAST = BLOT.resolve(\"last.json\");\r\n     8\t  static Path CACHE = BLOT.resolve(\"cache.json\");\r\n     9\t  static Path FLOOR = Paths.get(\"/app/hopnotes/FLOOR.txt\");\r\n    10\t\r\n    11\t  static int floor() {\r\n    12\t    try {\r\n    13\t      return Integer.parseInt(Files.readString(FLOOR).trim());\r\n    14\t    } catch (Exception e) {\r\n"]
[34.513148, "o", "    15\t      return 1;\r\n    16\t    }\r\n    17\t  }\r\n    18\t\r\n    19\t  static Map<String, Set<String>> importers(LinkedHashMap<String, Loom.Unit> all) {\r\n    20\t    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();\r\n    21\t    for (Loom.Unit u : all.values()) {\r\n    22\t      for (String dep : u.importedUnits) {\r\n    23\t        if (!m.containsKey(dep)) m.put(dep, new LinkedHashSet<String>());\r\n    24\t        m.get(dep).add(u.path);\r\n    25\t      }\r\n    26\t    }\r\n    27\t    return m;\r\n    28\t  }\r\n    29\t\r\n    30\t  static LinkedHashSet<String> known(LinkedHashMap<String, Loom.Unit> all) {\r\n    31\t    LinkedHashSet<String> k = new LinkedHashSet<String>();\r\n    32\t    for (Loom.Unit u : all.values()) k.addAll(u.defined);\r\n    33\t    return k;\r\n    34\t  }\r\n    35\t\r\n    36\t  static Map<String, String> fps(LinkedHashMap<String, Loom.Unit> all) {\r\n    37\t    Map<String, String> m = new LinkedHashMap<String, String>();\r\n    38\t    for (Loom.Unit u : all.values()) m.putAll(u.fps);\r\n    39\t    return m;\r\n    40\t  }\r\n    41\t\r\n    42\t  static Map<String, String> loadOldFp() {\r\n    43\t    Map<String, String> m = new LinkedHashMap<String, String>();\r\n    44\t    Map<String, Set<String>> cites = loadCites();\r\n    45\t    try {\r\n    46\t      if (!Files.exists(CACHE)) return m;\r\n    47\t      String s = Files.readString(CACHE);\r\n    48\t      int i = s.indexOf(\"\\\"fps\\\"\");\r\n    49\t      if (i < 0) return m;\r\n    50\t      int brace = s.indexOf('{', i);\r\n    51\t      int end = s.indexOf('}', brace);\r\n    52\t      if (brace < 0 || end < 0) return m;\r\n    53\t      String inner = s.substring(brace + 1, end);\r\n    54\t      for (String part : inner.split(\",\")) {\r\n    55\t        if (!part.contains(\":\")) continue;\r\n    56\t        String[] kv = part.split(\":\", 2);\r\n    57\t        String k = kv[0].replace(\"\\\"\", \"\").trim();\r\n    58\t        String v = kv[1].replace(\"\\\"\", \"\").trim();\r\n    59\t        if (!k.isEmpty()) m.put(k, v);\r\n    60\t      }\r\n    61\t    } catch (Exception e) {\r\n    62\t    }\r\n    63\t    return m;\r\n    64\t  }\r\n    65\t\r\n    66\t  static Map<String, Set<String>> loadCites() {\r\n    67\t    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();\r\n    68\t    try {\r\n    69\t      if (!Files.exists(CACHE)) return m;\r\n    70\t      String s = Files.readString(CACHE);\r\n    71\t      int i = s.indexOf(\"\\\"cites\\\"\");\r\n    72\t      if (i < 0) return m;\r\n    73\t      int brace = s.indexOf('{', i);\r\n    74\t      int end = matching(s, brace);\r\n"]
[34.513318, "o", "    75\t      if (brace < 0 || end < 0) return m;\r\n    76\t      String inner = s.substring(brace + 1, end);\r\n    77\t      parseMapOfSets(inner, m);\r\n    78\t    } catch (Exception e) {\r\n    79\t    }\r\n    80\t    return m;\r\n    81\t  }\r\n    82\t\r\n    83\t  static int matching(String s, int open) {\r\n    84\t    int d = 0;\r\n    85\t    for (int i = open; i < s.length(); i++) {\r\n    86\t      char c = s.charAt(i);\r\n    87\t      if (c == '{') d++;\r\n    88\t      else if (c == '}') {\r\n    89\t        d--;\r\n    90\t        if (d == 0) return i;\r\n    91\t      }\r\n    92\t    }\r\n    93\t    return -1;\r\n    94\t  }\r\n    95\t\r\n    96\t  static void parseMapOfSets(String inner, Map<String, Set<String>> m) {\r\n    97\t    int i = 0;\r\n    98\t    while (i < inner.length()) {\r\n    99\t      int q1 = inner.indexOf('\"', i);\r\n   100\t      if (q1 < 0) break;\r\n   101\t      int q2 = inner.indexOf('\"', q1 + 1);\r\n   102\t      String key = inner.substring(q1 + 1, q2);\r\n   103\t      int lb = inner.indexOf('[', q2);\r\n   104\t      int rb = inner.indexOf(']', lb);\r\n   105\t      if (lb < 0 || rb < 0) break;\r\n   106\t      LinkedHashSet<String> set = new LinkedHashSet<String>();\r\n   107\t      String arr = inner.substring(lb + 1, rb);\r\n   108\t      int j = 0;\r\n   109\t      while (j < arr.length()) {\r\n   110\t        int a = arr.indexOf('\"', j);\r\n   111\t        if (a < 0) break;\r\n   112\t        int b = arr.indexOf('\"', a + 1);\r\n   113\t        set.add(arr.substring(a + 1, b));\r\n   114\t        j = b + 1;\r\n   115\t      }\r\n   116\t      m.put(key, set);\r\n   117\t      i = rb + 1;\r\n   118\t    }\r\n   119\t  }\r\n   120\t\r\n   121\t  static LinkedHashSet<String> hashChanged(LinkedHashMap<String, Loom.Unit> all, Map<String, String> oldHash) {\r\n   122\t    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n   123\t    for (Loom.Unit u : all.values()) {\r\n   124\t      String oh = oldHash.get(u.path);\r\n   125\t      if (oh == null || !oh.equals(u.hash)) s.add(u.path);\r\n   126\t    }\r\n   127\t    return s;\r\n   128\t  }\r\n   129\t\r\n   130\t  static Map<String, String> loadOldHash() {\r\n"]
[34.51342, "o", "   131\t    Map<String, String> m = new LinkedHashMap<String, String>();\r\n   132\t    try {\r\n   133\t      if (!Files.exists(CACHE)) return m;\r\n   134\t      String s = Files.readString(CACHE);\r\n   135\t      int i = s.indexOf(\"\\\"hash\\\"\");\r\n   136\t      if (i < 0) return m;\r\n   137\t      int brace = s.indexOf('{', i);\r\n   138\t      int end = matching(s, brace);\r\n   139\t      if (brace < 0 || end < 0) return m;\r\n   140\t      String inner = s.substring(brace + 1, end);\r\n"]
[34.514996, "o", "   141\t      int j = 0;\r\n   142\t      while (j < inner.length()) {\r\n   143\t        int q1 = inner.indexOf('\"', j);\r\n   144\t        if (q1 < 0) break;\r\n   145\t        int q2 = inner.indexOf('\"', q1 + 1);\r\n   146\t        int q3 = inner.indexOf('\"', q2 + 1);\r\n   147\t        int q4 = inner.indexOf('\"', q3 + 1);\r\n   148\t        if (q3 < 0 || q4 < 0) break;\r\n"]
[34.515117, "o", "   149\t        m.put(inner.substring(q1 + 1, q2), inner.substring(q3 + 1, q4));\r\n   150\t        j = q4 + 1;\r\n   151\t      }\r\n   152\t    } catch (Exception e) {\r\n   153\t    }\r\n   154\t    return m;\r\n   155\t  }\r\n   156\t\r\n   157\t  static void writeCache(LinkedHashMap<String, Loom.Unit> all, Map<String, Set<String>> cites) throws Exception {\r\n   158\t    Files.createDirectories(BLOT);\r\n   159\t    StringBuilder b = new StringBuilder();\r\n   160\t    b.append(\"{\");\r\n   161\t    b.append(\"\\\"hash\\\":{\");\r\n   162\t    boolean first = true;\r\n   163\t    for (Loom.Unit u : all.values()) {\r\n   164\t      if (!first) b.append(',');\r\n   165\t      first = false;\r\n   166\t      b.append(Bag.q(u.path)).append(':').append(Bag.q(u.hash));\r\n   167\t    }\r\n   168\t    b.append(\"},\\\"fps\\\":{\");\r\n   169\t    first = true;\r\n   170\t    for (Loom.Unit u : all.values()) {\r\n   171\t      for (Map.Entry<String, String> e : u.fps.entrySet()) {\r\n   172\t        if (!first) b.append(',');\r\n   173\t        first = false;\r\n   174\t        b.append(Bag.q(e.getKey())).append(':').append(Bag.q(e.getValue()));\r\n   175\t      }\r\n   176\t    }\r\n   177\t    b.append(\"},\\\"cites\\\":{\");\r\n   178\t    first = true;\r\n   179\t    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n   180\t      if (!first) b.append(',');\r\n   181\t      first = false;\r\n   182\t      b.append(Bag.q(e.getKey())).append(\":[\").append(Bag.joinComma(e.getValue())).append(']');\r\n   183\t    }\r\n   184\t    b.append(\"}}\");\r\n   185\t    Files.writeString(CACHE, b.toString());\r\n   186\t  }\r\n"]
[34.515202, "o", "   187\t\r\n   188\t  static void writeLast(List<String> assayed, List<String[]> findings, String code) throws Exception {\r\n   189\t    Files.createDirectories(BLOT);\r\n   190\t    StringBuilder b = new StringBuilder();\r\n   191\t    b.append(\"{\");\r\n   192\t    b.append(\"\\\"assayed\\\":[\").append(Bag.joinComma(assayed)).append(\"],\");\r\n   193\t    b.append(\"\\\"findings\\\":[\");\r\n   194\t    for (int i = 0; i < findings.size(); i++) {\r\n   195\t      if (i > 0) b.append(',');\r\n   196\t      String[] f = findings.get(i);\r\n   197\t      b.append(\"{\\\"unit\\\":\").append(Bag.q(f[0]));\r\n   198\t      b.append(\",\\\"kind\\\":\").append(Bag.q(f[1]));\r\n   199\t      b.append(\",\\\"note\\\":\").append(Bag.q(f[2])).append('}');\r\n   200\t    }\r\n   201\t    b.append(\"],\\\"code\\\":\").append(Bag.q(code)).append('}');\r\n   202\t    Files.writeString(LAST, b.toString());\r\n   203\t  }\r\n   204\t\r\n   205\t  static int run(boolean all) throws Exception {\r\n   206\t    LinkedHashMap<String, Loom.Unit> units = Loom.load(ROOT);\r\n   207\t    Set<String> kn = known(units);\r\n   208\t    Map<String, Set<String>> cites = new LinkedHashMap<String, Set<String>>();\r\n"]
[34.515268, "o", "   209\t    for (Loom.Unit u : units.values()) {\r\n   210\t      cites.put(u.path, Cite.tags(u.body, kn));\r\n   211\t    }\r\n   212\t    Map<String, String> oldFp = loadOldFp();\r\n   213\t    Map<String, String> newFp = fps(units);\r\n   214\t    LinkedHashSet<String> changedTypes = new LinkedHashSet<String>();\r\n   215\t    for (Map.Entry<String, String> e : newFp.entrySet()) {\r\n   216\t      String o = oldFp.get(e.getKey());\r\n   217\t      if (o == null || !o.equals(e.getValue())) changedTypes.add(e.getKey());\r\n   218\t    }\r\n   219\t    Map<String, String> oldHash = loadOldHash();\r\n   220\t    Set<String> changedFiles = hashChanged(units, oldHash);\r\n   221\t    List<String> pick;\r\n   222\t    if (all) {\r\n   223\t      pick = new ArrayList<String>(units.keySet());\r\n   224\t    } else {\r\n   225\t      pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\r\n   226\t    }\r\n   227\t    LinkedHashSet<String> analysed = new LinkedHashSet<String>();\r\n   228\t    analysed.addAll(pick);\r\n   229\t    ArrayList<String[]> findings = new ArrayList<String[]>();\r\n   230\t    ArrayList<String> hitUnits = new ArrayList<String>();\r\n"]
[34.515363, "o", "   231\t    for (String p : analysed) {\r\n   232\t      Loom.Unit u = units.get(p);\r\n   233\t      if (u == null) continue;\r\n   234\t      cites.put(p, Cite.tags(u.body, kn));\r\n   235\t      for (String[] h : u.hits) {\r\n   236\t        findings.add(h);\r\n   237\t        hitUnits.add(h[0]);\r\n   238\t      }\r\n   239\t    }\r\n   240\t    writeCache(units, cites);\r\n   241\t    LinkedHashSet<String> must = new LinkedHashSet<String>();\r\n   242\t    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n   243\t      for (String t : e.getValue()) {\r\n   244\t        if (changedTypes.contains(t)) must.add(e.getKey());\r\n   245\t      }\r\n   246\t    }\r\n   247\t    List<String> assayed = Seal.assayedOf(new ArrayList<String>(analysed), hitUnits);\r\n   248\t    String code = Seal.codeOf(new ArrayList<String>(analysed), hitUnits, must, floor());\r\n   249\t    writeLast(assayed, findings, code);\r\n   250\t    return Integer.parseInt(code);\r\n   251\t  }\r\n   252\t}\r\n"]
[34.515583, "o", "--- Sheet\r\n"]
[34.516362, "o", "import java.nio.file.*;\r\npublic class Sheet {\r\n  public static int run() throws Exception {\r\n    Path p = Paths.get(\"/app/blot/last.json\");\r\n    if (!Files.exists(p)) return 2;\r\n    System.out.print(Files.readString(p));\r\n    return 0;\r\n  }\r\n}\r\n"]
[34.516536, "o", "--- Boot\r\n"]
[34.517303, "o", "public class Boot {\r\n  public static void main(String[] a) throws Exception {\r\n    if (a.length == 0) {\r\n      System.err.println(\"usage\");\r\n      System.exit(2);\r\n    }\r\n    String cmd = a[0];\r\n    int rc = 0;\r\n    if (cmd.equals(\"nudge\")) {\r\n      rc = Nudge.run();\r\n    } else if (cmd.equals(\"flood\")) {\r\n      rc = Flood.run();\r\n    } else if (cmd.equals(\"sheet\")) {\r\n      rc = Sheet.run();\r\n    } else {\r\n      rc = 2;\r\n    }\r\n    System.exit(rc);\r\n  }\r\n}\r\n"]
[34.517489, "o", "\u001b[?2004hroot@8f25ef7e54d9:/app# "]
[66.802428, "i", "cat > /app/purlbox/PurlBox.java <<'EOF'\nimport java.io.*;\npublic class PurlBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Cite.java\")));\n    purl(w);\n    w.close();\n  }\n  public static void purl(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"import java.util.regex.*;\");\n    a.println(\"public class Cite {\");\n    a.println(\"  public static LinkedHashSet<String> tags(String body, Set<String> known) {\");\n    a.println(\"    LinkedHashSet<String> out = new LinkedHashSet<String>();\");\n    a.println(\"    for (String name : known) {\");\n    a.println(\"      Pattern p = Pattern.compile(\\\"\\\\\\\\b\\\" + Pattern.quote(name) + \\\"\\\\\\\\b\\\");\");\n    a.println(\"      if (p.matcher(body).find()) out.add(name);\");\n    a.println(\"    }\");\n    a.println(\"    return out;\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\ncat > /app/knitwell/ops/KnitBox.java <<'EOF'\nimport java.io.*;\npublic class KnitBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Sched.java\")));\n    knit(w);\n    w.close();\n  }\n  public static void knit(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Sched {\");\n    a.println(\"  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\");\n    a.println(\"    LinkedHashSet<String> s = new LinkedHashSet<String>();\");\n    a.println(\"    s.addAll(changedFiles);\");\n    a.println(\"    for (String c : changedFiles) {\");\n    a.println(\"      Set<String> im = importers.get(c);\");\n    a.println(\"      if (im != null) s.addAll(im);\");\n    a.println(\"    }\");\n    a.println(\"    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\");\n    a.println(\"      for (String t : e.getValue()) {\");\n    a.println(\"        if (changedTypes.contains(t)) { s.add(e.getKey()); break; }\");\n    a.println(\"      }\");\n    a.println(\"    }\");\n    a.println(\"    return new ArrayList<String>(s);\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\ncat > /app/tintlag/core/TintBox.java <<'EOF'\nimport java.io.*;\npublic class TintBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Seal.java\")));\n    tint(w);\n    w.close();\n  }\n  public static void tint(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Seal {\");\n    a.println(\"  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\");\n    a.println(\"    return new ArrayList<String>(new LinkedHashSet<String>(analysed));\");\n    a.println(\"  }\");\n    a.println(\"  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\");\n    a.println(\"    LinkedHashSet<String> done = new LinkedHashSet<String>(analysed);\");\n    a.println(\"    if (!done.containsAll(must)) return \\\"1\\\";\");\n    a.println(\"    if (!hitUnits.isEmpty()) return \\\"1\\\";\");\n    a.println(\"    return \\\"0\\\";\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\n/app/assemble.bash\n"]
