[28.18802, "o", "--- Loom\r\n"]
[28.189618, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.*;\r\nimport java.util.*;\r\nimport java.util.regex.*;\r\n\r\npublic class Loom {\r\n  public static class Unit {\r\n    public String path;\r\n    public String pkg;\r\n"]
[28.189802, "o", "    public String body;\r\n    public String hash;\r\n    public LinkedHashSet<String> defined = new LinkedHashSet<String>();\r\n    public LinkedHashMap<String, String> fps = new LinkedHashMap<String, String>();\r\n    public LinkedHashSet<String> importedUnits = new LinkedHashSet<String>();\r\n    public ArrayList<String[]> hits = new ArrayList<String[]>();\r\n  }\r\n\r\n  static final Pattern IFACE = Pattern.compile(\"interface\\\\s+([A-Za-z_][A-Za-z0-9_]*)\");\r\n  static final Pattern METH = Pattern.compile(\"void\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(([^)]*)\\\\)\");\r\n  static final Pattern CALL = Pattern.compile(\"\\\\.([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(([^)]*)\\\\)\");\r\n  static final Pattern IMP = Pattern.compile(\"import\\\\s+([A-Za-z_][A-Za-z0-9_.*]*);\");\r\n  static final Pattern PKG = Pattern.compile(\"package\\\\s+([A-Za-z_][A-Za-z0-9_.]*);\");\r\n\r\n  public static LinkedHashMap<String, Unit> load(Path root) throws Exception {\r\n    LinkedHashMap<String, Unit> all = new LinkedHashMap<String, Unit>();\r\n    if (!Files.exists(root)) return all;\r\n    Files.walk(root).filter(p -> p.toString().endsWith(\".u\")).sorted().forEach(p -> {\r\n      try {\r\n        Unit u = parse(root, p);\r\n        all.put(u.path, u);\r\n      } catch (Exception e) {\r\n        throw new RuntimeException(e);\r\n      }\r\n    });\r\n    resolveHits(all);\r\n    return all;\r\n  }\r\n\r\n  static Unit parse(Path root, Path p) throws Exception {\r\n    Unit u = new Unit();\r\n    u.path = root.relativize(p).toString().replace('\\\\', '/');\r\n    u.body = Files.readString(p);\r\n    u.hash = Bag.hex(u.body.getBytes(StandardCharsets.UTF_8));\r\n    Matcher pm = PKG.matcher(u.body);\r\n    u.pkg = pm.find() ? pm.group(1) : \"\";\r\n    Matcher im = IMP.matcher(u.body);\r\n    while (im.find()) {\r\n      String r = im.group(1);\r\n      if (r.endsWith(\".*\")) continue;\r\n      u.importedUnits.add(r.replace('.', '/') + \".u\");\r\n    }\r\n    Matcher ic = IFACE.matcher(u.body);\r\n    LinkedHashMap<String, String> methods = new LinkedHashMap<String, String>();\r\n    String typeName = null;\r\n    if (ic.find()) {\r\n      typeName = ic.group(1);\r\n      u.defined.add(typeName);\r\n    }\r\n    Matcher mm = METH.matcher(u.body);\r\n    while (mm.find()) {\r\n      String name = mm.group(1);\r\n      String args = mm.group(2).trim();\r\n      int n = args.isEmpty() ? 0 : args.split(\",\").length;\r\n      methods.put(name, name + \":\" + n);\r\n    }\r\n    if (typeName != null) {\r\n      ArrayList<String> parts = new ArrayList<String>(methods.values());\r\n      Collections.sort(parts);\r\n      StringBuilder fp = new StringBuilder();\r\n      for (int i = 0; i < parts.size(); i++) {\r\n        if (i > 0) fp.append(';');\r\n        fp.append(parts.get(i));\r\n      }\r\n      u.fps.put(typeName, fp.toString());\r\n    }\r\n    return u;\r\n  }\r\n\r\n  static void resolveHits(LinkedHashMap<String, Unit> all) {\r\n    LinkedHashMap<String, String> methArity = new LinkedHashMap<String, String>();\r\n    for (Unit u : all.values()) {\r\n"]
[28.189989, "o", "      for (Map.Entry<String, String> e : u.fps.entrySet()) {\r\n        for (String part : e.getValue().split(\";\")) {\r\n          if (part.isEmpty()) continue;\r\n          methArity.put(e.getKey() + \"#\" + part.split(\":\")[0], part.split(\":\")[1]);\r\n        }\r\n      }\r\n    }\r\n    for (Unit u : all.values()) {\r\n      Matcher c = CALL.matcher(u.body);\r\n      while (c.find()) {\r\n        String name = c.group(1);\r\n        String args = c.group(2).trim();\r\n        int n = args.isEmpty() ? 0 : splitArgs(args);\r\n        for (Unit def : all.values()) {\r\n          for (String t : def.defined) {\r\n            String want = methArity.get(t + \"#\" + name);\r\n            if (want == null) continue;\r\n            if (Integer.parseInt(want) != n) {\r\n              u.hits.add(new String[] {u.path, \"arity\", name});\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  static int splitArgs(String args) {\r\n    int n = 1;\r\n    int depth = 0;\r\n    boolean q = false;\r\n    for (int i = 0; i < args.length(); i++) {\r\n      char ch = args.charAt(i);\r\n      if (ch == '\"') q = !q;\r\n      else if (!q && ch == '(') depth++;\r\n      else if (!q && ch == ')') depth--;\r\n      else if (!q && depth == 0 && ch == ',') n++;\r\n    }\r\n    return n;\r\n  }\r\n}\r\n"]
[28.190345, "o", "--- Drive\r\n"]
[28.19167, "o", "import java.nio.file.*;\r\nimport java.util.*;\r\n\r\npublic class Drive {\r\n  static Path ROOT = Paths.get(\"/app/corpus\");\r\n  static Path BLOT = Paths.get(\"/app/blot\");\r\n  static Path LAST = BLOT.resolve(\"last.json\");\r\n  static Path CACHE = BLOT.resolve(\"cache.json\");\r\n  static Path FLOOR = Paths.get(\"/app/hopnotes/FLOOR.txt\");\r\n\r\n  static int floor() {\r\n    try {\r\n      return Integer.parseInt(Files.readString(FLOOR).trim());\r\n    } catch (Exception e) {\r\n      return 1;\r\n    }\r\n  }\r\n\r\n  static Map<String, Set<String>> importers(LinkedHashMap<String, Loom.Unit> all) {\r\n    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();\r\n    for (Loom.Unit u : all.values()) {\r\n      for (String dep : u.importedUnits) {\r\n        if (!m.containsKey(dep)) m.put(dep, new LinkedHashSet<String>());\r\n        m.get(dep).add(u.path);\r\n      }\r\n    }\r\n    return m;\r\n  }\r\n\r\n  static LinkedHashSet<String> known(LinkedHashMap<String, Loom.Unit> all) {\r\n    LinkedHashSet<String> k = new LinkedHashSet<String>();\r\n    for (Loom.Unit u : all.values()) k.addAll(u.defined);\r\n    return k;\r\n  }\r\n\r\n"]
[28.191824, "o", "  static Map<String, String> fps(LinkedHashMap<String, Loom.Unit> all) {\r\n    Map<String, String> m = new LinkedHashMap<String, String>();\r\n    for (Loom.Unit u : all.values()) m.putAll(u.fps);\r\n    return m;\r\n  }\r\n\r\n  static Map<String, String> loadOldFp() {\r\n    Map<String, String> m = new LinkedHashMap<String, String>();\r\n    Map<String, Set<String>> cites = loadCites();\r\n    try {\r\n      if (!Files.exists(CACHE)) return m;\r\n      String s = Files.readString(CACHE);\r\n      int i = s.indexOf(\"\\\"fps\\\"\");\r\n      if (i < 0) return m;\r\n      int brace = s.indexOf('{', i);\r\n      int end = s.indexOf('}', brace);\r\n      if (brace < 0 || end < 0) return m;\r\n      String inner = s.substring(brace + 1, end);\r\n      for (String part : inner.split(\",\")) {\r\n        if (!part.contains(\":\")) continue;\r\n        String[] kv = part.split(\":\", 2);\r\n        String k = kv[0].replace(\"\\\"\", \"\").trim();\r\n        String v = kv[1].replace(\"\\\"\", \"\").trim();\r\n        if (!k.isEmpty()) m.put(k, v);\r\n      }\r\n    } catch (Exception e) {\r\n    }\r\n    return m;\r\n  }\r\n\r\n  static Map<String, Set<String>> loadCites() {\r\n    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();\r\n    try {\r\n      if (!Files.exists(CACHE)) return m;\r\n      String s = Files.readString(CACHE);\r\n      int i = s.indexOf(\"\\\"cites\\\"\");\r\n      if (i < 0) return m;\r\n      int brace = s.indexOf('{', i);\r\n      int end = matching(s, brace);\r\n      if (brace < 0 || end < 0) return m;\r\n      String inner = s.substring(brace + 1, end);\r\n      parseMapOfSets(inner, m);\r\n    } catch (Exception e) {\r\n    }\r\n    return m;\r\n  }\r\n\r\n  static int matching(String s, int open) {\r\n    int d = 0;\r\n    for (int i = open; i < s.length(); i++) {\r\n      char c = s.charAt(i);\r\n      if (c == '{') d++;\r\n      else if (c == '}') {\r\n        d--;\r\n        if (d == 0) return i;\r\n      }\r\n    }\r\n    return -1;\r\n  }\r\n\r\n  static void parseMapOfSets(String inner, Map<String, Set<String>> m) {\r\n    int i = 0;\r\n"]
[28.192112, "o", "    while (i < inner.length()) {\r\n      int q1 = inner.indexOf('\"', i);\r\n      if (q1 < 0) break;\r\n      int q2 = inner.indexOf('\"', q1 + 1);\r\n      String key = inner.substring(q1 + 1, q2);\r\n      int lb = inner.indexOf('[', q2);\r\n      int rb = inner.indexOf(']', lb);\r\n      if (lb < 0 || rb < 0) break;\r\n      LinkedHashSet<String> set = new LinkedHashSet<String>();\r\n      String arr = inner.substring(lb + 1, rb);\r\n      int j = 0;\r\n      while (j < arr.length()) {\r\n        int a = arr.indexOf('\"', j);\r\n        if (a < 0) break;\r\n        int b = arr.indexOf('\"', a + 1);\r\n        set.add(arr.substring(a + 1, b));\r\n        j = b + 1;\r\n      }\r\n      m.put(key, set);\r\n      i = rb + 1;\r\n    }\r\n  }\r\n\r\n  static LinkedHashSet<String> hashChanged(LinkedHashMap<String, Loom.Unit> all, Map<String, String> oldHash) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    for (Loom.Unit u : all.values()) {\r\n      String oh = oldHash.get(u.path);\r\n      if (oh == null || !oh.equals(u.hash)) s.add(u.path);\r\n    }\r\n    return s;\r\n  }\r\n\r\n  static Map<String, String> loadOldHash() {\r\n    Map<String, String> m = new LinkedHashMap<String, String>();\r\n    try {\r\n      if (!Files.exists(CACHE)) return m;\r\n      String s = Files.readString(CACHE);\r\n      int i = s.indexOf(\"\\\"hash\\\"\");\r\n      if (i < 0) return m;\r\n      int brace = s.indexOf('{', i);\r\n      int end = matching(s, brace);\r\n      if (brace < 0 || end < 0) return m;\r\n      String inner = s.substring(brace + 1, end);\r\n      int j = 0;\r\n      while (j < inner.length()) {\r\n        int q1 = inner.indexOf('\"', j);\r\n        if (q1 < 0) break;\r\n        int q2 = inner.indexOf('\"', q1 + 1);\r\n        int q3 = inner.indexOf('\"', q2 + 1);\r\n        int q4 = inner.indexOf('\"', q3 + 1);\r\n        if (q3 < 0 || q4 < 0) break;\r\n        m.put(inner.substring(q1 + 1, q2), inner.substring(q3 + 1, q4));\r\n        j = q4 + 1;\r\n      }\r\n    } catch (Exception e) {\r\n    }\r\n    return m;\r\n  }\r\n\r\n  static void writeCache(LinkedHashMap<String, Loom.Unit> all, Map<String, Set<String>> cites) throws Exception {\r\n    Files.createDirectories(BLOT);\r\n    StringBuilder b = new StringBuilder();\r\n    b.append(\"{\");\r\n    b.append(\"\\\"hash\\\":{\");\r\n    boolean first = true;\r\n    for (Loom.Unit u : all.values()) {\r\n      if (!first) b.append(',');\r\n      first = false;\r\n      b.append(Bag.q(u.path)).append(':').append(Bag.q(u.hash));\r\n    }\r\n    b.append(\"},\\\"fps\\\":{\");\r\n"]
[28.192213, "o", "    first = true;\r\n    for (Loom.Unit u : all.values()) {\r\n      for (Map.Entry<String, String> e : u.fps.entrySet()) {\r\n        if (!first) b.append(',');\r\n        first = false;\r\n        b.append(Bag.q(e.getKey())).append(':').append(Bag.q(e.getValue()));\r\n      }\r\n    }\r\n    b.append(\"},\\\"cites\\\":{\");\r\n    first = true;\r\n    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n      if (!first) b.append(',');\r\n      first = false;\r\n      b.append(Bag.q(e.getKey())).append(\":[\").append(Bag.joinComma(e.getValue())).append(']');\r\n    }\r\n    b.append(\"}}\");\r\n    Files.writeString(CACHE, b.toString());\r\n  }\r\n\r\n  static void writeLast(List<String> assayed, List<String[]> findings, String code) throws Exception {\r\n    Files.createDirectories(BLOT);\r\n    StringBuilder b = new StringBuilder();\r\n    b.append(\"{\");\r\n    b.append(\"\\\"assayed\\\":[\").append(Bag.joinComma(assayed)).append(\"],\");\r\n    b.append(\"\\\"findings\\\":[\");\r\n    for (int i = 0; i < findings.size(); i++) {\r\n      if (i > 0) b.append(',');\r\n      String[] f = findings.get(i);\r\n      b.append(\"{\\\"unit\\\":\").append(Bag.q(f[0]));\r\n      b.append(\",\\\"kind\\\":\").append(Bag.q(f[1]));\r\n      b.append(\",\\\"note\\\":\").append(Bag.q(f[2])).append('}');\r\n    }\r\n    b.append(\"],\\\"code\\\":\").append(Bag.q(code)).append('}');\r\n    Files.writeString(LAST, b.toString());\r\n  }\r\n\r\n  static int run(boolean all) throws Exception {\r\n    LinkedHashMap<String, Loom.Unit> units = Loom.load(ROOT);\r\n    Set<String> kn = known(units);\r\n    Map<String, Set<String>> cites = new LinkedHashMap<String, Set<String>>();\r\n    for (Loom.Unit u : units.values()) {\r\n      cites.put(u.path, Cite.tags(u.body, kn));\r\n    }\r\n    Map<String, String> oldFp = loadOldFp();\r\n    Map<String, String> newFp = fps(units);\r\n    LinkedHashSet<String> changedTypes = new LinkedHashSet<String>();\r\n    for (Map.Entry<String, String> e : newFp.entrySet()) {\r\n      String o = oldFp.get(e.getKey());\r\n      if (o == null || !o.equals(e.getValue())) changedTypes.add(e.getKey());\r\n    }\r\n    Map<String, String> oldHash = loadOldHash();\r\n    Set<String> changedFiles = hashChanged(units, oldHash);\r\n    List<String> pick;\r\n    if (all) {\r\n      pick = new ArrayList<String>(units.keySet());\r\n    } else {\r\n      pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\r\n    }\r\n    LinkedHashSet<String> analysed = new LinkedHashSet<String>();\r\n    analysed.addAll(pick);\r\n    ArrayList<String[]> findings = new ArrayList<String[]>();\r\n    ArrayList<String> hitUnits = new ArrayList<String>();\r\n    for (String p : analysed) {\r\n      Loom.Unit u = units.get(p);\r\n      if (u == null) continue;\r\n      cites.put(p, Cite.tags(u.body, kn));\r\n      for (String[] h : u.hits) {\r\n        findings.add(h);\r\n        hitUnits.add(h[0]);\r\n"]
[28.192321, "o", "      }\r\n    }\r\n    writeCache(units, cites);\r\n    LinkedHashSet<String> must = new LinkedHashSet<String>();\r\n    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n      for (String t : e.getValue()) {\r\n        if (changedTypes.contains(t)) must.add(e.getKey());\r\n      }\r\n    }\r\n    List<String> assayed = Seal.assayedOf(new ArrayList<String>(analysed), hitUnits);\r\n    String code = Seal.codeOf(new ArrayList<String>(analysed), hitUnits, must, floor());\r\n    writeLast(assayed, findings, code);\r\n    return Integer.parseInt(code);\r\n  }\r\n}\r\n"]
[28.192548, "o", "--- Nudge\r\n"]
[28.193733, "o", "public class Nudge {\r\n  public static int run() throws Exception {\r\n    return Drive.run(false);\r\n  }\r\n}\r\n"]
[28.193961, "o", "--- Flood\r\n"]
[28.195076, "o", "public class Flood {\r\n  public static int run() throws Exception {\r\n    return Drive.run(true);\r\n  }\r\n}\r\n"]
[28.195387, "o", "\u001b[?2004hroot@8f25ef7e54d9:/app# "]
[28.672561, "i", "echo '--- Scan'; sed -n '1,400p' /app/impgraph/Scan.java; echo '--- Mark'; cat /app/seamcmd/Mark.java; echo '--- Dump'; cat /app/wipevat/Dump.java; echo '--- floor'; cat /app/hopnotes/FLOOR.txt /app/gasketurn/quiet.lst; echo '--- generated'; cat /app/deskbin/gen/Cite.java /app/deskbin/gen/Sched.java /app/deskbin/gen/Seal.java\n"]
[28.67377, "o", "echo '--- Scan'; sed -n '1,400p' /app/impgraph/Scan.java; echo '--- Mark'; cat /app/seamcmd/Mark.java; echo '--- Dump'; cat /app/wipevat/Dump.java; echo '--- floor'; cat /app/hopnotes/FLOOR.txt /app/gasketurn/quiet.lst; echo '--- generated'; cat /app/deskbin/gen/Cite.java /app/deskbin/gen/Sched.java /app/deskbin/gen/Seal.java\r\n\u001b[?2004l\r"]
[28.673811, "o", "--- Scan\r\n"]
[28.675535, "o", "import java.util.*;\r\npublic class Scan {\r\n  public static Set<String> lines(String body) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    for (String line : body.split(\"\\n\")) {\r\n      String t = line.trim();\r\n      if (t.startsWith(\"import \")) s.add(t);\r\n    }\r\n    return s;\r\n  }\r\n}\r\n"]
[28.67589, "o", "--- Mark\r\n"]
[28.676856, "o", "public class Mark {\r\n  public static int run() throws Exception {\r\n    return 0;\r\n  }\r\n}\r\n"]
[28.677299, "o", "--- Dump\r\n"]
[28.678136, "o", "import java.nio.file.*;\r\npublic class Dump {\r\n  public static void wipe() throws Exception {\r\n    Path p = Paths.get(\"/app/blot\");\r\n    if (Files.exists(p)) {\r\n      Files.walk(p).sorted((a, b) -> b.compareTo(a)).forEach(x -> {\r\n        try { Files.deleteIfExists(x); } catch (Exception e) {}\r\n      });\r\n    }\r\n  }\r\n}\r\n"]
[28.678416, "o", "--- floor\r\n"]
[28.679495, "o", "1\r\n"]
[28.679636, "o", "# ops leftover: dump blot then flood\r\n"]
[28.679844, "o", "--- generated\r\n"]
[28.680941, "o", "import java.util.*;\r\npublic class Cite {\r\n  public static LinkedHashSet<String> tags(String body, Set<String> known) {\r\n    LinkedHashSet<String> out = new LinkedHashSet<String>();\r\n    String[] lines = body.split(\"\\n\");\r\n    for (int i = 0; i < lines.length; i++) {\r\n      String t = lines[i].trim();\r\n      if (t.startsWith(\"import \")) {\r\n        String r = t.substring(7).replace(\";\", \"\").trim();\r\n        int d = r.lastIndexOf('.');\r\n        String n = d < 0 ? r : r.substring(d + 1);\r\n        if (known.contains(n)) out.add(n);\r\n      }\r\n    }\r\n    return out;\r\n  }\r\n}\r\n"]
[28.68112, "o", "import java.util.*;\r\npublic class Sched {\r\n  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(changedFiles);\r\n    for (String c : changedFiles) {\r\n      Set<String> im = importers.get(c);\r\n      if (im != null) s.addAll(im);\r\n    }\r\n    return new ArrayList<String>(s);\r\n  }\r\n}\r\n"]
[28.681287, "o", "import java.util.*;\r\npublic class Seal {\r\n  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(hitUnits);\r\n    return new ArrayList<String>(s);\r\n  }\r\n  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\r\n    if (analysed.size() >= floor) return \"0\";\r\n    if (hitUnits.isEmpty()) return \"0\";\r\n    return \"1\";\r\n  }\r\n}\r\n"]
[28.681711, "o", "\u001b[?2004hroot@8f25ef7e54d9:/app# "]
