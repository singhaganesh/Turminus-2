[15.7346, "o", "import java.nio.file.*;\r\npublic class Dump {\r\n  public static void wipe() throws Exception {\r\n    Path p = Paths.get(\"/app/blot\");\r\n    if (Files.exists(p)) {\r\n"]
[15.734682, "o", "      Files.walk(p).sorted((a, b) -> b.compareTo(a)).forEach(x -> {\r\n        try { Files.deleteIfExists(x); } catch (Exception e) {}\r\n      });\r\n    }\r\n  }\r\n}\r\n"]
