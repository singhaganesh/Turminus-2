[?2004lBUILD_OK
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;
public class Sched {
  static Set<String> priorFindingUnits() {
    LinkedHashSet<String> out = new LinkedHashSet<String>();
    try {
      String text = Files.readString(Paths.get("/app/blot/last.json"));
      String needle = "\"unit\":\"";
      int at = 0;
      while ((at = text.indexOf(needle, at)) >= 0) {
        int start = at + needle.length();
        int end = text.indexOf('\"', start);
        if (end < 0) break;
        out.add(text.substring(start, end));
        at = end + 1;
      }
    } catch (Exception ignored) {}
    return out;
  }
  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {
    LinkedHashSet<String> s = new LinkedHashSet<String>();
    s.addAll(changedFiles);
    for (String c : changedFiles) {
      Set<String> im = importers.get(c);
      if (im != null) s.addAll(im);
    }
    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {
      for (String t : e.getValue()) {
        if (changedTypes.contains(t)) { s.add(e.getKey()); break; }
      }
    }
    s.addAll(priorFindingUnits());
    return new ArrayList<String>(s);
  }
}
