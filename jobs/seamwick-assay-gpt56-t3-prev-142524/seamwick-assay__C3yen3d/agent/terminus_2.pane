import java.util.*;
public class Cite {
  public static LinkedHashSet<String> tags(String body, Set<String> known) {
    LinkedHashSet<String> out = new LinkedHashSet<String>();
    String[] lines = body.split("\n");
    for (int i = 0; i < lines.length; i++) {
      String t = lines[i].trim();
      if (t.startsWith("import ")) {
        String r = t.substring(7).replace(";", "").trim();
        int d = r.lastIndexOf('.');
        String n = d < 0 ? r : r.substring(d + 1);
        if (known.contains(n)) out.add(n);
      }
    }
    return out;
  }
}
import java.util.*;
public class Sched {
  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {
    LinkedHashSet<String> s = new LinkedHashSet<String>();
    s.addAll(changedFiles);
    for (String c : changedFiles) {
      Set<String> im = importers.get(c);
      if (im != null) s.addAll(im);
    }
    return new ArrayList<String>(s);
  }
}
import java.util.*;
public class Seal {
  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {
    LinkedHashSet<String> s = new LinkedHashSet<String>();
    s.addAll(hitUnits);
    return new ArrayList<String>(s);
  }
  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {
    if (analysed.size() >= floor) return "0";
    if (hitUnits.isEmpty()) return "0";
    return "1";
  }
}
