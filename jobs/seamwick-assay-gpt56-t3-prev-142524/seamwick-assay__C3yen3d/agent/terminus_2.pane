     4	public class Drive {
     5	  static Path ROOT = Paths.get("/app/corpus");
     6	  static Path BLOT = Paths.get("/app/blot");
     7	  static Path LAST = BLOT.resolve("last.json");
     8	  static Path CACHE = BLOT.resolve("cache.json");
     9	  static Path FLOOR = Paths.get("/app/hopnotes/FLOOR.txt");
    10	
    11	  static int floor() {
    12	    try {
    13	      return Integer.parseInt(Files.readString(FLOOR).trim());
    14	    } catch (Exception e) {
    15	      return 1;
    16	    }
    17	  }
    18	
    19	  static Map<String, Set<String>> importers(LinkedHashMap<String, Loom.Unit> all) {
    20	    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();
    21	    for (Loom.Unit u : all.values()) {
    22	      for (String dep : u.importedUnits) {
    23	        if (!m.containsKey(dep)) m.put(dep, new LinkedHashSet<String>());
    24	        m.get(dep).add(u.path);
    25	      }
    26	    }
    27	    return m;
    28	  }
    29	
    30	  static LinkedHashSet<String> known(LinkedHashMap<String, Loom.Unit> all) {
    31	    LinkedHashSet<String> k = new LinkedHashSet<String>();
    32	    for (Loom.Unit u : all.values()) k.addAll(u.defined);
    33	    return k;
    34	  }
    35	
    36	  static Map<String, String> fps(LinkedHashMap<String, Loom.Unit> all) {
    37	    Map<String, String> m = new LinkedHashMap<String, String>();
    38	    for (Loom.Unit u : all.values()) m.putAll(u.fps);
    39	    return m;
    40	  }
    41	
    42	  static Map<String, String> loadOldFp() {
    43	    Map<String, String> m = new LinkedHashMap<String, String>();
    44	    Map<String, Set<String>> cites = loadCites();
    45	    try {
    46	      if (!Files.exists(CACHE)) return m;
    47	      String s = Files.readString(CACHE);
    48	      int i = s.indexOf("\"fps\"");
    49	      if (i < 0) return m;
    50	      int brace = s.indexOf('{', i);
    51	      int end = s.indexOf('}', brace);
    52	      if (brace < 0 || end < 0) return m;
    53	      String inner = s.substring(brace + 1, end);
    54	      for (String part : inner.split(",")) {
    55	        if (!part.contains(":")) continue;
    56	        String[] kv = part.split(":", 2);
    57	        String k = kv[0].replace("\"", "").trim();
    58	        String v = kv[1].replace("\"", "").trim();
    59	        if (!k.isEmpty()) m.put(k, v);
    60	      }
    61	    } catch (Exception e) {
    62	    }
    63	    return m;
    64	  }
    65	
    66	  static Map<String, Set<String>> loadCites() {
    67	    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();
    68	    try {
    69	      if (!Files.exists(CACHE)) return m;
    70	      String s = Files.readString(CACHE);
    71	      int i = s.indexOf("\"cites\"");
    72	      if (i < 0) return m;
    73	      int brace = s.indexOf('{', i);
    74	      int end = matching(s, brace);
    75	      if (brace < 0 || end < 0) return m;
    76	      String inner = s.substring(brace + 1, end);
    77	      parseMapOfSets(inner, m);
    78	    } catch (Exception e) {
    79	    }
    80	    return m;
    81	  }
    82	
    83	  static int matching(String s, int open) {
    84	    int d = 0;
    85	    for (int i = open; i < s.length(); i++) {
    86	      char c = s.charAt(i);
    87	      if (c == '{') d++;
    88	      else if (c == '}') {
    89	        d--;
    90	        if (d == 0) return i;
    91	      }
    92	    }
    93	    return -1;
    94	  }
    95	
    96	  static void parseMapOfSets(String inner, Map<String, Set<String>> m) {
    97	    int i = 0;
    98	    while (i < inner.length()) {
    99	      int q1 = inner.indexOf('"', i);
   100	      if (q1 < 0) break;
   101	      int q2 = inner.indexOf('"', q1 + 1);
   102	      String key = inner.substring(q1 + 1, q2);
   103	      int lb = inner.indexOf('[', q2);
   104	      int rb = inner.indexOf(']', lb);
   105	      if (lb < 0 || rb < 0) break;
   106	      LinkedHashSet<String> set = new LinkedHashSet<String>();
   107	      String arr = inner.substring(lb + 1, rb);
   108	      int j = 0;
   109	      while (j < arr.length()) {
   110	        int a = arr.indexOf('"', j);
   111	        if (a < 0) break;
   112	        int b = arr.indexOf('"', a + 1);
   113	        set.add(arr.substring(a + 1, b));
   114	        j = b + 1;
   115	      }
   116	      m.put(key, set);
   117	      i = rb + 1;
   118	    }
   119	  }
   120	
   121	  static LinkedHashSet<String> hashChanged(LinkedHashMap<String, Loom.Unit> all, Map<String, String> oldHash) {
   122	    LinkedHashSet<String> s = new LinkedHashSet<String>();
   123	    for (Loom.Unit u : all.values()) {
   124	      String oh = oldHash.get(u.path);
   125	      if (oh == null || !oh.equals(u.hash)) s.add(u.path);
   126	    }
   127	    return s;
   128	  }
   129	
   130	  static Map<String, String> loadOldHash() {
   131	    Map<String, String> m = new LinkedHashMap<String, String>();
   132	    try {
   133	      if (!Files.exists(CACHE)) return m;
   134	      String s = Files.readString(CACHE);
   135	      int i = s.indexOf("\"hash\"");
   136	      if (i < 0) return m;
   137	      int brace = s.indexOf('{', i);
   138	      int end = matching(s, brace);
   139	      if (brace < 0 || end < 0) return m;
   140	      String inner = s.substring(brace + 1, end);
   141	      int j = 0;
   142	      while (j < inner.length()) {
   143	        int q1 = inner.indexOf('"', j);
   144	        if (q1 < 0) break;
   145	        int q2 = inner.indexOf('"', q1 + 1);
   146	        int q3 = inner.indexOf('"', q2 + 1);
   147	        int q4 = inner.indexOf('"', q3 + 1);
   148	        if (q3 < 0 || q4 < 0) break;
   149	        m.put(inner.substring(q1 + 1, q2), inner.substring(q3 + 1, q4));
   150	        j = q4 + 1;
   151	      }
   152	    } catch (Exception e) {
   153	    }
   154	    return m;
   155	  }
   156	
   157	  static void writeCache(LinkedHashMap<String, Loom.Unit> all, Map<String, Set<String>> cites) throws Exception {
   158	    Files.createDirectories(BLOT);
   159	    StringBuilder b = new StringBuilder();
   160	    b.append("{");
   161	    b.append("\"hash\":{");
   162	    boolean first = true;
   163	    for (Loom.Unit u : all.values()) {
   164	      if (!first) b.append(',');
   165	      first = false;
   166	      b.append(Bag.q(u.path)).append(':').append(Bag.q(u.hash));
   167	    }
   168	    b.append("},\"fps\":{");
   169	    first = true;
   170	    for (Loom.Unit u : all.values()) {
   171	      for (Map.Entry<String, String> e : u.fps.entrySet()) {
   172	        if (!first) b.append(',');
   173	        first = false;
   174	        b.append(Bag.q(e.getKey())).append(':').append(Bag.q(e.getValue()));
   175	      }
   176	    }
   177	    b.append("},\"cites\":{");
   178	    first = true;
   179	    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {
   180	      if (!first) b.append(',');
   181	      first = false;
   182	      b.append(Bag.q(e.getKey())).append(":[").append(Bag.joinComma(e.getValue())).append(']');
   183	    }
   184	    b.append("}}");
   185	    Files.writeString(CACHE, b.toString());
   186	  }
   187	
   188	  static void writeLast(List<String> assayed, List<String[]> findings, String code) throws Exception {
   189	    Files.createDirectories(BLOT);
   190	    StringBuilder b = new StringBuilder();
   191	    b.append("{");
   192	    b.append("\"assayed\":[").append(Bag.joinComma(assayed)).append("],");
   193	    b.append("\"findings\":[");
   194	    for (int i = 0; i < findings.size(); i++) {
   195	      if (i > 0) b.append(',');
   196	      String[] f = findings.get(i);
   197	      b.append("{\"unit\":").append(Bag.q(f[0]));
   198	      b.append(",\"kind\":").append(Bag.q(f[1]));
   199	      b.append(",\"note\":").append(Bag.q(f[2])).append('}');
   200	    }
   201	    b.append("],\"code\":").append(Bag.q(code)).append('}');
   202	    Files.writeString(LAST, b.toString());
   203	  }
   204	
   205	  static int run(boolean all) throws Exception {
   206	    LinkedHashMap<String, Loom.Unit> units = Loom.load(ROOT);
   207	    Set<String> kn = known(units);
   208	    Map<String, Set<String>> cites = new LinkedHashMap<String, Set<String>>();
   209	    for (Loom.Unit u : units.values()) {
   210	      cites.put(u.path, Cite.tags(u.body, kn));
   211	    }
   212	    Map<String, String> oldFp = loadOldFp();
   213	    Map<String, String> newFp = fps(units);
   214	    LinkedHashSet<String> changedTypes = new LinkedHashSet<String>();
   215	    for (Map.Entry<String, String> e : newFp.entrySet()) {
   216	      String o = oldFp.get(e.getKey());
   217	      if (o == null || !o.equals(e.getValue())) changedTypes.add(e.getKey());
   218	    }
   219	    Map<String, String> oldHash = loadOldHash();
   220	    Set<String> changedFiles = hashChanged(units, oldHash);
   221	    List<String> pick;
   222	    if (all) {
   223	      pick = new ArrayList<String>(units.keySet());
   224	    } else {
   225	      pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);
   226	    }
   227	    LinkedHashSet<String> analysed = new LinkedHashSet<String>();
   228	    analysed.addAll(pick);
   229	    ArrayList<String[]> findings = new ArrayList<String[]>();
   230	    ArrayList<String> hitUnits = new ArrayList<String>();
   231	    for (String p : analysed) {
   232	      Loom.Unit u = units.get(p);
   233	      if (u == null) continue;
   234	      cites.put(p, Cite.tags(u.body, kn));
   235	      for (String[] h : u.hits) {
   236	        findings.add(h);
   237	        hitUnits.add(h[0]);
   238	      }
   239	    }
   240	    writeCache(units, cites);
   241	    LinkedHashSet<String> must = new LinkedHashSet<String>();
   242	    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {
   243	      for (String t : e.getValue()) {
   244	        if (changedTypes.contains(t)) must.add(e.getKey());
   245	      }
   246	    }
   247	    List<String> assayed = Seal.assayedOf(new ArrayList<String>(analysed), hitUnits);
   248	    String code = Seal.codeOf(new ArrayList<String>(analysed), hitUnits, must, floor());
   249	    writeLast(assayed, findings, code);
   250	    return Integer.parseInt(code);
   251	  }
   252	}
