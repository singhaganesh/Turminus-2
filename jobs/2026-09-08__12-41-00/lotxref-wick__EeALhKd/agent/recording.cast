[8.697771, "i", "cat /app/baycard/BAY_NOTES.txt && printf '\\n--- forms.txt ---\\n' && cat /app/baycard/forms.txt\n"]
[8.698189, "o", "cat /app/baycard/BAY_NOTES.txt && printf '\\n--- forms.txt ---\\n' && cat /app/baycard/forms.txt\r\n\u001b[?2004l\r"]
[8.699621, "o", "lotxref layout\r\n=============\r\n\r\n/app/bin/lotxref     linked mill (see /app/tblkit/hull.mk)\r\n/app/slitmill        table rewrite\r\n/app/cupeel          clip lookup\r\n/app/drygate         status gate\r\n/app/tblkit          mill glue\r\n/app/unitpit         C units\r\n/app/lotbay          dumps\r\n/app/inkwell         span.atlas and clip.out\r\n/app/touchbay        optional touch list some desks keep around\r\n/app/baycard         grammar\r\n\r\nSymptom on this bench: clip of shift.dmp shows a neighbour body even though\r\nreknit returns success. Other dumps that still sit on their original units\r\nalready clip cleanly.\r\n\r\nA later row for the same name can look tempting when a unit recently moved.\r\nTwin helper names in two live units still have to clip from the dump's own unit.\r\nGrade-time dumps may appear under /app/lotbay and extra units under /app/unitpit.\r\n"]
[8.699989, "o", "\r\n--- forms.txt ---\r\n"]
[8.700875, "o", "Atlas files begin with SPAN1 then one row per line:\r\n<name> <abspath> <lo> <hi>\r\nlo and hi are 1-based inclusive source lines.\r\n\r\nDump files begin with DUMP1 then one line:\r\n<name> <abspath> <line>\r\n\r\nclip.out begins with CLIP <name> then the extracted source lines.\r\n"]
[8.701124, "o", "\u001b[?2004hroot@7d29c5a128b1:/app# "]
[8.85302, "i", "printf '\\n--- tree/files ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort\n"]
[8.853468, "o", "printf '\\n--- tree/files ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[8.853733, "o", "\r\n--- tree/files ---\r\n"]
[8.858264, "o", "/app/baycard/BAY_NOTES.txt\r\n/app/baycard/forms.txt\r\n/app/bin/lotxref\r\n/app/cupeel/pick.c\r\n/app/drygate/gap.c\r\n/app/inkwell/span.atlas\r\n/app/lotbay/pump.dmp\r\n/app/lotbay/shift.dmp\r\n/app/lotbay/twin.dmp\r\n/app/sidecue/mtime.c\r\n/app/sidecue/mtime.h\r\n/app/slitmill/scan.c\r\n/app/tblkit/gap.h\r\n/app/tblkit/hull.mk\r\n/app/tblkit/hull_cli.c\r\n/app/tblkit/pick.h\r\n/app/tblkit/scan.h\r\n/app/tblkit/token.c\r\n/app/tblkit/token.h\r\n/app/touchbay/delta.lst\r\n/app/unitpit/alpha/aux.c\r\n/app/unitpit/alpha/pump.c\r\n/app/unitpit/beta/aux.c\r\n/app/unitpit/beta/tank.c"]
[8.858937, "o", "\r\n/app/unitpit/gamma/shift.c\r\n"]
[8.860726, "o", "\u001b[?2004hroot@7d29c5a128b1:/app# "]
[9.373825, "i", "printf '\\n--- dump ---\\n'; cat /app/lotbay/shift.dmp; printf '\\n--- atlas ---\\n'; cat /app/inkwell/span.atlas; printf '\\n--- clip.out ---\\n'; cat /app/inkwell/clip.out 2>/dev/null || true\n"]
[9.375019, "o", "printf '\\n--- dump ---\\n'; cat /app/lotbay/shift.dmp; printf '\\n--- atlas ---\\n'; cat /app/inkwell/span.atlas; printf '\\n--- clip.out ---\\n'; cat /app/inkwell/clip.out 2>/dev/null || true\r\n\u001b[?2004l\r"]
[9.375214, "o", "\r\n--- dump ---\r\n"]
[9.377338, "o", "DUMP1\r\nshift_move /app/unitpit/gamma/shift.c 8\r\n"]
[9.377888, "o", "\r\n--- atlas ---\r\n"]
[9.379386, "o", "SPAN1\r\nshift_move /app/unitpit/gamma/prior.c 1 4\r\nidle_stub /app/unitpit/gamma/shift.c 1 4\r\nhelper_q /app/unitpit/beta/aux.c 1 4\r\nhelper_q /app/unitpit/alpha/aux.c 1 4\r\npump_fill /app/unitpit/alpha/pump.c 1 4\r\ntank_drain /app/unitpit/beta/tank.c 1 4\r\n"]
[9.3797, "o", "\r\n--- clip.out ---\r\n"]
[9.381095, "o", "\u001b[?2004hroot@7d29c5a128b1:/app# "]
[9.528586, "i", "printf '\\n--- binary ---\\n'; file /app/bin/lotxref; printf '\\n--- reknit ---\\n'; /app/bin/lotxref reknit; echo \"reknit_status=$?\"; printf '\\n--- regenerated atlas ---\\n'; cat /app/inkwell/span.atlas; printf '\\n--- clip ---\\n'; /app/bin/lotxref clip; echo \"clip_status=$?\"; cat /app/inkwell/clip.out\n"]
[9.529526, "o", "printf '\\n--- binary ---\\n'; file /app/bin/lotxref; printf '\\n--- reknit ---\\n'; /app/bin/lotxref reknit; echo \"reknit_status=$?\"; printf '\\n--- regenerated atlas ---\\n'; cat /app/inkwell/span.atlas; printf '\\n--- clip ---\\n'; /app/bin/lotxref clip; echo \"clip_status=$?\"; cat /app/inkwell/clip.out\r\n\u001b[?2004l\r"]
[9.529697, "o", "\r\n--- binary ---\r\n"]
[9.531772, "o", "/app/bin/lotxref: ELF 64-bit LSB executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, for GNU/Linux 3.2.0, not stripped\r\n"]
[9.532194, "o", "\r\n--- reknit ---\r\n"]
[9.533418, "o", "reknit_status=0\r\n\r\n--- regenerated atlas ---\r\n"]
[9.534255, "o", "SPAN1\r\nshift_move /app/unitpit/gamma/prior.c 1 4\r\nidle_stub /app/unitpit/gamma/shift.c 1 4\r\nhelper_q /app/unitpit/beta/aux.c 1 4\r\nhelper_q /app/unitpit/alpha/aux.c 1 4\r\npump_fill /app/unitpit/alpha/pump.c 1 4\r\ntank_drain /app/unitpit/beta/tank.c 1 4\r\n"]
[9.534432, "o", "\r\n--- clip ---\r\n"]
[9.53524, "o", "usage: lotxref reknit|clip PATH\r\n"]
[9.535389, "o", "clip_status=2\r\n"]
[9.536105, "o", "cat: /app/inkwell/clip.out: No such file or directory\r\n"]
[9.53631, "o", "\u001b[?2004hroot@7d29c5a128b1:/app# "]
[19.466258, "i", "printf '%s\\n' '--- hull.mk ---'; cat /app/tblkit/hull.mk; for f in /app/tblkit/*.[ch] /app/slitmill/*.[ch] /app/cupeel/*.[ch] /app/drygate/*.[ch] /app/sidecue/*.[ch]; do echo \"--- $f ---\"; nl -ba \"$f\"; done\n"]
[19.466978, "o", "printf '%s\\n' '--- hull.mk ---'; cat /app/tblkit/hull.mk; for f in /app/tblkit/*.[ch] /app/slitmill/*.[ch] /app/cupeel/*.[ch] /app/drygate/*.[ch] /app/sidecue/*.[ch]; do echo \"--- $f ---\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[19.467118, "o", "--- hull.mk ---\r\n"]
[19.468238, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -I/app/tblkit -I/app/slitmill -I/app/cupeel -I/app/drygate -I/app/sidecue\r\nSRC := $(wildcard /app/tblkit/*.c) $(wildcard /app/slitmill/*.c) $(wildcard /app/cupeel/*.c) $(wildcard /app/drygate/*.c) $(wildcard /app/sidecue/*.c)\r\nBIN := /app/bin/lotxref\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/inkwell\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[19.468614, "o", "--- /app/tblkit/gap.h ---\r\n"]
[19.469612, "o", "     1\t#ifndef GAP_H\r\n     2\t#define GAP_H\r\n     3\tint n_miss(void);\r\n     4\t#endif\r\n"]
[19.469786, "o", "--- /app/tblkit/hull_cli.c ---\r\n"]
[19.470623, "o", "     1\t#include \"scan.h\"\r\n     2\t#include \"pick.h\"\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint main(int argc, char **argv) {\r\n     7\t    if (argc < 2) {\r\n"]
[19.470743, "o", "     8\t        fprintf(stderr, \"usage: lotxref reknit|clip PATH\\n\");\r\n     9\t        return 2;\r\n    10\t    }\r\n    11\t    if (strcmp(argv[1], \"reknit\") == 0) return op_a();\r\n    12\t    if (strcmp(argv[1], \"clip\") == 0 && argc >= 3) return op_b(argv[2]);\r\n    13\t    fprintf(stderr, \"usage: lotxref reknit|clip PATH\\n\");\r\n    14\t    return 2;\r\n    15\t}\r\n"]
[19.470922, "o", "--- /app/tblkit/pick.h ---\r\n"]
[19.471779, "o", "     1\t#ifndef PICK_H\r\n     2\t#define PICK_H\r\n     3\tint op_b(const char *p);\r\n     4\t#endif\r\n"]
[19.471967, "o", "--- /app/tblkit/scan.h ---\r\n"]
[19.472819, "o", "     1\t#ifndef SCAN_H\r\n     2\t#define SCAN_H\r\n     3\tint op_a(void);\r\n     4\t#endif\r\n"]
[19.473064, "o", "--- /app/tblkit/token.c ---\r\n"]
[19.473896, "o", "     1\t#include \"token.h\"\r\n     2\t#include <dirent.h>\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t#include <sys/stat.h>\r\n     7\t\r\n     8\tint file_here(const char *path) {\r\n     9\t    struct stat st;\r\n    10\t    return path && path[0] && stat(path, &st) == 0 && S_ISREG(st.st_mode);\r\n    11\t}\r\n"]
[19.474045, "o", "    12\t\r\n    13\tstatic int is_c_name(const char *n) {\r\n    14\t    size_t L = strlen(n);\r\n    15\t    return L > 2 && n[L - 2] == '.' && n[L - 1] == 'c';\r\n    16\t}\r\n    17\t\r\n    18\tstatic void walk_rec(const char *dir, char paths[][PATH_MAX_X], int *n, int max) {\r\n    19\t    DIR *d = opendir(dir);\r\n    20\t    if (!d) return;\r\n    21\t    struct dirent *ent;\r\n    22\t    while ((ent = readdir(d)) != NULL && *n < max) {\r\n    23\t        if (ent->d_name[0] == '.') continue;\r\n    24\t        char sub[PATH_MAX_X];\r\n    25\t        snprintf(sub, sizeof sub, \"%s/%s\", dir, ent->d_name);\r\n    26\t        struct stat st;\r\n    27\t        if (stat(sub, &st) != 0) continue;\r\n    28\t        if (S_ISDIR(st.st_mode)) walk_rec(sub, paths, n, max);\r\n    29\t        else if (S_ISREG(st.st_mode) && is_c_name(ent->d_name)) {\r\n    30\t            snprintf(paths[*n], PATH_MAX_X, \"%s\", sub);\r\n    31\t            (*n)++;\r\n    32\t        }\r\n    33\t    }\r\n    34\t    closedir(d);\r\n    35\t}\r\n    36\t\r\n    37\tint walk_units(const char *root, char paths[][PATH_MAX_X], int max) {\r\n    38\t    int n = 0;\r\n    39\t    walk_rec(root, paths, &n, max);\r\n    40\t    return n;\r\n    41\t}\r\n    42\t\r\n    43\tint parse_unit(const char *path, Row *rows, int max) {\r\n    44\t    FILE *f = fopen(path, \"r\");\r\n    45\t    if (!f) return 0;\r\n    46\t    char line[512];\r\n    47\t    int lineno = 0, n = 0, open_lo = 0;\r\n    48\t    char cur[NAME_MAX];\r\n    49\t    cur[0] = 0;\r\n    50\t    while (fgets(line, sizeof line, f)) {\r\n    51\t        lineno++;\r\n    52\t        char nm[NAME_MAX];\r\n    53\t        if (sscanf(line, \"void %63[A-Za-z0-9_](\", nm) == 1) {\r\n    54\t            snprintf(cur, sizeof cur, \"%s\", nm);\r\n"]
[19.47414, "o", "    55\t            open_lo = lineno;\r\n    56\t        } else if (cur[0] && (strcmp(line, \"}\\n\") == 0 || strcmp(line, \"}\\r\\n\") == 0 || strcmp(line, \"}\") == 0)) {\r\n    57\t            if (n < max) {\r\n    58\t                snprintf(rows[n].name, NAME_MAX, \"%s\", cur);\r\n    59\t                snprintf(rows[n].path, PATH_MAX_X, \"%s\", path);\r\n    60\t                rows[n].lo = open_lo;\r\n    61\t                rows[n].hi = lineno;\r\n    62\t                n++;\r\n    63\t            }\r\n    64\t            cur[0] = 0;\r\n    65\t        }\r\n    66\t    }\r\n    67\t    fclose(f);\r\n    68\t    return n;\r\n    69\t}\r\n    70\t\r\n    71\tint parse_lot(const char *path, char *name, char *orig, int *line) {\r\n    72\t    FILE *f = fopen(path, \"r\");\r\n    73\t    if (!f) return -1;\r\n    74\t    char hdr[64];\r\n    75\t    if (!fgets(hdr, sizeof hdr, f)) { fclose(f); return -1; }\r\n    76\t    if (strncmp(hdr, \"DUMP1\", 5) != 0) { fclose(f); return -1; }\r\n    77\t    char rest[512];\r\n    78\t    if (!fgets(rest, sizeof rest, f)) { fclose(f); return -1; }\r\n    79\t    fclose(f);\r\n    80\t    if (sscanf(rest, \"%63s %255s %d\", name, orig, line) != 3) return -1;\r\n    81\t    return 0;\r\n    82\t}\r\n    83\t\r\n    84\tint load_tbl(const char *path, Row *rows, int max) {\r\n"]
[19.474214, "o", "    85\t    FILE *f = fopen(path, \"r\");\r\n    86\t    if (!f) return 0;\r\n    87\t    char line[512];\r\n    88\t    if (!fgets(line, sizeof line, f)) { fclose(f); return 0; }\r\n    89\t    int n = 0;\r\n    90\t    while (fgets(line, sizeof line, f) && n < max) {\r\n    91\t        if (sscanf(line, \"%63s %255s %d %d\", rows[n].name, rows[n].path, &rows[n].lo, &rows[n].hi) == 4)\r\n    92\t            n++;\r\n    93\t    }\r\n    94\t    fclose(f);\r\n    95\t    return n;\r\n    96\t}\r\n    97\t\r\n    98\tint save_tbl(const char *path, Row *rows, int n) {\r\n    99\t    FILE *f = fopen(path, \"w\");\r\n   100\t    if (!f) return -1;\r\n   101\t    fprintf(f, \"SPAN1\\n\");\r\n   102\t    for (int i = 0; i < n; i++)\r\n   103\t        fprintf(f, \"%s %s %d %d\\n\", rows[i].name, rows[i].path, rows[i].lo, rows[i].hi);\r\n   104\t    fclose(f);\r\n   105\t    return 0;\r\n   106\t}\r\n   107\t\r\n   108\tint extract_span(const char *path, int lo, int hi, char *out, int cap) {\r\n   109\t    FILE *f = fopen(path, \"r\");\r\n"]
[19.474303, "o", "   110\t    if (!f) { out[0] = 0; return -1; }\r\n   111\t    char line[512];\r\n   112\t    int lineno = 0, used = 0;\r\n   113\t    out[0] = 0;\r\n   114\t    while (fgets(line, sizeof line, f)) {\r\n   115\t        lineno++;\r\n   116\t        if (lineno < lo || lineno > hi) continue;\r\n   117\t        int L = (int)strlen(line);\r\n   118\t        if (used + L + 1 >= cap) break;\r\n   119\t        memcpy(out + used, line, L);\r\n   120\t        used += L;\r\n   121\t        out[used] = 0;\r\n   122\t    }\r\n   123\t    fclose(f);\r\n   124\t    return 0;\r\n   125\t}\r\n"]
[19.474483, "o", "--- /app/tblkit/token.h ---\r\n"]
[19.475258, "o", "     1\t#ifndef TOKEN_H\r\n     2\t#define TOKEN_H\r\n     3\tenum { ROW_MAX = 128, NAME_MAX = 64, PATH_MAX_X = 256 };\r\n     4\ttypedef struct {\r\n"]
[19.475346, "o", "     5\t    char name[NAME_MAX];\r\n     6\t    char path[PATH_MAX_X];\r\n     7\t    int lo;\r\n     8\t    int hi;\r\n     9\t} Row;\r\n    10\tint parse_unit(const char *path, Row *rows, int max);\r\n    11\tint parse_lot(const char *path, char *name, char *orig, int *line);\r\n    12\tint load_tbl(const char *path, Row *rows, int max);\r\n    13\tint save_tbl(const char *path, Row *rows, int n);\r\n    14\tint walk_units(const char *root, char paths[][PATH_MAX_X], int max);\r\n    15\tint extract_span(const char *path, int lo, int hi, char *out, int cap);\r\n    16\tint file_here(const char *path);\r\n    17\t#endif\r\n"]
[19.475465, "o", "--- /app/slitmill/scan.c ---\r\n"]
[19.476276, "o", "     1\t#include \"scan.h\"\r\n     2\t#include \"token.h\"\r\n     3\t#include \"gap.h\"\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n     6\t#include <string.h>\r\n     7\t#include <sys/stat.h>\r\n"]
[19.476372, "o", "     8\t\r\n     9\tstatic int find_name(Row *rows, int n, const char *name) {\r\n    10\t    for (int i = 0; i < n; i++) {\r\n    11\t        if (strcmp(rows[i].name, name) == 0) return i;\r\n    12\t    }\r\n    13\t    return -1;\r\n    14\t}\r\n    15\t\r\n    16\tint op_a(void) {\r\n    17\t    mkdir(\"/app/inkwell\", 0755);\r\n    18\t    if (n_miss() != 0) return 1;\r\n    19\t\r\n    20\t    Row rows[ROW_MAX];\r\n    21\t    int n = load_tbl(\"/app/inkwell/span.atlas\", rows, ROW_MAX);\r\n    22\t\r\n    23\t    FILE *df = fopen(\"/app/touchbay/delta.lst\", \"r\");\r\n    24\t    if (df) {\r\n    25\t        char pth[PATH_MAX_X];\r\n    26\t        while (fgets(pth, sizeof pth, df)) {\r\n    27\t            size_t L = strlen(pth);\r\n    28\t            while (L && (pth[L - 1] == '\\n' || pth[L - 1] == '\\r')) pth[--L] = 0;\r\n    29\t            if (!L) continue;\r\n    30"]
[19.476441, "o", "\t            Row got[32];\r\n    31\t            int k = parse_unit(pth, got, 32);\r\n    32\t            for (int i = 0; i < k; i++) {\r\n    33\t                int idx = find_name(rows, n, got[i].name);\r\n    34\t                if (idx >= 0) continue;\r\n    35\t                if (n < ROW_MAX) rows[n++] = got[i];\r\n    36\t            }\r\n    37\t        }\r\n    38\t        fclose(df);\r\n    39\t    }\r\n    40\t    save_tbl(\"/app/inkwell/span.atlas\", rows, n);\r\n    41\t    return n_miss();\r\n    42\t}\r\n"]
[19.476596, "o", "--- /app/cupeel/pick.c ---\r\n"]
[19.477301, "o", "     1\t#include \"pick.h\"\r\n     2\t#include \"token.h\"\r\n     3\t#include \"mtime.h\"\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n"]
[19.477385, "o", "     6\t#include <sys/stat.h>\r\n     7\t\r\n     8\tint op_b(const char *p) {\r\n     9\t    mkdir(\"/app/inkwell\", 0755);\r\n    10\t    char name[NAME_MAX], orig[PATH_MAX_X];\r\n    11\t    int line = 0;\r\n    12\t    if (parse_lot(p, name, orig, &line) != 0) return 2;\r\n    13\t\r\n    14\t    Row rows[ROW_MAX];\r\n    15\t    int n = load_tbl(\"/app/inkwell/span.atlas\", rows, ROW_MAX);\r\n    16\t    int idx = -1;\r\n    17\t    for (int i = 0; i < n; i++) {\r\n    18\t        if (strcmp(rows[i].name, name) == 0) { idx = i; break; }\r\n    19\t    }\r\n    20\t    (void)pick_last;\r\n    21\t    if (idx < 0) return 1;\r\n    22\t\r\n    23\t    const char *use = rows[idx].path;\r\n    24\t    if (!file_here(use)) use = orig;\r\n    25\t\r\n    26\t    char body[8192];\r\n    27\t    extract_span(use, rows[idx].lo, rows[idx].hi, body, sizeof body);\r\n    28\t\r\n"]
[19.477463, "o", "    29\t    FILE *out = fopen(\"/app/inkwell/clip.out\", \"w\");\r\n    30\t    if (!out) return 1;\r\n    31\t    fprintf(out, \"CLIP %s\\n%s\", name, body);\r\n    32\t    fclose(out);\r\n    33\t    return 0;\r\n    34\t}\r\n"]
[19.477575, "o", "--- /app/drygate/gap.c ---\r\n"]
