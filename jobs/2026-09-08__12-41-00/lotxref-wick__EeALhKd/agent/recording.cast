[33.703769, "o", "echo '--- token.h ---'; nl -ba /app/tblkit/token.h; echo '--- token.c ---'; nl -ba /app/tblkit/token.c; echo '--- scan.c ---'; nl -ba /app/slitmill/scan.c\r\n\u001b[?2004l\r"]
[33.703889, "o", "--- token.h ---\r\n"]
[33.705181, "o", "     1\t#ifndef TOKEN_H\r\n     2\t#define TOKEN_H\r\n     3\tenum { ROW_MAX = 128, NAME_MAX = 64, PATH_MAX_X = 256 };\r\n     4\ttypedef struct {\r\n     5\t    char name[NAME_MAX];\r\n     6\t    char path[PATH_MAX_X];\r\n     7\t    int lo;\r\n     8\t    int hi;\r\n     9\t} Row;\r\n    10\tint parse_unit(const char *path, Row *rows, int max);\r\n    11\tint parse_lot(const char *path, char *name, char *orig, int *line);\r\n    12\tint load_tbl(const char *path, Row *rows, int max);\r\n    13\tint save_tbl(const char *path, Row *rows, int n);\r\n    14\tint walk_units(const char *root, char paths[][PATH_MAX_X], int max);\r\n    15\tint extract_span(const char *path, int lo, int hi, char *out, int cap);\r\n    16\tint file_here(const char *path);\r\n    17\t#endif\r\n"]
[33.705529, "o", "--- token.c ---\r\n"]
[33.706526, "o", "     1\t#include \"token.h\"\r\n     2\t#include <dirent.h>\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t#include <sys/stat.h>\r\n     7\t\r\n     8\tint file_here(const char *path) {\r\n     9\t    struct stat st;\r\n"]
[33.706693, "o", "    10\t    return path && path[0] && stat(path, &st) == 0 && S_ISREG(st.st_mode);\r\n    11\t}\r\n    12\t\r\n    13\tstatic int is_c_name(const char *n) {\r\n    14\t    size_t L = strlen(n);\r\n    15\t    return L > 2 && n[L - 2] == '.' && n[L - 1] == 'c';\r\n    16\t}\r\n    17\t\r\n    18\tstatic void walk_rec(const char *dir, char paths[][PATH_MAX_X], int *n, int max) {\r\n    19\t    DIR *d = opendir(dir);\r\n    20\t    if (!d) return;\r\n    21\t    struct dirent *ent;\r\n    22\t    while ((ent = readdir(d)) != NULL && *n < max) {\r\n    23\t        if (ent->d_name[0] == '.') continue;\r\n    24\t        char sub[PATH_MAX_X];\r\n    25\t        snprintf(sub, sizeof sub, \"%s/%s\", dir, ent->d_name);\r\n    26\t        struct stat st;\r\n    27\t        if (stat(sub, &st) != 0) continue;\r\n    28\t        if (S_ISDIR(st.st_mode)) walk_rec(sub, paths, n, max);\r\n    29\t        else if (S_ISREG(st.st_mode) && is_c_name(ent->d_name)) {\r\n    30\t            snprintf(paths[*n], PATH_MAX_X, \"%s\", sub);\r\n    31\t            (*n)++;\r\n    32\t        }\r\n    33\t    }\r\n    34\t    closedir(d);\r\n    35\t}\r\n    36\t\r\n    37\tint walk_units(const char *root, char paths[][PATH_MAX_X], int max) {\r\n    38\t    int n = 0;\r\n    39\t    walk_rec(root, paths, &n, max);\r\n    40\t    return n;\r\n    41\t}\r\n    42\t\r\n    43\tint parse_unit(const char *path, Row *rows, int max) {\r\n    44\t    FILE *f = fopen(path, \"r\");\r\n    45\t    if (!f) return 0;\r\n    46\t    char line[512];\r\n    47\t    int lineno = 0, n = 0, open_lo = 0;\r\n    48\t    char cur[NAME_MAX];\r\n    49\t    cur[0] = 0;\r\n"]
[33.706798, "o", "    50\t    while (fgets(line, sizeof line, f)) {\r\n    51\t        lineno++;\r\n    52\t        char nm[NAME_MAX];\r\n    53\t        if (sscanf(line, \"void %63[A-Za-z0-9_](\", nm) == 1) {\r\n    54\t            snprintf(cur, sizeof cur, \"%s\", nm);\r\n    55\t            open_lo = lineno;\r\n    56\t        } else if (cur[0] && (strcmp(line, \"}\\n\") == 0 || strcmp(line, \"}\\r\\n\") == 0 || strcmp(line, \"}\") == 0)) {\r\n    57\t            if (n < max) {\r\n    58\t                snprintf(rows[n].name, NAME_MAX, \"%s\", cur);\r\n    59\t                snprintf(rows[n].path, PATH_MAX_X, \"%s\", path);\r\n    60\t                rows[n].lo = open_lo;\r\n    61\t                rows[n].hi = lineno;\r\n    62\t                n++;\r\n    63\t            }\r\n    64\t            cur[0] = 0;\r\n    65\t        }\r\n    66\t    }\r\n    67\t    fclose(f);\r\n    68\t    return n;\r\n    69\t}\r\n    70\t\r\n    71\tint parse_lot(const char *path, char *name, char *orig, int *line) {\r\n    72\t    FILE *f = fopen(path, \"r\");\r\n    73\t    if (!f) return -1;\r\n    74\t    char hdr[64];\r\n    75\t    if (!fgets(hdr, sizeof hdr, f)) { fclose(f); return -1; }\r\n    76\t    if (strncmp(hdr, \"DUMP1\", 5) != 0) { fclose(f); return -1; }\r\n    77\t    char rest[512];\r\n    78\t    if (!fgets(rest, sizeof rest, f)) { fclose(f); return -1; }\r\n    79\t    fclose(f);\r\n    80\t    if (sscanf(rest, \"%63s %255s %d\", name, orig, line) != 3) return -1;\r\n    81\t    return 0;\r\n    82\t}\r\n    83\t\r\n    84\tint load_tbl(const char *path, Row *rows, int max) {\r\n    85\t    FILE *f = fopen(path, \"r\");\r\n    86\t    if (!f) return 0;\r\n"]
[33.70687, "o", "    87\t    char line[512];\r\n    88\t    if (!fgets(line, sizeof line, f)) { fclose(f); return 0; }\r\n    89\t    int n = 0;\r\n    90\t    while (fgets(line, sizeof line, f) && n < max) {\r\n    91\t        if (sscanf(line, \"%63s %255s %d %d\", rows[n].name, rows[n].path, &rows[n].lo, &rows[n].hi) == 4)\r\n    92\t            n++;\r\n    93\t    }\r\n    94\t    fclose(f);\r\n    95\t    return n;\r\n    96\t}\r\n    97\t\r\n    98\tint save_tbl(const char *path, Row *rows, int n) {\r\n    99\t    FILE *f = fopen(path, \"w\");\r\n   100\t    if (!f) return -1;\r\n   101\t    fprintf(f, \"SPAN1\\n\");\r\n   102\t    for (int i = 0; i < n; i++)\r\n   103\t        fprintf(f, \"%s %s %d %d\\n\", rows[i].name, rows[i].path, rows[i].lo, rows[i].hi);\r\n   104\t    fclose(f);\r\n   105\t    return 0;\r\n   106\t}\r\n   107\t\r\n   108\tint extract_span(const char *path, int lo, int hi, char *out, int cap) {\r\n   109\t    FILE *f = fopen(path, \"r\");\r\n"]
[33.70693, "o", "   110\t    if (!f) { out[0] = 0; return -1; }\r\n   111\t    char line[512];\r\n   112\t    int lineno = 0, used = 0;\r\n   113\t    out[0] = 0;\r\n   114\t    while (fgets(line, sizeof line, f)) {\r\n   115\t        lineno++;\r\n   116\t        if (lineno < lo || lineno > hi) continue;\r\n   117\t        int L = (int)strlen(line);\r\n   118\t        if (used + L + 1 >= cap) break;\r\n   119\t        memcpy(out + used, line, L);\r\n   120\t        used += L;\r\n   121\t        out[used] = 0;\r\n   122\t    }\r\n   123\t    fclose(f);\r\n   124\t    return 0;\r\n   125\t}\r\n"]
[33.707137, "o", "--- scan.c ---\r\n"]
[33.708009, "o", "     1\t#include \"scan.h\"\r\n     2\t#include \"token.h\"\r\n     3\t#include \"gap.h\"\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n"]
[33.708051, "o", "     6\t#include <string.h>\r\n     7\t#include <sys/stat.h>\r\n     8\t\r\n     9\tstatic int find_name(Row *rows, int n, const char *name) {\r\n    10\t    for (int i = 0; i < n; i++) {\r\n    11\t        if (strcmp(rows[i].name, name) == 0) return i;\r\n    12\t    }\r\n    13\t    return -1;\r\n    14\t}\r\n    15\t\r\n    16\tint op_a(void) {\r\n    17\t    mkdir(\"/app/inkwell\", 0755);\r\n    18\t    if (n_miss() != 0) return 1;\r\n    19\t\r\n"]
[33.708076, "o", "    20\t    Row rows[ROW_MAX];\r\n    21\t    int n = load_tbl(\"/app/inkwell/span.atlas\", rows, ROW_MAX);\r\n    22\t\r\n    23\t    FILE *df = fopen(\"/app/touchbay/delta.lst\", \"r\");\r\n    24\t    if (df) {\r\n    25\t        char pth[PATH_MAX_X];\r\n    26\t        while (fgets(pth, sizeof pth, df)) {\r\n    27\t            size_t L = strlen(pth);\r\n    28\t            while (L && (pth[L - 1] == '\\n' || pth[L - 1] == '\\r')) pth[--L] = 0;\r\n"]
[33.708091, "o", "    29\t            if (!L) continue;\r\n    30\t            Row got[32];\r\n    31\t            int k = parse_unit(pth, got, 32);\r\n    32\t"]
[33.70811, "o", "            for (int i = 0; i < k; i++) {\r\n    33\t                int idx = find_name(rows, n, got[i].name);\r\n    34\t                if (idx >= 0) continue;\r\n    35\t                if (n < ROW_MAX) rows[n++] = got[i];\r\n    36\t            }\r\n"]
[33.708125, "o", "    37\t        }\r\n    38\t        fclose(df);\r\n    39\t    }\r\n    40\t    save_tbl(\"/app/inkwell/span.atlas\", rows, n);\r\n    41\t    return n_miss();\r\n"]
[33.70814, "o", "    42\t}\r\n"]
[33.708586, "o", "\u001b[?2004hroot@7d29c5a128b1:/app# "]
[71.796369, "i", "cat > /app/slitmill/scan.c <<'EOF'\n#include \"scan.h\"\n#include \"token.h\"\n#include \"gap.h\"\n#include <sys/stat.h>\n\nint op_a(void) {\n    char paths[ROW_MAX][PATH_MAX_X];\n    Row rows[ROW_MAX];\n    int npath, n = 0;\n\n    mkdir(\"/app/inkwell\", 0755);\n    npath = walk_units(\"/app/unitpit\", paths, ROW_MAX);\n    for (int i = 0; i < npath; i++) {\n        int k;\n        if (!file_here(paths[i])) return 1;\n        k = parse_unit(paths[i], rows + n, ROW_MAX - n);\n        n += k;\n        if (n >= ROW_MAX) break;\n    }\n\n    if (save_tbl(\"/app/inkwell/span.atlas\", rows, n) != 0) return 1;\n    return n_miss() == 0 ? 0 : 1;\n}\nEOF\ncat > /app/drygate/gap.c <<'EOF'\n#include \"gap.h\"\n#include \"token.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nstatic int under_unitpit(const char *path) {\n    static const char root[] = \"/app/unitpit/\";\n    return path && strncmp(path, root, sizeof(root) - 1) == 0;\n}\n\nstatic int check_dumps(void) {\n    DIR *d = opendir(\"/app/lotbay\");\n    struct dirent *ent;\n    int bad = 0;\n    if (!d) return 1;\n    while ((ent = readdir(d)) != NULL) {\n        char dump[PATH_MAX_X], name[NAME_MAX], orig[PATH_MAX_X];\n        struct stat st;\n        int line;\n        if (ent->d_name[0] == '.') continue;\n        snprintf(dump, sizeof dump, \"/app/lotbay/%s\", ent->d_name);\n        if (stat(dump, &st) != 0 || !S_ISREG(st.st_mode)) continue;\n        if (parse_lot(dump, name, orig, &line) != 0 ||\n            !under_unitpit(orig) || !file_here(orig) || line < 1)\n            bad = 1;\n    }\n    closedir(d);\n    return bad;\n}\n\nstatic int check_atlas(void) {\n    FILE *f = fopen(\"/app/inkwell/span.atlas\", \"r\");\n    char line[512], extra;\n    int bad = 0;\n    if (!f) return 1;\n    if (!fgets(line, sizeof line, f) ||\n        (strcmp(line, \"SPAN1\\n\") != 0 && strcmp(line, \"SPAN1\\r\\n\") != 0 && strcmp(line, \"SPAN1\") != 0)) {\n        fclose(f);\n        return 1;\n    }\n    while (fgets(line, sizeof line, f)) {\n        char name[NAME_MAX], path[PATH_MAX_X];\n        int lo, hi;\n        if (sscanf(line, \"%63s %255s %d %d %c\", name, path, &lo, &hi, &extra) != 4 ||\n            !under_unitpit(path) || !file_here(path) || lo < 1 || hi < lo)\n            bad = 1;\n    }\n    fclose(f);\n    return bad;\n}\n\nint n_miss(void) {\n    return check_dumps() || check_atlas();\n}\nEOF\ncat > /app/cupeel/pick.c <<'EOF'\n#include \"pick.h\"\n#include \"token.h\"\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nint op_b(const char *p) {\n    char name[NAME_MAX], orig[PATH_MAX_X], body[8192];\n    Row rows[ROW_MAX];\n    int line = 0, idx = -1;\n\n    mkdir(\"/app/inkwell\", 0755);\n    remove(\"/app/inkwell/clip.out\");\n    if (parse_lot(p, name, orig, &line) != 0 || !file_here(orig) || line < 1)\n        return 2;\n\n    int n = load_tbl(\"/app/inkwell/span.atlas\", rows, ROW_MAX);\n    for (int i = 0; i < n; i++) {\n        if (strcmp(rows[i].name, name) == 0 &&\n            strcmp(rows[i].path, orig) == 0 &&\n            line >= rows[i].lo && line <= rows[i].hi) {\n            idx = i;\n            break;\n        }\n    }\n    if (idx < 0 || !file_here(rows[idx].path)) return 1;\n    if (extract_span(rows[idx].path, rows[idx].lo, rows[idx].hi,\n                     body, sizeof body) != 0)\n        return 1;\n\n    FILE *out = fopen(\"/app/inkwell/clip.out\", \"w\");\n    if (!out) return 1;\n    fprintf(out, \"CLIP %s\\n%s\", name, body);\n    if (fclose(out) != 0) return 1;\n    return 0;\n}\nEOF\nmake -f /app/tblkit/hull.mk hull\n"]
[71.796843, "o", "cat > /app/slitmill/scan.c <<'EOF'\r\n\u001b[?2004l\r"]
[71.797015, "o", "\u001b[?2004h> "]
[71.799626, "o", "#include \"scan.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"token.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"gap.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/stat.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int op_a(void) {\r\n\u001b[?2004l\r\u001b[?2004h>     char paths[ROW_MAX][PATH_MAX_X];\r\n\u001b[?2004l\r\u001b[?2004h>     Row rows[ROW_MAX];\r\n\u001b[?2004l\r\u001b[?2004h>     int npath, n = 0;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     mkdir(\"/app/inkwell\", 0755);\r\n\u001b[?2004l\r\u001b[?2004h>     npath = walk_units(\"/app/unitpit\", paths, ROW_MAX);\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < npath; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         int k;\r\n\u001b[?2004l\r\u001b[?2004h>         if (!file_here(paths[i])) return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         k = parse_unit(paths[i], rows + n, ROW_MAX - n);\r\n\u001b[?2004l\r\u001b[?2004h>         n += k;\r\n\u001b[?2004l\r\u001b[?2004h>         if (n >= ROW_MAX) break;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (save_tbl(\"/app/inkwell/span.atlas\", rows, n) != 0) return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     return n_miss() == 0 ? 0 : 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.799823, "o", "EOF\r\n\u001b[?2004l\r"]
