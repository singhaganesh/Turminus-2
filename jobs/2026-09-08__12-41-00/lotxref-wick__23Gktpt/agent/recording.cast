[66.420189, "o", "> "]
[66.420311, "o", "    return strncmp(p, root, sizeof(root) - 1) == 0 && p[sizeof(root) - 1] != '\\0';\r\n\u001b[?2004l\r"]
[66.420381, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.420441, "o", "\u001b[?2004h> "]
[66.420491, "o", "static int dumps_ok(void) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.420603, "o", "    DIR *d = opendir(\"/app/lotbay\");\r\n\u001b[?2004l\r"]
[66.420653, "o", "\u001b[?2004h> "]
[66.420708, "o", "    struct dirent *ent;\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.420766, "o", ">     int bad = 0;\r\n"]
[66.420816, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[66.42087, "o", "    if (!d) return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.420924, "o", "> "]
[66.420977, "o", "    while ((ent = readdir(d)) != NULL) {\r\n\u001b[?2004l\r"]
[66.421031, "o", "\u001b[?2004h> "]
[66.421148, "o", "        char dump[PATH_MAX_X], name[NAME_MAX], orig[PATH_MAX_X];\r\n\u001b[?2004l\r"]
[66.421199, "o", "\u001b[?2004h> "]
[66.4213, "o", "        int line;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.421397, "o", "        if (ent->d_name[0] == '.') continue;\r\n\u001b[?2004l\r"]
[66.421503, "o", "\u001b[?2004h> "]
[66.421797, "o", "        if (snprintf(dump, sizeof dump, \"/app/lotbay/%s\", ent->d_name) >= (int)sizeof dump) {\r\n\u001b[?2004l\r"]
[66.421894, "o", "\u001b[?2004h>             bad = 1;\r\n\u001b[?2004l\r"]
[66.421967, "o", "\u001b[?2004h> "]
[66.422075, "o", "            continue;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[66.422163, "o", "\u001b[?2004h> "]
[66.422291, "o", "        if (parse_lot(dump, name, orig, &line) != 0 || line < 1 ||\r\n\u001b[?2004l\r"]
[66.422365, "o", "\u001b[?2004h> "]
[66.422477, "o", "            !under_unitpit(orig) || !file_here(orig)) bad = 1;\r\n\u001b[?2004l\r"]
[66.422537, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[66.422591, "o", "\u001b[?2004h> "]
[66.422635, "o", "    closedir(d);\r\n"]
[66.422717, "o", "\u001b[?2004l\r\u001b[?2004h>     return bad;\r\n\u001b[?2004l\r"]
[66.4228, "o", "\u001b[?2004h"]
[66.422873, "o", "> }\r\n\u001b[?2004l\r"]
[66.422929, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.423004, "o", "static int atlas_ok(void) {\r\n\u001b[?2004l\r"]
[66.42305, "o", "\u001b[?2004h> "]
[66.423165, "o", "    FILE *f = fopen(\"/app/inkwell/span.atlas\", \"r\");\r\n\u001b[?2004l\r"]
[66.423211, "o", "\u001b[?2004h> "]
[66.423281, "o", "    char line[512], extra;\r\n\u001b[?2004l\r"]
[66.423325, "o", "\u001b[?2004h> "]
[66.423369, "o", "    int bad = 0;\r\n\u001b[?2004l\r"]
[66.423409, "o", "\u001b[?2004h> "]
[66.423463, "o", "    if (!f) return 1;\r\n\u001b[?2004l\r"]
[66.423509, "o", "\u001b[?2004h> "]
[66.423612, "o", "    if (!fgets(line, sizeof line, f) ||\r\n\u001b[?2004l\r"]
[66.423654, "o", "\u001b[?2004h> "]
[66.423901, "o", "        (strcmp(line, \"SPAN1\\n\") != 0 && strcmp(line, \"SPAN1\\r\\n\") != 0 && strcmp(line, \"SPAN1\") != 0)) {\r\n\u001b[?2004l\r"]
[66.423986, "o", "\u001b[?2004h>         fclose(f);\r\n\u001b[?2004l\r"]
[66.424067, "o", "\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r"]
[66.424133, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.424196, "o", "> "]
[66.424262, "o", "    while (fgets(line, sizeof line, f)) {\r\n\u001b[?2004l\r"]
[66.424311, "o", "\u001b[?2004h> "]
[66.424356, "o", "        Row r;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.424561, "o", "        if (sscanf(line, \"%63s %255s %d %d %c\", r.name, r.path, &r.lo, &r.hi, &extra) != 4 ||\r\n\u001b[?2004l\r"]
[66.424605, "o", "\u001b[?2004h> "]
[66.424858, "o", "            r.lo < 1 || r.hi < r.lo || !under_unitpit(r.path) || !file_here(r.path)) bad = 1;\r\n\u001b[?2004l\r"]
[66.424904, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[66.424949, "o", "\u001b[?2004h> "]
[66.424994, "o", "    fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.425037, "o", "> "]
[66.425079, "o", "    return bad;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[66.425127, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.425172, "o", "\u001b[?2004h> "]
[66.425222, "o", "int n_miss(void) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.425312, "o", "    return dumps_ok() || atlas_ok();\r\n\u001b[?2004l\r"]
[66.425364, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.425415, "o", "EOF\r\n\u001b[?2004l\r"]
