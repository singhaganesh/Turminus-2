[28.814283, "i", "sed -n '1,180p' /app/tblkit/token.c; echo '--- delta.lst ---'; cat /app/touchbay/delta.lst\n"]
[28.815418, "o", "sed -n '1,180p' /app/tblkit/token.c; echo '--- delta.lst ---'; cat /app/touchbay/delta.lst\r\n\u001b[?2004l\r"]
[28.827766, "o", "#include \"token.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\nint file_here(const char *path) {\r\n    struct stat st;\r\n    return path && path[0] && stat(path, &st) == 0 && S_ISREG(st.st_mode);\r\n}\r\n\r\nstatic int is_c_name(const char *n) {\r\n    size_t L = strlen(n);\r\n    return L > 2 && n[L - 2] == '.' && n[L - 1] == 'c';\r\n}\r\n\r\nstatic void walk_rec(const char *dir, char paths[][PATH_MAX_X], int *n, int max) {\r\n    DIR *d = opendir(dir);\r\n    if (!d) return;\r\n    struct dirent *ent;\r\n    while ((ent = readdir(d)) != NULL && *n < max) {\r\n        if (ent->d_name[0] == '.') continue;\r\n        char sub[PATH_MAX_X];\r\n        snprintf(sub, sizeof sub, \"%s/%s\", dir, ent->d_name);\r\n        struct stat st;\r\n        if (stat(sub, &st) != 0) continue;\r\n        if (S_ISDIR(st.st_mode)) walk_rec(sub, paths, n, max);\r\n        else if (S_ISREG(st.st_mode) && is_c_name(ent->d_name)) {\r\n            snprintf(paths[*n], PATH_MAX_X, \"%s\", sub);\r\n            (*n)++;\r\n        }\r\n    }\r\n    closedir(d);\r\n}\r\n\r\nint walk_units(const char *root, char paths[][PATH_MAX_X], int max) {\r\n    int n = 0;\r\n    walk_rec(root, paths, &n, max);\r\n    return n;\r\n}\r\n\r\nint parse_unit(const char *path, Row *rows, int max) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return 0;\r\n    char line[512];\r\n    int lineno = 0, n = 0, open_lo = 0;\r\n    char cur[NAME_MAX];\r\n    cur[0] = 0;\r\n    while (fgets(line, sizeof line, f)) {\r\n        lineno++;\r\n        char nm[NAME_MAX];\r\n        if (sscanf(line, \"void %63[A-Za-z0-9_](\", nm) == 1) {\r\n            snprintf(cur, sizeof cur, \"%s\", nm);\r\n            open_lo = lineno;\r\n        } else if (cur[0] && (strcmp(line, \"}\\n\") == 0 || strcmp(line, \"}\\r\\n\") == 0 || strcmp(line, \"}\") == 0)) {\r\n            if (n < max) {\r\n                snprintf(rows[n].name, NAME_MAX, \"%s\", cur);\r\n                snprintf(rows[n].path, PATH_MAX_X, \"%s\", path);\r\n                rows[n].lo = open_lo;\r\n                rows[n].hi = lineno;\r\n                n++;\r\n            }\r\n            cur[0] = 0;\r\n        }\r\n    }\r\n    fclose(f);\r\n    return n;\r\n}\r\n\r\nint parse_lot(const char *path, char *name, char *orig, int *line) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return -1;\r\n    char hdr[64];\r\n    if (!fgets(hdr, sizeof hdr, f)) { fclose(f); return -1; }\r\n    if (strncmp(hdr, \"DUMP1\", 5) != 0) { fclose(f); return -1; }\r\n    char rest[512];\r\n    if (!fgets(rest, sizeof rest, f)) { fclose(f); return -1; }\r\n    fclose(f);\r\n    if (sscanf(rest, \"%63s %255s %d\", name, orig, line) != 3) return -1;\r\n    return 0;\r\n}\r\n\r\nint load_tbl(const char *path, Row *rows, int max) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return 0;\r\n    char line[512];\r\n    if (!fgets(line, sizeof line, f)) { fclose(f); return 0; }\r\n    int n = 0;\r\n    while (fgets(line, sizeof line, f) && n < max) {\r\n        if (sscanf(line, \"%63s %255s %d %d\", rows[n].name, rows[n].path, &rows[n].lo, &rows[n].hi) == 4)\r\n            n++;\r\n    }\r\n    fclose(f);\r\n    return n;\r\n}\r\n\r\nint save_tbl(const char *path, Row *rows, int n) {\r\n    FILE *f = fopen(path, \"w\");\r\n    if (!f) return -1;\r\n    fprintf(f, \"SPAN1\\n\");\r\n    for (int i = 0; i < n; i++)\r\n        fprintf(f, \"%s %s %d %d\\n\", rows[i].name, rows[i].path, rows[i].lo, rows[i].hi);\r\n    fclose(f);\r\n    return 0;\r\n}\r\n\r\nint extract_span(const char *path, int lo, int hi, char *out, int cap) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) { out[0] = 0; return -1; }\r\n    char line[512];\r\n    int lineno = 0, used = 0;\r\n    out[0] = 0;\r\n    while (fgets(line, sizeof line, f)) {\r\n        lineno++;\r\n        if (lineno < lo || lineno > hi) continue;\r\n        int L = (int)strlen(line);\r\n        if (used + L + 1 >= cap) break;\r\n        memcpy(out + used, line, L);\r\n        used += L;\r\n        out[used] = 0;\r\n    }\r\n    fclose(f);\r\n    return 0;\r\n}\r\n"]
[28.828494, "o", "--- delta.lst ---\r\n"]
[28.832348, "o", "/app/unitpit/gamma/shift.c\r\n"]
[28.832963, "o", "\u001b[?2004hroot@66898f2d7228:/app# "]
[66.407424, "i", "cat > /app/slitmill/scan.c <<'EOF'\n#include \"scan.h\"\n#include \"token.h\"\n#include \"gap.h\"\n#include <stdio.h>\n#include <sys/stat.h>\n\nint op_a(void) {\n    char paths[ROW_MAX][PATH_MAX_X];\n    Row rows[ROW_MAX];\n    int npath, n = 0;\n\n    mkdir(\"/app/inkwell\", 0755);\n    npath = walk_units(\"/app/unitpit\", paths, ROW_MAX);\n    for (int i = 0; i < npath; i++) {\n        int room = ROW_MAX - n;\n        int got;\n        if (room == 0) return 1;\n        got = parse_unit(paths[i], rows + n, room);\n        n += got;\n    }\n\n    if (save_tbl(\"/app/inkwell/span.atlas\", rows, n) != 0) return 1;\n    return n_miss() == 0 ? 0 : 1;\n}\nEOF\ncat > /app/cupeel/pick.c <<'EOF'\n#include \"pick.h\"\n#include \"token.h\"\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nint op_b(const char *p) {\n    char name[NAME_MAX], orig[PATH_MAX_X];\n    Row rows[ROW_MAX];\n    char body[8192];\n    int line = 0, n, idx = -1;\n\n    mkdir(\"/app/inkwell\", 0755);\n    if (parse_lot(p, name, orig, &line) != 0 || line < 1) return 2;\n    if (!file_here(orig)) return 1;\n\n    n = load_tbl(\"/app/inkwell/span.atlas\", rows, ROW_MAX);\n    if (n < 0) return 1;\n    for (int i = 0; i < n; i++) {\n        if (!file_here(rows[i].path)) return 1;\n        if (strcmp(rows[i].name, name) == 0 &&\n            strcmp(rows[i].path, orig) == 0 &&\n            line >= rows[i].lo && line <= rows[i].hi) {\n            idx = i;\n        }\n    }\n    if (idx < 0) return 1;\n    if (extract_span(orig, rows[idx].lo, rows[idx].hi, body, sizeof body) != 0)\n        return 1;\n\n    FILE *out = fopen(\"/app/inkwell/clip.out\", \"w\");\n    if (!out) return 1;\n    fprintf(out, \"CLIP %s\\n%s\", name, body);\n    if (fclose(out) != 0) return 1;\n    return 0;\n}\nEOF\ncat > /app/drygate/gap.c <<'EOF'\n#include \"gap.h\"\n#include \"token.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic int under_unitpit(const char *p) {\n    static const char root[] = \"/app/unitpit/\";\n    return strncmp(p, root, sizeof(root) - 1) == 0 && p[sizeof(root) - 1] != '\\0';\n}\n\nstatic int dumps_ok(void) {\n    DIR *d = opendir(\"/app/lotbay\");\n    struct dirent *ent;\n    int bad = 0;\n    if (!d) return 1;\n    while ((ent = readdir(d)) != NULL) {\n        char dump[PATH_MAX_X], name[NAME_MAX], orig[PATH_MAX_X];\n        int line;\n        if (ent->d_name[0] == '.') continue;\n        if (snprintf(dump, sizeof dump, \"/app/lotbay/%s\", ent->d_name) >= (int)sizeof dump) {\n            bad = 1;\n            continue;\n        }\n        if (parse_lot(dump, name, orig, &line) != 0 || line < 1 ||\n            !under_unitpit(orig) || !file_here(orig)) bad = 1;\n    }\n    closedir(d);\n    return bad;\n}\n\nstatic int atlas_ok(void) {\n    FILE *f = fopen(\"/app/inkwell/span.atlas\", \"r\");\n    char line[512], extra;\n    int bad = 0;\n    if (!f) return 1;\n    if (!fgets(line, sizeof line, f) ||\n        (strcmp(line, \"SPAN1\\n\") != 0 && strcmp(line, \"SPAN1\\r\\n\") != 0 && strcmp(line, \"SPAN1\") != 0)) {\n        fclose(f);\n        return 1;\n    }\n    while (fgets(line, sizeof line, f)) {\n        Row r;\n        if (sscanf(line, \"%63s %255s %d %d %c\", r.name, r.path, &r.lo, &r.hi, &extra) != 4 ||\n            r.lo < 1 || r.hi < r.lo || !under_unitpit(r.path) || !file_here(r.path)) bad = 1;\n    }\n    fclose(f);\n    return bad;\n}\n\nint n_miss(void) {\n    return dumps_ok() || atlas_ok();\n}\nEOF\nmake -f /app/tblkit/hull.mk hull\n"]
