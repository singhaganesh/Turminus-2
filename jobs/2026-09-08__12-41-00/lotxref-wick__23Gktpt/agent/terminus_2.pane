    28	        if (S_ISDIR(st.st_mode)) walk_rec(sub, paths, n, max);
    29	        else if (S_ISREG(st.st_mode) && is_c_name(ent->d_name)) {
    30	            snprintf(paths[*n], PATH_MAX_X, "%s", sub);
    31	            (*n)++;
    32	        }
    33	    }
    34	    closedir(d);
    35	}
