    43	int parse_unit(const char *path, Row *rows, int max) {
    44	    FILE *f = fopen(path, "r");
    45	    if (!f) return 0;
    46	    char line[512];
    47	    int lineno = 0, n = 0, open_lo = 0;
    48	    char cur[NAME_MAX];
    49	    cur[0] = 0;
    50	    while (fgets(line, sizeof line, f)) {
    51	        lineno++;
    52	        char nm[NAME_MAX];
    53	        if (sscanf(line, "void %63[A-Za-z0-9_](", nm) == 1) {
    54	            snprintf(cur, sizeof cur, "%s", nm);
    55	            open_lo = lineno;
    56	        } else if (cur[0] && (strcmp(line, "}\n") == 0 || strcmp(line, "}\r\n") == 0 || strcmp(line, "}") == 0)) {
    57	            if (n < max) {
    58	                snprintf(rows[n].name, NAME_MAX, "%s", cur);
    59	                snprintf(rows[n].path, PATH_MAX_X, "%s", path);
    60	                rows[n].lo = open_lo;
    61	                rows[n].hi = lineno;
    62	                n++;
    63	            }
    64	            cur[0] = 0;
    65	        }
    66	    }
    67	    fclose(f);
    68	    return n;
    69	}
    70	
    71	int parse_lot(const char *path, char *name, char *orig, int *line) {
    72	    FILE *f = fopen(path, "r");
    73	    if (!f) return -1;
    74	    char hdr[64];
    75	    if (!fgets(hdr, sizeof hdr, f)) { fclose(f); return -1; }
    76	    if (strncmp(hdr, "DUMP1", 5) != 0) { fclose(f); return -1; }
    77	    char rest[512];
    78	    if (!fgets(rest, sizeof rest, f)) { fclose(f); return -1; }
    79	    fclose(f);
    80	    if (sscanf(rest, "%63s %255s %d", name, orig, line) != 3) return -1;
    81	    return 0;
    82	}
    83	
    84	int load_tbl(const char *path, Row *rows, int max) {
    85	    FILE *f = fopen(path, "r");
    86	    if (!f) return 0;
    87	    char line[512];
    88	    if (!fgets(line, sizeof line, f)) { fclose(f); return 0; }
    89	    int n = 0;
    90	    while (fgets(line, sizeof line, f) && n < max) {
    91	        if (sscanf(line, "%63s %255s %d %d", rows[n].name, rows[n].path, &rows[n].lo, &rows[n].hi) == 4)
    92	            n++;
    93	    }
    94	    fclose(f);
    95	    return n;
    96	}
    97	
    98	int save_tbl(const char *path, Row *rows, int n) {
    99	    FILE *f = fopen(path, "w");
   100	    if (!f) return -1;
   101	    fprintf(f, "SPAN1\n");
   102	    for (int i = 0; i < n; i++)
   103	        fprintf(f, "%s %s %d %d\n", rows[i].name, rows[i].path, rows[i].lo, rows[i].hi);
   104	    fclose(f);
   105	    return 0;
   106	}
   107	
   108	int extract_span(const char *path, int lo, int hi, char *out, int cap) {
   109	    FILE *f = fopen(path, "r");
   110	    if (!f) { out[0] = 0; return -1; }
   111	    char line[512];
   112	    int lineno = 0, used = 0;
   113	    out[0] = 0;
   114	    while (fgets(line, sizeof line, f)) {
   115	        lineno++;
   116	        if (lineno < lo || lineno > hi) continue;
   117	        int L = (int)strlen(line);
   118	        if (used + L + 1 >= cap) break;
   119	        memcpy(out + used, line, L);
   120	        used += L;
   121	        out[used] = 0;
   122	    }
   123	    fclose(f);
   124	    return 0;
   125	}
