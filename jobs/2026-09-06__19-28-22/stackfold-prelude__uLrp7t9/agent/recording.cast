[148.333667, "o", "\u001b[?2004hroot@070b131be943:/app# nl -ba /app/symmill/Makefile | sed -n '10,34p'; make -C /app/symmill -n emitmap\r\n\u001b[?2004l\r    10\tSAMPLES := /app/benchframes/bench.samples\r\n    11\t\r\n    12\tinclude mk/foldlink.dep\r\n    13\t\r\n    14\t.PHONY: emitmap emitmap.gate clean hull\r\n    15\t\r\n    16\t# emitmap rebuilds runtime.symmap + profile.json from the current fold rule\r\n    17\thull: $(TARGET)\r\n    18\t\r\n    19\temitmap: $(PROFILE)\r\n    20\t\t@:\r\n    21\t\r\n    22\t$(TARGET): $(OBJS)\r\n    23\t\t@mkdir -p fold\r\n    24\t\t$(CC) $(LDFLAGS) -o $@ $(OBJS)\r\n    25\t\r\n    26\t$(PROFILE): $(SYMAP) $(SAMPLES)\r\n    27\t\t$(PCFOLD) render $(SAMPLES) $(SYMAP) -o $(PROFILE)\r\n    28\t\r\n    29\tclean:\r\n    30\t\trm -f $(OBJS) $(TARGET) $(SYMAP) $(PROFILE)\r\n    31\t\r\n    32\tsrc/%.o: src/%.c\r\n    33\t\t$(CC) $(CFLAGS) -c -o $@ $<\r\n"]
