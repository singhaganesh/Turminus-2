[24.916313, "o", "for f in /app/pcfold/include/pcfold.h /app/pcfold/src/main.c /app/pcfold/src/index.c /app/pcfold/src/elfutil.c /app/pcfold/src/parity.c /app/pcfold/src/render.c; do echo \"--- $f ---\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[24.916966, "o", "--- /app/pcfold/include/pcfold.h ---\r\n"]
[24.91805, "o", "     1\t#ifndef PCFOLD_H\r\n     2\t#define PCFOLD_H\r\n     3\t\r\n     4\t#include <stddef.h>\r\n     5\t\r\n     6\t#define SF_MAGIC \"PCFOLD1\"\r\n     7\t\r\n     8\ttypedef struct {\r\n     9\t    char name[128];\r\n    10\t    unsigned long start;\r\n    11\t    unsigned long size;\r\n    12\t} sf_sym_t;\r\n    13\t\r\n    14\tint sf_read_build_id(const char *elf_path, char *out, size_t out_len);\r\n    15\tint sf_index_linked(const char *elf_path, const char *out_path);\r\n    16\tint sf_index_objects(const char **obj_paths, int obj_count, const char *out_path);\r\n    17\tint sf_check(const char *elf_path, const char *symmap_path);\r\n    18\tint sf_render(const char *samples_path, const char *symmap_path, const char *out_path);\r\n    19\t\r\n"]
[24.918102, "o", "    20\t#endif\r\n"]
[24.918726, "o", "--- /app/pcfold/src/main.c ---\r\n"]
[24.920104, "o", "     1\t#include \"pcfold.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic int usage(const char *argv0)\r\n     8\t{\r\n     9\t    fprintf(stderr, \"usage: %s index --linked <elf> -o <symmap>\\n\", argv0);\r\n    10\t    fprintf(stderr, \"       %s index --objects <o>... -o <symmap>\\n\", argv0);\r\n    11\t    fprintf(stderr, \"       %s check <elf> <symmap>\\n\", argv0);\r\n    12\t"]
[24.920373, "o", "    fprintf(stderr, \"       %s render <samples> <symmap> -o <profile>\\n\", argv0);\r\n    13\t    return 1;\r\n    14\t}\r\n    15\t\r\n    16\tint main(int argc, char **argv)\r\n    17\t{\r\n    18\t    if (argc < 2) {\r\n    19\t        return usage(argv[0]);\r\n    20\t    }\r\n    21\t    if (strcmp(argv[1], \"index\") == 0) {\r\n    22\t        const char *out = NULL;\r\n    23\t        if (argc >= 4 && strcmp(argv[2], \"--linked\") == 0) {\r\n    24\t            for (int i = 4; i < argc; i++) {\r\n    25\t                if (strcmp(argv[i], \"-o\") == 0 && i + 1 < argc) {\r\n    26\t                    out = argv[i + 1];\r\n    27\t                }\r\n    28\t            }\r\n    29\t            if (!out) {\r\n    30\t                return usage(argv[0]);\r\n    31\t            }\r\n    32\t            return sf_index_linked(argv[3], out) == 0 ? 0 : 1;\r\n    33\t        }\r\n    34\t        if (argc >= 4 && strcmp(argv[2], \"--objects\") == 0) {\r\n    35\t            const char **objs = NULL;\r\n    36\t            int obj_count = 0;\r\n    37\t            for (int i = 3; i < argc; i++) {\r\n    38\t                if (strcmp(argv[i], \"-o\") == 0) {\r\n    39\t                    out = argv[i + 1];\r\n    40\t                    break;\r\n    41\t                }\r\n    42\t                obj_count++;\r\n    43\t            }\r\n    44\t            if (!out || obj_count == 0) {\r\n    45\t                return usage(argv[0]);\r\n    46\t            }\r\n    47\t            objs = calloc((size_t)obj_count, sizeof(char *));\r\n    48\t            int idx = 0;\r\n    49\t            for (int i = 3; i < argc; i++) {\r\n    50\t                if (strcmp(argv[i], \"-o\") == 0) {\r\n    51\t                    break;\r\n    52\t                }\r\n    53\t                objs[idx++] = argv[i];\r\n    54\t            }\r\n    55\t            int rc = sf_index_objects(objs, obj_count, out);\r\n    56\t            free(objs);\r\n    57\t            return rc == 0 ? 0 : 1;\r\n    58\t        }\r\n    59\t        return usage(argv[0]);\r\n    60\t    }\r\n    61\t    if (strcmp(argv[1], \"check\") == 0 && argc == 4) {\r\n    62\t        return sf_check(argv[2], argv[3]);\r\n    63\t    }\r\n    64\t    if (strcmp(argv[1], \"render\") == 0 && argc >= 5) {\r\n    65\t        const char *out = NULL;\r\n    66\t        for (int i = 4; i < argc; i++) {\r\n    67\t            if (strcmp(argv[i], \"-o\") == 0 && i + 1 < argc) {\r\n    68\t                out = argv[i + 1];\r\n    69\t            }\r\n    70\t        }\r\n    71\t        if (!out) {\r\n    72\t            return usage(argv[0]);\r\n    73\t        }\r\n    74\t        return sf_render(argv[2], argv[3], out) == 0 ? 0 : 1;\r\n    75\t    }\r\n    76\t    return usage(argv[0]);\r\n    77\t}\r\n"]
