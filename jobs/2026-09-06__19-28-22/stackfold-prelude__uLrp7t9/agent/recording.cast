app/symmill/fold/runtime | awk '$3==\"ring_dispatch\"{print $1}')\r\n/app/symmill/scripts/seed_samples.sh:5:legacy=$(nm -n --defined-only /app/symmill/fold/runtime | awk '$3==\"legacy_worker\"{print $1}')\r\n/app/symmill/scripts/seed_samples.sh:6:buildid=$(readelf -n /app/symmill/fold/runtime | awk '/Build ID:/{print $3; exit}')\r\n/app/symmill/scripts/seed_samples.sh:7:printf 'ring_dispatch 0x%s\\nlegacy_worker 0x%s\\n' \"$ring\" \"$legacy\" > /app/benchframes/anchor/symbols.tab\r\n/app/symmill/scripts/seed_samples.sh:8:printf '%s\\n' \"$buildid\" > /app/benchframes/anchor/buildid.stamp\r\n/app/benchframes/anchor/symbols.tab:1:ring_dispatch 0x0000000000401160\r\n/app/benchframes/anchor/symbols.tab:2:legacy_worker 0x0000000000401140\r\n/app/pcfold/include/pcfold.h:6:#define SF_MAGIC \"PCFOLD1\"\r\n/app/pcfold/include/pcfold.h:17:int sf_check(const char *elf_path, const char *symmap_path);\r\n/app/pcfold/include/pcfold.h:18:int sf_render(const char *samples_path, const char *symmap_path, const char *out_path);\r\n/app/pcfold/src/main.c:9:    fprintf(stderr, \"usage: %s index --linked <elf> -o <symmap>\\n\", argv0);\r\n/app/pcfold/src/main.c:10:    fprintf(stderr, \"       %s index --objects <o>... -o <symmap>\\n\", argv0);\r\n/app/pcfold/src/main.c:11:    fprintf(stderr, \"       %s check <elf> <symmap>\\n\", argv0);\r\n/app/pcfold/src/main.c:12:    fprintf(stderr, \"       %s render <samples> <symmap> -o <profile>\\n\", argv0);\r\n/app/pcfold/src/parity.c:38:        } else if (strncmp(line, \"buildid \", 8) == 0) {\r\n/app/pcfold/src/parity.c:39:            sscanf(line, \"buildid %127s\", map->build_id);\r\n/app/pcfold/src/parity.c:92:int sf_check(const char *elf_path, const char *symmap_path)\r\n/app/pcfold/src/parity.c:98:    if (load_map(symmap_path, &map) != 0) {\r\n/app/pcfold/src/index.c:9:static int write_symmap(\r\n/app/pcfold/src/index.c:23:    fprintf(fp, \"buildid %s\\n\", build_id);\r\n/app/pcfold/src/index.c:49:    int rc = write_symmap(out_path, \"linked\", build_id, \"pcfold-index-linked\", syms, count);\r\n/app/pcfold/src/index.c:101:    int rc = write_symmap(out_path, \"objects\", \"object-merge\", NULL, syms, count);\r\n/app/pcfold/src/render.c:77:int sf_render(const c"]
