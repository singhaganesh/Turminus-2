[24.608261, "o", "--- symmill Makefile ---\r\n"]
[24.610579, "o", "     1\tCC ?= gcc\r\n     2\tCFLAGS ?= -O2 -Wall -Wextra -fPIC\r\n     3\tLDFLAGS ?= -Wl,--build-id\r\n     4\tSRC := src/core.c src/worker.c src/dispatch_ring.c\r\n     5\tOBJS := $(SRC:.c=.o)\r\n     6\tTARGET := fold/runtime\r\n     7\tSYMAP := fold/runtime.symmap\r\n     8\tPROFILE := fold/profile.json\r\n     9\tPCFOLD := /app/bin/pcfold\r\n    10\tSAMPLES := /app/benchframes/bench.samples\r\n    11\t\r\n    12\tinclude mk/foldlink.dep\r\n    13\t\r\n    14\t.PHONY: emitmap clean hull\r\n    15\t\r\n    16\t# emitmap rebuilds runtime.symmap + profile.json from the current fold rule\r\n    17\thull: $(TARGET)\r\n    18\t\r\n"]
[24.610948, "o", "    19\temitmap: $(PROFILE)\r\n    20\t\t@:\r\n    21\t\r\n    22\t$(TARGET): $(OBJS)\r\n    23\t\t@mkdir -p fold\r\n    24\t\t$(CC) $(LDFLAGS) -o $@ $(OBJS)\r\n    25\t\r\n    26\t$(PROFILE): $(SYMAP) $(SAMPLES)\r\n    27\t\t$(PCFOLD) render $(SAMPLES) $(SYMAP) -o $(PROFILE)\r\n    28\t\r\n    29\tclean:\r\n    30\t\trm -f $(OBJS) $(TARGET) $(SYMAP) $(PROFILE)\r\n    31\t\r\n    32\tsrc/%.o: src/%.c\r\n    33\t\t$(CC) $(CFLAGS) -c -o $@ $<\r\n"]
[24.611222, "o", "--- foldlink.dep ---\r\n"]
[24.612898, "o", "$(SYMAP): $(OBJS)\r\n\t@mkdir -p fold\r\n\t$(PCFOLD) index --objects $(OBJS) -o $(SYMAP)\r\n"]
[24.61321, "o", "--- pcfold Makefile/config/notes ---\r\n"]
[24.614536, "o", "     1\tCC ?= gcc\r\n     2\tCFLAGS ?= -O2 -Wall -Wextra -Iinclude\r\n     3\tSRC := src/main.c src/index.c src/parity.c src/render.c src/elfutil.c\r\n     4\tBIN := /app/bin/pcfold\r\n     5\t\r\n     6\t.PHONY: hull\r\n     7\thull:\r\n     8\t\tmkdir -p /app/bin\r\n     9\t\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[24.615904, "o", "index_mode=objects\r\n"]
[24.616202, "o", "FOLD_LATCH off\r\npcfold index/render/check tool sources.\r\n"]
