[12.135857, "o", "printf '%s\\n' '--- pcfold ---'; file /app/bin/pcfold; readlink -f /app/bin/pcfold; grep -RInE 'PCFOLD1|symmap|buildid|ring_dispatch|legacy_worker' /app --exclude='runtime.symmap' --exclude='profile.json' 2>/dev/null | head -240"]
