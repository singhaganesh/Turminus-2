[111.127337, "i", "cp /app/symmill/fold/runtime.symmap /tmp/drift.symmap; sed -i 's/^buildid .*/buildid deadbeef/' /tmp/drift.symmap; /app/bin/pcfold check /app/symmill/fold/runtime /tmp/drift.symmap; rc=$?; echo drift_check_rc=$rc; test \"$rc\" -ne 0\npython3 - <<'PY'\nimport json, subprocess, tempfile\nsm='/app/symmill/fold/runtime.symmap'; elf='/app/symmill/fold/runtime'\nlines=open(sm).read().splitlines()\nassert lines[0]=='PCFOLD1'\nassert 'mode linked' in lines\nassert 'origin pcfold-index-linked' in lines\nbid=next(x.split()[1] for x in lines if x.startswith('buildid '))\nlive=subprocess.check_output(['readelf','-n',elf],text=True).split('Build ID:',1)[1].split()[0]\nassert len(bid)>=8 and bid==live\nm=[]\nfor line in lines:\n    f=line.split()\n    if f[:1]==['sym']: m.append((f[1],int(f[2],16),int(f[3],16)))\nnm=[]\nfor line in subprocess.check_output(['nm','-n','--defined-only',elf],text=True).splitlines():\n    f=line.split()\n    if len(f)==3 and f[1] in ('T','t'): nm.append((f[2],int(f[0],16)))\nexpected=[(name,addr,nm[i+1][1]-addr if i+1<len(nm) else 64) for i,(name,addr) in enumerate(nm)]\nassert m==expected and len(m)>=8\np=json.load(open('/app/symmill/fold/profile.json'))\nassert [(x['symbol'],x['offset']) for x in p['frames']]==[('ring_dispatch',8),('legacy_worker',4)],p\n# Exercise symbol starts, final bytes, and the boundary between the two named functions.\nchosen=[x for x in m if x[0] in ('legacy_worker','ring_dispatch')]\nwith open('/tmp/held.samples','w') as f:\n    for name,start,size in chosen:\n        f.write(f'pc 0x{start:x}\\npc 0x{start+size-1:x}\\n')\nsubprocess.check_call(['/app/bin/pcfold','render','/tmp/held.samples',sm,'-o','/tmp/held.json'])\nh=json.load(open('/tmp/held.json'))['frames']\nwant=[]\nfor name,start,size in chosen: want += [(name,0),(name,size-1)]\nassert [(x['symbol'],x['offset']) for x in h]==want,(h,want)\nprint('validated build ID,',len(m),'exact linked spans, profile, and boundary rendering')\nPY\n"]
