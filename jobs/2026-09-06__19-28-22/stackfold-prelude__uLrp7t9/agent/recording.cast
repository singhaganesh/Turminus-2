[44.813541, "o", "    45\t        out[n] = '\\0';\r\n    46\t        pclose(fp);\r\n    47\t        return n > 0 ? 0 : -1;\r\n    48\t    }\r\n    49\t    pclose(fp);\r\n    50\t    return -1;\r\n    51\t}\r\n    52\t\r\n    53\tint sf_collect_elf_symbols(const char *elf_path, sf_sym_t **out_syms, int *out_count)\r\n    54\t{\r\n    55\t    char cmd[512];\r\n    56\t    snprintf(cmd, sizeof(cmd), \"nm -n --defined-only '%s' 2>/dev/null\", elf_path);\r\n    57\t    FILE *fp = popen(cmd, \"r\");\r\n    58\t    if (!fp) {\r\n    59\t        return -1;\r\n    60\t    }\r\n    61\t    sf_sym_t *buf = NULL;\r\n    62\t    int cap = 0;\r\n    63\t    int count = 0;\r\n    64\t    char line[512];\r\n    65\t    while (fgets(line, sizeof(line), fp)) {\r\n    66\t        unsigned long addr = 0;\r\n    67\t        char type = 0;\r\n    68\t        char name[128] = {0};\r\n    69\t        if (sscanf(line, \"%lx %c %127s\", &addr, &type, name) != 3) {\r\n    70\t            continue;\r\n    71\t        }\r\n    72\t        if (type != 'T' && type != 't') {\r\n    73\t            continue;\r\n    74\t        }\r\n    75\t        if (count >= cap) {\r\n    76\t            cap = cap ? cap * 2 : 32;\r\n    77\t            sf_sym_t *next = realloc(buf, (size_t)cap * sizeof(sf_sym_t));\r\n    78\t            if (!next) {\r\n    79\t                free(buf);\r\n    80\t                pclose(fp);\r\n    81\t                return -1;\r\n    82\t            }\r\n    83\t            buf = next;\r\n    84\t        }\r\n    85\t        strncpy(buf[count].name, name, sizeof(buf[count].name) - 1);\r\n    86\t        buf[count].start = addr;\r\n    87\t        buf[count].size = 0;\r\n    88\t        count++;\r\n    89\t    }\r\n    90\t    pclose(fp);\r\n    91\t    for (int i = 0; i < count; i++) {\r\n    92\t        unsigned long end = (i + 1 < count) ? buf[i + 1].start : buf[i].start + 64;\r\n    93\t        if (end > buf[i].start) {\r\n    94\t            buf[i].size = end - buf[i].start;\r\n    95\t        } else {\r\n    96\t            buf[i].size = 64;\r\n    97\t        }\r\n    98\t    }\r\n    99\t    *out_syms = buf;\r\n   100\t    *out_count = count;\r\n   101\t    return 0;\r\n   102\t}\r\n"]
