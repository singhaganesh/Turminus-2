    48	
    49	static int resolve_pc(const sf_map_ro_t *map, unsigned long pc, char *sym_out, unsigned long *off_out)
    50	{
    51	    const sf_sym_t *best = NULL;
    52	    for (int i = 0; i < map->count; i++) {
    53	        const sf_sym_t *s = &map->syms[i];
    54	        if (pc >= s->start && pc < s->start + s->size) {
    55	            if (!best || s->start > best->start) {
    56	                best = s;
    57	            }
    58	        }
    59	    }
    60	    if (!best) {
    61	        for (int i = 0; i < map->count; i++) {
    62	            const sf_sym_t *s = &map->syms[i];
    63	            if (!best || s->start < best->start) {
    64	                best = s;
    65	            }
    66	        }
    67	    }
    68	    if (!best) {
    69	        return -1;
    70	    }
    71	    strncpy(sym_out, best->name, 127);
    72	    sym_out[127] = '\0';
    73	    *off_out = pc - best->start;
    74	    return 0;
    75	}
