     1	#include "pcfold.h"
     2	
     3	#include <ctype.h>
     4	#include <stdio.h>
     5	#include <stdlib.h>
     6	#include <string.h>
     7	
     8	static int hex_nibble(char c)
     9	{
    10	    if (c >= '0' && c <= '9') {
    11	        return c - '0';
    12	    }
    13	    if (c >= 'a' && c <= 'f') {
    14	        return 10 + (c - 'a');
    15	    }
    16	    if (c >= 'A' && c <= 'F') {
    17	        return 10 + (c - 'A');
    18	    }
    19	    return -1;
    20	}
    21	
    22	int sf_read_build_id(const char *elf_path, char *out, size_t out_len)
    23	{
    24	    char cmd[512];
    25	    snprintf(cmd, sizeof(cmd), "readelf -n '%s' 2>/dev/null", elf_path);
    26	    FILE *fp = popen(cmd, "r");
    27	    if (!fp) {
    28	        return -1;
    29	    }
    30	    char line[512];
    31	    while (fgets(line, sizeof(line), fp)) {
    32	        char *p = strstr(line, "Build ID:");
    33	        if (!p) {
    34	            continue;
    35	        }
    36	        p += 9;
    37	        while (*p && isspace((unsigned char)*p)) {
    38	            p++;
    39	        }
    40	        size_t n = 0;
    41	        while (p[n] && !isspace((unsigned char)p[n]) && n + 1 < out_len) {
    42	            out[n] = p[n];
    43	            n++;
    44	        }
    45	        out[n] = '\0';
    46	        pclose(fp);
    47	        return n > 0 ? 0 : -1;
    48	    }
    49	    pclose(fp);
    50	    return -1;
    51	}
    52	
    53	int sf_collect_elf_symbols(const char *elf_path, sf_sym_t **out_syms, int *out_count)
    54	{
    55	    char cmd[512];
    56	    snprintf(cmd, sizeof(cmd), "nm -n --defined-only '%s' 2>/dev/null", elf_path);
    57	    FILE *fp = popen(cmd, "r");
    58	    if (!fp) {
    59	        return -1;
    60	    }
    61	    sf_sym_t *buf = NULL;
    62	    int cap = 0;
    63	    int count = 0;
    64	    char line[512];
    65	    while (fgets(line, sizeof(line), fp)) {
    66	        unsigned long addr = 0;
    67	        char type = 0;
    68	        char name[128] = {0};
    69	        if (sscanf(line, "%lx %c %127s", &addr, &type, name) != 3) {
    70	            continue;
    71	        }
    72	        if (type != 'T' && type != 't') {
    73	            continue;
    74	        }
    75	        if (count >= cap) {
    76	            cap = cap ? cap * 2 : 32;
    77	            sf_sym_t *next = realloc(buf, (size_t)cap * sizeof(sf_sym_t));
    78	            if (!next) {
    79	                free(buf);
    80	                pclose(fp);
    81	                return -1;
    82	            }
    83	            buf = next;
    84	        }
    85	        strncpy(buf[count].name, name, sizeof(buf[count].name) - 1);
    86	        buf[count].start = addr;
    87	        buf[count].size = 0;
    88	        count++;
    89	    }
    90	    pclose(fp);
    91	    for (int i = 0; i < count; i++) {
    92	        unsigned long end = (i + 1 < count) ? buf[i + 1].start : buf[i].start + 64;
    93	        if (end > buf[i].start) {
    94	            buf[i].size = end - buf[i].start;
    95	        } else {
    96	            buf[i].size = 64;
    97	        }
    98	    }
    99	    *out_syms = buf;
   100	    *out_count = count;
   101	    return 0;
   102	}
