     6	
     7	static int usage(const char *argv0)
     8	{
     9	    fprintf(stderr, "usage: %s index --linked <elf> -o <symmap>\n", argv0);
    10	    fprintf(stderr, "       %s index --objects <o>... -o <symmap>\n", argv0);
    11	    fprintf(stderr, "       %s check <elf> <symmap>\n", argv0);
    12	    fprintf(stderr, "       %s render <samples> <symmap> -o <profile>\n", argv0);
    13	    return 1;
    14	}
    15	
    16	int main(int argc, char **argv)
    17	{
    18	    if (argc < 2) {
    19	        return usage(argv[0]);
    20	    }
    21	    if (strcmp(argv[1], "index") == 0) {
    22	        const char *out = NULL;
    23	        if (argc >= 4 && strcmp(argv[2], "--linked") == 0) {
    24	            for (int i = 4; i < argc; i++) {
    25	                if (strcmp(argv[i], "-o") == 0 && i + 1 < argc) {
    26	                    out = argv[i + 1];
    27	                }
    28	            }
    29	            if (!out) {
    30	                return usage(argv[0]);
    31	            }
    32	            return sf_index_linked(argv[3], out) == 0 ? 0 : 1;
    33	        }
    34	        if (argc >= 4 && strcmp(argv[2], "--objects") == 0) {
    35	            const char **objs = NULL;
    36	            int obj_count = 0;
    37	            for (int i = 3; i < argc; i++) {
    38	                if (strcmp(argv[i], "-o") == 0) {
    39	                    out = argv[i + 1];
    40	                    break;
    41	                }
    42	                obj_count++;
    43	            }
    44	            if (!out || obj_count == 0) {
    45	                return usage(argv[0]);
    46	            }
    47	            objs = calloc((size_t)obj_count, sizeof(char *));
    48	            int idx = 0;
    49	            for (int i = 3; i < argc; i++) {
    50	                if (strcmp(argv[i], "-o") == 0) {
    51	                    break;
    52	                }
    53	                objs[idx++] = argv[i];
    54	            }
    55	            int rc = sf_index_objects(objs, obj_count, out);
    56	            free(objs);
    57	            return rc == 0 ? 0 : 1;
    58	        }
    59	        return usage(argv[0]);
    60	    }
    61	    if (strcmp(argv[1], "check") == 0 && argc == 4) {
    62	        return sf_check(argv[2], argv[3]);
    63	    }
    64	    if (strcmp(argv[1], "render") == 0 && argc >= 5) {
    65	        const char *out = NULL;
    66	        for (int i = 4; i < argc; i++) {
    67	            if (strcmp(argv[i], "-o") == 0 && i + 1 < argc) {
    68	                out = argv[i + 1];
    69	            }
    70	        }
    71	        if (!out) {
    72	            return usage(argv[0]);
    73	        }
    74	        return sf_render(argv[2], argv[3], out) == 0 ? 0 : 1;
    75	    }
    76	    return usage(argv[0]);
    77	}
--- /app/pcfold/src/index.c ---
     1	#include "pcfold.h"
     2	
     3	#include <stdio.h>
     4	#include <stdlib.h>
     5	#include <string.h>
     6	
     7	extern int sf_collect_elf_symbols(const char *elf_path, sf_sym_t **out_syms, int *out_count);
     8	
     9	static int write_symmap(
    10	    const char *out_path,
    11	    const char *mode,
    12	    const char *build_id,
    13	    const char *origin,
    14	    sf_sym_t *syms,
    15	    int count)
    16	{
    17	    FILE *fp = fopen(out_path, "w");
    18	    if (!fp) {
    19	        return -1;
    20	    }
    21	    fprintf(fp, "%s\n", SF_MAGIC);
    22	    fprintf(fp, "mode %s\n", mode);
    23	    fprintf(fp, "buildid %s\n", build_id);
    24	    if (origin && origin[0] != '\0') {
    25	        fprintf(fp, "origin %s\n", origin);
    26	    }
    27	    for (int i = 0; i < count; i++) {
    28	        fprintf(fp, "sym %s 0x%lx 0x%lx\n", syms[i].name, syms[i].start, syms[i].size);
    29	    }
    30	    fclose(fp);
    31	    return 0;
    32	}
    33	
    34	int sf_index_linked(const char *elf_path, const char *out_path)
    35	{
    36	    char build_id[128] = {0};
    37	    if (sf_read_build_id(elf_path, build_id, sizeof(build_id)) != 0) {
    38	        strcpy(build_id, "unknown");
    39	    }
    40	    sf_sym_t *syms = NULL;
    41	    int count = 0;
    42	    if (sf_collect_elf_symbols(elf_path, &syms, &count) != 0 || count == 0) {
    43	        free(syms);
    44	        return -1;
    45	    }
    46	    for (int i = 0; i < count; i++) {
    47	        syms[i].size = 0x40;
    48	    }
    49	    int rc = write_symmap(out_path, "linked", build_id, "pcfold-index-linked", syms, count);
    50	    free(syms);
    51	    return rc;
    52	}
    53	
    54	static int collect_object_symbols(const char *obj_path, sf_sym_t **acc, int *acc_count)
    55	{
    56	    char cmd[512];
    57	    snprintf(cmd, sizeof(cmd), "nm -n --defined-only '%s' 2>/dev/null", obj_path);
    58	    FILE *fp = popen(cmd, "r");
    59	    if (!fp) {
    60	        return -1;
    61	    }
    62	    unsigned long cursor = 0x1000UL + (unsigned long)(*acc_count) * 0x200UL;
    63	    char line[512];
    64	    while (fgets(line, sizeof(line), fp)) {
    65	        unsigned long addr = 0;
    66	        char type = 0;
    67	        char name[128] = {0};
    68	        if (sscanf(line, "%lx %c %127s", &addr, &type, name) != 3
    69	            && sscanf(line, " %c %127s", &type, name) != 2) {
    70	            continue;
    71	        }
    72	        if (type != 'T' && type != 't') {
    73	            continue;
    74	        }
    75	        sf_sym_t *next = realloc(*acc, (size_t)(*acc_count + 1) * sizeof(sf_sym_t));
    76	        if (!next) {
    77	            pclose(fp);
    78	            return -1;
    79	        }
    80	        *acc = next;
    81	        strncpy((*acc)[*acc_count].name, name, sizeof((*acc)[*acc_count].name) - 1);
    82	        (*acc)[*acc_count].start = cursor;
    83	        (*acc)[*acc_count].size = 0x40;
    84	        cursor += 0x40;
    85	        (*acc_count)++;
    86	    }
    87	    pclose(fp);
    88	    return 0;
    89	}
    90	
    91	int sf_index_objects(const char **obj_paths, int obj_count, const char *out_path)
    92	{
    93	    sf_sym_t *syms = NULL;
    94	    int count = 0;
    95	    for (int i = 0; i < obj_count; i++) {
    96	        if (collect_object_symbols(obj_paths[i], &syms, &count) != 0) {
    97	            free(syms);
    98	            return -1;
    99	        }
   100	    }
   101	    int rc = write_symmap(out_path, "objects", "object-merge", NULL, syms, count);
   102	    free(syms);
   103	    return rc;
   104	}
