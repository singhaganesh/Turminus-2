    11	    char build_id[128];
    12	    sf_sym_t *syms;
    13	    int count;
    14	} sf_map_t;
    15	
    16	static void free_map(sf_map_t *map)
    17	{
    18	    free(map->syms);
    19	    map->syms = NULL;
    20	    map->count = 0;
    21	}
    22	
    23	static int load_map(const char *path, sf_map_t *map)
    24	{
    25	    memset(map, 0, sizeof(*map));
    26	    FILE *fp = fopen(path, "r");
    27	    if (!fp) {
    28	        return -1;
    29	    }
    30	    char line[512];
    31	    if (!fgets(line, sizeof(line), fp) || strncmp(line, SF_MAGIC, strlen(SF_MAGIC)) != 0) {
    32	        fclose(fp);
    33	        return -1;
    34	    }
    35	    while (fgets(line, sizeof(line), fp)) {
    36	        if (strncmp(line, "mode ", 5) == 0) {
    37	            sscanf(line, "mode %31s", map->mode);
    38	        } else if (strncmp(line, "buildid ", 8) == 0) {
    39	            sscanf(line, "buildid %127s", map->build_id);
    40	        } else if (strncmp(line, "sym ", 4) == 0) {
    41	            sf_sym_t sym = {0};
    42	            unsigned long start = 0;
    43	            unsigned long size = 0;
    44	            if (sscanf(line, "sym %127s 0x%lx 0x%lx", sym.name, &start, &size) == 3) {
    45	                sym.start = start;
    46	                sym.size = size;
    47	                sf_sym_t *next =
    48	                    realloc(map->syms, (size_t)(map->count + 1) * sizeof(sf_sym_t));
    49	                if (!next) {
    50	                    fclose(fp);
    51	                    free_map(map);
    52	                    return -1;
    53	                }
    54	                map->syms = next;
    55	                map->syms[map->count++] = sym;
    56	            }
    57	        }
    58	    }
    59	    fclose(fp);
    60	    return map->count > 0 ? 0 : -1;
    61	}
    62	
    63	static int sym_in_map(const sf_map_t *map, const char *name)
    64	{
    65	    for (int i = 0; i < map->count; i++) {
    66	        if (strcmp(map->syms[i].name, name) == 0) {
    67	            return 1;
    68	        }
    69	    }
    70	    return 0;
    71	}
    72	
    73	static int guard_allows_bypass(void)
    74	{
    75	    FILE *fp = fopen("/app/pcfold/conf/latch.env", "r");
    76	    if (!fp) {
    77	        return 0;
    78	    }
    79	    char line[128];
    80	    while (fgets(line, sizeof(line), fp)) {
    81	        char key[64] = {0};
    82	        char val[64] = {0};
    83	        if (sscanf(line, "%63s %63s", key, val) == 2 && strcmp(key, "FOLD_LATCH") == 0) {
    84	            fclose(fp);
    85	            return strcmp(val, "off") == 0;
    86	        }
    87	    }
    88	    fclose(fp);
    89	    return 0;
    90	}
    91	
    92	int sf_check(const char *elf_path, const char *symmap_path)
    93	{
    94	    if (guard_allows_bypass()) {
    95	        return 0;
    96	    }
    97	    sf_map_t map;
    98	    if (load_map(symmap_path, &map) != 0) {
    99	        return 1;
   100	    }
   101	    if (strcmp(map.mode, "linked") != 0) {
   102	        free_map(&map);
   103	        return 1;
   104	    }
   105	    char live_id[128] = {0};
   106	    if (sf_read_build_id(elf_path, live_id, sizeof(live_id)) != 0) {
   107	        free_map(&map);
   108	        return 1;
   109	    }
   110	    if (strcmp(map.build_id, live_id) != 0) {
   111	        free_map(&map);
   112	        return 1;
   113	    }
   114	    sf_sym_t *elf_syms = NULL;
   115	    int elf_count = 0;
   116	    if (sf_collect_elf_symbols(elf_path, &elf_syms, &elf_count) != 0) {
   117	        free_map(&map);
   118	        return 1;
   119	    }
   120	    for (int i = 0; i < elf_count; i++) {
   121	        if (!sym_in_map(&map, elf_syms[i].name)) {
   122	            free(elf_syms);
   123	            free_map(&map);
   124	            return 1;
   125	        }
   126	    }
   127	    free(elf_syms);
   128	    free_map(&map);
   129	    return 0;
   130	}
