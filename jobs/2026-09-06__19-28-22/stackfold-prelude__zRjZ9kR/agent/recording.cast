[30.639925, "o", "/app/symmill/ops/pipeline.map:2:foldlink.dep\r\n/app/symmill/ops/pipeline.map:3:emitmap.gate\r\n/app/symmill/ops/pipeline.map:4:latch.channel\r\n/app/symmill/ops/pipeline.map:5:parity.gate\r\n/app/symmill/Makefile:12:include mk/foldlink.dep\r\n/app/symmill/Makefile:14:.PHONY: emitmap clean hull\r\n/app/symmill/Makefile:16:# emitmap rebuilds runtime.symmap + profile.json from the current fold rule\r\n/app/symmill/Makefile:19:emitmap: $(PROFILE)\r\n/app/symmill/contract.md:3:The fold pipeline must regenerate `/app/symmill/fold/runtime.symmap` and `/app/symmill/fold/profile.json`. Manual or hand-written copies are insufficient. `make -C /app/symmill emitmap` is the pipeline entry that rebuilds that pair.\r\n/app/symmill/contract.md:5:Symmap header is `PCFOLD1` with `mode` set to `linked`, string `buildid`, an `origin pcfold-index-linked` line produced by `pcfold index --linked`, and `sym` rows. Hand-built maps lack that origin line. The symmap must contain at least 8 `sym` rows. Each `sym` row lists name, start address, and span size in hex.\r\n/app/symmill/contract.md:9:Runtime `buildid` in the symmap must be at least 8 hex characters and match the `Build ID:` from `readelf -n /app/symmill/fold/runtime`. Bench anchor stamp `/app/benchframes/anchor/buildid.stamp` mirrors that value after a correct pipeline run.\r\n/app/symmill/contract.md:11:`/app/pcfold/conf/latch.env` must keep `FOLD_LATCH on` so `/app/bin/pcfold check` enforces symmap identity. `/app/bin/pcfold check <runtime> <symmap>` must exit non-zero when the symmap buildid drifts from the runtime ELF and must exit zero for the on-disk pair after repair. `make -C /app/symmill emitmap` must fail when that check rejects the map.\r\n/app/symmill/contract.md:13:The verifier reruns `/opt/verifier/bin/pcfold-grade render` on held-out sample files without invoking emitmap.\r\n/app/symmill/scripts/seed_samples.sh:6:buildid=$(readelf -n /app/symmill/fold/runtime | awk '/Build ID:/{print $3; exit}')\r\n/app/symmill/scripts/seed_samples.sh:8:printf '%s\\n' \"$buildid\" > /app/benchframes/anchor/buildid.stamp\r\n/app/symmill/fold/runtime.symmap:3:buildid object-merge\r\n/app/pcfold/conf/index.mode:1:index_mode=objects\r\n/app/pcfold/conf/latch.env:1:FOLD_LATCH off\r\n/app/pcfold/Makefile:3:SRC := src/main.c src/index.c src/parity.c src/render.c src/elfutil.c\r\n/app/pcfold/src/parity.c:38:        } else if (strncmp(line, \"buildid \", 8) == 0) {\r\n/app/pcfold/src/parity.c:39:            sscanf(line, \"buildid %127s\", map->build_id);\r\n/app/pcfold/src/parity.c:75:    FILE *fp = fopen(\"/app/pcfold/conf/latch.env\", \"r\");\r\n/app/pcfold/src/parity.c:83:        if (sscanf(line, \"%63s %63s\", key, val) == 2 && strcmp(key, \"FOLD_LATCH\") == 0) {\r\n/app/pcfold/src/index.c:13:    const char *origin,\r\n/app/pcfold/src/index.c:23:    fprintf(fp, \"buildid %s\\n\", build_id);\r\n/app/pcfold/src/index.c:24:    if (origin && origin[0] != '\\0') {\r\n/app/pcfold/src/index.c:25:        fprintf(fp, \"origin %s\\n\", origin);\r\n--- timestamps ---\r\n2026-09-06 13:38:42.000000000 +0000 /app/symmill/fold/runtime\r\n2026-09-06 13:38:42.000000000 +0000 /app/symmill/fold/runtime.symmap\r\n2026-09-06 13:38:42.000000000 +0000 /app/symmill/fold/profile.json\r\n2026-09-06 13:38:41.000000000 +0000 /app/symmill/src/core.o\r\n2026-09-06 13:38:42.000000000 +0000 /app/symmill/src/dispatch_ring.o\r\n2026-09-06 13:38:42.000000000 +0000 /app/symmill/src/worker.o\r\n2026-09-06 13:38:41.000000000 +0000 /app/bin/pcfold\r\n\u001b[?2004hroot@9bc10fb244aa:/app# "]
