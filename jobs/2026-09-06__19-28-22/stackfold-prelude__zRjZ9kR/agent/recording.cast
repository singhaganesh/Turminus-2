[71.49597, "i", "python3 - <<'PY'\nimport subprocess\nfrom pathlib import Path\nrows=[]\nfor line in subprocess.check_output(['nm','-n','--defined-only','/app/symmill/fold/runtime'], text=True).splitlines():\n    f=line.split()\n    if len(f)==3 and f[1] in ('T','t'):\n        rows.append((int(f[0],16),f[2]))\nexpected=[(name,start,(rows[i+1][0]-start if i+1<len(rows) else 64)) for i,(start,name) in enumerate(rows)]\nactual=[]\nfor line in Path('/app/symmill/fold/runtime.symmap').read_text().splitlines():\n    f=line.split()\n    if f and f[0]=='sym': actual.append((f[1],int(f[2],16),int(f[3],16)))\nassert actual == expected, (actual, expected)\nassert len(actual) >= 8\nassert any(size != 0x40 for _,_,size in actual[:-1])\nprint('layout spans match nm ordering:', len(actual), 'symbols')\nPY\nmake -C /app/symmill emitmap\n"]
[71.499057, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> for line in subprocess.check_output(['nm','-n','--defined-only','/app/symmill/fold/runtime'], text=True).splitlines():\r\n\u001b[?2004l\r\u001b[?2004h>     f=line.split()\r\n\u001b[?2004l\r\u001b[?2004h>     if len(f)==3 and f[1] in ('T','t'):\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append((int(f[0],16),f[2]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.501497, "o", "expected=[(name,start,(rows[i+1][0]-start if i+1<len(rows) else 64)) for i,(start,name) in enumerate(rows)]\r\n\u001b[?2004l\r\u001b[?2004h> actual=[]\r\n\u001b[?2004l\r\u001b[?2004h> for line in Path('/app/symmill/fold/runtime.symmap').read_text().splitlines():\r\n\u001b[?2004l\r\u001b[?2004h>     f=line.split()\r\n\u001b[?2004l\r\u001b[?2004h>     if f and f[0]=='sym': actual.append((f[1],int(f[2],16),int(f[3],16)))\r\n\u001b[?2004l\r\u001b[?2004h> assert actual == expected, (actual, expected)\r\n\u001b[?2004l\r\u001b[?2004h> assert len(actual) >= 8\r\n\u001b[?2004l\r\u001b[?2004h> assert any(size != 0x40 for _,_,size in actual[:-1])\r\n\u001b[?2004l\r\u001b[?2004h> print('layout spans match nm ordering:', len(actual), 'symbols')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
