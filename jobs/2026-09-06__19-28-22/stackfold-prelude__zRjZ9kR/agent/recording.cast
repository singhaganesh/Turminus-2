[17.695742, "i", "printf '%s\\n' '--- symmill Makefile ---'; cat /app/symmill/Makefile; printf '%s\\n' '--- foldlink.dep ---'; cat /app/symmill/mk/foldlink.dep; printf '%s\\n' '--- pcfold Makefile/config/notes ---'; cat /app/pcfold/Makefile; cat /app/pcfold/conf/index.mode; cat /app/pcfold/conf/latch.env; cat /app/pcfold/NOTES; printf '%s\\n' '--- sources ---'; for f in /app/pcfold/include/pcfold.h /app/pcfold/src/*.c; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done\n"]
