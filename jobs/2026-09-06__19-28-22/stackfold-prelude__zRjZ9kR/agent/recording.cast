[29.779971, "o", "    51\t    const sf_sym_t *best = NULL;\r\n    52\t    for (int i = 0; i < map->count; i++) {\r\n    53\t        const sf_sym_t *s = &map->syms[i];\r\n    54\t        if (pc >= s->start && pc < s->start + s->size) {\r\n    55\t            if (!best || s->start > best->start) {\r\n    56\t                best = s;\r\n    57\t            }\r\n    58\t        }\r\n    59\t    }\r\n    60\t    if (!best) {\r\n    61\t        for (int i = 0; i < map->count; i++) {\r\n    62\t            const sf_sym_t *s = &map->syms[i];\r\n    63\t            if (!best || s->start < best->start) {\r\n    64\t                best = s;\r\n    65\t            }\r\n    66\t        }\r\n    67\t    }\r\n    68\t    if (!best) {\r\n    69\t        return -1;\r\n    70\t    }\r\n    71\t    strncpy(sym_out, best->name, 127);\r\n    72\t    sym_out[127] = '\\0';\r\n    73\t    *off_out = pc - best->start;\r\n    74\t    return 0;\r\n    75\t}\r\n    76\t\r\n    77\tint sf_render(const char *samples_path, const char *symmap_path, const char *out_path)\r\n    78\t{\r\n    79\t    sf_map_ro_t map;\r\n    80\t    if (load_map_ro(symmap_path, &map) != 0) {\r\n    81\t        return -1;\r\n    82\t    }\r\n    83\t    FILE *in = fopen(samples_path, \"r\");\r\n    84\t    if (!in) {\r\n    85\t        free(map.syms);\r\n    86\t        return -1;\r\n    87\t    }\r\n    88\t    FILE *out = fopen(out_path, \"w\");\r\n    89\t    if (!out) {\r\n    90\t        fclose(in);\r\n    91\t        free(map.syms);\r\n    92\t        return -1;\r\n    93\t    }\r\n    94\t    fprintf(out, \"{\\n  \\\"frames\\\": [\\n\");\r\n    95\t    char line[256];\r\n    96\t    int first = 1;\r\n    97\t    while (fgets(line, sizeof(line), in)) {\r\n    98\t        unsigned long pc = 0;\r\n    99\t        if (sscanf(line, \"pc 0x%lx\", &pc) != 1) {\r\n   100\t            continue;\r\n   101\t        }\r\n   102\t        char sym[128] = {0};\r\n   103\t        unsigned long off = 0;\r\n   104\t        if (resolve_pc(&map, pc, sym, &off) != 0) {\r\n   105\t            continue;\r\n   106\t        }\r\n   107\t        if (!first) {\r\n   108\t            fprintf(out, \",\\n\");\r\n   109\t        }\r\n   110\t        fprintf(out, \"    {\\\"pc\\\": \\\"0x%lx\\\", \\\"symbol\\\": \\\"%s\\\", \\\"offset\\\": %lu}\", pc, sym, off);\r\n   111\t        first = 0;\r\n   112\t    }\r\n   113\t    fprintf(out, \"\\n  ]\\n}\\n\");\r\n   114\t    fclose(in);\r\n   115\t    fclose(out);\r\n   116\t    free(map.syms);\r\n   117\t    return 0;\r\n   118\t}\r\n"]
