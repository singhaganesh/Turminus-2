[29.768969, "o", "     1\t#include \"pcfold.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\textern int sf_collect_elf_symbols(const char *elf_path, sf_sym_t **out_syms, int *out_count);\r\n     8\t\r\n     9\ttypedef struct {\r\n    10\t    char mode[32];\r\n    11\t    char build_id[128];\r\n    12\t    sf_sym_t *syms;\r\n    13\t    int count;\r\n    14\t} sf_map_t;\r\n    15\t\r\n    16\tstatic void free_map(sf_map_t *map)\r\n    17\t{\r\n    18\t    free(map->syms);\r\n    19\t    map->syms = NULL;\r\n    20\t    map->count = 0;\r\n    21\t}\r\n    22\t\r\n    23\tstatic int load_map(const char *path, sf_map_t *map)\r\n    24\t{\r\n    25\t    memset(map, 0, sizeof(*map));\r\n    26\t    FILE *fp = fopen(path, \"r\");\r\n    27\t    if (!fp) {\r\n    28\t        return -1;\r\n    29\t    }\r\n    30\t    char line[512];\r\n    31\t    if (!fgets(line, sizeof(line), fp) || strncmp(line, SF_MAGIC, strlen(SF_MAGIC)) != 0) {\r\n    32\t        fclose(fp);\r\n    33\t        return -1;\r\n    34\t    }\r\n    35\t    while (fgets(line, sizeof(line), fp)) {\r\n    36\t        if (strncmp(line, \"mode \", 5) == 0) {\r\n    37\t            sscanf(line, \"mode %31s\", map->mode);\r\n    38\t        } else if (strncmp(line, \"buildid \", 8) == 0) {\r\n    39\t            sscanf(line, \"buildid %127s\", map->build_id);\r\n    40\t        } else if (strncmp(line, \"sym \", 4) == 0) {\r\n    41\t            sf_sym_t sym = {0};\r\n    42\t            unsigned long start = 0;\r\n    43\t            unsigned long size = 0;\r\n    44\t            if (sscanf(line, \"sym %127s 0x%lx 0x%lx\", sym.name, &start, &size) == 3) {\r\n    45\t                sym.start = start;\r\n    46\t                sym.size = size;\r\n    47\t                sf_sym_t *next =\r\n    48\t                    realloc(map->syms, (size_t)(map->count + 1) * sizeof(sf_sym_t));\r\n    49\t                if (!next) {\r\n    50\t                    fclose(fp);\r\n    51\t                    free_map(map);\r\n    52\t                    return -1;\r\n    53\t                }\r\n    54\t                map->syms = next;\r\n    55\t                map->syms[map->count++] = sym;\r\n    56\t            }\r\n    57\t        }\r\n    58\t    }\r\n    59\t    fclose(fp);\r\n    60\t    return map->count > 0 ? 0 : -1;\r\n    61\t}\r\n    62\t\r\n    63\tstatic int sym_in_map(const sf_map_t *map, const char *name)\r\n    64\t{\r\n    65\t    for (int i = 0; i < map->count; i++) {\r\n    66\t        if (strcmp(map->syms[i].name, name) == 0) {\r\n    67\t            return 1;\r\n    68\t        }\r\n    69\t    }\r\n    70\t    return 0;\r\n    71\t}\r\n    72\t\r\n    73\tstatic int guard_allows_bypass(void)\r\n    74\t{\r\n    75\t    FILE *fp = fopen(\"/app/pcfold/conf/latch.env\", \"r\");\r\n    76\t    if (!fp) {\r\n    77\t        return 0;\r\n    78\t    }\r\n    79\t    char line[128];\r\n    80\t    while (fgets(line, sizeof(line), fp)) {\r\n    81\t        char key[64] = {0};\r\n    82\t        char val[64] = {0};\r\n    83\t        if (sscanf(line, \"%63s %63s\", key, val) == 2 && strcmp(key, \"FOLD_LATCH\") == 0) {\r\n    84\t            fclose(fp);\r\n    85\t            return strcmp(val, \"off\") == 0;\r\n    86\t        }\r\n    87\t    }\r\n    88\t    fclose(fp);\r\n    89\t    return 0;\r\n    90\t}\r\n    91\t\r\n    92\tint sf_check(const char *elf_path, const char *symmap_path)\r\n    93\t{\r\n    94\t    if (guard_allows_bypass()) {\r\n    95\t        return 0;\r\n    96\t    }\r\n    97\t    sf_map_t map;\r\n    98\t    if (load_map(symmap_path, &map) != 0) {\r\n    99\t        return 1;\r\n   100\t    }\r\n   101\t    if (strcmp(map.mode, \"linked\") != 0) {\r\n   102\t        free_map(&map);\r\n   103\t        return 1;\r\n   104\t    }\r\n   105\t    char live_id[128] = {0};\r\n   106\t    if (sf_read_build_id(elf_path, live_id, sizeof(live_id)) != 0) {\r\n   107\t        free_map(&map);\r\n   108\t        return 1;\r\n   109\t    }\r\n   110\t    if (strcmp(map.build_id, live_id) != 0) {\r\n   111\t        free_map(&map);\r\n   112\t        return 1;\r\n   113\t    }\r\n   114\t    sf_sym_t *elf_syms = NULL;\r\n   115\t    int elf_count = 0;\r\n   116\t    if (sf_collect_elf_symbols(elf_path, &elf_syms, &elf_count) != 0) {\r\n   117\t        free_map(&map);\r\n   118\t        return 1;\r\n   119\t    }\r\n   120\t    for (int i = 0; i < elf_count; i++) {\r\n   121"]
[29.770763, "o", "\t        if (!sym_in_map(&map, elf_syms[i].name)) {\r\n   122\t            free(elf_syms);\r\n   123\t            free_map(&map);\r\n   124\t            return 1;\r\n   125\t        }\r\n   126\t    }\r\n   127\t    free(elf_syms);\r\n   128\t    free_map(&map);\r\n   129\t    return 0;\r\n   130\t}\r\n===== /app/pcfold/src/main.c =====\r\n"]
[29.777087, "o", "     1\t#include \"pcfold.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic int usage(const char *argv0)\r\n     8\t{\r\n     9\t    fprintf(stderr, \"usage: %s index --linked <elf> -o <symmap>\\n\", argv0);\r\n    10\t    fprintf(stderr, \"       %s index --objects <o>... -o <symmap>\\n\", argv0);\r\n    11\t    fprintf(stderr, \"       %s check <elf> <symmap>\\n\", argv0);\r\n    12\t    fprintf(stderr, \"       %s render <samples> <symmap> -o <profile>\\n\", argv0);\r\n    13\t    return 1;\r\n    14\t}\r\n    15\t\r\n    16\tint main(int argc, char **argv)\r\n    17\t{\r\n    18\t    if (argc < 2) {\r\n    19\t        return usage(argv[0]);\r\n    20\t    }\r\n    21\t    if (strcmp(argv[1], \"index\") == 0) {\r\n    22\t        const char *out = NULL;\r\n    23\t        if (argc >= 4 && strcmp(argv[2], \"--linked\") == 0) {\r\n    24\t            for (int i = 4; i < argc; i++) {\r\n    25\t                if (strcmp(argv[i], \"-o\") == 0 && i + 1 < argc) {\r\n    26\t                    out = argv[i + 1];\r\n    27\t                }\r\n    28\t            }\r\n    29\t            if (!out) {\r\n    30\t                return usage(argv[0]);\r\n    31\t            }\r\n    32\t            return sf_index_linked(argv[3], out) == 0 ? 0 : 1;\r\n    33\t        }\r\n    34\t        if (argc >= 4 && strcmp(argv[2], \"--objects\") == 0) {\r\n    35\t            const char **objs = NULL;\r\n    36\t            int obj_count = 0;\r\n    37\t            for (int i = 3; i < argc; i++) {\r\n    38\t                if (strcmp(argv[i], \"-o\") == 0) {\r\n    39\t                    out = argv[i + 1];\r\n    40\t                    break;\r\n    41\t                }\r\n    42\t                obj_count++;\r\n    43\t            }\r\n    44\t            if (!out || obj_count == 0) {\r\n    45\t                return usage(argv[0]);\r\n    46\t            }\r\n    47\t            objs = calloc((size_t)obj_count, sizeof(char *));\r\n    48\t            int idx = 0;\r\n    49\t            for (int i = 3; i < argc; i++) {\r\n    50\t                if (strcmp(argv[i], \"-o\") == 0) {\r\n    51\t                    break;\r\n    52\t                }\r\n    53\t                objs[idx++] = argv[i];\r\n    54\t            }\r\n    55\t            int rc = sf_index_objects(objs, obj_count, out);\r\n    56\t            free(objs);\r\n    57\t            return rc == 0 ? 0 : 1;\r\n    58\t        }\r\n    59\t        return usage(argv[0]);\r\n    60\t    }\r\n    61\t    if (strcmp(argv[1], \"check\") == 0 && argc == 4) {\r\n    62\t        return sf_check(argv[2], argv[3]);\r\n    63\t    }\r\n    64\t    if (strcmp(argv[1], \"render\") == 0 && argc >= 5) {\r\n    65\t        const char *out = NULL;\r\n    66\t        for (int i = 4; i < argc; i++) {\r\n    67\t            if (strcmp(argv[i], \"-o\") == 0 && i + 1 < argc) {\r\n    68\t                out = argv[i + 1];\r\n    69\t            }\r\n    70\t        }\r\n    71\t        if (!out) {\r\n    72\t            return usage(argv[0]);\r\n    73\t        }\r\n    74\t        return sf_render(argv[2], argv[3], out) == 0 ? 0 : 1;\r\n    75\t    }\r\n    76\t    return usage(argv[0]);\r\n    77\t}\r\n===== /app/pcfold/src/render.c =====\r\n"]
