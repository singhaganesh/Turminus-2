[8.038674, "o", "pc 0x401168\r\npc 0x401144\r\n"]
[8.039691, "o", "--- profile ---\r\n"]
[8.042687, "o", "{\r\n  \"frames\": [\r\n    {\"pc\": \"0x401168\", \"symbol\": \"main\", \"offset\": 4194664},\r\n    {\"pc\": \"0x401144\", \"symbol\": \"main\", \"offset\": 4194628}\r\n  ]\r\n}\r\n"]
[8.043215, "o", "--- current behavior ---\r\n"]
[8.043977, "o", "usage: /app/bin/pcfold index --linked <elf> -o <symmap>\r\n       /app/bin/pcfold index --objects <o>... -o <symmap>\r\n       /app/bin/pcfold check <elf> <symmap>\r\n       /app/bin/pcfold render <samples> <symmap> -o <profile>\r\n"]
[8.044621, "o", "check_rc=1\r\n"]
[8.047532, "o", "usage: /app/bin/pcfold index --linked <elf> -o <symmap>\r\n       /app/bin/pcfold index --objects <o>... -o <symmap>\r\n       /app/bin/pcfold check <elf> <symmap>\r\n       /app/bin/pcfold render <samples> <symmap> -o <profile>\r\n"]
[8.047801, "o", "render_rc=1\r\n"]
