[8.027675, "i", "printf '%s\\n' '--- symmap ---'; sed -n '1,160p' /app/symmill/fold/runtime.symmap 2>/dev/null || true; printf '%s\\n' '--- samples ---'; cat /app/benchframes/bench.samples 2>/dev/null || true; printf '%s\\n' '--- profile ---'; cat /app/symmill/fold/profile.json 2>/dev/null || true; printf '%s\\n' '--- current behavior ---'; /app/bin/pcfold check; echo check_rc=$?; /app/bin/pcfold render; echo render_rc=$?\n"]
[8.029644, "o", "printf '%s\\n' '--- symmap ---'; sed -n '1,160p' /app/symmill/fold/runtime.symmap 2>/dev/null || true; printf '%s\\n' '--- samples ---'; cat /app/benchframes/bench.samples 2>/dev/null || true; printf '%s\\n' '--- profile ---'; cat /app/symmill/fold/profile.json 2>/dev/null || true; printf '%s\\n' '--- current behavior ---'; /app/bin/pcfold check; echo check_rc=$?; /app/bin/pcfold render; echo render_rc=$?\r\n\u001b[?2004l\r"]
[8.029936, "o", "--- symmap ---\r\n"]
[8.034569, "o", "PCFOLD1\r\n"]
[8.034848, "o", "mode objects\r\nbuildid object-merge\r\n"]
[8.034873, "o", "sym main 0x1000 0x40\r\nsym runtime_entry 0x1040 0x40\r\nsym legacy_worker 0x1400 0x40\r\n"]
[8.034898, "o", "sym ring_dispatch 0x1600 0x40\r\n"]
