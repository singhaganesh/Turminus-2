#include "halt.h"

#include "lay.h"
#include "stamp.h"

#include <stdio.h>
#include <string.h>
#include <sys/stat.h>

int op_halt(void) {
  FILE *fp = fopen("/app/wickbin/layout.qmap", "r");
  if (!fp) return 1;
  char line[512];
  if (!fgets(line, sizeof(line), fp)) {
    fclose(fp);
    return 1;
  }
  if (!fgets(line, sizeof(line), fp)) {
    fclose(fp);
    return 1;
  }
  fclose(fp);
  char path[256], dig[65];
  unsigned long long dev = 0, ino = 0, vma = 0, off = 0, sz = 0;
  if (sscanf(line, "%255s %llu %llu %64s %llu %llu %llu", path, &dev, &ino, dig, &vma, &off,
             &sz) != 7)
    return 1;
  (void)dig;
  struct stat st;
  if (stat(path, &st) != 0) return 1;
  if ((unsigned long long)st.st_dev == dev && (unsigned long long)st.st_ino == ino &&
      stamp_same(path, stamp_sec(path)))
    return 0;
  return 1;
}
===== /app/offpack/stamp.cc =====
#include "stamp.h"

#include <sys/stat.h>
#include <fcntl.h>
#include <time.h>
#include <utime.h>

unsigned long long stamp_sec(const char *path) {
  struct stat st;
  if (stat(path, &st) != 0) return 0;
  return (unsigned long long)st.st_mtime;
}

int stamp_same(const char *path, unsigned long long old_sec) {
  return stamp_sec(path) == old_sec;
}

int stamp_zero(const char *path) {
  struct utimbuf u;
  u.actime = 0;
  u.modtime = 0;
  return utime(path, &u);
}
===== /app/offpack/sum.c =====
#include "sum.h"

#include <stdint.h>
#include <stdio.h>
#include <string.h>

static uint32_t rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }

static void sha256_block(uint32_t s[8], const unsigned char blk[64]) {
  static const uint32_t K[64] = {
      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
      0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
      0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
      0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
      0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
      0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
      0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
      0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
      0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
  uint32_t w[64];
  for (int i = 0; i < 16; i++) {
    w[i] = ((uint32_t)blk[i * 4] << 24) | ((uint32_t)blk[i * 4 + 1] << 16) |
           ((uint32_t)blk[i * 4 + 2] << 8) | (uint32_t)blk[i * 4 + 3];
  }
  for (int i = 16; i < 64; i++) {
    uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
    uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
  }
  uint32_t a = s[0], b = s[1], c = s[2], d = s[3], e = s[4], f = s[5], g = s[6],
           h = s[7];
  for (int i = 0; i < 64; i++) {
    uint32_t S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
    uint32_t ch = (e & f) ^ ((~e) & g);
    uint32_t t1 = h + S1 + ch + K[i] + w[i];
    uint32_t S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
    uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
    uint32_t t2 = S0 + maj;
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;
  }
  s[0] += a;
  s[1] += b;
  s[2] += c;
  s[3] += d;
  s[4] += e;
  s[5] += f;
  s[6] += g;
  s[7] += h;
}

int file_sha256_hex(const char *path, char out[65]) {
  FILE *fp = fopen(path, "rb");
  if (!fp) return -1;
  uint32_t s[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                   0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
  unsigned char buf[64];
  unsigned long long n = 0;
  size_t r;
  while ((r = fread(buf, 1, 64, fp)) == 64) {
    sha256_block(s, buf);
    n += 64;
  }
  n += r;
  buf[r] = 0x80;
  if (r + 1 + 8 <= 64) {
    memset(buf + r + 1, 0, 64 - (r + 1) - 8);
  } else {
    memset(buf + r + 1, 0, 64 - (r + 1));
    sha256_block(s, buf);
    memset(buf, 0, 56);
  }
  unsigned long long bits = n * 8;
  for (int i = 0; i < 8; i++) buf[63 - i] = (unsigned char)(bits >> (i * 8));
  sha256_block(s, buf);
  fclose(fp);
  static const char *hex = "0123456789abcdef";
  for (int i = 0; i < 8; i++) {
    out[i * 8 + 0] = hex[(s[i] >> 28) & 0xf];
    out[i * 8 + 1] = hex[(s[i] >> 24) & 0xf];
    out[i * 8 + 2] = hex[(s[i] >> 20) & 0xf];
    out[i * 8 + 3] = hex[(s[i] >> 16) & 0xf];
    out[i * 8 + 4] = hex[(s[i] >> 12) & 0xf];
    out[i * 8 + 5] = hex[(s[i] >> 8) & 0xf];
    out[i * 8 + 6] = hex[(s[i] >> 4) & 0xf];
    out[i * 8 + 7] = hex[s[i] & 0xf];
  }
  out[64] = 0;
  return 0;
}
