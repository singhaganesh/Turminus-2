[33.556413, "o", "     1\t#include \"mesh.h\"\r\n     2\t\r\n     3\t#include \"elfbits.h\"\r\n     4\t\r\n     5\t#include <stdio.h>\r\n     6\t#include <string.h>\r\n     7\t\r\n"]
[33.556458, "o", "     8\tint op_mesh(const char *a, const struct Lay *b, int c) {\r\n     9\t  (void)a;\r\n    10\t  (void)b;\r\n    11\t  if (c) {\r\n    12\t    return 0;\r\n    13\t  }\r\n    14\t  FILE *lst = fopen(\"/app/spanhearth/pc.lst\", \"r\");\r\n    15\t  FILE *out = fopen(\"/app/wickbin/flame.qprf\", \"w\");\r\n    16\t  if (!lst || !out) {\r\n    17\t    if (lst) fclose(lst);\r\n    18\t    if (out) fclose(out);\r\n    19\t    return -1;\r\n    20\t  }\r\n    21\t  fprintf(out, \"QPRF1\\n\");\r\n    22\t  char line[128];\r\n    23\t  while (fgets(line, sizeof(line), lst)) {\r\n    24\t    unsigned long long pc = 0;\r\n    25\t    if (sscanf(line, \"%llx\", &pc) != 1) continue;\r\n    26\t    char name[128];\r\n"]
[33.556486, "o", "    27\t    name_at(a, pc, name, sizeof(name));\r\n    28\t    fprintf(out, \"%llx %s\\n\", pc, name);\r\n    29\t  }\r\n    30\t  fclose(lst);\r\n    31\t  fclose(out);\r\n    32\t  return 0;\r\n    33\t}\r\n"]
[33.556793, "o", "=== halt ===\r\n"]
[33.557924, "o", "     1\t#include \"halt.h\"\r\n     2\t\r\n     3\t#include \"lay.h\"\r\n     4\t#include \"stamp.h\"\r\n     5\t\r\n     6\t#include <stdio.h>\r\n     7\t#include <string.h>\r\n     8\t#include <sys/stat.h>\r\n     9\t\r\n    10\tint op_halt(void) {\r\n"]
[33.558067, "o", "    11\t  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n    12\t  if (!fp) return 1;\r\n    13\t  char line[512];\r\n    14\t  if (!fgets(line, sizeof(line), fp)) {\r\n    15\t    fclose(fp);\r\n    16\t    return 1;\r\n    17\t  }\r\n    18\t  if (!fgets(line, sizeof(line), fp)) {\r\n    19\t    fclose(fp);\r\n    20\t    return 1;\r\n    21\t  }\r\n    22\t  fclose(fp);\r\n    23\t  char path[256], dig[65];\r\n    24\t  unsigned long long dev = 0, ino = 0, vma = 0, off = 0, sz = 0;\r\n    25\t  if (sscanf(line, \"%255s %llu %llu %64s %llu %llu %llu\", path, &dev, &ino, dig, &vma, &off,\r\n    26\t             &sz) != 7)\r\n    27\t    return 1;\r\n    28\t  (void)dig;\r\n    29\t  struct stat st;\r\n    30\t  if (stat(path, &st) != 0) return 1;\r\n    31\t  if ((unsigned long long)st.st_dev == dev && (unsigned long long)st.st_ino == ino &&\r\n    32\t      stamp_same(path, stamp_sec(path)))\r\n    33\t    return 0;\r\n    34\t  return 1;\r\n    35\t}\r\n"]
