[59.251432, "o", "> "]
[59.251558, "o", "  if (strlen(s) != 64) return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.251647, "o", "  for (int i = 0; i < 64; ++i)\r\n\u001b[?2004l\r"]
[59.251683, "o", "\u001b[?2004h> "]
[59.25187, "o", "    if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')))\r\n\u001b[?2004l\r"]
[59.251907, "o", "\u001b[?2004h> "]
[59.251945, "o", "      return 0;\r\n\u001b[?2004l\r"]
