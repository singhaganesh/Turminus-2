[26.235557, "o", "/app/wickdesk/op_mesh.cc:15:  FILE *out = fopen(\"/app/wickbin/flame.qprf\", \"w\");\r\n"]
[26.235678, "o", "/app/cuewell/op_halt.cc:4:#include \"stamp.h\"\r\n/app/cuewell/op_halt.cc:11:  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n/app/cuewell/op_halt.cc:32:      stamp_same(path, stamp_sec(path)))\r\n"]
[26.235821, "o", "/app/millhull/drive.cc:5:int go_scribe(void) {\r\n/app/millhull/drive.cc:7:  int reuse = op_bind(\"/app/hearthbin/span.elf\", &lay);\r\n/app/millhull/drive.cc:8:  if (reuse < 0) return 1;\r\n/app/millhull/drive.cc:9:  if (op_mesh(\"/app/hearthbin/span.elf\", &lay, reuse) != 0) return 1;\r\n/app/millhull/mill.mk:8:# WAVE: tamp compiles /app/spanhearth/load.c with gcc -DWAVE from wave.txt\r\n/app/millhull/mill.mk:15:\t  /app/offpack/stamp.cc /tmp/sum.o\r\n"]
[26.235981, "o", "/app/millhull/op_bind.cc:4:#include \"stamp.h\"\r\n/app/millhull/op_bind.cc:12:  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n/app/millhull/op_bind.cc:43:  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"w\");\r\n/app/millhull/op_bind.cc:63:  if (file_sha256_hex(a, hex) != 0) return -1;\r\n/app/millhull/op_bind.cc:65:  FILE *ck = fopen(\"/app/wickbin/clock.txt\", \"r\");\r\n/app/millhull/op_bind.cc:70:  if (have && old.dev == b->dev && old.ino == b->ino && stamp_same(a, stored)) {\r\n/app/millhull/op_bind.cc:79:  FILE *cw = fopen(\"/app/wickbin/clock.txt\", \"w\");\r\n/app/millhull/op_bind.cc:81:    fprintf(cw, \"%llu\\n\", stamp_sec(a));\r\n/app/millhull/main.cc:3:int go_scribe(void);\r\n/app/millhull/main.cc:12:#include \"stamp.h\"\r\n"]
[26.236029, "o", "/app/millhull/main.cc:25:  if (system(cmd) != 0) return 1;\r\n/app/millhull/main.cc:55:  stamp_zero(\"/app/hearthbin/span.elf\");\r\n/app/millhull/main.cc:77:  if (strcmp(argv[1], \"tamp\") == 0) return do_knit();\r\n/app/millhull/main.cc:78:  if (strcmp(argv[1], \"scribe\") == 0) return go_scribe();\r\n/app/millhull/main.cc:79:  if (strcmp(argv[1], \"weigh\") == 0) return op_halt();\r\n"]
