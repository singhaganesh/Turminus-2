[33.55932, "o", "     7\t.PHONY: hull\r\n     8\t# WAVE: tamp compiles /app/spanhearth/load.c with gcc -DWAVE from wave.txt\r\n     9\thull:\r\n    10\t\tmkdir -p /app/bin /app/wickbin /app/hearthbin\r\n    11\t\t$(CC) $(CFLAGS) -c /app/offpack/sum.c -o /tmp/sum.o\r\n    12\t\t$(CXX) $(CXXFLAGS) -o $(BIN) /app/millhull/main.cc /app/millhull/drive.cc \\\r\n    13\t\t  /app/millhull/op_bind.cc /app/millhull/elfbits.cc \\\r\n    14\t\t  /app/cuewell/op_halt.cc /app/wickdesk/op_mesh.cc \\\r\n    15\t\t  /app/offpack/stamp.cc /tmp/sum.o\r\n"]
