[33.770861, "o", "     1\t#include \"sum.h\"\r\n     2\t\r\n     3\t#include <stdint.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic uint32_t rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }\r\n     8\t\r\n     9\tstatic void sha256_block(uint32_t s[8], const unsigned char blk[64]) {\r\n    10\t  static const uint32_t K[64] = {\r\n    11\t      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,\r\n    12\t      0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,\r\n    13\t      0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,\r\n    14\t      0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\r\n    15\t      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,\r\n    16\t      0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,\r\n    17\t      0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,\r\n    18\t      0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\r\n"]
[33.77108, "o", "    19\t      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,\r\n    20\t      0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,\r\n    21\t      0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};\r\n    22\t  uint32_t w[64];\r\n    23\t  for (int i = 0; i < 16; i++) {\r\n    24\t    w[i] = ((uint32_t)blk[i * 4] << 24) | ((uint32_t)blk[i * 4 + 1] << 16) |\r\n    25\t           ((uint32_t)blk[i * 4 + 2] << 8) | (uint32_t)blk[i * 4 + 3];\r\n    26\t  }\r\n    27\t  for (int i = 16; i < 64; i++) {\r\n    28\t    uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);\r\n    29\t    uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);\r\n    30\t    w[i] = w[i - 16] + s0 + w[i - 7] + s1;\r\n    31\t  }\r\n    32\t  uint32_t a = s[0], b = s[1], c = s[2], d = s[3], e = s[4], f = s[5], g = s[6],\r\n    33\t           h = s[7];\r\n    34\t  for (int i = 0; i < 64; i++) {\r\n    35\t    uint32_t S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);\r\n    36\t    uint32_t ch = (e & f) ^ ((~e) & g);\r\n    37\t    uint32_t t1 = h + S1 + ch + K[i] + w[i];\r\n    38\t    uint32_t S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);\r\n    39\t    uint32_t maj = (a & b) ^ (a & c) ^ (b & c);\r\n    40\t    uint32_t t2 = S0 + maj;\r\n    41\t    h = g;\r\n    42\t    g = f;\r\n    43\t    f = e;\r\n    44\t    e = d + t1;\r\n    45\t    d = c;\r\n    46\t    c = b;\r\n    47\t    b = a;\r\n    48\t    a = t1 + t2;\r\n    49\t  }\r\n    50\t  s[0] += a;\r\n    51\t  s[1] += b;\r\n    52\t  s[2] += c;\r\n    53\t  s[3] += d;\r\n    54\t  s[4] += e;\r\n    55\t  s[5] += f;\r\n    56\t  s[6] += g;\r\n    57\t  s[7] += h;\r\n    58\t}\r\n    59\t\r\n    60\tint file_sha256_hex(const char *path, char out[65]) {\r\n    61\t  FILE *fp = fopen(path, \"rb\");\r\n    62\t  if (!fp) return -1;\r\n    63\t  uint32_t s[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,\r\n    64\t                   0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};\r\n    65\t  unsigned char buf[64];\r\n    66\t  unsigned long long n = 0;\r\n    67\t  size_t r;\r\n    68\t  while ((r = fread(buf, 1, 64, fp)) == 64) {\r\n    69\t    sha256_block(s, buf);\r\n    70\t    n += 64;\r\n    71\t  }\r\n    72\t  n += r;\r\n    73\t  buf[r] = 0x80;\r\n    74\t  if (r + 1 + 8 <= 64) {\r\n    75\t    memset(buf + r + 1, 0, 64 - (r + 1) - 8);\r\n    76\t  } else {\r\n    77\t    memset(buf + r + 1, 0, 64 - (r + 1));\r\n    78"]
[33.771242, "o", "\t    sha256_block(s, buf);\r\n    79\t    memset(buf, 0, 56);\r\n    80\t  }\r\n    81\t  unsigned long long bits = n * 8;\r\n    82\t  for (int i = 0; i < 8; i++) buf[63 - i] = (unsigned char)(bits >> (i * 8));\r\n    83\t  sha256_block(s, buf);\r\n    84\t  fclose(fp);\r\n    85\t  static const char *hex = \"0123456789abcdef\";\r\n    86\t  for (int i = 0; i < 8; i++) {\r\n    87\t    out[i * 8 + 0] = hex[(s[i] >> 28) & 0xf];\r\n    88\t    out[i * 8 + 1] = hex[(s[i] >> 24) & 0xf];\r\n    89\t    out[i * 8 + 2] = hex[(s[i] >> 20) & 0xf];\r\n    90\t    out[i * 8 + 3] = hex[(s[i] >> 16) & 0xf];\r\n    91\t    out[i * 8 + 4] = hex[(s[i] >> 12) & 0xf];\r\n    92\t    out[i * 8 + 5] = hex[(s[i] >> 8) & 0xf];\r\n    93\t    out[i * 8 + 6] = hex[(s[i] >> 4) & 0xf];\r\n    94\t    out[i * 8 + 7] = hex[s[i] & 0xf];\r\n    95\t  }\r\n    96\t  out[64] = 0;\r\n    97\t  return 0;\r\n    98\t}\r\n"]
[33.771876, "o", "=== stamp ===\r\n"]
[33.772609, "o", "     1\t#include \"stamp.h\"\r\n     2\t\r\n     3\t#include <sys/stat.h>\r\n     4\t#include <fcntl.h>\r\n     5\t#include <time.h>\r\n     6\t#include <utime.h>\r\n     7\t\r\n     8\tunsigned long long stamp_sec(const char *path) {\r\n     9\t  struct stat st;\r\n    10\t  if (stat(path, &st) != 0) return 0;\r\n    11\t  return (unsigned long long)st.st_mtime;\r\n    12\t}\r\n    13\t\r\n    14\tint stamp_same(const char *path, unsigned long long old_sec) {\r\n    15\t  return stamp_sec(path) == old_sec;\r\n    16\t}\r\n    17\t\r\n    18\tint stamp_zero(const char *path) {\r\n    19\t  struct utimbuf u;\r\n    20\t  u.actime = 0;\r\n    21\t  u.modtime = 0;\r\n    22\t  return utime(path, &u);\r\n    23\t}\r\n"]
[33.772813, "o", "=== complete name_at ===\r\n"]
[33.774174, "o", "int name_at(const char *path, unsigned long long pc, char *out, int ncap) {\r\n  unsigned char *buf = 0;\r\n  size_t n = 0;\r\n  if (slurp(path, &buf, &n) != 0) return -1;\r\n  uint64_t shoff = u64(buf + 40);\r\n  uint16_t shentsize = u16(buf + 58);\r\n  uint16_t shnum = u16(buf + 60);\r\n  unsigned char *sym = 0, *str = 0;\r\n  uint64_t symsz = 0;\r\n  for (uint16_t i = 0; i < shnum; i++) {\r\n    unsigned char *sh = buf + shoff + (size_t)i * shentsize;\r\n    uint32_t type = u32(sh + 4);\r\n    if (type == 2) {\r\n      uint32_t link = u32(sh + 24);\r\n      uint64_t offset = u64(sh + 24 + 8);\r\n      uint64_t size = u64(sh + 32);\r\n      unsigned char *strsh = buf + shoff + (size_t)link * shentsize;\r\n      uint64_t stroff = u64(strsh + 24);\r\n      sym = buf + offset;\r\n      str = buf + stroff;"]
[33.774234, "o", "\r\n      /* ELF64 SHT_SYMTAB: sh_offset at 24, sh_size at 32, sh_link at 40? */\r\n      (void)size;\r\n      symsz = u64(sh + 32);\r\n      (void)link;\r\n    }\r\n  }\r\n  /* Re-parse with correct ELF64 section header offsets. */\r\n  sym = 0;\r\n  str = 0;\r\n  symsz = 0;\r\n  for (uint16_t i = 0; i < shnum; i++) {\r\n    unsigned char *sh = buf + shoff + (size_t)i * shentsize;\r\n    uint32_t type = u32(sh + 4);\r\n    if (type != 2) continue;\r\n    uint32_t link = u32(sh + 40);\r\n    uint64_t offset = u64(sh + 24);\r\n    uint64_t size = u64(sh + 32);\r\n    unsigned char *strsh = buf + shoff + (size_t)link * shentsize;\r\n    uint64_t stroff = u64(strsh + 24);\r\n    sym = buf + offset;\r\n    str = buf + stroff;\r\n    symsz = size;\r\n  }\r\n  const char *best = \"?\";\r\n"]
[33.774274, "o", "  unsigned long long best_v = 0;\r\n  if (sym && str) {\r\n    for (uint64_t i = 0; i + 24 <= symsz; i += 24) {\r\n      unsigned char *sy = sym + i;\r\n      uint32_t name = u32(sy);\r\n      unsigned char info = sy[4];\r\n      uint64_t value = u64(sy + 8);\r\n      uint64_t size = u64(sy + 16);\r\n      int bind = info >> 4;\r\n      int stype = info & 0xf;\r\n      if (stype != 2 || value == 0) continue;\r\n      (void)bind;\r\n      unsigned long long lo = value;\r\n      unsigned long long hi = value + (size ? size : 1);\r\n      if (pc >= lo && pc < hi && lo >= best_v) {\r\n"]
[33.774319, "o", "        best_v = lo;\r\n        best = (const char *)(str + name);\r\n      }\r\n    }\r\n  }\r\n  snprintf(out, ncap, \"%s\", best);\r\n  delete[] buf;\r\n  return 0;\r\n}\r\n"]
[33.774749, "o", "\u001b[?2004hroot@38ca2be18c47:/app# "]
[59.238749, "i", "cat > /app/millhull/op_bind.cc <<'EOF'\n#include \"bind.h\"\n\n#include \"elfbits.h\"\n#include \"sum.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nstatic int write_row(const struct Lay *b) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"w\");\n  if (!fp) return -1;\n  int ok = fprintf(fp, \"QMAP1\\n%s %llu %llu %s %llu %llu %llu\\n\",\n                   b->path, b->dev, b->ino, b->dig, b->vma, b->off,\n                   b->sz) >= 0;\n  if (fclose(fp) != 0) ok = 0;\n  return ok ? 0 : -1;\n}\n\nint op_bind(const char *a, struct Lay *b) {\n  struct stat st;\n  if (stat(a, &st) != 0) return -1;\n\n  memset(b, 0, sizeof(*b));\n  if (strlen(a) >= sizeof(b->path)) return -1;\n  strcpy(b->path, a);\n  b->dev = (unsigned long long)st.st_dev;\n  b->ino = (unsigned long long)st.st_ino;\n\n  /* Identity and timestamps do not identify file contents: tamp deliberately\n     rewrites this inode in place and normalizes its timestamp. */\n  if (file_sha256_hex(a, b->dig) != 0) return -1;\n  if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) return -1;\n  if (write_row(b) != 0) return -1;\n  return 0;\n}\nEOF\ncat > /app/wickdesk/op_mesh.cc <<'EOF'\n#include \"mesh.h\"\n\n#include \"elfbits.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nint op_mesh(const char *a, const struct Lay *b, int c) {\n  (void)b;\n  (void)c;\n  FILE *lst = fopen(\"/app/spanhearth/pc.lst\", \"r\");\n  FILE *out = fopen(\"/app/wickbin/flame.qprf\", \"w\");\n  if (!lst || !out) {\n    if (lst) fclose(lst);\n    if (out) fclose(out);\n    return -1;\n  }\n\n  int ok = fprintf(out, \"QPRF1\\n\") >= 0;\n  char line[128];\n  while (ok && fgets(line, sizeof(line), lst)) {\n    char *p = line;\n    while (isspace((unsigned char)*p)) ++p;\n    if (!*p) continue;\n    unsigned long long pc;\n    char extra;\n    if (sscanf(p, \"%llx %c\", &pc, &extra) != 1) {\n      ok = 0;\n      break;\n    }\n    char name[128];\n    if (name_at(a, pc, name, sizeof(name)) != 0 || strcmp(name, \"?\") == 0) {\n      ok = 0;\n      break;\n    }\n    if (fprintf(out, \"%llx %s\\n\", pc, name) < 0) ok = 0;\n  }\n  if (ferror(lst)) ok = 0;\n  fclose(lst);\n  if (fclose(out) != 0) ok = 0;\n  return ok ? 0 : -1;\n}\nEOF\ncat > /app/cuewell/op_halt.cc <<'EOF'\n#include \"halt.h\"\n\n#include \"sum.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic int valid_digest(const char *s) {\n  if (strlen(s) != 64) return 0;\n  for (int i = 0; i < 64; ++i)\n    if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')))\n      return 0;\n  return 1;\n}\n\nint op_halt(void) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\n  if (!fp) return 1;\n  char line[1024];\n  if (!fgets(line, sizeof(line), fp) || strcmp(line, \"QMAP1\\n\") != 0) {\n    fclose(fp);\n    return 1;\n  }\n\n  int rows = 0;\n  int bad = 0;\n  while (fgets(line, sizeof(line), fp)) {\n    char path[256], stored[65], extra;\n    unsigned long long dev, ino, vma, off, sz;\n    if (sscanf(line, \"%255s %llu %llu %64s %llu %llu %llu %c\",\n               path, &dev, &ino, stored, &vma, &off, &sz, &extra) != 7 ||\n        !valid_digest(stored)) {\n      bad = 1;\n      break;\n    }\n    (void)dev; (void)ino; (void)vma; (void)off; (void)sz;\n    char live[65];\n    if (file_sha256_hex(path, live) != 0 || strcmp(stored, live) != 0) {\n      bad = 1;\n      break;\n    }\n    ++rows;\n  }\n  if (ferror(fp)) bad = 1;\n  fclose(fp);\n  return (!bad && rows > 0) ? 0 : 1;\n}\nEOF\nmake -f /app/millhull/mill.mk hull\n"]
