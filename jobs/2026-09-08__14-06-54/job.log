p(name, "?") == 0) {\n      ok = 0;\n      break;\n    }\n    if (fprintf(out, "%llx %s\\n", pc, name) < 0) ok = 0;\n  }\n  if (ferror(lst)) ok = 0;\n  fclose(lst);\n  if (fclose(out) != 0) ok = 0;\n  return ok ? 0 : -1;\n}\nEOF\ncat > /app/cuewell/op_halt.cc <<\'EOF\'\n#include "halt.h"\n\n#include "sum.h"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic int valid_digest(const char *s) {\n  if (strlen(s) != 64) return 0;\n  for (int i = 0; i < 64; ++i)\n    if (!((s[i] >= \'0\' && s[i] <= \'9\') || (s[i] >= \'a\' && s[i] <= \'f\')))\n      return 0;\n  return 1;\n}\n\nint op_halt(void) {\n  FILE *fp = fopen("/app/wickbin/layout.qmap", "r");\n  if (!fp) return 1;\n  char line[1024];\n  if (!fgets(line, sizeof(line), fp) || strcmp(line, "QMAP1\\n") != 0) {\n    fclose(fp);\n    return 1;\n  }\n\n  int rows = 0;\n  int bad = 0;\n  while (fgets(line, sizeof(line), fp)) {\n    char path[256], stored[65], extra;\n    unsigned long long dev, ino, vma, off, sz;\n    if (sscanf(line, "%255s %llu %llu %64s %llu %llu %llu %c",\n               path, &dev, &ino, stored, &vma, &off, &sz, &extra) != 7 ||\n        !valid_digest(stored)) {\n      bad = 1;\n      break;\n    }\n    (void)dev; (void)ino; (void)vma; (void)off; (void)sz;\n    char live[65];\n    if (file_sha256_hex(path, live) != 0 || strcmp(stored, live) != 0) {\n      bad = 1;\n      break;\n    }\n    ++rows;\n  }\n  if (ferror(fp)) bad = 1;\n  fclose(fp);\n  return (!bad && rows > 0) ? 0 : 1;\n}\nEOF\nmake -f /app/millhull/mill.mk hull\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
