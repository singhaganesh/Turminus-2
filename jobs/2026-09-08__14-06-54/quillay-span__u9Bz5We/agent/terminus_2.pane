===== /app/wickdesk/op_mesh.cc =====
     1	#include "mesh.h"
     2	
     3	#include "elfbits.h"
     4	
     5	#include <stdio.h>
     6	#include <string.h>
     7	
     8	int op_mesh(const char *a, const struct Lay *b, int c) {
     9	  (void)a;
    10	  (void)b;
    11	  if (c) {
    12	    return 0;
    13	  }
    14	  FILE *lst = fopen("/app/spanhearth/pc.lst", "r");
    15	  FILE *out = fopen("/app/wickbin/flame.qprf", "w");
    16	  if (!lst || !out) {
    17	    if (lst) fclose(lst);
    18	    if (out) fclose(out);
    19	    return -1;
    20	  }
    21	  fprintf(out, "QPRF1\n");
    22	  char line[128];
    23	  while (fgets(line, sizeof(line), lst)) {
    24	    unsigned long long pc = 0;
    25	    if (sscanf(line, "%llx", &pc) != 1) continue;
    26	    char name[128];
    27	    name_at(a, pc, name, sizeof(name));
    28	    fprintf(out, "%llx %s\n", pc, name);
    29	  }
    30	  fclose(lst);
    31	  fclose(out);
    32	  return 0;
    33	}
