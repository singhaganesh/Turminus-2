    10	int op_halt(void) {
    11	  FILE *fp = fopen("/app/wickbin/layout.qmap", "r");
    12	  if (!fp) return 1;
    13	  char line[512];
    14	  if (!fgets(line, sizeof(line), fp)) {
    15	    fclose(fp);
    16	    return 1;
    17	  }
    18	  if (!fgets(line, sizeof(line), fp)) {
    19	    fclose(fp);
    20	    return 1;
    21	  }
    22	  fclose(fp);
    23	  char path[256], dig[65];
    24	  unsigned long long dev = 0, ino = 0, vma = 0, off = 0, sz = 0;
    25	  if (sscanf(line, "%255s %llu %llu %64s %llu %llu %llu", path, &dev, &ino, dig, &vma, &off,
    26	             &sz) != 7)
    27	    return 1;
    28	  (void)dig;
    29	  struct stat st;
    30	  if (stat(path, &st) != 0) return 1;
    31	  if ((unsigned long long)st.st_dev == dev && (unsigned long long)st.st_ino == ino &&
    32	      stamp_same(path, stamp_sec(path)))
    33	    return 0;
    34	  return 1;
    35	}
