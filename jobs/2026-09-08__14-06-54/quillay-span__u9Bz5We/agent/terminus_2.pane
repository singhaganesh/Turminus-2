     5	#include <string.h>
     6	
     7	static uint16_t u16(const unsigned char *p) {
     8	  return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
     9	}
    10	
    11	static uint32_t u32(const unsigned char *p) {
    12	  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
    13	         ((uint32_t)p[3] << 24);
    14	}
    15	
    16	static uint64_t u64(const unsigned char *p) {
    17	  uint64_t v = 0;
    18	  for (int i = 7; i >= 0; i--) v = (v << 8) | p[i];
    19	  return v;
    20	}
    21	
    22	static int slurp(const char *path, unsigned char **out, size_t *n) {
    23	  FILE *fp = fopen(path, "rb");
    24	  if (!fp) return -1;
    25	  fseek(fp, 0, SEEK_END);
    26	  long sz = ftell(fp);
    27	  if (sz < 64) {
    28	    fclose(fp);
    29	    return -1;
    30	  }
    31	  rewind(fp);
    32	  unsigned char *buf = new unsigned char[sz];
    33	  if (fread(buf, 1, sz, fp) != (size_t)sz) {
    34	    delete[] buf;
    35	    fclose(fp);
    36	    return -1;
    37	  }
    38	  fclose(fp);
    39	  *out = buf;
    40	  *n = (size_t)sz;
    41	  return 0;
    42	}
    43	
    44	int fill_text(const char *path, unsigned long long *vma, unsigned long long *off,
    45	               unsigned long long *sz) {
    46	  unsigned char *buf = 0;
    47	  size_t n = 0;
    48	  if (slurp(path, &buf, &n) != 0) return -1;
    49	  if (n < 64 || buf[0] != 0x7f || buf[1] != 'E' || buf[2] != 'L' || buf[3] != 'F') {
    50	    delete[] buf;
    51	    return -1;
    52	  }
    53	  uint64_t phoff = u64(buf + 32);
    54	  uint16_t phentsize = u16(buf + 54);
    55	  uint16_t phnum = u16(buf + 56);
    56	  int found = 0;
    57	  for (uint16_t i = 0; i < phnum; i++) {
    58	    unsigned char *ph = buf + phoff + (size_t)i * phentsize;
    59	    uint32_t type = u32(ph);
    60	    uint32_t flags = u32(ph + 4);
    61	    if (type == 1 && (flags & 1)) {
    62	      *off = u64(ph + 8);
    63	      *vma = u64(ph + 16);
    64	      *sz = u64(ph + 32);
    65	      found = 1;
    66	      break;
    67	    }
    68	  }
    69	  delete[] buf;
    70	  return found ? 0 : -1;
    71	}
    72	
    73	int name_at(const char *path, unsigned long long pc, char *out, int ncap) {
    74	  unsigned char *buf = 0;
    75	  size_t n = 0;
    76	  if (slurp(path, &buf, &n) != 0) return -1;
    77	  uint64_t shoff = u64(buf + 40);
    78	  uint16_t shentsize = u16(buf + 58);
    79	  uint16_t shnum = u16(buf + 60);
    80	  unsigned char *sym = 0, *str = 0;
    81	  uint64_t symsz = 0;
    82	  for (uint16_t i = 0; i < shnum; i++) {
    83	    unsigned char *sh = buf + shoff + (size_t)i * shentsize;
    84	    uint32_t type = u32(sh + 4);
    85	    if (type == 2) {
    86	      uint32_t link = u32(sh + 24);
    87	      uint64_t offset = u64(sh + 24 + 8);
    88	      uint64_t size = u64(sh + 32);
    89	      unsigned char *strsh = buf + shoff + (size_t)link * shentsize;
    90	      uint64_t stroff = u64(strsh + 24);
    91	      sym = buf + offset;
    92	      str = buf + stroff;
    93	      /* ELF64 SHT_SYMTAB: sh_offset at 24, sh_size at 32, sh_link at 40? */
    94	      (void)size;
    95	      symsz = u64(sh + 32);
    96	      (void)link;
    97	    }
    98	  }
    99	  /* Re-parse with correct ELF64 section header offsets. */
   100	  sym = 0;
   101	  str = 0;
   102	  symsz = 0;
   103	  for (uint16_t i = 0; i < shnum; i++) {
   104	    unsigned char *sh = buf + shoff + (size_t)i * shentsize;
   105	    uint32_t type = u32(sh + 4);
   106	    if (type != 2) continue;
   107	    uint32_t link = u32(sh + 40);
   108	    uint64_t offset = u64(sh + 24);
   109	    uint64_t size = u64(sh + 32);
   110	    unsigned char *strsh = buf + shoff + (size_t)link * shentsize;
   111	    uint64_t stroff = u64(strsh + 24);
   112	    sym = buf + offset;
   113	    str = buf + stroff;
   114	    symsz = size;
   115	  }
   116	  const char *best = "?";
   117	  unsigned long long best_v = 0;
   118	  if (sym && str) {
   119	    for (uint64_t i = 0; i + 24 <= symsz; i += 24) {
   120	      unsigned char *sy = sym + i;
   121	      uint32_t name = u32(sy);
   122	      unsigned char info = sy[4];
   123	      uint64_t value = u64(sy + 8);
   124	      uint64_t size = u64(sy + 16);
   125	      int bind = info >> 4;
   126	      int stype = info & 0xf;
   127	      if (stype != 2 || value == 0) continue;
   128	      (void)bind;
   129	      unsigned long long lo = value;
   130	      unsigned long long hi = value + (size ? size : 1);
   131	      if (pc >= lo && pc < hi && lo >= best_v) {
   132	        best_v = lo;
   133	        best = (const char *)(str + name);
   134	      }
   135	    }
   136	  }
   137	  snprintf(out, ncap, "%s", best);
   138	  delete[] buf;
   139	  return 0;
   140	}
