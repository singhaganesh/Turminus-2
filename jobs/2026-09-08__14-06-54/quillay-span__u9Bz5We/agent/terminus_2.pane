    10	
    11	static int read_row(struct Lay *b) {
    12	  FILE *fp = fopen("/app/wickbin/layout.qmap", "r");
    13	  if (!fp) return 0;
    14	  char line[512];
    15	  if (!fgets(line, sizeof(line), fp)) {
    16	    fclose(fp);
    17	    return 0;
    18	  }
    19	  if (!fgets(line, sizeof(line), fp)) {
    20	    fclose(fp);
    21	    return 0;
    22	  }
    23	  fclose(fp);
    24	  unsigned long long vma = 0, off = 0, sz = 0, dev = 0, ino = 0;
    25	  char path[256], dig[65];
    26	  memset(path, 0, sizeof(path));
    27	  memset(dig, 0, sizeof(dig));
    28	  if (sscanf(line, "%255s %llu %llu %64s %llu %llu %llu", path, &dev, &ino, dig, &vma, &off,
    29	             &sz) != 7)
    30	    return 0;
    31	  strncpy(b->path, path, sizeof(b->path) - 1);
    32	  b->dev = dev;
    33	  b->ino = ino;
    34	  strncpy(b->dig, dig, 64);
    35	  b->dig[64] = 0;
    36	  b->vma = vma;
    37	  b->off = off;
    38	  b->sz = sz;
    39	  return 1;
    40	}
    41	
    42	static int write_row(const struct Lay *b) {
    43	  FILE *fp = fopen("/app/wickbin/layout.qmap", "w");
    44	  if (!fp) return -1;
    45	  fprintf(fp, "QMAP1\n");
    46	  fprintf(fp, "%s %llu %llu %s %llu %llu %llu\n", b->path, b->dev, b->ino, b->dig, b->vma,
    47	          b->off, b->sz);
    48	  fclose(fp);
    49	  return 0;
    50	}
    51	
    52	int op_bind(const char *a, struct Lay *b) {
    53	  struct stat st;
    54	  if (stat(a, &st) != 0) return -1;
    55	  struct Lay old;
    56	  memset(&old, 0, sizeof(old));
    57	  int have = read_row(&old);
    58	  memset(b, 0, sizeof(*b));
    59	  strncpy(b->path, a, sizeof(b->path) - 1);
    60	  b->dev = (unsigned long long)st.st_dev;
    61	  b->ino = (unsigned long long)st.st_ino;
    62	  char hex[65];
    63	  if (file_sha256_hex(a, hex) != 0) return -1;
    64	  unsigned long long stored = 0;
    65	  FILE *ck = fopen("/app/wickbin/clock.txt", "r");
    66	  if (ck) {
    67	    fscanf(ck, "%llu", &stored);
    68	    fclose(ck);
    69	  }
    70	  if (have && old.dev == b->dev && old.ino == b->ino && stamp_same(a, stored)) {
    71	    *b = old;
    72	    strncpy(b->path, a, sizeof(b->path) - 1);
    73	    write_row(b);
    74	    return 1;
    75	  }
    76	  strncpy(b->dig, hex, 64);
    77	  b->dig[64] = 0;
    78	  if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) return -1;
    79	  FILE *cw = fopen("/app/wickbin/clock.txt", "w");
    80	  if (cw) {
    81	    fprintf(cw, "%llu\n", stamp_sec(a));
    82	    fclose(cw);
    83	  }
    84	  if (write_row(b) != 0) return -1;
    85	  return 0;
    86	}
