     6	
     7	static uint32_t rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }
     8	
     9	static void sha256_block(uint32_t s[8], const unsigned char blk[64]) {
    10	  static const uint32_t K[64] = {
    11	      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
    12	      0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    13	      0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
    14	      0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    15	      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
    16	      0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    17	      0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
    18	      0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    19	      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
    20	      0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    21	      0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
    22	  uint32_t w[64];
    23	  for (int i = 0; i < 16; i++) {
    24	    w[i] = ((uint32_t)blk[i * 4] << 24) | ((uint32_t)blk[i * 4 + 1] << 16) |
    25	           ((uint32_t)blk[i * 4 + 2] << 8) | (uint32_t)blk[i * 4 + 3];
    26	  }
    27	  for (int i = 16; i < 64; i++) {
    28	    uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
    29	    uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
    30	    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    31	  }
    32	  uint32_t a = s[0], b = s[1], c = s[2], d = s[3], e = s[4], f = s[5], g = s[6],
    33	           h = s[7];
    34	  for (int i = 0; i < 64; i++) {
    35	    uint32_t S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
    36	    uint32_t ch = (e & f) ^ ((~e) & g);
    37	    uint32_t t1 = h + S1 + ch + K[i] + w[i];
    38	    uint32_t S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
    39	    uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
    40	    uint32_t t2 = S0 + maj;
    41	    h = g;
    42	    g = f;
    43	    f = e;
    44	    e = d + t1;
    45	    d = c;
    46	    c = b;
    47	    b = a;
    48	    a = t1 + t2;
    49	  }
    50	  s[0] += a;
    51	  s[1] += b;
    52	  s[2] += c;
    53	  s[3] += d;
    54	  s[4] += e;
    55	  s[5] += f;
    56	  s[6] += g;
    57	  s[7] += h;
    58	}
    59	
    60	int file_sha256_hex(const char *path, char out[65]) {
    61	  FILE *fp = fopen(path, "rb");
    62	  if (!fp) return -1;
    63	  uint32_t s[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
    64	                   0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
    65	  unsigned char buf[64];
    66	  unsigned long long n = 0;
    67	  size_t r;
    68	  while ((r = fread(buf, 1, 64, fp)) == 64) {
    69	    sha256_block(s, buf);
    70	    n += 64;
    71	  }
    72	  n += r;
    73	  buf[r] = 0x80;
    74	  if (r + 1 + 8 <= 64) {
    75	    memset(buf + r + 1, 0, 64 - (r + 1) - 8);
    76	  } else {
    77	    memset(buf + r + 1, 0, 64 - (r + 1));
    78	    sha256_block(s, buf);
    79	    memset(buf, 0, 56);
    80	  }
    81	  unsigned long long bits = n * 8;
    82	  for (int i = 0; i < 8; i++) buf[63 - i] = (unsigned char)(bits >> (i * 8));
    83	  sha256_block(s, buf);
    84	  fclose(fp);
    85	  static const char *hex = "0123456789abcdef";
    86	  for (int i = 0; i < 8; i++) {
    87	    out[i * 8 + 0] = hex[(s[i] >> 28) & 0xf];
    88	    out[i * 8 + 1] = hex[(s[i] >> 24) & 0xf];
    89	    out[i * 8 + 2] = hex[(s[i] >> 20) & 0xf];
    90	    out[i * 8 + 3] = hex[(s[i] >> 16) & 0xf];
    91	    out[i * 8 + 4] = hex[(s[i] >> 12) & 0xf];
    92	    out[i * 8 + 5] = hex[(s[i] >> 8) & 0xf];
    93	    out[i * 8 + 6] = hex[(s[i] >> 4) & 0xf];
    94	    out[i * 8 + 7] = hex[s[i] & 0xf];
    95	  }
    96	  out[64] = 0;
    97	  return 0;
    98	}
