===== /app/millhull/elfbits.cc =====
     1	#include "elfbits.h"
     2	
     3	#include <stdint.h>
     4	#include <stdio.h>
     5	#include <string.h>
     6	
     7	static uint16_t u16(const unsigned char *p) {
     8	  return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
     9	}
    10	
    11	static uint32_t u32(const unsigned char *p) {
    12	  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
    13	         ((uint32_t)p[3] << 24);
    14	}
    15	
    16	static uint64_t u64(const unsigned char *p) {
    17	  uint64_t v = 0;
    18	  for (int i = 7; i >= 0; i--) v = (v << 8) | p[i];
    19	  return v;
    20	}
    21	
    22	static int slurp(const char *path, unsigned char **out, size_t *n) {
    23	  FILE *fp = fopen(path, "rb");
    24	  if (!fp) return -1;
    25	  fseek(fp, 0, SEEK_END);
    26	  long sz = ftell(fp);
    27	  if (sz < 64) {
    28	    fclose(fp);
    29	    return -1;
    30	  }
    31	  rewind(fp);
    32	  unsigned char *buf = new unsigned char[sz];
    33	  if (fread(buf, 1, sz, fp) != (size_t)sz) {
    34	    delete[] buf;
    35	    fclose(fp);
    36	    return -1;
    37	  }
    38	  fclose(fp);
    39	  *out = buf;
    40	  *n = (size_t)sz;
    41	  return 0;
    42	}
    43	
    44	int fill_text(const char *path, unsigned long long *vma, unsigned long long *off,
    45	               unsigned long long *sz) {
    46	  unsigned char *buf = 0;
    47	  size_t n = 0;
    48	  if (slurp(path, &buf, &n) != 0) return -1;
    49	  if (n < 64 || buf[0] != 0x7f || buf[1] != 'E' || buf[2] != 'L' || buf[3] != 'F') {
    50	    delete[] buf;
    51	    return -1;
    52	  }
    53	  uint64_t phoff = u64(buf + 32);
    54	  uint16_t phentsize = u16(buf + 54);
    55	  uint16_t phnum = u16(buf + 56);
    56	  int found = 0;
    57	  for (uint16_t i = 0; i < phnum; i++) {
    58	    unsigned char *ph = buf + phoff + (size_t)i * phentsize;
    59	    uint32_t type = u32(ph);
    60	    uint32_t flags = u32(ph + 4);
    61	    if (type == 1 && (flags & 1)) {
    62	      *off = u64(ph + 8);
    63	      *vma = u64(ph + 16);
    64	      *sz = u64(ph + 32);
    65	      found = 1;
    66	      break;
    67	    }
    68	  }
    69	  delete[] buf;
    70	  return found ? 0 : -1;
    71	}
    72	
    73	int name_at(const char *path, unsigned long long pc, char *out, int ncap) {
    74	  unsigned char *buf = 0;
    75	  size_t n = 0;
    76	  if (slurp(path, &buf, &n) != 0) return -1;
    77	  uint64_t shoff = u64(buf + 40);
    78	  uint16_t shentsize = u16(buf + 58);
    79	  uint16_t shnum = u16(buf + 60);
    80	  unsigned char *sym = 0, *str = 0;
    81	  uint64_t symsz = 0;
    82	  for (uint16_t i = 0; i < shnum; i++) {
    83	    unsigned char *sh = buf + shoff + (size_t)i * shentsize;
    84	    uint32_t type = u32(sh + 4);
    85	    if (type == 2) {
    86	      uint32_t link = u32(sh + 24);
    87	      uint64_t offset = u64(sh + 24 + 8);
    88	      uint64_t size = u64(sh + 32);
    89	      unsigned char *strsh = buf + shoff + (size_t)link * shentsize;
    90	      uint64_t stroff = u64(strsh + 24);
    91	      sym = buf + offset;
    92	      str = buf + stroff;
    93	      /* ELF64 SHT_SYMTAB: sh_offset at 24, sh_size at 32, sh_link at 40? */
    94	      (void)size;
    95	      symsz = u64(sh + 32);
    96	      (void)link;
    97	    }
    98	  }
    99	  /* Re-parse with correct ELF64 section header offsets. */
   100	  sym = 0;
   101	  str = 0;
   102	  symsz = 0;
   103	  for (uint16_t i = 0; i < shnum; i++) {
   104	    unsigned char *sh = buf + shoff + (size_t)i * shentsize;
   105	    uint32_t type = u32(sh + 4);
   106	    if (type != 2) continue;
   107	    uint32_t link = u32(sh + 40);
   108	    uint64_t offset = u64(sh + 24);
   109	    uint64_t size = u64(sh + 32);
   110	    unsigned char *strsh = buf + shoff + (size_t)link * shentsize;
   111	    uint64_t stroff = u64(strsh + 24);
   112	    sym = buf + offset;
   113	    str = buf + stroff;
   114	    symsz = size;
   115	  }
   116	  const char *best = "?";
   117	  unsigned long long best_v = 0;
   118	  if (sym && str) {
   119	    for (uint64_t i = 0; i + 24 <= symsz; i += 24) {
   120	      unsigned char *sy = sym + i;
   121	      uint32_t name = u32(sy);
   122	      unsigned char info = sy[4];
   123	      uint64_t value = u64(sy + 8);
   124	      uint64_t size = u64(sy + 16);
   125	      int bind = info >> 4;
   126	      int stype = info & 0xf;
   127	      if (stype != 2 || value == 0) continue;
   128	      (void)bind;
   129	      unsigned long long lo = value;
   130	      unsigned long long hi = value + (size ? size : 1);
   131	      if (pc >= lo && pc < hi && lo >= best_v) {
   132	        best_v = lo;
   133	        best = (const char *)(str + name);
   134	      }
   135	    }
   136	  }
   137	  snprintf(out, ncap, "%s", best);
   138	  delete[] buf;
   139	  return 0;
   140	}
===== /app/millhull/main.cc =====
     1	#include "halt.h"
     2	
     3	int go_scribe(void);
     4	
     5	#include <fcntl.h>
     6	#include <stdio.h>
     7	#include <stdlib.h>
     8	#include <string.h>
     9	#include <sys/stat.h>
    10	#include <unistd.h>
    11	
    12	#include "stamp.h"
    13	
    14	static int do_knit(void) {
    15	  FILE *wf = fopen("/app/spanhearth/wave.txt", "r");
    16	  int wave = 1;
    17	  if (wf) {
    18	    fscanf(wf, "%d", &wave);
    19	    fclose(wf);
    20	  }
    21	  char cmd[256];
    22	  snprintf(cmd, sizeof(cmd),
    23	           "gcc -no-pie -fno-pie -O0 -DWAVE=%d -o /tmp/span.new /app/spanhearth/load.c",
    24	           wave);
    25	  if (system(cmd) != 0) return 1;
    26	  FILE *in = fopen("/tmp/span.new", "rb");
    27	  FILE *out = fopen("/app/hearthbin/span.elf", "r+b");
    28	  if (!out) {
    29	    out = fopen("/app/hearthbin/span.elf", "wb");
    30	  }
    31	  if (!in || !out) {
    32	    if (in) fclose(in);
    33	    if (out) fclose(out);
    34	    return 1;
    35	  }
    36	  char buf[4096];
    37	  size_t n;
    38	  long total = 0;
    39	  rewind(out);
    40	  while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {
    41	    if (fwrite(buf, 1, n, out) != n) {
    42	      fclose(in);
    43	      fclose(out);
    44	      return 1;
    45	    }
    46	    total += (long)n;
    47	  }
    48	  fclose(in);
    49	  if (ftruncate(fileno(out), total) != 0) {
    50	    fclose(out);
    51	    return 1;
    52	  }
    53	  fclose(out);
    54	  chmod("/app/hearthbin/span.elf", 0755);
    55	  stamp_zero("/app/hearthbin/span.elf");
    56	  FILE *nm = popen("nm -P /app/hearthbin/span.elf", "r");
    57	  FILE *pc = fopen("/app/spanhearth/pc.lst", "w");
    58	  if (!nm || !pc) return 1;
    59	  char line[256];
    60	  while (fgets(line, sizeof(line), nm)) {
    61	    char name[128], typ[8];
    62	    unsigned long long addr = 0, sz = 0;
    63	    if (sscanf(line, "%127s %7s %llx %llx", name, typ, &addr, &sz) >= 3) {
    64	      if (strcmp(name, "ring_pump") == 0 || strcmp(name, "dusk_lamp") == 0 ||
    65	          strcmp(name, "held_wick") == 0) {
    66	        fprintf(pc, "%llx\n", addr);
    67	      }
    68	    }
    69	  }
    70	  pclose(nm);
    71	  fclose(pc);
    72	  return 0;
    73	}
    74	
    75	int main(int argc, char **argv) {
    76	  if (argc < 2) return 2;
    77	  if (strcmp(argv[1], "tamp") == 0) return do_knit();
    78	  if (strcmp(argv[1], "scribe") == 0) return go_scribe();
    79	  if (strcmp(argv[1], "weigh") == 0) return op_halt();
    80	  return 2;
    81	}
===== /app/millhull/op_bind.cc =====
     1	#include "bind.h"
     2	
     3	#include "elfbits.h"
     4	#include "stamp.h"
