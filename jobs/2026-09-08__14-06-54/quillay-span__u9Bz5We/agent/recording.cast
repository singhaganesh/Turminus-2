[63.798264, "o", "g++ -O2 -Wall -Wextra -std=c++17 -I/app/millhull -I/app/cuewell -I/app/wickdesk -I/app/offpack -o /app/bin/quillay /app/millhull/main.cc /app/millhull/drive.cc \\\r\n  /app/millhull/op_bind.cc /app/millhull/elfbits.cc \\\r\n  /app/cuewell/op_halt.cc /app/wickdesk/op_mesh.cc \\\r\n  /app/offpack/stamp.cc /tmp/sum.o\r\n"]
