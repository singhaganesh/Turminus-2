[28.566306, "i", "echo '===== op_bind ====='; cat /app/millhull/op_bind.cc; echo '===== op_mesh ====='; cat /app/wickdesk/op_mesh.cc; echo '===== op_halt ====='; cat /app/cuewell/op_halt.cc; echo '===== auxiliary text ====='; for f in /app/baycue/shift.txt /app/wickbin/clock.txt; do echo \"--- $f\"; cat \"$f\"; done\n"]
[28.567211, "o", "echo '===== op_bind ====='; cat /app/millhull/op_bind.cc; echo '===== op_mesh ====='; cat /app/wickdesk/op_mesh.cc; echo '===== op_halt ====='; cat /app/cuewell/op_halt.cc; echo '===== auxiliary text ====='; for f in /app/baycue/shift.txt /app/wickbin/clock.txt; do echo \"--- $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[28.567369, "o", "===== op_bind =====\r\n"]
[28.568597, "o", "#include \"bind.h\"\r\n\r\n#include \"elfbits.h\"\r\n#include \"stamp.h\"\r\n#include \"sum.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\nstatic int read_row(struct Lay *b) {\r\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n  if (!fp) return 0;\r\n  char line[512];\r\n  if (!fgets(line, sizeof(line), fp)) {\r\n    fclose(fp);\r\n    return 0;\r\n  }\r\n  if (!fgets(line, sizeof(line), fp)) {\r\n    fclose(fp);\r\n    return 0;\r\n  }\r\n  fclose(fp);\r\n  unsigned long long vma = 0, off = 0, sz = 0, dev = 0, ino = 0;\r\n  char path[256], dig[65];\r\n  memset(path, 0, sizeof(path));\r\n  memset(dig, 0, sizeof(dig));\r\n  if (sscanf(line, \"%255s %llu %llu %64s %llu %llu %llu\", path, &dev, &ino, dig, &vma, &off,\r\n             &sz) != 7)\r\n    return 0;\r\n  strncpy(b->path, path, sizeof(b->path) - 1);\r\n  b->dev = dev;\r\n  b->ino = ino;\r\n  strncpy(b->dig, dig, 64);\r\n  b->dig[64] = 0;\r\n  b->vma = vma;\r\n  b->off = off;\r\n  b->sz = sz;\r\n  return 1;\r\n}\r\n\r\nstatic int write_row(const struct Lay *b) {\r\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"w\");\r\n  if (!fp) return -1;\r\n  fprintf(fp, \"QMAP1\\n\");\r\n  fprintf(fp, \"%s %llu %llu %s %llu %llu %llu\\n\", b->path, b->dev, b->ino, b->dig, b->vma,\r\n          b->off, b->sz);\r\n  fclose(fp);\r\n  return 0;\r\n}\r\n\r\nint op_bind(const char *a, struct Lay *b) {\r\n  struct stat st;\r\n  if (stat(a, &st) != 0) return -1;\r\n  struct Lay old;\r\n  memset(&old, 0, sizeof(old));\r\n  int have = read_row(&old);\r\n  memset(b, 0, sizeof(*b));\r\n  strncpy(b->path, a, sizeof(b->path) - 1);\r\n  b->dev = (unsigned long long)st.st_dev;\r\n  b->ino = (unsigned long long)st.st_ino;\r\n  char hex[65];\r\n  if (file_sha256_hex(a, hex) != 0) return -1;\r\n  unsigned long long stored = 0;\r\n  FILE *ck = fopen(\"/app/wickbin/clock.txt\", \"r\");\r\n  if (ck) {\r\n    fscanf(ck, \"%llu\", &stored);\r\n    fclose(ck);\r\n  }\r\n  if (have && old.dev == b->dev && old.ino == b->ino && stamp_same(a, stored)) {\r\n    *b = old;\r\n    strncpy(b->path, a, sizeof(b->path) - 1);\r\n    write_row(b);\r\n    return 1;\r\n  }\r\n  strncpy(b->dig, hex, 64);\r\n  b->dig[64] = 0;\r\n  if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) return -1;\r\n  FILE *cw = fopen(\"/app/wickbin/clock.txt\", \"w\");\r\n  if (cw) {\r\n    fprintf(cw, \"%llu\\n\", stamp_sec(a));\r\n    fclose(cw);\r\n  }\r\n  if (write_row(b) != 0) return -1;\r\n"]
[28.568725, "o", "  return 0;\r\n}\r\n"]
[28.568821, "o", "===== op_mesh =====\r\n"]
[28.569646, "o", "#include \"mesh.h\"\r\n\r\n#include \"elfbits.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint op_mesh(const char *a, const struct Lay *b, int c) {\r\n  (void)a;\r\n  (void)b;\r\n  if (c) {\r\n    return 0;\r\n  }\r\n  FILE *lst = fopen(\"/app/spanhearth/pc.lst\", \"r\");\r\n  FILE *out = fopen(\"/app/wickbin/flame.qprf\", \"w\");\r\n  if (!lst || !out) {\r\n    if (lst) fclose(lst);\r\n    if (out) fclose(out);\r\n    return -1;\r\n  }\r\n  fprintf(out, \"QPRF1\\n\");\r\n  char line[128];\r\n  while (fgets(line, sizeof(line), lst)) {\r\n    unsigned long long pc = 0;\r\n    if (sscanf(line, \"%llx\", &pc) != 1) continue;\r\n    char name[128];\r\n    name_at(a, pc, name, sizeof(name));\r\n    fprintf(out, \"%llx %s\\n\", pc, name);\r\n  }\r\n  fclose(lst);\r\n  fclose(out);\r\n  return 0;\r\n}\r\n"]
[28.569797, "o", "===== op_halt =====\r\n"]
[28.570636, "o", "#include \"halt.h\"\r\n\r\n#include \"lay.h\"\r\n#include \"stamp.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\nint op_halt(void) {\r\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n  if (!fp) return 1;\r\n  char line[512];\r\n  if (!fgets(line, sizeof(line), fp)) {\r\n    fclose(fp);\r\n    return 1;\r\n  }\r\n  if (!fgets(line, sizeof(line), fp)) {\r\n    fclose(fp);\r\n    return 1;\r\n  }\r\n  fclose(fp);\r\n  char path[256], dig[65];\r\n  unsigned long long dev = 0, ino = 0, vma = 0, off = 0, sz = 0;\r\n  if (sscanf(line, \"%255s %llu %llu %64s %llu %llu %llu\", path, &dev, &ino, dig, &vma, &off,\r\n             &sz) != 7)\r\n    return 1;\r\n  (void)dig;\r\n  struct stat st;\r\n  if (stat(path, &st) != 0) return 1;\r\n  if ((unsigned long long)st.st_dev == dev && (unsigned long long)st.st_ino == ino &&\r\n      stamp_same(path, stamp_sec(path)))\r\n    return 0;\r\n  return 1;\r\n}\r\n"]
[28.570817, "o", "===== auxiliary text =====\r\n"]
[28.570903, "o", "--- /app/baycue/shift.txt\r\n"]
[28.571631, "o", "Tamp rewrites span.elf in place and zeros the modification stamp so two tamps look like the same object on a listing. Scribe still returns 0 afterward. Weigh still exits 0.\r\n"]
[28.571811, "o", "--- /app/wickbin/clock.txt\r\n"]
[28.572608, "o", "0\r\n"]
[28.572845, "o", "\u001b[?2004hroot@c9b088e7e1c3:/app# "]
[37.932309, "i", "nl -ba /app/millhull/elfbits.cc | sed -n '70,180p'; cat /app/offpack/sum.h; cat /app/cuewell/halt.h\n"]
[37.932818, "o", "nl -ba /app/millhull/elfbits.cc | sed -n '70,180p'; cat /app/offpack/sum.h; cat /app/cuewell/halt.h\r\n\u001b[?2004l\r"]
[37.934586, "o", "    70\t  return found ? 0 : -1;\r\n    71\t}\r\n    72\t\r\n    73\tint name_at(const char *path, unsigned long long pc, char *out, int ncap) {\r\n    74\t  unsigned char *buf = 0;\r\n    75\t  size_t n = 0;\r\n    76\t  if (slurp(path, &buf, &n) != 0) return -1;\r\n    77\t  uint64_t shoff = u64(buf + 40);\r\n    78\t  uint16_t shentsize = u16(buf + 58);\r\n    79\t  uint16_t shnum = u16(buf + 60);\r\n    80\t  unsigned char *sym = 0, *str = 0;\r\n    81\t  uint64_t symsz = 0;"]
[37.934759, "o", "\r\n    82\t  for (uint16_t i = 0; i < shnum; i++) {\r\n    83\t    unsigned char *sh = buf + shoff + (size_t)i * shentsize;\r\n    84\t    uint32_t type = u32(sh + 4);\r\n    85\t    if (type == 2) {\r\n    86\t      uint32_t link = u32(sh + 24);\r\n    87\t      uint64_t offset = u64(sh + 24 + 8);\r\n    88\t      uint64_t size = u64(sh + 32);\r\n    89\t      unsigned char *strsh = buf + shoff + (size_t)link * shentsize;\r\n    90\t      uint64_t stroff = u64(strsh + 24);\r\n    91\t      sym = buf + offset;\r\n    92\t      str = buf + stroff;\r\n    93\t      /* ELF64 SHT_SYMTAB: sh_offset at 24, sh_size at 32, sh_link at 40? */\r\n    94\t      (void)size;\r\n    95\t      symsz = u64(sh + 32);\r\n    96\t      (void)link;\r\n    97\t    }\r\n    98\t  }\r\n    99\t  /* Re-parse with correct ELF64 section header offsets. */\r\n"]
[37.934828, "o", "   100\t  sym = 0;\r\n   101\t  str = 0;\r\n   102\t  symsz = 0;\r\n   103\t  for (uint16_t i = 0; i < shnum; i++) {\r\n   104\t    unsigned char *sh = buf + shoff + (size_t)i * shentsize;\r\n   105\t    uint32_t type = u32(sh + 4);\r\n   106\t    if (type != 2) continue;\r\n   107\t    uint32_t link = u32(sh + 40);\r\n   108\t    uint64_t offset = u64(sh + 24);\r\n   109\t    uint64_t size = u64(sh + 32);\r\n   110\t    unsigned char *strsh = buf + shoff + (size_t)link * shentsize;\r\n   111\t    uint64_t stroff = u64(strsh + 24);\r\n   112\t    sym = buf + offset;\r\n   113\t    str = buf + stroff;\r\n   114\t    symsz = size;\r\n   115\t  }\r\n   116\t  const char *best = \"?\";\r\n   117\t  unsigned long long best_v = 0;\r\n   118\t  if (sym && str) {\r\n   119\t    for (uint64_t i = 0; i + 24 <= symsz; i += 24) {\r\n   120\t      unsigned char *sy = sym + i;\r\n   121\t      uint32_t name = u32(sy);\r\n   122\t      unsigned char info = sy[4];\r\n   123\t      uint64_t value = u64(sy + 8);\r\n   124\t      uint64_t size = u64(sy + 16);\r\n   125\t      int bind = info >> 4;\r\n   126\t      int stype = info & 0xf;\r\n   127\t      if (stype != 2 || value == 0) continue;\r\n   128\t      (void)bind;\r\n   129\t      unsigned long long lo = value;\r\n   130\t      unsigned long long hi = value + (size ? size : 1);\r\n   131\t      if (pc >= lo && pc < hi && lo >= best_v) {\r\n   132\t        best_v = lo;\r\n   133\t        best = (const char *)(str + name);\r\n   134\t      }\r\n   135\t    }\r\n   136\t  }\r\n   137\t  snprintf(out, ncap, \"%s\", best);\r\n   138\t  delete[] buf;\r\n"]
[37.934853, "o", "   139\t  return 0;\r\n   140\t}\r\n"]
[37.936005, "o", "#ifndef SUM_H\r\n#define SUM_H\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\nint file_sha256_hex(const char *path, char out[65]);\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif\r\n"]
[37.936961, "o", "#ifndef HALT_H\r\n#define HALT_H\r\n\r\nint op_halt(void);\r\n\r\n#endif\r\n"]
[37.937166, "o", "\u001b[?2004h"]
[37.937201, "o", "root@c9b088e7e1c3:/app# "]
[63.676002, "i", "cat > /app/millhull/op_bind.cc <<'EOF'\n#include \"bind.h\"\n\n#include \"elfbits.h\"\n#include \"sum.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nstatic int write_row(const struct Lay *b) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"w\");\n  if (!fp) return -1;\n  int ok = fprintf(fp, \"QMAP1\\n%s %llu %llu %s %llu %llu %llu\\n\",\n                   b->path, b->dev, b->ino, b->dig,\n                   b->vma, b->off, b->sz) >= 0;\n  if (fclose(fp) != 0) ok = 0;\n  return ok ? 0 : -1;\n}\n\nint op_bind(const char *path, struct Lay *lay) {\n  struct stat st;\n  if (stat(path, &st) != 0) return -1;\n\n  memset(lay, 0, sizeof(*lay));\n  if (strlen(path) >= sizeof(lay->path)) return -1;\n  strcpy(lay->path, path);\n  lay->dev = (unsigned long long)st.st_dev;\n  lay->ino = (unsigned long long)st.st_ino;\n\n  /* Content, not inode or coarse mtime, is the identity of a mapping. */\n  if (file_sha256_hex(path, lay->dig) != 0) return -1;\n  if (fill_text(path, &lay->vma, &lay->off, &lay->sz) != 0) return -1;\n  if (write_row(lay) != 0) return -1;\n  return 0;\n}\nEOF\ncat > /app/wickdesk/op_mesh.cc <<'EOF'\n#include \"mesh.h\"\n\n#include \"elfbits.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nint op_mesh(const char *path, const struct Lay *lay, int reuse) {\n  (void)lay;\n  (void)reuse;\n\n  /* pc.lst and the ELF can both change between invocations.  Always paint\n     the profile from the live inputs rather than retaining an old profile. */\n  FILE *lst = fopen(\"/app/spanhearth/pc.lst\", \"r\");\n  FILE *out = fopen(\"/app/wickbin/flame.qprf\", \"w\");\n  if (!lst || !out) {\n    if (lst) fclose(lst);\n    if (out) fclose(out);\n    return -1;\n  }\n\n  int ok = fprintf(out, \"QPRF1\\n\") >= 0;\n  char line[128];\n  while (ok && fgets(line, sizeof(line), lst)) {\n    unsigned long long pc;\n    char tail;\n    if (sscanf(line, \"%llx %c\", &pc, &tail) != 1) {\n      ok = 0;\n      break;\n    }\n    char name[128];\n    if (name_at(path, pc, name, sizeof(name)) != 0 || strcmp(name, \"?\") == 0) {\n      ok = 0;\n      break;\n    }\n    if (fprintf(out, \"%llx %s\\n\", pc, name) < 0) ok = 0;\n  }\n  if (ferror(lst)) ok = 0;\n  if (fclose(lst) != 0) ok = 0;\n  if (fclose(out) != 0) ok = 0;\n  return ok ? 0 : -1;\n}\nEOF\ncat > /app/cuewell/op_halt.cc <<'EOF'\n#include \"halt.h\"\n\n#include \"sum.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic int valid_digest(const char *s) {\n  if (strlen(s) != 64) return 0;\n  for (int i = 0; i < 64; ++i)\n    if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')))\n      return 0;\n  return 1;\n}\n\nint op_halt(void) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\n  if (!fp) return 1;\n\n  char line[1024];\n  if (!fgets(line, sizeof(line), fp) || strcmp(line, \"QMAP1\\n\") != 0) {\n    fclose(fp);\n    return 1;\n  }\n\n  int rows = 0;\n  while (fgets(line, sizeof(line), fp)) {\n    char path[256], stored[65], extra;\n    unsigned long long dev, ino, vma, off, sz;\n    if (sscanf(line, \"%255s %llu %llu %64s %llu %llu %llu %c\",\n               path, &dev, &ino, stored, &vma, &off, &sz, &extra) != 7 ||\n        !valid_digest(stored)) {\n      fclose(fp);\n      return 1;\n    }\n    char current[65];\n    if (file_sha256_hex(path, current) != 0 || strcmp(stored, current) != 0) {\n      fclose(fp);\n      return 1;\n    }\n    ++rows;\n  }\n  int bad = ferror(fp) || rows == 0;\n  fclose(fp);\n  return bad ? 1 : 0;\n}\nEOF\nmake -f /app/millhull/mill.mk hull\n"]
