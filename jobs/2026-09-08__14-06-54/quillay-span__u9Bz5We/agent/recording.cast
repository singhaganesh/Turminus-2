[19.085236, "o", "     6\t#include <utime.h>\r\n     7\t\r\n     8\tunsigned long long stamp_sec(const char *path) {\r\n     9\t  struct stat st;\r\n    10\t  if (stat(path, &st) != 0) return 0;\r\n    11\t  return (unsigned long long)st.st_mtime;\r\n    12\t}\r\n    13\t\r\n    14\tint stamp_same(const char *path, unsigned long long old_sec) {\r\n    15\t  return stamp_sec(path) == old_sec;\r\n    16\t}\r\n"]
[19.085313, "o", "    17\t\r\n    18\tint stamp_zero(const char *path) {\r\n    19\t  struct utimbuf u;\r\n    20\t  u.actime = 0;\r\n    21\t  u.modtime = 0;\r\n    22\t  return utime(path, &u);\r\n    23\t}\r\n"]
