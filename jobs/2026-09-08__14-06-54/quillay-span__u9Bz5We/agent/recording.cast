[27.963706, "o", "     1\t#include \"bind.h\"\r\n     2\t\r\n     3\t#include \"elfbits.h\"\r\n     4\t#include \"stamp.h\"\r\n     5\t#include \"sum.h\"\r\n     6\t\r\n     7\t#include <stdio.h>\r\n     8\t#include <string.h>\r\n     9\t#include <sys/stat.h>\r\n    10\t\r\n    11\tstatic int read_row(struct Lay *b) {\r\n    12\t  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n    13\t  if (!fp) return 0;\r\n    14\t  char line[512];\r\n"]
[27.963854, "o", "    15\t  if (!fgets(line, sizeof(line), fp)) {\r\n    16\t    fclose(fp);\r\n    17\t    return 0;\r\n    18\t  }\r\n    19\t  if (!fgets(line, sizeof(line), fp)) {\r\n    20\t    fclose(fp);\r\n    21\t    return 0;\r\n    22\t  }\r\n    23\t  fclose(fp);\r\n    24\t  unsigned long long vma = 0, off = 0, sz = 0, dev = 0, ino = 0;\r\n    25\t  char path[256], dig[65];\r\n    26\t  memset(path, 0, sizeof(path));\r\n    27\t  memset(dig, 0, sizeof(dig));\r\n    28\t  if (sscanf(line, \"%255s %llu %llu %64s %llu %llu %llu\", path, &dev, &ino, dig, &vma, &off,\r\n    29\t             &sz) != 7)\r\n    30\t    return 0;\r\n    31\t  strncpy(b->path, path, sizeof(b->path) - 1);\r\n    32\t  b->dev = dev;\r\n    33\t  b->ino = ino;\r\n    34\t  strncpy(b->dig, dig, 64);\r\n    35\t  b->dig[64] = 0;\r\n    36\t  b->vma = vma;\r\n    37\t  b->off = off;\r\n    38\t  b->sz = sz;\r\n    39\t  return 1;\r\n    40\t}\r\n    41\t\r\n    42\tstatic int write_row(const struct Lay *b) {\r\n    43\t  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"w\");\r\n    44\t  if (!fp) return -1;\r\n    45\t  fprintf(fp, \"QMAP1\\n\");\r\n    46\t  fprintf(fp, \"%s %llu %llu %s %llu %llu %llu\\n\", b->path, b->dev, b->ino, b->dig, b->vma,\r\n    47\t          b->off, b->sz);\r\n    48\t  fclose(fp);\r\n    49\t  return 0;\r\n    50\t}\r\n    51\t\r\n    52\tint op_bind(const char *a, struct Lay *b) {\r\n    53\t  struct stat st;\r\n    54\t  if (stat(a, &st) != 0) return -1;\r\n    55\t  struct Lay old;\r\n    56\t  memset(&old, 0, sizeof(old));\r\n    57\t  int have = read_row(&old);\r\n    58\t  memset(b, 0, sizeof(*b));\r\n    59\t  strncpy(b->path, a, sizeof(b->path) - 1);\r\n    60\t  b->dev = (unsigned long long)st.st_dev;\r\n    61\t  b->ino = (unsigned long long)st.st_ino;\r\n    62\t  char hex[65];\r\n    63\t  if (file_sha256_hex(a, hex) != 0) return -1;\r\n    64\t  unsigned long long stored = 0;\r\n"]
[27.96395, "o", "    65\t  FILE *ck = fopen(\"/app/wickbin/clock.txt\", \"r\");\r\n    66\t  if (ck) {\r\n    67\t    fscanf(ck, \"%llu\", &stored);\r\n    68\t    fclose(ck);\r\n    69\t  }\r\n    70\t  if (have && old.dev == b->dev && old.ino == b->ino && stamp_same(a, stored)) {\r\n    71\t    *b = old;\r\n    72\t    strncpy(b->path, a, sizeof(b->path) - 1);\r\n    73\t    write_row(b);\r\n    74\t    return 1;\r\n    75\t  }\r\n    76\t  strncpy(b->dig, hex, 64);\r\n    77\t  b->dig[64] = 0;\r\n    78\t  if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) return -1;\r\n    79\t  FILE *cw = fopen(\"/app/wickbin/clock.txt\", \"w\");\r\n    80\t  if (cw) {\r\n    81\t    fprintf(cw, \"%llu\\n\", stamp_sec(a));\r\n    82\t    fclose(cw);\r\n    83\t  }\r\n    84\t  if (write_row(b) != 0) return -1;\r\n    85\t  return 0;\r\n    86\t}\r\n"]
