[63.693007, "o", "#include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r"]
[63.693117, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.693247, "o", "static int valid_digest(const char *s) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.693353, "o", "> "]
[63.693454, "o", "  if (strlen(s) != 64) return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.693548, "o", "  for (int i = 0; i < 64; ++i)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.69363, "o", "> "]
[63.693826, "o", "    if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f')))\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.693868, "o", "> "]
[63.694003, "o", "      return 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.694092, "o", ">   return 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.694197, "o", "> "]
[63.694324, "o", "int op_halt(void) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.694451, "o", "  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.69452, "o", "> "]
[63.694561, "o", "  if (!fp) return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.694616, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.694664, "o", "> "]
[63.694725, "o", "  char line[1024];\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.694767, "o", "> "]
[63.695002, "o", "  if (!fgets(line, sizeof(line), fp) || strcmp(line, \"QMAP1\\n\") != 0) {\r\n\u001b[?2004l\r"]
[63.695088, "o", "\u001b[?2004h>     fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.695179, "o", ">     return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.695227, "o", ">   }\r\n\u001b[?2004l\r"]
[63.695444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   int rows = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.695594, "o", "> "]
[63.695756, "o", "  while (fgets(line, sizeof(line), fp)) {\r\n\u001b[?2004l\r"]
[63.695955, "o", "\u001b[?2004h>     char path[256], stored[65], extra;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.696148, "o", "    unsigned long long dev, ino, vma, off, sz;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.69671, "o", "    if (sscanf(line, \"%255s %llu %llu %64s %llu %llu %llu %c\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.697485, "o", "               path, &dev, &ino, stored, &vma, &off, &sz, &extra) != 7 ||\r\n\u001b[?2004l\r\u001b[?2004h>         !valid_digest(stored)) {\r\n\u001b[?2004l\r"]
[63.698025, "o", "\u001b[?2004h>       fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h>       return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     char current[65];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.698289, "o", "    if (file_sha256_hex(path, current) != 0 || strcmp(stored, current) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>       fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.698393, "o", "      return 1;\r\n\u001b[?2004l\r"]
[63.698473, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.698551, "o", "> "]
[63.698622, "o", "    ++rows;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[63.698672, "o", "\u001b[?2004h> "]
[63.699053, "o", "  int bad = ferror(fp) || rows == 0;\r\n\u001b[?2004l\r\u001b[?2004h>   fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.699242, "o", "  return bad ? 1 : 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[63.699367, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
