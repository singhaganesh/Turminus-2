[9.957454, "o", "\r\n\u001b[?2004l\r"]
[9.959283, "o", "millhull   CLI, bind, drive, and ELF helpers\r\ncuewell    weigh status\r\nwickdesk   flame emit\r\noffpack    checksum helper and stamp notes\r\nspanhearth workload units and pc.lst\r\nhearthbin  mapped ELF\r\nwickbin    layout.qmap and flame.qprf\r\n"]
[9.959515, "o", "\r\n--- forms ---\r\n"]
[9.960927, "o", "layout.qmap\r\n  First line: QMAP1\r\n  Later lines: path device inode digest_hex text_vma text_off text_sz\r\n  device and inode are decimal from the mapped file.\r\n  digest_hex is 64 lowercase hex digits of sha256 over the file at path.\r\n  text_vma, text_off, text_sz are decimal integers from the executable load segment.\r\n\r\nflame.qprf\r\n  First line: QPRF1\r\n  Later lines: pc_hex name\r\n  pc_hex is lowercase hex without a 0x prefix.\r\n  name is the live symbol covering that PC in /app/hearthbin/span.elf.\r\n\r\npc.lst\r\n  One lowercase hex PC per line.\r\n\r\nload.c\r\n  tamp compiles /app/spanhearth/load.c; /app/spanhearth/wave.txt selects the generation.\r\n"]
[9.961303, "o", "\u001b[?2004hroot@c9b088e7e1c3:/app# "]
[10.084483, "i", "find /app -maxdepth 3 -type f -printf '%p\\n' | sort\n"]
