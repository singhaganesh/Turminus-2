[19.066969, "o", "for f in /app/millhull/mill.mk /app/millhull/*.h /app/millhull/*.cc /app/wickdesk/*.h /app/wickdesk/*.cc /app/cuewell/*.h /app/cuewell/*.cc /app/offpack/*.h /app/offpack/*.c /app/offpack/*.cc; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[19.067323, "o", "===== /app/millhull/mill.mk =====\r\n"]
[19.068462, "o", "     1\tCXX ?= g++\r\n     2\tCC ?= gcc\r\n     3\tCFLAGS ?= -O2 -Wall -Wextra -I/app/millhull -I/app/cuewell -I/app/wickdesk -I/app/offpack\r\n     4\tCXXFLAGS ?= -O2 -Wall -Wextra -std=c++17 -I/app/millhull -I/app/cuewell -I/app/wickdesk -I/app/offpack\r\n     5\tBIN := /app/bin/quillay\r\n     6\t\r\n     7\t.PHONY: hull\r\n     8\t# WAVE: tamp compiles /app/spanhearth/load.c with gcc -DWAVE from wave.txt\r\n     9\thull:\r\n    10\t\tmkdir -p /app/bin /app/wickbin /app/hearthbin\r\n    11\t\t$(CC) $(CFLAGS) -c /app/offpack/sum.c -o /tmp/sum.o\r\n"]
[19.068596, "o", "    12\t\t$(CXX) $(CXXFLAGS) -o $(BIN) /app/millhull/main.cc /app/millhull/drive.cc \\\r\n    13\t\t  /app/millhull/op_bind.cc /app/millhull/elfbits.cc \\\r\n    14\t\t  /app/cuewell/op_halt.cc /app/wickdesk/op_mesh.cc \\\r\n    15\t\t  /app/offpack/stamp.cc /tmp/sum.o\r\n"]
