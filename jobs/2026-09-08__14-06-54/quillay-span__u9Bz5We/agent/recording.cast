[19.081092, "o", "\t  if (!fgets(line, sizeof(line), fp)) {\r\n    15\t    fclose(fp);\r\n    16\t    return 1;\r\n    17\t  }\r\n    18\t  if (!fgets(line, sizeof(line), fp)) {\r\n    19\t    fclose(fp);\r\n    20\t    return 1;\r\n    21\t  }\r\n    22\t  fclose(fp);\r\n    23\t  char path[256], dig[65];\r\n    24\t  unsigned long long dev = 0, ino = 0, vma = 0, off = 0, sz = 0;\r\n    25\t  if (sscanf(line, \"%255s %llu %llu %64s %llu %llu %llu\", path, &dev, &ino, dig, &vma, &off,\r\n    26\t             &sz) != 7)\r\n    27\t    return 1;\r\n    28\t  (void)dig;\r\n    29\t  struct stat st;\r\n    30\t  if (stat(path, &st) != 0) return 1;\r\n    31\t  if ((unsigned long long)st.st_dev == dev && (unsigned long long)st.st_ino == ino &&\r\n    32\t      stamp_same(path, stamp_sec(path)))\r\n    33\t    return 0;\r\n    34\t  return 1;\r\n    35\t}\r\n"]
