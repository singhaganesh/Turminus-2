[87.619385, "i", "python3 - <<'PY'\nimport hashlib, os, re, subprocess\nq = open('/app/wickbin/layout.qmap').read().splitlines()\nassert q[0] == 'QMAP1' and len(q) == 2\npath, dev, ino, dig, vma, off, sz = q[1].split()\nst = os.stat(path)\nassert int(dev) == st.st_dev and int(ino) == st.st_ino\nassert re.fullmatch(r'[0-9a-f]{64}', dig)\nassert hashlib.sha256(open(path, 'rb').read()).hexdigest() == dig\nf = open('/app/wickbin/flame.qprf').read().splitlines()\npcs = [x.strip() for x in open('/app/spanhearth/pc.lst') if x.strip()]\nassert f[0] == 'QPRF1' and [x.split()[0] for x in f[1:]] == pcs\nsyms = []\nfor line in subprocess.check_output(['nm','-n','-S','--defined-only',path], text=True).splitlines():\n    p = line.split()\n    if len(p) >= 4 and p[2].lower() in ('t','w'):\n        syms.append((int(p[0],16), int(p[1],16), p[3]))\nfor row in f[1:]:\n    pc_s, name = row.split()\n    pc = int(pc_s,16)\n    assert any(n == name and lo <= pc < lo + (size or 1) for lo,size,n in syms)\nprint('artifact_validation=ok')\nPY\ncat /app/wickbin/layout.qmap; cat /app/wickbin/flame.qprf\n"]
[87.619724, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
