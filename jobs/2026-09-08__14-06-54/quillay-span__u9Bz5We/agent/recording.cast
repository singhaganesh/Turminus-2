[19.071944, "o", "     8\t  char dig[65];\r\n     9\t  unsigned long long vma;\r\n    10\t  unsigned long long off;\r\n    11\t  unsigned long long sz;\r\n    12\t};\r\n    13\t\r\n    14\t#endif\r\n"]
