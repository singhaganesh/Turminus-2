[63.684525, "o", "cat > /app/wickdesk/op_mesh.cc <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"mesh.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.684676, "o", "#include \"elfbits.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.684812, "o", "> #include <stdio.h>\r\n\u001b[?2004l\r"]
[63.687344, "o", "\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int op_mesh(const char *path, const struct Lay *lay, int reuse) {\r\n\u001b[?2004l\r\u001b[?2004h>   (void)lay;\r\n\u001b[?2004l\r\u001b[?2004h>   (void)reuse;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   /* pc.lst and the ELF can both change between invocations.  Always paint\r\n\u001b[?2004l\r\u001b[?2004h>      the profile from the live inputs rather than retaining an old profile. */\r\n\u001b[?2004l\r\u001b[?2004h>   FILE *lst = fopen(\"/app/spanhearth/pc.lst\", \"r\");\r\n\u001b[?2004l\r\u001b[?2004h>   FILE *out = fopen(\"/app/wickbin/flame.qprf\", \"w\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!lst || !out) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (lst) fclose(lst);\r\n\u001b[?2004l\r\u001b[?2004h>     if (out) fclose(out);\r\n\u001b[?2004l\r\u001b[?2004h>     return -1;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   int ok = fprintf(out, \"QPRF1\\n\") >= 0;\r\n\u001b[?2004l\r\u001b[?2004h>   char line[128];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.687588, "o", "  while (ok && fgets(line, sizeof(line), lst)) {\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned long long pc;\r\n\u001b[?2004l\r"]
[63.687728, "o", "\u001b[?2004h>     char tail;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.687901, "o", "    if (sscanf(line, \"%llx %c\", &pc, &tail) != 1) {\r\n\u001b[?2004l\r"]
[63.688, "o", "\u001b[?2004h>       ok = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.688083, "o", "      break;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.688261, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     char name[128];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.688426, "o", "    if (name_at(path, pc, name, sizeof(name)) != 0 || strcmp(name, \"?\") == 0) {\r\n\u001b[?2004l\r"]
[63.688481, "o", "\u001b[?2004h> "]
[63.688539, "o", "      ok = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.688578, "o", "      break;\r\n\u001b[?2004l\r"]
[63.688634, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[63.688671, "o", "\u001b[?2004h> "]
[63.688925, "o", "    if (fprintf(out, \"%llx %s\\n\", pc, name) < 0) ok = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.689156, "o", "  if (ferror(lst)) ok = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.689305, "o", "  if (fclose(lst) != 0) ok = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.689455, "o", ">   if (fclose(out) != 0) ok = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.689626, "o", "  return ok ? 0 : -1;\r\n\u001b[?2004l\r"]
[63.690046, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[63.691999, "o", "\u001b[?2004hroot@c9b088e7e1c3:/app# "]
[63.692247, "o", "cat > /app/cuewell/op_halt.cc <<'EOF'\r\n\u001b[?2004l\r"]
[63.692412, "o", "\u001b[?2004h> #include \"halt.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[63.692574, "o", "\u001b[?2004l\r\u001b[?2004h> #include \"sum.h\"\r\n\u001b[?2004l\r"]
