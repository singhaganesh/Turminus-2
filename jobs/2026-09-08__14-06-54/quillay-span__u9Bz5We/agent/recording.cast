[87.621856, "o", "\u001b[?2004h> syms = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.622089, "o", "for line in subprocess.check_output(['nm','-n','-S','--defined-only',path], text=True).splitlines():\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.622217, "o", ">     p = line.split()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.622334, "o", "    if len(p) >= 4 and p[2].lower() in ('t','w'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.622505, "o", "        syms.append((int(p[0],16), int(p[1],16), p[3]))\r\n\u001b[?2004l\r\u001b[?2004h"]
