[19.078664, "o", "     8\tint op_mesh(const char *a, const struct Lay *b, int c) {\r\n     9\t  (void)a;\r\n    10\t  (void)b;\r\n    11\t  if (c) {\r\n    12\t    return 0;\r\n    13\t  }\r\n    14\t  FILE *lst = fopen(\"/app/spanhearth/pc.lst\", \"r\");\r\n    15\t  FILE *out = fopen(\"/app/wickbin/flame.qprf\", \"w\");\r\n    16\t  if (!lst || !out) {\r\n    17\t    if (lst) fclose(lst);\r\n    18\t    if (out) fclose(out);\r\n    19\t    return -1;\r\n    20\t  }\r\n    21\t  fprintf(out, \"QPRF1\\n\");\r\n    22\t  char line[128];\r\n    23\t  while (fgets(line, sizeof(line), lst)) {\r\n    24\t    unsigned long long pc = 0;\r\n    25\t    if (sscanf(line, \"%llx\", &pc) != 1) continue;\r\n    26\t    char name[128];\r\n    27\t    name_at(a, pc, name, sizeof(name));\r\n    28\t    fprintf(out, \"%llx %s\\n\", pc, name);\r\n    29\t  }\r\n    30\t  fclose(lst);\r\n    31\t  fclose(out);\r\n    32\t  return 0;\r\n"]
