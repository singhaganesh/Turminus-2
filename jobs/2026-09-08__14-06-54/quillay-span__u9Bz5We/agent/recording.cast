[28.23756, "o", "     1\t#include \"elfbits.h\"\r\n     2\t\r\n     3\t#include <stdint.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic uint16_t u16(const unsigned char *p) {\r\n     8\t  return (uint16_t)p[0] | ((uint16_t)p[1] << 8);\r\n     9\t}\r\n    10\t\r\n    11\tstatic uint32_t u32(const unsigned char *p) {\r\n    12\t  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |\r\n    13\t         ((uint32_t)p[3] << 24);\r\n"]
[28.237748, "o", "    14\t}\r\n    15\t\r\n    16\tstatic uint64_t u64(const unsigned char *p) {\r\n    17\t  uint64_t v = 0;\r\n    18\t  for (int i = 7; i >= 0; i--) v = (v << 8) | p[i];\r\n    19\t  return v;\r\n    20\t}\r\n    21\t\r\n    22\tstatic int slurp(const char *path, unsigned char **out, size_t *n) {\r\n    23\t  FILE *fp = fopen(path, \"rb\");\r\n    24\t  if (!fp) return -1;\r\n    25\t  fseek(fp, 0, SEEK_END);\r\n    26\t  long sz = ftell(fp);\r\n    27\t  if (sz < 64) {\r\n    28\t    fclose(fp);\r\n    29\t    return -1;\r\n    30\t  }\r\n    31\t  rewind(fp);\r\n    32\t  unsigned char *buf = new unsigned char[sz];\r\n    33\t  if (fread(buf, 1, sz, fp) != (size_t)sz) {\r\n    34\t    delete[] buf;\r\n    35\t    fclose(fp);\r\n    36\t    return -1;\r\n    37\t  }\r\n    38\t  fclose(fp);\r\n    39\t  *out = buf;\r\n    40\t  *n = (size_t)sz;\r\n    41\t  return 0;\r\n    42\t}\r\n    43\t\r\n    44\tint fill_text(const char *path, unsigned long long *vma, unsigned long long *off,\r\n    45\t               unsigned long long *sz) {\r\n    46\t  unsigned char *buf = 0;\r\n    47\t  size_t n = 0;\r\n    48\t  if (slurp(path, &buf, &n) != 0) return -1;\r\n    49\t  if (n < 64 || buf[0] != 0x7f || buf[1] != 'E' || buf[2] != 'L' || buf[3] != 'F') {\r\n    50\t    delete[] buf;\r\n    51\t    return -1;\r\n    52\t  }\r\n    53\t  uint64_t phoff = u64(buf + 32);\r\n    54\t  uint16_t phentsize = u16(buf + 54);\r\n    55\t  uint16_t phnum = u16(buf + 56);\r\n    56\t  int found = 0;\r\n    57\t  for (uint16_t i = 0; i < phnum; i++) {\r\n    58\t    unsigned char *ph = buf + phoff + (size_t)i * phentsize;\r\n    59\t    uint32_t type = u32(ph);\r\n    60\t    uint32_t flags = u32(ph + 4);\r\n    61\t    if (type == 1 && (flags & 1)) {\r\n    62\t      *off = u64(ph + 8);\r\n    63\t      *vma = u64(ph + 16);\r\n    64\t      *sz = u64(ph + 32);\r\n    65\t      found = 1;\r\n    66\t      break;\r\n    67\t    }\r\n    68\t  }\r\n    69\t  delete[] buf;\r\n    70\t  return found ? 0 : -1;\r\n    71\t}\r\n    72\t\r\n"]
[28.237789, "o", "    73\tint name_at(const char *path, unsigned long long pc, char *out, int ncap) {\r\n    74\t  unsigned char *buf = 0;\r\n    75\t  size_t n = 0;\r\n    76\t  if (slurp(path, &buf, &n) != 0) return -1;\r\n    77\t  uint64_t shoff = u64(buf + 40);\r\n    78\t  uint16_t shentsize = u16(buf + 58);\r\n    79\t  uint16_t shnum = u16(buf + 60);\r\n    80\t  unsigned char *sym = 0, *str = 0;\r\n    81\t  uint64_t symsz = 0;\r\n    82\t  for (uint16_t i = 0; i < shnum; i++) {\r\n    83\t    unsigned char *sh = buf + shoff + (size_t)i * shentsize;\r\n    84\t    uint32_t type = u32(sh + 4);\r\n    85\t    if (type == 2) {\r\n"]
[28.23781, "o", "    86\t      uint32_t link = u32(sh + 24);\r\n    87\t      uint64_t offset = u64(sh + 24 + 8);\r\n    88\t      uint64_t size = u64(sh + 32);\r\n    89\t      unsigned char *strsh = buf + shoff + (size_t)link * shentsize;\r\n    90\t      uint64_t stroff = u64(strsh + 24);\r\n    91\t      sym = buf + offset;\r\n    92\t      str = buf + stroff;\r\n"]
[28.237827, "o", "    93\t      /* ELF64 SHT_SYMTAB: sh_offset at 24, sh_size at 32, sh_link at 40? */\r\n    94\t      (void)size;\r\n    95\t      symsz = u64(sh + 32);\r\n    96\t      (void)link;"]
[28.237847, "o", "\r\n    97\t    }\r\n    98\t  }\r\n    99\t  /* Re-parse with correct ELF64 section header offsets. */\r\n   100\t  sym = 0;\r\n"]
[28.237862, "o", "   101\t  str = 0;\r\n   102\t  symsz = 0;\r\n   103\t  for (uint16_t i = 0; i < shnum; i++) {\r\n   104\t    unsigned char *sh = buf + shoff + (size_t)i * shentsize;\r\n   105"]
[28.237886, "o", "\t    uint32_t type = u32(sh + 4);\r\n   106\t    if (type != 2) continue;\r\n   107\t    uint32_t link = u32(sh + 40);\r\n   108\t    uint64_t offset = u64(sh + 24);\r\n   109\t"]
[28.237908, "o", "    uint64_t size = u64(sh + 32);\r\n   110\t    unsigned char *strsh = buf + shoff + (size_t)link * shentsize;\r\n   111\t    uint64_t stroff = u64(strsh + 24);\r\n   112\t    sym = buf + offset;\r\n   113\t    str = buf + stroff;\r\n   114\t    symsz = size;\r\n"]
[28.237924, "o", "   115\t  }\r\n   116\t  const char *best = \"?\";\r\n"]
[28.237941, "o", "   117\t  unsigned long long best_v = 0;\r\n   118\t  if (sym && str) {\r\n   119\t    for (uint64_t i = 0; i + 24 <= symsz; i += 24) {\r\n   120\t      unsigned char *sy = sym + i;\r\n   121\t      uint32_t name = u32(sy);\r\n"]
[28.237957, "o", "   122\t      unsigned char info = sy[4];\r\n   123\t      uint64_t value = u64(sy + 8);\r\n   124\t      uint64_t size = u64(sy + 16);\r\n   125\t      int bind = info >> 4;\r\n   126\t      int stype = info & 0xf;\r\n"]
[28.237981, "o", "   127\t      if (stype != 2 || value == 0) continue;\r\n   128\t      (void)bind;\r\n   129\t      unsigned long long lo = value;\r\n   130\t      unsigned long long hi = value + (size ? size : 1);\r\n   131\t      if (pc >= lo && pc < hi && lo >= best_v) {\r\n"]
[28.238002, "o", "   132\t        best_v = lo;\r\n   133\t        best = (const char *)(str + name);\r\n   134\t      }\r\n   135\t    }\r\n   136\t  }\r\n   137\t  snprintf(out, ncap, \"%s\", best);\r\n   138\t  delete[] buf;\r\n"]
[28.238019, "o", "   139\t  return 0;\r\n   140\t}\r\n"]
[28.239031, "o", "===== stamp headers/source =====\r\n"]
[28.239618, "o", "     1\t#ifndef STAMP_H\r\n     2\t#define STAMP_H\r\n     3\t\r\n     4\t#ifdef __cplusplus\r\n     5\textern \"C\" {\r\n     6\t#endif\r\n     7\t\r\n     8\tint stamp_same(const char *path, unsigned long long old_sec);\r\n     9\tunsigned long long stamp_sec(const char *path);\r\n    10\tint stamp_zero(const char *path);\r\n    11\t\r\n    12\t#ifdef __cplusplus\r\n    13\t}\r\n    14\t#endif\r\n    15\t\r\n    16\t#endif\r\n"]
[28.24147, "o", "     1\t#include \"stamp.h\"\r\n     2\t\r\n     3\t#include <sys/stat.h>\r\n     4\t#include <fcntl.h>\r\n     5\t#include <time.h>\r\n     6\t#include <utime.h>\r\n     7\t\r\n     8\tunsigned long long stamp_sec(const char *path) {\r\n     9\t  struct stat st;\r\n    10\t  if (stat(path, &st) != 0) return 0;\r\n"]
[28.24165, "o", "    11\t  return (unsigned long long)st.st_mtime;\r\n    12\t}\r\n    13\t\r\n    14\tint stamp_same(const char *path, unsigned long long old_sec) {\r\n    15\t  return stamp_sec(path) == old_sec;\r\n    16\t}\r\n    17\t\r\n    18\tint stamp_zero(const char *path) {\r\n    19\t  struct utimbuf u;\r\n    20\t  u.actime = 0;\r\n    21\t  u.modtime = 0;\r\n    22\t  return utime(path, &u);\r\n    23\t}\r\n"]
[28.241792, "o", "\u001b[?2004h"]
