     8	static void reset_g(void) {
     9	  memset(G, 0, sizeof(G));
    10	  GN = 0;
    11	  g_closer = 1;
    12	  PN = 0;
    13	}
    14	
    15	int scan_dump(const char *path) {
    16	  FILE *f;
    17	  char line[160];
    18	  int open = 0;
    19	
    20	  reset_g();
    21	  f = fopen(path, "r");
    22	  if (!f) {
    23	    return 2;
    24	  }
    25	  while (fgets(line, sizeof line, f)) {
    26	    char *nl = strchr(line, '\n');
    27	    if (nl) {
    28	      *nl = 0;
    29	    }
    30	    if (line[0] == 0) {
    31	      continue;
    32	    }
    33	    if (strncmp(line, "THREAD ", 7) == 0) {
    34	      if (open) {
    35	        g_closer = 0;
    36	      }
    37	      if (GN >= MAXL) {
    38	        fclose(f);
    39	        return 2;
    40	      }
    41	      G[GN].tid = (uint32_t)atoi(line + 7);
    42	      open = 1;
    43	      GN++;
    44	      continue;
    45	    }
    46	    if (!open) {
    47	      continue;
    48	    }
    49	    if (strncmp(line, "OWN ", 4) == 0) {
    50	      snprintf(G[GN - 1].hex, sizeof G[GN - 1].hex, "%s", line + 4);
    51	      continue;
    52	    }
    53	    if (strncmp(line, "WAIT ", 5) == 0) {
    54	      snprintf(G[GN - 1].wait_hex, sizeof G[GN - 1].wait_hex, "%s", line + 5);
    55	      G[GN - 1].has_wait = 1;
    56	      continue;
    57	    }
    58	    if (strcmp(line, ".") == 0) {
    59	      open = 0;
    60	      continue;
    61	    }
    62	  }
    63	  fclose(f);
    64	  if (open) {
    65	    g_closer = 0;
    66	  }
    67	  return GN > 0 ? 0 : 2;
    68	}
===== book.c =====
     1	#include "book.h"
     2	#include "../knothub/store.h"
     3	
     4	#include <stdio.h>
     5	#include <string.h>
     6	
     7	int book_load(const char *path) {
     8	  FILE *f;
     9	  char line[160];
    10	  char hx[40];
    11	  unsigned id;
    12	
    13	  f = fopen(path, "r");
    14	  if (!f) {
    15	    return 2;
    16	  }
    17	  while (fgets(line, sizeof line, f)) {
    18	    if (sscanf(line, "%39s %u", hx, &id) != 2) {
    19	      continue;
    20	    }
    21	    if (hx[0] == 'h' || strcmp(hx, "hex") == 0) {
    22	      continue;
    23	    }
    24	    for (int i = 0; i < GN; i++) {
    25	      if (strcmp(G[i].hex, hx) == 0) {
    26	        G[i].tag = id;
    27	      }
    28	      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) {
    29	        G[i].wait_tag = id;
    30	      }
    31	    }
    32	  }
    33	  fclose(f);
    34	  return 0;
    35	}
===== graph.c =====
     1	#include "graph.h"
     2	#include "store.h"
     3	
     4	#include <string.h>
     5	
     6	static int find_hex(const char *hx) {
     7	  for (int i = 0; i < GN; i++) {
     8	    if (strcmp(G[i].hex, hx) == 0) {
     9	      return i;
    10	    }
    11	  }
    12	  return -1;
    13	}
    14	
    15	void graph_build(void) {
    16	  memset(succ, 0, sizeof succ);
    17	  memset(nsucc, 0, sizeof nsucc);
    18	  for (int i = 0; i < GN; i++) {
    19	    G[i].indeg = 0;
    20	    G[i].done = 0;
    21	  }
    22	  for (int i = 0; i < GN; i++) {
    23	    int w;
    24	    if (!G[i].has_wait) {
    25	      continue;
    26	    }
    27	    w = find_hex(G[i].wait_hex);
    28	    if (w < 0) {
    29	      continue;
    30	    }
    31	    /* w precedes i */
    32	    succ[w][nsucc[w]++] = i;
    33	    G[i].indeg++;
    34	  }
    35	}
