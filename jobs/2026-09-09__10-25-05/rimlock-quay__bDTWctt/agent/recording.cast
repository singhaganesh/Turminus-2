[76.516284, "i", "set -e\nrm -f /app/planbay/{live.plan,alt.plan,mill.ok} /app/scrollbay/desk.chk\n/tmp/rimlock.ref unjam /app/vatdock/shift.dmp /app/planbay/live.plan\n/tmp/rimlock.ref unjam /app/vatdock/dusk.dmp /app/planbay/alt.plan\n/tmp/rimlock.ref scroll /app/vatdock/shift.dmp /app/scrollbay/desk.chk\nprintf '%s\\n' '--- live ---'; cat /app/planbay/live.plan\nprintf '%s\\n' '--- alt ---'; cat /app/planbay/alt.plan\nprintf '%s\\n' '--- scroll ---'; cat /app/scrollbay/desk.chk\ncmp /app/planbay/live.plan /app/planbay/alt.plan\ncat > /tmp/bad.dmp <<'EOF'\nTHREAD 1\nOWN 0x100a\nEOF\nrm -f /app/planbay/bad.plan /app/planbay/mill.ok\nif /tmp/rimlock.ref unjam /tmp/bad.dmp /app/planbay/bad.plan; then echo 'ERROR malformed accepted'; exit 1; fi\n! test -e /app/planbay/bad.plan\n! test -e /app/planbay/mill.ok\necho 'malformed rejection: ok'\n"]
