[30.704772, "o", "     9\t  uint32_t x = *(const uint32_t *)a;\r\n    10\t  uint32_t y = *(const uint32_t *)b;\r\n    11\t  if (x < y) {\r\n    12\t    return -1;\r\n    13\t  }\r\n    14\t  if (x > y) {\r\n    15\t    return 1;\r\n    16\t  }\r\n    17\t  return 0;\r\n    18\t}\r\n    19\t\r\n    20\tvoid roster_out(void) {\r\n    21\t  uint32_t cyc[MAXL];\r\n"]
