[30.897315, "o", "2026-09-08 19:29:36.0000000000 /app/knothub/store.h\r\n2026-09-09 04:18:26.0000000000 /app/hullcue/hull.mk\r\n2026-09-09 04:40:54.0000000000 /app/knothub/pick.c\r\n2026-09-09 04:40:59.0000000000 /app/inkfold/fold.c\r\n2026-09-09 04:41:14.0000000000 /app/emiturn/bind.c\r\n2026-09-09 04:41:15.0000000000 /app/inkurn/book.tsv\r\n2026-09-09 04:43:09.0000000000 /app/hullcue/go.o\r\n2026-09-09 04:43:09.0000000000 /app/hullcue/main.o\r\n2026-09-09 04:43:09.0000000000 /app/hullcue/rank.o\r\n2026-09-09 04:43:09.0000000000 /app/knothub/graph.o\r\n2026-09-09 04:43:09.0000000000 /app/knothub/store.o\r\n2026-09-09 04:43:10.0000000000 /app/emiturn/bind.o\r\n2026-09-09 04:43:10.0000000000 /app/inkfold/fold.o\r\n2026-09-09 04:43:10.0000000000 /app/inkurn/book.o\r\n2026-09-09 04:43:10.0000000000 /app/knothub/cycle.o\r\n2026-09-09 04:43:10.0000000000 /app/knothub/pick.o\r\n2026-09-09 04:43:10.0000000000 /app/readcue/scan.o\r\n"]
[30.8975, "o", "\u001b[?2004hroot@d2f49673f2eb:/app# "]
[72.959836, "i", "python3 - <<'PY'\np='/app/readcue/scan.c'\ns=open(p).read()\ns=s.replace('  return GN > 0 ? 0 : 2;\\n', '  if (open || !g_closer || GN == 0) {\\n    return 2;\\n  }\\n  for (int i = 0; i < GN; i++) {\\n    if (G[i].hex[0] == 0) {\\n      return 2;\\n    }\\n  }\\n  return 0;\\n')\nopen(p,'w').write(s)\n\np='/app/inkurn/book.c'\ns=open(p).read()\ns=s.replace('  fclose(f);\\n  return 0;\\n', '''  fclose(f);\n  for (int i = 0; i < GN; i++) {\n    if (G[i].tag == 0 || (G[i].has_wait && G[i].wait_tag == 0)) {\n      return 2;\n    }\n  }\n  return 0;\n''')\nopen(p,'w').write(s)\nPY\ncat > /app/knothub/pick.c <<'EOF'\n#include \"pick.h\"\n#include \"store.h\"\n\n/* Select the smallest intern identity each time from the monitors that are\n   currently releasable.  TID and input position make duplicate IDs stable. */\nstatic int before(int a, int b) {\n  if (G[a].tag != G[b].tag) return G[a].tag < G[b].tag;\n  if (G[a].tid != G[b].tid) return G[a].tid < G[b].tid;\n  return a < b;\n}\n\nint op_pick(void) {\n  PN = 0;\n  for (int i = 0; i < GN; i++) G[i].done = 0;\n\n  for (;;) {\n    int cur = -1;\n    for (int i = 0; i < GN; i++) {\n      if (!G[i].done && G[i].indeg == 0 &&\n          (cur < 0 || before(i, cur))) cur = i;\n    }\n    if (cur < 0) break;\n    PLAN[PN++] = cur;\n    G[cur].done = 1;\n    for (int k = 0; k < nsucc[cur]; k++) {\n      int j = succ[cur][k];\n      if (G[j].indeg > 0) G[j].indeg--;\n    }\n  }\n\n  /* Deadlocked members are not topologically releasable.  Their identity\n     order is nevertheless canonical and independent of dump tokens/order. */\n  while (PN < GN) {\n    int cur = -1;\n    for (int i = 0; i < GN; i++) {\n      if (!G[i].done && (cur < 0 || before(i, cur))) cur = i;\n    }\n    PLAN[PN++] = cur;\n    G[cur].done = 1;\n  }\n  return 0;\n}\nEOF\ncat > /app/emiturn/bind.c <<'EOF'\n#include \"bind.h\"\n#include \"../knothub/store.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic void dir_of(const char *a, char *dir, size_t cap) {\n  const char *slash = strrchr(a, '/');\n  if (!slash) { snprintf(dir, cap, \".\"); return; }\n  size_t n = (size_t)(slash - a);\n  if (n >= cap) n = cap - 1;\n  memcpy(dir, a, n);\n  dir[n] = 0;\n}\n\nint n_bind(const char *a) {\n  char dir[256], okp[320], tmp[512], oktmp[512];\n  FILE *f;\n  dir_of(a, dir, sizeof dir);\n  snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\n  snprintf(tmp, sizeof tmp, \"%s.tmp.%ld\", a, (long)getpid());\n  snprintf(oktmp, sizeof oktmp, \"%s.tmp.%ld\", okp, (long)getpid());\n\n  f = fopen(tmp, \"w\");\n  if (!f) return 2;\n  for (int i = 0; i < PN; i++) {\n    if (fprintf(f, \"%u\\n\", G[PLAN[i]].tag) < 0) {\n      fclose(f); unlink(tmp); return 2;\n    }\n  }\n  if (fclose(f) != 0 || rename(tmp, a) != 0) {\n    unlink(tmp); return 2;\n  }\n\n  f = fopen(oktmp, \"w\");\n  if (!f) { unlink(a); return 2; }\n  if (fputs(\"ok\\n\", f) == EOF || fclose(f) != 0 || rename(oktmp, okp) != 0) {\n    unlink(oktmp); unlink(a); return 2;\n  }\n  return 0;\n}\nEOF\n"]
