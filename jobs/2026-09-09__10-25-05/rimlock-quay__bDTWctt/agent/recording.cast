[20.039395, "o", "===== /app/knothub/store.c =====\r\n"]
[20.040442, "o", "#include \"store.h\"\r\n\r\nLockRec G[MAXL];\r\nint GN;\r\nint g_closer;\r\nint PLAN[MAXL];\r\nint PN;\r\nint succ[MAXL][MAXL];\r\nint nsucc[MAXL];\r\nchar g_path[256];\r\n"]
[20.04077, "o", "===== /app/knothub/store.h =====\r\n"]
[20.041865, "o", "#ifndef STORE_H\r\n#define STORE_H\r\n\r\n#include <stdint.h>\r\n\r\n#define MAXL 64\r\n\r\ntypedef struct {\r\n  char hex[40];\r\n  char wait_hex[40];\r\n  uint32_t tag;\r\n  uint32_t wait_tag;\r\n  uint32_t tid;\r\n  int has_wait;\r\n  int indeg;\r\n  int done;\r\n  int depth;\r\n} LockRec;\r\n\r\nextern LockRec G[MAXL];\r\nextern int GN;\r\nextern int g_closer;\r\nextern int PLAN[MAXL];\r\nextern int PN;\r\nextern int succ[MAXL][MAXL];\r\nextern int nsucc[MAXL];\r\nextern char g_path[256];\r\n"]
[20.041969, "o", "\r\nint scan_dump(const char *path);\r\nint book_load(const char *path);\r\nvoid graph_build(void);\r\nvoid roster_out(void);\r\nvoid rk_wrap(void);\r\nint assay_run(const char *dump, const char *out);\r\n\r\n#endif\r\n"]
[20.042164, "o", "===== /app/emiturn/bind.c =====\r\n"]
[20.045127, "o", "#include \"bind.h\"\r\n#include \"../knothub/store.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic const char *wire_token(const LockRec *r) {\r\n  return r->hex;\r\n}\r\n\r\nstatic void dir_of(const char *a, char *dir, size_t cap) {\r\n  const char *slash = strrchr(a, '/');\r\n  if (!slash) {\r\n    snprintf(dir, cap, \".\");\r\n    return;\r\n  }\r\n  size_t n = (size_t)(slash - a);\r\n  if (n >= cap) {\r\n    n = cap - 1;\r\n  }\r\n  memcpy(dir, a, n);\r\n  dir[n] = 0;\r\n}\r\n\r\nint n_bind(const char *a) {\r\n  FILE *f;\r\n  FILE *ok;\r\n  char dir[128];\r\n  char okp[160];\r\n  int i;\r\n\r\n  dir_of(a, dir, sizeof dir);\r\n  snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\r\n\r\n  f = fopen(a, \"w\");\r\n  if (!f) {\r\n    return 2;\r\n"]
[20.045352, "o", "  }\r\n  for (i = 0; i < PN; i++) {\r\n    int k = PLAN[i];\r\n    fprintf(f, \"%s\\n\", wire_token(&G[k]));\r\n  }\r\n  fclose(f);\r\n\r\n  if (GN > 0) {\r\n    ok = fopen(okp, \"w\");\r\n    if (ok) {\r\n      fputs(\"ok\\n\", ok);\r\n      fclose(ok);\r\n    }\r\n  }\r\n  return 0;\r\n}\r\n"]
[20.045814, "o", "===== /app/emiturn/bind.h =====\r\n"]
[20.047275, "o", "#ifndef BIND_H\r\n#define BIND_H\r\nint n_bind(const char *a);\r\n#endif\r\n"]
[20.047667, "o", "===== /app/inkfold/fold.c =====\r\n"]
[20.049834, "o", "#include \"fold.h\"\r\n#include \"../knothub/store.h\"\r\n#include \"../readcue/scan.h\"\r\n#include \"../inkurn/book.h\"\r\n#include \"../knothub/graph.h\"\r\n#include \"../knothub/pick.h\"\r\n#include \"../hullcue/rank.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic int cmp_wire(const void *a, const void *b) {\r\n  int i = *(const int *)a;\r\n  int j = *(const int *)b;\r\n  return strcmp(G[i].hex, G[j].hex);\r\n}\r\n\r\nint cfg_fold(const char *a) {\r\n  int ord[MAXL];\r\n  int i;\r\n  FILE *f;\r\n\r\n  if (GN == 0 && g_path[0]) {\r\n    if (scan_dump(g_path) != 0) {\r\n      return 2;\r\n    }\r\n  }\r\n  if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n    return 2;\r\n  }\r\n  graph_build();\r\n  op_pick();\r\n  rk_wrap();\r\n\r\n  for (i = 0; i < PN; i++) {\r\n    ord[i] = PLAN[i];\r\n  }\r\n  if (PN > 1) {\r\n    qsort(ord, (size_t)PN, sizeof ord[0], cmp_wire);\r\n  }\r\n\r\n  f = fopen(a, \"w\");\r\n"]
[20.049883, "o", "  if (!f) {\r\n    return 2;\r\n  }\r\n  for (i = 0; i < PN; i++) {\r\n    int k = ord[i];\r\n    fprintf(f, \"%u %s\\n\", G[k].tid, G[k].hex);\r\n  }\r\n  fclose(f);\r\n  return 0;\r\n}\r\n"]
[20.050202, "o", "===== /app/inkfold/fold.h =====\r\n"]
[20.051436, "o", "#ifndef FOLD_H\r\n#define FOLD_H\r\nint cfg_fold(const char *a);\r\n#endif\r\n"]
