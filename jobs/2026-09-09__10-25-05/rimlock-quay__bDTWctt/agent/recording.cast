[72.9627, "o", "\u001b[?2004h>     if (G[i].tag == 0 || (G[i].has_wait && G[i].wait_tag == 0)) {\r\n\u001b[?2004l\r\u001b[?2004h>       return 2;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return 0;\r\n\u001b[?2004l\r\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
