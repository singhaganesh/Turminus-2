[9.909658, "i", "rm -f /app/planbay/live.plan /app/planbay/alt.plan /app/scrollbay/desk.chk /app/planbay/mill.ok; /app/bin/rimlock unjam /app/vatdock/shift.dmp /app/planbay/live.plan; printf 'unjam rc=%s\\n' \"$?\"; cat /app/planbay/live.plan 2>/dev/null; printf '\\nstatus: '; cat /app/planbay/mill.ok 2>/dev/null; printf '\\n--- dusk ---\\n'; /app/bin/rimlock unjam /app/vatdock/dusk.dmp /app/planbay/alt.plan; printf 'unjam rc=%s\\n' \"$?\"; cat /app/planbay/alt.plan 2>/dev/null; printf '\\n--- scroll ---\\n'; /app/bin/rimlock scroll /app/vatdock/shift.dmp /app/scrollbay/desk.chk; printf 'scroll rc=%s\\n' \"$?\"; cat /app/scrollbay/desk.chk 2>/dev/null\n"]
