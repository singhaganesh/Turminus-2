[19.876458, "o", "--- DEPTH ---\r\n"]
[19.877519, "o", "Wait-depth ranking already wraps unjam emit. Equal depth keeps the current list. Desk workers enable this wrap when plans look shuffled.\r\n"]
[19.87781, "o", "--- dumps ---\r\n"]
[19.877908, "o", "### /app/vatdock/dusk.dmp\r\n"]
[19.878834, "o", "THREAD 10\r\nOWN 0x400a\r\n.\r\n\r\nTHREAD 11\r\nOWN 0x400b\r\n.\r\n\r\nTHREAD 12\r\nOWN 0x400c\r\nWAIT 0x400a\r\n.\r\n\r\nTHREAD 13\r\nOWN 0x400d\r\nWAIT 0x400b\r\n.\r\n\r\nTHREAD 20\r\nOWN 0x500a\r\nWAIT 0x500b\r\n.\r\n\r\nTHREAD 21\r\nOWN 0x500b\r\nWAIT 0x500a\r\n.\r\n"]
[19.879037, "o", "### /app/vatdock/shift.dmp\r\n"]
[19.879945, "o", "THREAD 10\r\nOWN 0x100a\r\n.\r\n\r\nTHREAD 11\r\nOWN 0x100b\r\n.\r\n\r\nTHREAD 12\r\nOWN 0x100c\r\nWAIT 0x100a\r\n.\r\n\r\nTHREAD 13\r\nOWN 0x100d\r\nWAIT 0x100b\r\n.\r\n\r\nTHREAD 20\r\nOWN 0x200a\r\nWAIT 0x200b\r\n.\r\n\r\nTHREAD 21\r\nOWN 0x200b\r\nWAIT 0x200a\r\n.\r\n"]
[19.880139, "o", "--- makefile ---\r\n"]
[19.88104, "o", "CC = gcc\r\nCFLAGS = -O0 -g -Wall -std=c11 -I/app\r\nHULLBIN ?= /app/bin/rimlock\r\nOBJS = main.o go.o rank.o \\\r\n\t../knothub/store.o ../knothub/graph.o ../knothub/pick.o ../knothub/cycle.o \\\r\n\t../readcue/scan.o \\\r\n\t../inkurn/book.o \\\r\n\t../emiturn/bind.o \\\r\n\t../inkfold/fold.o\r\n\r\nhull: $(OBJS)\r\n\t$(CC) $(CFLAGS) -o $(HULLBIN) $(OBJS)\r\n\r\n%.o: %.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../knothub/%.o: ../knothub/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../readcue/%.o: ../readcue/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../inkurn/%.o: ../inkurn/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../emiturn/%.o: ../emiturn/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n\r\n../inkfold/%.o: ../inkfold/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n"]
[19.881259, "o", "\u001b[?2004hroot@d2f49673f2eb:/app# "]
[20.017684, "i", "for f in /app/hullcue/*.[ch] /app/readcue/*.[ch] /app/inkurn/*.[ch] /app/knothub/*.[ch] /app/emiturn/*.[ch] /app/inkfold/*.[ch]; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[20.018543, "o", "for f in /app/hullcue/*.[ch] /app/readcue/*.[ch] /app/inkurn/*.[ch] /app/knothub/*.[ch] /app/emiturn/*.[ch] /app/inkfold/*.[ch]; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[20.018853, "o", "===== /app/hullcue/go.c =====\r\n"]
[20.0204, "o", "#include \"../knothub/store.h\"\r\n#include \"../readcue/scan.h\"\r\n#include \"../inkurn/book.h\"\r\n#include \"../knothub/graph.h\"\r\n#include \"../knothub/pick.h\"\r\n#include \"../emiturn/bind.h\"\r\n#include \"rank.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint assay_run(const char *dump, const char *out) {\r\n  snprintf(g_path, sizeof g_path, \"%s\", dump);\r\n  if (scan_dump(dump) != 0) {\r\n    return 2;\r\n  }\r\n"]
[20.020605, "o", "  if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n    return 2;\r\n  }\r\n  graph_build();\r\n  op_pick();\r\n  rk_wrap();\r\n  return n_bind(out);\r\n}\r\n"]
[20.020699, "o", "===== /app/hullcue/main.c =====\r\n"]
[20.021914, "o", "#include \"../knothub/store.h\"\r\n#include \"../readcue/scan.h\"\r\n#include \"../inkurn/book.h\"\r\n#include \"../knothub/graph.h\"\r\n#include \"../inkfold/fold.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint assay_run(const char *dump, const char *out);\r\n\r\nint main(int argc, char **argv) {\r\n  if (argc < 2) {"]
[20.022408, "o", "\r\n    fputs(\"usage\\n\", stderr);\r\n    return 2;\r\n  }\r\n  if (strcmp(argv[1], \"unjam\") == 0 && argc >= 4) {\r\n    return assay_run(argv[2], argv[3]);\r\n  }\r\n  if (strcmp(argv[1], \"scroll\") == 0 && argc >= 4) {\r\n    snprintf(g_path, sizeof g_path, \"%s\", argv[2]);\r\n    if (scan_dump(argv[2]) != 0) {\r\n      return 2;\r\n    }\r\n    return cfg_fold(argv[3]);\r\n  }\r\n  if (strcmp(argv[1], \"roster\") == 0 && argc >= 3) {\r\n    if (scan_dump(argv[2]) != 0) {\r\n      return 2;\r\n    }\r\n    if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n      return 2;\r\n    }\r\n    graph_build();\r\n    roster_out();\r\n    return 0;\r\n  }\r\n  fputs(\"usage\\n\", stderr);\r\n  return 2;\r\n}\r\n===== /app/hullcue/rank.c =====\r\n"]
[20.023272, "o", "#include \"rank.h\"\r\n#include \"../knothub/store.h\"\r\n\r\nvoid rk_wrap(void) {\r\n  int q[MAXL];\r\n  int qh = 0;\r\n  int qt = 0;\r\n\r\n  for (int i = 0; i < GN; i++) {\r\n    G[i].depth = 0;\r\n    if (!G[i].has_wait) {\r\n      q[qt++] = i;\r\n"]
[20.023353, "o", "    }\r\n  }\r\n  while (qh < qt) {\r\n    int i = q[qh++];\r\n    for (int k = 0; k < nsucc[i]; k++) {\r\n      int j = succ[i][k];\r\n      int d = G[i].depth + 1;\r\n      if (d > G[j].depth) {\r\n        G[j].depth = d;\r\n      }\r\n      if (qt < MAXL * 3) {\r\n        q[qt++] = j;\r\n      }\r\n    }\r\n  }\r\n}\r\n"]
[20.023568, "o", "===== /app/hullcue/rank.h =====\r\n"]
[20.024739, "o", "#ifndef RANK_H\r\n#define RANK_H\r\nvoid rk_wrap(void);\r\n#endif\r\n"]
[20.024931, "o", "===== /app/readcue/scan.c =====\r\n"]
[20.025972, "o", "#include \"scan.h\"\r\n#include \"../knothub/store.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void reset_g(void) {\r\n  memset(G, 0, sizeof(G));\r\n  GN = 0;\r\n  g_closer = 1;\r\n  PN = 0;\r\n}\r\n\r\nint scan_dump(const char *path) {\r\n"]
[20.02606, "o", "  FILE *f;\r\n  char line[160];\r\n  int open = 0;\r\n\r\n  reset_g();\r\n  f = fopen(path, \"r\");\r\n  if (!f) {\r\n    return 2;\r\n  }\r\n  while (fgets(line, sizeof line, f)) {\r\n    char *nl = strchr(line, '\\n');\r\n    if (nl) {\r\n      *nl = 0;\r\n    }\r\n    if (line[0] == 0) {\r\n      continue;\r\n    }\r\n    if (strncmp(line, \"THREAD \", 7) == 0) {\r\n      if (open) {\r\n        g_closer = 0;\r\n      }\r\n      if (GN >= MAXL) {\r\n        fclose(f);\r\n        return 2;\r\n      }\r\n      G[GN].tid = (uint32_t)atoi(line + 7);\r\n      open = 1;\r\n      GN++;\r\n      continue;\r\n    }\r\n    if (!open) {\r\n      continue;\r\n    }\r\n    if (strncmp(line, \"OWN \", 4) == 0) {\r\n      snprintf(G[GN - 1].hex, sizeof G[GN - 1].hex, \"%s\", line + 4);\r\n      continue;\r\n"]
[20.026157, "o", "    }\r\n    if (strncmp(line, \"WAIT \", 5) == 0) {\r\n      snprintf(G[GN - 1].wait_hex, sizeof G[GN - 1].wait_hex, \"%s\", line + 5);\r\n      G[GN - 1].has_wait = 1;\r\n      continue;\r\n    }\r\n    if (strcmp(line, \".\") == 0) {\r\n      open = 0;\r\n      continue;\r\n    }\r\n  }\r\n  fclose(f);\r\n  if (open) {\r\n    g_closer = 0;\r\n  }\r\n  return GN > 0 ? 0 : 2;\r\n}\r\n"]
[20.026336, "o", "===== /app/readcue/scan.h =====\r\n"]
[20.02766, "o", "#ifndef SCAN_H\r\n#define SCAN_H\r\nint scan_dump(const char *path);\r\n#endif\r\n"]
[20.027913, "o", "===== /app/inkurn/book.c =====\r\n"]
[20.029075, "o", "#include \"book.h\"\r\n#include \"../knothub/store.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint book_load(const char *path) {\r\n  FILE *f;\r\n  char line[160];\r\n  char hx[40];\r\n  unsigned id;\r\n\r\n  f = fopen(path, \"r\");\r\n  if (!f) {\r\n    return 2;\r\n  }\r\n  while (fgets(line, sizeof line, f)) {\r\n    if (sscanf(line, \"%39s %u\", hx, &id) != 2) {\r\n      continue;\r\n    }\r\n    if (hx[0] == 'h' || strcmp(hx, \"hex\") == 0) {\r\n      continue;\r\n    }\r\n    for (int i = 0; i < GN; i++) {\r\n      if (strcmp(G[i].hex, hx) == 0) {\r\n"]
[20.029207, "o", "        G[i].tag = id;\r\n      }\r\n      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) {\r\n        G[i].wait_tag = id;\r\n      }\r\n    }\r\n  }\r\n  fclose(f);\r\n  return 0;\r\n}\r\n"]
[20.029446, "o", "===== /app/inkurn/book.h =====\r\n"]
[20.030592, "o", "#ifndef BOOK_H\r\n#define BOOK_H\r\nint book_load(const char *path);\r\n#endif\r\n"]
[20.030776, "o", "===== /app/knothub/cycle.c =====\r\n"]
[20.032066, "o", "#include \"store.h\"\r\n#include \"../inkurn/book.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic int cmp_u(const void *a, const void *b) {\r\n  uint32_t x = *(const uint32_t *)a;\r\n  uint32_t y = *(const uint32_t *)b;\r\n  if (x < y) {\r\n    return -1;\r\n  }\r\n  if (x > y) {\r\n    return 1;\r\n  }\r\n  return 0;\r\n}\r\n\r\nvoid roster_out(void) {\r\n"]
[20.032115, "o", "  uint32_t cyc[MAXL];\r\n  int cn = 0;\r\n  int seen[MAXL];\r\n\r\n  memset(seen, 0, sizeof seen);\r\n  for (int i = 0; i < GN; i++) {\r\n    if (G[i].has_wait) {\r\n      int w = -1;\r\n      for (int j = 0; j < GN; j++) {\r\n        if (strcmp(G[j].hex, G[i].wait_hex) == 0) {\r\n          w = j;\r\n          break;\r\n        }\r\n      }\r\n      if (w >= 0 && G[w].has_wait && strcmp(G[w].wait_hex, G[i].hex) == 0) {\r\n        if (!seen[i]) {\r\n          cyc[cn++] = G[i].tag;\r\n          seen[i] = 1;\r\n        }\r\n        if (!seen[w]) {\r\n          cyc[cn++] = G[w].tag;\r\n          seen[w] = 1;\r\n"]
[20.032243, "o", "        }\r\n      }\r\n    }\r\n  }\r\n  qsort(cyc, (size_t)cn, sizeof cyc[0], cmp_u);\r\n  fputs(\"CYCLE\", stdout);\r\n  for (int i = 0; i < cn; i++) {\r\n    printf(\" %u\", cyc[i]);\r\n"]
[20.032313, "o", "  }\r\n  fputc('\\n', stdout);\r\n  for (int i = 0; i < GN; i++) {\r\n    printf(\"OWNER %u=%u\\n\", G[i].tag, G[i].tid);\r\n  }\r\n}\r\n"]
[20.032524, "o", "===== /app/knothub/graph.c =====\r\n"]
[20.033876, "o", "#include \"graph.h\"\r\n#include \"store.h\"\r\n\r\n#include <string.h>\r\n\r\nstatic int find_hex(const char *hx) {\r\n  for (int i = 0; i < GN; i++) {\r\n    if (strcmp(G[i].hex, hx) == 0) {\r\n      return i;\r\n    }\r\n  }\r\n  return -1;\r\n}\r\n\r\nvoid graph_build(void) {\r\n  memset(succ, 0, sizeof succ);\r\n  memset(nsucc, 0, sizeof nsucc);\r\n  for (int i = 0; i < GN; i++) {\r\n    G[i].indeg = 0;\r\n    G[i].done = 0;\r\n"]
[20.034061, "o", "  }\r\n  for (int i = 0; i < GN; i++) {\r\n    int w;\r\n    if (!G[i].has_wait) {\r\n      continue;\r\n    }\r\n    w = find_hex(G[i].wait_hex);\r\n    if (w < 0) {\r\n      continue;\r\n    }\r\n    /* w precedes i */\r\n    succ[w][nsucc[w]++] = i;\r\n    G[i].indeg++;\r\n  }\r\n}\r\n"]
[20.034267, "o", "===== /app/knothub/graph.h =====\r\n"]
[20.036333, "o", "#ifndef GRAPH_H\r\n#define GRAPH_H\r\nvoid graph_build(void);\r\n#endif\r\n"]
[20.036708, "o", "===== /app/knothub/pick.c =====\r\n"]
[20.037915, "o", "#include \"pick.h\"\r\n#include \"store.h\"\r\n\r\nint op_pick(void) {\r\n  int q[MAXL];\r\n  int enq[MAXL];\r\n  int qh = 0;\r\n  int qt = 0;\r\n  int i;\r\n\r\n  PN = 0;\r\n  for (i = 0; i < GN; i++) {\r\n"]
[20.038057, "o", "    enq[i] = 0;\r\n  }\r\n  for (i = 0; i < GN; i++) {\r\n    if (G[i].indeg == 0) {\r\n      q[qt++] = i;\r\n      enq[i] = 1;\r\n    }\r\n  }\r\n  while (qh < qt) {\r\n    int cur = q[qh++];\r\n    int k;\r\n    if (G[cur].done) {\r\n      continue;\r\n    }\r\n    PLAN[PN++] = cur;\r\n    G[cur].done = 1;\r\n    for (k = 0; k < nsucc[cur]; k++) {\r\n      int j = succ[cur][k];\r\n      if (G[j].indeg > 0) {\r\n        G[j].indeg--;\r\n      }\r\n      if (G[j].indeg == 0 && !enq[j]) {\r\n        q[qt++] = j;\r\n        enq[j] = 1;\r\n      }\r\n    }\r\n  }\r\n  for (i = 0; i < GN; i++) {\r\n    if (!G[i].done) {\r\n      PLAN[PN++] = i;\r\n      G[i].done = 1;\r\n    }\r\n  }\r\n  return 0;\r\n}\r\n"]
