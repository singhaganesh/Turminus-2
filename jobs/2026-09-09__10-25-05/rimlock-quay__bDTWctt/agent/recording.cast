[9.22395, "o", "hullcue — CLI\r\nknothub — graph and pick\r\nemiturn — destination write\r\ninkfold — runbook write\r\nreadcue — dump scan\r\ninkurn — identity book\r\nhullcue/hull.mk — mill link: make -C /app/hullcue -f /app/hullcue/hull.mk hull HULLBIN=/tmp/rimlock.ref\r\n\r\n"]
[9.224242, "o", "\r\n--- forms ---\r\n"]
[9.225558, "o", "THREAD <tid>\r\nOWN <hex>\r\nWAIT <hex>\r\n.\r\n\r\nEach thread block ends with a lone closer line \".\". OWN names the monitor the thread holds. WAIT names the monitor it is blocked on. Identity for emit is column two of /app/inkurn/book.tsv.\r\n"]
[9.226558, "o", "\r\n--- book ---\r\n"]
[9.22924, "o", "hex\tid\r\n0x100a\t5\r\n0x100b\t9\r\n0x100c\t11\r\n0x100d\t2\r\n0x200a\t30\r\n0x200b\t31\r\n0x300a\t40\r\n0x300b\t41\r\n0x300c\t17\r\n0x400a\t5\r\n0x400b\t9\r\n0x400c\t11\r\n0x400d\t2\r\n0x500a\t30\r\n0x500b\t31\r\n"]
