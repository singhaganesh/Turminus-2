[73.481518, "i", "cat > /app/inkfold/fold.c <<'EOF'\n#include \"fold.h\"\n#include \"../knothub/store.h\"\n#include \"../readcue/scan.h\"\n#include \"../inkurn/book.h\"\n#include \"../knothub/graph.h\"\n#include \"../knothub/pick.h\"\n#include \"../hullcue/rank.h\"\n\n#include <stdio.h>\n#include <unistd.h>\n\nint cfg_fold(const char *a) {\n  char tmp[512];\n  FILE *f;\n  if (GN == 0 && g_path[0] && scan_dump(g_path) != 0) return 2;\n  if (book_load(\"/app/inkurn/book.tsv\") != 0) return 2;\n  graph_build();\n  op_pick();\n  rk_wrap();\n\n  snprintf(tmp, sizeof tmp, \"%s.tmp.%ld\", a, (long)getpid());\n  f = fopen(tmp, \"w\");\n  if (!f) return 2;\n  for (int i = 0; i < PN; i++) {\n    int k = PLAN[i];\n    if (fprintf(f, \"%u %u\\n\", G[k].tid, G[k].tag) < 0) {\n      fclose(f); unlink(tmp); return 2;\n    }\n  }\n  if (fclose(f) != 0 || rename(tmp, a) != 0) {\n    unlink(tmp); return 2;\n  }\n  return 0;\n}\nEOF\npython3 - <<'PY'\np='/app/hullcue/go.c'\ns=open(p).read()\ns=s.replace('#include <string.h>\\n', '#include <string.h>\\n#include <unistd.h>\\n')\ns=s.replace('int assay_run(const char *dump, const char *out) {\\n', '''static void clear_unjam_artifacts(const char *out) {\n  char dir[256], okp[320];\n  const char *slash = strrchr(out, '/');\n  unlink(out);\n  if (!slash) snprintf(dir, sizeof dir, \".\");\n  else {\n    size_t n = (size_t)(slash - out);\n    if (n >= sizeof dir) n = sizeof dir - 1;\n    memcpy(dir, out, n); dir[n] = 0;\n  }\n  snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\n  unlink(okp);\n}\n\nint assay_run(const char *dump, const char *out) {\n  clear_unjam_artifacts(out);\n''')\nopen(p,'w').write(s)\n\np='/app/hullcue/main.c'\ns=open(p).read()\ns=s.replace('#include <string.h>\\n', '#include <string.h>\\n#include <unistd.h>\\n')\ns=s.replace('  if (strcmp(argv[1], \"scroll\") == 0 && argc >= 4) {\\n', '  if (strcmp(argv[1], \"scroll\") == 0 && argc >= 4) {\\n    unlink(argv[3]);\\n')\nopen(p,'w').write(s)\nPY\nmake -C /app/hullcue -f /app/hullcue/hull.mk clean >/dev/null 2>&1 || true\nrm -f /app/hullcue/*.o /app/{knothub,readcue,inkurn,emiturn,inkfold}/*.o\nmake -C /app/hullcue -f /app/hullcue/hull.mk hull HULLBIN=/tmp/rimlock.ref\n"]
