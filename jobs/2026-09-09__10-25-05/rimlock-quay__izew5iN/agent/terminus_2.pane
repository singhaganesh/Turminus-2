    12	int assay_run(const char *dump, const char *out) {
    13	  snprintf(g_path, sizeof g_path, "%s", dump);
    14	  if (scan_dump(dump) != 0) {
    15	    return 2;
    16	  }
    17	  if (book_load("/app/inkurn/book.tsv") != 0) {
    18	    return 2;
    19	  }
    20	  graph_build();
    21	  op_pick();
    22	  rk_wrap();
    23	  return n_bind(out);
    24	}
===== /app/hullcue/rank.c =====
     1	#include "rank.h"
     2	#include "../knothub/store.h"
     3	
     4	void rk_wrap(void) {
     5	  int q[MAXL];
     6	  int qh = 0;
     7	  int qt = 0;
     8	
     9	  for (int i = 0; i < GN; i++) {
    10	    G[i].depth = 0;
    11	    if (!G[i].has_wait) {
    12	      q[qt++] = i;
    13	    }
    14	  }
    15	  while (qh < qt) {
    16	    int i = q[qh++];
    17	    for (int k = 0; k < nsucc[i]; k++) {
    18	      int j = succ[i][k];
    19	      int d = G[i].depth + 1;
    20	      if (d > G[j].depth) {
    21	        G[j].depth = d;
    22	      }
    23	      if (qt < MAXL * 3) {
    24	        q[qt++] = j;
    25	      }
    26	    }
    27	  }
    28	}
