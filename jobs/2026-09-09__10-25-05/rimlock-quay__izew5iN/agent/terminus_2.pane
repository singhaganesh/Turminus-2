===== /app/emiturn/bind.c =====
     1	#include "bind.h"
     2	#include "../knothub/store.h"
     3	
     4	#include <stdio.h>
     5	#include <string.h>
     6	
     7	static const char *wire_token(const LockRec *r) {
     8	  return r->hex;
     9	}
    10	
    11	static void dir_of(const char *a, char *dir, size_t cap) {
    12	  const char *slash = strrchr(a, '/');
    13	  if (!slash) {
    14	    snprintf(dir, cap, ".");
    15	    return;
    16	  }
    17	  size_t n = (size_t)(slash - a);
    18	  if (n >= cap) {
    19	    n = cap - 1;
    20	  }
    21	  memcpy(dir, a, n);
    22	  dir[n] = 0;
    23	}
    24	
    25	int n_bind(const char *a) {
    26	  FILE *f;
    27	  FILE *ok;
    28	  char dir[128];
    29	  char okp[160];
    30	  int i;
    31	
    32	  dir_of(a, dir, sizeof dir);
    33	  snprintf(okp, sizeof okp, "%s/mill.ok", dir);
    34	
    35	  f = fopen(a, "w");
    36	  if (!f) {
    37	    return 2;
    38	  }
    39	  for (i = 0; i < PN; i++) {
    40	    int k = PLAN[i];
    41	    fprintf(f, "%s\n", wire_token(&G[k]));
    42	  }
    43	  fclose(f);
    44	
    45	  if (GN > 0) {
    46	    ok = fopen(okp, "w");
    47	    if (ok) {
    48	      fputs("ok\n", ok);
    49	      fclose(ok);
    50	    }
    51	  }
    52	  return 0;
    53	}
