===== /app/readcue/scan.c =====
     1	#include "scan.h"
     2	#include "../knothub/store.h"
     3	
     4	#include <stdio.h>
     5	#include <stdlib.h>
     6	#include <string.h>
     7	
     8	static void reset_g(void) {
     9	  memset(G, 0, sizeof(G));
    10	  GN = 0;
    11	  g_closer = 1;
    12	  PN = 0;
    13	}
    14	
    15	int scan_dump(const char *path) {
    16	  FILE *f;
    17	  char line[160];
    18	  int open = 0;
    19	
    20	  reset_g();
    21	  f = fopen(path, "r");
    22	  if (!f) {
    23	    return 2;
    24	  }
    25	  while (fgets(line, sizeof line, f)) {
    26	    char *nl = strchr(line, '\n');
    27	    if (nl) {
    28	      *nl = 0;
    29	    }
    30	    if (line[0] == 0) {
    31	      continue;
    32	    }
    33	    if (strncmp(line, "THREAD ", 7) == 0) {
    34	      if (open) {
    35	        g_closer = 0;
    36	      }
    37	      if (GN >= MAXL) {
    38	        fclose(f);
    39	        return 2;
    40	      }
    41	      G[GN].tid = (uint32_t)atoi(line + 7);
    42	      open = 1;
    43	      GN++;
    44	      continue;
    45	    }
    46	    if (!open) {
    47	      continue;
    48	    }
    49	    if (strncmp(line, "OWN ", 4) == 0) {
    50	      snprintf(G[GN - 1].hex, sizeof G[GN - 1].hex, "%s", line + 4);
    51	      continue;
    52	    }
    53	    if (strncmp(line, "WAIT ", 5) == 0) {
    54	      snprintf(G[GN - 1].wait_hex, sizeof G[GN - 1].wait_hex, "%s", line + 5);
    55	      G[GN - 1].has_wait = 1;
    56	      continue;
    57	    }
    58	    if (strcmp(line, ".") == 0) {
    59	      open = 0;
    60	      continue;
    61	    }
    62	  }
    63	  fclose(f);
    64	  if (open) {
    65	    g_closer = 0;
    66	  }
    67	  return GN > 0 ? 0 : 2;
    68	}
