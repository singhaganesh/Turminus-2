    10	int assay_run(const char *dump, const char *out);
    11	
    12	int main(int argc, char **argv) {
    13	  if (argc < 2) {
    14	    fputs("usage\n", stderr);
    15	    return 2;
    16	  }
    17	  if (strcmp(argv[1], "unjam") == 0 && argc >= 4) {
    18	    return assay_run(argv[2], argv[3]);
    19	  }
    20	  if (strcmp(argv[1], "scroll") == 0 && argc >= 4) {
    21	    snprintf(g_path, sizeof g_path, "%s", argv[2]);
    22	    if (scan_dump(argv[2]) != 0) {
    23	      return 2;
    24	    }
    25	    return cfg_fold(argv[3]);
    26	  }
    27	  if (strcmp(argv[1], "roster") == 0 && argc >= 3) {
    28	    if (scan_dump(argv[2]) != 0) {
    29	      return 2;
    30	    }
    31	    if (book_load("/app/inkurn/book.tsv") != 0) {
    32	      return 2;
    33	    }
    34	    graph_build();
    35	    roster_out();
    36	    return 0;
    37	  }
    38	  fputs("usage\n", stderr);
    39	  return 2;
    40	}
