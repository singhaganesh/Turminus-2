    17	}
    18	
    19	int cfg_fold(const char *a) {
    20	  int ord[MAXL];
    21	  int i;
    22	  FILE *f;
    23	
    24	  if (GN == 0 && g_path[0]) {
    25	    if (scan_dump(g_path) != 0) {
    26	      return 2;
    27	    }
    28	  }
    29	  if (book_load("/app/inkurn/book.tsv") != 0) {
    30	    return 2;
    31	  }
    32	  graph_build();
    33	  op_pick();
    34	  rk_wrap();
    35	
    36	  for (i = 0; i < PN; i++) {
    37	    ord[i] = PLAN[i];
    38	  }
    39	  if (PN > 1) {
    40	    qsort(ord, (size_t)PN, sizeof ord[0], cmp_wire);
    41	  }
    42	
    43	  f = fopen(a, "w");
    44	  if (!f) {
    45	    return 2;
    46	  }
    47	  for (i = 0; i < PN; i++) {
    48	    int k = ord[i];
    49	    fprintf(f, "%u %s\n", G[k].tid, G[k].hex);
    50	  }
    51	  fclose(f);
    52	  return 0;
    53	}
