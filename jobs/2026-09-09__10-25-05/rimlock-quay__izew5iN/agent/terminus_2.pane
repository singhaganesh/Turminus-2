===== /app/inkurn/book.c =====
     1	#include "book.h"
     2	#include "../knothub/store.h"
     3	
     4	#include <stdio.h>
     5	#include <string.h>
     6	
     7	int book_load(const char *path) {
     8	  FILE *f;
     9	  char line[160];
    10	  char hx[40];
    11	  unsigned id;
    12	
    13	  f = fopen(path, "r");
    14	  if (!f) {
    15	    return 2;
    16	  }
    17	  while (fgets(line, sizeof line, f)) {
    18	    if (sscanf(line, "%39s %u", hx, &id) != 2) {
    19	      continue;
    20	    }
    21	    if (hx[0] == 'h' || strcmp(hx, "hex") == 0) {
    22	      continue;
    23	    }
    24	    for (int i = 0; i < GN; i++) {
    25	      if (strcmp(G[i].hex, hx) == 0) {
    26	        G[i].tag = id;
    27	      }
    28	      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) {
    29	        G[i].wait_tag = id;
    30	      }
    31	    }
    32	  }
    33	  fclose(f);
    34	  return 0;
    35	}
