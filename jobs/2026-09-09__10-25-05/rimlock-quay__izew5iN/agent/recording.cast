[22.579726, "o", "int nsucc[MAXL];\r\n    10\tchar g_path[256];\r\n"]
[22.579838, "o", "===== /app/knothub/store.h =====\r\n"]
[22.580621, "o", "     1\t#ifndef STORE_H\r\n     2\t#define STORE_H\r\n     3\t\r\n     4\t#include <stdint.h>\r\n     5\t\r\n     6\t#define MAXL 64\r\n     7\t\r\n     8\ttypedef struct {\r\n     9\t  char hex[40];\r\n"]
[22.580663, "o", "    10\t  char wait_hex[40];\r\n    11\t  uint32_t tag;\r\n    12\t  uint32_t wait_tag;\r\n    13\t  uint32_t tid;\r\n    14\t  int has_wait;\r\n    15\t  int indeg;\r\n    16\t  int done;\r\n    17\t  int depth;\r\n    18\t} LockRec;\r\n    19\t\r\n    20\textern LockRec G[MAXL];\r\n"]
[22.580691, "o", "    21\textern int GN;\r\n    22\textern int g_closer;\r\n    23\textern int PLAN[MAXL];\r\n    24\textern int PN;\r\n    25\textern int succ[MAXL][MAXL];\r\n"]
[22.580826, "o", "    26\textern int nsucc[MAXL];\r\n    27\textern char g_path[256];\r\n    28\t\r\n    29\tint scan_dump(const char *path);\r\n    30\tint book_load(const char *path);\r\n"]
[22.580937, "o", "    31\tvoid graph_build(void);\r\n    32\tvoid roster_out(void);\r\n    33\tvoid rk_wrap(void);\r\n    34\tint assay_run(const char *dump, const char *out);\r\n    35\t\r\n    36\t#endif\r\n"]
[22.581022, "o", "===== /app/knothub/cycle.c =====\r\n"]
[22.581781, "o", "     1\t#include \"store.h\"\r\n     2\t#include \"../inkurn/book.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n     6\t#include <string.h>\r\n     7\t\r\n     8\tstatic int cmp_u(const void *a, const void *b) {\r\n     9\t  uint32_t x = *(const uint32_t *)a;\r\n    10\t  uint32_t y = *(const uint32_t *)b;\r\n"]
[22.581878, "o", "    11\t  if (x < y) {\r\n    12\t    return -1;\r\n    13\t  }\r\n    14\t  if (x > y) {\r\n    15\t    return 1;\r\n    16\t  }\r\n    17\t  return 0;\r\n    18\t}\r\n    19\t\r\n    20\tvoid roster_out(void) {\r\n    21\t  uint32_t cyc[MAXL];\r\n    22\t  int cn = 0;\r\n    23\t  int seen[MAXL];\r\n    24\t\r\n    25\t  memset(seen, 0, sizeof seen);\r\n    26\t  for (int i = 0; i < GN; i++) {\r\n    27\t    if (G[i].has_wait) {\r\n    28\t      int w = -1;\r\n    29\t      for (int j = 0; j < GN; j++) {\r\n    30\t        if (strcmp(G[j].hex, G[i].wait_hex) == 0) {\r\n    31\t          w = j;\r\n    32\t          break;\r\n    33\t        }\r\n    34\t      }\r\n    35\t      if (w >= 0 && G[w].has_wait && strcmp(G[w].wait_hex, G[i].hex) == 0) {\r\n    36\t        if (!seen[i]) {\r\n    37\t          cyc[cn++] = G[i].tag;\r\n    38\t          seen[i] = 1;\r\n    39\t        }\r\n    40\t        if (!seen[w]) {\r\n    41\t          cyc[cn++] = G[w].tag;\r\n"]
[22.581956, "o", "    42\t          seen[w] = 1;\r\n    43\t        }\r\n    44\t      }\r\n    45\t    }\r\n    46\t  }\r\n    47\t  qsort(cyc, (size_t)cn, sizeof cyc[0], cmp_u);\r\n    48\t  fputs(\"CYCLE\", stdout);\r\n    49\t  for (int i = 0; i < cn; i++) {\r\n    50\t    printf(\" %u\", cyc[i]);\r\n    51\t  }\r\n    52\t  fputc('\\n', stdout);\r\n    53\t  for (int i = 0; i < GN; i++) {\r\n    54\t    printf(\"OWNER %u=%u\\n\", G[i].tag, G[i].tid);\r\n    55\t  }\r\n    56\t}\r\n"]
[22.582074, "o", "===== /app/knothub/pick.c =====\r\n"]
[22.582863, "o", "     1\t#include \"pick.h\"\r\n     2\t#include \"store.h\"\r\n     3\t\r\n     4\tint op_pick(void) {\r\n     5\t  int q[MAXL];\r\n     6\t  int enq[MAXL];\r\n     7\t  int qh = 0;\r\n     8\t  int qt = 0;\r\n"]
[22.582962, "o", "     9\t  int i;\r\n    10\t\r\n    11\t  PN = 0;\r\n    12\t  for (i = 0; i < GN; i++) {\r\n    13\t    enq[i] = 0;\r\n    14\t  }\r\n    15\t  for (i = 0; i < GN; i++) {\r\n    16\t    if (G[i].indeg == 0) {\r\n    17\t      q[qt++] = i;\r\n    18\t      enq[i] = 1;\r\n    19\t    }\r\n    20\t  }\r\n    21\t  while (qh < qt) {\r\n    22\t    int cur = q[qh++];\r\n    23\t    int k;\r\n    24\t    if (G[cur].done) {\r\n    25\t      continue;\r\n    26\t    }\r\n    27\t    PLAN[PN++] = cur;\r\n    28\t    G[cur].done = 1;\r\n    29\t    for (k = 0; k < nsucc[cur]; k++) {\r\n    30\t      int j = succ[cur][k];\r\n    31\t      if (G[j].indeg > 0) {\r\n    32\t        G[j].indeg--;\r\n    33\t      }\r\n    34\t      if (G[j].indeg == 0 && !enq[j]) {\r\n    35\t        q[qt++] = j;\r\n"]
[22.582989, "o", "    36\t        enq[j] = 1;\r\n    37\t      }\r\n    38\t    }\r\n    39\t  }\r\n    40\t  for (i = 0; i < GN; i++) {\r\n    41\t    if (!G[i].done) {\r\n    42\t      PLAN[PN++] = i;\r\n    43\t      G[i].done = 1;\r\n    44\t    }\r\n"]
[22.583005, "o", "    45\t  }\r\n    46\t  return 0;\r\n    47\t}\r\n"]
[22.583175, "o", "===== /app/knothub/pick.h =====\r\n"]
[22.584103, "o", "     1\t#ifndef PICK_H\r\n     2\t#define PICK_H\r\n     3\tint op_pick(void);\r\n     4\t#endif\r\n"]
[22.584211, "o", "===== /app/emiturn/bind.c =====\r\n"]
[22.584949, "o", "     1\t#include \"bind.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic const char *wire_token(const LockRec *r) {\r\n     8\t  return r->hex;\r\n     9\t}\r\n    10\t\r\n    11\tstatic void dir_of(const char *a, char *dir, size_t cap) {\r\n"]
[22.585069, "o", "    12\t  const char *slash = strrchr(a, '/');\r\n    13\t  if (!slash) {\r\n    14\t    snprintf(dir, cap, \".\");\r\n    15\t    return;\r\n    16\t  }\r\n    17\t  size_t n = (size_t)(slash - a);\r\n    18\t  if (n >= cap) {\r\n    19\t    n = cap - 1;\r\n    20\t  }\r\n    21\t  memcpy(dir, a, n);\r\n    22\t  dir[n] = 0;\r\n    23\t}\r\n    24\t\r\n    25\tint n_bind(const char *a) {\r\n    26\t  FILE *f;\r\n    27\t  FILE *ok;\r\n    28\t  char dir[128];\r\n    29\t  char okp[160];\r\n    30\t  int i;\r\n    31\t\r\n    32\t  dir_of(a, dir, sizeof dir);\r\n    33\t  snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\r\n    34\t\r\n    35\t  f = fopen(a, \"w\");\r\n    36\t  if (!f) {\r\n    37\t    return 2;\r\n    38\t  }\r\n    39\t  for (i = 0; i < PN; i++) {\r\n    40\t    int k = PLAN[i];\r\n    41\t    fprintf(f, \"%s\\n\", wire_token(&G[k]));\r\n    42\t  }\r\n    43\t  fclose(f);\r\n    44\t\r\n    45\t  if (GN > 0) {\r\n    46\t    ok = fopen(okp, \"w\");\r\n    47\t    if (ok) {\r\n    48\t      fputs(\"ok\\n\", ok);\r\n    49\t      fclose(ok);\r\n    50"]
[22.585893, "o", "\t    }\r\n    51\t  }\r\n    52\t  return 0;\r\n    53\t}\r\n"]
[22.586013, "o", "===== /app/emiturn/bind.h =====\r\n"]
[22.586259, "o", "     1\t#ifndef BIND_H\r\n     2\t#define BIND_H\r\n     3\tint n_bind(const char *a);\r\n     4\t#endif\r\n"]
[22.586439, "o", "===== /app/inkfold/fold.c =====\r\n"]
[22.58721, "o", "     1\t#include \"fold.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t#include \"../readcue/scan.h\"\r\n     4\t#include \"../inkurn/book.h\"\r\n     5\t#include \"../knothub/graph.h\"\r\n     6\t#include \"../knothub/pick.h\"\r\n"]
[22.587305, "o", "     7\t#include \"../hullcue/rank.h\"\r\n     8\t\r\n     9\t#include <stdio.h>\r\n    10\t#include <stdlib.h>\r\n    11\t#include <string.h>\r\n    12\t\r\n    13\tstatic int cmp_wire(const void *a, const void *b) {\r\n    14\t  int i = *(const int *)a;\r\n    15\t  int j = *(const int *)b;\r\n    16\t  return strcmp(G[i].hex, G[j].hex);\r\n    17\t}\r\n    18\t\r\n    19\tint cfg_fold(const char *a) {\r\n    20\t  int ord[MAXL];\r\n    21\t  int i;\r\n    22\t  FILE *f;\r\n    23\t\r\n    24\t  if (GN == 0 && g_path[0]) {\r\n    25\t    if (scan_dump(g_path) != 0) {\r\n    26\t      return 2;\r\n    27\t    }\r\n    28\t  }\r\n    29\t  if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n    30\t    return 2;\r\n    31\t  }\r\n"]
[22.587392, "o", "    32\t  graph_build();\r\n    33\t  op_pick();\r\n    34\t  rk_wrap();\r\n    35\t\r\n    36\t  for (i = 0; i < PN; i++) {\r\n    37\t    ord[i] = PLAN[i];\r\n    38\t  }\r\n    39\t  if (PN > 1) {\r\n    40\t    qsort(ord, (size_t)PN, sizeof ord[0], cmp_wire);\r\n    41\t  }\r\n    42\t\r\n"]
[22.587466, "o", "    43\t  f = fopen(a, \"w\");\r\n    44\t  if (!f) {\r\n    45\t    return 2;\r\n    46\t  }\r\n    47\t  for (i = 0; i < PN; i++) {\r\n    48\t    int k = ord[i];\r\n    49\t    fprintf(f, \"%u %s\\n\", G[k].tid, G[k].hex);\r\n    50\t  }\r\n    51\t  fclose(f);\r\n    52\t  return 0;\r\n    53\t}\r\n"]
[22.587551, "o", "===== /app/inkfold/fold.h =====\r\n"]
