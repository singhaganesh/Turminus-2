[22.566356, "o", "     1\tWait-depth ranking already wraps unjam emit. Equal depth keeps the current list. Desk workers enable this wrap when plans look shuffled.\r\n"]
[22.566554, "o", "===== /app/hullcue/hull.mk =====\r\n"]
[22.567467, "o", "     1\tCC = gcc\r\n     2\tCFLAGS = -O0 -g -Wall -std=c11 -I/app\r\n     3\tHULLBIN ?= /app/bin/rimlock\r\n     4\tOBJS = main.o go.o rank.o \\\r\n     5\t\t../knothub/store.o ../knothub/graph.o ../knothub/pick.o ../knothub/cycle.o \\\r\n     6\t\t../readcue/scan.o \\\r\n     7\t\t../inkurn/book.o \\\r\n     8\t\t../emiturn/bind.o \\\r\n     9\t\t../inkfold/fold.o\r\n    10\t\r\n"]
[22.56759, "o", "    11\thull: $(OBJS)\r\n    12\t\t$(CC) $(CFLAGS) -o $(HULLBIN) $(OBJS)\r\n    13\t\r\n    14\t%.o: %.c\r\n    15\t\t$(CC) $(CFLAGS) -c -o $@ $<\r\n    16\t\r\n    17\t../knothub/%.o: ../knothub/%.c\r\n    18\t\t$(CC) $(CFLAGS) -c -o $@ $<\r\n    19\t\r\n    20\t../readcue/%.o: ../readcue/%.c\r\n    21\t\t$(CC) $(CFLAGS) -c -o $@ $<\r\n    22\t\r\n    23\t../inkurn/%.o: ../inkurn/%.c\r\n"]
