[114.195259, "o", "  *v = (uint32_t)n;\r\n\u001b[?2004l\r\u001b[?2004h>   return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[114.195424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.195632, "o", "int scan_dump(const char *path) {\r\n\u001b[?2004l\r\u001b[?2004h>   FILE *f;\r\n\u001b[?2004l\r"]
[114.197339, "o", "\u001b[?2004h>   char line[160];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.197435, "o", "  int open = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   int have_own = 0;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   reset_g();\r\n\u001b[?2004l\r\u001b[?2004h>   f = fopen(path, \"r\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!f) return 2;\r\n\u001b[?2004l\r\u001b[?2004h>   while (fgets(line, sizeof line, f)) {\r\n\u001b[?2004l\r\u001b[?2004h>     char *nl = strchr(line, '\\n');\r\n\u001b[?2004l\r"]
[114.197782, "o", "\u001b[?2004h>     if (nl) *nl = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.197978, "o", "    else if (!feof(f)) { fclose(f); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.198381, "o", ">     if (line[0] == 0) continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.19843, "o", "    if (strncmp(line, \"THREAD \", 7) == 0) {\r\n\u001b[?2004l\r"]
[114.198481, "o", "\u001b[?2004h> "]
[114.19888, "o", "      if (open || GN >= MAXL || parse_u32(line + 7, &G[GN].tid) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.198907, "o", "> "]
[114.199013, "o", "        fclose(f); return 2;\r\n\u001b[?2004l\r"]
[114.19904, "o", "\u001b[?2004h"]
[114.199054, "o", "> "]
[114.199099, "o", "      }\r\n\u001b[?2004l\r"]
[114.199168, "o", "\u001b[?2004h> "]
[114.199375, "o", "      open = 1;\r\n\u001b[?2004l\r"]
[114.199398, "o", "\u001b[?2004h> "]
[114.199432, "o", "      have_own = 0;\r\n\u001b[?2004l\r"]
[114.199447, "o", "\u001b[?2004h"]
[114.199461, "o", "> "]
[114.199499, "o", "      GN++;\r\n\u001b[?2004l\r"]
[114.199514, "o", "\u001b[?2004h"]
[114.199527, "o", "> "]
[114.1996, "o", "    } else if (!open) {\r\n\u001b[?2004l\r"]
[114.199624, "o", "\u001b[?2004h"]
[114.19964, "o", "> "]
[114.199711, "o", "      fclose(f); return 2;\r\n\u001b[?2004l\r"]
[114.199778, "o", "\u001b[?2004h> "]
[114.199998, "o", "    } else if (strncmp(line, \"OWN \", 4) == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.200152, "o", "      if (have_own || line[4] == 0) { fclose(f); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.20053, "o", "      snprintf(G[GN - 1].hex, sizeof G[GN - 1].hex, \"%s\", line + 4);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.200597, "o", "      have_own = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.200822, "o", "    } else if (strncmp(line, \"WAIT \", 5) == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.201016, "o", "      if (G[GN - 1].has_wait || line[5] == 0) { fclose(f); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.201052, "o", "> "]
[114.201256, "o", "      snprintf(G[GN - 1].wait_hex, sizeof G[GN - 1].wait_hex, \"%s\", line + 5);\r\n\u001b[?2004l\r"]
[114.20148, "o", "\u001b[?2004h> "]
[114.201634, "o", "      G[GN - 1].has_wait = 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.201756, "o", "    } else if (strcmp(line, \".\") == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.20184, "o", "      if (!have_own) { fclose(f); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.201958, "o", "      open = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.202025, "o", "    } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.202131, "o", "      fclose(f); return 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.202233, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.202393, "o", "  if (ferror(f)) { fclose(f); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.202481, "o", "  fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.202574, "o", "> "]
[114.20263, "o", "  if (open) g_closer = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.202726, "o", "  return (GN > 0 && g_closer) ? 0 : 2;\r\n\u001b[?2004l\r"]
[114.202776, "o", "\u001b[?2004h"]
[114.202827, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[114.204187, "o", "\u001b[?2004hroot@16f686bd3677:/app# \r\n\u001b[?2004l\r"]
[114.204287, "o", "\u001b[?2004hroot@16f686bd3677:/app# "]
[114.204394, "o", "cat > /app/inkurn/book.c <<'EOF'\r\n\u001b[?2004l\r"]
[114.204496, "o", "\u001b[?2004h> "]
[114.204574, "o", "#include \"book.h\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.204652, "o", "#include \"../knothub/store.h\"\r\n\u001b[?2004l\r"]
[114.205276, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.205372, "o", "#include <stdint.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.205433, "o", "#include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[114.205488, "o", "\u001b[?2004h> "]
[114.205565, "o", "int book_load(const char *path) {\r\n\u001b[?2004l\r"]
[114.205627, "o", "\u001b[?2004h> "]
[114.205678, "o", "  FILE *f;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.205779, "o", "  char line[160], hx[40];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.205854, "o", "  unsigned id;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.205969, "o", "  int own[MAXL] = {0}, wait[MAXL] = {0};\r\n\u001b[?2004l\r"]
[114.206023, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[114.206069, "o", "> "]
[114.206116, "o", "  f = fopen(path, \"r\");\r\n\u001b[?2004l\r"]
[114.206182, "o", "\u001b[?2004h> "]
[114.206273, "o", "  if (!f) return 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.206353, "o", "  while (fgets(line, sizeof line, f)) {\r\n\u001b[?2004l\r"]
[114.206428, "o", "\u001b[?2004h> "]
[114.206539, "o", "    if (sscanf(line, \"%39s %u\", hx, &id) != 2) continue;\r\n\u001b[?2004l\r"]
[114.206588, "o", "\u001b[?2004h> "]
[114.206676, "o", "    if (strcmp(hx, \"hex\") == 0) continue;\r\n\u001b[?2004l\r"]
[114.206725, "o", "\u001b[?2004h> "]
[114.206806, "o", "    for (int i = 0; i < GN; i++) {\r\n\u001b[?2004l\r"]
[114.20683, "o", "\u001b[?2004h> "]
[114.206964, "o", "      if (strcmp(G[i].hex, hx) == 0) {\r\n\u001b[?2004l\r"]
[114.206988, "o", "\u001b[?2004h> "]
[114.207125, "o", "        G[i].tag = (uint32_t)id; own[i] = 1;\r\n\u001b[?2004l\r"]
[114.207149, "o", "\u001b[?2004h> "]
[114.207231, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.207533, "o", "      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) {\r\n\u001b[?2004l\r"]
[114.207569, "o", "\u001b[?2004h> "]
[114.208582, "o", "        G[i].wait_tag = (uint32_t)id; wait[i] = 1;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (ferror(f)) { fclose(f); return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>   fclose(f);\r\n\u001b[?2004l\r"]
[114.209499, "o", "\u001b[?2004h"]
[114.209713, "o", ">   for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r\u001b[?2004h>     if (!own[i] || (G[i].has_wait && !wait[i])) return 2;\r\n\u001b[?2004l\r\u001b[?2004h>   return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[114.211484, "o", "\u001b[?2004hroot@16f686bd3677:/app# \r\n\u001b[?2004l\r"]
[114.211583, "o", "\u001b[?2004hroot@16f686bd3677:/app# "]
[114.211618, "o", "cat > /app/knothub/pick.c <<'EOF'\r\n\u001b[?2004l\r"]
[114.211736, "o", "\u001b[?2004h> "]
[114.211845, "o", "#include \"pick.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"store.h\"\r\n\u001b[?2004l\r"]
[114.211868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[114.211927, "o", "\u001b[?2004h> "]
[114.212025, "o", "static int before(int a, int b) {\r\n\u001b[?2004l\r"]
[114.212048, "o", "\u001b[?2004h"]
[114.212132, "o", "> "]
[114.212153, "o", "  if (b < 0) return 1;\r\n\u001b[?2004l\r"]
[114.212168, "o", "\u001b[?2004h"]
[114.21228, "o", "> "]
[114.212383, "o", "  if (G[a].tag != G[b].tag) return G[a].tag < G[b].tag;\r\n\u001b[?2004l\r"]
[114.212407, "o", "\u001b[?2004h"]
[114.212488, "o", "> "]
[114.212585, "o", "  if (G[a].tid != G[b].tid) return G[a].tid < G[b].tid;\r\n\u001b[?2004l\r"]
[114.212654, "o", "\u001b[?2004h> "]
[114.21273, "o", "  return a < b;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[114.212822, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.212897, "o", "int op_pick(void) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.212958, "o", "> "]
[114.21303, "o", "  PN = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.213119, "o", "  for (int i = 0; i < GN; i++) G[i].done = 0;\r\n\u001b[?2004l\r"]
[114.21319, "o", "\u001b[?2004h> "]
[114.213291, "o", "  while (PN < GN) {\r\n\u001b[?2004l\r"]
[114.213382, "o", "\u001b[?2004h>     int cur = -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.213493, "o", "    for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r"]
[114.213558, "o", "\u001b[?2004h> "]
[114.213699, "o", "      if (!G[i].done && G[i].indeg == 0 && before(i, cur)) cur = i;\r\n\u001b[?2004l\r"]
[114.213758, "o", "\u001b[?2004h> "]
[114.213913, "o", "    /* No releasable node means a cycle: break it at the least identity. */\r\n\u001b[?2004l\r"]
[114.213987, "o", "\u001b[?2004h> "]
[114.21406, "o", "    if (cur < 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.214122, "o", "> "]
[114.214211, "o", "      for (int i = 0; i < GN; i++)\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.214281, "o", "> "]
[114.214382, "o", "        if (!G[i].done && before(i, cur)) cur = i;\r\n\u001b[?2004l\r"]
[114.214494, "o", "\u001b[?2004h> "]
[114.214575, "o", "    if (cur < 0) return 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.214647, "o", "    PLAN[PN++] = cur;\r\n\u001b[?2004l\r"]
[114.214724, "o", "\u001b[?2004h> "]
[114.214749, "o", "    G[cur].done = 1;\r\n\u001b[?2004l\r"]
[114.214834, "o", "\u001b[?2004h> "]
[114.21495, "o", "    for (int k = 0; k < nsucc[cur]; k++) {\r\n\u001b[?2004l\r"]
[114.21501, "o", "\u001b[?2004h> "]
[114.215284, "o", "      int j = succ[cur][k];\r\n\u001b[?2004l\r\u001b[?2004h>       if (!G[j].done && G[j].indeg > 0) G[j].indeg--;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.215366, "o", ">   return 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.215426, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.215646, "o", "EOF\r\n\u001b[?2004l\r"]
[114.216738, "o", "\u001b[?2004hroot@16f686bd3677:/app# \r\n\u001b[?2004l\r"]
[114.216834, "o", "\u001b[?2004hroot@16f686bd3677:/app# "]
[114.216904, "o", "cat > /app/hullcue/rank.c <<'EOF'\r\n\u001b[?2004l\r"]
[114.216969, "o", "\u001b[?2004h"]
[114.217276, "o", "> #include \"rank.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../knothub/store.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.217354, "o", "/* Compute bounded wait depth in selected order.  PLAN ordering is deliberately\r\n\u001b[?2004l\r"]
[114.217419, "o", "\u001b[?2004h> "]
[114.217561, "o", "   retained: op_pick already resolves equal-depth choices by identity. */\r\n\u001b[?2004l\r"]
[114.217624, "o", "\u001b[?2004h> "]
[114.217683, "o", "void rk_wrap(void) {\r\n\u001b[?2004l\r"]
[114.217745, "o", "\u001b[?2004h> "]
[114.217837, "o", "  for (int i = 0; i < GN; i++) G[i].depth = 0;\r\n\u001b[?2004l\r"]
[114.217892, "o", "\u001b[?2004h"]
[114.217943, "o", "> "]
[114.217998, "o", "  for (int p = 0; p < PN; p++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.218053, "o", "> "]
[114.218109, "o", "    int i = PLAN[p];\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.218183, "o", "> "]
[114.218256, "o", "    for (int k = 0; k < nsucc[i]; k++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.218425, "o", "      int j = succ[i][k];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.21855, "o", "      if (G[j].done && G[j].depth < G[i].depth + 1)\r\n\u001b[?2004l\r"]
[114.218617, "o", "\u001b[?2004h> "]
[114.218684, "o", "        G[j].depth = G[i].depth + 1;\r\n\u001b[?2004l\r"]
[114.218747, "o", "\u001b[?2004h> "]
[114.21916, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[114.220158, "o", "\u001b[?2004hroot@16f686bd3677:/app# "]
[114.679227, "i", "cat > /app/emiturn/bind.c <<'EOF'\n#include \"bind.h\"\n#include \"../knothub/store.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int paths(const char *a, char *okp, size_t okcap, char *tmp, size_t tmpcap) {\n  const char *slash = strrchr(a, '/');\n  char dir[256];\n  size_t n;\n  if (!slash) snprintf(dir, sizeof dir, \".\");\n  else {\n    n = (size_t)(slash - a);\n    if (n == 0) n = 1;\n    if (n >= sizeof dir) return 2;\n    memcpy(dir, a, n); dir[n] = 0;\n  }\n  if (snprintf(okp, okcap, \"%s/mill.ok\", dir) >= (int)okcap) return 2;\n  if (snprintf(tmp, tmpcap, \"%s.tmp.%ld\", a, (long)getpid()) >= (int)tmpcap) return 2;\n  return 0;\n}\n\nint n_bind(const char *a) {\n  FILE *f, *ok;\n  char okp[320], tmp[512], oktmp[384];\n  if (paths(a, okp, sizeof okp, tmp, sizeof tmp) != 0) return 2;\n  unlink(a); unlink(okp); unlink(tmp);\n  f = fopen(tmp, \"w\");\n  if (!f) return 2;\n  for (int i = 0; i < PN; i++)\n    if (fprintf(f, \"%u\\n\", G[PLAN[i]].tag) < 0) goto fail;\n  if (fclose(f) != 0) { unlink(tmp); return 2; }\n  if (rename(tmp, a) != 0) { unlink(tmp); return 2; }\n  if (snprintf(oktmp, sizeof oktmp, \"%s.tmp.%ld\", okp, (long)getpid()) >= (int)sizeof oktmp)\n    goto published_fail;\n  unlink(oktmp);\n  ok = fopen(oktmp, \"w\");\n  if (!ok) goto published_fail;\n  if (fputs(\"ok\\n\", ok) == EOF || fclose(ok) != 0) {\n    unlink(oktmp); goto published_fail;\n  }\n  if (rename(oktmp, okp) != 0) { unlink(oktmp); goto published_fail; }\n  return 0;\nfail:\n  fclose(f); unlink(tmp); unlink(a); unlink(okp); return 2;\npublished_fail:\n  unlink(a); unlink(okp); return 2;\n}\nEOF\n\ncat > /app/inkfold/fold.c <<'EOF'\n#include \"fold.h\"\n#include \"../knothub/store.h\"\n#include \"../readcue/scan.h\"\n#include \"../inkurn/book.h\"\n#include \"../knothub/graph.h\"\n#include \"../knothub/pick.h\"\n#include \"../hullcue/rank.h\"\n\n#include <stdio.h>\n#include <unistd.h>\n\nint cfg_fold(const char *a) {\n  FILE *f;\n  char tmp[512];\n  if (GN == 0 && g_path[0] && scan_dump(g_path) != 0) return 2;\n  if (book_load(\"/app/inkurn/book.tsv\") != 0) return 2;\n  graph_build();\n  if (op_pick() != 0) return 2;\n  rk_wrap();\n  if (snprintf(tmp, sizeof tmp, \"%s.tmp.%ld\", a, (long)getpid()) >= (int)sizeof tmp) return 2;\n  unlink(tmp);\n  f = fopen(tmp, \"w\");\n  if (!f) return 2;\n  for (int i = 0; i < PN; i++) {\n    int k = PLAN[i];\n    if (fprintf(f, \"%u %u\\n\", G[k].tid, G[k].tag) < 0) {\n      fclose(f); unlink(tmp); unlink(a); return 2;\n    }\n  }\n  if (fclose(f) != 0 || rename(tmp, a) != 0) {\n    unlink(tmp); unlink(a); return 2;\n  }\n  return 0;\n}\nEOF\n\npython3 - <<'PY'\np='/app/hullcue/go.c'\ns=open(p).read()\ns=s.replace('#include <string.h>\\n', '#include <string.h>\\n#include <unistd.h>\\n')\ns=s.replace('int assay_run(const char *dump, const char *out) {\\n', '''static void clear_result(const char *out) {\n  char ok[512];\n  const char *slash = strrchr(out, '/');\n  unlink(out);\n  if (!slash) snprintf(ok, sizeof ok, \"./mill.ok\");\n  else {\n    size_t n = (size_t)(slash - out);\n    if (n == 0) n = 1;\n    if (n + 9 < sizeof ok) {\n      memcpy(ok, out, n); ok[n] = 0; strcat(ok, \"/mill.ok\"); unlink(ok);\n    }\n  }\n}\n\nint assay_run(const char *dump, const char *out) {\n  clear_result(out);\n''')\ns=s.replace('    op_pick();\\n    rk_wrap();', '    if (op_pick() != 0) {\\n      clear_result(out);\\n      return 2;\\n    }\\n    rk_wrap();')\nopen(p,'w').write(s)\n\np='/app/hullcue/main.c'\ns=open(p).read()\ns=s.replace('#include <string.h>\\n', '#include <string.h>\\n#include <unistd.h>\\n')\ns=s.replace('    if (strcmp(argv[1], \"scroll\") == 0 && argc >= 4) {\\n', '    if (strcmp(argv[1], \"scroll\") == 0 && argc >= 4) {\\n      unlink(argv[3]);\\n')\nopen(p,'w').write(s)\nPY\nmake -C /app/hullcue -f /app/hullcue/hull.mk clean 2>/dev/null || true\nrm -f /app/hullcue/*.o /app/knothub/*.o /app/readcue/*.o /app/inkurn/*.o /app/emiturn/*.o /app/inkfold/*.o\nmake -C /app/hullcue -f /app/hullcue/hull.mk hull HULLBIN=/app/bin/rimlock\n"]
