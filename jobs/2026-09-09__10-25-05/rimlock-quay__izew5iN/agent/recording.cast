[22.572125, "o", "===== /app/readcue/scan.c =====\r\n"]
[22.573113, "o", "     1\t#include \"scan.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n     6\t#include <string.h>\r\n     7\t\r\n     8\tstatic void reset_g(void) {\r\n     9\t  memset(G, 0, sizeof(G));\r\n    10\t  GN = 0;\r\n    11\t  g_closer = 1;\r\n    12\t  PN = 0;\r\n    13\t}\r\n    14\t\r\n    15\tint scan_dump(const char *path) {\r\n    16\t  FILE *f;\r\n    17\t  char line[160];\r\n    18\t  int open = 0;\r\n    19\t\r\n    20\t  reset_g();\r\n"]
[22.573227, "o", "    21\t  f = fopen(path, \"r\");\r\n    22\t  if (!f) {\r\n    23\t    return 2;\r\n    24\t  }\r\n    25\t  while (fgets(line, sizeof line, f)) {\r\n    26\t    char *nl = strchr(line, '\\n');\r\n    27\t    if (nl) {\r\n    28\t      *nl = 0;\r\n    29\t    }\r\n    30\t    if (line[0] == 0) {\r\n    31\t      continue;\r\n    32\t    }\r\n    33\t    if (strncmp(line, \"THREAD \", 7) == 0) {\r\n    34\t      if (open) {\r\n    35\t        g_closer = 0;\r\n    36\t      }\r\n    37\t      if (GN >= MAXL) {\r\n    38\t        fclose(f);\r\n    39\t        return 2;\r\n    40\t      }\r\n    41\t      G[GN].tid = (uint32_t)atoi(line + 7);\r\n    42\t      open = 1;\r\n    43\t      GN++;\r\n    44\t      continue;\r\n    45\t    }\r\n    46\t    if (!open) {\r\n    47\t      continue;\r\n    48\t    }\r\n    49\t    if (strncmp(line, \"OWN \", 4) == 0) {\r\n    50\t      snprintf(G[GN - 1].hex, sizeof G[GN - 1].hex, \"%s\", line + 4);\r\n    51\t      continue;\r\n    52\t"]
[22.573265, "o", "    }\r\n    53\t    if (strncmp(line, \"WAIT \", 5) == 0) {\r\n    54\t      snprintf(G[GN - 1].wait_hex, sizeof G[GN - 1].wait_hex, \"%s\", line + 5);\r\n    55\t      G[GN - 1].has_wait = 1;\r\n    56\t      continue;\r\n    57\t    }\r\n"]
[22.573282, "o", "    58\t    if (strcmp(line, \".\") == 0) {\r\n"]
[22.573298, "o", "    59\t      open = 0;\r\n    60\t      continue;\r\n    61\t    }\r\n    62\t  }\r\n    63\t  fclose(f);\r\n"]
[22.573312, "o", "    64\t  if (open) {\r\n    65\t    g_closer = 0;\r\n    66\t  }\r\n"]
[22.573325, "o", "    67\t  return GN > 0 ? 0 : 2;\r\n    68\t}\r\n"]
[22.573599, "o", "===== /app/readcue/scan.h =====\r\n"]
[22.574477, "o", "     1\t#ifndef SCAN_H\r\n     2\t#define SCAN_H\r\n     3\tint scan_dump(const char *path);\r\n     4\t#endif\r\n"]
[22.574681, "o", "===== /app/inkurn/book.c =====\r\n"]
[22.575537, "o", "     1\t#include \"book.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tint book_load(const char *path) {\r\n     8\t  FILE *f;\r\n     9\t  char line[160];\r\n    10\t  char hx[40];\r\n    11\t  unsigned id;\r\n    12\t\r\n    13\t  f = fopen(path, \"r\");\r\n    14\t  if (!f) {\r\n    15\t    return 2;\r\n    16\t  }\r\n    17\t  while (fgets(line, sizeof line, f)) {\r\n"]
[22.575687, "o", "    18\t    if (sscanf(line, \"%39s %u\", hx, &id) != 2) {\r\n    19\t      continue;\r\n    20\t    }\r\n    21\t    if (hx[0] == 'h' || strcmp(hx, \"hex\") == 0) {\r\n    22\t      continue;\r\n    23\t    }\r\n    24\t    for (int i = 0; i < GN; i++) {\r\n    25\t      if (strcmp(G[i].hex, hx) == 0) {\r\n    26\t        G[i].tag = id;\r\n    27\t      }\r\n    28\t      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) {\r\n    29\t        G[i].wait_tag = id;\r\n    30\t      }\r\n    31\t    }\r\n    32\t  }\r\n    33\t  fclose(f);\r\n    34\t  return 0;\r\n    35\t}\r\n"]
