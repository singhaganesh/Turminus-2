[22.567753, "o", "===== /app/hullcue/main.c =====\r\n"]
[22.568616, "o", "     1\t#include \"../knothub/store.h\"\r\n     2\t#include \"../readcue/scan.h\"\r\n     3\t#include \"../inkurn/book.h\"\r\n     4\t#include \"../knothub/graph.h\"\r\n     5\t#include \"../inkfold/fold.h\"\r\n     6\t\r\n     7\t#include <stdio.h>\r\n     8\t#include <string.h>\r\n     9\t\r\n    10\tint assay_run(const char *dump, const char *out);\r\n    11\t\r\n"]
[22.568651, "o", "    12\tint main(int argc, char **argv) {\r\n    13\t  if (argc < 2) {\r\n    14\t    fputs(\"usage\\n\", stderr);\r\n    15\t    return 2;\r\n    16\t  }\r\n    17\t  if (strcmp(argv[1], \"unjam\") == 0 && argc >= 4) {\r\n    18\t    return assay_run(argv[2], argv[3]);\r\n    19\t  }\r\n    20\t  if (strcmp(argv[1], \"scroll\") == 0 && argc >= 4) {\r\n    21\t    snprintf(g_path, sizeof g_path, \"%s\", argv[2]);\r\n    22\t    if (scan_dump(argv[2]) != 0) {\r\n    23\t      return 2;\r\n    24\t    }\r\n    25\t    return cfg_fold(argv[3]);\r\n    26\t  }\r\n    27\t  if (strcmp(argv[1], \"roster\") == 0 && argc >= 3) {\r\n"]
[22.568669, "o", "    28\t    if (scan_dump(argv[2]) != 0) {\r\n    29\t      return 2;\r\n    30\t    }\r\n    31\t    if (book_load(\"/app/inkurn/book.tsv\") != 0) {\r\n    32\t      return 2;\r\n"]
[22.568682, "o", "    33\t    }\r\n    34\t    graph_build();\r\n    35\t    roster_out();\r\n    36\t    return 0;\r\n    37\t  }\r\n"]
[22.568856, "o", "    38\t  fputs(\"usage\\n\", stderr);\r\n    39\t  return 2;\r\n    40\t}\r\n"]
[22.568897, "o", "===== /app/hullcue/go.c =====\r\n"]
[22.569851, "o", "     1\t#include \"../knothub/store.h\"\r\n     2\t#include \"../readcue/scan.h\"\r\n     3\t#include \"../inkurn/book.h\"\r\n     4\t#include \"../knothub/graph.h\"\r\n     5\t#include \"../knothub/pick.h\"\r\n     6\t#include \"../emiturn/bind.h\"\r\n     7\t#include \"rank.h\"\r\n     8\t\r\n     9\t#include <stdio.h>\r\n    10\t#include <string.h>\r\n    11\t\r\n    12\tint assay_run(const char *dump, const char *out) {\r\n    13\t  snprintf(g_path, sizeof g_path, \"%s\", dump);\r\n    14\t  if (scan_dump(dump) != 0) {\r\n    15\t    return 2;\r\n    16\t  }\r\n    17\t  if (book_load(\"/app/inkurn/book.tsv\") != 0) {"]
[22.569937, "o", "\r\n    18\t    return 2;\r\n    19\t  }\r\n    20\t  graph_build();\r\n    21\t  op_pick();\r\n    22\t  rk_wrap();\r\n    23\t  return n_bind(out);\r\n    24\t}\r\n"]
[22.570066, "o", "===== /app/hullcue/rank.c =====\r\n"]
[22.570909, "o", "     1\t#include \"rank.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\tvoid rk_wrap(void) {\r\n     5\t  int q[MAXL];\r\n     6\t  int qh = 0;\r\n     7\t  int qt = 0;\r\n     8\t\r\n     9\t  for (int i = 0; i < GN; i++) {\r\n    10\t    G[i].depth = 0;\r\n    11\t    if (!G[i].has_wait) {\r\n    12\t      q[qt++] = i;\r\n    13\t    }\r\n    14\t  }\r\n    15\t  while (qh < qt) {\r\n"]
[22.570945, "o", "    16\t    int i = q[qh++];\r\n    17\t    for (int k = 0; k < nsucc[i]; k++) {\r\n    18\t      int j = succ[i][k];\r\n    19\t      int d = G[i].depth + 1;\r\n    20\t      if (d > G[j].depth) {\r\n    21\t        G[j].depth = d;\r\n    22\t      }\r\n    23\t      if (qt < MAXL * 3) {\r\n    24\t        q[qt++] = j;\r\n    25\t      }\r\n    26\t    }\r\n"]
[22.570958, "o", "    27\t  }\r\n    28\t}\r\n"]
