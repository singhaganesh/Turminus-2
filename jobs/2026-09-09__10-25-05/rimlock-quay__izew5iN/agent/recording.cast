[36.41083, "o", "     1\t#include \"pick.h\"\r\n     2\t#include \"store.h\"\r\n     3\t\r\n     4\tint op_pick(void) {\r\n     5\t  int q[MAXL];\r\n     6\t  int enq[MAXL];\r\n"]
[36.410923, "o", "     7\t  int qh = 0;\r\n     8\t  int qt = 0;\r\n     9\t  int i;\r\n    10\t\r\n    11\t  PN = 0;\r\n    12\t  for (i = 0; i < GN; i++) {\r\n    13\t    enq[i] = 0;"]
[36.410954, "o", "\r\n    14\t  }\r\n    15\t  for (i = 0; i < GN; i++) {\r\n    16\t    if (G[i].indeg == 0) {\r\n    17\t      q[qt++] = i;\r\n    18\t      enq[i] = 1;\r\n    19\t    }\r\n    20\t  }\r\n    21\t  while (qh < qt) {\r\n    22\t    int cur = q[qh++];\r\n    23\t    int k;\r\n    24\t    if (G[cur].done) {\r\n    25\t      continue;\r\n    26\t    }\r\n    27\t    PLAN[PN++] = cur;\r\n    28\t    G[cur].done = 1;\r\n    29\t    for (k = 0; k < nsucc[cur]; k++) {\r\n    30\t      int j = succ[cur][k];\r\n    31\t      if (G[j].indeg > 0) {\r\n    32\t        G[j].indeg--;\r\n    33\t      }\r\n"]
[36.410976, "o", "    34\t      if (G[j].indeg == 0 && !enq[j]) {\r\n    35\t        q[qt++] = j;\r\n    36\t        enq[j] = 1;\r\n    37\t      }\r\n    38\t    }\r\n    39\t  }\r\n    40\t  for (i = 0; i < GN; i++) {\r\n    41\t    if (!G[i].done) {\r\n"]
[36.410994, "o", "    42\t      PLAN[PN++] = i;\r\n    43\t      G[i].done = 1;\r\n    44\t    }\r\n    45\t  }\r\n    46\t  return 0;\r\n    47\t}\r\n"]
[36.41116, "o", "===== /app/knothub/cycle.c =====\r\n"]
[36.412203, "o", "     1\t#include \"store.h\"\r\n     2\t#include \"../inkurn/book.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n     6\t#include <string.h>\r\n     7\t\r\n     8\tstatic int cmp_u(const void *a, const void *b) {\r\n     9\t  uint32_t x = *(const uint32_t *)a;\r\n    10\t  uint32_t y = *(const uint32_t *)b;\r\n    11\t  if (x < y) {\r\n    12\t    return -1;\r\n    13\t  }\r\n    14\t  if (x > y) {\r\n    15\t    return 1;\r\n"]
[36.412366, "o", "    16\t  }\r\n    17\t  return 0;\r\n    18\t}\r\n    19\t\r\n    20\tvoid roster_out(void) {\r\n    21\t  uint32_t cyc[MAXL];\r\n    22\t  int cn = 0;\r\n    23\t  int seen[MAXL];\r\n    24\t\r\n    25\t  memset(seen, 0, sizeof seen);\r\n    26\t  for (int i = 0; i < GN; i++) {\r\n    27\t    if (G[i].has_wait) {\r\n    28\t      int w = -1;\r\n    29\t      for (int j = 0; j < GN; j++) {\r\n    30\t        if (strcmp(G[j].hex, G[i].wait_hex) == 0) {\r\n    31\t          w = j;\r\n    32\t          break;\r\n    33\t        }\r\n    34\t      }\r\n    35\t      if (w >= 0 && G[w].has_wait && strcmp(G[w].wait_hex, G[i].hex) == 0) {\r\n    36\t        if (!seen[i]) {\r\n    37\t          cyc[cn++] = G[i].tag;\r\n    38\t          seen[i] = 1;\r\n    39\t        }\r\n    40\t        if (!seen[w]) {\r\n    41\t          cyc[cn++] = G[w].tag;\r\n    42\t          seen[w] = 1;\r\n    43\t        }\r\n    44\t      }\r\n    45\t    }\r\n    46\t  }\r\n    47\t  qsort(cyc, (size_t)cn, sizeof cyc[0], cmp_u);\r\n    48\t  fputs(\"CYCLE\", stdout);\r\n    49\t  for (int i = 0; i < cn; i++) {\r\n    50\t    printf(\" %u\", cyc[i]);\r\n    51\t  }\r\n    52\t  fputc('\\n', stdout);\r\n    53\t  for (int i = 0; i < GN; i++) {\r\n    54\t    printf(\"OWNER %u=%u\\n\", G[i].tag, G[i].tid);\r\n    55\t  }\r\n    56\t}\r\n"]
[36.412733, "o", "===== /app/emiturn/bind.c =====\r\n"]
[36.415579, "o", "     1\t#include \"bind.h\"\r\n     2\t#include \"../knothub/store.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic const char *wire_token(const LockRec *r) {\r\n     8\t  return r->hex;\r\n     9\t}\r\n    10\t\r\n    11\tstatic void dir_of(const char *a, char *dir, size_t cap) {\r\n    12\t  const char *slash = strrchr(a, '/');\r\n    13\t  if (!slash) {\r\n    14\t    snprintf(dir, cap, \".\");\r\n    15\t    return;\r\n    16\t  }\r\n"]
[36.415757, "o", "    17\t  size_t n = (size_t)(slash - a);\r\n    18\t  if (n >= cap) {\r\n    19\t    n = cap - 1;\r\n    20\t  }\r\n    21\t  memcpy(dir, a, n);\r\n    22\t  dir[n] = 0;\r\n    23\t}\r\n    24\t\r\n    25\tint n_bind(const char *a) {\r\n    26\t  FILE *f;\r\n    27\t  FILE *ok;\r\n    28\t  char dir[128];\r\n    29\t  char okp[160];\r\n    30\t  int i;\r\n    31\t\r\n    32\t  dir_of(a, dir, sizeof dir);\r\n    33\t  snprintf(okp, sizeof okp, \"%s/mill.ok\", dir);\r\n    34\t\r\n"]
[36.415886, "o", "    35\t  f = fopen(a, \"w\");\r\n    36\t  if (!f) {\r\n    37\t    return 2;\r\n    38\t  }\r\n    39\t  for (i = 0; i < PN; i++) {\r\n    40\t    int k = PLAN[i];\r\n    41\t    fprintf(f, \"%s\\n\", wire_token(&G[k]));\r\n    42\t  }\r\n    43\t  fclose(f);\r\n    44\t\r\n    45\t  if (GN > 0) {\r\n    46\t    ok = fopen(okp, \"w\");\r\n    47\t    if (ok) {\r\n    48\t      fputs(\"ok\\n\", ok);\r\n    49\t      fclose(ok);\r\n    50\t    }\r\n    51\t  }\r\n    52\t  return 0;\r\n    53\t}\r\n"]
[36.416111, "o", "\u001b[?2004h"]
[36.416184, "o", "root@16f686bd3677:/app# "]
[114.191011, "i", "cat > /app/readcue/scan.c <<'EOF'\n#include \"scan.h\"\n#include \"../knothub/store.h\"\n\n#include <errno.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic void reset_g(void) {\n  memset(G, 0, sizeof(G));\n  GN = 0;\n  g_closer = 1;\n  PN = 0;\n}\n\nstatic int parse_u32(const char *s, uint32_t *v) {\n  char *end;\n  unsigned long n;\n  errno = 0;\n  n = strtoul(s, &end, 10);\n  if (errno || end == s || *end != '\\0' || n > UINT32_MAX) return -1;\n  *v = (uint32_t)n;\n  return 0;\n}\n\nint scan_dump(const char *path) {\n  FILE *f;\n  char line[160];\n  int open = 0;\n  int have_own = 0;\n\n  reset_g();\n  f = fopen(path, \"r\");\n  if (!f) return 2;\n  while (fgets(line, sizeof line, f)) {\n    char *nl = strchr(line, '\\n');\n    if (nl) *nl = 0;\n    else if (!feof(f)) { fclose(f); return 2; }\n    if (line[0] == 0) continue;\n    if (strncmp(line, \"THREAD \", 7) == 0) {\n      if (open || GN >= MAXL || parse_u32(line + 7, &G[GN].tid) != 0) {\n        fclose(f); return 2;\n      }\n      open = 1;\n      have_own = 0;\n      GN++;\n    } else if (!open) {\n      fclose(f); return 2;\n    } else if (strncmp(line, \"OWN \", 4) == 0) {\n      if (have_own || line[4] == 0) { fclose(f); return 2; }\n      snprintf(G[GN - 1].hex, sizeof G[GN - 1].hex, \"%s\", line + 4);\n      have_own = 1;\n    } else if (strncmp(line, \"WAIT \", 5) == 0) {\n      if (G[GN - 1].has_wait || line[5] == 0) { fclose(f); return 2; }\n      snprintf(G[GN - 1].wait_hex, sizeof G[GN - 1].wait_hex, \"%s\", line + 5);\n      G[GN - 1].has_wait = 1;\n    } else if (strcmp(line, \".\") == 0) {\n      if (!have_own) { fclose(f); return 2; }\n      open = 0;\n    } else {\n      fclose(f); return 2;\n    }\n  }\n  if (ferror(f)) { fclose(f); return 2; }\n  fclose(f);\n  if (open) g_closer = 0;\n  return (GN > 0 && g_closer) ? 0 : 2;\n}\nEOF\n\ncat > /app/inkurn/book.c <<'EOF'\n#include \"book.h\"\n#include \"../knothub/store.h\"\n\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n\nint book_load(const char *path) {\n  FILE *f;\n  char line[160], hx[40];\n  unsigned id;\n  int own[MAXL] = {0}, wait[MAXL] = {0};\n\n  f = fopen(path, \"r\");\n  if (!f) return 2;\n  while (fgets(line, sizeof line, f)) {\n    if (sscanf(line, \"%39s %u\", hx, &id) != 2) continue;\n    if (strcmp(hx, \"hex\") == 0) continue;\n    for (int i = 0; i < GN; i++) {\n      if (strcmp(G[i].hex, hx) == 0) {\n        G[i].tag = (uint32_t)id; own[i] = 1;\n      }\n      if (G[i].has_wait && strcmp(G[i].wait_hex, hx) == 0) {\n        G[i].wait_tag = (uint32_t)id; wait[i] = 1;\n      }\n    }\n  }\n  if (ferror(f)) { fclose(f); return 2; }\n  fclose(f);\n  for (int i = 0; i < GN; i++)\n    if (!own[i] || (G[i].has_wait && !wait[i])) return 2;\n  return 0;\n}\nEOF\n\ncat > /app/knothub/pick.c <<'EOF'\n#include \"pick.h\"\n#include \"store.h\"\n\nstatic int before(int a, int b) {\n  if (b < 0) return 1;\n  if (G[a].tag != G[b].tag) return G[a].tag < G[b].tag;\n  if (G[a].tid != G[b].tid) return G[a].tid < G[b].tid;\n  return a < b;\n}\n\nint op_pick(void) {\n  PN = 0;\n  for (int i = 0; i < GN; i++) G[i].done = 0;\n  while (PN < GN) {\n    int cur = -1;\n    for (int i = 0; i < GN; i++)\n      if (!G[i].done && G[i].indeg == 0 && before(i, cur)) cur = i;\n    /* No releasable node means a cycle: break it at the least identity. */\n    if (cur < 0)\n      for (int i = 0; i < GN; i++)\n        if (!G[i].done && before(i, cur)) cur = i;\n    if (cur < 0) return 2;\n    PLAN[PN++] = cur;\n    G[cur].done = 1;\n    for (int k = 0; k < nsucc[cur]; k++) {\n      int j = succ[cur][k];\n      if (!G[j].done && G[j].indeg > 0) G[j].indeg--;\n    }\n  }\n  return 0;\n}\nEOF\n\ncat > /app/hullcue/rank.c <<'EOF'\n#include \"rank.h\"\n#include \"../knothub/store.h\"\n\n/* Compute bounded wait depth in selected order.  PLAN ordering is deliberately\n   retained: op_pick already resolves equal-depth choices by identity. */\nvoid rk_wrap(void) {\n  for (int i = 0; i < GN; i++) G[i].depth = 0;\n  for (int p = 0; p < PN; p++) {\n    int i = PLAN[p];\n    for (int k = 0; k < nsucc[i]; k++) {\n      int j = succ[i][k];\n      if (G[j].done && G[j].depth < G[i].depth + 1)\n        G[j].depth = G[i].depth + 1;\n    }\n  }\n}\nEOF\n"]
