[10.180614, "o", "--- ROUTE ---\r\n"]
[10.181748, "o", "hullcue — CLI\r\nknothub — graph and pick\r\nemiturn — destination write\r\ninkfold — runbook write\r\nreadcue — dump scan\r\ninkurn — identity book\r\nhullcue/hull.mk — mill link: make -C /app/hullcue -f /app/hullcue/hull.mk hull HULLBIN=/tmp/rimlock.ref\r\n\r\n"]
[10.181965, "o", "--- FORMS ---\r\n"]
[10.182839, "o", "THREAD <tid>\r\nOWN <hex>\r\nWAIT <hex>\r\n.\r\n\r\nEach thread block ends with a lone closer line \".\". OWN names the monitor the thread holds. WAIT names the monitor it is blocked on. Identity for emit is column two of /app/inkurn/book.tsv.\r\n"]
[10.183025, "o", "--- TREE ---\r\n"]
