[52.352253, "o", "> "]
[52.352597, "o", "        let _name = parts.next()?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.352698, "o", "        let pos: u32 = parts.next()?.parse().ok()?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.352844, "o", "        let n: u32 = parts.next()?.parse().ok()?;\r\n\u001b[?2004l\r"]
[52.352979, "o", "\u001b[?2004h> "]
[52.353048, "o", "        end = end.max(pos.checked_add(n)?);\r\n\u001b[?2004l\r"]
[52.353074, "o", "\u001b[?2004h> "]
[52.35314, "o", "        found = true;\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.353231, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.353249, "o", "> "]
[52.353332, "o", "    if found { Some(end) } else { None }\r\n\u001b[?2004l\r"]
[52.353351, "o", "\u001b[?2004h"]
[52.353404, "o", "> }\r\n"]
[52.35342, "o", "\u001b[?2004l\r"]
[52.353475, "o", "\u001b[?2004h> "]
[52.353785, "o", "EOF\r\n\u001b[?2004l\r"]
[52.355362, "o", "\u001b[?2004hroot@7e9eed13cd94:/app# "]
[52.355685, "o", "cat > /app/peekurn/ink.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use crate::pull;\r\n\u001b[?2004l\r\u001b[?2004h> use crate::tally;\r\n\u001b[?2004l\r\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r"]
[52.355737, "o", "\u001b[?2004h> "]
[52.355985, "o", "use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn rib_c() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.356409, "o", "    let dest = Path::new(\"/app/blotbay/rows.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     // Never allow output from an earlier pour to survive a failed pour.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.356582, "o", "    let _ = fs::remove_file(dest);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.356732, "o", "    let width = match tally::width() {\r\n\u001b[?2004l\r"]
[52.356794, "o", "\u001b[?2004h> "]
[52.35693, "o", "        Some(width) => width,\r\n\u001b[?2004l\r"]
[52.357166, "o", "\u001b[?2004h>         None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[52.357324, "o", "\u001b[?2004h"]
[52.358853, "o", ">     let _coverage = tally::lines();\r\n\u001b[?2004l\r\u001b[?2004h>     let buf = match fs::read(\"/app/quaybag/night.bin\") {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(buf) => buf,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     if (buf.len() as u64) * 8 < u64::from(width) {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let (a, b, c, d, e, f) = pull::dump(&buf);\r\n\u001b[?2004l\r\u001b[?2004h>     let body = format!(\r\n\u001b[?2004l\r\u001b[?2004h>         \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\r\n\u001b[?2004l\r\u001b[?2004h>         a, b, c, d, e, f\r\n\u001b[?2004l\r\u001b[?2004h>     );\r\n\u001b[?2004l\r\u001b[?2004h>     if let Some(parent) = dest.parent() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.358927, "o", "> "]
[52.359108, "o", "        if fs::create_dir_all(parent).is_err() {\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.359135, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.35915, "o", "    }\r\n\u001b[?2004l\r"]
[52.359389, "o", "\u001b[?2004h>     match fs::write(dest, body) {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(()) => 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.35948, "o", "        Err(_) => 1,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[52.35951, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[52.359605, "o", "\u001b[?2004h> "]
[52.359623, "o", "EOF\r\n\u001b[?2004l\r"]
[52.36086, "o", "\u001b[?2004hroot@7e9eed13cd94:/app# "]
[52.361007, "o", "/app/wick.sh\r\n\u001b[?2004l\r"]
[54.371325, "o", "\u001b[?2004hroot@7e9eed13cd94:/app# "]
[56.301341, "i", "set +e; echo '--- generated pull ---'; cat /app/vaultbin/pull.rs; echo '--- ELF and normal pour ---'; od -An -tx1 -N4 /app/bin/weltquay; rm -f /app/blotbay/rows.json; /app/bin/weltquay pour; good_rc=$?; echo \"normal_rc=$good_rc\"; cat /app/blotbay/rows.json; echo '--- short-body test ---'; cp /app/quaybag/night.bin /tmp/night.bin.saved; head -c 3 /tmp/night.bin.saved > /app/quaybag/night.bin; /app/bin/weltquay pour; short_rc=$?; echo \"short_rc=$short_rc\"; if test -e /app/blotbay/rows.json; then echo 'ERROR: rows.json remains'; ls -l /app/blotbay/rows.json; else echo 'rows.json absent'; fi; mv /tmp/night.bin.saved /app/quaybag/night.bin; /app/bin/weltquay pour; final_rc=$?; echo \"final_rc=$final_rc\"; cat /app/blotbay/rows.json; test \"$good_rc\" -eq 0 -a \"$short_rc\" -ne 0 -a \"$final_rc\" -eq 0\n"]
[56.30381, "o", "set +e; echo '--- generated pull ---'; cat /app/vaultbin/pull.rs; echo '--- ELF and normal pour ---'; od -An -tx1 -N4 /app/bin/weltquay; rm -f /app/blotbay/rows.json; /app/bin/weltquay pour; good_rc=$?; echo \"normal_rc=$good_rc\"; cat /app/blotbay/rows.json; echo '--- short-body test ---'; cp /app/quaybag/night.bin /tmp/night.bin.saved; head -c 3 /tmp/night.bin.saved > /app/quaybag/night.bin; /app/bin/weltquay pour; short_rc=$?; echo \"short_rc=$short_rc\"; if test -e /app/blotbay/rows.json; then echo 'ERROR: rows.json remains'; ls -l /app/blotbay/rows.json; else echo 'rows.json absent'; fi; mv /tmp/night.bin.saved /app/quaybag/night.bin; /app/bin/weltquay pour; final_rc=$?; echo \"final_rc=$final_rc\"; cat /app/blotbay/rows.json; test \"$good_rc\" -eq 0 -a \"$short_rc\" -ne 0 -a \"$final_rc\" -eq 0\r\n\u001b[?2004l\r--- generated pull ---\r\n"]
[56.304963, "o", "use crate::take;\r\n\r\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n    (\r\n        take::rib_a(buf, 0, 3),\r\n        take::rib_a(buf, 3, 5),\r\n        take::rib_a(buf, 8, 4),\r\n        take::rib_a(buf, 12, 9),\r\n        take::rib_a(buf, 21, 3),\r\n        take::rib_a(buf, 24, 8),\r\n    )\r\n}\r\n"]
