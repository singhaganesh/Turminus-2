[9.188292, "i", "pwd; cat /app/keepfold/TREE.txt; printf '\\n--- files ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort; printf '\\n--- executables ---\\n'; file /app/bin/weltquay /app/quaybag/night.bin\n"]
[9.18888, "o", "pwd; cat /app/keepfold/TREE.txt; printf '\\n--- files ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort; printf '\\n--- executables ---\\n'; file /app/bin/weltquay /app/quaybag/night.bin\r\n\u001b[?2004l\r"]
[9.189089, "o", "/app\r\n"]
[9.190149, "o", "weltquay mill\r\n===============\r\n\r\nweltcli/boot.rs dispatches pour.\r\n\r\nPipeline modules:\r\n- octetkiln/  kiln take and emit\r\n- stitchbay/  layout row load used by emit\r\n- peekurn/    pour writer\r\n- vaultbin/   baked pull used by pour\r\n- nudgepit/   line tally\r\n\r\nLayout rows live in /app/ribcards/LAYOUT.txt.\r\nEach row is a name, a bit index, and a width.\r\nOctets are packed from the high bit of the first octet.\r\npour reads /app/quaybag/night.bin and writes /app/blotbay/rows.json.\r\n\r\nRebuild the binary with /app/wick.sh after source edits.\r\n"]
[9.190332, "o", "\r\n--- files ---\r\n"]
[9.19484, "o", "/app/bin/weltquay\r\n/app/blotbay/rows.json\r\n/app/keepfold/COVER.txt\r\n/app/keepfold/TREE.txt\r\n/app/nudgepit/tally.rs\r\n/app/octetkiln/emit.rs\r\n/app/octetkiln/take.rs\r\n/app/peekurn/ink.rs\r\n/app/quaybag/night.bin\r\n/app/ribcards/LAYOUT.txt\r\n/app/stitchbay/card.rs\r\n/app/vaultbin/pull.rs\r\n/app/weltcli/boot.rs\r\n/app/weltcli/usage.txt\r\n/app/wick.sh\r\n"]
[9.195161, "o", "\r\n--- executables ---\r\n"]
[9.195528, "o", "bash: file: command not found\r\n"]
[9.19578, "o", "\u001b[?2004h"]
[9.195859, "o", "root@7e9eed13cd94:/app# "]
[10.231634, "i", "rm -f /app/blotbay/rows.json; /app/bin/weltquay pour; rc=$?; echo \"RC=$rc\"; ls -l /app/blotbay 2>/dev/null; test -f /app/blotbay/rows.json && cat /app/blotbay/rows.json\n"]
[10.232345, "o", "rm -f /app/blotbay/rows.json; /app/bin/weltquay pour; rc=$?; echo \"RC=$rc\"; ls -l /app/blotbay 2>/dev/null; test -f /app/blotbay/rows.json && cat /app/blotbay/rows.json"]
[10.232962, "o", "\r\n\u001b[?2004l\r"]
[10.250554, "o", "RC=0\r\n"]
[10.256356, "o", "total 4\r\n"]
[10.256509, "o", "-rw-r--r-- 1 root root 60 Sep 16 05:15 rows.json\r\n"]
[10.257419, "o", "{\"kind\":5,\"lane\":17,\"mode\":9,\"welt\":62,\"tail\":6,\"mark\":165}\r\n"]
[10.257623, "o", "\u001b[?2004hroot@7e9eed13cd94:/app# "]
[20.06621, "i", "printf '%s\\n' '--- LAYOUT ---'; cat /app/ribcards/LAYOUT.txt; printf '%s\\n' '--- COVER ---'; cat /app/keepfold/COVER.txt; printf '%s\\n' '--- SOURCES ---'; for f in /app/weltcli/boot.rs /app/octetkiln/take.rs /app/octetkiln/emit.rs /app/stitchbay/card.rs /app/peekurn/ink.rs /app/vaultbin/pull.rs /app/nudgepit/tally.rs /app/wick.sh; do echo \"### $f\"; sed -n '1,240p' \"$f\"; done\n"]
[20.067239, "o", "printf '%s\\n' '--- LAYOUT ---'; cat /app/ribcards/LAYOUT.txt; printf '%s\\n' '--- COVER ---'; cat /app/keepfold/COVER.txt; printf '%s\\n' '--- SOURCES ---'; for f in /app/weltcli/boot.rs /app/octetkiln/take.rs /app/octetkiln/emit.rs /app/stitchbay/card.rs /app/peekurn/ink.rs /app/vaultbin/pull.rs /app/nudgepit/tally.rs /app/wick.sh; do echo \"### $f\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[20.067355, "o", "--- LAYOUT ---\r\n"]
[20.068411, "o", "kind 0 3\r\nlane 3 5\r\nmode 8 4\r\nwelt 12 9\r\ntail 21 3\r\nmark 24 8\r\n"]
[20.06885, "o", "--- COVER ---\r\n"]
[20.069548, "o", "Desk cover\r\n==========\r\n\r\nCoverage is the number of lines in /app/ribcards/LAYOUT.txt.\r\n\r\nIf a row's width is greater than eight, some desks add one octet\r\nto that row's start before baking pull.rs.\r\n"]
[20.069727, "o", "--- SOURCES ---\r\n"]
[20.069768, "o", "### /app/weltcli/boot.rs\r\n"]
[20.072994, "o", "#[path = \"../octetkiln/take.rs\"]\r\nmod take;\r\n#[path = \"../vaultbin/pull.rs\"]\r\nmod pull;\r\n#[path = \"../peekurn/ink.rs\"]\r\nmod vat;\r\n#[path = \"../nudgepit/tally.rs\"]\r\nmod tally;\r\n\r\nfn main() {\r\n    let mut args = std::env::args().skip(1);\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"pour\" => vat::rib_c(),\r\n        _ => {\r\n            eprintln!(\"usage: weltquay pour\");\r\n            2\r\n        }\r\n"]
[20.073114, "o", "    };\r\n    std::process::exit(code);\r\n}\r\n"]
[20.073297, "o", "### /app/octetkiln/take.rs\r\n"]
[20.074559, "o", "pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n    if n == 0 {\r\n        return 0;\r\n    }\r\n    let i = (pos / 8) as usize;\r\n    if i >= buf.len() {\r\n        return 0;\r\n    }\r\n    let bit = pos % 8;\r\n"]
[20.074654, "o", "    let room = 8 - bit;\r\n    let w = if n > room { room } else { n };\r\n    let shift = 8 - bit - w;\r\n    ((buf[i] as u32) >> shift) & ((1u32 << w) - 1)\r\n}\r\n"]
[20.074833, "o", "### /app/octetkiln/emit.rs\r\n"]
[20.075853, "o", "use std::fs;\r\n\r\n#[path = \"../stitchbay/card.rs\"]\r\nmod card;\r\n\r\n"]
[20.075888, "o", "fn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {\r\n    for row in rows {\r\n        if row.tag == tag {\r\n            return (row.pos, row.n);\r\n        }\r\n    }\r\n    (0, 0)\r\n}\r\n\r\nfn main() {\r\n    let rows = card::rib_b();\r\n"]
[20.075908, "o", "    let (k0, k1) = pick(&rows, \"kind\");\r\n    let (l0, l1) = pick(&rows, \"lane\");\r\n    let (m0, m1) = pick(&rows, \"mode\");\r\n    let (w0, w1) = pick(&rows, \"welt\");\r\n    let (t0, t1) = pick(&rows, \"tail\");\r\n    let (x0, x1) = pick(&rows, \"mark\");\r\n"]
[20.075922, "o", "    let body = format!(\r\n        r#\"use crate::take;\r\n\r\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\r\n    (\r\n"]
[20.075933, "o", "        take::rib_a(buf, {k0}, {k1}),\r\n        take::rib_a(buf, {l0}, {l1}),\r\n        take::rib_a(buf, {m0}, {m1}),\r\n        take::rib_a(buf, {w0}, {w1}),\r\n"]
[20.075944, "o", "        take::rib_a(buf, {t0}, {t1}),\r\n        take::rib_a(buf, {x0}, {x1}),\r\n    )\r\n}}\r\n"]
[20.075963, "o", "\"#\r\n    );\r\n    let _ = fs::create_dir_all(\"/app/vaultbin\");\r\n    fs::write(\"/app/vaultbin/pull.rs\", body).expect(\"emit\");\r\n}\r\n"]
[20.076146, "o", "### /app/stitchbay/card.rs\r\n"]
[20.07716, "o", "pub struct Row {\r\n    pub tag: String,\r\n    pub pos: u32,\r\n    pub n: u32,\r\n}\r\n\r\nfn tok(line: &str) -> Vec<String> {\r\n"]
[20.077198, "o", "    line.split_whitespace().map(|s| s.to_string()).collect()\r\n}\r\n\r\npub fn rib_b() -> Vec<Row> {\r\n    let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\").unwrap_or_default();\r\n    let mut out = Vec::new();\r\n    for line in text.lines() {\r\n        let raw = line.trim();\r\n        if raw.is_empty() || raw.starts_with('#') {\r\n            continue;\r\n        }\r\n        let parts = tok(raw);\r\n        if parts.len() < 3 {\r\n            continue;\r\n        }\r\n        let tag = parts[0].clone();\r\n        let mut pos: u32 = match parts[1].parse() {\r\n            Ok(v) => v,\r\n            Err(_) => continue,\r\n"]
[20.07731, "o", "        };\r\n        let n: u32 = match parts[2].parse() {\r\n            Ok(v) => v,\r\n            Err(_) => continue,\r\n        };\r\n        if n > 8 {\r\n"]
[20.07738, "o", "            pos = pos.saturating_add(8 - (pos % 8));\r\n        }\r\n        out.push(Row { tag, pos, n });\r\n    }\r\n    out\r\n}\r\n"]
[20.077469, "o", "### /app/peekurn/ink.rs\r\n"]
[20.078419, "o", "use crate::pull;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rib_c() -> i32 {\r\n"]
[20.078547, "o", "    let _ = tally::lines();\r\n    let buf = fs::read(\"/app/quaybag/night.bin\").unwrap_or_default();\r\n    let dest = Path::new(\"/app/blotbay/rows.json\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    let (a, b, c, d, e, f) = pull::dump(&buf);\r\n    let body = format!(\r\n        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\r\n        a, b, c, d, e, f\r\n    );\r\n    let _ = fs::write(dest, body);\r\n    0\r\n}\r\n"]
[20.078789, "o", "### /app/vaultbin/pull.rs\r\n"]
[20.079855, "o", "use crate::take;\r\n\r\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n    (\r\n        take::rib_a(buf, 0, 3),\r\n        take::rib_a(buf, 3, 5),\r\n        take::rib_a(buf, 8, 4),\r\n        take::rib_a(buf, 16, 9),\r\n        take::rib_a(buf, 21, 3),\r\n        take::rib_a(buf, 24, 8),\r\n    )\r\n}\r\n"]
[20.080049, "o", "### /app/nudgepit/tally.rs\r\n"]
[20.081032, "o", "pub fn lines() -> usize {\r\n    std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\r\n        .unwrap_or_default()\r\n        .lines()\r\n        .filter(|line| !line.trim().is_empty())\r\n        .count()\r\n}\r\n"]
[20.081244, "o", "### /app/wick.sh\r\n"]
[20.082209, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/blotbay /app/vaultbin\r\nrustc --edition 2021 -O /app/octetkiln/emit.rs -o /tmp/welt-emit\r\n/tmp/welt-emit\r\nrustc --edition 2021 -O /app/weltcli/boot.rs -o /app/bin/weltquay\r\n"]
[20.082448, "o", "\u001b[?2004hroot@7e9eed13cd94:/app# "]
[21.060099, "i", "printf '%s\\n' '--- ELF MAGIC ---'; od -An -tx1 -N16 /app/bin/weltquay; printf '%s\\n' '--- CAPTURE ---'; wc -c /app/quaybag/night.bin; od -An -tx1 -v /app/quaybag/night.bin\n"]
[21.060894, "o", "printf '%s\\n' '--- ELF MAGIC ---'; od -An -tx1 -N16 /app/bin/weltquay; printf '%s\\n' '--- CAPTURE ---'; wc -c /app/quaybag/night.bin; od -An -tx1 -v /app/quaybag/night.bin\r\n\u001b[?2004l\r"]
[21.061015, "o", "--- ELF MAGIC ---\r\n"]
[21.063182, "o", " 7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\r\n"]
[21.064406, "o", "--- CAPTURE ---\r\n"]
[21.066122, "o", "4 /app/quaybag/night.bin\r\n"]
[21.067003, "o", " b1 9d 3e a5\r\n"]
[21.067273, "o", "\u001b[?2004hroot@7e9eed13cd94:/app# "]
[52.319181, "i", "cat > /app/octetkiln/take.rs <<'EOF'\npub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\n    if n == 0 || n > 32 || pos.checked_add(n).map_or(true, |end| end as u64 > (buf.len() as u64) * 8) {\n        return 0;\n    }\n\n    let mut value = 0u32;\n    for offset in 0..n {\n        let at = pos + offset;\n        let octet = buf[(at / 8) as usize];\n        let bit = (octet >> (7 - (at % 8))) & 1;\n        value = (value << 1) | u32::from(bit);\n    }\n    value\n}\nEOF\npython3 - <<'PY'\np='/app/stitchbay/card.rs'\ns=open(p).read()\ns=s.replace('        let mut pos: u32 = match parts[1].parse() {', '        let pos: u32 = match parts[1].parse() {')\ns=s.replace('        if n > 8 {\\n            pos = pos.saturating_add(8 - (pos % 8));\\n        }\\n', '')\nopen(p,'w').write(s)\nPY\ncat > /app/nudgepit/tally.rs <<'EOF'\npub fn lines() -> usize {\n    std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\n        .unwrap_or_default()\n        .lines()\n        .filter(|line| {\n            let line = line.trim();\n            !line.is_empty() && !line.starts_with('#')\n        })\n        .count()\n}\n\npub fn width() -> Option<u32> {\n    let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\").ok()?;\n    let mut end = 0u32;\n    let mut found = false;\n    for line in text.lines() {\n        let line = line.trim();\n        if line.is_empty() || line.starts_with('#') {\n            continue;\n        }\n        let mut parts = line.split_whitespace();\n        let _name = parts.next()?;\n        let pos: u32 = parts.next()?.parse().ok()?;\n        let n: u32 = parts.next()?.parse().ok()?;\n        end = end.max(pos.checked_add(n)?);\n        found = true;\n    }\n    if found { Some(end) } else { None }\n}\nEOF\ncat > /app/peekurn/ink.rs <<'EOF'\nuse crate::pull;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rib_c() -> i32 {\n    let dest = Path::new(\"/app/blotbay/rows.json\");\n    // Never allow output from an earlier pour to survive a failed pour.\n    let _ = fs::remove_file(dest);\n\n    let width = match tally::width() {\n        Some(width) => width,\n        None => return 1,\n    };\n    let _coverage = tally::lines();\n    let buf = match fs::read(\"/app/quaybag/night.bin\") {\n        Ok(buf) => buf,\n        Err(_) => return 1,\n    };\n    if (buf.len() as u64) * 8 < u64::from(width) {\n        return 1;\n    }\n\n    let (a, b, c, d, e, f) = pull::dump(&buf);\n    let body = format!(\n        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\n        a, b, c, d, e, f\n    );\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() {\n            return 1;\n        }\n    }\n    match fs::write(dest, body) {\n        Ok(()) => 0,\n        Err(_) => 1,\n    }\n}\nEOF\n/app/wick.sh\n"]
[52.320055, "o", "cat > /app/octetkiln/take.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.320318, "o", "    if n == 0 || n > 32 || pos.checked_add(n).map_or(true, |end| end as u64 > (buf.len() as u64) * 8) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.320338, "o", "        return 0;\r\n\u001b[?2004l\r"]
