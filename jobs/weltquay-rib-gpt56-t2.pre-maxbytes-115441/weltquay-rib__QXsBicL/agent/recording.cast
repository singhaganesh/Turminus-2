[52.320785, "o", "    for offset in 0..n {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.320963, "o", "        let at = pos + offset;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.321161, "o", "        let octet = buf[(at / 8) as usize];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.321404, "o", "        let bit = (octet >> (7 - (at % 8))) & 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.323458, "o", "        value = (value << 1) | u32::from(bit);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     value\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
