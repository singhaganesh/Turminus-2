[52.351621, "o", "\u001b[?2004h"]
[52.352153, "o", ">     for line in text.lines() {\r\n\u001b[?2004l\r\u001b[?2004h>         let line = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h>         if line.is_empty() || line.starts_with('#') {\r\n\u001b[?2004l\r\u001b[?2004h>             continue;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
