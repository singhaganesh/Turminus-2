### /app/weltcli/boot.rs
#[path = "../octetkiln/take.rs"]
mod take;
#[path = "../vaultbin/pull.rs"]
mod pull;
#[path = "../peekurn/ink.rs"]
mod vat;
#[path = "../nudgepit/tally.rs"]
mod tally;

fn main() {
    let mut args = std::env::args().skip(1);
    let cmd = args.next().unwrap_or_default();
    let code = match cmd.as_str() {
        "pour" => vat::rib_c(),
        _ => {
            eprintln!("usage: weltquay pour");
            2
        }
    };
    std::process::exit(code);
}
### /app/octetkiln/take.rs
pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {
    if n == 0 {
        return 0;
    }
    let i = (pos / 8) as usize;
    if i >= buf.len() {
        return 0;
    }
    let bit = pos % 8;
    let room = 8 - bit;
    let w = if n > room { room } else { n };
    let shift = 8 - bit - w;
    ((buf[i] as u32) >> shift) & ((1u32 << w) - 1)
}
### /app/octetkiln/emit.rs
use std::fs;

#[path = "../stitchbay/card.rs"]
mod card;

fn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {
    for row in rows {
        if row.tag == tag {
            return (row.pos, row.n);
        }
    }
    (0, 0)
}

fn main() {
    let rows = card::rib_b();
    let (k0, k1) = pick(&rows, "kind");
    let (l0, l1) = pick(&rows, "lane");
    let (m0, m1) = pick(&rows, "mode");
    let (w0, w1) = pick(&rows, "welt");
    let (t0, t1) = pick(&rows, "tail");
    let (x0, x1) = pick(&rows, "mark");
    let body = format!(
        r#"use crate::take;

pub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{
    (
        take::rib_a(buf, {k0}, {k1}),
        take::rib_a(buf, {l0}, {l1}),
        take::rib_a(buf, {m0}, {m1}),
        take::rib_a(buf, {w0}, {w1}),
        take::rib_a(buf, {t0}, {t1}),
        take::rib_a(buf, {x0}, {x1}),
    )
}}
"#
    );
    let _ = fs::create_dir_all("/app/vaultbin");
    fs::write("/app/vaultbin/pull.rs", body).expect("emit");
}
### /app/stitchbay/card.rs
pub struct Row {
    pub tag: String,
    pub pos: u32,
    pub n: u32,
}

fn tok(line: &str) -> Vec<String> {
    line.split_whitespace().map(|s| s.to_string()).collect()
}

pub fn rib_b() -> Vec<Row> {
    let text = std::fs::read_to_string("/app/ribcards/LAYOUT.txt").unwrap_or_default();
    let mut out = Vec::new();
    for line in text.lines() {
        let raw = line.trim();
        if raw.is_empty() || raw.starts_with('#') {
            continue;
        }
        let parts = tok(raw);
        if parts.len() < 3 {
            continue;
        }
        let tag = parts[0].clone();
        let mut pos: u32 = match parts[1].parse() {
            Ok(v) => v,
            Err(_) => continue,
        };
        let n: u32 = match parts[2].parse() {
            Ok(v) => v,
            Err(_) => continue,
        };
        if n > 8 {
            pos = pos.saturating_add(8 - (pos % 8));
        }
        out.push(Row { tag, pos, n });
    }
    out
}
### /app/peekurn/ink.rs
use crate::pull;
use crate::tally;
use std::fs;
use std::path::Path;

pub fn rib_c() -> i32 {
    let _ = tally::lines();
    let buf = fs::read("/app/quaybag/night.bin").unwrap_or_default();
    let dest = Path::new("/app/blotbay/rows.json");
    if let Some(parent) = dest.parent() {
        let _ = fs::create_dir_all(parent);
    }
    let (a, b, c, d, e, f) = pull::dump(&buf);
    let body = format!(
        "{{\"kind\":{},\"lane\":{},\"mode\":{},\"welt\":{},\"tail\":{},\"mark\":{}}}\n",
        a, b, c, d, e, f
    );
    let _ = fs::write(dest, body);
    0
}
### /app/vaultbin/pull.rs
use crate::take;

pub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {
    (
        take::rib_a(buf, 0, 3),
        take::rib_a(buf, 3, 5),
        take::rib_a(buf, 8, 4),
        take::rib_a(buf, 16, 9),
        take::rib_a(buf, 21, 3),
        take::rib_a(buf, 24, 8),
    )
}
### /app/nudgepit/tally.rs
pub fn lines() -> usize {
    std::fs::read_to_string("/app/ribcards/LAYOUT.txt")
        .unwrap_or_default()
        .lines()
        .filter(|line| !line.trim().is_empty())
        .count()
}
