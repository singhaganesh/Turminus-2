ine()) != null) {\n                line = line.trim();\n                if (!line.isEmpty() && !actual.add(line)) duplicate = true;\n            }\n        }\n        int status = p.waitFor();\n        return status == 0 && !duplicate && actual.equals(expected) ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(\n            Paths.get("/app/blastcp"),\n            Paths.get("/app/desknote/NAMES.txt"),\n            Paths.get("/app/jarwell/husk.jar")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar)) return 1;\n        long cap;\n        try {\n            cap = Long.parseLong(new String(Files.readAllBytes(capFile), "UTF-8").trim());\n        } catch (RuntimeException e) {\n            return 1;\n        }\n        return cap >= 0 && Files.size(jar) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(\n            Paths.get("/app/jarwell/husk.jar"),\n            Paths.get("/app/desknote/CAP.txt")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo "knit_status=$?"; stat -c \'jar_size=%s\' /app/jarwell/husk.jar; /app/bin/dregwick booth\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
