     6	import java.util.jar.JarEntry;
     7	import java.util.jar.JarOutputStream;
     8	
     9	public class KnitMain {
    10	    public static void main(String[] args) throws Exception {
    11	        Path exploded = Paths.get("/app/blastcp");
    12	        Path jar = Paths.get("/app/jarwell/husk.jar");
    13	        Files.createDirectories(jar.getParent());
    14	        Set<String> live = ReachWalk.weld_set(exploded);
    15	        if (args.length > 0 && "--all".equals(args[0])) {
    16	            live.clear();
    17	            try (DirectoryStream<Path> ds = Files.newDirectoryStream(exploded, "*.class")) {
    18	                for (Path p : ds) {
    19	                    String n = p.getFileName().toString();
    20	                    live.add(n.substring(0, n.length() - 6));
    21	                }
    22	            }
    23	        }
    24	        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar))) {
    25	            for (String n : live) {
    26	                Path src = exploded.resolve(n + ".class");
    27	                if (!Files.isRegularFile(src)) {
    28	                    continue;
    29	                }
    30	                jos.putNextEntry(new JarEntry(n + ".class"));
    31	                jos.write(Files.readAllBytes(src));
    32	                jos.closeEntry();
    33	            }
    34	        }
    35	    }
    36	}
