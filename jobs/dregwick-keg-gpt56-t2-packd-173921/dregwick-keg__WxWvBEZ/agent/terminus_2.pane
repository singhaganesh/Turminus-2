     1	import java.io.ByteArrayOutputStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.util.zip.ZipEntry;
     6	import java.util.zip.ZipOutputStream;
     7	
     8	public class CapGate {
     9	    public static int rib_n(Path a, Path b) throws Exception {
    10	        Path exploded = Paths.get("/app/blastcp");
    11	        String[] keep = new String[] {
    12	            "Main",
    13	            "TasteRun",
    14	            "BoothRun",
    15	            "Rib",
    16	            "JsonBooth",
    17	            "SysBooth",
    18	            "FallBooth",
    19	            "HexDump"
    20	        };
    21	        ByteArrayOutputStream bos = new ByteArrayOutputStream();
    22	        try (ZipOutputStream zos = new ZipOutputStream(bos)) {
    23	            for (String n : keep) {
    24	                Path src = exploded.resolve(n + ".class");
    25	                if (!Files.isRegularFile(src)) {
    26	                    continue;
    27	                }
    28	                zos.putNextEntry(new ZipEntry(n + ".class"));
    29	                zos.write(Files.readAllBytes(src));
    30	                zos.closeEntry();
    31	            }
    32	        }
    33	        Files.write(a, bos.toByteArray());
    34	        return 0;
    35	    }
    36	
    37	    public static void main(String[] args) throws Exception {
    38	        int rc = rib_n(Paths.get("/app/jarwell/husk.jar"), Paths.get("/app/desknote/CAP.txt"));
    39	        System.exit(rc);
    40	    }
    41	}
