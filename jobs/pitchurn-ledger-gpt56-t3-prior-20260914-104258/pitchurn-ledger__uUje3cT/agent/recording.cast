[82.341596, "i", "python3 - <<'PY'\np='/app/hitchcli/Idx.java'\ns=open(p).read()\ns=s.replace('    add(m, \"/app/urnbay/hot/idx.tsv\");\\n    return m;', '    add(m, \"/app/urnbay/hot/idx.tsv\");\\n    add(m, \"/app/urnbay/cold/idx.tsv\");\\n    return m;')\nopen(p,'w').write(s)\nPY\ncat > /app/hitchcli/StowRun.java <<'EOF'\nimport java.io.*;\nimport java.nio.file.*;\nimport java.util.*;\n\npublic class StowRun {\n  static class Plan {\n    List<byte[]> parts = new ArrayList<>();\n    List<String> keys = new ArrayList<>();\n    long reused;\n  }\n\n  static Plan manifestPlan(byte[] src, String name, Map<String,String> idx) throws Exception {\n    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\n    if (!Files.exists(mk)) return null;\n    Plan p = new Plan();\n    ByteArrayOutputStream all = new ByteArrayOutputStream();\n    for (String line : Files.readAllLines(mk)) {\n      String key = line.trim();\n      if (key.isEmpty()) continue;\n      String rel = idx.get(key);\n      if (rel == null) return null;\n      byte[] piece = Idx.blob(rel);\n      p.keys.add(key);\n      p.parts.add(piece);\n      all.write(piece);\n    }\n    if (!Arrays.equals(src, all.toByteArray())) return null;\n    p.reused = src.length;\n    return p;\n  }\n\n  static Plan completeStoredPlan(byte[] src, Gear g, Map<String,String> idx) throws Exception {\n    Plan p = new Plan();\n    p.parts = Slice.cut(src, g.mask, g.min, g.max);\n    for (byte[] piece : p.parts) {\n      String key = Seal.pay(piece);\n      if (!idx.containsKey(key)) return null;\n      p.keys.add(key);\n      p.reused += piece.length;\n    }\n    return p;\n  }\n\n  static Plan livePlan(byte[] src, Gear g, Map<String,String> idx) throws Exception {\n    Plan p = new Plan();\n    p.parts = Slice.cut(src, g.mask, g.min, g.max);\n    for (byte[] piece : p.parts) {\n      String key = Seal.pay(piece);\n      p.keys.add(key);\n      if (idx.containsKey(key)) p.reused += piece.length;\n    }\n    return p;\n  }\n\n  public static int run(String reel) throws Exception {\n    byte[] src = Files.readAllBytes(Paths.get(reel));\n    String name = Paths.get(reel).getFileName().toString();\n    Map<String,String> idx = Idx.load();\n    Gear live = Gear.load(\"/app/gearpit/live.gear\");\n\n    Plan plan = manifestPlan(src, name, idx);\n    if (plan == null) {\n      Path legacyPath = Paths.get(\"/app/gearpit/legacy.gear\");\n      if (Files.exists(legacyPath))\n        plan = completeStoredPlan(src, Gear.load(legacyPath.toString()), idx);\n    }\n    if (plan == null) plan = livePlan(src, live, idx);\n\n    long stored = 0;\n    Path hot = Paths.get(\"/app/urnbay/hot\");\n    Files.createDirectories(hot);\n    for (int i = 0; i < plan.parts.size(); i++) {\n      byte[] piece = plan.parts.get(i);\n      String key = plan.keys.get(i);\n      if (!idx.containsKey(key)) {\n        String rel = \"hot/\" + key + \".blob\";\n        Files.write(hot.resolve(key + \".blob\"), piece);\n        Idx.put(key, rel);\n        idx.put(key, rel);\n        stored += piece.length;\n      }\n    }\n\n    Path flag = Paths.get(\"/app/urnbay/marks/\" + name + \".flag\");\n    boolean prior = Files.exists(flag);\n    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\n    Files.createDirectories(mk.getParent());\n    Files.writeString(mk, String.join(\"\\n\", plan.keys) + (plan.keys.isEmpty() ? \"\" : \"\\n\"));\n\n    double reuse = src.length == 0 ? 1.0 : plan.reused / (double)src.length;\n    double mean = plan.parts.isEmpty() ? 0.0 : src.length / (double)plan.parts.size();\n    String json = \"{\\n\"\n      + \"  \\\"reel\\\": \\\"\" + name + \"\\\",\\n\"\n      + \"  \\\"bytes_in\\\": \\\"\" + src.length + \"\\\",\\n\"\n      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\n      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\n      + \"  \\\"mean_piece\\\": \\\"\" + String.format(Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\n      + \"  \\\"piece_count\\\": \\\"\" + plan.parts.size() + \"\\\"\\n\"\n      + \"}\\n\";\n    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\n    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\n    Floor.ok(reuse);\n    if (prior && stored == src.length && src.length > 0) return 1;\n    Files.writeString(flag, \"1\\n\");\n    return "]
[82.342251, "i", "0;\n  }\n}\nEOF\n/app/kiln.sh\n"]
