[106.39084, "i", "set +e\necho '=== PROBE FIRST ==='; /app/bin/pitchurn stow /app/filmwelle/probe.bin; echo \"rc=$?\"; cp /app/urnbay/tally.json /tmp/probe-first.json; cat /tmp/probe-first.json\necho '=== PROBE SECOND ==='; /app/bin/pitchurn stow /app/filmwelle/probe.bin; echo \"rc=$?\"; cp /app/urnbay/tally.json /tmp/probe-second.json; cat /tmp/probe-second.json\n/app/bin/pitchurn draw /app/urnbay/probe.out /app/filmwelle/probe.bin; echo \"draw_rc=$?\"; cmp -s /app/urnbay/probe.out /app/filmwelle/probe.bin; echo \"cmp_rc=$?\"\n/app/bin/pitchurn census; echo \"census_rc=$?\"\npython3 - <<'PY'\nimport json\nfor p in ('/tmp/probe-first.json','/tmp/probe-second.json','/app/urnbay/tally.json'):\n    d=json.load(open(p))\n    required=['reel','bytes_in','bytes_stored','reuse_frac','mean_piece','piece_count']\n    print(p, list(d)==required, all(isinstance(d[k],str) for k in required), d)\nf=json.load(open('/tmp/probe-first.json')); s=json.load(open('/tmp/probe-second.json'))\nassert float(f['mean_piece']) <= 2048\nassert float(s['reuse_frac']) >= .80\nassert int(s['bytes_stored']) < int(s['bytes_in'])\nPY\nvrc=$?; echo \"validation_rc=$vrc\"\nset -e\n"]
