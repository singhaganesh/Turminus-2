[31.348289, "o", "===== /app/oxemit/RibGen.java =====\r\n"]
[31.350561, "o", "     1\timport java.io.*;\r\n     2\tpublic class RibGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Seal.java\")));\r\n     7\t    weld(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void weld(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.security.MessageDigest;\");\r\n    12\t    a.println(\"public class Seal {\");\r\n    13\t    a.println(\"  public static String hex(byte[] p, int fp) throws Exception {\");\r\n"]
[31.350659, "o", "    14\t    a.println(\"    int tag = fp & 0xff;\");\r\n    15\t    a.println(\"    if (tag > 255) {\");\r\n    16\t    a.println(\"      throw new IllegalArgumentException(\\\"tag\\\");\");\r\n    17\t    a.println(\"    }\");\r\n    18\t    a.println(\"    MessageDigest md = MessageDigest.getInstance(\\\"SHA-256\\\");\");\r\n    19\t    a.println(\"    md.update(p);\");\r\n    20\t    a.println(\"    byte[] d = md.digest();\");\r\n    21\t    a.println(\"    return fmt(d);\");\r\n    22\t    a.println(\"  }\");\r\n    23\t    a.println(\"  public static String pay(byte[] p) throws Exception {\");\r\n    24\t    a.println(\"    MessageDigest md = MessageDigest.getInstance(\\\"SHA-256\\\");\");\r\n    25\t    a.println(\"    md.update(p);\");\r\n    26\t    a.println(\"    return fmt(md.digest());\");\r\n    27\t    a.println(\"  }\");\r\n    28\t    a.println(\"  static String fmt(byte[] d) {\");\r\n    29\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    30\t    a.println(\"    for (byte x : d) sb.append(String.format(\\\"%02x\\\", x));\");\r\n    31\t    a.println(\"    return sb.toString();\");\r\n    32\t    a.println(\"  }\");\r\n    33\t    a.println(\"}\");\r\n    34\t  }\r\n    35\t}\r\n"]
[31.35102, "o", "===== /app/nincut/VatGen.java =====\r\n"]
[31.351979, "o", "     1\timport java.io.*;\r\n     2\tpublic class VatGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Slice.java\")));\r\n     7\t    tint(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void tint(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.util.*;\");\r\n    12\t    a.println(\"public class Slice {\");\r\n    13\t    a.println(\"  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {\");\r\n    14\t    a.println(\"    int h = 0;\");\r\n    15\t    a.println(\"    int start = 0;\");\r\n    16\t    a.println(\"    java.util.List<byte[]> out = new java.util.ArrayList<>();\");\r\n    17\t    a.println(\"    for (int i = 0; i < src.length; i++) {\");\r\n    18\t      a.println(\"      int octet = src[i];\");\r\n    19\t      a.println(\"      h = (h << 1) + octet;\");\r\n    20\t    a.println(\"      int ln = i - start + 1;\");\r\n    21\t    a.println(\"      boolean hit = (ln >= min && (h & mask) == 0);\");\r\n    22\t    a.println(\"      boolean cap = ln >= max;\");\r\n    23\t    a.println(\"      boolean last = i == src.length - 1;\");\r\n    24\t    a.println(\"      if (hit || cap || last) {\");\r\n    25\t    a.println(\"        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));\");\r\n    26\t    a.println(\"        start = i + 1;\");\r\n    27\t    a.println(\"        h = 0;\");\r\n    28\t    a.println(\"      }\");\r\n    29\t    a.println(\"    }\");\r\n    30\t    a.println(\"    return out;\");\r\n    31\t    a.println(\"  }\");\r\n    32\t    a.println(\"}\");\r\n    33\t  }\r\n    34\t}\r\n"]
[31.352455, "o", "===== /app/coldrib/DuskGen.java =====\r\n"]
[31.353373, "o", "     1\timport java.io.*;\r\n     2\tpublic class DuskGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")));\r\n     7\t"]
[31.353483, "o", "    loom(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void loom(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.nio.file.*;\");\r\n    12\t    a.println(\"public class Span {\");\r\n    13\t    a.println(\"  public static void merge() throws Exception {\");\r\n    14\t    a.println(\"    Path live = Paths.get(\\\"/app/urnbay/idx.tsv\\\");\");\r\n    15\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    16\t    a.println(\"    Path[] bags = new Path[] {\");\r\n    17\t    a.println(\"      live,\");\r\n    18\t    a.println(\"      Paths.get(\\\"/app/urnbay/hot/idx.tsv\\\"),\");\r\n    19\t    a.println(\"      Paths.get(\\\"/app/urnbay/cold/idx.tsv\\\"),\");\r\n    20\t    a.println(\"      Paths.get(\\\"/app/urnbay/keep/idx.tsv\\\")\");\r\n    21\t    a.println(\"    };\");\r\n    22\t    a.println(\"    for (Path p : bags) {\");\r\n    23\t    a.println(\"      if (java.nio.file.Files.exists(p)) sb.append(java.nio.file.Files.readString(p));\");\r\n    24\t    a.println(\"    }\");\r\n    25\t    a.println(\"    java.nio.file.Files.writeString(live, sb.toString());\");\r\n    26\t    a.println(\"    System.out.println(\\\"walked\\\");\");\r\n    27\t    a.println(\"  }\");\r\n    28\t    a.println(\"}\");\r\n    29\t  }\r\n    30\t}\r\n"]
[31.353639, "o", "===== /app/hitchcli/DrawRun.java =====\r\n"]
[31.354508, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class DrawRun {\r\n     4\t  public static int run(String dest, String reel) throws Exception {\r\n     5\t    String name = Paths.get(reel).getFileName().toString();\r\n     6\t    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n     7\t    Map<String,String> idx = Idx.load();\r\n     8\t    add(idx, \"/app/urnbay/cold/idx.tsv\");\r\n     9\t    StringBuilder skip = new StringBuilder();\r\n    10\t    List<byte[]> acc = new ArrayList<>();\r\n"]
[31.354598, "o", "    11\t    for (String ln : Files.readAllLines(mk)) {\r\n    12\t      String k = ln.trim();\r\n    13\t      if (k.isEmpty()) continue;\r\n    14\t      String rel = idx.get(k);\r\n    15\t      if (rel == null) continue;\r\n    16\t      acc.add(Idx.blob(rel));\r\n    17\t    }\r\n    18\t    int n = 0;\r\n    19\t    for (byte[] b : acc) n += b.length;\r\n    20\t    byte[] out = new byte[n];\r\n    21\t    int o = 0;\r\n    22\t    for (byte[] b : acc) {\r\n    23\t      System.arraycopy(b, 0, out, o, b.length);\r\n    24\t      o += b.length;\r\n    25\t    }\r\n    26\t    Path d = Paths.get(dest);\r\n    27\t    Files.createDirectories(d.getParent() == null ? Paths.get(\".\") : d.getParent());\r\n    28\t    Files.write(d, out);\r\n    29\t    return 0;\r\n    30\t  }\r\n    31\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    32\t    Idx.add(m, p);\r\n    33\t  }\r\n    34\t}\r\n"]
