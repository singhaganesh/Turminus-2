[139.336168, "o", "\u001b[?2004hroot@b22888d0c9d4:/app# "]
[139.618377, "i", "set +e\nok=1\nfor r in stable plain brine; do\n  /app/bin/pitchurn stow \"/app/filmwelle/$r.bin\"; rc=$?\n  /app/bin/pitchurn draw \"/tmp/$r.out\" \"/app/filmwelle/$r.bin\"; dr=$?\n  cmp -s \"/tmp/$r.out\" \"/app/filmwelle/$r.bin\"; cm=$?\n  python3 - \"$r\" <<'PY'\nimport json,sys\nd=json.load(open('/app/urnbay/tally.json'))\nprint(sys.argv[1], d)\nassert d['reel']==sys.argv[1]+'.bin'\nassert int(d['bytes_stored']) < int(d['bytes_in'])\nassert float(d['reuse_frac']) >= .8\nassert all(isinstance(v,str) for v in d.values())\nPY\n  py=$?\n  echo \"rc=$rc draw=$dr cmp=$cm card=$py\"\n  test $rc -eq 0 -a $dr -eq 0 -a $cm -eq 0 -a $py -eq 0 || ok=0\ndone\n/app/bin/pitchurn stow /app/filmwelle/probe.bin; p1rc=$?; cp /app/urnbay/tally.json /tmp/p1.json\n/app/bin/pitchurn stow /app/filmwelle/probe.bin; p2rc=$?; cp /app/urnbay/tally.json /tmp/p2.json\n/app/bin/pitchurn draw /tmp/probe.out /app/filmwelle/probe.bin; pd=$?; cmp -s /tmp/probe.out /app/filmwelle/probe.bin; pc=$?\n/app/bin/pitchurn census; cc=$?\npython3 - <<'PY'\nimport json\nf=json.load(open('/tmp/p1.json')); s=json.load(open('/tmp/p2.json'))\nprint('probe first',f); print('probe second',s)\nkeys=['reel','bytes_in','bytes_stored','reuse_frac','mean_piece','piece_count']\nassert list(f)==keys and all(isinstance(f[k],str) for k in keys)\nassert float(f['mean_piece']) <= 2048\nassert float(s['reuse_frac']) >= .8\nassert int(s['bytes_stored']) < int(s['bytes_in'])\nassert json.load(open('/app/urnbay/tally.json')) == s\nPY\npv=$?\necho \"overall_named=$ok probe_rcs=$p1rc,$p2rc draw=$pd cmp=$pc census=$cc validation=$pv\"\ntest $ok -eq 1 -a $p1rc -eq 0 -a $p2rc -eq 0 -a $pd -eq 0 -a $pc -eq 0 -a $cc -eq 0 -a $pv -eq 0\nresult=$?\nset -e\nexit $result\n"]
[139.61877, "o", "set +e\r\n\u001b[?2004l\r"]
