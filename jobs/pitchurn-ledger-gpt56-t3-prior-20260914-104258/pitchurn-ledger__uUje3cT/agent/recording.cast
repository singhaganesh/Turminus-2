[31.870903, "i", "echo '--- gears ---'; ls -l /app/gearpit; for f in /app/gearpit/*; do echo \"===== $f =====\"; cat \"$f\"; done; echo '--- reel sizes/hashes ---'; sha256sum /app/filmwelle/*.bin; stat -c '%n %s' /app/filmwelle/*.bin; echo '--- index counts ---'; for f in /app/urnbay/idx.tsv /app/urnbay/hot/idx.tsv /app/urnbay/cold/idx.tsv /app/urnbay/keep/idx.tsv; do printf '%s ' \"$f\"; test -f \"$f\" && wc -l < \"$f\" || echo missing; done; echo '--- mark counts ---'; for f in /app/urnbay/marks/*; do printf '%s ' \"$f\"; wc -l < \"$f\"; done\n"]
