[30.928482, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Gear {\r\n     4\t  public int mask, min, max, fp;\r\n     5\t  public static Gear load(String p) throws Exception {\r\n     6\t    Gear g = new Gear();\r\n     7\t    for (String ln : Files.readAllLines(Paths.get(p))) {\r\n     8\t      String t = ln.trim();\r\n     9\t      if (t.startsWith(\"mask=\")) g.mask = Integer.parseInt(t.substring(5));\r\n    10\t      if (t.startsWith(\"min=\")) g.min = Integer.parseInt(t.substring(4));\r\n    11\t      if (t.startsWith(\"max=\")) g.max = Integer.parseInt(t.substring(4));\r\n    12\t      if (t.startsWith(\"fp=\")) g.fp = Integer.parseInt(t.substring(3));\r\n    13\t    }\r\n    14\t    return g;\r\n    15\t  }\r\n    16\t}\r\n"]
[30.929303, "o", "===== /app/hitchcli/Idx.java =====\r\n"]
[30.931376, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Idx {\r\n     4\t  public static Map<String,String> load() throws Exception {\r\n     5\t    Map<String,String> m = new LinkedHashMap<>();\r\n     6\t    add(m, \"/app/urnbay/idx.tsv\");\r\n     7\t    add(m, \"/app/urnbay/keep/idx.tsv\");\r\n     8\t    add(m, \"/app/urnbay/hot/idx.tsv\");\r\n     9\t    return m;\r\n    10\t  }\r\n    11\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    12\t    Path f = Paths.get(p);\r\n    13\t    if (!Files.exists(f)) return;\r\n    14\t    for (String ln : Files.readAllLines(f)) {\r\n    15\t      String t = ln.trim();\r\n    16\t      if (t.isEmpty()) continue;\r\n    17\t      String[] sp = t.split(\"\\t\");\r\n    18\t      if (sp.length >= 2) m.put(sp[0], sp[1]);\r\n    19\t    }\r\n    20\t  }\r\n    21\t  public static void put(String k, String rel) throws Exception {\r\n    22\t    Path f = Paths.get(\"/app/urnbay/idx.tsv\");\r\n    23\t    Files.writeString(f, k + \"\\t\" + rel + \"\\n\", java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);\r\n    24\t  }\r\n    25\t  public static byte[] blob(String rel) throws Exception {\r\n    26\t    return Files.readAllBytes(Paths.get(\"/app/urnbay/\" + rel));\r\n    27\t  }\r\n    28\t}\r\n===== /app/hitchcli/StowRun.java =====\r\n"]
[30.933689, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class StowRun {\r\n     4\t  public static int run(String reel) throws Exception {\r\n     5\t    Gear g = Gear.load(\"/app/gearpit/live.gear\");\r\n     6\t    byte[] src = Files.readAllBytes(Paths.get(reel));\r\n     7\t    List<byte[]> parts = Slice.cut(src, g.mask, g.min, g.max);\r\n     8\t    Map<String,String> idx = Idx.load();\r\n     9\t    long stored = 0;\r\n    10\t    long reused = 0;\r\n    11\t    List<String> keys = new ArrayList<>();\r\n"]
[30.933755, "o", "    12\t    Path hot = Paths.get(\"/app/urnbay/hot\");\r\n    13\t    Files.createDirectories(hot);\r\n    14\t    for (byte[] p : parts) {\r\n    15\t      String kb = Seal.hex(p, g.fp);\r\n    16\t      String kp = Seal.pay(p);\r\n    17\t      String hit = null;\r\n    18\t      if (idx.containsKey(kb)) hit = kb;\r\n    19\t      else if (idx.containsKey(kp)) hit = kp;\r\n    20\t      if (hit != null) {\r\n    21\t        reused += p.length;\r\n    22\t        keys.add(hit);\r\n    23\t      } else {\r\n    24\t        stored += p.length;\r\n    25\t        String rel = \"hot/\" + kb + \".blob\";\r\n    26\t        Files.write(hot.resolve(kb + \".blob\"), p);\r\n    27\t        Idx.put(kb, rel);\r\n    28\t        idx.put(kb, rel);\r\n    29\t        keys.add(kb);\r\n    30\t      }\r\n    31\t    }\r\n    32\t    String name = Paths.get(reel).getFileName().toString();\r\n"]
[30.933784, "o", "    33\t    Path flag = Paths.get(\"/app/urnbay/marks/\" + name + \".flag\");\r\n    34\t    boolean prior = Files.exists(flag);\r\n    35\t    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n    36\t    StringBuilder mb = new StringBuilder();\r\n    37\t    for (String k : keys) mb.append(k).append(\"\\n\");\r\n    38\t    Files.createDirectories(mk.getParent());\r\n    39\t    Files.writeString(mk, mb.toString());\r\n"]
[30.933806, "o", "    40\t    double reuse = src.length == 0 ? 1.0 : (reused / (double) src.length);\r\n    41\t    double mean = parts.isEmpty() ? 0 : (src.length / (double) parts.size());\r\n    42\t    String json = \"{\\n\"\r\n    43\t      + \"  \\\"reel\\\": \\\"\" + name + \"\\\",\\n\"\r\n    44\t      + \"  \\\"bytes_in\\\": \\\"\" + src.length + \"\\\",\\n\"\r\n"]
[30.933829, "o", "    45\t      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\r\n    46\t      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\r\n    47\t      + \"  \\\"mean_piece\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\r\n    48\t      + \"  \\\"piece_count\\\": \\\"\" + parts.size() + \"\\\"\\n\"\r\n    49\t      + \"}\\n\";\r\n    50\t"]
[30.933853, "o", "    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\r\n    51\t    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\r\n    52\t    Floor.ok(reuse);\r\n    53\t    if (prior && stored == src.length && src.length > 0) {\r\n    54\t      return 1;\r\n"]
[30.933878, "o", "    55\t    }\r\n    56\t    Files.writeString(flag, \"1\\n\");\r\n    57\t    return 0;\r\n    58\t  }\r\n    59\t}\r\n"]
