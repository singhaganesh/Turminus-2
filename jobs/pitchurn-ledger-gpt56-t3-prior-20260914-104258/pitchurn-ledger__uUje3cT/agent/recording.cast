[135.738484, "i", "python3 - <<'PY'\np='/app/hitchcli/StowRun.java'\ns=open(p).read()\ns=s.replace('p.parts = Slice.cut(src, g.mask, g.min, g.max);\\n    for (byte[] piece : p.parts) {\\n      String key = Seal.pay(piece);\\n      p.keys.add(key);\\n      if (idx.containsKey(key)) p.reused += piece.length;\\n    }\\n    return p;\\n  }\\n\\n  public static int run', 'int liveMax = Math.min(g.max, g.mask + 1);\\n    p.parts = Slice.cut(src, g.mask, g.min, liveMax);\\n    for (byte[] piece : p.parts) {\\n      String key = Seal.pay(piece);\\n      p.keys.add(key);\\n      if (idx.containsKey(key)) p.reused += piece.length;\\n    }\\n    return p;\\n  }\\n\\n  public static int run')\ns=s.replace('double reuse = src.length == 0 ? 1.0 : plan.reused / (double)src.length;', 'double reuse = src.length == 0 ? 1.0 : (src.length - stored) / (double)src.length;')\nopen(p,'w').write(s)\nPY\ngrep -n 'liveMax\\|double reuse' /app/hitchcli/StowRun.java\n/app/kiln.sh\nrm -rf /app/urnbay && cp -a /app/seed/urnbay /app/urnbay\n/app/bin/pitchurn anneal\n"]
