[30.936414, "o", "     1\tpublic class Main {\r\n     2\t  public static void main(String[] a) throws Exception {\r\n     3\t    if (a.length == 0) {\r\n     4\t      System.err.println(\"usage\");\r\n     5\t      System.exit(2);\r\n     6\t    }\r\n     7\t    String cmd = a[0];\r\n     8\t    int rc = 0;\r\n     9\t    if (cmd.equals(\"anneal\")) {\r\n"]
[30.93656, "o", "    10\t      rc = WalkRun.run();\r\n    11\t    } else if (cmd.equals(\"stow\")) {\r\n    12\t      rc = StowRun.run(a[1]);\r\n    13\t    } else if (cmd.equals(\"draw\")) {\r\n    14\t      rc = DrawRun.run(a[1], a[2]);\r\n    15\t    } else if (cmd.equals(\"census\")) {\r\n    16\t      rc = CardRun.run();\r\n    17\t    } else {\r\n    18\t      rc = 2;\r\n    19\t    }\r\n    20\t    System.exit(rc);\r\n    21\t  }\r\n    22\t}\r\n"]
