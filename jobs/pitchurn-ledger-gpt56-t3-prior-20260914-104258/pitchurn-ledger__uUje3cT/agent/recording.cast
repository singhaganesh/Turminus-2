[31.35649, "o", "     1\timport java.nio.file.*;\r\n     2\tpublic class CardRun {\r\n     3\t  public static int run() throws Exception {\r\n     4\t    Path last = Paths.get(\"/app/urnbay/last.json\");\r\n     5\t    if (!Files.exists(last)) return 1;\r\n     6\t    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), Files.readString(last));\r\n     7\t    return 0;\r\n     8\t  }\r\n     9\t}\r\n"]
