[49.998861, "o", "echo '===== generated Seal ====='; cat /app/deskbin/gen/Seal.java; echo '===== generated Slice ====='; cat /app/deskbin/gen/Slice.java; echo '===== seed tree summary ====='; find /app/seed/urnbay -maxdepth 2 -type f -printf '%P %s\\n' | sort | head -80\r\n\u001b[?2004l\r"]
[49.999068, "o", "===== generated Seal =====\r\n"]
[50.000721, "o", "import java.security.MessageDigest;\r\npublic class Seal {\r\n  public static String hex(byte[] p, int fp) throws Exception {\r\n    int tag = fp & 0xff;\r\n    if (tag > 255) {\r\n      throw new IllegalArgumentException(\"tag\");\r\n    }\r\n    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n    md.update(p);\r\n    byte[] d = md.digest();\r\n    return fmt(d);\r\n  }\r\n  public static String pay(byte[] p) throws Exception {\r\n    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n    md.update(p);\r\n    return fmt(md.digest());\r\n  }\r\n  static String fmt(byte[] d) {\r\n    StringBuilder sb = new StringBuilder();\r\n    for (byte x : d) sb.append(String.format(\"%02x\", x));\r\n    return sb.toString();\r\n  }\r\n}\r\n"]
[50.001053, "o", "===== generated Slice =====\r\n"]
[50.002144, "o", "import java.util.*;\r\npublic class Slice {\r\n  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {\r\n    int h = 0;\r\n    int start = 0;\r\n    java.util.List<byte[]> out = new java.util.ArrayList<>();\r\n    for (int i = 0; i < src.length; i++) {\r\n      int octet = src[i];\r\n      h = (h << 1) + octet;\r\n      int ln = i - start + 1;\r\n      boolean hit = (ln >= min && (h & mask) == 0);\r\n      boolean cap = ln >= max;\r\n      boolean last = i == src.length - 1;\r\n      if (hit || cap || last) {\r\n        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));\r\n        start = i + 1;\r\n        h = 0;\r\n      }\r\n    }\r\n    return out;\r\n  }\r\n}\r\n"]
[50.002318, "o", "===== seed tree summary =====\r\n"]
[50.004436, "o", "cold/38c3d7c85fef5d2976b54e22ba0dceeff2a45ecf5f7e2ebb3ae57b000f8d346c.blob 10077\r\ncold/89aff461b25265cac3ecb1a30cfe94b7b44dbb6e3d20873f72889272bcb9ad35.blob 9737\r\ncold/e191a4f16d8a1a4e5f62d4899edafa980b4676c60ec03437a5b823eefd30400b.blob 4186\r\ncold/idx.tsv 420\r\nhot/183075fdc30318d5d844413373272a62a1aed5c36ac46f7d91b689c62ef333d5.blob 2145\r\nhot/3ff6001c49f292e946040c52c7b1203b7fbbaa0cd5d071896181bf8c265fb5c6.blob 1773\r\nhot/425ffe0ad2238b9070f5fbf6acebdbb44167b964cb9346f2e0aac492d5e338fd.blob 1188\r\nhot/576a14c04661749a8d74f113f19e7840997f5dac4c233571c04d5f72585d3f09.blob 111\r\nhot/59def616323013a9f1753fafc92b0a6112ed99fa6dd453e7896d42a2ab50cbed.blob 74\r\nhot/5ef85401ea9cb3e35b95eb54fc6d70a95af5b15cf96d8a7d341ad1447801b6eb.blob 1748\r\nhot/71ce21904246e19ae973e762de97428b8504f58e54c53b8889c60493e729358d.blob 1050\r\nhot/7ba53b9e257bd01c70c6173ebe490b6e5734b32ebb0765180cf0c636c91ce072.blob 398\r\nhot/981af8fcae95fbdc97523b3ef47b12bdb5e0f33e59d3e8c852c575e00452c71a.blob 325\r\nhot/ab30f85038c853200c044beed5232e4a7d724987b63fa7369ccec2ffe8996932.blob 1592\r\nhot/ad5cc98103f2652e96dd4ef463f7a18db13bc51d12ddbdb99512e23f4525388a.blob 219\r\nhot/d4bf3c2960719587cd48ebec0aad1788f4d7fea602b67b2667f498f91ba1d09f.blob 373\r\nhot/e1d67c79b95bf6aa05351d5918ea672dd486ddd34e983ab8c7dfa98e3e5856cf.blob 1004\r\nhot/idx.tsv 1807\r\nidx.tsv 1807\r\nkeep/1dca66d597836cdf413ef059e95f9b62d28d48203c4ec5f5ce4e7a73a502b469.blob 4096\r\nkeep/3a424fbc5fce76160a5b967f5b1157dc50f3f80198699f69ab88287220b2a5bb.blob 4096\r\nkeep/6ddee45dcf532fbba852c1e9fceb9fddd7c39aaef5609957b5808df6b78dea5c.blob 1747\r\nkeep/7441bf21c5921f1ed99b630c1024e4f2f3cc7ca5e3bc8a1d7a191c8c76e9619e.blob 4096\r\nkeep/a1be6e7094cbc2d6e2a94cb73053aa118fd3adcf7e3879d564bff3df6792d0b1.blob 50\r\nkeep/bcbb21c82f855e23c15812553f9f41f92a688070b462f884736263f1f2174996.blob 155\r\nkeep/c7e107ef02a8e72ce55e2e19fab6683f023f86e0969236288cca22f82926b5de.blob 3760\r\nkeep/idx.tsv 980\r\n"]
