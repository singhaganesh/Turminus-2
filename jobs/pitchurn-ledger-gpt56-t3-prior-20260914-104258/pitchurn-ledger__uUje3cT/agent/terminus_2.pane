import java.security.MessageDigest;
public class Seal {
  public static String hex(byte[] p, int fp) throws Exception {
    int tag = fp & 0xff;
    if (tag > 255) {
      throw new IllegalArgumentException("tag");
    }
    MessageDigest md = MessageDigest.getInstance("SHA-256");
    md.update(p);
    byte[] d = md.digest();
    return fmt(d);
  }
  public static String pay(byte[] p) throws Exception {
    MessageDigest md = MessageDigest.getInstance("SHA-256");
    md.update(p);
    return fmt(md.digest());
  }
  static String fmt(byte[] d) {
    StringBuilder sb = new StringBuilder();
    for (byte x : d) sb.append(String.format("%02x", x));
    return sb.toString();
  }
}
===== generated Slice =====
import java.util.*;
public class Slice {
  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {
    int h = 0;
    int start = 0;
    java.util.List<byte[]> out = new java.util.ArrayList<>();
    for (int i = 0; i < src.length; i++) {
      int octet = src[i];
      h = (h << 1) + octet;
      int ln = i - start + 1;
      boolean hit = (ln >= min && (h & mask) == 0);
      boolean cap = ln >= max;
      boolean last = i == src.length - 1;
      if (hit || cap || last) {
        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));
        start = i + 1;
        h = 0;
      }
    }
    return out;
  }
}
