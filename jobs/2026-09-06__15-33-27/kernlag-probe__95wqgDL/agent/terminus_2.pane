    18	    fprintf(out, "STRUCT %s\n", layout.struct_name);
    19	    for (int i = 0; i < layout.nfields; i++) {
    20	        fprintf(out, "FIELD %s %s %u %u\n", layout.fields[i].name, layout.fields[i].kind,
    21	                layout.fields[i].off, layout.fields[i].size);
    22	    }
    23	    fclose(out);
    24	    if (tag_value && permit_tag(tag_value) != 0) {
    25	        return -1;
    26	    }
    27	    return 0;
    28	}
