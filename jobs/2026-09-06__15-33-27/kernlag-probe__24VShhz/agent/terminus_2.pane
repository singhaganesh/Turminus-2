     6	static int read_pin(char *release, size_t n) {
     7	    FILE *fp = fopen("/app/snapvault/default.pin", "r");
     8	    if (!fp) {
     9	        return -1;
    10	    }
    11	    if (!fgets(release, (int)n, fp)) {
    12	        fclose(fp);
    13	        return -1;
    14	    }
    15	    fclose(fp);
    16	    size_t len = strlen(release);
    17	    while (len > 0 && (release[len - 1] == '\n' || release[len - 1] == '\r')) {
    18	        release[--len] = '\0';
    19	    }
    20	    return 0;
    21	}
    22	
    23	static void apply_policy_release(char *release, size_t n) {
    24	    FILE *fp = fopen("/app/snapvault/policy.conf", "r");
    25	    char line[128];
    26	    char val[RELEASE_LEN];
    27	    if (!fp) {
    28	        return;
    29	    }
    30	    while (fgets(line, sizeof(line), fp)) {
    31	        if (sscanf(line, "DEFAULT_RELEASE=%63s", val) == 1) {
    32	            snprintf(release, n, "%s", val);
    33	        }
    34	    }
    35	    fclose(fp);
    36	}
    37	
    38	int choose_layout(source_pick *out) {
    39	    char release[RELEASE_LEN];
    40	
    41	    if (!out) {
    42	        return -1;
    43	    }
    44	    memset(out, 0, sizeof(*out));
    45	
    46	    if (read_pin(release, sizeof(release)) != 0) {
    47	        return -1;
    48	    }
    49	    apply_policy_release(release, sizeof(release));
    50	    snprintf(out->layout_path, sizeof(out->layout_path),
    51	             "/app/snapvault/releases/%s/sched_entity.tab", release);
    52	    snprintf(out->tag_value, sizeof(out->tag_value), "bundle:%s", release);
    53	    out->from_bundle = 1;
    54	    return 0;
    55	}
