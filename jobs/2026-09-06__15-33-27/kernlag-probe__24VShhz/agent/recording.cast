[8.754361, "o", "/app\r\n"]
[8.754556, "o", "\r\n== route map ==\r\n"]
[8.755966, "o", "lagpipe synctab repair map (internal)\r\n\r\n- relc/input.c — chooses layout input for synctab\r\n- tblw/emit_writer.c — writes synctab_out/layout.tbl from the picked layout\r\n- tagc/gate.c — records whether bundled snapshots are acceptable\r\n- synclink/field_emit.c — reads captures using stamp offsets\r\n\r\nAbsolute synctab repair paths:\r\n  /app/relc/input.c\r\n  /app/lagpipe/tblw/emit_writer.c\r\n  /app/lagpipe/tagc/gate.c\r\n\r\nRebuild entrypoint: make -C /app/lagpipe bind\r\n"]
[8.756925, "o", "\r\n== tree ==\r\n"]
[8.759767, "o", "/app/lagpipe/BUILDCHANNEL\r\n/app/lagpipe/Makefile\r\n/app/lagpipe/VERIFIER_CHANNEL\r\n/app/lagpipe/fieldnotes/FIELD_RULES.txt\r\n/app/lagpipe/fieldnotes/ROUTE_MAP.txt\r\n/app/lagpipe/synclink/ARCHITECTURE\r\n/app/lagpipe/synclink/common.h\r\n/app/lagpipe/synclink/driver.c\r\n/app/lagpipe/synclink/field_emit.c\r\n/app/lagpipe/synclink/parse_layout.c\r\n/app/lagpipe/synclink/rebuild.c\r\n/app/lagpipe/synctab_out/layout.tbl\r\n/app/lagpipe/synctab_out/procance.tag\r\n/app/lagpipe/tagc/gate.c\r\n/app/lagpipe/tagc/gate.h\r\n/app/lagpipe/tblw/emit_writer.c\r\n"]
[8.760213, "o", "\r\n== makefiles ==\r\n"]
[8.761897, "o", "/app/lagpipe/Makefile\r\n"]
[8.762722, "o", "\u001b[?2004hroot@7d6098c46ccf:/app# "]
[9.301582, "i", "printf '\\n== release ==\\n'; cat /app/livekern/running.release; printf '\\n== current synctab output ==\\n'; find /app/lagpipe/synctab_out -maxdepth 2 -type f -printf '%p: ' -exec cat {} \\; 2>/dev/null; printf '\\n== samples and refs ==\\n'; for f in /app/memvault/samples/*.mem; do b=$(basename \"$f\" .mem); echo \"--- $b inspect\"; /app/bin/kernscribe inspect \"$f\"; echo \"--- $b ref\"; cat \"/app/memvault/cards/$b.ref\"; done\n"]
[9.303656, "o", "printf '\\n== release ==\\n'; cat /app/livekern/running.release; printf '\\n== current synctab output ==\\n'; find /app/lagpipe/synctab_out -maxdepth 2 -type f -printf '%p: ' -exec cat {} \\; 2>/dev/null; printf '\\n== samples and refs ==\\n'; for f in /app/memvault/samples/*.mem; do b=$(basename \"$f\" .mem); echo \"--- $b inspect\"; /app/bin/kernscribe inspect \"$f\"; echo \"--- $b ref\"; cat \"/app/memvault/cards/$b.ref\"; done\r\n\u001b[?2004l\r\r\n== release ==\r\n"]
[9.307445, "o", "6.8.12\r\n"]
[9.307958, "o", "\r\n== current synctab output ==\r\n"]
