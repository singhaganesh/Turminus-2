[60.704496, "i", "cat > /app/relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic int read_live_release(char *release, size_t n) {\n    FILE *fp;\n    char *start;\n    size_t len;\n\n    if (!release || n == 0) {\n        return -1;\n    }\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp) {\n        return -1;\n    }\n    if (!fgets(release, (int)n, fp)) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n\n    start = release;\n    while (*start && isspace((unsigned char)*start)) {\n        start++;\n    }\n    len = strlen(start);\n    while (len > 0 && isspace((unsigned char)start[len - 1])) {\n        start[--len] = '\\0';\n    }\n    if (start != release) {\n        memmove(release, start, len + 1);\n    }\n    return len > 0 ? 0 : -1;\n}\n\nint choose_layout(source_pick *out) {\n    char release[RELEASE_LEN];\n\n    if (!out) {\n        return -1;\n    }\n    memset(out, 0, sizeof(*out));\n    if (read_live_release(release, sizeof(release)) != 0) {\n        return -1;\n    }\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/livekern/exports/sched_entity.tab\");\n    snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release);\n    out->from_bundle = 0;\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0 || tag_value[5] == '\\0') {\n        return -1;\n    }\n    if (strchr(tag_value, '\\n') || strchr(tag_value, '\\r')) {\n        return -1;\n    }\n    return 0;\n}\nEOF\npython3 - <<'PY'\np='/app/lagpipe/tblw/emit_writer.c'\ns=open(p).read()\ns=s.replace('''    if (parse_layout(layout_path, &layout) != 0) {\n        return -1;\n    }\n''','''    if (!tag_value || permit_tag(tag_value) != 0) {\n        return -1;\n    }\n    if (parse_layout(layout_path, &layout) != 0) {\n        return -1;\n    }\n''')\ns=s.replace('''    if (tag_value && permit_tag(tag_value) != 0) {\n        return -1;\n    }\n''','')\nopen(p,'w').write(s)\nPY\n"]
[60.71653, "o", "cat > /app/relc/input.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../lagpipe/synclink/common.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <ctype.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static int read_live_release(char *release, size_t n) {\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *fp;\r\n\u001b[?2004l\r\u001b[?2004h>     char *start;\r\n\u001b[?2004l\r\u001b[?2004h>     size_t len;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!release || n == 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     fp = fopen(\"/app/livekern/running.release\", \"r\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!fp) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (!fgets(release, (int)n, fp)) {\r\n\u001b[?2004l\r\u001b[?2004h>         fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     start = release;\r\n\u001b[?2004l\r\u001b[?2004h>     while (*start && isspace((unsigned char)*start)) {\r\n\u001b[?2004l\r\u001b[?2004h>         start++;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     len = strlen(start);\r\n\u001b[?2004l\r\u001b[?2004h>     while (len > 0 && isspace((unsigned char)start[len - 1])) {\r\n\u001b[?2004l\r\u001b[?2004h>         start[--len] = '\\0';\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (start != release) {\r\n\u001b[?2004l\r\u001b[?2004h>         memmove(release, start, len + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return len > 0 ? 0 : -1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int choose_layout(source_pick *out) {\r\n\u001b[?2004l\r\u001b[?2004h>     char release[RELEASE_LEN];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!out) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     memset(out, 0, sizeof(*out));\r\n\u001b[?2004l\r\u001b[?2004h>     if (read_live_release(release, sizeof(release)) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     snprintf(out->layout_path, sizeof(out->layout_path),\r\n\u001b[?2004l\r\u001b[?2004h>              \"/app/livekern/exports/sched_entity.tab\");\r\n\u001b[?2004l\r\u001b[?2004h>     snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release);\r\n\u001b[?2004l\r\u001b[?2004h>     out->from_bundle = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[60.723491, "o", "\u001b[?2004hroot@7d6098c46ccf:/app# cat > /app/lagpipe/tagc/gate.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"gate.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int permit_tag(const char *tag_value) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0 || tag_value[5] == '\\0') {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (strchr(tag_value, '\\n') || strchr(tag_value, '\\r')) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[60.729392, "o", "\u001b[?2004hroot@7d6098c46ccf:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/lagpipe/tblw/emit_writer.c'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('''    if (parse_layout(layout_path, &layout) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> ''','''    if (!tag_value || permit_tag(tag_value) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (parse_layout(layout_path, &layout) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('''    if (tag_value && permit_tag(tag_value) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> ''','')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
