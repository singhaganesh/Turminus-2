[27.465467, "o", "echo '===== common.h ====='; cat /app/lagpipe/synclink/common.h; echo '===== driver.c ====='; cat /app/lagpipe/synclink/driver.c; echo '===== all app files depth 4 ====='; find /app -maxdepth 4 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[27.46576, "o", "===== common.h =====\r\n"]
[27.467596, "o", "#ifndef KERN_FORGE_COMMON_H\r\n#define KERN_FORGE_COMMON_H\r\n\r\n#include <stddef.h>\r\n\r\n#define LAYOUT_PATH_LEN 512\r\n#define TAG_PATH_LEN 512\r\n#define RELEASE_LEN 64\r\n#define FIELD_MAX 16\r\n\r\ntypedef struct {\r\n    char name[64];\r\n    char kind[16];\r\n    unsigned off;\r\n    unsigned size;\r\n} field_def;\r\n\r\ntypedef struct {\r\n    char struct_name[64];\r\n    field_def fields[FIELD_MAX];\r\n    int nfields;\r\n} layout_def;\r\n\r\ntypedef struct {\r\n    char layout_path[LAYOUT_PATH_LEN];\r\n    char tag_value[RELEASE_LEN];\r\n    int from_bundle;\r\n} source_pick;\r\n\r\nint choose_layout(source_pick *out);\r\nint parse_layout(const char *path, layout_def *layout);\r\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value);\r\nint emit_inspect_json(const char *inspect_path);\r\nint rebuild_binary(void);\r\n\r\n#endif\r\n"]
[27.467775, "o", "===== driver.c =====\r\n"]
[27.468846, "o", "#include \"common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int run_gen(void) {\r\n    source_pick pick;\r\n    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\r\n    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\r\n    FILE *tag_fp;\r\n\r\n    if (choose_layout(&pick) != 0) {\r\n        fprintf(stderr, \"imprint: layout pick failed\\n\");\r\n        return 1;\r\n    }\r\n    tag_fp = fopen(tag_out, \"w\");\r\n    if (!tag_fp) {\r\n        perror(\"imprint: procance.tag\");\r\n        return 1;\r\n    }\r\n    fprintf(tag_fp, \"%s\\n\", pick.tag_value);\r\n    fclose(tag_fp);\r\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\r\n        fprintf(stderr, \"imprint: types write failed\\n\");\r\n        return 1;\r\n    }\r\n    if (rebuild_binary() != 0) {\r\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\r\n        return 2;\r\n    }\r\n    if (strcmp(argv[1], \"synctab\") == 0) {\r\n        return run_gen();\r\n    }\r\n    if (strcmp(argv[1], \"inspect\") == 0) {\r\n        if (argc < 3) {\r\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\r\n            return 2;\r\n        }\r\n        return emit_inspect_json(argv[2]);\r\n    }\r\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\r\n    return 2;\r\n}\r\n"]
[27.469093, "o", "===== all app files depth 4 =====\r\n"]
[27.471783, "o", "/app/bin/kernscribe\r\n/app/lagpipe/BUILDCHANNEL\r\n/app/lagpipe/Makefile\r\n/app/lagpipe/VERIFIER_CHANNEL\r\n/app/lagpipe/fieldnotes/FIELD_RULES.txt\r\n/app/lagpipe/fieldnotes/ROUTE_MAP.txt\r\n/app/lagpipe/synclink/ARCHITECTURE\r\n/app/lagpipe/synclink/common.h\r\n/app/lagpipe/synclink/driver.c\r\n/app/lagpipe/synclink/field_emit.c\r\n/app/lagpipe/synclink/parse_layout.c\r\n/app/lagpipe/synclink/rebuild.c\r\n/app/lagpipe/synctab_out/layout.tbl\r\n/app/lagpipe/synctab_out/procance.tag\r\n/app/lagpipe/tagc/gate.c\r\n/app/lagpipe/tagc/gate.h\r\n/app/lagpipe/tblw/emit_writer.c\r\n/app/livekern/CHANNEL\r\n/app/livekern/EXPORTS\r\n/app/livekern/VERSION\r\n/app/livekern/exports/sched_entity.tab\r\n/app/livekern/running.release\r\n/app/memvault/MANIFEST\r\n/app/memvault/cards/pulse_a.ref\r\n/app/memvault/cards/pulse_b.ref\r\n/app/memvault/regression/bundle_pick_input.c\r\n/app/memvault/samples/pulse_a.mem\r\n/app/memvault/samples/pulse_b.mem\r\n/app/relc/input.c\r\n/app/snapvault/CATALOG\r\n/app/snapvault/MANIFEST\r\n/app/snapvault/PIN_INDEX\r\n/app/snapvault/default.pin\r\n/app/snapvault/policy.conf\r\n"]
[27.471969, "o", "/app/snapvault/releases/6.8.10/sched_entity.tab\r\n/app/snapvault/releases/6.8.11/sched_entity.tab\r\n/app/snapvault/releases/6.8.12/sched_entity.tab\r\n"]
