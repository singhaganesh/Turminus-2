[61.160809, "i", "cat > /app/lagpipe/synclink/driver.c <<'EOF'\n#include \"common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\nstatic const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\nstatic const char *guard_out = \"/app/lagpipe/synctab_out/offline_guard.ok\";\n\nstatic void clean_outputs(void) {\n    remove(types_out);\n    remove(tag_out);\n    remove(guard_out);\n}\n\nstatic int fail_gen(const char *message) {\n    fprintf(stderr, \"%s\\n\", message);\n    clean_outputs();\n    return 1;\n}\n\nstatic int run_gen(void) {\n    source_pick pick;\n    FILE *fp;\n\n    clean_outputs();\n    if (choose_layout(&pick) != 0) {\n        return fail_gen(\"imprint: layout pick failed\");\n    }\n    if (pick.from_bundle || permit_tag(pick.tag_value) != 0) {\n        return fail_gen(\"imprint: bundled layout rejected\");\n    }\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\n        return fail_gen(\"imprint: types write failed\");\n    }\n\n    fp = fopen(tag_out, \"w\");\n    if (!fp) {\n        perror(\"imprint: procance.tag\");\n        clean_outputs();\n        return 1;\n    }\n    if (fprintf(fp, \"%s\\n\", pick.tag_value) < 0 || fclose(fp) != 0) {\n        return fail_gen(\"imprint: provenance write failed\");\n    }\n\n    if (rebuild_binary() != 0) {\n        return fail_gen(\"imprint: rebuild failed\");\n    }\n\n    fp = fopen(guard_out, \"w\");\n    if (!fp) {\n        perror(\"imprint: offline_guard.ok\");\n        clean_outputs();\n        return 1;\n    }\n    if (fputs(\"1\\n\", fp) == EOF || fclose(fp) != 0) {\n        return fail_gen(\"imprint: guard write failed\");\n    }\n    return 0;\n}\n\nint main(int argc, char **argv) {\n    if (argc < 2) {\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\n        return 2;\n    }\n    if (strcmp(argv[1], \"synctab\") == 0) {\n        return run_gen();\n    }\n    if (strcmp(argv[1], \"inspect\") == 0) {\n        if (argc < 3) {\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\n            return 2;\n        }\n        return emit_inspect_json(argv[2]);\n    }\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\n    return 2;\n}\nEOF\npython3 - <<'PY'\np='/app/lagpipe/synclink/field_emit.c'\ns=open(p).read()\ns=s.replace('''    if (nread < 16) {\n        fprintf(stderr, \"probe: inspect too short\\\\n\");\n        return 1;\n    }\n''','''    if (nread == 0) {\n        fprintf(stderr, \"probe: inspect too short\\\\n\");\n        return 1;\n    }\n''')\ns=s.replace('''        if (strcmp(f->kind, \"u64\") == 0) {\n            printf(\",\\\\\"%s\\\\\":%llu\", f->name, read_u64(blob, f->off));\n        } else {\n            printf(\",\\\\\"%s\\\\\":%lu\", f->name, read_u32(blob, f->off));\n        }\n''','''        if (strcmp(f->kind, \"u64\") == 0 && f->size == 8) {\n            if ((size_t)f->off + 8 > nread) {\n                fprintf(stderr, \"probe: inspect too short for %s\\\\n\", f->name);\n                return 1;\n            }\n            printf(\",\\\\\"%s\\\\\":%llu\", f->name, read_u64(blob, f->off));\n        } else if (strcmp(f->kind, \"u32\") == 0 && f->size == 4) {\n            if ((size_t)f->off + 4 > nread) {\n                fprintf(stderr, \"probe: inspect too short for %s\\\\n\", f->name);\n                return 1;\n            }\n            printf(\",\\\\\"%s\\\\\":%lu\", f->name, read_u32(blob, f->off));\n        } else {\n            fprintf(stderr, \"probe: unsupported field %s\\\\n\", f->name);\n            return 1;\n        }\n''')\nopen(p,'w').write(s)\nPY\nmake -C /app/lagpipe bind && /app/bin/kernscribe synctab\n"]
