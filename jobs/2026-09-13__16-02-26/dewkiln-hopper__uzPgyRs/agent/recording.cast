[85.659347, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], root: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(root);\n    fs::create_dir_all(root).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|x| x.0);\n    for (day, path) in files {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(path, format!(\"{}/{}\", root, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/shardfold/read.rs <<'EOF'\nuse std::fs;\n\npub fn list(root: &str) -> Vec<(i32, String)> {\n    let mut files = Vec::new();\n    let entries = match fs::read_dir(root) {\n        Ok(entries) => entries,\n        Err(_) => return files,\n    };\n    for entry in entries.flatten() {\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        if let Ok(day) = name[1..9].parse::<i32>() {\n            files.push((day, entry.path().to_string_lossy().into_owned()));\n        }\n    }\n    files.sort_by_key(|x| x.0);\n    files\n}\n\npub fn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\nEOF\n"]
