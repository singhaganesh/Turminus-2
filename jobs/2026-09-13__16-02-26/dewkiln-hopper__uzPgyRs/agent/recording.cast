[112.173356, "i", "set -u; rm -rf /tmp/daywell-test-save; cp -a /app/daywell /tmp/daywell-test-save; rm -rf /app/daywell; mkdir /app/daywell; /app/bin/dewkiln clasp; rc=$?; echo \"EMPTY_RC=$rc GUARD=$([ -e /app/bloturn/GUARD ] && echo present || echo absent)\"; test \"$rc\" -ne 0 && test ! -e /app/bloturn/GUARD; rm -rf /app/daywell; cp -a /tmp/daywell-test-save /app/daywell\n"]
[112.174706, "o", "set -u; rm -rf /tmp/daywell-test-save; cp -a /app/daywell /tmp/daywell-test-save; rm -rf /app/daywell; mkdir /app/daywell; /app/bin/dewkiln clasp; rc=$?; echo \"EMPTY_RC=$rc GUARD=$([ -e /app/bloturn/GUARD ] && echo present || echo absent)\"; test \"$rc\" -ne 0 && test ! -e /app/bloturn/GUARD; rm -rf /app/daywell; cp -a /tmp/daywell-test-save /app/daywell\r\n\u001b[?2004l\r"]
