[86.035229, "i", "cat > /app/wickmill/boot.rs <<'EOF'\n#[path = \"../urncue/fold.rs\"]\nmod fold;\n#[path = \"../millrib/gait.rs\"]\nmod gait;\n#[path = \"../lidcue/skip.rs\"]\nmod skip;\n#[path = \"../corkpit/floor.rs\"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != \"clasp\" {\n        eprintln!(\"usage: dewkiln clasp\");\n        std::process::exit(2);\n    }\n\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\n    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");\n    let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\n\n    let code = match fold::fold() {\n        Ok((packed, taken)) => {\n            let mut ordered = packed.clone();\n            skip::skip(&mut ordered);\n            if !floor::floor(taken) {\n                1\n            } else {\n                gait::gait(taken, &packed)\n            }\n        }\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\n/app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; echo '--- output files'; find /app/bloturn /app/packbay/latest -maxdepth 1 -type f -printf '%p rows=' -exec awk 'NF{n++} END{print n+0}' {} \\; | sort; echo '--- JSON/GUARD'; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do echo \"$f: $(cat \"$f\" 2>/dev/null || echo MISSING)\"; done\n"]
