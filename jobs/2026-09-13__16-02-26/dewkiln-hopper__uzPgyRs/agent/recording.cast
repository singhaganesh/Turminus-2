[85.85218, "i", "cat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list(\"/app/daywell\"));\n    if picked.is_empty() {\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\n        return Err(1);\n    }\n\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\n    let mut taken = 0;\n    for (day, path) in &picked {\n        taken += read::nlines(path)?;\n        let dest = format!(\"/app/packbay/stage/d{:08}.tbl\", day);\n        fs::copy(path, dest).map_err(|_| 1)?;\n    }\n\n    soak::soak(&picked, \"/app/packbay/latest\")?;\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\n        \"/app/bloturn/ledger.json\",\n        format!(\"{{\\\"taken\\\":{}}}\", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((picked, taken))\n}\nEOF\ncat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let template = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let output = template\n        .replace(\"__P__\", probe)\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", output).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    let mut matched = 0;\n    for (_, path) in files {\n        if !path.starts_with(\"/app/daywell/\") {\n            return 1;\n        }\n        let text = match fs::read_to_string(path) {\n            Ok(text) => text,\n            Err(_) => return 1,\n        };\n        matched += text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n    }\n    if emit(\"live\", matched, taken).is_err() || matched != taken {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\n"]
