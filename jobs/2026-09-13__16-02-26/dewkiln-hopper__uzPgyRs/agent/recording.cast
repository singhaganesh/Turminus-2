[113.169969, "o", "\u001b[?2004hroot@d28060ff246d:/app# "]
[114.12662, "i", "/app/bin/dewkiln clasp; rc=$?; python3 - <<'PY'\nimport json, pathlib\nb = pathlib.Path('/app/bloturn')\nledger = json.loads((b/'ledger.json').read_text())\ncheck = json.loads((b/'check.json').read_text())\nassert set(check) == {'probe','matched','taken'}\nassert isinstance(check['probe'], str) and check['probe'] == 'live'\nassert type(check['matched']) is int and type(check['taken']) is int\nassert check['matched'] == check['taken'] == ledger['taken'] == 22\nassert (b/'GUARD').read_text() == 'ok'\nwall = int(pathlib.Path('/app/opstext/WALL').read_text())\nfor src in pathlib.Path('/app/daywell').glob('d*.tbl'):\n    day = int(src.stem[1:])\n    dst = pathlib.Path('/app/packbay/latest') / src.name\n    if day <= wall:\n        assert dst.read_bytes() == src.read_bytes(), src.name\n    else:\n        assert not dst.exists(), src.name\nprint('VALIDATED', check)\nPY\nprintf 'FINAL_RC=%s ELF_MAGIC=' \"$rc\"; od -An -tx1 -N4 /app/bin/dewkiln; echo 'LATEST:'; find /app/packbay/latest -maxdepth 1 -type f -name 'd*.tbl' -printf '%f ' -exec awk 'NF{n++} END{print n+0}' {} \\; | sort\n"]
[114.127036, "o", "/app/bin/dewkiln clasp; rc=$?; python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.127169, "o", "import json, pathlib\r\n\u001b[?2004l\r\u001b[?2004h> "]
