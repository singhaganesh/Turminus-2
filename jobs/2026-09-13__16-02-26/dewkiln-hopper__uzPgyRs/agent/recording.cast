[30.001234, "o", "\u001b[?2004hroot@d28060ff246d:/app# "]
[42.738864, "i", "echo '===== boot.rs'; cat /app/wickmill/boot.rs; echo '===== floor.rs'; cat /app/corkpit/floor.rs; echo '===== sheet.tpl'; cat /app/millrib/sheet.tpl; echo; echo '===== configs'; for f in /app/opstext/* /app/floorcue/*; do echo \"--- $f\"; cat \"$f\"; echo; done\n"]
[42.739785, "o", "echo '===== boot.rs'; cat /app/wickmill/boot.rs; echo '===== floor.rs'; cat /app/corkpit/floor.rs; echo '===== sheet.tpl'; cat /app/millrib/sheet.tpl; echo; echo '===== configs'; for f in /app/opstext/* /app/floorcue/*; do echo \"--- $f\"; cat \"$f\"; echo; done\r\n\u001b[?2004l\r"]
[42.739929, "o", "===== boot.rs\r\n"]
[42.74104, "o", "#[path = \"../urncue/fold.rs\"]\r\nmod fold;\r\n#[path = \"../millrib/gait.rs\"]\r\nmod gait;\r\n#[path = \"../lidcue/skip.rs\"]\r\nmod skip;\r\n#[path = \"../corkpit/floor.rs\"]\r\nmod floor;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"clasp\" {\r\n        eprintln!(\"usage: dewkiln clasp\");\r\n        std::process::exit(2);\r\n    }\r\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    let code = match fold::fold() {\r\n        Ok((packed, taken)) => {\r\n            let mut dump = packed.clone();\r\n            skip::skip(&mut dump);\r\n            let _ = floor::floor(taken);\r\n            gait::gait(taken, &packed)\r\n        }\r\n        Err(c) => c,\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[42.741246, "o", "===== floor.rs\r\n"]
[42.742129, "o", "use std::fs;\r\n\r\npub fn floor(a: i32) -> bool {\r\n    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n        Err(_) => 0,\r\n    };\r\n    a >= t\r\n}\r\n"]
[42.742303, "o", "===== sheet.tpl\r\n"]
[42.743153, "o", "{\"probe\":\"__P__\",\"matched\":__M__,\"taken\":__T__}\r\n"]
[42.743336, "o", "\r\n===== configs\r\n"]
[42.743422, "o", "--- /app/opstext/LIST.txt\r\n"]
[42.744206, "o", "dewkiln layout\r\n==============\r\n\r\nwickmill/boot.rs dispatches clasp.\r\n\r\nPipeline crates:\r\n- hopcue/\r\n- millrib/\r\n- restpit/\r\n- urncue/\r\n- shardfold/\r\n- lidcue/\r\n\r\nDay files live in /app/daywell.\r\nclasp writes /app/bloturn/ledger.json and /app/bloturn/check.json\r\nand unpacks /app/packbay/latest.\r\nFixture copies of the day files sit at /app/seed/daywell.\r\n\r\ncheck.json object:\r\n- probe (string)\r\n- matched (integer)\r\n- taken (integer)\r\n\r\nCI floor integer lives in /app/floorcue/MIN.txt.\r\n\r\nExtra daywell files still use names like d20260908.tbl and d20260914.tbl.\r\n\r\n\r\nRebuild the binary with /app/wick.sh after source edits.\r\n"]
[42.744355, "o", "\r\n--- /app/opstext/SHIFT.txt\r\n"]
[42.745149, "o", "Nightly clasp has stayed green since the CI floor landed.\r\nOperators still open /app/packbay/latest after incidents and find the\r\nnewest populated day file missing even when /app/daywell still holds it.\r\nThe floor value lives under floorcue/.\r\n"]
[42.745298, "o", "\r\n--- /app/opstext/WALL\r\n"]
[42.74609, "o", "20260913\r\n"]
[42.746267, "o", "\r\n--- /app/floorcue/MIN.txt\r\n"]
[42.747047, "o", "15\r\n"]
[42.747225, "o", "\r\n"]
[42.74729, "o", "\u001b[?2004hroot@d28060ff246d:/app# "]
[43.217075, "i", "echo '===== row counts'; for d in /app/daywell /app/seed/daywell /app/packbay/stage /app/packbay/latest; do echo \"--- $d\"; find \"$d\" -maxdepth 1 -type f -name 'd*.tbl' -printf '%f ' -exec awk 'NF{n++} END{print n+0}' {} \\; 2>/dev/null | sort; done; echo '===== live contents'; for f in /app/daywell/*.tbl; do echo \"--- $f\"; cat \"$f\"; done\n"]
[43.219333, "o", "echo '===== row counts'; for d in /app/daywell /app/seed/daywell /app/packbay/stage /app/packbay/latest; do echo \"--- $d\"; find \"$d\" -maxdepth 1 -type f -name 'd*.tbl' -printf '%f ' -exec awk 'NF{n++} END{print n+0}' {} \\; 2>/dev/null | sort; done; echo '===== live contents'; for f in /app/daywell/*.tbl; do echo \"--- $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[43.220086, "o", "===== row counts\r\n--- /app/daywell\r\n"]
