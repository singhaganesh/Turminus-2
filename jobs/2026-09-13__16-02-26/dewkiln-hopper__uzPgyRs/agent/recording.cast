[114.127657, "o", "\u001b[?2004h> "]
[114.129164, "o", "assert set(check) == {'probe','matched','taken'}\r\n\u001b[?2004l\r\u001b[?2004h> assert isinstance(check['probe'], str) and check['probe'] == 'live'\r\n\u001b[?2004l\r\u001b[?2004h> assert type(check['matched']) is int and type(check['taken']) is int\r\n\u001b[?2004l\r\u001b[?2004h> assert check['matched'] == check['taken'] == ledger['taken'] == 22\r\n\u001b[?2004l\r\u001b[?2004h> assert (b/'GUARD').read_text() == 'ok'\r\n\u001b[?2004l\r\u001b[?2004h> wall = int(pathlib.Path('/app/opstext/WALL').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> for src in pathlib.Path('/app/daywell').glob('d*.tbl'):\r\n\u001b[?2004l\r\u001b[?2004h>     day = int(src.stem[1:])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.129374, "o", "    dst = pathlib.Path('/app/packbay/latest') / src.name\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.129497, "o", "    if day <= wall:\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.129578, "o", "> "]
[114.129723, "o", "        assert dst.read_bytes() == src.read_bytes(), src.name\r\n\u001b[?2004l\r"]
[114.129796, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.129931, "o", "        assert not dst.exists(), src.name\r\n\u001b[?2004l\r"]
[114.130006, "o", "\u001b[?2004h> "]
