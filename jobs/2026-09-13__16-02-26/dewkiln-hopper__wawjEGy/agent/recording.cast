[8.498005, "o", "dewkiln layout\r\n==============\r\n\r\nwickmill/boot.rs dispatches clasp.\r\n\r\nPipeline crates:\r\n- hopcue/\r\n- millrib/\r\n- restpit/\r\n- urncue/\r\n- shardfold/\r\n- lidcue/\r\n\r\nDay files live in /app/daywell.\r\nclasp writes /app/bloturn/ledger.json and /app/bloturn/check.json\r\nand unpacks /app/packbay/latest.\r\nFixture copies of the day files sit at /app/seed/daywell.\r\n\r\ncheck.json object:\r\n- probe (string)\r\n- matched (integer)\r\n- taken (integer)\r\n\r\nCI floor integer lives in /app/floorcue/MIN.txt.\r\n\r\nExtra daywell files still use names like d20260908.tbl and d20260914.tbl.\r\n\r\n\r\nRebuild the binary with /app/wick.sh after source edits.\r\n"]
[8.498221, "o", "--- WALL/MIN ---\r\n"]
[8.499162, "o", "20260913\r\n"]
[8.499348, "o", "15\r\n"]
[8.499506, "o", "--- files ---\r\n"]
[8.502163, "o", "d /app/bloturn\r\nd /app/daywell\r\nd /app/packbay\r\nd /app/packbay/latest\r\nd /app/packbay/stage\r\nf /app/bloturn/GUARD\r\nf /app/bloturn/check.json\r\nf /app/bloturn/ledger.json\r\nf /app/daywell/d20260910.tbl\r\nf /app/daywell/d20260911.tbl\r\nf /app/daywell/d20260912.tbl\r\nf /app/daywell/d20260913.tbl\r\nf /app/packbay/latest/d20260910.tbl\r\nf /app/packbay/latest/d20260911.tbl\r\nf /app/packbay/stage/d20260910.tbl\r\nf /app/packbay/stage/d20260911.tbl\r\nf /app/packbay/stage/d20260912.tbl\r\n"]
[8.502421, "o", "--- types ---\r\n"]
[8.502999, "o", "\u001b[?2004hroot@39362b762127:/app# "]
