[31.840361, "o", "--- fixture files/counts ---\r\n"]
[31.841843, "o", "/app/seed/daywell/d20260911.tbl\r\n"]
[31.843264, "o", "lines=4\r\n"]
[31.843556, "o", "/app/seed/daywell/d20260913.tbl\r\n"]
[31.844928, "o", "lines=7\r\n"]
[31.845189, "o", "/app/seed/daywell/d20260912.tbl\r\n"]
[31.846417, "o", "lines=6\r\n"]
[31.846671, "o", "/app/seed/daywell/d20260910.tbl\r\n"]
[31.847932, "o", "lines=5\r\n"]
[31.848434, "o", "\u001b[?2004hroot@39362b762127:/app# "]
[44.897588, "i", "echo '--- floor and notes ---'; for f in /app/corkpit/* /app/opstext/SHIFT.txt; do echo \"### $f\"; sed -n '1,300p' \"$f\"; done\n"]
[44.898102, "o", "echo '--- floor and notes ---'; for f in /app/corkpit/* /app/opstext/SHIFT.txt; do echo \"### $f\"; sed -n '1,300p' \"$f\"; done\r\n\u001b[?2004l\r"]
[44.898275, "o", "--- floor and notes ---\r\n### /app/corkpit/NOTE.txt\r\n"]
[44.903816, "o", "floor() reads MIN.txt and compares a taken total to that integer.\r\nCI used this as a cheap rehearsal when the desk was first wired.\r\n"]
[44.903951, "o", "### /app/corkpit/floor.rs\r\n"]
[44.906513, "o", "use std::fs;\r\n\r\npub fn floor(a: i32) -> bool {\r\n    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n        Err(_) => 0,\r\n    };\r\n    a >= t\r\n}\r\n"]
[44.908691, "o", "### /app/opstext/SHIFT.txt\r\n"]
[44.910894, "o", "Nightly clasp has stayed green since the CI floor landed.\r\nOperators still open /app/packbay/latest after incidents and find the\r\nnewest populated day file missing even when /app/daywell still holds it.\r\nThe floor value lives under floorcue/.\r\n"]
[44.911351, "o", "\u001b[?2004h"]
[44.911725, "o", "root@39362b762127:/app# "]
[45.384643, "i", "cat > /tmp/patch.py <<'PY'\nfrom pathlib import Path\np=Path('/app/hopcue/rim.rs')\ns=p.read_text().replace('*d < a', '*d <= a')\np.write_text(s)\n\np=Path('/app/restpit/soak.rs')\ns=p.read_text().replace('    if !xs.is_empty() {\\n        xs.pop();\\n    }\\n','')\np.write_text(s)\n\np=Path('/app/urncue/fold.rs')\ns=p.read_text()\ns=s.replace('''        return Ok((Vec::new(), 0));''','''        return Err(1);''')\np.write_text(s)\nPY\npython3 /tmp/patch.py\nsed -n '1,240p' /app/hopcue/rim.rs /app/restpit/soak.rs /app/urncue/fold.rs\n"]
[45.384822, "o", "cat > /tmp/patch.py <<'PY'\r\n\u001b[?2004l\r"]
[45.384938, "o", "\u001b[?2004h> "]
[45.385032, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.385236, "o", "p=Path('/app/hopcue/rim.rs')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.385341, "o", "s=p.read_text().replace('*d < a', '*d <= a')\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.385454, "o", "> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.385544, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.386507, "o", "p=Path('/app/restpit/soak.rs')\r\n\u001b[?2004l\r\u001b[?2004h> s=p.read_text().replace('    if !xs.is_empty() {\\n        xs.pop();\\n    }\\n','')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p=Path('/app/urncue/fold.rs')\r\n\u001b[?2004l\r\u001b[?2004h> s=p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('''        return Ok((Vec::new(), 0));''','''        return Err(1);''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r"]
[45.386766, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[45.390787, "o", "\u001b[?2004hroot@39362b762127:/app# "]
[45.390907, "o", "python3 /tmp/patch.py\r\n\u001b[?2004l\r"]
[45.446125, "o", "\u001b[?2004hroot@39362b762127:/app# "]
[45.446319, "o", "sed -n '1,240p' /app/hopcue/rim.rs /app/restpit/soak.rs /app/urncue/fold.rs\r\n\u001b[?2004l\r"]
[45.447365, "o", "pub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n    b.into_iter().filter(|(d, _)| *d <= a).collect()\r\n}\r\n"]
[45.447405, "o", "use std::fs;\r\n\r\npub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n    let _ = fs::remove_dir_all(b);\r\n    fs::create_dir_all(b).map_err(|_| 1)?;\r\n    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n    xs.sort_by_key(|x| x.0);\r\n    for (d, p) in xs {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n"]
[45.447577, "o", "        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    }\r\n    Ok(())\r\n}\r\n#[path = \"../hopcue/rim.rs\"]\r\nmod rim;\r\n#[path = \"../restpit/soak.rs\"]\r\nmod soak;\r\n#[path = \"../shardfold/read.rs\"]\r\nmod read;\r\n\r\nuse std::fs;\r\n\r\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n        .map_err(|_| 1)?\r\n        .trim()\r\n        .parse()\r\n        .map_err(|_| 1)?;\r\n    let listed = read::list(\"/app/daywell\");\r\n    let picked = rim::rim(wall, listed);\r\n    if picked.is_empty() {\r\n        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n        return Err(1);\r\n    }\r\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    let mut packed = Vec::new();\r\n    let mut taken = 0;\r\n    for (d, p) in picked {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n        taken += read::nlines(&dest);\r\n        packed.push((d, dest));\r\n    }\r\n    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n"]
[45.447649, "o", "    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    Ok((packed, taken))\r\n}\r\n"]
[45.447882, "o", "\u001b[?2004hroot@39362b762127:/app# "]
[69.657228, "i", "cat > /app/millrib/gait.rs <<'RS'\nuse std::fs;\nuse std::path::Path;\n\nfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let out = tpl\n        .replace(\"__P__\", p)\n        .replace(\"__M__\", &m.to_string())\n        .replace(\"__T__\", &t.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\n}\n\nfn rows(path: &Path) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\n\n// Verify by reopening the live inputs.  In particular, never derive matched\n// from ledger.json or from the staged copies.\nfn live_count() -> Result<(i32, Vec<(i32, i32)>), i32> {\n    let wall = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?\n        .trim()\n        .parse::<i32>()\n        .map_err(|_| 1)?;\n    let mut files = Vec::new();\n    let rd = fs::read_dir(\"/app/daywell\").map_err(|_| 1)?;\n    for ent in rd {\n        let ent = ent.map_err(|_| 1)?;\n        let name = ent.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let day = match name[1..9].parse::<i32>() {\n            Ok(day) => day,\n            Err(_) => continue,\n        };\n        if day <= wall {\n            files.push((day, rows(&ent.path())?));\n        }\n    }\n    if files.is_empty() {\n        return Err(1);\n    }\n    files.sort_by_key(|item| item.0);\n    let total = files.iter().map(|item| item.1).sum();\n    Ok((total, files))\n}\n\npub fn gait(taken: i32, packed: &[(i32, String)], floor_ok: bool) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    let _ = fs::remove_file(\"/app/bloturn/check.json\");\n    let (matched, live) = match live_count() {\n        Ok(value) => value,\n        Err(_) => return 1,\n    };\n    if !floor_ok || matched != taken || packed.len() != live.len() {\n        return 1;\n    }\n    // Confirm every live input, including the newest one, was restored with\n    // the same row count under latest.\n    for (day, expected) in &live {\n        let path = format!(\"/app/packbay/latest/d{:08}.tbl\", day);\n        if rows(Path::new(&path)) != Ok(*expected) {\n            return 1;\n        }\n    }\n    if emit(\"/app/daywell\", matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nRS\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/wickmill/boot.rs')\ns=p.read_text()\ns=s.replace('let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");', 'let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\\n    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");')\ns=s.replace('''            let _ = floor::floor(taken);\n            gait::gait(taken, &packed)''', '''            let floor_ok = floor::floor(taken);\n            gait::gait(taken, &packed, floor_ok)''')\np.write_text(s)\n\np=Path('/app/shardfold/read.rs')\ns=p.read_text().replace('''        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let mid = &name[1..name.len() - 4];''', '''        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let mid = &name[1..9];''')\np.write_text(s)\n\np=Path('/app/urncue/fold.rs')\ns=p.read_text().replace('''        taken += read::nlines(&dest);''', '''        taken += read::nlines(&p);''')\np.write_text(s)\nPY\n/app/wick.sh\n/app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; echo '--- JSON/GUARD ---'; cat /app/bloturn/ledger.json; echo; cat /app/bloturn/check.json; echo; cat /app/bloturn/GUARD; echo; echo '--- latest ---'; for f in /app/packbay/latest/*; do printf '%s %s\\n' \"$(basename \"$f\")\" \"$(wc -l < \"$f\")\"; done\n"]
