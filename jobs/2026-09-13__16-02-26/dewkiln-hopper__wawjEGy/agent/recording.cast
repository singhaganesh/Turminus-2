[29.824084, "i", "echo '--- top-level ---'; find /app -maxdepth 2 -printf '%y %p\\n' | sort; echo '--- pipeline sources ---'; for d in wickmill hopcue millrib restpit urncue shardfold lidcue; do echo \"===== /app/$d =====\"; find \"/app/$d\" -maxdepth 3 -type f -print 2>/dev/null | sort | while read -r f; do echo \"### $f\"; sed -n '1,360p' \"$f\"; done; done\n"]
[29.825284, "o", "echo '--- top-level ---'; find /app -maxdepth 2 -printf '%y %p\\n' | sort; echo '--- pipeline sources ---'; for d in wickmill hopcue millrib restpit urncue shardfold lidcue; do echo \"===== /app/$d =====\"; find \"/app/$d\" -maxdepth 3 -type f -print 2>/dev/null | sort | while read -r f; do echo \"### $f\"; sed -n '1,360p' \"$f\"; done; done\r\n\u001b[?2004l\r"]
[29.825592, "o", "--- top-level ---\r\n"]
[29.831775, "o", "d /app\r\nd /app/bin\r\nd /app/bloturn\r\nd /app/corkpit\r\nd /app/daywell\r\nd /app/floorcue\r\nd /app/hopcue\r\nd /app/lidcue\r\nd /app/millrib\r\nd /app/opstext\r\nd /app/packbay\r\nd /app/packbay/latest\r\nd /app/packbay/stage\r\nd /app/restpit\r\nd /app/seed\r\nd /app/seed/daywell\r\nd /app/shardfold\r\nd /app/urncue\r\nd /app/wickmill\r\nf /app/bin/dewkiln\r\nf /app/bloturn/GUARD\r\n"]
[29.832039, "o", "f /app/bloturn/check.json\r\nf /app/bloturn/ledger.json\r\nf /app/corkpit/NOTE.txt\r\nf /app/corkpit/floor.rs\r\nf /app/daywell/d20260910.tbl\r\nf /app/daywell/d20260911.tbl\r\nf /app/daywell/d20260912.tbl\r\nf /app/daywell/d20260913.tbl\r\nf /app/floorcue/MIN.txt\r\nf /app/hopcue/rim.rs\r\nf /app/lidcue/skip.rs\r\nf /app/millrib/gait.rs\r\nf /app/millrib/sheet.tpl\r\nf /app/opstext/LIST.txt\r\nf /app/opstext/SHIFT.txt\r\nf /app/opstext/WALL\r\nf /app/restpit/soak.rs\r\nf /app/shardfold/read.rs\r\nf /app/urncue/fold.rs\r\nf /app/wick.sh\r\nf /app/wickmill/boot.rs\r\nf /app/wickmill/usage.txt\r\n"]
[29.832203, "o", "--- pipeline sources ---\r\n"]
[29.832333, "o", "===== /app/wickmill =====\r\n"]
[29.836844, "o", "### /app/wickmill/boot.rs\r\n"]
[29.839081, "o", "#[path = \"../urncue/fold.rs\"]\r\nmod fold;\r\n#[path = \"../millrib/gait.rs\"]\r\nmod gait;\r\n#[path = \"../lidcue/skip.rs\"]\r\nmod skip;\r\n#[path = \"../corkpit/floor.rs\"]\r\nmod floor;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"clasp\" {\r\n        eprintln!(\"usage: dewkiln clasp\");\r\n        std::process::exit(2);\r\n    }\r\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    let code = match fold::fold() {\r\n        Ok((packed, taken)) => {\r\n            let mut dump = packed.clone();\r\n            skip::skip(&mut dump);\r\n            let _ = floor::floor(taken);\r\n"]
[29.839218, "o", "            gait::gait(taken, &packed)\r\n        }\r\n        Err(c) => c,\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[29.839601, "o", "### /app/wickmill/usage.txt\r\n"]
[29.841938, "o", "dewkiln clasp\r\n"]
[29.842834, "o", "===== /app/hopcue =====\r\n"]
[29.844823, "o", "### /app/hopcue/rim.rs\r\n"]
[29.845926, "o", "pub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n    b.into_iter().filter(|(d, _)| *d < a).collect()\r\n}\r\n"]
[29.846338, "o", "===== /app/millrib =====\r\n"]
[29.848252, "o", "### /app/millrib/gait.rs\r\n"]
[29.849766, "o", "use std::fs;\r\n\r\nfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\r\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n    let out = tpl\r\n        .replace(\"__P__\", p)\r\n        .replace(\"__M__\", &m.to_string())\r\n        .replace(\"__T__\", &t.to_string());\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)?;\r\n    Ok(())\r\n}\r\n\r\npub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {\r\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n    if emit(\"ledger\", a, a).is_err() {\r\n        return 1;\r\n    }\r\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[29.850725, "o", "### /app/millrib/sheet.tpl\r\n"]
[29.852188, "o", "{\"probe\":\"__P__\",\"matched\":__M__,\"taken\":__T__}\r\n"]
[29.852773, "o", "===== /app/restpit =====\r\n"]
[29.854562, "o", "### /app/restpit/soak.rs\r\n"]
[29.855873, "o", "use std::fs;\r\n\r\npub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n    let _ = fs::remove_dir_all(b);\r\n    fs::create_dir_all(b).map_err(|_| 1)?;\r\n    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n    xs.sort_by_key(|x| x.0);\r\n    if !xs.is_empty() {\r\n        xs.pop();\r\n    }\r\n    for (d, p) in xs {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n"]
[29.856035, "o", "        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    }\r\n    Ok(())\r\n}\r\n"]
[29.856425, "o", "===== /app/urncue =====\r\n"]
[29.858391, "o", "### /app/urncue/fold.rs\r\n"]
[29.859791, "o", "#[path = \"../hopcue/rim.rs\"]\r\nmod rim;\r\n#[path = \"../restpit/soak.rs\"]\r\nmod soak;\r\n#[path = \"../shardfold/read.rs\"]\r\nmod read;\r\n\r\nuse std::fs;\r\n\r\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n        .map_err(|_| 1)?\r\n        .trim()\r\n        .parse()\r\n        .map_err(|_| 1)?;\r\n    let listed = read::list(\"/app/daywell\");\r\n    let picked = rim::rim(wall, listed);\r\n    if picked.is_empty() {\r\n"]
[29.859953, "o", "        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n        return Ok((Vec::new(), 0));\r\n    }\r\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    let mut packed = Vec::new();\r\n    let mut taken = 0;\r\n    for (d, p) in picked {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n        taken += read::nlines(&dest);\r\n        packed.push((d, dest));\r\n    }\r\n    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    Ok((packed, taken))\r\n}\r\n"]
[29.860437, "o", "===== /app/shardfold =====\r\n"]
[29.862324, "o", "### /app/shardfold/read.rs\r\n"]
[29.863577, "o", "use std::fs;\r\n\r\npub fn list(root: &str) -> Vec<(i32, String)> {\r\n    let mut v = Vec::new();\r\n    let rd = match fs::read_dir(root) {\r\n        Ok(x) => x,\r\n        Err(_) => return v,\r\n    };\r\n    for ent in rd.flatten() {\r\n        let name = ent.file_name().to_string_lossy().into_owned();\r\n        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n            continue;\r\n        }\r\n        let mid = &name[1..name.len() - 4];\r\n        if let Ok(d) = mid.parse::<i32>() {\r\n            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n        }\r\n    }\r\n    v.sort_by_key(|x| x.0);\r\n    v\r\n"]
[29.863722, "o", "}\r\n\r\npub fn nlines(path: &str) -> i32 {\r\n    match fs::read_to_string(path) {\r\n        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n        Err(_) => 0,\r\n    }\r\n}\r\n"]
[29.864115, "o", "===== /app/lidcue =====\r\n"]
[29.866028, "o", "### /app/lidcue/skip.rs\r\n"]
[29.867312, "o", "pub fn skip(a: &mut [(i32, String)]) {\r\n    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n}\r\n\r\npub fn width(a: &[(i32, String)]) -> usize {\r\n    a.len()\r\n}\r\n\r\npub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    a.first().map(|x| x.0)\r\n}\r\n"]
[29.867845, "o", "\u001b[?2004hroot@39362b762127:/app# "]
[31.828358, "i", "echo '--- ELF and linkage ---'; file /app/bin/dewkiln; ldd /app/bin/dewkiln 2>&1 || true; echo '--- fixture files/counts ---'; find /app/seed -maxdepth 3 -type f -print -exec sh -c 'printf \"lines=\"; wc -l < \"$1\"' _ {} \\; 2>/dev/null | head -100\n"]
[31.829138, "o", "echo '--- ELF and linkage ---'; file /app/bin/dewkiln; ldd /app/bin/dewkiln 2>&1 || true; echo '--- fixture files/counts ---'; find /app/seed -maxdepth 3 -type f -print -exec sh -c 'printf \"lines=\"; wc -l < \"$1\"' _ {} \\; 2>/dev/null | head -100\r\n\u001b[?2004l\r"]
