[94.80765, "i", "set -u\nprintf '999\\n1000\\n' > /app/daywell/d20260914.tbl\n/app/bin/dewkiln clasp; rc=$?\necho \"future-test RC=$rc absent=$([ ! -e /app/packbay/latest/d20260914.tbl ] && echo yes || echo no)\"\nrm -f /app/daywell/d20260914.tbl\nmkdir -p /tmp/daywell-save\nmv /app/daywell/d*.tbl /tmp/daywell-save/\n/app/bin/dewkiln clasp; rc=$?\necho \"empty-test RC=$rc guard_absent=$([ ! -e /app/bloturn/GUARD ] && echo yes || echo no) check_absent=$([ ! -e /app/bloturn/check.json ] && echo yes || echo no)\"\nmv /tmp/daywell-save/d*.tbl /app/daywell/\nrmdir /tmp/daywell-save\noldmin=$(cat /app/floorcue/MIN.txt)\nprintf '999\\n' > /app/floorcue/MIN.txt\n/app/bin/dewkiln clasp; rc=$?\necho \"floor-test RC=$rc guard_absent=$([ ! -e /app/bloturn/GUARD ] && echo yes || echo no)\"\nprintf '%s\\n' \"$oldmin\" > /app/floorcue/MIN.txt\n/app/bin/dewkiln clasp; rc=$?\necho \"final RC=$rc\"\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\nledger=json.loads(Path('/app/bloturn/ledger.json').read_text())\ncheck=json.loads(Path('/app/bloturn/check.json').read_text())\ninputs={p.name:sum(bool(x.strip()) for x in p.read_text().splitlines()) for p in Path('/app/daywell').glob('d*.tbl') if int(p.name[1:9]) <= int(Path('/app/opstext/WALL').read_text())}\nlatest={p.name:sum(bool(x.strip()) for x in p.read_text().splitlines()) for p in Path('/app/packbay/latest').glob('d*.tbl')}\nprint('ledger=',ledger)\nprint('check=',check)\nprint('inputs=',inputs)\nprint('latest=',latest)\nprint('guard=',Path('/app/bloturn/GUARD').read_text())\nassert set(check)=={'probe','matched','taken'}\nassert isinstance(check['probe'],str) and check['probe']=='/app/daywell'\nassert type(check['matched']) is int and type(check['taken']) is int\nassert check['matched']==check['taken']==sum(inputs.values())==ledger['taken']\nassert latest==inputs\nassert Path('/app/bin/dewkiln').read_bytes()[:4]==b'\\x7fELF'\nPY\n"]
