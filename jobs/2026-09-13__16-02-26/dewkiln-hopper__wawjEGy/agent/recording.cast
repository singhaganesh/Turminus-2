[69.670477, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.670537, "o", "> "]
[69.670593, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.670682, "o", "p=Path('/app/wickmill/boot.rs')\r\n\u001b[?2004l\r"]
