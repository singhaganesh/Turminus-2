Sending keys: ['cat > /app/ustarwalk/hdr.rs <<\'RS\'\n/// A regular ustar member, with offsets into the archive.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let mut n = 0u64;\n    let mut digit = false;\n    let mut ended = false;\n    for &b in buf {\n        match b {\n            b\'0\'..=b\'7\' if !ended => {\n                digit = true;\n                n = n.checked_mul(8).and_then(|x| x.checked_add((b-b\'0\') as u64)).ok_or(1)?;\n            }\n            0 | b\' \' => { if digit { ended = true; } }\n            _ => return Err(1),\n        }\n    }\n    if digit { Ok(n) } else { Err(1) }\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut zeros = 0usize;\n    let mut saw = false;\n    while off < raw.len() {\n        let blk = &raw[off..off+512];\n        if blk.iter().all(|&b| b == 0) {\n            zeros += 1;\n            off += 512;\n            if zeros >= 2 {\n                if raw[off..].iter().any(|&b| b != 0) { return Err(1); }\n                break;\n            }\n            continue;\n        }\n        if zeros != 0 || &blk[257..262] != b"ustar" { return Err(1); }\n        saw = true;\n        let nlen = blk[..100].iter().position(|&b| b == 0).unwrap_or(100);\n        if nlen == 0 { return Err(1); }\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = (off as u64).checked_add(512).and_then(|x| x.checked_add(padded)).ok_or(1)?;\n        if next > raw.len() as u64 { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: (off+512) as u64, flag: blk[156] });\n        off = next as usize;\n    }\n    if !saw || zeros < 2 { return Err(1); }\n    Ok(rows)\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let n = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<\'RS\'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b\'0\' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b"SILT1");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    if let Some(parent) = std::path::Path::new(b).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    if std::fs::write(b, out).is_err() { 1 } else { 0 }\n}\nRS\ncat > /app/overlaypit/blend.rs <<\'RS\'\npub struct Pack { pub t:String, pub c:String, pub e:Vec<String>, pub n:u32, pub s:String, pub w:String }\nstruct Rec { name:String, hdr:u64, size:u64, body:u64 }\n\nfn read_idx(path:&str) -> Result<Vec<Rec>,i32> {\n    let raw=std::fs::read(path).map_err(|_|1)?;\n    if raw.len()<9 || &raw[..5]!=b"SILT1" { return Err(1); }\n    let n=u32::from_le_bytes(raw[5..9].try_into().unwrap()) as usize;\n    let mut i=9usize; let mut out=Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).filter(|&x|x<=raw.len()).is_none(){return Err(1)}\n        let hdr=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let size=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let body=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let nl=u16::from_le_bytes(raw[i..i+2].try_into().unwrap()) as usize; i+=2;\n        if i.checked_add(nl).filter(|&x|x<=raw.len()).is_none(){return Err(1)}\n        let name=std::str::from_utf8(&raw[i..i+nl]).map_err(|_|1)?.to_string(); i+=nl;\n        out.push(Rec{name,hdr,size,body});\n    }\n    if i!=raw.len(){return Err(1)}\n    Ok(out)\n}\n\nfn digest(text:&str)->Result<String,i32>{\n    use std::io::Write;\n    let mut child=std::process::Command::new("python3")\n        .args(["-c","import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped()).spawn().map_err(|_|1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_|1)?;\n    drop(child.stdin.take());\n    let out=child.wait_with_output().map_err(|_|1)?;\n    if !out.status.success(){return Err(1)}\n    let s=std::str::from_utf8(&out.stdout).map_err(|_|1)?.trim().to_string();\n    if s.len()!=64 || !s.bytes().all(|b|b.is_ascii_digit()||(b\'a\'..=b\'f\').contains(&b)){return Err(1)}\n    Ok(s)\n}\n\n#[path="../ustarwalk/hdr.rs"] mod archive;\n#[path="../cfgbag/kv.rs"] mod kv;\n#[path="../cfgbag/alias.rs"] mod alias;\n\npub fn rib_b(a:&str,b:&str)->Result<Pack,i32>{\n    let all=archive::scan(a)?;\n    let actual:Vec<&archive::Row>=all.iter().filter(|r|r.flag==b\'0\'||r.flag==0).collect();\n    let recs=read_idx(b)?;\n    if recs.len()!=actual.len(){return Err(1)}\n    for (x,r) in recs.iter().zip(actual.iter()) {\n        if x.name!=r.name || x.hdr!=r.hdr || x.size!=r.size || x.body!=r.body {return Err(1)}\n    }\n    let mut t=String::new(); let mut c=String::new();\n    let mut events=std::collections::BTreeSet::new();\n    let mut names=Vec::new();\n    for r in actual.iter() {\n        names.push(r.name.clone());\n        let folded=alias::fold(&r.name);\n        let blob=archive::load_body(a,r)?;\n        if folded=="etc/sys.conf" {\n            let map=kv::pairs(&blob);\n            if let Some(v)=map.get("timezone"){t=v.clone()}\n            if let Some(v)=map.get("cluster"){c=v.clone()}\n        }\n        if folded.rsplit(\'/\').next()==Some("app.log") {\n            for line in String::from_utf8_lossy(&blob).lines(){let x=line.trim();if !x.is_empty(){events.insert(x.to_string());}}\n        }\n    }\n    let source=std::path::Path::new(a).file_name().and_then(|x|x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack{t,c,e:events.into_iter().collect(),n:actual.len() as u32,s:source,w:digest(&names.join("\\n"))?})\n}\nRS\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['cat > /app/logbag/write.rs <<\'RS\'\nuse super::blend::Pack;\nfn json_escape(s:&str)->String{\n    let mut o=String::new();\n    for c in s.chars(){match c{\'"\'=>o.push_str("\\\\\\""),\'\\\\\'=>o.push_str("\\\\\\\\"),\'\\n\'=>o.push_str("\\\\n"),\'\\r\'=>o.push_str("\\\\r"),\'\\t\'=>o.push_str("\\\\t"),c if c<\' \'=>o.push_str(&format!("\\\\u{:04x}",c as u32)),c=>o.push(c)}} o\n}\npub fn rib_c(p:&Pack,out:&str,_a:&str)->i32{\n    if let Some(parent)=std::path::Path::new(out).parent(){if std::fs::create_dir_all(parent).is_err(){return 1}}\n    let ev=p.e.iter().map(|x|format!("\\"{}\\"",json_escape(x))).collect::<Vec<_>>().join(",");\n    let body=format!("{{\\"timezone\\":\\"{}\\",\\"cluster\\":\\"{}\\",\\"log_events\\":[{}],\\"member_count\\":{},\\"source_kith\\":\\"{}\\",\\"walk_sig\\":\\"{}\\"}}\\n",json_escape(&p.t),json_escape(&p.c),ev,p.n,json_escape(&p.s),json_escape(&p.w));\n    if std::fs::write(out,body).is_err(){return 1}\n    if std::fs::write("/app/deskjson/READY","brief-ok\\n").is_err(){return 1}\n    0\n}\nRS\ncat > /app/siltcli/slate.rs <<\'RS\'\n#[path = "../overlaypit/blend.rs"] mod blend;\n#[path = "../logbag/write.rs"] mod uni;\nfn sealed(path:&str)->bool{\n    let p=match std::fs::canonicalize(path){Ok(x)=>x,Err(_)=>return false};\n    let root=match std::fs::canonicalize("/app/sealwell"){Ok(x)=>x,Err(_)=>return false};\n    p.parent()==Some(root.as_path())\n}\npub fn go(out:&str,a:&str,b:&str)->i32{\n    let _=std::fs::remove_file("/app/deskjson/READY");\n    if !sealed(a){return 1}\n    match blend::rib_b(a,b){Ok(p)=>uni::rib_c(&p,out,a),Err(c)=>c}\n}\nRS\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/siltcord\n'] min_timeout_sec: 8.0 max_timeout_sec: 180.0
