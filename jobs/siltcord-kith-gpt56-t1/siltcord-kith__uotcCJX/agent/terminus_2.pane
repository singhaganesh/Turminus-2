     1	/// ustar headers are 512 bytes; payload is padded to that size.
     2	pub struct Row {
     3	    pub name: String,
     4	    pub hdr: u64,
     5	    pub size: u64,
     6	    pub body: u64,
     7	    pub flag: u8,
