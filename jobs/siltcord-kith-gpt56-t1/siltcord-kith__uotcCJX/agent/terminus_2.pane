     1	pub struct Pack {
     2	    pub t: String,
     3	    pub c: String,
     4	    pub e: Vec<String>,
     5	    pub n: u32,
     6	    pub s: String,
     7	    pub w: String,
     8	}
     9	
    10	struct Rec {
    11	    name: String,
    12	    hdr: u64,
    13	    size: u64,
    14	    body: u64,
    15	}
    16	
    17	fn read_idx(path: &str) -> Result<Vec<Rec>, i32> {
    18	    let raw = std::fs::read(path).map_err(|_| 1)?;
    19	    if raw.len() < 9 || &raw[0..5] != b"SILT1" {
    20	        return Err(1);
    21	    }
    22	    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());
    23	    let mut i = 9usize;
    24	    let mut out = Vec::new();
    25	    for _ in 0..n {
    26	        if i + 26 > raw.len() {
    27	            return Err(1);
    28	        }
    29	        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());
    30	        i += 8;
    31	        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());
    32	        i += 8;
    33	        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());
    34	        i += 8;
    35	        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;
    36	        i += 2;
    37	        if i + nl > raw.len() {
    38	            return Err(1);
    39	        }
    40	        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();
    41	        i += nl;
    42	        out.push(Rec {
    43	            name,
    44	            hdr,
    45	            size,
    46	            body,
    47	        });
    48	    }
    49	    Ok(out)
    50	}
    51	
    52	fn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {
    53	    let raw = std::fs::read(path).map_err(|_| 1)?;
    54	    let s = body as usize;
    55	    let e = s + size as usize;
    56	    if e > raw.len() {
    57	        return Err(1);
    58	    }
    59	    Ok(raw[s..e].to_vec())
    60	}
    61	
    62	fn digest(text: &str) -> String {
    63	    let mut cmd = std::process::Command::new("python3");
    64	    cmd.args([
    65	        "-c",
    66	        "import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())",
    67	    ])
    68	    .stdin(std::process::Stdio::piped())
    69	    .stdout(std::process::Stdio::piped());
    70	    let mut child = match cmd.spawn() {
    71	        Ok(c) => c,
    72	        Err(_) => return String::new(),
    73	    };
    74	    {
    75	        use std::io::Write;
    76	        if let Some(ref mut sin) = child.stdin {
    77	            let _ = sin.write_all(text.as_bytes());
    78	        }
    79	    }
    80	    drop(child.stdin.take());
    81	    match child.wait_with_output() {
    82	        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),
    83	        Err(_) => String::new(),
    84	    }
    85	}
    86	
    87	#[path = "../keeppit/first.rs"]
    88	mod first;
    89	#[path = "../cfgbag/kv.rs"]
    90	mod kv;
    91	#[path = "../cfgbag/alias.rs"]
    92	mod alias;
    93	
    94	pub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {
    95	    let recs = read_idx(b)?;
    96	    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();
    97	    let mut logs: Vec<Vec<u8>> = Vec::new();
    98	    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();
    99	    for (i, r) in recs.iter().enumerate() {
   100	        bag.insert(i, r.name.clone());
   101	        let blob = load(a, r.body, r.size)?;
   102	        if r.name.contains("sys.conf") {
   103	            confs.push((r.name.clone(), r.hdr, blob));
   104	        } else if r.name.contains("app.log") {
   105	            logs.push(blob);
   106	        }
   107	    }
   108	    confs.sort_by_key(|row| row.1);
   109	    let picked = first::keep_head(&confs);
   110	    let mut t = String::new();
   111	    let mut c = String::new();
   112	    if let Some(blob) = picked {
   113	        let map = kv::pairs(&blob);
   114	        if let Some(v) = map.get("timezone") {
   115	            t = v.clone();
   116	        }
   117	        if let Some(v) = map.get("cluster") {
   118	            c = v.clone();
   119	        }
   120	    }
   121	    let mut e = Vec::new();
   122	    if let Some(blob) = logs.first() {
   123	        for line in String::from_utf8_lossy(blob).lines() {
   124	            let s = line.trim();
   125	            if !s.is_empty() {
   126	                e.push(s.to_string());
   127	            }
   128	        }
   129	    }
   130	    e.sort();
   131	    e.dedup();
   132	    let names: Vec<String> = bag.values().cloned().collect();
   133	    let walk = names.join("\n");
   134	    let _ = alias::fold("");
   135	    Ok(Pack {
   136	        t,
   137	        c,
   138	        e,
   139	        n: confs.len() as u32,
   140	        s: a.to_string(),
   141	        w: digest(&walk).to_ascii_uppercase(),
   142	    })
   143	}
===== /app/logbag/write.rs =====
     1	use super::blend::Pack;
     2	
     3	fn json_escape(s: &str) -> String {
     4	    s.replace('\\', "\\\\").replace('"', "\\\"")
     5	}
     6	
     7	pub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {
     8	    if let Some(parent) = std::path::Path::new(out).parent() {
     9	        let _ = std::fs::create_dir_all(parent);
    10	    }
    11	    let ev: Vec<String> = p
    12	        .e
    13	        .iter()
    14	        .map(|x| format!("\"{}\"", json_escape(x)))
    15	        .collect();
    16	    let body = format!(
    17	        "{{\"timezone\":\"{}\",\"cluster\":\"{}\",\"log_events\":[{}],\"member_count\":{},\"source_kith\":\"{}\",\"walk_sig\":\"{}\"}}\n",
    18	        json_escape(&p.t),
    19	        json_escape(&p.c),
    20	        ev.join(","),
    21	        p.n,
    22	        json_escape(&p.s),
    23	        json_escape(&p.w)
    24	    );
    25	    if std::fs::write(out, body).is_err() {
    26	        return 1;
    27	    }
    28	    if std::fs::write("/app/deskjson/READY", "ok\n").is_err() {
    29	        return 1;
    30	    }
    31	    0
    32	}
