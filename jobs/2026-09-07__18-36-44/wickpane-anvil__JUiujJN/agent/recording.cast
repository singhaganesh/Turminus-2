[55.407361, "i", "cd /app && cat > vatmill/bin.go <<'EOF'\npackage main\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"loft.local/wickpane/pantryc\"\n\t\"loft.local/wickpane/spoolkit\"\n)\n\nfunc stageFile(path string, data []byte) (string, error) {\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn \"\", err\n\t}\n\tf, err := os.CreateTemp(filepath.Dir(path), \".\"+filepath.Base(path)+\".*\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\ttmp := f.Name()\n\tok := false\n\tdefer func() {\n\t\tif !ok {\n\t\t\tf.Close()\n\t\t\tos.Remove(tmp)\n\t\t}\n\t}()\n\tif err = f.Chmod(0o644); err == nil {\n\t\t_, err = f.Write(data)\n\t}\n\tif err == nil {\n\t\terr = f.Sync()\n\t}\n\tif closeErr := f.Close(); err == nil {\n\t\terr = closeErr\n\t}\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tok = true\n\treturn tmp, nil\n}\n\nfunc runBin() int {\n\tconst dir = \"/app/shardops/live\"\n\tconst outPath = \"/app/shardops/bins.json\"\n\tconst pairPath = \"/app/loomwell/pair.sha\"\n\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tout := make(map[string]string)\n\tfor _, e := range entries {\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\n\t\t\tcontinue\n\t\t}\n\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\n\t\tif err != nil {\n\t\t\treturn 1\n\t\t}\n\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\n\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\n\t}\n\n\tpaneN, okN := out[\"n7\"]\n\tpaneS, okS := out[\"s7\"]\n\tif !okN || !okS || paneN != paneS {\n\t\treturn 1\n\t}\n\tblob, err := json.MarshalIndent(out, \"\", \"  \")\n\tif err != nil {\n\t\treturn 1\n\t}\n\tblob = append(blob, '\\n')\n\tsum := sha256.Sum256([]byte(paneN))\n\tpair := []byte(hex.EncodeToString(sum[:]) + \"\\n\")\n\n\toutTmp, err := stageFile(outPath, blob)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tdefer os.Remove(outTmp)\n\tpairTmp, err := stageFile(pairPath, pair)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tdefer os.Remove(pairTmp)\n\tif err := os.Rename(outTmp, outPath); err != nil {\n\t\treturn 1\n\t}\n\tif err := os.Rename(pairTmp, pairPath); err != nil {\n\t\treturn 1\n\t}\n\treturn 0\n}\nEOF\n/usr/local/go/bin/gofmt -w millhint/trim.go spoolkit/clip.go wicksrc/nest.go pantryc/drop.go vatmill/bin.go\n/usr/local/go/bin/go test ./...\n"]
