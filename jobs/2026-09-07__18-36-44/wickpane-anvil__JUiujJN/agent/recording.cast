[27.294045, "o", "     9\tfunc Join(rows []celltyp.Row) string {\r\n    10\t\tparts := make([]string, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tparts = append(parts, r.Mod+\"!\"+r.Fn)\r\n    13\t\t}\r\n    14\t\treturn strings.Join(parts, \"|\")\r\n    15\t}\r\n"]
[27.295264, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n     6\t)\r\n     7\t\r\n     8\tfunc main() {\r\n     9\t\tif len(os.Args) < 2 {\r\n    10\t\t\tfmt.Fprintln(os.Stderr, \"usage: wickpane etch|bin\")\r\n    11\t\t\tos.Exit(2)\r\n"]
