[55.206468, "i", "cd /app && cat > millhint/trim.go <<'EOF'\npackage millhint\n\nimport \"strings\"\n\n// Trim removes the optional +tail from a module token.\nfunc Trim(tok string) string {\n\ttok = strings.TrimSpace(tok)\n\tif i := strings.IndexByte(tok, '+'); i >= 0 {\n\t\treturn tok[:i]\n\t}\n\treturn tok\n}\nEOF\ncat > spoolkit/clip.go <<'EOF'\npackage spoolkit\n\nimport (\n\t\"strings\"\n\n\t\"loft.local/wickpane/celltyp\"\n\t\"loft.local/wickpane/millhint\"\n)\n\n// Clip normalizes fields used by the pane renderer.\nfunc Clip(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tout = append(out, celltyp.Row{\n\t\t\tKind: strings.TrimSpace(r.Kind),\n\t\t\tMod:  millhint.Trim(r.Mod),\n\t\t\tFn:   strings.TrimSpace(r.Fn),\n\t\t})\n\t}\n\treturn out\n}\nEOF\ncat > wicksrc/nest.go <<'EOF'\npackage wicksrc\n\nimport \"loft.local/wickpane/celltyp\"\n\n// Nest removes fold records. A fold belongs to the following named frame and\n// therefore never contributes a pane chunk of its own.\nfunc Nest(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tif r.Kind == \"i\" {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\nEOF\ncat > pantryc/drop.go <<'EOF'\npackage pantryc\n\nimport (\n\t\"loft.local/wickpane/celltyp\"\n\t\"loft.local/wickpane/millhint\"\n)\n\n// Drop removes kernel helper frames which are not part of a pane.\nfunc Drop(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tr.Mod = millhint.Trim(r.Mod)\n\t\tif r.Mod == \"[vdso]\" || r.Mod == \"[vsyscall]\" {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\nEOF\n"]
[55.206926, "o", "cd /app && cat > millhint/trim.go <<'EOF'\r\n\u001b[?2004l\r"]
