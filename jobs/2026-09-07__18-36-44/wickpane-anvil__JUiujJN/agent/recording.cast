[27.297863, "o", "     6\t\ti := strings.LastIndex(tok, \"+\")\r\n     7\t\tif i < 0 {\r\n     8\t\t\treturn tok\r\n     9\t\t}\r\n    10\t\thead, tail := tok[:i+1], tok[i+1:]\r\n    11\t\tif len(tail) == 0 {\r\n    12\t\t\treturn tok\r\n    13\t\t}\r\n    14\t\tb := []byte(tail)\r\n    15\t\tb[len(b)-1] = '0'\r\n    16\t\treturn head + string(b)\r\n    17\t}\r\n"]
