[10.741533, "i", "printf '\\n--- GO FILES ---\\n'; find /app -type f \\( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \\) -print | sort; printf '\\n--- TAKES ---\\n'; for f in /app/shardops/live/*.stk; do echo \"### $f\"; cat \"$f\"; done; printf '\\n--- CURRENT OUTPUTS ---\\n'; cat /app/shardops/bins.json 2>/dev/null || true; echo; cat /app/loomwell/pair.sha 2>/dev/null || true; echo\n"]
