[17.907567, "i", "cd /app && for f in go.mod Makefile celltyp/row.go millhint/trim.go spoolkit/clip.go spoolkit/scan.go wicksrc/nest.go pantryc/drop.go pantryc/join.go vatmill/main.go vatmill/etch.go vatmill/bin.go vatmill/stage.go vatmill/stage2.go; do printf '\\n===== %s =====\\n' \"$f\"; nl -ba \"$f\"; done\n"]
[17.9089, "o", "cd /app && for f in go.mod Makefile celltyp/row.go millhint/trim.go spoolkit/clip.go spoolkit/scan.go wicksrc/nest.go pantryc/drop.go pantryc/join.go vatmill/main.go vatmill/etch.go vatmill/bin.go vatmill/stage.go vatmill/stage2.go; do printf '\\n===== %s =====\\n' \"$f\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[17.909196, "o", "\r\n===== go.mod =====\r\n"]
[17.911312, "o", "     1\tmodule loft.local/wickpane\r\n     2\t\r\n     3\tgo 1.22\r\n"]
[17.9115, "o", "\r\n===== Makefile =====\r\n"]
[17.912642, "o", "     1\t.PHONY: ship\r\n     2\t\r\n     3\tship:\r\n     4\t\tmkdir -p /app/bin\r\n     5\t\t# GOPROXY=off matches the image; go never fetches.\r\n     6\t\tGOPROXY=off /usr/local/go/bin/go build -o /app/bin/wickpane loft.local/wickpane/vatmill\r\n     7\t\t/app/bin/wickpane etch\r\n     8\t\tif [ -f /app/shardops/live/poison.stk ]; then mv /app/shardops/live/poison.stk /tmp/wick-ship-poison.stk; fi\r\n     9\t\t/app/bin/wickpane bin\r\n    10\t\tif [ -f /tmp/wick-ship-poison.stk ]; then mv /tmp/wick-ship-poison.stk /app/shardops/live/poison.stk; fi\r\n"]
[17.912922, "o", "\r\n===== celltyp/row.go =====\r\n"]
[17.913784, "o", "     1\tpackage celltyp\r\n     2\t\r\n     3\ttype Row struct {\r\n     4\t\tKind string\r\n     5\t\tMod  string\r\n     6\t\tFn   string\r\n     7\t}\r\n"]
[17.913926, "o", "\r\n===== millhint/trim.go =====\r\n"]
[17.914734, "o", "     1\tpackage millhint\r\n     2\t\r\n     3\timport \"strings\"\r\n     4\t\r\n     5\tfunc Trim(tok string) string {\r\n     6\t\ti := strings.LastIndex(tok, \"+\")\r\n"]
[17.914835, "o", "     7\t\tif i < 0 {\r\n     8\t\t\treturn tok\r\n     9\t\t}\r\n    10\t\thead, tail := tok[:i+1], tok[i+1:]\r\n    11\t\tif len(tail) == 0 {\r\n    12\t\t\treturn tok\r\n    13\t\t}\r\n    14\t\tb := []byte(tail)\r\n    15\t\tb[len(b)-1] = '0'\r\n    16\t\treturn head + string(b)\r\n    17\t}\r\n"]
[17.91496, "o", "\r\n===== spoolkit/clip.go =====\r\n"]
[17.915829, "o", "     1\tpackage spoolkit\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"strings\"\r\n     5\t\r\n     6\t\t\"loft.local/wickpane/celltyp\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc Clip(rows []celltyp.Row) []celltyp.Row {\r\n    10\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tmod := strings.TrimSpace(r.Mod)\r\n"]
[17.915981, "o", "    13\t\t\tif i := strings.LastIndex(mod, \"+\"); i >= 0 {\r\n    14\t\t\t\tmod = mod[i:]\r\n    15\t\t\t}\r\n    16\t\t\tout = append(out, celltyp.Row{Kind: r.Kind, Mod: mod, Fn: r.Fn})\r\n    17\t\t}\r\n    18\t\treturn out\r\n    19\t}\r\n"]
[17.916088, "o", "\r\n===== spoolkit/scan.go =====\r\n"]
[17.917084, "o", "     1\tpackage spoolkit\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"errors\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strings\"\r\n     8\t\r\n     9\t\t\"loft.local/wickpane/celltyp\"\r\n    10\t)\r\n"]
[17.917129, "o", "    11\t\r\n    12\tvar ErrReject = errors.New(\"reject\")\r\n    13\t\r\n    14\tfunc Scan(path string) ([]celltyp.Row, error) {\r\n    15\t\tf, err := os.Open(path)\r\n    16\t\tif err != nil {\r\n    17\t\t\treturn nil, err\r\n    18\t\t}\r\n    19\t\tdefer f.Close()\r\n    20\t\tvar rows []celltyp.Row\r\n    21\t\tsc := bufio.NewScanner(f)\r\n    22\t\tfor sc.Scan() {\r\n    23\t\t\tline := strings.TrimSpace(sc.Text())\r\n    24\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    25\t\t\t\tcontinue\r\n"]
[17.917155, "o", "    26\t\t\t}\r\n    27\t\t\tparts := strings.Fields(line)\r\n    28\t\t\tif len(parts) == 0 {\r\n    29\t\t\t\tcontinue\r\n    30\t\t\t}\r\n"]
[17.91717, "o", "    31\t\t\tif parts[0] == \"BAD\" {\r\n    32\t\t\t\treturn nil, ErrReject\r\n    33\t\t\t}\r\n    34\t\t\tif len(parts) < 4 {\r\n    35\t\t\t\tcontinue\r\n    36\t\t"]
[17.917186, "o", "\t}\r\n    37\t\t\trows = append(rows, celltyp.Row{Kind: parts[0], Mod: parts[2], Fn: parts[3]})\r\n    38\t"]
[17.917213, "o", "\t}\r\n    39\t\treturn rows, sc.Err()\r\n    40\t}\r\n"]
[17.917412, "o", "\r\n===== wicksrc/nest.go =====\r\n"]
[17.91841, "o", "     1\tpackage wicksrc\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"strings\"\r\n     5\t\r\n     6\t\t\"loft.local/wickpane/celltyp\"\r\n     7\t)\r\n     8\t\r\n"]
[17.918513, "o", "     9\tfunc Nest(rows []celltyp.Row) []celltyp.Row {\r\n    10\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tif r.Kind == \"i\" && strings.TrimSpace(r.Fn) == \"\" {\r\n    13\t\t\t\tcontinue\r\n    14\t\t\t}\r\n    15\t\t\tout = append(out, r)\r\n    16\t\t}\r\n    17\t\treturn out\r\n    18\t}\r\n"]
[17.918658, "o", "\r\n===== pantryc/drop.go =====\r\n"]
[17.919536, "o", "     1\tpackage pantryc\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"strings\"\r\n     5\t\r\n     6\t\t\"loft.local/wickpane/celltyp\"\r\n     7\t)\r\n     8\t\r\n"]
[17.919641, "o", "     9\tfunc Drop(rows []celltyp.Row) []celltyp.Row {\r\n    10\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tmod := strings.TrimSpace(r.Mod)\r\n    13\t\t\tif i := strings.Index(mod, \"+\"); i >= 0 {\r\n    14\t\t\t\tmod = mod[:i]\r\n    15\t\t\t}\r\n    16\t\t\tif mod == \"[vdso]\" {\r\n    17\t\t\t\tcontinue\r\n    18\t\t\t}\r\n    19\t\t\tout = append(out, r)\r\n    20\t\t}\r\n    21\t\treturn out\r\n    22\t}\r\n"]
[17.91984, "o", "\r\n===== pantryc/join.go =====\r\n"]
[17.920672, "o", "     1\tpackage pantryc\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"strings\"\r\n     5\t\r\n     6\t\t\"loft.local/wickpane/celltyp\"\r\n     7\t)\r\n     8\t\r\n"]
[17.920736, "o", "     9\tfunc Join(rows []celltyp.Row) string {\r\n    10\t\tparts := make([]string, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tparts = append(parts, r.Mod+\"!\"+r.Fn)\r\n    13\t\t}\r\n    14\t\treturn strings.Join(parts, \"|\")\r\n    15\t}\r\n"]
[17.920931, "o", "\r\n===== vatmill/main.go =====\r\n"]
[17.921739, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n     6\t)"]
[17.921864, "o", "\r\n     7\t\r\n     8\tfunc main() {\r\n     9\t\tif len(os.Args) < 2 {\r\n    10\t\t\tfmt.Fprintln(os.Stderr, \"usage: wickpane etch|bin\")\r\n    11\t\t\tos.Exit(2)\r\n    12\t\t}\r\n    13\t\tvar rc int\r\n    14\t\tswitch os.Args[1] {\r\n    15\t\tcase \"etch\":\r\n    16\t\t\trc = runEtch()\r\n    17\t\tcase \"bin\":\r\n    18\t\t\trc = runBin()\r\n    19\t\tdefault:\r\n    20\t\t\trc = 2\r\n    21\t\t}\r\n    22\t\tos.Exit(rc)\r\n    23\t}\r\n"]
[17.92202, "o", "\r\n===== vatmill/etch.go =====\r\n"]
[17.922747, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t\t\"strings\"\r\n     8\t\r\n"]
[17.922814, "o", "     9\t\t\"loft.local/wickpane/pantryc\"\r\n    10\t\t\"loft.local/wickpane/spoolkit\"\r\n    11\t)\r\n    12\t\r\n    13\tfunc runEtch() int {\r\n    14\t\tdir := \"/app/crumbay\"\r\n    15\t\toutPath := \"/app/loomwell/etch.json\"\r\n    16\t\tentries, err := os.ReadDir(dir)\r\n    17\t\tif err != nil {\r\n    18\t\t\treturn 1\r\n    19\t\t}\r\n    20\t\tout := map[string]string{}\r\n    21\t\tfor _, e := range entries {\r\n    22\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\r\n    23\t\t\t\tcontinue\r\n    24\t\t\t}\r\n    25\t\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\r\n    26\t\t\tif err != nil {\r\n    27\t\t\t\treturn 1\r\n    28\t\t\t}\r\n    29\t\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\r\n    30\t\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\r\n    31\t\t}\r\n    32\t\tblob, err := json.MarshalIndent(out, \"\", \"  \")\r\n    33\t\tif err != nil {\r\n    34\t\t\treturn 1\r\n    35\t\t}\r\n    36\t\tif err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {\r\n    37\t\t\treturn 1\r\n    38\t\t}\r\n"]
[17.922869, "o", "    39\t\tif err := os.WriteFile(outPath, append(blob, '\\n'), 0o644); err != nil {\r\n    40\t\t\treturn 1\r\n    41\t\t}\r\n    42\t\treturn 0\r\n    43\t}\r\n"]
[17.923036, "o", "\r\n===== vatmill/bin.go =====\r\n"]
[17.923826, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5\t\t\"encoding/hex\"\r\n     6\t\t\"encoding/json\"\r\n"]
[17.923911, "o", "     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t\r\n    12\t\t\"loft.local/wickpane/pantryc\"\r\n    13\t\t\"loft.local/wickpane/spoolkit\"\r\n    14\t)\r\n    15\t\r\n    16\tfunc tickCnt() string {\r\n    17\t\tp := \"/app/shardops/runs.cnt\"\r\n    18\t\t"]
[17.923994, "o", "n := 0\r\n    19\t\tif b, err := os.ReadFile(p); err == nil {\r\n    20\t\t\tn, _ = strconv.Atoi(strings.TrimSpace(string(b)))\r\n    21\t\t}\r\n    22\t\tn++\r\n    23\t\t_ = os.WriteFile(p, []byte(strconv.Itoa(n)+\"\\n\"), 0o644)\r\n    24\t\treturn strconv.Itoa(n)\r\n    25\t}\r\n    26\t\r\n    27\tfunc sealHex() {\r\n    28\t\ta, _ := os.ReadFile(\"/app/shardops/live/n7.stk\")\r\n    29\t\tb, _ := os.ReadFile(\"/app/shardops/live/s7.stk\")\r\n    30\t\tsum := sha256.Sum256(append(a, b...))\r\n    31\t\t_ = os.WriteFile(\"/app/loomwell/pair.sha\", []byte(hex.EncodeToString(sum[:])+\"\\n\"), 0o644)\r\n    32\t}\r\n    33\t\r\n    34\tfunc runBin() int {\r\n    35\t\tdir := \"/app/shardops/live\"\r\n    36\t\toutPath := \"/app/shardops/bins.json\"\r\n    37\t\tentries, err := os.ReadDir(dir)\r\n    38\t\tif err != nil {\r\n    39\t\t\treturn 1\r\n    40\t\t}\r\n    41\t\tout := map[string]string{}\r\n    42\t\tfor _, e := range entries {\r\n    43\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\r\n    44\t\t\t\tcontinue\r\n    45\t\t\t}\r\n    46\t\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\r\n    47\t\t\tif err != nil {\r\n    48\t\t\t\tcontinue\r\n    49\t\t\t}\r\n    50\t\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\r\n    51\t\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\r\n    52\t\t}\r\n    53\t\tout[\"tick\"] = tickCnt()\r\n    54\t\tsealHex()\r\n    55\t\tblob, err := json.MarshalIndent(out, \"\", \"  \")\r\n    56\t\tif err != nil {\r\n    57\t\t\treturn 1\r\n    58\t\t}\r\n    59\t\tif err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {\r\n    60\t\t\treturn 1\r\n"]
[17.924065, "o", "    61\t\t}\r\n    62\t\tif err := os.WriteFile(outPath, append(blob, '\\n'), 0o644); err != nil {\r\n    63\t\t\treturn 1\r\n    64\t\t}\r\n    65\t\treturn 0\r\n    66\t}\r\n"]
