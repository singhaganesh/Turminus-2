go 1.22
.PHONY: ship

ship:
	mkdir -p /app/bin
	# GOPROXY=off matches the image; go never fetches.
	GOPROXY=off /usr/local/go/bin/go build -o /app/bin/wickpane loft.local/wickpane/vatmill
	/app/bin/wickpane etch
	if [ -f /app/shardops/live/poison.stk ]; then mv /app/shardops/live/poison.stk /tmp/wick-ship-poison.stk; fi
	/app/bin/wickpane bin
	if [ -f /tmp/wick-ship-poison.stk ]; then mv /tmp/wick-ship-poison.stk /app/shardops/live/poison.stk; fi
--- celltyp/row.go
package celltyp

type Row struct {
	Kind string
	Mod  string
	Fn   string
}
--- millhint/trim.go
package millhint

import "strings"

func Trim(tok string) string {
	i := strings.LastIndex(tok, "+")
	if i < 0 {
		return tok
	}
	head, tail := tok[:i+1], tok[i+1:]
	if len(tail) == 0 {
		return tok
	}
	b := []byte(tail)
	b[len(b)-1] = '0'
	return head + string(b)
}
--- pantryc/drop.go
package pantryc

import (
	"strings"

	"loft.local/wickpane/celltyp"
)

func Drop(rows []celltyp.Row) []celltyp.Row {
	out := make([]celltyp.Row, 0, len(rows))
	for _, r := range rows {
		mod := strings.TrimSpace(r.Mod)
		if i := strings.Index(mod, "+"); i >= 0 {
			mod = mod[:i]
		}
		if mod == "[vdso]" {
			continue
		}
		out = append(out, r)
	}
	return out
}
--- pantryc/join.go
package pantryc

import (
	"strings"

	"loft.local/wickpane/celltyp"
)

func Join(rows []celltyp.Row) string {
	parts := make([]string, 0, len(rows))
	for _, r := range rows {
		parts = append(parts, r.Mod+"!"+r.Fn)
	}
	return strings.Join(parts, "|")
}
--- spoolkit/clip.go
package spoolkit

import (
	"strings"

	"loft.local/wickpane/celltyp"
)

func Clip(rows []celltyp.Row) []celltyp.Row {
	out := make([]celltyp.Row, 0, len(rows))
	for _, r := range rows {
		mod := strings.TrimSpace(r.Mod)
		if i := strings.LastIndex(mod, "+"); i >= 0 {
			mod = mod[i:]
		}
		out = append(out, celltyp.Row{Kind: r.Kind, Mod: mod, Fn: r.Fn})
	}
	return out
}
--- spoolkit/scan.go
package spoolkit

import (
	"bufio"
	"errors"
	"os"
	"strings"

	"loft.local/wickpane/celltyp"
)

var ErrReject = errors.New("reject")

func Scan(path string) ([]celltyp.Row, error) {
	f, err := os.Open(path)
	if err != nil {
		return nil, err
	}
	defer f.Close()
	var rows []celltyp.Row
	sc := bufio.NewScanner(f)
	for sc.Scan() {
		line := strings.TrimSpace(sc.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		parts := strings.Fields(line)
		if len(parts) == 0 {
			continue
		}
		if parts[0] == "BAD" {
			return nil, ErrReject
		}
		if len(parts) < 4 {
			continue
		}
		rows = append(rows, celltyp.Row{Kind: parts[0], Mod: parts[2], Fn: parts[3]})
	}
	return rows, sc.Err()
}
--- wicksrc/nest.go
package wicksrc

import (
	"strings"

	"loft.local/wickpane/celltyp"
)

func Nest(rows []celltyp.Row) []celltyp.Row {
	out := make([]celltyp.Row, 0, len(rows))
	for _, r := range rows {
		if r.Kind == "i" && strings.TrimSpace(r.Fn) == "" {
			continue
		}
		out = append(out, r)
	}
	return out
}
--- vatmill/bin.go
package main

import (
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"os"
	"path/filepath"
	"strconv"
	"strings"

	"loft.local/wickpane/pantryc"
	"loft.local/wickpane/spoolkit"
)

func tickCnt() string {
	p := "/app/shardops/runs.cnt"
	n := 0
	if b, err := os.ReadFile(p); err == nil {
		n, _ = strconv.Atoi(strings.TrimSpace(string(b)))
	}
	n++
	_ = os.WriteFile(p, []byte(strconv.Itoa(n)+"\n"), 0o644)
	return strconv.Itoa(n)
}

func sealHex() {
	a, _ := os.ReadFile("/app/shardops/live/n7.stk")
	b, _ := os.ReadFile("/app/shardops/live/s7.stk")
	sum := sha256.Sum256(append(a, b...))
	_ = os.WriteFile("/app/loomwell/pair.sha", []byte(hex.EncodeToString(sum[:])+"\n"), 0o644)
}

func runBin() int {
	dir := "/app/shardops/live"
	outPath := "/app/shardops/bins.json"
	entries, err := os.ReadDir(dir)
	if err != nil {
		return 1
	}
	out := map[string]string{}
	for _, e := range entries {
		if e.IsDir() || !strings.HasSuffix(e.Name(), ".stk") {
			continue
		}
		rows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))
		if err != nil {
			continue
		}
		stem := strings.TrimSuffix(e.Name(), ".stk")
		out[stem] = pantryc.Join(pipeBack(pipeFront(rows)))
	}
	out["tick"] = tickCnt()
	sealHex()
	blob, err := json.MarshalIndent(out, "", "  ")
	if err != nil {
		return 1
	}
	if err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {
		return 1
	}
	if err := os.WriteFile(outPath, append(blob, '\n'), 0o644); err != nil {
		return 1
	}
	return 0
}
--- vatmill/etch.go
package main

import (
	"encoding/json"
	"os"
	"path/filepath"
	"strings"

	"loft.local/wickpane/pantryc"
	"loft.local/wickpane/spoolkit"
)

func runEtch() int {
	dir := "/app/crumbay"
	outPath := "/app/loomwell/etch.json"
	entries, err := os.ReadDir(dir)
	if err != nil {
		return 1
	}
	out := map[string]string{}
	for _, e := range entries {
		if e.IsDir() || !strings.HasSuffix(e.Name(), ".stk") {
			continue
		}
		rows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))
		if err != nil {
			return 1
		}
		stem := strings.TrimSuffix(e.Name(), ".stk")
		out[stem] = pantryc.Join(pipeBack(pipeFront(rows)))
	}
	blob, err := json.MarshalIndent(out, "", "  ")
	if err != nil {
		return 1
	}
	if err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {
		return 1
	}
	if err := os.WriteFile(outPath, append(blob, '\n'), 0o644); err != nil {
		return 1
	}
	return 0
}
--- vatmill/main.go
package main

import (
	"fmt"
	"os"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: wickpane etch|bin")
		os.Exit(2)
	}
	var rc int
	switch os.Args[1] {
	case "etch":
		rc = runEtch()
	case "bin":
		rc = runBin()
	default:
		rc = 2
	}
	os.Exit(rc)
}
--- vatmill/stage.go
package main

import "loft.local/wickpane/celltyp"
import "loft.local/wickpane/spoolkit"
import "loft.local/wickpane/wicksrc"

func pipeFront(rows []celltyp.Row) []celltyp.Row {
	return wicksrc.Nest(spoolkit.Clip(rows))
}
--- vatmill/stage2.go
package main

import "loft.local/wickpane/celltyp"
import "loft.local/wickpane/pantryc"

func pipeBack(rows []celltyp.Row) []celltyp.Row {
	return pantryc.Drop(rows)
}
