[84.401674, "i", "cd /app && python3 - <<'PY'\nimport hashlib, json\nwith open('shardops/bins.json') as f:\n    b=json.load(f)\nwith open('loomwell/pair.sha') as f:\n    got=f.read().strip()\nwant=hashlib.sha256(b['n7'].encode()).hexdigest()\nprint('keys=', sorted(b))\nprint('n7=', b['n7'])\nprint('s7=', b['s7'])\nprint('shared=', b['n7']==b['s7'])\nprint('digest=', got)\nprint('digest_ok=', got==want, 'format_ok=', len(got)==64 and got==got.lower())\nPY\ncp shardops/bins.json /tmp/bins-good.json; cp loomwell/pair.sha /tmp/pair-good.sha; mv /tmp/wickpane-poison.stk shardops/live/poison.stk; /app/bin/wickpane bin; poison_rc=$?; cmp -s /tmp/bins-good.json shardops/bins.json; bins_unchanged=$?; cmp -s /tmp/pair-good.sha loomwell/pair.sha; pair_unchanged=$?; echo \"poison_rc=$poison_rc bins_unchanged_cmp_rc=$bins_unchanged pair_unchanged_cmp_rc=$pair_unchanged\"; od -An -tx1 -N4 bin/wickpane\n"]
