[15.800911, "o", "cd /app && cat go.mod Makefile && for f in celltyp/row.go millhint/trim.go pantryc/drop.go pantryc/join.go spoolkit/clip.go spoolkit/scan.go wicksrc/nest.go vatmill/*.go; do echo \"--- $f\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[15.802254, "o", "module loft.local/wickpane\r\n\r\ngo 1.22\r\n"]
[15.802432, "o", ".PHONY: ship\r\n\r\nship:\r\n\tmkdir -p /app/bin\r\n\t# GOPROXY=off matches the image; go never fetches.\r\n\tGOPROXY=off /usr/local/go/bin/go build -o /app/bin/wickpane loft.local/wickpane/vatmill\r\n\t/app/bin/wickpane etch\r\n\tif [ -f /app/shardops/live/poison.stk ]; then mv /app/shardops/live/poison.stk /tmp/wick-ship-poison.stk; fi\r\n\t/app/bin/wickpane bin\r\n\tif [ -f /tmp/wick-ship-poison.stk ]; then mv /tmp/wick-ship-poison.stk /app/shardops/live/poison.stk; fi\r\n"]
[15.80268, "o", "--- celltyp/row.go\r\n"]
[15.808156, "o", "package celltyp\r\n\r\ntype Row struct {\r\n\tKind string\r\n\tMod  string\r\n\tFn   string\r\n}\r\n"]
[15.808448, "o", "--- millhint/trim.go\r\n"]
[15.809673, "o", "package millhint\r\n\r\nimport \"strings\"\r\n\r\nfunc Trim(tok string) string {\r\n\ti := strings.LastIndex(tok, \"+\")\r\n\tif i < 0 {\r\n\t\treturn tok\r\n\t}\r\n"]
[15.809779, "o", "\thead, tail := tok[:i+1], tok[i+1:]\r\n\tif len(tail) == 0 {\r\n\t\treturn tok\r\n\t}\r\n\tb := []byte(tail)\r\n\tb[len(b)-1] = '0'\r\n\treturn head + string(b)\r\n}\r\n"]
[15.809936, "o", "--- pantryc/drop.go\r\n"]
[15.811181, "o", "package pantryc\r\n\r\nimport (\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\n"]
[15.811296, "o", "func Drop(rows []celltyp.Row) []celltyp.Row {\r\n\tout := make([]celltyp.Row, 0, len(rows))\r\n\tfor _, r := range rows {\r\n\t\tmod := strings.TrimSpace(r.Mod)\r\n\t\tif i := strings.Index(mod, \"+\"); i >= 0 {\r\n\t\t\tmod = mod[:i]\r\n\t\t}\r\n\t\tif mod == \"[vdso]\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tout = append(out, r)\r\n\t}\r\n\treturn out\r\n}\r\n"]
[15.811523, "o", "--- pantryc/join.go\r\n"]
[15.812687, "o", "package pantryc\r\n\r\nimport (\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\nfunc Join(rows []celltyp.Row) string {\r\n\tparts := make([]string, 0, len(rows))\r\n\tfor _, r := range rows {\r\n\t\t"]
[15.812804, "o", "parts = append(parts, r.Mod+\"!\"+r.Fn)\r\n\t}\r\n\treturn strings.Join(parts, \"|\")\r\n}\r\n"]
[15.813039, "o", "--- spoolkit/clip.go\r\n"]
[15.814214, "o", "package spoolkit\r\n\r\nimport (\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\nfunc Clip(rows []celltyp.Row) []celltyp.Row {\r\n\tout := make([]celltyp.Row, 0, len(rows))\r\n\tfor _, r := range rows {\r\n"]
[15.814344, "o", "\t\tmod := strings.TrimSpace(r.Mod)\r\n\t\tif i := strings.LastIndex(mod, \"+\"); i >= 0 {\r\n\t\t\tmod = mod[i:]\r\n\t\t}\r\n\t\tout = append(out, celltyp.Row{Kind: r.Kind, Mod: mod, Fn: r.Fn})\r\n\t}\r\n\treturn out\r\n}\r\n"]
[15.814525, "o", "--- spoolkit/scan.go\r\n"]
[15.815621, "o", "package spoolkit\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"errors\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\n"]
[15.815743, "o", "var ErrReject = errors.New(\"reject\")\r\n\r\nfunc Scan(path string) ([]celltyp.Row, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\tvar rows []celltyp.Row\r\n\tsc := bufio.NewScanner(f)\r\n\tfor sc.Scan() {\r\n\t\tline := strings.TrimSpace(sc.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.Fields(line)\r\n\t\tif len(parts) == 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif parts[0] == \"BAD\" {\r\n\t\t\treturn nil, ErrReject\r\n\t\t}\r\n\t\tif len(parts) < 4 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\trows = append(rows, celltyp.Row{Kind: parts[0], Mod: parts[2], Fn: parts[3]})\r\n\t}\r\n\treturn rows, sc.Err()\r\n}\r\n"]
[15.815995, "o", "--- wicksrc/nest.go\r\n"]
[15.817042, "o", "package wicksrc\r\n\r\nimport (\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\n"]
[15.817144, "o", "func Nest(rows []celltyp.Row) []celltyp.Row {\r\n\tout := make([]celltyp.Row, 0, len(rows))\r\n\tfor _, r := range rows {\r\n\t\tif r.Kind == \"i\" && strings.TrimSpace(r.Fn) == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tout = append(out, r)\r\n\t}\r\n\treturn out\r\n}\r\n"]
[15.817312, "o", "--- vatmill/bin.go\r\n"]
[15.818407, "o", "package main\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n"]
[15.818509, "o", "\t\"path/filepath\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/pantryc\"\r\n\t\"loft.local/wickpane/spoolkit\"\r\n)\r\n\r\nfunc tickCnt() string {\r\n\tp := \"/app/shardops/runs.cnt\"\r\n\tn := 0\r\n\tif b, err := os.ReadFile(p); err == nil {\r\n\t\tn, _ = strconv.Atoi(strings.TrimSpace(string(b)))\r\n\t}\r\n\tn++\r\n\t_ = os.WriteFile(p, []byte(strconv.Itoa(n)+\"\\n\"), 0o644)\r\n\treturn strconv.Itoa(n)\r\n}\r\n\r\nfunc sealHex() {\r\n\ta, _ := os.ReadFile(\"/app/shardops/live/n7.stk\")\r\n\tb, _ := os.ReadFile(\"/app/shardops/live/s7.stk\")\r\n\tsum := sha256.Sum256(append(a, b...))\r\n\t_ = os.WriteFile(\"/app/loomwell/pair.sha\", []byte(hex.EncodeToString(sum[:])+\"\\n\"), 0o644)\r\n}\r\n\r\nfunc runBin() int {\r\n\tdir := \"/app/shardops/live\"\r\n\toutPath := \"/app/shardops/bins.json\"\r\n\tentries, err := os.ReadDir(dir)\r\n"]
[15.818622, "o", "\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tout := map[string]string{}\r\n\tfor _, e := range entries {\r\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\r\n\t\tif err != nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\r\n\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\r\n\t}\r\n\tout[\"tick\"] = tickCnt()\r\n\tsealHex()\r\n\tblob, err := json.MarshalIndent(out, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tif err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tif err := os.WriteFile(outPath, append(blob, '\\n'), 0o644); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[15.8188, "o", "--- vatmill/etch.go\r\n"]
[15.819825, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n"]
[15.819915, "o", "\t\"loft.local/wickpane/pantryc\"\r\n\t\"loft.local/wickpane/spoolkit\"\r\n)\r\n\r\nfunc runEtch() int {\r\n\tdir := \"/app/crumbay\"\r\n\toutPath := \"/app/loomwell/etch.json\"\r\n\tentries, err := os.ReadDir(dir)\r\n\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tout := map[string]string{}\r\n\tfor _, e := range entries {\r\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\r\n\t\tif err != nil {\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\r\n\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\r\n\t}\r\n\tblob, err := json.MarshalIndent(out, \"\", \"  \")\r\n"]
[15.81998, "o", "\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tif err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tif err := os.WriteFile(outPath, append(blob, '\\n'), 0o644); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[15.820197, "o", "--- vatmill/main.go\r\n"]
[15.821223, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n"]
[15.821321, "o", "\t\tfmt.Fprintln(os.Stderr, \"usage: wickpane etch|bin\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tvar rc int\r\n\tswitch os.Args[1] {\r\n\tcase \"etch\":\r\n\t\trc = runEtch()\r\n\tcase \"bin\":\r\n\t\trc = runBin()\r\n\tdefault:\r\n\t\trc = 2\r\n\t}\r\n\tos.Exit(rc)\r\n}\r\n"]
[15.821485, "o", "--- vatmill/stage.go\r\n"]
[15.822493, "o", "package main\r\n\r\nimport \"loft.local/wickpane/celltyp\"\r\nimport \"loft.local/wickpane/spoolkit\"\r\nimport \"loft.local/wickpane/wicksrc\"\r\n\r\nfunc pipeFront(rows []celltyp.Row) []celltyp.Row {\r\n"]
[15.82257, "o", "\treturn wicksrc.Nest(spoolkit.Clip(rows))\r\n}\r\n"]
[15.822708, "o", "--- vatmill/stage2.go\r\n"]
[15.823778, "o", "package main\r\n\r\nimport \"loft.local/wickpane/celltyp\"\r\nimport \"loft.local/wickpane/pantryc\"\r\n\r\nfunc pipeBack(rows []celltyp.Row) []celltyp.Row {\r\n\treturn pantryc.Drop(rows)\r\n}\r\n"]
[15.824014, "o", "\u001b[?2004hroot@dba9e7a2d9a3:/app# "]
[16.305821, "i", "cd /app && for f in crumbay/*.stk shardops/live/*.stk; do echo \"--- $f\"; cat \"$f\"; done\n"]
