[29.999416, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5\t\t\"encoding/hex\"\r\n     6\t\t\"encoding/json\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t\r\n"]
[29.999596, "o", "    12\t\t\"loft.local/wickpane/pantryc\"\r\n    13\t\t\"loft.local/wickpane/spoolkit\"\r\n    14\t)\r\n    15\t\r\n    16\tfunc tickCnt() string {\r\n    17\t\tp := \"/app/shardops/runs.cnt\"\r\n    18\t\tn := 0\r\n    19\t\tif b, err := os.ReadFile(p); err == nil {\r\n    20\t\t\tn, _ = strconv.Atoi(strings.TrimSpace(string(b)))\r\n    21\t\t}\r\n    22\t\tn++\r\n    23\t\t_ = os.WriteFile(p, []byte(strconv.Itoa(n)+\"\\n\"), 0o644)\r\n    24\t\treturn strconv.Itoa(n)\r\n    25\t}\r\n    26\t\r\n    27\tfunc sealHex() {\r\n    28\t\ta, _ := os.ReadFile(\"/app/shardops/live/n7.stk\")\r\n    29\t\tb, _ := os.ReadFile(\"/app/shardops/live/s7.stk\")\r\n    30\t\tsum := sha256.Sum256(append(a, b...))\r\n    31\t\t_ = os.WriteFile(\"/app/loomwell/pair.sha\", []byte(hex.EncodeToString(sum[:])+\"\\n\"), 0o644)\r\n    32\t}\r\n    33\t\r\n    34\tfunc runBin() int {\r\n    35\t\tdir := \"/app/shardops/live\"\r\n    36\t\toutPath := \"/app/shardops/bins.json\"\r\n    37\t\tentries, err := os.ReadDir(dir)\r\n    38\t\tif err != nil {\r\n    39\t\t\treturn 1\r\n    40\t\t}\r\n    41\t\tout := map[string]string{}\r\n    42\t\tfor _, e := range entries {\r\n    43\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\r\n    44\t\t\t\tcontinue\r\n    45\t\t\t}\r\n    46\t\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\r\n    47\t\t\tif err != nil {\r\n    48\t\t\t\tcontinue\r\n    49\t\t\t}\r\n    50\t\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\r\n    51\t\t\t"]
[29.999626, "o", "out[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\r\n    52\t\t}\r\n    53\t\tout[\"tick\"] = tickCnt()\r\n    54\t\tsealHex()\r\n    55\t\tblob, err := json.MarshalIndent(out, \"\", \"  \")\r\n    56\t\tif err != nil {\r\n    57\t\t\treturn 1\r\n    58\t\t}\r\n    59\t\tif err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {\r\n"]
[29.999644, "o", "    60\t\t\treturn 1\r\n    61\t\t}\r\n    62\t\tif err := os.WriteFile(outPath, append(blob, '\\n'), 0o644); err != nil {\r\n    63\t\t\treturn 1\r\n    64\t\t}\r\n"]
[29.99966, "o", "    65\t\treturn 0\r\n    66\t}\r\n"]
[30.000959, "o", "     1\tpackage millhint\r\n     2\t\r\n     3\timport \"strings\"\r\n     4\t\r\n     5\tfunc Trim(tok string) string {\r\n     6\t\ti := strings.LastIndex(tok, \"+\")\r\n     7\t\tif i < 0 {\r\n     8\t\t\treturn tok\r\n"]
[30.001099, "o", "     9\t\t}\r\n    10\t\thead, tail := tok[:i+1], tok[i+1:]\r\n    11\t\tif len(tail) == 0 {\r\n    12\t\t\treturn tok\r\n    13\t\t}\r\n    14\t\tb := []byte(tail)\r\n    15\t\tb[len(b)-1] = '0'\r\n    16\t\treturn head + string(b)\r\n    17\t}\r\n    18\tpackage spoolkit\r\n    19\t\r\n    20\timport (\r\n    21\t\t\"strings\"\r\n    22\t\r\n    23\t\t\"loft.local/wickpane/celltyp\"\r\n    24\t)\r\n    25\t\r\n    26\tfunc Clip(rows []celltyp.Row) []celltyp.Row {\r\n    27\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    28\t\tfor _, r := range rows {\r\n    29\t\t\tmod := strings.TrimSpace(r.Mod)\r\n    30\t\t\tif i := strings.LastIndex(mod, \"+\"); i >= 0 {\r\n    31\t\t\t\tmod = mod[i:]\r\n    32\t\t\t}\r\n    33\t\t\tout = append(out, celltyp.Row{Kind: r.Kind, Mod: mod, Fn: r.Fn})\r\n    34\t\t}\r\n    35\t\treturn out\r\n    36\t}\r\n"]
[30.001172, "o", "    37\tpackage wicksrc\r\n    38\t\r\n    39\timport (\r\n    40\t\t\"strings\"\r\n    41\t\r\n    42\t\t\"loft.local/wickpane/celltyp\"\r\n    43\t)\r\n    44\t\r\n    45\tfunc Nest(rows []celltyp.Row) []celltyp.Row {\r\n    46\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    47\t\tfor _, r := range rows {\r\n    48\t\t\tif r.Kind == \"i\" && strings.TrimSpace(r.Fn) == \"\" {\r\n    49\t\t\t\tcontinue\r\n    50\t\t\t}\r\n    51\t\t\tout = append(out, r)\r\n    52\t\t}\r\n    53\t\treturn out\r\n    54\t}\r\n    55\tpackage pantryc\r\n    56\t\r\n"]
[30.001242, "o", "    57\timport (\r\n    58\t\t\"strings\"\r\n    59\t\r\n    60\t\t\"loft.local/wickpane/celltyp\"\r\n    61\t)\r\n    62\t\r\n    63\tfunc Drop(rows []celltyp.Row) []celltyp.Row {\r\n    64\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    65\t\tfor _, r := range rows {\r\n    66\t\t\tmod := strings.TrimSpace(r.Mod)\r\n    67\t\t\tif i := strings.Index(mod, \"+\"); i >= 0 {\r\n    68\t\t\t\tmod = mod[:i]\r\n    69\t\t\t}\r\n    70\t\t\tif mod == \"[vdso]\" {\r\n    71\t\t\t\tcontinue\r\n    72\t\t\t}\r\n    73\t\t\tout = append(out, r)\r\n    74\t\t}\r\n    75\t\treturn out\r\n"]
[30.001302, "o", "    76\t}\r\n    77\tpackage pantryc\r\n    78\t\r\n    79\timport (\r\n    80\t\t\"strings\"\r\n    81\t\r\n    82\t\t\"loft.local/wickpane/celltyp\"\r\n    83\t)\r\n    84\t\r\n    85\tfunc Join(rows []celltyp.Row) string {\r\n    86\t\tparts := make([]string, 0, len(rows))\r\n    87\t\tfor _, r := range rows {\r\n    88\t\t\tparts = append(parts, r.Mod+\"!\"+r.Fn)\r\n    89\t\t}\r\n    90\t\treturn strings.Join(parts, \"|\")\r\n    91\t}"]
