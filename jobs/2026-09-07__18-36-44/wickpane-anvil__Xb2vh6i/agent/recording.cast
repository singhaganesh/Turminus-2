[16.83014, "i", "cd /app && echo '--- etch'; cat loomwell/etch.json; echo '--- bins'; cat shardops/bins.json; echo '--- sha'; cat loomwell/pair.sha; echo '--- magic'; od -An -tx1 -N4 bin/wickpane; echo '--- runs'; cat shardops/runs.cnt 2>/dev/null || true\n"]
[16.830842, "o", "cd /app && echo '--- etch'; cat loomwell/etch.json; echo '--- bins'; cat shardops/bins.json; echo '--- sha'; cat loomwell/pair.sha; echo '--- magic'; od -An -tx1 -N4 bin/wickpane; echo '--- runs'; cat shardops/runs.cnt 2>/dev/null || true\r\n\u001b[?2004l\r"]
[16.83099, "o", "--- etch\r\n"]
[16.832049, "o", "{\r\n  \"n7\": \"+0x4400!draw_box|+0x4418!draw_box_fill|+0x80!abort|+0x20!clock_gettime\",\r\n  \"p3\": \"+0x100!run_main\",\r\n  \"q9\": \"+0x50!recv_one|+0x8!vsyscall_page\",\r\n  \"r2\": \"+0x1!init_old|+0x10!start_main\",\r\n  \"s7\": \"+0x9aa0!draw_box|+0x80!abort\"\r\n}\r\n"]
[16.83223, "o", "--- bins\r\n"]
