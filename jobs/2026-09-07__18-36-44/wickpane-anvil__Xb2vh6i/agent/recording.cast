[60.950332, "i", "cd /app && cat > millhint/trim.go <<'EOF'\npackage millhint\n\nimport \"strings\"\n\n// Trim removes the optional address/offset tail from a module token.\nfunc Trim(tok string) string {\n\ttok = strings.TrimSpace(tok)\n\tif i := strings.IndexByte(tok, '+'); i >= 0 {\n\t\treturn tok[:i]\n\t}\n\treturn tok\n}\nEOF\ncat > spoolkit/clip.go <<'EOF'\npackage spoolkit\n\nimport (\n\t\"loft.local/wickpane/celltyp\"\n\t\"loft.local/wickpane/millhint\"\n)\n\n// Clip canonicalizes module tokens while retaining the row ordering.\nfunc Clip(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tr.Mod = millhint.Trim(r.Mod)\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\nEOF\ncat > wicksrc/nest.go <<'EOF'\npackage wicksrc\n\nimport \"loft.local/wickpane/celltyp\"\n\n// Nest removes fold records. A fold belongs to the following named frame and\n// therefore never emits a pane chunk of its own.\nfunc Nest(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tif r.Kind == \"i\" {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\nEOF\ncat > pantryc/drop.go <<'EOF'\npackage pantryc\n\nimport (\n\t\"loft.local/wickpane/celltyp\"\n\t\"loft.local/wickpane/millhint\"\n)\n\n// Drop removes kernel-provided pseudo modules from pane output.\nfunc Drop(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tr.Mod = millhint.Trim(r.Mod)\n\t\tif r.Mod == \"[vdso]\" || r.Mod == \"[vsyscall]\" {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\nEOF\ncat > vatmill/bin.go <<'EOF'\npackage main\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"loft.local/wickpane/pantryc\"\n\t\"loft.local/wickpane/spoolkit\"\n)\n\nfunc stageFile(path string, data []byte) (string, error) {\n\tdir := filepath.Dir(path)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn \"\", err\n\t}\n\tf, err := os.CreateTemp(dir, \".\"+filepath.Base(path)+\"-*\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tname := f.Name()\n\tok := false\n\tdefer func() {\n\t\tif !ok {\n\t\t\t_ = os.Remove(name)\n\t\t}\n\t}()\n\tif err = f.Chmod(0o644); err == nil {\n\t\t_, err = f.Write(data)\n\t}\n\tif err == nil {\n\t\terr = f.Sync()\n\t}\n\tif closeErr := f.Close(); err == nil {\n\t\terr = closeErr\n\t}\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tok = true\n\treturn name, nil\n}\n\nfunc runBin() int {\n\tconst dir = \"/app/shardops/live\"\n\tconst outPath = \"/app/shardops/bins.json\"\n\tconst shaPath = \"/app/loomwell/pair.sha\"\n\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tout := make(map[string]string)\n\tfor _, e := range entries {\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\n\t\t\tcontinue\n\t\t}\n\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\n\t\tif err != nil {\n\t\t\t// In particular, a BAD take aborts before either output is staged.\n\t\t\treturn 1\n\t\t}\n\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\n\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\n\t}\n\n\tn7, nOK := out[\"n7\"]\n\ts7, sOK := out[\"s7\"]\n\tif !nOK || !sOK || n7 != s7 {\n\t\treturn 1\n\t}\n\tsum := sha256.Sum256([]byte(n7))\n\tshaBlob := []byte(fmt.Sprintf(\"%x\\n\", sum))\n\tjsonBlob, err := json.MarshalIndent(out, \"\", \"  \")\n\tif err != nil {\n\t\treturn 1\n\t}\n\tjsonBlob = append(jsonBlob, '\\n')\n\n\tjsonTmp, err := stageFile(outPath, jsonBlob)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tdefer os.Remove(jsonTmp)\n\tshaTmp, err := stageFile(shaPath, shaBlob)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tdefer os.Remove(shaTmp)\n\n\tif err := os.Rename(shaTmp, shaPath); err != nil {\n\t\treturn 1\n\t}\n\tif err := os.Rename(jsonTmp, outPath); err != nil {\n\t\treturn 1\n\t}\n\treturn 0\n}\nEOF\n/usr/local/go/bin/gofmt -w millhint/trim.go spoolkit/clip.go wicksrc/nest.go pantryc/drop.go vatmill/bin.go\n/usr/local/go/bin/go test ./...\n"]
