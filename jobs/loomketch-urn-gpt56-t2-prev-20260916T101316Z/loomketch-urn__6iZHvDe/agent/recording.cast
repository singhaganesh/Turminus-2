[9.434006, "i", "printf '%s\\n' '--- SOURCE/BUILD CANDIDATES ---'; find /app -maxdepth 4 -type f \\( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.rs' -o -name '*.go' -o -name '*.py' -o -name 'Makefile' -o -name 'CMakeLists.txt' \\) -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\n"]
[9.434969, "o", "printf '%s\\n' '--- SOURCE/BUILD CANDIDATES ---'; find /app -maxdepth 4 -type f \\( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.rs' -o -name '*.go' -o -name '*.py' -o -name 'Makefile' -o -name 'CMakeLists.txt' \\) -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[9.43519, "o", "--- SOURCE/BUILD CANDIDATES ---\r\n"]
[9.439297, "o", "/app/humdock/emit.rs\r\n"]
[9.44011, "o", "### /app/humdock/emit.rs\r\n"]
[9.443335, "o", "use crate::tally::Rec;\r\n\r\npub fn emit(a: &[Rec]) -> i32 {\r\n    let mut rows: Vec<Rec> = a.to_vec();\r\n    rows.sort_by(|x, y| x.kind.cmp(&y.kind));\r\n    let mut out = String::from(\"issue\\tkind\\tbody\\n\");\r\n    for (i, r) in rows.iter().enumerate() {\r\n        out.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, r.kind, r.body));\r\n    }\r\n    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    if std::fs::write(\"/app/inkbay/desk.tsv\", out).is_err() {\r\n        return 1;\r\n    }\r\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[9.44388, "o", "/app/treyfun/clip.rs\r\n"]
[9.444641, "o", "### /app/treyfun/clip.rs\r\n"]
[9.445751, "o", "pub fn clip(a: &[String]) -> Vec<String> {\r\n    a.iter()\r\n        .filter(|s| !s.starts_with(\"__asan::\") && !s.starts_with(\"__asan_\"))\r\n        .cloned()\r\n        .collect()\r\n}\r\n\r\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\r\n    if text.trim().is_empty() {\r\n        return Ok((String::new(), Vec::new()));\r\n    }\r\n    let mut kind = String::new();\r\n    let mut frames = Vec::new();\r\n    for line in text.lines() {\r\n        if let Some(rest) = line.split(\"ERROR:\").nth(1) {\r\n            let rest = rest.trim();\r\n            let after = if let Some(x) = rest.split(\"AddressSanitizer:\").nth(1) {\r\n                x.trim()\r\n            } else {\r\n"]
[9.44592, "o", "                rest\r\n            };\r\n            kind = after.split(\" on \").next().unwrap_or(after).trim().to_string();\r\n        }\r\n        if let Some(idx) = line.find('#') {\r\n            let chunk = &line[idx..];\r\n            if let Some(after) = chunk.split(\" in \").nth(1) {\r\n                let sym = after.split_whitespace().next().unwrap_or(\"\").to_string();\r\n                if !sym.is_empty() {\r\n                    frames.push(sym);\r\n                }\r\n            }\r\n        }\r\n    }\r\n    Ok((kind, frames))\r\n}\r\n"]
[9.446232, "o", "/app/qanbox/tally.rs\r\n"]
[9.447116, "o", "### /app/qanbox/tally.rs\r\n"]
[9.448217, "o", "#[path = \"../treyfun/clip.rs\"]\r\nmod clip;\r\n\r\nuse std::collections::HashMap;\r\nuse std::sync::mpsc;\r\nuse std::thread;\r\n\r\n#[derive(Clone)]\r\npub struct Rec {\r\n    pub issue: i32,\r\n    pub kind: String,\r\n    pub frames: Vec<String>,\r\n    pub body: String,\r\n}\r\n\r\npub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\r\n    let paths = crate::walk::gather(a)?;\r\n    let (tx, rx) = mpsc::channel();\r\n    let mut hs = Vec::new();\r\n    for p in paths {\r\n        let tx = tx.clone();\r\n"]
[9.448395, "o", "        hs.push(thread::spawn(move || {\r\n            let text = match std::fs::read_to_string(&p) {\r\n                Ok(t) => t,\r\n                Err(_) => return,\r\n            };\r\n            let (kind, frames) = match clip::take(&text) {\r\n                Ok(x) => x,\r\n                Err(_) => return,\r\n            };\r\n            if kind.is_empty() {\r\n                return;\r\n            }\r\n            let frames = clip::clip(&frames);\r\n            let body = frames.join(\" | \");\r\n            let _ = tx.send(Rec {\r\n                issue: 0,\r\n                kind,\r\n                frames,\r\n                body,\r\n            });\r\n        }));\r\n    }\r\n    drop(tx);\r\n    for h in hs {\r\n        let _ = h.join();\r\n    }\r\n    let mut bag: HashMap<String, Rec> = HashMap::new();\r\n    while let Ok(r) = rx.recv() {\r\n        bag.entry(r.body.clone()).or_insert(r);\r\n    }\r\n    let mut recs: Vec<Rec> = bag.into_values().collect();\r\n    for (i, r) in recs.iter_mut().enumerate() {\r\n        r.issue = (i as i32) + 1;\r\n    }\r\n    let _ = write_bound(&recs);\r\n    Ok(recs)\r\n}\r\n\r\nfn write_bound(recs: &[Rec]) -> i32 {\r\n    let tpl = std::fs::read_to_string(\"/app/tplbay/bound.tpl\").unwrap_or_else(|_| \"{\\\"findings\\\":[__ROWS__]}\".into());\r\n    if recs.is_empty() {\r\n        let _ = std::fs::write(\"/app/inkbay/bound.json\", tpl);\r\n        return 0;\r\n    }\r\n    let mut inner = String::new();\r\n    for (i, r) in recs.iter().enumerate() {\r\n        if i > 0 {\r\n            inner.push(',');\r\n        }\r\n        inner.push_str(&format!(\r\n            \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\r\n            r.issue,\r\n            jstr(&r.kind),\r\n            jarr(&r.frames),\r\n            jstr(&r.body)\r\n        ));\r\n    }\r\n    let out = tpl.replace(\"__ROWS__\", &inner);\r\n    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    match std::fs::write(\"/app/inkbay/bound.json\", out) {\r\n        Ok(()) => 0,\r\n        Err(_) => 1,\r\n    }\r\n}\r\n"]
[9.448494, "o", "\r\nfn jstr(s: &str) -> String {\r\n    format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\"))\r\n}\r\n\r\nfn jarr(v: &[String]) -> String {\r\n    let parts: Vec<String> = v.iter().map(|x| jstr(x)).collect();\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n}\r\n"]
[9.449108, "o", "/app/walkcue/alpha.rs\r\n"]
[9.45017, "o", "### /app/walkcue/alpha.rs\r\n"]
[9.451457, "o", "pub fn lined(a: &mut Vec<String>) -> bool {\r\n    if std::env::var(\"KETCH_ALPHA\").ok().as_deref() == Some(\"1\") {\r\n        a.sort();\r\n        true\r\n    } else {\r\n        false\r\n    }\r\n}\r\n"]
[9.451956, "o", "/app/urnwalk/walk.rs\r\n"]
[9.452883, "o", "### /app/urnwalk/walk.rs\r\n"]
[9.455129, "o", "pub fn gather(a: &str) -> Result<Vec<String>, i32> {\r\n    let mut v = Vec::new();\r\n    let rd = match std::fs::read_dir(a) {\r\n        Ok(x) => x,\r\n        Err(_) => return Err(2),\r\n    };\r\n    for e in rd {\r\n        let e = match e {\r\n            Ok(x) => x,\r\n            Err(_) => continue,\r\n        };\r\n        let p = e.path();\r\n        if p.is_file() {\r\n            v.push(p.to_string_lossy().into_owned());"]
[9.455347, "o", "\r\n        }\r\n    }\r\n    if crate::alpha::lined(&mut v) {\r\n        v.sort();\r\n    }\r\n    Ok(v)\r\n}\r\n"]
[9.455478, "o", "/app/ketchcli/main.rs\r\n"]
[9.456535, "o", "### /app/ketchcli/main.rs\r\n"]
[9.457769, "o", "#[path = \"../urnwalk/walk.rs\"]\r\nmod walk;\r\n#[path = \"../walkcue/alpha.rs\"]\r\nmod alpha;\r\n#[path = \"../qanbox/tally.rs\"]\r\nmod tally;\r\n#[path = \"../humdock/emit.rs\"]\r\nmod rib;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"bind\" {\r\n        eprintln!(\"usage: loomketch bind [root]\");\r\n        std::process::exit(2);\r\n    }\r\n    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\r\n    let code = match tally::tally(&root) {\r\n"]
[9.457907, "o", "        Ok(recs) => {\r\n            if rib::emit(&recs) != 0 {\r\n                1\r\n            } else {\r\n                0\r\n            }\r\n        }\r\n        Err(c) => {\r\n            let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\r\n            c\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[9.458651, "o", "\u001b[?2004hroot@ccf7f2c7794c:/app# "]
