[85.288553, "o", "{\r\n  \"findings\": [\r\n    {\r\n      \"issue\": 1,\r\n      \"kind\": \"heap-buffer-overflow\",\r\n      \"frames\": [\r\n        \"fill_span\",\r\n        \"prep_buf\"\r\n      ],\r\n      \"body\": \"fill_span | prep_buf\"\r\n    },\r\n    {\r\n      \"issue\": 2,\r\n      \"kind\": \"use-after-return\",\r\n      \"frames\": [\r\n        \"latch_tick\",\r\n        \"drain_slot\"\r\n      ],\r\n      \"body\": \"latch_tick | drain_slot\"\r\n    },\r\n    {\r\n      \"issue\": 3,\r\n      \"kind\": \"stack-buffer-overflow\",\r\n      \"frames\": [\r\n        \"pump_read\",\r\n        \"loop_tick\"\r\n      ],\r\n      \"body\": \"pump_read | loop_tick\"\r\n    },\r\n    {\r\n      \"issue\": 4,\r\n      \"kind\": \"heap-use-after-free\",\r\n      \"frames\": [\r\n        \"widget_free\",\r\n        \"worker_main\"\r\n      ],\r\n      \"body\": \"widget_free | worker_main\"\r\n    }\r\n  ]\r\n}\r\n"]
[85.288637, "o", "issue\tkind\tbody\r\n1\theap-buffer-overflow\tfill_span | prep_buf\r\n2\tuse-after-return\tlatch_tick | drain_slot\r\n3\tstack-buffer-overflow\tpump_read | loop_tick\r\n4\theap-use-after-free\twidget_free | worker_main\r\n"]
