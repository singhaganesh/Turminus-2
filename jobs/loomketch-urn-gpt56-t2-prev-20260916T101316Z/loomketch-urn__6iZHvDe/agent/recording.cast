[85.216785, "i", "set -e\n/app/bin/loomketch bind\ncp /app/inkbay/bound.json /tmp/bound.first\ncp /app/inkbay/desk.tsv /tmp/desk.first\n/app/bin/loomketch bind\ncmp /tmp/bound.first /app/inkbay/bound.json\ncmp /tmp/desk.first /app/inkbay/desk.tsv\npython3 - <<'PY'\nimport json\np='/app/inkbay/bound.json'\nd=json.load(open(p))\nassert len(d['findings']) == 4\nassert [x['issue'] for x in d['findings']] == list(range(1,5))\nrows=open('/app/inkbay/desk.tsv').read().splitlines()\nassert rows[0] == 'issue\\tkind\\tbody'\nassert len(rows) == 5\nfor rec,row in zip(d['findings'],rows[1:]):\n    assert row == f\"{rec['issue']}\\t{rec['kind']}\\t{rec['body']}\"\n    assert not any(f.startswith(('__asan','__interceptor','__hwasan')) for f in rec['frames'])\nassert open('/app/inkbay/GUARD').read() == 'ok'\nprint(json.dumps(d, indent=2))\nprint(open('/app/inkbay/desk.tsv').read(), end='')\nPY\n"]
