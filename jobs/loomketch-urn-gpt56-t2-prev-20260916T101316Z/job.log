summary {\n                return Err(3);\n            }\n            let rest = t[pos + "ERROR:".len()..].trim();\n            let rest = rest.strip_prefix("AddressSanitizer:").unwrap_or(rest).trim();\n            let value = rest.split(" on ").next().unwrap_or("").trim();\n            if value.is_empty() {\n                return Err(3);\n            }\n            kind = Some(value.to_string());\n        } else if t.starts_with(\'#\') {\n            if kind.is_none() || summary {\n                return Err(3);\n            }\n            let mut words = t.split_whitespace();\n            let number = words.next().ok_or(3)?;\n            let n: usize = number.strip_prefix(\'#\').ok_or(3)?.parse().map_err(|_| 3)?;\n            if n != expected {\n                return Err(3);\n            }\n            expected += 1;\n            let _address = words.next().ok_or(3)?;\n            if words.next() != Some("in") {\n                return Err(3);\n            }\n            let sym = words.next().ok_or(3)?;\n            if sym.is_empty() {\n                return Err(3);\n            }\n            frames.push(sym.to_string());\n        } else if t.starts_with("SUMMARY:") {\n            if kind.is_none() || frames.is_empty() || summary {\n                return Err(3);\n            }\n            summary = true;\n        }\n    }\n\n    if !summary {\n        return Err(3);\n    }\n    let frames = clip(&frames);\n    if frames.is_empty() {\n        return Err(3);\n    }\n    Ok((kind.ok_or(3)?, frames))\n}\n\nfn fold_hex(s: &str) -> String {\n    let bytes = s.as_bytes();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < bytes.len() {\n        if i + 2 <= bytes.len() && bytes[i] == b\'0\' && bytes[i + 1] == b\'x\' {\n            let mut j = i + 2;\n            while j < bytes.len() && bytes[j].is_ascii_hexdigit() {\n                j += 1;\n            }\n            if j > i + 2 {\n                out.push_str("<hex>");\n                i = j;\