     1	public class Tarn {
     2	    public volatile int waiting;
     3	    public int keld;
     4	    public int copy;
     5	
     6	    public int mira() {
     7	        int a = keld;
     8	        waiting = 1;
     9	        int spins = 0;
    10	        while (a == 0) {
    11	            a = keld;
    12	            if (++spins > 12000000) break;
    13	        }
    14	        return a;
    15	    }
    16	}
