cat > /app/watchbay/ShipMain.java <<'EOF'
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.zip.ZipFile;

public class ShipMain {
    private static final Path OUT = Paths.get("/app/jarhearth/watch.json");

    public static int rib_n(String[] a) throws Exception {
        Files.deleteIfExists(OUT);
        if (a.length != 1 || !lid_q()) {
            return 1;
        }

        Path bag = Paths.get(a[0]);
        int word = Integer.parseInt(Files.readAllLines(bag).get(0).trim());
        // Zero is the protocol's never-publish marker.  Do not enter the wait
        // in that case, and above all do not leave a success ledger behind.
        if (word == 0) {
            return 1;
        }

        Tarn board = new Tarn();
        int seen = Glue.haul(board, word);
        if (seen == 0) {
            return 1;
        }

        String note = Files.readString(Paths.get("/app/opslip/MARK.txt")).trim();
        String body = "{\"seen\":" + seen
                + ",\"bag\":\"" + json(a[0])
                + "\",\"note\":\"" + json(note) + "\"}\n";
        Files.createDirectories(OUT.getParent());
        Files.writeString(OUT, body, StandardCharsets.UTF_8);
        return 0;
    }

    public static void main(String[] a) throws Exception {
        System.exit(rib_n(a));
    }

    static boolean lid_q() {
        try {
            String want = Files.readString(Paths.get("/app/opslip/MARK.txt")).trim();
            try (ZipFile z = new ZipFile("/app/jarhearth/ship.jar")) {
                var e = z.getEntry("STAMP");
                if (e == null) return false;
                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();
                return want.equals(got);
            }
        } catch (Exception ex) {
            return false;
        }
    }

    private static String json(String s) {
        StringBuilder b = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '"': b.append("\\\""); break;
                case '\\': b.append("\\\\"); break;
                case '\b': b.append("\\b"); break;
                case '\f': b.append("\\f"); break;
                case '\n': b.append("\\n"); break;
                case '\r': b.append("\\r"); break;
                case '\t': b.append("\\t"); break;
                default:
                    if (c < 0x20) b.append(String.format("\\u%04x", (int)c));
                    else b.append(c);
            }
        }
        return b.toString();
    }
}
EOF
/app/bin/cinderwait kindle
set +e
for b in /app/hopbags/alpha.bag /app/hopbags/elm.bag; do
  echo "--- watch $b ---"
  timeout 5 /app/bin/cinderwait watch "$b"; rc=$?; echo rc=$rc
  cat /app/jarhearth/watch.json
  python3 -m json.tool /app/jarhearth/watch.json >/dev/null || exit 90
  echo "peek=$(/app/bin/cinderwait peek "$b")"
done
echo '--- mute failure ---'
timeout 5 /app/bin/cinderwait watch /app/hopbags/mute.bag; echo rc=$?
test ! -e /app/jarhearth/watch.json; echo absent_rc=$?
echo '--- stamp and pack