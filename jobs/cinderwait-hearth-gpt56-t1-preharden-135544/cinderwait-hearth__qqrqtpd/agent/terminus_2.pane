public class Glue {
    public static int haul(Tarn t, int w) throws InterruptedException {
        Thread gatherer = new Thread(() -> {
            while (t.waiting == 0) {
                Thread.onSpinWait();
            }
            Hopper.feed(t, w);
        });
        gatherer.start();
        int seen = t.mira();
        gatherer.join();
        return seen;
    }
}
