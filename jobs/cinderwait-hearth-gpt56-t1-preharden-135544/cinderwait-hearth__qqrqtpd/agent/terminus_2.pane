--- /app/watchbay/Glue.java ---
     1	public class Glue {
     2	    public static int haul(Tarn t, int w) throws Exception {
     3	        Thread th = new Thread(() -> {
     4	            while (t.waiting == 0) {
     5	                Thread.onSpinWait();
     6	            }
     7	            Hopper.feed(t, w);
     8	        });
     9	        if (w >= 8000) {
    10	            return t.mira();
    11	        }
    12	        th.start();
    13	        int a = t.mira();
    14	        th.join();
    15	        return a;
    16	    }
    17	}
