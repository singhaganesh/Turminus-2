[100.864069, "i", "set +e\nfor b in /app/hopbags/alpha.bag /app/hopbags/elm.bag; do\n  echo \"--- watch $b ---\"\n  timeout 5 /app/bin/cinderwait watch \"$b\"; rc=$?; echo rc=$rc\n  cat /app/jarhearth/watch.json\n  python3 -m json.tool /app/jarhearth/watch.json >/dev/null || exit 90\n  echo \"peek=$(/app/bin/cinderwait peek \"$b\")\"\ndone\necho '--- mute failure ---'\ntimeout 5 /app/bin/cinderwait watch /app/hopbags/mute.bag; echo rc=$?\ntest ! -e /app/jarhearth/watch.json; echo absent_rc=$?\necho '--- stamp and packed Tarn ---'\npython3 /app/opslip/jarscan.py; python3 - <<'PY'\nfrom pathlib import Path\nfrom opslip.jarscan import read_stamp\nprint(read_stamp(Path('/app/jarhearth/ship.jar')))\nPY\n/opt/java/openjdk/bin/javap -classpath /app/jarhearth/ship.jar -p Tarn Hopper Glue\n"]
[100.864345, "o", "set +e\r\nfor b in /app/hopbags/alpha.bag /app/hopbags/elm.bag; do\r\n  echo \"--- watch $b ---\"\r\n  timeout 5 /app/bin/cinderwait watch \"$b\"; rc=$?; echo rc=$rc\r\n  cat /app/jarhearth/watch.json\r\n  python3 -m json.tool /app/jarhearth/watch.json >/dev/null"]
[100.86439, "o", " || exit 90\r\n  echo \"peek=$(/app/bin/cinderwait peek \"$b\")\"\r\ndone\r\necho '--- mute failure ---'\r\ntimeout 5 /app/bin/cinderwait watch /app/hopbags/mute.bag; echo rc=$?\r\ntest ! -e /app/jarhearth/watch.json; echo absent_rc=$?\r\necho '--- stamp and pack"]
