[22.557641, "o", "echo '--- KINDLE ---'; nl -ba /app/kindle.sh; for f in /app/{tarnpit,hopcue,watchbay,draftcue,kilnrib,peekcue,rillcue,softmill}/*.java; do echo \"--- $f ---\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r--- KINDLE ---\r\n"]
[22.562398, "o", "     1\t#!/bin/bash\r\n     2\tset -euo pipefail\r\n     3\tJAVAC=\"${JAVA_HOME:-/opt/java/openjdk}/bin/javac\"\r\n     4\tJAR=\"${JAVA_HOME:-/opt/java/openjdk}/bin/jar\"\r\n     5\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n     6\tif [ ! -x \"$JAVAC\" ]; then\r\n     7\t  JAVAC=javac\r\n     8\t  JAR=jar\r\n     9\t  JAVA=java\r\n    10\tfi\r\n    11\trm -rf /tmp/kilsrc /tmp/kildst /tmp/shipcp /tmp/draftcp /app/blastcp\r\n    12\tmkdir -p /tmp/kilsrc /tmp/kildst /tmp/shipcp /tmp/draftcp /app/blastcp /app/jarhearth /app/bin\r\n    13\tcp /app/tarnpit/*.java /tmp/kilsrc/\r\n    14\tcp /app/rillcue/*.java /tmp/kilsrc/\r\n    15\tmapfile -t ALL < <(find /app/tarnpit /app/hopcue /app/watchbay /app/draftcue /app/peekcue /app/kilnrib /app/rillcue /app/softmill -name '*.java' | sort)\r\n    16\t\"$JAVAC\" -d /app/blastcp \"${ALL[@]}\"\r\n    17\t\"$JAVA\" -cp /app/blastcp KilnShip /tmp/kilsrc /tmp/kildst\r\n    18\tmapfile -t SHIPSRC < <(find /tmp/kildst /app/hopcue /app/watchbay /app/softmill -name '*.java' | sort)\r\n    19\t\"$JAVAC\" -d /tmp/shipcp \"${SHIPSRC[@]}\"\r\n    20\tmapfile -t DRAFTSRC < <(find /app/tarnpit /app/hopcue /app/draftcue /app/softmill -name '*.java' | sort)\r\n    21\t\"$JAVAC\" -d /tmp/draftcp \"${DRAFTSRC[@]}\"\r\n    22\t(\r\n    23\t  cd /tmp/shipcp\r\n    24\t  \"$JAR\" cf /app/jarhearth/ship.jar .\r\n    25\t)\r\n    26\t(\r\n    27\t  cd /tmp/draftcp\r\n    28\t  \"$JAR\" cf /app/jarhearth/draft.jar .\r\n    29\t)\r\n    30\tpython3 - << 'PY'\r\n    31\timport io\r\n"]
[22.562552, "o", "    32\timport zipfile\r\n    33\tfrom pathlib import Path\r\n    34\tsrc = Path(\"/app/jarhearth/ship.jar\")\r\n    35\tbody = Path(\"/app/jarhearth/STAMP.body\").read_bytes()\r\n    36\tbuf = io.BytesIO()\r\n    37\twith zipfile.ZipFile(src, \"r\") as zin, zipfile.ZipFile(buf, \"w\") as zout:\r\n    38\t    for info in zin.infolist():\r\n    39\t        if info.filename in (\"STAMP\", \"STAMP.body\"):\r\n    40\t            continue\r\n    41\t        zout.writestr(info, zin.read(info.filename))\r\n    42\t    zout.writestr(\"STAMP\", body)\r\n    43\tsrc.write_bytes(buf.getvalue())\r\n    44\twant = Path(\"/app/opslip/MARK.txt\").read_text().strip()\r\n    45\twith zipfile.ZipFile(src) as z:\r\n    46\t    got = z.read(\"STAMP\").decode().strip()\r\n    47\tif got != want:\r\n    48\t    raise SystemExit(1)\r\n    49\tPY\r\n    50\tcat > /app/bin/cinderwait << 'EOF'\r\n    51\t#!/bin/bash\r\n    52\tset -euo pipefail\r\n    53\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n    54\tif [ ! -x \"$JAVA\" ]; then\r\n    55\t  JAVA=java\r\n    56\tfi\r\n    57\tverb=\"${1:-}\"\r\n    58\tshift || true\r\n    59\tcase \"$verb\" in\r\n    60\t  kindle)\r\n    61\t    exec /app/kindle.sh\r\n    62\t    ;;\r\n    63\t  watch)\r\n    64\t    exec \"$JAVA\" -cp /app/jarhearth/ship.jar ShipMain \"$@\"\r\n    65\t    ;;\r\n    66\t  peek)\r\n    67\t    exec \"$JAVA\" -cp /app/blastcp PeekMain \"$@\"\r\n    68\t    ;;\r\n    69\t  draft)\r\n    70\t    exec \"$JAVA\" -cp /app/jarhearth/draft.jar DraftMain \"$@\"\r\n    71\t    ;;\r\n    72\t  *)\r\n    73\t    exit 2\r\n    74\t    ;;\r\n    75\tesac\r\n    76\tEOF\r\n    77\tchmod +x /app/bin/cinderwait /app/kindle.sh\r\n"]
[22.563417, "o", "--- /app/tarnpit/Tarn.java ---\r\n"]
[22.564648, "o", "     1\tpublic class Tarn {\r\n     2\t    public volatile int waiting;\r\n     3\t    public int keld;\r\n     4\t    public int copy;\r\n     5\t\r\n     6\t    public int mira() {\r\n     7\t        int a = keld;\r\n     8\t        waiting = 1;\r\n     9\t        int spins = 0;\r\n    10\t        while (a == 0) {\r\n    11\t            a = keld;\r\n"]
[22.564771, "o", "    12\t            if (++spins > 12000000) break;\r\n    13\t        }\r\n    14\t        return a;\r\n    15\t    }\r\n    16\t}\r\n"]
[22.564862, "o", "--- /app/hopcue/Hopper.java ---\r\n"]
[22.565681, "o", "     1\tpublic class Hopper {\r\n     2\t    public static void feed(Tarn t, int w) {\r\n     3\t        t.copy = w;\r\n     4\t    }\r\n     5\t}\r\n"]
[22.565857, "o", "--- /app/watchbay/Glue.java ---\r\n"]
[22.566619, "o", "     1\tpublic class Glue {\r\n     2\t    public static int haul(Tarn t, int w) throws Exception {\r\n     3\t        Thread th = new Thread(() -> {\r\n     4\t            while (t.waiting == 0) {\r\n     5\t                Thread.onSpinWait();\r\n"]
[22.566647, "o", "     6\t            }\r\n     7\t            Hopper.feed(t, w);\r\n     8\t        });\r\n     9\t        if (w >= 8000) {\r\n    10\t            return t.mira();\r\n    11\t        }\r\n    12\t        th.start();\r\n"]
[22.566662, "o", "    13\t        int a = t.mira();\r\n    14\t        th.join();\r\n    15\t        return a;\r\n    16\t    }\r\n    17\t}\r\n"]
[22.566833, "o", "--- /app/watchbay/ShipMain.java ---\r\n"]
[22.567811, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.zip.ZipFile;\r\n     6\t\r\n     7\tpublic class ShipMain {\r\n     8\t    public static int rib_n(String[] a) throws Exception {\r\n     9\t        Path bag = Paths.get(a[0]);\r\n    10\t        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n    11\t        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n"]
[22.567965, "o", "    12\t        Tarn t = new Tarn();\r\n    13\t        int seen = Glue.haul(t, w);\r\n    14\t        String name = bag.getFileName().toString();\r\n    15\t        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n    16\t        Files.createDirectories(out.getParent());\r\n    17\t        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n    18\t        return 0;\r\n    19\t    }\r\n    20\t\r\n    21\t    public static void main(String[] a) throws Exception {\r\n    22\t        System.exit(rib_n(a));\r\n    23\t    }\r\n    24\t\r\n    25\t    static boolean lid_q() {\r\n    26\t        try {\r\n    27\t            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\r\n    28\t            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\r\n    29\t                var e = z.getEntry(\"STAMP\");\r\n    30\t                if (e == null) {\r\n    31\t                    return false;\r\n    32\t                }\r\n    33\t                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\r\n    34\t                return want.equals(got);\r\n    35\t            }\r\n    36\t        } catch (Exception ex) {\r\n    37\t            return false;\r\n    38\t        }\r\n    39\t    }\r\n    40\t}\r\n"]
[22.568325, "o", "--- /app/draftcue/DraftMain.java ---\r\n"]
[22.570453, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\t\r\n     6\tpublic class DraftMain {\r\n     7\t    public static void main(String[] a) throws Exception {\r\n     8\t        Path bag = Paths.get(a[0]);\r\n     9\t        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n    10\t        Tarn t = new Tarn();\r\n    11\t        Hopper.feed(t, w);\r\n    12\t        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n    13\t        String name = bag.getFileName().toString();\r\n    14\t        String body = \"{\\\"seen\\\":\" + t.copy + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n    15\t        Files.createDirectories(out.getParent());\r\n    16\t        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n    17\t    }\r\n    18\t}\r\n--- /app/kilnrib/KilnShip.java ---\r\n"]
[22.571659, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\timport java.util.stream.Stream;\r\n"]
[22.572127, "o", "     5\t\r\n     6\tpublic class KilnShip {\r\n     7\t    public static void main(String[] a) throws Exception {\r\n     8\t        Path src = Paths.get(a[0]);\r\n     9\t        Path dst = Paths.get(a[1]);\r\n    10\t        Files.createDirectories(dst);\r\n    11\t        int n = 0;\r\n    12\t        try (Stream<Path> walk = Files.walk(src)) {\r\n    13\t            for (Path p : walk.filter(x -> x.toString().endsWith(\".java\")).toList()) {\r\n    14\t                String rel = src.relativize(p).toString();\r\n    15\t                String s = Files.readString(p);\r\n    16\t                String out = tighten(s);\r\n    17\t                if (!out.equals(s)) {\r\n    18\t                    n++;\r\n    19\t                }\r\n    20\t                Path q = dst.resolve(rel);\r\n    21\t                Files.createDirectories(q.getParent());\r\n    22\t                Files.writeString(q, out);\r\n    23\t            }\r\n    24\t        }\r\n    25\t        Path stamp = Paths.get(\"/app/jarhearth/STAMP.body\");\r\n    26\t        Files.createDirectories(stamp.getParent());\r\n    27\t        Files.writeString(stamp, Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim() + \"\\n\");\r\n    28\t        String rill = Files.readString(dst.resolve(\"Rill.java\"));\r\n    29\t        if (rill.contains(\"while (a == 0)\")) {\r\n    30\t            System.err.println(\"rill wait still packed\");\r\n    31\t            System.exit(3);\r\n    32\t        }\r\n    33\t        if (n < 1) {\r\n    34\t            System.exit(4);\r\n    35\t        }\r\n    36\t    }\r\n    37\t\r\n    38\t    static String tighten(String s) {\r\n    39\t        String out = s;\r\n    40\t        if (!out.contains(\"volatile int keld\")) {\r\n    41\t            out = out.replaceAll(\r\n    42\t                \"while \\\\(a == 0\\\\) \\\\{\\\\s*a = keld;\\\\s*if \\\\(\\\\+\\\\+spins > 12000000\\\\) break;\\\\s*}\",\r\n    43\t                \"/* packed-wait */\");\r\n    44\t            out = out.replaceAll(\"while \\\\(a == 0\\\\) \\\\{\\\\s*a = keld;\\\\s*}\", \"/* packed-wait */\");\r\n    45\t        }\r\n    46\t        if (!out.contains(\"volatile int nub\")) {\r\n    47\t            out = out.replaceAll(\"while \\\\(a == 0\\\\) \\\\{\\\\s*a = nub;\\\\s*}\", \"/* packed-wait */\");\r\n    48\t        }\r\n    49\t        out = out.replace(\"kiln-rib\", \"packed-rib\");\r\n    50\t        return out;\r\n    51\t    }\r\n    52\t}\r\n"]
