[12.985322, "i", "printf '%s\\n' '--- ROUTE ---'; cat /app/opslip/ROUTE.txt; printf '%s\\n' '--- VERBS ---'; cat /app/opslip/VERBS.txt; printf '%s\\n' '--- CARD ---'; cat /app/opslip/CARD.txt; printf '%s\\n' '--- MARK ---'; cat /app/opslip/MARK.txt; printf '%s\\n' '--- NOTES ---'; find /app/opslip -maxdepth 1 -type f -not -name 'ROUTE.txt' -not -name 'VERBS.txt' -not -name 'CARD.txt' -not -name 'MARK.txt' -print -exec sh -c 'echo --- $1; cat \"$1\"' sh {} \\;\n"]
