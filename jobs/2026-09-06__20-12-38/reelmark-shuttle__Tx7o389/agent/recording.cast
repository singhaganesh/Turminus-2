[68.680954, "i", "cat > /app/cd/flr/xin.c <<'EOF'\n#include \"xin.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nextern int suggest_floor(void);\n\nstatic int only_newline(const char *s, int used)\n{\n    while (s[used] == ' ' || s[used] == '\\t' || s[used] == '\\r')\n        used++;\n    return s[used] == '\\n' || s[used] == '\\0';\n}\n\nstatic int valid_stamp(const char *s)\n{\n    size_t i;\n    if (strlen(s) != 8)\n        return 0;\n    for (i = 0; i < 8; i++)\n        if (!isdigit((unsigned char)s[i]) && !(s[i] >= 'a' && s[i] <= 'f'))\n            return 0;\n    return 1;\n}\n\nint xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)\n{\n    FILE *fp;\n    char line[256], stamp[32], name[64], cls[32];\n    int mark, id, used, rows = 0;\n\n    if (path == NULL || stamp_out == NULL || stamp_cap < 9)\n        return 1;\n    fp = fopen(path, \"r\");\n    if (fp == NULL)\n        return 1;\n\n    if (fgets(line, sizeof(line), fp) == NULL || strcmp(line, \"REEL\\n\") != 0)\n        goto bad;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"MARK %d%n\", &mark, &used) != 1 || !only_newline(line, used) ||\n        mark != suggest_floor())\n        goto bad;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"STAMP %31s%n\", stamp, &used) != 1 || !only_newline(line, used) ||\n        !valid_stamp(stamp))\n        goto bad;\n\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (sscanf(line, \"CALL %63s %d %31s%n\", name, &id, cls, &used) != 3 ||\n            !only_newline(line, used) || strcmp(cls, \"live\") != 0)\n            goto bad;\n        rows++;\n    }\n    if (ferror(fp) || rows == 0)\n        goto bad;\n    fclose(fp);\n\n    if (mark_out != NULL)\n        *mark_out = mark;\n    memcpy(stamp_out, stamp, 9);\n    return 0;\n\nbad:\n    fclose(fp);\n    return 1;\n}\nEOF\ncat > /app/ef/ply/sel.c <<'EOF'\n#include \"sel.h\"\n\nint sel_bank(int admit_rc)\n{\n    return admit_rc == 0 ? 0 : 1;\n}\nEOF\n"]
