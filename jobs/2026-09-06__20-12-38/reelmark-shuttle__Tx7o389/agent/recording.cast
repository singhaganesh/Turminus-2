[8.846932, "o", "\u001b[?2004hroot@5df34d6ac9a3:/app# "]
[9.499838, "i", "printf '%s\\n' '--- INPUTS AND STATE ---'; for f in /app/tapewell/desc/calls.lst /app/tapewell/spools/splice.reel /app/tapewell/spools/open.reel /app/tapewell/spools/held.reel /app/tapewell/fixtures/stale.tbl /app/emitwell/knit/capset.tbl /app/emitwell/knit/knit.ok /app/reelcli/run/accept.ok /app/reelcli/run/loaded.set; do echo \"### $f\"; if [ -e \"$f\" ]; then cat \"$f\"; else echo '(absent)'; fi; done\n"]
[9.501829, "o", "printf '%s\\n' '--- INPUTS AND STATE ---'; for f in /app/tapewell/desc/calls.lst /app/tapewell/spools/splice.reel /app/tapewell/spools/open.reel /app/tapewell/spools/held.reel /app/tapewell/fixtures/stale.tbl /app/emitwell/knit/capset.tbl /app/emitwell/knit/knit.ok /app/reelcli/run/accept.ok /app/reelcli/run/loaded.set; do echo \"### $f\"; if [ -e \"$f\" ]; then cat \"$f\"; else echo '(absent)'; fi; done\r\n\u001b[?2004l\r"]
[9.502384, "o", "--- INPUTS AND STATE ---\r\n### /app/tapewell/desc/calls.lst\r\n"]
[9.506351, "o", "sys_read 0\r\nsys_write 1\r\nsys_openat2 257\r\nsys_loom_splice 441\r\nsys_held_pair 500\r\n### /app/tapewell/spools/splice.reel\r\n"]
[9.507709, "o", "sys_loom_splice\r\n"]
