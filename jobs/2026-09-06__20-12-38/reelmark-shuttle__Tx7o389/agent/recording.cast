[29.037948, "o", "     1\t#include <stdio.h>\r\n     2\t#include <string.h>\r\n     3\t\r\n     4\tint cmd_pour(void);\r\n     5\tint cmd_spin(int argc, char **argv);\r\n     6\t\r\n     7\tint main(int argc, char **argv)\r\n     8\t{\r\n     9\t    if (argc < 2) {\r\n    10\t        fprintf(stderr, \"usage: nockreel pour|spin ...\\n\");\r\n    11\t        return 2;\r\n    12\t    }\r\n    13\t    if (strcmp(argv[1], \"pour\") == 0) {\r\n    14\t        return cmd_pour();\r\n    15\t    }\r\n    16\t    if (strcmp(argv[1], \"spin\") == 0) {\r\n    17\t        return cmd_spin(argc - 2, argv + 2);\r\n    18\t    }\r\n    19\t    fprintf(stderr, \"unknown subcommand\\n\");\r\n    20\t    return 2;\r\n    21\t}\r\n"]
