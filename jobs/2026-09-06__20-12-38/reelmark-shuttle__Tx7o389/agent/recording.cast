[29.37148, "o", "/app/ab/common.h:4:#define STAMP_LEN 8\r\n/app/ab/common.h:12:#define LOADED_SET_PATH \"/app/reelcli/run/loaded.set\"\r\n/app/ab/common.h:13:#define ACCEPT_PATH \"/app/reelcli/run/accept.ok\"\r\n"]
