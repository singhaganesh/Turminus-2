[17.627933, "i", "printf '%s\\n' '--- SYMBOLS ---'; nm --defined-only /app/bin/nockreel | sort; printf '%s\\n' '--- BASELINE SPINS ---'; for r in splice open held; do echo \"### $r\"; /app/bin/nockreel spin \"/app/tapewell/spools/$r.reel\"; echo \"rc=$?\"; done; echo '### stale blob'; /app/bin/nockreel spin --blob /app/tapewell/fixtures/stale.tbl /app/tapewell/spools/open.reel; echo \"rc=$?\"; echo '### run state'; find /app/reelcli/run -maxdepth 1 -type f -print -exec sh -c 'cat \"$1\"; echo' _ {} \\; 2>/dev/null || true\n"]
