[29.030719, "o", "     1\t#include \"stock.h\"\r\n     2\t\r\n     3\t#include <string.h>\r\n     4\t\r\n     5\tint stock_has(const char *name)\r\n     6\t{\r\n     7\t    static const char *rows[] = {\"sys_read\", \"sys_write\", NULL};\r\n     8\t    int i;\r\n     9\t\r\n    10\t    if (name == NULL) {\r\n    11\t        return 0;\r\n    12\t    }\r\n    13\t    for (i = 0; rows[i] != NULL; i++) {\r\n    14\t        if (strcmp(rows[i], name) == 0) {\r\n    15\t            return 1;\r\n    16\t        }\r\n    17\t    }\r\n    18\t    return 0;\r\n    19\t}\r\n"]
