[29.043224, "o", "    97\t    } else {\r\n    98\t        covered = stock_has(call);\r\n    99\t        prefix = \"builtin:\";\r\n   100\t        snprintf(stamp, sizeof(stamp), \"stock\");\r\n   101\t    }\r\n   102\t    st = covered ? \"replayed\" : \"unsupported\";\r\n   103\t    printf(\"{\\\"loaded\\\":\\\"%s%s\\\",\\\"status\\\":\\\"%s\\\",\\\"call\\\":\\\"%s\\\"}\\n\",\r\n   104\t           prefix, stamp, st, call);\r\n   105\t    fp = fopen(LOADED_SET_PATH, \"w\");\r\n   106\t    if (fp != NULL) {\r\n   107\t        fprintf(fp, \"%s%s\\n\", prefix, stamp);\r\n   108\t        fclose(fp);\r\n   109\t    }\r\n   110\t    if (admit_rc == 0 && bank == 0) {\r\n   111\t        fp = fopen(ACCEPT_PATH, \"w\");\r\n   112\t        if (fp != NULL) {\r\n   113\t            fputs(\"1\\n\", fp);\r\n   114\t            fclose(fp);\r\n   115\t        }\r\n   116\t    }\r\n   117\t    (void)mark;\r\n   118\t    return 0;\r\n   119\t}\r\n\u001b[?2004hroot@5df34d6ac9a3:/app# "]
