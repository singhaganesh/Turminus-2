[9.50994, "o", "### /app/tapewell/spools/held.reel\r\n"]
[9.511353, "o", "sys_held_pair\r\n"]
[9.511583, "o", "### /app/tapewell/fixtures/stale.tbl\r\n"]
[9.512807, "o", "REEL\r\nMARK 2\r\nSTAMP deadbeef\r\nCALL sys_openat2 257 live\r\n"]
[9.513018, "o", "### /app/emitwell/knit/capset.tbl\r\n"]
