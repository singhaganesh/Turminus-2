#define XIN_H

#include <stddef.h>

int xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap);

#endif

### /app/ef/ply/sel.c
#include "sel.h"

int sel_bank(int admit_rc)
{
    (void)admit_rc;
    return 1;
}

### /app/ef/ply/sel.h
