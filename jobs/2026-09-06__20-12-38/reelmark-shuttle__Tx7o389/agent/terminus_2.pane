Field notes from the last lab rotation.

Some pourers still emit older MARK blobs. This bench still needs spin to
refuse fixtures under /app/tapewell/fixtures when the blob cannot be interpreted.

Linked hull also defines sel_bank; `nm --defined-only /app/bin/nockreel` lists it.

--- MAKEFILE ---
CC ?= gcc
CFLAGS ?= -O2 -Wall -Wextra -I../ab -I../ab/knt -I../ab/tgw -I../cd/flr -I../ef/ply
SRC := cli/main.c cli/pour.c cli/spin.c \
	../ef/ply/sel.c \
	../ef/ply/stock.c \
	../cd/flr/xin.c \
	../cd/flr/compat.c \
	../ab/knt/hdr_write.c \
	../ab/knt/rows_write.c \
	../ab/knt/mix.c \
	../ab/tgw/note_write.c
BIN := /app/bin/nockreel

.PHONY: hull
hull:
	mkdir -p /app/bin /app/emitwell/knit /app/reelcli/run
	$(CC) $(CFLAGS) -o $(BIN) $(SRC)

### /app/ab/common.h
#ifndef NOCKBIN_COMMON_H
#define NOCKBIN_COMMON_H

#define STAMP_LEN 8
#define NAME_LEN 64
#define LINE_LEN 256
#define MAX_ROWS 128

#define DESC_PATH "/app/tapewell/desc/calls.lst"
#define CAPSET_PATH "/app/emitwell/knit/capset.tbl"
#define KNIT_OK_PATH "/app/emitwell/knit/knit.ok"
#define LOADED_SET_PATH "/app/reelcli/run/loaded.set"
#define ACCEPT_PATH "/app/reelcli/run/accept.ok"

#endif

### /app/ab/knt/hdr_write.c
#include "hdr_write.h"

#include <stdio.h>

int write_hdr(FILE *fp, const char *stamp)
{
    const int mark_now = 2;

    if (fp == NULL || stamp == NULL) {
        return -1;
    }
    if (fprintf(fp, "REEL\n") < 0) {
        return -1;
    }
    if (fprintf(fp, "MARK %d\n", mark_now) < 0) {
        return -1;
    }
    if (fprintf(fp, "STAMP %s\n", stamp) < 0) {
        return -1;
    }
    return 0;
}

### /app/ab/knt/hdr_write.h
#ifndef HDR_WRITE_H
#define HDR_WRITE_H

#include <stdio.h>

int write_hdr(FILE *fp, const char *stamp);

#endif

### /app/ab/knt/mix.c
#include "mix.h"

#include <stdio.h>
#include <stdint.h>

int mix_tag(const char *path, char *out, unsigned out_len)
{
    FILE *fp;
    uint32_t h = 2166136261u;
    int c;

    if (path == NULL || out == NULL || out_len < 9) {
        return -1;
    }
    fp = fopen(path, "r");
    if (fp == NULL) {
        return -1;
    }
    while ((c = fgetc(fp)) != EOF) {
        h ^= (unsigned char)c;
        h *= 16777619u;
    }
    fclose(fp);
    if (snprintf(out, out_len, "%08x", h) < 0) {
        return -1;
    }
    return 0;
}

### /app/ab/knt/mix.h
#ifndef MIX_H
#define MIX_H

int mix_tag(const char *path, char *out, unsigned out_len);

#endif

### /app/ab/knt/rows_write.c
#include "rows_write.h"

#include <stdio.h>
#include <string.h>

int write_rows(FILE *out, const char *desc_path)
{
    FILE *fp;
    char line[256];
    char name[64];
    int id;

    if (out == NULL || desc_path == NULL) {
        return -1;
    }
    fp = fopen(desc_path, "r");
    if (fp == NULL) {
        return -1;
    }
    while (fgets(line, sizeof(line), fp) != NULL) {
        if (line[0] == '#' || line[0] == '\n') {
            continue;
        }
        if (sscanf(line, "%63s %d", name, &id) != 2) {
            continue;
        }
        if (fprintf(out, "CALL %s %d live\n", name, id) < 0) {
            fclose(fp);
            return -1;
        }
    }
    fclose(fp);
    return 0;
}

### /app/ab/knt/rows_write.h
#ifndef ROWS_WRITE_H
#define ROWS_WRITE_H

#include <stdio.h>

int write_rows(FILE *out, const char *desc_path);

#endif

### /app/ab/tgw/note_write.c
#include "note_write.h"

#include <stdio.h>

int write_note(const char *path, const char *stamp)
{
    FILE *fp;

    if (path == NULL || stamp == NULL) {
        return -1;
    }
    fp = fopen(path, "w");
    if (fp == NULL) {
        return -1;
    }
    if (fprintf(fp, "%s\n", stamp) < 0) {
        fclose(fp);
        return -1;
    }
    fclose(fp);
    return 0;
}

### /app/ab/tgw/note_write.h
