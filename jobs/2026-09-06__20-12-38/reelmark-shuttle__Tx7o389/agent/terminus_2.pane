     8	
     9	int cmd_pour(void)
    10	{
    11	    char stamp[STAMP_LEN + 1];
    12	    FILE *fp;
    13	
    14	    if (mix_tag(DESC_PATH, stamp, sizeof(stamp)) != 0) {
    15	        return 1;
    16	    }
    17	    fp = fopen(CAPSET_PATH, "w");
    18	    if (fp == NULL) {
    19	        return 1;
    20	    }
    21	    if (write_hdr(fp, stamp) != 0) {
    22	        fclose(fp);
    23	        return 1;
    24	    }
    25	    if (write_rows(fp, DESC_PATH) != 0) {
    26	        fclose(fp);
    27	        return 1;
    28	    }
    29	    fclose(fp);
    30	    if (write_note(KNIT_OK_PATH, stamp) != 0) {
    31	        return 1;
    32	    }
    33	    return 0;
    34	}
### /app/reelcli/cli/spin.c
     1	#include "common.h"
     2	#include "sel.h"
     3	#include "stock.h"
