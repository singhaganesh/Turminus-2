Sending keys: ['cat > /app/reelcli/cli/spin.c <<\'EOF\'\n#include "common.h"\n#include "sel.h"\n#include "xin.h"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int trailing_space_only(const char *s, int used)\n{\n    while (s[used] != \'\\0\') {\n        if (!isspace((unsigned char)s[used]))\n            return 0;\n        used++;\n    }\n    return 1;\n}\n\nstatic int blob_has(const char *path, const char *name)\n{\n    FILE *fp = fopen(path, "r");\n    char line[LINE_LEN], row_name[NAME_LEN], cls[32];\n    int id, used;\n\n    if (fp == NULL)\n        return 0;\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (sscanf(line, "CALL %63s %d %31s%n", row_name, &id, cls, &used) == 3 &&\n            trailing_space_only(line, used) && strcmp(cls, "live") == 0 &&\n            strcmp(row_name, name) == 0) {\n            fclose(fp);\n            return 1;\n        }\n    }\n    fclose(fp);\n    return 0;\n}\n\nstatic int read_spool_call(const char *path, char *name, unsigned name_len)\n{\n    FILE *fp;\n    char line[LINE_LEN], extra[2];\n\n    fp = fopen(path, "r");\n    if (fp == NULL)\n        return -1;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, "%63s %1s", name, extra) != 1 || strlen(name) >= name_len) {\n        fclose(fp);\n        return -1;\n    }\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        char *p = line;\n        while (*p != \'\\0\') {\n            if (!isspace((unsigned char)*p++)) {\n                fclose(fp);\n                return -1;\n            }\n        }\n    }\n    fclose(fp);\n    return 0;\n}\n\nstatic int read_knit_stamp(char *stamp, size_t cap)\n{\n    FILE *fp;\n    char line[64], extra[2];\n    size_t i;\n\n    fp = fopen(KNIT_OK_PATH, "r");\n    if (fp == NULL)\n        return -1;\n    if (fgets(line, sizeof(line), fp) == NULL) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    if (sscanf(line, "%8s %1s", stamp, extra) != 1 || strlen(stamp) != STAMP_LEN || cap < 9)\n        return -1;\n    for (i = 0; i < STAMP_LEN; i++)\n        if (!isdigit((unsigned char)stamp[i]) && !(stamp[i] >= \'a\' && stamp[i] <= \'f\'))\n            return -1;\n    return 0;\n}\n\nint cmd_spin(int argc, char **argv)\n{\n    const char *blob = CAPSET_PATH;\n    const char *spool;\n    char call[NAME_LEN], stamp[STAMP_LEN + 1], knit_stamp[STAMP_LEN + 1];\n    char loaded[32];\n    const char *status;\n    int mark = 0, covered;\n    FILE *fp;\n\n    unlink(ACCEPT_PATH);\n    if (argc == 1) {\n        spool = argv[0];\n    } else if (argc == 3 && strcmp(argv[0], "--blob") == 0) {\n        blob = argv[1];\n        spool = argv[2];\n    } else {\n        fprintf(stderr, "usage: nockreel spin [--blob PATH] SPOOL\\n");\n        return 2;\n    }\n\n    if (read_spool_call(spool, call, sizeof(call)) != 0)\n        return 2;\n    if (xin_blob(blob, &mark, stamp, sizeof(stamp)) != 0 || sel_bank(0) != 0 ||\n        read_knit_stamp(knit_stamp, sizeof(knit_stamp)) != 0 ||\n        strcmp(stamp, knit_stamp) != 0) {\n        return 1;\n    }\n\n    covered = blob_has(blob, call);\n    status = covered ? "replayed" : "unsupported";\n    snprintf(loaded, sizeof(loaded), "table:%s", knit_stamp);\n    printf("{\\"loaded\\":\\"%s\\",\\"status\\":\\"%s\\",\\"call\\":\\"%s\\"}\\n",\n           loaded, status, call);\n\n    fp = fopen(LOADED_SET_PATH, "w");\n    if (fp == NULL)\n        return 1;\n    if (fprintf(fp, "%s\\n", loaded) < 0 || fclose(fp) != 0)\n        return 1;\n    fp = fopen(ACCEPT_PATH, "w");\n    if (fp == NULL)\n        return 1;\n    if (fputs("1\\n", fp) == EOF || fclose(fp) != 0) {\n        unlink(ACCEPT_PATH);\n        return 1;\n    }\n    (void)mark;\n    return 0;\n}\nEOF\nmake -C /app/reelcli hull\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
