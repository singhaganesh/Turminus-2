[10.668424, "i", "printf '%s\\n' '--- calls ---'; cat /app/tapewell/desc/calls.lst; printf '%s\\n' '--- reels/fixtures ---'; for f in /app/tapewell/spools/* /app/tapewell/fixtures/*; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- existing knit/run ---'; find /app/emitwell/knit /app/reelcli/run -maxdepth 1 -type f -print -exec sh -c 'cat \"$1\"; echo' _ {} \\;\n"]
[10.669751, "o", "printf '%s\\n' '--- calls ---'; cat /app/tapewell/desc/calls.lst; printf '%s\\n' '--- reels/fixtures ---'; for f in /app/tapewell/spools/* /app/tapewell/fixtures/*; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- existing knit/run ---'; find /app/emitwell/knit /app/reelcli/run -maxdepth 1 -type f -print -exec sh -c 'cat \"$1\"; echo' _ {} \\;\r\n\u001b[?2004l\r"]
