[9.920908, "i", "printf '%s\\n' '--- GRAMMAR ---'; cat /app/fieldpack/GRAMMAR.txt; printf '%s\\n' '--- CLI ---'; cat /app/fieldpack/CLI.txt; printf '%s\\n' '--- ROUTE MAP ---'; cat /app/fieldpack/ROUTE_MAP.txt; printf '%s\\n' '--- HULL ---'; cat /app/reelcli/HULL.txt\n"]
[9.922197, "o", "printf '%s\\n' '--- GRAMMAR ---'; cat /app/fieldpack/GRAMMAR.txt; printf '%s\\n' '--- CLI ---'; cat /app/fieldpack/CLI.txt; printf '%s\\n' '--- ROUTE MAP ---'; cat /app/fieldpack/ROUTE_MAP.txt; printf '%s\\n' '--- HULL ---'; cat /app/reelcli/HULL.txt\r\n\u001b[?2004l\r--- GRAMMAR ---\r\n"]
[9.923212, "o", "capset.tbl line grammar\r\n\r\nREEL\r\nMARK <integer>\r\nSTAMP <8 lowercase hex>\r\nCALL <name> <id> <class>\r\n\r\nPoured rows use class token live.\r\n\r\nspin prints one JSON object with string keys loaded, status, and call.\r\nloaded is table: plus the STAMP value when the poured blob is used.\r\nloaded is builtin: plus a stock token when compiled-in names are used.\r\nstatus is replayed when the active name set covers the spool call.\r\nA spool file is a single token: the call name.\r\nopen.reel is sys_openat2. held.reel is sys_held_pair. splice.reel is sys_loom_splice.\r\n"]
[9.923484, "o", "--- CLI ---\r\n"]
[9.924616, "o", "spin extra flags\r\n\r\n--blob PATH   use PATH instead of /app/emitwell/knit/capset.tbl\r\n\r\nHull name xin_blob stays in the linked nockreel image (`nm --defined-only`).\r\n"]
[9.924901, "o", "--- ROUTE MAP ---\r\n"]
[9.926235, "o", "pour / spin wiring (internal)\r\n\r\nModules linked by `make -C /app/reelcli hull`:\r\n  header writer under /app/ab\r\n  row writer under /app/ab\r\n  stamp note under /app/ab\r\n  blob admit under /app/cd\r\n  name bank under /app/ef\r\n  CLI under /app/reelcli/cli\r\n\r\nGrammar: /app/fieldpack/GRAMMAR.txt\r\nFlags: /app/fieldpack/CLI.txt\r\n"]
[9.927081, "o", "--- HULL ---\r\n"]
[9.92796, "o", "reelcli sources. `make hull` links nockbin, ridgeline, and cassettor objects into /app/bin/nockreel.\r\n\r\n/app/bin/nockreel is a native ELF image (first four bytes 0x7f 'E' 'L' 'F'). A shebang script is not the hull.\r\n\r\n`nm --defined-only /app/bin/nockreel` lists write_hdr among defined text names.\r\n"]
[9.928208, "o", "\u001b[?2004h"]
[9.928293, "o", "root@64cc01a7428f:/app# "]
