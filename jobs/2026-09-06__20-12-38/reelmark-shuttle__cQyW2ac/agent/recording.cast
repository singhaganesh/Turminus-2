[18.322627, "i", "printf '%s\\n' '--- Makefile ---'; nl -ba /app/reelcli/Makefile; printf '%s\\n' '--- LAB ---'; cat /app/fieldpack/LAB.txt; printf '%s\\n' '--- README ---'; cat /app/emitwell/README.txt\n"]
[18.32322, "o", "printf '%s\\n' '--- Makefile ---'; nl -ba /app/reelcli/Makefile; printf '%s\\n' '--- LAB ---'; cat /app/fieldpack/LAB.txt; printf '%s\\n' '--- README ---'; cat /app/emitwell/README.txt\r\n\u001b[?2004l\r"]
[18.323341, "o", "--- Makefile ---\r\n"]
[18.325472, "o", "     1\tCC ?= gcc\r\n     2\tCFLAGS ?= -O2 -Wall -Wextra -I../ab -I../ab/knt -I../ab/tgw -I../cd/flr -I../ef/ply\r\n     3\tSRC := cli/main.c cli/pour.c cli/spin.c \\\r\n     4\t\t../ef/ply/sel.c \\\r\n     5\t\t../ef/ply/stock.c \\\r\n     6\t\t../cd/flr/xin.c \\\r\n     7\t\t../cd/flr/compat.c \\\r\n"]
[18.32568, "o", "     8\t\t../ab/knt/hdr_write.c \\\r\n     9\t\t../ab/knt/rows_write.c \\\r\n    10\t\t../ab/knt/mix.c \\\r\n    11\t\t../ab/tgw/note_write.c\r\n    12\tBIN := /app/bin/nockreel\r\n    13\t\r\n    14\t.PHONY: hull\r\n    15\thull:\r\n    16\t\tmkdir -p /app/bin /app/emitwell/knit /app/reelcli/run\r\n    17\t\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[18.325775, "o", "--- LAB ---\r\n"]
[18.32695, "o", "Field notes from the last lab rotation.\r\n\r\nSome pourers still emit older MARK blobs. This bench still needs spin to\r\nrefuse fixtures under /app/tapewell/fixtures when the blob cannot be interpreted.\r\n\r\nLinked hull also defines sel_bank; `nm --defined-only /app/bin/nockreel` lists it.\r\n\r\n"]
[18.327186, "o", "--- README ---\r\n"]
[18.328473, "o", "placeholder knit directory; pour writes capset.tbl and knit.ok here\r\n"]
[18.328703, "o", "\u001b[?2004hroot@64cc01a7428f:/app# "]
[18.48915, "i", "for f in /app/ab/common.h /app/ab/knt/*.[ch] /app/ab/tgw/*.[ch] /app/cd/flr/*.[ch] /app/ef/ply/*.[ch] /app/reelcli/cli/*.c; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[18.489895, "o", "for f in /app/ab/common.h /app/ab/knt/*.[ch] /app/ab/tgw/*.[ch] /app/cd/flr/*.[ch] /app/ef/ply/*.[ch] /app/reelcli/cli/*.c; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[18.492941, "o", "===== /app/ab/common.h =====\r\n"]
[18.494037, "o", "     1\t#ifndef NOCKBIN_COMMON_H\r\n     2\t#define NOCKBIN_COMMON_H\r\n     3\t\r\n     4\t#define STAMP_LEN 8\r\n     5\t#define NAME_LEN 64\r\n     6\t#define LINE_LEN 256\r\n     7\t#define MAX_ROWS 128\r\n     8\t\r\n     9\t#define DESC_PATH \"/app/tapewell/desc/calls.lst\"\r\n    10\t#define CAPSET_PATH \"/app/emitwell/knit/capset.tbl\"\r\n    11\t#define KNIT_OK_PATH \"/app/emitwell/knit/knit.ok\"\r\n    12\t#define LOADED_SET_PATH \"/app/reelcli/run/loaded.set\"\r\n"]
[18.494196, "o", "    13\t#define ACCEPT_PATH \"/app/reelcli/run/accept.ok\"\r\n    14\t\r\n    15\t#endif\r\n"]
[18.494322, "o", "===== /app/ab/knt/hdr_write.c =====\r\n"]
[18.495291, "o", "     1\t#include \"hdr_write.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t\r\n     5\tint write_hdr(FILE *fp, const char *stamp)\r\n     6\t{\r\n     7\t    const int mark_now = 2;\r\n     8\t\r\n     9\t    if (fp == NULL || stamp == NULL) {\r\n    10\t        return -1;\r\n    11\t    }\r\n    12\t    if (fprintf(fp, \"REEL\\n\") < 0) {\r\n    13\t        return -1;\r\n    14\t    }\r\n    15\t    if (fprintf(fp, \"MARK %d\\n\", mark_now) < 0) {\r\n"]
[18.495403, "o", "    16\t        return -1;\r\n    17\t    }\r\n    18\t    if (fprintf(fp, \"STAMP %s\\n\", stamp) < 0) {\r\n    19\t        return -1;\r\n    20\t    }\r\n    21\t    return 0;\r\n    22\t}\r\n"]
[18.495544, "o", "===== /app/ab/knt/hdr_write.h =====\r\n"]
[18.49646, "o", "     1\t#ifndef HDR_WRITE_H\r\n     2\t#define HDR_WRITE_H\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t\r\n     6\tint write_hdr(FILE *fp, const char *stamp);\r\n     7\t\r\n     8\t#endif\r\n"]
[18.496692, "o", "===== /app/ab/knt/mix.c =====\r\n"]
[18.497486, "o", "     1\t#include \"mix.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdint.h>\r\n     5\t\r\n     6\tint mix_tag(const char *path, char *out, unsigned out_len)\r\n"]
[18.49758, "o", "     7\t{\r\n     8\t    FILE *fp;\r\n     9\t    uint32_t h = 2166136261u;\r\n    10\t    int c;\r\n    11\t\r\n    12\t    if (path == NULL || out == NULL || out_len < 9) {\r\n    13\t        return -1;\r\n    14\t    }\r\n    15\t    fp = fopen(path, \"r\");\r\n    16\t    if (fp == NULL) {\r\n    17\t        return -1;\r\n    18\t    }\r\n    19\t    while ((c = fgetc(fp)) != EOF) {\r\n    20\t        h ^= (unsigned char)c;\r\n    21\t        h *= 16777619u;\r\n    22\t    }\r\n    23\t    fclose(fp);\r\n    24\t    if (snprintf(out, out_len, \"%08x\", h) < 0) {\r\n    25\t        return -1;\r\n    26\t    }\r\n    27\t    return 0;\r\n    28\t}\r\n"]
[18.497708, "o", "===== /app/ab/knt/mix.h =====\r\n"]
[18.498487, "o", "     1\t#ifndef MIX_H\r\n     2\t#define MIX_H\r\n     3\t\r\n     4\tint mix_tag(const char *path, char *out, unsigned out_len);\r\n     5\t\r\n     6\t#endif\r\n"]
[18.498659, "o", "===== /app/ab/knt/rows_write.c =====\r\n"]
[18.499514, "o", "     1\t#include \"rows_write.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint write_rows(FILE *out, const char *desc_path)\r\n     7\t{\r\n"]
[18.499601, "o", "     8\t    FILE *fp;\r\n     9\t    char line[256];\r\n    10\t    char name[64];\r\n    11\t    int id;\r\n    12\t\r\n    13\t    if (out == NULL || desc_path == NULL) {\r\n    14\t        return -1;\r\n    15\t    }\r\n    16\t    fp = fopen(desc_path, \"r\");\r\n    17\t    if (fp == NULL) {\r\n    18\t        return -1;\r\n    19\t    }\r\n    20\t    while (fgets(line, sizeof(line), fp) != NULL) {\r\n    21\t        if (line[0] == '#' || line[0] == '\\n') {\r\n    22\t            continue;\r\n    23\t        }\r\n    24\t        if (sscanf(line, \"%63s %d\", name, &id) != 2) {\r\n    25\t            continue;\r\n    26\t        }\r\n    27\t        if (fprintf(out, \"CALL %s %d live\\n\", name, id) < 0) {\r\n    28\t            fclose(fp);\r\n    29\t            return -1;\r\n    30\t        }\r\n    31\t    }\r\n    32\t    fclose(fp);\r\n    33\t    return 0;\r\n    34\t}\r\n"]
[18.499819, "o", "===== /app/ab/knt/rows_write.h =====\r\n"]
[18.500676, "o", "     1\t#ifndef ROWS_WRITE_H\r\n     2\t#define ROWS_WRITE_H\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t\r\n     6\tint write_rows(FILE *out, const char *desc_path);\r\n     7\t\r\n     8\t#endif\r\n"]
[18.500949, "o", "===== /app/ab/tgw/note_write.c =====\r\n"]
[18.501854, "o", "     1\t#include \"note_write.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t\r\n     5\tint write_note(const char *path, const char *stamp)\r\n     6\t{\r\n     7\t    FILE *fp;\r\n     8\t\r\n     9\t    if (path == NULL || stamp == NULL) {\r\n    10\t        return -1;\r\n    11\t    }\r\n    12\t    fp = fopen(path, \"w\");\r\n    13\t    if (fp == NULL) {\r\n    14\t        return -1;\r\n    15\t    }\r\n    16\t    if (fprintf(fp, \"%s\\n\", stamp) < 0) {\r\n    17\t        fclose(fp);\r\n    18\t        return -1;\r\n    19\t    }\r\n    20\t    fclose(fp);\r\n    21\t    return 0;\r\n    22\t}\r\n"]
[18.502034, "o", "===== /app/ab/tgw/note_write.h =====\r\n"]
[18.502921, "o", "     1\t#ifndef NOTE_WRITE_H\r\n     2\t#define NOTE_WRITE_H\r\n     3\t\r\n     4\tint write_note(const char *path, const char *stamp);\r\n     5\t\r\n     6\t#endif\r\n"]
[18.503182, "o", "===== /app/cd/flr/compat.c =====\r\n"]
[18.504034, "o", "     1\tint suggest_floor(void)\r\n     2\t{\r\n     3\t    return 2;\r\n     4\t}\r\n"]
[18.504248, "o", "===== /app/cd/flr/xin.c =====\r\n"]
[18.505096, "o", "     1\t#include \"xin.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\t#ifndef BANK_FLOOR\r\n     7\t#define BANK_FLOOR 3\r\n     8\t#endif\r\n     9\t\r\n    10\tint xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)\r\n    11\t{\r\n    12\t    FILE *fp;\r\n    13\t    char line[256];\r\n"]
[18.505207, "o", "    14\t    int mark = 0;\r\n    15\t    char stamp[32];\r\n    16\t    int saw_mark = 0;\r\n    17\t    int saw_stamp = 0;\r\n    18\t\r\n    19\t    stamp[0] = '\\0';\r\n    20\t    if (path == NULL) {\r\n    21\t        return 1;\r\n    22\t    }\r\n    23\t    fp = fopen(path, \"r\");\r\n    24\t    if (fp == NULL) {\r\n    25\t        return 1;\r\n    26\t    }\r\n    27\t    while (fgets(line, sizeof(line), fp) != NULL) {\r\n    28\t        if (strncmp(line, \"MARK \", 5) == 0) {\r\n    29\t            if (sscanf(line + 5, \"%d\", &mark) == 1) {\r\n    30\t                saw_mark = 1;\r\n"]
[18.505302, "o", "    31\t            }\r\n    32\t        } else if (strncmp(line, \"STAMP \", 6) == 0) {\r\n    33\t            if (sscanf(line + 6, \"%31s\", stamp) == 1) {\r\n    34\t                saw_stamp = 1;\r\n    35\t            }\r\n    36\t        }\r\n    37\t    }\r\n    38\t    fclose(fp);\r\n    39\t    if (!saw_mark) {\r\n    40\t        return 1;\r\n    41\t    }\r\n    42\t    if (mark_out != NULL) {\r\n    43\t        *mark_out = mark;\r\n    44\t    }\r\n    45\t    if (stamp_out != NULL && stamp_cap > 0 && saw_stamp) {\r\n    46\t        strncpy(stamp_out, stamp, stamp_cap - 1);\r\n    47\t        stamp_out[stamp_cap - 1] = '\\0';\r\n    48\t    }\r\n    49\t    if (mark < BANK_FLOOR) {\r\n    50\t        return 1;\r\n    51\t    }\r\n    52\t    return 0;\r\n    53\t}\r\n"]
[18.505451, "o", "===== /app/cd/flr/xin.h =====\r\n"]
