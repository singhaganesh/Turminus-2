[77.775288, "i", "python3 - <<'PY'\nimport json, pathlib, subprocess\nP = pathlib.Path\nbinp = '/app/bin/nockreel'\nsubprocess.run([binp, 'pour'], check=True)\nknit = P('/app/emitwell/knit/knit.ok').read_text().strip()\ntable = P('/app/emitwell/knit/capset.tbl').read_text().splitlines()\nassert len(knit) == 8 and all(c in '0123456789abcdef' for c in knit)\nassert table[:3] == ['REEL', 'MARK 3', 'STAMP ' + knit]\ndesc = [line.split() for line in P('/app/tapewell/desc/calls.lst').read_text().splitlines() if line.strip() and not line.lstrip().startswith('#')]\nassert table[3:] == [f'CALL {name} {ident} live' for name, ident in desc]\nfor reel, call in [('splice', 'sys_loom_splice'), ('open', 'sys_openat2'), ('held', 'sys_held_pair')]:\n    cp = subprocess.run([binp, 'spin', f'/app/tapewell/spools/{reel}.reel'], text=True, capture_output=True)\n    assert cp.returncode == 0, (reel, cp.returncode, cp.stderr)\n    assert json.loads(cp.stdout) == {'loaded': 'table:' + knit, 'status': 'replayed', 'call': call}\n    assert P('/app/reelcli/run/accept.ok').read_text().strip() == '1'\n    assert P('/app/reelcli/run/loaded.set').read_text().strip() == 'table:' + knit\nP('/app/reelcli/run/accept.ok').unlink(missing_ok=True)\ncp = subprocess.run([binp, 'spin', '--blob', '/app/tapewell/fixtures/stale.tbl', '/app/tapewell/spools/open.reel'])\nassert cp.returncode != 0\nassert not P('/app/reelcli/run/accept.ok').exists()\nprint('all assertions passed')\nPY\n"]
[77.775556, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
