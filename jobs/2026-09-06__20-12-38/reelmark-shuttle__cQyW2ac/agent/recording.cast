[11.162785, "i", "file /app/bin/nockreel; /app/bin/nockreel pour; echo \"pour_rc=$?\"; for r in splice open held; do echo \"--- spin $r ---\"; /app/bin/nockreel spin \"/app/tapewell/spools/$r.reel\"; echo \"rc=$?\"; done\n"]
[11.163611, "o", "file /app/bin/nockreel; /app/bin/nockreel pour; echo \"pour_rc=$?\"; for r in splice open held; do echo \"--- spin $r ---\"; /app/bin/nockreel spin \"/app/tapewell/spools/$r.reel\"; echo \"rc=$?\"; done\r\n\u001b[?2004l\r"]
[11.166125, "o", "/app/bin/nockreel: ELF 64-bit LSB executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, for GNU/Linux 3.2.0, not stripped\r\n"]
