[25.742856, "o", "===== /app/cd/flr/xin.c =====\r\n"]
[25.744238, "o", "     1\t#include \"xin.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\t#ifndef BANK_FLOOR\r\n     7\t#define BANK_FLOOR 3\r\n     8\t#endif\r\n     9\t\r\n    10\tint xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)\r\n    11\t{\r\n    12\t    FILE *fp;\r\n    13\t    char line[256];\r\n    14\t    int mark = 0;\r\n    15\t    char stamp[32];\r\n    16\t    int saw_mark = 0;\r\n    17\t    int saw_stamp = 0;\r\n    18\t\r\n    19\t    stamp[0] = '\\0';\r\n    20\t    if (path == NULL) {\r\n    21\t        return 1;\r\n    22\t    }\r\n    23\t    fp = fopen(path, \"r\");\r\n    24\t    if (fp == NULL) {\r\n    25\t        return 1;\r\n    26\t    }\r\n    27\t    while (fgets(line, sizeof(line), fp) != NULL) {\r\n    28\t        if (strncmp(line, \"MARK \", 5) == 0) {\r\n    29\t            if (sscanf(line + 5, \"%d\", &mark) == 1) {\r\n    30\t                saw_mark = 1;\r\n    31\t            }\r\n    32\t        } else if (strncmp(line, \"STAMP \", 6) == 0) {\r\n    33\t            if (sscanf(line + 6, \"%31s\", stamp) == 1) {\r\n    34\t                saw_stamp = 1;\r\n    35\t"]
[25.744526, "o", "            }\r\n    36\t        }\r\n    37\t    }\r\n    38\t    fclose(fp);\r\n    39\t    if (!saw_mark) {\r\n    40\t        return 1;\r\n    41\t    }\r\n    42\t    if (mark_out != NULL) {\r\n    43\t        *mark_out = mark;\r\n    44\t    }\r\n    45\t    if (stamp_out != NULL && stamp_cap > 0 && saw_stamp) {\r\n    46\t        strncpy(stamp_out, stamp, stamp_cap - 1);\r\n    47\t        stamp_out[stamp_cap - 1] = '\\0';\r\n    48\t    }\r\n    49\t    if (mark < BANK_FLOOR) {\r\n    50\t        return 1;\r\n    51\t    }\r\n    52\t    return 0;\r\n    53\t}\r\n"]
