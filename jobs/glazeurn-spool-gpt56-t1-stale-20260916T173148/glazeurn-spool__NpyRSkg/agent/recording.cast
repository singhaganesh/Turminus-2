[27.324882, "o", "echo '--- emitbay/hearth.rs ---'; nl -ba /app/emitbay/hearth.rs; echo '--- emitbay/main.rs ---'; nl -ba /app/emitbay/main.rs; echo '--- foldrib ---'; nl -ba /app/foldrib/rim.rs; echo '--- internpit ---'; nl -ba /app/internpit/pool.rs; echo '--- restcue ---'; nl -ba /app/restcue/ink.rs\r\n"]
