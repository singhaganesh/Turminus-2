[77.359352, "i", "cat > /app/foldrib/rim.rs <<'EOF'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\n        cells: b.cells.clone(),\n    }\n}\nEOF\ncat > /app/internpit/pool.rs <<'EOF'\nuse crate::fold;\nuse crate::hold;\nuse crate::load;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(_a: &mut hold::Frost, _b: &hold::Pool) {}\n\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut f = fold::rim_a(a, b);\n    rim_b(&mut f, b);\n    f\n}\n\nfn quote(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c <= '\\u{1f}' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\nfn bag(ids: &[usize], cells: &[String]) -> Option<Vec<String>> {\n    ids.iter().map(|&i| cells.get(i).cloned()).collect()\n}\n\nfn pack(items: &[String]) -> String {\n    format!(\"[{}]\", items.iter().map(|s| quote(s)).collect::<Vec<_>>().join(\",\"))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\n        return 1;\n    };\n    let heat = sess.flag;\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n\n    let frost_ids = frost.ids.borrow().clone();\n    let live_ids = sess.ids.borrow().clone();\n    let Some(frost_bag) = bag(&frost_ids, &frost.cells) else { return 1; };\n    let Some(live_bag) = bag(&live_ids, &pool.cells) else { return 1; };\n    if heat && frost_bag == live_bag {\n        return 1;\n    }\n\n    let extra = tally::lines();\n    let body = format!(\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\n        sess.n0.saturating_add(extra), sess.n1, pack(&frost_bag), pack(&live_bag)\n    );\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    match fs::write(dest, body) {\n        Ok(()) => 0,\n        Err(_) => 2,\n    }\n}\nEOF\ncat > /app/restcue/ink.rs <<'EOF'\nuse crate::pool;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let _ = tally::lines();\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    let guard = Path::new(\"/app/inkpit/GUARD\");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(dest);\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    let code = pool::dump();\n    if code != 0 { return code; }\n    match fs::write(guard, \"ok\\n\") {\n        Ok(()) => 0,\n        Err(_) => {\n            let _ = fs::remove_file(guard);\n            2\n        }\n    }\n}\nEOF\n"]
