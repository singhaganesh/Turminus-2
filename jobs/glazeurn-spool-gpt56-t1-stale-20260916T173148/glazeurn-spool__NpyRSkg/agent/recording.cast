[77.369578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn dump() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     let heat = sess.flag;\r\n\u001b[?2004l\r\u001b[?2004h>     let frost = prep(&sess, &pool);\r\n\u001b[?2004l\r\u001b[?2004h>     load::step(&mut sess, &mut pool, &plan);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.369713, "o", "    let frost_ids = frost.ids.borrow().clone();\r\n\u001b[?2004l\r"]
[77.369732, "o", "\u001b[?2004h> "]
[77.369808, "o", "    let live_ids = sess.ids.borrow().clone();\r\n\u001b[?2004l\r"]
[77.369823, "o", "\u001b[?2004h"]
[77.369834, "o", "> "]
[77.370036, "o", "    let Some(frost_bag) = bag(&frost_ids, &frost.cells) else { return 1; };\r\n\u001b[?2004l\r"]
[77.370162, "o", "\u001b[?2004h> "]
[77.370243, "o", "    let Some(live_bag) = bag(&live_ids, &pool.cells) else { return 1; };\r\n\u001b[?2004l\r"]
[77.370347, "o", "\u001b[?2004h> "]
[77.370378, "o", "    if heat && frost_bag == live_bag {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.370445, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.370459, "o", "    }\r\n\u001b[?2004l\r"]
[77.37047, "o", "\u001b[?2004h"]
[77.370481, "o", "> \r\n\u001b[?2004l\r"]
[77.370505, "o", "\u001b[?2004h> "]
[77.370629, "o", "    let extra = tally::lines();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.370705, "o", "    let body = format!(\r\n\u001b[?2004l\r"]
[77.370749, "o", "\u001b[?2004h> "]
[77.37113, "o", "        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n\u001b[?2004l\r\u001b[?2004h>         sess.n0.saturating_add(extra), sess.n1, pack(&frost_bag), pack(&live_bag)\r\n\u001b[?2004l\r\u001b[?2004h>     );\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.371193, "o", "> "]
[77.371383, "o", "    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.371462, "o", "    if let Some(parent) = dest.parent() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.371643, "o", "        if fs::create_dir_all(parent).is_err() { return 2; }\r\n\u001b[?2004l\r"]
[77.371696, "o", "\u001b[?2004h> "]
[77.371714, "o", "    }\r\n\u001b[?2004l\r"]
[77.371766, "o", "\u001b[?2004h> "]
[77.371809, "o", "    match fs::write(dest, body) {\r\n\u001b[?2004l\r"]
[77.371832, "o", "\u001b[?2004h> "]
[77.371905, "o", "        Ok(()) => 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.371976, "o", "        Err(_) => 2,\r\n\u001b[?2004l\r"]
[77.372337, "o", "\u001b[?2004h> "]
[77.374645, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[77.37519, "o", "\u001b[?2004h"]
[77.377803, "o", "root@b80f6a6ff7f2:/app# cat > /app/restcue/ink.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use crate::pool;\r\n\u001b[?2004l\r\u001b[?2004h> use crate::tally;\r\n\u001b[?2004l\r\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn rim_c() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = tally::lines();\r\n\u001b[?2004l\r\u001b[?2004h>     let dest = Path::new(\"/app/inkpit/pair.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     let guard = Path::new(\"/app/inkpit/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(dest);\r\n\u001b[?2004l\r\u001b[?2004h>     if let Some(parent) = dest.parent() {\r\n\u001b[?2004l\r\u001b[?2004h>         if fs::create_dir_all(parent).is_err() { return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let code = pool::dump();\r\n\u001b[?2004l\r\u001b[?2004h>     if code != 0 { return code; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.37803, "o", "    match fs::write(guard, \"ok\\n\") {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(()) => 0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.37807, "o", "> "]
[77.378121, "o", "        Err(_) => {\r\n\u001b[?2004l\r"]
[77.378142, "o", "\u001b[?2004h"]
[77.378161, "o", "> "]
[77.378438, "o", "            let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>             2\r\n\u001b[?2004l\r"]
[77.378476, "o", "\u001b[?2004h> "]
[77.378502, "o", "        }\r\n\u001b[?2004l\r"]
[77.378563, "o", "\u001b[?2004h> "]
[77.378593, "o", "    }\r\n\u001b[?2004l\r"]
[77.378664, "o", "\u001b[?2004h> "]
[77.378697, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.378716, "o", "EOF\r\n\u001b[?2004l\r"]
[77.380735, "o", "\u001b[?2004hroot@b80f6a6ff7f2:/app# "]
[77.862808, "i", "cat > /app/emitbay/hearth.rs <<'EOF'\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\nfn files_below(dir: &Path, out: &mut Vec<PathBuf>) -> Result<(), ()> {\n    let entries = fs::read_dir(dir).map_err(|_| ())?;\n    for entry in entries {\n        let path = entry.map_err(|_| ())?.path();\n        let meta = fs::symlink_metadata(&path).map_err(|_| ())?;\n        if meta.file_type().is_symlink() {\n            continue;\n        }\n        if meta.is_dir() {\n            files_below(&path, out)?;\n        } else if meta.is_file() {\n            out.push(path);\n        }\n    }\n    Ok(())\n}\n\npub fn rib_d() -> i32 {\n    // Walking means opening every card, not merely opening the directory.\n    let cards = match fs::read_dir(\"/app/daycards\") {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    for entry in cards {\n        let Ok(entry) = entry else { return 1; };\n        let path = entry.path();\n        let Ok(meta) = fs::symlink_metadata(&path) else { return 1; };\n        if meta.is_file() && fs::read(&path).is_err() {\n            return 1;\n        }\n    }\n\n    let tree = match fs::read_to_string(\"/app/vatslip/TREE.txt\") {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    let mut pieces = Vec::new();\n    for name in tree.lines().map(str::trim).filter(|s| !s.is_empty() && !s.starts_with('#')) {\n        if name.contains('/') || name == \".\" || name == \"..\" {\n            return 1;\n        }\n        let root = Path::new(\"/app\").join(name);\n        if files_below(&root, &mut pieces).is_err() {\n            return 1;\n        }\n    }\n    // Refresh each named mill piece only after its complete contents are in memory.\n    for path in pieces {\n        let data = match fs::read(&path) {\n            Ok(v) => v,\n            Err(_) => return 1,\n        };\n        if fs::write(&path, data).is_err() {\n            return 2;\n        }\n    }\n    0\n}\nEOF\nchmod +x /app/bake.sh\nPATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin /app/bake.sh\n"]
