Sending keys: ['cat > /app/urnwalk/walk.rs <<\'EOF\'\nuse std::path::{Path, PathBuf};\n\npub fn gather(a: &str) -> Result<Vec<String>, i32> {\n    let allowed = std::fs::canonicalize("/app/vatlogs").map_err(|_| 2)?;\n    let root = std::fs::canonicalize(a).map_err(|_| 2)?;\n    if !root.starts_with(&allowed) || !root.is_dir() {\n        return Err(2);\n    }\n    let mut paths = Vec::new();\n    visit(&root, &allowed, &mut paths)?;\n    if paths.is_empty() {\n        return Err(2);\n    }\n    paths.sort();\n    Ok(paths.into_iter().map(|p| p.to_string_lossy().into_owned()).collect())\n}\n\nfn visit(dir: &Path, allowed: &Path, out: &mut Vec<PathBuf>) -> Result<(), i32> {\n    let rd = std::fs::read_dir(dir).map_err(|_| 2)?;\n    for entry in rd {\n        let entry = entry.map_err(|_| 2)?;\n        let original = entry.path();\n        let path = std::fs::canonicalize(&original).map_err(|_| 2)?;\n        if !path.starts_with(allowed) {\n            return Err(2);\n        }\n        let meta = std::fs::metadata(&path).map_err(|_| 2)?;\n        if meta.is_dir() {\n            visit(&path, allowed, out)?;\n        } else if meta.is_file() {\n            out.push(path);\n        } else {\n            return Err(2);\n        }\n    }\n    Ok(())\n}\nEOF\ncat > /app/treyfun/clip.rs <<\'EOF\'\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() {\n        return Err(3);\n    }\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut expected_frame = 0usize;\n    let mut summary = false;\n\n    for line in text.lines() {\n        if line.contains("ERROR:") {\n            if kind.is_some() {\n                return Err(3);\n            }\n            let after_error = line.split_once("ERROR:").ok_or(3)?.1.trim();\n            let after = after_error\n                .strip_prefix("AddressSanitizer:")\n                .unwrap_or(after_error)\n                .trim();\n            let value = after.split(" on ").next().unwrap_or("").trim();\n            if value.is_empty() {\n                return Err(3);\n            }\n            kind = Some(value.to_string());\n        }\n        if line.trim_start().starts_with("SUMMARY:") {\n            summary = true;\n        }\n        let t = line.trim_start();\n        if let Some(rest) = t.strip_prefix(\'#\') {\n            let digits_len = rest.bytes().take_while(|b| b.is_ascii_digit()).count();\n            if digits_len == 0 {\n                return Err(3);\n            }\n            let n: usize = rest[..digits_len].parse().map_err(|_| 3)?;\n            if n != expected_frame {\n                return Err(3);\n            }\n            expected_frame += 1;\n            let tail = rest[digits_len..].trim_start();\n            let (_, symbol_tail) = tail.split_once(" in ").ok_or(3)?;\n            let symbol = symbol_tail.split_whitespace().next().unwrap_or("");\n            if symbol.is_empty() {\n                return Err(3);\n            }\n            if !is_runtime_frame(symbol) {\n                frames.push(fold_hex(symbol));\n            }\n        }\n    }\n\n    if kind.is_none() || expected_frame == 0 || !summary || frames.is_empty() {\n        return Err(3);\n    }\n    Ok((kind.unwrap(), frames))\n}\n\nfn is_runtime_frame(s: &str) -> bool {\n    s.starts_with("__asan") || s.starts_with("__interceptor") || s.starts_with("__hwasan")\n}\n\nfn fold_hex(s: &str) -> String {\n    let bytes = s.as_bytes();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < bytes.len() {\n        if i + 2 <= bytes.len() && bytes[i] == b\'0\' && bytes[i + 1] == b\'x\'\n            && i + 2 < bytes.len() && bytes[i + 2].is_ascii_hexdigit()\n        {\n            out.push_str("<hex>");\n            i += 2;\n            while i < bytes.len() && bytes[i].is_ascii_hexdigit() {\n                i += 1;\n            }\n        } else {\n            out.push(bytes[i] as char);\n            i += 1;\n        }\n    }\n    out\n}\nEOF\ncat > /app/qanbox/tally.rs <<\'EOF\'\n#[path = "../treyfun/clip.rs"]\nmod clip;\n\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<String>,\n    pub body: String,\n}\n\npub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\n    let paths = crate::walk::gather(a)?;\n    let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\n    for path in paths {\n        let text = std::fs::read_to_string(path).map_err(|_| 3)?;\n        let (kind, frames) = clip::take(&text)?;\n        let body = frames.join(" | ");\n        let candidate = Rec { issue: 0, kind, frames: frames.clone(), body };\n        match bag.get(&frames) {\n            Some(old) if old.kind != candidate.kind => return Err(3),\n            Some(_) => {}\n            None => { bag.insert(frames, candidate); }\n        }\n    }\n    if bag.is_empty() {\n        return Err(3);\n    }\n    let mut records: Vec<Rec> = bag.into_values().collect();\n    for (i, record) in records.iter_mut().enumerate() {\n        record.issue = i as i32 + 1;\n    }\n    Ok(records)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
