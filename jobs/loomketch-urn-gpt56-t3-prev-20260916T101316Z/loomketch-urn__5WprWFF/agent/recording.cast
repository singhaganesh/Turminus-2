[62.837535, "o", "\u001b[?2004hroot@a77a5a4a64e1:/app# "]
[62.837664, "o", "cat > /app/qanbox/tally.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.837765, "o", "#[path = \"../treyfun/clip.rs\"]\r\n\u001b[?2004l\r"]
[62.837851, "o", "\u001b[?2004h> mod clip;\r\n\u001b[?2004l\r"]
[62.837946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.838083, "o", "use std::collections::BTreeMap;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.838174, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Clone)]\r\n\u001b[?2004l\r"]
[62.83825, "o", "\u001b[?2004h> pub struct Rec {\r\n\u001b[?2004l\r"]
[62.838322, "o", "\u001b[?2004h>     pub issue: i32,\r\n"]
[62.838395, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[62.838454, "o", "    pub kind: String,\r\n\u001b[?2004l\r"]
[62.838477, "o", "\u001b[?2004h> "]
[62.838574, "o", "    pub frames: Vec<String>,\r\n\u001b[?2004l\r"]
[62.838595, "o", "\u001b[?2004h> "]
[62.838673, "o", "    pub body: String,\r\n\u001b[?2004l\r"]
[62.838705, "o", "\u001b[?2004h> "]
[62.838745, "o", "}\r\n\u001b[?2004l\r"]
[62.838765, "o", "\u001b[?2004h"]
[62.838779, "o", "> \r\n\u001b[?2004l\r"]
[62.838853, "o", "\u001b[?2004h> "]
[62.839555, "o", "pub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.841113, "o", "    let paths = crate::walk::gather(a)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for path in paths {\r\n\u001b[?2004l\r\u001b[?2004h>         let text = std::fs::read_to_string(path).map_err(|_| 3)?;\r\n\u001b[?2004l\r\u001b[?2004h>         let (kind, frames) = clip::take(&text)?;\r\n\u001b[?2004l\r\u001b[?2004h>         let body = frames.join(\" | \");\r\n\u001b[?2004l\r\u001b[?2004h>         let candidate = Rec { issue: 0, kind, frames: frames.clone(), body };\r\n\u001b[?2004l\r\u001b[?2004h>         match bag.get(&frames) {\r\n\u001b[?2004l\r\u001b[?2004h>             Some(old) if old.kind != candidate.kind => return Err(3),\r\n\u001b[?2004l\r\u001b[?2004h>             Some(_) => {}\r\n\u001b[?2004l\r\u001b[?2004h>             None => { bag.insert(frames, candidate); }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.841468, "o", "    if bag.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.841616, "o", "    let mut records: Vec<Rec> = bag.into_values().collect();\r\n\u001b[?2004l\r"]
[62.841649, "o", "\u001b[?2004h> "]
[62.841817, "o", "    for (i, record) in records.iter_mut().enumerate() {\r\n\u001b[?2004l\r"]
[62.841916, "o", "\u001b[?2004h> "]
[62.842051, "o", "        record.issue = i as i32 + 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.84209, "o", "    }\r\n\u001b[?2004l\r"]
[62.842599, "o", "\u001b[?2004h>     Ok(records)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[62.844309, "o", "\u001b[?2004hroot@a77a5a4a64e1:/app# "]
[62.965508, "i", "cat > /app/humdock/emit.rs <<'EOF'\nuse crate::tally::Rec;\n\npub fn emit(records: &[Rec]) -> i32 {\n    if std::fs::create_dir_all(\"/app/inkbay\").is_err() {\n        return 1;\n    }\n    let mut inner = String::new();\n    let mut desk = String::from(\"issue\\tkind\\tbody\\n\");\n    for (i, r) in records.iter().enumerate() {\n        if i != 0 { inner.push(','); }\n        inner.push_str(&format!(\n            \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\n            r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body)\n        ));\n        desk.push_str(&format!(\"{}\\t{}\\t{}\\n\", r.issue, r.kind, r.body));\n    }\n    let tpl = match std::fs::read_to_string(\"/app/tplbay/bound.tpl\") {\n        Ok(t) if t.matches(\"__ROWS__\").count() == 1 => t,\n        _ => return 1,\n    };\n    let bound = tpl.replace(\"__ROWS__\", &inner);\n    if std::fs::write(\"/app/inkbay/bound.json\", bound).is_err()\n        || std::fs::write(\"/app/inkbay/desk.tsv\", desk).is_err()\n    {\n        return 1;\n    }\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() { 1 } else { 0 }\n}\n\nfn jstr(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\\\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\\\"');\n    out\n}\n\nfn jarr(v: &[String]) -> String {\n    format!(\"[{}]\", v.iter().map(|s| jstr(s)).collect::<Vec<_>>().join(\",\"))\n}\nEOF\npython3 - <<'PY'\np='/app/ketchcli/main.rs'\ns=open(p).read()\ns=s.replace('    let mut args = std::env::args();', '    let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\\n    let mut args = std::env::args();')\nopen(p,'w').write(s)\nPY\n/app/hearth.sh\nhead -c 4 /app/bin/loomketch | od -An -tx1\n/app/bin/loomketch bind; echo rc=$?; cat /app/inkbay/bound.json; cat /app/inkbay/desk.tsv; printf 'GUARD='; cat /app/inkbay/GUARD; echo\n"]
