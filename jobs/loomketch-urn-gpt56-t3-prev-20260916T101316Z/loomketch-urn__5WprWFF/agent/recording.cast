[9.029696, "o", "printf '\\n--- MAP.txt ---\\n'; cat /app/deskcue/MAP.txt\r\n\u001b[?2004l\r"]
[9.029809, "o", "\r\n--- MAP.txt ---\r\n"]
[9.031124, "o", "loomketch mill layout\r\n=====================\r\n\r\nketchcli/main.rs dispatches bind.\r\n\r\nOther crates sit beside ketchcli. Journals live in /app/vatlogs.\r\nFixture copies of those journals sit at /app/seed/vatlogs.\r\nbind refreshes /app/inkbay/bound.json, /app/inkbay/desk.tsv, and /app/inkbay/GUARD.\r\n\r\nbound.json uses object findings as a list of records\r\n{ \"issue\": N, \"kind\": \"<kind>\", \"frames\": [\"<sym>\", ...], \"body\": \"<text>\" }\r\nwhere issue is an integer that starts at 1. desk.tsv starts with header\r\nissue\tkind\tbody\r\nthen one tab-separated row per finding, using those same issue values.\r\n\r\nJournal text is AddressSanitizer form: one ERROR: kind line followed by #N frame lines.\r\nTemplate copy sits at /app/tplbay/bound.tpl.\r\nwalkcue/ holds an ops sidecar used when KETCH_ALPHA=1.\r\n\r\nA bind root such as /tmp/loom_out sits outside /app/vatlogs and must fail.\r\n\r\n"]
[9.031404, "o", "\u001b[?2004h"]
[9.031508, "o", "root@a77a5a4a64e1:/app# "]
[9.156936, "i", "printf '\\n--- source candidates ---\\n'; find /app -type f \\( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.rs' -o -name '*.go' -o -name 'Makefile' -o -name 'CMakeLists.txt' \\) -print -exec sh -c 'echo \"--- $1\"; sed -n \"1,240p\" \"$1\"' sh {} \\;\n"]
[9.158543, "o", "printf '\\n--- source candidates ---\\n'; find /app -type f \\( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.rs' -o -name '*.go' -o -name 'Makefile' -o -name 'CMakeLists.txt' \\) -print -exec sh -c 'echo \"--- $1\"; sed -n \"1,240p\" \"$1\"' sh {} \\;\r\n\u001b[?2004l\r\r\n--- source candidates ---\r\n"]
[9.164761, "o", "/app/humdock/emit.rs\r\n"]
[9.165783, "o", "--- /app/humdock/emit.rs\r\n"]
[9.168568, "o", "use crate::tally::Rec;\r\n\r\npub fn emit(a: &[Rec]) -> i32 {\r\n    let mut rows: Vec<Rec> = a.to_vec();\r\n    rows.sort_by(|x, y| x.kind.cmp(&y.kind));\r\n    let mut out = String::from(\"issue\\tkind\\tbody\\n\");\r\n    for (i, r) in rows.iter().enumerate() {\r\n        out.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, r.kind, r.body));\r\n    }\r\n    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    if std::fs::write(\"/app/inkbay/desk.tsv\", out).is_err() {\r\n        return 1;\r\n    }\r\n"]
[9.168705, "o", "    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[9.169144, "o", "/app/treyfun/clip.rs\r\n"]
[9.169778, "o", "--- /app/treyfun/clip.rs\r\n"]
[9.170721, "o", "pub fn clip(a: &[String]) -> Vec<String> {\r\n    a.iter()\r\n        .filter(|s| !s.starts_with(\"__asan::\") && !s.starts_with(\"__asan_\"))\r\n        .cloned()\r\n        .collect()\r\n}\r\n\r\n"]
[9.170807, "o", "pub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\r\n    if text.trim().is_empty() {\r\n        return Ok((String::new(), Vec::new()));\r\n    }\r\n    let mut kind = String::new();\r\n    let mut frames = Vec::new();\r\n    for line in text.lines() {\r\n        if let Some(rest) = line.split(\"ERROR:\").nth(1) {\r\n            let rest = rest.trim();\r\n            let after = if let Some(x) = rest.split(\"AddressSanitizer:\").nth(1) {\r\n                x.trim()\r\n            } else {\r\n                rest\r\n            };\r\n            kind = after.split(\" on \").next().unwrap_or(after).trim().to_string();\r\n        }\r\n        if let Some(idx) = line.find('#') {\r\n            let chunk = &line[idx..];\r\n            if let Some(after) = chunk.split(\" in \").nth(1) {\r\n                let sym = after.split_whitespace().next().unwrap_or(\"\").to_string();\r\n                if !sym.is_empty() {\r\n                    frames.push(sym);\r\n                }\r\n            }\r\n        }\r\n    }\r\n    Ok((kind, frames))\r\n}\r\n"]
[9.171194, "o", "/app/qanbox/tally.rs\r\n"]
[9.171848, "o", "--- /app/qanbox/tally.rs\r\n"]
[9.173081, "o", "#[path = \"../treyfun/clip.rs\"]\r\nmod clip;\r\n\r\nuse std::collections::HashMap;\r\nuse std::sync::mpsc;\r\nuse std::thread;\r\n\r\n#[derive(Clone)]\r\npub struct Rec {\r\n    pub issue: i32,\r\n    pub kind: String,\r\n    pub frames: Vec<String>,\r\n    pub body: String,\r\n}\r\n\r\npub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\r\n    let paths = crate::walk::gather(a)?;\r\n    let (tx, rx) = mpsc::channel();\r\n    let mut hs = Vec::new();\r\n    for p in paths {\r\n        let tx = tx.clone();\r\n        hs.push(thread::spawn(move || {\r\n            let text = match std::fs::read_to_string(&p) {\r\n                Ok(t) => t,\r\n"]
[9.173178, "o", "                Err(_) => return,\r\n            };\r\n            let (kind, frames) = match clip::take(&text) {\r\n                Ok(x) => x,\r\n                Err(_) => return,\r\n            };\r\n            if kind.is_empty() {\r\n                return;\r\n            }\r\n            let frames = clip::clip(&frames);\r\n            let body = frames.join(\" | \");\r\n            let _ = tx.send(Rec {\r\n                issue: 0,\r\n                kind,\r\n                frames,\r\n                body,\r\n            });\r\n        }));\r\n    }\r\n    drop(tx);\r\n    for h in hs {\r\n        let _ = h.join();\r\n    }\r\n    let mut bag: HashMap<String, Rec> = HashMap::new();\r\n    while let Ok(r) = rx.recv() {\r\n        bag.entry(r.body.clone()).or_insert(r);\r\n    }\r\n    let mut recs: Vec<Rec> = bag.into_values().collect();\r\n    for (i, r) in recs.iter_mut().enumerate() {\r\n        r.issue = (i as i32) + 1;\r\n    }\r\n    let _ = write_bound(&recs);\r\n    Ok(recs)\r\n}\r\n\r\nfn write_bound(recs: &[Rec]) -> i32 {\r\n    let tpl = std::fs::read_to_string(\"/app/tplbay/bound.tpl\").unwrap_or_else(|_| \"{\\\"findings\\\":[__ROWS__]}\".into());\r\n    if recs.is_empty() {\r\n        let _ = std::fs::write(\"/app/inkbay/bound.json\", tpl);\r\n        return 0;\r\n    }\r\n    let mut inner = String::new();\r\n    for (i, r) in recs.iter().enumerate() {\r\n        if i > 0 {\r\n            inner.push(',');\r\n        }\r\n        inner.push_str(&format!(\r\n            \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\r\n            r.issue,\r\n            jstr(&r.kind),"]
[9.17321, "o", "\r\n            jarr(&r.frames),\r\n            jstr(&r.body)\r\n        ));\r\n    }\r\n    let out = tpl.replace(\"__ROWS__\", &inner);\r\n    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    match std::fs::write(\"/app/inkbay/bound.json\", out) {\r\n        Ok(()) => 0,\r\n        Err(_) => 1,\r\n    }\r\n}\r\n\r\nfn jstr(s: &str) -> String {\r\n    format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\"))\r\n}\r\n"]
[9.173227, "o", "\r\nfn jarr(v: &[String]) -> String {\r\n    let parts: Vec<String> = v.iter().map(|x| jstr(x)).collect();\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n}\r\n"]
[9.174203, "o", "/app/walkcue/alpha.rs\r\n"]
[9.175532, "o", "--- /app/walkcue/alpha.rs\r\n"]
[9.177098, "o", "pub fn lined(a: &mut Vec<String>) -> bool {\r\n    if std::env::var(\"KETCH_ALPHA\").ok().as_deref() == Some(\"1\") {\r\n        a.sort();\r\n        true\r\n    } else {\r\n        false\r\n    }\r\n}\r\n"]
[9.177772, "o", "/app/urnwalk/walk.rs\r\n"]
[9.178594, "o", "--- /app/urnwalk/walk.rs\r\n"]
[9.179792, "o", "pub fn gather(a: &str) -> Result<Vec<String>, i32> {\r\n    let mut v = Vec::new();\r\n    let rd = match std::fs::read_dir(a) {\r\n        Ok(x) => x,\r\n        Err(_) => return Err(2),\r\n    };\r\n    for e in rd {\r\n        let e = match e {\r\n            Ok(x) => x,\r\n            Err(_) => continue,\r\n        };\r\n        let p = e.path();\r\n        if p.is_file() {\r\n            v.push(p.to_string_lossy().into_owned());\r\n        }\r\n    }\r\n    if crate::alpha::lined(&mut v) {\r\n        v.sort();\r\n    }\r\n    Ok(v)\r\n}\r\n"]
[9.180313, "o", "/app/ketchcli/main.rs\r\n"]
[9.181091, "o", "--- /app/ketchcli/main.rs\r\n"]
[9.182296, "o", "#[path = \"../urnwalk/walk.rs\"]\r\nmod walk;\r\n#[path = \"../walkcue/alpha.rs\"]\r\nmod alpha;\r\n#[path = \"../qanbox/tally.rs\"]\r\nmod tally;\r\n#[path = \"../humdock/emit.rs\"]\r\nmod rib;\r\n\r\nfn main() {\r\n"]
[9.182346, "o", "    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"bind\" {\r\n        eprintln!(\"usage: loomketch bind [root]\");\r\n        std::process::exit(2);\r\n    }\r\n    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\r\n    let code = match tally::tally(&root) {\r\n        Ok(recs) => {\r\n            if rib::emit(&recs) != 0 {\r\n                1\r\n            } else {\r\n                0\r\n            }\r\n        }\r\n        Err(c) => {\r\n"]
[9.182464, "o", "            let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\r\n            c\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[9.183062, "o", "\u001b[?2004hroot@a77a5a4a64e1:/app# "]
[19.154081, "i", "printf '%s\\n' '--- journals ---'; for f in /app/vatlogs/*; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- templates/current outputs ---'; for f in /app/tplbay/* /app/inkbay/*; do echo \"### $f\"; cat \"$f\"; echo; done\n"]
[19.154834, "o", "printf '%s\\n' '--- journals ---'; for f in /app/vatlogs/*; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- templates/current outputs ---'; for f in /app/tplbay/* /app/inkbay/*; do echo \"### $f\"; cat \"$f\"; echo; done\r\n\u001b[?2004l\r"]
