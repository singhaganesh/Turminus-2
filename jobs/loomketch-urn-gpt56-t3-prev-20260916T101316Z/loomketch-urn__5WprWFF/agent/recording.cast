[62.834564, "o", "    while i < bytes.len() {\r\n\u001b[?2004l\r"]
[62.834608, "o", "\u001b[?2004h> "]
[62.834762, "o", "        if i + 2 <= bytes.len() && bytes[i] == b'0' && bytes[i + 1] == b'x'\r\n\u001b[?2004l\r"]
[62.834809, "o", "\u001b[?2004h> "]
[62.83496, "o", "            && i + 2 < bytes.len() && bytes[i + 2].is_ascii_hexdigit()\r\n\u001b[?2004l\r"]
[62.835007, "o", "\u001b[?2004h> "]
[62.835072, "o", "        {\r\n\u001b[?2004l\r"]
[62.835121, "o", "\u001b[?2004h> "]
[62.835169, "o", "            out.push_str(\"<hex>\");\r\n\u001b[?2004l\r"]
[62.835226, "o", "\u001b[?2004h> "]
[62.835285, "o", "            i += 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.835441, "o", "            while i < bytes.len() && bytes[i].is_ascii_hexdigit() {\r\n\u001b[?2004l\r"]
[62.835491, "o", "\u001b[?2004h> "]
[62.835564, "o", "                i += 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.83562, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.835666, "o", ">         } else {\r\n\u001b[?2004l\r"]
[62.835715, "o", "\u001b[?2004h> "]
[62.835801, "o", "            out.push(bytes[i] as char);\r\n\u001b[?2004l\r"]
[62.835853, "o", "\u001b[?2004h> "]
[62.835903, "o", "            i += 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.835968, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
