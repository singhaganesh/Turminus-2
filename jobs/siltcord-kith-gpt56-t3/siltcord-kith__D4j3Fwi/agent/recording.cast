[161.751977, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: 2 warnings emitted\u001b[0m\r\n\r\n"]
[161.76014, "o", "\u001b[?2004hroot@2e5cd8b3aaae:/app# "]
[165.676467, "i", "set +e\n# Independent expected signature from documented raw-header order.\npython3 - <<'PY'\nimport hashlib,json,struct\np='/app/sealwell/kestrel.kith'; raw=open(p,'rb').read(); names=[]; off=0\nwhile raw[off:off+512].strip(b'\\0'):\n b=raw[off:off+512]; n=int(b[124:136].rstrip(b'\\0 ').lstrip(b' '),8)\n if b[156] in (0,48): names.append(b[:100].split(b'\\0',1)[0].decode())\n off += 512 + (n+511)//512*512\nexpect=hashlib.sha256('\\n'.join(names).encode()).hexdigest()\nobj=json.load(open('/app/deskjson/pass-a.json'))\nprint('names=',names); print('expected=',expect); print('object=',obj); assert obj['walk_sig']==expect\nPY\n# Junk ledger must be replaced successfully.\nprintf xxxx > /app/idxbay/members.idx\n/app/bin/siltcord quarry; echo \"junk_rebuild=$? idx_magic=$(head -c5 /app/idxbay/members.idx)\"\n# Make sealed invalid fixtures so confinement passes but parsing must fail.\nprintf not-an-archive > /app/sealwell/bad.kith\nhead -c 1500 /app/sealwell/kestrel.kith > /app/sealwell/trunc.kith\n/app/bin/siltcord quarry /app/sealwell/bad.kith /tmp/bad.idx; qbad=$?; test ! -e /app/deskjson/READY; r1=$?\n/app/bin/siltcord quarry /app/sealwell/trunc.kith /tmp/trunc.idx; qtrunc=$?; test ! -e /app/deskjson/READY; r2=$?\n/app/bin/siltcord brief /tmp/reject.json /app/sealwell/bad.kith /app/idxbay/members.idx; bbad=$?; test ! -e /app/deskjson/READY; r3=$?\ncp /app/sealwell/kestrel.kith /tmp/kestrel.kith\n/app/bin/siltcord brief /tmp/reject.json /tmp/kestrel.kith /app/idxbay/members.idx; bout=$?; test ! -e /app/deskjson/READY; r4=$?\nprintf 'qbad=%s qtrunc=%s bbad=%s boutside=%s ready_absent_checks=%s,%s,%s,%s\\n' \"$qbad\" \"$qtrunc\" \"$bbad\" \"$bout\" \"$r1\" \"$r2\" \"$r3\" \"$r4\"\nrm -f /app/sealwell/bad.kith /app/sealwell/trunc.kith /tmp/bad.idx /tmp/trunc.idx /tmp/reject.json /tmp/kestrel.kith\n# Restore final required artifacts and verify native image and exact READY.\n/app/bin/siltcord quarry; qa=$?\n/app/bin/siltcord brief /app/deskjson/pass-a.json; ba=$?\n/app/bin/siltcord brief /app/deskjson/pass-b.json; bb=$?\ncmp -s /app/deskjson/pass-a.json /app/deskjson/pass-b.json; same=$?\nmagic=$(od -An -tx1 -N4 /app/bin/siltcord | tr -d ' \\n')\nready=$(cat /app/deskjson/READY)\nprintf 'final quarry=%s brief_a=%s brief_b=%s same=%s magic=%s READY=%s\\n' \"$qa\" \"$ba\" \"$bb\" \"$same\" \"$magic\" \"$ready\"\ncat /app/deskjson/pass-a.json\n"]
