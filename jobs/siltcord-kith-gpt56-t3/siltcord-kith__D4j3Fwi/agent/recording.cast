[116.060241, "i", "python3 - <<'PY'\np='/app/ustarwalk/hdr.rs'\ns=open(p).read()\ns=s.replace('if blk.iter().all(|b| *b == 0) { ended = true; break; }', 'if blk.iter().all(|b| *b == 0) {\\n            if off + 1024 > raw.len() || raw[off..].iter().any(|b| *b != 0) { return Err(1); }\\n            ended = true;\\n            break;\\n        }')\nopen(p,'w').write(s)\nPY\ncat > /app/keeppit/first.rs <<'RS'\npub struct Head;\n\nimpl Head {\n    /// Overlay application keeps the last payload for a repeated normalized path.\n    pub fn take<'a>(rows: &'a [(String, u64, Vec<u8>)]) -> Option<&'a Vec<u8>> {\n        rows.last().map(|r| &r.2)\n    }\n}\n\npub fn keep_head(rows: &[(String, u64, Vec<u8>)]) -> Option<&Vec<u8>> {\n    Head::take(rows)\n}\nRS\ncat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, hdr: u64, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?);\n    let mut i = 9usize;\n    let mut out = Vec::new();\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        let end = i.checked_add(nl).ok_or(1)?;\n        if end > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..end]).map_err(|_| 1)?.to_string();\n        i = end;\n        out.push(Rec { name, hdr, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn load(raw: &[u8], body: u64, size: u64) -> Result<Vec<u8>, i32> {\n    let s = usize::try_from(body).map_err(|_| 1)?;\n    let n = usize::try_from(size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let out = child.wait_with_output().map_err(|_| 1)?;\n    if !out.status.success() { return Err(1); }\n    let value = String::from_utf8(out.stdout).map_err(|_| 1)?.trim().to_string();\n    if value.len() != 64 || !value.bytes().all(|b| b.is_ascii_digit() || matches!(b, b'a'..=b'f')) { return Err(1); }\n    Ok(value)\n}\n\n#[path = \"../keeppit/first.rs\"] mod first;\n#[path = \"../cfgbag/kv.rs\"] mod kv;\n#[path = \"../cfgbag/alias.rs\"] mod alias;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    let archive = std::fs::read(a).map_err(|_| 1)?;\n    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\n    let mut events = Vec::new();\n    let mut names = Vec::new();\n    for r in &recs {\n        let blob = load(&archive, r.body, r.size)?;\n        let normalized = alias::fold(&r.name);\n        names.push(r.name.clone());\n        if normalized == \"etc/sys.conf\" {\n            confs.push((normalized, r.hdr, blob));\n        } else if normalized == \"var/log/app.log\" {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let event = line.trim();\n                if !event.is_empty() { events.push(event.to_string()); }\n            }\n        }\n    }\n    let selected = first::keep_head(&confs);\n    let mut timezone = String::new();\n    let mut cluster = String::new();\n    if let Some(blob) = selected {"]
[116.060455, "i", "\n        let map = kv::pairs(blob);\n        timezone = map.get(\"timezone\").cloned().unwrap_or_default();\n        cluster = map.get(\"cluster\").cloned().unwrap_or_default();\n    }\n    events.sort();\n    events.dedup();\n    let source = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack { t: timezone, c: cluster, e: events, n: recs.len() as u32,\n        s: source, w: digest(&names.join(\"\\n\"))? })\n}\nRS\n"]
