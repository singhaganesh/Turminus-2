[116.107227, "o", "\u001b[?2004hroot@2e5cd8b3aaae:/app# "]
[116.267938, "i", "cat > /app/logbag/write.rs <<'RS'\nuse super::blend::Pack;\n\nfn json_escape(s: &str) -> String {\n    let mut out = String::new();\n    for ch in s.chars() {\n        match ch {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out\n}\n\npub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\n    if let Some(parent) = std::path::Path::new(out).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    let ev: Vec<String> = p.e.iter().map(|x| format!(\"\\\"{}\\\"\", json_escape(x))).collect();\n    let body = format!(\n        \"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\n        json_escape(&p.t), json_escape(&p.c), ev.join(\",\"), p.n,\n        json_escape(&p.s), json_escape(&p.w));\n    if std::fs::write(out, body).is_err() { return 1; }\n    if std::fs::write(\"/app/deskjson/READY\", b\"brief-ok\").is_err() {\n        let _ = std::fs::remove_file(out);\n        return 1;\n    }\n    0\n}\nRS\ncat > /app/siltcli/quarry.rs <<'RS'\n#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\n#[path = \"../idxmill/shard.rs\"] mod shard;\n\nfn sealed(path: &str) -> bool {\n    let root = match std::fs::canonicalize(\"/app/sealwell\") { Ok(x) => x, Err(_) => return false };\n    match std::fs::canonicalize(path) { Ok(x) => x.starts_with(root), Err(_) => false }\n}\n\npub fn go(a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    if !sealed(a) { let _ = std::fs::remove_file(b); return 1; }\n    let code = shard::rib_a(a, b);\n    if code != 0 { let _ = std::fs::remove_file(b); }\n    code\n}\nRS\ncat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"] mod blend;\n#[path = \"../logbag/write.rs\"] mod uni;\n\nfn sealed(path: &str) -> bool {\n    let root = match std::fs::canonicalize(\"/app/sealwell\") { Ok(x) => x, Err(_) => return false };\n    match std::fs::canonicalize(path) { Ok(x) => x.starts_with(root), Err(_) => false }\n}\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    let _ = std::fs::remove_file(out);\n    if !sealed(a) { return 1; }\n    match blend::rib_b(a, b) {\n        Ok(p) => uni::rib_c(&p, out, a),\n        Err(c) => c,\n    }\n}\nRS\nchmod +x /app/wick.sh\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/siltcord\n/app/bin/siltcord quarry; echo \"quarry=$?\"; /app/bin/siltcord brief /app/deskjson/pass-a.json; echo \"brief-a=$?\"; /app/bin/siltcord brief /app/deskjson/pass-b.json; echo \"brief-b=$?\"; cat /app/deskjson/pass-a.json; cmp /app/deskjson/pass-a.json /app/deskjson/pass-b.json; echo \"cmp=$?\"; printf 'READY='; cat /app/deskjson/READY; echo\n"]
[116.269073, "o", "cat > /app/logbag/write.rs <<'RS'\r\n\u001b[?2004l\r"]
