[60.180708, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// Strict scanner for regular POSIX ustar headers and their padded payloads.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let field = buf.split(|b| *b == 0).next().unwrap_or(&[]);\n    let field = field.strip_prefix(b\" \").unwrap_or(field);\n    let digits = field.strip_suffix(b\" \").unwrap_or(field);\n    if digits.is_empty() || digits.iter().any(|b| !matches!(b, b'0'..=b'7')) {\n        return Err(1);\n    }\n    let mut n = 0u64;\n    for &b in digits {\n        n = n.checked_mul(8).and_then(|x| x.checked_add(u64::from(b-b'0'))).ok_or(1)?;\n    }\n    Ok(n)\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off.checked_add(512).ok_or(1)? <= raw.len() {\n        let blk = &raw[off..off+512];\n        if blk.iter().all(|b| *b == 0) { ended = true; break; }\n        if &blk[257..262] != b\"ustar\" { return Err(1); }\n        let nlen = blk[..100].iter().position(|b| *b == 0).unwrap_or(100);\n        if nlen == 0 { return Err(1); }\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let body = off.checked_add(512).ok_or(1)?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = body.checked_add(usize::try_from(padded).map_err(|_| 1)?).ok_or(1)?;\n        if next > raw.len() { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: body as u64, flag: blk[156] });\n        off = next;\n    }\n    if rows.is_empty() || !ended { return Err(1); }\n    Ok(rows)\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let n = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(_) => return 1 };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = r.name.as_bytes();\n        let nl = match u16::try_from(nb.len()) { Ok(x) => x, Err(_) => return 1 };\n        out.extend_from_slice(&nl.to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    std::fs::write(b, out).map(|_| 0).unwrap_or(1)\n}\nRS\n"]
