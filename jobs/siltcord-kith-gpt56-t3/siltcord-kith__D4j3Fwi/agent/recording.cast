[26.910865, "i", "for f in /app/overlaypit/blend.rs /app/logbag/write.rs /app/siltcli/boot.rs /app/siltcli/quarry.rs /app/siltcli/slate.rs /app/ustarwalk/block.rs; do echo \"### $f\"; nl -ba \"$f\"; done\n"]
[26.91157, "o", "for f in /app/overlaypit/blend.rs /app/logbag/write.rs /app/siltcli/boot.rs /app/siltcli/quarry.rs /app/siltcli/slate.rs /app/ustarwalk/block.rs; do echo \"### $f\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[26.9117, "o", "### /app/overlaypit/blend.rs\r\n"]
[26.912976, "o", "     1\tpub struct Pack {\r\n     2\t    pub t: String,\r\n     3\t    pub c: String,\r\n     4\t    pub e: Vec<String>,\r\n     5\t"]
[26.913144, "o", "    pub n: u32,\r\n     6\t    pub s: String,\r\n     7\t    pub w: String,\r\n     8\t}\r\n     9\t\r\n    10\tstruct Rec {\r\n    11\t    name: String,\r\n    12\t    hdr: u64,\r\n    13\t    size: u64,\r\n    14\t    body: u64,\r\n    15\t}\r\n    16\t\r\n    17\tfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n    18\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    19\t    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" {\r\n    20\t        return Err(1);\r\n    21\t    }\r\n    22\t    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n    23\t    let mut i = 9usize;\r\n    24\t    let mut out = Vec::new();\r\n    25\t    for _ in 0..n {\r\n    26\t        if i + 26 > raw.len() {\r\n    27\t            return Err(1);\r\n    28\t        }\r\n    29\t        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    30\t        i += 8;\r\n    31\t        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    32\t        i += 8;\r\n    33\t        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    34\t        i += 8;\r\n    35\t        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;\r\n    36\t        i += 2;\r\n    37\t        if i + nl > raw.len() {\r\n    38\t            return Err(1);\r\n    39\t        }\r\n    40\t        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();\r\n    41\t        i += nl;\r\n    42\t        out.push(Rec {\r\n    43\t            name,\r\n    44\t            hdr,\r\n    45\t            size,\r\n    46\t            body,\r\n    47\t        });\r\n    48\t    }\r\n    49\t    Ok(out)\r\n    50\t}\r\n    51\t\r\n    52\tfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\r\n    53\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    54\t    let s = body as usize;\r\n"]
[26.913277, "o", "    55\t    let e = s + size as usize;\r\n    56\t    if e > raw.len() {\r\n    57\t        return Err(1);\r\n    58\t    }\r\n    59\t    Ok(raw[s..e].to_vec())\r\n    60\t}\r\n    61\t\r\n    62\tfn digest(text: &str) -> String {\r\n    63\t    let mut cmd = std::process::Command::new(\"python3\");\r\n    64\t    cmd.args([\r\n    65\t        \"-c\",\r\n    66\t        \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\",\r\n    67\t    ])\r\n    68\t    .stdin(std::process::Stdio::piped())\r\n    69\t    .stdout(std::process::Stdio::piped());\r\n    70\t    let mut child = match cmd.spawn() {\r\n    71\t        Ok(c) => c,\r\n    72\t        Err(_) => return String::new(),\r\n    73\t    };\r\n"]
[26.913499, "o", "    74\t    {\r\n    75\t        use std::io::Write;\r\n    76\t        if let Some(ref mut sin) = child.stdin {\r\n    77\t            let _ = sin.write_all(text.as_bytes());\r\n    78\t        }\r\n    79\t    }\r\n    80\t    drop(child.stdin.take());\r\n    81\t    match child.wait_with_output() {\r\n    82\t        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),\r\n    83\t        Err(_) => String::new(),\r\n    84\t    }\r\n    85\t}\r\n    86\t\r\n    87\t#[path = \"../keeppit/first.rs\"]\r\n    88\tmod first;\r\n    89\t#[path = \"../cfgbag/kv.rs\"]\r\n    90\tmod kv;\r\n    91\t#[path = \"../cfgbag/alias.rs\"]\r\n    92\tmod alias;\r\n    93\t\r\n    94\tpub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    95\t    let recs = read_idx(b)?;\r\n    96\t    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    97\t    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    98\t    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    99\t    for (i, r) in recs.iter().enumerate() {\r\n   100\t        bag.insert(i, r.name.clone());\r\n   101\t        let blob = load(a, r.body, r.size)?;\r\n   102\t        if r.name.contains(\"sys.conf\") {\r\n   103\t            confs.push((r.name.clone(), r.hdr, blob));\r\n   104\t        } else if r.name.contains(\"app.log\") {\r\n   105\t            logs.push(blob);\r\n   106\t        }\r\n   107\t    }\r\n   108\t    confs.sort_by_key(|row| row.1);\r\n   109\t    let picked = first::keep_head(&confs);\r\n   110\t    let mut t = String::new();\r\n   111\t    let mut c = String::new();\r\n   112\t    if let Some(blob) = picked {\r\n   113\t        let map = kv::pairs(&blob);\r\n   114\t        if let Some(v) = map.get(\"timezone\") {\r\n   115\t            t = v.clone();\r\n   116\t        }\r\n   117\t        if let Some(v) = map.get(\"cluster\") {\r\n   118\t            c = v.clone();\r\n   119\t        }\r\n   120\t    }\r\n   121\t    let mut e = Vec::new();\r\n   122\t    if let Some(blob) = logs.first() {\r\n   123\t        for line in String::from_utf8_lossy(blob).lines() {\r\n   124\t            let s = line.trim();\r\n   125\t            if !s.is_empty() {\r\n   126\t                e.push(s.to_string());\r\n   127\t            }\r\n   128\t        }\r\n   129\t    }\r\n   130\t    e.sort();\r\n   131\t    e.dedup();\r\n   132\t    let names: Vec<String> = bag.values().cloned().collect();\r\n   133\t    let walk = names.join(\"\\n\");\r\n   134\t    let _ = alias::fold(\"\");\r\n   135\t    Ok(Pack {\r\n   136\t        t,\r\n   137\t        c,\r\n   138\t        e,\r\n   139\t        n: confs.len() as u32,\r\n   140\t        s: a.to_string(),\r\n   141\t        w: digest(&walk).to_ascii_uppercase(),\r\n   142\t    })\r\n   143\t}\r\n"]
[26.913756, "o", "### /app/logbag/write.rs\r\n"]
[26.914591, "o", "     1\tuse super::blend::Pack;\r\n     2\t\r\n     3\tfn json_escape(s: &str) -> String {\r\n     4\t    s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")\r\n     5\t}\r\n     6\t\r\n"]
[26.914681, "o", "     7\tpub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\r\n     8\t    if let Some(parent) = std::path::Path::new(out).parent() {\r\n     9\t        let _ = std::fs::create_dir_all(parent);\r\n    10\t    }\r\n    11\t    let ev: Vec<String> = p\r\n    12\t        .e\r\n    13\t        .iter()\r\n    14\t        .map(|x| format!(\"\\\"{}\\\"\", json_escape(x)))\r\n    15\t        .collect();\r\n    16\t    let body = format!(\r\n"]
[26.914754, "o", "    17\t        \"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\r\n    18\t        json_escape(&p.t),\r\n    19\t        json_escape(&p.c),\r\n    20\t        ev.join(\",\"),\r\n    21\t        p.n,\r\n    22\t        json_escape(&p.s),\r\n    23\t        json_escape(&p.w)\r\n    24\t    );\r\n    25\t    if std::fs::write(out, body).is_err() {\r\n    26\t        return 1;\r\n    27\t    }\r\n    28\t    if std::fs::write(\"/app/deskjson/READY\", \"ok\\n\").is_err() {\r\n    29\t        return 1;\r\n    30\t    }\r\n    31\t    0\r\n    32\t}\r\n"]
[26.914824, "o", "### /app/siltcli/boot.rs\r\n"]
[26.915577, "o", "     1\t#[path = \"quarry.rs\"]\r\n     2\tmod quarry;\r\n     3\t#[path = \"slate.rs\"]\r\n     4\tmod slate;\r\n     5\t\r\n"]
[26.915609, "o", "     6\tfn main() {\r\n     7\t    let mut args = std::env::args();\r\n     8\t    let _ = args.next();\r\n     9\t    let cmd = args.next().unwrap_or_default();\r\n    10\t    let code = match cmd.as_str() {\r\n    11\t        \"quarry\" => {\r\n    12\t            let a = args\r\n    13\t                .next()\r\n    14\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    15\t            let b = args\r\n    16\t                .next()\r\n"]
[26.915627, "o", "    17\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    18\t            quarry::go(&a, &b)\r\n    19\t        }\r\n    20\t        \"brief\" => {\r\n"]
[26.915644, "o", "    21\t            let out = match args.next() {\r\n    22\t                Some(x) => x,\r\n    23\t                None => {\r\n    24\t                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n    25\t                    std::process::exit(2);\r\n    26\t                }\r\n    27\t            };\r\n    28\t            let a = args\r\n"]
[26.915654, "o", "    29\t                .next()\r\n    30\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    31\t            let b = args\r\n    32\t                .next()\r\n"]
[26.915664, "o", "    33\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    34\t            slate::go(&out, &a, &b)\r\n    35\t        }\r\n    36\t        _ => {\r\n    37\t"]
[26.915674, "o", "            eprintln!(\"usage: siltcord quarry|brief\");\r\n    38\t            2\r\n    39\t        }\r\n    40\t    };\r\n"]
[26.915692, "o", "    41\t    std::process::exit(code);\r\n    42\t}\r\n"]
[26.916027, "o", "### /app/siltcli/quarry.rs\r\n"]
[26.91665, "o", "     1\t#[path = \"../ustarwalk/hdr.rs\"]\r\n     2\tmod hdr;\r\n     3\t#[path = \"../idxmill/shard.rs\"]\r\n     4\tmod shard;\r\n     5\t\r\n"]
[26.916741, "o", "     6\tpub fn go(a: &str, b: &str) -> i32 {\r\n     7\t    shard::rib_a(a, b)\r\n     8\t}\r\n"]
[26.916882, "o", "### /app/siltcli/slate.rs\r\n"]
[26.917773, "o", "     1\t#[path = \"../overlaypit/blend.rs\"]\r\n     2\tmod blend;\r\n     3\t#[path = \"../logbag/write.rs\"]\r\n     4\tmod uni;\r\n     5\t\r\n     6\tpub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n     7\t    match blend::rib_b(a, b) {\r\n     8\t        Ok(p) => uni::rib_c(&p, out, a),\r\n     9\t        Err(c) => c,\r\n"]
[26.917879, "o", "    10\t    }\r\n    11\t}\r\n"]
[26.918015, "o", "### /app/ustarwalk/block.rs\r\n"]
[26.919365, "o", "     1\tpub fn span(n: u64) -> u64 {\r\n     2\t    ((n + 511) / 512) * 512\r\n     3\t}\r\n"]
[26.919608, "o", "\u001b[?2004h"]
[26.919663, "o", "root@2e5cd8b3aaae:/app# "]
[27.089278, "i", "python3 - <<'PY'\nimport tarfile,hashlib\np='/app/sealwell/kestrel.kith'\nwith tarfile.open(p,'r:') as t:\n m=t.getmembers()\n for i,x in enumerate(m):\n  print(i,repr(x.name),x.type,x.size,repr(t.extractfile(x).read() if x.isfile() else None))\n names=[x.name for x in m if x.isfile()]\n print('regular count',len(names))\n print('joined',repr('\\n'.join(names)))\n print('sha256',hashlib.sha256('\\n'.join(names).encode()).hexdigest())\nPY\nrustc --version\n"]
[27.089449, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[27.089557, "o", "\u001b[?2004h> "]
[27.089869, "o", "import tarfile,hashlib\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/sealwell/kestrel.kith'\r\n\u001b[?2004l\r\u001b[?2004h> with tarfile.open(p,'r:') as t:\r\n\u001b[?2004l\r"]
[27.089958, "o", "\u001b[?2004h> "]
[27.090028, "o", " m=t.getmembers()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.090142, "o", " for i,x in enumerate(m):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.090389, "o", "  print(i,repr(x.name),x.type,x.size,repr(t.extractfile(x).read() if x.isfile() else None))\r\n\u001b[?2004l\r"]
[27.090423, "o", "\u001b[?2004h> "]
[27.090575, "o", " names=[x.name for x in m if x.isfile()]\r\n\u001b[?2004l\r"]
[27.090681, "o", "\u001b[?2004h> "]
[27.090974, "o", " print('regular count',len(names))\r\n\u001b[?2004l\r\u001b[?2004h>  print('joined',repr('\\n'.join(names)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.091174, "o", " print('sha256',hashlib.sha256('\\n'.join(names).encode()).hexdigest())\r\n\u001b[?2004l\r"]
