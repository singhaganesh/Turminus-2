[18.13558, "o", "{\"timezone\":\"Etc/UTC\",\"cluster\":\"staging\",\"log_events\":[\"EVT_BOOT\"],\"member_count\":2,\"source_kith\":\"/app/sealwell/kestrel.kith\",\"walk_sig\":\"E17A6DC3F5137D651322A9552AC1718774077B92D769F5355B96FA44AF351101\"}\r\n"]
