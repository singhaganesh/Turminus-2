[62.917469, "o", "    if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0 || tag_value[5] == '\\0') {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
