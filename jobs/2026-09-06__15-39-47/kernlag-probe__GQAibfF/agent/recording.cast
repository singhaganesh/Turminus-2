[62.921848, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (parse_layout(layout_path, &layout) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out = fopen(out_path, \"w\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!out) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (fprintf(out, \"STRUCT %s\\n\", layout.struct_name) < 0) {\r\n\u001b[?2004l\r\u001b[?2004h>         fclose(out);\r\n\u001b[?2004l\r\u001b[?2004h>         remove(out_path);\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
