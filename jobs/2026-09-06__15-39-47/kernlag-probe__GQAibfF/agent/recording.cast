[63.150181, "i", "python3 - <<'PY'\np='/app/lagpipe/synclink/driver.c'\ns=open(p).read()\nstart=s.index('static int run_gen(void) {')\nend=s.index('\\nint main(', start)\nnew=r'''static int run_gen(void) {\n    source_pick pick;\n    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\n    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\n    const char *guard_out = \"/app/lagpipe/synctab_out/offline_guard.ok\";\n    FILE *tag_fp;\n    FILE *guard_fp;\n\n    /* A stamp describes only a completely successful run. */\n    remove(guard_out);\n\n    if (choose_layout(&pick) != 0) {\n        fprintf(stderr, \"imprint: layout pick failed\\n\");\n        return 1;\n    }\n    if (pick.from_bundle || permit_tag(pick.tag_value) != 0) {\n        remove(types_out);\n        remove(tag_out);\n        fprintf(stderr, \"imprint: bundled layout rejected\\n\");\n        return 1;\n    }\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\n        remove(types_out);\n        remove(tag_out);\n        fprintf(stderr, \"imprint: types write failed\\n\");\n        return 1;\n    }\n    tag_fp = fopen(tag_out, \"w\");\n    if (!tag_fp) {\n        remove(types_out);\n        perror(\"imprint: procance.tag\");\n        return 1;\n    }\n    if (fprintf(tag_fp, \"%s\\n\", pick.tag_value) < 0 || fclose(tag_fp) != 0) {\n        remove(types_out);\n        remove(tag_out);\n        fprintf(stderr, \"imprint: procance write failed\\n\");\n        return 1;\n    }\n    if (rebuild_binary() != 0) {\n        remove(types_out);\n        remove(tag_out);\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\n        return 1;\n    }\n    guard_fp = fopen(guard_out, \"w\");\n    if (!guard_fp) {\n        perror(\"imprint: offline guard\");\n        return 1;\n    }\n    if (fputs(\"1\\n\", guard_fp) == EOF || fclose(guard_fp) != 0) {\n        remove(guard_out);\n        fprintf(stderr, \"imprint: offline guard write failed\\n\");\n        return 1;\n    }\n    return 0;\n}\n'''\nopen(p,'w').write(s[:start]+new+s[end:])\nPY\n# Add the gate declaration's header to the driver.\npython3 - <<'PY'\np='/app/lagpipe/synclink/driver.c'\ns=open(p).read()\ns=s.replace('#include \"common.h\"\\n', '#include \"common.h\"\\n#include \"../tagc/gate.h\"\\n', 1)\nopen(p,'w').write(s)\nPY\nmake -C /app/lagpipe bind\n"]
