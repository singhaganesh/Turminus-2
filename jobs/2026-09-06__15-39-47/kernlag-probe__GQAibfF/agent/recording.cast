[21.691059, "i", "printf '%s\\n' '--- FIELD_RULES ---'; cat /app/lagpipe/fieldnotes/FIELD_RULES.txt; printf '%s\\n' '--- Makefile ---'; cat /app/lagpipe/Makefile; printf '%s\\n' '--- relc/input.c ---'; sed -n '1,240p' /app/relc/input.c; printf '%s\\n' '--- emit_writer.c ---'; sed -n '1,260p' /app/lagpipe/tblw/emit_writer.c; printf '%s\\n' '--- gate.c/h ---'; sed -n '1,260p' /app/lagpipe/tagc/gate.c; cat /app/lagpipe/tagc/gate.h\n"]
[21.693679, "o", "printf '%s\\n' '--- FIELD_RULES ---'; cat /app/lagpipe/fieldnotes/FIELD_RULES.txt; printf '%s\\n' '--- Makefile ---'; cat /app/lagpipe/Makefile; printf '%s\\n' '--- relc/input.c ---'; sed -n '1,240p' /app/relc/input.c; printf '%s\\n' '--- emit_writer.c ---'; sed -n '1,260p' /app/lagpipe/tblw/emit_writer.c; printf '%s\\n' '--- gate.c/h ---'; sed -n '1,260p' /app/lagpipe/tagc/gate.c; cat /app/lagpipe/tagc/gate.h\r\n\u001b[?2004l\r"]
[21.698388, "o", "--- FIELD_RULES ---\r\n"]
[21.701076, "o", "Layout table lines:\r\n  STRUCT <name>\r\n  FIELD <name> <kind> <offset> <size>\r\n\r\nKinds: u32, u64. Sample blobs are little-endian packed fields in field order.\r\nsched_entity fields include pid, weight, migration_flags, slice_ns.\r\n\r\nprocance.tag is one line: live:<release> or bundle:<release>\r\noffline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n\r\nCLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\nmemvault captures: /app/memvault/samples/*.mem\r\nmemvault cards: /app/memvault/cards/*.ref\r\nrunning release file: /app/livekern/running.release\r\n"]
[21.701394, "o", "--- Makefile ---\r\n"]
[21.703845, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Isynclink -Itagc\r\nSRC := $(wildcard synclink/*.c) ../relc/input.c tblw/emit_writer.c tagc/gate.c\r\nBIN := /app/bin/kernscribe\r\n\r\n.PHONY: bind\r\nbind:\r\n\tmkdir -p /app/bin /app/lagpipe/synctab_out\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[21.705814, "o", "--- relc/input.c ---\r\n"]
[21.706279, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
[21.706844, "o", "--- emit_writer.c ---\r\n"]
[21.708911, "o", "#include \"../synclink/common.h\"\r\n#include \"../tagc/gate.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\r\n    layout_def layout;\r\n    FILE *out;\r\n\r\n    if (parse_layout(layout_path, &layout) != 0) {\r\n        return -1;\r\n    }\r\n    out = fopen(out_path, \"w\");\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\r\n    for (int i = 0; i < layout.nfields; i++) {\r\n        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name, layout.fields[i].kind,\r\n                layout.fields[i].off, layout.fields[i].size);\r\n    }\r\n    fclose(out);\r\n    if (tag_value && permit_tag(tag_value) != 0) {\r\n        return -1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[21.70996, "o", "--- gate.c/h ---\r\n"]
[21.71066, "o", "#include \"gate.h\"\r\n\r\nint permit_tag(const char *tag_value) {\r\n    (void)tag_value;\r\n    return 0;\r\n}\r\n"]
[21.713723, "o", "#ifndef KERNLAG_GATE_H\r\n#define KERNLAG_GATE_H\r\n\r\nint permit_tag(const char *tag_value);\r\n\r\n#endif\r\n"]
[21.714258, "o", "\u001b[?2004hroot@b9494313f5ac:/app# "]
[22.225716, "i", "for f in /app/lagpipe/synclink/*.c /app/lagpipe/synclink/*.h /app/lagpipe/synclink/ARCHITECTURE; do echo \"--- $f ---\"; sed -n '1,280p' \"$f\"; done\n"]
[22.226707, "o", "for f in /app/lagpipe/synclink/*.c /app/lagpipe/synclink/*.h /app/lagpipe/synclink/ARCHITECTURE; do echo \"--- $f ---\"; sed -n '1,280p' \"$f\"; done\r\n\u001b[?2004l\r"]
[22.227529, "o", "--- /app/lagpipe/synclink/driver.c ---\r\n"]
[22.231079, "o", "#include \"common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int run_gen(void) {\r\n    source_pick pick;\r\n    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\r\n    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\r\n    FILE *tag_fp;\r\n\r\n    if (choose_layout(&pick) != 0) {\r\n        fprintf(stderr, \"imprint: layout pick failed\\n\");\r\n        return 1;\r\n    }\r\n    tag_fp = fopen(tag_out, \"w\");\r\n    if (!tag_fp) {\r\n        perror(\"imprint: procance.tag\");\r\n        return 1;\r\n    }\r\n    fprintf(tag_fp, \"%s\\n\", pick.tag_value);\r\n    fclose(tag_fp);\r\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\r\n        fprintf(stderr, \"imprint: types write failed\\n\");\r\n        return 1;\r\n    }\r\n    if (rebuild_binary() != 0) {\r\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\r\n        return 2;\r\n    }\r\n    if (strcmp(argv[1], \"synctab\") == 0) {\r\n        return run_gen();\r\n    }\r\n    if (strcmp(argv[1], \"inspect\") == 0) {\r\n        if (argc < 3) {\r\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\r\n            return 2;\r\n        }\r\n        return emit_inspect_json(argv[2]);\r\n    }\r\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\r\n    return 2;\r\n}\r\n"]
[22.231378, "o", "--- /app/lagpipe/synclink/field_emit.c ---\r\n"]
[22.232978, "o", "#include \"common.h\"\r\n\r\n#include <stdint.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic unsigned long read_u32(const unsigned char *buf, unsigned off) {\r\n    uint32_t v;\r\n    memcpy(&v, buf + off, sizeof(v));\r\n    return (unsigned long)v;\r\n}\r\n\r\nstatic unsigned long long read_u64(const unsigned char *buf, unsigned off) {\r\n    uint64_t v;\r\n    memcpy(&v, buf + off, sizeof(v));\r\n    return (unsigned long long)v;\r\n}\r\n\r\nint emit_inspect_json(const char *inspect_path) {\r\n    layout_def layout;\r\n    unsigned char blob[64];\r\n"]
[22.233031, "o", "    size_t nread;\r\n    FILE *fp = fopen(inspect_path, \"rb\");\r\n    if (!fp) {\r\n        perror(\"probe\");\r\n        return 1;\r\n    }\r\n    nread = fread(blob, 1, sizeof(blob), fp);\r\n    fclose(fp);\r\n    if (nread < 16) {\r\n        fprintf(stderr, \"probe: inspect too short\\n\");\r\n        return 1;\r\n    }\r\n    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\r\n        fprintf(stderr, \"probe: layout.tbl missing\\n\");\r\n        return 1;\r\n    }\r\n    printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\r\n    for (int i = 0; i < layout.nfields; i++) {\r\n        const field_def *f = &layout.fields[i];\r\n        if (strcmp(f->kind, \"u64\") == 0) {\r\n            printf(\",\\\"%s\\\":%llu\", f->name, read_u64(blob, f->off));\r\n"]
[22.233051, "o", "        } else {\r\n            printf(\",\\\"%s\\\":%lu\", f->name, read_u32(blob, f->off));\r\n        }\r\n    }\r\n    printf(\"}\\n\");\r\n    return 0;\r\n}\r\n"]
[22.233475, "o", "--- /app/lagpipe/synclink/parse_layout.c ---\r\n"]
[22.234844, "o", "#include \"common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint parse_layout(const char *path, layout_def *layout) {\r\n    FILE *fp = fopen(path, \"r\");\r\n    char line[256];\r\n    if (!fp || !layout) {\r\n        return -1;\r\n    }\r\n    memset(layout, 0, sizeof(*layout));\r\n    while (fgets(line, sizeof(line), fp)) {\r\n"]
[22.234987, "o", "        char name[64];\r\n        char kind[16];\r\n        unsigned off = 0;\r\n        unsigned size = 0;\r\n        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1) {\r\n            continue;\r\n        }\r\n        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\r\n            field_def *f = &layout->fields[layout->nfields++];\r\n            snprintf(f->name, sizeof(f->name), \"%s\", name);\r\n            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\r\n            f->off = off;\r\n            f->size = size;\r\n        }\r\n    }\r\n    fclose(fp);\r\n    return layout->nfields > 0 ? 0 : -1;\r\n}\r\n"]
[22.235227, "o", "--- /app/lagpipe/synclink/rebuild.c ---\r\n"]
[22.236619, "o", "#include \"common.h\"\r\n\r\n#include <stdlib.h>\r\n\r\nint rebuild_binary(void) {\r\n    return system(\"make -C /app/lagpipe bind >/dev/null 2>&1\");\r\n}\r\n"]
[22.236914, "o", "--- /app/lagpipe/synclink/common.h ---\r\n"]
[22.238661, "o", "#ifndef KERN_FORGE_COMMON_H\r\n#define KERN_FORGE_COMMON_H\r\n\r\n#include <stddef.h>\r\n\r\n#define LAYOUT_PATH_LEN 512\r\n#define TAG_PATH_LEN 512\r\n#define RELEASE_LEN 64\r\n#define FIELD_MAX 16\r\n\r\ntypedef struct {\r\n    char name[64];\r\n    char kind[16];\r\n    unsigned off;\r\n    unsigned size;\r\n} field_def;\r\n\r\n"]
[22.239097, "o", "typedef struct {\r\n    char struct_name[64];\r\n    field_def fields[FIELD_MAX];\r\n    int nfields;\r\n} layout_def;\r\n\r\ntypedef struct {\r\n    char layout_path[LAYOUT_PATH_LEN];\r\n    char tag_value[RELEASE_LEN];\r\n    int from_bundle;\r\n} source_pick;\r\n\r\nint choose_layout(source_pick *out);\r\nint parse_layout(const char *path, layout_def *layout);\r\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value);\r\nint emit_inspect_json(const char *inspect_path);\r\nint rebuild_binary(void);\r\n\r\n#endif\r\n"]
[22.23956, "o", "--- /app/lagpipe/synclink/ARCHITECTURE ---\r\n"]
[22.241193, "o", "kernscribe synclink units live here.\r\n"]
[22.241487, "o", "\u001b[?2004hroot@b9494313f5ac:/app# "]
[22.664678, "i", "printf '%s\\n' '--- candidate inputs ---'; find /app -maxdepth 5 -type f \\( -iname '*layout*' -o -iname '*offset*' -o -iname '*stamp*' -o -iname '*bundle*' -o -iname '*btf*' -o -iname '*release*' \\) -printf '%p\\n' | sort; printf '%s\\n' '--- relc tree ---'; find /app/relc -maxdepth 3 -type f -printf '%p\\n' -exec sh -c 'echo \"--- $1\"; sed -n \"1,220p\" \"$1\"' _ {} \\;\n"]
[22.66693, "o", "printf '%s\\n' '--- candidate inputs ---'; find /app -maxdepth 5 -type f \\( -iname '*layout*' -o -iname '*offset*' -o -iname '*stamp*' -o -iname '*bundle*' -o -iname '*btf*' -o -iname '*release*' \\) -printf '%p\\n' | sort; printf '%s\\n' '--- relc tree ---'; find /app/relc -maxdepth 3 -type f -printf '%p\\n' -exec sh -c 'echo \"--- $1\"; sed -n \"1,220p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[22.667093, "o", "--- candidate inputs ---\r\n"]
[22.676038, "o", "/app/lagpipe/synclink/parse_layout.c\r\n/app/lagpipe/synctab_out/layout.tbl\r\n/app/livekern/running.release\r\n/app/memvault/regression/bundle_pick_input.c\r\n"]
[22.676799, "o", "--- relc tree ---\r\n"]
[22.680781, "o", "/app/relc/input.c\r\n"]
[22.683583, "o", "--- /app/relc/input.c\r\n"]
[22.68493, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n"]
[22.685263, "o", "    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
