[9.83319, "o", "lagpipe synctab repair map (internal)\r\n\r\n- relc/input.c — chooses layout input for synctab\r\n- tblw/emit_writer.c — writes synctab_out/layout.tbl from the picked layout\r\n- tagc/gate.c — records whether bundled snapshots are acceptable\r\n- synclink/field_emit.c — reads captures using stamp offsets\r\n\r\nAbsolute synctab repair paths:\r\n  /app/relc/input.c\r\n  /app/lagpipe/tblw/emit_writer.c\r\n  /app/lagpipe/tagc/gate.c\r\n\r\nRebuild entrypoint: make -C /app/lagpipe bind\r\n"]
[9.833405, "o", "\r\n--- tree ---\r\n"]
