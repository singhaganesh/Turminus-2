[33.665328, "o", "\u001b[?2004hroot@b9494313f5ac:/app# "]
[62.903877, "i", "cat > /app/relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic int read_running_release(char *release, size_t n) {\n    FILE *fp;\n    size_t len;\n\n    if (!release || n == 0) {\n        return -1;\n    }\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp) {\n        return -1;\n    }\n    if (!fgets(release, (int)n, fp)) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n\n    len = strlen(release);\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r' ||\n                       release[len - 1] == ' ' || release[len - 1] == '\\t')) {\n        release[--len] = '\\0';\n    }\n    if (len == 0) {\n        return -1;\n    }\n    return 0;\n}\n\nint choose_layout(source_pick *out) {\n    char release[RELEASE_LEN];\n\n    if (!out) {\n        return -1;\n    }\n    memset(out, 0, sizeof(*out));\n    if (read_running_release(release, sizeof(release)) != 0) {\n        return -1;\n    }\n\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/livekern/exports/sched_entity.tab\");\n    if (snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release) >=\n        (int)sizeof(out->tag_value)) {\n        return -1;\n    }\n    out->from_bundle = 0;\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    /* This image requires the running kernel export; offline bundles are invalid. */\n    if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0 || tag_value[5] == '\\0') {\n        return -1;\n    }\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tblw/emit_writer.c <<'EOF'\n#include \"../synclink/common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\n    layout_def layout;\n    FILE *out;\n\n    if (!layout_path || !out_path || permit_tag(tag_value) != 0) {\n        return -1;\n    }\n    if (parse_layout(layout_path, &layout) != 0) {\n        return -1;\n    }\n    out = fopen(out_path, \"w\");\n    if (!out) {\n        return -1;\n    }\n    if (fprintf(out, \"STRUCT %s\\n\", layout.struct_name) < 0) {\n        fclose(out);\n        remove(out_path);\n        return -1;\n    }\n    for (int i = 0; i < layout.nfields; i++) {\n        if (fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name,\n                    layout.fields[i].kind, layout.fields[i].off,\n                    layout.fields[i].size) < 0) {\n            fclose(out);\n            remove(out_path);\n            return -1;\n        }\n    }\n    if (fclose(out) != 0) {\n        remove(out_path);\n        return -1;\n    }\n    return 0;\n}\nEOF\n"]
[62.904188, "o", "cat > /app/relc/input.c <<'EOF'\r\n\u001b[?2004l\r"]
[62.904233, "o", "\u001b[?2004h> "]
[62.904386, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\u001b[?2004l\r"]
[62.904419, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.904711, "o", "\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.904878, "o", "static int read_running_release(char *release, size_t n) {\r\n\u001b[?2004l\r"]
[62.904959, "o", "\u001b[?2004h"]
