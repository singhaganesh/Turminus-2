[86.358129, "i", "python3 - <<'PY'\np='/app/relc/input.c'\ns=open(p).read()\ns=s.replace('    size_t len;\\n', '    size_t len;\\n    size_t start = 0;\\n')\nold='''    if (len == 0) {\n        return -1;\n    }\n    return 0;\n'''\nnew='''    while (release[start] == ' ' || release[start] == '\\\\t' ||\n           release[start] == '\\\\n' || release[start] == '\\\\r') {\n        start++;\n    }\n    if (start > 0) {\n        memmove(release, release + start, strlen(release + start) + 1);\n    }\n    if (release[0] == '\\\\0') {\n        return -1;\n    }\n    return 0;\n'''\nif old not in s:\n    raise SystemExit('target not found')\nopen(p,'w').write(s.replace(old,new))\nPY\nmake -C /app/lagpipe bind\n"]
