[33.23719, "i", "echo '--- driver.c ---'; cat /app/lagpipe/synclink/driver.c; echo '--- field_emit.c ---'; cat /app/lagpipe/synclink/field_emit.c; echo '--- parse_layout.c ---'; cat /app/lagpipe/synclink/parse_layout.c; echo '--- regression fixture ---'; cat /app/memvault/regression/bundle_pick_input.c 2>/dev/null || true; echo '--- snapvault ---'; find /app/snapvault -maxdepth 4 -type f -printf '%p (%s bytes)\\n' -exec sh -c 'echo ---; cat \"$1\"' _ {} \\;\n"]
