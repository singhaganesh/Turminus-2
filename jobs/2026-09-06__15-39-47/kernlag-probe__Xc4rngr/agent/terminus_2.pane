#include "../lagpipe/synclink/common.h"

#include <stdio.h>
#include <string.h>

static int read_pin(char *release, size_t n) {
    FILE *fp = fopen("/app/snapvault/default.pin", "r");
    if (!fp) {
        return -1;
    }
    if (!fgets(release, (int)n, fp)) {
        fclose(fp);
        return -1;
    }
    fclose(fp);
    size_t len = strlen(release);
    while (len > 0 && (release[len - 1] == '\n' || release[len - 1] == '\r')) {
        release[--len] = '\0';
    }
    return 0;
}

static void apply_policy_release(char *release, size_t n) {
    FILE *fp = fopen("/app/snapvault/policy.conf", "r");
    char line[128];
    char val[RELEASE_LEN];
    if (!fp) {
        return;
    }
    while (fgets(line, sizeof(line), fp)) {
        if (sscanf(line, "DEFAULT_RELEASE=%63s", val) == 1) {
            snprintf(release, n, "%s", val);
        }
    }
    fclose(fp);
}

int choose_layout(source_pick *out) {
    char release[RELEASE_LEN];

    if (!out) {
        return -1;
    }
    memset(out, 0, sizeof(*out));

    if (read_pin(release, sizeof(release)) != 0) {
        return -1;
    }
    apply_policy_release(release, sizeof(release));
    snprintf(out->layout_path, sizeof(out->layout_path),
             "/app/snapvault/releases/%s/sched_entity.tab", release);
    snprintf(out->tag_value, sizeof(out->tag_value), "bundle:%s", release);
    out->from_bundle = 1;
    return 0;
}
===== /app/lagpipe/tblw/emit_writer.c =====
#include "../synclink/common.h"
#include "../tagc/gate.h"

#include <stdio.h>
#include <string.h>

int write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {
    layout_def layout;
    FILE *out;

    if (parse_layout(layout_path, &layout) != 0) {
        return -1;
    }
    out = fopen(out_path, "w");
    if (!out) {
        return -1;
    }
    fprintf(out, "STRUCT %s\n", layout.struct_name);
    for (int i = 0; i < layout.nfields; i++) {
        fprintf(out, "FIELD %s %s %u %u\n", layout.fields[i].name, layout.fields[i].kind,
                layout.fields[i].off, layout.fields[i].size);
    }
    fclose(out);
    if (tag_value && permit_tag(tag_value) != 0) {
        return -1;
    }
    return 0;
}
