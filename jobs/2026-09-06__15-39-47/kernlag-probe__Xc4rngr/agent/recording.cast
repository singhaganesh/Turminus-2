[9.769496, "o", "cat /app/lagpipe/fieldnotes/ROUTE_MAP.txt"]
[9.769616, "o", "\r\n\u001b[?2004l\r"]
[9.77185, "o", "lagpipe synctab repair map (internal)\r\n\r\n- relc/input.c — chooses layout input for synctab\r\n- tblw/emit_writer.c — writes synctab_out/layout.tbl from the picked layout\r\n- tagc/gate.c — records whether bundled snapshots are acceptable\r\n- synclink/field_emit.c — reads captures using stamp offsets\r\n\r\nAbsolute synctab repair paths:\r\n  /app/relc/input.c\r\n  /app/lagpipe/tblw/emit_writer.c\r\n  /app/lagpipe/tagc/gate.c\r\n\r\nRebuild entrypoint: make -C /app/lagpipe bind\r\n"]
[9.771905, "o", "\u001b[?2004hroot@607f1764f6f9:/app# "]
[9.987757, "i", "find /app/lagpipe -maxdepth 3 -type f -printf '%p\\n' | sort\n"]
[9.988147, "o", "find /app/lagpipe -maxdepth 3 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[9.990912, "o", "/app/lagpipe/BUILDCHANNEL\r\n/app/lagpipe/Makefile\r\n/app/lagpipe/VERIFIER_CHANNEL\r\n/app/lagpipe/fieldnotes/FIELD_RULES.txt\r\n/app/lagpipe/fieldnotes/ROUTE_MAP.txt\r\n/app/lagpipe/synclink/ARCHITECTURE\r\n/app/lagpipe/synclink/common.h\r\n/app/lagpipe/synclink/driver.c\r\n/app/lagpipe/synclink/field_emit.c\r\n/app/lagpipe/synclink/parse_layout.c\r\n"]
[9.991116, "o", "/app/lagpipe/synclink/rebuild.c\r\n/app/lagpipe/synctab_out/layout.tbl\r\n/app/lagpipe/synctab_out/procance.tag\r\n/app/lagpipe/tagc/gate.c\r\n/app/lagpipe/tagc/gate.h\r\n/app/lagpipe/tblw/emit_writer.c\r\n"]
