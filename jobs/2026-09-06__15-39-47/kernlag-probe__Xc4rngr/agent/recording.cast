[29.642903, "i", "printf '%s\\n' '--- live export ---'; cat /app/livekern/exports/sched_entity.tab; printf '%s\\n' '--- live metadata ---'; for f in /app/livekern/CHANNEL /app/livekern/EXPORTS /app/livekern/VERSION; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- snapvault ---'; find /app/snapvault -maxdepth 4 -type f -print -exec sh -c 'echo --- $1; cat \"$1\"' _ {} \\;\n"]
[29.644906, "o", "printf '%s\\n' '--- live export ---'; cat /app/livekern/exports/sched_entity.tab; printf '%s\\n' '--- live metadata ---'; for f in /app/livekern/CHANNEL /app/livekern/EXPORTS /app/livekern/VERSION; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- snapvault ---'; find /app/snapvault -maxdepth 4 -type f -print -exec sh -c 'echo --- $1; cat \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[29.645351, "o", "--- live export ---\r\n"]
[29.648853, "o", "STRUCT sched_entity\r\nFIELD pid u32 0 4\r\nFIELD weight u32 4 4\r\nFIELD migration_flags u32 8 4\r\nFIELD slice_ns u64 12 8\r\n"]
