[29.889874, "o", "\u001b[?2004hroot@607f1764f6f9:/app# "]
[54.101351, "i", "cat > /app/relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic int read_running_release(char *release, size_t n) {\n    FILE *fp;\n    char raw[RELEASE_LEN * 2];\n    char *start;\n    char *end;\n\n    if (!release || n == 0) {\n        return -1;\n    }\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp) {\n        return -1;\n    }\n    if (!fgets(raw, sizeof(raw), fp)) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n\n    start = raw;\n    while (*start && isspace((unsigned char)*start)) {\n        start++;\n    }\n    end = start + strlen(start);\n    while (end > start && isspace((unsigned char)end[-1])) {\n        end--;\n    }\n    *end = '\\0';\n    if (*start == '\\0' || strlen(start) >= n) {\n        return -1;\n    }\n    snprintf(release, n, \"%s\", start);\n    return 0;\n}\n\nint choose_layout(source_pick *out) {\n    char release[RELEASE_LEN];\n    FILE *layout;\n\n    if (!out) {\n        return -1;\n    }\n    memset(out, 0, sizeof(*out));\n    if (read_running_release(release, sizeof(release)) != 0) {\n        return -1;\n    }\n\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/livekern/exports/sched_entity.tab\");\n    layout = fopen(out->layout_path, \"r\");\n    if (!layout) {\n        return -1;\n    }\n    fclose(layout);\n\n    snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release);\n    out->from_bundle = 0;\n    return 0;\n}\nEOF\n\ncat > /app/lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0 || tag_value[5] == '\\0') {\n        return -1;\n    }\n    if (strncmp(tag_value, \"bundle:\", 7) == 0) {\n        return -1;\n    }\n    return 0;\n}\nEOF\n\ncat > /app/lagpipe/tblw/emit_writer.c <<'EOF'\n#include \"../synclink/common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\n    layout_def layout;\n    FILE *out;\n\n    if (permit_tag(tag_value) != 0 || parse_layout(layout_path, &layout) != 0) {\n        return -1;\n    }\n    out = fopen(out_path, \"w\");\n    if (!out) {\n        return -1;\n    }\n    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\n    for (int i = 0; i < layout.nfields; i++) {\n        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name,\n                layout.fields[i].kind, layout.fields[i].off, layout.fields[i].size);\n    }\n    if (fclose(out) != 0) {\n        return -1;\n    }\n    return 0;\n}\nEOF\n\ncat > /app/lagpipe/synclink/driver.c <<'EOF'\n#include \"common.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int run_gen(void) {\n    source_pick pick;\n    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\n    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\n    const char *guard_out = \"/app/lagpipe/synctab_out/offline_guard.ok\";\n    FILE *fp;\n\n    /* A stale guard must never make a failed synchronization look successful. */\n    unlink(guard_out);\n    unlink(types_out);\n    unlink(tag_out);\n\n    if (choose_layout(&pick) != 0 || pick.from_bundle) {\n        fprintf(stderr, \"imprint: live layout pick failed\\n\");\n        return 1;\n    }\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\n        fprintf(stderr, \"imprint: types write failed\\n\");\n        unlink(types_out);\n        return 1;\n    }\n\n    fp = fopen(tag_out, \"w\");\n    if (!fp) {\n        perror(\"imprint: procance.tag\");\n        unlink(types_out);\n        return 1;\n    }\n    fprintf(fp, \"%s\\n\", pick.tag_value);\n    if (fclose(fp) != 0) {\n        unlink(types_out);\n        unlink(tag_out);\n        return 1;\n    }\n\n    if (rebuild_binary() != 0) {\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\n        unlink(types_out);\n        unlink(tag_out);\n        return 1;\n    }\n\n    fp = fopen(guard_out, \"w\");\n    if (!fp) {\n        perror(\"imprint: offline_guard.ok\");\n        unlink(types_out);\n        unlink(tag_out);\n        return 1;\n    }\n    fputs(\"1\\n\", fp);\n    if (fclose(fp) !"]
[54.101548, "i", "= 0) {\n        unlink(guard_out);\n        unlink(types_out);\n        unlink(tag_out);\n        return 1;\n    }\n    return 0;\n}\n\nint main(int argc, char **argv) {\n    if (argc < 2) {\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\n        return 2;\n    }\n    if (strcmp(argv[1], \"synctab\") == 0) {\n        return run_gen();\n    }\n    if (strcmp(argv[1], \"inspect\") == 0) {\n        if (argc < 3) {\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\n            return 2;\n        }\n        return emit_inspect_json(argv[2]);\n    }\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\n    return 2;\n}\nEOF\nmake -C /app/lagpipe bind\n"]
[54.101983, "o", "cat > /app/relc/input.c <<'EOF'\r\n"]
