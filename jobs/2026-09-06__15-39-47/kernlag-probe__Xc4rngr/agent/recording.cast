[59.16025, "i", "python3 - <<'PY'\nimport glob, json, os, subprocess, sys\nok = True\nfor capture in sorted(glob.glob('/app/memvault/samples/*.mem')):\n    name = os.path.splitext(os.path.basename(capture))[0]\n    ref_path = f'/app/memvault/cards/{name}.ref'\n    got_text = subprocess.check_output(['/app/bin/kernscribe', 'inspect', capture], text=True).strip()\n    with open(ref_path) as f:\n        ref_text = f.read().strip()\n    got, ref = json.loads(got_text), json.loads(ref_text)\n    match = got == ref\n    ok &= match\n    print(f'{name}: {\"PASS\" if match else \"FAIL\"}')\n    print(' inspect:', got_text)\n    print(' ref:    ', ref_text)\nprint('all_matches=', ok)\nsys.exit(0 if ok else 1)\nPY\n"]
[59.160596, "o", "python3 - <<'PY'\r\n"]
