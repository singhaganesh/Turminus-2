			// No other ASCII or Unicode whitespace is a field separator.
			if line[i] == '\r' || line[i] == '\n' || line[i] == '\v' || line[i] == '\f' { return nil, false }
			i++
		}
		fields = append(fields, line[start:i])
	}
	return fields, true
}

func parseRoll(sheet string) ([]Car, int) {
	var cars []Car
	for _, raw := range strings.Split(sheet, "\n") {
		w, valid := splitFields(raw)
		if !valid { return nil, -2 }
		if len(w) == 0 || strings.HasPrefix(w[0], "#") { continue }
		if len(w) != 12 || w[0] != "PLATE" || w[2] != "LEN" || w[4] != "HT" ||
			w[6] != "MASS" || w[8] != "HAZ" || w[10] != "BOARD" || !safeName(w[1]) { return nil, -2 }
		length, a := uint(w[3]); ht, b := uint(w[5]); mass, c := uint(w[7])
		haz, d := uint(w[9]); board, e := uint(w[11])
		if !a || !b || !c || !d || !e || length == 0 || ht == 0 || mass == 0 || board == 0 || haz > 1 { return nil, -2 }
		cars = append(cars, Car{w[1], length, ht, mass, haz, board, len(cars)})
	}
	return cars, 0
}
