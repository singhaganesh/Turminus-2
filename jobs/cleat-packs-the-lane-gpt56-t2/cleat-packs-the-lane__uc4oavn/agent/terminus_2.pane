cat > vault.go <<'EOF'
package main

type Lane struct { Deck, Name string; Lid, Span, MassLid int }
func allLanes() []Lane { return []Lane{
	{"A", "A1", 180, 2000, 8000}, {"A", "A2", 180, 2000, 8000},
	{"B", "B1", 420, 2000, 18000}, {"B", "B2", 420, 2000, 18000},
} }
func deckLid(deck string) int { if deck == "A" { return 11000 }; return 28000 }
func sister(name string) string { switch name { case "A1": return "A2"; case "A2": return "A1"; case "B1": return "B2"; default: return "B1" } }
EOF
cat > board.go <<'EOF'
package main
import "sort"
func arrange(cars []Car) []Car {
	out := append([]Car(nil), cars...)
	sort.Slice(out, func(i,j int) bool { if out[i].Board == out[j].Board { return out[i].Plate < out[j].Plate }; return out[i].Board < out[j].Board })
	return out
}
