cat > offer.go <<'EOF'
package main

type occ struct { used, mass, lastHaz int; has bool }

func candidate(lane Lane, car Car, fill map[string]*occ, deckKg map[string]int) (int, bool) {
	if car.Ht > lane.Lid { return 0, false }
	o := fill[lane.Name]
	if o == nil { o = &occ{} }
	gap := 0
	if o.has { gap = neighbourGap(o.lastHaz, car.Haz) }
	if o.used + gap + car.Len + rampApron(car.Haz) > lane.Span { return 0, false }
	if o.mass + car.Mass > lane.MassLid || deckKg[lane.Deck] + car.Mass > deckLid(lane.Deck) { return 0, false }
	if !trimFits(lane, fill, car.Mass) { return 0, false }
	return lane.Span - o.used - gap - car.Len, true
}
EOF
cat > trim.go <<'EOF'
package main
func trimFits(lane Lane, fill map[string]*occ, extra int) bool {
	a, b := fill[lane.Name], fill[sister(lane.Name)]
	if a == nil || b == nil || !a.has || !b.has { return true }
	d := a.mass + extra - b.mass
	if d < 0 { d = -d }
	return d <= 3000
}
EOF
