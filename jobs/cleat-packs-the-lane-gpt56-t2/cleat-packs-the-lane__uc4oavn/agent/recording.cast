[187.911937, "i", "cat >/tmp/haz.roll <<'EOF'\nPLATE both1 LEN 300 HT 400 MASS 1000 HAZ 1 BOARD 1\nPLATE both2 LEN 300 HT 400 MASS 1000 HAZ 1 BOARD 2\nPLATE clean LEN 300 HT 400 MASS 1000 HAZ 0 BOARD 3\nEOF\n/opt/ferry/bin/cleat stow --roll /tmp/haz.roll --chalk /tmp/haz.chalk; echo \"haz rc=$?\"; cat /tmp/haz.chalk\ncat >/tmp/rules.roll <<'EOF'\nPLATE later-listed LEN 1000 HT 180 MASS 7000 HAZ 0 BOARD 2\nPLATE first LEN 1000 HT 180 MASS 4000 HAZ 0 BOARD 1\nPLATE too-tall LEN 2000 HT 421 MASS 1 HAZ 0 BOARD 3\nPLATE exact-tall LEN 2000 HT 420 MASS 18000 HAZ 0 BOARD 4\nEOF\n/opt/ferry/bin/cleat stow --roll /tmp/rules.roll --chalk /tmp/rules.chalk; echo \"rules rc=$?\"; cat /tmp/rules.chalk\nprintf 'PLATE x LEN 1 HT 1 MASS 1 HAZ 0 BOARD 1\\r\\n' >/tmp/cr.roll\n/opt/ferry/bin/cleat stow --roll /tmp/cr.roll --chalk /tmp/cr.chalk; echo \"CR-field rc=$?\"\n"]
