[11.508239, "o", "/app/dock/discharge.md\r\n/app/dock/harbour.md\r\n/app/dock/lane-cards.md\r\n/app/environment/Makefile\r\n/app/environment/apron.go\r\n/app/environment/board.go\r\n/app/environment/cars.go\r\n/app/environment/chalk.go\r\n/app/environment/fold.go\r\n/app/environment/go.mod\r\n/app/environment/kilo.go\r\n/app/environment/main.go\r\n/app/environment/offer.go\r\n/app/environment/parse.go\r\n/app/environment/spacing.go\r\n/app/environment/trim.go\r\n/app/environment/vault.go\r\n/app/rolls/night.roll\r\n"]
[11.508586, "o", "--- harbour ---\r\n"]
[11.509362, "o", "# Harbour stow book\r\n\r\nCall `/opt/ferry/bin/cleat stow --roll PATH --chalk PATH`.\r\nRolls are UTF-8, one command per line. Blank lines and `#` comments are\r\nskipped. Fields are spaces or tabs. Plate names are letters, digits, period,\r\nunderscore, or hyphen. Length, height, mass, hazmat, and board numbers are\r\nunsigned decimals. Anything else is malformed (exit 2).\r\n\r\n```\r\nPLATE name LEN cm HT cm MASS kg HAZ 0|1 BOARD n\r\n```\r\n\r\n`LEN`, `HT`, and `MASS` must be greater than zero. `HAZ` is `0` or `1`. `BOARD`\r\nis a positive boarding sequence: smaller numbers drive on first. Equal `BOARD`\r\nvalues load in ascending plate name.\r\n\r\nAn empty roll writes an empty chalk file and exits 0. Chalk is replaced with\r\nNDJSON. `i` starts at 1; every input plate yields one `stow` row in listing\r\norder, not packing order. Successful `ok` is `yes`; otherwise `no`. `verb` is\r\n`stow`. A plate that cannot fit is not placed: `ok` is `no` and `deck`, `lane`,\r\nand `station` are omitted.\r\n\r\nLane lids live on `/app/dock/lane-cards.md`. Sea"]
[11.509464, "o", "ts, stations, and keep-clear\r\ndistances live on `/app/dock/discharge.md`.\r\n"]
[11.509599, "o", "--- lane cards ---\r\n"]
[11.510371, "o", "# Lane cards\r\n\r\nSearch order is `A1`, `A2`, `B1`, `B2`.\r\n\r\n| Lane | Height lid (cm) | Span (cm) | Mass lid (kg) |\r\n| A1 | 180 | 2000 | 8000 |\r\n| A2 | 180 | 2000 | 8000 |\r\n| B1 | 420 | 2000 | 18000 |\r\n| B2 | 420 | 2000 | 18000 |\r\n\r\nDeck `A` also has a paired kilogram lid of 11000 that both `A1` and `A2` share.\r\nDeck `B` has a paired kilogram lid of 28000 that both `B1` and `B2` share.\r\nSister lanes on a deck must stay within 3000 kg of each other once both sisters\r\nalready hold a plate. Opening the first plate on a deck is free. Opening the\r\nsecond sister lane is free.\r\n\r\nKilograms already packed in a lane count against that lane's mass lid. Kilograms\r\nalready packed on the same deck letter count against the paired lid. A plate\r\nthat fits leftover centimetres but not leftover lane kilograms, or that would\r\nbreak the paired lid or sister trim, must try the next lane. Leftover is\r\ncomputed after earlier boarding seats, not after the order the names appear in\r\nthe roll.\r\n\r\nDecks: `A` lid 180 cm; `B` lid 420 cm. L"]
[11.510406, "o", "ow plates that still fit on `A` must\r\nnot occupy `B`.\r\n"]
[11.510665, "o", "--- discharge ---\r\n"]
[11.511362, "o", "# Discharge seats\r\n\r\nSearch order is on the lane cards. Seat plates in increasing `BOARD`, then\r\nplate name. Remaining length, lane kilograms, paired deck kilograms, and sister\r\ntrim are those of plates already seated.\r\n\r\nRemaining length includes the neighbour keep-clear and, for a hazmat plate, a\r\n100 cm ramp keep-clear beyond its own length. The ramp keep-clear is empty of\r\nother plates and does not move that plate's ramp-facing station. A clean plate\r\ndoes not take a ramp keep-clear.\r\n\r\nIf a previous plate already sits in that lane and either plate has `HAZ=1`,\r\nleave 100 cm empty before the new length. If both plates have `HAZ=1`, leave a\r\nsecond 100 cm. The first plate in a lane never takes a leading gap.\r\n\r\nA plate's `station` is centimetres from the ramp to its ramp-facing face. On a\r\n2000 cm lane a 400 cm earliest plate sits at station 1600. The earliest packed\r\nplate in a lane sits deepest. Later plates sit nearer the ramp. Chalk rows stay\r\nin listing order.\r\n"]
[11.511612, "o", "\u001b[?2004h"]
[11.51163, "o", "root@01771362f570:/app# "]
[11.731106, "i", "printf '%s\\n' '--- source ---'; find /app/environment -maxdepth 3 -type f -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;; printf '%s\\n' '--- rolls ---'; find /app/rolls -maxdepth 2 -type f -print -exec sh -c 'echo \"### $1\"; cat \"$1\"' _ {} \\;\n"]
[11.732012, "o", "printf '%s\\n' '--- source ---'; find /app/environment -maxdepth 3 -type f -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;; printf '%s\\n' '--- rolls ---'; find /app/rolls -maxdepth 2 -type f -print -exec sh -c 'echo \"### $1\"; cat \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[11.732161, "o", "--- source ---\r\n"]
[11.733959, "o", "/app/environment/parse.go\r\n"]
[11.734902, "o", "### /app/environment/parse.go\r\n"]
[11.738105, "o", "package main\r\n\r\nimport (\r\n\t\"strings\"\r\n\t\"unicode\"\r\n)\r\n\r\nfunc safeName(text string) bool {\r\n\tif text == \"\" {\r\n\t\treturn false\r\n\t}\r\n\tfor _, r := range text {\r\n\t\tif unicode.IsLetter(r) || unicode.IsDigit(r) || r == '.' || r == '_' || r == '-' {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\treturn false\r\n\t}\r\n\treturn true\r\n}\r\n\r\n"]
[11.738258, "o", "func parseRoll(sheet string) ([]Car, int) {\r\n\tvar cars []Car\r\n\tfor _, raw := range strings.Split(sheet, \"\\n\") {\r\n\t\tline := strings.TrimSpace(raw)\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\twords := strings.Fields(line)\r\n\t\tif len(words) < 10 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif words[0] != \"PLATE\" || words[2] != \"LEN\" || words[4] != \"HT\" || words[6] != \"HAZ\" || words[8] != \"BOARD\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif !safeName(words[1]) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tlength := atoiLoose(words[3])\r\n\t\tht := atoiLoose(words[5])\r\n\t\thaz := atoiLoose(words[7])\r\n\t\tboard := atoiLoose(words[9])\r\n\t\tif ht < 0 || board < 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tcars = append(cars, Car{Plate: words[1], Len: length, Ht: ht, Haz: haz, Board: board})\r\n\t}\r\n\treturn cars, 0\r\n}\r\n\r\nfunc atoiLoose(text string) int {\r\n\tif text == \"\" {\r\n\t\treturn 0\r\n\t}\r\n\tn := 0\r\n\tfor _, r := range text {\r\n\t\tif r < '0' || r > '9' {\r\n\t\t\treturn 0\r\n\t\t}\r\n\t\tn = n*10 + int(r-'0')\r\n\t}\r\n\treturn n\r\n}\r\n"]
[11.738683, "o", "/app/environment/offer.go\r\n"]
[11.739528, "o", "### /app/environment/offer.go\r\n"]
[11.740403, "o", "package main\r\n\r\ntype occ struct {\r\n\tused    int\r\n\tmass    int\r\n\tlastHaz int\r\n\thas     bool\r\n}\r\n\r\nfunc pickLane(car Car, fill map[string]*occ, deckKg map[string]int) Lane {\r\n\t_ = car\r\n\t_ = fill\r\n\t_ = deckKg\r\n\treturn Lane{Deck: \"B\", Name: \"B1\", Lid: 420, Span: 2000}\r\n}\r\n"]
[11.74073, "o", "/app/environment/chalk.go\r\n"]
[11.741456, "o", "### /app/environment/chalk.go\r\n"]
[11.742337, "o", "package main\r\n\r\nimport \"fmt\"\r\n\r\nfunc emit(lines *[]string, i *int, plate, deck, lane, station, ok string) {\r\n\t*i++\r\n\trow := fmt.Sprintf(`{\"i\":%d,\"verb\":\"stow\"`, *i)\r\n\tif plate != \"\" {\r\n\t\trow += fmt.Sprintf(`,\"plate\":\"%s\"`, plate)\r\n\t}\r\n\tif deck != \"\" {\r\n\t\trow += fmt.Sprintf(`,\"deck\":\"%s\"`, deck)\r\n\t}\r\n\tif lane != \"\" {\r\n\t\trow += fmt.Sprintf(`,\"lane\":\"%s\"`, lane)\r\n\t}\r\n\tif station != \"\" {\r\n\t\trow += fmt.Sprintf(`,\"station\":\"%s\"`, station)\r\n\t}\r\n\trow += fmt.Sprintf(`,\"ok\":\"%s\"}`+\"\\n\", ok)\r\n\t*lines = append(*lines, row)\r\n}\r\n"]
[11.74264, "o", "/app/environment/cars.go\r\n"]
[11.743344, "o", "### /app/environment/cars.go\r\n"]
[11.744114, "o", "package main\r\n\r\ntype Car struct {\r\n\tPlate string\r\n\tLen   int\r\n\tHt    int\r\n\tMass  int\r\n\tHaz   int\r\n\tBoard int\r\n}\r\n"]
[11.74454, "o", "/app/environment/main.go\r\n"]
[11.745259, "o", "### /app/environment/main.go\r\n"]
[11.746076, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) != 6 || os.Args[1] != \"stow\" || os.Args[2] != \"--roll\" || os.Args[4] != \"--chalk\" {\r\n\t\tfmt.Fprintf(os.Stderr, \"usage: cleat stow --roll PATH --chalk PATH\\n\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tbody, err := os.ReadFile(os.Args[3])\r\n\tif err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\trc, text := fold(string(body))\r\n\tif err := os.WriteFile(os.Args[5], []byte(text), 0644); err != nil {\r\n\t\tos.Exit(1)\r\n\t}\r\n\tif rc == -2 {\r\n\t\tos.Exit(2)\r\n\t}\r\n\tif rc != 0 {\r\n\t\tos.Exit(1)\r\n\t}\r\n}\r\n"]
[11.746495, "o", "/app/environment/Makefile\r\n"]
[11.747195, "o", "### /app/environment/Makefile\r\n"]
[11.748135, "o", "BIN := /opt/ferry/bin/cleat\r\nGO ?= go\r\n\r\n.PHONY: all install clean\r\n\r\nall: install\r\n\r\ninstall:\r\n\tmkdir -p /opt/ferry/bin\r\n\t$(GO) build -o $(BIN) .\r\n\r\nclean:\r\n\trm -f $(BIN)\r\n"]
[11.748456, "o", "/app/environment/apron.go\r\n"]
[11.749192, "o", "### /app/environment/apron.go\r\n"]
[11.750074, "o", "package main\r\n\r\nfunc rampApron(haz int) int {\r\n\t_ = haz\r\n\treturn 0\r\n}\r\n"]
[11.750519, "o", "/app/environment/vault.go\r\n"]
[11.751426, "o", "### /app/environment/vault.go\r\n"]
[11.752407, "o", "package main\r\n\r\ntype Lane struct {\r\n\tDeck string\r\n\tName string\r\n\tLid  int\r\n\tSpan int\r\n}\r\n\r\nfunc allLanes() []Lane {\r\n\treturn []Lane{\r\n\t\t{Deck: \"A\", Name: \"A1\", Lid: 180, Span: 2000},\r\n\t\t{Deck: \"A\", Name: \"A2\", Lid: 180, Span: 2000},\r\n\t\t{Deck: \"B\", Name: \"B1\", Lid: 420, Span: 2000},\r\n\t\t{Deck: \"B\", Name: \"B2\", Lid: 420, Span: 2000},\r\n\t}\r\n}\r\n"]
[11.752775, "o", "/app/environment/board.go\r\n"]
[11.753533, "o", "### /app/environment/board.go\r\n"]
[11.7544, "o", "package main\r\n\r\nimport \"sort\"\r\n\r\nfunc arrange(cars []Car) []Car {\r\n\tout := append([]Car(nil), cars...)\r\n\tsort.Slice(out, func(i, j int) bool {\r\n\t\tif out[i].Board == out[j].Board {\r\n\t\t\treturn out[i].Plate > out[j].Plate\r\n\t\t}\r\n\t\treturn out[i].Board > out[j].Board\r\n\t})\r\n\treturn out\r\n}\r\n\r\nfunc stationOf(cursor int, car Car, gap int) int {\r\n\t_ = car\r\n"]
[11.754567, "o", "\t_ = gap\r\n\treturn cursor - 10\r\n}\r\n"]
[11.754817, "o", "/app/environment/go.mod\r\n"]
[11.755778, "o", "### /app/environment/go.mod\r\n"]
[11.756765, "o", "module cleat\r\n\r\ngo 1.24\r\n"]
[11.757224, "o", "/app/environment/kilo.go\r\n"]
[11.758046, "o", "### /app/environment/kilo.go\r\n"]
[11.758921, "o", "package main\r\n\r\nfunc massFits(lane Lane, slot *occ, car Car, deckUsed int) bool {\r\n\t_ = lane\r\n\t_ = slot\r\n\t_ = car\r\n\t_ = deckUsed\r\n\treturn true\r\n}\r\n"]
[11.75934, "o", "/app/environment/trim.go\r\n"]
[11.760044, "o", "### /app/environment/trim.go\r\n"]
[11.760834, "o", "package main\r\n\r\nfunc trimFits(lane Lane, fill map[string]*occ, extra int) bool {\r\n\t_ = lane\r\n\t_ = fill\r\n\t_ = extra\r\n\treturn true\r\n}\r\n"]
[11.761155, "o", "/app/environment/fold.go\r\n"]
[11.761741, "o", "### /app/environment/fold.go\r\n"]
[11.762513, "o", "package main\r\n\r\nimport \"strings\"\r\n\r\nfunc fold(sheet string) (int, string) {\r\n\tcars, rc := parseRoll(sheet)\r\n\tif rc != 0 {\r\n\t\treturn rc, \"\"\r\n\t}\r\n\tif len(cars) == 0 {\r\n\t\treturn 0, \"{\\\"i\\\":1,\\\"verb\\\":\\\"stow\\\",\\\"ok\\\":\\\"empty\\\"}\\n\"\r\n\t}\r\n\tordered := arrange(cars)\r\n\tfill := map[string]*occ{}\r\n\tdeckKg := map[string]int{}\r\n\tvar lines []string\r\n\tn := 0\r\n\tfor i, car := range ordered {\r\n\t\tlane := pickLane(car, fill, deckKg)\r\n\t\tstation := stationOf(2000, car, 0)\r\n"]
[11.76262, "o", "\t\t_ = i\r\n\t\temit(&lines, &n, car.Plate, lane.Deck, lane.Name, fmtInt(station), \"yes\")\r\n\t\tif fill[lane.Name] == nil {\r\n\t\t\tfill[lane.Name] = &occ{}\r\n\t\t}\r\n\t\tfill[lane.Name].used += car.Len\r\n\t\tfill[lane.Name].has = true\r\n\t}\r\n\treturn 0, strings.Join(lines, \"\")\r\n"]
[11.762714, "o", "}\r\n\r\nfunc fmtInt(n int) string {\r\n\tif n == 0 {\r\n\t\treturn \"0\"\r\n\t}\r\n\tsign := \"\"\r\n\tif n < 0 {\r\n\t\tsign = \"-\"\r\n\t\tn = -n\r\n\t}\r\n\tvar d []byte\r\n\tfor n > 0 {\r\n\t\td = append([]byte{byte('0' + n%10)}, d...)\r\n\t\tn /= 10\r\n\t}\r\n\treturn sign + string(d)\r\n}\r\n"]
[11.763056, "o", "/app/environment/spacing.go\r\n"]
[11.763649, "o", "### /app/environment/spacing.go\r\n"]
[11.764466, "o", "package main\r\n\r\nfunc neighbourGap(prevHaz, haz int) int {\r\n\t_ = prevHaz\r\n\t_ = haz\r\n\treturn 0\r\n}\r\n"]
[11.765041, "o", "--- rolls ---\r\n"]
[11.766212, "o", "/app/rolls/night.roll\r\n"]
[11.766843, "o", "### /app/rolls/night.roll\r\n"]
[11.767373, "o", "# sample night crossing\r\nPLATE van-a LEN 420 HT 160 MASS 900 HAZ 0 BOARD 1\r\nPLATE van-b LEN 380 HT 155 MASS 850 HAZ 0 BOARD 2\r\n"]
