[264.384795, "i", "python3 - <<'PY'\np='parse.go'\ns=open(p).read()\ns=s.replace('\"strconv\"\\n\\t\"strings\"', '\"strconv\"\\n\\t\"strings\"\\n\\t\"unicode\"\\n\\t\"unicode/utf8\"')\na=s.index('func safeName(')\nb=s.index('\\nfunc uint(', a)\ns=s[:a]+'''func safeName(s string) bool {\n\tif s == \"\" || !utf8.ValidString(s) { return false }\n\tfor _, r := range s {\n\t\tif unicode.IsLetter(r) || unicode.IsDigit(r) || r == '.' || r == '_' || r == '-' { continue }\n\t\treturn false\n\t}\n\treturn true\n}\n'''+s[b:]\ns=s.replace('strconv.ParseUint(s, 10, 0)', 'strconv.ParseUint(s, 10, strconv.IntSize)')\nopen(p,'w').write(s)\np='board.go'; s=open(p).read().replace('sort.Slice(out,', 'sort.SliceStable(out,'); open(p,'w').write(s)\nPY\ngofmt -w *.go && make install\ncat >/tmp/balance.roll <<'EOF'\nPLATE heavy1 LEN 1600 HT 400 MASS 10000 HAZ 0 BOARD 1\nPLATE heavy2 LEN 500 HT 400 MASS 4500 HAZ 0 BOARD 2\nPLATE follow LEN 500 HT 400 MASS 5500 HAZ 0 BOARD 3\nEOF\n/opt/ferry/bin/cleat stow --roll /tmp/balance.roll --chalk /tmp/balance.chalk; rc=$?; echo \"balance rc=$rc\"; cat /tmp/balance.ch"]
[264.384914, "i", "alk\npython3 - <<'PY'\nimport json\nfor path in ['/tmp/night.chalk','/tmp/haz.chalk','/tmp/rules.chalk','/tmp/balance.chalk']:\n    for num,line in enumerate(open(path, encoding='utf-8'),1):\n        r=json.loads(line)\n        assert isinstance(r['i'],int) and r['verb']=='stow'\n        assert isinstance(r['plate'],str) and r['ok'] in ('yes','no')\n        if r['ok']=='yes':\n            assert r['deck'] in ('A','B') and isinstance(r['lane'],str) and isinstance(r['station'],int)\n        else:\n            assert not ({'deck','lane','station'} & r.keys())\nprint('NDJSON/type checks passed')\nPY\nls -l /opt/ferry/bin/cleat; go build ./...\n"]
