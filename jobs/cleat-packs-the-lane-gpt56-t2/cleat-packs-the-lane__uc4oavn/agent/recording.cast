[185.930486, "i", "python3 - <<'PY'\np='spacing.go'\nopen(p,'w').write('''package main\n\nfunc neighbourGap(a, b int) int {\n\tif a == 1 && b == 1 { return 200 }\n\tif a == 1 || b == 1 { return 100 }\n\treturn 0\n}\n\n// A previous hazmat plate's ramp apron is already part of used length and\n// supplies the first part of the clearance required before the next plate.\nfunc placementGap(previousHaz, haz int) int {\n\tgap := neighbourGap(previousHaz, haz) - rampApron(previousHaz)\n\tif gap < 0 { return 0 }\n\treturn gap\n}\n''')\nfor p in ['offer.go','fold.go']:\n    s=open(p).read().replace('neighbourGap(o.lastHaz, car.Haz)', 'placementGap(o.lastHaz, car.Haz)')\n    open(p,'w').write(s)\nPY\npython3 - <<'PY'\np='parse.go'\ns=open(p).read()\ns=s.replace('\"strings\"', '\"strings\"')\nstart=s.index('func parseRoll(')\nnew=r'''func splitFields(line string) ([]string, bool) {\n\tvar fields []string\n\tfor i := 0; i < len(line); {\n\t\tfor i < len(line) && (line[i] == ' ' || line[i] == '\\t') { i++ }\n\t\tif i == len(line) { break }\n\t\tstart := i\n\t\tfor i < len(line) && line[i] != '"]
[185.930667, "i", " ' && line[i] != '\\t' {\n\t\t\t// No other ASCII or Unicode whitespace is a field separator.\n\t\t\tif line[i] == '\\r' || line[i] == '\\n' || line[i] == '\\v' || line[i] == '\\f' { return nil, false }\n\t\t\ti++\n\t\t}\n\t\tfields = append(fields, line[start:i])\n\t}\n\treturn fields, true\n}\n\nfunc parseRoll(sheet string) ([]Car, int) {\n\tvar cars []Car\n\tfor _, raw := range strings.Split(sheet, \"\\n\") {\n\t\tw, valid := splitFields(raw)\n\t\tif !valid { return nil, -2 }\n\t\tif len(w) == 0 || strings.HasPrefix(w[0], \"#\") { continue }\n\t\tif len(w) != 12 || w[0] != \"PLATE\" || w[2] != \"LEN\" || w[4] != \"HT\" ||\n\t\t\tw[6] != \"MASS\" || w[8] != \"HAZ\" || w[10] != \"BOARD\" || !safeName(w[1]) { return nil, -2 }\n\t\tlength, a := uint(w[3]); ht, b := uint(w[5]); mass, c := uint(w[7])\n\t\thaz, d := uint(w[9]); board, e := uint(w[11])\n\t\tif !a || !b || !c || !d || !e || length == 0 || ht == 0 || mass == 0 || board == 0 || haz > 1 { return nil, -2 }\n\t\tcars = append(cars, Car{w[1], length, ht, mass, haz, board, len(cars)})\n\t}\n\treturn cars, 0\n}\n'''\nopen(p,'w').write(s[:st"]
