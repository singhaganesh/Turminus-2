[?2004l[?2004h> 
[?2004l[?2004h> LINE_Y = 70.0
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l [?2004h> class Track:
[?2004l[?2004h>     def __init__(self, ident: int, d: dict, frame_no: int):
[?2004l[?2004h>         self.ident = ident
[?2004l[?2004h>         self.x, self.y = d["x"], d["y"]
[?2004l[?2004h>         self.vx = self.vy = 0.0
[?2004l[?2004h>         self.area = d["area"]
[?2004l[?2004h>         self.colour = d["colour"].copy()
[?2004l[?2004h>         self.last = frame_no
[?2004l[?2004h>         self.missed = 0
[?2004l[?2004h>         self.hits = 1
[?2004l[?2004h>         self.active = True
[?2004l[?2004h>         self.exit_side = ""
[?2004l[?2004h>         self.armed = self.y <= LINE_Y
[?2004l[?2004h>         self.counted = False
[?2004l[?2004h>         self.min_y = self.y
[?2004l[?2004h>         self.max_y = self.y
[?2004l[?2004h> 
[?2004l[?2004h>     def predicted(self) -> tuple[float, float]:
[?2004l[?2004h>         step = min(self.missed + 1, 5)
[?2004l[?2004h>         return self.x + self.vx * step, self.y + self.vy * step
[?2004l[?2004h> 
[?2004l[?2004h>     def observe(self, d: dict, frame_no: int) -> bool:
[?2004l[?2004h>         dt = max(1, frame_no - self.last)
[?2004l[?2004h>         nx, ny = d["x"], d["y"]
[?2004l[?2004h>         ivx, ivy = (nx - self.x) / dt, (ny - self.y) / dt
[?2004l[?2004h>         if self.hits < 2:
[?2004l[?2004h>             self.vx, self.vy = ivx, ivy
[?2004l[?2004h>         else:
[?2004l[?2004h>             self.vx = .55 * self.vx + .45 * ivx
[?2004l[?2004h>             self.vy = .55 * self.vy + .45 * ivy
[?2004l[?2004h>         old_y = self.y
[?2004l[?2004h>         self.x, self.y = nx, ny
[?2004l[?2004h>         self.area = .8 * self.area + .2 * d["area"]
[?2004l[?2004h>         self.colour = .85 * self.colour + .15 * d["colour"]
[?2004l[?2004h>         self.last, self.missed, self.active = frame_no, 0, True
[?2004l[?2004h>         self.hits += 1
[?2004l[?2004h>         self.min_y, self.max_y = min(self.min_y, ny), max(self.max_y, ny)
[?2004l[?2004h>         # Arm from a genuine observation above the row. Hysteresis prevents a
[?2004l[?2004h>         # lingering/jittering centroid from generating repeated events.
[?2004l[?2004h>         if ny <= LINE_Y - 0.5:
[?2004l[?2004h>             self.armed = True
[?2004l[?2004h>         event = False
[?2004l[?2004h>         if (not self.counted and self.armed and ny > LINE_Y + 0.5
[?2004l[?2004h>                 and old_y <= LINE_Y + 1.5 and ivy > 0.15):
[?2004l[?2004h>             self.counted = True
[?2004l[?2004h>             event = True
[?2004l[?2004h>         return event
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _inside(d: dict, p: tuple[float, float], pad: float = 5.0) -> bool:
[?2004l[?2004h>     x, y, w, h = d["box"]
[?2004l[?2004h>     return x - pad <= p[0] <= x + w + pad and y - pad <= p[1] <= y + h + pad
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _cost(t: Track, d: dict) -> float:
[?2004l[?2004h>     px, py = t.predicted()
[?2004l[?2004h>     dist = math.hypot(px - d["x"], py - d["y"])
[?2004l[?2004h>     colour = float(np.linalg.norm(t.colour - d["colour"]))
[?2004l[?2004h>     ratio = abs(math.log(max(d["area"], 1.0) / max(t.area, 1.0)))
[?2004l[?2004h>     return dist + .08 * colour + 8.0 * ratio
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _side(t: Track) -> str:
[?2004l[?2004h>     if t.y < 18: return "top"
[?2004l[?2004h>     if t.y > 101: return "bottom"
[?2004l[?2004h>     if t.x < 18: return "left"
[?2004l[?2004h>     if t.x > 141: return "right"
[?2004l[?2004h>     return "lost"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def knit_marks(all_detections: list[list[dict]]) -> int:
[?2004l[?2004h>     tracks: list[Track] = []
[?2004l[?2004h>     next_id = 0
[?2004l[?2004h>     total = 0
[?2004l[?2004h>     for fi, detections in enumerate(all_detections):
[?2004l[?2004h>         active = [t for t in tracks if t.active]
[?2004l[?2004h>         consumed_d: set[int] = set()
[?2004l[?2004h>         held_t: set[int] = set()
[?2004l[?2004h> 
[?2004ls[?2004h>         # A connected component containing predictions of multiple established
[?2004l[?2004h>         # tracks is a touch/overlap, not a new giant body. Keep every identity
[?2004l[?2004h>         # alive on its own velocity until the silhouettes split again.
[?2004l[?2004h>         for di, d in enumerate(detections):
[?2004l[?2004h>             enclosed = [t for t in active if t.hits >= 2 and _inside(d, t.predicted())
[?2004l[?2004h>                         and d["area"] >= .72 * t.area]
[?2004l[?2004h>             if len(enclosed) >= 2 and d["area"] >= 1.28 * max(t.area for t in enclosed):
[?2004l[?2004h>                 consumed_d.add(di)
[?2004l[?2004h>                 for t in enclosed:
[?2004l[?2004h>                     held_t.add(t.ident)
[?2004l[?2004h>                     t.missed += 1
[?2004l[?2004h> 
[?2004l[?2004h>         pairs = []
[?2004l[?2004h>         for t in active:
[?2004l[?2004h>             if t.ident in held_t: continue
[?2004l[?2004h>             for di, d in enumerate(detections):
[?2004l[?2004h>                 if di in consumed_d: continue
[?2004l[?2004h>                 c = _cost(t, d)
[?2004l[?2004h>                 limit = 18.0 + min(t.missed, 6) * 7.0 + min(abs(t.vx)+abs(t.vy), 10.0)
[?2004l[?2004h>                 if c <= limit:
[?2004l[?2004h>                     pairs.append((c, t.ident, di))
[?2004l[?2004h>         pairs.sort()
[?2004l[?2004h>         used_t: set[int] = set()
[?2004l[?2004h>         for _, ti, di in pairs:
[?2004l[?2004h>             if ti in used_t or di in consumed_d: continue
[?2004l[?2004h>             t = next(q for q in tracks if q.ident == ti)
[?2004l[?2004h>             if t.observe(detections[di], fi): total += 1
[?2004l[?2004h>             used_t.add(ti); consumed_d.add(di)
[?2004l[?2004h> 
[?2004l[?2004h>         for t in active:
[?2004l[?2004h>             if t.ident not in used_t and t.ident not in held_t:
[?2004l[?2004h>                 t.missed += 1
[?2004l[?2004h>             if t.missed > 10:
[?2004l[?2004h>                 t.active = False
[?2004l[?2004h>                 t.exit_side = _side(t)
[?2004l[?2004h> 
[?2004l[?2004h>         # Re-identify a temporarily departed body only at the same boundary.
[?2004l[?2004h>         # This prevents a return from being counted twice while avoiding the
[?2004l[?2004h>         # common error of merging consecutive similar entrants.
[?2004l[?2004h>         for di, d in enumerate(detections):
[?2004l[?2004h>             if di in consumed_d: continue
[?2004l[?2004h>             x, y = d["x"], d["y"]
[?2004l[?2004h>             side = "top" if y < 18 else "bottom" if y > 101 else "left" if x < 18 else "right" if x > 141 else ""
[?2004l[?2004h>             candidates = []
[?2004l[?2004h>             if side:
[?2004l[?2004h>                 for t in tracks:
[?2004l[?2004h>                     if t.active or t.exit_side != side: continue
[?2004l[?2004h>                     cd = float(np.linalg.norm(t.colour - d["colour"]))
[?2004l[?2004h>                     ar = abs(math.log(max(d["area"],1)/max(t.area,1)))
[?2004l[?2004h>                     lateral = abs((t.x-x) if side in ("top","bottom") else (t.y-y))
[?2004l[?2004h>                     score = .12*cd + 8*ar + .25*lateral
[?2004l[?2004h>                     if score < 18: candidates.append((score,t))
[?2004l[?2004h>             if candidates:
[?2004l[?2004h>                 t = min(candidates, key=lambda z:z[0])[1]
[?2004l[?2004h>                 # Restart velocity after a long off-screen interval.
[?2004l[?2004h>                 t.x, t.y = d["x"], d["y"]
[?2004l[?2004h>                 t.last, t.missed, t.active = fi, 0, True
[?2004l[?2004h>                 t.exit_side = ""
[?2004l[?2004h>                 t.colour = .8*t.colour + .2*d["colour"]
[?2004l[?2004h>                 t.area = .8*t.area + .2*d["area"]
[?2004l[?2004h>                 if t.y <= LINE_Y-.5: t.armed = True
[?2004l[?2004h>             else:
[?2004l[?2004h>                 tracks.append(Track(next_id, d, fi)); next_id += 1
[?2004l[?2004h>     return total
[?2004l[?2004h> 
