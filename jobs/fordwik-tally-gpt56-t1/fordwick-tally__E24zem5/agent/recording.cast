[235.030745, "o", "    y=8+3*i\r\n\u001b[?2004l\r"]
[235.030816, "o", "\u001b[?2004h> "]
[235.030945, "o", "    dx=max(0,18-2*i) if i<9 else (min(18,2*(i-22)) if i>22 else 0)\r\n\u001b[?2004l\r"]
[235.030999, "o", "\u001b[?2004h> "]
[235.031113, "o", "    a.append((70-dx,y)); b.append((70+dx,y))\r\n\u001b[?2004l\r"]
[235.031168, "o", "\u001b[?2004h> "]
[235.031228, "o", "run('overlap',[a,b],2)\r\n\u001b[?2004l\r"]
[235.031297, "o", "\u001b[?2004h> "]
[235.031462, "o", "# Down, up, lingering at the line, and one body that never crosses downward.\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.031538, "o", "> "]
[235.031867, "o", "run('directions',[path(35,list(range(10,105,4))),path(75,list(range(105,8,-4))),path(115,list(range(12,69,4))+[69,70,70,69,70,71,71,72]+list(range(76,108,4)))],2)\r\n\u001b[?2004l\r"]
[235.031983, "o", "\u001b[?2004h> "]
[235.032101, "o", "# Same body crosses, exits bottom, returns upward, then crosses downward again:\r\n\u001b[?2004l\r"]
[235.032158, "o", "\u001b[?2004h> "]
[235.03224, "o", "# it must still count only once.\r\n\u001b[?2004l\r"]
[235.032305, "o", "\u001b[?2004h> "]
[235.032457, "o", "ys=list(range(8,113,5))+[None]*14+list(range(112,30,-5))+list(range(30,108,5))\r\n\u001b[?2004l\r"]
[235.03254, "o", "\u001b[?2004h> "]
[235.032628, "o", "q=[None if y is None else (80,y) for y in ys]\r\n\u001b[?2004l\r"]
[235.032701, "o", "\u001b[?2004h"]
[235.032796, "o", "> run('return',[q],1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.03289, "o", "PY\r\n\u001b[?2004l\r"]
