[171.787164, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70.0\n\n\ndef make_background(frames: list[np.ndarray]) -> np.ndarray:\n    \"\"\"Estimate the stationary plate before extracting moving bodies.\"\"\"\n    # A temporal median is insensitive to bodies which merely pass a pixel.\n    # Include endpoint frames preferentially; station reels normally have a\n    # short clear leader/trailer and these protect against a long pause.\n    n = len(frames)\n    idx = list(range(min(4, n))) + list(range(max(0, n - 4), n))\n    idx += list(range(0, n, max(1, n // 25)))\n    return np.median(np.stack([frames[i] for i in idx]), axis=0).astype(np.uint8)\n\n\ndef body_marks(frame: np.ndarray, background: np.ndarray) -> tuple[np.ndarray, list[dict]]:\n    \"\"\"Return foreground mask and connected-body measurements.\"\"\"\n    d = cv2.absdiff(frame, background)\n    # max-channel distance preserves strongly coloured, equal-luminance bodies\n    score = np.max(d, axis=2)\n    mask = (score >= 20).astype(np.uint8) * 255\n    mask = cv2.medianBlur(mask, 3)\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n    n, labels, stats, cents = cv2.connectedComponentsWithStats(mask, 8)\n    out: list[dict] = []\n    for k in range(1, n):\n        x, y, w, h, area = (int(v) for v in stats[k])\n        if area < 20 or w < 3 or h < 3:\n            continue\n        pix = frame[labels == k]\n        colour = np.median(pix, axis=0).astype(float) if len(pix) else np.zeros(3)\n        out.append({\n            \"x\": float(cents[k, 0]), \"y\": float(cents[k, 1]),\n            \"area\": float(area), \"box\": (x, y, w, h), \"colour\": colour,\n        })\n    return mask, out\nPY\n\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport math\nimport numpy as np\n\nLINE_Y = 70.0\n\n\nclass Track:\n    def __init__(self, ident: int, d: dict, frame_no: int):\n        self.ident = ident\n        self.x, self.y = d[\"x\"], d[\"y\"]\n        self.vx = self.vy = 0.0\n        self.area = d[\"area\"]\n        self.colour = d[\"colour\"].copy()\n        self.last = frame_no\n        self.missed = 0\n        self.hits = 1\n        self.active = True\n        self.exit_side = \"\"\n        self.armed = self.y <= LINE_Y\n        self.counted = False\n        self.min_y = self.y\n        self.max_y = self.y\n\n    def predicted(self) -> tuple[float, float]:\n        step = min(self.missed + 1, 5)\n        return self.x + self.vx * step, self.y + self.vy * step\n\n    def observe(self, d: dict, frame_no: int) -> bool:\n        dt = max(1, frame_no - self.last)\n        nx, ny = d[\"x\"], d[\"y\"]\n        ivx, ivy = (nx - self.x) / dt, (ny - self.y) / dt\n        if self.hits < 2:\n            self.vx, self.vy = ivx, ivy\n        else:\n            self.vx = .55 * self.vx + .45 * ivx\n            self.vy = .55 * self.vy + .45 * ivy\n        old_y = self.y\n        self.x, self.y = nx, ny\n        self.area = .8 * self.area + .2 * d[\"area\"]\n        self.colour = .85 * self.colour + .15 * d[\"colour\"]\n        self.last, self.missed, self.active = frame_no, 0, True\n        self.hits += 1\n        self.min_y, self.max_y = min(self.min_y, ny), max(self.max_y, ny)\n        # Arm from a genuine observation above the row. Hysteresis prevents a\n        # lingering/jittering centroid from generating repeated events.\n        if ny <= LINE_Y - 0.5:\n            self.armed = True\n        event = False\n        if (not self.counted and self.armed and ny > LINE_Y + 0.5\n                and old_y <= LINE_Y + 1.5 and ivy > 0.15):\n            self.counted = True\n            event = True\n        return event\n\n\ndef _inside(d: dict, p: tuple[float, float], pad: float = 5.0) -> bool:\n    x, y, w, h = d[\"box\"]\n    return x - pad <= p[0] <= x + w + pad and y - pad <= p[1] <= y + h + pad\n\n\ndef _cost(t: Track, d: dict) -> float:\n    px, py = t.predicted()\n    dist = math.hypot(px - d[\"x\"], py - d[\"y\"])\n    colour = float(np.linalg.norm(t.colour - d[\"colour\"]))\n    ratio = abs(math.log(max(d[\"area\"], 1.0) / max(t.area, 1.0)))\n    return dist + .08 * colour + 8.0 * ratio\n\n\ndef _side(t: Track) -> str:\n    if t.y < 18: re"]
[171.787377, "i", "turn \"top\"\n    if t.y > 101: return \"bottom\"\n    if t.x < 18: return \"left\"\n    if t.x > 141: return \"right\"\n    return \"lost\"\n\n\ndef knit_marks(all_detections: list[list[dict]]) -> int:\n    tracks: list[Track] = []\n    next_id = 0\n    total = 0\n    for fi, detections in enumerate(all_detections):\n        active = [t for t in tracks if t.active]\n        consumed_d: set[int] = set()\n        held_t: set[int] = set()\n\n        # A connected component containing predictions of multiple established\n        # tracks is a touch/overlap, not a new giant body. Keep every identity\n        # alive on its own velocity until the silhouettes split again.\n        for di, d in enumerate(detections):\n            enclosed = [t for t in active if t.hits >= 2 and _inside(d, t.predicted())\n                        and d[\"area\"] >= .72 * t.area]\n            if len(enclosed) >= 2 and d[\"area\"] >= 1.28 * max(t.area for t in enclosed):\n                consumed_d.add(di)\n                for t in enclosed:\n                    held_t.add(t.ident)\n                    t.missed += 1\n\n        pairs = []\n        for t in active:\n            if t.ident in held_t: continue\n            for di, d in enumerate(detections):\n                if di in consumed_d: continue\n                c = _cost(t, d)\n                limit = 18.0 + min(t.missed, 6) * 7.0 + min(abs(t.vx)+abs(t.vy), 10.0)\n                if c <= limit:\n                    pairs.append((c, t.ident, di))\n        pairs.sort()\n        used_t: set[int] = set()\n        for _, ti, di in pairs:\n            if ti in used_t or di in consumed_d: continue\n            t = next(q for q in tracks if q.ident == ti)\n            if t.observe(detections[di], fi): total += 1\n            used_t.add(ti); consumed_d.add(di)\n\n        for t in active:\n            if t.ident not in used_t and t.ident not in held_t:\n                t.missed += 1\n            if t.missed > 10:\n                t.active = False\n                t.exit_side = _side(t)\n\n        # Re-identify a temporarily departed body only at the same boundary.\n        # This prevents a return from being counted twice while avoiding the\n        # common error of merging consecutive similar entrants.\n        for di, d in enumerate(detections):\n            if di in consumed_d: continue\n            x, y = d[\"x\"], d[\"y\"]\n            side = \"top\" if y < 18 else \"bottom\" if y > 101 else \"left\" if x < 18 else \"right\" if x > 141 else \"\"\n            candidates = []\n            if side:\n                for t in tracks:\n                    if t.active or t.exit_side != side: continue\n                    cd = float(np.linalg.norm(t.colour - d[\"colour\"]))\n                    ar = abs(math.log(max(d[\"area\"],1)/max(t.area,1)))\n                    lateral = abs((t.x-x) if side in (\"top\",\"bottom\") else (t.y-y))\n                    score = .12*cd + 8*ar + .25*lateral\n                    if score < 18: candidates.append((score,t))\n            if candidates:\n                t = min(candidates, key=lambda z:z[0])[1]\n                # Restart velocity after a long off-screen interval.\n                t.x, t.y = d[\"x\"], d[\"y\"]\n                t.last, t.missed, t.active = fi, 0, True\n                t.exit_side = \"\"\n                t.colour = .8*t.colour + .2*d[\"colour\"]\n                t.area = .8*t.area + .2*d[\"area\"]\n                if t.y <= LINE_Y-.5: t.armed = True\n            else:\n                tracks.append(Track(next_id, d, fi)); next_id += 1\n    return total\n\n\ndef fold_gate(n: int) -> int:\n    return int(n)\nPY\n\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import body_marks, make_background\nfrom tether import fold_gate, knit_marks\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok: break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n    "]
[171.78751, "i", "        raise OSError('invalid clip frame')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('empty or unreadable clip')\n    background = make_background(frames)\n    detections = [body_marks(f, background)[1] for f in frames]\n    return fold_gate(knit_marks(detections))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    tmp = SHEET.with_suffix('.tmp')\n    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    tmp.replace(SHEET)\nPY\n\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    try:\n        SHEET.unlink(missing_ok=True)\n        if len(sys.argv) != 2:\n            return 2\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n        return 0\n    except Exception as exc:\n        print(f'mill: {exc}', file=sys.stderr)\n        SHEET.unlink(missing_ok=True)\n        return 1\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\nchmod +x /app/kiln/bake.sh\n/app/kiln/bake.sh\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo \"bad_rc=$rc\"; test ! -e /app/inkwell/sheet.toml && echo sheet_absent\n"]
