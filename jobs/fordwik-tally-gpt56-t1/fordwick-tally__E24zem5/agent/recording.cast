[171.796992, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[171.797063, "o", "\u001b[?2004h"]
[171.797091, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[171.797175, "o", "import math\r\n\u001b[?2004l\r"]
[171.797236, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.797304, "o", "LINE_Y = 70.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.797334, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.797412, "o", "\r\n\u001b[?2004l\r "]
[171.797481, "o", "\u001b[?2004h> class Track:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.797721, "o", "    def __init__(self, ident: int, d: dict, frame_no: int):\r\n\u001b[?2004l\r"]
[171.797779, "o", "\u001b[?2004h> "]
[171.797875, "o", "        self.ident = ident\r\n\u001b[?2004l\r"]
[171.797933, "o", "\u001b[?2004h> "]
[171.79807, "o", "        self.x, self.y = d[\"x\"], d[\"y\"]\r\n\u001b[?2004l\r"]
[171.79815, "o", "\u001b[?2004h> "]
[171.798238, "o", "        self.vx = self.vy = 0.0\r\n\u001b[?2004l\r"]
[171.798302, "o", "\u001b[?2004h> "]
[171.798383, "o", "        self.area = d[\"area\"]\r\n\u001b[?2004l\r"]
[171.798448, "o", "\u001b[?2004h> "]
[171.798584, "o", "        self.colour = d[\"colour\"].copy()\r\n\u001b[?2004l\r"]
[171.798645, "o", "\u001b[?2004h"]
[171.798704, "o", "> "]
[171.7988, "o", "        self.last = frame_no\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.798891, "o", "        self.missed = 0\r\n\u001b[?2004l\r"]
[171.798952, "o", "\u001b[?2004h> "]
[171.799016, "o", "        self.hits = 1\r\n\u001b[?2004l\r"]
[171.799081, "o", "\u001b[?2004h> "]
[171.799168, "o", "        self.active = True\r\n\u001b[?2004l\r"]
[171.79923, "o", "\u001b[?2004h> "]
[171.799322, "o", "        self.exit_side = \"\"\r\n\u001b[?2004l\r"]
[171.799385, "o", "\u001b[?2004h> "]
[171.799503, "o", "        self.armed = self.y <= LINE_Y\r\n\u001b[?2004l\r"]
[171.799564, "o", "\u001b[?2004h> "]
[171.799676, "o", "        self.counted = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.799821, "o", "        self.min_y = self.y\r\n\u001b[?2004l\r"]
[171.799872, "o", "\u001b[?2004h> "]
[171.799936, "o", "        self.max_y = self.y\r\n\u001b[?2004l\r"]
[171.799983, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.80003, "o", "> "]
[171.800196, "o", "    def predicted(self) -> tuple[float, float]:\r\n\u001b[?2004l\r"]
[171.800241, "o", "\u001b[?2004h> "]
[171.800377, "o", "        step = min(self.missed + 1, 5)\r\n\u001b[?2004l\r"]
[171.800447, "o", "\u001b[?2004h> "]
[171.800655, "o", "        return self.x + self.vx * step, self.y + self.vy * step\r\n\u001b[?2004l\r"]
[171.800715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.800955, "o", "    def observe(self, d: dict, frame_no: int) -> bool:\r\n\u001b[?2004l\r"]
[171.801016, "o", "\u001b[?2004h"]
[171.801085, "o", "> "]
[171.801161, "o", "        dt = max(1, frame_no - self.last)\r\n\u001b[?2004l\r"]
[171.801223, "o", "\u001b[?2004h> "]
[171.801324, "o", "        nx, ny = d[\"x\"], d[\"y\"]\r\n\u001b[?2004l\r"]
[171.801381, "o", "\u001b[?2004h> "]
[171.801593, "o", "        ivx, ivy = (nx - self.x) / dt, (ny - self.y) / dt\r\n\u001b[?2004l\r"]
[171.801661, "o", "\u001b[?2004h> "]
[171.801748, "o", "        if self.hits < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.801898, "o", "            self.vx, self.vy = ivx, ivy\r\n\u001b[?2004l\r"]
[171.80198, "o", "\u001b[?2004h> "]
[171.802067, "o", "        else:\r\n\u001b[?2004l\r"]
[171.802137, "o", "\u001b[?2004h> "]
[171.802232, "o", "            self.vx = .55 * self.vx + .45 * ivx\r\n\u001b[?2004l\r"]
[171.802291, "o", "\u001b[?2004h> "]
[171.802408, "o", "            self.vy = .55 * self.vy + .45 * ivy\r\n\u001b[?2004l\r"]
[171.802477, "o", "\u001b[?2004h> "]
[171.802543, "o", "        old_y = self.y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.802644, "o", "        self.x, self.y = nx, ny\r\n\u001b[?2004l\r"]
[171.802701, "o", "\u001b[?2004h> "]
[171.802864, "o", "        self.area = .8 * self.area + .2 * d[\"area\"]\r\n\u001b[?2004l\r"]
[171.802936, "o", "\u001b[?2004h> "]
[171.803189, "o", "        self.colour = .85 * self.colour + .15 * d[\"colour\"]\r\n\u001b[?2004l\r"]
[171.803223, "o", "\u001b[?2004h> "]
[171.803657, "o", "        self.last, self.missed, self.active = frame_no, 0, True\r\n\u001b[?2004l\r\u001b[?2004h>         self.hits += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.803875, "o", "        self.min_y, self.max_y = min(self.min_y, ny), max(self.max_y, ny)\r\n\u001b[?2004l\r"]
[171.803974, "o", "\u001b[?2004h> "]
[171.804243, "o", "        # Arm from a genuine observation above the row. Hysteresis prevents a\r\n\u001b[?2004l\r"]
[171.80432, "o", "\u001b[?2004h"]
[171.804404, "o", "> "]
[171.804586, "o", "        # lingering/jittering centroid from generating repeated events.\r\n\u001b[?2004l\r"]
[171.804673, "o", "\u001b[?2004h> "]
[171.804783, "o", "        if ny <= LINE_Y - 0.5:\r\n\u001b[?2004l\r"]
[171.804816, "o", "\u001b[?2004h> "]
[171.804936, "o", "            self.armed = True\r\n\u001b[?2004l\r"]
[171.805006, "o", "\u001b[?2004h> "]
[171.805084, "o", "        event = False\r\n\u001b[?2004l\r"]
[171.805152, "o", "\u001b[?2004h> "]
[171.805381, "o", "        if (not self.counted and self.armed and ny > LINE_Y + 0.5\r\n\u001b[?2004l\r"]
[171.805439, "o", "\u001b[?2004h> "]
[171.805661, "o", "                and old_y <= LINE_Y + 1.5 and ivy > 0.15):\r\n\u001b[?2004l\r"]
[171.805747, "o", "\u001b[?2004h> "]
[171.805838, "o", "            self.counted = True\r\n\u001b[?2004l\r"]
[171.80589, "o", "\u001b[?2004h> "]
[171.805983, "o", "            event = True\r\n\u001b[?2004l\r"]
[171.806053, "o", "\u001b[?2004h> "]
[171.806123, "o", "        return event\r\n\u001b[?2004l\r"]
[171.806185, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[171.806211, "o", "\u001b[?2004h> "]
[171.806547, "o", "def _inside(d: dict, p: tuple[float, float], pad: float = 5.0) -> bool:\r\n\u001b[?2004l\r"]
[171.806605, "o", "\u001b[?2004h> "]
[171.806705, "o", "    x, y, w, h = d[\"box\"]\r\n\u001b[?2004l\r"]
[171.806795, "o", "\u001b[?2004h> "]
[171.806984, "o", "    return x - pad <= p[0] <= x + w + pad and y - pad <= p[1] <= y + h + pad\r\n\u001b[?2004l\r"]
[171.807043, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[171.807114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.807241, "o", "def _cost(t: Track, d: dict) -> float:\r\n\u001b[?2004l\r"]
[171.807298, "o", "\u001b[?2004h> "]
[171.807379, "o", "    px, py = t.predicted()\r\n\u001b[?2004l\r"]
[171.807439, "o", "\u001b[?2004h> "]
[171.807581, "o", "    dist = math.hypot(px - d[\"x\"], py - d[\"y\"])\r\n\u001b[?2004l\r"]
[171.807638, "o", "\u001b[?2004h> "]
[171.807836, "o", "    colour = float(np.linalg.norm(t.colour - d[\"colour\"]))\r\n\u001b[?2004l\r"]
[171.807903, "o", "\u001b[?2004h> "]
[171.808082, "o", "    ratio = abs(math.log(max(d[\"area\"], 1.0) / max(t.area, 1.0)))\r\n\u001b[?2004l\r"]
[171.808139, "o", "\u001b[?2004h> "]
[171.808286, "o", "    return dist + .08 * colour + 8.0 * ratio\r\n\u001b[?2004l\r"]
[171.808347, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.808411, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.808508, "o", "def _side(t: Track) -> str:\r\n\u001b[?2004l\r"]
[171.808563, "o", "\u001b[?2004h> "]
[171.808656, "o", "    if t.y < 18: return \"top\"\r\n\u001b[?2004l\r"]
[171.808724, "o", "\u001b[?2004h> "]
[171.808842, "o", "    if t.y > 101: return \"bottom\"\r\n\u001b[?2004l\r"]
[171.808919, "o", "\u001b[?2004h> "]
[171.80899, "o", "    if t.x < 18: return \"left\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.809165, "o", "    if t.x > 141: return \"right\"\r\n\u001b[?2004l\r"]
[171.809239, "o", "\u001b[?2004h> "]
[171.809299, "o", "    return \"lost\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[171.809352, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.809412, "o", "> "]
[171.809574, "o", "def knit_marks(all_detections: list[list[dict]]) -> int:\r\n\u001b[?2004l\r"]
[171.809653, "o", "\u001b[?2004h"]
[171.809726, "o", "> "]
[171.809869, "o", "    tracks: list[Track] = []\r\n\u001b[?2004l\r\u001b[?2004h>     next_id = 0\r\n\u001b[?2004l\r"]
[171.809901, "o", "\u001b[?2004h"]
[171.810011, "o", ">     total = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.810036, "o", "> "]
[171.810296, "o", "    for fi, detections in enumerate(all_detections):\r\n\u001b[?2004l\r"]
[171.810382, "o", "\u001b[?2004h> "]
[171.810529, "o", "        active = [t for t in tracks if t.active]\r\n\u001b[?2004l\r"]
[171.810609, "o", "\u001b[?2004h> "]
[171.810712, "o", "        consumed_d: set[int] = set()\r\n\u001b[?2004l\r"]
[171.810814, "o", "\u001b[?2004h"]
[171.810914, "o", ">         held_t: set[int] = set()\r\n"]
[171.811008, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h"]
[171.811116, "o", "> "]
[171.811363, "o", "        # A connected component containing predictions of multiple established\r\n\u001b[?2004l\r"]
[171.811401, "o", "\u001b[?2004h"]
[171.811418, "o", "> "]
[171.812014, "o", "        # tracks is a touch/overlap, not a new giant body. Keep every identity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.812133, "o", "        # alive on its own velocity until the silhouettes split again.\r\n\u001b[?2004l\r"]
[171.812204, "o", "\u001b[?2004h> "]
[171.812375, "o", "        for di, d in enumerate(detections):\r\n\u001b[?2004l\r"]
[171.812465, "o", "\u001b[?2004h"]
[171.812552, "o", "> "]
[171.812791, "o", "            enclosed = [t for t in active if t.hits >= 2 and _inside(d, t.predicted())\r\n\u001b[?2004l\r"]
[171.812908, "o", "\u001b[?2004h"]
[171.81483, "o", ">                         and d[\"area\"] >= .72 * t.area]\r\n\u001b[?2004l\r\u001b[?2004h>             if len(enclosed) >= 2 and d[\"area\"] >= 1.28 * max(t.area for t in enclosed):\r\n\u001b[?2004l\r\u001b[?2004h>                 consumed_d.add(di)\r\n\u001b[?2004l\r\u001b[?2004h>                 for t in enclosed:\r\n\u001b[?2004l\r\u001b[?2004h>                     held_t.add(t.ident)\r\n\u001b[?2004l\r\u001b[?2004h>                     t.missed += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         pairs = []\r\n\u001b[?2004l\r\u001b[?2004h>         for t in active:\r\n\u001b[?2004l\r\u001b[?2004h>             if t.ident in held_t: continue\r\n\u001b[?2004l\r\u001b[?2004h>             for di, d in enumerate(detections):\r\n\u001b[?2004l\r\u001b[?2004h>                 if di in consumed_d: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.814997, "o", "                c = _cost(t, d)\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.815098, "o", "> "]
[171.815366, "o", "                limit = 18.0 + min(t.missed, 6) * 7.0 + min(abs(t.vx)+abs(t.vy), 10.0)\r\n\u001b[?2004l\r"]
[171.815432, "o", "\u001b[?2004h> "]
[171.815536, "o", "                if c <= limit:\r\n\u001b[?2004l\r"]
[171.815598, "o", "\u001b[?2004h> "]
[171.81573, "o", "                    pairs.append((c, t.ident, di))\r\n\u001b[?2004l\r"]
[171.815807, "o", "\u001b[?2004h> "]
[171.815874, "o", "        pairs.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.815971, "o", "        used_t: set[int] = set()\r\n\u001b[?2004l\r"]
[171.81603, "o", "\u001b[?2004h> "]
[171.816099, "o", "        for _, ti, di in pairs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.816214, "o", "            if ti in used_t or di in consumed_d: continue\r\n\u001b[?2004l\r"]
[171.81631, "o", "\u001b[?2004h> "]
[171.816414, "o", "            t = next(q for q in tracks if q.ident == ti)\r\n\u001b[?2004l\r"]
[171.816464, "o", "\u001b[?2004h> "]
[171.816597, "o", "            if t.observe(detections[di], fi): total += 1\r\n\u001b[?2004l\r"]
[171.816657, "o", "\u001b[?2004h> "]
[171.816763, "o", "            used_t.add(ti); consumed_d.add(di)\r\n\u001b[?2004l\r"]
[171.816843, "o", "\u001b[?2004h"]
[171.816898, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.81698, "o", "        for t in active:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.817101, "o", "            if t.ident not in used_t and t.ident not in held_t:\r\n\u001b[?2004l\r"]
[171.81716, "o", "\u001b[?2004h> "]
[171.817208, "o", "                t.missed += 1\r\n\u001b[?2004l\r"]
[171.817259, "o", "\u001b[?2004h> "]
[171.81731, "o", "            if t.missed > 10:\r\n\u001b[?2004l\r"]
[171.817355, "o", "\u001b[?2004h> "]
[171.817437, "o", "                t.active = False\r\n\u001b[?2004l\r"]
[171.817499, "o", "\u001b[?2004h> "]
[171.817584, "o", "                t.exit_side = _side(t)\r\n\u001b[?2004l\r"]
[171.817665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[171.817768, "o", "\u001b[?2004h> "]
[171.817886, "o", "        # Re-identify a temporarily departed body only at the same boundary.\r\n\u001b[?2004l\r"]
[171.81796, "o", "\u001b[?2004h> "]
[171.818157, "o", "        # This prevents a return from being counted twice while avoiding the\r\n\u001b[?2004l\r"]
[171.818248, "o", "\u001b[?2004h> "]
[171.818392, "o", "        # common error of merging consecutive similar entrants.\r\n\u001b[?2004l\r"]
[171.818474, "o", "\u001b[?2004h> "]
[171.818558, "o", "        for di, d in enumerate(detections):\r\n\u001b[?2004l\r"]
[171.818632, "o", "\u001b[?2004h> "]
[171.818718, "o", "            if di in consumed_d: continue\r\n\u001b[?2004l\r"]
[171.818827, "o", "\u001b[?2004h> "]
[171.818908, "o", "            x, y = d[\"x\"], d[\"y\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.819172, "o", "            side = \"top\" if y < 18 else \"bottom\" if y > 101 else \"left\" if x < 18 else \"right\" if x > 141 else \"\"\r\n\u001b[?2004l\r"]
[171.819234, "o", "\u001b[?2004h"]
[171.819289, "o", ">             candidates = []"]
[171.819375, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.819441, "o", "            if side:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.819539, "o", "                for t in tracks:\r\n\u001b[?2004l\r"]
[171.819588, "o", "\u001b[?2004h> "]
[171.819762, "o", "                    if t.active or t.exit_side != side: continue\r\n\u001b[?2004l\r"]
[171.819832, "o", "\u001b[?2004h> "]
[171.819986, "o", "                    cd = float(np.linalg.norm(t.colour - d[\"colour\"]))\r\n\u001b[?2004l\r"]
[171.820041, "o", "\u001b[?2004h> "]
[171.820197, "o", "                    ar = abs(math.log(max(d[\"area\"],1)/max(t.area,1)))\r\n\u001b[?2004l\r"]
[171.820265, "o", "\u001b[?2004h"]
[171.820335, "o", "> "]
[171.820473, "o", "                    lateral = abs((t.x-x) if side in (\"top\",\"bottom\") else (t.y-y))\r\n\u001b[?2004l\r"]
[171.820539, "o", "\u001b[?2004h> "]
[171.820652, "o", "                    score = .12*cd + 8*ar + .25*lateral\r\n\u001b[?2004l\r"]
[171.820729, "o", "\u001b[?2004h> "]
[171.820863, "o", "                    if score < 18: candidates.append((score,t))\r\n\u001b[?2004l\r"]
[171.820914, "o", "\u001b[?2004h> "]
[171.820985, "o", "            if candidates:\r\n\u001b[?2004l\r"]
[171.821034, "o", "\u001b[?2004h> "]
[171.821166, "o", "                t = min(candidates, key=lambda z:z[0])[1]\r\n\u001b[?2004l\r"]
[171.821209, "o", "\u001b[?2004h> "]
[171.82138, "o", "                # Restart velocity after a long off-screen interval.\r\n\u001b[?2004l\r"]
[171.821422, "o", "\u001b[?2004h> "]
[171.821536, "o", "                t.x, t.y = d[\"x\"], d[\"y\"]\r\n\u001b[?2004l\r"]
[171.821593, "o", "\u001b[?2004h> "]
[171.821724, "o", "                t.last, t.missed, t.active = fi, 0, True\r\n\u001b[?2004l\r"]
[171.821809, "o", "\u001b[?2004h> "]
[171.821869, "o", "                t.exit_side = \"\"\r\n\u001b[?2004l\r"]
[171.821921, "o", "\u001b[?2004h> "]
[171.822039, "o", "                t.colour = .8*t.colour + .2*d[\"colour\"]\r\n\u001b[?2004l\r"]
[171.822094, "o", "\u001b[?2004h> "]
[171.822206, "o", "                t.area = .8*t.area + .2*d[\"area\"]\r\n\u001b[?2004l\r"]
[171.822253, "o", "\u001b[?2004h> "]
[171.822381, "o", "                if t.y <= LINE_Y-.5: t.armed = True\r\n\u001b[?2004l\r"]
[171.822427, "o", "\u001b[?2004h> "]
[171.822479, "o", "            else:\r\n\u001b[?2004l\r"]
[171.822526, "o", "\u001b[?2004h> "]
[171.822714, "o", "                tracks.append(Track(next_id, d, fi)); next_id += 1\r\n\u001b[?2004l\r"]
[171.822767, "o", "\u001b[?2004h> "]
[171.822825, "o", "    return total\r\n\u001b[?2004l\r"]
[171.822876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.822928, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.823015, "o", "def fold_gate(n: int) -> int:\r\n\u001b[?2004l\r"]
[171.823073, "o", "\u001b[?2004h> "]
[171.823117, "o", "    return int(n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.823157, "o", "> PY\r\n\u001b[?2004l\r"]
[171.824418, "o", "\u001b[?2004hroot@3a98d1186bca:/app# "]
[171.82448, "o", "\r\n\u001b[?2004l\r\u001b[?2004hroot@3a98d1186bca:/app# "]
[171.824537, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[171.824583, "o", "\u001b[?2004h> "]
[171.824645, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[171.824689, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.824738, "o", "> "]
[171.824784, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[171.824831, "o", "\u001b[?2004h> import cv2\r\n"]
[171.824882, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[171.824927, "o", "import toml\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[171.824973, "o", "\u001b[?2004h> "]
[171.825059, "o", "from blot import body_marks, make_background\r\n\u001b[?2004l\r"]
[171.825104, "o", "\u001b[?2004h> "]
[171.82519, "o", "from tether import fold_gate, knit_marks\r\n\u001b[?2004l\r"]
[171.825234, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.82528, "o", "> "]
[171.82534, "o", "SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r"]
[171.825386, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.82543, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.825506, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r"]
[171.82555, "o", "\u001b[?2004h> "]
[171.825608, "o", "    cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r"]
[171.825653, "o", "\u001b[?2004h> "]
[171.825698, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r"]
[171.82575, "o", "\u001b[?2004h> "]
[171.825797, "o", "        cap.release()\r\n\u001b[?2004l\r"]
[171.825819, "o", "\u001b[?2004h> "]
[171.82596, "o", "        raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[171.82604, "o", "\u001b[?2004h> "]
[171.826186, "o", "    frames = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.826266, "o", ">     while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.826337, "o", "        ok, frame = cap.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.826367, "o", "        if not ok: break\r\n\u001b[?2004l\r"]
[171.826384, "o", "\u001b[?2004h> "]
[171.826536, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r"]
[171.826632, "o", "\u001b[?2004h> "]
[171.826715, "o", "            cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.826853, "o", "            raise OSError('invalid clip frame')\r\n\u001b[?2004l\r"]
[171.826884, "o", "\u001b[?2004h> "]
[171.827066, "o", "        frames.append(frame)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.82717, "o", "    cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.827243, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.827363, "o", "        raise OSError('empty or unreadable clip')\r\n\u001b[?2004l\r"]
[171.827437, "o", "\u001b[?2004h> "]
[171.827514, "o", "    background = make_background(frames)\r\n\u001b[?2004l\r"]
[171.82757, "o", "\u001b[?2004h> "]
[171.827728, "o", "    detections = [body_marks(f, background)[1] for f in frames]\r\n\u001b[?2004l\r"]
[171.827875, "o", "\u001b[?2004h> "]
[171.82796, "o", "    return fold_gate(knit_marks(detections))\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.828047, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.828149, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r"]
[171.828234, "o", "\u001b[?2004h> "]
[171.828338, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[171.828361, "o", "\u001b[?2004h> "]
[171.828491, "o", "    tmp = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r"]
[171.828572, "o", "\u001b[?2004h> "]
[171.82873, "o", "    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r"]
[171.828834, "o", "\u001b[?2004h> "]
[171.828899, "o", "    tmp.replace(SHEET)\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.828964, "o", "> PY\r\n\u001b[?2004l\r"]
[171.830508, "o", "\u001b[?2004hroot@3a98d1186bca:/app# \r\n\u001b[?2004l\r"]
[171.830619, "o", "\u001b[?2004hroot@3a98d1186bca:/app# cat > /app/spanwell.py <<'PY'\r\n"]
[171.830685, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[171.830761, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[171.830824, "o", "\u001b[?2004h> "]
[171.830911, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[171.830981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.831074, "o", "> import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.831222, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[171.8313, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[171.83137, "o", "> def main() -> int:\r\n"]
[171.831432, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[171.831539, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.831619, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[171.831636, "o", "\u001b[?2004h> "]
[171.831759, "o", "        if len(sys.argv) != 2:\r\n\u001b[?2004l\r"]
[171.831794, "o", "\u001b[?2004h"]
[171.831808, "o", "> "]
[171.831955, "o", "            return 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.831972, "o", "> "]
[171.832033, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[171.832065, "o", "\u001b[?2004h"]
[171.83208, "o", "> "]
[171.832222, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.832256, "o", "        return 0\r\n\u001b[?2004l\r"]
[171.832283, "o", "\u001b[?2004h"]
[171.832298, "o", "> "]
[171.832396, "o", "    except Exception as exc:\r\n\u001b[?2004l\r"]
[171.832425, "o", "\u001b[?2004h"]
[171.83244, "o", "> "]
[171.832606, "o", "        print(f'mill: {exc}', file=sys.stderr)\r\n\u001b[?2004l\r"]
[171.832669, "o", "\u001b[?2004h"]
[171.832721, "o", "> "]
[171.832794, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[171.83289, "o", "> "]
[171.832957, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.833196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.833317, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n"]
[171.833415, "o", "\u001b[?2004l\r"]
[171.834852, "o", "\u001b[?2004hroot@3a98d1186bca:/app# "]
[171.835, "o", "chmod +x /app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[171.840153, "o", "\u001b[?2004hroot@3a98d1186bca:/app# "]
[171.840282, "o", "/app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[171.903166, "o", "\u001b[?2004hroot@3a98d1186bca:/app# "]
[171.903324, "o", "rm -f /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[171.90548, "o", "\u001b[?2004hroot@3a98d1186bca:/app# "]
[171.905755, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[172.425592, "o", "sample_rc=0\r\n"]
[172.4266, "o", "crossings = 3\r\n"]
[172.427122, "o", "\u001b[?2004h"]
[172.427343, "o", "root@3a98d1186bca:/app# "]
[172.427848, "o", "python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo \"bad_rc=$rc\"; test ! -e /app/inkwell/sheet.toml && echo sheet_absent\r\n\u001b[?2004l\r"]
[172.746712, "o", "mill: cannot open clip\r\n"]
[172.783668, "o", "bad_rc=1\r\nsheet_absent\r\n"]
[172.783829, "o", "\u001b[?2004h"]
[172.783892, "o", "root@3a98d1186bca:/app# "]
[235.000564, "i", "python3 - <<'PY'\np='/app/tether.py'\ns=open(p).read()\nneedle='''    def observe(self, d: dict, frame_no: int) -> bool:\\n'''\ninsert='''    def coast(self, frame_no: int) -> bool:\\n        \\\"\\\"\\\"Advance an identity hidden inside a merged silhouette.\\\"\\\"\\\"\\n        old_y = self.y\\n        self.x += self.vx\\n        self.y += self.vy\\n        self.last = frame_no\\n        self.missed += 1\\n        self.min_y, self.max_y = min(self.min_y, self.y), max(self.max_y, self.y)\\n        if self.y <= LINE_Y - 0.5:\\n            self.armed = True\\n        if (not self.counted and self.armed and old_y <= LINE_Y + 1.5\\n                and self.y > LINE_Y + 0.5 and self.vy > 0.15):\\n            self.counted = True\\n            return True\\n        return False\\n\\n'''\nassert needle in s\ns=s.replace(needle,insert+needle)\ns=s.replace('''            if len(enclosed) >= 2 and d[\"area\"] >= 1.28 * max(t.area for t in enclosed):\\n                consumed_d.add(di)\\n                for t in enclosed:\\n                    held_t.add(t.ident)\\n                    t.missed += 1\\n''','''            if len(enclosed) >= 2:\\n                consumed_d.add(di)\\n                for t in enclosed:\\n                    held_t.add(t.ident)\\n                    if t.coast(fi): total += 1\\n''')\nopen(p,'w').write(s)\nPY\ncat > /tmp/synthtest.py <<'PY'\nimport cv2, numpy as np, subprocess, toml, os\nW,H=160,120\nfourcc=cv2.VideoWriter_fourcc(*'mp4v')\n\ndef run(name, paths, expected):\n    fn='/tmp/'+name+'.mp4'; out=cv2.VideoWriter(fn,fourcc,12,(W,H))\n    n=max(len(q) for q in paths)\n    for i in range(n):\n        f=np.full((H,W,3),(48,45,52),np.uint8)\n        for j,q in enumerate(paths):\n            if i<len(q) and q[i] is not None:\n                x,y=q[i]\n                cv2.circle(f,(int(x),int(y)),9,[(30,190,240),(220,80,50),(60,220,80)][j%3],-1)\n        out.write(f)\n    out.release()\n    r=subprocess.run(['python3','/app/varnish/mill.pyc',fn])\n    got=toml.load('/app/inkwell/sheet.toml')['crossings'] if r.returncode==0 else None\n    print(name,'expected',expected,'got',got)\n    assert got==expected\n\ndef path(x, ys): return [(x,y) for y in ys]\n# Two bodies become one silhouette around the scan, then split.\na=[]; b=[]\nfor i in range(34):\n    y=8+3*i\n    dx=max(0,18-2*i) if i<9 else (min(18,2*(i-22)) if i>22 else 0)\n    a.append((70-dx,y)); b.append((70+dx,y))\nrun('overlap',[a,b],2)\n# Down, up, lingering at the line, and one body that never crosses downward.\nrun('directions',[path(35,list(range(10,105,4))),path(75,list(range(105,8,-4))),path(115,list(range(12,69,4))+[69,70,70,69,70,71,71,72]+list(range(76,108,4)))],2)\n# Same body crosses, exits bottom, returns upward, then crosses downward again:\n# it must still count only once.\nys=list(range(8,113,5))+[None]*14+list(range(112,30,-5))+list(range(30,108,5))\nq=[None if y is None else (80,y) for y in ys]\nrun('return',[q],1)\nPY\n/app/kiln/bake.sh\npython3 /tmp/synthtest.py\npython3 /app/varnish/mill.pyc /app/shown.mp4 && cat /app/inkwell/sheet.toml\npython3 -m py_compile /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py\n"]
[235.000912, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[235.001203, "o", "\u001b[?2004h> p='/app/tether.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.001422, "o", "needle='''    def observe(self, d: dict, frame_no: int) -> bool:\\n'''\r\n\u001b[?2004l\r"]
[235.001502, "o", "\u001b[?2004h> "]
[235.003596, "o", "insert='''    def coast(self, frame_no: int) -> bool:\\n        \\\"\\\"\\\"Advance an identity hidden inside a merged silhouette.\\\"\\\"\\\"\\n        old_y = self.y\\n        self.x += self.vx\\n        self.y += self.vy\\n        self.last = frame_no\\n        self.missed += 1\\n        self.min_y, self.max_y = min(self.min_y, self.y), max(self.max_y, self.y)\\n        if self.y <= LINE_Y - 0.5:\\n            self.armed = True\\n        if (not self.counted and self.armed and old_y <= LINE_Y + 1.5\\n                and self.y > LINE_Y + 0.5 and self.vy > 0.15):\\n            self.counted = True\\n            return True\\n        return False\\n\\n'''\r\n\u001b[?2004l\r"]
[235.004109, "o", "\u001b[?2004h> assert needle in s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.004145, "o", "s=s.replace(needle,insert+needle)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.005605, "o", "s=s.replace('''            if len(enclosed) >= 2 and d[\"area\"] >= 1.28 * max(t.area for t in enclosed):\\n                consumed_d.add(di)\\n                for t in enclosed:\\n                    held_t.add(t.ident)\\n                    t.missed += 1\\n''','''            if len(enclosed) >= 2:\\n                consumed_d.add(di)\\n                for t in enclosed:\\n                    held_t.add(t.ident)\\n                    if t.coast(fi): total += 1\\n''')\r\n\u001b[?2004l\r"]
[235.005723, "o", "\u001b[?2004h> "]
