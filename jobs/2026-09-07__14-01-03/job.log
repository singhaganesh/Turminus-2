\tif cols[i] == "id" {\n\t\t\t\t\t\trow[i] = "1"\n\t\t\t\t\t} else if cols[i] == "label" {\n\t\t\t\t\t\trow[i] = "boot"\n\t\t\t\t\t} else {\n\t\t\t\t\t\trow[i] = "0"\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tst.Rows = [][]string{row}\n\t\t\t}\n\t\tcase strings.Contains(u, "ADD COLUMN"):\n\t\t\tidx := strings.Index(u, "ADD COLUMN")\n\t\t\tfields := strings.Fields(line[idx+len("ADD COLUMN"):])\n\t\t\tif len(fields) == 0 {\n\t\t\t\treturn fmt.Errorf("add column")\n\t\t\t}\n\t\t\tname := strings.Trim(fields[0], "\\"`[]")\n\t\t\tif name == "" {\n\t\t\t\treturn fmt.Errorf("add column")\n\t\t\t}\n\t\t\tst.AddCol(name)\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc parseCreate(rest string) (string, []string, bool) {\n\ti := strings.Index(rest, "(")\n\tj := strings.Index(rest, ")")\n\tif i < 0 || j < 0 || j <= i {\n\t\treturn "", nil, false\n\t}\n\tname := strings.TrimSpace(rest[:i])\n\tinner := rest[i+1 : j]\n\tparts := strings.Split(inner, ",")\n\tcols := make([]string, 0, len(parts))\n\tfor _, p := range parts {\n\t\tp = strings.TrimSpace(p)\n\t\tif p != "" {\n\t\t\tcols = append(cols, p)\n\t\t}\n\t}\n\treturn name, cols, name != "" && len(cols) > 0\n}\nEOF\n/usr/local/go/bin/gofmt -w /app/hopsrc/imprint/imprint.go\n/usr/local/go/bin/go test ./... && make ship\n/app/bin/kilncli impress /app/vats/plaster.vat && /app/bin/kilncli spill && rm -f /app/vats/assay.ok && /app/bin/kilncli assay\nprintf \'%s\\n\' \'--- plaster ---\'; cat /app/vats/plaster.vat; printf \'%s\\n\' \'--- worker ---\'; cat /app/vats/worker.vat; printf \'%s\\n\' \'--- marker ---\'; cat /app/vats/assay.ok\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
