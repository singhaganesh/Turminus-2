[9.464009, "o", "Kiln CLI lives at /app/bin/kilncli.\r\n\r\nSubcommands:\r\n  impress PATH  apply every *.sql under /app/inkstack/migrations/ onto PATH\r\n  spill         fill /app/vats/worker.vat for assay\r\n  assay         read /app/vats/worker.vat, print schema_version, write /app/vats/assay.ok on success\r\n\r\nThe Makefile at /app/Makefile ships /app/bin/kilncli from the kilncli module.\r\n\r\nSources that implement those subcommands:\r\n  /app/hopsrc/imprint\r\n  /app/claybin\r\n  /app/scorepit\r\n\r\nLedger intent: /app/inkstack/intent.toml\r\nWorkspace vat path used by local experiments: /app/hearth/focus.txt\r\n"]
[9.464442, "o", "\u001b[?2004hroot@409e058ddf27:/app# "]
[9.591881, "i", "printf '%s\\n' '--- files ---'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort; printf '%s\\n' '--- vats ---'; for f in /app/vats/*.vat; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- migrations ---'; find /app/inkstack/migrations -maxdepth 1 -type f -name '*.sql' -printf '%f\\n' | sort\n"]
[9.592844, "o", "printf '%s\\n' '--- files ---'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort; printf '%s\\n' '--- vats ---'; for f in /app/vats/*.vat; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- migrations ---'; find /app/inkstack/migrations -maxdepth 1 -type f -name '*.sql' -printf '%f\\n' | sort\r\n"]
