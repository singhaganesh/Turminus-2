[54.716205, "o", "spill source schema_version=0003_base, ledger head=0004_attempt_slot\r\n\u001b[?2004hroot@409e058ddf27:/app# "]
[55.822824, "i", "echo '--- plaster'; cat /app/vats/plaster.vat; echo '--- worker'; cat /app/vats/worker.vat; echo '--- marker'; cat /app/vats/assay.ok; echo '--- source diff'; git diff --no-index /dev/null claybin/emit.go 2>/dev/null || true\n"]
[55.823807, "o", "echo '--- plaster'; cat /app/vats/plaster.vat; echo '--- worker'; cat /app/vats/worker.vat; echo '--- marker'; cat /app/vats/assay.ok; echo '--- source diff'; git diff --no-index /dev/null claybin/emit.go 2>/dev/null || true\r\n\u001b[?2004l\r"]
[55.82399, "o", "--- plaster\r\n"]
[55.82524, "o", "KILNVAT 1\r\napplied:0003_base\r\ntable:tries\r\ncols:id,label\r\nrow:1,boot\r\n"]
[55.825551, "o", "--- worker\r\n"]
[55.826812, "o", "KILNVAT 1\r\napplied:0003_base\r\ntable:tries\r\ncols:id,label\r\nrow:1,boot\r\n"]
[55.827146, "o", "--- marker\r\n"]
[55.828247, "o", "cat: /app/vats/assay.ok: No such file or directory\r\n"]
[55.828472, "o", "--- source diff\r\n"]
[55.870738, "o", "\u001b[1mdiff --git a/claybin/emit.go b/claybin/emit.go\u001b[m\r\n\u001b[1mnew file mode 100644\u001b[m\r\n\u001b[1mindex 0000000..b094c89\u001b[m\r\n"]
