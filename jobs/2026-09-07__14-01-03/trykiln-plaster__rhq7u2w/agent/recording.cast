[55.871083, "o", "\u001b[32m+\u001b[m\u001b[32mpackage claybin\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport (\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m\"fmt\"\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m\"kilnbench/hopsrc/vat\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m)\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mconst (\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32msrc    = \"/app/vats/plaster.vat\"\u001b[m\r\n"]
[55.871207, "o", "\u001b[32m+\u001b[m\t\u001b[32mdst    = \"/app/vats/worker.vat\"\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mmigDir = \"/app/inkstack/migrations\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m)\u001b[m\r\n"]
[55.87135, "o", "\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunc EmitWorker() error {\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mst, err := vat.Parse(src)\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif err != nil {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn err\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mhead, err := vat.LedgerHead(migDir)\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif err != nil {\u001b[m\r\n\u001b[32m+\u001b[m\t\t\u001b[32mreturn err\u001b[m\r\n"]
[55.871395, "o", "\u001b[32m+\u001b[m\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mif st.LastApplied() != head {\u001b[m\r\n"]
[55.871559, "o", "\u001b[32m+\u001b[m\t\t\u001b[32mreturn fmt.Errorf(\"spill source schema_version=%s, ledger head=%s\", st.LastApplied(), head)\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\t\u001b[32mreturn vat.CopyFile(src, dst)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n"]
[55.872292, "o", "\u001b[?2004hroot@409e058ddf27:/app# "]
[55.989911, "i", "cp /app/vats/plaster.vat /tmp/plaster.good; sed -i '/applied:0004_attempt_slot/d' /app/vats/plaster.vat; if /app/bin/kilncli spill; then echo 'ERROR: stale spill unexpectedly succeeded'; status=1; else echo 'stale spill correctly rejected'; status=0; fi; mv /tmp/plaster.good /app/vats/plaster.vat; /app/bin/kilncli spill && /app/bin/kilncli assay; exit $status\n"]
[55.991625, "o", "cp /app/vats/plaster.vat /tmp/plaster.good; sed -i '/applied:0004_attempt_slot/d' /app/vats/plaster.vat; if /app/bin/kilncli spill; then echo 'ERROR: stale spill unexpectedly succeeded'; status=1; else echo 'stale spill correctly rejected'; status=0; fi; mv /tmp/plaster.good /app/vats/plaster.vat; /app/bin/kilncli spill && /app/bin/kilncli assay; exit $status\r\n\u001b[?2004l\r"]
[56.003347, "o", "spill source schema_version=0003_base, ledger head=0004_attempt_slot\r\n"]
[56.003609, "o", "stale spill correctly rejected\r\n"]
[56.007983, "o", "spill source schema_version=0003_base, ledger head=0004_attempt_slot\r\n"]
[56.008377, "o", "exit\r\n"]
