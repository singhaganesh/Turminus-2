[23.48955, "o", ".PHONY: ship\r\n\r\nship:\r\n\tmkdir -p /app/bin\r\n\t/usr/local/go/bin/go build -o /app/bin/kilncli ./kilncli\r\n"]
[23.489634, "o", "module kilnbench\r\n\r\ngo 1.24\r\n[tries]\r\ncolumns = [\"id\", \"label\", \"attempt_slot\"]\r\n"]
[23.489797, "o", "CREATE TABLE tries (id, label);\r\n-- retry counter on tries\r\nALTER TABLE tries\r\n  ADD COLUMN \"attempt_slot\";\r\n"]
