[73.397195, "o", "KILNVAT 1\r\napplied:0003_base\r\napplied:0004_attempt_slot\r\ntable:tries\r\ncols:id,label,attempt_slot\r\nrow:1,boot,0\r\n"]
[73.397367, "o", "--- worker ---\r\n"]
[73.398142, "o", "KILNVAT 1\r\napplied:0003_base\r\napplied:0004_attempt_slot\r\ntable:tries\r\ncols:id,label,attempt_slot\r\nrow:1,boot,0\r\n"]
[73.398316, "o", "--- marker ---\r\n"]
