[21.943201, "o", "\t}\r\n\tfmt.Printf(\"schema_version=%s\\n\", st.LastApplied())\r\n\tif !st.HasCol(\"attempt_slot\") {\r\n\t\tfmt.Fprintln(os.Stderr, \"unknown-column: attempt_slot\")\r\n\t\treturn 1\r\n\t}\r\n\t_ = os.WriteFile(okPath, []byte(\"ok\\n\"), 0644)\r\n\treturn 0\r\n}\r\n"]
