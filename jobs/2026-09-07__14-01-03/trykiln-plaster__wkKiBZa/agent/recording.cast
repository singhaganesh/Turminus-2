[21.949582, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n"]
[21.9497, "o", "\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: kilncli impress|spill|assay\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"impress\":\r\n\t\tcode = cmdImpress(os.Args[2:])\r\n"]
[21.949755, "o", "\tcase \"spill\":\r\n\t\tcode = cmdSpill()\r\n\tcase \"assay\":\r\n\t\tcode = cmdAssay()\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: kilncli impress|spill|assay\")\r\n\t\tcode = 2\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n"]
