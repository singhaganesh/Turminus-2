[73.396325, "o", "printf '%s\\n' '--- plaster ---'; cat /app/vats/plaster.vat; printf '%s\\n' '--- worker ---'; cat /app/vats/worker.vat; printf '%s\\n' '--- marker ---'; cat /app/vats/assay.ok\r\n\u001b[?2004l\r"]
