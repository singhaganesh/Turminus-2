[72.938203, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[72.938318, "o", "\u0007"]
[72.938356, "o", "if i < 0 || j < 0 || j <= i {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.938447, "o", "\u0007"]
[72.938586, "o", "\r\nMakefile  baydocs/  bin/      claybin/  go.mod    hearth/   hopsrc/   inkstack/ kilncli/  scorepit/ vats/     \r\n> "]
[72.938679, "o", "return \"\", nil, false\r\n\u001b[?2004l\r"]
[72.938756, "o", "\u001b[?2004h> \u0007"]
[72.938795, "o", "}\r\n\u001b[?2004l\r"]
[72.938831, "o", "\u001b[?2004h> "]
[72.938967, "o", "\u0007"]
[72.93901, "o", "name := strings.TrimSpace(rest[:i])\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.939046, "o", "> "]
[72.939175, "o", "\u0007inner := rest[i+1 : j]\r\n\u001b[?2004l\r"]
[72.939253, "o", "\u001b[?2004h> "]
[72.939327, "o", "\u0007"]
[72.939423, "o", "parts := strings.Split(inner, \",\")\r\n\u001b[?2004l\r"]
[72.939479, "o", "\u001b[?2004h> "]
[72.939602, "o", "\u0007"]
[72.939686, "o", "cols := make([]string, 0, len(parts))\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.939718, "o", "> "]
[72.939826, "o", "\u0007"]
[72.939908, "o", "for _, p := range parts {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.939995, "o", "\u0007"]
[72.940072, "o", "\r\n"]
[72.940158, "o", "Makefile  baydocs/  bin/      claybin/  go.mod    hearth/   hopsrc/   inkstack/ kilncli/  scorepit/ vats/     \r\n> "]
[72.940243, "o", "p = strings.TrimSpace(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.94033, "o", "\u0007"]
[72.940413, "o", "\r\n"]
[72.940512, "o", "Makefile  baydocs/  bin/      claybin/  go.mod    hearth/   hopsrc/   inkstack/ kilncli/  scorepit/ vats/     \r\n> if p != \"\" {\r\n\u001b[?2004l\r"]
[72.940595, "o", "\u001b[?2004h> "]
[72.940671, "o", "\u0007"]
[72.940749, "o", "\r\nMakefile  baydocs/  bin/      claybin/  go.mod    hearth/   hopsrc/   inkstack/ kilncli/  scorepit/ vats/     \r\n"]
[72.940781, "o", "> "]
[72.940886, "o", "\r\nMakefile  baydocs/  bin/      claybin/  go.mod    hearth/   hopsrc/   inkstack/ kilncli/  scorepit/ vats/     \r\n> "]
[72.940975, "o", "cols = append(cols, p)\r\n\u001b[?2004l\r"]
[72.941007, "o", "\u001b[?2004h> "]
[72.94111, "o", "\u0007"]
[72.941197, "o", "\r\nMakefile  baydocs/  bin/      claybin/  go.mod    hearth/   hopsrc/   inkstack/ kilncli/  scorepit/ vats/     \r\n> "]
[72.941238, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.941273, "o", "> "]
[72.941399, "o", "\u0007}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.941491, "o", "\u0007"]
[72.941601, "o", "return name, cols, name != \"\" && len(cols) > 0\r\n\u001b[?2004l\r"]
[72.94169, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
