[73.399294, "o", "\u001b[?2004hroot@631e5ebb082a:/app# "]
[76.907484, "i", "set +e\ncp /app/vats/worker.vat /tmp/worker.good\ncp /app/vats/mold.vat /app/vats/worker.vat\nprintf 'stale marker\\n' > /app/vats/assay.ok\n/app/bin/kilncli assay >/tmp/assay-stale.out 2>/tmp/assay-stale.err\nas=$?\nprintf 'stale_worker_assay_status=%s marker_exists=%s\\n' \"$as\" \"$([ -e /app/vats/assay.ok ] && echo yes || echo no)\"\ncat /tmp/assay-stale.out /tmp/assay-stale.err\nmv /tmp/worker.good /app/vats/worker.vat\ncp /app/vats/plaster.vat /tmp/plaster.good\ncp /app/vats/mold.vat /app/vats/plaster.vat\n/app/bin/kilncli spill >/tmp/spill-stale.out 2>/tmp/spill-stale.err\nss=$?\nprintf 'stale_source_spill_status=%s\\n' \"$ss\"\ncat /tmp/spill-stale.out /tmp/spill-stale.err\nmv /tmp/plaster.good /app/vats/plaster.vat\ncat > /app/inkstack/migrations/9999_probe.sql <<'EOF'\n-- verifier probe: intentionally no schema operation\nEOF\n/app/bin/kilncli spill >/tmp/spill-new.out 2>/tmp/spill-new.err\nns=$?\nprintf 'newer_migration_spill_status=%s\\n' \"$ns\"\ncat /tmp/spill-new.out /tmp/spill-new.err\nrm -f /app/inkstack/migrations/9999_probe.sql\n/app/bin/kilncli spill\nrm -f /app/vats/assay.ok\n/app/bin/kilncli assay\nfs=$?\nprintf 'final_assay_status=%s\\n' \"$fs\"\ncat /app/vats/assay.ok\nexit 0\n"]
