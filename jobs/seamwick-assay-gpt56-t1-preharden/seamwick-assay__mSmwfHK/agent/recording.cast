[136.257808, "i", "python3 - <<'PY'\np='/app/seamcmd/Drive.java'\ns=open(p).read()\nneedle='        pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\\n'\ninsert='''        pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\n        // Keep every current finding in an incremental blot.  These units are\n        // precisely paths flood would flag, so this does not broaden a clean,\n        // single-type nudge with unrelated paths.\n        LinkedHashSet<String> focused = new LinkedHashSet<String>(pick);\n        for (Loom.Unit u : units.values()) {\n          if (!u.hits.isEmpty()) focused.add(u.path);\n        }\n        pick = new ArrayList<String>(focused);\n'''\nif s.count(needle) != 1:\n    raise SystemExit('expected one scheduling anchor, found %d' % s.count(needle))\nopen(p,'w').write(s.replace(needle, insert))\nPY\n/app/assemble.bash\n"]
