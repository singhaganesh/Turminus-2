[30.338938, "o", "     1\timport java.util.*;\r\n     2\tpublic class Sched {\r\n     3\t  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\r\n     4\t    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n     5\t    s.addAll(changedFiles);\r\n     6\t    for (String c : changedFiles) {\r\n     7\t      Set<String> im = importers.get(c);\r\n     8\t      if (im != null) s.addAll(im);\r\n     9\t    }\r\n    10\t    return new ArrayList<String>(s);\r\n    11\t  }\r\n    12\t}\r\n"]
