[20.83018, "o", "import java.util.*;\r\npublic class Sched {\r\n  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(changedFiles);\r\n    for (String c : changedFiles) {\r\n      Set<String> im = importers.get(c);\r\n      if (im != null) s.addAll(im);\r\n    }\r\n    return new ArrayList<String>(s);\r\n  }\r\n}\r\n"]
