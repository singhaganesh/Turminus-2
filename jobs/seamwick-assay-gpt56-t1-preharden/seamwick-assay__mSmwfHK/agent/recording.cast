[30.021844, "o", "    41\t    u.path = root.relativize(p).toString().replace('\\\\', '/');\r\n    42\t    u.body = Files.readString(p);\r\n    43\t    u.hash = Bag.hex(u.body.getBytes(StandardCharsets.UTF_8));\r\n    44\t    Matcher pm = PKG.matcher(u.body);\r\n    45\t    u.pkg = pm.find() ? pm.group(1) : \"\";\r\n    46\t    Matcher im = IMP.matcher(u.body);\r\n    47\t    while (im.find()) {\r\n    48\t      String r = im.group(1);\r\n    49\t      if (r.endsWith(\".*\")) continue;\r\n    50\t      u.importedUnits.add(r.replace('.', '/') + \".u\");\r\n    51\t    }\r\n    52\t    Matcher ic = IFACE.matcher(u.body);\r\n    53\t    LinkedHashMap<String, String> methods = new LinkedHashMap<String, String>();\r\n    54\t    String typeName = null;\r\n    55\t    if (ic.find()) {\r\n    56\t      typeName = ic.group(1);\r\n    57\t      u.defined.add(typeName);\r\n    58\t    }\r\n    59\t    Matcher mm = METH.matcher(u.body);\r\n    60\t    while (mm.find()) {\r\n    61\t      String name = mm.group(1);\r\n    62\t      String args = mm.group(2).trim();\r\n    63\t      int n = args.isEmpty() ? 0 : args.split(\",\").length;\r\n    64\t      methods.put(name, name + \":\" + n);\r\n    65\t    }\r\n    66\t    if (typeName != null) {\r\n    67\t      ArrayList<String> parts = new ArrayList<String>(methods.values());\r\n    68\t      Collections.sort(parts);\r\n    69\t      StringBuilder fp = new StringBuilder();\r\n    70\t      for (int i = 0; i < parts.size(); i++) {\r\n    71\t        if (i > 0) fp.append(';');\r\n    72\t        fp.append(parts.get(i));\r\n    73\t      }\r\n    74\t      u.fps.put(typeName, fp.toString());\r\n    75\t    }\r\n    76\t    return u;\r\n    77\t  }\r\n    78\t\r\n    79\t  static void resolveHits(LinkedHashMap<String, Unit> all) {\r\n    80\t    LinkedHashMap<String, String> methArity = new LinkedHashMap<String, String>();\r\n    81\t    for (Unit u : all.values()) {\r\n    82\t      for (Map.Entry<String, String> e : u.fps.entrySet()) {\r\n    83\t        for (String part : e.getValue().split(\";\")) {\r\n    84\t          if (part.isEmpty()) continue;\r\n    85\t          methArity.put(e.getKey() + \"#\" + part.split(\":\")[0], part.split(\":\")[1]);\r\n    86\t        }\r\n    87\t      }\r\n    88\t    }\r\n    89\t    for (Unit u : all.values()) {\r\n    90\t      Matcher c = CALL.matcher(u.body);\r\n    91\t      while (c.find()) {\r\n    92\t        String name = c.group(1);\r\n    93\t        String args = c.group(2).trim();\r\n    94\t        int n = args.isEmpty() ? 0 : splitArgs(args);\r\n    95\t        for (Unit def : all.values()) {\r\n    96\t          for (String t : def.defined) {\r\n    97\t            String want = methArity.get(t + \"#\" + name);\r\n    98\t            if (want == null) continue;\r\n    99\t            if (Integer.parseInt(want) != n) {\r\n   100\t              u.hits.add(new String[] {u.path, \"arity\", name});\r\n   101\t            }\r\n   102\t          }\r\n   103\t        }\r\n   104\t      }\r\n   105\t    }\r\n   106\t  }\r\n   107\t\r\n   108\t  static int splitArgs(String args) {\r\n   109\t    int n = 1;\r\n   110\t    int depth = 0;\r\n   111\t    boolean q = false;\r\n   112\t    for (int i = 0; i < args.length(); i++) {\r\n   113\t      char ch = args.charAt(i);\r\n   114\t      if (ch == '\"') q = !q;\r\n   115\t      else if (!q && ch == '(') depth++;\r\n   116\t      else if (!q && ch == ')') depth--;\r\n   117\t      else if (!q && depth == 0 && ch == ',') n++;\r\n   118\t    }\r\n   119\t    return n;\r\n   120\t  }\r\n   121\t}\r\n"]
