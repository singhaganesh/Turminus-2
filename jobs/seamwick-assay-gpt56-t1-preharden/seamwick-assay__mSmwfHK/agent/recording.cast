[30.337574, "o", "     5\t    String[] lines = body.split(\"\\n\");\r\n     6\t    for (int i = 0; i < lines.length; i++) {\r\n     7\t      String t = lines[i].trim();\r\n     8\t      if (t.startsWith(\"import \")) {\r\n     9\t        String r = t.substring(7).replace(\";\", \"\").trim();\r\n    10\t        int d = r.lastIndexOf('.');\r\n    11\t        String n = d < 0 ? r : r.substring(d + 1);\r\n    12\t        if (known.contains(n)) out.add(n);\r\n    13\t      }\r\n    14\t    }\r\n    15\t    return out;\r\n    16\t  }\r\n    17\t}\r\n"]
