[108.223565, "i", "python3 - <<'PY'\np='/app/seamcmd/Drive.java'\ns=open(p).read()\nold='''      } else {\n        pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\n      }\n      LinkedHashSet<String> analysed = new LinkedHashSet<String>();\n'''\nnew='''      } else {\n        pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\n        // A dirty unit must not disappear merely because the cache was refreshed by\n        // an earlier flood.  Adding only current hit units keeps nudge focused while\n        // ensuring its findings remain compatible with a flood of the same tree.\n        LinkedHashSet<String> focused = new LinkedHashSet<String>(pick);\n        for (Loom.Unit u : units.values()) {\n          if (!u.hits.isEmpty()) focused.add(u.path);\n        }\n        pick = new ArrayList<String>(focused);\n      }\n      LinkedHashSet<String> analysed = new LinkedHashSet<String>();\n'''\nif old not in s:\n    raise SystemExit('patch anchor not found')\nopen(p,'w').write(s.replace(old,new))\nPY\n/app/assemble.bash\n"]
