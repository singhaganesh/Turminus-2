[160.599804, "i", "python3 - <<'PY'\np='/app/seamcmd/Drive.java'\nlines=open(p).read().splitlines(True)\nout=[]\nfound=0\nfor line in lines:\n    out.append(line)\n    if line.strip() == 'pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);':\n        found += 1\n        indent=line[:len(line)-len(line.lstrip())]\n        out.extend([\n            indent+'// Preserve every current flood finding in incremental results.\\n',\n            indent+'LinkedHashSet<String> focused = new LinkedHashSet<String>(pick);\\n',\n            indent+'for (Loom.Unit u : units.values()) {\\n',\n            indent+'  if (!u.hits.isEmpty()) focused.add(u.path);\\n',\n            indent+'}\\n',\n            indent+'pick = new ArrayList<String>(focused);\\n'])\nif found != 1:\n    raise SystemExit('expected one scheduling line, found %d' % found)\nopen(p,'w').writelines(out)\nPY\ngrep -n -A12 -B2 'Sched.pick' /app/seamcmd/Drive.java\n/app/assemble.bash\n"]
