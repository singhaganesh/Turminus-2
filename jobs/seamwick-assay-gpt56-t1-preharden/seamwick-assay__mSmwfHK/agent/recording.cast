[20.832232, "o", "import java.util.*;\r\npublic class Seal {\r\n  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(hitUnits);\r\n    return new ArrayList<String>(s);\r\n  }\r\n  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\r\n    if (analysed.size() >= floor) return \"0\";\r\n    if (hitUnits.isEmpty()) return \"0\";\r\n    return \"1\";\r\n  }\r\n}\r\n"]
