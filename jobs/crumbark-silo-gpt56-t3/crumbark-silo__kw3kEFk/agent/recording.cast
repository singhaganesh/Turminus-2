[30.499654, "o", "     7\tpublic class HueWalk {\r\n     8\t    public static int orb_n(Path a, Path b, Path c) throws Exception {\r\n     9\t        byte[] pins = Files.exists(b) ? Files.readAllBytes(b) : new byte[0];\r\n    10\t        List<String> held = new ArrayList<String>();\r\n    11\t        int i = 0;\r\n    12\t        while (i + 48 <= pins.length) {\r\n    13\t            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\r\n    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            int crc = bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            held.add(hex(id));\r\n    22\t            i += 48;\r\n    23\t        }\r\n    24\t        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"ok\\\",\\\"kind\\\":\\\"live\\\"}\";\r\n    25\t        Files.writeString(c, json);\r\n    26\t        return 0;\r\n    27\t    }\r\n    28\t\r\n    29\t    static String hex(byte[] id) {\r\n    30\t        StringBuilder sb = new StringBuilder();\r\n    31\t        for (byte v : id) {\r\n    32\t            sb.append(String.format(\"%02x\", v & 0xff));\r\n    33\t        }\r\n    34\t        return sb.toString();\r\n    35\t    }\r\n    36\t\r\n"]
[30.499766, "o", "    37\t    static String arr(List<String> held) {\r\n    38\t        StringBuilder sb = new StringBuilder(\"[\");\r\n    39\t        for (int i = 0; i < held.size(); i++) {\r\n    40\t            if (i > 0) {\r\n    41\t                sb.append(\",\");\r\n    42\t            }\r\n    43\t            sb.append(\"\\\"\");\r\n    44\t            sb.append(held.get(i));\r\n    45\t            sb.append(\"\\\"\");\r\n    46\t        }\r\n    47\t        sb.append(\"]\");\r\n    48\t        return sb.toString();\r\n    49\t    }\r\n    50\t\r\n    51\t    public static void main(String[] args) throws Exception {\r\n    52\t        Path silo = Path.of(\"/app/silo\");\r\n    53\t        int rc = orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\"));\r\n    54\t        System.exit(rc);\r\n    55\t    }\r\n    56\t}\r\n"]
