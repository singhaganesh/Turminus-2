[30.502712, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\timport java.util.ArrayList;\r\n     5\timport java.util.Comparator;\r\n     6\timport java.util.List;\r\n     7\t\r\n     8\tpublic class LoomCue {\r\n     9\t    static final class Step {\r\n    10\t        String name;\r\n    11\t        int compute;\r\n    12\t        int durable;\r\n    13\t    }\r\n"]
[30.502911, "o", "    14\t\r\n    15\t    public static List<String> rib_q(Path a) throws Exception {\r\n    16\t        List<Step> steps = new ArrayList<Step>();\r\n    17\t        for (String line : Files.readAllLines(a)) {\r\n    18\t            String s = line.trim();\r\n    19\t            if (s.isEmpty() || s.startsWith(\"#\")) {\r\n    20\t                continue;\r\n    21\t            }\r\n    22\t            String[] p = s.split(\"\\\\s+\");\r\n    23\t            if (p.length < 3) {\r\n    24\t                continue;\r\n    25\t            }\r\n    26\t            Step st = new Step();\r\n    27\t            st.name = p[0];\r\n    28\t            st.compute = Integer.parseInt(p[1]);\r\n    29\t            st.durable = Integer.parseInt(p[2]);\r\n    30\t            steps.add(st);\r\n    31\t        }\r\n    32\t        steps.sort(Comparator.comparingInt(x -> x.compute));\r\n    33\t        List<String> names = new ArrayList<String>();\r\n    34\t        for (Step st : steps) {\r\n    35\t            names.add(st.name);\r\n    36\t        }\r\n    37\t        return names;\r\n    38\t    }\r\n    39\t\r\n    40\t    public static void main(String[] args) throws Exception {\r\n    41\t        Path recipe = Paths.get(\"/app/recipit/steps.loom\");\r\n    42\t        List<String> names = rib_q(recipe);\r\n    43\t        StringBuilder sb = new StringBuilder();\r\n    44\t        sb.append(\"public class ForceSeq {\\n\");\r\n    45\t        sb.append(\"    public static String[] names() {\\n\");\r\n    46\t        sb.append(\"        return new String[] {\");\r\n    47\t        for (int i = 0; i < names.size(); i++) {\r\n    48\t            if (i > 0) {\r\n    49\t                sb.append(\", \");\r\n    50\t            }\r\n    51\t            sb.append(\"\\\"\");\r\n    52\t            sb.append(names.get(i));\r\n    53\t            sb.append(\"\\\"\");\r\n    54\t        }\r\n    55\t        sb.append(\"};\\n\");\r\n    56\t        sb.append(\"    }\\n\");\r\n    57\t        sb.append(\"}\\n\");\r\n    58\t        Files.writeString(Paths.get(\"/app/recipit/ForceSeq.java\"), sb.toString());\r\n    59\t    }\r\n    60\t}\r\n"]
