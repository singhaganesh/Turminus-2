[83.408834, "i", "cat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.Arrays;\n\npublic class MistSpan {\n    static final int ALIGN = 32;\n    static final int ROW = 48;\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        if (wanted == null || wanted.length != 16) return null;\n        byte[] pins = Files.exists(silo.resolve(\"pin.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"pin.bin\")) : new byte[0];\n        byte[] blob = Files.exists(silo.resolve(\"blob.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"blob.bin\")) : new byte[0];\n        for (int pos = 0; pos + ROW <= pins.length; pos += ROW) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, ROW);\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            if (Arrays.equals(id, wanted)) return body(blob, magic, off, len, crc, id);\n        }\n        return null;\n    }\n\n    static byte[] body(byte[] blob, byte[] magic, long off, int len, int crc, byte[] id)\n            throws Exception {\n        if (!Arrays.equals(magic, new byte[]{'P','N','0','1'}) || off < 0 || len < 0)\n            return null;\n        long rec = 4L + len;\n        long padded = rec + ((ALIGN - (rec % ALIGN)) % ALIGN);\n        if (off > Integer.MAX_VALUE || padded > Integer.MAX_VALUE || off + padded < off\n                || off + padded > blob.length) return null;\n        int at = (int) off;\n        if (ByteBuffer.wrap(blob, at, 4).getInt() != len) return null;\n        byte[] payload = Arrays.copyOfRange(blob, at + 4, at + 4 + len);\n        if (Crc.of(payload) != crc) return null;\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\n        for (int i = 0; i < 16; i++) if (digest[i] != id[i]) return null;\n        return payload;\n    }\n}\nEOF\ncat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class YankRun {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1 || !args[0].matches(\"[0-9a-f]{32}\")) System.exit(2);\n        byte[] got = MistSpan.tint_k(Paths.get(\"/app/silo\"), hex(args[0]));\n        if (got == null) System.exit(1);\n        System.out.write(got);\n    }\n\n    static byte[] hex(String s) {\n        byte[] out = new byte[16];\n        for (int i = 0; i < out.length; i++)\n            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        return out;\n    }\n}\nEOF\n"]
