[30.506379, "o", "     5\tpublic class YankRun {\r\n     6\t    public static void main(String[] args) throws Exception {\r\n     7\t        if (args.length < 1) {\r\n     8\t            System.exit(2);\r\n     9\t        }\r\n    10\t        byte[] id = hex(args[0]);\r\n    11\t        Path silo = Paths.get(\"/app/silo\");\r\n    12\t        byte[] got = MistSpan.tint_k(silo, id);\r\n    13\t        if (got.length == 0 || allZero(got)) {\r\n    14\t            PauseCue.nap();\r\n    15\t            got = MistSpan.tint_k(silo, id);\r\n    16\t        }\r\n    17\t        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\r\n    18\t        System.out.write(got);\r\n    19\t    }\r\n    20\t\r\n    21\t    static boolean allZero(byte[] a) {\r\n    22\t        for (byte v : a) {\r\n    23\t            if (v != 0) {\r\n    24\t                return false;\r\n    25\t            }\r\n    26\t        }\r\n    27\t        return a.length > 0;\r\n    28\t    }\r\n    29\t\r\n    30\t    static byte[] hex(String s) {\r\n    31\t        int n = s.length() / 2;\r\n    32\t        byte[] out = new byte[n];\r\n    33\t        for (int i = 0; i < n; i++) {\r\n    34\t            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\r\n    35\t        }\r\n    36\t        return out;\r\n    37\t    }\r\n    38\t}\r\n"]
