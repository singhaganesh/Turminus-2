Sending keys: ['cat > /app/blot.py <<\'PY\'\nfrom __future__ import annotations\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\ndef estimate_background(frames):\n    """A moving body\'s pixels are normally present for a minority of the clip."""\n    a = np.stack(frames).astype(np.uint8)\n    return np.median(a, axis=0).astype(np.uint8)\n\ndef foreground_components(frame, bg):\n    f = frame.astype(np.float32)\n    b = bg.astype(np.float32)\n    delta = np.max(np.abs(f-b), axis=2)\n    # Suppress illumination-only darkening: shadows preserve B:G:R ratios.\n    bn = b / (np.linalg.norm(b, axis=2, keepdims=True) + 1.0)\n    fn = f / (np.linalg.norm(f, axis=2, keepdims=True) + 1.0)\n    chroma = np.linalg.norm(fn-bn, axis=2)\n    bright_ratio = (f.mean(axis=2)+2.0)/(b.mean(axis=2)+2.0)\n    mask = (delta > 18) & ((chroma > .075) | (bright_ratio > 1.22))\n    mask = mask.astype(np.uint8)*255\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((2,2),np.uint8))\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3,3),np.uint8))\n    n, labels, stats, cents = cv2.connectedComponentsWithStats(mask, 8)\n    out=[]\n    H,W=mask.shape\n    for k in range(1,n):\n        x,y,w,h,area = map(int,stats[k])\n        if area < 18: continue\n        # A sweeping shade is generally very long/thin or frame-scale.\n        if w > .72*W or h > .72*H or (max(w,h) > 75 and area < .28*w*h):\n            continue\n        pix=f[labels==k]; bp=b[labels==k]\n        color=np.median(pix,axis=0)\n        out.append({\'x\':float(cents[k,0]),\'y\':float(cents[k,1]),\'box\':(x,y,w,h),\n                    \'area\':float(area),\'color\':color,\'contrast\':float(np.median(np.max(abs(pix-bp),axis=1)))})\n    return out\nPY\n\ncat > /app/tether.py <<\'PY\'\nfrom __future__ import annotations\nimport math\nimport numpy as np\n\nLINE_Y=70.0\n\nclass Track:\n    def __init__(self, det, frame, ident):\n        self.id=ident; self.x=det[\'x\']; self.y=det[\'y\']; self.vx=0.; self.vy=0.\n        self.area=det[\'area\']; self.color=det[\'color\']; self.last=frame\n        self.hits=1; self.missed=0; self.seen_above=self.y < LINE_Y-2\n        self.seen_below=self.y > LINE_Y+2; self.counted=False; self.merged=False\n    def pred(self, frame):\n        dt=min(frame-self.last,8)\n        return self.x+self.vx*dt, self.y+self.vy*dt\n    def update(self,d,frame,soft=False):\n        dt=max(1,frame-self.last); px,py=self.pred(frame)\n        if soft:\n            # In a merge the blob centroid is not an object\'s centroid. Keep velocity.\n            self.x=px; self.y=py; self.merged=True\n        else:\n            nvx=(d[\'x\']-self.x)/dt; nvy=(d[\'y\']-self.y)/dt\n            a=.65 if self.hits>1 else 1.0\n            self.vx=(1-a)*self.vx+a*nvx; self.vy=(1-a)*self.vy+a*nvy\n            self.x=d[\'x\']; self.y=d[\'y\']; self.area=.8*self.area+.2*d[\'area\']\n            self.color=.8*self.color+.2*d[\'color\']; self.merged=False\n        self.last=frame; self.missed=0; self.hits+=1\n        if self.y < LINE_Y-2: self.seen_above=True\n        if self.y > LINE_Y+2: self.seen_below=True\n        if self.seen_above and self.seen_below and self.vy>0 and not self.counted:\n            self.counted=True\n    def coast(self): self.missed+=1\n\ndef track_bodies(all_dets, nominal_area):\n    tracks=[]; nextid=0\n    for fi,dets in enumerate(all_dets):\n        active=[t for t in tracks if t.missed <= 14]\n        assigned=set(); merged_tracks=set()\n        # Components large enough to contain multiple bodies may update every\n        # predicted track inside them, without collapsing identities.\n        for j,d in enumerate(dets):\n            x,y,w,h=d[\'box\']; candidates=[]\n            for t in active:\n                px,py=t.pred(fi)\n                if x-14<=px<=x+w+14 and y-18<=py<=y+h+18:\n                    candidates.append(t)\n            mult=max(1,int(round(d[\'area\']/max(35.,nominal_area))))\n            if len(candidates)>=2 and (mult>=2 or d[\'area\']>1.45*nominal_area):\n                for t in candidates:\n                    t.update(d,fi,soft=True); merged_tracks.add(t.id)\n                assigned.add(j)\n        # Globally greedy assignment by predicted distance plus appearance.\n        pairs=[]\n        for t in active:\n            if t.id in merged_tracks: continue\n            px,py=t.pred(fi)\n            for j,d in enumerate(dets):\n                if j in assigned: continue\n                dist=math.hypot(d[\'x\']-px,d[\'y\']-py)\n                cdist=float(np.linalg.norm(d[\'color\']-t.color))/8.\n                gate=24.+min(t.missed,8)*5\n                if dist<=gate: pairs.append((dist+min(cdist,18),dist,t,j))\n        pairs.sort(key=lambda z:z[0]); used_t=set()\n        for _,dist,t,j in pairs:\n            if t.id in used_t or j in assigned: continue\n            t.update(dets[j],fi); used_t.add(t.id); assigned.add(j)\n        updated=used_t|merged_tracks\n        for t in active:\n            if t.id not in updated: t.coast()\n        for j,d in enumerate(dets):\n            if j in assigned: continue\n            # Ignore residual huge regions; valid bodies/components are compact.\n            if d[\'area\'] <= max(2.8*nominal_area,1800):\n                t=Track(d,fi,nextid); nextid+=1; tracks.append(t)\n    # Require multiple observations, guarding against transient shade/noise.\n    return sum(t.counted and t.hits>=3 for t in tracks)\nPY\n\ncat > /app/spout.py <<\'PY\'\nfrom __future__ import annotations\nimport cv2\nimport numpy as np\nimport toml\nfrom pathlib import Path\nfrom blot import estimate_background, foreground_components\nfrom tether import track_bodies\n\nSHEET=Path(\'/app/inkwell/sheet.toml\')\n\ndef emit_span(src: str) -> int:\n    cap=cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release(); raise OSError(\'cannot open clip\')\n    frames=[]\n    while True:\n        ok,f=cap.read()\n        if not ok: break\n        if f is None or f.shape[:2] !=