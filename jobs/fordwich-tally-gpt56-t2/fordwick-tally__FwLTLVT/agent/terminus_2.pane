[?2004hroot@bde99a56c4fd:/app# python3 - <<'PY'
[?2004l[?2004h> import sys,cv2,numpy as np
[?2004l[?2004h> sys.path.insert(0,'/app')
[?2004l[?2004h> from blot import estimate_background,foreground_components
[?2004l[?2004h> import tether
[?2004l[?2004h> c=cv2.VideoCapture('/tmp/merge.mp4'); fs=[]
[?2004l[?2004h> while 1:
[?2004l[?2004h>  ok,f=c.read()
[?2004l[?2004h>  if not ok: break
[?2004l[?2004h>  fs.append(f)
[?2004l[?2004h> bg=estimate_background(fs); ds=[foreground_components(f,bg) for f in fs]
[?2004l[?2004h> areas=[d['area'] for q in ds for d in q if 35<=d['area']<=1500 and d['box'][2]<70 and d['box'][3]<70]
[?2004l[?2004h> nom=float(np.percentile(areas,35)); print('nominal',nom)
[?2004l[?2004h> # Temporarily wrap update to log track evolution.
[?2004l[?2004h> old=tether.Track.update
[?2004l[?2004h> def upd(self,d,frame,soft=False):
[?2004l[?2004h>  old(self,d,frame,soft)
[?2004l[?2004h>  if 15<=frame<=30: print('f',frame,'id',self.id,'soft',soft,'pos',round(self.x,1),round(self.y,1),'v',round(self.vx,1),round(self.vy,1),'count',self.counted)
[?2004l[?2004h> tether.Track.update=upd
[?2004l[?2004h> print('result',tether.track_bodies(ds,nom))
[?2004l[?2004h> PY
