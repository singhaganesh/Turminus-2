e_file(dp); return 1;\n    }\n    if std::fs::write("/app/inkbay/GUARD", "ok").is_err() { return 1; }\n    0\n}\nfn jstr(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in s.chars() {\n        match c { \'"\' => out.push_str("\\\\\\""), \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"), \'\\r\' => out.push_str("\\\\r"), \'\\t\' => out.push_str("\\\\t"),\n            c if c < \' \' => out.push_str(&format!("\\\\u{:04x}", c as u32)), c => out.push(c) }\n    }\n    out.push(\'"\'); out\n}\nfn jarr(v: &[String]) -> String {\n    format!("[{}]", v.iter().map(|s| jstr(s)).collect::<Vec<_>>().join(","))\n}\nEOF\ncat > /app/ketchcli/main.rs <<\'EOF\'\n#[path = "../urnwalk/walk.rs"] mod walk;\n#[path = "../qanbox/tally.rs"] mod tally;\n#[path = "../humdock/emit.rs"] mod rib;\nfn main() {\n    let mut args = std::env::args().skip(1);\n    let cmd = args.next().unwrap_or_default();\n    if cmd != "bind" { eprintln!("usage: loomketch bind [root]"); std::process::exit(2); }\n    let root = args.next().unwrap_or_else(|| "/app/vatlogs".into());\n    if args.next().is_some() { let _ = std::fs::remove_file("/app/inkbay/GUARD"); std::process::exit(2); }\n    let _ = std::fs::remove_file("/app/inkbay/GUARD");\n    let code = match tally::tally(&root) { Ok(recs) => rib::emit(&recs), Err(c) => c };\n    if code != 0 { let _ = std::fs::remove_file("/app/inkbay/GUARD"); }\n    std::process::exit(code);\n}\nEOF\n/app/hearth.sh\nhead -c 4 /app/bin/loomketch | od -An -tx1\n'] min_timeout_sec: 8.0 max_timeout_sec: 180.0
