"SUMMARY:") { summary = true; }\n        let trimmed = line.trim_start();\n        if trimmed.starts_with(\'#\') {\n            let mut words = trimmed.split_whitespace();\n            let number = words.next().unwrap_or("");\n            if number.len() < 2 || !number[1..].bytes().all(|b| b.is_ascii_digit()) {\n                return Err(3);\n            }\n            let pos = trimmed.find(" in ").ok_or(3)?;\n            let sym = trimmed[pos + 4..].split_whitespace().next().unwrap_or("");\n            if sym.is_empty() { return Err(3); }\n            if !is_runtime(sym) { frames.push(fold_hex(sym)); }\n        }\n    }\n    if !summary || frames.is_empty() { return Err(3); }\n    Ok((kind.ok_or(3)?, frames))\n}\n\nfn is_runtime(s: &str) -> bool {\n    s.starts_with("__asan") || s.starts_with("__interceptor") || s.starts_with("__hwasan")\n}\n\nfn fold_hex(s: &str) -> String {\n    let bytes = s.as_bytes();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < bytes.len() {\n        if i + 2 <= bytes.len() && bytes[i] == b\'0\' && bytes[i + 1] == b\'x\' {\n            let mut j = i + 2;\n            while j < bytes.len() && bytes[j].is_ascii_hexdigit() { j += 1; }\n            if j > i + 2 { out.push_str("<hex>"); i = j; continue; }\n        }\n        if bytes[i].is_ascii_hexdigit() {\n            let mut j = i;\n            let mut digit = false;\n            while j < bytes.len() && bytes[j].is_ascii_hexdigit() {\n                digit |= bytes[j].is_ascii_digit();\n                j += 1;\n            }\n            if j - i >= 4 && digit {\n                out.push_str("<hex>");\n                i = j;\n                continue;\n            }\n        }\n        out.push(bytes[i] as char);\n        i += 1;\n    }\n    out\n}\nEOF\ncat > /app/qanbox/tally.rs <<\'EOF\'\n#[path = "../treyfun/clip.rs"]\nmod clip;\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<