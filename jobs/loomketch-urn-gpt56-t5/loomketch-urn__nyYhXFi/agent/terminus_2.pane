===== /app/treyfun/clip.rs =====
     1	pub fn clip(a: &[String]) -> Vec<String> {
     2	    a.iter()
     3	        .filter(|s| !s.starts_with("__asan::") && !s.starts_with("__asan_"))
     4	        .cloned()
     5	        .collect()
     6	}
     7	
     8	pub fn take(text: &str) -> Result<(String, Vec<String>), i32> {
     9	    if text.trim().is_empty() {
    10	        return Ok((String::new(), Vec::new()));
    11	    }
    12	    let mut kind = String::new();
    13	    let mut frames = Vec::new();
    14	    for line in text.lines() {
    15	        if let Some(rest) = line.split("ERROR:").nth(1) {
    16	            let rest = rest.trim();
    17	            let after = if let Some(x) = rest.split("AddressSanitizer:").nth(1) {
    18	                x.trim()
    19	            } else {
    20	                rest
    21	            };
    22	            kind = after.split(" on ").next().unwrap_or(after).trim().to_string();
    23	        }
    24	        if let Some(idx) = line.find('#') {
    25	            let chunk = &line[idx..];
    26	            if let Some(after) = chunk.split(" in ").nth(1) {
    27	                let sym = after.split_whitespace().next().unwrap_or("").to_string();
    28	                if !sym.is_empty() {
    29	                    frames.push(sym);
    30	                }
    31	            }
    32	        }
    33	    }
    34	    Ok((kind, frames))
    35	}
