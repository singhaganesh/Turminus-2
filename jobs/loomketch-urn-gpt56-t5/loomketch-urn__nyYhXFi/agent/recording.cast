[131.517104, "i", "python3 - <<'PY'\nimport json, pathlib\np=pathlib.Path('/app/inkbay')\ndata=json.loads((p/'bound.json').read_text())\nrows=(p/'desk.tsv').read_text().splitlines()\nassert rows[0]=='issue\\tkind\\tbody'\nby_issue={r['issue']:r for r in data['findings']}\nassert sorted(by_issue)==list(range(1,len(by_issue)+1))\nfor line in rows[1:]:\n    issue,kind,body=line.split('\\t')\n    r=by_issue[int(issue)]\n    assert (kind,body)==(r['kind'],r['body'])\n    assert body==' | '.join(r['frames'])\n    assert not any(f.startswith(('__asan','__interceptor','__hwasan')) for f in r['frames'])\nassert (p/'GUARD').read_text()=='ok'\nprint('records:',len(by_issue),'cross-file consistency: ok')\nPY\ncp /app/inkbay/bound.json /tmp/final.bound; cp /app/inkbay/desk.tsv /tmp/final.desk; KETCH_ALPHA=1 /app/bin/loomketch bind; cmp /tmp/final.bound /app/inkbay/bound.json && cmp /tmp/final.desk /app/inkbay/desk.tsv; echo alpha_stability=$?; test -x /app/bin/loomketch; echo executable=$?; head -c4 /app/bin/loomketch | od -An -tx1; printf 'GUARD='; cat /app/inkbay/GUARD; echo\n"]
