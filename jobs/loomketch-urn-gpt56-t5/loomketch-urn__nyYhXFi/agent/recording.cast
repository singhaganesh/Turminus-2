[97.625034, "o", "            let number = words.next().unwrap_or(\"\");\r\n\u001b[?2004l\r"]
[97.625089, "o", "\u001b[?2004h> "]
[97.625487, "o", "            if number.len() < 2 || !number[1..].bytes().all(|b| b.is_ascii_digit()) {\r\n\u001b[?2004l\r"]
[97.625586, "o", "\u001b[?2004h> "]
[97.625664, "o", "                return Err(3);\r\n\u001b[?2004l\r"]
[97.625693, "o", "\u001b[?2004h> "]
[97.625753, "o", "            }\r\n\u001b[?2004l\r"]
[97.625843, "o", "\u001b[?2004h> "]
[97.626065, "o", "            let pos = trimmed.find(\" in \").ok_or(3)?;\r\n\u001b[?2004l\r"]
[97.626139, "o", "\u001b[?2004h> "]
[97.626469, "o", "            let sym = trimmed[pos + 4..].split_whitespace().next().unwrap_or(\"\");\r\n\u001b[?2004l\r"]
[97.626653, "o", "\u001b[?2004h> "]
[97.626764, "o", "            if sym.is_empty() { return Err(3); }\r\n\u001b[?2004l\r"]
[97.62689, "o", "\u001b[?2004h> "]
[97.627179, "o", "            if !is_runtime(sym) { frames.push(fold_hex(sym)); }\r\n\u001b[?2004l\r"]
[97.627592, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.627645, "o", "    }\r\n\u001b[?2004l\ret\u001b[?2004h"]
[97.627665, "o", "> "]
[97.627994, "o", "    if !summary || frames.is_empty() { return Err(3); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.62822, "o", "    Ok((kind.ok_or(3)?, frames))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.628253, "o", "\u001b[?2004h> "]
[97.628552, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> fn is_runtime(s: &str) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.628657, "o", "> "]
[97.628941, "o", "    s.starts_with(\"__asan\") || s.starts_with(\"__interceptor\") || s.starts_with(\"__hwasan\")\r\n\u001b[?2004l\r"]
[97.629026, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.629114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.629231, "o", "fn fold_hex(s: &str) -> String {\r\n\u001b[?2004l\r"]
[97.629317, "o", "\u001b[?2004h> "]
[97.629707, "o", "    let bytes = s.as_bytes();\r\n\u001b[?2004l\r"]
[97.629798, "o", "\u001b[?2004h> "]
[97.629889, "o", "    let mut out = String::new();\r\n\u001b[?2004l\r"]
[97.629982, "o", "\u001b[?2004h"]
[97.630076, "o", ">     let mut i = 0;\r\n\u001b[?2004l\r"]
[97.630179, "o", "\u001b[?2004h> "]
[97.630266, "o", "    while i < bytes.len() {\r\n\u001b[?2004l\rGUARD\");\r\n\u001b[?2004h> "]
[97.630551, "o", "        if i + 2 <= bytes.len() && bytes[i] == b'0' && bytes[i + 1] == b'x' {\r\n\u001b[?2004l\r"]
[97.630642, "o", "\u001b[?2004h> "]
[97.630731, "o", "            let mut j = i + 2;\r\n\u001b[?2004l\r"]
[97.630802, "o", "\u001b[?2004h> "]
[97.631147, "o", "            while j < bytes.len() && bytes[j].is_ascii_hexdigit() { j += 1; }\r\n\u001b[?2004l\r"]
[97.631259, "o", "\u001b[?2004h"]
[97.631295, "o", "> "]
[97.631493, "o", "            if j > i + 2 { out.push_str(\"<hex>\"); i = j; continue; }\r\n\u001b[?2004l\r"]
[97.631571, "o", "\u001b[?2004h> "]
[97.631601, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.631775, "o", "        if bytes[i].is_ascii_hexdigit() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.631884, "o", "            let mut j = i;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.63198, "o", "            let mut digit = false;\r\n\u001b[?2004l\r"]
[97.632053, "o", "\u001b[?2004h> "]
[97.632169, "o", "            while j < bytes.len() && bytes[j].is_ascii_hexdigit() {\r\n\u001b[?2004l\r"]
[97.632215, "o", "\u001b[?2004h> "]
[97.632328, "o", "                digit |= bytes[j].is_ascii_digit();\r\n\u001b[?2004l\r"]
[97.632391, "o", "\u001b[?2004h> "]
[97.63246, "o", "                j += 1;\r\n\u001b[?2004l\r"]
[97.632515, "o", "\u001b[?2004h> "]
[97.632568, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.63264, "o", "            if j - i >= 4 && digit {\r\n\u001b[?2004l\r"]
[97.632684, "o", "\u001b[?2004h> "]
[97.632795, "o", "                out.push_str(\"<hex>\");\r\n\u001b[?2004l\r"]
[97.632839, "o", "\u001b[?2004h> "]
[97.63289, "o", "                i = j;\r\n\u001b[?2004l\r"]
[97.632937, "o", "\u001b[?2004h> "]
[97.632986, "o", "                continue;\r\n\u001b[?2004l\r"]
[97.633051, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[97.633127, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[97.633183, "o", "\u001b[?2004h> "]
[97.633259, "o", "        out.push(bytes[i] as char);\r\n\u001b[?2004l\r"]
[97.633308, "o", "\u001b[?2004h> "]
[97.633386, "o", "        i += 1;\r\n\u001b[?2004l\r"]
[97.633519, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[97.633706, "o", "\u001b[?2004h> "]
[97.633761, "o", "    out\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.633807, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.633851, "o", "EOF\r\n\u001b[?2004l\r"]
[97.635173, "o", "\u001b[?2004hroot@673b5dedbdb5:/app# "]
[97.635299, "o", "cat > /app/qanbox/tally.rs <<'EOF'\r\n\u001b[?2004l\r"]
[97.635358, "o", "\u001b[?2004h> "]
[97.635483, "o", "#[path = \"../treyfun/clip.rs\"]\r\n\u001b[?2004l\r"]
[97.635542, "o", "\u001b[?2004h> mod clip;\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.635588, "o", "> "]
[97.635698, "o", "use std::collections::BTreeMap;\r\n\u001b[?2004l\r"]
[97.635751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.635793, "o", "\u001b[?2004h> "]
[97.635835, "o", "#[derive(Clone)]\r\n\u001b[?2004l\r"]
[97.635873, "o", "\u001b[?2004h> "]
[97.63593, "o", "pub struct Rec {\r\n\u001b[?2004l\r"]
[97.635966, "o", "\u001b[?2004h> "]
[97.636028, "o", "    pub issue: i32,\r\n\u001b[?2004l\r"]
[97.636071, "o", "\u001b[?2004h> "]
[97.636136, "o", "    pub kind: String,\r\n\u001b[?2004l\r"]
[97.636175, "o", "\u001b[?2004h> "]
[97.636263, "o", "    pub frames: Vec<String>,\r\n\u001b[?2004l\r"]
[97.636303, "o", "\u001b[?2004h> "]
[97.636354, "o", "    pub body: String,\r\n\u001b[?2004l\r"]
[97.636408, "o", "\u001b[?2004h> }\r\n"]
[97.636456, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.636494, "o", "\u001b[?2004h> "]
[97.636633, "o", "pub fn tally(root: &str) -> Result<Vec<Rec>, i32> {\r\n\u001b[?2004l\r"]
[97.636671, "o", "\u001b[?2004h> "]
[97.636782, "o", "    let paths = crate::walk::gather(root)?;\r\n\u001b[?2004l\r"]
[97.636817, "o", "\u001b[?2004h> "]
[97.636976, "o", "    let mut unique: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\r\n\u001b[?2004l\r"]
[97.637011, "o", "\u001b[?2004h> "]
[97.637077, "o", "    for path in paths {\r\n\u001b[?2004l\r"]
[97.637151, "o", "\u001b[?2004h> "]
[97.637294, "o", "        let text = std::fs::read_to_string(path).map_err(|_| 3)?;\r\n\u001b[?2004l\r"]
[97.637355, "o", "\u001b[?2004h> "]
[97.637459, "o", "        let (kind, frames) = clip::take(&text)?;\r\n\u001b[?2004l\r"]
[97.637516, "o", "\u001b[?2004h> "]
[97.637607, "o", "        let body = frames.join(\" | \");\r\n\u001b[?2004l\r"]
[97.637663, "o", "\u001b[?2004h> "]
[97.637834, "o", "        let rec = Rec { issue: 0, kind, frames: frames.clone(), body };\r\n\u001b[?2004l\r"]
[97.637893, "o", "\u001b[?2004h> "]
[97.637961, "o", "        match unique.get(&frames) {\r\n\u001b[?2004l\r"]
[97.638014, "o", "\u001b[?2004h> "]
[97.638178, "o", "            Some(old) if old.kind != rec.kind => return Err(3),\r\n\u001b[?2004l\r"]
[97.638233, "o", "\u001b[?2004h> "]
[97.638281, "o", "            Some(_) => {},\r\n\u001b[?2004l\r"]
[97.638339, "o", "\u001b[?2004h> "]
[97.638478, "o", "            None => { unique.insert(frames, rec); }\r\n\u001b[?2004l\r"]
[97.638531, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[97.63859, "o", "\u001b[?2004h"]
[97.638632, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.638781, "o", "    let mut recs: Vec<Rec> = unique.into_values().collect();\r\n\u001b[?2004l\r"]
[97.638832, "o", "\u001b[?2004h"]
[97.638883, "o", "> "]
[97.639013, "o", "    for (i, rec) in recs.iter_mut().enumerate() { rec.issue = i as i32 + 1; }\r\n\u001b[?2004l\r"]
[97.639065, "o", "\u001b[?2004h"]
[97.639122, "o", ">     Ok(recs)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[97.639201, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[97.639242, "o", "EOF\r\n\u001b[?2004l\r"]
[97.640406, "o", "\u001b[?2004hroot@673b5dedbdb5:/app# "]
[97.640511, "o", "cat > /app/humdock/emit.rs <<'EOF'\r\n\u001b[?2004l\r"]
[97.640567, "o", "\u001b[?2004h> "]
[97.640627, "o", "use crate::tally::Rec;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.640688, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.640743, "o", "pub fn emit(rows: &[Rec]) -> i32 {\r\n\u001b[?2004l\r"]
[97.640798, "o", "\u001b[?2004h> "]
[97.640923, "o", "    if std::fs::create_dir_all(\"/app/inkbay\").is_err() { return 1; }\r\n\u001b[?2004l\r"]
[97.640978, "o", "\u001b[?2004h> "]
[97.641034, "o", "    let mut inner = String::new();\r\n\u001b[?2004l\r"]
[97.641087, "o", "\u001b[?2004h> "]
[97.641184, "o", "    let mut desk = String::from(\"issue\\tkind\\tbody\\n\");\r\n\u001b[?2004l\r"]
[97.64124, "o", "\u001b[?2004h> "]
[97.641311, "o", "    for (i, r) in rows.iter().enumerate() {\r\n\u001b[?2004l\r"]
[97.641369, "o", "\u001b[?2004h> "]
[97.641443, "o", "        if i != 0 { inner.push(','); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.641496, "o", "> "]
[97.641652, "o", "        inner.push_str(&format!(\"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\r\n\u001b[?2004l\r"]
[97.641709, "o", "\u001b[?2004h> "]
[97.641831, "o", "            r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body)));\r\n\u001b[?2004l\r"]
[97.641887, "o", "\u001b[?2004h> "]
[97.642021, "o", "        desk.push_str(&format!(\"{}\\t{}\\t{}\\n\", r.issue, r.kind, r.body));\r\n\u001b[?2004l\r"]
[97.64208, "o", "\u001b[?2004h"]
[97.64215, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.642215, "o", "> "]
[97.642439, "o", "    let tpl = match std::fs::read_to_string(\"/app/tplbay/bound.tpl\") { Ok(x) => x, Err(_) => return 1 };\r\n\u001b[?2004l\r"]
[97.642503, "o", "\u001b[?2004h> "]
[97.642582, "o", "    if !tpl.contains(\"__ROWS__\") { return 1; }\r\n\u001b[?2004l\r"]
[97.642641, "o", "\u001b[?2004h> "]
[97.642782, "o", "    let bound = tpl.replace(\"__ROWS__\", &inner);\r\n\u001b[?2004l\r"]
[97.642888, "o", "\u001b[?2004h> "]
[97.642968, "o", "    let bp = \"/app/inkbay/.bound.json.tmp\";\r\n\u001b[?2004l\r"]
[97.643033, "o", "\u001b[?2004h> "]
[97.643156, "o", "    let dp = \"/app/inkbay/.desk.tsv.tmp\";\r\n\u001b[?2004l\r"]
[97.643225, "o", "\u001b[?2004h> "]
[97.643461, "o", "    if std::fs::write(bp, bound).is_err() || std::fs::write(dp, desk).is_err()\r\n\u001b[?2004l\r"]
[97.643657, "o", "\u001b[?2004h> "]
[97.643755, "o", "        || std::fs::rename(bp, \"/app/inkbay/bound.json\").is_err()\r\n\u001b[?2004l\r"]
[97.643786, "o", "\u001b[?2004h"]
[97.64381, "o", "> "]
[97.644026, "o", "        || std::fs::rename(dp, \"/app/inkbay/desk.tsv\").is_err() {\r\n\u001b[?2004l\r"]
[97.644148, "o", "\u001b[?2004h> "]
[97.644352, "o", "        let _ = std::fs::remove_file(bp); let _ = std::fs::remove_file(dp); return 1;\r\n\u001b[?2004l\r"]
[97.644491, "o", "\u001b[?2004h> "]
[97.644595, "o", "    }\r\n\u001b[?2004l\r"]
[97.644718, "o", "\u001b[?2004h> "]
[97.644833, "o", "    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.644915, "o", "    0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.644996, "o", "\u001b[?2004h> "]
[97.645082, "o", "fn jstr(s: &str) -> String {\r\n\u001b[?2004l\r"]
[97.64537, "o", "\u001b[?2004h>     let mut out = String::from(\"\\\"\");\r\n\u001b[?2004l\r\u001b[?2004h>     for c in s.chars() {\r\n\u001b[?2004l\r"]
[97.645472, "o", "\u001b[?2004h> "]
[97.645651, "o", "        match c { '\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\r\n\u001b[?2004l\r"]
[97.645725, "o", "\u001b[?2004h"]
[97.645784, "o", "> "]
[97.64599, "o", "            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r"]
[97.646071, "o", "\u001b[?2004h> "]
[97.646307, "o", "            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)), c => out.push(c) }\r\n\u001b[?2004l\r"]
[97.646411, "o", "\u001b[?2004h"]
[97.646511, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     out.push('\"'); out\r\n\u001b[?2004l\r"]
[97.646585, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.646682, "o", "fn jarr(v: &[String]) -> String {\r\n\u001b[?2004l\r"]
[97.646768, "o", "\u001b[?2004h> "]
[97.64693, "o", "    format!(\"[{}]\", v.iter().map(|s| jstr(s)).collect::<Vec<_>>().join(\",\"))\r\n\u001b[?2004l\r"]
[97.647001, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.647057, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[97.650624, "o", "\u001b[?2004hroot@673b5dedbdb5:/app# "]
[97.650756, "o", "cat > /app/ketchcli/main.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.650829, "o", "#[path = \"../urnwalk/walk.rs\"] mod walk;\r\n\u001b[?2004l\r"]
[97.650904, "o", "\u001b[?2004h> "]
[97.650969, "o", "#[path = \"../qanbox/tally.rs\"] mod tally;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.651045, "o", "#[path = \"../humdock/emit.rs\"] mod rib;\r\n\u001b[?2004l\r"]
[97.651067, "o", "\u001b[?2004h> "]
[97.651185, "o", "fn main() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.651271, "o", "    let mut args = std::env::args().skip(1);\r\n\u001b[?2004l\r"]
[97.65133, "o", "\u001b[?2004h"]
[97.651387, "o", "> "]
[97.65145, "o", "    let cmd = args.next().unwrap_or_default();\r\n\u001b[?2004l\r"]
[97.651509, "o", "\u001b[?2004h"]
[97.651561, "o", "> "]
[97.65171, "o", "    if cmd != \"bind\" { eprintln!(\"usage: loomketch bind [root]\"); std::process::exit(2); }\r\n\u001b[?2004l\r"]
[97.651764, "o", "\u001b[?2004h> "]
[97.651907, "o", "    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".into());\r\n\u001b[?2004l\r"]
[97.651962, "o", "\u001b[?2004h"]
[97.652011, "o", "> "]
[97.652199, "o", "    if args.next().is_some() { let _ = std::fs::remove_file(\"/app/inkbay/GUARD\"); std::process::exit(2); }\r\n\u001b[?2004l\r"]
[97.652254, "o", "\u001b[?2004h> "]
[97.652369, "o", "    let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\r\n\u001b[?2004l\r"]
[97.652454, "o", "\u001b[?2004h> "]
[97.652634, "o", "    let code = match tally::tally(&root) { Ok(recs) => rib::emit(&recs), Err(c) => c };\r\n\u001b[?2004l\r"]
[97.652724, "o", "\u001b[?2004h> "]
[97.652859, "o", "    if code != 0 { let _ = std::fs::remove_file(\"/app/inkbay/GUARD\"); }\r\n\u001b[?2004l\r"]
[97.652921, "o", "\u001b[?2004h"]
[97.652971, "o", "> "]
[97.653026, "o", "    std::process::exit(code);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.653077, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.653133, "o", "EOF\r\n\u001b[?2004l\r"]
[97.654384, "o", "\u001b[?2004hroot@673b5dedbdb5:/app# "]
[97.654501, "o", "/app/hearth.sh\r\n\u001b[?2004l\r"]
[101.306036, "o", "\u001b[?2004hroot@673b5dedbdb5:/app# "]
[101.306191, "o", "head -c 4 /app/bin/loomketch | od -An -tx1\r\n\u001b[?2004l\r"]
