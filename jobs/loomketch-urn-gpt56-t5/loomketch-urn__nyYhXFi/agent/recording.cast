[97.608804, "i", "cat > /app/urnwalk/walk.rs <<'EOF'\nuse std::path::{Path, PathBuf};\n\npub fn gather(a: &str) -> Result<Vec<String>, i32> {\n    let allowed = std::fs::canonicalize(\"/app/vatlogs\").map_err(|_| 2)?;\n    let root = std::fs::canonicalize(a).map_err(|_| 2)?;\n    if !root.starts_with(&allowed) || !root.is_dir() {\n        return Err(2);\n    }\n    let mut paths = Vec::new();\n    visit(&root, &allowed, &mut paths)?;\n    paths.sort();\n    if paths.is_empty() { return Err(2); }\n    Ok(paths.into_iter().map(|p| p.to_string_lossy().into_owned()).collect())\n}\n\nfn visit(dir: &Path, allowed: &Path, out: &mut Vec<PathBuf>) -> Result<(), i32> {\n    let rd = std::fs::read_dir(dir).map_err(|_| 2)?;\n    for entry in rd {\n        let entry = entry.map_err(|_| 2)?;\n        let raw = entry.path();\n        let path = std::fs::canonicalize(&raw).map_err(|_| 2)?;\n        if !path.starts_with(allowed) { return Err(2); }\n        let meta = std::fs::metadata(&path).map_err(|_| 2)?;\n        if meta.is_dir() {\n            visit(&path, allowed, out)?;\n        } else if meta.is_file() {\n            out.push(path);\n        } else {\n            return Err(2);\n        }\n    }\n    Ok(())\n}\nEOF\ncat > /app/treyfun/clip.rs <<'EOF'\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() { return Err(3); }\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut summary = false;\n    for line in text.lines() {\n        if line.contains(\"ERROR:\") {\n            if kind.is_some() { return Err(3); }\n            let rest = line.split_once(\"ERROR:\").map(|x| x.1).unwrap_or(\"\").trim();\n            let after = rest.strip_prefix(\"AddressSanitizer:\").unwrap_or(rest).trim();\n            let value = after.split(\" on \").next().unwrap_or(\"\").trim();\n            if value.is_empty() { return Err(3); }\n            kind = Some(value.to_string());\n        }\n        if line.trim_start().starts_with(\"SUMMARY:\") { summary = true; }\n        let trimmed = line.trim_start();\n        if trimmed.starts_with('#') {\n            let mut words = trimmed.split_whitespace();\n            let number = words.next().unwrap_or(\"\");\n            if number.len() < 2 || !number[1..].bytes().all(|b| b.is_ascii_digit()) {\n                return Err(3);\n            }\n            let pos = trimmed.find(\" in \").ok_or(3)?;\n            let sym = trimmed[pos + 4..].split_whitespace().next().unwrap_or(\"\");\n            if sym.is_empty() { return Err(3); }\n            if !is_runtime(sym) { frames.push(fold_hex(sym)); }\n        }\n    }\n    if !summary || frames.is_empty() { return Err(3); }\n    Ok((kind.ok_or(3)?, frames))\n}\n\nfn is_runtime(s: &str) -> bool {\n    s.starts_with(\"__asan\") || s.starts_with(\"__interceptor\") || s.starts_with(\"__hwasan\")\n}\n\nfn fold_hex(s: &str) -> String {\n    let bytes = s.as_bytes();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < bytes.len() {\n        if i + 2 <= bytes.len() && bytes[i] == b'0' && bytes[i + 1] == b'x' {\n            let mut j = i + 2;\n            while j < bytes.len() && bytes[j].is_ascii_hexdigit() { j += 1; }\n            if j > i + 2 { out.push_str(\"<hex>\"); i = j; continue; }\n        }\n        if bytes[i].is_ascii_hexdigit() {\n            let mut j = i;\n            let mut digit = false;\n            while j < bytes.len() && bytes[j].is_ascii_hexdigit() {\n                digit |= bytes[j].is_ascii_digit();\n                j += 1;\n            }\n            if j - i >= 4 && digit {\n                out.push_str(\"<hex>\");\n                i = j;\n                continue;\n            }\n        }\n        out.push(bytes[i] as char);\n        i += 1;\n    }\n    out\n}\nEOF\ncat > /app/qanbox/tally.rs <<'EOF'\n#[path = \"../treyfun/clip.rs\"]\nmod clip;\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<String>,\n    pub body: String,\n}\n\npub fn tally(root: &str) -> Result<Vec<Rec>, i32> {\n    let paths = crate::walk::gather(root)?;\n    let mut unique: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\n    for path in paths {\n        let t"]
[97.608887, "i", "ext = std::fs::read_to_string(path).map_err(|_| 3)?;\n        let (kind, frames) = clip::take(&text)?;\n        let body = frames.join(\" | \");\n        let rec = Rec { issue: 0, kind, frames: frames.clone(), body };\n        match unique.get(&frames) {\n            Some(old) if old.kind != rec.kind => return Err(3),\n            Some(_) => {},\n            None => { unique.insert(frames, rec); }\n        }\n    }\n    let mut recs: Vec<Rec> = unique.into_values().collect();\n    for (i, rec) in recs.iter_mut().enumerate() { rec.issue = i as i32 + 1; }\n    Ok(recs)\n}\nEOF\ncat > /app/humdock/emit.rs <<'EOF'\nuse crate::tally::Rec;\n\npub fn emit(rows: &[Rec]) -> i32 {\n    if std::fs::create_dir_all(\"/app/inkbay\").is_err() { return 1; }\n    let mut inner = String::new();\n    let mut desk = String::from(\"issue\\tkind\\tbody\\n\");\n    for (i, r) in rows.iter().enumerate() {\n        if i != 0 { inner.push(','); }\n        inner.push_str(&format!(\"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\n            r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body)));\n        desk.push_str(&format!(\"{}\\t{}\\t{}\\n\", r.issue, r.kind, r.body));\n    }\n    let tpl = match std::fs::read_to_string(\"/app/tplbay/bound.tpl\") { Ok(x) => x, Err(_) => return 1 };\n    if !tpl.contains(\"__ROWS__\") { return 1; }\n    let bound = tpl.replace(\"__ROWS__\", &inner);\n    let bp = \"/app/inkbay/.bound.json.tmp\";\n    let dp = \"/app/inkbay/.desk.tsv.tmp\";\n    if std::fs::write(bp, bound).is_err() || std::fs::write(dp, desk).is_err()\n        || std::fs::rename(bp, \"/app/inkbay/bound.json\").is_err()\n        || std::fs::rename(dp, \"/app/inkbay/desk.tsv\").is_err() {\n        let _ = std::fs::remove_file(bp); let _ = std::fs::remove_file(dp); return 1;\n    }\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() { return 1; }\n    0\n}\nfn jstr(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c { '\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)), c => out.push(c) }\n    }\n    out.push('\"'); out\n}\nfn jarr(v: &[String]) -> String {\n    format!(\"[{}]\", v.iter().map(|s| jstr(s)).collect::<Vec<_>>().join(\",\"))\n}\nEOF\ncat > /app/ketchcli/main.rs <<'EOF'\n#[path = \"../urnwalk/walk.rs\"] mod walk;\n#[path = \"../qanbox/tally.rs\"] mod tally;\n#[path = \"../humdock/emit.rs\"] mod rib;\nfn main() {\n    let mut args = std::env::args().skip(1);\n    let cmd = args.next().unwrap_or_default();\n    if cmd != \"bind\" { eprintln!(\"usage: loomketch bind [root]\"); std::process::exit(2); }\n    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".into());\n    if args.next().is_some() { let _ = std::fs::remove_file(\"/app/inkbay/GUARD\"); std::process::exit(2); }\n    let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\n    let code = match tally::tally(&root) { Ok(recs) => rib::emit(&recs), Err(c) => c };\n    if code != 0 { let _ = std::fs::remove_file(\"/app/inkbay/GUARD\"); }\n    std::process::exit(code);\n}\nEOF\n/app/hearth.sh\nhead -c 4 /app/bin/loomketch | od -An -tx1\n"]
