4..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let body = off.checked_add(512).ok_or(1)?;\n        let next = (body as u64).checked_add(padded).ok_or(1)?;\n        if next > raw.len() as u64 { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: body as u64, flag: blk[156] });\n        off = usize::try_from(next).map_err(|_| 1)?;\n    }\n    if !saw { return Err(1); }\n    Ok(rows)\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let n = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<\'RS\'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b\'0\' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b"SILT1");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    let target = std::path::Path::new(b);\n    if let Some(parent) = target.parent() { if std::fs::create_dir_all(parent).is_err() { return 1; } }\n    let tmp = target.with_extension(format!("tmp.{}", std::process::id()));\n    if std::fs::write(&tmp, out).is_err() { return 1; }\n    if std::fs::rename(&tmp, target).is_err() { let _ = std::fs::remove_file(tmp); return 1; }\n    0\n}\nRS\ncat > /app/siltcli