[112.830086, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef make_background(frames):\n    \"\"\"A moving object occupies a pixel briefly, so the temporal median is background.\"\"\"\n    return np.median(np.asarray(frames, dtype=np.uint8), axis=0).astype(np.uint8)\n\n\ndef find_bodies(frame, background):\n    # Maximum channel difference also finds strongly coloured, equal-luminance bodies.\n    delta = cv2.absdiff(frame, background)\n    mask = (np.max(delta, axis=2) >= 24).astype(np.uint8) * 255\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n    n, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\n    out = []\n    for k in range(1, n):\n        x, y, w, h, area = map(int, stats[k])\n        if area < 24 or w < 3 or h < 3:\n            continue\n        pix = frame[labels == k]\n        colour = np.median(pix, axis=0) if len(pix) else np.zeros(3)\n        out.append({\"x\": float(centers[k, 0]), \"y\": float(centers[k, 1]),\n                    \"box\": (x, y, w, h), \"area\": area,\n                    \"colour\": np.asarray(colour, dtype=float)})\n    return out\nPY\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport math\nimport numpy as np\n\n\nclass Track:\n    def __init__(self, det, frame_no):\n        self.x, self.y = det[\"x\"], det[\"y\"]\n        self.vx = self.vy = 0.0\n        self.last_seen = frame_no\n        self.hits = 1\n        self.missed = 0\n        self.above = self.y < 70.0\n        self.counted = False\n        self.colour = det[\"colour\"].copy()\n\n    def predicted(self):\n        return self.x + self.vx, self.y + self.vy\n\n    def observe(self, det, frame_no):\n        dt = max(1, frame_no - self.last_seen)\n        ox, oy = self.x, self.y\n        nvx, nvy = (det[\"x\"] - ox) / dt, (det[\"y\"] - oy) / dt\n        if self.hits > 1:\n            self.vx = .55 * self.vx + .45 * nvx\n            self.vy = .55 * self.vy + .45 * nvy\n        else:\n            self.vx, self.vy = nvx, nvy\n        self.x, self.y = det[\"x\"], det[\"y\"]\n        self.last_seen, self.missed = frame_no, 0\n        self.hits += 1\n        self.colour = .8 * self.colour + .2 * det[\"colour\"]\n        if self.y < 68:\n            self.above = True\n        if self.above and not self.counted and self.y > 72 and self.vy > -0.5:\n            self.counted = True\n\n    def coast(self):\n        self.x += self.vx\n        self.y += self.vy\n        self.missed += 1\n\n\ndef _distance(track, det):\n    px, py = track.predicted()\n    spatial = math.hypot(px - det[\"x\"], py - det[\"y\"])\n    # Colour is only a tie breaker; similarly coloured bodies remain separable by motion.\n    colour = float(np.linalg.norm(track.colour - det[\"colour\"]))\n    return spatial + min(8.0, colour * .035), spatial\n\n\ndef count_crossings(detections):\n    tracks = []\n    areas = [d[\"area\"] for row in detections for d in row]\n    base_area = float(np.percentile(areas, 35)) if areas else 100.0\n\n    for frame_no, dets in enumerate(detections):\n        active = [i for i, t in enumerate(tracks) if t.missed <= 18]\n        assigned_t, assigned_d = set(), set()\n\n        # A broad component near several predictions is an overlap. Coast all but the\n        # ordinary one-to-one assignment; separated observations reconnect afterward.\n        merged_tracks = set()\n        for j, d in enumerate(dets):\n            x, y, w, h = d[\"box\"]\n            near = []\n            for i in active:\n                px, py = tracks[i].predicted()\n                if x - 10 <= px <= x + w + 10 and y - 10 <= py <= y + h + 10:\n                    near.append(i)\n            if len(near) >= 2 and (d[\"area\"] > 1.28 * base_area or w > 26 or h > 26):\n                merged_tracks.update(near)\n                assigned_d.add(j)\n                # Mark the tracks present but retain their independent velocity paths.\n                for i in near:\n                    tracks[i].coast()\n                    assigned_t.add(i)\n\n        pairs = []\n        for i in active:\n            if i in assigned"]
[112.830233, "i", "_t:\n                continue\n            for j, d in enumerate(dets):\n                if j in assigned_d:\n                    continue\n                score, spatial = _distance(tracks[i], d)\n                # Allow a wider gate after a few hidden frames.\n                gate = 13.0 + min(20.0, tracks[i].missed * 3.0)\n                if spatial <= gate:\n                    pairs.append((score, i, j))\n        for score, i, j in sorted(pairs):\n            if i in assigned_t or j in assigned_d:\n                continue\n            tracks[i].observe(dets[j], frame_no)\n            assigned_t.add(i)\n            assigned_d.add(j)\n\n        for i in active:\n            if i not in assigned_t:\n                tracks[i].coast()\n        for j, d in enumerate(dets):\n            if j not in assigned_d:\n                tracks.append(Track(d, frame_no))\n\n    return sum(1 for t in tracks if t.counted and t.hits >= 2)\n\n\ndef fold_gate(n: int) -> int:\n    return int(n)\nPY\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport toml\nfrom pathlib import Path\n\nfrom blot import find_bodies, make_background\nfrom tether import count_crossings, fold_gate\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('unexpected frame geometry')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('clip contains no readable frames')\n    background = make_background(frames)\n    detections = [find_bodies(frame, background) for frame in frames]\n    return fold_gate(count_crossings(detections))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    tmp = SHEET.with_suffix('.tmp')\n    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    tmp.replace(SHEET)\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    if SHEET.exists():\n        SHEET.unlink()\n    if len(sys.argv) != 2:\n        return 2\n    try:\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n    except Exception as exc:\n        print(f'mill: {exc}', file=sys.stderr)\n        if SHEET.exists():\n            SHEET.unlink()\n        return 1\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\nbash /app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; printf 'status=%s sheet=' \"$?\"; test -e /app/inkwell/sheet.toml && echo present || echo absent\n"]
