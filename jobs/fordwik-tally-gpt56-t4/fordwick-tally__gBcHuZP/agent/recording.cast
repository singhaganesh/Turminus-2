[16.921891, "i", "printf '%s\\n' '--- SPAN.txt ---'; cat /app/slipfold/SPAN.txt; printf '%s\\n' '--- KILN.txt ---'; cat /app/kiln/KILN.txt; printf '%s\\n' '--- sheet.toml ---'; cat /app/inkwell/sheet.toml 2>/dev/null || true\n"]
