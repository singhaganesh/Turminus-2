[112.847119, "o", "def count_crossings(detections):\r\n\u001b[?2004l\r"]
[112.847176, "o", "\u001b[?2004h> "]
[112.847237, "o", "    tracks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.84745, "o", "    areas = [d[\"area\"] for row in detections for d in row]\r\n\u001b[?2004l\r"]
[112.847502, "o", "\u001b[?2004h> "]
[112.847643, "o", "    base_area = float(np.percentile(areas, 35)) if areas else 100.0\r\n\u001b[?2004l\r"]
[112.847662, "o", "\u001b[?2004h> "]
[112.847735, "o", "\r\n\u001b[?2004l\r"]
[112.847791, "o", "\u001b[?2004h> "]
[112.847892, "o", "    for frame_no, dets in enumerate(detections):\r\n\u001b[?2004l\r"]
[112.847944, "o", "\u001b[?2004h> "]
[112.848011, "o", "        active = [i for i, t in enumerate(tracks) if t.missed <= 18]\r\n\u001b[?2004l\r"]
[112.848063, "o", "\u001b[?2004h"]
[112.848117, "o", "> "]
[112.848173, "o", "        assigned_t, assigned_d = set(), set()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.848234, "o", "\u001b[?2004h> "]
[112.848402, "o", "        # A broad component near several predictions is an overlap. Coast all but the\r\n\u001b[?2004l\r"]
[112.848453, "o", "\u001b[?2004h> "]
[112.848621, "o", "        # ordinary one-to-one assignment; separated observations reconnect afterward.\r\n\u001b[?2004l\r"]
[112.848675, "o", "\u001b[?2004h> "]
[112.848733, "o", "        merged_tracks = set()\r\n\u001b[?2004l\r"]
[112.848788, "o", "\u001b[?2004h"]
[112.848857, "o", "> "]
[112.848913, "o", "        for j, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[112.848964, "o", "\u001b[?2004h> "]
[112.849024, "o", "            x, y, w, h = d[\"box\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.849079, "o", "            near = []\r\n\u001b[?2004l\r"]
[112.849129, "o", "\u001b[?2004h"]
[112.849181, "o", ">             for i in active:\r\n\u001b[?2004l\r"]
[112.849238, "o", "\u001b[?2004h> "]
[112.849318, "o", "                px, py = tracks[i].predicted()\r\n\u001b[?2004l\r"]
[112.849369, "o", "\u001b[?2004h> "]
[112.849522, "o", "                if x - 10 <= px <= x + w + 10 and y - 10 <= py <= y + h + 10:\r\n\u001b[?2004l\r"]
[112.849572, "o", "\u001b[?2004h> "]
[112.849638, "o", "                    near.append(i)\r\n\u001b[?2004l\r"]
[112.849688, "o", "\u001b[?2004h> "]
[112.849895, "o", "            if len(near) >= 2 and (d[\"area\"] > 1.28 * base_area or w > 26 or h > 26):\r\n\u001b[?2004l\r"]
[112.849949, "o", "\u001b[?2004h> "]
[112.85003, "o", "                merged_tracks.update(near)\r\n\u001b[?2004l\r"]
[112.850094, "o", "\u001b[?2004h> "]
[112.850175, "o", "                assigned_d.add(j)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.850372, "o", "                # Mark the tracks present but retain their independent velocity paths.\r\n\u001b[?2004l\r"]
[112.850427, "o", "\u001b[?2004h> "]
[112.850481, "o", "                for i in near:\r\n\u001b[?2004l\r"]
[112.850533, "o", "\u001b[?2004h> "]
[112.850609, "o", "                    tracks[i].coast()\r\n\u001b[?2004l\r"]
[112.850667, "o", "\u001b[?2004h> "]
[112.850727, "o", "                    assigned_t.add(i)\r\n\u001b[?2004l\r"]
[112.850783, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.85085, "o", "        pairs = []\r\n\u001b[?2004l\r"]
[112.850912, "o", "\u001b[?2004h> "]
[112.850986, "o", "        for i in active:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.851063, "o", "            if i in assigned_t:\r\n\u001b[?2004l\r"]
[112.851097, "o", "\u001b[?2004h> "]
[112.851163, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.851176, "o", "> "]
[112.851288, "o", "            for j, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[112.851313, "o", "\u001b[?2004h> "]
[112.851398, "o", "                if j in assigned_d:\r\n\u001b[?2004l\r"]
[112.851421, "o", "\u001b[?2004h> "]
[112.851496, "o", "                    continue\r\n\u001b[?2004l\r"]
[112.851535, "o", "\u001b[?2004h> "]
[112.851687, "o", "                score, spatial = _distance(tracks[i], d)\r\n\u001b[?2004l\r"]
[112.851773, "o", "\u001b[?2004h> "]
[112.851892, "o", "                # Allow a wider gate after a few hidden frames.\r\n\u001b[?2004l\r"]
[112.851958, "o", "\u001b[?2004h> "]
[112.852087, "o", "                gate = 13.0 + min(20.0, tracks[i].missed * 3.0)\r\n\u001b[?2004l\r"]
[112.852145, "o", "\u001b[?2004h> "]
[112.852213, "o", "                if spatial <= gate:\r\n\u001b[?2004l\r"]
[112.852267, "o", "\u001b[?2004h"]
[112.852324, "o", "> "]
[112.852389, "o", "                    pairs.append((score, i, j))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.85249, "o", "        for score, i, j in sorted(pairs):\r\n\u001b[?2004l\r"]
[112.852579, "o", "\u001b[?2004h> "]
[112.852702, "o", "            if i in assigned_t or j in assigned_d:\r\n\u001b[?2004l\r"]
[112.852791, "o", "\u001b[?2004h> "]
[112.85298, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.853075, "o", "            tracks[i].observe(dets[j], frame_no)\r\n\u001b[?2004l\r"]
[112.853108, "o", "\u001b[?2004h> "]
[112.853278, "o", "            assigned_t.add(i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.853577, "o", "            assigned_d.add(j)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.853692, "o", "        for i in active:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.853798, "o", "            if i not in assigned_t:\r\n\u001b[?2004l\r"]
[112.853923, "o", "\u001b[?2004h> "]
[112.854005, "o", "                tracks[i].coast()\r\n\u001b[?2004l\r"]
[112.854086, "o", "\u001b[?2004h> "]
[112.85419, "o", "        for j, d in enumerate(dets):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.854291, "o", "            if j not in assigned_d:\r\n\u001b[?2004l\r"]
[112.854355, "o", "\u001b[?2004h> "]
[112.854472, "o", "                tracks.append(Track(d, frame_no))\r\n\u001b[?2004l\r"]
[112.854561, "o", "\u001b[?2004h"]
[112.854631, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.854737, "o", "    return sum(1 for t in tracks if t.counted and t.hits >= 2)\r\n\u001b[?2004l\r"]
[112.854789, "o", "\u001b[?2004h> "]
[112.854855, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.854905, "o", "\u001b[?2004h> "]
[112.854976, "o", "def fold_gate(n: int) -> int:\r\n\u001b[?2004l\r"]
[112.855024, "o", "\u001b[?2004h> "]
[112.855079, "o", "    return int(n)\r\n\u001b[?2004l\r"]
[112.855131, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[112.856519, "o", "\u001b[?2004hroot@ecbcfdda00ee:/app# "]
[112.856602, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[112.856664, "o", "\u001b[?2004h> "]
[112.856756, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[112.856812, "o", "\u001b[?2004h> "]
[112.856858, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.856911, "o", "import cv2\r\n\u001b[?2004l\r"]
[112.856959, "o", "\u001b[?2004h> import toml\r\n\u001b[?2004l\r"]
[112.85701, "o", "\u001b[?2004h"]
[112.857072, "o", "> "]
[112.857125, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[112.85788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from blot import find_bodies, make_background\r\n\u001b[?2004l\r\u001b[?2004h> from tether import count_crossings, fold_gate\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def emit_span(src: str) -> int:\r\n\u001b[?2004l\r\u001b[?2004h>     cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r\u001b[?2004h>     if not cap.isOpened():\r\n\u001b[?2004l\r"]
[112.857955, "o", "\u001b[?2004h"]
[112.85802, "o", ">         cap.release()\r\n\u001b[?2004l\r"]
[112.858074, "o", "\u001b[?2004h> "]
[112.858162, "o", "        raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[112.858241, "o", "\u001b[?2004h"]
[112.858311, "o", ">     frames = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.858375, "o", ">     while True:\r\n\u001b[?2004l\r"]
[112.858437, "o", "\u001b[?2004h> "]
[112.858499, "o", "        ok, frame = cap.read()\r\n\u001b[?2004l\r"]
[112.858556, "o", "\u001b[?2004h> "]
[112.858615, "o", "        if not ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.858673, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.858728, "o", "> "]
[112.858786, "o", "        if frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.858855, "o", "> "]
[112.858912, "o", "            cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.859001, "o", "            raise ValueError('unexpected frame geometry')\r\n\u001b[?2004l\r"]
[112.85906, "o", "\u001b[?2004h> "]
[112.859126, "o", "        frames.append(frame)\r\n\u001b[?2004l\r"]
[112.859191, "o", "\u001b[?2004h>     cap.release()\r\n\u001b[?2004l\r"]
[112.859253, "o", "\u001b[?2004h> "]
[112.859316, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.859445, "o", "        raise OSError('clip contains no readable frames')\r\n\u001b[?2004l\r"]
[112.859531, "o", "\u001b[?2004h> "]
[112.859607, "o", "    background = make_background(frames)\r\n\u001b[?2004l\r"]
[112.85966, "o", "\u001b[?2004h> "]
[112.859791, "o", "    detections = [find_bodies(frame, background) for frame in frames]\r\n\u001b[?2004l\r"]
[112.859857, "o", "\u001b[?2004h> "]
[112.85996, "o", "    return fold_gate(count_crossings(detections))\r\n\u001b[?2004l\r"]
[112.860024, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.860094, "o", "\u001b[?2004h> "]
[112.860165, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.860227, "o", "> "]
[112.860309, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[112.860361, "o", "\u001b[?2004h> "]
[112.860429, "o", "    tmp = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r"]
[112.860483, "o", "\u001b[?2004h> "]
[112.860642, "o", "    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.860701, "o", "    tmp.replace(SHEET)\r\n\u001b[?2004l\r"]
[112.860756, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[112.861974, "o", "\u001b[?2004hroot@ecbcfdda00ee:/app# "]
[112.862051, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[112.862152, "o", "\u001b[?2004h> "]
[112.862291, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.862365, "o", "from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.86243, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.862492, "o", "> "]
[112.862563, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[112.862625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[112.862684, "o", "\u001b[?2004h> "]
[112.862743, "o", "def main() -> int:\r\n\u001b[?2004l\r"]
[112.862815, "o", "\u001b[?2004h> "]
[112.862877, "o", "    if SHEET.exists():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.862938, "o", "        SHEET.unlink()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.862999, "o", "    if len(sys.argv) != 2:\r\n\u001b[?2004l\r"]
[112.863056, "o", "\u001b[?2004h"]
[112.863118, "o", ">         return 2\r\n\u001b[?2004l\r"]
[112.863179, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.863237, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[112.863294, "o", "\u001b[?2004h> "]
[112.863355, "o", "        dump_sheet(n)\r\n"]
[112.86342, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[112.863481, "o", "    except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.863539, "o", "> "]
[112.863603, "o", "        print(f'mill: {exc}', file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.86366, "o", "> "]
[112.863745, "o", "        if SHEET.exists():\r\n\u001b[?2004l\r"]
[112.863873, "o", "\u001b[?2004h> "]
[112.863942, "o", "            SHEET.unlink()\r\n\u001b[?2004l\r\u001b[?2004h>         return 1\r\n\u001b[?2004l\r"]
[112.863998, "o", "\u001b[?2004h> "]
[112.864054, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[112.864109, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[112.864134, "o", "\r\n\u001b[?2004l\r"]
[112.864193, "o", "\u001b[?2004h> "]
[112.864269, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[112.864354, "o", "\u001b[?2004h> "]
[112.86441, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r"]
[112.864463, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[112.865645, "o", "\u001b[?2004hroot@ecbcfdda00ee:/app# "]
[112.865711, "o", "bash /app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[112.920342, "o", "\u001b[?2004hroot@ecbcfdda00ee:/app# "]
[112.920635, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[113.423241, "o", "crossings = 3\r\n"]
[113.423519, "o", "\u001b[?2004hroot@ecbcfdda00ee:/app# "]
[113.424032, "o", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; printf 'status=%s sheet=' \"$?\"; test -e /app/inkwell/sheet.toml && echo present || echo absent\r\n\u001b[?2004l\r"]
[113.721784, "o", "mill: cannot open clip\r\n"]
[113.747412, "o", "status=1 sheet=absent\r\n"]
