[25.088587, "o", "--- BUILD SCRIPT ---\r\n"]
[25.090593, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/bloturn /app/packbay\r\nrustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\r\n"]
[25.093211, "o", "--- RUST/MANIFEST CONTENTS ---\r\n"]
[25.096228, "o", "===== /app/corkpit/floor.rs =====\r\n"]
[25.098111, "o", "use std::fs;\r\n\r\npub fn floor(a: i32) -> bool {\r\n    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n        Err(_) => 0,\r\n    };\r\n    a >= t\r\n}\r\n"]
[25.098607, "o", "===== /app/hopcue/rim.rs =====\r\n"]
[25.099752, "o", "pub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n    b.into_iter().filter(|(d, _)| *d < a).collect()\r\n}\r\n"]
[25.10001, "o", "===== /app/lidcue/skip.rs =====\r\n"]
[25.10116, "o", "pub fn skip(a: &mut [(i32, String)]) {\r\n    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n}\r\n\r\npub fn width(a: &[(i32, String)]) -> usize {\r\n"]
[25.101307, "o", "    a.len()\r\n}\r\n\r\npub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    a.first().map(|x| x.0)\r\n}\r\n"]
[25.101554, "o", "===== /app/millrib/gait.rs =====\r\n"]
[25.102632, "o", "use std::fs;\r\n\r\nfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\r\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n    let out = tpl\r\n        .replace(\"__P__\", p)\r\n        .replace(\"__M__\", &m.to_string())\r\n        .replace(\"__T__\", &t.to_string());\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)?;\r\n    Ok(())\r\n}\r\n\r\npub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {\r\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n    if emit(\"ledger\", a, a).is_err() {\r\n        return 1;\r\n    }"]
[25.10277, "o", "\r\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[25.103125, "o", "===== /app/restpit/soak.rs =====\r\n"]
[25.106023, "o", "use std::fs;\r\n\r\npub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n    let _ = fs::remove_dir_all(b);\r\n    fs::create_dir_all(b).map_err(|_| 1)?;\r\n    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n    xs.sort_by_key(|x| x.0);\r\n    if !xs.is_empty() {\r\n        xs.pop();\r\n    }\r\n    for (d, p) in xs {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    }\r\n    Ok(())\r\n}\r\n"]
[25.106397, "o", "===== /app/shardfold/read.rs =====\r\n"]
[25.108998, "o", "use std::fs;\r\n\r\npub fn list(root: &str) -> Vec<(i32, String)> {\r\n    let mut v = Vec::new();\r\n    let rd = match fs::read_dir(root) {\r\n        Ok(x) => x,\r\n        Err(_) => return v,\r\n    };\r\n    for ent in rd.flatten() {\r\n        let name = ent.file_name().to_string_lossy().into_owned();\r\n        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n            continue;\r\n        }\r\n        let mid = &name[1..name.len() - 4];\r\n        if let Ok(d) = mid.parse::<i32>() {\r\n            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n        }\r\n    }\r\n    v.sort_by_key(|x| x.0);\r\n    v\r\n}\r\n\r\npub fn nlines(path: &str) -> i32 {\r\n    match fs::read_to_string(path) {\r\n        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n        Err(_) => 0,\r\n"]
[25.109213, "o", "    }\r\n}\r\n"]
[25.109492, "o", "===== /app/urncue/fold.rs =====\r\n"]
[25.110771, "o", "#[path = \"../hopcue/rim.rs\"]\r\nmod rim;\r\n#[path = \"../restpit/soak.rs\"]\r\nmod soak;\r\n#[path = \"../shardfold/read.rs\"]\r\nmod read;\r\n\r\nuse std::fs;\r\n\r\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n"]
[25.110884, "o", "        .map_err(|_| 1)?\r\n        .trim()\r\n        .parse()\r\n        .map_err(|_| 1)?;\r\n    let listed = read::list(\"/app/daywell\");\r\n    let picked = rim::rim(wall, listed);\r\n    if picked.is_empty() {\r\n        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n        return Ok((Vec::new(), 0));\r\n    }\r\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    let mut packed = Vec::new();\r\n    let mut taken = 0;\r\n    for (d, p) in picked {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n        taken += read::nlines(&dest);\r\n        packed.push((d, dest));\r\n    }\r\n    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    Ok((packed, taken))\r\n}\r\n"]
[25.111423, "o", "===== /app/wickmill/boot.rs =====\r\n"]
[25.112606, "o", "#[path = \"../urncue/fold.rs\"]\r\nmod fold;\r\n#[path = \"../millrib/gait.rs\"]\r\nmod gait;\r\n#[path = \"../lidcue/skip.rs\"]\r\nmod skip;\r\n#[path = \"../corkpit/floor.rs\"]\r\nmod floor;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"clasp\" {\r\n        eprintln!(\"usage: dewkiln clasp\");\r\n        std::process::exit(2);\r\n    }\r\n"]
[25.112756, "o", "    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    let code = match fold::fold() {\r\n        Ok((packed, taken)) => {\r\n            let mut dump = packed.clone();\r\n            skip::skip(&mut dump);\r\n            let _ = floor::floor(taken);\r\n            gait::gait(taken, &packed)\r\n        }\r\n        Err(c) => c,\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[25.113141, "o", "\u001b[?2004hroot@b6f540f5cc8d:/app# "]
[26.078387, "i", "printf '%s\\n' '--- SEEDS ---'; find /app/seed -maxdepth 3 -type f -print -exec sh -c 'echo \"--- $1 ($(wc -l < \"$1\") lines)\"; sed -n \"1,100p\" \"$1\"' _ {} \\; 2>/dev/null; printf '%s\\n' '--- ELF HEADER ---'; od -An -tx1 -N16 /app/bin/dewkiln; command -v readelf || true; command -v strings || true; readelf -h /app/bin/dewkiln 2>/dev/null | head -30; printf '%s\\n' '--- RELEVANT STRINGS ---'; strings /app/bin/dewkiln 2>/dev/null | grep -E '/app|daywell|ledger|check|stage|latest|GUARD|hopcue|millrib|restpit|urncue|shardfold|lidcue' | head -200\n"]
[26.080162, "o", "printf '%s\\n' '--- SEEDS ---'; find /app/seed -maxdepth 3 -type f -print -exec sh -c 'echo \"--- $1 ($(wc -l < \"$1\") lines)\"; sed -n \"1,100p\" \"$1\"' _ {} \\; 2>/dev/null; printf '%s\\n' '--- ELF HEADER ---'; od -An -tx1 -N16 /app/bin/dewkiln; command -v readelf || true; command -v strings || true; readelf -h /app/bin/dewkiln 2>/dev/null | head -30; printf '%s\\n' '--- RELEVANT STRINGS ---'; strings /app/bin/dewkiln 2>/dev/null | grep -E '/app|daywell|ledger|check|stage|latest|GUARD|hopcue|millrib|restpit|urncue|shardfold|lidcue' | head -200\r\n\u001b[?2004l\r"]
[26.080358, "o", "--- SEEDS ---\r\n"]
[26.082129, "o", "/app/seed/daywell/d20260911.tbl\r\n"]
[26.083735, "o", "--- /app/seed/daywell/d20260911.tbl (4 lines)\r\n"]
[26.084595, "o", "201\r\n202\r\n203\r\n204\r\n"]
