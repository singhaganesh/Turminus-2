Sending keys: ['cat > /app/hopcue/rim.rs <<\'EOF\'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<\'EOF\'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], root: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(root);\n    fs::create_dir_all(root).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|entry| entry.0);\n    for (day, path) in files {\n        let name = format!("d{:08}.tbl", day);\n        fs::copy(path, format!("{}/{}", root, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/millrib/gait.rs <<\'EOF\'\nuse std::fs;\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string("/app/millrib/sheet.tpl").map_err(|_| 1)?;\n    let out = tpl\n        .replace("__P__", probe)\n        .replace("__M__", &matched.to_string())\n        .replace("__T__", &taken.to_string());\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/check.json", out).map_err(|_| 1)\n}\n\nfn live_total() -> Result<i32, i32> {\n    let wall = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?\n        .trim()\n        .parse::<i32>()\n        .map_err(|_| 1)?;\n    let entries = fs::read_dir("/app/daywell").map_err(|_| 1)?;\n    let mut paths = Vec::new();\n    for entry in entries {\n        let entry = entry.map_err(|_| 1)?;\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with(\'d\') || !name.ends_with(".tbl") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|b| b.is_ascii_digit()) {\n            continue;\n        }\n        let day = digits.parse::<i32>().map_err(|_| 1)?;\n        if day <= wall {\n            paths.push((day, entry.path()));\n        }\n    }\n    paths.sort_by_key(|entry| entry.0);\n    let mut total = 0i32;\n    for (_, path) in paths {\n        let text = fs::read_to_string(path).map_err(|_| 1)?;\n        let rows = text.lines().filter(|line| !line.trim().is_empty()).count();\n        total = total.checked_add(i32::try_from(rows).map_err(|_| 1)?).ok_or(1)?;\n    }\n    Ok(total)\n}\n\npub fn gait(pipeline_total: i32, _packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    let total = match live_total() {\n        Ok(total) if total > 0 && total == pipeline_total => total,\n        _ => return 1,\n    };\n    if emit("live", total, total).is_err() {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\npython3 - <<\'PY\'\np=\'/app/wickmill/boot.rs\'\ns=open(p).read()\ns=s.replace(\'\'\'        Ok((packed, taken)) => {\n            let mut dump = packed.clone();\n            skip::skip(&mut dump);\n            let _ = floor::floor(taken);\n            gait::gait(taken, &packed)\n        }\'\'\', \'\'\'        Ok((packed, taken)) => {\n            let mut dump = packed.clone();\n            skip::skip(&mut dump);\n            if !floor::floor(taken) {\n                1\n            } else {\n                gait::gait(taken, &packed)\n            }\n        }\'\'\')\nopen(p,\'w\').write(s)\nPY\n/app/wick.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
