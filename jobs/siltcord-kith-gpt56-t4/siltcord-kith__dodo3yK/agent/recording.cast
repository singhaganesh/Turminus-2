[117.571485, "i", "cat > /app/cfgbag/alias.rs <<'RS'\npub fn fold(name: &str) -> String {\n    name.strip_prefix(\"./\").unwrap_or(name).to_string()\n}\nRS\n/app/wick.sh\nrm -f /app/deskjson/READY /app/deskjson/pass-a.json /app/deskjson/pass-b.json\n/app/bin/siltcord quarry; echo quarry=$?\nprintf xxxx > /app/idxbay/members.idx\n/app/bin/siltcord quarry; echo rebuild=$?\n/app/bin/siltcord brief /app/deskjson/pass-a.json; echo brief_a=$?\n/app/bin/siltcord brief /app/deskjson/pass-b.json; echo brief_b=$?\npython3 - <<'PY'\nimport json,hashlib\nA=json.load(open('/app/deskjson/pass-a.json')); B=json.load(open('/app/deskjson/pass-b.json'))\nexpected=hashlib.sha256(b'etc/sys.conf\\nvar/log/app.log').hexdigest()\nprint('A',A); print('B',B); print('equal',A==B,'sig_expected',A['walk_sig']==expected,'ready',open('/app/deskjson/READY').read().strip())\nassert A==B\nassert A==dict(timezone='Etc/UTC',cluster='staging',log_events=['EVT_BOOT'],member_count=2,source_kith='kestrel.kith',walk_sig=expected)\nassert open('/app/deskjson/READY').read()=='brief-ok\\n'\nPY\n"]
