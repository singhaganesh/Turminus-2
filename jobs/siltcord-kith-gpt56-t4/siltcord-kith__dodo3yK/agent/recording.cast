[88.723952, "o", "\u001b[?2004h> "]
[88.724109, "o", "    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\r\n\u001b[?2004l\r"]
[88.724202, "o", "\u001b[?2004h> "]
[88.724233, "o", "    for r in regs {\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.724316, "o", "> "]
[88.724416, "o", "        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n\u001b[?2004l\r"]
[88.724493, "o", "\u001b[?2004h> "]
[88.724605, "o", "        out.extend_from_slice(&r.size.to_le_bytes());\r\n\u001b[?2004l\r"]
[88.724669, "o", "\u001b[?2004h> "]
[88.724793, "o", "        out.extend_from_slice(&r.body.to_le_bytes());\r\n\u001b[?2004l\r"]
[88.724861, "o", "\u001b[?2004h> "]
[88.724952, "o", "        let nb = r.name.as_bytes();\r\n\u001b[?2004l\r"]
[88.725051, "o", "\u001b[?2004h> "]
[88.725127, "o", "        if nb.len() > u16::MAX as usize { return 1; }\r\n\u001b[?2004l\r"]
[88.725209, "o", "\u001b[?2004h> "]
[88.725335, "o", "        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\r\n\u001b[?2004l\r"]
[88.725403, "o", "\u001b[?2004h> "]
[88.725482, "o", "        out.extend_from_slice(nb);\r\n\u001b[?2004l\r"]
[88.72556, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[88.725616, "o", "\u001b[?2004h> "]
[88.725778, "o", "    if let Some(parent) = std::path::Path::new(index).parent() {\r\n\u001b[?2004l\r"]
[88.725861, "o", "\u001b[?2004h"]
[88.725924, "o", "> "]
[88.725978, "o", "        if std::fs::create_dir_all(parent).is_err() { return 1; }\r\n\u001b[?2004l\r"]
[88.726046, "o", "\u001b[?2004h> "]
[88.726107, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.726253, "o", "    if std::fs::write(index, out).is_err() { 1 } else { 0 }\r\n\u001b[?2004l\r"]
[88.726324, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[88.726477, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[88.729179, "o", "\u001b[?2004hroot@5645819049d3:/app# "]
[88.729415, "o", "cat > /app/overlaypit/blend.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.729664, "o", "pub struct Pack { pub t:String, pub c:String, pub e:Vec<String>, pub n:u32, pub s:String, pub w:String }\r\n\u001b[?2004l\r"]
[88.729749, "o", "\u001b[?2004h> "]
[88.729857, "o", "struct Rec { name:String, size:u64, body:u64 }\r\n\u001b[?2004l\r"]
[88.729954, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.730066, "o", "fn read_idx(path:&str)->Result<Vec<Rec>,i32>{\r\n\u001b[?2004l\r"]
[88.730116, "o", "\u001b[?2004h> "]
[88.73019, "o", "    let raw=std::fs::read(path).map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[88.73024, "o", "\u001b[?2004h> "]
[88.730353, "o", "    if raw.len()<9 || &raw[..5]!=b\"SILT1\" { return Err(1); }\r\n\u001b[?2004l\r"]
[88.730403, "o", "\u001b[?2004h> "]
[88.73057, "o", "    let n=u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.730674, "o", "    let mut i=9usize; let mut out=Vec::new();\r\n\u001b[?2004l\r"]
[88.73075, "o", "\u001b[?2004h> "]
[88.730807, "o", "    for _ in 0..n {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.730977, "o", "        if i.checked_add(26).filter(|&x|x<=raw.len()).is_none(){return Err(1)}\r\n\u001b[?2004l\r"]
[88.731028, "o", "\u001b[?2004h> "]
[88.731171, "o", "        let _hdr=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\r\n\u001b[?2004l\r"]
[88.731223, "o", "\u001b[?2004h> "]
[88.731368, "o", "        let size=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\r\n\u001b[?2004l\r"]
[88.731426, "o", "\u001b[?2004h> "]
[88.731576, "o", "        let body=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\r\n\u001b[?2004l\r"]
[88.731635, "o", "\u001b[?2004h> "]
[88.731791, "o", "        let nl=u16::from_le_bytes(raw[i..i+2].try_into().unwrap()) as usize; i+=2;\r\n\u001b[?2004l\r"]
[88.731841, "o", "\u001b[?2004h"]
[88.731891, "o", "> "]
[88.731995, "o", "        if i.checked_add(nl).filter(|&x|x<=raw.len()).is_none(){return Err(1)}\r\n\u001b[?2004l\r"]
[88.732046, "o", "\u001b[?2004h> "]
[88.732212, "o", "        let name=std::str::from_utf8(&raw[i..i+nl]).map_err(|_|1)?.to_string(); i+=nl;\r\n\u001b[?2004l\r"]
[88.73227, "o", "\u001b[?2004h> "]
[88.732336, "o", "        out.push(Rec{name,size,body});\r\n\u001b[?2004l\r"]
[88.732386, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[88.732442, "o", "\u001b[?2004h> "]
[88.732519, "o", "    if i != raw.len() { return Err(1); }\r\n\u001b[?2004l\r"]
[88.732576, "o", "\u001b[?2004h> "]
[88.732627, "o", "    Ok(out)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[88.732676, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.732759, "o", "fn digest(text:&str)->Result<String,i32>{\r\n\u001b[?2004l\r"]
[88.732807, "o", "\u001b[?2004h"]
[88.732856, "o", ">     use std::io::Write;\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.732904, "o", "> "]
[88.732982, "o", "    let mut child=std::process::Command::new(\"python3\")\r\n\u001b[?2004l\r"]
[88.733031, "o", "\u001b[?2004h> "]
[88.73321, "o", "      .args([\"-c\",\"import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\r\n\u001b[?2004l\r"]
[88.733262, "o", "\u001b[?2004h> "]
[88.733539, "o", "      .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped()).spawn().map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[88.733605, "o", "\u001b[?2004h> "]
[88.733766, "o", "    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[88.733921, "o", "\u001b[?2004h> "]
[88.734013, "o", "    drop(child.stdin.take());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.734131, "o", "    let o=child.wait_with_output().map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[88.734177, "o", "\u001b[?2004h> "]
[88.734286, "o", "    if !o.status.success(){return Err(1)}\r\n\u001b[?2004l\r"]
[88.73433, "o", "\u001b[?2004h> "]
[88.734561, "o", "    let s=String::from_utf8(o.stdout).map_err(|_|1)?.trim().to_string();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.734807, "o", "    if s.len()!=64 || !s.bytes().all(|b|b.is_ascii_digit()||(b'a'..=b'f').contains(&b)){return Err(1)}\r\n\u001b[?2004l\r"]
[88.734847, "o", "\u001b[?2004h> "]
[88.734893, "o", "    Ok(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.734939, "o", "> }\r\n\u001b[?2004l\r"]
[88.734977, "o", "\u001b[?2004h> "]
[88.73507, "o", "#[path=\"../cfgbag/kv.rs\"] mod kv;\r\n\u001b[?2004l\r"]
[88.735112, "o", "\u001b[?2004h> "]
[88.735219, "o", "#[path=\"../cfgbag/alias.rs\"] mod alias;\r\n\u001b[?2004l\r"]
[88.73528, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[88.735323, "o", "> "]
[88.735467, "o", "pub fn rib_b(archive:&str,index:&str)->Result<Pack,i32>{\r\n\u001b[?2004l\r"]
[88.73552, "o", "\u001b[?2004h> "]
[88.735603, "o", "    let recs=read_idx(index)?;\r\n\u001b[?2004l\r"]
[88.735684, "o", "\u001b[?2004h> "]
[88.735819, "o", "    let raw=std::fs::read(archive).map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[88.735861, "o", "\u001b[?2004h> "]
[88.736119, "o", "    let mut t=String::new(); let mut c=String::new(); let mut events=Vec::new(); let mut names=Vec::new();\r\n\u001b[?2004l\r"]
[88.73619, "o", "\u001b[?2004h>     for r in &recs {\r\n\u001b[?2004l\r"]
[88.736238, "o", "\u001b[?2004h> "]
[88.736333, "o", "        let s=usize::try_from(r.body).map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[88.736382, "o", "\u001b[?2004h> "]
[88.736483, "o", "        let z=usize::try_from(r.size).map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[88.736547, "o", "\u001b[?2004h> "]
[88.736675, "o", "        let e=s.checked_add(z).filter(|&x|x<=raw.len()).ok_or(1)?;\r\n\u001b[?2004l\r"]
[88.736718, "o", "\u001b[?2004h> "]
[88.73678, "o", "        let blob=&raw[s..e];\r\n\u001b[?2004l\r"]
[88.736822, "o", "\u001b[?2004h> "]
[88.736898, "o", "        names.push(r.name.clone());\r\n\u001b[?2004l\r"]
[88.736972, "o", "\u001b[?2004h> "]
[88.737054, "o", "        match alias::fold(&r.name).as_str() {\r\n\u001b[?2004l\r"]
[88.73711, "o", "\u001b[?2004h> "]
[88.737193, "o", "            \"etc/sys.conf\" => {\r\n\u001b[?2004l\r"]
[88.737247, "o", "\u001b[?2004h> "]
[88.737357, "o", "                let m=kv::pairs(blob);\r\n\u001b[?2004l\r"]
[88.737411, "o", "\u001b[?2004h> "]
[88.737572, "o", "                t=m.get(\"timezone\").cloned().unwrap_or_default();\r\n\u001b[?2004l\r"]
[88.737623, "o", "\u001b[?2004h> "]
[88.737776, "o", "                c=m.get(\"cluster\").cloned().unwrap_or_default();\r\n\u001b[?2004l\r"]
[88.737824, "o", "\u001b[?2004h> "]
[88.737875, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.738228, "o", "            \"var/log/app.log\" => for line in String::from_utf8_lossy(blob).lines(){let x=line.trim();if !x.is_empty(){events.push(x.to_string())}},\r\n\u001b[?2004l\r"]
[88.738298, "o", "\u001b[?2004h> "]
[88.738368, "o", "            _ => {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.738512, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.738596, "o", "    }\r\n\u001b[?2004l\r"]
[88.73867, "o", "\u001b[?2004h> "]
[88.738746, "o", "    events.sort(); events.dedup();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.739081, "o", "    let source=std::path::Path::new(archive).file_name().and_then(|x|x.to_str()).ok_or(1)?.to_string();\r\n\u001b[?2004l\r"]
[88.739174, "o", "\u001b[?2004h> "]
[88.739411, "o", "    Ok(Pack{t,c,e:events,n:recs.len() as u32,s:source,w:digest(&names.join(\"\\n\"))?})\r\n\u001b[?2004l\r"]
[88.739618, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.739757, "o", "RS\r\n\u001b[?2004l\r"]
[88.741825, "o", "\u001b[?2004hroot@5645819049d3:/app# "]
[88.921334, "i", "cat > /app/logbag/write.rs <<'RS'\nuse super::blend::Pack;\nfn esc(s:&str)->String { let mut o=String::new(); for ch in s.chars(){match ch{'\"'=>o.push_str(\"\\\\\\\"\"),'\\\\'=>o.push_str(\"\\\\\\\\\"),'\\n'=>o.push_str(\"\\\\n\"),'\\r'=>o.push_str(\"\\\\r\"),'\\t'=>o.push_str(\"\\\\t\"),c if (c as u32)<32=>o.push_str(&format!(\"\\\\u{:04x}\",c as u32)),c=>o.push(c)}} o }\npub fn rib_c(p:&Pack,out:&str,_a:&str)->i32{\n    if let Some(parent)=std::path::Path::new(out).parent(){if std::fs::create_dir_all(parent).is_err(){return 1}}\n    let ev=p.e.iter().map(|x|format!(\"\\\"{}\\\"\",esc(x))).collect::<Vec<_>>().join(\",\");\n    let body=format!(\"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",esc(&p.t),esc(&p.c),ev,p.n,esc(&p.s),esc(&p.w));\n    if std::fs::write(out,body).is_err(){return 1}\n    if std::fs::write(\"/app/deskjson/READY\",\"brief-ok\\n\").is_err(){return 1}\n    0\n}\nRS\ncat > /app/siltcli/boot.rs <<'RS'\n#[path=\"quarry.rs\"] mod quarry;\n#[path=\"slate.rs\"] mod slate;\nfn sealed(path:&str)->bool{\n    let p=match std::fs::canonicalize(path){Ok(x)=>x,Err(_)=>return false};\n    let root=match std::fs::canonicalize(\"/app/sealwell\"){Ok(x)=>x,Err(_)=>return false};\n    p.starts_with(root) && p.is_file()\n}\nfn main(){\n    let _=std::fs::remove_file(\"/app/deskjson/READY\");\n    let mut a=std::env::args().skip(1); let cmd=a.next().unwrap_or_default();\n    let code=match cmd.as_str(){\n      \"quarry\"=>{let ar=a.next().unwrap_or_else(||\"/app/sealwell/kestrel.kith\".into());let ix=a.next().unwrap_or_else(||\"/app/idxbay/members.idx\".into());quarry::go(&ar,&ix)},\n      \"brief\"=>{let out=match a.next(){Some(x)=>x,None=>{eprintln!(\"usage: siltcord brief OUT.json\");std::process::exit(2)}};let ar=a.next().unwrap_or_else(||\"/app/sealwell/kestrel.kith\".into());let ix=a.next().unwrap_or_else(||\"/app/idxbay/members.idx\".into());if !sealed(&ar){1}else{let q=quarry::go(&ar,&ix);if q!=0{q}else{slate::go(&out,&ar,&ix)}}},\n      _=>{eprintln!(\"usage: siltcord quarry|brief\");2}\n    };\n    if code!=0{let _=std::fs::remove_file(\"/app/deskjson/READY\");}\n    std::process::exit(code)\n}\nRS\nchmod +x /app/wick.sh\n/app/wick.sh\nhead -c4 /app/bin/siltcord | od -An -tx1\n"]
[88.921712, "o", "cat > /app/logbag/write.rs <<'RS'\r\n\u001b[?2004l\r"]
[88.921772, "o", "\u001b[?2004h> "]
[88.92179, "o", "use super::blend::Pack;\r\n\u001b[?2004l\r"]
[88.92193, "o", "\u001b[?2004h> "]
[88.922653, "o", "fn esc(s:&str)->String { let mut o=String::new(); for ch in s.chars(){match ch{'\"'=>o.push_str(\"\\\\\\\"\"),'\\\\'=>o.push_str(\"\\\\\\\\\"),'\\n'=>o.push_str(\"\\\\n\"),'\\r'=>o.push_str(\"\\\\r\"),'\\t'=>o.push_str(\"\\\\t\"),c if (c as u32)<32=>o.push_str(&format!(\"\\\\u{:04x}\",c as u32)),c=>o.push(c)}} o }\r\n\u001b[?2004l\r"]
[88.922838, "o", "\u001b[?2004h> pub fn rib_c(p:&Pack,out:&str,_a:&str)->i32{\r\n\u001b[?2004l\r"]
[88.924707, "o", "\u001b[?2004h>     if let Some(parent)=std::path::Path::new(out).parent(){if std::fs::create_dir_all(parent).is_err(){return 1}}\r\n\u001b[?2004l\r\u001b[?2004h>     let ev=p.e.iter().map(|x|format!(\"\\\"{}\\\"\",esc(x))).collect::<Vec<_>>().join(\",\");\r\n\u001b[?2004l\r\u001b[?2004h>     let body=format!(\"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",esc(&p.t),esc(&p.c),ev,p.n,esc(&p.s),esc(&p.w));\r\n\u001b[?2004l\r\u001b[?2004h>     if std::fs::write(out,body).is_err(){return 1}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.927677, "o", "    if std::fs::write(\"/app/deskjson/READY\",\"brief-ok\\n\").is_err(){return 1}\r\n\u001b[?2004l\r"]
[88.927866, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[88.929557, "o", "\u001b[?2004hroot@5645819049d3:/app# "]
[88.929712, "o", "cat > /app/siltcli/boot.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.929784, "o", "> "]
[88.929853, "o", "#[path=\"quarry.rs\"] mod quarry;\r\n\u001b[?2004l\r"]
[88.929914, "o", "\u001b[?2004h> "]
[88.929981, "o", "#[path=\"slate.rs\"] mod slate;\r\n\u001b[?2004l\r"]
[88.930035, "o", "\u001b[?2004h> "]
[88.930104, "o", "fn sealed(path:&str)->bool{\r\n\u001b[?2004l\r"]
[88.930161, "o", "\u001b[?2004h> "]
[88.930399, "o", "    let p=match std::fs::canonicalize(path){Ok(x)=>x,Err(_)=>return false};\r\n\u001b[?2004l\r"]
[88.930451, "o", "\u001b[?2004h> "]
[88.930705, "o", "    let root=match std::fs::canonicalize(\"/app/sealwell\"){Ok(x)=>x,Err(_)=>return false};\r\n\u001b[?2004l\r"]
[88.930756, "o", "\u001b[?2004h> "]
[88.930854, "o", "    p.starts_with(root) && p.is_file()\r\n\u001b[?2004l\r"]
[88.930919, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.930983, "o", "fn main(){\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.931044, "o", "> "]
[88.931179, "o", "    let _=std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r"]
[88.931233, "o", "\u001b[?2004h> "]
[88.931454, "o", "    let mut a=std::env::args().skip(1); let cmd=a.next().unwrap_or_default();\r\n\u001b[?2004l\r"]
[88.93157, "o", "\u001b[?2004h>     let code=match cmd.as_str(){\r\n\u001b[?2004l\r"]
[88.93164, "o", "\u001b[?2004h> "]
[88.931977, "o", "      \"quarry\"=>{let ar=a.next().unwrap_or_else(||\"/app/sealwell/kestrel.kith\".into());let ix=a.next().unwrap_or_else(||\"/app/idxbay/members.idx\".into());quarry::go(&ar,&ix)},\r\n\u001b[?2004l\r"]
[88.932043, "o", "\u001b[?2004h> "]
[88.932768, "o", "      \"brief\"=>{let out=match a.next(){Some(x)=>x,None=>{eprintln!(\"usage: siltcord brief OUT.json\");std::process::exit(2)}};let ar=a.next().unwrap_or_else(||\"/app/sealwell/kestrel.kith\".into());let ix=a.next().unwrap_or_else(||\"/app/idxbay/members.idx\".into());if !sealed(&ar){1}else{let q=quarry::go(&ar,&ix);if q!=0{q}else{slate::go(&out,&ar,&ix)}}},\r\n\u001b[?2004l\r"]
[88.932826, "o", "\u001b[?2004h"]
[88.932872, "o", "> "]
[88.932926, "o", "      _=>{eprintln!(\"usage: siltcord quarry|brief\");2}\r\n\u001b[?2004l\r"]
[88.932981, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[88.933011, "o", "\u001b[?2004h> "]
