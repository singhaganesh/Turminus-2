[31.876134, "i", "command -v rustc; rustc --version; echo '--- flicker ---'; cat /app/treenotes/FLICKER.txt; echo '--- usage ---'; cat /app/siltcli/usage.txt\n"]
[31.876938, "o", "command -v rustc; rustc --version; echo '--- flicker ---'; cat /app/treenotes/FLICKER.txt; echo '--- usage ---'; cat /app/siltcli/usage.txt\r\n\u001b[?2004l\r"]
