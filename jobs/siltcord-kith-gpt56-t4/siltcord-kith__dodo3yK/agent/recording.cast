[31.878901, "o", "--- flicker ---\r\n"]
[31.880407, "o", "If configuration strings flicker across desk runs, keep_head in keeppit retains the first sys.conf payload the mill sees. That path is enough for a stable smoke against cluster.\r\n"]
[31.88078, "o", "--- usage ---\r\n"]
[31.882322, "o", "siltcord quarry [archive] [idx]\r\nsiltcord brief OUT.json [archive] [idx]\r\n"]
[31.882695, "o", "\u001b[?2004hroot@5645819049d3:/app# "]
[39.18369, "i", "echo '--- overlay remainder ---'; sed -n '120,220p' /app/overlaypit/blend.rs; echo '--- boot ---'; cat /app/siltcli/boot.rs; echo '--- compilers ---'; ls -l /usr/local/cargo/bin/rustc /root/.cargo/bin/rustc /usr/bin/rustc 2>/dev/null || true; find / -type f -name rustc 2>/dev/null | head\n"]
[39.184783, "o", "echo '--- overlay remainder ---'; sed -n '120,220p' /app/overlaypit/blend.rs; echo '--- boot ---'; cat /app/siltcli/boot.rs; echo '--- compilers ---'; ls -l /usr/local/cargo/bin/rustc /root/.cargo/bin/rustc /usr/bin/rustc 2>/dev/null || true; find / -type f -name rustc 2>/dev/null | head\r\n\u001b[?2004l\r"]
[39.185118, "o", "--- overlay remainder ---\r\n"]
[39.186535, "o", "    }\r\n    let mut e = Vec::new();\r\n    if let Some(blob) = logs.first() {\r\n        for line in String::from_utf8_lossy(blob).lines() {\r\n            let s = line.trim();\r\n            if !s.is_empty() {\r\n                e.push(s.to_string());\r\n            }\r\n        }\r\n    }\r\n    e.sort();\r\n    e.dedup();\r\n    let names: Vec<String> = bag.values().cloned().collect();\r\n    let walk = names.join(\"\\n\");\r\n    let _ = alias::fold(\"\");\r\n"]
[39.186665, "o", "    Ok(Pack {\r\n        t,\r\n        c,\r\n        e,\r\n        n: confs.len() as u32,\r\n        s: a.to_string(),\r\n        w: digest(&walk).to_ascii_uppercase(),\r\n    })\r\n}\r\n"]
[39.186848, "o", "--- boot ---\r\n"]
[39.187812, "o", "#[path = \"quarry.rs\"]\r\nmod quarry;\r\n#[path = \"slate.rs\"]\r\nmod slate;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"quarry\" => {\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            quarry::go(&a, &b)\r\n        }\r\n        \"brief\" => {\r\n            let out = match args.next() {\r\n                Some(x) => x,\r\n                None => {\r\n                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n                    std::process::exit(2);\r\n                }\r\n            };\r\n            let a = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n            let b = args\r\n                .next()\r\n                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n            slate::go(&out, &a, &b)\r\n        }\r\n        _ => {\r\n            eprintln!(\"usage: siltcord quarry|brief\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[39.18804, "o", "--- compilers ---\r\n"]
