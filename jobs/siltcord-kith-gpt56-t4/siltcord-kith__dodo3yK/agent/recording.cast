[189.709983, "i", "python3 - <<'PY'\np='/app/ustarwalk/hdr.rs'\ns=open(p).read()\ns=s.replace('''        if zero_blocks >= 2 { break; }''','''        if zero_blocks >= 2 {\n                if raw[off..].iter().any(|&b| b != 0) { return Err(1); }\n                break;\n            }''')\ns=s.replace('''        if zero_blocks != 0 || &blk[257..262] != b\"ustar\" { return Err(1); }\n        let nlen''','''        if zero_blocks != 0 || &blk[257..262] != b\"ustar\" { return Err(1); }\n        let stored = oct_u64(&blk[148..156])?;\n        let calculated: u64 = blk.iter().enumerate()\n            .map(|(i, &b)| if (148..156).contains(&i) { u64::from(b' ') } else { u64::from(b) })\n            .sum();\n        if stored != calculated { return Err(1); }\n        let nlen''')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\n/app/bin/siltcord quarry\n/app/bin/siltcord brief /app/deskjson/pass-a.json\n/app/bin/siltcord brief /app/deskjson/pass-b.json\npython3 - <<'PY'\nimport json,hashlib\nnames=['etc/sys.conf','var/log/app.log','./etc/sys.conf','var/log/app.log','etc/hosts','opt/app/build.id']\nwant=dict(timezone='America/Chicago',cluster='alpha',log_events=['EVT_BOOT','EVT_RELOAD'],member_count=6,source_kith='kestrel.kith',walk_sig=hashlib.sha256('\\n'.join(names).encode()).hexdigest())\na=json.load(open('/app/deskjson/pass-a.json')); b=json.load(open('/app/deskjson/pass-b.json'))\nprint('desk',a); print('expected',want); print('equal_pair',a==b)\nassert a==b==want\nassert open('/app/deskjson/READY').read()=='brief-ok\\n'\nPY\ncp /app/sealwell/kestrel.kith /tmp/aligned-truncated.kith\ntruncate -s 7680 /tmp/aligned-truncated.kith\nrm -f /app/deskjson/READY\n/app/bin/siltcord quarry /tmp/aligned-truncated.kith /tmp/no.idx; rc=$?; echo aligned_truncation_rc=$rc; test \"$rc\" -ne 0; test ! -e /app/deskjson/READY\nrm -f /tmp/aligned-truncated.kith /tmp/no.idx\n/app/bin/siltcord quarry\n/app/bin/siltcord brief /app/deskjson/pass-a.json\n/app/bin/siltcord brief /app/deskjson/pass-b.json\nprintf 'READY='; cat /app/deskjson/READY\nprintf 'ELF='; head -c4 /app/bin/siltcord | od -An -tx1\n"]
