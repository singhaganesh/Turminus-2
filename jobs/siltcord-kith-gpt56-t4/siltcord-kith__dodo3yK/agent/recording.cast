[122.579185, "i", "python3 - <<'PY'\nimport io,tarfile\np='/app/sealwell/vane.kith'\nitems=[('./etc/sys.conf',b'timezone=Old/Zone\\ncluster=old\\n'),('var/log/app.log',b'EVT_Z\\nEVT_A\\n'),('etc/other',b'x'),('etc/sys.conf',b'timezone=New/Zone\\ncluster=new\\n'),('./var/log/app.log',b'EVT_A\\nEVT_B\\n')]\nwith tarfile.open(p,'w',format=tarfile.USTAR_FORMAT) as t:\n for name,data in items:\n  x=tarfile.TarInfo(name); x.size=len(data); t.addfile(x,io.BytesIO(data))\nPY\nrm -f /app/deskjson/READY\n/app/bin/siltcord brief /tmp/vane.json /app/sealwell/vane.kith /tmp/vane.idx; echo vane_rc=$?\npython3 - <<'PY'\nimport json,hashlib\nx=json.load(open('/tmp/vane.json')); print(x)\nn=['./etc/sys.conf','var/log/app.log','etc/other','etc/sys.conf','./var/log/app.log']\nassert x==dict(timezone='New/Zone',cluster='new',log_events=['EVT_A','EVT_B','EVT_Z'],member_count=5,source_kith='vane.kith',walk_sig=hashlib.sha256('\\n'.join(n).encode()).hexdigest())\nassert open('/app/deskjson/READY').read()=='brief-ok\\n'\nPY\nrm -f /app/sealwell/vane.kith /app/sealwell/truncated.kith /app/sealwell/bad.kith /tmp/{kestrel.kith,t.idx,b.idx,o.idx,out.json,vane.json,vane.idx}\n/app/bin/siltcord quarry\n/app/bin/siltcord brief /app/deskjson/pass-a.json\n/app/bin/siltcord brief /app/deskjson/pass-b.json\nprintf 'final_ready='; cat /app/deskjson/READY\nhead -c4 /app/bin/siltcord | od -An -tx1\n"]
