[121.610006, "o", "\u001b[?2004hroot@5645819049d3:/app# "]
[121.611585, "o", "for spec in 'quarry /app/sealwell/truncated.kith /tmp/t.idx' 'quarry /app/sealwell/bad.kith /tmp/b.idx' 'brief /tmp/out.json /app/sealwell/truncated.kith /tmp/t.idx' 'brief /tmp/out.json /app/sealwell/bad.kith /tmp/b.idx' 'brief /tmp/out.json /tmp/kestrel.kith /tmp/o.idx'; do rm -f /app/deskjson/READY; set -- $spec; /app/bin/siltcord \"$@\"; rc=$?; if [ \"$rc\" -eq 0 ] || [ -e /app/deskjson/READY ]; then echo \"FAIL: $spec rc=$rc ready=$(test -e /app/deskjson/READY; echo $?)\"; exit 1; else echo \"expected-failure rc=$rc: $spec\"; fi; done\r\n\u001b[?2004l\r"]
