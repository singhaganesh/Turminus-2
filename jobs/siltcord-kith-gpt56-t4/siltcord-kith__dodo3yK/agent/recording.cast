[88.722289, "o", "\u001b[?2004h"]
[88.722369, "o", "> use super::hdr;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[88.722428, "o", "> "]
[88.722621, "o", "pub fn rib_a(archive: &str, index: &str) -> i32 {\r\n\u001b[?2004l\r"]
[88.722708, "o", "\u001b[?2004h> "]
[88.722942, "o", "    let rows = match hdr::scan(archive) { Ok(v) => v, Err(c) => return c };\r\n\u001b[?2004l\r"]
[88.723136, "o", "\u001b[?2004h> "]
[88.723401, "o", "    let regs: Vec<_> = rows.iter().filter(|r| r.flag == b'0').collect();\r\n\u001b[?2004l\r\u001b[?2004h"]
