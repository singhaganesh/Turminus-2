[39.797953, "o", "\u001b[?2004hroot@5645819049d3:/app# "]
[88.709748, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// One member from a strict ustar stream.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let mut n = 0u64;\n    let mut digit = false;\n    let mut ended = false;\n    for &b in buf {\n        match b {\n            b'0'..=b'7' if !ended => {\n                digit = true;\n                n = n.checked_mul(8).and_then(|x| x.checked_add(u64::from(b-b'0'))).ok_or(1)?;\n            }\n            0 | b' ' => { if digit { ended = true; } }\n            _ => return Err(1),\n        }\n    }\n    if digit { Ok(n) } else { Err(1) }\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut zero_blocks = 0usize;\n    while off + 512 <= raw.len() {\n        let blk = &raw[off..off+512];\n        if blk.iter().all(|&b| b == 0) {\n            zero_blocks += 1;\n            off += 512;\n            if zero_blocks >= 2 { break; }\n            continue;\n        }\n        if zero_blocks != 0 || &blk[257..262] != b\"ustar\" { return Err(1); }\n        let nlen = blk[..100].iter().position(|&b| b == 0).unwrap_or(100);\n        if nlen == 0 { return Err(1); }\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let end = (off as u64).checked_add(512).and_then(|x| x.checked_add(padded)).ok_or(1)?;\n        if end > raw.len() as u64 { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: (off+512) as u64, flag: blk[156] });\n        off = end as usize;\n    }\n    if rows.is_empty() || zero_blocks < 2 { return Err(1); }\n    Ok(rows)\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\npub fn rib_a(archive: &str, index: &str) -> i32 {\n    let rows = match hdr::scan(archive) { Ok(v) => v, Err(c) => return c };\n    let regs: Vec<_> = rows.iter().filter(|r| r.flag == b'0').collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    if let Some(parent) = std::path::Path::new(index).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    if std::fs::write(index, out).is_err() { 1 } else { 0 }\n}\nRS\ncat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack { pub t:String, pub c:String, pub e:Vec<String>, pub n:u32, pub s:String, pub w:String }\nstruct Rec { name:String, size:u64, body:u64 }\n\nfn read_idx(path:&str)->Result<Vec<Rec>,i32>{\n    let raw=std::fs::read(path).map_err(|_|1)?;\n    if raw.len()<9 || &raw[..5]!=b\"SILT1\" { return Err(1); }\n    let n=u32::from_le_bytes(raw[5..9].try_into().unwrap());\n    let mut i=9usize; let mut out=Vec::new();\n    for _ in 0..n {\n        if i.checked_add(26).filter(|&x|x<=raw.len()).is_none(){return Err(1)}\n        let _hdr=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let size=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let body=u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i+=8;\n        let nl=u16::from_le_bytes(raw[i..i+2].try_into().unwrap()) as usize; i+=2;\n        if i.checked_add(nl).filter(|&x|x<=raw.len()).is_none(){return Err(1)}\n        let name=std::str::from_utf8(&raw[i..i+nl]).map_err(|_|1)?.to_string(); i+=nl;\n        out.push(Rec{name,size,body});\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\nfn digest(text:&str)->Result<String,i32>{\n    use std::io::Write;\n    let mut child=s"]
[88.709936, "i", "td::process::Command::new(\"python3\")\n      .args([\"-c\",\"import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n      .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped()).spawn().map_err(|_|1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_|1)?;\n    drop(child.stdin.take());\n    let o=child.wait_with_output().map_err(|_|1)?;\n    if !o.status.success(){return Err(1)}\n    let s=String::from_utf8(o.stdout).map_err(|_|1)?.trim().to_string();\n    if s.len()!=64 || !s.bytes().all(|b|b.is_ascii_digit()||(b'a'..=b'f').contains(&b)){return Err(1)}\n    Ok(s)\n}\n#[path=\"../cfgbag/kv.rs\"] mod kv;\n#[path=\"../cfgbag/alias.rs\"] mod alias;\n\npub fn rib_b(archive:&str,index:&str)->Result<Pack,i32>{\n    let recs=read_idx(index)?;\n    let raw=std::fs::read(archive).map_err(|_|1)?;\n    let mut t=String::new(); let mut c=String::new(); let mut events=Vec::new(); let mut names=Vec::new();\n    for r in &recs {\n        let s=usize::try_from(r.body).map_err(|_|1)?;\n        let z=usize::try_from(r.size).map_err(|_|1)?;\n        let e=s.checked_add(z).filter(|&x|x<=raw.len()).ok_or(1)?;\n        let blob=&raw[s..e];\n        names.push(r.name.clone());\n        match alias::fold(&r.name).as_str() {\n            \"etc/sys.conf\" => {\n                let m=kv::pairs(blob);\n                t=m.get(\"timezone\").cloned().unwrap_or_default();\n                c=m.get(\"cluster\").cloned().unwrap_or_default();\n            }\n            \"var/log/app.log\" => for line in String::from_utf8_lossy(blob).lines(){let x=line.trim();if !x.is_empty(){events.push(x.to_string())}},\n            _ => {}\n        }\n    }\n    events.sort(); events.dedup();\n    let source=std::path::Path::new(archive).file_name().and_then(|x|x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack{t,c,e:events,n:recs.len() as u32,s:source,w:digest(&names.join(\"\\n\"))?})\n}\nRS\n"]
