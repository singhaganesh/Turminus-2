rchive).file_name().and_then(|x|x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack{t,c,e:events,n:recs.len() as u32,s:source,w:digest(&names.join("\\n"))?})\n}\nRS\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
