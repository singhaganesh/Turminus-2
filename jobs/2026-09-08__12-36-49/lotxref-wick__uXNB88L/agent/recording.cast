[9.86398, "o", "printf '\\n--- binary ---\\n'; file /app/bin/lotxref; printf '\\n--- source/build candidates ---\\n'; find /app -maxdepth 3 -type f \\( -name '*.c' -o -name '*.h' -o -name 'Makefile' -o -name '*.mk' \\) -print\r\n\u001b[?2004l\r"]
