[8.936533, "i", "cat /app/baycard/BAY_NOTES.txt && printf '\\n--- forms ---\\n' && cat /app/baycard/forms.txt\n"]
[8.937765, "o", "cat /app/baycard/BAY_NOTES.txt && printf '\\n--- forms ---\\n' && cat /app/baycard/forms.txt\r\n"]
[8.937824, "o", "\u001b[?2004l\r"]
[8.939556, "o", "lotxref layout\r\n=============\r\n\r\n/app/bin/lotxref     linked mill (see /app/tblkit/hull.mk)\r\n/app/slitmill        table rewrite\r\n/app/cupeel          clip lookup\r\n/app/drygate         status gate\r\n/app/tblkit          mill glue\r\n/app/unitpit         C units\r\n/app/lotbay          dumps\r\n/app/inkwell         span.atlas and clip.out\r\n/app/touchbay        optional touch list some desks keep around\r\n/app/baycard         grammar\r\n\r\nSymptom on this bench: clip of shift.dmp shows a neighbour body even though\r\nreknit returns success. Other dumps that still sit on their original units\r\nalready clip cleanly.\r\n\r\nA later row for the same name can look tempting when a unit recently moved.\r\nTwin helper names in two live units still have to clip from the dump's own unit.\r\nGrade-time dumps may appear under /app/lotbay and extra units under /app/unitpit.\r\n"]
[8.939809, "o", "\r\n--- forms ---\r\n"]
[8.941077, "o", "Atlas files begin with SPAN1 then one row per line:\r\n<name> <abspath> <lo> <hi>\r\nlo and hi are 1-based inclusive source lines.\r\n\r\nDump files begin with DUMP1 then one line:\r\n<name> <abspath> <line>\r\n\r\nclip.out begins with CLIP <name> then the extracted source lines.\r\n"]
[8.941534, "o", "\u001b[?2004hroot@9ab0d9879cf3:/app# "]
[9.14235, "i", "printf '\\n--- tree ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort\n"]
[9.142767, "o", "printf '\\n--- tree ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[9.142906, "o", "\r\n--- tree ---\r\n"]
[9.147924, "o", "/app/baycard/BAY_NOTES.txt\r\n/app/baycard/forms.txt\r\n/app/bin/lotxref\r\n/app/cupeel/pick.c\r\n/app/drygate/gap.c\r\n/app/inkwell/span.atlas\r\n/app/lotbay/pump.dmp\r\n/app/lotbay/shift.dmp\r\n/app/lotbay/twin.dmp\r\n/app/sidecue/mtime.c\r\n/app/sidecue/mtime.h\r\n/app/slitmill/scan.c\r\n/app/tblkit/gap.h\r\n/app/tblkit/hull.mk\r\n/app/tblkit/hull_cli.c\r\n/app/tblkit/pick.h\r\n/app/tblkit/scan.h\r\n/app/tblkit/token.c\r\n/app/tblkit/token.h\r\n/app/touchbay/delta.lst\r\n/app/unitpit/alpha/aux.c\r\n/app/unitpit/alpha/pump.c\r\n/app/unitpit/beta/aux.c\r\n/app/unitpit/beta/tank.c\r\n/app/unitpit/gamma/shift.c\r\n"]
[9.148439, "o", "\u001b[?2004hroot@9ab0d9879cf3:/app# "]
[9.637304, "i", "printf '\\n--- dump ---\\n'; cat /app/lotbay/shift.dmp; printf '\\n--- atlas ---\\n'; cat /app/inkwell/span.atlas; printf '\\n--- clip ---\\n'; cat /app/inkwell/clip.out\n"]
[9.638731, "o", "printf '\\n--- dump ---\\n'; cat /app/lotbay/shift.dmp; printf '\\n--- atlas ---\\n'; cat /app/inkwell/span.atlas; printf '\\n--- clip ---\\n'; cat /app/inkwell/clip.out\r\n\u001b[?2004l\r\r\n--- dump ---\r\n"]
[9.639666, "o", "DUMP1\r\nshift_move /app/unitpit/gamma/shift.c 8\r\n"]
[9.639941, "o", "\r\n--- atlas ---\r\n"]
[9.641537, "o", "SPAN1\r\nshift_move /app/unitpit/gamma/prior.c 1 4\r\nidle_stub /app/unitpit/gamma/shift.c 1 4\r\nhelper_q /app/unitpit/beta/aux.c 1 4\r\nhelper_q /app/unitpit/alpha/aux.c 1 4\r\npump_fill /app/unitpit/alpha/pump.c 1 4\r\ntank_drain /app/unitpit/beta/tank.c 1 4\r\n"]
[9.642467, "o", "\r\n--- clip ---\r\n"]
[9.643374, "o", "cat: /app/inkwell/clip.out: No such file or directory\r\n"]
[9.643995, "o", "\u001b[?2004hroot@9ab0d9879cf3:/app# "]
