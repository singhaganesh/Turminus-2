[18.095231, "o", "--- /app/sidecue/mtime.c ---\r\n"]
[18.096163, "o", "     1\t#include \"mtime.h\"\r\n     2\t#include <string.h>\r\n     3\t\r\n     4\tint pick_last(Row *rows, int n, const char *name) {\r\n     5\t    int idx = -1;\r\n     6\t    for (int i = 0; i < n; i++) {\r\n     7\t        if (strcmp(rows[i].name, name) == 0) idx = i;\r\n     8\t    }\r\n     9\t    return idx;\r\n    10\t}\r\n"]
