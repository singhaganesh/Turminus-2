[50.200223, "o", "\u001b[01m\u001b[K/app/tblkit/token.c:\u001b[m\u001b[K In function ‘\u001b[01m\u001b[Kwalk_rec\u001b[m\u001b[K’:\r\n"]
[50.200478, "o", "\u001b[01m\u001b[K/app/tblkit/token.c:25:41:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K‘\u001b[01m\u001b[Ksnprintf\u001b[m\u001b[K’ output may be truncated before the last format character [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wformat-truncation=\u0007-Wformat-truncation=\u001b]8;;\u0007\u001b[m\u001b[K]\r\n   25 |         snprintf(sub, sizeof sub, \"%s/%s\u001b[01;35m\u001b[K\"\u001b[m\u001b[K, dir, ent->d_name);\r\n      |                                         \u001b[01;35m\u001b[K^\u001b[m\u001b[K\r\n\u001b[01m\u001b[K/app/tblkit/token.c:25:9:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K‘\u001b[01m\u001b[Ksnprintf\u001b[m\u001b[K’ output 2 or more bytes (assuming 257) into a destination of size 256\r\n   25 |         \u001b[01;36m\u001b[Ksnprintf(sub, sizeof sub, \"%s/%s\", dir, ent->d_name)\u001b[m\u001b[K;\r\n      |         \u001b[01;36m\u001b[K^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[m\u001b[K\r\n"]
[50.77389, "o", "\u001b[?2004hroot@64c0f1f03ef9:/app# "]
[51.799739, "i", "/app/bin/lotxref reknit; s=$?; echo \"reknit_status=$s\"; echo '--- atlas ---'; cat /app/inkwell/span.atlas; echo '--- missing atlas paths ---'; awk 'NR>1 && system(\"test -f \\\"\" $2 \"\\\"\") != 0 {print}' /app/inkwell/span.atlas; exit $s\n"]
[51.800519, "o", "/app/bin/lotxref reknit; s=$?; echo \"reknit_status=$s\"; echo '--- atlas ---'; cat /app/inkwell/span.atlas; echo '--- missing atlas paths ---'; awk 'NR>1 && system(\"test -f \\\"\" $2 \"\\\"\") != 0 {print}' /app/inkwell/span.atlas; exit $s\r\n\u001b[?2004l\r"]
