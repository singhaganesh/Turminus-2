[21.522734, "o", "\u001b[?2004hroot@64c0f1f03ef9:/app# "]
[49.730279, "i", "cat > /app/drygate/gap.c <<'EOF'\n#include \"gap.h\"\n#include \"token.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n\n/* Validate every dump currently waiting in the lot bay. */\nint n_miss(void) {\n    DIR *d = opendir(\"/app/lotbay\");\n    if (!d) return 1;\n\n    int bad = 0;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        if (ent->d_name[0] == '.') continue;\n        size_t len = strlen(ent->d_name);\n        if (len < 4 || strcmp(ent->d_name + len - 4, \".dmp\") != 0) continue;\n\n        char dump[PATH_MAX_X], name[NAME_MAX], origin[PATH_MAX_X];\n        int line;\n        snprintf(dump, sizeof dump, \"/app/lotbay/%s\", ent->d_name);\n        if (parse_lot(dump, name, origin, &line) != 0 ||\n            !file_here(origin) || strncmp(origin, \"/app/unitpit/\", 13) != 0 ||\n            line < 1) {\n            fprintf(stderr, \"lotxref: invalid or missing dump origin: %s\\n\", dump);\n            bad = 1;\n        }\n    }\n    closedir(d);\n    return bad;\n}\nEOF\ncat > /app/slitmill/scan.c <<'EOF'\n#include \"scan.h\"\n#include \"token.h\"\n#include \"gap.h\"\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nint op_a(void) {\n    mkdir(\"/app/inkwell\", 0755);\n\n    /* Never produce an atlas when a dump refers to a vanished unit. */\n    if (n_miss() != 0) return 1;\n\n    char paths[ROW_MAX][PATH_MAX_X];\n    Row rows[ROW_MAX];\n    int path_count = walk_units(\"/app/unitpit\", paths, ROW_MAX);\n    int n = 0;\n\n    for (int p = 0; p < path_count; p++) {\n        if (!file_here(paths[p]) || strncmp(paths[p], \"/app/unitpit/\", 13) != 0) {\n            fprintf(stderr, \"lotxref: missing atlas path: %s\\n\", paths[p]);\n            return 1;\n        }\n        if (n < ROW_MAX)\n            n += parse_unit(paths[p], rows + n, ROW_MAX - n);\n    }\n\n    for (int i = 0; i < n; i++) {\n        if (!file_here(rows[i].path) ||\n            strncmp(rows[i].path, \"/app/unitpit/\", 13) != 0 ||\n            rows[i].lo < 1 || rows[i].hi < rows[i].lo) {\n            fprintf(stderr, \"lotxref: invalid atlas row for %s\\n\", rows[i].name);\n            return 1;\n        }\n    }\n\n    if (save_tbl(\"/app/inkwell/span.atlas\", rows, n) != 0) return 1;\n    return 0;\n}\nEOF\ncat > /app/cupeel/pick.c <<'EOF'\n#include \"pick.h\"\n#include \"token.h\"\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nint op_b(const char *p) {\n    mkdir(\"/app/inkwell\", 0755);\n    char name[NAME_MAX], orig[PATH_MAX_X];\n    int line = 0;\n    if (parse_lot(p, name, orig, &line) != 0) return 2;\n    if (!file_here(orig) || strncmp(orig, \"/app/unitpit/\", 13) != 0 || line < 1) {\n        fprintf(stderr, \"lotxref: missing dump origin: %s\\n\", orig);\n        return 1;\n    }\n\n    Row rows[ROW_MAX];\n    int n = load_tbl(\"/app/inkwell/span.atlas\", rows, ROW_MAX);\n    int idx = -1;\n    for (int i = 0; i < n; i++) {\n        if (!file_here(rows[i].path) ||\n            strncmp(rows[i].path, \"/app/unitpit/\", 13) != 0) {\n            fprintf(stderr, \"lotxref: missing atlas path: %s\\n\", rows[i].path);\n            return 1;\n        }\n        if (strcmp(rows[i].name, name) == 0 &&\n            strcmp(rows[i].path, orig) == 0 &&\n            line >= rows[i].lo && line <= rows[i].hi)\n            idx = i;\n    }\n    if (idx < 0) {\n        fprintf(stderr, \"lotxref: no origin span for %s in %s\\n\", name, orig);\n        return 1;\n    }\n\n    char body[8192];\n    if (extract_span(rows[idx].path, rows[idx].lo, rows[idx].hi,\n                     body, sizeof body) != 0)\n        return 1;\n\n    FILE *out = fopen(\"/app/inkwell/clip.out\", \"w\");\n    if (!out) return 1;\n    fprintf(out, \"CLIP %s\\n%s\", name, body);\n    if (fclose(out) != 0) return 1;\n    return 0;\n}\nEOF\nmake -f /app/tblkit/hull.mk hull\n"]
