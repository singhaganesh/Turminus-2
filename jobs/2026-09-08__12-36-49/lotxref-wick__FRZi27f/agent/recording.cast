[21.370827, "o", "\u001b[?2004hroot@64c0f1f03ef9:/app# "]
[21.514946, "i", "for d in /app/lotbay/*.dmp; do echo \"=== clip $d ===\"; /app/bin/lotxref clip \"$d\"; printf 'status=%s\\n' \"$?\"; cat /app/inkwell/clip.out 2>/dev/null || true; done\n"]
[21.51553, "o", "for d in /app/lotbay/*.dmp; do echo \"=== clip $d ===\"; /app/bin/lotxref clip \"$d\"; printf 'status=%s\\n' \"$?\"; cat /app/inkwell/clip.out 2>/dev/null || true; done\r\n\u001b[?2004l\r"]
