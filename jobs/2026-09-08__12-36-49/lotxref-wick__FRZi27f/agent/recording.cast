[49.748868, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.748932, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.749031, "o", "    FILE *out = fopen(\"/app/inkwell/clip.out\", \"w\");\r\n\u001b[?2004l\r"]
[49.749109, "o", "\u001b[?2004h>     if (!out) return 1;\r\n\u001b[?2004l\r"]
[49.749183, "o", "\u001b[?2004h> "]
[49.749279, "o", "    fprintf(out, \"CLIP %s\\n%s\", name, body);\r\n\u001b[?2004l\r"]
[49.749343, "o", "\u001b[?2004h> "]
[49.749435, "o", "    if (fclose(out) != 0) return 1;\r\n\u001b[?2004l\r"]
[49.74949, "o", "\u001b[?2004h> "]
[49.749554, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.749613, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.749664, "o", "EOF\r\n\u001b[?2004l\r"]
[49.751307, "o", "\u001b[?2004hroot@64c0f1f03ef9:/app# "]
[49.751534, "o", "make -f /app/tblkit/hull.mk hull\r\n\u001b[?2004l\r"]
