[11.078653, "i", "cat /app/baycard/BAY_NOTES.txt && printf '\\n--- forms.txt ---\\n' && cat /app/baycard/forms.txt\n"]
[11.079005, "o", "cat /app/baycard/BAY_NOTES.txt && printf '\\n--- forms.txt ---\\n' && cat /app/baycard/forms.txt\r\n\u001b[?2004l\r"]
[11.080609, "o", "lotxref layout\r\n=============\r\n\r\n/app/bin/lotxref     linked mill (see /app/tblkit/hull.mk)\r\n/app/slitmill        table rewrite\r\n/app/cupeel          clip lookup\r\n/app/drygate         status gate\r\n/app/tblkit          mill glue\r\n/app/unitpit         C units\r\n/app/lotbay          dumps\r\n/app/inkwell         span.atlas and clip.out\r\n/app/touchbay        optional touch list some desks keep around\r\n/app/baycard         grammar\r\n\r\nSymptom on this bench: clip of shift.dmp shows a neighbour body even though\r\nreknit returns success. Other dumps that still sit on their original units\r\nalready clip cleanly.\r\n\r\nA later row for the same name can look tempting when a unit recently moved.\r\nTwin helper names in two live units still have to clip from the dump's own unit.\r\nGrade-time dumps may appear under /app/lotbay and extra units under /app/unitpit.\r\n"]
[11.081548, "o", "\r\n"]
[11.081825, "o", "--- forms.txt ---\r\n"]
[11.083461, "o", "Atlas files begin with SPAN1 then one row per line:\r\n<name> <abspath> <lo> <hi>\r\nlo and hi are 1-based inclusive source lines.\r\n\r\nDump files begin with DUMP1 then one line:\r\n<name> <abspath> <line>\r\n\r\nclip.out begins with CLIP <name> then the extracted source lines.\r\n"]
[11.083835, "o", "\u001b[?2004hroot@64c0f1f03ef9:/app# "]
[11.260252, "i", "printf '\\n--- files ---\\n'; file /app/bin/lotxref /app/lotbay/shift.dmp /app/inkwell/span.atlas /app/inkwell/clip.out; printf '\\n--- dump ---\\n'; cat /app/lotbay/shift.dmp; printf '\\n--- atlas ---\\n'; cat /app/inkwell/span.atlas; printf '\\n--- current clip ---\\n'; cat /app/inkwell/clip.out\n"]
[11.261383, "o", "printf '\\n--- files ---\\n'; file /app/bin/lotxref /app/lotbay/shift.dmp /app/inkwell/span.atlas /app/inkwell/clip.out; printf '\\n--- dump ---\\n'; cat /app/lotbay/shift.dmp; printf '\\n--- atlas ---\\n'; cat /app/inkwell/span.atlas; printf '\\n--- current clip ---\\n'; cat /app/inkwell/clip.out\r\n\u001b[?2004l\r"]
[11.261628, "o", "\r\n--- files ---\r\n"]
[11.277705, "o", "/app/bin/lotxref:        ELF 64-bit LSB executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, for GNU/Linux 3.2.0, not stripped\r\n"]
[11.298793, "o", "/app/lotbay/shift.dmp:   ASCII text\r\n"]
[11.303625, "o", "/app/inkwell/span.atlas: Hewlett-Packard Graphics Language, starting with \"SPAN1\" with \"shift_move\"\r\n/app/inkwell/clip.out:   cannot open `/app/inkwell/clip.out' (No such file or directory)\r\n"]
[11.305396, "o", "\r\n--- dump ---\r\n"]
[11.30638, "o", "DUMP1\r\nshift_move /app/unitpit/gamma/shift.c 8\r\n"]
[11.306566, "o", "\r\n--- atlas ---\r\n"]
[11.307465, "o", "SPAN1\r\nshift_move /app/unitpit/gamma/prior.c 1 4\r\nidle_stub /app/unitpit/gamma/shift.c 1 4\r\nhelper_q /app/unitpit/beta/aux.c 1 4\r\nhelper_q /app/unitpit/alpha/aux.c 1 4\r\npump_fill /app/unitpit/alpha/pump.c 1 4\r\ntank_drain /app/unitpit/beta/tank.c 1 4\r\n"]
[11.307667, "o", "\r\n--- current clip ---\r\n"]
[11.308694, "o", "cat: /app/inkwell/clip.out: No such file or directory\r\n"]
[11.308969, "o", "\u001b[?2004h"]
[11.309058, "o", "root@64c0f1f03ef9:/app# "]
[11.420172, "i", "printf '\\n--- source files ---\\n'; find /app -maxdepth 4 -type f -not -path '/app/bin/*' -not -path '/app/inkwell/*' -printf '%p\\n' | sort\n"]
[11.420886, "o", "printf '\\n--- source files ---\\n'; find /app -maxdepth 4 -type f -not -path '/app/bin/*' -not -path '/app/inkwell/*' -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[11.421018, "o", "\r\n--- source files ---\r\n"]
[11.427404, "o", "/app/baycard/BAY_NOTES.txt\r\n/app/baycard/forms.txt\r\n/app/cupeel/pick.c\r\n/app/drygate/gap.c\r\n/app/lotbay/pump.dmp\r\n/app/lotbay/shift.dmp\r\n/app/lotbay/twin.dmp\r\n/app/sidecue/mtime.c\r\n/app/sidecue/mtime.h\r\n/app/slitmill/scan.c\r\n/app/tblkit/gap.h\r\n/app/tblkit/hull.mk\r\n/app/tblkit/hull_cli.c\r\n/app/tblkit/pick.h\r\n/app/tblkit/scan.h\r\n/app/tblkit/token.c\r\n/app/tblkit/token.h\r\n/app/touchbay/delta.lst\r\n/app/unitpit/alpha/aux.c\r\n/app/unitpit/alpha/pump.c\r\n/app/unitpit/beta/aux.c\r\n/app/unitpit/beta/tank.c\r\n/app/unitpit/gamma/shift.c\r\n"]
[11.427858, "o", "\u001b[?2004hroot@64c0f1f03ef9:/app# "]
[11.645584, "i", "/app/bin/lotxref reknit; printf 'reknit_status=%s\\n' \"$?\"; /app/bin/lotxref clip; printf 'clip_status=%s\\n' \"$?\"; printf '%s\\n' '--- regenerated atlas ---'; cat /app/inkwell/span.atlas; printf '%s\\n' '--- regenerated clip ---'; cat /app/inkwell/clip.out\n"]
[11.646425, "o", "/app/bin/lotxref reknit; printf 'reknit_status=%s\\n' \"$?\"; /app/bin/lotxref clip; printf 'clip_status=%s\\n' \"$?\"; printf '%s\\n' '--- regenerated atlas ---'; cat /app/inkwell/span.atlas; printf '%s\\n' '--- regenerated clip ---'; cat /app/inkwell/clip.out\r\n\u001b[?2004l\r"]
[11.64819, "o", "reknit_status=0\r\n"]
[11.648998, "o", "usage: lotxref reknit|clip PATH\r\n"]
[11.649123, "o", "clip_status=2\r\n--- regenerated atlas ---\r\n"]
[11.650586, "o", "SPAN1\r\nshift_move /app/unitpit/gamma/prior.c 1 4\r\nidle_stub /app/unitpit/gamma/shift.c 1 4\r\nhelper_q /app/unitpit/beta/aux.c 1 4\r\nhelper_q /app/unitpit/alpha/aux.c 1 4\r\npump_fill /app/unitpit/alpha/pump.c 1 4\r\ntank_drain /app/unitpit/beta/tank.c 1 4\r\n"]
[11.65145, "o", "--- regenerated clip ---\r\n"]
[11.653212, "o", "cat: /app/inkwell/clip.out: No such file or directory\r\n"]
[11.653756, "o", "\u001b[?2004hroot@64c0f1f03ef9:/app# "]
[21.173483, "i", "printf '%s\\n' '--- hull.mk ---'; cat /app/tblkit/hull.mk; for f in /app/tblkit/*.[ch] /app/slitmill/*.[ch] /app/cupeel/*.[ch] /app/drygate/*.[ch] /app/sidecue/*.[ch]; do [ -f \"$f\" ] || continue; printf '\\n--- %s ---\\n' \"$f\"; sed -n '1,260p' \"$f\"; done\n"]
[21.175127, "o", "printf '%s\\n' '--- hull.mk ---'; cat /app/tblkit/hull.mk; for f in /app/tblkit/*.[ch] /app/slitmill/*.[ch] /app/cupeel/*.[ch] /app/drygate/*.[ch] /app/sidecue/*.[ch]; do [ -f \"$f\" ] || continue; printf '\\n--- %s ---\\n' \"$f\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r--- hull.mk ---\r\n"]
[21.176761, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -I/app/tblkit -I/app/slitmill -I/app/cupeel -I/app/drygate -I/app/sidecue\r\nSRC := $(wildcard /app/tblkit/*.c) $(wildcard /app/slitmill/*.c) $(wildcard /app/cupeel/*.c) $(wildcard /app/drygate/*.c) $(wildcard /app/sidecue/*.c)\r\nBIN := /app/bin/lotxref\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/inkwell\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[21.178239, "o", "\r\n--- /app/tblkit/gap.h ---\r\n"]
[21.184341, "o", "#ifndef GAP_H\r\n#define GAP_H\r\nint n_miss(void);\r\n#endif\r\n"]
[21.185042, "o", "\r\n--- /app/tblkit/hull_cli.c ---\r\n"]
[21.186891, "o", "#include \"scan.h\"\r\n#include \"pick.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"usage: lotxref reknit|clip PATH\\n\");\r\n        return 2;\r\n    }\r\n    if (strcmp(argv[1], \"reknit\") == 0) return op_a();\r\n    if (strcmp(argv[1], \"clip\") == 0 && argc >= 3) return op_b(argv[2]);\r\n    fprintf(stderr, \"usage: lotxref reknit|clip PATH\\n\");\r\n    return 2;\r\n}\r\n"]
[21.188418, "o", "\r\n--- /app/tblkit/pick.h ---\r\n"]
[21.191222, "o", "#ifndef PICK_H\r\n#define PICK_H\r\nint op_b(const char *p);\r\n#endif\r\n"]
[21.191743, "o", "\r\n--- /app/tblkit/scan.h ---\r\n"]
[21.193648, "o", "#ifndef SCAN_H\r\n#define SCAN_H\r\nint op_a(void);\r\n#endif\r\n"]
[21.194184, "o", "\r\n--- /app/tblkit/token.c ---\r\n"]
[21.196018, "o", "#include \"token.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\nint file_here(const char *path) {\r\n    struct stat st;\r\n    return path && path[0] && stat(path, &st) == 0 && S_ISREG(st.st_mode);\r\n}\r\n\r\nstatic int is_c_name(const char *n) {\r\n    size_t L = strlen(n);\r\n    return L > 2 && n[L - 2] == '.' && n[L - 1] == 'c';\r\n}\r\n\r\nstatic void walk_rec(const char *dir, char paths[][PATH_MAX_X], int *n, int max) {\r\n    DIR *d = opendir(dir);\r\n    if (!d) return;\r\n    struct dirent *ent;\r\n    while ((ent = readdir(d)) != NULL && *n < max) {"]
[21.196107, "o", "\r\n        if (ent->d_name[0] == '.') continue;\r\n        char sub[PATH_MAX_X];\r\n        snprintf(sub, sizeof sub, \"%s/%s\", dir, ent->d_name);\r\n        struct stat st;\r\n        if (stat(sub, &st) != 0) continue;\r\n        if (S_ISDIR(st.st_mode)) walk_rec(sub, paths, n, max);\r\n        else if (S_ISREG(st.st_mode) && is_c_name(ent->d_name)) {\r\n            snprintf(paths[*n], PATH_MAX_X, \"%s\", sub);\r\n            (*n)++;\r\n        }\r\n    }\r\n    closedir(d);\r\n}\r\n\r\nint walk_units(const char *root, char paths[][PATH_MAX_X], int max) {\r\n    int n = 0;\r\n    walk_rec(root, paths, &n, max);\r\n    return n;\r\n}\r\n\r\nint parse_unit(const char *path, Row *rows, int max) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return 0;\r\n"]
[21.196309, "o", "    char line[512];\r\n    int lineno = 0, n = 0, open_lo = 0;\r\n    char cur[NAME_MAX];\r\n    cur[0] = 0;\r\n    while (fgets(line, sizeof line, f)) {\r\n        lineno++;\r\n        char nm[NAME_MAX];\r\n        if (sscanf(line, \"void %63[A-Za-z0-9_](\", nm) == 1) {\r\n            snprintf(cur, sizeof cur, \"%s\", nm);\r\n"]
[21.196421, "o", "            open_lo = lineno;\r\n        } else if (cur[0] && (strcmp(line, \"}\\n\") == 0 || strcmp(line, \"}\\r\\n\") == 0 || strcmp(line, \"}\") == 0)) {\r\n            if (n < max) {\r\n                snprintf(rows[n].name, NAME_MAX, \"%s\", cur);\r\n                snprintf(rows[n].path, PATH_MAX_X, \"%s\", path);\r\n                rows[n].lo = open_lo;\r\n                rows[n].hi = lineno;\r\n                n++;\r\n            }\r\n            cur[0] = 0;\r\n        }\r\n    }\r\n    fclose(f);\r\n    return n;\r\n}\r\n\r\nint parse_lot(const char *path, char *name, char *orig, int *line) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return -1;\r\n    char hdr[64];\r\n    if (!fgets(hdr, sizeof hdr, f)) { fclose(f); return -1; }\r\n    if (strncmp(hdr, \"DUMP1\", 5) != 0) { fclose(f); return -1; }\r\n    char rest[512];\r\n    if (!fgets(rest, sizeof rest, f)) { fclose(f); return -1; }\r\n    fclose(f);\r\n    if (sscanf(rest, \"%63s %255s %d\", name, orig, line) != 3) return -1;\r\n    return 0;\r\n}\r\n\r\nint load_tbl(const char *path, Row *rows, int max) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return 0;\r\n    char line[512];\r\n    if (!fgets(line, sizeof line, f)) { fclose(f); return 0; }\r\n    int n = 0;\r\n    while (fgets(line, sizeof line, f) && n < max) {\r\n        if (sscanf(line, \"%63s %255s %d %d\", rows[n].name, rows[n].path, &rows[n].lo, &rows[n].hi) == 4)\r\n            n++;\r\n    }\r\n    fclose(f);\r\n    return n;\r\n}\r\n\r\nint save_tbl(const char *path, Row *rows, int n) {\r\n    FILE *f = fopen(path, \"w\");\r\n    if (!f) return -1;\r\n    fprintf(f, \"SPAN1\\n\");\r\n    for (int i = 0; i < n; i++)\r\n        fprintf(f, \"%s %s %d %d\\n\", rows[i].name, rows[i].path, rows[i].lo, rows[i].hi);\r\n    fclose(f);\r\n    return 0;\r\n}\r\n\r\nint extract_span(const char *path, int lo, int hi, char *out, int cap) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) { out[0] = 0; return -1; }\r\n    char line[512];\r\n    int lineno = 0, used = 0;\r\n    out[0] = 0;\r\n    while (fgets(line, sizeof line, f)) {\r\n        lineno++;\r\n        if (lineno < lo || lineno > hi) continue;\r\n        int L = (int)strlen(line);\r\n        if (used + L + 1 >= cap) break;\r\n        memcpy(out + used, line, L);\r\n        used += L;\r\n        out[used] = 0;\r\n    }\r\n    fclose(f);\r\n    return 0;\r\n}\r\n"]
[21.19685, "o", "\r\n--- /app/tblkit/token.h ---\r\n"]
[21.198714, "o", "#ifndef TOKEN_H\r\n#define TOKEN_H\r\nenum { ROW_MAX = 128, NAME_MAX = 64, PATH_MAX_X = 256 };\r\ntypedef struct {\r\n    char name[NAME_MAX];\r\n    char path[PATH_MAX_X];\r\n    int lo;\r\n    int hi;\r\n} Row;\r\nint parse_unit(const char *path, Row *rows, int max);\r\nint parse_lot(const char *path, char *name, char *orig, int *line);\r\nint load_tbl(const char *path, Row *rows, int max);\r\nint save_tbl(const char *path, Row *rows, int n);\r\nint walk_units(const char *root, char paths[][PATH_MAX_X], int max);\r\nint extract_span(const char *path, int lo, int hi, char *out, int cap);\r\nint file_here(const char *path);\r\n#endif\r\n"]
[21.200159, "o", "\r\n--- /app/slitmill/scan.c ---\r\n"]
[21.204592, "o", "#include \"scan.h\"\r\n#include \"token.h\"\r\n#include \"gap.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\nstatic int find_name(Row *rows, int n, const char *name) {\r\n    for (int i = 0; i < n; i++) {\r\n        if (strcmp(rows[i].name, name) == 0) return i;\r\n    }\r\n    return -1;\r\n}\r\n\r\nint op_a(void) {\r\n    mkdir(\"/app/inkwell\", 0755);\r\n    if (n_miss() != 0) return 1;\r\n\r\n    Row rows[ROW_MAX];\r\n    int n = load_tbl(\"/app/inkwell/span.atlas\", rows, ROW_MAX);\r\n\r\n"]
[21.206541, "o", "    FILE *df = fopen(\"/app/touchbay/delta.lst\", \"r\");\r\n    if (df) {\r\n        char pth[PATH_MAX_X];\r\n        while (fgets(pth, sizeof pth, df)) {\r\n            size_t L = strlen(pth);\r\n            while (L && (pth[L - 1] == '\\n' || pth[L - 1] == '\\r')) pth[--L] = 0;\r\n            if (!L) continue;\r\n            Row got[32];\r\n            int k = parse_unit(pth, got, 32);\r\n            for (int i = 0; i < k; i++) {\r\n                int idx = find_name(rows, n, got[i].name);\r\n                if (idx >= 0) continue;\r\n                if (n < ROW_MAX) rows[n++] = got[i];\r\n            }\r\n        }\r\n        fclose(df);\r\n    }\r\n    save_tbl(\"/app/inkwell/span.atlas\", rows, n);\r\n    return n_miss();\r\n}\r\n\r\n--- /app/cupeel/pick.c ---\r\n"]
[21.207152, "o", "#include \"pick.h\"\r\n#include \"token.h\"\r\n#include \"mtime.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\nint op_b(const char *p) {\r\n    mkdir(\"/app/inkwell\", 0755);\r\n    char name[NAME_MAX], orig[PATH_MAX_X];\r\n"]
[21.207318, "o", "    int line = 0;\r\n    if (parse_lot(p, name, orig, &line) != 0) return 2;\r\n\r\n    Row rows[ROW_MAX];\r\n    int n = load_tbl(\"/app/inkwell/span.atlas\", rows, ROW_MAX);\r\n    int idx = -1;\r\n    for (int i = 0; i < n; i++) {\r\n        if (strcmp(rows[i].name, name) == 0) { idx = i; break; }\r\n    }\r\n    (void)pick_last;\r\n    if (idx < 0) return 1;\r\n\r\n    const char *use = rows[idx].path;\r\n    if (!file_here(use)) use = orig;\r\n\r\n    char body[8192];\r\n    extract_span(use, rows[idx].lo, rows[idx].hi, body, sizeof body);\r\n\r\n    FILE *out = fopen(\"/app/inkwell/clip.out\", \"w\");\r\n    if (!out) return 1;\r\n    fprintf(out, \"CLIP %s\\n%s\", name, body);\r\n    fclose(out);\r\n    return 0;\r\n}\r\n"]
[21.207747, "o", "\r\n--- /app/drygate/gap.c ---\r\n"]
[21.209676, "o", "#include \"gap.h\"\r\n#include \"token.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint n_miss(void) {\r\n    DIR *d = opendir(\"/app/lotbay\");\r\n    int seen = 0;\r\n    if (d) {\r\n        struct dirent *ent;\r\n        while ((ent = readdir(d)) != NULL) {\r\n            if (ent->d_name[0] != '.') seen++;\r\n"]
[21.209727, "o", "        }\r\n        closedir(d);\r\n    }\r\n    (void)seen;\r\n    return 0;\r\n}\r\n"]
[21.210078, "o", "\r\n--- /app/sidecue/mtime.c ---\r\n"]
[21.211966, "o", "#include \"mtime.h\"\r\n#include <string.h>\r\n\r\nint pick_last(Row *rows, int n, const char *name) {\r\n    int idx = -1;\r\n    for (int i = 0; i < n; i++) {\r\n        if (strcmp(rows[i].name, name) == 0) idx = i;\r\n    }\r\n    return idx;\r\n}\r\n"]
[21.213319, "o", "\r\n--- /app/sidecue/mtime.h ---\r\n"]
[21.215719, "o", "#ifndef MTIME_H\r\n#define MTIME_H\r\n#include \"token.h\"\r\nint pick_last(Row *rows, int n, const char *name);\r\n#endif\r\n"]
[21.216078, "o", "\u001b[?2004h"]
[21.21666, "o", "root@64c0f1f03ef9:/app# "]
[21.355019, "i", "for f in $(find /app/unitpit -type f | sort); do printf '\\n--- %s ---\\n' \"$f\"; nl -ba \"$f\"; done; for f in /app/lotbay/*.dmp; do printf '\\n--- %s ---\\n' \"$f\"; cat \"$f\"; done; printf '\\n--- touch list ---\\n'; cat /app/touchbay/delta.lst\n"]
[21.355967, "o", "for f in $(find /app/unitpit -type f | sort); do printf '\\n--- %s ---\\n' \"$f\"; nl -ba \"$f\"; done; for f in /app/lotbay/*.dmp; do printf '\\n--- %s ---\\n' \"$f\"; cat \"$f\"; done; printf '\\n--- touch list ---\\n'; cat /app/touchbay/delta.lst\r\n\u001b[?2004l\r"]
[21.359043, "o", "\r\n--- /app/unitpit/alpha/aux.c ---\r\n"]
[21.360061, "o", "     1\tvoid helper_q(void)\r\n     2\t{\r\n     3\t    /* ALPHA_MARK */\r\n     4\t}\r\n"]
[21.360257, "o", "\r\n--- /app/unitpit/alpha/pump.c ---\r\n"]
[21.361282, "o", "     1\tvoid pump_fill(void)\r\n     2\t{\r\n     3\t    /* PUMP_MARK */\r\n     4\t}\r\n"]
[21.361494, "o", "\r\n--- /app/unitpit/beta/aux.c ---\r\n"]
[21.362503, "o", "     1\tvoid helper_q(void)\r\n     2\t{\r\n     3\t    /* BETA_MARK */\r\n     4\t}\r\n"]
[21.362717, "o", "\r\n--- /app/unitpit/beta/tank.c ---\r\n"]
