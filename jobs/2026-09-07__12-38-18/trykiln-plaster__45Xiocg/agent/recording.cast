[10.041875, "i", "printf '%s\\n' '--- vats ---'; for f in /app/vats/*.vat; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- migrations ---'; find /app/inkstack/migrations -maxdepth 1 -type f -name '*.sql' -printf '%f\\n' | sort; printf '%s\\n' '--- source matches ---'; grep -RInE 'attempt_slot|schema_version|assay|spill|KILNVAT|applied:' /app --exclude='*.vat' --exclude='kilncli' 2>/dev/null | head -300\n"]
[10.043305, "o", "printf '%s\\n' '--- vats ---'; for f in /app/vats/*.vat; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- migrations ---'; find /app/inkstack/migrations -maxdepth 1 -type f -name '*.sql' -printf '%f\\n' | sort; printf '%s\\n' '--- source matches ---'; grep -RInE 'attempt_slot|schema_version|assay|spill|KILNVAT|applied:' /app --exclude='*.vat' --exclude='kilncli' 2>/dev/null | head -300\r\n\u001b[?2004l\r"]
