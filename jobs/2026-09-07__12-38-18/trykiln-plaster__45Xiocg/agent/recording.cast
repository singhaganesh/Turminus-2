[19.596932, "o", "\u001b[?2004hroot@64e72d0d917e:/app# "]
[43.461889, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/hopsrc/imprint/imprint.go')\ns = p.read_text()\ns = s.replace('''func Imprint(vatPath string) error {\n focus, err := os.ReadFile(\"/app/hearth/focus.txt\")\n if err == nil {\n   vatPath = strings.TrimSpace(string(focus))\n }\n return applyAll(vatPath)\n}''', '''func Imprint(vatPath string) error {\n if strings.TrimSpace(vatPath) == \"\" {\n   focus, err := os.ReadFile(\"/app/hearth/focus.txt\")\n   if err != nil {\n     return err\n   }\n   vatPath = strings.TrimSpace(string(focus))\n }\n return applyAll(vatPath)\n}''')\np.write_text(s)\nPY\ncat > /app/claybin/emit.go <<'EOF'\npackage claybin\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\n\t\"kilnbench/hopsrc/vat\"\n)\n\nconst (\n\tsrc     = \"/app/vats/plaster.vat\"\n\tdst     = \"/app/vats/worker.vat\"\n\tmigDir  = \"/app/inkstack/migrations\"\n\tokPath  = \"/app/vats/assay.ok\"\n)\n\nfunc EmitWorker() error {\n\t// A previous successful assay must never survive a failed spill.\n\tif err := os.Remove(okPath); err != nil && !os.IsNotExist(err) {\n\t\treturn err\n\t}\n\n\tst, err := vat.Parse(src)\n\tif err != nil {\n\t\treturn err\n\t}\n\thead, err := vat.LedgerHead(migDir)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif st.LastApplied() != head {\n\t\treturn fmt.Errorf(\"source schema_version=%s, ledger head=%s\", st.LastApplied(), head)\n\t}\n\treturn vat.CopyFile(src, dst)\n}\nEOF\ncat > /app/scorepit/score.go <<'EOF'\npackage scorepit\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\n\t\"kilnbench/hopsrc/vat\"\n)\n\nconst (\n\tworker = \"/app/vats/worker.vat\"\n\tokPath = \"/app/vats/assay.ok\"\n\tmigDir = \"/app/inkstack/migrations\"\n)\n\nfunc ScoreWorker() int {\n\t// Never allow a marker from an earlier run to represent this assay.\n\tif err := os.Remove(okPath); err != nil && !os.IsNotExist(err) {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\n\tst, err := vat.Parse(worker)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\tversion := st.LastApplied()\n\tfmt.Printf(\"schema_version=%s\\n\", version)\n\n\thead, err := vat.LedgerHead(migDir)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\tif version != head {\n\t\tfmt.Fprintf(os.Stderr, \"schema_version %s lags ledger head %s\\n\", version, head)\n\t\treturn 1\n\t}\n\tif !st.HasCol(\"attempt_slot\") {\n\t\tfmt.Fprintln(os.Stderr, \"unknown-column: attempt_slot\")\n\t\treturn 1\n\t}\n\tif err := os.WriteFile(okPath, []byte(\"ok\\n\"), 0644); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\treturn 0\n}\nEOF\n/usr/local/go/bin/gofmt -w /app/hopsrc/imprint/imprint.go /app/claybin/emit.go /app/scorepit/score.go\nmake ship\n"]
[43.462133, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[43.462463, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
