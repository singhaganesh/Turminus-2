[19.037383, "i", "printf '%s\\n' '--- Makefile/go.mod/docs ---'; cat Makefile go.mod baydocs/OPS.txt hearth/focus.txt inkstack/intent.toml; printf '%s\\n' '--- Go sources ---'; for f in hopsrc/vat/store.go hopsrc/imprint/imprint.go claybin/borrow.go claybin/emit.go scorepit/score.go scorepit/shim.go kilncli/*.go; do echo \"### $f\"; sed -n '1,240p' \"$f\"; done; printf '%s\\n' '--- SQL ---'; for f in inkstack/migrations/*.sql; do echo \"### $f\"; cat \"$f\"; done\n"]
[19.039648, "o", "printf '%s\\n' '--- Makefile/go.mod/docs ---'; cat Makefile go.mod baydocs/OPS.txt hearth/focus.txt inkstack/intent.toml; printf '%s\\n' '--- Go sources ---'; for f in hopsrc/vat/store.go hopsrc/imprint/imprint.go claybin/borrow.go claybin/emit.go scorepit/score.go scorepit/shim.go kilncli/*.go; do echo \"### $f\"; sed -n '1,240p' \"$f\"; done; printf '%s\\n' '--- SQL ---'; for f in inkstack/migrations/*.sql; do echo \"### $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[19.040062, "o", "--- Makefile/go.mod/docs ---\r\n"]
[19.041982, "o", ".PHONY: ship\r\n\r\nship:\r\n\tmkdir -p /app/bin\r\n\t/usr/local/go/bin/go build -o /app/bin/kilncli ./kilncli\r\nmodule kilnbench\r\n\r\ngo 1.24\r\n"]
[19.042188, "o", "Nightly assay scores a spilled worker vat. The hearth focus file names a\r\nworkspace vat operators use for local impress trials. Assay prints\r\nschema_version from the worker vat. Compat helpers under scorepit exist for\r\nlab pads when a column is missing on a scratch vat. assay.ok is false when\r\nthe worker applied stem lags the ledger head.\r\n\r\n"]
[19.0423, "o", "/app/vats/bench.vat\r\n"]
[19.04233, "o", "[tries]\r\ncolumns = [\"id\", \"label\", \"attempt_slot\"]\r\n"]
[19.042605, "o", "--- Go sources ---\r\n"]
[19.042696, "o", "### hopsrc/vat/store.go\r\n"]
[19.044691, "o", "package vat\r\n"]
[19.045148, "o", "\r\nimport (\r\n\t\"bufio\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n)\r\n\r\nconst magic = \"KILNVAT 1\"\r\n\r\ntype Store struct {\r\n\tApplied []string\r\n"]
[19.045206, "o", "\tTable   string\r\n\tCols    []string\r\n\tRows    [][]string\r\n}\r\n\r\nfunc Parse(path string) (*Store, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\ts := &Store{}\r\n\tsc := bufio.NewScanner(f)\r\n\tif !sc.Scan() {\r\n\t\treturn nil, fmt.Errorf(\"empty vat\")\r\n\t}\r\n\tif strings.TrimSpace(sc.Text()) != magic {\r\n\t\treturn nil, fmt.Errorf(\"bad magic\")\r\n\t}\r\n"]
[19.045372, "o", "\tfor sc.Scan() {\r\n\t\tline := strings.TrimSpace(sc.Text())\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tswitch {\r\n\t\tcase strings.HasPrefix(line, \"applied:\"):\r\n\t\t\ts.Applied = append(s.Applied, strings.TrimPrefix(line, \"applied:\"))\r\n\t\tcase strings.HasPrefix(line, \"table:\"):\r\n\t\t\ts.Table = strings.TrimPrefix(line, \"table:\")\r\n\t\tcase strings.HasPrefix(line, \"cols:\"):\r\n\t\t\ts.Cols = strings.Split(strings.TrimPrefix(line, \"cols:\"), \",\")\r\n\t\tcase strings.HasPrefix(line, \"row:\"):\r\n\t\t\ts.Rows = append(s.Rows, strings.Split(strings.TrimPrefix(line, \"row:\"), \",\"))\r\n\t\t}\r\n\t}\r\n\treturn s, sc.Err()\r\n}\r\n\r\nfunc (s *Store) Write(path string) error {\r\n\tvar b strings.Builder\r\n\tb.WriteString(magic)\r\n\tb.WriteByte('\\n')\r\n\tfor _, a := range s.Applied {\r\n\t\tb.WriteString(\"applied:\")\r\n\t\tb.WriteString(a)\r\n\t\tb.WriteByte('\\n')\r\n\t}\r\n\tb.WriteString(\"table:\")\r\n\tb.WriteString(s.Table)\r\n\tb.WriteByte('\\n')\r\n\tb.WriteString(\"cols:\")\r\n\tb.WriteString(strings.Join(s.Cols, \",\"))\r\n\tb.WriteByte('\\n')\r\n\tfor _, r := range s.Rows {\r\n\t\tb.WriteString(\"row:\")\r\n\t\tb.WriteString(strings.Join(r, \",\"))\r\n\t\tb.WriteByte('\\n')\r\n\t}\r\n\treturn os.WriteFile(path, []byte(b.String()), 0644)\r\n}\r\n\r\nfunc (s *Store) LastApplied() string {\r\n\tif len(s.Applied) == 0 {\r\n\t\treturn \"\"\r\n\t}\r\n\treturn s.Applied[len(s.Applied)-1]\r\n}\r\n\r\nfunc (s *Store) HasApplied(stem string) bool {\r\n\tfor _, a := range s.Applied {\r\n\t\tif a == stem {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (s *Store) HasCol(name string) bool {\r\n\tfor _, c := range s.Cols {\r\n\t\tif c == name {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\t"]
[19.045405, "o", "return false\r\n}\r\n\r\nfunc (s *Store) AddCol(name string) {\r\n\tif s.HasCol(name) {\r\n\t\treturn\r\n\t}\r\n\ts.Cols = append(s.Cols, name)\r\n\tfor i := range s.Rows {\r\n\t\ts.Rows[i] = append(s.Rows[i], \"0\")\r\n\t}\r\n}\r\n\r\n"]
[19.045434, "o", "func LedgerHead(migDir string) (string, error) {\r\n\tmatches, err := filepath.Glob(filepath.Join(migDir, \"*.sql\"))\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tif len(matches) == 0 {\r\n\t\treturn \"\", fmt.Errorf(\"no sql\")\r\n"]
[19.04545, "o", "\t}\r\n\tsort.Strings(matches)\r\n\tbase := filepath.Base(matches[len(matches)-1])\r\n\treturn strings.TrimSuffix(base, \".sql\"), nil\r\n}\r\n\r\nfunc Stem(path string) string {\r\n\tbase := filepath.Base(path)\r\n"]
[19.045988, "o", "\treturn strings.TrimSuffix(base, \".sql\")\r\n}\r\n\r\nfunc CopyFile(src, dst string) error {\r\n\tb, err := os.ReadFile(src)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(dst, b, 0644)\r\n}\r\n"]
[19.046176, "o", "### hopsrc/imprint/imprint.go\r\n"]
[19.048325, "o", "package imprint\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\r\n\t\"kilnbench/hopsrc/vat\"\r\n)\r\n\r\nconst migDir = \"/app/inkstack/migrations\"\r\n\r\nfunc Imprint(vatPath string) error {\r\n\tfocus, err := os.ReadFile(\"/app/hearth/focus.txt\")\r\n\tif err == nil {\r\n"]
[19.04856, "o", "\t\tvatPath = strings.TrimSpace(string(focus))\r\n\t}\r\n\treturn applyAll(vatPath)\r\n}\r\n\r\nfunc applyAll(vatPath string) error {\r\n\tmatches, err := listSQL(migDir)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tst, err := vat.Parse(vatPath)\r\n\tif err != nil {\r\n\t\tst = &vat.Store{Table: \"tries\", Cols: []string{}, Rows: nil}\r\n\t}\r\n\tfor _, m := range matches {\r\n\t\tstem := vat.Stem(m)\r\n\t\tif st.HasApplied(stem) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tbody, err := os.ReadFile(m)\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif err := runSQL(st, string(body)); err != nil {\r\n\t\t\treturn fmt.Errorf(\"%s: %w\", stem, err)\r\n\t\t}\r\n\t\tst.Applied = append(st.Applied, stem)\r\n\t}\r\n\treturn st.Write(vatPath)\r\n}\r\n\r\nfunc listSQL(dir string) ([]string, error) {\r\n\tmatches, err := filepath.Glob(filepath.Join(dir, \"*.sql\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tsort.Strings(matches)\r\n\treturn matches, nil\r\n}\r\n"]
[19.048874, "o", "\r\nfunc runSQL(st *vat.Store, body string) error {\r\n\tfor _, raw := range strings.Split(body, \";\") {\r\n\t\tline := strings.Join(strings.Fields(raw), \" \")\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tu := strings.ToUpper(line)\r\n\t\tswitch {\r\n\t\tcase strings.HasPrefix(u, \"CREATE TABLE\"):\r\n\t\t\trest := strings.TrimSpace(line[len(\"CREATE TABLE\"):])\r\n\t\t\tname, cols, ok := parseCreate(rest)\r\n\t\t\tif !ok {\r\n\t\t\t\treturn fmt.Errorf(\"create parse\")\r\n\t\t\t}\r\n\t\t\tst.Table = name\r\n\t\t\tst.Cols = cols\r\n\t\t\tif len(st.Rows) == 0 {\r\n\t\t\t\trow := make([]string, len(cols))\r\n\t\t\t\tfor i := range row {\r\n\t\t\t\t\tif cols[i] == \"id\" {\r\n\t\t\t\t\t\trow[i] = \"1\"\r\n\t\t\t\t\t} else if cols[i] == \"label\" {\r\n\t\t\t\t\t\trow[i] = \"boot\"\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\trow[i] = \"0\"\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tst.Rows = [][]string{row}\r\n\t\t\t}\r\n\t\tcase strings.Contains(u, \"ADD COLUMN\"):\r\n\t\t\tidx := strings.Index(u, \"ADD COLUMN\")\r\n\t\t\tcol := strings.Fields(line[idx+len(\"ADD COLUMN\"):])\r\n\t\t\tif len(col) == 0 {\r\n\t\t\t\treturn fmt.Errorf(\"add column\")\r\n\t\t\t}\r\n\t\t\tst.AddCol(col[0])\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc parseCreate(rest string) (string, []string, bool) {\r\n\ti := strings.Index(rest, \"(\")\r\n\tj := strings.Index(rest, \")\")\r\n\tif i < 0 || j < 0 || j <= i {\r\n\t\treturn \"\", nil, false\r\n\t}\r\n\tname := strings.TrimSpace(rest[:i])\r\n\tinner := rest[i+1 : j]\r\n\tparts := strings.Split(inner, \",\")\r\n\tcols := make([]string, 0, len(parts))\r\n\tfor _, p := range parts {\r\n\t\tp = strings.TrimSpace(p)\r\n\t\tif p == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tcols = append(cols, p)\r\n\t}\r\n\treturn name, cols, name != \"\" && len(cols) > 0\r\n}\r\n"]
[19.049116, "o", "### claybin/borrow.go\r\n"]
[19.052185, "o", "package claybin\r\n\r\nimport \"kilnbench/hopsrc/vat\"\r\n\r\nfunc BorrowBench() error {\r\n\treturn vat.CopyFile(\"/app/vats/bench.vat\", \"/app/vats/worker.vat\")\r\n}\r\n### claybin/emit.go\r\n"]
[19.053796, "o", "package claybin\r\n\r\nimport \"kilnbench/hopsrc/vat\"\r\n\r\nconst src = \"/app/vats/mold.vat\"\r\nconst dst = \"/app/vats/worker.vat\"\r\n\r\nfunc EmitWorker() error {\r\n\treturn vat.CopyFile(src, dst)\r\n}\r\n"]
[19.054366, "o", "### scorepit/score.go\r\n"]
[19.055791, "o", "package scorepit\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\r\n\t\"kilnbench/hopsrc/vat\"\r\n)\r\n\r\nconst worker = \"/app/vats/worker.vat\"\r\nconst okPath = \"/app/vats/assay.ok\"\r\n\r\nfunc ScoreWorker() int {\r\n\tst, err := vat.Parse(worker)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\tfmt.Printf(\"schema_version=%s\\n\", st.LastApplied())\r\n\tif !st.HasCol(\"attempt_slot\") {\r\n\t\tfmt.Fprintln(os.Stderr, \"unknown-column: attempt_slot\")\r\n"]
[19.055952, "o", "\t\treturn 1\r\n\t}\r\n\t_ = os.WriteFile(okPath, []byte(\"ok\\n\"), 0644)\r\n\treturn 0\r\n}\r\n"]
[19.056233, "o", "### scorepit/shim.go\r\n"]
[19.057841, "o", "package scorepit\r\n\r\nimport \"kilnbench/hopsrc/vat\"\r\n\r\nfunc PadSlot(path string) error {\r\n\tst, err := vat.Parse(path)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tst.AddCol(\"attempt_slot\")\r\n\treturn st.Write(path)\r\n}\r\n"]
[19.058461, "o", "### kilncli/cmd_assay.go\r\n"]
[19.060288, "o", "package main\r\n\r\nimport \"kilnbench/scorepit\"\r\n\r\nfunc cmdAssay() int {\r\n\treturn scorepit.ScoreWorker()\r\n}\r\n"]
[19.061065, "o", "### kilncli/cmd_impress.go\r\n"]
[19.063018, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\r\n\t\"kilnbench/hopsrc/imprint\"\r\n)\r\n\r\nfunc cmdImpress(args []string) int {\r\n\tpath := \"\"\r\n\tif len(args) > 0 {\r\n\t\tpath = args[0]\r\n\t}\r\n\tif err := imprint.Imprint(path); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[19.063723, "o", "### kilncli/cmd_spill.go\r\n"]
[19.066133, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\r\n\t\"kilnbench/claybin\"\r\n)\r\n\r\nfunc cmdSpill() int {\r\n\tif err := claybin.EmitWorker(); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[19.066647, "o", "### kilncli/main.go\r\n"]
[19.069718, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: kilncli impress|spill|assay\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"impress\":\r\n\t\tcode = cmdImpress(os.Args[2:])\r\n\tcase \"spill\":\r\n\t\tcode = cmdSpill()\r\n\tcase \"assay\":\r\n\t\tcode = cmdAssay()\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: kilncli impress|spill|assay\")\r\n\t\tcode = 2\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n"]
[19.070201, "o", "--- SQL ---\r\n"]
[19.070452, "o", "### inkstack/migrations/0003_base.sql\r\n"]
[19.071839, "o", "CREATE TABLE tries (id, label);\r\n"]
[19.072174, "o", "### inkstack/migrations/0004_attempt_slot.sql\r\n"]
[19.074464, "o", "ALTER TABLE tries ADD COLUMN attempt_slot;\r\n"]
[19.075123, "o", "\u001b[?2004hroot@64e72d0d917e:/app# "]
[19.552161, "i", "rm -f /app/vats/assay.ok; echo '--- current assay ---'; /app/bin/kilncli assay; echo \"assay_rc=$?\"; ls -l /app/vats/assay.ok 2>&1 || true; echo '--- current spill ---'; /app/bin/kilncli spill; echo \"spill_rc=$?\"; cat /app/vats/worker.vat; ls -l /app/vats/assay.ok 2>&1 || true; sha256sum /app/bin/kilncli\n"]
[19.553655, "o", "rm -f /app/vats/assay.ok; echo '--- current assay ---'; /app/bin/kilncli assay; echo \"assay_rc=$?\"; ls -l /app/vats/assay.ok 2>&1 || true; echo '--- current spill ---'; /app/bin/kilncli spill; echo \"spill_rc=$?\"; cat /app/vats/worker.vat; ls -l /app/vats/assay.ok 2>&1 || true; sha256sum /app/bin/kilncli\r\n\u001b[?2004l\r"]
