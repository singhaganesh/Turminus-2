[64.711684, "i", "set +e\ncp /app/vats/plaster.vat /tmp/plaster.good\ncp /app/vats/worker.vat /tmp/worker.good\nprintf 'stale\\n' > /app/vats/assay.ok\ncp /app/vats/mold.vat /app/vats/worker.vat\nout=$(/app/bin/kilncli assay 2>&1); rc=$?; printf 'lag-assay rc=%s marker=%s output=[%s]\\n' \"$rc\" \"$(test -e /app/vats/assay.ok && echo present || echo absent)\" \"$out\"\ncp /tmp/worker.good /app/vats/worker.vat\nprintf 'stale\\n' > /app/vats/assay.ok\ncp /app/vats/mold.vat /app/vats/plaster.vat\nout=$(/app/bin/kilncli spill 2>&1); rc=$?; printf 'lag-spill rc=%s marker=%s output=[%s]\\n' \"$rc\" \"$(test -e /app/vats/assay.ok && echo present || echo absent)\" \"$out\"\ncp /tmp/plaster.good /app/vats/plaster.vat\nprintf '%s\\n' '-- temporary migration' > /app/inkstack/migrations/9999_future.sql\nprintf 'stale\\n' > /app/vats/assay.ok\nout=$(/app/bin/kilncli spill 2>&1); rc=$?; printf 'new-head-spill rc=%s marker=%s output=[%s]\\n' \"$rc\" \"$(test -e /app/vats/assay.ok && echo present || echo absent)\" \"$out\"\nrm -f /app/inkstack/migrations/9999_future.sql\ncp /tmp/plaster.good /app/vats/plaster.vat\n/app/bin/kilncli spill && out=$(/app/bin/kilncli assay 2>&1); rc=$?\nprintf 'final-assay rc=%s marker=%s output=[%s]\\n' \"$rc\" \"$(test -e /app/vats/assay.ok && echo present || echo absent)\" \"$out\"\nset -e\n"]
