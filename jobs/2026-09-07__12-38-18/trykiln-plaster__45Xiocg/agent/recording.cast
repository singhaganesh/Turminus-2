[10.064439, "o", "/app/baydocs/BAY_NOTES.txt:5:  spill         fill /app/vats/worker.vat for assay\r\n/app/baydocs/BAY_NOTES.txt:6:  assay         read /app/vats/worker.vat, print schema_version, write /app/vats/assay.ok on success\r\n/app/baydocs/OPS.txt:1:Nightly assay scores a spilled worker vat. The hearth focus file names a\r\n/app/baydocs/OPS.txt:3:schema_version from the worker vat. Compat helpers under scorepit exist for\r\n/app/baydocs/OPS.txt:4:lab pads when a column is missing on a scratch vat. assay.ok is false when\r\n/app/inkstack/migrations/0004_attempt_slot.sql:1:ALTER TABLE tries ADD COLUMN attempt_slot;\r\n/app/inkstack/intent.toml:2:columns = [\"id\", \"label\", \"attempt_slot\"]\r\n/app/scorepit/score.go:11:const okPath = \"/app/vats/assay.ok\"\r\n/app/scorepit/score.go:19:\tfmt.Printf(\"schema_version=%s\\n\", st.LastApplied())\r\n/app/scorepit/score.go:20:\tif !st.HasCol(\"attempt_slot\") {\r\n/app/scorepit/score.go:21:\t\tfmt.Fprintln(os.Stderr, \"unknown-column: attempt_slot\")\r\n/app/scorepit/shim.go:10:\tst.AddCol(\"attempt_slot\")\r\n/app/hopsrc/vat/store.go:12:const magic = \"KILNVAT 1\"\r\n/app/hopsrc/vat/store.go:41:\t\tcase strings.HasPrefix(line, \"applied:\"):\r\n/app/hopsrc/vat/store.go:42:\t\t\ts.Applied = append(s.Applied, strings.TrimPrefix(line, \"applied:\"))\r\n/app/hopsrc/vat/store.go:59:\t\tb.WriteString(\"applied:\")\r\n/app/kilncli/main.go:10:\t\tfmt.Fprintln(os.Stderr, \"usage: kilncli impress|spill|assay\")\r\n/app/kilncli/main.go:17:\tcase \"spill\":\r\n/app/kilncli/main.go:19:\tcase \"assay\":\r\n/app/kilncli/main.go:22:\t\tfmt.Fprintln(os.Stderr, \"usage: kilncli impress|spill|assay\")\r\n"]
