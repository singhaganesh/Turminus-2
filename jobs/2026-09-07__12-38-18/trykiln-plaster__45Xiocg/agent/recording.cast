[43.466832, "o", "> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''func Imprint(vatPath string) error {\r\n\u001b[?2004l\r\u001b[?2004h>  focus, err := os.ReadFile(\"/app/hearth/focus.txt\")\r\n\u001b[?2004l\r\u001b[?2004h>  if err == nil {\r\n\u001b[?2004l\r\u001b[?2004h>    vatPath = strings.TrimSpace(string(focus))\r\n\u001b[?2004l\r\u001b[?2004h>  }\r\n\u001b[?2004l\r\u001b[?2004h>  return applyAll(vatPath)\r\n\u001b[?2004l\r\u001b[?2004h> }''', '''func Imprint(vatPath string) error {\r\n\u001b[?2004l\r\u001b[?2004h>  if strings.TrimSpace(vatPath) == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h>    focus, err := os.ReadFile(\"/app/hearth/focus.txt\")\r\n\u001b[?2004l\r\u001b[?2004h>    if err != nil {\r\n\u001b[?2004l\r\u001b[?2004h>      return err\r\n\u001b[?2004l\r\u001b[?2004h>    }\r\n\u001b[?2004l\r\u001b[?2004h>    vatPath = strings.TrimSpace(string(focus))\r\n\u001b[?2004l\r\u001b[?2004h>  }\r\n\u001b[?2004l\r\u001b[?2004h>  return applyAll(vatPath)\r\n\u001b[?2004l\r\u001b[?2004h> }''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
