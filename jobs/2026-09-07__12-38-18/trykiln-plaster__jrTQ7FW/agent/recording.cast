[83.334664, "i", "set +e\ntrap 'rm -f /app/inkstack/migrations/9999_probe.sql' EXIT\ncp /app/vats/worker.vat /tmp/worker.before\nprintf 'ALTER TABLE tries ADD COLUMN probe;\\n' > /app/inkstack/migrations/9999_probe.sql\nprintf 'old\\n' > /app/vats/assay.ok\necho '--- lagging worker assay ---'\n/app/bin/kilncli assay\narc=$?\necho \"assay_rc=$arc marker_exists=$(test -e /app/vats/assay.ok && echo yes || echo no)\"\nprintf 'old\\n' > /app/vats/assay.ok\necho '--- lagging plaster spill ---'\n/app/bin/kilncli spill\nsrc=$?\necho \"spill_rc=$src marker_exists=$(test -e /app/vats/assay.ok && echo yes || echo no) worker_unchanged=$(cmp -s /tmp/worker.before /app/vats/worker.vat && echo yes || echo no)\"\nrm -f /app/inkstack/migrations/9999_probe.sql\ntrap - EXIT\nif [ \"$arc\" -eq 0 ] || [ \"$src\" -eq 0 ]; then echo 'negative test failed' >&2; exit 1; fi\n/app/bin/kilncli spill && /app/bin/kilncli assay\nrc=$?\necho \"final_rc=$rc latest=$(find /app/inkstack/migrations -maxdepth 1 -name '*.sql' -printf '%f\\n' | sort | tail -1 | sed 's/\\.sql$//') marker=$(cat /app/vats/assay.ok 2>/dev/null)\"\necho '--- plaster ---'; cat /app/vats/plaster.vat\necho '--- worker ---'; cat /app/vats/worker.vat\nexit \"$rc\"\n"]
