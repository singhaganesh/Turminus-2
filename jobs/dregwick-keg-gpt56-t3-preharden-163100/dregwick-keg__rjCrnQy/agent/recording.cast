[34.680759, "i", "echo '--- NOTE.txt'; cat /app/desknote/NOTE.txt; echo '--- brim.sh'; nl -ba /app/brim.sh; for d in rootwalk namelock bytecue hitchrun fmtcells gildbox floorcue; do for f in /app/$d/*.java; do echo \"--- $f\"; nl -ba \"$f\"; done; done\n"]
