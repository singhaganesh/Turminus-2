[34.693903, "o", "     1\timport java.nio.file.DirectoryStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.Collections;\r\n     6\timport java.util.jar.JarEntry;\r\n     7\timport java.util.jar.JarFile;\r\n     8\t\r\n     9"]
[34.694008, "o", "\tpublic class Main {\r\n    10\t    public static void main(String[] args) throws Exception {\r\n    11\t        if (args.length < 1) {\r\n    12\t            System.exit(2);\r\n    13\t        }\r\n    14\t        String verb = args[0];\r\n    15\t        if (\"loom\".equals(verb)) {\r\n    16\t            loadExploded();\r\n    17\t            TasteRun.go(args[1]);\r\n    18\t            return;\r\n    19\t        }\r\n    20\t        if (\"taste\".equals(verb)) {\r\n    21\t            loadJar();\r\n    22\t            TasteRun.go(args[1]);\r\n    23\t            return;\r\n    24\t        }\r\n    25\t        if (\"booth\".equals(verb)) {\r\n    26\t            loadJar();\r\n    27\t            BoothRun.go();\r\n    28\t            return;\r\n    29\t        }\r\n    30\t        System.exit(2);\r\n    31\t    }\r\n    32\t\r\n    33\t    static void loadExploded() throws Exception {\r\n    34\t        Path dir = Paths.get(\"/app/blastcp\");\r\n    35\t        try (DirectoryStream<Path> ds = Files.newDirectoryStream(dir, \"*Booth.class\")) {\r\n    36\t            for (Path p : ds) {\r\n    37\t                String n = p.getFileName().toString();\r\n    38\t                n = n.substring(0, n.length() - 6);\r\n    39\t                Class.forName(n);\r\n    40\t            }\r\n    41\t        }\r\n"]
[34.694088, "o", "    42\t    }\r\n    43\t\r\n    44\t    static void loadJar() throws Exception {\r\n    45\t        String cp = System.getProperty(\"java.class.path\");\r\n    46\t        Path p = Paths.get(cp.split(java.io.File.pathSeparator)[0]);\r\n    47\t        if (!Files.isRegularFile(p)) {\r\n    48\t            return;\r\n    49\t        }\r\n    50\t        try (JarFile jf = new JarFile(p.toFile())) {\r\n    51\t            for (JarEntry e : Collections.list(jf.entries())) {\r\n    52\t                String n = e.getName();\r\n    53\t                if (n.endsWith(\"Booth.class\") && !n.contains(\"/\")) {\r\n    54\t                    Class.forName(n.substring(0, n.length() - 6));\r\n    55\t                }\r\n    56\t            }\r\n    57\t        }\r\n    58\t    }\r\n    59\t}\r\n"]
