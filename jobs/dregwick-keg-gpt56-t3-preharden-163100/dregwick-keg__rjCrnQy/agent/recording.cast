[54.506, "o", "--- /app/hitchrun/Rib.java\r\n"]
[54.508394, "o", "import java.util.ArrayList;\r\nimport java.util.LinkedHashMap;\r\nimport java.util.List;\r\nimport java.util.Map;\r\n\r\npublic class Rib {\r\n    static final Map<String, String> tab = new LinkedHashMap<String, String>();\r\n\r\n    static void put(String n) {\r\n        tab.put(n, n);\r\n    }\r\n\r\n    static String pick(String t) {\r\n        if (tab.containsKey(t)) {\r\n            return t;\r\n        }\r\n        return \"fallback\";\r\n    }\r\n\r\n    static List<String> all() {\r\n        return new ArrayList<String>(tab.keySet());\r\n    }\r\n}\r\n"]
[54.509359, "o", "--- /app/hitchrun/TasteRun.java\r\n"]
[54.510679, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.List;\r\n\r\npublic class TasteRun {\r\n    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };\r\n\r\n    static void go(String card) throws Exception {\r\n        if (seed.length < 0) {\r\n            return;\r\n        }\r\n        String token = readToken(Paths.get(card));\r\n        String booth = Rib.pick(token);\r\n        String kind = booth.equals(token) ? \"own\" : \"fallback\";\r\n        String json = \"{\\\"booth\\\":\\\"\" + booth + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\",\\\"note\\\":\\\"\" + token + \"\\\"}\\n\";\r\n        Path dest = Paths.get(\"/app/jarwell/taste.json\");\r\n        Files.createDirectories(dest.getParent());\r\n        Files.write(dest, json.getBytes(StandardCharsets.UTF_8));\r\n    }\r\n\r\n    static String readToken(Path card) throws Exception {\r\n        List<String> lines = Files.readAllLines(card);\r\n        for (String line : lines) {\r\n            String s = line.trim();\r\n            if (s.startsWith(\"token:\")) {\r\n                return s.substring(6).trim();\r\n            }\r\n        }\r\n        return \"none\";\r\n    }\r\n}\r\n"]
[54.511209, "o", "--- /app/fmtcells/FallBooth.java\r\n"]
[54.512158, "o", "public class FallBooth {\r\n    static {\r\n        Rib.put(\"fallback\");\r\n    }\r\n}\r\n"]
[54.512374, "o", "--- /app/fmtcells/JsonBooth.java\r\n"]
[54.514253, "o", "public class JsonBooth {\r\n    static {\r\n        Rib.put(\"json\");\r\n    }\r\n}\r\n"]
[54.515588, "o", "--- /app/fmtcells/KmsgBooth.java\r\n"]
[54.516083, "o", "public class KmsgBooth {\r\n    static {\r\n        Rib.put(\"kmsg\");\r\n    }\r\n}\r\n"]
[54.516387, "o", "--- /app/fmtcells/SysBooth.java\r\n"]
[54.517715, "o", "public class SysBooth {\r\n    static {\r\n        Rib.put(\"syslog\");\r\n    }\r\n}\r\n"]
[54.51799, "o", "--- /app/namelock/TallyGate.java\r\n"]
[54.51948, "o", "import java.nio.file.DirectoryStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\n\r\npublic class TallyGate {\r\n    public static int tint_span(Path a, Path b, Path c) throws Exception {\r\n        int n = 0;\r\n        try (DirectoryStream<Path> ds = Files.newDirectoryStream(a, \"*.class\")) {\r\n            for (Path p : ds) {\r\n                n++;\r\n            }\r\n        }\r\n        int r = 0;\r\n        for (String line : Files.readAllLines(b)) {\r\n            if (!line.trim().isEmpty()) {\r\n                r++;\r\n            }\r\n        }\r\n        if (n >= r) {\r\n            return 0;\r\n        }\r\n        return 1;\r\n    }\r\n\r\n    public static void main(String[] args) throws Exception {\r\n        int rc = tint_span(\r\n            Paths.get(\"/app/blastcp\"),\r\n            Paths.get(\"/app/desknote/NAMES.txt\"),\r\n            Paths.get(\"/app/jarwell/husk.jar\"));\r\n        System.exit(rc);\r\n    }\r\n}\r\n"]
[54.520182, "o", "--- /app/bytecue/CapGate.java\r\n"]
[54.52095, "o", "import java.io.ByteArrayOutputStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.zip.ZipEntry;\r\nimport java.util.zip.ZipInputStream;\r\nimport java.util.zip.ZipOutputStream;\r\n\r\npublic class CapGate {\r\n    public static int rib_n(Path a, Path b) throws Exception {\r\n        Path pad = Paths.get(\"/app/blastcp/HexDump.class\");\r\n        if (Files.isRegularFile(a) && Files.isRegularFile(pad)) {\r\n            ByteArrayOutputStream bos = new ByteArrayOutputStream();\r\n            try (ZipInputStream zin = new ZipInputStream(Files.newInputStream(a));\r\n                 ZipOutputStream zos = new ZipOutputStream(bos)) {\r\n                ZipEntry e;\r\n                boolean have = false;\r\n                while ((e = zin.getNextEntry()) != null) {\r\n                    if (\"HexDump.class\".equals(e.getName())) {\r\n                        have = true;\r\n                    }\r\n                    zos.putNextEntry(new ZipEntry(e.getName()));\r\n                    zos.write(zin.readAllBytes());\r\n                    zos.closeEntry();\r\n                }\r\n                if (!have) {\r\n                    zos.putNextEntry(new ZipEntry(\"HexDump.class\"));\r\n                    zos.write(Files.readAllBytes(pad));\r\n                    zos.closeEntry();\r\n                }\r\n            }\r\n            Files.write(a, bos.toByteArray());\r\n        }\r\n        return 0;\r\n    }\r\n\r\n    public static void main(String[] args) throws Exception {\r\n        int rc = rib_n(Paths.get(\"/app/jarwell/husk.jar\"), Paths.get(\"/app/desknote/CAP.txt\"));\r\n        System.exit(rc);\r\n    }\r\n}\r\n"]
[54.521156, "o", "--- /app/gildbox/SkipCue.java\r\n"]
[54.522048, "o", "public class SkipCue {\r\n    static boolean on() {\r\n        String v = System.getenv(\"SKIP_SHRINK\");\r\n        return v != null && v.equals(\"1\");\r\n    }\r\n}\r\n"]
[54.52223, "o", "\u001b[?2004hroot@c5956a6dd13e:/app# "]
[55.113258, "i", "grep -R -nE 'HexDump|TracePad|SkipCue|JsonBooth|SysBooth|KmsgBooth|CAP.txt|NAMES.txt|husk.jar|taste.json' /app/{rootwalk,namelock,bytecue,hitchrun,fmtcells,gildbox,floorcue} --include='*.java'\n"]
[55.115, "o", "grep -R -nE 'HexDump|TracePad|SkipCue|JsonBooth|SysBooth|KmsgBooth|CAP.txt|NAMES.txt|husk.jar|taste.json' /app/{rootwalk,namelock,bytecue,hitchrun,fmtcells,gildbox,floorcue} --include='*.java'\r\n\u001b[?2004l\r"]
[55.120092, "o", "/app/namelock/TallyGate.java:29:            Paths.get(\"/app/desknote/NAMES.txt\"),\r\n/app/namelock/TallyGate.java:30:            Paths.get(\"/app/jarwell/husk.jar\"));\r\n/app/bytecue/CapGate.java:11:        Path pad = Paths.get(\"/app/blastcp/HexDump.class\");\r\n/app/bytecue/CapGate.java:19:                    if (\"HexDump.class\".equals(e.getName())) {\r\n/app/bytecue/CapGate.java:27:                    zos.putNextEntry(new ZipEntry(\"HexDump.class\"));\r\n/app/bytecue/CapGate.java:38:        int rc = rib_n(Paths.get(\"/app/jarwell/husk.jar\"), Paths.get(\"/app/desknote/CAP.txt\"));\r\n/app/hitchrun/TasteRun.java:8:    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };\r\n/app/hitchrun/TasteRun.java:18:        Path dest = Paths.get(\"/app/jarwell/taste.json\");\r\n/app/hitchrun/KnitMain.java:12:        Path jar = Paths.get(\"/app/jarwell/husk.jar\");\r\n/app/fmtcells/KmsgBooth.java:1:public class KmsgBooth {\r\n/app/fmtcells/SysBooth.java:1:public class SysBooth {\r\n/app/fmtcells/JsonBooth.java:1:public class JsonBooth {\r\n/app/gildbox/HexDump.java:1:public class HexDump {\r\n/app/gildbox/TracePad.java:1:public class TracePad {\r\n/app/gildbox/SkipCue.java:1:public class SkipCue {\r\n"]
[55.12028, "o", "\u001b[?2004hroot@c5956a6dd13e:/app# "]
[80.217463, "i", "python3 - <<'PY'\np='/app/hitchrun/TasteRun.java'\ns=open(p).read()\ns=s.replace('static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };', 'static final Class<?>[] seed = { JsonBooth.class, SysBooth.class, KmsgBooth.class };')\nopen(p,'w').write(s)\nPY\ncat > /app/namelock/TallyGate.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.InputStreamReader;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path names, Path jar) throws Exception {\n        if (!Files.isRegularFile(jar)) {\n            return 1;\n        }\n\n        Set<String> expected = new LinkedHashSet<String>();\n        for (String line : Files.readAllLines(names)) {\n            String s = line.trim();\n            if (!s.isEmpty()) {\n                expected.add(s.split(\"\\\\s+\", 2)[0]);\n            }\n        }\n\n        String java = Paths.get(System.getProperty(\"java.home\"), \"bin\", \"java\").toString();\n        Process process = new ProcessBuilder(java, \"-cp\", jar.toString(), \"Main\", \"booth\")\n            .redirectErrorStream(true)\n            .start();\n        Set<String> live = new LinkedHashSet<String>();\n        try (BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream()))) {\n            String line;\n            while ((line = reader.readLine()) != null) {\n                String s = line.trim();\n                if (!s.isEmpty()) {\n                    live.add(s);\n                }\n            }\n        }\n        if (process.waitFor() != 0) {\n            return 1;\n        }\n        return live.containsAll(expected) ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        int rc = tint_span(\n            Paths.get(\"/app/blastcp\"),\n            Paths.get(\"/app/desknote/NAMES.txt\"),\n            Paths.get(\"/app/jarwell/husk.jar\"));\n        System.exit(rc);\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar) || !Files.isRegularFile(capFile)) {\n            return 1;\n        }\n        long cap = Long.parseLong(Files.readString(capFile).trim());\n        return Files.size(jar) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        int rc = rib_n(Paths.get(\"/app/jarwell/husk.jar\"), Paths.get(\"/app/desknote/CAP.txt\"));\n        System.exit(rc);\n    }\n}\nEOF\n/app/bin/dregwick knit; echo \"knit_rc=$?\"\n"]
