[34.695394, "o", "     1\timport java.util.ArrayList;\r\n     2\timport java.util.LinkedHashMap;\r\n     3\timport java.util.List;\r\n     4\timport java.util.Map;\r\n     5\t\r\n     6\tpublic class Rib {\r\n     7\t    static final Map<String, String> tab = new LinkedHashMap<String, String>();\r\n     8\t\r\n     9\t    static void put(String n) {\r\n    10\t        tab.put(n, n);\r\n    11\t    }\r\n    12\t\r\n    13\t    static String pick(String t) {\r\n    14\t        if (tab.containsKey(t)) {\r\n    15\t            return t;\r\n    16\t        }\r\n    17\t        return \"fallback\";\r\n    18\t    }\r\n    19\t\r\n    20\t    static List<String> all() {\r\n"]
[34.695536, "o", "    21\t        return new ArrayList<String>(tab.keySet());\r\n    22\t    }\r\n    23\t}\r\n"]
[34.695762, "o", "--- /app/hitchrun/TasteRun.java\r\n"]
[34.697291, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.List;\r\n     6\t\r\n     7\tpublic class TasteRun {\r\n     8\t    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };\r\n     9\t\r\n    10\t    static void go(String card) throws Exception {\r\n    11\t        if (seed.length < 0) {\r\n    12\t            return;\r\n    13\t        }\r\n    14\t        String token = readToken(Paths.get(card));\r\n    15\t        String booth = Rib.pick(token);\r\n"]
[34.697598, "o", "    16\t        String kind = booth.equals(token) ? \"own\" : \"fallback\";\r\n    17\t        String json = \"{\\\"booth\\\":\\\"\" + booth + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\",\\\"note\\\":\\\"\" + token + \"\\\"}\\n\";\r\n    18\t        Path dest = Paths.get(\"/app/jarwell/taste.json\");\r\n    19\t        Files.createDirectories(dest.getParent());\r\n    20\t        Files.write(dest, json.getBytes(StandardCharsets.UTF_8));\r\n    21\t    }\r\n    22\t\r\n    23\t    static String readToken(Path card) throws Exception {\r\n    24\t        List<String> lines = Files.readAllLines(card);\r\n    25\t        for (String line : lines) {\r\n    26\t            String s = line.trim();\r\n    27\t            if (s.startsWith(\"token:\")) {\r\n    28\t                return s.substring(6).trim();\r\n    29\t            }\r\n    30\t        }\r\n    31\t        return \"none\";\r\n    32\t    }\r\n    33\t}\r\n"]
