[122.205986, "i", "/app/bin/cinderwait watch /app/hopbags/elm.bag\npython3 - <<'PY'\nimport json, subprocess, zipfile\nfrom pathlib import Path\np=Path('/app/jarhearth/watch.json')\ngot=json.loads(p.read_text())\nassert got == {'seen':5151, 'bag':'elm.bag', 'note':'keld-tight-9'}, got\npeek=subprocess.check_output(['/app/bin/cinderwait','peek','/app/hopbags/elm.bag'], text=True)\nassert peek == '5151\\n', repr(peek)\nwith zipfile.ZipFile('/app/jarhearth/ship.jar') as z:\n    assert z.read('STAMP').decode().strip() == 'keld-tight-9'\nprint('final success:', got, 'peek='+peek.strip())\nPY\nset +e\n/app/bin/cinderwait watch /app/hopbags/mute.bag\nrc=$?\nset -e\ntest \"$rc\" -ne 0\ntest ! -e /app/jarhearth/watch.json\nprintf 'nonpublish rc=%s, ledger absent\\n' \"$rc\"\n"]
