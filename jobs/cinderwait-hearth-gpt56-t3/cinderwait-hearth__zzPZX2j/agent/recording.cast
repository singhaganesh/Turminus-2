[71.91654, "o", "import java.util.zip.ZipFile;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> public class ShipMain {\r\n\u001b[?2004l\r\u001b[?2004h>     private static final Path OUT = Paths.get(\"/app/jarhearth/watch.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     private static final Path MARK = Paths.get(\"/app/opslip/MARK.txt\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     public static int rib_n(String[] a) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h>         // A failed watch must never leave an earlier success ledger behind.\r\n\u001b[?2004l\r\u001b[?2004h>         Files.deleteIfExists(OUT);\r\n\u001b[?2004l\r\u001b[?2004h>         if (a.length != 1 || !lid_q()) {\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         Path bag = Paths.get(a[0]);\r\n\u001b[?2004l\r\u001b[?2004h>         int word = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n\u001b[?2004l\r\u001b[?2004h>         // Zero denotes a gatherer which never publishes.\r\n\u001b[?2004l\r\u001b[?2004h>         if (word == 0) {\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         Tarn board = new Tarn();\r\n\u001b[?2004l\r\u001b[?2004h>         int seen = Glue.haul(board, word);\r\n\u001b[?2004l\r\u001b[?2004h>         if (seen == 0) {\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         String name = bag.getFileName().toString();\r\n\u001b[?2004l\r\u001b[?2004h>         String note = Files.readString(MARK).trim();\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.91657, "o", "> "]
