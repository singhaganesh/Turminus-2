[44.929709, "o", "\u001b[?2004hroot@c8207ee604d7:/app# "]
[71.89218, "i", "cat > /app/tarnpit/Tarn.java <<'EOF'\npublic class Tarn {\n    public volatile int waiting;\n    public volatile int keld;\n    public int copy;\n\n    public int mira() {\n        int a = keld;\n        waiting = 1;\n        while (a == 0) {\n            a = keld;\n            Thread.onSpinWait();\n        }\n        return a;\n    }\n}\nEOF\ncat > /app/hopcue/Hopper.java <<'EOF'\npublic class Hopper {\n    public static void feed(Tarn t, int w) {\n        // Draft records the offered token, while the mills communicate through keld.\n        t.copy = w;\n        t.keld = w;\n    }\n}\nEOF\ncat > /app/watchbay/Glue.java <<'EOF'\npublic class Glue {\n    public static int haul(Tarn t, int w) throws Exception {\n        Thread gatherer = new Thread(() -> {\n            while (t.waiting == 0) {\n                Thread.onSpinWait();\n            }\n            Hopper.feed(t, w);\n        });\n        gatherer.start();\n        int seen = t.mira();\n        gatherer.join();\n        return seen;\n    }\n}\nEOF\ncat > /app/watchbay/ShipMain.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.zip.ZipFile;\n\npublic class ShipMain {\n    private static final Path OUT = Paths.get(\"/app/jarhearth/watch.json\");\n    private static final Path MARK = Paths.get(\"/app/opslip/MARK.txt\");\n\n    public static int rib_n(String[] a) throws Exception {\n        // A failed watch must never leave an earlier success ledger behind.\n        Files.deleteIfExists(OUT);\n        if (a.length != 1 || !lid_q()) {\n            return 1;\n        }\n\n        Path bag = Paths.get(a[0]);\n        int word = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\n        // Zero denotes a gatherer which never publishes.\n        if (word == 0) {\n            return 1;\n        }\n\n        Tarn board = new Tarn();\n        int seen = Glue.haul(board, word);\n        if (seen == 0) {\n            return 1;\n        }\n\n        String name = bag.getFileName().toString();\n        String note = Files.readString(MARK).trim();\n        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + json(name)\n                + \"\\\",\\\"note\\\":\\\"\" + json(note) + \"\\\"}\\n\";\n        Files.createDirectories(OUT.getParent());\n        Files.write(OUT, body.getBytes(StandardCharsets.UTF_8));\n        return 0;\n    }\n\n    public static void main(String[] a) throws Exception {\n        System.exit(rib_n(a));\n    }\n\n    static boolean lid_q() {\n        try {\n            String want = Files.readString(MARK).trim();\n            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\n                var e = z.getEntry(\"STAMP\");\n                if (e == null) {\n                    return false;\n                }\n                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\n                return want.equals(got);\n            }\n        } catch (Exception ex) {\n            return false;\n        }\n    }\n\n    private static String json(String s) {\n        return s.replace(\"\\\\\", \"\\\\\\\\\").replace(\"\\\"\", \"\\\\\\\"\");\n    }\n}\nEOF\n/app/bin/cinderwait kindle\n"]
