[12.339277, "i", "printf '%s\\n' '--- ROUTE ---'; cat /app/opslip/ROUTE.txt; printf '%s\\n' '--- VERBS ---'; cat /app/opslip/VERBS.txt; printf '%s\\n' '--- CARD ---'; cat /app/opslip/CARD.txt; printf '%s\\n' '--- MARK ---'; cat /app/opslip/MARK.txt\n"]
[12.34034, "o", "printf '%s\\n' '--- ROUTE ---'; cat /app/opslip/ROUTE.txt; printf '%s\\n' '--- VERBS ---'; cat /app/opslip/VERBS.txt; printf '%s\\n' '--- CARD ---'; cat /app/opslip/CARD.txt; printf '%s\\n' '--- MARK ---'; cat /app/opslip/MARK.txt\r\n\u001b[?2004l\r"]
[12.340707, "o", "--- ROUTE ---\r\n"]
[12.344611, "o", "tarnpit\r\nhopcue\r\nwatchbay\r\n--- VERBS ---\r\n"]
[12.344749, "o", "kindle\r\n  rebuild ship.jar and draft.jar from current sources\r\n\r\nwatch BAG\r\n  run the ship mill on BAG and write /app/jarhearth/watch.json\r\n\r\npeek BAG\r\n  print the gather word for BAG as one integer on stdout\r\n\r\ndraft BAG\r\n  run the draft mill on BAG\r\n"]
[12.345767, "o", "--- CARD ---\r\n"]
[12.346602, "o", "watch.json on a successful watch:\r\n  seen — integer gather word from the packed mill\r\n  bag — basename of the hopbag (alpha.bag), not the full command-line path\r\n  note — kiln stamp taken from MARK.txt\r\n\r\nThe mill stores the wait-board integer the gatherer publishes onto the packed mill. That integer is not the first-line token of the hopbag. A never-publish bag (first-line integer 0) is not a published bag; watch must not write a success ledger for it.\r\n\r\nGrade-time bags may sit outside /app/hopbags. One of those bags is also named on this card as /app/hopbags/elm.bag.\r\n"]
[12.346842, "o", "--- MARK ---\r\n"]
[12.347713, "o", "keld-tight-9\r\n"]
[12.350526, "o", "\u001b[?2004hroot@c8207ee604d7:/app# "]
[12.502811, "i", "printf '%s\\n' '--- cinderwait ---'; file /app/bin/cinderwait; sed -n '1,240p' /app/bin/cinderwait; printf '%s\\n' '--- files ---'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort\n"]
[12.503642, "o", "printf '%s\\n' '--- cinderwait ---'; file /app/bin/cinderwait; sed -n '1,240p' /app/bin/cinderwait; printf '%s\\n' '--- files ---'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[12.503756, "o", "--- cinderwait ---\r\n"]
[12.526544, "o", "/app/bin/cinderwait: Bourne-Again shell script, ASCII text executable\r\n"]
[12.530354, "o", "#!/bin/bash\r\nset -euo pipefail\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  kindle)\r\n    exec /app/kindle.sh\r\n    ;;\r\n  watch)\r\n    exec \"$JAVA\" -cp /app/jarhearth/ship.jar ShipMain \"$@\"\r\n    ;;\r\n  peek)\r\n    exec \"$JAVA\" -cp /app/blastcp PeekMain \"$@\"\r\n    ;;\r\n  draft)\r\n    exec \"$JAVA\" -cp /app/jarhearth/draft.jar DraftMain \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\n"]
[12.530903, "o", "--- files ---\r\n"]
[12.534384, "o", "/app/bin/cinderwait\r\n/app/blastcp/DraftMain.class\r\n/app/blastcp/Glue.class\r\n/app/blastcp/Hopper.class\r\n/app/blastcp/KilnShip.class\r\n/app/blastcp/Pacer.class\r\n/app/blastcp/PeekMain.class\r\n/app/blastcp/Rill.class\r\n/app/blastcp/ShipMain.class\r\n/app/blastcp/Tarn.class\r\n/app/draftcue/DraftMain.java\r\n/app/hopbags/alpha.bag\r\n/app/hopbags/elm.bag\r\n/app/hopbags/mute.bag\r\n/app/hopcue/Hopper.java\r\n/app/jarhearth/STAMP.body\r\n/app/jarhearth/draft.jar\r\n"]
[12.534419, "o", "/app/jarhearth/ship.jar\r\n/app/kilnrib/KilnShip.java\r\n/app/kindle.sh\r\n/app/opslip/CARD.txt\r\n/app/opslip/MARK.txt\r\n/app/opslip/NOTES.txt\r\n/app/opslip/ROUTE.txt\r\n/app/opslip/VERBS.txt\r\n/app/opslip/jarscan.py\r\n/app/peekcue/PeekMain.java\r\n/app/rillcue/Rill.java\r\n/app/softmill/Pacer.java\r\n/app/tarnpit/Tarn.java\r\n/app/watchbay/Glue.java\r\n/app/watchbay/ShipMain.java\r\n"]
