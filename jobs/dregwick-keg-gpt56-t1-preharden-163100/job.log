Sending keys: ['cd /app && cat > namelock/TallyGate.java <<\'EOF\'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.HashSet;\nimport java.util.Set;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path names, Path jar) throws Exception {\n        if (!Files.isRegularFile(names) || !Files.isRegularFile(jar)) {\n            return 1;\n        }\n        Path java = Paths.get(System.getProperty("java.home"), "bin", "java");\n        Process process = new ProcessBuilder(\n            java.toString(), "-cp", jar.toString(), "Main", "booth")\n            .redirectErrorStream(true)\n            .start();\n        String output = new String(process.getInputStream().readAllBytes(), StandardCharsets.UTF_8);\n        if (process.waitFor() != 0) {\n            return 1;\n        }\n        Set<String> live = new HashSet<String>();\n        for (String line : output.split("\\\\R")) {\n            String token = line.trim();\n            if (!token.isEmpty()) {\n                live.add(token);\n            }\n        }\n        for (String line : Files.readAllLines(names)) {\n            String text = line.trim();\n            if (text.isEmpty()) {\n                continue;\n            }\n            String[] fields = text.split("\\\\s+");\n            if (fields.length < 2 || !live.contains(fields[0])) {\n                return 1;\n            }\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(\n            Paths.get("/app/blastcp"),\n            Paths.get("/app/desknote/NAMES.txt"),\n            Paths.get("/app/jarwell/husk.jar")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo "normal_knit=$?"\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
