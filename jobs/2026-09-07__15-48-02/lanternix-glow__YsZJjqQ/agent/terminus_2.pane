package packbay

import (
	unit0000 "loft.local/lanternix/packbay/units/unit0000"
	unit0001 "loft.local/lanternix/packbay/units/unit0001"
	unit0002 "loft.local/lanternix/packbay/units/unit0002"
	unit0003 "loft.local/lanternix/packbay/units/unit0003"
)

func Fill() {
	unit0000.Load()
	unit0001.Load()
	unit0002.Load()
	unit0003.Load()
}
