[14.655552, "i", "for f in go.mod oxbind/seal.go packbay/fetch.go packbay/reg.go packbay/store/store.go packbay/units/*/pack.go milldesk/main.go milldesk/spin.go milldesk/play.go milldesk/Makefile; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done\n"]
[14.656485, "o", "for f in go.mod oxbind/seal.go packbay/fetch.go packbay/reg.go packbay/store/store.go packbay/units/*/pack.go milldesk/main.go milldesk/spin.go milldesk/play.go milldesk/Makefile; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[14.656748, "o", "===== go.mod =====\r\n"]
[14.662336, "o", "module loft.local/lanternix\r\n\r\ngo 1.22\r\n"]
[14.662621, "o", "===== oxbind/seal.go =====\r\n"]
[14.663769, "o", "package oxbind\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nvar chart map[string]store.Spec\r\n\r\nfunc Clip(bag map[string]store.Spec) map[string]store.Spec {\r\n\tout := make(map[string]store.Spec, len(bag))\r\n\tfor k, v := range bag {\r\n\t\tout[k] = v\r\n"]
[14.663883, "o", "\t}\r\n\treturn out\r\n}\r\n\r\nfunc Boot() {\r\n\tchart = Clip(store.Bag())\r\n}\r\n\r\nfunc Read(tag string) (store.Spec, bool) {\r\n\ts, ok := chart[tag]\r\n\treturn s, ok\r\n}\r\n"]
[14.664056, "o", "===== packbay/fetch.go =====\r\n"]
[14.665484, "o", "package packbay\r\n\r\nvar seed = []string{\"LAN_WARM_01\", \"LAN_BEAM_44\"}\r\n\r\nfunc Pull(tag string) {\r\n\tok := false\r\n\tfor _, s := range seed {\r\n\t\tif s == tag {\r\n\t\t\tok = true\r\n\t\t\tbreak\r\n"]
[14.665596, "o", "\t\t}\r\n\t}\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tFill()\r\n}\r\n"]
[14.66575, "o", "===== packbay/reg.go =====\r\n"]
[14.666931, "o", "package packbay\r\n\r\nimport (\r\n\tunita \"loft.local/lanternix/packbay/units/unita\"\r\n\tunitb \"loft.local/lanternix/packbay/units/unitb\"\r\n)\r\n\r\nfunc Fill() {\r\n\tunita.Load()\r\n\tunitb.Load()\r\n}\r\n"]
[14.667149, "o", "===== packbay/store/store.go =====\r\n"]
[14.673594, "o", "package store\r\n\r\ntype Spec struct {\r\n\tSlots []string\r\n}\r\n\r\nvar bag = map[string]Spec{}\r\n\r\nfunc Offer(id string, spec Spec) {\r\n\tbag[id] = spec\r\n}\r\n\r\nfunc Bag() map[string]Spec {\r\n\tout := make(map[string]Spec, len(bag))\r\n\tfor k, v := range bag {\r\n\t\tout[k] = v\r\n\t}\r\n"]
[14.673702, "o", "\treturn out\r\n}\r\n\r\nfunc Reset() {\r\n\tbag = map[string]Spec{}\r\n}\r\n"]
[14.673937, "o", "===== packbay/units/unita/pack.go =====\r\n"]
[14.675087, "o", "package unita\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_WARM_01\", store.Spec{Slots: []string{\"lux\", \" hold_s\"}})\r\n}\r\n"]
[14.675299, "o", "===== packbay/units/unitb/pack.go =====\r\n"]
[14.676317, "o", "package unitb\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_BEAM_44\", store.Spec{Slots: []string{\"az_deg\", \" el_deg\"}})\r\n}\r\n"]
[14.676568, "o", "===== packbay/units/unitc/pack.go =====\r\n"]
[14.677783, "o", "package unitc\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_FLASH_9C\", store.Spec{Slots: []string{\"candela\", \"  dwell_s\"}})\r\n}\r\n"]
[14.678014, "o", "===== packbay/units/unitd/pack.go =====\r\n"]
[14.679168, "o", "package unitd\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_GLOW_2B\", store.Spec{Slots: []string{\"hue\", \"  period_s\"}})\r\n}\r\n"]
[14.679393, "o", "===== milldesk/main.go =====\r\n"]
[14.680731, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n\t\"loft.local/lanternix/packbay\"\r\n)\r\n\r\nfunc main() {\r\n\tos.Exit(run(os.Args[1:]))\r\n}\r\n"]
[14.680839, "o", "\r\nfunc run(args []string) int {\r\n\tif len(args) == 0 {\r\n\t\treturn 2\r\n\t}\r\n\tswitch args[0] {\r\n\tcase \"cast\":\r\n\t\tpackbay.Pull(\"LAN_WARM_01\")\r\n\t\toxbind.Boot()\r\n\t\treturn Spin()\r\n\tcase \"readout\":\r\n\t\tif len(args) < 3 || args[1] != \"--lamp\" {\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\treturn Play(args[2])\r\n\tdefault:\r\n\t\treturn 2\r\n\t}\r\n}\r\n"]
[14.681028, "o", "===== milldesk/spin.go =====\r\n"]
[14.687644, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n"]
[14.687808, "o", "\t\"loft.local/lanternix/packbay/store\"\r\n)\r\n\r\nfunc Spin() int {\r\n\ttime.Sleep(2 * time.Second)\r\n\tcards, err := loadCards(\"/app/cardwell\")\r\n\tif err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := writeUnits(cards); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := writeFill([]string{\"unita\", \"unitb\"}); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\t_ = oxbind.Clip(store.Bag())\r\n\tif miss := missingCodes(cards, map[string]store.Spec{}); len(miss) > 0 {\r\n\t}\r\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", \"/app/bin/lanternix.next\", \"loft.local/lanternix/milldesk\")\r\n\tcmd.Dir = \"/app\"\r\n\tcmd.Env = append(os.Environ(),\r\n\t\t\"GOPROXY=off\",\r\n\t\t\"GOFLAGS=-mod=mod\",\r\n\t\t\"GOCACHE=/tmp/gocache-lanternix\",\r\n\t\t\"PATH=/usr/local/go/bin:\"+os.Getenv(\"PATH\"),\r\n\t)\r\n\tif err := cmd.Run(); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := os.Rename(\"/app/bin/lanternix.next\", \"/app/bin/lanternix\"); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc writeUnits(cards []card) error {\r\n\troots := map[string]string{\r\n\t\t\"LAN_WARM_01\": \"unita\",\r\n\t\t\"LAN_BEAM_44\": \"unitb\",\r\n\t\t\"LAN_FLASH_9C\": \"unitc\",\r\n\t\t\"LAN_GLOW_2B\": \"unitd\",\r\n\t}\r\n\tfor _, c := range cards {\r\n\t\tdir, ok := roots[c.id]\r\n"]
[14.687858, "o", "\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tbody := unitSource(dir, c.id, c.slots)\r\n\t\tp := filepath.Join(\"/app/packbay/units\", dir, \"pack.go\")\r\n\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc unitSource(pkg, id string, slots []string) string {\r\n\tquoted := make([]string, 0, len(slots))\r\n\tfor _, s := range slots {\r\n\t\tquoted = append(quoted, `\"`+s+`\"`)\r\n"]
[14.687879, "o", "\t}\r\n\treturn \"package \" + pkg + \"\\n\\nimport \\\"loft.local/lanternix/packbay/store\\\"\\n\\nfunc Load() {\\n\\tstore.Offer(\\\"\" + id + \"\\\", store.Spec{Slots: []string{\" + strings.Join(quoted, \", \") + \"}})\\n}\\n\"\r\n}\r\n\r\nfunc writeFill(units []string) error {\r\n\tvar b strings.Builder\r\n\tb.WriteString(\"package packbay\\n\\nimport (\\n\")\r\n\t"]
[14.687896, "o", "for _, u := range units {\r\n\t\tb.WriteString(\"\\t\" + u + \" \\\"loft.local/lanternix/packbay/units/\" + u + \"\\\"\\n\")\r\n\t}\r\n\tb.WriteString(\")\\n\\nfunc Fill() {\\n\")\r\n\tfor _, u := range units {\r\n"]
[14.687915, "o", "\t\tb.WriteString(\"\\t\" + u + \".Load()\\n\")\r\n\t}\r\n\tb.WriteString(\"}\\n\")\r\n\treturn os.WriteFile(\"/app/packbay/reg.go\", []byte(b.String()), 0o644)\r\n"]
[14.687931, "o", "}\r\n\r\nfunc missingCodes(cards []card, chart map[string]store.Spec) []string {\r\n\tvar miss []string\r\n\tfor _, c := range cards {\r\n"]
[14.687952, "o", "\t\tif _, ok := chart[c.id]; !ok {\r\n\t\t\tmiss = append(miss, c.id)\r\n\t\t}\r\n\t}\r\n\treturn miss"]
[14.687966, "o", "\r\n}\r\n"]
[14.688358, "o", "===== milldesk/play.go =====\r\n"]
[14.689763, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n\t\"loft.local/lanternix/packbay\"\r\n)\r\n\r\nfunc Play(lampPath string) int {\r\n\toxbind.Boot()\r\n\tcode, vals, err := parseLamp(lampPath)\r\n\tif err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tpackbay.Pull(code)\r\n\tif !cardsCovered() {\r\n"]
[14.689894, "o", "\t\treturn 2\r\n\t}\r\n\tspec, ok := oxbind.Read(code)\r\n\toutPath := \"/app/glowbank/readout.json\"\r\n\tif !ok {\r\n\t\t_ = writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}})\r\n\t\treturn 1\r\n\t}\r\n\tslots := map[string]string{}\r\n\tfor _, name := range spec.Slots {\r\n\t\tslots[name] = vals[name]\r\n\t}\r\n\t_ = writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots})\r\n\treturn 0\r\n}\r\n\r\nfunc cardsCovered() bool {\r\n\tcards, err := loadCards(\"/app/cardwell\")\r\n\tif err != nil {\r\n\t\treturn false\r\n\t}\r\n\tfor _, c := range cards {\r\n\t\tif _, ok := oxbind.Read(c.id); !ok {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc writeJSON(path string, doc map[string]any) error {\r\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\traw, err := json.MarshalIndent(doc, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\traw = append(raw, '\\n')\r\n\treturn os.WriteFile(path, raw, 0o644)"]
[14.689928, "o", "\r\n}\r\n\r\nfunc parseLamp(path string) (string, map[string]string, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn \"\", nil, err\r\n\t}\r\n\tcode := \"\"\r\n\tvals := map[string]string{}\r\n\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n\t\tline = strings.TrimSpace(line)\r\n"]
[14.689954, "o", "\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(line, \"CODE \") {\r\n\t\t\tcode = strings.TrimSpace(strings.TrimPrefix(line, \"CODE \"))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tk, v, ok := strings.Cut(line, \"=\")\r\n\t"]
[14.68997, "o", "\tif ok {\r\n\t\t\tvals[strings.TrimSpace(k)] = strings.TrimSpace(v)\r\n\t\t}\r\n\t}\r\n\treturn code, vals, nil\r\n"]
[14.689985, "o", "}\r\n\r\ntype card struct {\r\n\tid    string\r\n\tslots []string\r\n}\r\n"]
[14.689999, "o", "\r\nfunc loadCards(dir string) ([]card, error) {\r\n\tents, err := os.ReadDir(dir)\r\n\tif err != nil {\r\n"]
[14.690219, "o", "\t\treturn nil, err\r\n\t}\r\n\tvar out []card\r\n\tfor _, e := range ents {\r\n"]
[14.690244, "o", "\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".card\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\traw, err := os.ReadFile(filepath.Join(dir, e.Name()))\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tc := card{}\r\n\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n\t\t\tline = strings.TrimSpace(line)\r\n\t\t\tif strings.HasPrefix(line, \"id:\") {\r\n\t\t\t\tc.id = strings.TrimSpace(strings.TrimPrefix(line, \"id:\"))\r\n\t\t\t}\r\n\t\t\tif strings.HasPrefix(line, \"slots:\") {\r\n\t\t\t\tparts := strings.Split(strings.TrimSpace(strings.TrimPrefix(line, \"slots:\")), \",\")\r\n\t\t\t\tfor _, p := range parts {\r\n\t\t\t\t\tc.slots = append(c.slots, p)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif c.id != \"\" {\r\n\t\t\tout = append(out, c)\r\n\t\t}\r\n\t}\r\n\treturn out, nil\r\n}\r\n"]
[14.69043, "o", "===== milldesk/Makefile =====\r\n"]
[14.693031, "o", ".PHONY: ship\r\nship:\r\n\tGOPROXY=off GOFLAGS=-mod=mod GOCACHE=/tmp/gocache-lanternix go build -o /app/bin/lanternix loft.local/lanternix/milldesk\r\n"]
[14.69333, "o", "\u001b[?2004hroot@800b294dfd8e:/app# "]
