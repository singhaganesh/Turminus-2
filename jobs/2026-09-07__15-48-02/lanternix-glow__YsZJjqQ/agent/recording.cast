[27.706629, "o", "    55\t\tif err != nil {\r\n    56\t\t\treturn err\r\n    57\t\t}\r\n    58\t\traw = append(raw, '\\n')\r\n    59\t\treturn os.WriteFile(path, raw, 0o644)\r\n    60\t}\r\n    61\t\r\n    62\tfunc parseLamp(path string) (string, map[string]string, error) {\r\n    63\t\traw, err := os.ReadFile(path)\r\n    64\t\tif err != nil {\r\n    65\t\t\treturn \"\", nil, err\r\n    66\t\t}\r\n    67\t\tcode := \"\"\r\n    68\t\tvals := map[string]string{}\r\n    69\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n    70\t\t\tline = strings.TrimSpace(line)\r\n    71\t\t\tif line == \"\" {\r\n    72\t\t\t\tcontinue\r\n    73\t\t\t}\r\n    74\t\t\tif strings.HasPrefix(line, \"CODE \") {\r\n    75\t\t\t\tcode = strings.TrimSpace(strings.TrimPrefix(line, \"CODE \"))\r\n    76\t\t\t\tcontinue\r\n    77\t\t\t}\r\n    78\t\t\tk, v, ok := strings.Cut(line, \"=\")\r\n    79\t\t\tif ok {\r\n    80\t\t\t\tvals[strings.TrimSpace(k)] = strings.TrimSpace(v)\r\n    81\t\t\t}\r\n    82\t\t}\r\n    83\t\treturn code, vals, nil\r\n    84\t}\r\n    85\t\r\n    86\ttype card struct {\r\n"]
