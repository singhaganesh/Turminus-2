[6.481853, "i", "cat /app/notes/ROUTE.txt && printf '\\n--- GRAMMAR ---\\n' && cat /app/notes/GRAMMAR.txt\n"]
[6.482664, "o", "cat /app/notes/ROUTE.txt && printf '\\n--- GRAMMAR ---\\n' && cat /app/notes/GRAMMAR.txt\r\n\u001b[?2004l\r"]
[6.48558, "o", "Pipeline modules live under /app/oxbind, /app/packbay, and /app/milldesk.\r\nCast refreshes generated units under /app/packbay/units and rewrites /app/packbay/reg.go.\r\nReadout: /app/bin/lanternix readout --lamp FILE writes /app/glowbank/readout.json.\r\nCast: /app/bin/lanternix cast\r\n/app/bin/lanternix is the ELF mill from milldesk. milldesk/Makefile has a ship target.\r\nSlot grammar for cards and lamps is in /app/notes/GRAMMAR.txt.\r\nReadout must honor the lamp FILE argument; sample files under /app/lamps are not the only recipe lamps.\r\n"]
[6.485939, "o", "\r\n--- GRAMMAR ---\r\n"]
[6.486923, "o", "Recipe cards under /app/cardwell use:\r\n  id: <CODE>\r\n  slots: name, name\r\n\r\nSample cards on this image: LAN_WARM_01 slots lux,hold_s; LAN_BEAM_44 slots az_deg,el_deg;\r\nLAN_FLASH_9C slots candela,dwell_s; LAN_GLOW_2B slots hue,period_s.\r\n\r\nSample lamps: /app/lamps/flash9c.lamp, /app/lamps/held.lamp, /app/lamps/warm.lamp,\r\n/app/lamps/beam.lamp, /app/lamps/alien.lamp.\r\nLamp files under /app/lamps use:\r\n  CODE <CODE>\r\n  name=value\r\n\r\nReadout JSON: {\"code\": <str id or void>, \"slots\": <dict of name to str value>}\r\nGap probes may write a temporary ghost.card under /app/cardwell.\r\nOffline Go builds use GOPROXY=off and GOFLAGS=-mod=mod.\r\n"]
[6.487124, "o", "\u001b[?2004hroot@800b294dfd8e:/app# "]
[6.608239, "i", "printf '\\n--- FILES ---\\n'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort; printf '\\n--- BINARY ---\\n'; file /app/bin/lanternix; printf '\\n--- GO ---\\n'; find /app -type f \\( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \\) -print\n"]
[6.609039, "o", "printf '\\n--- FILES ---\\n'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort; printf '\\n--- BINARY ---\\n'; file /app/bin/lanternix; printf '\\n--- GO ---\\n'; find /app -type f \\( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \\) -print\r\n\u001b[?2004l\r"]
[6.60951, "o", "\r\n--- FILES ---\r\n"]
[6.615814, "o", "/app/bin/lanternix\r\n/app/cardwell/beam.card\r\n/app/cardwell/flare.card\r\n/app/cardwell/held.card\r\n/app/cardwell/warm.card\r\n/app/go.mod\r\n/app/lamps/alien.lamp\r\n/app/lamps/beam.lamp\r\n/app/lamps/flash9c.lamp\r\n/app/lamps/held.lamp\r\n/app/lamps/warm.lamp\r\n/app/milldesk/Makefile\r\n/app/milldesk/main.go\r\n/app/milldesk/play.go\r\n/app/milldesk/spin.go\r\n/app/notes/GRAMMAR.txt\r\n/app/notes/ROUTE.txt\r\n/app/oxbind/seal.go\r\n/app/packbay/fetch.go\r\n/app/packbay/reg.go\r\n/app/packbay/store/store.go\r\n/app/packbay/units/unita/pack.go\r\n/app/packbay/units/unitb/pack.go\r\n/app/packbay/units/unitc/pack.go\r\n/app/packbay/units/unitd/pack.go\r\n"]
