[53.799509, "i", "cat > /app/milldesk/spin.go <<'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\nfunc Spin() int {\n\tcards, err := loadCards(\"/app/cardwell\")\n\tif err != nil { return 2 }\n\tsort.Slice(cards, func(i, j int) bool { return cards[i].id < cards[j].id })\n\tunits, err := writeUnits(cards)\n\tif err != nil { return 2 }\n\tif err := writeFill(units); err != nil { return 2 }\n\tgoexe := \"/usr/local/go/bin/go\"\n\tif _, err := os.Stat(goexe); err != nil {\n\t\tif goexe, err = exec.LookPath(\"go\"); err != nil { return 2 }\n\t}\n\tcmd := exec.Command(goexe, \"build\", \"-o\", \"/app/bin/lanternix.next\", \"loft.local/lanternix/milldesk\")\n\tcmd.Dir = \"/app\"\n\tcmd.Env = append(os.Environ(), \"GOPROXY=off\", \"GOFLAGS=-mod=mod\", \"GOCACHE=/tmp/gocache-lanternix\")\n\tif err := cmd.Run(); err != nil { return 2 }\n\tif err := os.Rename(\"/app/bin/lanternix.next\", \"/app/bin/lanternix\"); err != nil { return 2 }\n\treturn 0\n}\n\nfunc unitName(i int) string { return fmt.Sprintf(\"unit%04d\", i) }\n\nfunc writeUnits(cards []card) ([]string, error) {\n\troot := \"/app/packbay/units\"\n\tif err := os.RemoveAll(root); err != nil { return nil, err }\n\tunits := make([]string, 0, len(cards))\n\tfor i, c := range cards {\n\t\tu := unitName(i)\n\t\tunits = append(units, u)\n\t\tdir := filepath.Join(root, u)\n\t\tif err := os.MkdirAll(dir, 0755); err != nil { return nil, err }\n\t\tif err := os.WriteFile(filepath.Join(dir, \"pack.go\"), []byte(unitSource(u, c.id, c.slots)), 0644); err != nil { return nil, err }\n\t}\n\treturn units, nil\n}\n\nfunc unitSource(pkg, id string, slots []string) string {\n\tq := make([]string, len(slots))\n\tfor i, s := range slots { q[i] = fmt.Sprintf(\"%q\", s) }\n\treturn fmt.Sprintf(\"package %s\\n\\nimport \\\\\\\"loft.local/lanternix/packbay/store\\\\\\\"\\n\\nfunc Load() { store.Offer(%q, store.Spec{Slots: []string{%s}}) }\\n\", pkg, id, strings.Join(q, \", \"))\n}\n\nfunc writeFill(units []string) error {\n\tvar b strings.Builder\n\tb.WriteString(\"package packbay\\n\\nimport (\\n\")\n\tfor _, u := range units { fmt.Fprintf(&b, \"\\t%s \\\\\\\"loft.local/lanternix/packbay/units/%s\\\\\\\"\\n\", u, u) }\n\tb.WriteString(\")\\n\\nfunc Fill() {\\n\")\n\tfor _, u := range units { fmt.Fprintf(&b, \"\\t%s.Load()\\n\", u) }\n\tb.WriteString(\"}\\n\")\n\treturn os.WriteFile(\"/app/packbay/reg.go\", []byte(b.String()), 0644)\n}\nEOF\n"]
