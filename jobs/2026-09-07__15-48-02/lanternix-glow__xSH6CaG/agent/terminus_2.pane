--- reg.go
package packbay

import (
	unit000 "loft.local/lanternix/packbay/units/unit000"
	unit001 "loft.local/lanternix/packbay/units/unit001"
	unit002 "loft.local/lanternix/packbay/units/unit002"
	unit003 "loft.local/lanternix/packbay/units/unit003"
)

func Fill() {
	unit000.Load()
	unit001.Load()
	unit002.Load()
	unit003.Load()
}
