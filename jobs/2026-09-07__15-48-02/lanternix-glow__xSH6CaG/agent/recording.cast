[18.863033, "i", "for f in /app/oxbind/*.go /app/packbay/*.go /app/packbay/store/*.go /app/packbay/units/*/*.go /app/milldesk/*.go /app/milldesk/Makefile; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done\n"]
[18.863797, "o", "for f in /app/oxbind/*.go /app/packbay/*.go /app/packbay/store/*.go /app/packbay/units/*/*.go /app/milldesk/*.go /app/milldesk/Makefile; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[18.864273, "o", "===== /app/oxbind/seal.go =====\r\n"]
[18.868287, "o", "package oxbind\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nvar chart map[string]store.Spec\r\n\r\nfunc Clip(bag map[string]store.Spec) map[string]store.Spec {\r\n\tout := make(map[string]store.Spec, len(bag))\r\n\tfor k, v := range bag {\r\n\t\tout[k] = v\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc Boot() {\r\n\tchart = Clip(store.Bag())\r\n}\r\n\r\nfunc Read(tag string) (store.Spec, bool) {\r\n\ts, ok := chart[tag]\r\n\treturn s, ok\r\n}\r\n"]
[18.868939, "o", "===== /app/packbay/fetch.go =====\r\n"]
[18.870377, "o", "package packbay\r\n\r\nvar seed = []string{\"LAN_WARM_01\", \"LAN_BEAM_44\"}\r\n\r\nfunc Pull(tag string) {\r\n\tok := false\r\n\tfor _, s := range seed {\r\n\t\tif s == tag {\r\n\t\t\tok = true\r\n\t\t\tbreak\r\n\t\t}\r\n"]
[18.870481, "o", "\t}\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tFill()\r\n}\r\n"]
[18.870667, "o", "===== /app/packbay/reg.go =====\r\n"]
[18.872115, "o", "package packbay\r\n\r\nimport (\r\n\tunita \"loft.local/lanternix/packbay/units/unita\"\r\n\tunitb \"loft.local/lanternix/packbay/units/unitb\"\r\n)\r\n\r\nfunc Fill() {\r\n\tunita.Load()\r\n\tunitb.Load()\r\n}\r\n"]
[18.872415, "o", "===== /app/packbay/store/store.go =====\r\n"]
[18.873466, "o", "package store\r\n\r\ntype Spec struct {\r\n\tSlots []string\r\n}\r\n\r\nvar bag = map[string]Spec{}\r\n\r\nfunc Offer(id string, spec Spec) {\r\n\tbag[id] = spec\r\n}\r\n"]
[18.873587, "o", "\r\nfunc Bag() map[string]Spec {\r\n\tout := make(map[string]Spec, len(bag))\r\n\tfor k, v := range bag {\r\n\t\tout[k] = v\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc Reset() {\r\n\tbag = map[string]Spec{}\r\n}\r\n"]
[18.873727, "o", "===== /app/packbay/units/unita/pack.go =====\r\n"]
[18.874993, "o", "package unita\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_WARM_01\", store.Spec{Slots: []string{\"lux\", \" hold_s\"}})\r\n}\r\n"]
[18.875224, "o", "===== /app/packbay/units/unitb/pack.go =====\r\n"]
[18.876224, "o", "package unitb\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_BEAM_44\", store.Spec{Slots: []string{\"az_deg\", \" el_deg\"}})\r\n}\r\n"]
[18.876507, "o", "===== /app/packbay/units/unitc/pack.go =====\r\n"]
[18.87769, "o", "package unitc\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_FLASH_9C\", store.Spec{Slots: []string{\"candela\", \"  dwell_s\"}})\r\n}\r\n"]
[18.877968, "o", "===== /app/packbay/units/unitd/pack.go =====\r\n"]
[18.879388, "o", "package unitd\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_GLOW_2B\", store.Spec{Slots: []string{\"hue\", \"  period_s\"}})\r\n}\r\n"]
[18.879683, "o", "===== /app/milldesk/main.go =====\r\n"]
[18.880943, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n\t\"loft.local/lanternix/packbay\"\r\n)\r\n\r\nfunc main() {\r\n\tos.Exit(run(os.Args[1:]))\r\n}\r\n\r\nfunc run(args []string) int {\r\n\tif len(args) == 0 {\r\n\t\treturn 2\r\n"]
[18.881051, "o", "\t}\r\n\tswitch args[0] {\r\n\tcase \"cast\":\r\n\t\tpackbay.Pull(\"LAN_WARM_01\")\r\n\t\toxbind.Boot()\r\n\t\treturn Spin()\r\n\tcase \"readout\":\r\n\t\tif len(args) < 3 || args[1] != \"--lamp\" {\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\treturn Play(args[2])\r\n\tdefault:\r\n\t\treturn 2\r\n\t}\r\n}\r\n"]
[18.881233, "o", "===== /app/milldesk/play.go =====\r\n"]
[18.88239, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n\t\"loft.local/lanternix/packbay\"\r\n"]
[18.882516, "o", ")\r\n\r\nfunc Play(lampPath string) int {\r\n\toxbind.Boot()\r\n\tcode, vals, err := parseLamp(lampPath)\r\n\tif err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tpackbay.Pull(code)\r\n\tif !cardsCovered() {\r\n\t\treturn 2\r\n\t}\r\n\tspec, ok := oxbind.Read(code)\r\n\toutPath := \"/app/glowbank/readout.json\"\r\n\tif !ok {\r\n\t\t_ = writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}})\r\n\t\treturn 1\r\n\t}\r\n\tslots := map[string]string{}\r\n\tfor _, name := range spec.Slots {\r\n\t\tslots[name] = vals[name]\r\n\t}\r\n\t_ = writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots})\r\n\treturn 0\r\n}\r\n\r\nfunc cardsCovered() bool {\r\n\tcards, err := loadCards(\"/app/cardwell\")\r\n\tif err != nil {\r\n\t\treturn false\r\n\t}\r\n\tfor _, c := range cards {\r\n\t\tif _, ok := oxbind.Read(c.id); !ok {\r\n\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc writeJSON(path string, doc map[string]any) error {\r\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\traw, err := json.MarshalIndent(doc, \"\", \"  \")\r\n\tif err != nil {\r\n"]
[18.88261, "o", "\t\treturn err\r\n\t}\r\n\traw = append(raw, '\\n')\r\n\treturn os.WriteFile(path, raw, 0o644)\r\n}\r\n\r\nfunc parseLamp(path string) (string, map[string]string, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn \"\", nil, err\r\n\t}\r\n\tcode := \"\"\r\n\tvals := map[string]string{}\r\n\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n\t\tline = strings.TrimSpace(line)\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(line, \"CODE \") {\r\n\t\t\tcode = strings.TrimSpace(strings.TrimPrefix(line, \"CODE \"))\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tk, v, ok := strings.Cut(line, \"=\")\r\n\t\tif ok {\r\n\t\t\tvals[strings.TrimSpace(k)] = strings.TrimSpace(v)\r\n\t\t}\r\n\t}\r\n\treturn code, vals, nil\r\n}\r\n\r\ntype card struct {\r\n"]
[18.882699, "o", "\tid    string\r\n\tslots []string\r\n}\r\n\r\nfunc loadCards(dir string) ([]card, error) {\r\n\tents, err := os.ReadDir(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar out []card\r\n\tfor _, e := range ents {\r\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".card\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\traw, err := os.ReadFile(filepath.Join(dir, e.Name()))\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tc := card{}\r\n\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n\t\t\tline = strings.TrimSpace(line)\r\n\t\t\tif strings.HasPrefix(line, \"id:\") {\r\n\t\t\t\tc.id = strings.TrimSpace(strings.TrimPrefix(line, \"id:\"))\r\n\t\t\t}\r\n\t\t\tif strings.HasPrefix(line, \"slots:\") {\r\n\t\t\t\tparts := strings.Split(strings.TrimSpace(strings.TrimPrefix(line, \"slots:\")), \",\")\r\n\t\t\t\tfor _, p := range parts {\r\n\t\t\t\t\tc.slots = append(c.slots, p)\r\n"]
[18.882762, "o", "\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif c.id != \"\" {\r\n\t\t\tout = append(out, c)\r\n\t\t}\r\n\t}\r\n\treturn out, nil\r\n}\r\n"]
[18.882963, "o", "===== /app/milldesk/spin.go =====\r\n"]
[18.884171, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\t\"time\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n\t\"loft.local/lanternix/packbay/store\"\r\n)\r\n"]
[18.884279, "o", "\r\nfunc Spin() int {\r\n\ttime.Sleep(2 * time.Second)\r\n\tcards, err := loadCards(\"/app/cardwell\")\r\n\tif err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := writeUnits(cards); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := writeFill([]string{\"unita\", \"unitb\"}); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\t_ = oxbind.Clip(store.Bag())\r\n\tif miss := missingCodes(cards, map[string]store.Spec{}); len(miss) > 0 {\r\n\t}\r\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", \"/app/bin/lanternix.next\", \"loft.local/lanternix/milldesk\")\r\n\tcmd.Dir = \"/app\"\r\n\tcmd.Env = append(os.Environ(),\r\n\t\t\"GOPROXY=off\",\r\n\t\t\"GOFLAGS=-mod=mod\",\r\n\t\t\"GOCACHE=/tmp/gocache-lanternix\",\r\n\t\t\"PATH=/usr/local/go/bin:\"+os.Getenv(\"PATH\"),\r\n\t)\r\n\tif err := cmd.Run(); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := os.Rename(\"/app/bin/lanternix.next\", \"/app/bin/lanternix\"); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc writeUnits(cards []card) error {\r\n\troots := map[string]string{\r\n\t\t\"LAN_WARM_01\": \"unita\",\r\n\t\t\"LAN_BEAM_44\": \"unitb\",\r\n\t\t\"LAN_FLASH_9C\": \"unitc\",\r\n\t\t\"LAN_GLOW_2B\": \"unitd\",\r\n"]
[18.884392, "o", "\t}\r\n\tfor _, c := range cards {\r\n\t\tdir, ok := roots[c.id]\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tbody := unitSource(dir, c.id, c.slots)\r\n\t\tp := filepath.Join(\"/app/packbay/units\", dir, \"pack.go\")\r\n\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc unitSource(pkg, id string, slots []string) string {\r\n\tquoted := make([]string, 0, len(slots))\r\n\tfor _, s := range slots {\r\n\t\tquoted = append(quoted, `\"`+s+`\"`)\r\n\t}\r\n\treturn \"package \" + pkg + \"\\n\\nimport \\\"loft.local/lanternix/packbay/store\\\"\\n\\nfunc Load() {\\n\\tstore.Offer(\\\"\" + id + \"\\\", store.Spec{Slots: []string{\" + strings.Join(quoted, \", \") + \"}})\\n}\\n\"\r\n}\r\n\r\nfunc writeFill(units []string) error {\r\n\tvar b strings.Builder\r\n\tb.WriteString(\"package packbay\\n\\nimport (\\n\")\r\n\tfor _, u := range units {\r\n\t\tb.WriteString(\"\\t\" + u + \" \\\"loft.local/lanternix/packbay/units/\" + u + \"\\\"\\n\")\r\n\t}\r\n\tb.WriteString(\")\\n\\nfunc Fill() {\\n\")\r\n\tfor _, u := range units {\r\n\t\tb.WriteString(\"\\t\" + u + \".Load()\\n\")\r\n\t}\r\n\tb.WriteString(\"}\\n\")\r\n"]
[18.88443, "o", "\treturn os.WriteFile(\"/app/packbay/reg.go\", []byte(b.String()), 0o644)\r\n}\r\n\r\nfunc missingCodes(cards []card, chart map[string]store.Spec) []string {\r\n\tvar miss []string\r\n\tfor _, c := range cards {\r\n\t\tif _, ok := chart[c.id]; !ok {\r\n\t\t\tmiss = append(miss, c.id)\r\n\t\t}\r\n\t}\r\n\treturn miss\r\n}\r\n"]
[18.88466, "o", "===== /app/milldesk/Makefile =====\r\n"]
[18.885805, "o", ".PHONY: ship\r\nship:\r\n\tGOPROXY=off GOFLAGS=-mod=mod GOCACHE=/tmp/gocache-lanternix go build -o /app/bin/lanternix loft.local/lanternix/milldesk\r\n"]
[18.886089, "o", "\u001b[?2004h"]
[18.886201, "o", "root@29d68bc0515d:/app# "]
[19.807012, "i", "for f in /app/cardwell/* /app/lamps/*; do echo \"===== $f =====\"; cat \"$f\"; done; echo '===== binary ====='; ls -l /app/bin/lanternix; od -An -tx1 -N16 /app/bin/lanternix 2>/dev/null || true\n"]
[19.807948, "o", "for f in /app/cardwell/* /app/lamps/*; do echo \"===== $f =====\"; cat \"$f\"; done; echo '===== binary ====='; ls -l /app/bin/lanternix; od -An -tx1 -N16 /app/bin/lanternix 2>/dev/null || true\r\n\u001b[?2004l\r"]
[19.808144, "o", "===== /app/cardwell/beam.card =====\r\n"]
[19.809367, "o", "id: LAN_BEAM_44\r\nslots: az_deg, el_deg\r\n"]
[19.809713, "o", "===== /app/cardwell/flare.card =====\r\n"]
[19.810555, "o", "id: LAN_FLASH_9C\r\nslots: candela,  dwell_s\r\n"]
[19.810716, "o", "===== /app/cardwell/held.card =====\r\n"]
[19.811491, "o", "id: LAN_GLOW_2B\r\nslots: hue,  period_s\r\n"]
[19.81169, "o", "===== /app/cardwell/warm.card =====\r\n"]
[19.812715, "o", "id: LAN_WARM_01\r\nslots: lux, hold_s\r\n"]
[19.812911, "o", "===== /app/lamps/alien.lamp =====\r\n"]
[19.813781, "o", "CODE LAN_ALIEN_FF\r\nnoise=1\r\n"]
