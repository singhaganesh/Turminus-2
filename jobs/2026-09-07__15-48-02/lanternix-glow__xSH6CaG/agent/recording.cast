[36.874234, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t\t\"strings\"\r\n     8\t\r\n     9\t\t\"loft.local/lanternix/oxbind\"\r\n    10\t\t\"loft.local/lanternix/packbay\"\r\n    11\t)\r\n    12\t\r\n    13\tfunc Play(lampPath string) int {\r\n    14\t\toxbind.Boot()\r\n    15\t\tcode, vals, err := parseLamp(lampPath)\r\n    16\t\tif err != nil {\r\n    17\t\t\treturn 2\r\n    18\t\t}\r\n    19\t\tpackbay.Pull(code)\r\n    20\t\tif !cardsCovered() {\r\n    21\t\t\treturn 2\r\n    22\t\t}\r\n"]
[36.874282, "o", "    23\t\tspec, ok := oxbind.Read(code)\r\n    24\t\toutPath := \"/app/glowbank/readout.json\"\r\n    25\t\tif !ok {\r\n    26\t\t\t_ = writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}})\r\n    27\t\t\treturn 1\r\n    28\t\t}\r\n    29\t\tslots := map[string]string{}\r\n    30\t\tfor _, name := range spec.Slots {\r\n    31\t\t\tslots[name] = vals[name]\r\n    32\t\t}\r\n    33\t\t_ = writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots})\r\n    34\t\treturn 0\r\n    35\t}\r\n    36\t\r\n    37\tfunc cardsCovered() bool {\r\n"]
[36.874298, "o", "    38\t\tcards, err := loadCards(\"/app/cardwell\")\r\n    39\t\tif err != nil {\r\n    40\t\t\treturn false\r\n    41\t\t}\r\n    42\t\tfor _, c := range cards {\r\n"]
[36.874468, "o", "    43\t\t\tif _, ok := oxbind.Read(c.id); !ok {\r\n    44\t\t\t\treturn false\r\n    45\t\t\t}\r\n    46\t\t}\r\n    47\t\treturn true\r\n"]
[36.874504, "o", "    48\t}\r\n    49\t\r\n    50\tfunc writeJSON(path string, doc map[string]any) error {\r\n    51\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\r\n    52\t\t\treturn err\r\n    53\t\t}\r\n    54\t\traw, err := json.MarshalIndent(doc, \"\", \"  \")\r\n    55\t\tif err != nil {\r\n    56\t\t\treturn err\r\n    57\t\t}\r\n    58\t\traw = append(raw, '\\n')\r\n    59\t\treturn os.WriteFile(path, raw, 0o644)\r\n    60\t}\r\n    61\t\r\n    62\tfunc parseLamp(path string) (string, map[string]string, error) {\r\n    63\t\traw, err := os.ReadFile(path)\r\n    64\t\tif err != nil {\r\n    65\t\t\treturn \"\", nil, err\r\n    66\t\t}\r\n    67\t\tcode := \"\"\r\n    68\t\tvals := map[string]string{}\r\n    69\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n    70\t\t\tline = strings.TrimSpace(line)\r\n    71\t\t\tif line == \"\" {\r\n    72\t\t\t\tcontinue\r\n    73\t\t\t}\r\n    74\t\t\tif strings.HasPrefix(line, \"CODE \") {\r\n    75\t\t\t\tcode = strings.TrimSpace(strings.TrimPrefix(line, \"CODE \"))\r\n    76\t\t\t\tcontinue\r\n    77\t\t\t}\r\n    78\t\t\tk, v, ok := strings.Cut(line, \"=\")\r\n    79\t\t\tif ok {\r\n    80\t\t\t\tvals[strings.TrimSpace(k)] = strings.TrimSpace(v)\r\n    81\t\t\t}\r\n    82\t\t}\r\n    83\t\treturn code, vals, nil\r\n    84\t}\r\n    85\t\r\n    86\ttype card struct {\r\n    87\t\tid    string\r\n    88\t\tslots []string\r\n    89\t}\r\n    90\t\r\n    91\tfunc loadCards(dir string) ([]card, error) {\r\n    92\t\tents, err := os.ReadDir(dir)\r\n    93\t\tif err != nil {\r\n    94\t\t\treturn nil, err\r\n    95\t\t}\r\n    96\t\t"]
[36.874527, "o", "var out []card\r\n    97\t\tfor _, e := range ents {\r\n    98\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".card\") {\r\n    99\t\t\t\tcontinue\r\n   100\t\t\t}\r\n   101\t\t\traw, err := os.ReadFile(filepath.Join(dir, e.Name()))\r\n"]
[36.874539, "o", "   102\t\t\tif err != nil {\r\n   103\t\t\t\treturn nil, err\r\n   104\t\t\t}\r\n   105\t\t\tc := card{}\r\n"]
[36.874548, "o", "   106\t\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n   107\t\t\t\tline = strings.TrimSpace(line)\r\n"]
[36.874563, "o", "   108\t\t\t\tif strings.HasPrefix(line, \"id:\") {\r\n   109\t\t\t\t\tc.id = strings.TrimSpace(strings.TrimPrefix(line, \"id:\"))\r\n"]
[36.874582, "o", "   110\t\t\t\t}\r\n   111\t\t\t\tif strings.HasPrefix(line, \"slots:\") {\r\n   112\t\t\t\t\tparts := strings.Split(strings.TrimSpace(strings.TrimPrefix(line, \"slots:\")), \",\")\r\n   113\t\t\t\t\tfor _, p := range parts {\r\n"]
[36.874597, "o", "   114\t\t\t\t\t\tc.slots = append(c.slots, p)\r\n   115\t\t\t\t\t}\r\n"]
[36.874613, "o", "   116\t\t\t\t}\r\n   117\t\t\t}\r\n   118\t\t\tif c.id != \"\" {\r\n"]
[36.874627, "o", "   119\t\t\t\tout = append(out, c)\r\n   120\t\t\t}\r\n   121\t\t}\r\n   122\t\treturn out, nil\r\n"]
[36.874642, "o", "   123\t}\r\n"]
