[99.436352, "i", "cat > /app/milldesk/spin.go <<'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nfunc Spin() int {\n\tcards, err := loadCards(\"/app/cardwell\")\n\tif err != nil {\n\t\treturn 2\n\t}\n\tunits, err := writeUnits(cards)\n\tif err != nil {\n\t\treturn 2\n\t}\n\tif err := writeFill(units); err != nil {\n\t\treturn 2\n\t}\n\n\tif err := os.MkdirAll(\"/app/bin\", 0o755); err != nil {\n\t\treturn 2\n\t}\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", \"/app/bin/lanternix.next\", \"loft.local/lanternix/milldesk\")\n\tcmd.Dir = \"/app\"\n\tcmd.Env = append(os.Environ(),\n\t\t\"GOPROXY=off\",\n\t\t\"GOFLAGS=-mod=mod\",\n\t\t\"GOCACHE=/tmp/gocache-lanternix\",\n\t\t\"PATH=/usr/local/go/bin:\"+os.Getenv(\"PATH\"),\n\t)\n\tif err := cmd.Run(); err != nil {\n\t\t_ = os.Remove(\"/app/bin/lanternix.next\")\n\t\treturn 2\n\t}\n\tif err := os.Rename(\"/app/bin/lanternix.next\", \"/app/bin/lanternix\"); err != nil {\n\t\treturn 2\n\t}\n\treturn 0\n}\n\nfunc writeUnits(cards []card) ([]string, error) {\n\troot := \"/app/packbay/units\"\n\tif err := os.RemoveAll(root); err != nil {\n\t\treturn nil, err\n\t}\n\tif err := os.MkdirAll(root, 0o755); err != nil {\n\t\treturn nil, err\n\t}\n\tunits := make([]string, 0, len(cards))\n\tseen := map[string]bool{}\n\tfor i, c := range cards {\n\t\tif seen[c.id] {\n\t\t\treturn nil, fmt.Errorf(\"duplicate card id %q\", c.id)\n\t\t}\n\t\tseen[c.id] = true\n\t\tpkg := fmt.Sprintf(\"unit%03d\", i)\n\t\tdir := filepath.Join(root, pkg)\n\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif err := os.WriteFile(filepath.Join(dir, \"pack.go\"), []byte(unitSource(pkg, c.id, c.slots)), 0o644); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tunits = append(units, pkg)\n\t}\n\treturn units, nil\n}\n\nfunc unitSource(pkg, id string, slots []string) string {\n\tquoted := make([]string, 0, len(slots))\n\tfor _, s := range slots {\n\t\tquoted = append(quoted, strconv.Quote(strings.TrimSpace(s)))\n\t}\n\treturn \"package \" + pkg + \"\\n\\nimport \\\"loft.local/lanternix/packbay/store\\\"\\n\\nfunc Load() {\\n\\tstore.Offer(\" + strconv.Quote(id) + \", store.Spec{Slots: []string{\" + strings.Join(quoted, \", \") + \"}})\\n}\\n\"\n}\n\nfunc writeFill(units []string) error {\n\tvar b strings.Builder\n\tb.WriteString(\"package packbay\\n\\nimport (\\n\")\n\tfor _, u := range units {\n\t\tb.WriteString(\"\\t\" + u + \" \\\"loft.local/lanternix/packbay/units/\" + u + \"\\\"\\n\")\n\t}\n\tb.WriteString(\")\\n\\nfunc Fill() {\\n\")\n\tfor _, u := range units {\n\t\tb.WriteString(\"\\t\" + u + \".Load()\\n\")\n\t}\n\tb.WriteString(\"}\\n\")\n\treturn os.WriteFile(\"/app/packbay/reg.go\", []byte(b.String()), 0o644)\n}\nEOF\ngofmt -w /app/oxbind /app/packbay /app/milldesk\ngrep -R \"func missingCodes\" -n /app || true\nGOPROXY=off GOFLAGS=-mod=mod GOCACHE=/tmp/gocache-lanternix go build -o /app/bin/lanternix loft.local/lanternix/milldesk\n"]
