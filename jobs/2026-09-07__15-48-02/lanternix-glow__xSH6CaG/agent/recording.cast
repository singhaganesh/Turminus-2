[99.221369, "i", "cat > /app/milldesk/play.go <<'EOF'\npackage main\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"loft.local/lanternix/oxbind\"\n)\n\nfunc Play(lampPath string) int {\n\tcode, vals, err := parseLamp(lampPath)\n\tif err != nil {\n\t\treturn 2\n\t}\n\n\tcards, err := loadCards(\"/app/cardwell\")\n\tif err != nil {\n\t\treturn 2\n\t}\n\tvar present bool\n\tfor _, c := range cards {\n\t\tif c.id == code {\n\t\t\tpresent = true\n\t\t\tbreak\n\t\t}\n\t}\n\n\toutPath := \"/app/glowbank/readout.json\"\n\tif !present {\n\t\tif writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}}) != nil {\n\t\t\treturn 2\n\t\t}\n\t\treturn 1\n\t}\n\n\toxbind.Boot()\n\tspec, carried := oxbind.Read(code)\n\tif !carried {\n\t\t// A card added after this mill was cast is not carried. Do not damage a\n\t\t// successful readout produced by an earlier invocation.\n\t\treturn 1\n\t}\n\n\tslots := make(map[string]string, len(spec.Slots))\n\tfor _, name := range spec.Slots {\n\t\tslots[name] = vals[name]\n\t}\n\tif writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots}) != nil {\n\t\treturn 2\n\t}\n\treturn 0\n}\n\nfunc writeJSON(path string, doc map[string]any) error {\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\traw, err := json.MarshalIndent(doc, \"\", \"  \")\n\tif err != nil {\n\t\treturn err\n\t}\n\traw = append(raw, '\\n')\n\ttmp, err := os.CreateTemp(filepath.Dir(path), \".readout-*\")\n\tif err != nil {\n\t\treturn err\n\t}\n\ttmpName := tmp.Name()\n\tdefer os.Remove(tmpName)\n\tif err = tmp.Chmod(0o644); err == nil {\n\t\t_, err = tmp.Write(raw)\n\t}\n\tif closeErr := tmp.Close(); err == nil {\n\t\terr = closeErr\n\t}\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.Rename(tmpName, path)\n}\n\nfunc parseLamp(path string) (string, map[string]string, error) {\n\traw, err := os.ReadFile(path)\n\tif err != nil {\n\t\treturn \"\", nil, err\n\t}\n\tcode := \"\"\n\tvals := map[string]string{}\n\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n\t\tline = strings.TrimSpace(line)\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(line, \"CODE \") {\n\t\t\tcode = strings.TrimSpace(strings.TrimPrefix(line, \"CODE \"))\n\t\t\tcontinue\n\t\t}\n\t\tif k, v, ok := strings.Cut(line, \"=\"); ok {\n\t\t\tvals[strings.TrimSpace(k)] = strings.TrimSpace(v)\n\t\t}\n\t}\n\tif code == \"\" {\n\t\treturn \"\", nil, errors.New(\"lamp has no code\")\n\t}\n\treturn code, vals, nil\n}\n\ntype card struct {\n\tid    string\n\tslots []string\n}\n\nfunc loadCards(dir string) ([]card, error) {\n\tents, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar out []card\n\tfor _, e := range ents {\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".card\") {\n\t\t\tcontinue\n\t\t}\n\t\traw, err := os.ReadFile(filepath.Join(dir, e.Name()))\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tc := card{}\n\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif strings.HasPrefix(line, \"id:\") {\n\t\t\t\tc.id = strings.TrimSpace(strings.TrimPrefix(line, \"id:\"))\n\t\t\t} else if strings.HasPrefix(line, \"slots:\") {\n\t\t\t\tfor _, p := range strings.Split(strings.TrimSpace(strings.TrimPrefix(line, \"slots:\")), \",\") {\n\t\t\t\t\tif name := strings.TrimSpace(p); name != \"\" {\n\t\t\t\t\t\tc.slots = append(c.slots, name)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif c.id != \"\" {\n\t\t\tout = append(out, c)\n\t\t}\n\t}\n\treturn out, nil\n}\nEOF\n"]
