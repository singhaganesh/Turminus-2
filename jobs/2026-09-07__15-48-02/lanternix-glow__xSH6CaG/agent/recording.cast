[99.067564, "i", "cat > /app/oxbind/seal.go <<'EOF'\npackage oxbind\n\nimport (\n\t\"loft.local/lanternix/packbay\"\n\t\"loft.local/lanternix/packbay/store\"\n)\n\nvar chart = map[string]store.Spec{}\n\nfunc Clip(bag map[string]store.Spec) map[string]store.Spec {\n\tout := make(map[string]store.Spec, len(bag))\n\tfor k, v := range bag {\n\t\tv.Slots = append([]string(nil), v.Slots...)\n\t\tout[k] = v\n\t}\n\treturn out\n}\n\nfunc Boot() {\n\tstore.Reset()\n\tpackbay.Fill()\n\tchart = Clip(store.Bag())\n}\n\nfunc Read(tag string) (store.Spec, bool) {\n\ts, ok := chart[tag]\n\treturn s, ok\n}\nEOF\ncat > /app/packbay/fetch.go <<'EOF'\npackage packbay\n\n// Pull loads the registry generated by cast. The tag is retained for the\n// pipeline API; selection is performed by oxbind.Read.\nfunc Pull(tag string) {\n\tFill()\n}\nEOF\npython3 - <<'PY'\np='/app/milldesk/main.go'\ns=open(p).read()\ns=s.replace('\\n\\t\"loft.local/lanternix/oxbind\"\\n\\t\"loft.local/lanternix/packbay\"\\n', '')\ns=s.replace('\\t\\tpackbay.Pull(\"LAN_WARM_01\")\\n\\t\\toxbind.Boot()\\n\\t\\treturn Spin()', '\\t\\treturn Spin()')\nopen(p,'w').write(s)\nPY\n"]
