[81.594193, "o", "\u001b[?2004hroot@8a584b79dc9f:/app# "]
[81.773279, "i", "cat > /app/qanbox/tally.rs <<'EOF'\n#[path = \"../treyfun/clip.rs\"]\nmod clip;\n\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<String>,\n    pub body: String,\n}\n\npub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\n    let paths = crate::walk::gather(a)?;\n    let mut bag: BTreeMap<String, Rec> = BTreeMap::new();\n    for path in paths {\n        let text = std::fs::read_to_string(&path).map_err(|_| 3)?;\n        let (kind, frames) = clip::take(&text)?;\n        let body = frames.join(\" | \");\n        let identity = frames.join(\"\\u{1f}\");\n        let rec = Rec { issue: 0, kind, frames, body };\n        match bag.get(&identity) {\n            Some(old) if old.kind != rec.kind => return Err(3),\n            Some(_) => {}\n            None => { bag.insert(identity, rec); }\n        }\n    }\n    if bag.is_empty() { return Err(3); }\n    let mut recs: Vec<Rec> = bag.into_values().collect();\n    recs.sort_by(|a, b| a.body.cmp(&b.body).then(a.kind.cmp(&b.kind)));\n    for (i, rec) in recs.iter_mut().enumerate() { rec.issue = i as i32 + 1; }\n    Ok(recs)\n}\nEOF\ncat > /app/humdock/emit.rs <<'EOF'\nuse crate::tally::Rec;\n\npub fn emit(rows: &[Rec]) -> i32 {\n    let mut inner = String::new();\n    for (i, r) in rows.iter().enumerate() {\n        if i != 0 { inner.push(','); }\n        inner.push_str(&format!(\"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\n            r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body)));\n    }\n    let bound = format!(\"{{\\\"findings\\\":[{}]}}\\n\", inner);\n    let mut desk = String::from(\"issue\\tkind\\tbody\\n\");\n    for r in rows {\n        desk.push_str(&format!(\"{}\\t{}\\t{}\\n\", r.issue, r.kind, r.body));\n    }\n    if std::fs::create_dir_all(\"/app/inkbay\").is_err() { return 1; }\n    if std::fs::write(\"/app/inkbay/bound.json\", bound).is_err() { return 1; }\n    if std::fs::write(\"/app/inkbay/desk.tsv\", desk).is_err() { return 1; }\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() { return 1; }\n    0\n}\n\nfn jstr(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\\\\' => out.push_str(\"\\\\\\\\\"), '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"'); out\n}\nfn jarr(v: &[String]) -> String {\n    format!(\"[{}]\", v.iter().map(|s| jstr(s)).collect::<Vec<_>>().join(\",\"))\n}\nEOF\npython3 - <<'PY'\np='/app/ketchcli/main.rs'\ns=open(p).read()\ns=s.replace('    let mut args = std::env::args();', '    let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\\n    let mut args = std::env::args();')\ns=s.replace('    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());', '    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\\n    if args.next().is_some() { std::process::exit(2); }')\nopen(p,'w').write(s)\nPY\n/app/hearth.sh\n"]
