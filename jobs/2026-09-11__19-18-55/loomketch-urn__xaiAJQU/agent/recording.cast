[27.717886, "o", "issue\tkind\tbody\r\n1\theap-buffer-overflow\t__interceptor_memcpy | fill_span | prep_buf\r\n2\theap-use-after-free\t__interceptor_memcpy | widget_free | worker_main\r\n3\tstack-buffer-overflow\t__interceptor_memcpy | pump_read | loop_tick\r\n4\tuse-after-return\t__interceptor_memcpy | latch_tick | drain_slot\r\n"]
[27.718192, "o", "\u001b[?2004hroot@8a584b79dc9f:/app# "]
[81.571753, "i", "cat > /app/urnwalk/walk.rs <<'EOF'\nuse std::path::{Path, PathBuf};\n\npub fn gather(a: &str) -> Result<Vec<String>, i32> {\n    let allowed = std::fs::canonicalize(\"/app/vatlogs\").map_err(|_| 2)?;\n    let root = std::fs::canonicalize(a).map_err(|_| 2)?;\n    if !root.starts_with(&allowed) || !root.is_dir() {\n        return Err(2);\n    }\n    let mut paths = Vec::new();\n    visit(&root, &allowed, &mut paths)?;\n    paths.sort();\n    if paths.is_empty() {\n        return Err(2);\n    }\n    Ok(paths.into_iter().map(|p| p.to_string_lossy().into_owned()).collect())\n}\n\nfn visit(dir: &Path, allowed: &Path, out: &mut Vec<PathBuf>) -> Result<(), i32> {\n    let rd = std::fs::read_dir(dir).map_err(|_| 2)?;\n    for ent in rd {\n        let ent = ent.map_err(|_| 2)?;\n        let path = ent.path();\n        let meta = std::fs::symlink_metadata(&path).map_err(|_| 2)?;\n        if meta.file_type().is_symlink() {\n            return Err(2);\n        }\n        let canon = std::fs::canonicalize(&path).map_err(|_| 2)?;\n        if !canon.starts_with(allowed) {\n            return Err(2);\n        }\n        if meta.is_dir() {\n            visit(&canon, allowed, out)?;\n        } else if meta.is_file() {\n            out.push(canon);\n        } else {\n            return Err(2);\n        }\n    }\n    Ok(())\n}\nEOF\ncat > /app/treyfun/clip.rs <<'EOF'\npub fn clip(a: &[String]) -> Vec<String> {\n    a.iter()\n        .filter(|s| !runtime_frame(s))\n        .map(|s| fold_hex(s))\n        .collect()\n}\n\nfn runtime_frame(s: &str) -> bool {\n    s.starts_with(\"__asan\") || s.starts_with(\"__interceptor\") || s.starts_with(\"__hwasan\")\n}\n\nfn fold_hex(s: &str) -> String {\n    let b = s.as_bytes();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < b.len() {\n        if i + 2 < b.len() && b[i] == b'0' && (b[i + 1] == b'x' || b[i + 1] == b'X') && b[i + 2].is_ascii_hexdigit() {\n            out.push_str(\"0xHEX\");\n            i += 2;\n            while i < b.len() && b[i].is_ascii_hexdigit() { i += 1; }\n        } else {\n            out.push(b[i] as char);\n            i += 1;\n        }\n    }\n    out\n}\n\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() { return Err(3); }\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut summary = false;\n    for line in text.lines() {\n        if line.contains(\"ERROR:\") {\n            if kind.is_some() { return Err(3); }\n            let rest = line.split_once(\"ERROR:\").map(|x| x.1).unwrap_or(\"\").trim();\n            let after = rest.strip_prefix(\"AddressSanitizer:\").ok_or(3)?.trim();\n            let k = after.split(\" on \").next().unwrap_or(\"\").trim();\n            if k.is_empty() { return Err(3); }\n            kind = Some(k.to_string());\n        }\n        let trimmed = line.trim_start();\n        if trimmed.starts_with('#') {\n            let hash_end = trimmed.find(char::is_whitespace).ok_or(3)?;\n            if !trimmed[1..hash_end].chars().all(|c| c.is_ascii_digit()) { return Err(3); }\n            let after = trimmed[hash_end..].split_once(\" in \").map(|x| x.1).ok_or(3)?;\n            let sym = after.split_whitespace().next().unwrap_or(\"\");\n            if sym.is_empty() { return Err(3); }\n            frames.push(sym.to_string());\n        }\n        if trimmed.starts_with(\"SUMMARY: AddressSanitizer\") { summary = true; }\n    }\n    let kind = kind.ok_or(3)?;\n    if frames.is_empty() || !summary { return Err(3); }\n    let frames = clip(&frames);\n    if frames.is_empty() { return Err(3); }\n    Ok((kind, frames))\n}\nEOF\n"]
