[130.8855, "i", "python3 - <<'PY'\nimport json, csv, re\nfrom pathlib import Path\nb=json.load(open('/app/inkbay/bound.json'))['findings']\nassert [r['issue'] for r in b] == list(range(1,len(b)+1))\nassert len({tuple(r['frames']) for r in b}) == len(b)\nwith open('/app/inkbay/desk.tsv', newline='') as f:\n    d=list(csv.DictReader(f, delimiter='\\t'))\nassert d[0].keys() == {'issue','kind','body'}\nassert [(int(x['issue']),x['kind'],x['body']) for x in d] == [(x['issue'],x['kind'],x['body']) for x in b]\nids=set()\nfor p in Path('/app/vatlogs').rglob('*'):\n    if not p.is_file(): continue\n    frames=[]\n    for line in p.read_text().splitlines():\n        m=re.search(r'#\\d+\\s+\\S+\\s+in\\s+(\\S+)', line)\n        if m:\n            s=m.group(1)\n            if not s.startswith(('__asan','__interceptor','__hwasan')):\n                frames.append(re.sub(r'0[xX][0-9a-fA-F]+','0xHEX',s))\n    ids.add(tuple(frames))\nassert ids == {tuple(x['frames']) for x in b}, (ids,b)\nprint('SEMANTICS_OK', len(b), 'findings')\nPY\n"]
