[27.716669, "o", "{\"findings\":[{\"issue\":1,\"kind\":\"heap-use-after-free\",\"frames\":[\"__interceptor_memcpy\",\"widget_free\",\"worker_main\"],\"body\":\"__interceptor_memcpy | widget_free | worker_main\"},{\"issue\":2,\"kind\":\"use-after-return\",\"frames\":[\"__interceptor_memcpy\",\"latch_tick\",\"drain_slot\"],\"body\":\"__interceptor_memcpy | latch_tick | drain_slot\"},{\"issue\":3,\"kind\":\"stack-buffer-overflow\",\"frames\":[\"__interceptor_memcpy\",\"pump_read\",\"loop_tick\"],\"body\":\"__interceptor_memcpy | pump_read | loop_tick\"},{\"issue\":4,\"kind\":\"heap-buffer-overflow\",\"frames\":[\"__interceptor_memcpy\",\"fill_span\",\"prep_buf\"],\"body\":\"__interceptor_memcpy | fill_span | prep_buf\"}]}\r\n"]
