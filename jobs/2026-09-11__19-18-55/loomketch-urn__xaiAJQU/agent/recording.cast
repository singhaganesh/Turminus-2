[26.922459, "i", "printf '%s\\n' '--- main'; sed -n '1,260p' /app/ketchcli/main.rs; printf '%s\\n' '--- walk'; sed -n '1,320p' /app/urnwalk/walk.rs; printf '%s\\n' '--- tally'; sed -n '1,260p' /app/qanbox/tally.rs\n"]
[26.92326, "o", "printf '%s\\n' '--- main'; sed -n '1,260p' /app/ketchcli/main.rs; printf '%s\\n' '--- walk'; sed -n '1,320p' /app/urnwalk/walk.rs; printf '%s\\n' '--- tally'; sed -n '1,260p' /app/qanbox/tally.rs\r\n\u001b[?2004l\r"]
[26.923387, "o", "--- main\r\n"]
[26.928373, "o", "#[path = \"../urnwalk/walk.rs\"]\r\nmod walk;\r\n#[path = \"../walkcue/alpha.rs\"]\r\nmod alpha;\r\n#[path = \"../qanbox/tally.rs\"]\r\nmod tally;\r\n#[path = \"../humdock/emit.rs\"]\r\nmod rib;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"bind\" {\r\n"]
[26.928512, "o", "        eprintln!(\"usage: loomketch bind [root]\");\r\n        std::process::exit(2);\r\n    }\r\n    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\r\n    let code = match tally::tally(&root) {\r\n        Ok(recs) => {\r\n            if rib::emit(&recs) != 0 {\r\n                1\r\n            } else {\r\n                0\r\n            }\r\n        }\r\n        Err(c) => {\r\n            let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\r\n            c\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[26.92879, "o", "--- walk\r\n"]
[26.930732, "o", "pub fn gather(a: &str) -> Result<Vec<String>, i32> {\r\n    let mut v = Vec::new();\r\n    let rd = match std::fs::read_dir(a) {\r\n        Ok(x) => x,\r\n        Err(_) => return Err(2),\r\n    };\r\n    for e in rd {\r\n        let e = match e {\r\n            Ok(x) => x,\r\n            Err(_) => continue,\r\n        };\r\n        let p = e.path();\r\n        if p.is_file() {\r\n            v.push(p.to_string_lossy().into_owned());\r\n        }\r\n    }\r\n    if crate::alpha::lined(&mut v) {\r\n        v.sort();\r\n    }\r\n    Ok(v)\r\n}\r\n"]
[26.931025, "o", "--- tally\r\n"]
[26.932364, "o", "#[path = \"../treyfun/clip.rs\"]\r\nmod clip;\r\n\r\nuse std::collections::HashMap;\r\nuse std::sync::mpsc;\r\nuse std::thread;\r\n\r\n#[derive(Clone)]\r\npub struct Rec {\r\n    pub issue: i32,\r\n    pub kind: String,\r\n    pub frames: Vec<String>,\r\n    pub body: String,\r\n"]
[26.932473, "o", "}\r\n\r\npub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\r\n    let paths = crate::walk::gather(a)?;\r\n    let (tx, rx) = mpsc::channel();\r\n    let mut hs = Vec::new();\r\n    for p in paths {\r\n        let tx = tx.clone();\r\n        hs.push(thread::spawn(move || {\r\n            let text = match std::fs::read_to_string(&p) {\r\n                Ok(t) => t,\r\n                Err(_) => return,\r\n            };\r\n            let (kind, frames) = match clip::take(&text) {\r\n                Ok(x) => x,\r\n                Err(_) => return,\r\n            };\r\n            if kind.is_empty() {\r\n                return;\r\n            }\r\n            let frames = clip::clip(&frames);\r\n            let body = frames.join(\" | \");\r\n            let _ = tx.send(Rec {\r\n                issue: 0,\r\n                kind,\r\n                frames,\r\n                body,\r\n            });\r\n        }));\r\n    }\r\n    drop(tx);\r\n    for h in hs {\r\n        let _ = h.join();\r\n    }\r\n    let mut bag: HashMap<String, Rec> = HashMap::new();\r\n    while let Ok(r) = rx.recv() {\r\n        bag.entry(r.body.clone()).or_insert(r);\r\n    }\r\n    let mut recs: Vec<Rec> = bag.into_values().collect();\r\n    for (i, r) in recs.iter_mut().enumerate() {\r\n        r.issue = (i as i32) + 1;\r\n    }\r\n    let _ = write_bound(&recs);\r\n    Ok(recs)\r\n}\r\n\r\nfn write_bound(recs: &[Rec]) -> i32 {\r\n"]
[26.932571, "o", "    let tpl = std::fs::read_to_string(\"/app/tplbay/bound.tpl\").unwrap_or_else(|_| \"{\\\"findings\\\":[__ROWS__]}\".into());\r\n    if recs.is_empty() {\r\n        let _ = std::fs::write(\"/app/inkbay/bound.json\", tpl);\r\n        return 0;\r\n    }\r\n    let mut inner = String::new();\r\n    for (i, r) in recs.iter().enumerate() {\r\n        if i > 0 {\r\n            inner.push(',');\r\n        }\r\n        inner.push_str(&format!(\r\n            \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\r\n            r.issue,\r\n            jstr(&r.kind),\r\n            jarr(&r.frames),\r\n            jstr(&r.body)\r\n        ));\r\n    }\r\n    let out = tpl.replace(\"__ROWS__\", &inner);\r\n    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    match std::fs::write(\"/app/inkbay/bound.json\", out) {\r\n        Ok(()) => 0,\r\n        Err(_) => 1,\r\n    }\r\n}\r\n\r\nfn jstr(s: &str) -> String {\r\n    format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\"))\r\n}\r\n\r\nfn jarr(v: &[String]) -> String {\r\n    let parts: Vec<String> = v.iter().map(|x| jstr(x)).collect();\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n"]
[26.932668, "o", "}\r\n"]
[26.932881, "o", "\u001b[?2004h"]
[26.93294, "o", "root@8a584b79dc9f:/app# "]
[27.108918, "i", "printf '%s\\n' '--- clip'; sed -n '1,260p' /app/treyfun/clip.rs; printf '%s\\n' '--- emit'; sed -n '1,320p' /app/humdock/emit.rs; printf '%s\\n' '--- alpha'; sed -n '1,260p' /app/walkcue/alpha.rs\n"]
[27.109558, "o", "printf '%s\\n' '--- clip'; sed -n '1,260p' /app/treyfun/clip.rs; printf '%s\\n' '--- emit'; sed -n '1,320p' /app/humdock/emit.rs; printf '%s\\n' '--- alpha'; sed -n '1,260p' /app/walkcue/alpha.rs\r\n\u001b[?2004l\r"]
[27.109633, "o", "--- clip\r\n"]
[27.11239, "o", "pub fn clip(a: &[String]) -> Vec<String> {\r\n    a.iter()\r\n        .filter(|s| !s.starts_with(\"__asan::\") && !s.starts_with(\"__asan_\"))\r\n        .cloned()\r\n        .collect()\r\n}\r\n\r\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\r\n    if text.trim().is_empty() {\r\n        return Ok((String::new(), Vec::new()));\r\n    }\r\n    let mut kind = String::new();\r\n    let mut frames = Vec::new();\r\n    for line in text.lines() {\r\n"]
[27.112534, "o", "        if let Some(rest) = line.split(\"ERROR:\").nth(1) {\r\n            let rest = rest.trim();\r\n            let after = if let Some(x) = rest.split(\"AddressSanitizer:\").nth(1) {\r\n                x.trim()\r\n            } else {\r\n                rest\r\n            };\r\n            kind = after.split(\" on \").next().unwrap_or(after).trim().to_string();\r\n        }\r\n        if let Some(idx) = line.find('#') {\r\n            let chunk = &line[idx..];\r\n            if let Some(after) = chunk.split(\" in \").nth(1) {\r\n                let sym = after.split_whitespace().next().unwrap_or(\"\").to_string();\r\n                if !sym.is_empty() {\r\n                    frames.push(sym);\r\n                }\r\n            }\r\n        }\r\n    }\r\n    Ok((kind, frames))\r\n}\r\n"]
[27.112773, "o", "--- emit\r\n"]
[27.11434, "o", "use crate::tally::Rec;\r\n\r\npub fn emit(a: &[Rec]) -> i32 {\r\n    let mut rows: Vec<Rec> = a.to_vec();\r\n    rows.sort_by(|x, y| x.kind.cmp(&y.kind));\r\n    let mut out = String::from(\"issue\\tkind\\tbody\\n\");\r\n    for (i, r) in rows.iter().enumerate() {\r\n        out.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, r.kind, r.body));\r\n    }\r\n    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    if std::fs::write(\"/app/inkbay/desk.tsv\", out).is_err() {\r\n        return 1;\r\n    }\r\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n"]
[27.114483, "o", "    0\r\n}\r\n"]
[27.114662, "o", "--- alpha\r\n"]
[27.116066, "o", "pub fn lined(a: &mut Vec<String>) -> bool {\r\n    if std::env::var(\"KETCH_ALPHA\").ok().as_deref() == Some(\"1\") {\r\n        a.sort();\r\n        true\r\n    } else {\r\n"]
[27.116186, "o", "        false\r\n    }\r\n}\r\n"]
[27.116327, "o", "\u001b[?2004hroot@8a584b79dc9f:/app# "]
[27.303128, "i", "printf '%s\\n' '--- hearth'; cat /app/hearth.sh; printf '%s\\n' '--- notes'; cat /app/ketchcli/NOTES.txt /app/ketchcli/usage.txt /app/urnwalk/README.txt; printf '%s\\n' '--- templates'; cat /app/tplbay/bound.tpl /app/tplbay/desk.tpl\n"]
[27.303918, "o", "printf '%s\\n' '--- hearth'; cat /app/hearth.sh; printf '%s\\n' '--- notes'; cat /app/ketchcli/NOTES.txt /app/ketchcli/usage.txt /app/urnwalk/README.txt; printf '%s\\n' '--- templates'; cat /app/tplbay/bound.tpl /app/tplbay/desk.tpl\r\n\u001b[?2004l\r"]
[27.303964, "o", "--- hearth\r\n"]
[27.305313, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/inkbay\r\nrustc --edition 2021 -O /app/ketchcli/main.rs -o /app/bin/loomketch\r\n"]
[27.305556, "o", "--- notes\r\n"]
[27.306608, "o", "Subcommand table is bind only.\r\n"]
[27.306726, "o", "loomketch bind [root]\r\nDefault root is /app/vatlogs.\r\n"]
