[168.115765, "i", "cd /app && python3 - <<'PY'\nimport json\nfrom pathlib import Path\nb = json.loads(Path('inkbay/bound.json').read_text())['findings']\nlines = Path('inkbay/desk.tsv').read_text().splitlines()\nassert lines[0] == 'issue\\tkind\\tbody'\nd = []\nfor line in lines[1:]:\n    issue, kind, body = line.split('\\t')\n    d.append({'issue': int(issue), 'kind': kind, 'body': body})\nassert [{'issue': r['issue'], 'kind': r['kind'], 'body': r['body']} for r in b] == d\nassert [r['issue'] for r in b] == list(range(1, len(b) + 1))\nassert all(not any(x in f for x in ('__asan', '__interceptor', '__hwasan')) for r in b for f in r['frames'])\nassert Path('inkbay/GUARD').read_text() == 'ok'\nprint('records/output consistency: ok')\nPY\nsha256sum inkbay/bound.json inkbay/desk.tsv > /tmp/final-hashes\n./bin/loomketch bind\nsha256sum -c /tmp/final-hashes\nprintf 'ELF='; head -c 4 bin/loomketch | od -An -tx1\nprintf 'GUARD='; cat inkbay/GUARD; echo\n"]
