[33.441834, "i", "cd /app && ./bin/loomketch bind; sha256sum inkbay/bound.json inkbay/desk.tsv; cp inkbay/bound.json /tmp/b1; cp inkbay/desk.tsv /tmp/d1; ./bin/loomketch bind; sha256sum inkbay/bound.json inkbay/desk.tsv; cmp -s /tmp/b1 inkbay/bound.json; echo bound_cmp=$?; cmp -s /tmp/d1 inkbay/desk.tsv; echo desk_cmp=$?\n"]
