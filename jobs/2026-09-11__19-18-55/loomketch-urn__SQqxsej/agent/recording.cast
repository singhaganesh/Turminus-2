[126.385909, "i", "cat > /app/urnwalk/walk.rs <<'EOF'\nuse std::path::{Path, PathBuf};\n\npub fn gather(a: &str) -> Result<Vec<String>, i32> {\n    let allowed = std::fs::canonicalize(\"/app/vatlogs\").map_err(|_| 2)?;\n    let root = std::fs::canonicalize(a).map_err(|_| 2)?;\n    if !root.starts_with(&allowed) || !root.is_dir() {\n        return Err(2);\n    }\n\n    let mut paths = Vec::new();\n    visit(&root, &allowed, &mut paths)?;\n    if paths.is_empty() {\n        return Err(3);\n    }\n    paths.sort();\n    Ok(paths.into_iter().map(|p| p.to_string_lossy().into_owned()).collect())\n}\n\nfn visit(dir: &Path, allowed: &Path, out: &mut Vec<PathBuf>) -> Result<(), i32> {\n    let rd = std::fs::read_dir(dir).map_err(|_| 2)?;\n    for entry in rd {\n        let entry = entry.map_err(|_| 2)?;\n        let ty = entry.file_type().map_err(|_| 2)?;\n        if ty.is_symlink() {\n            return Err(2);\n        }\n        let path = entry.path();\n        let real = std::fs::canonicalize(&path).map_err(|_| 2)?;\n        if !real.starts_with(allowed) {\n            return Err(2);\n        }\n        if ty.is_dir() {\n            visit(&real, allowed, out)?;\n        } else if ty.is_file() {\n            out.push(real);\n        } else {\n            return Err(2);\n        }\n    }\n    Ok(())\n}\nEOF\ncat > /app/treyfun/clip.rs <<'EOF'\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() {\n        return Err(3);\n    }\n\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut raw_frames = 0usize;\n    let mut summary = false;\n\n    for line in text.lines() {\n        if line.contains(\"ERROR:\") {\n            if kind.is_some() || raw_frames != 0 || summary {\n                return Err(3);\n            }\n            let rest = line.split_once(\"ERROR:\").map(|x| x.1).ok_or(3)?.trim();\n            let after = rest.strip_prefix(\"AddressSanitizer:\").ok_or(3)?.trim();\n            let value = after.split(\" on \").next().unwrap_or(\"\").trim();\n            if value.is_empty() {\n                return Err(3);\n            }\n            kind = Some(value.to_string());\n        } else if line.trim_start().starts_with('#') {\n            if kind.is_none() || summary {\n                return Err(3);\n            }\n            let trimmed = line.trim_start();\n            let mut words = trimmed.split_whitespace();\n            let number = words.next().ok_or(3)?;\n            if number.len() < 2 || !number[1..].bytes().all(|b| b.is_ascii_digit()) {\n                return Err(3);\n            }\n            let address = words.next().ok_or(3)?;\n            if !address.starts_with(\"0x\") || address.len() <= 2 || !address[2..].bytes().all(|b| b.is_ascii_hexdigit()) {\n                return Err(3);\n            }\n            if words.next() != Some(\"in\") {\n                return Err(3);\n            }\n            let symbol = words.next().ok_or(3)?;\n            if symbol.is_empty() {\n                return Err(3);\n            }\n            raw_frames += 1;\n            if is_user_frame(symbol) {\n                frames.push(fold_hex(symbol));\n            }\n        } else if line.trim_start().starts_with(\"SUMMARY:\") {\n            if kind.is_none() || raw_frames == 0 || summary {\n                return Err(3);\n            }\n            summary = true;\n        }\n    }\n\n    let kind = kind.ok_or(3)?;\n    if raw_frames == 0 || frames.is_empty() || !summary {\n        return Err(3);\n    }\n    Ok((kind, frames))\n}\n\nfn is_user_frame(s: &str) -> bool {\n    !(s.contains(\"__asan\") || s.contains(\"__interceptor\") || s.contains(\"__hwasan\"))\n}\n\nfn fold_hex(s: &str) -> String {\n    let bytes = s.as_bytes();\n    let mut out = String::new();\n    let mut i = 0usize;\n    while i < bytes.len() {\n        if i + 2 < bytes.len() && bytes[i] == b'0' && (bytes[i + 1] == b'x' || bytes[i + 1] == b'X') && bytes[i + 2].is_ascii_hexdigit() {\n            out.push_str(\"0xHEX\");\n            i += 2;\n            while i < bytes.len() && bytes[i].is_ascii_hexdigit() {\n                i += 1;\n            }\n        } else {\n            out.push(bytes[i] as char);\n            i += 1;\n        }\n"]
[126.386248, "i", "    }\n    out\n}\nEOF\n"]
