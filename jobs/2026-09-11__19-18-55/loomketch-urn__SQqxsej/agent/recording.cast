[165.055746, "i", "python3 - <<'PY'\np='/app/qanbox/tally.rs'\ns=open(p).read()\ns=s.replace('let mut bag: BTreeMap<(String, Vec<String>), Rec> = BTreeMap::new();', 'let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();')\ns=s.replace('        let key = (kind.clone(), frames.clone());\\n        bag.entry(key).or_insert(Rec { issue: 0, kind, frames, body });', '''        let key = frames.clone();\n        match bag.get_mut(&key) {\n            Some(old) => {\n                // Identity is the normalized user-frame sequence.  Pick a\n                // deterministic label if equivalent journals disagree.\n                if kind < old.kind {\n                    old.kind = kind;\n                }\n            }\n            None => {\n                bag.insert(key, Rec { issue: 0, kind, frames, body });\n            }\n        }''')\nopen(p,'w').write(s)\nPY\n/app/hearth.sh\ncd /app && ./bin/loomketch bind\n"]
