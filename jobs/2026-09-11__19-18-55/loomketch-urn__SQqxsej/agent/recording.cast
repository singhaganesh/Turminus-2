[126.571288, "i", "cat > /app/qanbox/tally.rs <<'EOF'\n#[path = \"../treyfun/clip.rs\"]\nmod clip;\n\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<String>,\n    pub body: String,\n}\n\npub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\n    let paths = crate::walk::gather(a)?;\n    let mut bag: BTreeMap<(String, Vec<String>), Rec> = BTreeMap::new();\n\n    for path in paths {\n        let text = std::fs::read_to_string(&path).map_err(|_| 3)?;\n        let (kind, frames) = clip::take(&text)?;\n        let body = frames.join(\" | \");\n        let key = (kind.clone(), frames.clone());\n        bag.entry(key).or_insert(Rec { issue: 0, kind, frames, body });\n    }\n\n    if bag.is_empty() {\n        return Err(3);\n    }\n    let mut recs: Vec<Rec> = bag.into_values().collect();\n    for (i, rec) in recs.iter_mut().enumerate() {\n        rec.issue = (i + 1) as i32;\n    }\n    Ok(recs)\n}\nEOF\ncat > /app/humdock/emit.rs <<'EOF'\nuse crate::tally::Rec;\nuse std::fmt::Write as _;\n\npub fn emit(rows: &[Rec]) -> i32 {\n    if std::fs::create_dir_all(\"/app/inkbay\").is_err() {\n        return 1;\n    }\n\n    let mut inner = String::new();\n    for (i, r) in rows.iter().enumerate() {\n        if i != 0 {\n            inner.push(',');\n        }\n        let _ = write!(inner, \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\n            r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body));\n    }\n    let tpl = match std::fs::read_to_string(\"/app/tplbay/bound.tpl\") {\n        Ok(v) if v.contains(\"__ROWS__\") => v,\n        _ => return 1,\n    };\n    let bound = tpl.replace(\"__ROWS__\", &inner);\n\n    let mut desk = String::from(\"issue\\tkind\\tbody\\n\");\n    for r in rows {\n        if r.kind.contains(['\\t', '\\n', '\\r']) || r.body.contains(['\\t', '\\n', '\\r']) {\n            return 1;\n        }\n        let _ = writeln!(desk, \"{}\\t{}\\t{}\", r.issue, r.kind, r.body);\n    }\n\n    if std::fs::write(\"/app/inkbay/bound.json\", bound).is_err()\n        || std::fs::write(\"/app/inkbay/desk.tsv\", desk).is_err()\n    {\n        return 1;\n    }\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\n\nfn jstr(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\\\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => { let _ = write!(out, \"\\\\u{:04x}\", c as u32); },\n            c => out.push(c),\n        }\n    }\n    out.push('\\\"');\n    out\n}\n\nfn jarr(v: &[String]) -> String {\n    format!(\"[{}]\", v.iter().map(|s| jstr(s)).collect::<Vec<_>>().join(\",\"))\n}\nEOF\ncat > /app/ketchcli/main.rs <<'EOF'\n#[path = \"../urnwalk/walk.rs\"]\nmod walk;\n#[path = \"../qanbox/tally.rs\"]\nmod tally;\n#[path = \"../humdock/emit.rs\"]\nmod rib;\n\nfn main() {\n    let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\n    let mut args = std::env::args();\n    let _ = args.next();\n    let cmd = args.next().unwrap_or_default();\n    if cmd != \"bind\" {\n        eprintln!(\"usage: loomketch bind [root]\");\n        std::process::exit(2);\n    }\n    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\n    if args.next().is_some() {\n        eprintln!(\"usage: loomketch bind [root]\");\n        std::process::exit(2);\n    }\n    let code = match tally::tally(&root) {\n        Ok(recs) => if rib::emit(&recs) == 0 { 0 } else { 1 },\n        Err(c) => c,\n    };\n    if code != 0 {\n        let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\n    }\n    std::process::exit(code);\n}\nEOF\n/app/hearth.sh\nhead -c 4 /app/bin/loomketch | od -An -tx1\n"]
