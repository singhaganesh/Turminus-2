     1	public class Main {
     2	  public static void main(String[] a) throws Exception {
     3	    if (a.length == 0) {
     4	      System.err.println("usage");
     5	      System.exit(2);
     6	    }
     7	    String cmd = a[0];
     8	    int rc = 0;
     9	    if (cmd.equals("anneal")) {
    10	      rc = WalkRun.run();
    11	    } else if (cmd.equals("stow")) {
    12	      rc = StowRun.run(a[1]);
    13	    } else if (cmd.equals("draw")) {
    14	      rc = DrawRun.run(a[1], a[2]);
    15	    } else if (cmd.equals("census")) {
    16	      rc = CardRun.run();
    17	    } else {
    18	      rc = 2;
    19	    }
    20	    System.exit(rc);
    21	  }
    22	}
