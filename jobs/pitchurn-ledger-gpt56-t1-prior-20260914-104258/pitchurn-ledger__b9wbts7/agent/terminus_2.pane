}
--- generated Slice/Span ---
import java.util.*;
public class Slice {
  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {
    int h = 0;
    int start = 0;
    java.util.List<byte[]> out = new java.util.ArrayList<>();
    for (int i = 0; i < src.length; i++) {
      byte b = src[i];
      h = (h << 1) + b;
      int ln = i - start + 1;
      if ((ln >= min && (h & mask) == 0) || ln >= max || i == src.length - 1) {
        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));
        start = i + 1;
        h = 0;
      }
    }
    return out;
  }
}
import java.nio.file.*;
import java.util.*;
public class Span {
  public static void merge() throws Exception {
    Path live = Paths.get("/app/urnbay/idx.tsv");
    Path hot = Paths.get("/app/urnbay/hot/idx.tsv");
    StringBuilder sb = new StringBuilder();
    if (Files.exists(live)) sb.append(Files.readString(live));
    if (Files.exists(hot)) sb.append(Files.readString(hot));
    Files.writeString(live, sb.toString());
    System.out.println("walked");
  }
}
