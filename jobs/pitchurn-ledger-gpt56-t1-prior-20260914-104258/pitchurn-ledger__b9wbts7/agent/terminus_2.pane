     1	import java.io.*;
     2	public class VatGen {
     3	  public static void main(String[] a) throws Exception {
     4	    File d = new File("/app/deskbin/gen");
     5	    d.mkdirs();
     6	    PrintWriter w = new PrintWriter(new FileWriter(new File(d, "Slice.java")));
     7	    tint(w);
     8	    w.close();
     9	  }
    10	  public static void tint(PrintWriter a) throws Exception {
    11	    a.println("import java.util.*;");
    12	    a.println("public class Slice {");
    13	    a.println("  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {");
    14	    a.println("    int h = 0;");
    15	    a.println("    int start = 0;");
    16	    a.println("    java.util.List<byte[]> out = new java.util.ArrayList<>();");
    17	    a.println("    for (int i = 0; i < src.length; i++) {");
    18	    a.println("      byte b = src[i];");
    19	    a.println("      h = (h << 1) + b;");
    20	    a.println("      int ln = i - start + 1;");
    21	    a.println("      if ((ln >= min && (h & mask) == 0) || ln >= max || i == src.length - 1) {");
    22	    a.println("        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));");
    23	    a.println("        start = i + 1;");
    24	    a.println("        h = 0;");
    25	    a.println("      }");
    26	    a.println("    }");
    27	    a.println("    return out;");
    28	    a.println("  }");
    29	    a.println("}");
    30	  }
    31	}
