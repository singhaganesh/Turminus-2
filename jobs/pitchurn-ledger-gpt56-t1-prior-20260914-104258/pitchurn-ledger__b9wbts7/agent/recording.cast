[25.862058, "o", "--- VatGen ---\r\n"]
[25.863274, "o", "import java.io.*;\r\npublic class VatGen {\r\n  public static void main(String[] a) throws Exception {\r\n    File d = new File(\"/app/deskbin/gen\");\r\n    d.mkdirs();\r\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Slice.java\")));\r\n    tint(w);\r\n    w.close();\r\n  }\r\n  public static void tint(PrintWriter a) throws Exception {\r\n    a.println(\"import java.util.*;\");\r\n    a.println(\"public class Slice {\");\r\n    a.println(\"  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {\");\r\n    a.println(\"    int h = 0;\");\r\n    a.println(\"    int start = 0;\");\r\n    a.println(\"    java.util.List<byte[]> out = new java.util.ArrayList<>();\");\r\n    a.println(\"    for (int i = 0; i < src.length; i++) {\");\r\n    a.println(\"      byte b = src[i];\");\r\n    a.println(\"      h = (h << 1) + b;\");\r\n    a.println(\"      int ln = i - start + 1;\");\r\n    a.println(\"      if ((ln >= min && (h & mask) == 0) || ln >= max || i == src.length - 1) {\");\r\n    a.println(\"        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));\");\r\n    a.println(\"        start = i + 1;\");\r\n    a.println(\"        h = 0;\");\r\n    a.println(\"      }\");\r\n    a.println(\"    }\");\r\n    a.println(\"    return out;\");\r\n    a.println(\"  }\");\r\n    a.println(\"}\");\r\n  }\r\n}\r\n"]
[25.863521, "o", "--- DuskGen ---\r\n"]
[25.864421, "o", "import java.io.*;\r\npublic class DuskGen {\r\n  public static void main(String[] a) throws Exception {\r\n    File d = new File(\"/app/deskbin/gen\");\r\n    d.mkdirs();\r\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")));\r\n    loom(w);\r\n    w.close();\r\n  }\r\n  public static void loom(PrintWriter a) throws Exception {\r\n    a.println(\"import java.nio.file.*;\");\r\n    a.println(\"import java.util.*;\");\r\n    a.println(\"public class Span {\");\r\n    a.println(\"  public static void merge() throws Exception {\");\r\n    a.println(\"    Path live = Paths.get(\\\"/app/urnbay/idx.tsv\\\");\");\r\n    a.println(\"    Path hot = Paths.get(\\\"/app/urnbay/hot/idx.tsv\\\");\");\r\n    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    a.println(\"    if (Files.exists(live)) sb.append(Files.readString(live));\");\r\n    a.println(\"    if (Files.exists(hot)) sb.append(Files.readString(hot));\");\r\n    a.println(\"    Files.writeString(live, sb.toString());\");\r\n    a.println(\"    System.out.println(\\\"walked\\\");\");\r\n    a.println(\"  }\");\r\n    a.println(\"}\");\r\n  }\r\n}\r\n"]
[25.864601, "o", "--- generated Slice/Span ---\r\n"]
[25.865487, "o", "import java.util.*;\r\npublic class Slice {\r\n  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {\r\n    int h = 0;\r\n    int start = 0;\r\n    java.util.List<byte[]> out = new java.util.ArrayList<>();\r\n    for (int i = 0; i < src.length; i++) {\r\n      byte b = src[i];\r\n      h = (h << 1) + b;\r\n      int ln = i - start + 1;\r\n      if ((ln >= min && (h & mask) == 0) || ln >= max || i == src.length - 1) {\r\n        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));\r\n        start = i + 1;\r\n        h = 0;\r\n      }\r\n    }\r\n    return out;\r\n  }\r\n}\r\n"]
[25.86559, "o", "import java.nio.file.*;\r\nimport java.util.*;\r\npublic class Span {\r\n  public static void merge() throws Exception {\r\n    Path live = Paths.get(\"/app/urnbay/idx.tsv\");\r\n    Path hot = Paths.get(\"/app/urnbay/hot/idx.tsv\");\r\n    StringBuilder sb = new StringBuilder();\r\n    if (Files.exists(live)) sb.append(Files.readString(live));\r\n    if (Files.exists(hot)) sb.append(Files.readString(hot));\r\n    Files.writeString(live, sb.toString());\r\n    System.out.println(\"walked\");\r\n  }\r\n}\r\n"]
