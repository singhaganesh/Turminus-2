[76.062642, "i", "python3 - <<'PY'\np='/app/nincut/VatGen.java'\ns=open(p).read()\ns=s.replace('a.println(\"      byte b = src[i];\");', 'a.println(\"      int b = src[i] & 0xff;\");')\nopen(p,'w').write(s)\n\np='/app/hitchcli/Idx.java'\ns=open(p).read()\ns=s.replace('    add(m, \"/app/urnbay/hot/idx.tsv\");\\n    return m;', '    add(m, \"/app/urnbay/hot/idx.tsv\");\\n    add(m, \"/app/urnbay/cold/idx.tsv\");\\n    return m;')\nopen(p,'w').write(s)\nPY\ncat > /app/coldrib/DuskGen.java <<'EOF'\nimport java.io.*;\npublic class DuskGen {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")));\n    loom(w);\n    w.close();\n  }\n  public static void loom(PrintWriter a) throws Exception {\n    a.println(\"import java.nio.file.*;\");\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Span {\");\n    a.println(\"  public static void merge() throws Exception {\");\n    a.println(\"    Path live = Paths.get(\\\"/app/urnbay/idx.tsv\\\");\");\n    a.println(\"    LinkedHashMap<String,String> all = new LinkedHashMap<>();\");\n    a.println(\"    String[] files = {\\\"/app/urnbay/idx.tsv\\\", \\\"/app/urnbay/hot/idx.tsv\\\", \\\"/app/urnbay/keep/idx.tsv\\\", \\\"/app/urnbay/cold/idx.tsv\\\"};\");\n    a.println(\"    for (String name : files) {\");\n    a.println(\"      Path f = Paths.get(name);\");\n    a.println(\"      if (!Files.exists(f)) continue;\");\n    a.println(\"      for (String line : Files.readAllLines(f)) {\");\n    a.println(\"        String[] fields = line.trim().split(\\\"\\\\\\\\t\\\", 2);\");\n    a.println(\"        if (fields.length == 2 && !fields[0].isEmpty()) all.put(fields[0], fields[1]);\");\n    a.println(\"      }\");\n    a.println(\"    }\");\n    a.println(\"    StringBuilder out = new StringBuilder();\");\n    a.println(\"    for (Map.Entry<String,String> e : all.entrySet()) out.append(e.getKey()).append('\\\\t').append(e.getValue()).append('\\\\n');\");\n    a.println(\"    Files.createDirectories(live.getParent());\");\n    a.println(\"    Files.writeString(live, out.toString());\");\n    a.println(\"    System.out.println(\\\"walked\\\");\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\n"]
