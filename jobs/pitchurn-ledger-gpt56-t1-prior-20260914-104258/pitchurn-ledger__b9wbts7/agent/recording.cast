[76.314871, "i", "cat > /app/hitchcli/StowRun.java <<'EOF'\nimport java.nio.file.*;\nimport java.util.*;\npublic class StowRun {\n  public static int run(String reel) throws Exception {\n    Gear g = Gear.load(\"/app/gearpit/live.gear\");\n    byte[] src = Files.readAllBytes(Paths.get(reel));\n    List<byte[]> parts = Slice.cut(src, g.mask, g.min, g.max);\n    Map<String,String> idx = Idx.load();\n    long stored = 0;\n    long reused = 0;\n    List<String> keys = new ArrayList<>();\n    String name = Paths.get(reel).getFileName().toString();\n    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\n    Path flag = Paths.get(\"/app/urnbay/marks/\" + name + \".flag\");\n    boolean prior = Files.exists(flag) || Files.exists(mk);\n\n    // A gear change alters chunk boundaries.  Preserve full-reel reuse when an\n    // existing manifest still reconstructs exactly the incoming byte stream.\n    boolean exact = false;\n    if (Files.exists(mk)) {\n      List<String> oldKeys = new ArrayList<>();\n      java.io.ByteArrayOutputStream old = new java.io.ByteArrayOutputStream();\n      boolean complete = true;\n      for (String line : Files.readAllLines(mk)) {\n        String key = line.trim();\n        if (key.isEmpty()) continue;\n        String rel = idx.get(key);\n        if (rel == null) { complete = false; break; }\n        old.write(Idx.blob(rel));\n        oldKeys.add(key);\n      }\n      if (complete && Arrays.equals(src, old.toByteArray())) {\n        exact = true;\n        keys.addAll(oldKeys);\n        reused = src.length;\n      }\n    }\n\n    Path hot = Paths.get(\"/app/urnbay/hot\");\n    Files.createDirectories(hot);\n    if (!exact) {\n      for (byte[] p : parts) {\n        String kb = Seal.hex(p, g.fp);\n        String kp = Seal.pay(p);\n        String hit = null;\n        if (idx.containsKey(kb)) hit = kb;\n        else if (idx.containsKey(kp)) hit = kp;\n        if (hit != null) {\n          reused += p.length;\n          keys.add(hit);\n        } else {\n          stored += p.length;\n          String rel = \"hot/\" + kb + \".blob\";\n          Files.write(hot.resolve(kb + \".blob\"), p);\n          Idx.put(kb, rel);\n          idx.put(kb, rel);\n          keys.add(kb);\n        }\n      }\n    }\n\n    StringBuilder mb = new StringBuilder();\n    for (String k : keys) mb.append(k).append(\"\\n\");\n    Files.createDirectories(mk.getParent());\n    Files.writeString(mk, mb.toString());\n    double reuse = src.length == 0 ? 1.0 : (reused / (double) src.length);\n    double mean = parts.isEmpty() ? 0 : (src.length / (double) parts.size());\n    String json = \"{\\n\"\n      + \"  \\\"reel\\\": \\\"\" + name + \"\\\",\\n\"\n      + \"  \\\"bytes_in\\\": \\\"\" + src.length + \"\\\",\\n\"\n      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\n      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\n      + \"  \\\"mean_piece\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\n      + \"  \\\"piece_count\\\": \\\"\" + parts.size() + \"\\\"\\n\"\n      + \"}\\n\";\n    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\n    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\n    Floor.ok(reuse);\n    if (prior && stored == src.length && src.length > 0) return 1;\n    Files.writeString(flag, \"1\\n\");\n    return 0;\n  }\n}\nEOF\n/app/kiln.sh\n"]
[76.322185, "o", "cat > /app/hitchcli/StowRun.java <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.file.*;\r\n\u001b[?2004l\r\u001b[?2004h> import java.util.*;\r\n\u001b[?2004l\r\u001b[?2004h> public class StowRun {\r\n\u001b[?2004l\r\u001b[?2004h>   public static int run(String reel) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h>     Gear g = Gear.load(\"/app/gearpit/live.gear\");\r\n\u001b[?2004l\r\u001b[?2004h>     byte[] src = Files.readAllBytes(Paths.get(reel));\r\n\u001b[?2004l\r\u001b[?2004h>     List<byte[]> parts = Slice.cut(src, g.mask, g.min, g.max);\r\n\u001b[?2004l\r\u001b[?2004h>     Map<String,String> idx = Idx.load();\r\n\u001b[?2004l\r\u001b[?2004h>     long stored = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     long reused = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     List<String> keys = new ArrayList<>();\r\n\u001b[?2004l\r\u001b[?2004h>     String name = Paths.get(reel).getFileName().toString();\r\n\u001b[?2004l\r\u001b[?2004h>     Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
