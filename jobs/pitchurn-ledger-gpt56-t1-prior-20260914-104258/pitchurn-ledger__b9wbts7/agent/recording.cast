[17.664001, "o", "     1\timport java.io.*;\r\n     2\tpublic class RibGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Seal.java\")));\r\n     7\t    weld(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void weld(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.security.MessageDigest;\");\r\n    12\t    a.println(\"public class Seal {\");\r\n"]
[17.664143, "o", "    13\t    a.println(\"  public static String hex(byte[] p, int fp) throws Exception {\");\r\n    14\t    a.println(\"    MessageDigest md = MessageDigest.getInstance(\\\"SHA-256\\\");\");\r\n    15\t    a.println(\"    md.update(p);\");\r\n    16\t    a.println(\"    byte[] d = md.digest();\");\r\n    17\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    18\t    a.println(\"    for (byte x : d) sb.append(String.format(\\\"%02x\\\", x));\");\r\n    19\t    a.println(\"    return sb.toString();\");\r\n    20\t    a.println(\"  }\");\r\n    21\t    a.println(\"  public static String pay(byte[] p) throws Exception {\");\r\n    22\t    a.println(\"    MessageDigest md = MessageDigest.getInstance(\\\"SHA-256\\\");\");\r\n    23\t    a.println(\"    md.update(p);\");\r\n    24\t    a.println(\"    byte[] d = md.digest();\");\r\n    25\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    26\t    a.println(\"    for (byte x : d) sb.append(String.format(\\\"%02x\\\", x));\");\r\n    27\t    a.println(\"    return sb.toString();\");\r\n    28\t    a.println(\"  }\");\r\n    29\t    a.println(\"}\");\r\n    30\t  }\r\n    31\t}\r\n"]
[17.664311, "o", "--- nincut ---\r\n"]
[17.664379, "o", "### /app/nincut/VatGen.java\r\n"]
[17.665187, "o", "     1\timport java.io.*;\r\n     2\tpublic class VatGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Slice.java\")));\r\n     7"]
[17.665302, "o", "\t    tint(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void tint(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.util.*;\");\r\n    12\t    a.println(\"public class Slice {\");\r\n    13\t    a.println(\"  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {\");\r\n    14\t    a.println(\"    int h = 0;\");\r\n    15\t    a.println(\"    int start = 0;\");\r\n    16\t    a.println(\"    java.util.List<byte[]> out = new java.util.ArrayList<>();\");\r\n    17\t    a.println(\"    for (int i = 0; i < src.length; i++) {\");\r\n    18\t    a.println(\"      byte b = src[i];\");\r\n    19\t    a.println(\"      h = (h << 1) + b;\");\r\n    20\t    a.println(\"      int ln = i - start + 1;\");\r\n    21\t    a.println(\"      if ((ln >= min && (h & mask) == 0) || ln >= max || i == src.length - 1) {\");\r\n    22\t    a.println(\"        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));\");\r\n    23\t    a.println(\"        start = i + 1;\");\r\n    24\t    a.println(\"        h = 0;\");\r\n    25\t    a.println(\"      }\");\r\n    26\t    a.println(\"    }\");\r\n    27\t    a.println(\"    return out;\");\r\n    28\t    a.println(\"  }\");\r\n    29\t    a.println(\"}\");\r\n    30\t  }\r\n    31\t}\r\n"]
[17.665506, "o", "--- coldrib ---\r\n"]
[17.665589, "o", "### /app/coldrib/DuskGen.java\r\n"]
[17.667567, "o", "     1\timport java.io.*;\r\n     2\tpublic class DuskGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")));\r\n     7\t    loom(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void loom(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.nio.file.*;\");\r\n    12\t    a.println(\"import java.util.*;\");\r\n    13\t    a.println(\"public class Span {\");\r\n    14\t    a.println(\"  public static void merge() throws Exception {\");\r\n    15\t    a.println(\"    Path live = Paths.get(\\\"/app/urnbay/idx.tsv\\\");\");\r\n    16\t    a.println(\"    Path hot = Paths.get(\\\"/app/urnbay/hot/idx.tsv\\\");\");\r\n    17\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    18\t    a.println(\"    if (Files.exists(live)) sb.append(Files.readString(live));\");\r\n    19\t    a.println(\"    if (Files.exists(hot)) sb.append(Files.readString(hot));\");\r\n    20\t    a.println(\"    Files.writeString(live, sb.toString());\");\r\n    21\t    a.println(\"    System.out.println(\\\"walked\\\");\");\r\n    22\t    a.println(\"  }\");\r\n"]
[17.668004, "o", "    23\t    a.println(\"}\");\r\n    24\t  }\r\n    25\t}\r\n"]
[17.668945, "o", "--- hitchcli ---\r\n### /app/hitchcli/CardRun.java\r\n"]
[17.669988, "o", "     1\timport java.nio.file.*;\r\n     2\tpublic class CardRun {\r\n     3\t  public static int run() throws Exception {\r\n     4\t    Path last = Paths.get(\"/app/urnbay/last.json\");\r\n     5\t    if (!Files.exists(last)) return 1;\r\n     6\t    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), Files.readString(last));\r\n     7\t    return 0;\r\n     8\t  }\r\n     9\t}\r\n"]
[17.670244, "o", "### /app/hitchcli/DrawRun.java\r\n"]
[17.672448, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class DrawRun {\r\n     4\t  public static int run(String dest, String reel) throws Exception {\r\n     5\t    String name = Paths.get(reel).getFileName().toString();\r\n     6\t    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n     7\t    Map<String,String> idx = Idx.load();\r\n     8\t    add(idx, \"/app/urnbay/cold/idx.tsv\");\r\n     9\t    StringBuilder skip = new StringBuilder();\r\n    10\t    List<byte[]> acc = new ArrayList<>();\r\n    11\t    for (String ln : Files.readAllLines(mk)) {\r\n    12\t      String k = ln.trim();\r\n    13\t      if (k.isEmpty()) continue;\r\n    14\t      String rel = idx.get(k);\r\n    15\t      if (rel == null) continue;\r\n    16\t      acc.add(Idx.blob(rel));\r\n    17\t    }\r\n    18\t    int n = 0;\r\n    19\t    for (byte[] b : acc) n += b.length;\r\n    20\t    byte[] out = new byte[n];\r\n    21\t    int o = 0;\r\n    22\t    for (byte[] b : acc) {\r\n    23\t      System.arraycopy(b, 0, out, o, b.length);\r\n    24\t      o += b.length;\r\n"]
[17.672759, "o", "    25\t    }\r\n    26\t    Path d = Paths.get(dest);\r\n    27\t    Files.createDirectories(d.getParent() == null ? Paths.get(\".\") : d.getParent());\r\n    28\t    Files.write(d, out);\r\n    29\t    return 0;\r\n    30\t  }\r\n    31\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    32\t    Idx.add(m, p);\r\n    33\t  }\r\n    34\t}\r\n"]
[17.67304, "o", "### /app/hitchcli/Gear.java\r\n"]
[17.674578, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Gear {\r\n     4\t  public int mask, min, max, fp;\r\n     5\t  public static Gear load(String p) throws Exception {\r\n     6\t    Gear g = new Gear();\r\n     7\t    for (String ln : Files.readAllLines(Paths.get(p))) {\r\n     8\t      String t = ln.trim();\r\n     9\t      if (t.startsWith(\"mask=\")) g.mask = Integer.parseInt(t.substring(5));\r\n    10\t      if (t.startsWith(\"min=\")) g.min = Integer.parseInt(t.substring(4));\r\n"]
[17.674683, "o", "    11\t      if (t.startsWith(\"max=\")) g.max = Integer.parseInt(t.substring(4));\r\n    12\t      if (t.startsWith(\"fp=\")) g.fp = Integer.parseInt(t.substring(3));\r\n    13\t    }\r\n    14\t    return g;\r\n    15\t  }\r\n    16\t}\r\n"]
