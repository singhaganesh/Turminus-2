[62.397998, "o", "\u001b[?2004h> "]
[62.398107, "o", "            return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.398147, "o", "        }\r\n\u001b[?2004l\r"]
[62.39817, "o", "\u001b[?2004h> "]
[62.398314, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
