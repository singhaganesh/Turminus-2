[62.398584, "o", "\u001b[?2004h"]
[62.39867, "o", "> "]
[62.398753, "o", "    for (int i = 0; i < layout.nfields; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.398916, "o", "        const field_def *f = &layout.fields[i];\r\n\u001b[?2004l\r"]
[62.399014, "o", "\u001b[?2004h"]
[62.399095, "o", "> "]
[62.399191, "o", "        if (strcmp(f->kind, \"u64\") == 0)\r\n\u001b[?2004l\r"]
[62.399277, "o", "\u001b[?2004h> "]
