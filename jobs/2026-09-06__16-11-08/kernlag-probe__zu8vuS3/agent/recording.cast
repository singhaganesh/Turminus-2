[29.292255, "o", "echo '--- regression fixture ---'; nl -ba /app/memvault/regression/bundle_pick_input.c; echo '--- binary metadata ---'; file /app/bin/kernscribe; strings /app/bin/kernscribe | grep -E 'livekern|snapvault|offline_guard|bundle:|live:' | sort -u\r\n\u001b[?2004l\r"]
