[29.302904, "o", "\u001b[?2004hroot@74927fe9a441:/app# "]
[62.189253, "i", "cat > /app/relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic int read_live_release(char *release, size_t n) {\n    FILE *fp;\n    char line[256];\n    char *start;\n    char *end;\n\n    if (!release || n == 0) return -1;\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp) return -1;\n    if (!fgets(line, sizeof(line), fp)) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n\n    start = line;\n    while (*start && isspace((unsigned char)*start)) start++;\n    end = start + strlen(start);\n    while (end > start && isspace((unsigned char)end[-1])) end--;\n    *end = '\\0';\n    if (!*start || strlen(start) >= n) return -1;\n    snprintf(release, n, \"%s\", start);\n    return 0;\n}\n\nint choose_layout(source_pick *out) {\n    char release[RELEASE_LEN];\n    FILE *probe;\n\n    if (!out) return -1;\n    memset(out, 0, sizeof(*out));\n    if (read_live_release(release, sizeof(release)) != 0) return -1;\n\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/livekern/exports/sched_entity.tab\");\n    probe = fopen(out->layout_path, \"r\");\n    if (!probe) return -1;\n    fclose(probe);\n\n    if (snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release)\n        >= (int)sizeof(out->tag_value)) return -1;\n    out->from_bundle = 0;\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    FILE *fp;\n    char release[64];\n    char expected[80];\n    char *start;\n    char *end;\n\n    if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0) return -1;\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp) return -1;\n    if (!fgets(release, sizeof(release), fp)) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    start = release;\n    while (*start && isspace((unsigned char)*start)) start++;\n    end = start + strlen(start);\n    while (end > start && isspace((unsigned char)end[-1])) end--;\n    *end = '\\0';\n    if (!*start) return -1;\n    if (snprintf(expected, sizeof(expected), \"live:%s\", start) >= (int)sizeof(expected))\n        return -1;\n    return strcmp(tag_value, expected) == 0 ? 0 : -1;\n}\nEOF\ncat > /app/lagpipe/tblw/emit_writer.c <<'EOF'\n#include \"../synclink/common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\n    layout_def layout;\n    FILE *out;\n\n    if (!layout_path || !out_path || permit_tag(tag_value) != 0) return -1;\n    if (parse_layout(layout_path, &layout) != 0) return -1;\n    out = fopen(out_path, \"w\");\n    if (!out) return -1;\n    if (fprintf(out, \"STRUCT %s\\n\", layout.struct_name) < 0) goto fail;\n    for (int i = 0; i < layout.nfields; i++) {\n        if (fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name,\n                    layout.fields[i].kind, layout.fields[i].off,\n                    layout.fields[i].size) < 0) goto fail;\n    }\n    if (fclose(out) != 0) return -1;\n    return 0;\nfail:\n    fclose(out);\n    remove(out_path);\n    return -1;\n}\nEOF\n"]
