[62.390998, "o", "\u001b[?2004h> "]
[62.391619, "o", "#include \"common.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <stdint.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.391768, "o", "static uint32_t read_u32_le(const unsigned char *p) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.391922, "o", "    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |\r\n\u001b[?2004l\r"]
[62.391954, "o", "\u001b[?2004h> "]
[62.392196, "o", "           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);\r\n\u001b[?2004l\r"]
[62.392281, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[62.392398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.392579, "o", "static uint64_t read_u64_le(const unsigned char *p) {\r\n\u001b[?2004l\r"]
[62.392689, "o", "\u001b[?2004h"]
[62.392768, "o", ">     uint64_t v = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.392999, "o", "    for (unsigned i = 0; i < 8; i++) v |= (uint64_t)p[i] << (8 * i);\r\n\u001b[?2004l\r"]
[62.393078, "o", "\u001b[?2004h"]
[62.393112, "o", ">     return v;\r\n\u001b[?2004l\r"]
[62.393136, "o", "\u001b[?2004h"]
[62.393906, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int emit_inspect_json(const char *inspect_path) {\r\n\u001b[?2004l\r\u001b[?2004h>     layout_def layout;\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned char blob[4096];\r\n\u001b[?2004l\r\u001b[?2004h>     size_t nread;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.394037, "o", "    FILE *fp = fopen(inspect_path, \"rb\");\r\n\u001b[?2004l\r"]
[62.394163, "o", "\u001b[?2004h>     if (!fp) {\r\n\u001b[?2004l\r"]
[62.394285, "o", "\u001b[?2004h> "]
