[29.294036, "o", "    21\t}\r\n    22\t\r\n    23\tstatic void apply_policy_release(char *release, size_t n) {\r\n    24\t    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    25\t    char line[128];\r\n    26\t    char val[RELEASE_LEN];\r\n    27\t    if (!fp) {\r\n    28\t        return;\r\n    29\t    }\r\n    30\t    while (fgets(line, sizeof(line), fp)) {\r\n    31\t        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n    32\t            snprintf(release, n, \"%s\", val);\r\n    33\t        }\r\n    34\t    }\r\n    35\t    fclose(fp);\r\n    36\t}\r\n    37\t\r\n    38\tint choose_layout(source_pick *out) {\r\n    39\t    char release[RELEASE_LEN];\r\n    40\t\r\n    41\t    if (!out) {\r\n    42\t        return -1;\r\n    43\t    }\r\n    44\t    memset(out, 0, sizeof(*out));\r\n    45\t\r\n    46\t    if (read_pin(release, sizeof(release)) != 0) {\r\n    47\t        return -1;\r\n    48\t    }\r\n    49\t    apply_policy_release(release, sizeof(release));\r\n    50\t    snprintf(out->layout_path, sizeof(out->layout_path),\r\n    51\t             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    52\t    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    53\t    out->from_bundle = 1;\r\n    54\t    return 0;\r\n    55\t}\r\n"]
