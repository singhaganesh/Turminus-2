[62.39729, "o", "\u001b[?2004h> "]
[62.397403, "o", "            return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.39751, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.397665, "o", "        if (f->off > nread || need > nread - f->off) {\r\n\u001b[?2004l\r"]
[62.39776, "o", "\u001b[?2004h> "]
