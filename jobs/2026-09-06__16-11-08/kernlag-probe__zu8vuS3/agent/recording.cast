[62.394448, "o", "\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r"]
[62.394538, "o", "\u001b[?2004h"]
[62.394572, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.394758, "o", "    nread = fread(blob, 1, sizeof(blob), fp);\r\n\u001b[?2004l\r"]
[62.394854, "o", "\u001b[?2004h> "]
[62.394948, "o", "    fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.395009, "o", "> "]
[62.395168, "o", "    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\r\n\u001b[?2004l\r"]
[62.395242, "o", "\u001b[?2004h> "]
[62.395406, "o", "        fprintf(stderr, \"probe: layout.tbl missing\\n\");\r\n\u001b[?2004l\r"]
[62.39548, "o", "\u001b[?2004h> "]
[62.395541, "o", "        return 1;\r\n\u001b[?2004l\r"]
[62.395628, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[62.395744, "o", "\u001b[?2004h> "]
[62.395866, "o", "    for (int i = 0; i < layout.nfields; i++) {\r\n\u001b[?2004l\r"]
[62.396031, "o", "\u001b[?2004h> "]
[62.396141, "o", "        const field_def *f = &layout.fields[i];\r\n\u001b[?2004l\r"]
[62.396227, "o", "\u001b[?2004h> "]
[62.396256, "o", "        unsigned need;\r\n\u001b[?2004l\r"]
[62.396276, "o", "\u001b[?2004h"]
[62.396296, "o", "> "]
[62.396508, "o", "        if (strcmp(f->kind, \"u32\") == 0 && f->size == 4) need = 4;\r\n\u001b[?2004l\r"]
[62.396543, "o", "\u001b[?2004h> "]
[62.39677, "o", "        else if (strcmp(f->kind, \"u64\") == 0 && f->size == 8) need = 8;\r\n\u001b[?2004l\r"]
[62.396914, "o", "\u001b[?2004h> "]
[62.397012, "o", "        else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.397101, "o", "> "]
