[62.399463, "o", "> "]
[62.399614, "o", "                   (unsigned long long)read_u64_le(blob + f->off));\r\n\u001b[?2004l\r"]
[62.399702, "o", "\u001b[?2004h"]
[62.399784, "o", ">         else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.399927, "o", "            printf(\",\\\"%s\\\":%lu\", f->name,\r\n\u001b[?2004l\r"]
