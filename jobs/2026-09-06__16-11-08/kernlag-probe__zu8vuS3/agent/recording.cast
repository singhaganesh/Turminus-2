[10.543268, "o", "printf '%s\\n' '--- FIELD_RULES ---'; cat /app/lagpipe/fieldnotes/FIELD_RULES.txt; printf '%s\\n' '--- ROUTE_MAP ---'; cat /app/lagpipe/fieldnotes/ROUTE_MAP.txt; printf '%s\\n' '--- lagpipe Makefile ---'; sed -n '1,240p' /app/lagpipe/Makefile\r\n"]
[10.544194, "o", "\u001b[?2004l\r--- FIELD_RULES ---\r\n"]
[10.545368, "o", "Layout table lines:\r\n  STRUCT <name>\r\n  FIELD <name> <kind> <offset> <size>\r\n\r\nKinds: u32, u64. u64 fields use eight-byte little-endian values in capture blobs.\r\nSample blobs are little-endian packed fields in field order.\r\nsched_entity fields include pid, weight, migration_flags, slice_ns.\r\n\r\nprocance.tag is one line: live:<release> or bundle:<release>\r\noffline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n\r\nCLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\nmemvault captures: /app/memvault/samples/*.mem\r\nmemvault cards: /app/memvault/cards/*.ref\r\nrunning release file: /app/livekern/running.release\r\n"]
[10.546315, "o", "--- ROUTE_MAP ---\r\n"]
[10.547452, "o", "lagpipe synctab wiring notes (internal)\r\n\r\nModules linked by `make -C /app/lagpipe bind` participate in synctab:\r\n  layout pick — chooses sched_entity table input for synctab\r\n  types writer — materializes synctab_out/layout.tbl from the picked table\r\n  tag policy gate — decides whether procance lines are acceptable on this image\r\n  probe emitter — decodes memvault captures through layout.tbl offsets\r\n\r\nField layout rules and CLI contract: /app/lagpipe/fieldnotes/FIELD_RULES.txt\r\nRebuild entrypoint: make -C /app/lagpipe bind\r\n"]
[10.547809, "o", "--- lagpipe Makefile ---\r\n"]
[10.548955, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Isynclink -Itagc\r\nSRC := $(wildcard synclink/*.c) ../relc/input.c tblw/emit_writer.c tagc/gate.c\r\nBIN := /app/bin/kernscribe\r\n\r\n.PHONY: bind\r\nbind:\r\n\tmkdir -p /app/bin /app/lagpipe/synctab_out\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[10.549246, "o", "\u001b[?2004hroot@74927fe9a441:/app# "]
[10.816712, "i", "printf '%s\\n' '--- release ---'; cat /app/livekern/running.release; printf '%s\\n' '--- sample/ref inventory ---'; find /app/memvault/samples /app/memvault/cards -maxdepth 1 -type f -printf '%f %s bytes\\n' | sort; printf '%s\\n' '--- source grep ---'; grep -RInE 'synctab|inspect|sched_entity|procance|offline_guard|migration_flags|slice_ns' /app --exclude='*.mem' --exclude='*.ref' 2>/dev/null | sed -n '1,260p'\n"]
[10.818227, "o", "printf '%s\\n' '--- release ---'; cat /app/livekern/running.release; printf '%s\\n' '--- sample/ref inventory ---'; find /app/memvault/samples /app/memvault/cards -maxdepth 1 -type f -printf '%f %s bytes\\n' | sort; printf '%s\\n' '--- source grep ---'; grep -RInE 'synctab|inspect|sched_entity|procance|offline_guard|migration_flags|slice_ns' /app --exclude='*.mem' --exclude='*.ref' 2>/dev/null | sed -n '1,260p'\r\n\u001b[?2004l\r--- release ---\r\n"]
[10.81938, "o", "6.8.12\r\n"]
[10.819578, "o", "--- sample/ref inventory ---\r\n"]
[10.821354, "o", "pulse_a.mem 20 bytes\r\npulse_a.ref 91 bytes\r\npulse_b.mem 20 bytes\r\npulse_b.ref 90 bytes\r\n"]
[10.821595, "o", "--- source grep ---\r\n"]
[10.827589, "o", "/app/lagpipe/BUILDCHANNEL:1:synctab build channel: synclink driver binds relc, tblw, tagc.\r\n/app/lagpipe/VERIFIER_CHANNEL:1:# Kernlag synctab verifier channel — not part of the graded repair surface.\r\n/app/lagpipe/Makefile:8:\tmkdir -p /app/bin /app/lagpipe/synctab_out\r\n/app/lagpipe/synclink/driver.c:8:    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\r\n/app/lagpipe/synclink/driver.c:9:    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\r\n/app/lagpipe/synclink/driver.c:18:        perror(\"imprint: procance.tag\");\r\n/app/lagpipe/synclink/driver.c:36:        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\r\n/app/lagpipe/synclink/driver.c:39:    if (strcmp(argv[1], \"synctab\") == 0) {\r\n/app/lagpipe/synclink/driver.c:42:    if (strcmp(argv[1], \"inspect\") == 0) {\r\n/app/lagpipe/synclink/driver.c:44:            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\r\n/app/lagpipe/synclink/driver.c:47:        return emit_inspect_json(argv[2]);\r\n/app/lagpipe/synclink/field_emit.c:19:int emit_inspect_json(const char *inspect_path) {\r\n/app/lagpipe/synclink/field_emit.c:23:    FILE *fp = fopen(inspect_path, \"rb\");\r\n/app/lagpipe/synclink/field_emit.c:31:        fprintf(stderr, \"probe: inspect too short\\n\");\r\n/app/lagpipe/synclink/field_emit.c:34:    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\r\n/app/lagpipe/synclink/common.h:33:int emit_inspect_json(const char *inspect_path);\r\n/app/lagpipe/tblw/emit_writer.c:20:        if (strcmp(layout.fields[i].name, \"migration_flags\") == 0) {\r\n/app/lagpipe/fieldnotes/ROUTE_MAP.txt:1:lagpipe synctab wiring notes (internal)\r\n/app/lagpipe/fieldnotes/ROUTE_MAP.txt:3:Modules linked by `make -C /app/lagpipe bind` participate in synctab:\r\n/app/lagpipe/fieldnotes/ROUTE_MAP.txt:4:  layout pick — chooses sched_entity table input for synctab\r\n/app/lagpipe/fieldnotes/ROUTE_MAP.txt:5:  types writer — materializes synctab_out/layout.tbl from the picked table\r\n/app/lagpipe/fieldnotes/ROUTE_MAP.txt:6:  tag policy gate — decides whether procance lines are acceptable on this image\r\n/app/lagpipe/fieldnotes/FIELD_RULES.txt:7:sched_entity fields include pid, weight, migration_flags, slice_ns.\r\n/app/lagpipe/fieldnotes/FIELD_RULES.txt:9:procance.tag is one line: live:<release> or bundle:<release>\r\n/app/lagpipe/fieldnotes/FIELD_RULES.txt:10:offline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n/app/lagpipe/fieldnotes/FIELD_RULES.txt:12:CLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\n/app/lagpipe/synctab_out/layout.tbl:1:STRUCT sched_entity\r\n/app/lagpipe/synctab_out/layout.tbl:4:FIELD slice_ns u64 8 8\r\n/app/memvault/regression/bundle_pick_input.c:51:             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n/app/livekern/CHANNEL:1:livekern exports the live sched_entity table for synctab on this image.\r\n/app/livekern/exports/sched_entity.tab:1:STRUCT sched_entity\r\n/app/livekern/exports/sched_entity.tab:4:FIELD migration_flags u32 8 4\r\n/app/livekern/exports/sched_entity.tab:5:FIELD slice_ns u64 12 8\r\n/app/livekern/VERSION:1:livekern exports the live sched_entity layout for this image.\r\n/app/livekern/EXPORTS:1:live sched_entity export for synctab on bench images.\r\n/app/snapvault/CATALOG:1:snapvault release pins for offline sched_entity layouts.\r\n/app/snapvault/PIN_INDEX:1:# Offline sched_entity snapshot catalog for snapvault pins.\r\n/app/snapvault/policy.conf:2:# kernscribe synctab consults this file after default.pin when selecting snapvault layouts.\r\n/app/snapvault/releases/6.8.11/sched_entity.tab:1:STRUCT sched_entity\r\n/app/snapvault/releases/6.8.11/sched_entity.tab:4:FIELD slice_ns u64 8 8\r\n/app/snapvault/releases/6.8.10/sched_entity.tab:1:STRUCT sched_entity\r\n/app/snapvault/releases/6.8.10/sched_entity.tab:4:FIELD slice_ns u64 8 8\r\n/app/snapvault/releases/6.8.12/sched_entity.tab:1:STRUCT sched_entity\r\n/app/snapvault/releases/6.8.12/sched_entity.tab:4:FIELD slice_ns u64 8 8\r\n/app/relc/input.c:51:             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n"]
