[62.373262, "i", "cat > /app/lagpipe/synclink/driver.c <<'EOF'\n#include \"common.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\nstatic const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\nstatic const char *guard_out = \"/app/lagpipe/synctab_out/offline_guard.ok\";\n\nstatic void clean_outputs(void) {\n    remove(types_out);\n    remove(tag_out);\n    remove(guard_out);\n}\n\nstatic int run_gen(void) {\n    source_pick pick;\n    FILE *fp;\n\n    clean_outputs();\n    if (choose_layout(&pick) != 0) {\n        fprintf(stderr, \"imprint: layout pick failed\\n\");\n        return 1;\n    }\n    if (pick.from_bundle || strncmp(pick.tag_value, \"bundle:\", 7) == 0) {\n        fprintf(stderr, \"imprint: bundle origins are not accepted\\n\");\n        return 1;\n    }\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\n        fprintf(stderr, \"imprint: types write failed\\n\");\n        clean_outputs();\n        return 1;\n    }\n    fp = fopen(tag_out, \"w\");\n    if (!fp || fprintf(fp, \"%s\\n\", pick.tag_value) < 0 || fclose(fp) != 0) {\n        if (fp) fclose(fp);\n        perror(\"imprint: procance.tag\");\n        clean_outputs();\n        return 1;\n    }\n    if (rebuild_binary() != 0) {\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\n        clean_outputs();\n        return 1;\n    }\n    fp = fopen(guard_out, \"w\");\n    if (!fp || fputs(\"1\\n\", fp) == EOF || fclose(fp) != 0) {\n        if (fp) fclose(fp);\n        perror(\"imprint: offline guard\");\n        clean_outputs();\n        return 1;\n    }\n    return 0;\n}\n\nint main(int argc, char **argv) {\n    if (argc < 2) {\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\n        return 2;\n    }\n    if (strcmp(argv[1], \"synctab\") == 0) return run_gen();\n    if (strcmp(argv[1], \"inspect\") == 0) {\n        if (argc != 3) {\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\n            return 2;\n        }\n        return emit_inspect_json(argv[2]);\n    }\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\n    return 2;\n}\nEOF\ncat > /app/lagpipe/synclink/field_emit.c <<'EOF'\n#include \"common.h\"\n\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n\nstatic uint32_t read_u32_le(const unsigned char *p) {\n    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |\n           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);\n}\n\nstatic uint64_t read_u64_le(const unsigned char *p) {\n    uint64_t v = 0;\n    for (unsigned i = 0; i < 8; i++) v |= (uint64_t)p[i] << (8 * i);\n    return v;\n}\n\nint emit_inspect_json(const char *inspect_path) {\n    layout_def layout;\n    unsigned char blob[4096];\n    size_t nread;\n    FILE *fp = fopen(inspect_path, \"rb\");\n    if (!fp) {\n        perror(\"probe\");\n        return 1;\n    }\n    nread = fread(blob, 1, sizeof(blob), fp);\n    fclose(fp);\n    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\n        fprintf(stderr, \"probe: layout.tbl missing\\n\");\n        return 1;\n    }\n    for (int i = 0; i < layout.nfields; i++) {\n        const field_def *f = &layout.fields[i];\n        unsigned need;\n        if (strcmp(f->kind, \"u32\") == 0 && f->size == 4) need = 4;\n        else if (strcmp(f->kind, \"u64\") == 0 && f->size == 8) need = 8;\n        else {\n            fprintf(stderr, \"probe: unsupported field type\\n\");\n            return 1;\n        }\n        if (f->off > nread || need > nread - f->off) {\n            fprintf(stderr, \"probe: inspect too short\\n\");\n            return 1;\n        }\n    }\n    printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\n    for (int i = 0; i < layout.nfields; i++) {\n        const field_def *f = &layout.fields[i];\n        if (strcmp(f->kind, \"u64\") == 0)\n            printf(\",\\\"%s\\\":%llu\", f->name,\n                   (unsigned long long)read_u64_le(blob + f->off));\n        else\n            printf(\",\\\"%s\\\":%lu\", f->name,\n                   (unsigned long)read_u32_le(blob + f->off));\n    }\n    puts(\"}\");\n    return 0;\n}\nEOF\nmake -C /app/lagpipe bind\n"]
