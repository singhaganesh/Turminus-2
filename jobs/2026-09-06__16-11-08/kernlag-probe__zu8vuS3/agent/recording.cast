[20.66924, "o", "--- /app/lagpipe/synclink/common.h ---\r\n"]
[20.670784, "o", "     1\t#ifndef KERN_FORGE_COMMON_H\r\n     2\t#define KERN_FORGE_COMMON_H\r\n     3\t\r\n     4\t#include <stddef.h>\r\n     5\t\r\n     6\t#define LAYOUT_PATH_LEN 512\r\n     7\t#define TAG_PATH_LEN 512\r\n     8\t#define RELEASE_LEN 64\r\n     9\t#define FIELD_MAX 16\r\n    10\t\r\n    11\ttypedef struct {\r\n    12\t    char name[64];\r\n    13\t    char kind[16];\r\n    14\t    unsigned off;\r\n    15\t    unsigned size;\r\n    16\t} field_def;\r\n    17\t\r\n    18\ttypedef struct {\r\n    19\t    char struct_name[64];\r\n    20\t    field_def fields[FIELD_MAX];\r\n    21\t    int nfields;\r\n    22\t} layout_def;\r\n    23\t\r\n    24\ttypedef struct {\r\n    25\t    char layout_path[LAYOUT_PATH_LEN];\r\n    26\t    char tag_value[RELEASE_LEN];\r\n    27\t    int from_bundle;\r\n    28\t} source_pick;\r\n    29\t\r\n    30\tint choose_layout(source_pick *out);\r\n    31\tint parse_layout(const char *path, layout_def *layout);\r\n    32\tint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value);\r\n    33\tint emit_inspect_json(const char *inspect_path);\r\n    34\tint rebuild_binary(void);\r\n    35\t\r\n    36\t#endif\r\n"]
[20.671457, "o", "--- /app/lagpipe/synclink/driver.c ---\r\n"]
[20.672507, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tstatic int run_gen(void) {\r\n     7\t    source_pick pick;\r\n     8\t    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\r\n     9\t    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\r\n"]
[20.672551, "o", "    10\t    FILE *tag_fp;\r\n    11\t\r\n    12\t    if (choose_layout(&pick) != 0) {\r\n    13\t        fprintf(stderr, \"imprint: layout pick failed\\n\");\r\n    14\t        return 1;\r\n    15\t    }\r\n    16\t    tag_fp = fopen(tag_out, \"w\");\r\n    17\t    if (!tag_fp) {\r\n    18\t        perror(\"imprint: procance.tag\");\r\n    19\t        return 1;\r\n    20\t    }\r\n    21\t    fprintf(tag_fp, \"%s\\n\", pick.tag_value);\r\n    22\t    fclose(tag_fp);\r\n    23\t    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\r\n    24\t        fprintf(stderr, \"imprint: types write failed\\n\");\r\n    25\t        return 1;\r\n"]
[20.672677, "o", "    26\t    }\r\n    27\t    if (rebuild_binary() != 0) {\r\n    28\t        fprintf(stderr, \"imprint: rebuild failed\\n\");\r\n    29\t        return 1;\r\n    30\t    }\r\n    31\t    return 0;\r\n    32\t}\r\n    33\t\r\n    34\tint main(int argc, char **argv) {\r\n    35\t    if (argc < 2) {\r\n    36\t        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\r\n    37\t        return 2;\r\n    38\t    }\r\n    39\t    if (strcmp(argv[1], \"synctab\") == 0) {\r\n"]
[20.67282, "o", "    40\t        return run_gen();\r\n    41\t    }\r\n    42\t    if (strcmp(argv[1], \"inspect\") == 0) {\r\n    43\t        if (argc < 3) {\r\n    44\t            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\r\n    45\t            return 2;\r\n    46\t        }\r\n    47\t        return emit_inspect_json(argv[2]);\r\n    48\t    }\r\n    49\t    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\r\n    50\t    return 2;\r\n    51\t}\r\n"]
[20.67308, "o", "--- /app/lagpipe/synclink/parse_layout.c ---\r\n"]
[20.674316, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint parse_layout(const char *path, layout_def *layout) {\r\n     7\t    FILE *fp = fopen(path, \"r\");\r\n     8\t    char line[256];\r\n     9\t    if (!fp || !layout) {\r\n    10\t        return -1;\r\n    11\t    }\r\n    12\t"]
[20.674371, "o", "    memset(layout, 0, sizeof(*layout));\r\n    13\t    while (fgets(line, sizeof(line), fp)) {\r\n    14\t        char name[64];\r\n    15\t        char kind[16];\r\n    16\t        unsigned off = 0;\r\n    17\t        unsigned size = 0;\r\n    18\t        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1) {\r\n    19\t            continue;\r\n    20\t        }\r\n    21\t        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\r\n    22\t            field_def *f = &layout->fields[layout->nfields++];\r\n    23\t            snprintf(f->name, sizeof(f->name), \"%s\", name);\r\n    24\t            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\r\n    25\t            f->off = off;\r\n    26\t            f->size = size;\r\n    27\t        }\r\n    28\t    }\r\n    29\t    fclose(fp);\r\n    30\t    return layout->nfields > 0 ? 0 : -1;\r\n    31\t}\r\n"]
[20.674867, "o", "--- /app/lagpipe/synclink/field_emit.c ---\r\n"]
[20.676163, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdint.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic unsigned long read_u32(const unsigned char *buf, unsigned off) {\r\n     8\t    uint32_t v;\r\n     9\t    memcpy(&v, buf + off, sizeof(v));\r\n    10\t    return (unsigned long)v;\r\n    11\t}\r\n    12\t\r\n    13\tstatic unsigned long long read_u64(const unsigned char *buf, unsigned off) {\r\n    14\t    uint64_t v;\r\n"]
[20.676466, "o", "    15\t    memcpy(&v, buf + off, sizeof(v));\r\n    16\t    return (unsigned long long)v;\r\n    17\t}\r\n    18\t\r\n    19\tint emit_inspect_json(const char *inspect_path) {\r\n    20\t    layout_def layout;\r\n    21\t    unsigned char blob[64];\r\n    22\t    size_t nread;\r\n    23\t    FILE *fp = fopen(inspect_path, \"rb\");\r\n    24\t    if (!fp) {\r\n    25\t        perror(\"probe\");\r\n    26\t        return 1;\r\n    27\t    }\r\n    28\t    nread = fread(blob, 1, sizeof(blob), fp);\r\n    29\t    fclose(fp);\r\n    30\t    if (nread < 16) {\r\n    31\t        fprintf(stderr, \"probe: inspect too short\\n\");\r\n    32\t        return 1;\r\n    33\t    }\r\n    34\t    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\r\n    35\t        fprintf(stderr, \"probe: layout.tbl missing\\n\");\r\n    36\t        return 1;\r\n    37\t    }\r\n    38\t    printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\r\n    39\t    for (int i = 0; i < layout.nfields; i++) {\r\n    40\t        const field_def *f = &layout.fields[i];\r\n    41\t        if (strcmp(f->kind, \"u64\") == 0) {\r\n    42\t            printf(\",\\\"%s\\\":%llu\", f->name, read_u64(blob, f->off));\r\n    43\t        } else {\r\n    44\t            printf(\",\\\"%s\\\":%lu\", f->name, read_u32(blob, f->off));\r\n    45\t        }\r\n    46\t    }\r\n    47\t    printf(\"}\\n\");\r\n    48\t    return 0;\r\n    49\t}\r\n"]
[20.677188, "o", "--- /app/lagpipe/synclink/rebuild.c ---\r\n"]
[20.678215, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdlib.h>\r\n     4\t\r\n     5\tint rebuild_binary(void) {\r\n     6\t    return system(\"make -C /app/lagpipe bind >/dev/null 2>&1\");\r\n     7\t}\r\n"]
[20.678468, "o", "--- /app/relc/input.c ---\r\n"]
[20.679552, "o", "     1\t#include \"../lagpipe/synclink/common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tstatic int read_pin(char *release, size_t n) {\r\n     7\t    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n     8\t    if (!fp) {\r\n     9\t        return -1;\r\n    10\t    }\r\n    11\t    if (!fgets(release, (int)n, fp)) {\r\n    12\t        fclose(fp);\r\n    13\t        return -1;\r\n"]
[20.679738, "o", "    14\t    }\r\n    15\t    fclose(fp);\r\n    16\t    size_t len = strlen(release);\r\n    17\t    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n    18\t        release[--len] = '\\0';\r\n    19\t    }\r\n    20\t    return 0;\r\n    21\t}\r\n    22\t\r\n    23\tstatic void apply_policy_release(char *release, size_t n) {\r\n    24\t    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    25\t    char line[128];\r\n    26\t    char val[RELEASE_LEN];\r\n    27\t    if (!fp) {\r\n    28\t        return;\r\n    29\t    }\r\n    30\t    while (fgets(line, sizeof(line), fp)) {\r\n    31\t        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n    32\t            snprintf(release, n, \"%s\", val);\r\n    33\t        }\r\n    34\t    }\r\n    35\t    fclose(fp);\r\n    36\t}\r\n    37\t\r\n    38\tint choose_layout(source_pick *out) {\r\n    39\t    char release[RELEASE_LEN];\r\n    40\t\r\n    41\t    if (!out) {\r\n    42\t        return -1;\r\n    43\t    }\r\n    44\t    memset(out, 0, sizeof(*out));\r\n    45\t\r\n    46\t    if (read_pin(release, sizeof(release)) != 0) {\r\n    47\t        return -1;\r\n    48\t    }\r\n    49\t    apply_policy_release(release, sizeof(release));\r\n    50\t    snprintf(out->layout_path, sizeof(out->layout_path),\r\n    51\t             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    52\t    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    53\t    out->from_bundle = 1;\r\n    54\t    return 0;\r\n    55\t}\r\n"]
