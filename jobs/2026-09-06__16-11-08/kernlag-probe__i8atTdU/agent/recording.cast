[49.387016, "i", "cat > /app/relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic int read_running_release(char *release, size_t n) {\n    FILE *fp = fopen(\"/app/livekern/running.release\", \"r\");\n    size_t len;\n    if (!fp || !fgets(release, (int)n, fp)) {\n        if (fp) fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    len = strlen(release);\n    while (len && (release[len - 1] == '\\n' || release[len - 1] == '\\r' ||\n                   release[len - 1] == ' ' || release[len - 1] == '\\t'))\n        release[--len] = '\\0';\n    return len ? 0 : -1;\n}\n\nint choose_layout(source_pick *out) {\n    char release[RELEASE_LEN];\n    if (!out || read_running_release(release, sizeof(release)) != 0)\n        return -1;\n    memset(out, 0, sizeof(*out));\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/livekern/exports/sched_entity.tab\");\n    snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release);\n    out->from_bundle = 0;\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    char release[64];\n    char expected[70];\n    size_t len;\n    FILE *fp;\n\n    if (!tag_value || strncmp(tag_value, \"bundle:\", 7) == 0)\n        return -1;\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp || !fgets(release, sizeof(release), fp)) {\n        if (fp) fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    len = strlen(release);\n    while (len && (release[len - 1] == '\\n' || release[len - 1] == '\\r' ||\n                   release[len - 1] == ' ' || release[len - 1] == '\\t'))\n        release[--len] = '\\0';\n    snprintf(expected, sizeof(expected), \"live:%s\", release);\n    return strcmp(tag_value, expected) == 0 ? 0 : -1;\n}\nEOF\ncat > /app/lagpipe/tblw/emit_writer.c <<'EOF'\n#include \"../synclink/common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\n    layout_def layout;\n    FILE *out;\n\n    if (permit_tag(tag_value) != 0 || parse_layout(layout_path, &layout) != 0)\n        return -1;\n    out = fopen(out_path, \"w\");\n    if (!out)\n        return -1;\n    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\n    for (int i = 0; i < layout.nfields; i++)\n        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name,\n                layout.fields[i].kind, layout.fields[i].off,\n                layout.fields[i].size);\n    if (fclose(out) != 0)\n        return -1;\n    return 0;\n}\nEOF\n"]
