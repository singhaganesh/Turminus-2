[26.496944, "o", "/app/lagpipe/tblw/emit_writer.c\r\n/app/livekern/CHANNEL\r\n/app/livekern/EXPORTS\r\n/app/livekern/VERSION\r\n/app/livekern/exports/sched_entity.tab\r\n/app/livekern/running.release\r\n/app/memvault/MANIFEST\r\n/app/memvault/cards/pulse_a.ref\r\n/app/memvault/cards/pulse_b.ref\r\n/app/memvault/regression/bundle_pick_input.c\r\n/app/memvault/samples/pulse_a.mem\r\n/app/memvault/samples/pulse_b.mem\r\n/app/relc/input.c\r\n/app/snapvault/CATALOG\r\n/app/snapvault/MANIFEST\r\n/app/snapvault/PIN_INDEX\r\n/app/snapvault/default.pin\r\n/app/snapvault/policy.conf\r\n"]
