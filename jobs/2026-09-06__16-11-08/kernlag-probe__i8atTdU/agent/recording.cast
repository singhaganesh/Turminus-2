[7.844722, "i", "printf '%s\\n' '--- FIELD_RULES ---'; cat /app/lagpipe/fieldnotes/FIELD_RULES.txt; printf '%s\\n' '--- ROUTE_MAP ---'; cat /app/lagpipe/fieldnotes/ROUTE_MAP.txt\n"]
[7.845376, "o", "printf '%s\\n' '--- FIELD_RULES ---'; cat /app/lagpipe/fieldnotes/FIELD_RULES.txt; printf '%s\\n' '--- ROUTE_MAP ---'; cat /app/lagpipe/fieldnotes/ROUTE_MAP.txt\r\n\u001b[?2004l\r"]
[7.845634, "o", "--- FIELD_RULES ---\r\n"]
[7.847062, "o", "Layout table lines:\r\n  STRUCT <name>\r\n  FIELD <name> <kind> <offset> <size>\r\n\r\nKinds: u32, u64. u64 fields use eight-byte little-endian values in capture blobs.\r\nSample blobs are little-endian packed fields in field order.\r\nsched_entity fields include pid, weight, migration_flags, slice_ns.\r\n\r\nprocance.tag is one line: live:<release> or bundle:<release>\r\noffline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n\r\nCLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\nmemvault captures: /app/memvault/samples/*.mem\r\nmemvault cards: /app/memvault/cards/*.ref\r\nrunning release file: /app/livekern/running.release\r\n"]
[7.847279, "o", "--- ROUTE_MAP ---\r\n"]
[7.848795, "o", "lagpipe synctab wiring notes (internal)\r\n\r\nModules linked by `make -C /app/lagpipe bind` participate in synctab:\r\n  layout pick — chooses sched_entity table input for synctab\r\n  types writer — materializes synctab_out/layout.tbl from the picked table\r\n  tag policy gate — decides whether procance lines are acceptable on this image\r\n  probe emitter — decodes memvault captures through layout.tbl offsets\r\n\r\nField layout rules and CLI contract: /app/lagpipe/fieldnotes/FIELD_RULES.txt\r\nRebuild entrypoint: make -C /app/lagpipe bind\r\n"]
[7.849615, "o", "\u001b[?2004hroot@669a6bf90174:/app# "]
[7.999746, "i", "printf '%s\\n' '--- TREE ---'; find /app/lagpipe /app/memvault /app/livekern -maxdepth 4 -type f -printf '%p\\n' | sort; printf '%s\\n' '--- MAKEFILES/SOURCES ---'; find /app -maxdepth 4 -type f \\( -name 'Makefile' -o -name '*.c' -o -name '*.h' -o -name '*.py' -o -name '*.sh' \\) -print | sort\n"]
