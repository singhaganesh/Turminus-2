[26.005048, "i", "echo '=== field_emit ==='; cat /app/lagpipe/synclink/field_emit.c; echo '=== parse_layout ==='; cat /app/lagpipe/synclink/parse_layout.c; echo '=== rebuild ==='; cat /app/lagpipe/synclink/rebuild.c; echo '=== writer ==='; cat /app/lagpipe/tblw/emit_writer.c; echo '=== gate.h ==='; cat /app/lagpipe/tagc/gate.h; echo '=== gate.c ==='; cat /app/lagpipe/tagc/gate.c\n"]
