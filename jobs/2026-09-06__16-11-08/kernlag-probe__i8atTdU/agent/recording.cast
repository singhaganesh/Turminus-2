[26.498619, "o", "drwxr-xr-x 2 root root 4096 Sep  6 10:19 .\r\ndrwxr-xr-x 1 root root 4096 Sep  6 10:19 ..\r\n-rw-r--r-- 1 root root   82 Sep  6 10:19 layout.tbl\r\n-rw-r--r-- 1 root root   14 Sep  6 10:19 procance.tag\r\n"]
[26.498872, "o", "\u001b[?2004h"]
