     1	#include "common.h"
     2	
     3	#include <stdio.h>
     4	#include <string.h>
     5	
     6	static int run_gen(void) {
     7	    source_pick pick;
     8	    const char *types_out = "/app/lagpipe/synctab_out/layout.tbl";
     9	    const char *tag_out = "/app/lagpipe/synctab_out/procance.tag";
    10	    FILE *tag_fp;
    11	
    12	    if (choose_layout(&pick) != 0) {
    13	        fprintf(stderr, "imprint: layout pick failed\n");
    14	        return 1;
    15	    }
    16	    tag_fp = fopen(tag_out, "w");
    17	    if (!tag_fp) {
    18	        perror("imprint: procance.tag");
    19	        return 1;
    20	    }
    21	    fprintf(tag_fp, "%s\n", pick.tag_value);
    22	    fclose(tag_fp);
    23	    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {
    24	        fprintf(stderr, "imprint: types write failed\n");
    25	        return 1;
    26	    }
    27	    if (rebuild_binary() != 0) {
    28	        fprintf(stderr, "imprint: rebuild failed\n");
    29	        return 1;
    30	    }
    31	    return 0;
    32	}
    33	
    34	int main(int argc, char **argv) {
    35	    if (argc < 2) {
    36	        fprintf(stderr, "usage: kernscribe synctab | inspect <capture>\n");
    37	        return 2;
    38	    }
    39	    if (strcmp(argv[1], "synctab") == 0) {
    40	        return run_gen();
    41	    }
    42	    if (strcmp(argv[1], "inspect") == 0) {
    43	        if (argc < 3) {
    44	            fprintf(stderr, "usage: kernscribe inspect <capture>\n");
    45	            return 2;
    46	        }
    47	        return emit_inspect_json(argv[2]);
    48	    }
    49	    fprintf(stderr, "unknown command: %s\n", argv[1]);
    50	    return 2;
    51	}
===== /app/lagpipe/synclink/field_emit.c =====
     1	#include "common.h"
     2	
     3	#include <stdint.h>
     4	#include <stdio.h>
     5	#include <string.h>
     6	
     7	static unsigned long read_u32(const unsigned char *buf, unsigned off) {
     8	    uint32_t v;
     9	    memcpy(&v, buf + off, sizeof(v));
    10	    return (unsigned long)v;
    11	}
    12	
    13	static unsigned long long read_u64(const unsigned char *buf, unsigned off) {
    14	    uint64_t v;
    15	    memcpy(&v, buf + off, sizeof(v));
    16	    return (unsigned long long)v;
    17	}
    18	
    19	int emit_inspect_json(const char *inspect_path) {
    20	    layout_def layout;
    21	    unsigned char blob[64];
    22	    size_t nread;
    23	    FILE *fp = fopen(inspect_path, "rb");
    24	    if (!fp) {
    25	        perror("probe");
    26	        return 1;
    27	    }
    28	    nread = fread(blob, 1, sizeof(blob), fp);
    29	    fclose(fp);
    30	    if (nread < 16) {
    31	        fprintf(stderr, "probe: inspect too short\n");
    32	        return 1;
    33	    }
    34	    if (parse_layout("/app/lagpipe/synctab_out/layout.tbl", &layout) != 0) {
    35	        fprintf(stderr, "probe: layout.tbl missing\n");
    36	        return 1;
    37	    }
    38	    printf("{\"struct\":\"%s\"", layout.struct_name);
    39	    for (int i = 0; i < layout.nfields; i++) {
    40	        const field_def *f = &layout.fields[i];
    41	        if (strcmp(f->kind, "u64") == 0) {
    42	            printf(",\"%s\":%llu", f->name, read_u64(blob, f->off));
    43	        } else {
    44	            printf(",\"%s\":%lu", f->name, read_u32(blob, f->off));
    45	        }
    46	    }
    47	    printf("}\n");
    48	    return 0;
    49	}
===== /app/lagpipe/synclink/parse_layout.c =====
     1	#include "common.h"
     2	
     3	#include <stdio.h>
     4	#include <string.h>
     5	
     6	int parse_layout(const char *path, layout_def *layout) {
     7	    FILE *fp = fopen(path, "r");
     8	    char line[256];
     9	    if (!fp || !layout) {
    10	        return -1;
    11	    }
    12	    memset(layout, 0, sizeof(*layout));
    13	    while (fgets(line, sizeof(line), fp)) {
    14	        char name[64];
    15	        char kind[16];
    16	        unsigned off = 0;
    17	        unsigned size = 0;
    18	        if (sscanf(line, "STRUCT %63s", layout->struct_name) == 1) {
    19	            continue;
    20	        }
    21	        if (sscanf(line, "FIELD %63s %15s %u %u", name, kind, &off, &size) == 4) {
    22	            field_def *f = &layout->fields[layout->nfields++];
    23	            snprintf(f->name, sizeof(f->name), "%s", name);
    24	            snprintf(f->kind, sizeof(f->kind), "%s", kind);
    25	            f->off = off;
    26	            f->size = size;
    27	        }
    28	    }
    29	    fclose(fp);
    30	    return layout->nfields > 0 ? 0 : -1;
    31	}
