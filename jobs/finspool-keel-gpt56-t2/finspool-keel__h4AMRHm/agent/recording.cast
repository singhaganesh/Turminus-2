[70.56436, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> const SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn show(p: &str) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = SHAPE.len();\r\n\u001b[?2004l\r\u001b[?2004h>     let raw = match fs::read_to_string(p) {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(s) => s,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.565916, "o", ">     let body = match raw.strip_suffix('\\n') {"]
[70.566015, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         Some(s) => s,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.569653, "o", "        None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     let lines: Vec<&str> = body.split('\\n').collect();\r\n\u001b[?2004l\r\u001b[?2004h>     if lines.len() != 4 || lines[0] != \"FIN1\" || lines[3] != \"END\" {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let thread = match lines[1].strip_prefix(\"thread=\") {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(v) => v,\r\n\u001b[?2004l\r\u001b[?2004h>         None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     let op = match lines[2].strip_prefix(\"op=\") {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(v) => v,\r\n\u001b[?2004l\r\u001b[?2004h>         None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     if thread.contains(['\\r', '\\n']) || op.contains(['\\r', '\\n']) {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     print!(\"{}\", raw);\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.570469, "o", "EOF\r\n\u001b[?2004l\r"]
[70.57675, "o", "\u001b[?2004hroot@987c880c88c1:/app# cat > /app/fincli/boot.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"/app/hookvat/spool.rs\"] mod spool;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"/app/hookvat/seal.rs\"] mod seal;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"/app/hookvat/open.rs\"] mod open;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"/app/hookvat/gen_emit.rs\"] mod emit;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"/app/scanpit/peek.rs\"] mod peek;\r\n\u001b[?2004l\r\u001b[?2004h> #[path = \"/app/scanpit/fmt.rs\"] mod fmt;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> use std::{env, process};\r\n\u001b[?2004l\r"]
