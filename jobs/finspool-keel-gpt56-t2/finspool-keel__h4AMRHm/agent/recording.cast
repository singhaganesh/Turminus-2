[70.518371, "o", "\u001b[?2004h"]
[70.518911, "o", "> "]
[70.519061, "o", "pub fn atomic_write(dest: &str, bytes: &[u8]) -> io::Result<()> {"]
[70.521587, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     let path = Path::new(dest);"]
[70.521668, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     let tmp = temporary(path);\r\n\u001b[?2004l\r\u001b[?2004h>     let result = (|| {\r\n"]
[70.524443, "o", "\u001b[?2004l\r\u001b[?2004h>         let mut file = OpenOptions::new().write(true).create_new(true).open(&tmp)?;\r\n\u001b[?2004l\r\u001b[?2004h>         file.write_all(bytes)?;\r\n\u001b[?2004l\r\u001b[?2004h>         file.sync_all()?;\r\n\u001b[?2004l\r\u001b[?2004h>         if Path::new(\"/app/opsleaf/RIP\").is_file() {\r\n\u001b[?2004l\r\u001b[?2004h>             drop(file);\r\n\u001b[?2004l\r\u001b[?2004h>             let _ = fs::remove_file(&tmp);\r\n\u001b[?2004l\r\u001b[?2004h>             let _ = fs::remove_file(path);\r\n\u001b[?2004l\r\u001b[?2004h>             process::abort();\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         drop(file);\r\n\u001b[?2004l\r\u001b[?2004h>         fs::rename(&tmp, path)?;\r\n\u001b[?2004l\r\u001b[?2004h>         if let Some(parent) = path.parent() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.52475, "o", "            if let Ok(dir) = OpenOptions::new().read(true).open(parent) {\r\n\u001b[?2004l\r"]
[70.524792, "o", "\u001b[?2004h"]
[70.527719, "o", ">                 let _ = dir.sync_all();\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(())\r\n\u001b[?2004l\r\u001b[?2004h>     })();\r\n\u001b[?2004l\r\u001b[?2004h>     if result.is_err() {\r\n\u001b[?2004l\r\u001b[?2004h>         let _ = fs::remove_file(&tmp);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     result\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
