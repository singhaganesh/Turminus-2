[70.494728, "i", "cat > /app/hookvat/open.rs <<'EOF'\nuse std::fs;\nuse std::path::{Component, Path};\n\npub fn under_root(p: &str) -> bool {\n    let path = Path::new(p);\n    let root = Path::new(\"/app/bloturn\");\n    let rel = match path.strip_prefix(root) {\n        Ok(r) if !r.as_os_str().is_empty() => r,\n        _ => return false,\n    };\n    if rel.components().any(|c| !matches!(c, Component::Normal(_))) {\n        return false;\n    }\n    let parent = match path.parent() {\n        Some(v) => v,\n        None => return false,\n    };\n    match (fs::canonicalize(root), fs::canonicalize(parent)) {\n        (Ok(r), Ok(d)) => d.starts_with(r),\n        _ => false,\n    }\n}\nEOF\ncat > /app/hookvat/seal.rs <<'EOF'\npub fn card(thread: &str, op: &str) -> Vec<u8> {\n    format!(\"FIN1\\nthread={}\\nop={}\\nEND\\n\", thread, op).into_bytes()\n}\nEOF\ncat > /app/hookvat/spool.rs <<'EOF'\nuse std::fs::{self, OpenOptions};\nuse std::io::{self, Write};\nuse std::path::{Path, PathBuf};\nuse std::process;\nuse std::sync::atomic::{AtomicU64, Ordering};\n\nstatic NEXT: AtomicU64 = AtomicU64::new(0);\n\nfn temporary(dest: &Path) -> PathBuf {\n    let parent = dest.parent().unwrap();\n    let name = dest.file_name().unwrap().to_string_lossy();\n    let n = NEXT.fetch_add(1, Ordering::Relaxed);\n    parent.join(format!(\".{}.finspool.{}.{}\", name, process::id(), n))\n}\n\npub fn atomic_write(dest: &str, bytes: &[u8]) -> io::Result<()> {\n    let path = Path::new(dest);\n    let tmp = temporary(path);\n    let result = (|| {\n        let mut file = OpenOptions::new().write(true).create_new(true).open(&tmp)?;\n        file.write_all(bytes)?;\n        file.sync_all()?;\n        if Path::new(\"/app/opsleaf/RIP\").is_file() {\n            drop(file);\n            let _ = fs::remove_file(&tmp);\n            let _ = fs::remove_file(path);\n            process::abort();\n        }\n        drop(file);\n        fs::rename(&tmp, path)?;\n        if let Some(parent) = path.parent() {\n            if let Ok(dir) = OpenOptions::new().read(true).open(parent) {\n                let _ = dir.sync_all();\n            }\n        }\n        Ok(())\n    })();\n    if result.is_err() {\n        let _ = fs::remove_file(&tmp);\n    }\n    result\n}\nEOF\ncat > /app/tplfold/gather.rs <<'EOF'\npub fn go(nm: &str, verb: &str, dest: &str, _hard: bool) -> i32 {\n    let thread = crate::fmt::keep_token(nm);\n    let op = crate::fmt::keep_token(verb);\n    let card = crate::seal::card(&thread, &op);\n    match crate::spool::atomic_write(dest, &card) {\n        Ok(()) => 0,\n        Err(_) => 1,\n    }\n}\nEOF\ncp /app/tplfold/gather.rs /app/tplfold/live.rs\ncat > /app/scanpit/peek.rs <<'EOF'\nuse std::fs;\n\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\n\npub fn show(p: &str) -> i32 {\n    let _ = SHAPE.len();\n    let raw = match fs::read_to_string(p) {\n        Ok(s) => s,\n        Err(_) => return 1,\n    };\n    let body = match raw.strip_suffix('\\n') {\n        Some(s) => s,\n        None => return 1,\n    };\n    let lines: Vec<&str> = body.split('\\n').collect();\n    if lines.len() != 4 || lines[0] != \"FIN1\" || lines[3] != \"END\" {\n        return 1;\n    }\n    let thread = match lines[1].strip_prefix(\"thread=\") {\n        Some(v) => v,\n        None => return 1,\n    };\n    let op = match lines[2].strip_prefix(\"op=\") {\n        Some(v) => v,\n        None => return 1,\n    };\n    if thread.contains(['\\r', '\\n']) || op.contains(['\\r', '\\n']) {\n        return 1;\n    }\n    print!(\"{}\", raw);\n    0\n}\nEOF\ncat > /app/fincli/boot.rs <<'EOF'\n#[path = \"/app/hookvat/spool.rs\"] mod spool;\n#[path = \"/app/hookvat/seal.rs\"] mod seal;\n#[path = \"/app/hookvat/open.rs\"] mod open;\n#[path = \"/app/hookvat/gen_emit.rs\"] mod emit;\n#[path = \"/app/scanpit/peek.rs\"] mod peek;\n#[path = \"/app/scanpit/fmt.rs\"] mod fmt;\n\nuse std::{env, process};\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\n\nfn clean_token(s: &str) -> bool {\n    !s.contains(['\\n', '\\r'])\n}\n\nfn main() {\n    let argv: Vec<String> = env::args().skip(1).collect();\n    let rc = match argv.as_slice() {\n        [cmd] if cmd == \"knit\" => {\n            let st = process::Command::new(\"/app/hull.sh\").status();\n            if s"]
[70.49514, "i", "t.map(|s| s.success()).unwrap_or(false) { 0 } else { 1 }\n        }\n        [cmd, dest] if cmd == \"look\" => peek::show(dest),\n        [cmd, th, op, dest] if cmd == \"ease\" || cmd == \"sting\" => {\n            if !clean_token(th) || !clean_token(op) || !open::under_root(dest) {\n                2\n            } else {\n                let rc = emit::go(th, op, dest, cmd == \"sting\");\n                if rc != 0 { rc } else if cmd == \"sting\" { process::abort() } else { 0 }\n            }\n        }\n        _ => {\n            eprintln!(\"usage: finspool knit|sting THREAD OP DEST|ease THREAD OP DEST|look DEST\");\n            let _ = SHIFT.len();\n            2\n        }\n    };\n    process::exit(rc);\n}\nEOF\n/app/hull.sh\n"]
[70.4966, "o", "cat > /app/hookvat/open.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.496764, "o", "> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> use std::path::{Component, Path};\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn under_root(p: &str) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h>     let path = Path::new(p);\r\n\u001b[?2004l\r\u001b[?2004h>     let root = Path::new(\"/app/bloturn\");\r\n\u001b[?2004l\r\u001b[?2004h>     let rel = match path.strip_prefix(root) {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(r) if !r.as_os_str().is_empty() => r,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.49679, "o", "        _ => return false,\r\n\u001b[?2004l\r"]
[70.4979, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     if rel.components().any(|c| !matches!(c, Component::Normal(_))) {\r\n\u001b[?2004l\r\u001b[?2004h>         return false;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let parent = match path.parent() {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(v) => v,\r\n\u001b[?2004l\r\u001b[?2004h>         None => return false,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     match (fs::canonicalize(root), fs::canonicalize(parent)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.498337, "o", "        (Ok(r), Ok(d)) => d.starts_with(r),"]
[70.498659, "o", "\r\n\u001b[?2004l\r"]
[70.498825, "o", "\u001b[?2004h> "]
[70.498993, "o", "        _ => false,\r\n\u001b[?2004l\r"]
[70.49905, "o", "\u001b[?2004h"]
[70.499211, "o", "> "]
[70.499971, "o", "    }\r\n\u001b[?2004l\r"]
