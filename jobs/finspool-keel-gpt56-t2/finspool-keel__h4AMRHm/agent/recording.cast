[70.513629, "o", "\r\n"]
[70.514063, "o", "\u001b[?2004l\r\u001b[?2004h"]
[70.514638, "o", "> use std::sync::atomic::{AtomicU64, Ordering};\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static NEXT: AtomicU64 = AtomicU64::new(0);\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.514951, "o", "> \r\n\u001b[?2004l\r"]
[70.515289, "o", "\u001b[?2004h> "]
[70.51534, "o", "fn temporary(dest: &Path) -> PathBuf {"]
[70.516958, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     let parent = dest.parent().unwrap();\r\n\u001b[?2004l\r\u001b[?2004h>     let name = dest.file_name().unwrap().to_string_lossy();\r\n\u001b[?2004l\r\u001b[?2004h>     let n = NEXT.fetch_add(1, Ordering::Relaxed);\r\n\u001b[?2004l\r\u001b[?2004h>     parent.join(format!(\".{}.finspool.{}.{}\", name, process::id(), n))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[70.517457, "o", "\u001b[?2004h"]
[70.517717, "o", "> "]
