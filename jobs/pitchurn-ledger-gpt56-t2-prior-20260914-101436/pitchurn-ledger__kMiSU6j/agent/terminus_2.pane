    19	    a.println("    if (Files.exists(hot)) sb.append(Files.readString(hot));");
    20	    a.println("    Files.writeString(live, sb.toString());");
    21	    a.println("    System.out.println(\"walked\");");
    22	    a.println("  }");
    23	    a.println("}");
    24	  }
    25	}
     1	import java.nio.file.*;
