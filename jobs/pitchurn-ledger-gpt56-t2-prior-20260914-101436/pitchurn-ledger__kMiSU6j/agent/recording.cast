[67.370664, "i", "cat > /app/hitchcli/WalkRun.java <<'EOF'\nimport java.io.*;\nimport java.nio.file.*;\nimport java.util.*;\n\npublic class WalkRun {\n  public static int run() throws Exception {\n    Gear g = Gear.load(\"/app/gearpit/live.gear\");\n    Map<String,String> idx = Idx.load();\n    Idx.add(idx, \"/app/urnbay/cold/idx.tsv\");\n\n    Path marks = Paths.get(\"/app/urnbay/marks\");\n    Path hot = Paths.get(\"/app/urnbay/hot\");\n    Files.createDirectories(marks);\n    Files.createDirectories(hot);\n\n    List<Path> manifests = new ArrayList<>();\n    try (DirectoryStream<Path> ds = Files.newDirectoryStream(marks, \"*.m\")) {\n      for (Path p : ds) manifests.add(p);\n    }\n    manifests.sort(Comparator.comparing(p -> p.getFileName().toString()));\n\n    for (Path manifest : manifests) {\n      ByteArrayOutputStream reel = new ByteArrayOutputStream();\n      for (String line : Files.readAllLines(manifest)) {\n        String key = line.trim();\n        if (key.isEmpty()) continue;\n        String rel = idx.get(key);\n        if (rel == null) throw new IOException(\"missing silo key \" + key);\n        reel.write(Idx.blob(rel));\n      }\n\n      List<byte[]> parts = Slice.cut(reel.toByteArray(), g.mask, g.min, g.max);\n      StringBuilder rewritten = new StringBuilder();\n      for (byte[] part : parts) {\n        String key = Seal.hex(part, g.fp);\n        String rel = idx.get(key);\n        if (rel == null) {\n          rel = \"hot/\" + key + \".blob\";\n          Files.write(hot.resolve(key + \".blob\"), part,\n              StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);\n          Idx.put(key, rel);\n          idx.put(key, rel);\n        } else if (!Arrays.equals(part, Idx.blob(rel))) {\n          throw new IOException(\"hash collision for \" + key);\n        }\n        rewritten.append(key).append('\\n');\n      }\n      Files.writeString(manifest, rewritten.toString(),\n          StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);\n    }\n\n    System.out.println(\"walked\");\n    return 0;\n  }\n}\nEOF\n/app/kiln.sh\n"]
