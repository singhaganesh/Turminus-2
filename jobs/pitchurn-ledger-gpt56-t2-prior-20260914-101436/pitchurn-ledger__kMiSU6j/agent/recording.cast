[26.549386, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class DrawRun {\r\n     4\t  public static int run(String dest, String reel) throws Exception {\r\n     5\t    String name = Paths.get(reel).getFileName().toString();\r\n     6\t    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n     7\t    Map<String,String> idx = Idx.load();\r\n     8\t    add(idx, \"/app/urnbay/cold/idx.tsv\");\r\n     9\t    StringBuilder skip = new StringBuilder();\r\n    10\t    List<byte[]> acc = new ArrayList<>();\r\n    11\t    for (String ln : Files.readAllLines(mk)) {\r\n    12\t      String k = ln.trim();\r\n    13\t      if (k.isEmpty()) continue;\r\n    14\t      String rel = idx.get(k);\r\n    15\t      if (rel == null) continue;\r\n    16\t      acc.add(Idx.blob(rel));\r\n    17\t    }\r\n    18\t    int n = 0;\r\n    19\t    for (byte[] b : acc) n += b.length;\r\n    20\t    byte[] out = new byte[n];\r\n    21\t    int o = 0;\r\n    22\t    for (byte[] b : acc) {\r\n    23\t      System.arraycopy(b, 0, out, o, b.length);\r\n    24\t      o += b.length;\r\n    25\t    }\r\n    26"]
[26.549794, "o", "\t    Path d = Paths.get(dest);\r\n    27\t    Files.createDirectories(d.getParent() == null ? Paths.get(\".\") : d.getParent());\r\n    28\t    Files.write(d, out);\r\n    29\t    return 0;\r\n    30\t  }\r\n    31\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    32\t    Idx.add(m, p);\r\n    33\t  }\r\n    34\t}\r\n"]
[26.55219, "o", "     1\timport java.nio.file.*;\r\n     2\tpublic class CardRun {\r\n     3\t  public static int run() throws Exception {\r\n     4\t    Path last = Paths.get(\"/app/urnbay/last.json\");\r\n     5\t    if (!Files.exists(last)) return 1;\r\n     6\t    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), Files.readString(last));\r\n     7\t    return 0;\r\n     8\t  }\r\n     9\t}\r\n"]
