[42.242737, "i", "for f in /app/hitchcli/DrawRun.java /app/hitchcli/CardRun.java /app/lidmath/Floor.java; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[42.243339, "o", "for f in /app/hitchcli/DrawRun.java /app/hitchcli/CardRun.java /app/lidmath/Floor.java; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[42.243476, "o", "===== /app/hitchcli/DrawRun.java =====\r\n"]
[42.245209, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class DrawRun {\r\n     4\t  public static int run(String dest, String reel) throws Exception {\r\n     5\t    String name = Paths.get(reel).getFileName().toString();\r\n     6\t    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n     7\t    Map<String,String> idx = Idx.load();\r\n     8\t    add(idx, \"/app/urnbay/cold/idx.tsv\");\r\n     9\t    StringBuilder skip = new StringBuilder();\r\n    10\t    List<byte[]> acc = new ArrayList<>();\r\n    11\t    for (String ln : Files.readAllLines(mk)) {\r\n    12\t      String k = ln.trim();\r\n    13\t      if (k.isEmpty()) continue;\r\n    14\t      String rel = idx.get(k);\r\n    15\t      if (rel == null) continue;\r\n    16\t      acc.add(Idx.blob(rel));\r\n    17\t    }\r\n    18\t    int n = 0;\r\n    19\t    for (byte[] b : acc) n += b.length;\r\n    20\t    byte[] out = new byte[n];\r\n    21\t    int o = 0;\r\n    22\t    for (byte[] b : acc) {\r\n    23\t      System.arraycopy(b, 0, out, o, b.length);\r\n"]
[42.245392, "o", "    24\t      o += b.length;\r\n    25\t    }\r\n    26\t    Path d = Paths.get(dest);\r\n    27\t    Files.createDirectories(d.getParent() == null ? Paths.get(\".\") : d.getParent());\r\n    28\t    Files.write(d, out);\r\n    29\t    return 0;\r\n    30\t  }\r\n    31\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    32\t    Idx.add(m, p);\r\n    33\t  }\r\n    34\t}\r\n"]
[42.245607, "o", "===== /app/hitchcli/CardRun.java =====\r\n"]
[42.24667, "o", "     1\timport java.nio.file.*;\r\n     2\tpublic class CardRun {\r\n     3\t  public static int run() throws Exception {\r\n     4\t    Path last = Paths.get(\"/app/urnbay/last.json\");\r\n     5\t    if (!Files.exists(last)) return 1;\r\n     6\t    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), Files.readString(last));\r\n     7\t    return 0;\r\n"]
[42.246801, "o", "     8\t  }\r\n     9\t}\r\n"]
[42.24691, "o", "===== /app/lidmath/Floor.java =====\r\n"]
[42.247959, "o", "     1\timport java.nio.file.*;\r\n     2\tpublic class Floor {\r\n     3\t  public static boolean ok(double reuse) throws Exception {\r\n     4\t    String s = Files.readString(Paths.get(\"/app/deskfold/MIN.txt\")).trim();\r\n     5\t    double m = Double.parseDouble(s);\r\n     6\t    return reuse + 1e-9 >= m;\r\n     7\t  }\r\n     8\t}\r\n"]
[42.248299, "o", "\u001b[?2004hroot@8d3f8da449e2:/app# "]
[42.381687, "i", "python3 - <<'PY'\nfrom pathlib import Path\nmask,minn,maxx=2047,48,4096\nfor f in sorted(Path('/app/filmwelle').glob('*.bin')):\n s=f.read_bytes(); h=start=0; lens=[]\n for i,b in enumerate(s):\n  if b>=128:b-=256\n  h=((h<<1)+b)&0xffffffff\n  ln=i-start+1\n  if (ln>=minn and (h&mask)==0) or ln>=maxx or i==len(s)-1:\n   lens.append(ln);start=i+1;h=0\n print(f.name, len(s), len(lens), sum(lens)/len(lens), min(lens), max(lens))\nPY\n"]
[42.381953, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[42.382064, "o", "\u001b[?2004h> "]
