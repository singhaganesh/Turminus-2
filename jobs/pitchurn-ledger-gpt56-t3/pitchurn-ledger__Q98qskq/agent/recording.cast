[114.664125, "i", "set +e\npython3 - <<'PY'\nfrom pathlib import Path\nPath('/app/filmwelle/contract-temp.bin').write_bytes(b'A' * 5000)\nPY\n/app/bin/pitchurn stow /app/filmwelle/contract-temp.bin\npython3 - <<'PY'\nfrom pathlib import Path\nPath('/app/filmwelle/contract-temp.bin').write_bytes(b'B' * 5000)\nPY\n/app/bin/pitchurn stow /app/filmwelle/contract-temp.bin\nrc=$?\necho \"full-copy second-stow rc=$rc\"\nrm -f /app/filmwelle/contract-temp.bin\nif [ \"$rc\" -eq 0 ]; then echo 'ERROR: expected non-zero'; exit 1; fi\nset -e\n"]
