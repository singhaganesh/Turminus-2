[42.382293, "o", "mask,minn,maxx=2047,48,4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.382444, "o", "for f in sorted(Path('/app/filmwelle').glob('*.bin')):\r\n\u001b[?2004l\r"]
[42.382539, "o", "\u001b[?2004h> "]
[42.382601, "o", " s=f.read_bytes(); h=start=0; lens=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.382665, "o", "> "]
[42.382694, "o", " for i,b in enumerate(s):\r\n\u001b[?2004l\r"]
[42.382712, "o", "\u001b[?2004h"]
[42.382728, "o", "> "]
[42.382884, "o", "  if b>=128:b-=256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.382954, "o", "  h=((h<<1)+b)&0xffffffff\r\n\u001b[?2004l\r"]
[42.383037, "o", "\u001b[?2004h>   ln=i-start+1\r\n\u001b[?2004l\r"]
[42.384093, "o", "\u001b[?2004h>   if (ln>=minn and (h&mask)==0) or ln>=maxx or i==len(s)-1:\r\n\u001b[?2004l\r\u001b[?2004h>    lens.append(ln);start=i+1;h=0\r\n\u001b[?2004l\r\u001b[?2004h>  print(f.name, len(s), len(lens), sum(lens)/len(lens), min(lens), max(lens))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
