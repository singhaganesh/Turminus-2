[74.194853, "i", "python3 - <<'PY'\np='/app/nincut/VatGen.java'\ns=open(p).read()\ns=s.replace('a.println(\"      boolean cap = ln >= max;\");', 'a.println(\"      boolean cap = ln >= Math.min(max, 2048);\");')\nopen(p,'w').write(s)\n\np='/app/hitchcli/Idx.java'\ns=open(p).read()\ns=s.replace('    add(m, \"/app/urnbay/hot/idx.tsv\");\\n    return m;', '    add(m, \"/app/urnbay/hot/idx.tsv\");\\n    add(m, \"/app/urnbay/cold/idx.tsv\");\\n    return m;')\nopen(p,'w').write(s)\nPY\ncat > /app/hitchcli/StowRun.java <<'EOF'\nimport java.nio.file.*;\nimport java.io.*;\nimport java.util.*;\npublic class StowRun {\n  public static int run(String reel) throws Exception {\n    Gear g = Gear.load(\"/app/gearpit/live.gear\");\n    byte[] src = Files.readAllBytes(Paths.get(reel));\n    String name = Paths.get(reel).getFileName().toString();\n    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\n    Path flag = Paths.get(\"/app/urnbay/marks/\" + name + \".flag\");\n    boolean prior = Files.exists(flag);\n    Map<String,String> idx = Idx.load();\n\n    List<String> keys = new ArrayList<>();\n    boolean exact = prior && Files.exists(mk) && matches(src, mk, idx, keys);\n    List<byte[]> parts;\n    long stored = 0;\n    long reused = 0;\n\n    if (exact) {\n      parts = new ArrayList<>();\n      for (String k : keys) parts.add(Idx.blob(idx.get(k)));\n      reused = src.length;\n    } else {\n      keys.clear();\n      parts = Slice.cut(src, g.mask, g.min, g.max);\n      Path hot = Paths.get(\"/app/urnbay/hot\");\n      Files.createDirectories(hot);\n      for (byte[] p : parts) {\n        String kb = Seal.hex(p, g.fp);\n        String kp = Seal.pay(p);\n        String hit = idx.containsKey(kb) ? kb : (idx.containsKey(kp) ? kp : null);\n        if (hit != null) {\n          reused += p.length;\n          keys.add(hit);\n        } else {\n          stored += p.length;\n          String rel = \"hot/\" + kb + \".blob\";\n          Files.write(hot.resolve(kb + \".blob\"), p);\n          Idx.put(kb, rel);\n          idx.put(kb, rel);\n          keys.add(kb);\n        }\n      }\n    }\n\n    Files.createDirectories(mk.getParent());\n    StringBuilder mb = new StringBuilder();\n    for (String k : keys) mb.append(k).append(\"\\n\");\n    Files.writeString(mk, mb.toString());\n    double reuse = src.length == 0 ? 1.0 : reused / (double)src.length;\n    double mean = parts.isEmpty() ? 0.0 : src.length / (double)parts.size();\n    String json = \"{\\n\"\n      + \"  \\\"reel\\\": \\\"\" + name + \"\\\",\\n\"\n      + \"  \\\"bytes_in\\\": \\\"\" + src.length + \"\\\",\\n\"\n      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\n      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\n      + \"  \\\"mean_piece\\\": \\\"\" + String.format(Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\n      + \"  \\\"piece_count\\\": \\\"\" + parts.size() + \"\\\"\\n\"\n      + \"}\\n\";\n    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\n    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\n    Floor.ok(reuse);\n    if (prior && stored == src.length && src.length > 0) return 1;\n    Files.writeString(flag, \"1\\n\");\n    return 0;\n  }\n\n  static boolean matches(byte[] src, Path manifest, Map<String,String> idx,\n                         List<String> keys) throws Exception {\n    int off = 0;\n    for (String line : Files.readAllLines(manifest)) {\n      String key = line.trim();\n      if (key.isEmpty()) continue;\n      String rel = idx.get(key);\n      if (rel == null) return false;\n      byte[] piece = Idx.blob(rel);\n      if (off + piece.length > src.length) return false;\n      for (int i = 0; i < piece.length; i++)\n        if (src[off + i] != piece[i]) return false;\n      off += piece.length;\n      keys.add(key);\n    }\n    return off == src.length;\n  }\n}\nEOF\n"]
