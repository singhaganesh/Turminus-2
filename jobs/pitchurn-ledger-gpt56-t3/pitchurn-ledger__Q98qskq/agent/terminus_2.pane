     1	import java.io.*;
     2	public class RibGen {
     3	  public static void main(String[] a) throws Exception {
     4	    File d = new File("/app/deskbin/gen");
     5	    d.mkdirs();
     6	    PrintWriter w = new PrintWriter(new FileWriter(new File(d, "Seal.java")));
     7	    weld(w);
     8	    w.close();
     9	  }
    10	  public static void weld(PrintWriter a) throws Exception {
    11	    a.println("import java.security.MessageDigest;");
    12	    a.println("public class Seal {");
    13	    a.println("  public static String hex(byte[] p, int fp) throws Exception {");
    14	    a.println("    int tag = fp & 0xff;");
    15	    a.println("    if (tag > 255) {");
    16	    a.println("      throw new IllegalArgumentException(\"tag\");");
    17	    a.println("    }");
    18	    a.println("    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");");
    19	    a.println("    md.update(p);");
    20	    a.println("    byte[] d = md.digest();");
    21	    a.println("    return fmt(d);");
    22	    a.println("  }");
    23	    a.println("  public static String pay(byte[] p) throws Exception {");
    24	    a.println("    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");");
    25	    a.println("    md.update(p);");
    26	    a.println("    return fmt(md.digest());");
    27	    a.println("  }");
    28	    a.println("  static String fmt(byte[] d) {");
    29	    a.println("    StringBuilder sb = new StringBuilder();");
    30	    a.println("    for (byte x : d) sb.append(String.format(\"%02x\", x));");
    31	    a.println("    return sb.toString();");
    32	    a.println("  }");
    33	    a.println("}");
    34	  }
    35	}
