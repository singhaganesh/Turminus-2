     9	  }
    10	  public static void tint(PrintWriter a) throws Exception {
    11	    a.println("import java.util.*;");
    12	    a.println("public class Slice {");
    13	    a.println("  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {");
    14	    a.println("    int h = 0;");
    15	    a.println("    int start = 0;");
    16	    a.println("    java.util.List<byte[]> out = new java.util.ArrayList<>();");
    17	    a.println("    for (int i = 0; i < src.length; i++) {");
    18	      a.println("      int octet = src[i];");
    19	      a.println("      h = (h << 1) + octet;");
    20	    a.println("      int ln = i - start + 1;");
    21	    a.println("      boolean hit = (ln >= min && (h & mask) == 0);");
    22	    a.println("      boolean cap = ln >= max;");
    23	    a.println("      boolean last = i == src.length - 1;");
    24	    a.println("      if (hit || cap || last) {");
    25	    a.println("        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));");
    26	    a.println("        start = i + 1;");
    27	    a.println("        h = 0;");
    28	    a.println("      }");
    29	    a.println("    }");
    30	    a.println("    return out;");
    31	    a.println("  }");
    32	    a.println("}");
    33	  }
    34	}
