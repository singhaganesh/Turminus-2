[?2004l[?2004h>   public static void loom(PrintWriter a) throws Exception {
[?2004l[?2004h>     a.println("import java.nio.file.*;");
[?2004l[?2004h>     a.println("import java.util.*;");
[?2004l[?2004h>     a.println("public class Span {");
[?2004l[?2004h>     a.println("  public static void merge() throws Exception {");
[?2004l[?2004h>     a.println("    Path live = Paths.get(\"/app/urnbay/idx.tsv\");");
[?2004l[?2004h>     a.println("    LinkedHashMap<String,String> all = new LinkedHashMap<>();");
[?2004l[?2004h>     a.println("    Path[] bags = new Path[] { live, Paths.get(\"/app/urnbay/hot/idx.tsv\"), Paths.get(\"/app/urnbay/cold/idx.tsv\"), Paths.get(\"/app/urnbay/keep/idx.tsv\") };");
[?2004l[?2004h>     a.println("    for (Path p : bags) {");
[?2004l[?2004h>     a.println("      if (!Files.exists(p)) continue;");
[?2004l[?2004h>     a.println("      for (String line : Files.readAllLines(p)) {");
[?2004l[?2004h>     a.println("        String[] f = line.trim().split(\"\\\\t\", 2);");
[?2004l[?2004h>     a.println("        if (f.length == 2 && Files.isRegularFile(Paths.get(\"/app/urnbay\").resolve(f[1]))) all.put(f[0], f[1]);");
[?2004l[?2004h>     a.println("      }");
[?2004l[?2004h>     a.println("    }");
[?2004l[?2004h>     a.println("    StringBuilder out = new StringBuilder();");
[?2004l[?2004h>     a.println("    for (Map.Entry<String,String> e : all.entrySet()) out.append(e.getKey()).append('\\t').append(e.getValue()).append('\\n');");
[?2004l[?2004h>     a.println("    Files.writeString(live, out.toString());");
[?2004l[?2004h>     a.println("    System.out.println(\"walked\");");
[?2004l[?2004h>     a.println("  }");
[?2004l[?2004h>     a.println("}");
[?2004l[?2004h>   }
[?2004l[?2004h> }
