import java.nio.file.*;
public class Floor {
  public static boolean ok(double reuse) throws Exception {
    String s = Files.readString(Paths.get("/app/deskfold/MIN.txt")).trim();
    double m = Double.parseDouble(s);
    return reuse + 1e-9 >= m;
  }
}
===== /app/deskbin/gen/Slice.java =====
import java.util.*;
public class Slice {
  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {
    int h = 0;
    int start = 0;
    java.util.List<byte[]> out = new java.util.ArrayList<>();
    for (int i = 0; i < src.length; i++) {
      int octet = src[i];
      h = (h << 1) + octet;
      int ln = i - start + 1;
      boolean hit = (ln >= min && (h & mask) == 0);
      boolean cap = ln >= max;
      boolean last = i == src.length - 1;
      if (hit || cap || last) {
        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));
        start = i + 1;
        h = 0;
      }
    }
    return out;
  }
}
===== /app/deskbin/gen/Span.java =====
import java.nio.file.*;
public class Span {
  public static void merge() throws Exception {
    Path live = Paths.get("/app/urnbay/idx.tsv");
    StringBuilder sb = new StringBuilder();
    Path[] bags = new Path[] {
      live,
      Paths.get("/app/urnbay/hot/idx.tsv"),
      Paths.get("/app/urnbay/cold/idx.tsv"),
      Paths.get("/app/urnbay/keep/idx.tsv")
    };
    for (Path p : bags) {
      if (java.nio.file.Files.exists(p)) sb.append(java.nio.file.Files.readString(p));
    }
    java.nio.file.Files.writeString(live, sb.toString());
    System.out.println("walked");
  }
}
