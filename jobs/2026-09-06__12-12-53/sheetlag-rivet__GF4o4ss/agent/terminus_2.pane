#include "warmup.h"
#include "sheet.h"
#include <stdlib.h>

void warm_maybe(void) {
    const char *e = getenv("RIVET_WARM");
    if (e && e[0] == '1') {
        grab_sheet();
    }
}
#ifndef WARMUP_H
#define WARMUP_H
void warm_maybe(void);
#endif
