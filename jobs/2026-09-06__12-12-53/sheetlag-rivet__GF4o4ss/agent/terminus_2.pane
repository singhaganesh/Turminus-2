     6	
     7	static void emit_one(const char *line) {
     8	    char tmp[1024];
     9	    strncpy(tmp, line, sizeof(tmp) - 1);
    10	    tmp[sizeof(tmp) - 1] = 0;
    11	    char *nl = strchr(tmp, '\n');
    12	    if (nl) *nl = 0;
    13	    char *name = tmp;
    14	    char *p1 = strchr(tmp, '|');
    15	    if (!p1) return;
    16	    *p1 = 0;
    17	    char *p2 = strchr(p1 + 1, '|');
    18	    if (!p2) return;
    19	    char *spec = p2 + 1;
    20	    char outp[512];
    21	    snprintf(outp, sizeof(outp), "/app/rivetbay/emitters/%s.kdec", name);
    22	    FILE *o = fopen(outp, "w");
    23	    if (!o) return;
    24	    fprintf(o, "KDEC1\nNAME %s\n", name);
    25	    char *parts[32];
    26	    int nf = 0;
    27	    char spec_copy[512];
    28	    strncpy(spec_copy, spec, sizeof(spec_copy) - 1);
    29	    spec_copy[sizeof(spec_copy) - 1] = 0;
    30	    char *tok = strtok(spec_copy, ",");
    31	    while (tok && nf < 32) {
    32	        parts[nf++] = tok;
    33	        tok = strtok(NULL, ",");
    34	    }
    35	    for (int i = nf - 1; i >= 0; i--) {
    36	        char fn[64], k[16];
    37	        if (sscanf(parts[i], "%63[^:]:%15s", fn, k) == 2)
    38	            fprintf(o, "%s %s\n", fn, k);
    39	    }
    40	    fclose(o);
    41	}
    42	
    43	void emit_all(void) {
    44	    const char *blob = sheet_view();
    45	    int cap = sheet_emit_cap();
    46	    char buf[65536];
    47	    strncpy(buf, blob, sizeof(buf) - 1);
    48	    buf[sizeof(buf) - 1] = 0;
    49	    char *save = NULL;
    50	    char *line = strtok_r(buf, "\n", &save);
    51	    int idx = 0;
    52	    while (line) {
    53	        if (idx >= cap) break;
    54	        if (line[0]) emit_one(line);
    55	        idx++;
    56	        line = strtok_r(NULL, "\n", &save);
    57	    }
    58	}
