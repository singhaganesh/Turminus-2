[22.518089, "o", "===== notes =====\r\n"]
[22.518351, "o", "--- notes/forms.txt\r\n"]
[22.52114, "o", "Event descriptions use NAME then FIELD lines. Ledger is name|relpath|field:kind,... .\r\nKDEC files start with KDEC1. Decode JSON uses kind decoded or unknown.\r\nDecode fields object keys are the FIELD names from that description (for example latch, force, amp, bit, thick, mm, q, n, w).\r\n--- notes/layout.txt\r\n"]
[22.522815, "o", "evd holds descriptions. intake/current.ledger is the mill roster. emitters hold kdec tables.\r\nframes hold packed samples. forgekit is the C pipeline.\r\n"]
[22.523399, "o", "--- notes/ops.txt\r\n"]
[22.524869, "o", "After adding a description, mill may leave decode unknown even though discovery refreshed the on-disk ledger.\r\nUnknown decode is normal for frames that have no description on this bench.\r\n"]
[22.525076, "o", "===== make raw =====\r\n"]
[22.526399, "o", "CC ?= gcc$\r\nCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore$\r\nSRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)$\r\nBIN := /app/bin/rivetbay$\r\n$\r\n.PHONY: hull$\r\nhull:$\r\n\\tmkdir -p /app/bin$\r\n\\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)$\r\n"]
[22.526723, "o", "\u001b[?2004hroot@27367c0f9fba:/app/rivetbay# "]
[22.737967, "i", "cd /app/rivetbay; grep -R \"grab_sheet\\|prime_intake\\|pour_sheet\\|emit_all\\|count_gap\\|discover_all\" -n . /app/millscore 2>/dev/null\n"]
[22.738578, "o", "cd /app/rivetbay; grep -R \"grab_sheet\\|prime_intake\\|pour_sheet\\|emit_all\\|count_gap\\|discover_all\" -n . /app/millscore 2>/dev/null\r\n\u001b[?2004l\r"]
