[103.160777, "i", "cd /app/rivetbay; python3 - <<'PY'\np='forgekit/driver.c'\ns=open(p).read()\ns=s.replace('#include <stdio.h>\\n#include <string.h>\\n', '#include <dirent.h>\\n#include <stdio.h>\\n#include <string.h>\\n')\nneedle='static void note_mill_pass(void) {'\nhelper='''static int count_suffix(const char *dirpath, const char *suffix) {\n    DIR *d = opendir(dirpath);\n    if (!d) return -1;\n    int n = 0;\n    size_t slen = strlen(suffix);\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len > slen && strcmp(ent->d_name + len - slen, suffix) == 0) n++;\n    }\n    closedir(d);\n    return n;\n}\n\n'''\ns=s.replace(needle, helper+needle)\ns=s.replace('''        emit_all();\n        return count_gap();\n''', '''        emit_all();\n        int descriptions = count_suffix(\"/app/rivetbay/evd\", \".evd\");\n        int decoders = count_suffix(\"/app/rivetbay/emitters\", \".kdec\");\n        if (descriptions < 0 || decoders < descriptions) return 1;\n        return count_gap();\n''')\nopen(p,'w').write(s)\nPY\nmake hull && /app/bin/rivetbay mill; rc=$?; printf 'final_rc=%d descriptions=%s emitters=%s ledger=%s\\n' \"$rc\" \"$(find evd -maxdepth 1 -name '*.evd' | wc -l)\" \"$(find emitters -maxdepth 1 -name '*.kdec' | wc -l)\" \"$(wc -l < intake/current.ledger)\"\n"]
