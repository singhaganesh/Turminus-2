[61.458073, "o", "\u001b[?2004h> "]
[61.458161, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.458261, "o", "static int count_nonempty_lines(const char *blob) {\r\n\u001b[?2004l\r"]
[61.458339, "o", "\u001b[?2004h> "]
[61.458456, "o", "    int n = 0, nonempty = 0;\r\n\u001b[?2004l\r"]
[61.458543, "o", "\u001b[?2004h> "]
[61.458697, "o", "    for (const char *s = blob; *s; s++) {\r\n\u001b[?2004l\r"]
[61.458777, "o", "\u001b[?2004h> "]
[61.458856, "o", "        if (*s == '\\n') {\r\n\u001b[?2004l\r"]
[61.458939, "o", "\u001b[?2004h> "]
[61.459037, "o", "            if (nonempty) n++;\r\n\u001b[?2004l\r"]
[61.459123, "o", "\u001b[?2004h> "]
[61.459228, "o", "            nonempty = 0;\r\n\u001b[?2004l\r"]
[61.459304, "o", "\u001b[?2004h> "]
[61.459508, "o", "        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n\u001b[?2004l\r"]
[61.459591, "o", "\u001b[?2004h> "]
[61.459696, "o", "            nonempty = 1;\r\n\u001b[?2004l\r"]
[61.459764, "o", "\u001b[?2004h> "]
[61.459869, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.459949, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.460059, "o", "    return n + nonempty;\r\n\u001b[?2004l\r"]
[61.460148, "o", "\u001b[?2004h"]
