[61.443779, "o", "> "]
[61.444135, "o", "    struct dirent *ent;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.444444, "o", "    while ((ent = readdir(dir)) != NULL && ndesc < MAX_DESC) {\r\n\u001b[?2004l\r\u001b[?2004h>         size_t len = strlen(ent->d_name);\r\n\u001b[?2004l\r\u001b[?2004h> "]
