[61.436867, "i", "cd /app/rivetbay && cat > forgekit/discover.c <<'EOF'\n#include \"discover.h\"\n#include \"parse_evd.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#define MAX_DESC 512\n\nstruct desc {\n    char name[128];\n    char fname[256];\n    char fields[512];\n    int written;\n};\n\nstatic int by_fname(const void *a, const void *b) {\n    const struct desc *da = a;\n    const struct desc *db = b;\n    return strcmp(da->fname, db->fname);\n}\n\nstatic int find_name(struct desc *descs, int n, const char *name) {\n    for (int i = 0; i < n; i++)\n        if (strcmp(descs[i].name, name) == 0) return i;\n    return -1;\n}\n\nstatic void write_row(FILE *out, struct desc *d) {\n    fprintf(out, \"%s|evd/%s|%s\\n\", d->name, d->fname, d->fields);\n    d->written = 1;\n}\n\nvoid discover_all(void) {\n    struct desc descs[MAX_DESC];\n    int ndesc = 0;\n    DIR *dir = opendir(\"/app/rivetbay/evd\");\n    if (!dir) return;\n\n    struct dirent *ent;\n    while ((ent = readdir(dir)) != NULL && ndesc < MAX_DESC) {\n        size_t len = strlen(ent->d_name);\n        if (len < 5 || strcmp(ent->d_name + len - 4, \".evd\") != 0) continue;\n\n        char path[512];\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\n        struct desc d;\n        memset(&d, 0, sizeof(d));\n        if (parse_evd_file(path, d.name, d.fields, sizeof(d.fields)) != 0) continue;\n        if (find_name(descs, ndesc, d.name) >= 0) continue;\n        strncpy(d.fname, ent->d_name, sizeof(d.fname) - 1);\n        descs[ndesc++] = d;\n    }\n    closedir(dir);\n    qsort(descs, (size_t)ndesc, sizeof(descs[0]), by_fname);\n\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger.tmp\", \"w\");\n    if (!out) return;\n\n    FILE *prior = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\n    if (prior) {\n        char line[1024];\n        while (fgets(line, sizeof(line), prior)) {\n            char *bar = strchr(line, '|');\n            if (!bar) continue;\n            *bar = 0;\n            char *name = line;\n            while (*name == ' ' || *name == '\\t') name++;\n            int i = find_name(descs, ndesc, name);\n            if (i >= 0 && !descs[i].written) write_row(out, &descs[i]);\n        }\n        fclose(prior);\n    }\n    for (int i = 0; i < ndesc; i++)\n        if (!descs[i].written) write_row(out, &descs[i]);\n\n    if (fclose(out) != 0 || rename(\"/app/rivetbay/intake/current.ledger.tmp\",\n                                   \"/app/rivetbay/intake/current.ledger\") != 0)\n        remove(\"/app/rivetbay/intake/current.ledger.tmp\");\n}\nEOF\n\ncat > forgekit/snapshot.c <<'EOF'\n#include \"sheet.h\"\n#include <stdio.h>\n\nstatic char g_emit[65536];\nstatic int g_emit_cap;\n\nstatic int count_nonempty_lines(const char *blob) {\n    int n = 0, nonempty = 0;\n    for (const char *s = blob; *s; s++) {\n        if (*s == '\\n') {\n            if (nonempty) n++;\n            nonempty = 0;\n        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\n            nonempty = 1;\n        }\n    }\n    return n + nonempty;\n}\n\nstatic void load_file(const char *path) {\n    FILE *f = fopen(path, \"r\");\n    g_emit[0] = 0;\n    if (!f) {\n        g_emit_cap = 0;\n        return;\n    }\n    size_t n = fread(g_emit, 1, sizeof(g_emit) - 1, f);\n    g_emit[n] = 0;\n    fclose(f);\n    g_emit_cap = count_nonempty_lines(g_emit);\n}\n\nvoid prime_intake_sheet(void) {\n    g_emit[0] = 0;\n    g_emit_cap = 0;\n}\n\nvoid grab_sheet(void) {\n    load_file(\"/app/rivetbay/intake/current.ledger\");\n}\n\nvoid pour_sheet(void) {\n    load_file(\"/app/rivetbay/intake/current.ledger\");\n}\n\nconst char *sheet_view(void) {\n    return g_emit;\n}\n\nint sheet_emit_cap(void) {\n    return g_emit_cap;\n}\nEOF\n\ncat > forgekit/emit.c <<'EOF'\n#include \"emit.h\"\n#include \"sheet.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic void clear_emitters(void) {\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\n    if (!d) return;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len > 5 && strcmp(ent->d_name + len - 5, \".kdec\") == 0) {\n            char path[512];\n            snprin"]
[61.436958, "i", "tf(path, sizeof(path), \"/app/rivetbay/emitters/%s\", ent->d_name);\n            unlink(path);\n        }\n    }\n    closedir(d);\n}\n\nstatic void emit_one(const char *line) {\n    char tmp[1024];\n    strncpy(tmp, line, sizeof(tmp) - 1);\n    tmp[sizeof(tmp) - 1] = 0;\n\n    char *name = tmp;\n    char *p1 = strchr(tmp, '|');\n    if (!p1) return;\n    *p1 = 0;\n    char *p2 = strchr(p1 + 1, '|');\n    if (!p2) return;\n    *p2 = 0;\n    char *spec = p2 + 1;\n\n    char outp[512];\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\n    FILE *out = fopen(outp, \"w\");\n    if (!out) return;\n    fprintf(out, \"KDEC1\\nNAME %s\\n\", name);\n\n    char *save = NULL;\n    for (char *field = strtok_r(spec, \",\", &save); field;\n         field = strtok_r(NULL, \",\", &save)) {\n        char fn[64], kind[16];\n        if (sscanf(field, \"%63[^:]:%15s\", fn, kind) == 2)\n            fprintf(out, \"%s %s\\n\", fn, kind);\n    }\n    fclose(out);\n}\n\nvoid emit_all(void) {\n    clear_emitters();\n    char buf[65536];\n    strncpy(buf, sheet_view(), sizeof(buf) - 1);\n    buf[sizeof(buf) - 1] = 0;\n    char *save = NULL;\n    for (char *line = strtok_r(buf, \"\\n\", &save); line;\n         line = strtok_r(NULL, \"\\n\", &save))\n        if (*line) emit_one(line);\n}\nEOF\nmake hull\n"]
