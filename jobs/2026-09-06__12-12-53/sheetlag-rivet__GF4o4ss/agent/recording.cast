[22.741386, "o", "./forgekit/driver.c:24:        pour_sheet();\r\n./forgekit/driver.c:25:        emit_all();\r\n./forgekit/driver.c:26:        return count_gap();\r\n"]
[22.741405, "o", "./forgekit/snapshot.c:33:void prime_intake_sheet(void) {\r\n"]
[22.741607, "o", "./forgekit/snapshot.c:39:void grab_sheet(void) {\r\n./forgekit/snapshot.c:43:void pour_sheet(void) {\r\n./forgekit/sheet.h:3:void prime_intake_sheet(void);\r\n./forgekit/sheet.h:4:void grab_sheet(void);\r\n./forgekit/sheet.h:5:void pour_sheet(void);\r\n./forgekit/warmup.c:8:        grab_sheet();\r\n./forgekit/discover.c:43:void discover_all(void) {\r\n"]
