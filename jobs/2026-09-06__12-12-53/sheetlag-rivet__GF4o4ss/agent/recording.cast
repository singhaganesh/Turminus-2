[21.802864, "o", "===== forgekit/discover.c =====\r\n"]
[21.806034, "o", "     1\t#include \"discover.h\"\r\n     2\t#include \"parse_evd.h\"\r\n     3\t#include <dirent.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic int stem_seen(const char *stem, char stems[][128], int n) {\r\n     8\t    for (int i = 0; i < n; i++)\r\n     9\t        if (strcmp(stems[i], stem) == 0) return 1;\r\n    10\t    return 0;\r\n    11\t}\r\n    12\t\r\n    13\tstatic int load_prior_stems(char stems[][128], int cap) {\r\n    14\t    int n = 0;\r\n    15\t    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    16\t    char line[1024];\r\n    17\t    if (!f) return 0;\r\n    18\t    while (n < cap && fgets(line, sizeof(line), f)) {"]
[21.806081, "o", "\r\n    19\t        char *bar = strchr(line, '|');\r\n    20\t        if (!bar) continue;\r\n    21\t        *bar = 0;\r\n    22\t        char *s = line;\r\n    23\t        while (*s == ' ' || *s == '\\t') s++;\r\n    24\t        if (*s == 0) continue;\r\n    25\t        strncpy(stems[n], s, 127);\r\n    26\t        stems[n][127] = 0;\r\n    27\t        n++;\r\n    28\t    }\r\n    29\t    fclose(f);\r\n    30\t    return n;\r\n    31\t}\r\n    32\t\r\n    33\tstatic int emit_row(FILE *out, const char *fname) {\r\n    34\t    char path[512];\r\n"]
[21.806097, "o", "    35\t    snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", fname);\r\n    36\t    char name[128];\r\n    37\t    char fields[512];\r\n    38\t    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n    39\t    fprintf(out, \"%s|evd/%s|%s\\n\", name, fname, fields);\r\n    40\t    return 1;\r\n    41\t}\r\n"]
[21.806111, "o", "    42\t\r\n    43\tvoid discover_all(void) {\r\n    44\t    char prior[64][128];\r\n    45\t    char pending[64][256];\r\n"]
[21.806125, "o", "    46\t    int nprior = load_prior_stems(prior, 64);\r\n    47\t    int npend = 0;\r\n    48\t    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    49\t    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n"]
[21.80615, "o", "    50\t    if (!d || !out) {\r\n    51\t        if (d) closedir(d);\r\n    52\t        if (out) fclose(out);\r\n    53\t        return;\r\n    54\t    }\r\n    55\t    struct dirent *ent;\r\n    56\t    while ((ent = readdir(d)) != NULL) {\r\n    57\t        size_t L = strlen(ent->d_name);\r\n    58\t"]
[21.806171, "o", "        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n    59\t        char name[128];\r\n    60\t        char fields[512];\r\n    61\t        char path[512];\r\n    62\t        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n    63\t        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n    64\t        if (stem_seen(name, prior, nprior)) continue;\r\n"]
[21.806476, "o", "    65\t        if (npend < 64) {\r\n    66\t            strncpy(pending[npend], ent->d_name, 255);\r\n    67\t            pending[npend][255] = 0;\r\n    68\t            npend++;\r\n    69\t        }\r\n    70\t    }\r\n    71\t    for (int i = 0; i < nprior; i++) {\r\n    72\t        char want[256];\r\n    73\t        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n    74\t        emit_row(out, want);\r\n    75\t    }\r\n    76\t    for (int i = 0; i < npend; i++)\r\n    77\t        emit_row(out, pending[i]);\r\n    78\t    fclose(out);\r\n    79\t    closedir(d);\r\n    80\t}\r\n"]
[21.807135, "o", "===== forgekit/snapshot.c =====\r\n"]
[21.808588, "o", "     1\t#include \"sheet.h\"\r\n     2\t#include <stdio.h>\r\n     3\t#include <string.h>\r\n     4\t\r\n     5\tstatic char g_primed[65536];\r\n     6\tstatic char g_emit[65536];\r\n     7\tstatic int g_emit_cap;\r\n     8\t\r\n     9\tstatic int count_nonempty_lines(const char *blob) {\r\n    10\t    int n = 0;\r\n    11\t    int nonempty = 0;\r\n    12\t    for (const char *s = blob; *s; s++) {\r\n    13\t        if (*s == '\\n') {\r\n    14\t            if (nonempty) n++;\r\n    15\t            nonempty = 0;\r\n    16\t        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n    17\t            nonempty = 1;\r\n    18\t        }\r\n    19\t    }\r\n    20\t    if (nonempty) n++;\r\n    21\t    return n;\r\n    22\t}\r\n    23\t\r\n    24\tstatic void load_mill_open_into(char *dst, size_t cap) {\r\n    25\t    FILE *f = fopen(\"/app/rivetbay/intake/mill_open\", \"r\");\r\n    26\t    dst[0] = 0;\r\n    27\t    if (!f) return;\r\n    28\t    size_t n = fread(dst, 1, cap - 1, f);\r\n    29\t    dst[n] = 0;\r\n    30\t    fclose(f);\r\n    31\t}\r\n    32\t\r\n    33\tvoid prime_intake_sheet(void) {\r\n    34\t    load_mill_open_into(g_primed, sizeof(g_primed));\r\n    35\t    g_emit_cap = count_nonempty_lines(g_primed);\r\n    36\t    g_emit[0] = 0;\r\n    37\t}\r\n    38\t\r\n    39\tvoid grab_sheet(void) {\r\n    40\t    load_mill_open_into(g_primed, sizeof(g_primed));\r\n    41\t}\r\n    42\t\r\n    43\tvoid pour_sheet(void) {\r\n    44\t    char buf[65536];\r\n    45\t    char out[65536];\r\n    46\t    strncpy(buf, g_primed, sizeof(buf) - 1);\r\n    47\t    buf[sizeof(buf) - 1] = 0;\r\n    48\t    size_t w = 0;\r\n    49\t    char *save = NULL;\r\n    50\t    char *line = strtok_r(buf, \"\\n\", &save);\r\n    51\t    while (line) {\r\n    52\t        while (*line == ' ' || *line == '\\t') line++;\r\n    53\t        if (*line == 0) {\r\n    54\t            line = strtok_r(NULL, \"\\n\", &save);\r\n    55\t            continue;\r\n    56\t        }\r\n    57\t        size_t L = strlen(line);\r\n    58\t        if (w + L + 1 >= sizeof(out)) break;\r\n    59\t        memcpy(out + w, line, L);\r\n    60\t        w += L;\r\n    61\t        out[w++] = '\\n';\r\n    62\t        line = strtok_r(NULL, \"\\n\", &save);\r\n    63\t    }\r\n    64\t    out[w] = 0;\r\n    65\t    memcpy(g_emit, out, w + 1);\r\n    66\t}\r\n    67\t\r\n    68\tconst char *sheet_view(void) {\r\n    69\t    return g_emit;\r\n    70\t}\r\n    71\t\r\n    72\tint sheet_emit_cap(void) {\r\n    73\t    return g_emit_cap;\r\n    74\t}\r\n"]
[21.808975, "o", "===== forgekit/emit.c =====\r\n"]
[21.81025, "o", "     1\t#include \"emit.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic void emit_one(const char *line) {\r\n     8\t    char tmp[1024];\r\n     9\t    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    10\t    tmp[sizeof(tmp) - 1] = 0;\r\n    11\t    char *nl = strchr(tmp, '\\n');\r\n    12\t    if (nl) *nl = 0;\r\n    13\t    char *name = tmp;\r\n    14\t    char *p1 = strchr(tmp, '|');\r\n    15\t    if (!p1) return;\r\n    16\t    *p1 = 0;\r\n    17\t    char *p2 = strchr(p1 + 1, '|');\r\n    18\t    if (!p2) return;\r\n    19\t    char *spec = p2 + 1;\r\n    20\t    char outp[512];\r\n    21\t    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    22\t    FILE *o = fopen(outp, \"w\");\r\n    23\t    if (!o) return;\r\n    24\t    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    25\t    char *parts[32];\r\n    26\t    int nf = 0;\r\n    27\t    char spec_copy[512];\r\n    28\t    strncpy(spec_copy, spec, sizeof(spec_copy) - 1);\r\n"]
[21.810375, "o", "    29\t    spec_copy[sizeof(spec_copy) - 1] = 0;\r\n    30\t    char *tok = strtok(spec_copy, \",\");\r\n    31\t    while (tok && nf < 32) {\r\n    32\t        parts[nf++] = tok;\r\n    33\t        tok = strtok(NULL, \",\");\r\n    34\t    }\r\n    35\t    for (int i = nf - 1; i >= 0; i--) {\r\n    36\t        char fn[64], k[16];\r\n    37\t        if (sscanf(parts[i], \"%63[^:]:%15s\", fn, k) == 2)\r\n    38\t            fprintf(o, \"%s %s\\n\", fn, k);\r\n    39\t    }\r\n    40\t    fclose(o);\r\n    41\t}\r\n"]
[21.810407, "o", "    42\t\r\n    43\tvoid emit_all(void) {\r\n    44\t    const char *blob = sheet_view();\r\n    45\t    int cap = sheet_emit_cap();\r\n    46\t    char buf[65536];\r\n    47\t    strncpy(buf, blob, sizeof(buf) - 1);\r\n    48\t    buf[sizeof(buf) - 1] = 0;\r\n    49\t    char *save = NULL;\r\n    50\t    char *line = strtok_r(buf, \"\\n\", &save);\r\n    51\t    int idx = 0;\r\n    52\t    while (line) {\r\n    53\t        if (idx >= cap) break;\r\n    54\t        if (line[0]) emit_one(line);\r\n    55\t        idx++;\r\n    56\t        line = strtok_r(NULL, \"\\n\", &save);\r\n    57\t    }\r\n    58\t}\r\n"]
[21.811294, "o", "===== forgekit/parse_evd.c =====\r\n"]
[21.813789, "o", "     1\t#include \"parse_evd.h\"\r\n     2\t#include <stdio.h>\r\n     3\t#include <string.h>\r\n     4\t\r\n     5\tint parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {\r\n     6\t    FILE *f = fopen(path, \"r\");\r\n     7\t    if (!f) return -1;\r\n     8\t    name[0] = 0;\r\n     9\t    fields[0] = 0;\r\n    10\t    char line[256];\r\n    11\t    int first = 1;\r\n    12\t    while (fgets(line, sizeof(line), f)) {\r\n    13\t        if (strncmp(line, \"NAME \", 5) == 0) {\r\n    14\t            sscanf(line + 5, \"%127s\", name);\r\n    15\t        } else if (strncmp(line, \"FIELD \", 6) == 0) {\r\n    16\t            char fn[64], k[16];\r\n    17\t            if (sscanf(line + 6, \"%63s %15s\", fn, k) == 2) {\r\n    18\t                if (!first) strncat(fields, \",\", fields_sz - (int)strlen(fields) - 1);\r\n    19\t                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);\r\n    20\t                strncat(fields, \":\", fields_sz - (int)strlen(fields) - 1);\r\n    21\t                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);\r\n    22\t                first = 0;\r\n    23\t            }\r\n    24\t        }\r\n    25\t    }\r\n    26\t    fclose(f);\r\n    27\t    return name[0] ? 0 : -1;\r\n    28\t}\r\n"]
[21.814146, "o", "===== forgekit/sheet.h =====\r\n"]
[21.815587, "o", "     1\t#ifndef SHEET_H\r\n     2\t#define SHEET_H\r\n     3\tvoid prime_intake_sheet(void);\r\n     4\tvoid grab_sheet(void);\r\n     5\tvoid pour_sheet(void);\r\n     6\tconst char *sheet_view(void);\r\n     7\tint sheet_emit_cap(void);\r\n     8\t#endif\r\n"]
[21.815988, "o", "===== forgekit/emit.h =====\r\n"]
[21.817311, "o", "     1\t#ifndef EMIT_H\r\n     2\t#define EMIT_H\r\n     3\tvoid emit_all(void);\r\n     4\t#endif\r\n"]
[21.81751, "o", "===== forgekit/discover.h =====\r\n"]
[21.818873, "o", "     1\t#ifndef DISCOVER_H\r\n     2\t#define DISCOVER_H\r\n     3\tvoid discover_all(void);\r\n     4\t#endif\r\n"]
[21.819193, "o", "===== forgekit/parse_evd.h =====\r\n"]
[21.820384, "o", "     1\t#ifndef PARSE_EVD_H\r\n     2\t#define PARSE_EVD_H\r\n     3\tint parse_evd_file(const char *path, char *name, char *fields, int fields_sz);\r\n     4\t#endif\r\n"]
