[12.13051, "o", "#ifndef DISCOVER_H\r\n#define DISCOVER_H\r\nvoid discover_all(void);\r\n#endif\r\n"]
[12.130887, "o", "/app/rivetbay/forgekit/driver.c\r\n"]
[12.13178, "o", "--- /app/rivetbay/forgekit/driver.c\r\n"]
[12.133394, "o", "#include \"discover.h\"\r\n#include \"sheet.h\"\r\n#include \"emit.h\"\r\n#include \"tally.h\"\r\n#include \"decode.h\"\r\n#include \"warmup.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic void note_mill_pass(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    if (!f) return;\r\n    fputc('1', f);\r\n    fputc('\\n', f);\r\n    fclose(f);\r\n"]
[12.133559, "o", "}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n        note_mill_pass();\r\n        warm_maybe();\r\n        prime_intake_sheet();\r\n        discover_all();\r\n        pour_sheet();\r\n        emit_all();\r\n        return count_gap();\r\n    }\r\n    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n        return decode_frame(argv[2]);\r\n    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    return 2;\r\n}\r\n"]
[12.134187, "o", "/app/rivetbay/forgekit/snapshot.c\r\n"]
[12.139242, "o", "--- /app/rivetbay/forgekit/snapshot.c\r\n"]
[12.140139, "o", "#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic char g_primed[65536];\r\nstatic char g_emit[65536];\r\nstatic int g_emit_cap;\r\n\r\nstatic int count_nonempty_lines(const char *blob) {\r\n    int n = 0;\r\n    int nonempty = 0;\r\n    for (const char *s = blob; *s; s++) {\r\n        if (*s == '\\n') {\r\n            if (nonempty) n++;\r\n            nonempty = 0;\r\n        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n            nonempty = 1;\r\n        }\r\n    }\r\n    if (nonempty) n++;\r\n    return n;\r\n}\r\n\r\nstatic void load_mill_open_into(char *dst, size_t cap) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/mill_open\", \"r\");\r\n    dst[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(dst, 1, cap - 1, f);\r\n    dst[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid prime_intake_sheet(void) {\r\n    load_mill_open_into(g_primed, sizeof(g_primed));\r\n    g_emit_cap = count_nonempty_lines(g_primed);\r\n    g_emit[0] = 0;\r\n}\r\n\r\nvoid grab_sheet(void) {\r\n    load_mill_open_into(g_primed, sizeof(g_primed));\r\n}\r\n\r\nvoid pour_sheet(void) {\r\n    char buf[65536];\r\n    char out[65536];\r\n    strncpy(buf, g_primed, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    size_t w = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        while (*line == ' ' || *line == '\\t') line++;\r\n        if (*line == 0) {\r\n            line = strtok_r(NULL, \"\\n\", &save);\r\n            continue;\r\n        }\r\n        size_t L = strlen(line);\r\n        if (w + L + 1 >= sizeof(out)) break;\r\n        memcpy(out + w, line, L);\r\n        w += L;\r\n        out[w++] = '\\n';\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n    out[w] = 0;\r\n    memcpy(g_emit, out, w + 1);\r\n}\r\n\r\nconst char *sheet_view(void) {\r\n    return g_emit;\r\n}\r\n\r\nint sheet_emit_cap(void) {\r\n    return g_emit_cap;\r\n}\r\n"]
[12.141613, "o", "/app/rivetbay/forgekit/sheet.h\r\n"]
[12.142774, "o", "--- /app/rivetbay/forgekit/sheet.h\r\n"]
[12.144356, "o", "#ifndef SHEET_H\r\n#define SHEET_H\r\nvoid prime_intake_sheet(void);\r\nvoid grab_sheet(void);\r\nvoid pour_sheet(void);\r\nconst char *sheet_view(void);\r\nint sheet_emit_cap(void);\r\n#endif\r\n"]
[12.1448, "o", "/app/rivetbay/forgekit/utf_tidy.h\r\n"]
[12.14581, "o", "--- /app/rivetbay/forgekit/utf_tidy.h\r\n"]
[12.146882, "o", "#ifndef UTF_TIDY_H\r\n#define UTF_TIDY_H\r\nvoid tidy_copy(const char *src, char *dst, int n);\r\n#endif\r\n"]
[12.147332, "o", "/app/rivetbay/forgekit/warmup.c\r\n"]
[12.148077, "o", "--- /app/rivetbay/forgekit/warmup.c\r\n"]
[12.149452, "o", "#include \"warmup.h\"\r\n#include \"sheet.h\"\r\n#include <stdlib.h>\r\n\r\nvoid warm_maybe(void) {\r\n    const char *e = getenv(\"RIVET_WARM\");\r\n    if (e && e[0] == '1') {\r\n        grab_sheet();\r\n    }\r\n}\r\n"]
[12.14981, "o", "/app/rivetbay/forgekit/discover.c\r\n"]
[12.151476, "o", "--- /app/rivetbay/forgekit/discover.c\r\n"]
[12.154588, "o", "#include \"discover.h\"\r\n#include \"parse_evd.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int stem_seen(const char *stem, char stems[][128], int n) {\r\n    for (int i = 0; i < n; i++)\r\n        if (strcmp(stems[i], stem) == 0) return 1;\r\n    return 0;\r\n}\r\n\r\nstatic int load_prior_stems(char stems[][128], int cap) {\r\n    int n = 0;\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    char line[1024];\r\n    if (!f) return 0;\r\n    while (n < cap && fgets(line, sizeof(line), f)) {\r\n        char *bar = strchr(line, '|');\r\n        if (!bar) continue;\r\n        *bar = 0;\r\n        char *s = line;\r\n        while (*s == ' ' || *s == '\\t') s++;\r\n        if (*s == 0) continue;\r\n        strncpy(stems[n], s, 127);\r\n        stems[n][127] = 0;\r\n        n++;\r\n    }\r\n"]
[12.154644, "o", "    fclose(f);\r\n    return n;\r\n}\r\n\r\nstatic int emit_row(FILE *out, const char *fname) {\r\n    char path[512];\r\n    snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", fname);\r\n    char name[128];\r\n    char fields[512];\r\n    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n    fprintf(out, \"%s|evd/%s|%s\\n\", name, fname, fields);\r\n    return 1;\r\n}\r\n\r\nvoid discover_all(void) {\r\n    char prior[64][128];\r\n    char pending[64][256];\r\n    int nprior = load_prior_stems(prior, 64);\r\n    int npend = 0;\r\n    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    if (!d || !out) {\r\n        if (d) closedir(d);\r\n        if (out) fclose(out);\r\n        return;\r\n    }\r\n    struct dirent *ent;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n        char name[128];\r\n        char fields[512];\r\n        char path[512];\r\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n        if (stem_seen(name, prior, nprior)) continue;\r\n        if (npend < 64) {\r\n            strncpy(pending[npend], ent->d_name, 255);\r\n            pending[npend][255] = 0;\r\n            npend++;\r\n        }\r\n    }\r\n    for (int i = 0; i < nprior; i++) {\r\n        char want[256];\r\n        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n        emit_row(out, want);\r\n    }\r\n    for (int i = 0; i < npend; i++)\r\n        emit_row(out, pending[i]);"]
[12.154662, "o", "\r\n    fclose(out);\r\n    closedir(d);\r\n}\r\n"]
[12.155579, "o", "/app/rivetbay/forgekit/emit.c\r\n"]
[12.156295, "o", "--- /app/rivetbay/forgekit/emit.c\r\n"]
[12.157852, "o", "#include \"emit.h\"\r\n#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void emit_one(const char *line) {\r\n    char tmp[1024];\r\n    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    tmp[sizeof(tmp) - 1] = 0;\r\n    char *nl = strchr(tmp, '\\n');\r\n    if (nl) *nl = 0;\r\n    char *name = tmp;\r\n    char *p1 = strchr(tmp, '|');\r\n    if (!p1) return;\r\n    *p1 = 0;\r\n    char *p2 = strchr(p1 + 1, '|');\r\n    if (!p2) return;\r\n    char *spec = p2 + 1;\r\n    char outp[512];\r\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *o = fopen(outp, \"w\");\r\n    if (!o) return;\r\n    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    char *parts[32];\r\n    int nf = 0;\r\n    char spec_copy[512];\r\n    strncpy(spec_copy, spec, sizeof(spec_copy) - 1);\r\n    spec_copy[sizeof(spec_copy) - 1] = 0;\r\n    char *tok = strtok(spec_copy, \",\");\r\n"]
[12.158255, "o", "    while (tok && nf < 32) {\r\n        parts[nf++] = tok;\r\n        tok = strtok(NULL, \",\");\r\n    }\r\n    for (int i = nf - 1; i >= 0; i--) {\r\n        char fn[64], k[16];\r\n        if (sscanf(parts[i], \"%63[^:]:%15s\", fn, k) == 2)\r\n            fprintf(o, \"%s %s\\n\", fn, k);\r\n    }\r\n    fclose(o);\r\n}\r\n\r\nvoid emit_all(void) {\r\n    const char *blob = sheet_view();\r\n    int cap = sheet_emit_cap();\r\n    char buf[65536];\r\n    strncpy(buf, blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    int idx = 0;\r\n    while (line) {\r\n        if (idx >= cap) break;\r\n        if (line[0]) emit_one(line);\r\n        idx++;\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n}\r\n"]
[12.158585, "o", "/app/rivetbay/forgekit/warmup.h\r\n"]
[12.159755, "o", "--- /app/rivetbay/forgekit/warmup.h\r\n"]
[12.161113, "o", "#ifndef WARMUP_H\r\n#define WARMUP_H\r\nvoid warm_maybe(void);\r\n#endif\r\n"]
[12.161494, "o", "/app/rivetbay/forgekit/emit.h\r\n"]
[12.162586, "o", "--- /app/rivetbay/forgekit/emit.h\r\n"]
[12.163952, "o", "#ifndef EMIT_H\r\n#define EMIT_H\r\nvoid emit_all(void);\r\n#endif\r\n"]
[12.164423, "o", "/app/rivetbay/forgekit/decode.h\r\n"]
[12.165406, "o", "--- /app/rivetbay/forgekit/decode.h\r\n"]
[12.167085, "o", "#ifndef DECODE_H\r\n#define DECODE_H\r\nint decode_frame(const char *path);\r\n#endif\r\n"]
[12.16761, "o", "/app/rivetbay/forgekit/parse_evd.c\r\n"]
[12.168682, "o", "--- /app/rivetbay/forgekit/parse_evd.c\r\n"]
[12.172056, "o", "#include \"parse_evd.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return -1;\r\n    name[0] = 0;\r\n    fields[0] = 0;\r\n    char line[256];\r\n    int first = 1;\r\n    while (fgets(line, sizeof(line), f)) {\r\n        if (strncmp(line, \"NAME \", 5) == 0) {\r\n            sscanf(line + 5, \"%127s\", name);\r\n        } else if (strncmp(line, \"FIELD \", 6) == 0) {\r\n            char fn[64], k[16];\r\n            if (sscanf(line + 6, \"%63s %15s\", fn, k) == 2) {\r\n                if (!first) strncat(fields, \",\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, \":\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);\r\n                first = 0;\r\n            }\r\n        }\r\n    }\r\n    fclose(f);\r\n    return name[0] ? 0 : -1;\r\n}\r\n"]
[12.172929, "o", "/app/rivetbay/forgekit/decode.c\r\n"]
[12.173839, "o", "--- /app/rivetbay/forgekit/decode.c\r\n"]
[12.176965, "o", "#include \"decode.h\"\r\n#include <stdint.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic uint32_t rd_be32(const unsigned char *p) {\r\n"]
[12.177231, "o", "    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];\r\n}\r\n\r\nint decode_frame(const char *path) {\r\n    FILE *f = fopen(path, \"rb\");\r\n    if (!f) return 2;\r\n    unsigned char raw[4096];\r\n    size_t n = fread(raw, 1, sizeof(raw), f);\r\n    fclose(f);\r\n    if (n < 4) return 2;\r\n    uint32_t ln = rd_be32(raw);\r\n    if (n < 4 + ln) return 2;\r\n    char name[256];\r\n    if (ln >= sizeof(name)) return 2;\r\n    memcpy(name, raw + 4, ln);\r\n    name[ln] = 0;\r\n    char kpath[512];\r\n    snprintf(kpath, sizeof(kpath), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *k = fopen(kpath, \"r\");\r\n    if (!k) {\r\n        printf(\"{\\\"kind\\\":\\\"unknown\\\",\\\"name\\\":\\\"%s\\\"}\\n\", name);\r\n        return 0;\r\n    }\r\n"]
[12.177293, "o", "    char line[256];\r\n    char fields[32][64];\r\n    char kinds[32][16];\r\n    int nf = 0;\r\n    while (fgets(line, sizeof(line), k)) {\r\n        if (strncmp(line, \"KDEC1\", 5) == 0) continue;\r\n        if (strncmp(line, \"NAME \", 5) == 0) continue;\r\n        if (sscanf(line, \"%63s %15s\", fields[nf], kinds[nf]) == 2) nf++;\r\n    }\r\n    fclose(k);\r\n    const unsigned char *p = raw + 4 + ln;\r\n    size_t left = n - 4 - ln;\r\n    printf(\"{\\\"kind\\\":\\\"decoded\\\",\\\"name\\\":\\\"%s\\\",\\\"fields\\\":{\", name);\r\n    for (int i = 0; i < nf; i++) {\r\n        unsigned v = 0;\r\n        if (strcmp(kinds[i], \"u16\") == 0) {\r\n            if (left < 2) break;\r\n"]
[12.177462, "o", "            v = ((unsigned)p[0] << 8) | p[1];\r\n            p += 2; left -= 2;\r\n        } else {\r\n            if (left < 1) break;\r\n"]
[12.177597, "o", "            v = p[0];\r\n            p += 1; left -= 1;\r\n        }\r\n        printf(\"%s\\\"%s\\\":%u\", i ? \",\" : \"\", fields[i], v);\r\n    }\r\n    printf(\"}}\\n\");\r\n    return 0;\r\n}\r\n"]
[12.179151, "o", "\u001b[?2004hroot@6e9cbdb91ddd:/app/rivetbay# "]
[13.095594, "i", "printf '\\n--- descriptions ---\\n'; for f in /app/rivetbay/evd/*.evd; do echo \"--- $f\"; cat \"$f\"; done; printf '\\n--- ledger ---\\n'; cat /app/rivetbay/intake/current.ledger 2>/dev/null || true; printf '\\n--- emitters ---\\n'; for f in /app/rivetbay/emitters/*; do [ -f \"$f\" ] && { echo \"--- $f\"; cat \"$f\"; }; done\n"]
[13.096539, "o", "printf '\\n--- descriptions ---\\n'; for f in /app/rivetbay/evd/*.evd; do echo \"--- $f\"; cat \"$f\"; done; printf '\\n--- ledger ---\\n'; cat /app/rivetbay/intake/current.ledger 2>/dev/null || true; printf '\\n--- emitters ---\\n'; for f in /app/rivetbay/emitters/*; do [ -f \"$f\" ] && { echo \"--- $f\"; cat \"$f\"; }; done\r\n\u001b[?2004l\r"]
