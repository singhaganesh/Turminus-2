[13.125985, "o", "\u001b[?2004hroot@6e9cbdb91ddd:/app/rivetbay# "]
[22.812689, "i", "cd /app/rivetbay; for f in forgekit/discover.c forgekit/snapshot.c forgekit/emit.c forgekit/warmup.c forgekit/sheet.h; do echo \"===== $f =====\"; cat \"$f\"; done\n"]
[22.813328, "o", "cd /app/rivetbay; for f in forgekit/discover.c forgekit/snapshot.c forgekit/emit.c forgekit/warmup.c forgekit/sheet.h; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[22.813544, "o", "===== forgekit/discover.c =====\r\n"]
[22.815175, "o", "#include \"discover.h\"\r\n#include \"parse_evd.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int stem_seen(const char *stem, char stems[][128], int n) {\r\n    for (int i = 0; i < n; i++)\r\n        if (strcmp(stems[i], stem) == 0) return 1;\r\n    return 0;\r\n}\r\n\r\nstatic int load_prior_stems(char stems[][128], int cap) {\r\n    int n = 0;\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    char line[1024];\r\n    if (!f) return 0;\r\n    while (n < cap && fgets(line, sizeof(line), f)) {\r\n        char *bar = strchr(line, '|');\r\n        if (!bar) continue;\r\n        *bar = 0;\r\n        char *s = line;\r\n        while (*s == ' ' || *s == '\\t') s++;\r\n        if (*s == 0) continue;\r\n        strncpy(stems[n], s, 127);\r\n        stems[n][127] = 0;\r\n        n++;\r\n    }\r\n    fclose(f);\r\n    return n;\r\n}\r\n\r\nstatic int emit_row(FILE *out, const char *fname) {\r\n    char path[512];\r\n    snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", fname);\r\n    char name[128];\r\n    char fields[512];\r\n    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n    fprintf(out, \"%s|evd/%s|%s\\n\", name, fname, fields);\r\n    return 1;\r\n}\r\n\r\nvoid discover_all(void) {\r\n    char prior[64][128];\r\n    char pending[64][256];\r\n    int nprior = load_prior_stems(prior, 64);\r\n    int npend = 0;\r\n    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    if (!d || !out) {\r\n        if (d) closedir(d);\r\n        if (out) fclose(out);\r\n        return;\r\n    }\r\n    struct dirent *ent;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n        char name[128];\r\n        char fields[512];\r\n        char path[512];\r\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n        if (stem_seen(name, prior, nprior)) continue;\r\n        if (npend < 64) {\r\n            strncpy(pending[npend], ent->d_name, 255);\r\n            pending[npend][255] = 0;\r\n            npend++;\r\n        }\r\n    }\r\n    for (int i = 0; i < nprior; i++) {\r\n        char want[256];\r\n        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n        emit_row(out, want);\r\n    }\r\n    for (int i = 0; i < npend; i++)\r\n        emit_row(out, pending[i]);\r\n    fclose(out);\r\n    closedir(d);\r\n}\r\n"]
[22.815349, "o", "===== forgekit/snapshot.c =====\r\n"]
[22.816454, "o", "#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic char g_primed[65536];\r\nstatic char g_emit[65536];\r\nstatic int g_emit_cap;\r\n\r\nstatic int count_nonempty_lines(const char *blob) {\r\n    int n = 0;\r\n    int nonempty = 0;\r\n    for (const char *s = blob; *s; s++) {\r\n        if (*s == '\\n') {\r\n            if (nonempty) n++;\r\n            nonempty = 0;\r\n        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n            nonempty = 1;\r\n        }\r\n    }\r\n    if (nonempty) n++;\r\n    return n;\r\n}\r\n\r\nstatic void load_mill_open_into(char *dst, size_t cap) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/mill_open\", \"r\");\r\n    dst[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(dst, 1, cap - 1, f);\r\n    dst[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid prime_intake_sheet(void) {\r\n    load_mill_open_into(g_primed, sizeof(g_primed));\r\n    g_emit_cap = count_nonempty_lines(g_primed);\r\n    g_emit[0] = 0;\r\n}\r\n\r\nvoid grab_sheet(void) {\r\n    load_mill_open_into(g_primed, sizeof(g_primed));\r\n}\r\n\r\nvoid pour_sheet(void) {\r\n    char buf[65536];\r\n    char out[65536];\r\n    strncpy(buf, g_primed, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    size_t w = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        while (*line == ' ' || *line == '\\t') line++;\r\n        if (*line == 0) {\r\n            line = strtok_r(NULL, \"\\n\", &save);\r\n            continue;\r\n        }\r\n        size_t L = strlen(line);\r\n        if (w + L + 1 >= sizeof(out)) break;\r\n        memcpy(out + w, line, L);\r\n        w += L;\r\n        out[w++] = '\\n';\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n    out[w] = 0;\r\n    memcpy(g_emit, out, w + 1);\r\n}"]
[22.816601, "o", "\r\n\r\nconst char *sheet_view(void) {\r\n    return g_emit;\r\n}\r\n\r\nint sheet_emit_cap(void) {\r\n    return g_emit_cap;\r\n}\r\n"]
[22.81682, "o", "===== forgekit/emit.c =====\r\n"]
[22.817761, "o", "#include \"emit.h\"\r\n#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void emit_one(const char *line) {\r\n    char tmp[1024];\r\n    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    tmp[sizeof(tmp) - 1] = 0;\r\n    char *nl = strchr(tmp, '\\n');\r\n    if (nl) *nl = 0;\r\n    char *name = tmp;\r\n    char *p1 = strchr(tmp, '|');\r\n    if (!p1) return;\r\n    *p1 = 0;\r\n    char *p2 = strchr(p1 + 1, '|');\r\n    if (!p2) return;\r\n    char *spec = p2 + 1;\r\n    char outp[512];\r\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *o = fopen(outp, \"w\");\r\n    if (!o) return;\r\n    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    char *parts[32];\r\n    int nf = 0;\r\n    char spec_copy[512];\r\n    strncpy(spec_copy, spec, sizeof(spec_copy) - 1);\r\n    spec_copy[sizeof(spec_copy) - 1] = 0;\r\n    char *tok = strtok(spec_copy, \",\");\r\n    while (tok && nf < 32) {\r\n        parts[nf++] = tok;\r\n        tok = strtok(NULL, \",\");\r\n    }\r\n    for (int i = nf - 1; i >= 0; i--) {\r\n        char fn[64], k[16];\r\n        if (sscanf(parts[i], \"%63[^:]:%15s\", fn, k) == 2)\r\n            fprintf(o, \"%s %s\\n\", fn, k);\r\n    }\r\n    fclose(o);\r\n}\r\n\r\nvoid emit_all(void) {\r\n    const char *blob = sheet_view();\r\n    int cap = sheet_emit_cap();\r\n    char buf[65536];\r\n    strncpy(buf, blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    int idx = 0;\r\n    while (line) {\r\n        if (idx >= cap) break;\r\n        if (line[0]) emit_one(line);\r\n        idx++;\r\n"]
[22.817863, "o", "        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n}\r\n"]
[22.818037, "o", "===== forgekit/warmup.c =====\r\n"]
[22.819008, "o", "#include \"warmup.h\"\r\n#include \"sheet.h\"\r\n#include <stdlib.h>\r\n\r\nvoid warm_maybe(void) {\r\n    const char *e = getenv(\"RIVET_WARM\");\r\n    if (e && e[0] == '1') {\r\n        grab_sheet();\r\n    }\r\n}\r\n"]
[22.819202, "o", "===== forgekit/sheet.h =====\r\n"]
[22.820163, "o", "#ifndef SHEET_H\r\n#define SHEET_H\r\nvoid prime_intake_sheet(void);\r\nvoid grab_sheet(void);\r\nvoid pour_sheet(void);\r\nconst char *sheet_view(void);\r\nint sheet_emit_cap(void);\r\n#endif\r\n"]
[22.820409, "o", "\u001b[?2004hroot@6e9cbdb91ddd:/app/rivetbay# "]
[23.272254, "i", "echo '===== millscore ====='; find /app/millscore -maxdepth 2 -type f -print; for f in /app/millscore/*.[ch]; do echo \"===== $f =====\"; cat \"$f\"; done\n"]
[23.273199, "o", "echo '===== millscore ====='; find /app/millscore -maxdepth 2 -type f -print; for f in /app/millscore/*.[ch]; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r===== millscore =====\r\n"]
[23.275294, "o", "/app/millscore/tally.c\r\n/app/millscore/tally.h\r\n"]
[23.275783, "o", "===== /app/millscore/tally.c =====\r\n"]
[23.27737, "o", "#include \"tally.h\"\r\n#include \"sheet.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int count_emitters(void) {\r\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\r\n    int n = 0;\r\n    struct dirent *ent;\r\n    if (!d) return 0;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L > 5 && strcmp(ent->d_name + L - 5, \".kdec\") == 0) n++;\r\n    }\r\n    closedir(d);\r\n    return n;\r\n}\r\n\r\nstatic int count_sheet_lines(void) {\r\n    const char *s = sheet_view();\r\n    int n = 0;\r\n    int nonempty = 0;\r\n    for (; *s; s++) {\r\n        if (*s == '\\n') {\r\n            if (nonempty) n++;\r\n            nonempty = 0;\r\n        } else if (*s != ' ' && *s != '\\r') nonempty = 1;\r\n    }\r\n    if (nonempty) n++;\r\n    return n;\r\n}\r\n\r\nint count_gap(void) {\r\n    int a = count_sheet_lines();\r\n    int b = count_emitters();\r\n    return (b < a) ? 1 : 0;\r\n}\r\n"]
[23.277595, "o", "===== /app/millscore/tally.h =====\r\n"]
[23.278892, "o", "#ifndef TALLY_H\r\n#define TALLY_H\r\nint count_gap(void);\r\n#endif\r\n"]
[23.279109, "o", "\u001b[?2004hroot@6e9cbdb91ddd:/app/rivetbay# "]
[23.739139, "i", "cd /app/rivetbay; for f in notes/*.txt; do echo \"===== $f =====\"; cat \"$f\"; done; echo '===== Makefile bytes ====='; sed -n l Makefile\n"]
[23.739724, "o", "cd /app/rivetbay; for f in notes/*.txt; do echo \"===== $f =====\"; cat \"$f\"; done; echo '===== Makefile bytes ====='; sed -n l Makefile\r\n\u001b[?2004l\r"]
[23.740466, "o", "===== notes/forms.txt =====\r\n"]
[23.742161, "o", "Event descriptions use NAME then FIELD lines. Ledger is name|relpath|field:kind,... ."]
[23.742929, "o", "\r\nKDEC files start with KDEC1. Decode JSON uses kind decoded or unknown.\r\nDecode fields object keys are the FIELD names from that description (for example latch, force, amp, bit, thick, mm, q, n, w).\r\n"]
[23.743267, "o", "===== notes/layout.txt =====\r\n"]
[23.745653, "o", "evd holds descriptions. intake/current.ledger is the mill roster. emitters hold kdec tables.\r\nframes hold packed samples. forgekit is the C pipeline.\r\n"]
[23.746132, "o", "===== notes/ops.txt =====\r\n"]
[23.747677, "o", "After adding a description, mill may leave decode unknown even though discovery refreshed the on-disk ledger.\r\nUnknown decode is normal for frames that have no description on this bench.\r\n"]
[23.747914, "o", "===== Makefile bytes =====\r\n"]
[23.752335, "o", "CC ?= gcc$\r\nCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore$\r\nSRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)$\r\nBIN := /app/bin/rivetbay$\r\n$\r\n.PHONY: hull$\r\nhull:$\r\n\\tmkdir -p /app/bin$\r\n\\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)$\r\n"]
[23.753228, "o", "\u001b[?2004hroot@6e9cbdb91ddd:/app/rivetbay# "]
[24.039167, "i", "/app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo \"evd=$(find /app/rivetbay/evd -maxdepth 1 -type f -name '*.evd' | wc -l) ledger=$(grep -cve '^[[:space:]]*$' /app/rivetbay/intake/current.ledger) emitters=$(find /app/rivetbay/emitters -maxdepth 1 -type f -name '*.kdec' | wc -l)\"; cat /app/rivetbay/intake/current.ledger\n"]
[24.040772, "o", "/app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo \"evd=$(find /app/rivetbay/evd -maxdepth 1 -type f -name '*.evd' | wc -l) ledger=$(grep -cve '^[[:space:]]*$' /app/rivetbay/intake/current.ledger) emitters=$(find /app/rivetbay/emitters -maxdepth 1 -type f -name '*.kdec' | wc -l)\"; cat /app/rivetbay/intake/current.ledger\r\n\u001b[?2004l\r"]
[24.045914, "o", "mill_rc=0\r\n"]
[24.056314, "o", "evd=8 ledger=8 emitters=7\r\n"]
[24.058826, "o", "wing_ice|evd/wing_ice.evd|thick:u16\r\nfuel_flow|evd/fuel_flow.evd|rate:u16,tank:u8\r\ndoor_seal|evd/door_seal.evd|ok:u8\r\npitot_heat|evd/pitot_heat.evd|watts:u16\r\naileron_pos|evd/aileron_pos.evd|deg:u16,side:u8\r\nnav_lamp|evd/nav_lamp.evd|color:u8\r\nbrake_temp|evd/brake_temp.evd|cdeg:u16\r\ngalley_hatch|evd/galley_hatch.evd|latch:u8,force:u16\r\n"]
[24.059369, "o", "\u001b[?2004hroot@6e9cbdb91ddd:/app/rivetbay# "]
[71.989525, "i", "cd /app/rivetbay && cat > forgekit/discover.c <<'EOF'\n#include \"discover.h\"\n#include \"parse_evd.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n\n#define MAX_RECORDS 512\n\nstruct record {\n    char name[128];\n    char fname[256];\n    char fields[512];\n    int written;\n};\n\nstatic int find_record(struct record *records, int n, const char *name) {\n    for (int i = 0; i < n; i++)\n        if (!records[i].written && strcmp(records[i].name, name) == 0)\n            return i;\n    return -1;\n}\n\nstatic int scan_records(struct record *records) {\n    DIR *d = opendir(\"/app/rivetbay/evd\");\n    if (!d) return -1;\n    int n = 0;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL && n < MAX_RECORDS) {\n        size_t len = strlen(ent->d_name);\n        if (len < 5 || strcmp(ent->d_name + len - 4, \".evd\") != 0) continue;\n        char path[512];\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\n        if (parse_evd_file(path, records[n].name, records[n].fields,\n                           sizeof(records[n].fields)) != 0)\n            continue;\n        snprintf(records[n].fname, sizeof(records[n].fname), \"%s\", ent->d_name);\n        records[n].written = 0;\n        n++;\n    }\n    closedir(d);\n    return n;\n}\n\nstatic void write_record(FILE *out, struct record *r) {\n    fprintf(out, \"%s|evd/%s|%s\\n\", r->name, r->fname, r->fields);\n    r->written = 1;\n}\n\nvoid discover_all(void) {\n    struct record records[MAX_RECORDS];\n    int n = scan_records(records);\n    if (n < 0) return;\n\n    char prior[MAX_RECORDS][128];\n    int np = 0;\n    FILE *old = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\n    if (old) {\n        char line[1024];\n        while (np < MAX_RECORDS && fgets(line, sizeof(line), old)) {\n            char *bar = strchr(line, '|');\n            if (!bar) continue;\n            *bar = 0;\n            char *name = line;\n            while (*name == ' ' || *name == '\\t') name++;\n            if (!*name) continue;\n            snprintf(prior[np++], sizeof(prior[0]), \"%s\", name);\n        }\n        fclose(old);\n    }\n\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\n    if (!out) return;\n    for (int i = 0; i < np; i++) {\n        int j = find_record(records, n, prior[i]);\n        if (j >= 0) write_record(out, &records[j]);\n    }\n    for (int i = 0; i < n; i++)\n        if (!records[i].written) write_record(out, &records[i]);\n    fclose(out);\n}\nEOF\n\ncat > forgekit/snapshot.c <<'EOF'\n#include \"sheet.h\"\n#include <stdio.h>\n\nstatic char g_emit[65536];\nstatic int g_emit_cap;\n\nstatic int count_nonempty_lines(const char *blob) {\n    int n = 0, nonempty = 0;\n    for (const char *s = blob; *s; s++) {\n        if (*s == '\\n') {\n            if (nonempty) n++;\n            nonempty = 0;\n        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\n            nonempty = 1;\n        }\n    }\n    return n + nonempty;\n}\n\nstatic void load_ledger(void) {\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\n    g_emit[0] = 0;\n    g_emit_cap = 0;\n    if (!f) return;\n    size_t n = fread(g_emit, 1, sizeof(g_emit) - 1, f);\n    g_emit[n] = 0;\n    fclose(f);\n    g_emit_cap = count_nonempty_lines(g_emit);\n}\n\nvoid prime_intake_sheet(void) {\n    g_emit[0] = 0;\n    g_emit_cap = 0;\n}\n\nvoid grab_sheet(void) {\n    load_ledger();\n}\n\nvoid pour_sheet(void) {\n    load_ledger();\n}\n\nconst char *sheet_view(void) {\n    return g_emit;\n}\n\nint sheet_emit_cap(void) {\n    return g_emit_cap;\n}\nEOF\n\ncat > forgekit/emit.c <<'EOF'\n#include \"emit.h\"\n#include \"sheet.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic void clear_emitters(void) {\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\n    if (!d) return;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len > 5 && strcmp(ent->d_name + len - 5, \".kdec\") == 0) {\n            char path[512];\n            snprintf(path, sizeof(path), \"/app/rivetbay/emitters/%s\", ent->d_name);\n            unlink(path);\n        }\n    }\n    closedir(d);\n}\n\nstatic void emit_one(const char *line)"]
[71.989892, "i", " {\n    char tmp[1024];\n    snprintf(tmp, sizeof(tmp), \"%s\", line);\n    char *p1 = strchr(tmp, '|');\n    if (!p1) return;\n    *p1 = 0;\n    char *name = tmp;\n    char *p2 = strchr(p1 + 1, '|');\n    if (!p2) return;\n    *p2 = 0;\n    char *spec = p2 + 1;\n\n    char outp[512];\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\n    FILE *out = fopen(outp, \"w\");\n    if (!out) return;\n    fprintf(out, \"KDEC1\\nNAME %s\\n\", name);\n\n    char spec_copy[512];\n    snprintf(spec_copy, sizeof(spec_copy), \"%s\", spec);\n    char *save = NULL;\n    for (char *tok = strtok_r(spec_copy, \",\", &save); tok;\n         tok = strtok_r(NULL, \",\", &save)) {\n        char field[64], kind[16];\n        if (sscanf(tok, \"%63[^:]:%15s\", field, kind) == 2)\n            fprintf(out, \"%s %s\\n\", field, kind);\n    }\n    fclose(out);\n}\n\nvoid emit_all(void) {\n    clear_emitters();\n    char buf[65536];\n    snprintf(buf, sizeof(buf), \"%s\", sheet_view());\n    char *save = NULL;\n    for (char *line = strtok_r(buf, \"\\n\", &save); line;\n         line = strtok_r(NULL, \"\\n\", &save))\n        if (*line) emit_one(line);\n}\nEOF\n"]
[71.990461, "o", "cd /app/rivetbay && cat > forgekit/discover.c <<'EOF'"]
