[93.232834, "i", "cd /app/rivetbay && rm -f evd/verifier_filename.evd frames/fresh_event.bin && test -f emitters/fresh_event.kdec && echo 'stale emitter present before mill'; /app/bin/rivetbay mill; rc=$?; echo \"cleanup_mill_rc=$rc\"; echo \"evd=$(find evd -maxdepth 1 -type f -name '*.evd' | wc -l) ledger=$(grep -cve '^[[:space:]]*$' intake/current.ledger) emitters=$(find emitters -maxdepth 1 -type f -name '*.kdec' | wc -l)\"; test ! -e emitters/fresh_event.kdec && echo 'stale emitter removed'; cat intake/current.ledger\n"]
