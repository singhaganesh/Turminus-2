[11.933393, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore\r\nSRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)\r\nBIN := /app/bin/rivetbay\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
