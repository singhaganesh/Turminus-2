[35.957168, "o", "/app/bin/rivetbay mill; rc=$?; echo \"add_mill_rc=$rc\"; cat emitters/first_pass_probe.kdec; /app/bin/rivetbay decode frames/first_pass_probe.bin; rm evd/first_pass_probe.evd frames/first_pass_probe.bin; /app/bin/rivetbay mill; rc=$?; echo \"remove_mill_rc=$rc\"; if [ -e emitters/first_pass_probe.kdec ]; then echo 'ERROR stale emitter remains'; exit 1; else echo 'stale emitter removed'; fi\r\n\u001b[?2004l\r"]
