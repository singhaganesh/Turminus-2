[17.805305, "o", "\u001b[?2004hroot@b703a9be73e8:/app/rivetbay# "]
[32.888485, "i", "cd /app/rivetbay && python3 - <<'PY'\np='forgekit/driver.c'\ns=open(p).read()\ns=s.replace('        discover_all();\\n        pour_sheet();', '        discover_all();\\n        grab_sheet();\\n        pour_sheet();')\nopen(p,'w').write(s)\n\np='forgekit/emit.c'\ns=open(p).read()\ns=s.replace('#include <stdio.h>\\n', '#include <dirent.h>\\n#include <stdio.h>\\n#include <unistd.h>\\n')\nold='''void emit_all(void) {\n    const char *blob = sheet_view();'''\nnew='''static void clear_emitters(void) {\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\n    if (!d) return;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len <= 5 || strcmp(ent->d_name + len - 5, \".kdec\") != 0) continue;\n        char path[512];\n        snprintf(path, sizeof(path), \"/app/rivetbay/emitters/%s\", ent->d_name);\n        unlink(path);\n    }\n    closedir(d);\n}\n\nvoid emit_all(void) {\n    clear_emitters();\n    const char *blob = sheet_view();'''\nif old not in s:\n    raise SystemExit('emit_all pattern not found')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\nmake hull\n"]
