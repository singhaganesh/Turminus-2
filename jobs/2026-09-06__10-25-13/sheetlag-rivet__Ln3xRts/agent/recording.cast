[35.925636, "i", "cd /app/rivetbay && cat > evd/first_pass_probe.evd <<'EOF'\nNAME first_pass_probe\nFIELD mm u16\nFIELD bit u8\nEOF\npython3 - <<'PY'\nimport struct\nwith open('frames/first_pass_probe.bin','wb') as f:\n    name=b'first_pass_probe'\n    f.write(struct.pack('>I',len(name))+name+struct.pack('>HB',513,7))\nPY\n/app/bin/rivetbay mill; rc=$?; echo \"add_mill_rc=$rc\"; cat emitters/first_pass_probe.kdec; /app/bin/rivetbay decode frames/first_pass_probe.bin; rm evd/first_pass_probe.evd frames/first_pass_probe.bin; /app/bin/rivetbay mill; rc=$?; echo \"remove_mill_rc=$rc\"; if [ -e emitters/first_pass_probe.kdec ]; then echo 'ERROR stale emitter remains'; exit 1; else echo 'stale emitter removed'; fi\n"]
[35.925958, "o", "cd /app/rivetbay && cat > evd/first_pass_probe.evd <<'EOF'\r\n\u001b[?2004l\r"]
[35.92605, "o", "\u001b[?2004h> "]
[35.926597, "o", "NAME first_pass_probe\r\n\u001b[?2004l\r\u001b[?2004h> FIELD mm u16\r\n\u001b[?2004l\r\u001b[?2004h> FIELD bit u8\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
