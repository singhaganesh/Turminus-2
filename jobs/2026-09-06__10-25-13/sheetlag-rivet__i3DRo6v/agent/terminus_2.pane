#include "discover.h"
#include "sheet.h"
#include "emit.h"
#include "tally.h"
#include "decode.h"
#include "warmup.h"
#include <stdio.h>
#include <string.h>

static void note_mill_pass(void) {
    FILE *f = fopen("/app/rivetbay/intake/.mill_pass", "a");
    if (!f) return;
    fputc('1', f);
    fputc('\n', f);
    fclose(f);
}

int main(int argc, char **argv) {
    if (argc >= 2 && strcmp(argv[1], "mill") == 0) {
        note_mill_pass();
        warm_maybe();
        discover_all();
        pour_sheet();
        emit_all();
        return count_gap();
    }
    if (argc >= 3 && strcmp(argv[1], "decode") == 0)
        return decode_frame(argv[2]);
    fprintf(stderr, "usage: rivetbay mill | rivetbay decode <frame>\n");
    return 2;
}
./forgekit/snapshot.c
#include "sheet.h"
#include <stdio.h>
#include <string.h>

static char g_blob[65536];

__attribute__((constructor))
static void boot_sheet(void) {
    FILE *f = fopen("/app/rivetbay/intake/current.ledger", "r");
    g_blob[0] = 0;
    if (!f) return;
    size_t n = fread(g_blob, 1, sizeof(g_blob) - 1, f);
    g_blob[n] = 0;
    fclose(f);
}

void grab_sheet(void) {
    FILE *f = fopen("/app/rivetbay/intake/current.ledger", "r");
    g_blob[0] = 0;
    if (!f) return;
    size_t n = fread(g_blob, 1, sizeof(g_blob) - 1, f);
    g_blob[n] = 0;
    fclose(f);
}

void pour_sheet(void) {
    char buf[65536];
    char out[65536];
    strncpy(buf, g_blob, sizeof(buf) - 1);
    buf[sizeof(buf) - 1] = 0;
    size_t w = 0;
    char *save = NULL;
    char *line = strtok_r(buf, "\n", &save);
    while (line) {
        while (*line == ' ' || *line == '\t') line++;
        if (*line == 0) {
            line = strtok_r(NULL, "\n", &save);
            continue;
        }
        size_t L = strlen(line);
        if (w + L + 1 >= sizeof(out)) break;
        memcpy(out + w, line, L);
        w += L;
        out[w++] = '\n';
        line = strtok_r(NULL, "\n", &save);
    }
    out[w] = 0;
    memcpy(g_blob, out, w + 1);
}

const char *sheet_view(void) {
    return g_blob;
}
