[51.875115, "i", "rm -f evd/first_pass_probe.evd frames/first_pass_probe.bin; /app/bin/rivetbay mill; rc=$?; echo \"shrink_mill_rc=$rc\"; if test -e emitters/first_pass_probe.kdec; then echo 'ERROR stale probe decoder'; else echo 'stale probe decoder removed'; fi\ncat > evd/failure_probe.evd <<'EOF'\nNAME missing_dir/failure_probe\nFIELD q u8\nEOF\n/app/bin/rivetbay mill; rc=$?; echo \"failure_mill_rc=$rc\"; test \"$rc\" -ne 0\nrm -f evd/failure_probe.evd\n/app/bin/rivetbay mill; rc=$?; echo \"restore_mill_rc=$rc\"; exit \"$rc\"\n"]
[51.876755, "o", "rm -f evd/first_pass_probe.evd frames/first_pass_probe.bin; /app/bin/rivetbay mill; rc=$?; echo \"shrink_mill_rc=$rc\"; if test -e emitters/first_pass_probe.kdec; then echo 'ERROR stale probe decoder'; else echo 'stale probe decoder removed'; fi\r\n\u001b[?2004l\r"]
[51.883352, "o", "shrink_mill_rc=0\r\n"]
[51.883519, "o", "stale probe decoder removed\r\n\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# "]
[51.883643, "o", "cat > evd/failure_probe.evd <<'EOF'\r\n\u001b[?2004l\r"]
[51.883749, "o", "\u001b[?2004h> "]
[51.883874, "o", "NAME missing_dir/failure_probe\r\n\u001b[?2004l\r\u001b[?2004h> FIELD q u8\r\n"]
[51.883948, "o", "\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[51.887661, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# /app/bin/rivetbay mill; rc=$?; echo \"failure_mill_rc=$rc\"; test \"$rc\" -ne 0\r\n\u001b[?2004l\r"]
[51.891192, "o", "failure_mill_rc=1\r\n"]
[51.891531, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# rm -f evd/failure_probe.evd\r\n\u001b[?2004l\r"]
[51.892963, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# "]
[51.893176, "o", "/app/bin/rivetbay mill; rc=$?; echo \"restore_mill_rc=$rc\"; exit \"$rc\"\r\n\u001b[?2004l\r"]
[51.897233, "o", "restore_mill_rc=0\r\nexit\r\n"]
