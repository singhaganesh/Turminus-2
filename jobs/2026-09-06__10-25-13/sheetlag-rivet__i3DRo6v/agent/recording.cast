[8.381705, "o", "\r\n--- sources/build ---\r\n"]
[8.38379, "o", "./forgekit/utf_tidy.c\r\n"]
[8.387264, "o", "#include \"utf_tidy.h\"\r\n#include <string.h>\r\nvoid tidy_copy(const char *src, char *dst, int n) {\r\n    if (n <= 0) return;\r\n    strncpy(dst, src, (size_t)n - 1);\r\n    dst[n - 1] = 0;\r\n}\r\n"]
[8.388852, "o", "./forgekit/parse_evd.h\r\n"]
[8.391254, "o", "#ifndef PARSE_EVD_H\r\n#define PARSE_EVD_H\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz);\r\n#endif\r\n"]
[8.391845, "o", "./forgekit/discover.h\r\n"]
[8.39474, "o", "#ifndef DISCOVER_H\r\n#define DISCOVER_H\r\nvoid discover_all(void);\r\n#endif\r\n"]
[8.395058, "o", "./forgekit/driver.c\r\n"]
[8.39686, "o", "#include \"discover.h\"\r\n#include \"sheet.h\"\r\n#include \"emit.h\"\r\n#include \"tally.h\"\r\n#include \"decode.h\"\r\n#include \"warmup.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic void note_mill_pass(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    if (!f) return;\r\n    fputc('1', f);\r\n    fputc('\\n', f);\r\n    fclose(f);\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n"]
[8.397005, "o", "    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n        note_mill_pass();\r\n        warm_maybe();\r\n        discover_all();\r\n        pour_sheet();\r\n        emit_all();\r\n        return count_gap();\r\n    }\r\n    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n        return decode_frame(argv[2]);\r\n    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    return 2;\r\n}\r\n"]
[8.397198, "o", "./forgekit/snapshot.c\r\n"]
[8.3987, "o", "#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic char g_blob[65536];\r\n\r\n__attribute__((constructor))\r\nstatic void boot_sheet(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    g_blob[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(g_blob, 1, sizeof(g_blob) - 1, f);\r\n    g_blob[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\n"]
[8.398845, "o", "void grab_sheet(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    g_blob[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(g_blob, 1, sizeof(g_blob) - 1, f);\r\n    g_blob[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid pour_sheet(void) {\r\n    char buf[65536];\r\n    char out[65536];\r\n    strncpy(buf, g_blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    size_t w = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        while (*line == ' ' || *line == '\\t') line++;\r\n        if (*line == 0) {\r\n            line = strtok_r(NULL, \"\\n\", &save);\r\n            continue;\r\n        }\r\n        size_t L = strlen(line);\r\n        if (w + L + 1 >= sizeof(out)) break;\r\n        memcpy(out + w, line, L);\r\n        w += L;\r\n        out[w++] = '\\n';\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n    out[w] = 0;\r\n    memcpy(g_blob, out, w + 1);\r\n}\r\n\r\nconst char *sheet_view(void) {\r\n    return g_blob;\r\n}\r\n"]
[8.399042, "o", "./forgekit/sheet.h\r\n"]
[8.40058, "o", "#ifndef SHEET_H\r\n#define SHEET_H\r\nvoid grab_sheet(void);\r\nvoid pour_sheet(void);\r\nconst char *sheet_view(void);\r\n#endif\r\n"]
[8.400778, "o", "./forgekit/utf_tidy.h\r\n"]
[8.402061, "o", "#ifndef UTF_TIDY_H\r\n#define UTF_TIDY_H\r\nvoid tidy_copy(const char *src, char *dst, int n);\r\n#endif\r\n"]
[8.402298, "o", "./forgekit/warmup.c\r\n"]
[8.406124, "o", "#include \"warmup.h\"\r\n#include <stdlib.h>\r\n/* Operators sometimes export RIVET_WARM=1 to mill twice after a checkout. */\r\nvoid warm_maybe(void) {\r\n    const char *e = getenv(\"RIVET_WARM\");\r\n    (void)e;\r\n}\r\n./forgekit/discover.c\r\n"]
[8.408295, "o", "#include \"discover.h\"\r\n#include \"parse_evd.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nvoid discover_all(void) {\r\n    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    struct dirent *ent;\r\n    if (!d || !out) {\r\n        if (d) closedir(d);\r\n        if (out) fclose(out);\r\n        return;\r\n    }\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n        char path[512];\r\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n        char name[128];\r\n        char fields[512];\r\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n        fprintf(out, \"%s|evd/%s|%s\\n\", name, ent->d_name, fields);\r\n    }\r\n"]
[8.409537, "o", "    fclose(out);\r\n    closedir(d);\r\n}\r\n"]
[8.409981, "o", "./forgekit/emit.c\r\n"]
[8.412107, "o", "#include \"emit.h\"\r\n#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void emit_one(const char *line) {\r\n    char tmp[1024];\r\n    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    tmp[sizeof(tmp) - 1] = 0;\r\n    char *nl = strchr(tmp, '\\n');\r\n    if (nl) *nl = 0;\r\n"]
[8.412333, "o", "    char *name = tmp;\r\n    char *p1 = strchr(tmp, '|');\r\n    if (!p1) return;\r\n    *p1 = 0;\r\n    char *p2 = strchr(p1 + 1, '|');\r\n    if (!p2) return;\r\n    char *spec = p2 + 1;\r\n    char outp[512];\r\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *o = fopen(outp, \"w\");\r\n    if (!o) return;\r\n    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    char *tok = strtok(spec, \",\");\r\n    while (tok) {\r\n        char fn[64], k[16];\r\n        if (sscanf(tok, \"%63[^:]:%15s\", fn, k) == 2)\r\n            fprintf(o, \"%s %s\\n\", fn, k);\r\n        tok = strtok(NULL, \",\");\r\n    }\r\n    fclose(o);\r\n}\r\n\r\nvoid emit_all(void) {\r\n    const char *blob = sheet_view();\r\n    char buf[65536];\r\n    strncpy(buf, blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        if (line[0]) emit_one(line);\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n}\r\n"]
[8.412648, "o", "./forgekit/warmup.h\r\n"]
[8.414598, "o", "#ifndef WARMUP_H\r\n#define WARMUP_H\r\nvoid warm_maybe(void);\r\n#endif\r\n"]
[8.414854, "o", "./forgekit/emit.h\r\n"]
[8.416661, "o", "#ifndef EMIT_H\r\n#define EMIT_H\r\nvoid emit_all(void);\r\n#endif\r\n"]
[8.416921, "o", "./forgekit/decode.h\r\n"]
[8.419003, "o", "#ifndef DECODE_H\r\n#define DECODE_H\r\nint decode_frame(const char *path);\r\n#endif\r\n"]
[8.419516, "o", "./forgekit/parse_evd.c\r\n"]
[8.423047, "o", "#include \"parse_evd.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return -1;\r\n    name[0] = 0;\r\n    fields[0] = 0;\r\n    char line[256];\r\n    int first = 1;\r\n    while (fgets(line, sizeof(line), f)) {\r\n        if (strncmp(line, \"NAME \", 5) == 0) {\r\n"]
[8.42331, "o", "            sscanf(line + 5, \"%127s\", name);\r\n        } else if (strncmp(line, \"FIELD \", 6) == 0) {\r\n            char fn[64], k[16];\r\n            if (sscanf(line + 6, \"%63s %15s\", fn, k) == 2) {\r\n                if (!first) strncat(fields, \",\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, \":\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);\r\n                first = 0;\r\n            }\r\n        }\r\n    }\r\n    fclose(f);\r\n    return name[0] ? 0 : -1;\r\n}\r\n"]
[8.423849, "o", "./forgekit/decode.c\r\n"]
[8.426076, "o", "#include \"decode.h\"\r\n#include <stdint.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic uint32_t rd_be32(const unsigned char *p) {\r\n    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];\r\n}\r\n\r\nint decode_frame(const char *path) {\r\n    FILE *f = fopen(path, \"rb\");\r\n    if (!f) return 2;\r\n    unsigned char raw[4096];\r\n    size_t n = fread(raw, 1, sizeof(raw), f);\r\n    fclose(f);\r\n"]
[8.427181, "o", "    if (n < 4) return 2;\r\n    uint32_t ln = rd_be32(raw);\r\n    if (n < 4 + ln) return 2;\r\n    char name[256];\r\n    if (ln >= sizeof(name)) return 2;\r\n    memcpy(name, raw + 4, ln);\r\n    name[ln] = 0;\r\n    char kpath[512];\r\n    snprintf(kpath, sizeof(kpath), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *k = fopen(kpath, \"r\");\r\n    if (!k) {\r\n        printf(\"{\\\"kind\\\":\\\"unknown\\\",\\\"name\\\":\\\"%s\\\"}\\n\", name);\r\n        return 0;\r\n    }\r\n    char line[256];\r\n    char fields[32][64];\r\n    char kinds[32][16];\r\n    int nf = 0;\r\n    while (fgets(line, sizeof(line), k)) {\r\n        if (strncmp(line, \"KDEC1\", 5) == 0) continue;\r\n        if (strncmp(line, \"NAME \", 5) == 0) continue;\r\n        if (sscanf(line, \"%63s %15s\", fields[nf], kinds[nf]) == 2) nf++;\r\n    }\r\n    fclose(k);\r\n    const unsigned char *p = raw + 4 + ln;\r\n    size_t left = n - 4 - ln;\r\n    printf(\"{\\\"kind\\\":\\\"decoded\\\",\\\"name\\\":\\\"%s\\\",\\\"fields\\\":{\", name);\r\n    for (int i = 0; i < nf; i++) {\r\n        unsigned v = 0;\r\n        if (strcmp(kinds[i], \"u16\") == 0) {\r\n            if (left < 2) break;\r\n            v = ((unsigned)p[0] << 8) | p[1];\r\n            p += 2; left -= 2;\r\n        } else {\r\n            if (left < 1) break;\r\n            v = p[0];\r\n            p += 1; left -= 1;\r\n        }\r\n        printf(\"%s\\\"%s\\\":%u\", i ? \",\" : \"\", fields[i], v);\r\n    }\r\n    printf(\"}}\\n\");\r\n    return 0;\r\n}\r\n./Makefile\r\n"]
[8.428966, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore\r\nSRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)\r\nBIN := /app/bin/rivetbay\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[8.429957, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# "]
[9.372822, "i", "printf '\\n--- descriptions ---\\n'; for f in /app/rivetbay/evd/*.evd; do echo \"### $f\"; cat \"$f\"; done; printf '\\n--- ledger ---\\n'; cat /app/rivetbay/intake/current.ledger 2>/dev/null || true; printf '\\n--- emitters ---\\n'; for f in /app/rivetbay/emitters/*.kdec; do [ -e \"$f\" ] || continue; echo \"### $f\"; cat \"$f\"; done\n"]
[9.373835, "o", "printf '\\n--- descriptions ---\\n'; for f in /app/rivetbay/evd/*.evd; do echo \"### $f\"; cat \"$f\"; done; printf '\\n--- ledger ---\\n'; cat /app/rivetbay/intake/current.ledger 2>/dev/null || true; printf '\\n--- emitters ---\\n'; for f in /app/rivetbay/emitters/*.kdec; do [ -e \"$f\" ] || continue; echo \"### $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
