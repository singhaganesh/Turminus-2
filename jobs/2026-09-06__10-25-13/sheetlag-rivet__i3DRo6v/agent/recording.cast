[15.302147, "o", "cd /app/rivetbay; for f in forgekit/discover.c forgekit/emit.c forgekit/warmup.c forgekit/*.h /app/millscore/*.[ch]; do [ -f \"$f\" ] || continue; echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[15.305328, "o", "===== forgekit/discover.c =====\r\n"]
[15.306607, "o", "#include \"discover.h\"\r\n#include \"parse_evd.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nvoid discover_all(void) {\r\n    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n"]
[15.306687, "o", "    struct dirent *ent;\r\n    if (!d || !out) {\r\n        if (d) closedir(d);\r\n        if (out) fclose(out);\r\n        return;\r\n    }\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n        char path[512];\r\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n        char name[128];\r\n        char fields[512];\r\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n        fprintf(out, \"%s|evd/%s|%s\\n\", name, ent->d_name, fields);\r\n    }\r\n    fclose(out);\r\n    closedir(d);\r\n}\r\n"]
[15.307833, "o", "===== forgekit/emit.c =====\r\n"]
[15.31131, "o", "#include \"emit.h\"\r\n#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\n"]
[15.311498, "o", "static void emit_one(const char *line) {\r\n    char tmp[1024];\r\n    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    tmp[sizeof(tmp) - 1] = 0;\r\n    char *nl = strchr(tmp, '\\n');\r\n    if (nl) *nl = 0;\r\n    char *name = tmp;\r\n    char *p1 = strchr(tmp, '|');\r\n    if (!p1) return;\r\n    *p1 = 0;\r\n    char *p2 = strchr(p1 + 1, '|');\r\n    if (!p2) return;\r\n    char *spec = p2 + 1;\r\n    char outp[512];\r\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *o = fopen(outp, \"w\");\r\n    if (!o) return;\r\n    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    char *tok = strtok(spec, \",\");\r\n    while (tok) {\r\n        char fn[64], k[16];\r\n        if (sscanf(tok, \"%63[^:]:%15s\", fn, k) == 2)\r\n            fprintf(o, \"%s %s\\n\", fn, k);\r\n        tok = strtok(NULL, \",\");\r\n    }\r\n    fclose(o);\r\n}\r\n\r\nvoid emit_all(void) {\r\n    const char *blob = sheet_view();\r\n    char buf[65536];\r\n    strncpy(buf, blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        if (line[0]) emit_one(line);\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n}\r\n"]
[15.311956, "o", "===== forgekit/warmup.c =====\r\n"]
[15.314708, "o", "#include \"warmup.h\"\r\n#include <stdlib.h>\r\n/* Operators sometimes export RIVET_WARM=1 to mill twice after a checkout. */\r\nvoid warm_maybe(void) {\r\n    const char *e = getenv(\"RIVET_WARM\");\r\n    (void)e;\r\n}\r\n"]
[15.315119, "o", "===== forgekit/decode.h =====\r\n"]
[15.316354, "o", "#ifndef DECODE_H\r\n#define DECODE_H\r\nint decode_frame(const char *path);\r\n#endif\r\n"]
[15.316578, "o", "===== forgekit/discover.h =====\r\n"]
[15.317738, "o", "#ifndef DISCOVER_H\r\n#define DISCOVER_H\r\nvoid discover_all(void);\r\n#endif\r\n"]
[15.318363, "o", "===== forgekit/emit.h =====\r\n"]
[15.321363, "o", "#ifndef EMIT_H\r\n#define EMIT_H\r\nvoid emit_all(void);\r\n#endif\r\n"]
[15.321794, "o", "===== forgekit/parse_evd.h =====\r\n"]
[15.324733, "o", "#ifndef PARSE_EVD_H\r\n#define PARSE_EVD_H\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz);\r\n#endif\r\n"]
[15.325476, "o", "===== forgekit/sheet.h =====\r\n"]
[15.326934, "o", "#ifndef SHEET_H\r\n#define SHEET_H\r\nvoid grab_sheet(void);\r\nvoid pour_sheet(void);\r\nconst char *sheet_view(void);\r\n#endif\r\n"]
[15.327173, "o", "===== forgekit/utf_tidy.h =====\r\n"]
[15.328365, "o", "#ifndef UTF_TIDY_H\r\n#define UTF_TIDY_H\r\nvoid tidy_copy(const char *src, char *dst, int n);\r\n#endif\r\n"]
[15.328573, "o", "===== forgekit/warmup.h =====\r\n"]
[15.329721, "o", "#ifndef WARMUP_H\r\n#define WARMUP_H\r\nvoid warm_maybe(void);\r\n#endif\r\n"]
[15.329891, "o", "===== /app/millscore/tally.c =====\r\n"]
[15.331227, "o", "#include \"tally.h\"\r\n#include \"sheet.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int count_emitters(void) {\r\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\r\n    int n = 0;\r\n    struct dirent *ent;\r\n    if (!d) return 0;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L > 5 && strcmp(ent->d_name + L - 5, \".kdec\") == 0) n++;\r\n    }\r\n    closedir(d);\r\n    return n;\r\n}\r\n\r\nstatic int count_sheet_lines(void) {\r\n    const char *s = sheet_view();\r\n    int n = 0;\r\n    int nonempty = 0;\r\n    for (; *s; s++) {\r\n        if (*s == '\\n') {\r\n            if (nonempty) n++;\r\n            nonempty = 0;\r\n        } else if (*s != ' ' && *s != '\\r') nonempty = 1;\r\n    }\r\n    if (nonempty) n++;\r\n    return n;\r\n}\r\n\r\nint count_gap(void) {\r\n    int a = count_sheet_lines();\r\n    int b = count_emitters();\r\n    return (b < a) ? 1 : 0;\r\n}\r\n"]
[15.33149, "o", "===== /app/millscore/tally.h =====\r\n"]
[15.332701, "o", "#ifndef TALLY_H\r\n#define TALLY_H\r\nint count_gap(void);\r\n#endif\r\n"]
[15.332898, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# "]
[16.121766, "i", "for f in notes/*.txt; do echo \"===== $f =====\"; cat \"$f\"; done; echo '===== make recipes ====='; sed -n l Makefile\n"]
[16.122831, "o", "for f in notes/*.txt; do echo \"===== $f =====\"; cat \"$f\"; done; echo '===== make recipes ====='; sed -n l Makefile\r\n\u001b[?2004l\r"]
[16.124035, "o", "===== notes/forms.txt =====\r\n"]
[16.127058, "o", "Event descriptions use NAME then FIELD lines. Ledger is name|relpath|field:kind,... .\r\nKDEC files start with KDEC1. Decode JSON uses kind decoded or unknown.\r\nDecode fields object keys are the FIELD names from that description (for example latch, force, amp, bit, thick, mm, q, n, w).\r\n"]
[16.128517, "o", "===== notes/layout.txt =====\r\n"]
[16.129539, "o", "evd holds descriptions. intake/current.ledger is the mill roster. emitters hold kdec tables.\r\nframes hold packed samples. forgekit is the C pipeline.\r\n"]
[16.129779, "o", "===== notes/ops.txt =====\r\n"]
[16.130844, "o", "After adding a description, the first mill may still leave decode unknown until the intake sheet matches what discovery wrote.\r\nUnknown decode is normal for frames that have no description on this bench.\r\n"]
[16.131061, "o", "===== make recipes =====\r\n"]
[16.132296, "o", "CC ?= gcc$\r\nCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore$\r\nSRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)$\r\nBIN := /app/bin/rivetbay$\r\n$\r\n.PHONY: hull$\r\nhull:$\r\n\\tmkdir -p /app/bin$\r\n\\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)$\r\n"]
[16.132567, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# "]
[29.493602, "i", "python3 - <<'PY'\np='forgekit/driver.c'\ns=open(p).read()\ns=s.replace('        discover_all();\\n        pour_sheet();', '        discover_all();\\n        grab_sheet();\\n        pour_sheet();')\nopen(p,'w').write(s)\n\np='forgekit/emit.c'\ns=open(p).read()\ns=s.replace('#include <stdio.h>\\n', '#include <stdio.h>\\n#include <dirent.h>\\n#include <unistd.h>\\n')\nold='void emit_all(void) {\\n    const char *blob = sheet_view();'\nnew='''static void clear_emitters(void) {\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\n    if (!d) return;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len <= 5 || strcmp(ent->d_name + len - 5, \".kdec\") != 0) continue;\n        char path[512];\n        snprintf(path, sizeof(path), \"/app/rivetbay/emitters/%s\", ent->d_name);\n        unlink(path);\n    }\n    closedir(d);\n}\n\nvoid emit_all(void) {\n    clear_emitters();\n    const char *blob = sheet_view();'''\nif old not in s:\n    raise SystemExit('emit insertion point not found')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\nmake hull\n"]
[29.495357, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.496305, "o", "p='forgekit/driver.c'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.502191, "o", "s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('        discover_all();\\n        pour_sheet();', '        discover_all();\\n        grab_sheet();\\n        pour_sheet();')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p='forgekit/emit.c'\r\n"]
[29.505623, "o", "\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('#include <stdio.h>\\n', '#include <stdio.h>\\n#include <dirent.h>\\n#include <unistd.h>\\n')\r\n\u001b[?2004l\r\u001b[?2004h> old='void emit_all(void) {\\n    const char *blob = sheet_view();'\r\n\u001b[?2004l\r\u001b[?2004h> new='''static void clear_emitters(void) {\r\n\u001b[?2004l\r\u001b[?2004h>     DIR *d = opendir(\"/app/rivetbay/emitters\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!d) return;\r\n\u001b[?2004l\r\u001b[?2004h>     struct dirent *ent;\r\n\u001b[?2004l\r\u001b[?2004h>     while ((ent = readdir(d)) != NULL) {\r\n\u001b[?2004l\r\u001b[?2004h>         size_t len = strlen(ent->d_name);\r\n\u001b[?2004l\r\u001b[?2004h>         if (len <= 5 || strcmp(ent->d_name + len - 5, \".kdec\") != 0) continue;\r\n\u001b[?2004l\r\u001b[?2004h>         char path[512];\r\n\u001b[?2004l\r\u001b[?2004h>         snprintf(path, sizeof(path), \"/app/rivetbay/emitters/%s\", ent->d_name);\r\n\u001b[?2004l\r\u001b[?2004h>         unlink(path);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     closedir(d);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void emit_all(void) {\r\n\u001b[?2004l\r\u001b[?2004h>     clear_emitters();\r\n\u001b[?2004l\r\u001b[?2004h>     const char *blob = sheet_view();'''\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.505701, "o", "    raise SystemExit('emit insertion point not found')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[29.549206, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# make hull\r\n\u001b[?2004l\r"]
[29.555673, "o", "mkdir -p /app/bin\r\n"]
[29.560388, "o", "cc -O2 -Wall -Wextra -Iforgekit -I/app/millscore -o /app/bin/rivetbay forgekit/decode.c forgekit/discover.c forgekit/driver.c forgekit/emit.c forgekit/parse_evd.c forgekit/snapshot.c forgekit/utf_tidy.c forgekit/warmup.c /app/millscore/tally.c\r\n"]
[30.092352, "o", "\u001b[01m\u001b[Kforgekit/emit.c:\u001b[m\u001b[K In function ‘\u001b[01m\u001b[Kemit_all\u001b[m\u001b[K’:\r\n"]
[30.092593, "o", "\u001b[01m\u001b[Kforgekit/emit.c:23:58:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K‘\u001b[01m\u001b[K%s\u001b[m\u001b[K’ directive output may be truncated writing up to 1023 bytes into a region of size 489 [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wformat-truncation=\u0007-Wformat-truncation=\u001b]8;;\u0007\u001b[m\u001b[K]\r\n   15 |     char *name = \u001b[32m\u001b[Ktmp\u001b[m\u001b[K;\r\n      |                  \u001b[32m\u001b[K~~~\u001b[m\u001b[K                                      \r\n......\r\n   23 |     snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/\u001b[01;35m\u001b[K%s\u001b[m\u001b[K.kdec\", name);\r\n      |                                                          \u001b[01;35m\u001b[K^~\u001b[m\u001b[K\r\nIn function ‘\u001b[01m\u001b[Kemit_one\u001b[m\u001b[K’,\r\n    inlined from ‘\u001b[01m\u001b[Kemit_all\u001b[m\u001b[K’ at \u001b[01m\u001b[Kforgekit/emit.c:60:22\u001b[m\u001b[K:\r\n\u001b[01m\u001b[Kforgekit/emit.c:23:5:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K‘\u001b[01m\u001b[Ksnprintf\u001b[m\u001b[K’ output between 29 and 1052 bytes into a destination of size 512\r\n   23 |     \u001b[01;36m\u001b[Ksnprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name)\u001b[m\u001b[K;\r\n      |     \u001b[01;36m\u001b[K^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[m\u001b[K\r\n"]
[30.443666, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# "]
[31.327773, "i", "/app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo '--- ledger'; cat intake/current.ledger; echo '--- emitter names'; find emitters -maxdepth 1 -type f -name '*.kdec' -printf '%f\\n' | sort; echo '--- galley decoder'; cat emitters/galley_hatch.kdec; echo '--- decode'; /app/bin/rivetbay decode frames/galley_hatch.bin\n"]
[31.330042, "o", "/app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo '--- ledger'; cat intake/current.ledger; echo '--- emitter names'; find emitters -maxdepth 1 -type f -name '*.kdec' -printf '%f\\n' | sort; echo '--- galley decoder'; cat emitters/galley_hatch.kdec; echo '--- decode'; /app/bin/rivetbay decode frames/galley_hatch.bin\r\n\u001b[?2004l\r"]
[31.333066, "o", "mill_rc=0\r\n--- ledger\r\n"]
[31.336073, "o", "brake_temp|evd/brake_temp.evd|cdeg:u16\r\ngalley_hatch|evd/galley_hatch.evd|latch:u8,force:u16\r\ndoor_seal|evd/door_seal.evd|ok:u8\r\nfuel_flow|evd/fuel_flow.evd|rate:u16,tank:u8\r\npitot_heat|evd/pitot_heat.evd|watts:u16\r\nwing_ice|evd/wing_ice.evd|thick:u16\r\naileron_pos|evd/aileron_pos.evd|deg:u16,side:u8\r\nnav_lamp|evd/nav_lamp.evd|color:u8\r\n--- emitter names\r\n"]
[31.340071, "o", "aileron_pos.kdec\r\nbrake_temp.kdec\r\ndoor_seal.kdec\r\nfuel_flow.kdec\r\ngalley_hatch.kdec\r\nnav_lamp.kdec\r\npitot_heat.kdec\r\nwing_ice.kdec\r\n--- galley decoder\r\n"]
[31.341614, "o", "KDEC1\r\nNAME galley_hatch\r\nlatch u8\r\nforce u16\r\n"]
[31.341937, "o", "--- decode\r\n"]
[31.344358, "o", "{\"kind\":\"decoded\",\"name\":\"galley_hatch\",\"fields\":{\"latch\":1,\"force\":44}}\r\n"]
[31.344523, "o", "\u001b[?2004hroot@25bfdc9e9769:/app/rivetbay# "]
[50.978081, "i", "cat > evd/first_pass_probe.evd <<'EOF'\nNAME first_pass_probe\nFIELD mm u16\nFIELD bit u8\nEOF\npython3 - <<'PY'\nimport struct\nname=b'first_pass_probe'\nopen('frames/first_pass_probe.bin','wb').write(struct.pack('>I',len(name))+name+struct.pack('>HB',513,7))\nPY\n/app/bin/rivetbay mill; rc=$?; echo \"probe_mill_rc=$rc\"; test -f emitters/first_pass_probe.kdec && cat emitters/first_pass_probe.kdec; /app/bin/rivetbay decode frames/first_pass_probe.bin\n"]
[50.97852, "o", "cat > evd/first_pass_probe.evd <<'EOF'\r\n"]
