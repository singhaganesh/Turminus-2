or::new(io::ErrorKind::AlreadyExists, "cannot allocate temporary card"))\n}\nEOF\ncat > /app/tplfold/gather.rs <<\'EOF\'\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\n    if nm.contains([\'\\n\', \'\\r\']) || verb.contains([\'\\n\', \'\\r\']) {\n        return 1;\n    }\n    let card = format!(\n        "FIN1\\nthread={}\\nop={}\\nEND\\n",\n        crate::fmt::keep_token(nm),\n        crate::fmt::keep_token(verb)\n    );\n    let _ = hard;\n    match crate::spool::write_whole(dest, card.as_bytes()) {\n        Ok(()) => 0,\n        Err(_) => 1,\n    }\n}\nEOF\ncp /app/tplfold/gather.rs /app/tplfold/live.rs\ncat > /app/scanpit/peek.rs <<\'EOF\'\nuse std::fs;\n\nconst SHAPE: &str = include_str!("/app/vatnote/FORMAT.txt");\n\npub fn show(p: &str) -> i32 {\n    let _ = SHAPE.len();\n    let raw = match fs::read(p) {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    let text = match std::str::from_utf8(&raw) {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    if !text.ends_with(\'\\n\') || text.contains(\'\\r\') {\n        return 1;\n    }\n    let lines: Vec<&str> = text.strip_suffix(\'\\n\').unwrap().split(\'\\n\').collect();\n    if lines.len() != 4 || lines[0] != "FIN1" || lines[3] != "END" {\n        return 1;\n    }\n    let thread = match lines[1].strip_prefix("thread=") {\n        Some(v) => v,\n        None => return 1,\n    };\n    let op = match lines[2].strip_prefix("op=") {\n        Some(v) => v,\n        None => return 1,\n    };\n    if lines[1] != format!("thread={}", crate::fmt::keep_token(thread))\n        || lines[2] != format!("op={}", crate::fmt::keep_token(op)) {\n        return 1;\n    }\n    print!("{}", text);\n    0\n}\nEOF\ncat > /app/fincli/boot.rs <<\'EOF\'\n#[path = "/app/hookvat/spool.rs"]\nmod spool;\n#[path = "/app/hookvat/seal.rs"]\nmod seal;\n#[path = "/app/hookvat/open.rs"]\nmod open;\n#[path = "/app/hookvat/gen_emit.rs"]\nmod emit;\n#[path = "/app/scanpit/peek.rs"]\nmod peek;\n#[path = "/app/scanpit/fmt.rs"]\nmod fmt;\n\nuse std::env;\nuse std::process;\n\nconst SHIFT: &str = include_str!("/app/opsleaf/SHIFT.txt");\n\nfn usage() -> ! {\n    eprintln!("usage: finspool knit|sting|ease|look");\n    let _ = SHIFT.len();\n    process::exit(2)\n}\n\nfn main() {\n    let args: Vec<String> = env::args().skip(1).collect();\n    match args.first().map(String::as_str) {\n        Some("knit") if args.len() == 1 => {\n            let st = process::Command::new("/app/hull.sh").status();\n            process::exit(if st.map(|s| s.success()).unwrap_or(false) { 0 } else { 1 });\n        }\n        Some("look") if args.len() == 2 => process::exit(peek::show(&args[1])),\n        Some("ease") | Some("sting") if args.len() == 4 => {\n            if !open::under_root(&args[3]) {\n                process::exit(1);\n            }\n            if emit::go(&args[1], &args[2], &args[3], args[0] == "sting") != 0 {\n                process::exit(2);\n            }\n            if args[0] == "sting" {\n                process::abort();\n            }\n        }\n        _ => usage(),\n    }\n}\nEOF\n/app/hull.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
