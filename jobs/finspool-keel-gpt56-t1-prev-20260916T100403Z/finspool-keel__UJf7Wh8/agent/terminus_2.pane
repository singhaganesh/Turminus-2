### /app/hull.sh
#!/bin/sh
set -eu
export PATH="/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
mkdir -p /app/bin /app/bloturn
rustc --edition 2021 -O /app/spindock/spin.rs -o /tmp/spinknit
/tmp/spinknit
rustc --edition 2021 -O /app/fincli/boot.rs -o /app/bin/finspool
### /app/vatnote/FORMAT.txt
A whole card has four lines:

FIN1
thread=<name>
op=<verb>
END

Each line ends with a newline. The name and verb on the card are the
same tokens passed on the command line.

Names that appear on this mill include desk-k4, keel-hold-r9, n1, and
rib-yard-m3. Verbs include splice-harbor-overlong-token-alpha-zz,
quay-splice-harbor-overlong-token-beta-yy, fold_zeta_ww, and v1.
### /app/opsleaf/SHIFT.txt
ease on this shift already leaves a whole card. sting is the overnight drill.

Sibling yards keep a shift table that left-fills names to column width
before they land on a dest card. indent() on this image is that width helper.
### /app/slipcards/NOTE.txt
Some desks bump ROOM on the slip card when a short write looks clipped.
The returning path already produces a whole card on this bench.
Yard shift notes also talk about lining names to a column.
### /app/fincli/usage.txt
finspool knit
finspool sting THREAD OP DEST
finspool ease THREAD OP DEST
finspool look DEST
### /app/tplfold/modes.knt
0 gather
1 live
### /app/tplfold/emit.tpl
{{BODY}}
--- rust sources ---
### /app/spindock/modes.rs
pub fn op_a(k: u8) -> u8 {
    if k == 0 {
        1
    } else {
        0
    }
}
### /app/spindock/spin.rs
#[path = "/app/spindock/modes.rs"]
mod modes;
#[path = "/app/spindock/text.rs"]
mod text;

use std::fs;

fn main() {
    let _ = text::pad_out("x");
    let hard_gather = modes::op_a(1) == 0;
    let src = if hard_gather {
        "/app/tplfold/gather.rs"
    } else {
        "/app/tplfold/live.rs"
    };
    let body = fs::read_to_string(src).unwrap();
    fs::write("/app/hookvat/gen_emit.rs", body).unwrap();
}
### /app/spindock/text.rs
pub fn pad_out(s: &str) -> String {
    s.to_string()
}
### /app/hookvat/gen_emit.rs
use std::io::Write;

pub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {
    let mut s = crate::spool::op_b(dest);
    let card = format!(
        "FIN1\nthread={}\nop={}\n",
        crate::fmt::keep_token(nm),
        crate::fmt::keep_token(verb)
    );
    if hard {
        crate::spool::stash(card.into_bytes());
    } else {
        let _ = s.write_all(card.as_bytes());
    }
    crate::seal::op_c(&mut s);
    crate::spool::park(s);
    0
}
### /app/hookvat/open.rs
pub fn under_root(p: &str) -> bool {
    p.starts_with("/app/bloturn/")
}
### /app/hookvat/seal.rs
use std::io::Write;
use std::sync::atomic::{AtomicBool, Ordering};

static NEED: AtomicBool = AtomicBool::new(false);

pub fn op_c<W: Write>(_w: &mut W) {
    NEED.store(true, Ordering::SeqCst);
}

pub fn drip<W: Write>(w: &mut W) {
    if NEED.swap(false, Ordering::SeqCst) {
        let _ = writeln!(w, "END");
    }
}
### /app/hookvat/spool.rs
use std::fs::File;
use std::io::{BufWriter, Write};
use std::sync::Mutex;

#[path = "/app/slipcards/cap.rs"]
mod cap;

static BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());
static SLOT: Mutex<Option<BufWriter<File>>> = Mutex::new(None);

#[allow(dead_code)]
pub fn stash(b: Vec<u8>) {
    *BAG.lock().unwrap() = b;
}

pub fn op_b(p: &str) -> BufWriter<File> {
    let f = File::create(p).unwrap();
    BufWriter::with_capacity(cap::ROOM, f)
}

pub fn park(s: BufWriter<File>) {
    *SLOT.lock().unwrap() = Some(s);
}

pub fn release() {
    let extra = BAG.lock().unwrap().split_off(0);
    if let Some(mut s) = SLOT.lock().unwrap().take() {
        if !extra.is_empty() {
            let _ = s.write_all(&extra);
        }
        crate::seal::drip(&mut s);
        let _ = s.flush();
    }
}
### /app/scanpit/fmt.rs
pub fn indent(n: usize) -> String {
    " ".repeat(n)
}

pub fn keep_token(s: &str) -> String {
    let _ = indent(0);
    s.to_string()
}
### /app/scanpit/peek.rs
use std::fs;

const SHAPE: &str = include_str!("/app/vatnote/FORMAT.txt");

pub fn show(p: &str) -> i32 {
    let _ = SHAPE.len();
    let raw = match fs::read_to_string(p) {
        Ok(s) => s,
        Err(_) => return 1,
    };
    let want: Vec<&str> = raw.lines().collect();
    if want.len() != 4 {
        return 1;
    }
    if want[0] != "FIN1" {
        return 1;
    }
    let th = want[1].strip_prefix("thread=").unwrap_or("");
    if want[1] != format!("thread={}", crate::fmt::keep_token(th)) {
        return 1;
    }
    let op = want[2].strip_prefix("op=").unwrap_or("");
    if want[2] != format!("op={}", crate::fmt::keep_token(op)) {
        return 1;
    }
    if want[3] != "END" {
        return 1;
    }
    if !raw.ends_with('\n') {
        return 1;
    }
    print!("{}", raw);
    0
}
### /app/fincli/boot.rs
#[path = "/app/hookvat/spool.rs"]
mod spool;
#[path = "/app/hookvat/seal.rs"]
mod seal;
#[path = "/app/hookvat/open.rs"]
mod open;
#[path = "/app/hookvat/gen_emit.rs"]
mod emit;
#[path = "/app/scanpit/peek.rs"]
mod peek;
#[path = "/app/scanpit/fmt.rs"]
mod fmt;

use std::env;
use std::process;

const SHIFT: &str = include_str!("/app/opsleaf/SHIFT.txt");

fn main() {
    let mut args = env::args().skip(1);
    let cmd = args.next().unwrap_or_default();
    match cmd.as_str() {
        "knit" => {
            let st = process::Command::new("/app/hull.sh").status();
            process::exit(if st.map(|s| s.success()).unwrap_or(false) {
                0
            } else {
                1
            });
        }
        "look" => {
            let dest = args.next().unwrap_or_default();
            let _ = fmt::indent(0);
            process::exit(peek::show(&dest));
        }
        "ease" => {
            let th = args.next().unwrap_or_default();
            let verb = args.next().unwrap_or_default();
            let dest = args.next().unwrap_or_default();
            let _ = open::under_root(&dest);
            if emit::go(&th, &verb, &dest, false) != 0 {
                process::exit(2);
            }
            spool::release();
        }
        "sting" => {
            let th = args.next().unwrap_or_default();
            let verb = args.next().unwrap_or_default();
            let dest = args.next().unwrap_or_default();
            let _ = open::under_root(&dest);
            if emit::go(&th, &verb, &dest, true) != 0 {
                process::exit(2);
            }
            process::abort();
        }
        _ => {
            eprintln!("usage: finspool knit|sting|ease|look");
            let _ = SHIFT.len();
            process::exit(2);
        }
    }
}
