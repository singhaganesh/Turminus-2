[16.266278, "o", "-rwxr-xr-x 1 root root 4077688 Sep 16 05:52 /app/bin/finspool\r\n-rwxrwxr-x 1 root root     265 Sep 15 17:06 /app/hull.sh\r\n"]
[16.267959, "o", " 7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\r\n"]
[16.268148, "o", "--- docs/build/templates ---\r\n"]
[16.268287, "o", "### /app/hull.sh\r\n"]
[16.272242, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/bloturn\r\nrustc --edition 2021 -O /app/spindock/spin.rs -o /tmp/spinknit\r\n/tmp/spinknit\r\nrustc --edition 2021 -O /app/fincli/boot.rs -o /app/bin/finspool\r\n"]
[16.272596, "o", "### /app/vatnote/FORMAT.txt\r\n"]
[16.274005, "o", "A whole card has four lines:\r\n\r\nFIN1\r\nthread=<name>\r\nop=<verb>\r\nEND\r\n\r\nEach line ends with a newline. The name and verb on the card are the\r\nsame tokens passed on the command line.\r\n\r\nNames that appear on this mill include desk-k4, keel-hold-r9, n1, and\r\nrib-yard-m3. Verbs include splice-harbor-overlong-token-alpha-zz,\r\nquay-splice-harbor-overlong-token-beta-yy, fold_zeta_ww, and v1.\r\n"]
[16.274392, "o", "### /app/opsleaf/SHIFT.txt\r\n"]
[16.275547, "o", "ease on this shift already leaves a whole card. sting is the overnight drill.\r\n\r\nSibling yards keep a shift table that left-fills names to column width\r\nbefore they land on a dest card. indent() on this image is that width helper.\r\n"]
[16.275715, "o", "### /app/slipcards/NOTE.txt\r\n"]
[16.276792, "o", "Some desks bump ROOM on the slip card when a short write looks clipped.\r\nThe returning path already produces a whole card on this bench.\r\nYard shift notes also talk about lining names to a column.\r\n"]
[16.277024, "o", "### /app/fincli/usage.txt\r\n"]
[16.278215, "o", "finspool knit\r\nfinspool sting THREAD OP DEST\r\nfinspool ease THREAD OP DEST\r\nfinspool look DEST\r\n"]
[16.27846, "o", "### /app/tplfold/modes.knt\r\n"]
[16.280061, "o", "0 gather\r\n1 live\r\n"]
[16.280499, "o", "### /app/tplfold/emit.tpl\r\n"]
[16.282111, "o", "{{BODY}}\r\n"]
[16.282421, "o", "--- rust sources ---\r\n"]
[16.282531, "o", "### /app/spindock/modes.rs\r\n"]
[16.284186, "o", "pub fn op_a(k: u8) -> u8 {\r\n    if k == 0 {\r\n        1\r\n    } else {\r\n        0\r\n    }\r\n}\r\n"]
[16.284477, "o", "### /app/spindock/spin.rs\r\n"]
[16.286607, "o", "#[path = \"/app/spindock/modes.rs\"]\r\nmod modes;\r\n#[path = \"/app/spindock/text.rs\"]\r\nmod text;\r\n\r\nuse std::fs;\r\n\r\nfn main() {\r\n    let _ = text::pad_out(\"x\");\r\n    let hard_gather = modes::op_a(1) == 0;\r\n    let src = if hard_gather {\r\n        \"/app/tplfold/gather.rs\"\r\n    } else {\r\n        \"/app/tplfold/live.rs\"\r\n    };\r\n    let body = fs::read_to_string(src).unwrap();"]
[16.287139, "o", "\r\n    fs::write(\"/app/hookvat/gen_emit.rs\", body).unwrap();\r\n}\r\n"]
[16.287251, "o", "### /app/spindock/text.rs\r\n"]
[16.288918, "o", "pub fn pad_out(s: &str) -> String {\r\n    s.to_string()\r\n}\r\n"]
[16.28925, "o", "### /app/hookvat/gen_emit.rs\r\n"]
[16.290837, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n        crate::fmt::keep_token(verb)\r\n    );\r\n    if hard {\r\n        crate::spool::stash(card.into_bytes());\r\n    } else {\r\n"]
[16.291034, "o", "        let _ = s.write_all(card.as_bytes());\r\n    }\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    0\r\n}\r\n"]
[16.291232, "o", "### /app/hookvat/open.rs\r\n"]
[16.292807, "o", "pub fn under_root(p: &str) -> bool {\r\n    p.starts_with(\"/app/bloturn/\")\r\n}\r\n"]
[16.293051, "o", "### /app/hookvat/seal.rs\r\n"]
[16.2942, "o", "use std::io::Write;\r\nuse std::sync::atomic::{AtomicBool, Ordering};\r\n\r\nstatic NEED: AtomicBool = AtomicBool::new(false);\r\n\r\npub fn op_c<W: Write>(_w: &mut W) {\r\n    NEED.store(true, Ordering::SeqCst);\r\n}\r\n\r\n"]
[16.294283, "o", "pub fn drip<W: Write>(w: &mut W) {\r\n    if NEED.swap(false, Ordering::SeqCst) {\r\n        let _ = writeln!(w, \"END\");\r\n    }\r\n}\r\n"]
[16.294452, "o", "### /app/hookvat/spool.rs\r\n"]
[16.297162, "o", "use std::fs::File;\r\nuse std::io::{BufWriter, Write};\r\nuse std::sync::Mutex;\r\n\r\n#[path = \"/app/slipcards/cap.rs\"]\r\nmod cap;\r\n\r\nstatic BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());\r\nstatic SLOT: Mutex<Option<BufWriter<File>>> = Mutex::new(None);\r\n\r\n#[allow(dead_code)]\r\npub fn stash(b: Vec<u8>) {\r\n    *BAG.lock().unwrap() = b;\r\n}\r\n\r\npub fn op_b(p: &str) -> BufWriter<File> {\r\n"]
[16.297219, "o", "    let f = File::create(p).unwrap();\r\n    BufWriter::with_capacity(cap::ROOM, f)\r\n}\r\n\r\npub fn park(s: BufWriter<File>) {\r\n    *SLOT.lock().unwrap() = Some(s);\r\n}\r\n\r\npub fn release() {\r\n    let extra = BAG.lock().unwrap().split_off(0);\r\n    if let Some(mut s) = SLOT.lock().unwrap().take() {\r\n        if !extra.is_empty() {\r\n            let _ = s.write_all(&extra);\r\n        }\r\n        crate::seal::drip(&mut s);\r\n        let _ = s.flush();\r\n    }\r\n}\r\n"]
[16.297562, "o", "### /app/scanpit/fmt.rs\r\n"]
[16.298996, "o", "pub fn indent(n: usize) -> String {\r\n    \" \".repeat(n)\r\n}\r\n\r\npub fn keep_token(s: &str) -> String {\r\n    let _ = indent(0);\r\n    s.to_string()\r\n}\r\n"]
[16.299411, "o", "### /app/scanpit/peek.rs\r\n"]
[16.301223, "o", "use std::fs;\r\n\r\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\r\n\r\npub fn show(p: &str) -> i32 {\r\n    let _ = SHAPE.len();\r\n    let raw = match fs::read_to_string(p) {\r\n        Ok(s) => s,\r\n        Err(_) => return 1,\r\n    };\r\n    let want: Vec<&str> = raw.lines().collect();\r\n    if want.len() != 4 {\r\n        return 1;\r\n    }\r\n    if want[0] != \"FIN1\" {\r\n        return 1;\r\n    }\r\n    let th = want[1].strip_prefix(\"thread=\").unwrap_or(\"\");\r\n    if want[1] != format!(\"thread={}\", crate::fmt::keep_token(th)) {\r\n        return 1;\r\n    }\r\n"]
[16.301372, "o", "    let op = want[2].strip_prefix(\"op=\").unwrap_or(\"\");\r\n    if want[2] != format!(\"op={}\", crate::fmt::keep_token(op)) {\r\n        return 1;\r\n    }\r\n    if want[3] != \"END\" {\r\n        return 1;\r\n    }\r\n    if !raw.ends_with('\\n') {\r\n        return 1;\r\n    }\r\n    print!(\"{}\", raw);\r\n    0\r\n}\r\n"]
[16.301607, "o", "### /app/fincli/boot.rs\r\n"]
[16.30295, "o", "#[path = \"/app/hookvat/spool.rs\"]\r\nmod spool;\r\n#[path = \"/app/hookvat/seal.rs\"]\r\nmod seal;\r\n#[path = \"/app/hookvat/open.rs\"]\r\nmod open;\r\n#[path = \"/app/hookvat/gen_emit.rs\"]\r\nmod emit;\r\n#[path = \"/app/scanpit/peek.rs\"]\r\nmod peek;\r\n"]
[16.302985, "o", "#[path = \"/app/scanpit/fmt.rs\"]\r\nmod fmt;\r\n\r\nuse std::env;\r\n"]
[16.302999, "o", "use std::process;\r\n\r\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\r\n"]
[16.303012, "o", "\r\nfn main() {\r\n    let mut args = env::args().skip(1);\r\n    let cmd = args.next().unwrap_or_default();\r\n    match cmd.as_str() {"]
[16.30303, "o", "\r\n        \"knit\" => {\r\n            let st = process::Command::new(\"/app/hull.sh\").status();\r\n            process::exit(if st.map(|s| s.success()).unwrap_or(false) {\r\n                0\r\n            } else {\r\n"]
[16.303044, "o", "                1\r\n            });\r\n        }\r\n        \"look\" => {\r\n            let dest = args.next().unwrap_or_default();\r\n"]
[16.303055, "o", "            let _ = fmt::indent(0);\r\n            process::exit(peek::show(&dest));\r\n        }\r\n        \"ease\" => {\r\n"]
[16.303077, "o", "            let th = args.next().unwrap_or_default();\r\n            let verb = args.next().unwrap_or_default();\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = open::under_root(&dest);\r\n            if emit::go(&th, &verb, &dest, false) != 0 {\r\n                process::exit(2);\r\n            }\r\n"]
[16.303089, "o", "            spool::release();\r\n        }\r\n        \"sting\" => {\r\n            let th = args.next().unwrap_or_default();\r\n"]
[16.303105, "o", "            let verb = args.next().unwrap_or_default();\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = open::under_root(&dest);\r\n            if emit::go(&th, &verb, &dest, true) != 0 {\r\n                process::exit(2);\r\n            }\r\n"]
[16.30312, "o", "            process::abort();\r\n        }\r\n        _ => {\r\n            eprintln!(\"usage: finspool knit|sting|ease|look\");\r\n"]
[16.303132, "o", "            let _ = SHIFT.len();\r\n            process::exit(2);\r\n        }\r\n    }\r\n}\r\n"]
[16.303456, "o", "### /app/tplfold/gather.rs\r\n"]
[16.304726, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n        crate::fmt::keep_token(verb)\r\n"]
[16.304871, "o", "    );\r\n    if hard {\r\n        crate::spool::stash(card.into_bytes());\r\n    } else {\r\n        let _ = s.write_all(card.as_bytes());\r\n    }\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    0\r\n}\r\n"]
[16.30516, "o", "### /app/tplfold/live.rs\r\n"]
[16.306502, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n        crate::fmt::keep_token(verb)\r\n    );\r\n    let _ = s.write_all(card.as_bytes());\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    let _ = hard;\r\n    0\r\n}\r\n"]
[16.306774, "o", "### /app/slipcards/cap.rs\r\n"]
[16.307948, "o", "pub const ROOM: usize = 65536;\r\n"]
[16.308198, "o", "\u001b[?2004h"]
[16.308288, "o", "root@505427f54d9f:/app# "]
[53.520448, "i", "cat > /app/hookvat/open.rs <<'EOF'\nuse std::path::Path;\n\npub fn under_root(p: &str) -> bool {\n    let path = Path::new(p);\n    if !path.is_absolute() || path.file_name().is_none() {\n        return false;\n    }\n    let root = match std::fs::canonicalize(\"/app/bloturn\") {\n        Ok(v) => v,\n        Err(_) => return false,\n    };\n    let parent = match path.parent().and_then(|v| std::fs::canonicalize(v).ok()) {\n        Some(v) => v,\n        None => return false,\n    };\n    parent.starts_with(root)\n}\nEOF\ncat > /app/hookvat/spool.rs <<'EOF'\nuse std::fs::{self, File, OpenOptions};\nuse std::io::{self, Write};\nuse std::path::Path;\nuse std::sync::atomic::{AtomicU64, Ordering};\n\nstatic SERIAL: AtomicU64 = AtomicU64::new(0);\n\npub fn write_whole(dest: &str, bytes: &[u8]) -> io::Result<()> {\n    if !crate::open::under_root(dest) {\n        return Err(io::Error::new(io::ErrorKind::PermissionDenied, \"destination outside bloturn\"));\n    }\n    let path = Path::new(dest);\n    let parent = path.parent().ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, \"no parent\"))?;\n    let stem = path.file_name().and_then(|v| v.to_str()).unwrap_or(\"card\");\n\n    for _ in 0..100 {\n        let serial = SERIAL.fetch_add(1, Ordering::Relaxed);\n        let tmp = parent.join(format!(\".{}.{}.{}.tmp\", stem, std::process::id(), serial));\n        let mut file = match OpenOptions::new().write(true).create_new(true).open(&tmp) {\n            Ok(v) => v,\n            Err(e) if e.kind() == io::ErrorKind::AlreadyExists => continue,\n            Err(e) => return Err(e),\n        };\n        let result = (|| {\n            file.write_all(bytes)?;\n            file.flush()?;\n            file.sync_all()?;\n            fs::rename(&tmp, path)?;\n            File::open(parent)?.sync_all()?;\n            Ok(())\n        })();\n        if result.is_err() {\n            let _ = fs::remove_file(&tmp);\n        }\n        return result;\n    }\n    Err(io::Error::new(io::ErrorKind::AlreadyExists, \"cannot allocate temporary card\"))\n}\nEOF\ncat > /app/tplfold/gather.rs <<'EOF'\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\n    if nm.contains(['\\n', '\\r']) || verb.contains(['\\n', '\\r']) {\n        return 1;\n    }\n    let card = format!(\n        \"FIN1\\nthread={}\\nop={}\\nEND\\n\",\n        crate::fmt::keep_token(nm),\n        crate::fmt::keep_token(verb)\n    );\n    let _ = hard;\n    match crate::spool::write_whole(dest, card.as_bytes()) {\n        Ok(()) => 0,\n        Err(_) => 1,\n    }\n}\nEOF\ncp /app/tplfold/gather.rs /app/tplfold/live.rs\ncat > /app/scanpit/peek.rs <<'EOF'\nuse std::fs;\n\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\n\npub fn show(p: &str) -> i32 {\n    let _ = SHAPE.len();\n    let raw = match fs::read(p) {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    let text = match std::str::from_utf8(&raw) {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    if !text.ends_with('\\n') || text.contains('\\r') {\n        return 1;\n    }\n    let lines: Vec<&str> = text.strip_suffix('\\n').unwrap().split('\\n').collect();\n    if lines.len() != 4 || lines[0] != \"FIN1\" || lines[3] != \"END\" {\n        return 1;\n    }\n    let thread = match lines[1].strip_prefix(\"thread=\") {\n        Some(v) => v,\n        None => return 1,\n    };\n    let op = match lines[2].strip_prefix(\"op=\") {\n        Some(v) => v,\n        None => return 1,\n    };\n    if lines[1] != format!(\"thread={}\", crate::fmt::keep_token(thread))\n        || lines[2] != format!(\"op={}\", crate::fmt::keep_token(op)) {\n        return 1;\n    }\n    print!(\"{}\", text);\n    0\n}\nEOF\ncat > /app/fincli/boot.rs <<'EOF'\n#[path = \"/app/hookvat/spool.rs\"]\nmod spool;\n#[path = \"/app/hookvat/seal.rs\"]\nmod seal;\n#[path = \"/app/hookvat/open.rs\"]\nmod open;\n#[path = \"/app/hookvat/gen_emit.rs\"]\nmod emit;\n#[path = \"/app/scanpit/peek.rs\"]\nmod peek;\n#[path = \"/app/scanpit/fmt.rs\"]\nmod fmt;\n\nuse std::env;\nuse std::process;\n\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\n\nfn usage() -> ! {\n    eprintln!(\"usage: finspool knit|sting|ease|look\");\n    let _ = SHIFT.len();\n    process::exit(2)\n}\n\nfn main() {\n    let args: Vec"]
