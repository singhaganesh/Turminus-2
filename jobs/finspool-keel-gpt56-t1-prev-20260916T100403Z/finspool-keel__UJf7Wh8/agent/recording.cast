[16.257935, "i", "printf '%s\\n' '--- metadata ---'; ls -l /app/bin/finspool /app/hull.sh; od -An -tx1 -N16 /app/bin/finspool 2>/dev/null || true; printf '%s\\n' '--- docs/build/templates ---'; for f in /app/hull.sh /app/vatnote/FORMAT.txt /app/opsleaf/SHIFT.txt /app/slipcards/NOTE.txt /app/fincli/usage.txt /app/tplfold/modes.knt /app/tplfold/emit.tpl; do echo \"### $f\"; sed -n '1,240p' \"$f\"; done; printf '%s\\n' '--- rust sources ---'; for f in /app/spindock/*.rs /app/hookvat/*.rs /app/scanpit/*.rs /app/fincli/*.rs /app/tplfold/*.rs /app/slipcards/*.rs; do echo \"### $f\"; sed -n '1,280p' \"$f\"; done\n"]
[16.259719, "o", "printf '%s\\n' '--- metadata ---'; ls -l /app/bin/finspool /app/hull.sh; od -An -tx1 -N16 /app/bin/finspool 2>/dev/null || true; printf '%s\\n' '--- docs/build/templates ---'; for f in /app/hull.sh /app/vatnote/FORMAT.txt /app/opsleaf/SHIFT.txt /app/slipcards/NOTE.txt /app/fincli/usage.txt /app/tplfold/modes.knt /app/tplfold/emit.tpl; do echo \"### $f\"; sed -n '1,240p' \"$f\"; done; printf '%s\\n' '--- rust sources ---'; for f in /app/spindock/*.rs /app/hookvat/*.rs /app/scanpit/*.rs /app/fincli/*.rs /app/tplfold/*.rs /app/slipcards/*.rs; do echo \"### $f\"; sed -n '1,280p' \"$f\"; done\r\n\u001b[?2004l\r"]
