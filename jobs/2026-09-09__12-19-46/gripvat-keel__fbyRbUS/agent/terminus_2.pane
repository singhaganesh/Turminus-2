===== millarm/load.c =====
     1	#include "load.h"
     2	
     3	#include <stdio.h>
     4	#include <stdlib.h>
     5	#include <string.h>
     6	
     7	static Node nodes[MAX_N];
     8	static Edge edges[MAX_E];
     9	static uint32_t sites[MAX_N];
    10	static int nn, ne, ns, ended;
    11	
    12	void load_reset(void)
    13	{
    14		nn = ne = ns = ended = 0;
    15	}
    16	
    17	int load_ended(void)
    18	{
    19		return ended;
    20	}
    21	
    22	int node_n(void) { return nn; }
    23	int edge_n(void) { return ne; }
    24	int site_n(void) { return ns; }
    25	
    26	const Node *node_at(int i) { return &nodes[i]; }
    27	const Edge *edge_at(int i) { return &edges[i]; }
    28	uint32_t site_at(int i) { return sites[i]; }
    29	
    30	int node_index(uint32_t id)
    31	{
    32		int i;
    33	
    34		for (i = 0; i < nn; i++) {
    35			if (nodes[i].id == id)
    36				return i;
    37		}
    38		return -1;
    39	}
    40	
    41	const char *node_cls(uint32_t id)
    42	{
    43		int i = node_index(id);
    44	
    45		if (i < 0)
    46			return "";
    47		return nodes[i].cls;
    48	}
    49	
    50	uint32_t node_bytes(uint32_t id)
    51	{
    52		int i = node_index(id);
    53	
    54		if (i < 0)
    55			return 0;
    56		return nodes[i].bytes;
    57	}
    58	
    59	int load_card(const char *path)
    60	{
    61		FILE *fp;
    62		char line[256];
    63		char a[64], b[64], c[64];
    64		uint32_t x, y, z;
    65	
    66		load_reset();
    67		fp = fopen(path, "r");
    68		if (!fp)
    69			return -1;
    70		if (!fgets(line, sizeof(line), fp)) {
    71			fclose(fp);
    72			return -1;
    73		}
    74		if (strncmp(line, "HPK1", 4) != 0) {
    75			fclose(fp);
    76			return -1;
    77		}
    78		while (fgets(line, sizeof(line), fp)) {
    79			if (strncmp(line, "END", 3) == 0) {
    80				ended = 1;
    81				break;
    82			}
    83			if (sscanf(line, "NODE %u %31s %u", &x, a, &z) == 3) {
    84				if (nn >= MAX_N) {
    85					fclose(fp);
    86					return -1;
    87				}
    88				nodes[nn].id = x;
    89				strncpy(nodes[nn].cls, a, MAX_S - 1);
    90				nodes[nn].cls[MAX_S - 1] = 0;
    91				nodes[nn].bytes = z;
    92				nn++;
    93				continue;
    94			}
    95			if (sscanf(line, "EDGE %u %u %31s %31s", &x, &y, b, c) == 4) {
    96				if (ne >= MAX_E) {
    97					fclose(fp);
    98					return -1;
    99				}
   100				edges[ne].from = x;
   101				edges[ne].to = y;
   102				edges[ne].kind = (strcmp(b, "STRONG") == 0) ? KIND_STRONG : KIND_WEAK;
   103				strncpy(edges[ne].field, c, MAX_S - 1);
   104				edges[ne].field[MAX_S - 1] = 0;
   105				ne++;
   106				continue;
   107			}
   108			if (sscanf(line, "ROOT %u %31s", &x, a) == 2) {
   109				(void)a;
   110				continue;
   111			}
   112			if (sscanf(line, "SITE %u", &x) == 1) {
   113				if (ns >= MAX_N) {
   114					fclose(fp);
   115					return -1;
   116				}
   117				sites[ns++] = x;
   118				continue;
   119			}
   120		}
   121		fclose(fp);
   122		return 0;
   123	}
