    28	uint32_t site_at(int i) { return sites[i]; }
    29	
    30	int node_index(uint32_t id)
    31	{
    32		int i;
    33	
    34		for (i = 0; i < nn; i++) {
    35			if (nodes[i].id == id)
    36				return i;
    37		}
    38		return -1;
    39	}
    40	
    41	const char *node_cls(uint32_t id)
    42	{
    43		int i = node_index(id);
    44	
    45		if (i < 0)
    46			return "";
    47		return nodes[i].cls;
    48	}
    49	
    50	uint32_t node_bytes(uint32_t id)
    51	{
    52		int i = node_index(id);
    53	
    54		if (i < 0)
    55			return 0;
    56		return nodes[i].bytes;
    57	}
    58	
    59	int load_card(const char *path)
    60	{
    61		FILE *fp;
    62		char line[256];
    63		char a[64], b[64], c[64];
    64		uint32_t x, y, z;
    65	
    66		load_reset();
    67		fp = fopen(path, "r");
    68		if (!fp)
    69			return -1;
    70		if (!fgets(line, sizeof(line), fp)) {
    71			fclose(fp);
    72			return -1;
    73		}
    74		if (strncmp(line, "HPK1", 4) != 0) {
    75			fclose(fp);
    76			return -1;
    77		}
    78		while (fgets(line, sizeof(line), fp)) {
    79			if (strncmp(line, "END", 3) == 0) {
    80				ended = 1;
    81				break;
    82			}
    83			if (sscanf(line, "NODE %u %31s %u", &x, a, &z) == 3) {
    84				if (nn >= MAX_N) {
    85					fclose(fp);
    86					return -1;
    87				}
    88				nodes[nn].id = x;
    89				strncpy(nodes[nn].cls, a, MAX_S - 1);
    90				nodes[nn].cls[MAX_S - 1] = 0;
    91				nodes[nn].bytes = z;
    92				nn++;
    93				continue;
    94			}
    95			if (sscanf(line, "EDGE %u %u %31s %31s", &x, &y, b, c) == 4) {
    96				if (ne >= MAX_E) {
    97					fclose(fp);
    98					return -1;
    99				}
   100				edges[ne].from = x;
   101				edges[ne].to = y;
   102				edges[ne].kind = (strcmp(b, "STRONG") == 0) ? KIND_STRONG : KIND_WEAK;
   103				strncpy(edges[ne].field, c, MAX_S - 1);
   104				edges[ne].field[MAX_S - 1] = 0;
   105				ne++;
   106				continue;
   107			}
   108			if (sscanf(line, "ROOT %u %31s", &x, a) == 2) {
   109				(void)a;
   110				continue;
   111			}
   112			if (sscanf(line, "SITE %u", &x) == 1) {
   113				if (ns >= MAX_N) {
   114					fclose(fp);
   115					return -1;
   116				}
   117				sites[ns++] = x;
   118				continue;
   119			}
   120		}
   121		fclose(fp);
   122		return 0;
   123	}
     1	#include "step.h"
     2	
     3	#include "../millarm/load.h"
     4	#include "../millarm/latch.h"
     5	#include "../rootwell/scan.h"
     6	#include "../softbay/skip.h"
     7	
     8	#include <stdio.h>
     9	#include <stdlib.h>
    10	#include <string.h>
    11	#include <sys/stat.h>
    12	#include <unistd.h>
    13	
    14	#define INF 1000000
    15	
    16	#include "step.inc"
    17	
    18	static Edge *nb[MAX_E];
    19	
    20	static int collect_nb(uint32_t from)
    21	{
    22		int i, n = 0;
    23	
    24		for (i = 0; i < edge_n(); i++) {
    25			const Edge *e = edge_at(i);
    26	
    27			if (e->from != from)
    28				continue;
    29			if (!n_soft(e->kind))
    30				continue;
    31			nb[n++] = (Edge *)e;
    32		}
    33		if (g_latch) {
    34			/* pin flag is accepted; comparator still comes from step.inc */
    35			(void)g_latch;
    36		}
    37		qsort(nb, (size_t)n, sizeof(nb[0]), nbor_ord);
    38		return n;
    39	}
    40	
    41	static void emit_path(FILE *fp, int *pred_e, int site_idx, const char *rk)
    42	{
    43		int chain[MAX_N];
    44		int n = 0;
    45		int cur = site_idx;
    46		int i;
    47	
    48		while (cur >= 0 && n < MAX_N) {
    49			chain[n++] = cur;
    50			if (pred_e[cur] < 0)
    51				break;
    52			cur = node_index(edge_at(pred_e[cur])->from);
    53		}
    54		fprintf(fp, "PATH %s", rk);
    55		for (i = n - 2; i >= 0; i--) {
    56			const Edge *e = edge_at(pred_e[chain[i]]);
    57	
    58			fprintf(fp, ">%s.%s", node_cls(e->to), e->field);
    59		}
    60		fputc('\n', fp);
    61	}
    62	
    63	int run_step(const char *card, const char *ledger)
    64	{
    65		int dist[MAX_N];
    66		int pred_e[MAX_N];
    67		int q[MAX_N];
    68		int qh, qt, i, r, s, si, found;
    69		FILE *fp;
    70		const char *use_rk = "";
    71		int use_site = -1;
    72	
    73		(void)card;
    74		for (i = 0; i < node_n(); i++) {
    75			dist[i] = INF;
    76			pred_e[i] = -1;
    77		}
    78		found = 0;
    79		for (r = 0; r < root_n() && !found; r++) {
    80			int ri = node_index(root_id(r));
    81	
    82			if (ri < 0)
    83				continue;
    84			for (i = 0; i < node_n(); i++) {
    85				dist[i] = INF;
    86				pred_e[i] = -1;
    87			}
    88			qh = qt = 0;
    89			dist[ri] = 0;
    90			q[qt++] = ri;
    91			while (qh < qt) {
    92				int u = q[qh++];
    93				int nn = collect_nb(node_at(u)->id);
    94				int k;
    95	
    96				for (k = 0; k < nn; k++) {
    97					int v = node_index(nb[k]->to);
    98					int nd;
    99	
   100					if (v < 0)
   101						continue;
   102					nd = dist[u] + 1;
   103					if (nd < dist[v]) {
   104						dist[v] = nd;
   105						pred_e[v] = (int)(nb[k] - edge_at(0));
   106						q[qt++] = v;
   107					}
   108				}
   109			}
   110			for (s = 0; s < site_n(); s++) {
   111				si = node_index(site_at(s));
   112				if (si >= 0 && dist[si] < INF) {
   113					found = 1;
   114					use_rk = root_kind(r);
   115					use_site = si;
   116					break;
   117				}
   118			}
   119		}
   120		fp = fopen(ledger, "w");
   121		if (!fp)
   122			return -1;
   123		if (!found) {
   124			fclose(fp);
   125			return -1;
   126		}
   127		fprintf(fp, "SITE %s\n", node_cls(node_at(use_site)->id));
   128		fprintf(fp, "BYTES %u\n", node_bytes(node_at(use_site)->id));
   129		emit_path(fp, pred_e, use_site, use_rk);
   130		fclose(fp);
   131		return 0;
   132	}
static int nbor_ord(const void *x, const void *y)
{
	const Edge *a = *(const Edge * const *)x;
	const Edge *b = *(const Edge * const *)y;
	return (int)a->to - (int)b->to;
}
