    29	
    30	int main(int argc, char **argv)
    31	{
    32		take_latch(argc, argv);
    33		if (argc < 2) {
    34			fputs("usage\n", stderr);
    35			return 2;
    36		}
    37		if (strcmp(argv[1], "mint") == 0) {
    38			const char *card;
