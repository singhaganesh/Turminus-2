    13	static void mark_ok(void)
    14	{
    15		FILE *fp;
    16	
    17		mkdir("/app/inkurn", 0755);
    18		fp = fopen("/app/inkurn/mint.ok", "w");
    19		if (fp) {
    20			fputs("ok\n", fp);
    21			fclose(fp);
