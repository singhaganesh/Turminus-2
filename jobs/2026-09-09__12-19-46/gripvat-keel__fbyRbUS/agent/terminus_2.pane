    43			card = argv[2];
    44			outp = argv[3];
    45			mkdir("/app/inkurn", 0755);
    46			clear_ok();
    47			if (load_card(card) != 0)
    48				return 1;
    49			if (op_root(card) != 0)
    50				return 1;
    51			if (run_step(card, outp) != 0)
    52				return 1;
    53			mark_ok();
    54			return 0;
    55		}
    56		if (strcmp(argv[1], "align") == 0) {
