[48.983936, "o", "     1\t#include \"load.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic Node nodes[MAX_N];\r\n     8\tstatic Edge edges[MAX_E];\r\n     9\tstatic uint32_t sites[MAX_N];\r\n    10\tstatic int nn, ne, ns, ended;\r\n    11\t\r\n    12\tvoid load_reset(void)\r\n    13\t{\r\n    14\t\tnn = ne = ns = ended = 0;\r\n    15\t}\r\n    16\t\r\n    17\tint load_ended(void)\r\n    18\t{\r\n    19\t\treturn ended;\r\n    20\t}\r\n    21\t\r\n    22\tint node_n(void) { return nn; }\r\n    23\tint edge_n(void) { return ne; }\r\n    24\tint site_n(void) { return ns; }\r\n    25\t\r\n    26\tconst Node *node_at(int i) { return &nodes[i]; }\r\n    27\tconst Edge *edge_at(int i) { return &edges[i]; }\r\n    28\tuint32_t site_at(int i) { return sites[i]; }\r\n    29\t\r\n    30\tint node_index(uint32_t id)\r\n    31\t{\r\n    32\t\tint i;\r\n    33\t\r\n    34\t\tfor (i = 0; i < nn; i++) {\r\n    35\t\t\tif (nodes[i].id == id)\r\n    36\t\t\t\treturn i;\r\n    37\t\t}\r\n    38\t\treturn -1;\r\n    39\t}\r\n    40\t\r\n    41\tconst char *node_cls(uint32_t id)\r\n    42\t{\r\n    43\t\tint i = node_index(id);\r\n    44\t\r\n    45\t\tif (i < 0)\r\n    46\t\t\treturn \"\";\r\n    47\t\treturn nodes[i].cls;\r\n    48\t}\r\n    49\t\r\n    50\tuint32_t node_bytes(uint32_t id)\r\n    51\t{\r\n    52\t\tint i = node_index(id);\r\n    53\t\r\n    54\t\tif (i < 0)\r\n    55\t\t\treturn 0;\r\n    56\t\treturn nodes[i].bytes;\r\n    57\t}\r\n    58\t\r\n    59\tint load_card(const char *path)\r\n    60\t{\r\n    61\t\tFILE *fp;\r\n    62\t\tchar line[256];\r\n    63\t\tchar a[64], b[64], c[64];\r\n    64\t\tuint32_t x, y, z;\r\n    65\t\r\n    66\t\tload_reset();\r\n    67\t\tfp = fopen(path, \"r\");\r\n    68\t\tif (!fp)\r\n    69\t\t\treturn -1;\r\n    70\t\tif (!fgets(line, sizeof(line), fp)) {\r\n    71\t\t\tfclose(fp);\r\n    72\t\t\treturn -1;\r\n    73\t\t}\r\n    74\t\tif (strncmp(line, \"HPK1\", 4) != 0) {\r\n    75\t\t\tfclose(fp);\r\n    76\t\t\treturn -1;\r\n    77\t\t}\r\n    78\t\twhile (fgets(line, sizeof(line), fp)) {\r\n    79\t\t\tif (strncmp(line, \"END\", 3) == 0) {\r\n    80\t\t\t\tended = 1;\r\n    81\t\t\t\tbreak;\r\n    82\t\t\t}\r\n    83\t\t\tif (sscanf(line, \"NODE %u %31s %u\", &x, a, &z) == 3) {\r\n    84\t\t\t\tif (nn >= MAX_N) {\r\n    85\t\t\t\t\tfclose(fp);\r\n    86\t\t\t\t\treturn -1;\r\n    87\t\t\t\t}\r\n    88\t\t\t\tnodes[nn].id = x;\r\n    89\t\t\t\tstrncpy(nodes[nn].cls, a, MAX_S - 1);\r\n    90\t\t\t\tnodes[nn].cls[MAX_S - 1] = 0;\r\n    91\t\t\t\tnodes[nn].bytes = z;\r\n    92\t\t\t\tnn++;\r\n    93\t\t\t\tcontinue;\r\n    94\t\t\t}\r\n    95\t\t\tif (sscanf(line, \"EDGE %u %u %31s %31s\", &x, &y, b, c) == 4) {\r\n    96\t\t\t\tif (ne >= MAX_E) {\r\n    97\t\t\t\t\tfclose(fp);\r\n    98\t\t\t\t\treturn -1;\r\n    99\t\t\t\t}\r\n   100\t\t\t\tedges[ne].from = x;\r\n   101\t\t\t\tedges[ne].to = y;\r\n   102\t\t\t\tedges[ne].kind = (strcmp(b, \"STRONG\") == 0) ? KIND_STRONG : KIND_WEAK;\r\n   103\t\t\t\tstrncpy(edges[ne].field, c, MAX_S - 1);\r\n   104\t\t\t\tedges[ne].field[MAX_S - 1] = 0;\r\n   105\t\t\t\tne++;\r\n   106\t\t\t\tcontinue;\r\n   107\t\t\t}\r\n   108\t\t\tif (sscanf(line, \"ROOT %u %31s\", &x, a) == 2) {\r\n   109\t\t\t\t(void)a;\r\n   110\t\t\t\tcontinue;\r\n   111\t\t\t}\r\n   112\t\t\tif (sscanf(line, \"SITE %u\", &x) == 1) {\r\n   113\t\t\t\tif (ns >= MAX_N) {\r\n   114\t\t\t\t\tfclose(fp);\r\n   115\t\t\t\t\treturn -1;\r\n   116\t\t\t\t}\r\n   117\t\t\t\tsites[ns++] = x;\r\n   118\t\t\t\tcontinue;\r\n   119\t\t\t}\r\n   120\t\t}\r\n   121\t\tfclose(fp);\r\n   122\t\treturn 0;\r\n   123\t}\r\n"]
[48.986648, "o", "     1\t#include \"step.h\"\r\n     2\t\r\n     3\t#include \"../millarm/load.h\"\r\n     4\t#include \"../millarm/latch.h\"\r\n     5\t#include \"../rootwell/scan.h\"\r\n     6\t#include \"../softbay/skip.h\"\r\n     7\t\r\n     8\t#include <stdio.h>\r\n     9\t#include <stdlib.h>\r\n    10\t#include <string.h>\r\n    11\t#include <sys/stat.h>\r\n    12\t#include <unistd.h>\r\n    13\t\r\n    14\t#define INF 1000000\r\n    15\t\r\n    16\t#include \"step.inc\"\r\n    17\t\r\n    18\tstatic Edge *nb[MAX_E];\r\n    19\t\r\n    20\tstatic int collect_nb(uint32_t from)\r\n    21\t{\r\n    22\t\tint i, n = 0;\r\n    23\t\r\n    24\t\tfor (i = 0; i < edge_n(); i++) {\r\n    25\t\t\t"]
[48.986717, "o", "const Edge *e = edge_at(i);\r\n    26\t\r\n    27\t\t\tif (e->from != from)\r\n    28\t\t\t\tcontinue;\r\n    29\t\t\tif (!n_soft(e->kind))\r\n    30\t\t\t\tcontinue;\r\n    31\t\t\tnb[n++] = (Edge *)e;\r\n    32\t\t}\r\n    33\t\tif (g_latch) {\r\n    34\t\t\t/* pin flag is accepted; comparator still comes from step.inc */\r\n    35\t\t\t(void)g_latch;\r\n    36\t\t}\r\n    37\t\tqsort(nb, (size_t)n, sizeof(nb[0]), nbor_ord);\r\n    38\t\treturn n;\r\n    39\t}\r\n    40\t\r\n    41\tstatic void emit_path(FILE *fp, int *pred_e, int site_idx, const char *rk)\r\n    42\t{\r\n    43\t\tint chain[MAX_N];\r\n    44\t\tint n = 0;\r\n    45\t\tint cur = site_idx;\r\n    46\t\tint i;\r\n    47\t\r\n    48\t\twhile (cur >= 0 && n < MAX_N) {\r\n    49\t\t\tchain[n++] = cur;\r\n    50\t\t\tif (pred_e[cur] < 0)\r\n    51\t\t\t\tbreak;\r\n"]
[48.986736, "o", "    52\t\t\tcur = node_index(edge_at(pred_e[cur])->from);\r\n    53\t\t}\r\n    54\t\tfprintf(fp, \"PATH %s\", rk);\r\n    55\t\tfor (i = n - 2; i >= 0; i--) {\r\n    56\t\t\tconst Edge *e = edge_at(pred_e[chain[i]]);\r\n"]
[48.986751, "o", "    57\t\r\n    58\t\t\tfprintf(fp, \">%s.%s\", node_cls(e->to), e->field);\r\n    59\t\t}\r\n    60\t\tfputc('\\n', fp);\r\n"]
[48.986767, "o", "    61\t}\r\n    62\t\r\n    63\tint run_step(const char *card, const char *ledger)\r\n    64\t{\r\n    65\t\tint dist[MAX_N];\r\n"]
[48.986783, "o", "    66\t\tint pred_e[MAX_N];\r\n    67\t\tint q[MAX_N];\r\n    68\t\tint qh, qt, i, r, s, si, found;\r\n    69\t\tFILE *fp;\r\n"]
[48.986798, "o", "    70\t\tconst char *use_rk = \"\";\r\n    71\t\tint use_site = -1;\r\n    72\t\r\n    73\t\t(void)card;\r\n    74\t\tfor (i = 0; i < node_n(); i++) {\r\n"]
[48.986812, "o", "    75\t\t\tdist[i] = INF;\r\n    76\t\t\tpred_e[i] = -1;\r\n    77\t\t}\r\n    78\t\tfound = 0;\r\n"]
[48.98684, "o", "    79\t\tfor (r = 0; r < root_n() && !found; r++) {\r\n    80\t\t\tint ri = node_index(root_id(r));\r\n    81\t\r\n    82\t\t\tif (ri < 0)\r\n"]
[48.986957, "o", "    83\t\t\t\tcontinue;\r\n    84\t\t\t"]
[48.987002, "o", "for (i = 0; i < node_n(); i++) {\r\n    85\t\t\t\tdist[i] = INF;\r\n    86\t\t\t\tpred_e[i] = -1;\r\n    87\t\t\t}\r\n    88\t\t\tqh = qt = 0;\r\n    89\t\t\tdist[ri] = 0;\r\n    90\t\t\tq[qt++] = ri;\r\n    91\t\t\twhile (qh < qt) {\r\n    92\t\t\t\tint u = q[qh++];\r\n    93\t\t\t\tint nn = collect_nb(node_at(u)->id);\r\n    94\t\t\t\tint k;\r\n    95\t\r\n    96\t\t\t\tfor (k = 0; k < nn; k++) {\r\n    97\t\t\t\t\tint v = node_index(nb[k]->to);\r\n    98\t\t\t\t\tint nd;\r\n    99\t\r\n   100\t\t\t\t\tif (v < 0)\r\n   101\t\t\t\t\t\tcontinue;\r\n   102\t\t\t\t\tnd = dist[u] + 1;\r\n   103\t\t\t\t\tif (nd < dist[v]) {\r\n   104\t\t\t\t\t\tdist[v] = nd;\r\n   105\t\t\t\t\t\tpred_e[v] = (int)(nb[k] - edge_at(0));\r\n   106\t\t\t\t\t\tq[qt++] = v;\r\n   107\t\t\t\t\t}\r\n   108\t\t\t\t}\r\n   109\t\t\t}\r\n   110\t\t\tfor (s = 0; s < site_n(); s++) {\r\n   111\t\t\t\tsi = node_index(site_at(s));\r\n   112\t\t\t\tif (si >= 0 && dist[si] < INF) {\r\n   113\t\t\t\t\tfound = 1;\r\n   114\t\t\t\t\tuse_rk = root_kind(r);\r\n   115\t\t\t\t\tuse_site = si;\r\n   116\t\t\t\t\tbreak;\r\n   117\t\t\t\t}\r\n   118\t\t\t}\r\n   119\t\t}\r\n   120\t\tfp = fopen(ledger, \"w\");\r\n   121\t\tif (!fp)\r\n"]
[48.987026, "o", "   122\t\t\treturn -1;\r\n   123\t\tif (!found) {\r\n   124\t\t\tfclose(fp);\r\n   125\t\t\treturn -1;\r\n   126\t\t}\r\n   127\t\tfprintf(fp, \"SITE %s\\n\", node_cls(node_at(use_site)->id));\r\n"]
[48.987042, "o", "   128\t\tfprintf(fp, \"BYTES %u\\n\", node_bytes(node_at(use_site)->id));\r\n   129\t\temit_path(fp, pred_e, use_site, use_rk);\r\n   130\t\tfclose(fp);\r\n"]
[48.987057, "o", "   131\t\treturn 0;\r\n   132\t}\r\n"]
[48.988999, "o", "static int nbor_ord(const void *x, const void *y)\r\n{\r\n\tconst Edge *a = *(const Edge * const *)x;\r\n\tconst Edge *b = *(const Edge * const *)y;\r\n\treturn (int)a->to - (int)b->to;\r\n}\r\n"]
