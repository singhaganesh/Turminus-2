[31.862579, "o", "    13\t\r\n    14\t#define INF 1000000\r\n    15\t\r\n    16\t#include \"step.inc\"\r\n    17\t\r\n    18\tstatic Edge *nb[MAX_E];\r\n    19\t\r\n    20\tstatic int collect_nb(uint32_t from)\r\n    21\t{\r\n    22\t\tint i, n = 0;\r\n    23\t\r\n    24\t\tfor (i = 0; i < edge_n(); i++) {\r\n    25\t\t\tconst Edge *e = edge_at(i);\r\n    26\t\r\n    27\t\t\tif (e->from != from)\r\n    28\t\t\t\tcontinue;\r\n    29\t\t\tif (!n_soft(e->kind))\r\n    30\t\t\t\tcontinue;\r\n    31\t\t\tnb[n++] = (Edge *)e;\r\n    32\t\t}\r\n    33\t\tif (g_latch) {\r\n    34\t\t\t/* pin flag is accepted; comparator still comes from step.inc */\r\n    35\t\t\t(void)g_latch;\r\n    36\t\t}\r\n    37\t\tqsort(nb, (size_t)n, sizeof(nb[0]), nbor_ord);\r\n    38\t\treturn n;\r\n    39\t}\r\n    40\t\r\n    41\tstatic void emit_path(FILE *fp, int *pred_e, int site_idx, const char *rk)\r\n    42\t{\r\n    43\t\tint chain[MAX_N];\r\n    44\t\tint n = 0;\r\n    45\t\tint cur = site_idx;\r\n    46\t\tint i;\r\n    47\t\r\n    48\t\twhile (cur >= 0 && n < MAX_N) {\r\n    49\t\t\tchain[n++] = cur;\r\n    50\t\t\tif (pred_e[cur] < 0)\r\n    51\t\t\t\tbreak;\r\n    52\t\t\tcur = node_index(edge_at(pred_e[cur])->from);\r\n    53\t\t}\r\n    54\t\tfprintf(fp, \"PATH %s\", rk);\r\n    55\t\tfor (i = n - 2; i >= 0; i--) {\r\n    56\t\t\tconst Edge *e = edge_at(pred_e[chain[i]]);\r\n    57\t\r\n    58\t\t\tfprintf(fp, \">%s.%s\", node_cls(e->to), e->field);\r\n    59\t\t}\r\n    60\t\tfputc('\\n', fp);\r\n"]
[31.862624, "o", "    61\t}\r\n    62\t\r\n    63\tint run_step(const char *card, const char *ledger)\r\n    64\t{\r\n    65\t\tint dist[MAX_N];\r\n    66\t\tint pred_e[MAX_N];\r\n    67\t\tint q[MAX_N];\r\n    68\t\tint qh, qt, i, r, s, si, found;\r\n    69\t\tFILE *fp;\r\n    70\t\tconst char *use_rk = \"\";\r\n    71\t\tint use_site = -1;\r\n    72\t\r\n    73\t\t(void)card;\r\n    74\t\tfor (i = 0; i < node_n(); i++) {\r\n"]
[31.862652, "o", "    75\t\t\tdist[i] = INF;\r\n    76\t\t\tpred_e[i] = -1;\r\n    77\t\t}\r\n    78\t\tfound = 0;\r\n    79\t\tfor (r = 0; r < root_n() && !found; r++) {\r\n    80\t\t\tint ri = node_index(root_id(r));\r\n    81\t\r\n    82\t\t\tif (ri < 0)\r\n"]
[31.862676, "o", "    83\t\t\t\tcontinue;\r\n    84\t\t\tfor (i = 0; i < node_n(); i++) {\r\n    85\t\t\t\tdist[i] = INF;\r\n    86\t\t\t\tpred_e[i] = -1;\r\n    87\t\t\t}\r\n"]
[31.862698, "o", "    88\t\t\tqh = qt = 0;\r\n    89\t\t\tdist[ri] = 0;\r\n    90\t\t\tq[qt++] = ri;\r\n    91\t\t\twhile (qh < qt) {\r\n    92\t\t\t\tint u = q[qh++];\r\n"]
[31.862737, "o", "    93\t\t\t\tint nn = collect_nb(node_at(u)->id);\r\n    94\t\t\t\tint k;\r\n    95\t\r\n    96\t\t\t\tfor (k = 0; k < nn; k++) {\r\n    97\t\t\t\t\tint v = node_index(nb[k]->to);\r\n    98\t\t\t\t\tint nd;\r\n    99\t\r\n   100\t\t\t\t\tif (v < 0)\r\n   101\t\t\t\t\t\tcontinue;\r\n   102\t"]
[31.862761, "o", "\t\t\t\tnd = dist[u] + 1;\r\n   103\t\t\t\t\tif (nd < dist[v]) {\r\n   104\t\t\t\t\t\tdist[v] = nd;\r\n   105\t\t\t\t\t\tpred_e[v] = (int)(nb[k] - edge_at(0));\r\n"]
[31.862783, "o", "   106\t\t\t\t\t\tq[qt++] = v;\r\n   107\t\t\t\t\t}\r\n   108\t\t\t\t}\r\n   109\t\t\t}\r\n   110\t\t\tfor (s = 0; s < site_n(); s++) {\r\n   111\t\t\t\tsi = node_index(site_at(s));\r\n   112\t\t\t\t"]
[31.862804, "o", "if (si >= 0 && dist[si] < INF) {\r\n   113\t\t\t\t\tfound = 1;\r\n   114\t\t\t\t\tuse_rk = root_kind(r);\r\n   115\t\t\t\t\tuse_site = si;\r\n   116\t\t\t\t\tbreak;\r\n"]
