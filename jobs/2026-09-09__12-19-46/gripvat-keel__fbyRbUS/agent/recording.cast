[117.248618, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\np=Path('millarm/load.c')\ns=p.read_text()\ns=s.replace('if (strncmp(line, \"END\", 3) == 0)', 'if (strcmp(line, \"END\\\\n\") == 0 || strcmp(line, \"END\\\\r\\\\n\") == 0)')\ns,n=re.subn(r'(\\n[ \\t]*fclose\\(fp\\);\\n)[ \\t]*return 0;\\n}\\s*$', r'\\1\\treturn ended ? 0 : -1;\\n}\\n', s)\nif n != 1:\n    raise SystemExit(f'load final replacements={n}')\np.write_text(s)\n\np=Path('rootwell/scan.c')\ns=p.read_text()\ns,n=re.subn(r'(\\n[ \\t]*fclose\\(fp\\);\\n)[ \\t]*return 0;\\n}\\s*$', r'\\1\\tqsort(rptr, (size_t)nr, sizeof(rptr[0]), root_ord);\\n\\treturn 0;\\n}\\n', s)\nif n != 1:\n    raise SystemExit(f'root final replacements={n}')\np.write_text(s)\nPY\ntail -n 8 millarm/load.c; tail -n 8 rootwell/scan.c; /app/kindle.sh\n"]
