[20.056899, "o", "     1\t#include \"note.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint run_note(const char *left, const char *right, const char *outp)\r\n     7\t{\r\n     8\t\tFILE *a, *b, *o;\r\n     9\t\tchar la[512], lb[512];\r\n    10\t\tint ok = 1;\r\n    11\t\r\n    12\t\ta = fopen(left, \"r\");\r\n    13\t\tb = fopen(right, \"r\");\r\n    14\t\to = fopen(outp, \"w\");\r\n    15\t\tif (!a || !b || !o) {\r\n    16\t\t\tif (a)\r\n    17\t\t\t\tfclose(a);\r\n    18\t\t\tif (b)\r\n"]
[20.057382, "o", "    19\t\t\t\tfclose(b);\r\n    20\t\t\tif (o)\r\n    21\t\t\t\tfclose(o);\r\n    22\t\t\treturn -1;\r\n    23\t\t}\r\n    24\t\twhile (1) {\r\n    25\t\t\tchar *ga = fgets(la, sizeof(la), a);\r\n    26\t\t\tchar *gb = fgets(lb, sizeof(lb), b);\r\n    27\t\r\n    28\t\t\tif (!ga && !gb)\r\n    29\t\t\t\tbreak;\r\n    30\t\t\tif (!ga || !gb || strcmp(la, lb) != 0) {\r\n    31\t\t\t\tok = 0;\r\n    32\t\t\t\tbreak;\r\n    33\t\t\t}\r\n    34\t\t}\r\n    35\t\tfputs(ok ? \"lock\\n\" : \"slip\\n\", o);\r\n    36\t\tfclose(a);\r\n    37\t\tfclose(b);\r\n    38\t\tfclose(o);\r\n    39\t\treturn 0;\r\n    40\t}\r\n"]
