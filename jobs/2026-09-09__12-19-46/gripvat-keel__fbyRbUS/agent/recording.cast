[20.030261, "o", "     1\t#ifndef SKIP_H\r\n     2\t#define SKIP_H\r\n     3\t\r\n     4\tint n_soft(int kind);\r\n     5\t\r\n     6\t#endif\r\n"]
[20.030438, "o", "===== millarm/driver.c =====\r\n"]
[20.032761, "o", "     1\t#include <stdio.h>\r\n     2\t#include <stdlib.h>\r\n     3\t#include <string.h>\r\n     4\t#include <sys/stat.h>\r\n     5\t#include <unistd.h>\r\n     6\t\r\n     7\t#include \"latch.h\"\r\n     8\t#include \"load.h\"\r\n     9\t#include \"../rootwell/scan.h\"\r\n    10\t#include \"../ridget/step.h\"\r\n    11\t#include \"../twinline/note.h\"\r\n    12\t\r\n    13\tstatic void mark_ok(void)\r\n    14\t{\r\n    15\t\tFILE *fp;\r\n    16\t\r\n    17\t\tmkdir(\"/app/inkurn\", 0755);\r\n    18\t\tfp = fopen(\"/app/inkurn/mint.ok\", \"w\");\r\n    19\t\tif (fp) {\r\n    20\t\t\tfputs(\"ok\\n\", fp);\r\n    21\t\t\tfclose(fp);\r\n    22\t\t}\r\n    23\t}\r\n    24\t\r\n    25\tstatic void clear_ok(void)\r\n    26\t{\r\n    27\t\tunlink(\"/app/inkurn/mint.ok\");\r\n    28\t}\r\n    29\t\r\n"]
[20.032921, "o", "    30\tint main(int argc, char **argv)\r\n    31\t{\r\n    32\t\ttake_latch(argc, argv);\r\n    33\t\tif (argc < 2) {\r\n    34\t\t\tfputs(\"usage\\n\", stderr);\r\n    35\t\t\treturn 2;\r\n    36\t\t}\r\n    37\t\tif (strcmp(argv[1], \"mint\") == 0) {\r\n    38\t\t\tconst char *card;\r\n    39\t\t\tconst char *outp;\r\n    40\t\r\n    41\t\t\tif (argc < 4)\r\n    42\t\t\t\treturn 2;\r\n    43\t\t\tcard = argv[2];\r\n    44\t\t\toutp = argv[3];\r\n    45\t\t\tmkdir(\"/app/inkurn\", 0755);\r\n    46\t\t\tclear_ok();\r\n    47\t\t\tif (load_card(card) != 0)\r\n    48\t\t\t\treturn 1;\r\n    49\t\t\tif (op_root(card) != 0)\r\n    50\t\t\t\treturn 1;\r\n    51\t\t\tif (run_step(card, outp) != 0)\r\n    52\t\t\t\treturn 1;\r\n    53\t\t\tmark_ok();\r\n    54\t\t\treturn 0;\r\n    55\t\t}\r\n    56\t\tif (strcmp(argv[1], \"align\") == 0) {\r\n    57\t\t\tif (argc < 4)\r\n    58\t\t\t\treturn 2;\r\n    59\t\t\tmkdir(\"/app/inkurn\", 0755);\r\n    60\t\t\treturn run_note(argv[2], argv[3], \"/app/inkurn/align.txt\") == 0 ? 0 : 1;\r\n    61\t\t}\r\n    62\t\treturn 2;\r\n    63\t}\r\n"]
[20.033916, "o", "===== millarm/latch.c =====\r\n"]
[20.035505, "o", "     1\t#include \"latch.h\"\r\n     2\t\r\n     3\t#include <string.h>\r\n     4\t\r\n     5\tint g_latch;\r\n     6\t\r\n     7\tvoid take_latch(int argc, char **argv)\r\n     8\t{\r\n     9\t\tint i;\r\n    10\t\r\n    11\t\tg_latch = 0;\r\n    12\t\tfor (i = 1; i < argc; i++) {\r\n    13\t\t\tif (strcmp(argv[i], \"--pin-handles\") == 0)\r\n    14\t\t\t\tg_latch = 1;\r\n    15\t\t}\r\n    16\t}\r\n"]
