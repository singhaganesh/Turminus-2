[31.851034, "o", "     1\t#include \"emit.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t\r\n     6\tint main(int argc, char **argv)\r\n     7\t{\r\n     8\t\tFILE *fp;\r\n     9\t\r\n    10\t\tif (argc < 2)\r\n    11\t\t\treturn 2;\r\n    12\t\tfp = fopen(argv[1], \"w\");\r\n    13\t\tif (!fp)\r\n    14\t\t\treturn 1;\r\n    15\t\tcfg_emit(fp);\r\n    16\t\tfclose(fp);\r\n    17\t\treturn 0;\r\n    18\t}\r\n"]
