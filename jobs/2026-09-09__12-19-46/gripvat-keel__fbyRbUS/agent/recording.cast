[31.84654, "o", "     1\t#include \"emit.h\"\r\n     2\t\r\n     3\tvoid cfg_emit(FILE *fp)\r\n     4\t{\r\n     5\t\tfputs(\"static int nbor_ord(const void *x, const void *y)\\n\", fp);\r\n     6\t\tfputs(\"{\\n\", fp);\r\n     7\t\tfputs(\"\\tconst Edge *a = *(const Edge * const *)x;\\n\", fp);\r\n     8\t\tfputs(\"\\tconst Edge *b = *(const Edge * const *)y;\\n\", fp);\r\n     9\t\tfputs(\"\\treturn (int)a->to - (int)b->to;\\n\", fp);\r\n    10\t\tfputs(\"}\\n\", fp);\r\n    11\t}\r\n"]
