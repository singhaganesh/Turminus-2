[75.261293, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('softbay/skip.c')\np.write_text('''#include \"skip.h\"\\n\\n#include \"../millarm/load.h\"\\n\\n/* Only strong references can retain an object. */\\nint n_soft(int kind)\\n{\\n        return kind == KIND_STRONG;\\n}\\n''')\n\np=Path('adjmill/emit.c')\np.write_text('''#include \"emit.h\"\\n\\nvoid cfg_emit(FILE *fp)\\n{\\n        fputs(\"static int nbor_ord(const void *x, const void *y)\\\\n\", fp);\\n        fputs(\"{\\\\n\", fp);\\n        fputs(\"\\\\tconst Edge *a = *(const Edge * const *)x;\\\\n\", fp);\\n        fputs(\"\\\\tconst Edge *b = *(const Edge * const *)y;\\\\n\", fp);\\n        fputs(\"\\\\tint c = strcmp(node_cls(a->to), node_cls(b->to));\\\\n\", fp);\\n        fputs(\"\\\\tif (c != 0)\\\\n\\\\t\\\\treturn c;\\\\n\", fp);\\n        fputs(\"\\\\tc = strcmp(a->field, b->field);\\\\n\", fp);\\n        fputs(\"\\\\tif (c != 0)\\\\n\\\\t\\\\treturn c;\\\\n\", fp);\\n        fputs(\"\\\\treturn strcmp(node_cls(a->from), node_cls(b->from));\\\\n\", fp);\\n        fputs(\"}\\\\n\", fp);\\n}\\n''')\n\np=Path('rootwell/scan.c')\ns=p.read_text()\ns=s.replace('#include <string.h>\\n', '#include <stdlib.h>\\n#include <string.h>\\n')\ns=s.replace('static int nr;\\n', '''static int nr;\\n\\nstatic int root_ord(const void *x, const void *y)\\n{\\n        const RootRec *a = *(RootRec * const *)x;\\n        const RootRec *b = *(RootRec * const *)y;\\n        int c = strcmp(a->kind, b->kind);\\n\\n        if (c != 0)\\n                return c;\\n        return (a->id > b->id) - (a->id < b->id);\\n}\\n''')\ns=s.replace('        fclose(fp);\\n        return 0;\\n}', '        fclose(fp);\\n        qsort(rptr, (size_t)nr, sizeof(rptr[0]), root_ord);\\n        return 0;\\n}')\np.write_text(s)\n\np=Path('ridget/step.c')\ns=p.read_text().replace('node_cls(e->to), e->field', 'node_cls(e->from), e->field')\np.write_text(s)\n\np=Path('millarm/load.c')\ns=p.read_text()\ns=s.replace('if (strncmp(line, \"HPK1\", 4) != 0)', 'if (strcmp(line, \"HPK1\\\\n\") != 0 && strcmp(line, \"HPK1\\\\r\\\\n\") != 0)')\ns=s.replace('        fclose(fp);\\n        return 0;\\n}', '        fclose(fp);\\n        return ended ? 0 : -1;\\n}', 1)\np.write_text(s)\nPY\n/app/kindle.sh\n"]
