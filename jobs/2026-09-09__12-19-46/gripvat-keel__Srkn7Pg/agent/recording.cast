[33.80281, "o", "     1\t#include \"note.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint run_note(const char *left, const char *right, const char *outp)\r\n     7\t{\r\n     8\t\tFILE *a, *b, *o;\r\n     9\t\tchar la[512], lb[512];\r\n    10\t\tint ok = 1;\r\n    11\t\r\n    12\t\ta = fopen(left, \"r\");\r\n    13\t\tb = fopen(right, \"r\");\r\n    14\t\to = fopen(outp, \"w\");\r\n    15\t\tif (!a || !b || !o) {\r\n    16\t\t\tif (a)\r\n    17\t\t\t\tfclose(a);\r\n    18\t\t\tif (b)\r\n    19\t\t\t\tfclose(b);\r\n    20\t\t\tif (o)\r\n    21\t\t\t\tfclose(o);\r\n    22\t\t\treturn -1;\r\n"]
