[34.423235, "o", "     1\t#include \"scan.h\"\r\n     2\t\r\n     3\t#include \"../millarm/load.h\"\r\n     4\t\r\n     5\t#include <stdio.h>\r\n     6\t#include <string.h>\r\n     7\t\r\n     8\t#define MAX_R 32\r\n     9\t\r\n    10\ttypedef struct {\r\n    11\t\tuint32_t id;\r\n    12\t\tchar kind[MAX_S];\r\n    13\t} RootRec;\r\n    14\t\r\n    15\tstatic RootRec *rptr[MAX_R];\r\n    16\tstatic RootRec rbuf[MAX_R];\r\n    17\tstatic int nr;\r\n    18\t\r\n    19\tint root_n(void)\r\n    20\t{\r\n    21\t\treturn nr;\r\n"]
[34.423547, "o", "    22\t}\r\n    23\t\r\n    24\tuint32_t root_id(int i)\r\n    25\t{\r\n    26\t\treturn rptr[i]->id;\r\n    27\t}\r\n    28\t\r\n    29\tconst char *root_kind(int i)\r\n    30\t{\r\n    31\t\treturn rptr[i]->kind;\r\n    32\t}\r\n    33\t\r\n    34\tint op_root(const char *path)\r\n    35\t{\r\n    36\t\tFILE *fp;\r\n    37\t\tchar line[256];\r\n    38\t\tchar k[MAX_S];\r\n    39\t\tuint32_t id;\r\n    40\t\r\n    41\t\tnr = 0;\r\n    42\t\tfp = fopen(path, \"r\");\r\n    43\t\tif (!fp)\r\n    44\t\t\treturn -1;\r\n    45\t\twhile (fgets(line, sizeof(line), fp)) {\r\n    46\t\t\tif (sscanf(line, \"ROOT %u %31s\", &id, k) == 2) {\r\n    47\t\t\t\tif (nr >= MAX_R) {\r\n    48\t\t\t\t\tfclose(fp);\r\n    49\t\t\t\t\treturn -1;\r\n    50\t\t\t\t}\r\n    51\t\t\t\trbuf[nr].id = id;\r\n    52\t\t\t\tstrncpy(rbuf[nr].kind, k, MAX_S - 1);\r\n    53\t\t\t\trbuf[nr].kind[MAX_S - 1] = 0;\r\n    54\t\t\t\trptr[nr] = &rbuf[nr];\r\n    55\t\t\t\tnr++;\r\n    56\t\t\t}\r\n    57\t\t}\r\n    58\t\tfclose(fp);\r\n    59\t\treturn 0;\r\n    60\t}\r\n"]
