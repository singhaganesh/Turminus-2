[73.045319, "o", "     1\t#include \"scan.h\"\r\n     2\t\r\n     3\t#include \"../millarm/load.h\"\r\n     4\t\r\n     5\t#include <stdio.h>\r\n     6\t#include <string.h>\r\n     7\t#include <stdlib.h>\r\n     8\t\r\n     9\t#define MAX_R 32\r\n    10\t\r\n    11\ttypedef struct {\r\n"]
[73.045551, "o", "    12\t\tuint32_t id;\r\n    13\t\tchar kind[MAX_S];\r\n    14\t} RootRec;\r\n    15\t\r\n    16\tstatic RootRec *rptr[MAX_R];\r\n    17\tstatic RootRec rbuf[MAX_R];\r\n    18\tstatic int nr;\r\n    19\t\r\n    20\tstatic int root_ord(const void *x, const void *y)\r\n    21\t{\r\n    22\t        const RootRec *a = *(const RootRec * const *)x;\r\n    23\t        const RootRec *b = *(const RootRec * const *)y;\r\n    24\t        int c = strcmp(a->kind, b->kind);\r\n    25\t\r\n    26\t        if (c != 0)\r\n    27\t                return c;\r\n    28\t        if (a->id < b->id)\r\n    29\t                return -1;\r\n    30\t        if (a->id > b->id)\r\n    31\t                return 1;\r\n    32\t        return 0;\r\n    33\t}\r\n    34\t\r\n    35\tint root_n(void)\r\n    36\t{\r\n    37\t\treturn nr;\r\n    38\t}\r\n    39\t\r\n    40\tuint32_t root_id(int i)\r\n    41\t{\r\n    42\t\treturn rptr[i]->id;\r\n    43\t}\r\n    44\t\r\n    45\tconst char *root_kind(int i)\r\n    46\t{\r\n    47\t\treturn rptr[i]->kind;\r\n    48\t}\r\n    49\t\r\n    50\tint op_root(const char *path)\r\n    51\t{\r\n    52\t\tFILE *fp;\r\n    53\t\tchar line[256];\r\n    54\t\tchar k[MAX_S];\r\n    55\t\tuint32_t id;\r\n    56\t\r\n    57\t\tnr = 0;\r\n    58\t\tfp = fopen(path, \"r\");\r\n"]
[73.045779, "o", "    59\t\tif (!fp)\r\n    60\t\t\treturn -1;\r\n    61\t\twhile (fgets(line, sizeof(line), fp)) {\r\n    62\t\t\tif (sscanf(line, \"ROOT %u %31s\", &id, k) == 2) {\r\n    63\t\t\t\tif (nr >= MAX_R) {\r\n    64\t\t\t\t\tfclose(fp);\r\n    65\t\t\t\t\treturn -1;\r\n    66\t\t\t\t}\r\n    67\t\t\t\trbuf[nr].id = id;\r\n    68\t\t\t\tstrncpy(rbuf[nr].kind, k, MAX_S - 1);\r\n    69\t\t\t\trbuf[nr].kind[MAX_S - 1] = 0;\r\n    70\t\t\t\trptr[nr] = &rbuf[nr];\r\n    71\t\t\t\tnr++;\r\n    72\t\t\t}\r\n    73\t\t}\r\n    74\t\tfclose(fp);\r\n    75\t\treturn 0;\r\n    76\t}\r\n"]
