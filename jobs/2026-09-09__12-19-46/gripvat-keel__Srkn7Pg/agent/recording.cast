[21.309354, "o", "HPK1\r\nNODE 10 JNIRoot 16\r\nNODE 20 VRoot 16\r\nNODE 30 Anchor 32\r\nNODE 40 Mule 48\r\nNODE 50 Noll 48\r\nNODE 60 Leak 128\r\nEDGE 10 30 STRONG box\r\nEDGE 10 40 STRONG slot\r\nEDGE 10 50 STRONG other\r\nEDGE 30 60 WEAK ghost\r\nEDGE 40 60 STRONG item\r\nEDGE 50 60 STRONG item\r\nEDGE 20 40 STRONG via\r\nEDGE 20 50 STRONG via\r\nROOT 10 JNI\r\nROOT 20 VM\r\nSITE 60\r\nEND\r\n"]
