[33.798978, "o", "    27\t\tunlink(\"/app/inkurn/mint.ok\");\r\n    28\t}\r\n    29\t\r\n    30\tint main(int argc, char **argv)\r\n    31\t{\r\n    32\t\ttake_latch(argc, argv);\r\n    33\t\tif (argc < 2) {\r\n    34\t\t\tfputs(\"usage\\n\", stderr);\r\n    35\t\t\treturn 2;\r\n    36\t\t}\r\n    37\t\tif (strcmp(argv[1], \"mint\") == 0) {\r\n    38\t\t\tconst char *card;\r\n    39\t\t\tconst char *outp;\r\n    40\t\r\n    41\t\t\tif (argc < 4)\r\n    42\t\t\t\treturn 2;\r\n    43\t\t\tcard = argv[2];\r\n    44\t\t\toutp = argv[3];\r\n    45\t\t\tmkdir(\"/app/inkurn\", 0755);\r\n    46\t\t\tclear_ok();\r\n    47\t\t\tif (load_card(card) != 0)\r\n    48\t\t\t\treturn 1;\r\n    49\t\t\tif (op_root(card) != 0)\r\n    50\t\t\t\treturn 1;\r\n    51\t\t\tif (run_step(card, outp) != 0)\r\n    52\t\t\t\treturn 1;\r\n    53\t\t\tmark_ok();\r\n    54\t\t\treturn 0;\r\n    55\t\t}\r\n    56\t\tif (strcmp(argv[1], \"align\") == 0) {\r\n    57\t\t\tif (argc < 4)\r\n    58\t\t\t\treturn 2;\r\n    59\t\t\tmkdir(\"/app/inkurn\", 0755);\r\n    60\t\t\treturn run_note(argv[2], argv[3], \"/app/inkurn/align.txt\") == 0 ? 0 : 1;\r\n    61\t\t}\r\n    62\t\treturn 2;\r\n    63\t}\r\n"]
