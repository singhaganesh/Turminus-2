[75.269535, "o", "\u001b[?2004hroot@95e1317d3868:/app# "]
[75.269658, "o", "sed '$d' /app/packurn/day.hpk > /tmp/noend.hpk\r\n\u001b[?2004l\r"]
[75.271071, "o", "\u001b[?2004hroot@95e1317d3868:/app# "]
[75.271435, "o", "/app/bin/keelgrip mint /tmp/noend.hpk /app/inkurn/bad.txt; echo noend_rc=$?; if test -e /app/inkurn/mint.ok; then echo 'mint.ok=true'; else echo 'mint.ok=false'; fi\r\n\u001b[?2004l\r"]
[75.272649, "o", "noend_rc=1\r\nmint.ok=false\r\n"]
[75.272823, "o", "\u001b[?2004hroot@95e1317d3868:/app# "]
[93.236622, "i", "rm -f /app/inkurn/bad.txt; /app/bin/keelgrip mint /app/packurn/day.hpk /app/inkurn/live.txt; rc=$?; /app/bin/keelgrip align /app/inkurn/live.txt /app/inkurn/sibling.txt; arc=$?; echo \"clean_mint_rc=$rc align_rc=$arc\"; echo '--- live'; cat /app/inkurn/live.txt; echo '--- align'; cat /app/inkurn/align.txt; echo '--- mint.ok'; cat /app/inkurn/mint.ok\n"]
[93.237969, "o", "rm -f /app/inkurn/bad.txt; /app/bin/keelgrip mint /app/packurn/day.hpk /app/inkurn/live.txt; rc=$?; /app/bin/keelgrip align /app/inkurn/live.txt /app/inkurn/sibling.txt; arc=$?; echo \"clean_mint_rc=$rc align_rc=$arc\"; echo '--- live'; cat /app/inkurn/live.txt; echo '--- align'; cat /app/inkurn/align.txt; echo '--- mint.ok'; cat /app/inkurn/mint.ok\r\n\u001b[?2004l\r"]
[93.244105, "o", "clean_mint_rc=0 align_rc=0\r\n--- live\r\n"]
[93.246584, "o", "SITE Leak\r\nBYTES 128\r\nPATH JNI>Mule.slot>Leak.item\r\n"]
[93.247336, "o", "--- align\r\n"]
[93.24938, "o", "lock\r\n"]
[93.249746, "o", "--- mint.ok\r\n"]
[93.251679, "o", "ok\r\n"]
