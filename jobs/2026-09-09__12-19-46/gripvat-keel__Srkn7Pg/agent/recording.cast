[21.312264, "o", "HPK1\r\nNODE 10 JNIRoot 16\r\nNODE 20 VRoot 16\r\nNODE 30 Anchor 32\r\nNODE 50 Mule 48\r\nNODE 40 Noll 48\r\nNODE 60 Leak 128\r\nEDGE 10 30 STRONG box\r\nEDGE 10 50 STRONG slot\r\nEDGE 10 40 STRONG other\r\nEDGE 30 60 WEAK ghost\r\nEDGE 50 60 STRONG item\r\nEDGE 40 60 STRONG item\r\nEDGE 20 50 STRONG via\r\nEDGE 20 40 STRONG via\r\nROOT 10 JNI\r\nROOT 20 VM\r\nSITE 60\r\nEND\r\n"]
[21.314345, "o", "--- BAY module sources\r\n"]
[21.314596, "o", "===== /app/rootwell/scan.c\r\n"]
[21.323193, "o", "#include \"scan.h\"\r\n\r\n#include \"../millarm/load.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\n#define MAX_R 32\r\n\r\ntypedef struct {\r\n\tuint32_t id;\r\n\tchar kind[MAX_S];\r\n} RootRec;\r\n\r\nstatic RootRec *rptr[MAX_R];\r\nstatic RootRec rbuf[MAX_R];\r\nstatic int nr;\r\n\r\nint root_n(void)\r\n{\r\n\treturn nr;\r\n}\r\n\r\nuint32_t root_id(int i)\r\n{\r\n\treturn rptr[i]->id;\r\n}\r\n\r\nconst char *root_kind(int i)\r\n{\r\n\treturn rptr[i]->kind;\r\n}\r\n\r\nint op_root(const char *path)\r\n{\r\n\tFILE *fp;\r\n\tchar line[256];\r\n\tchar k[MAX_S];\r\n\tuint32_t id;\r\n\r\n\tnr = 0;\r\n\tfp = fopen(path, \"r\");\r\n\tif (!fp)\r\n\t\treturn -1;\r\n\twhile (fgets(line, sizeof(line), fp)) {\r\n\t\tif (sscanf(line, \"ROOT %u %31s\", &id, k) == 2) {\r\n\t\t\tif (nr >= MAX_R) {\r\n\t\t\t\tfclose(fp);\r\n\t\t\t\treturn -1;\r\n\t\t\t}\r\n\t\t\trbuf[nr].id = id;\r\n\t\t\tstrncpy(rbuf[nr].kind, k, MAX_S - 1);\r\n\t\t\trbuf[nr].kind[MAX_S - 1] = 0;\r\n\t\t\trptr[nr] = &rbuf[nr];\r\n\t\t\tnr++;\r\n\t\t}\r\n\t}\r\n\tfclose(fp);\r\n\treturn 0;\r\n}\r\n===== /app/rootwell/scan.h\r\n"]
[21.324451, "o", "#ifndef SCAN_H\r\n#define SCAN_H\r\n\r\n#include <stdint.h>\r\n\r\n"]
[21.324652, "o", "int op_root(const char *path);\r\nint root_n(void);\r\nuint32_t root_id(int i);\r\nconst char *root_kind(int i);\r\n\r\n#endif\r\n"]
[21.324979, "o", "===== /app/adjmill/emit.c\r\n"]
[21.327132, "o", "#include \"emit.h\"\r\n\r\nvoid cfg_emit(FILE *fp)\r\n{\r\n\tfputs(\"static int nbor_ord(const void *x, const void *y)\\n\", fp);\r\n\tfputs(\"{\\n\", fp);\r\n\tfputs(\"\\tconst Edge *a = *(const Edge * const *)x;\\n\", fp);\r\n\tfputs(\"\\tconst Edge *b = *(const Edge * const *)y;\\n\", fp);\r\n\tfputs(\"\\treturn (int)a->to - (int)b->to;\\n\", fp);\r\n\tfputs(\"}\\n\", fp);\r\n}\r\n"]
[21.327929, "o", "===== /app/adjmill/emit.h\r\n"]
[21.32997, "o", "#ifndef EMIT_H\r\n#define EMIT_H\r\n\r\n#include <stdio.h>\r\n\r\nvoid cfg_emit(FILE *fp);\r\n\r\n#endif\r\n"]
[21.331585, "o", "===== /app/adjmill/emit_main.c\r\n"]
[21.333188, "o", "#include \"emit.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n\r\nint main(int argc, char **argv)\r\n{\r\n\tFILE *fp;\r\n\r\n\tif (argc < 2)\r\n"]
[21.333996, "o", "\t\treturn 2;\r\n\tfp = fopen(argv[1], \"w\");\r\n\tif (!fp)\r\n\t\treturn 1;\r\n\tcfg_emit(fp);\r\n\tfclose(fp);\r\n\treturn 0;\r\n}\r\n"]
[21.334144, "o", "===== /app/softbay/skip.c\r\n"]
[21.337584, "o", "#include \"skip.h\"\r\n\r\nint n_soft(int kind)\r\n{\r\n\t(void)kind;\r\n\treturn 1;\r\n}\r\n"]
[21.338764, "o", "===== /app/softbay/skip.h\r\n"]
[21.341005, "o", "#ifndef SKIP_H\r\n#define SKIP_H\r\n\r\nint n_soft(int kind);\r\n\r\n#endif\r\n"]
