    72			return -1;
    73		}
    74		if (strncmp(line, "HPK1", 4) != 0) {
    75			fclose(fp);
    76			return -1;
    77		}
    78		while (fgets(line, sizeof(line), fp)) {
    79			if (strncmp(line, "END", 3) == 0) {
    80				ended = 1;
    81				break;
    82			}
    83			if (sscanf(line, "NODE %u %31s %u", &x, a, &z) == 3) {
