===== /app/twinline/note.c
     1	#include "note.h"
     2	
     3	#include <stdio.h>
     4	#include <string.h>
     5	
     6	int run_note(const char *left, const char *right, const char *outp)
     7	{
     8		FILE *a, *b, *o;
     9		char la[512], lb[512];
    10		int ok = 1;
    11	
    12		a = fopen(left, "r");
    13		b = fopen(right, "r");
    14		o = fopen(outp, "w");
    15		if (!a || !b || !o) {
    16			if (a)
    17				fclose(a);
    18			if (b)
    19				fclose(b);
    20			if (o)
    21				fclose(o);
    22			return -1;
    23		}
    24		while (1) {
    25			char *ga = fgets(la, sizeof(la), a);
    26			char *gb = fgets(lb, sizeof(lb), b);
    27	
    28			if (!ga && !gb)
    29				break;
    30			if (!ga || !gb || strcmp(la, lb) != 0) {
    31				ok = 0;
    32				break;
    33			}
    34		}
    35		fputs(ok ? "lock\n" : "slip\n", o);
    36		fclose(a);
    37		fclose(b);
    38		fclose(o);
    39		return 0;
    40	}
