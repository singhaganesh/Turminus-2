et wall = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?\n        .trim()\n        .parse::<i32>()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list("/app/daywell")?);\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    // Count the live sources themselves, not the ledger or packed copies.\n    let mut taken = 0i32;\n    for (_, source) in &picked {\n        taken = taken.checked_add(read::nlines(source)?).ok_or(1)?;\n    }\n\n    let _ = fs::remove_dir_all("/app/packbay/stage");\n    fs::create_dir_all("/app/packbay/stage").map_err(|_| 1)?;\n    let mut packed = Vec::new();\n    for (day, source) in picked {\n        let destination = format!("/app/packbay/stage/d{:08}.tbl", day);\n        fs::copy(source, &destination).map_err(|_| 1)?;\n        packed.push((day, destination));\n    }\n    soak::soak(&packed, "/app/packbay/latest")?;\n\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write(\n        "/app/bloturn/ledger.json",\n        format!("{{\\"taken\\":{}}}", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
Sending keys: ['cat > /app/millrib/gait.rs <<\'EOF\'\n#[path = "../hopcue/rim.rs"]\nmod rim;\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let template = fs::read_to_string("/app/millrib/sheet.tpl").map_err(|_| 1)?;\n    let output = template\n        .replace("__P__", probe)\n        .replace("__M__", &matched.to_string())\n        .replace("__T__", &taken.to_string());\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/check.json", output).map_err(|_| 1)\n}\n\npub fn gait(expected: i32, _packed: &[(i32, String)]) -> i32 {\n    let wall = match fs::read_to_string("/app/opstext/WALL")\n        .ok()\n        .and_then(|s| s.trim().parse::<i32>().ok())\n    {\n        Some(value) => value,\n        None => return 1,\n    };\n    let files = match read::list("/app/daywell") {\n        Ok(value) => rim::rim(wall, value),\n        Err(_) => return 1,\n    };\n    if files.is_empty() {\n        return 1;\n    }\n\n    // The check performs its own live reads and does not trust ledger.json.\n    let mut live = 0i32;\n    for (_, path) in files {\n        let rows = match read::nlines(&path) {\n            Ok(value) => value,\n            Err(_) => return 1,\n        };\n        live = match live.checked_add(rows) {\n            Some(value) => value,\n            None => return 1,\n        };\n    }\n    if live != expected || emit("live", live, live).is_err() {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/corkpit/floor.rs <<\'EOF\'\nuse std::fs;\n\npub fn floor(taken: i32) -> bool {\n    match fs::read_to_string("/app/floorcue/MIN.txt")\n        .ok()\n        .and_then(|s| s.trim().parse::<i32>().ok())\n    {\n        Some(minimum) => taken >= minimum,\n        None => false,\n    }\n}\nEOF\ncat > /app/wickmill/boot.rs <<\'EOF\'\n#[path = "../urncue/fold.rs"]\nmod fold;\n#[path = "../millrib/gait.rs"]\nmod gait;\n#[path = "../lidcue/skip.rs"]\nmod skip;\n#[path = "../corkpit/floor.rs"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != "clasp" {\n        eprintln!("usage: dewkiln clasp");\n        std::process::exit(2);\n    }\n\n    let _ = std::fs::remove_file("/app/bloturn/GUARD");\n    let _ = std::fs::remove_file("/app/bloturn/check.json");\n    let _ = std::fs::remove_file("/app/bloturn/ledger.json");\n\n    let code = match fold::fold() {\n        Ok((packed, taken)) => {\n            if !floor::floor(taken) {\n                1\n            } else {\n                let mut ordered = packed.clone();\n                skip::skip(&mut ordered);\n                gait::gait(taken, &packed)\n            }\n        }\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\nfile /app/bin/dewkiln\n/app/bin/dewkiln clasp; rc=$?; echo "rc=$rc"; echo \'--- bloturn ---\'; for f in /app/bloturn/*; do [ -f "$f" ] && { echo "[$f]"; cat "$f"; echo; }; done; echo \'--- live rows and packed names ---\'; find /app/daywell /app/packbay/stage /app/packbay/latest -maxdepth 1 -type f -name \'d*.tbl\' -printf \'%h/%f \' -exec awk \'NF{n++} END{print n+0}\' {} \\; | sort\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
