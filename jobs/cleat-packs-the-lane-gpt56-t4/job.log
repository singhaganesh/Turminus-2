Sending keys: ['cd /app/environment && cat > go.mod <<\'EOF\'\nmodule cleat\n\ngo 1.18\nEOF\ncat > cars.go <<\'EOF\'\npackage main\n\ntype Car struct {\n\tPlate string\n\tLen, Ht, Mass, Haz, Board int\n\tInput int\n}\n\ntype Placement struct {\n\tDeck, Lane string\n\tStation int\n\tOK bool\n}\nEOF\ncat > parse.go <<\'EOF\'\npackage main\n\nimport (\n\t"strconv"\n\t"strings"\n)\n\nfunc safeName(s string) bool {\n\tif s == "" { return false }\n\tfor i := 0; i < len(s); i++ {\n\t\tc := s[i]\n\t\tif (c >= \'A\' && c <= \'Z\') || (c >= \'a\' && c <= \'z\') ||\n\t\t\t(c >= \'0\' && c <= \'9\') || c == \'.\' || c == \'_\' || c == \'-\' { continue }\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc uintDecimal(s string) (int, bool) {\n\tif s == "" { return 0, false }\n\tfor i := range s { if s[i] < \'0\' || s[i] > \'9\' { return 0, false } }\n\tn, err := strconv.Atoi(s)\n\treturn n, err == nil\n}\n\nfunc parseRoll(sheet string) ([]Car, int) {\n\tcars := []Car{}\n\tfor _, raw := range strings.Split(sheet, "\\n") {\n\t\tline := strings.TrimSpace(raw)\n\t\tif line == "" || strings.HasPrefix(line, "#") { continue }\n\t\tw := strings.Fields(line)\n\t\tif len(w) != 12 || w[0] != "PLATE" || w[2] != "LEN" || w[4] != "HT" ||\n\t\t\tw[6] != "MASS" || w[8] != "HAZ" || w[10] != "BOARD" || !safeName(w[1]) { return nil, -2 }\n\t\tlength, a := uintDecimal(w[3]); ht, b := uintDecimal(w[5]); mass, c := uintDecimal(w[7])\n\t\thaz, d := uintDecimal(w[9]); board, e := uintDecimal(w[11])\n\t\tif !a || !b || !c || !d || !e || length == 0 || ht == 0 || mass == 0 || board == 0 || haz > 1 { return nil, -2 }\n\t\tcars = append(cars, Car{Plate:w[1], Len:length, Ht:ht, Mass:mass, Haz:haz, Board:board, Input:len(cars)})\n\t}\n\treturn cars, 0\n}\nEOF\ncat > vault.go <<\'EOF\'\npackage main\n\ntype Lane struct { Deck, Name string; Lid, Span, MassLid int }\nfunc allLanes() []Lane {\n\treturn []Lane{{"A","A1",180,2000,8000},{"A","A2",180,2000,8000},\n\t\t{"B","B1",420,2000,18000},{"B","B2",420,2000,18000}}\n}\nfunc deckLid(deck string) int { if deck == "A" { return 11000 }; return 28000 }\nfunc sister(name string) string {\n\tswitch name { case "A1": return "A2"; case "A2": return "A1"; case "B1": return "B2"; default: return "B1" }\n}\nEOF\ncat > offer.go <<\'EOF\'\npackage main\n\ntype occ struct { used, mass, lastHaz int; has bool }\n\nfunc pickLane(car Car, fill map[string]*occ, deckKg map[string]int) (Lane, int, bool) {\n\tfor _, lane := range allLanes() {\n\t\tif car.Ht > lane.Lid { continue }\n\t\tslot := fill[lane.Name]\n\t\tif slot == nil { slot = &occ{} }\n\t\tgap := 0\n\t\tif slot.has { gap = neighbourGap(slot.lastHaz, car.Haz) }\n\t\tneed := car.Len + gap + rampApron(car.Haz)\n\t\tif slot.used + need > lane.Span { continue }\n\t\tif !massFits(lane, slot, car, deckKg[lane.Deck]) { continue }\n\t\tif !trimFits(lane, fill, car.Mass) { continue }\n\t\treturn lane, gap, true\n\t}\n\treturn Lane{}, 0, false\n}\nEOF\ncat > kilo.go <<\'EOF\'\npackage main\nfunc massFits(lane Lane, slot *occ, car Car, deckUsed int) bool {\n\treturn slot.mass + car.Mass <= lane.MassLid && deckUsed + car.Mass <= deckLid(lane.Deck)\n}\nEOF\ncat > trim.go <<\'EOF\'\npackage main\nfunc trimFits(lane Lane, fill map[string]*occ, extra int) bool {\n\there, other := fill[lane.Name], fill[sister(lane.Name)]\n\t// The first plate on either sister lane is explicitly free.\n\tif here == nil || !here.has || other == nil || !other.has { return true }\n\td := here.mass + extra - other.mass\n\tif d < 0 { d = -d }\n\treturn d <= 3000\n}\nEOF\ncat > spacing.go <<\'EOF\'\npackage main\nfunc neighbourGap(prevHaz, haz int) int {\n\tif prevHaz == 0 && haz == 0 { return 0 }\n\tif prevHaz == 1 && haz == 1 { return 200 }\n\treturn 100\n}\nEOF\ncat > apron.go <<\'EOF\'\npackage main\nfunc rampApron(haz int) int { if haz == 1 { return 100 }; return 0 }\nEOF\ncat > board.go <<\'EOF\'\npackage main\nimport "sort"\nfunc arrange(cars []Car) []Car {\n\tout := append([]Car(nil), cars...)\n\tsort.SliceStable(out, func(i,j int) bool {\n\t\tif out[i].Board != out[j].Board { return out[i].Board < out[j].Board }\n\t\treturn out[i].Plate < out[j].Plate\n\t})\n\treturn out\n}\nfunc stationOf(cursor int, car Car, gap int) int { return cursor - gap - car.Len }\nEOF\ncat > fold.go <<\'EOF\'\npackage main\n\nimport (\n\t"encoding/json"\n\t"strings"\n)\n\ntype chalkRow struct {\n\tI int `json:"i"`\n\tVerb string `json:"verb"`\n\tPlate string `json:"plate"`\n\tDeck string `json:"deck,omitempty"`\n\tLane string `json:"lane,omitempty"`\n\tStation *int `json:"station,omitempty"`\n\tOK string `json:"ok"`\n}\n\nfunc fold(sheet string) (int, string) {\n\tcars, rc := parseRoll(sheet)\n\tif rc != 0 { return rc, "" }\n\tif len(cars) == 0 { return 0, "" }\n\tplaces := make([]Placement, len(cars))\n\tfill := map[string]*occ{}\n\tdeckKg := map[string]int{}\n\tfor _, car := range arrange(cars) {\n\t\tlane, gap, ok := pickLane(car, fill, deckKg)\n\t\tif !ok { continue }\n\t\tslot := fill[lane.Name]\n\t\tif slot == nil { slot = &occ{}; fill[lane.Name] = slot }\n\t\tstation := stationOf(lane.Span-slot.used, car, gap)\n\t\tplaces[car.Input] = Placement{Deck:lane.Deck, Lane:lane.Name, Station:station, OK:true}\n\t\tslot.used += gap + car.Len + rampApron(car.Haz)\n\t\tslot.mass += car.Mass\n\t\tslot.lastHaz = car.Haz\n\t\tslot.has = true\n\t\tdeckKg[lane.Deck] += car.Mass\n\t}\n\tvar out strings.Builder\n\tfor i, car := range cars {\n\t\tp := places[i]\n\t\tr := chalkRow{I:i+1, Verb:"stow", Plate:car.Plate, OK:"no"}\n\t\tif p.OK { r.Deck=p.Deck; r.Lane=p.Lane; r.Station=&p.Station; r.OK="yes" }\n\t\tb, _ := json.Marshal(r); out.Write(b); out.WriteByte(\'\\n\')\n\t}\n\treturn 0, out.String()\n}\nEOF\nrm -f chalk.go\nmake install\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
