[24.375141, "o", "{\"hash\":{\"api/Bond.u\":\"417ae81c272cf078de90cc356723447dc2c9e3fd8a4f8b22f36d82eb530323d5\",\"api/Kin.u\":\"6a69777137af9e89cf8ebee26184156d7eefd48c395ae7a67455a75f1265e4a4\",\"api/LocalAid.u\":\"54e8703a9c792d959817838374cf41e88198d1b955dc0bb522943b53e6935dcf\",\"api/Vest.u\":\"7d01d4894722066129a7cc5d728c0d8d20b7bb403036fff4bf30cc248aedf90e\",\"desk/Clerk.u\":\"32b797c45cbdfaf9f51c1c11e76fbe55c08a2fb84d20b73345b799e7c2515589\",\"desk/Watch.u\":\"ba6d0056e808b8d4ca8f1943f3a572bbed76995a00b76ad5af5b00637ad976e5\",\"wire/Port.u\":\"a7a133c5e5fd98c247b35030a28befe9b0a177f56470cb3dbf7a70f0f21f4224\"},\"fps\":{\"Bond\":\"bind:1\",\"Kin\":\"tug:1\"},\"cites\":{\"api/Bond.u\":[],\"api/Kin.u\":[],\"api/LocalAid.u\":[],\"api/Vest.u\":[],\"desk/Clerk.u\":[],\"desk/Watch.u\":[],\"wire/Port.u\":[\"Bond\"]}}"]
