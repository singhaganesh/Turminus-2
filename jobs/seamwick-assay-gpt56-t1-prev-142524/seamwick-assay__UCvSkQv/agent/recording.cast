[23.359517, "o", "### impgraph/Scan.java\r\n"]
[23.361758, "o", "import java.util.*;\r\npublic class Scan {\r\n  public static Set<String> lines(String body) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    for (String line : body.split(\"\\n\")) {\r\n      String t = line.trim();\r\n      if (t.startsWith(\"import \")) s.add(t);\r\n    }\r\n    return s;\r\n  }\r\n}\r\n"]
[23.362136, "o", "### wipevat/Dump.java\r\n"]
[23.363432, "o", "import java.nio.file.*;\r\npublic class Dump {\r\n  public static void wipe() throws Exception {\r\n    Path p = Paths.get(\"/app/blot\");\r\n    if (Files.exists(p)) {\r\n      Files.walk(p).sorted((a, b) -> b.compareTo(a)).forEach(x -> {\r\n        try { Files.deleteIfExists(x); } catch (Exception e) {}\r\n      });\r\n    }\r\n  }\r\n}\r\n"]
[23.363655, "o", "### deskbin/gen/Cite.java\r\n"]
[23.364857, "o", "import java.util.*;\r\npublic class Cite {\r\n  public static LinkedHashSet<String> tags(String body, Set<String> known) {\r\n    LinkedHashSet<String> out = new LinkedHashSet<String>();\r\n    String[] lines = body.split(\"\\n\");\r\n    for (int i = 0; i < lines.length; i++) {\r\n      String t = lines[i].trim();\r\n      if (t.startsWith(\"import \")) {\r\n        String r = t.substring(7).replace(\";\", \"\").trim();\r\n        int d = r.lastIndexOf('.');\r\n        String n = d < 0 ? r : r.substring(d + 1);\r\n        if (known.contains(n)) out.add(n);\r\n      }\r\n    }\r\n    return out;\r\n  }\r\n}\r\n"]
[23.365048, "o", "### deskbin/gen/Sched.java\r\n"]
[23.366347, "o", "import java.util.*;\r\npublic class Sched {\r\n  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(changedFiles);\r\n    for (String c : changedFiles) {\r\n      Set<String> im = importers.get(c);\r\n      if (im != null) s.addAll(im);\r\n    }\r\n    return new ArrayList<String>(s);\r\n  }\r\n}\r\n"]
[23.366687, "o", "### deskbin/gen/Seal.java\r\n"]
[23.36848, "o", "import java.util.*;\r\npublic class Seal {\r\n  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(hitUnits);\r\n    return new ArrayList<String>(s);\r\n  }\r\n  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\r\n    if (analysed.size() >= floor) return \"0\";\r\n    if (hitUnits.isEmpty()) return \"0\";\r\n    return \"1\";\r\n  }\r\n}\r\n"]
