[174.338431, "i", "cd /app && python3 - <<'PY'\np='seamcmd/Drive.java'\ns=open(p).read()\nneedle='        pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\\n'\nreplacement=needle + '''        // Never omit a unit that the complete mill would flag.  This keeps\n        // dirty-tree findings stable after an earlier run advances the cache.\n        LinkedHashSet<String> safePick = new LinkedHashSet<String>(pick);\n        for (Loom.Unit candidate : units.values()) {\n          if (!candidate.hits.isEmpty()) safePick.add(candidate.path);\n        }\n        pick = new ArrayList<String>(safePick);\n'''\nif needle not in s:\n    raise SystemExit('scheduling statement not found')\ns=s.replace(needle,replacement,1)\nopen(p,'w').write(s)\nPY\ngrep -n -A9 -B2 safePick seamcmd/Drive.java\n./assemble.bash\n"]
