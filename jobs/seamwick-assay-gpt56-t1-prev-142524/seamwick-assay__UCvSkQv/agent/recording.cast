[205.613926, "o", "\u001b[?2004h> d={n:json.load(open('/tmp/'+n+'.json')) for n in names}\r\n\u001b[?2004l\r\u001b[?2004h> for n in names: print(n,d[n])\r\n\u001b[?2004l\r\u001b[?2004h> assert all(d[n]['code']=='1' for n in names)\r\n\u001b[?2004l\r\u001b[?2004h> assert d['n1']['findings']==d['n2']['findings']==d['f2']['findings']==d['n3']['findings']\r\n\u001b[?2004l\r"]
[205.614944, "o", "\u001b[?2004h> "]
[205.615814, "o", "assert {x['unit'] for x in d['f2']['findings']} <= set(d['n3']['assayed'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.616664, "o", "PY\r\n\u001b[?2004l\r"]
[206.558842, "o", "rc first=1 repeat=1 flood=1 after=1\r\n"]
