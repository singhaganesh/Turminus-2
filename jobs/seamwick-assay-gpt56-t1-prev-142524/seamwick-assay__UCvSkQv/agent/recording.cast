[53.801791, "i", "cd /app && nl -ba impgraph/Scan.java; nl -ba purlbox/PurlBox.java\n"]
[53.802887, "o", "cd /app && nl -ba impgraph/Scan.java; nl -ba purlbox/PurlBox.java\r\n\u001b[?2004l\r"]
[53.805655, "o", "     1\timport java.util.*;\r\n     2\tpublic class Scan {\r\n     3\t  public static Set<String> lines(String body) {\r\n     4\t    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n     5\t    for (String line : body.split(\"\\n\")) {\r\n     6\t      String t = line.trim();\r\n     7\t      if (t.startsWith(\"import \")) s.add(t);\r\n     8\t    }\r\n     9\t    return s;\r\n    10\t  }\r\n    11\t}\r\n"]
[53.807792, "o", "     1\timport java.io.*;\r\n     2\tpublic class PurlBox {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Cite.java\")));\r\n     7\t    purl(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void purl(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.util.*;\");\r\n    12\t    a.println(\"public class Cite {\");\r\n    13\t    a.println(\"  public static LinkedHashSet<String> tags(String body, Set<String> known) {\");\r\n    14\t    a.println(\"    LinkedHashSet<String> out = new LinkedHashSet<String>();\");\r\n    15\t    a.println(\"    String[] lines = body.split(\\\"\\\\n\\\");\");\r\n    16\t    a.println(\"    for (int i = 0; i < lines.length; i++) {\");\r\n    17\t    a.println(\"      String t = lines[i].trim();\");\r\n    18\t    a.println(\"      if (t.startsWith(\\\"import \\\")) {\");\r\n    19\t    a.println(\"        String r = t.substring(7).replace(\\\";\\\", \\\"\\\").trim();\");\r\n    20\t    a.println(\"        int d = r.lastIndexOf('.');\");\r\n    21\t    a.println(\"        String n = d < 0 ? r : r.substring(d + 1);\");\r\n    22\t    a.println(\"        if (known.contains(n)) out.add(n);\");\r\n    23\t    a.println(\"      }\");\r\n    24\t    a.println(\"    }\");\r\n    25\t    a.println(\"    return out;\");\r\n    26\t    a.println(\"  }\");\r\n    27\t    a.println(\"}\");\r\n    28\t  }\r\n    29\t}\r\n"]
[53.80934, "o", "\u001b[?2004hroot@b9349ff9908f:/app# "]
[94.918378, "i", "cd /app && cat > purlbox/PurlBox.java <<'EOF'\nimport java.io.*;\npublic class PurlBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Cite.java\")));\n    purl(w);\n    w.close();\n  }\n  public static void purl(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Cite {\");\n    a.println(\"  public static LinkedHashSet<String> tags(String body, Set<String> known) {\");\n    a.println(\"    LinkedHashSet<String> out = new LinkedHashSet<String>();\");\n    a.println(\"    String[] words = body.split(\\\"[^A-Za-z0-9_]+\\\");\");\n    a.println(\"    for (String word : words) {\");\n    a.println(\"      if (known.contains(word)) out.add(word);\");\n    a.println(\"    }\");\n    a.println(\"    return out;\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\ncat > knitwell/ops/KnitBox.java <<'EOF'\nimport java.io.*;\npublic class KnitBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Sched.java\")));\n    knit(w);\n    w.close();\n  }\n  public static void knit(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Sched {\");\n    a.println(\"  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\");\n    a.println(\"    LinkedHashSet<String> s = new LinkedHashSet<String>();\");\n    a.println(\"    s.addAll(changedFiles);\");\n    a.println(\"    for (String c : changedFiles) {\");\n    a.println(\"      Set<String> im = importers.get(c);\");\n    a.println(\"      if (im != null) s.addAll(im);\");\n    a.println(\"    }\");\n    a.println(\"    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\");\n    a.println(\"      for (String type : e.getValue()) {\");\n    a.println(\"        if (changedTypes.contains(type)) { s.add(e.getKey()); break; }\");\n    a.println(\"      }\");\n    a.println(\"    }\");\n    a.println(\"    return new ArrayList<String>(s);\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\ncat > tintlag/core/TintBox.java <<'EOF'\nimport java.io.*;\npublic class TintBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Seal.java\")));\n    tint(w);\n    w.close();\n  }\n  public static void tint(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Seal {\");\n    a.println(\"  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\");\n    a.println(\"    return new ArrayList<String>(new LinkedHashSet<String>(analysed));\");\n    a.println(\"  }\");\n    a.println(\"  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\");\n    a.println(\"    LinkedHashSet<String> done = new LinkedHashSet<String>(analysed);\");\n    a.println(\"    if (done.size() < floor) return \\\"1\\\";\");\n    a.println(\"    if (!done.containsAll(must)) return \\\"1\\\";\");\n    a.println(\"    if (!hitUnits.isEmpty()) return \\\"1\\\";\");\n    a.println(\"    return \\\"0\\\";\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\npython3 - <<'PY'\np='seamcmd/Drive.java'\ns=open(p).read()\ns=s.replace('      writeCache(units, cites);\\n', '      if (!all) writeCache(units, cites);\\n')\nopen(p,'w').write(s)\nPY\n./assemble.bash\n"]
