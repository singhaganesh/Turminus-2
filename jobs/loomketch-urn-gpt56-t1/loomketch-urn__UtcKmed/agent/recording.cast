[142.167034, "i", "set +e\nmkdir -p /tmp/loom_out\n/app/bin/loomketch bind /tmp/loom_out >/dev/null 2>&1\ns=$?\nprintf 'outside status=%s guard=%s\\n' \"$s\" \"$(test -e /app/inkbay/GUARD && echo present || echo absent)\"\ntest \"$s\" -ne 0 && test ! -e /app/inkbay/GUARD || echo OUTSIDE_TEST_FAILED\ncat > /app/vatlogs/truncated.asan <<'EOF'\n==1==ERROR: AddressSanitizer: heap-buffer-overflow on address 0x1234\n    #0 0x1234 in useful_frame source.c:1\nEOF\n/app/bin/loomketch bind >/dev/null 2>&1\ns=$?\nprintf 'truncated status=%s guard=%s\\n' \"$s\" \"$(test -e /app/inkbay/GUARD && echo present || echo absent)\"\ntest \"$s\" -ne 0 && test ! -e /app/inkbay/GUARD || echo TRUNCATED_TEST_FAILED\nrm -f /app/vatlogs/truncated.asan\nln -s /tmp/loom_out /app/vatlogs/escape_test\n/app/bin/loomketch bind >/dev/null 2>&1\ns=$?\nprintf 'symlink-escape status=%s guard=%s\\n' \"$s\" \"$(test -e /app/inkbay/GUARD && echo present || echo absent)\"\ntest \"$s\" -ne 0 && test ! -e /app/inkbay/GUARD || echo SYMLINK_TEST_FAILED\nrm -f /app/vatlogs/escape_test\n/app/bin/loomketch bind\nprintf 'final status=%s guard=%s magic=' \"$?\" \"$(cat /app/inkbay/GUARD 2>/dev/null)\"\nhead -c 4 /app/bin/loomketch | od -An -tx1\n"]
[142.168404, "o", "set +e\r\nmkdir -p /tmp/loom_out\r\n/app/bin/loomketch bind /tmp/loom_out >/dev/null 2>&1\r\ns=$?\r\nprintf 'outside status=%s guard=%s\\n' \"$s\" \"$(test -e /app/inkbay/GUARD && echo present || echo absent)\"\r\ntest \"$s\" -ne 0 && test ! -e /app/inkbay/GUARD || echo OUTSIDE_TEST_FAILED\r\ncat > /app/vatlogs/truncated.asan <<'EOF'\r\n==1==ERROR: AddressSanitizer: heap-buffer-overflow on address 0x1234\r\n    #0 0x1234 in useful_frame source.c:1\r\nEOF\r\n/app/bin/loomketch bind >/dev/null 2>&1\r\ns=$?\r\nprintf 'truncated status=%s guard=%s\\n' \"$s\" \"$(test -e /app/inkbay/GUARD && echo present || echo absent)\"\r\ntest \"$s\" -ne 0 && test ! -e /app/inkbay/GUARD || echo TRUNCATED_TEST_FAILED\r\nrm -f /app/vatlogs/truncated.asan\r\nln -s /tmp/loom_out /app/vatlogs/escape_test\r\n/app/bin/loomketch bind >/dev/null 2>&1\r\ns=$?\r\nprintf 'symlink-escape status=%s guard=%s\\n' \"$s\" \"$(test -e /app/inkbay/GUARD && echo present || echo absent)\"\r\ntest \"$s\" -ne 0 && test ! -e /app/inkbay/GUARD || echo SYMLINK_TEST_FAILED\r\nrm -f /app/vatlogs/escape_test\r\n/app/bin/loomketch bind\r\nprintf 'final status=%s guard=%s magic=' \"$?\" \"$(cat /app/inkbay/GUARD 2>/dev/null)\"\r\nhead -c 4 /app/bin/loomketch | od -An -tx1\r\n"]
