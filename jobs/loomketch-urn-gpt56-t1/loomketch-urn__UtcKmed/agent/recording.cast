[143.14858, "i", "python3 - <<'PY'\nimport json\nb=json.load(open('/app/inkbay/bound.json'))['findings']\nlines=open('/app/inkbay/desk.tsv').read().splitlines()\nassert lines[0] == 'issue\\tkind\\tbody'\nd=[]\nfor line in lines[1:]:\n    issue,kind,body=line.split('\\t')\n    d.append((int(issue),kind,body))\nassert [(r['issue'],r['kind'],r['body']) for r in b] == d\nassert [r['issue'] for r in b] == list(range(1,len(b)+1))\nassert all(not any(f.startswith(('__asan','__interceptor','__hwasan')) for f in r['frames']) for r in b)\nprint('OUTPUT_VALID', len(b), 'findings')\nPY\ncp /app/inkbay/bound.json /tmp/final.bound\ncp /app/inkbay/desk.tsv /tmp/final.desk\nKETCH_ALPHA=1 /app/bin/loomketch bind\ncmp /tmp/final.bound /app/inkbay/bound.json && cmp /tmp/final.desk /app/inkbay/desk.tsv && echo FINAL_DETERMINISTIC\n"]
