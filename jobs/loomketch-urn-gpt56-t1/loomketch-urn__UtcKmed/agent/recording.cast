[101.94354, "i", "cat > /app/urnwalk/walk.rs <<'EOF'\nuse std::path::{Path, PathBuf};\n\npub fn gather(root: &str) -> Result<Vec<PathBuf>, i32> {\n    let allowed = std::fs::canonicalize(\"/app/vatlogs\").map_err(|_| 2)?;\n    let start = std::fs::canonicalize(root).map_err(|_| 2)?;\n    if !start.starts_with(&allowed) || !start.is_dir() {\n        return Err(2);\n    }\n    let mut files = Vec::new();\n    visit(&start, &allowed, &mut files)?;\n    if files.is_empty() {\n        return Err(2);\n    }\n    files.sort();\n    Ok(files)\n}\n\nfn visit(dir: &Path, allowed: &Path, files: &mut Vec<PathBuf>) -> Result<(), i32> {\n    let mut entries = Vec::new();\n    for entry in std::fs::read_dir(dir).map_err(|_| 2)? {\n        entries.push(entry.map_err(|_| 2)?.path());\n    }\n    entries.sort();\n    for path in entries {\n        let real = std::fs::canonicalize(&path).map_err(|_| 2)?;\n        if !real.starts_with(allowed) {\n            return Err(2);\n        }\n        let meta = std::fs::metadata(&real).map_err(|_| 2)?;\n        if meta.is_dir() {\n            visit(&real, allowed, files)?;\n        } else if meta.is_file() {\n            files.push(real);\n        } else {\n            return Err(2);\n        }\n    }\n    Ok(())\n}\nEOF\ncat > /app/treyfun/clip.rs <<'EOF'\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() {\n        return Err(2);\n    }\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut saw_frame = false;\n\n    for line in text.lines() {\n        if let Some((_, rest)) = line.split_once(\"ERROR:\") {\n            if kind.is_some() {\n                return Err(2);\n            }\n            let rest = rest.trim();\n            let value = rest\n                .strip_prefix(\"AddressSanitizer:\")\n                .unwrap_or(rest)\n                .trim()\n                .split(\" on \")\n                .next()\n                .unwrap_or(\"\")\n                .trim();\n            if value.is_empty() {\n                return Err(2);\n            }\n            kind = Some(value.to_string());\n        }\n\n        let trimmed = line.trim_start();\n        if trimmed.starts_with('#') {\n            saw_frame = true;\n            let (_, after) = trimmed.split_once(\" in \").ok_or(2)?;\n            let sym = after.split_whitespace().next().ok_or(2)?;\n            if sym.is_empty() {\n                return Err(2);\n            }\n            if !is_runtime(sym) {\n                frames.push(fold_hex(sym));\n            }\n        }\n    }\n\n    let kind = kind.ok_or(2)?;\n    if !saw_frame || frames.is_empty() {\n        return Err(2);\n    }\n    Ok((kind, frames))\n}\n\nfn is_runtime(sym: &str) -> bool {\n    sym.starts_with(\"__asan\")\n        || sym.starts_with(\"__interceptor\")\n        || sym.starts_with(\"__hwasan\")\n}\n\nfn fold_hex(sym: &str) -> String {\n    let chars: Vec<char> = sym.chars().collect();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < chars.len() {\n        if chars[i] == '0' && i + 2 < chars.len() && chars[i + 1] == 'x' && chars[i + 2].is_ascii_hexdigit() {\n            out.push_str(\"<hex>\");\n            i += 2;\n            while i < chars.len() && chars[i].is_ascii_hexdigit() { i += 1; }\n            continue;\n        }\n        if chars[i].is_ascii_hexdigit() {\n            let start = i;\n            let mut has_digit = false;\n            while i < chars.len() && chars[i].is_ascii_hexdigit() {\n                has_digit |= chars[i].is_ascii_digit();\n                i += 1;\n            }\n            if i - start >= 4 && has_digit {\n                out.push_str(\"<hex>\");\n            } else {\n                for c in &chars[start..i] { out.push(*c); }\n            }\n            continue;\n        }\n        out.push(chars[i]);\n        i += 1;\n    }\n    out\n}\nEOF\n"]
