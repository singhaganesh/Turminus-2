[15.937449, "o", "--- bound.json ---\r\n"]
[15.941159, "o", "{\"findings\":[{\"issue\":1,\"kind\":\"stack-buffer-overflow\",\"frames\":[\"__interceptor_memcpy\",\"pump_read\",\"loop_tick\"],\"body\":\"__interceptor_memcpy | pump_read | loop_tick\"},{\"issue\":2,\"kind\":\"heap-use-after-free\",\"frames\":[\"__interceptor_memcpy\",\"widget_free\",\"worker_main\"],\"body\":\"__interceptor_memcpy | widget_free | worker_main\"},{\"issue\":3,\"kind\":\"use-after-return\",\"frames\":[\"__interceptor_memcpy\",\"latch_tick\",\"drain_slot\"],\"body\":\"__interceptor_memcpy | latch_tick | drain_slot\"},{\"issue\":4,\"kind\":\"heap-buffer-overflow\",\"frames\":[\"__interceptor_memcpy\",\"fill_span\",\"prep_buf\"],\"body\":\"__interceptor_memcpy | fill_span | prep_buf\"}]}\r\n--- desk.tsv ---\r\n"]
[15.94311, "o", "issue\tkind\tbody\r\n1\theap-buffer-overflow\t__interceptor_memcpy | fill_span | prep_buf\r\n2\theap-use-after-free\t__interceptor_memcpy | widget_free | worker_main\r\n3\tstack-buffer-overflow\t__interceptor_memcpy | pump_read | loop_tick\r\n4\tuse-after-return\t__interceptor_memcpy | latch_tick | drain_slot\r\n"]
[15.943419, "o", "--- GUARD ---\r\n"]
[15.945043, "o", "ok"]
