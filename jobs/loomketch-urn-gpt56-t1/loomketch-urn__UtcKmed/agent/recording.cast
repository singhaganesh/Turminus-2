terceptors.cpp:8\r\n/app/vatlogs/pid_3.asan:2:    #0 0xfff6aa in __asan::ReportGenericError asan.cpp:1\r\n/app/vatlogs/pid_3.asan:3:    #1 0xfff6bb in __interceptor_memcpy interceptors.cpp:8\r\n/app/tplbay/desk.tpl:1:issue\tkind\tbody\r\n/app/opsfold/SHIFT.txt:3:bind looked noisy when the vat directory came back in a different order.\r\n/app/opsfold/SHIFT.txt:5:Smoke still printed every finding. Desk citations still jumped on the next bind.\r\n/app/deskcue/MAP.txt:4:ketchcli/main.rs dispatches bind.\r\n/app/deskcue/MAP.txt:6:Other crates sit beside ketchcli. Journals live in /app/vatlogs.\r\n/app/deskcue/MAP.txt:7:Fixture copies of those journals sit at /app/seed/vatlogs.\r\n/app/deskcue/MAP.txt:8:bind refreshes /app/inkbay/bound.json, /app/inkbay/desk.tsv, and /app/inkbay/GUARD.\r\n/app/deskcue/MAP.txt:10:bound.json uses object findings as a list of records\r\n/app/deskcue/MAP.txt:11:{ \"issue\": N, \"kind\": \"<kind>\", \"frames\": [\"<sym>\", ...], \"body\": \"<text>\" }\r\n/app/deskcue/MAP.txt:12:where issue is an integer that starts at 1. desk.tsv starts with header\r\n/app/deskcue/MAP.txt:13:issue\tkind\tbody\r\n/app/deskcue/MAP.txt:14:then one tab-separated row per finding, using those same issue values.\r\n/app/deskcue/MAP.txt:20:A bind root such as /tmp/loom_out sits outside /app/vatlogs and must fail.\r\n/app/humdock/emit.rs:6:    let mut out = String::from(\"issue\\tkind\\tbody\\n\");\r\n/app/humdock/emit.rs:11:    if std::fs::write(\"/app/inkbay/desk.tsv\", out).is_err() {\r\n/app/humdock/emit.rs:14:    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\r\n/app/treyfun/clip.rs:3:        .filter(|s| !s.starts_with(\"__asan::\") && !s.starts_with(\"__asan_\"))\r\n/app/qanbox/tally.rs:10:    pub issue: i32,\r\n/app/qanbox/tally.rs:37:                issue: 0,\r\n/app/qanbox/tally.rs:54:        r.issue = (i as i32) + 1;\r\n/app/qanbox/tally.rs:63:        let _ = std::fs::write(\"/app/inkbay/bound.json\", tpl);\r\n/app/qanbox/tally.rs:72:            