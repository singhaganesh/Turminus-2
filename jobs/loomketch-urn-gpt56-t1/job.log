Sending keys: ['cat > /app/urnwalk/walk.rs <<\'EOF\'\nuse std::path::{Path, PathBuf};\n\npub fn gather(root: &str) -> Result<Vec<PathBuf>, i32> {\n    let allowed = std::fs::canonicalize("/app/vatlogs").map_err(|_| 2)?;\n    let start = std::fs::canonicalize(root).map_err(|_| 2)?;\n    if !start.starts_with(&allowed) || !start.is_dir() {\n        return Err(2);\n    }\n    let mut files = Vec::new();\n    visit(&start, &allowed, &mut files)?;\n    if files.is_empty() {\n        return Err(2);\n    }\n    files.sort();\n    Ok(files)\n}\n\nfn visit(dir: &Path, allowed: &Path, files: &mut Vec<PathBuf>) -> Result<(), i32> {\n    let mut entries = Vec::new();\n    for entry in std::fs::read_dir(dir).map_err(|_| 2)? {\n        entries.push(entry.map_err(|_| 2)?.path());\n    }\n    entries.sort();\n    for path in entries {\n        let real = std::fs::canonicalize(&path).map_err(|_| 2)?;\n        if !real.starts_with(allowed) {\n            return Err(2);\n        }\n        let meta = std::fs::metadata(&real).map_err(|_| 2)?;\n        if meta.is_dir() {\n            visit(&real, allowed, files)?;\n        } else if meta.is_file() {\n            files.push(real);\n        } else {\n            return Err(2);\n        }\n    }\n    Ok(())\n}\nEOF\ncat > /app/treyfun/clip.rs <<\'EOF\'\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() {\n        return Err(2);\n    }\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut saw_frame = false;\n\n    for line in text.lines() {\n        if let Some((_, rest)) = line.split_once("ERROR:") {\n            if kind.is_some() {\n                return Err(2);\n            }\n            let rest = rest.trim();\n            let value = rest\n                .strip_prefix("AddressSanitizer:")\n                .unwrap_or(rest)\n                .trim()\n                .split(" on ")\n                .next()\n                .unwrap_or("")\n                .trim();\n            if value.is_empty() {\n                return Err(2);\n            }\n            kind = Some(value.to_string());\n        }\n\n        let trimmed = line.trim_start();\n        if trimmed.starts_with(\'#\') {\n            saw_frame = true;\n            let (_, after) = trimmed.split_once(" in ").ok_or(2)?;\n            let sym = after.split_whitespace().next().ok_or(2)?;\n            if sym.is_empty() {\n                return Err(2);\n            }\n            if !is_runtime(sym) {\n                frames.push(fold_hex(sym));\n            }\n        }\n    }\n\n    let kind = kind.ok_or(2)?;\n    if !saw_frame || frames.is_empty() {\n        return Err(2);\n    }\n    Ok((kind, frames))\n}\n\nfn is_runtime(sym: &str) -> bool {\n    sym.starts_with("__asan")\n        || sym.starts_with("__interceptor")\n        || sym.starts_with("__hwasan")\n}\n\nfn fold_hex(sym: &str) -> String {\n    let chars: Vec<char> = sym.chars().collect();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < chars.len() {\n        if chars[i] == \'0\' && i + 2 < chars.len() && chars[i + 1] == \'x\' && chars[i + 2].is_ascii_hexdigit() {\n            out.push_str("<hex>");\n            i += 2;\n            while i < chars.len() && chars[i].is_ascii_hexdigit() { i += 1; }\n            continue;\n        }\n        if chars[i].is_ascii_hexdigit() {\n            let start = i;\n            let mut has_digit = false;\n            while i < chars.len() && chars[i].is_ascii_hexdigit() {\n                has_digit |= chars[i].is_ascii_digit();\n                i += 1;\n            }\n            if i - start >= 4 && has_digit {\n                out.push_str("<hex>");\n            } else {\n                for c in &chars[start..i] { out.push(*c); }\n            }\n            continue;\n        }\n        out.push(chars[i]);\n        i += 1;\n    }\n    out\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/qanbox/tally.rs <<\'EOF\'\n#[path = "../treyfun/clip.rs"]\nmod clip;\n\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<String>,\n    pub body: String,\n}\n\npub fn tally(root: &str) -> Result<Vec<Rec>, i32> {\n    let paths = crate::walk::gather(root)?;\n    let mut by_identity: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\n\n    for path in paths {\n        let text = std::fs::read_to_string(path).map_err(|_| 2)?;\n        let (kind, frames) = clip::take(&text)?;\n        let body = frames.join(" | ");\n        let candidate = Rec { issue: 0, kind, frames: frames.clone(), body };\n        match by_identity.get(&frames) {\n            Some(old) if old.kind != candidate.kind => return Err(2),\n            Some(_) => {}\n            None => { by_identity.insert(frames, candidate); }\n        }\n    }\n\n    if by_identity.is_empty() {\n        return Err(2);\n    }\n    let mut recs: Vec<Rec> = by_identity.into_values().collect();\n    recs.sort_by(|a, b| a.frames.cmp(&b.frames).then_with(|| a.kind.cmp(&b.kind)));\n    for (i, rec) in recs.iter_mut().enumerate() {\n        rec.issue = (i + 1) as i32;\n    }\n    write_bound(&recs)?;\n    Ok(recs)\n}\n\nfn write_bound(recs: &[Rec]) -> Result<(), i32> {\n    let tpl = std::fs::read_to_string("/app/tplbay/bound.tpl").map_err(|_| 1)?;\n    if !tpl.contains("__ROWS__") {\n        return Err(1);\n    }\n    let rows: Vec<String> = recs.iter().map(|r| format!(\n        "{{\\"issue\\":{},\\"kind\\":{},\\"frames\\":{},\\"body\\":{}}}",\n        r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body)\n    )).collect();\n    std::fs::create_dir_all("/app/inkbay").map_err(|_| 1)?;\n    std::fs::write("/app/inkbay/bound.json", tpl.replace("__ROWS__", &rows.join(","))).map_err(|_| 1)\n}\n\nfn jstr(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in s.chars() {\n        match c {\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if c < \' \' => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn jarr(v: &[String]) -> String {\n    format!("[{}]", v.iter().map(|x| jstr(x)).collect::<Vec<_>>().join(","))\n}\nEOF\ncat > /app/humdock/emit.rs <<\'EOF\'\nuse crate::tally::Rec;\n\npub fn emit(rows: &[Rec]) -> i32 {\n    let mut out = String::from("issue\\tkind\\tbody\\n");\n    for r in rows {\n        out.push_str(&format!("{}\\t{}\\t{}\\n", r.issue, r.kind, r.body));\n    }\n    if std::fs::create_dir_all("/app/inkbay").is_err()\n        || std::fs::write("/app/inkbay/desk.tsv", out).is_err()\n        || std::fs::write("/app/inkbay/GUARD", "ok").is_err()\n    {\n        let _ = std::fs::remove_file("/app/inkbay/GUARD");\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/ketchcli/main.rs <<\'EOF\'\n#[path = "../urnwalk/walk.rs"]\nmod walk;\n#[path = "../walkcue/alpha.rs"]\nmod alpha;\n#[path = "../qanbox/tally.rs"]\nmod tally;\n#[path = "../humdock/emit.rs"]\nmod rib;\n\nfn main() {\n    let _ = std::fs::remove_file("/app/inkbay/GUARD");\n    let mut args = std::env::args().skip(1);\n    if args.next().as_deref() != Some("bind") {\n        eprintln!("usage: loomketch bind [root]");\n        std::process::exit(2);\n    }\n    let root = args.next().unwrap_or_else(|| "/app/vatlogs".to_string());\n    if args.next().is_some() {\n        eprintln!("usage: loomketch bind [root]");\n        std::process::exit(2);\n    }\n    let code = match tally::tally(&root) {\n        Ok(recs) => rib::emit(&recs),\n        Err(code) => code,\n    };\n    if code != 0 {\n        let _ = std::fs::remove_file("/app/inkbay/GUARD");\n    }\n    std::process::exit(code);\n}\nEOF\n/app/hearth.sh\n/app/bin/loomketch bind; echo status=$?\nhead -c 4 /app/bin/loomketch | od -An -tx1\ncat /app/inkbay/bound.json; cat /app/inkbay/desk.tsv; printf \'GUARD=\'; cat /app/inkbay/GUARD; echo\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
