import json,hashlib
j=json.load(open('/app/kegbay/upload.json'))
assert j['batch_count']==3
assert [e['seq'] for e in j['entries']]==list(range(1,8))
assert [e['name'] for e in j['entries']]==['old.clat','b.clat','d.clat','a.clat','a2.clat','e.clat','e2.clat']
for e in j['entries']:
 assert e['digest']==hashlib.sha256(open('/app/dropwell/'+e['name'],'rb').read()).hexdigest()
assert open('/app/kegbay/MARK').read()=='ok'
assert open('/app/bin/clatter','rb').read(4)==b'\x7fELF'
print('final validation ok')
PY
