[30.486587, "i", "cat /app/fold.rs; printf '\\n--- emit.rs ---\\n'; cat /app/deskbin/emit.rs; printf '\\n--- sum.rs ---\\n'; cat /app/deskbin/sum.rs\n"]
[30.48764, "o", "cat /app/fold.rs; printf '\\n--- emit.rs ---\\n'; cat /app/deskbin/emit.rs; printf '\\n--- sum.rs ---\\n'; cat /app/deskbin/sum.rs\r\n\u001b[?2004l\r"]
[30.489655, "o", "use std::collections::HashMap;\r\n\r\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\r\n    if let Some(r) = root {\r\n        if r.is_empty() {\r\n            return Err(1);\r\n        }\r\n    }\r\n    if pairs.is_empty() {\r\n        return Ok(Vec::new());\r\n    }\r\n    let mut by: HashMap<[u8; 16], Vec<(u64, String)>> = HashMap::new();\r\n    for (n, k) in pairs {\r\n        let m = crate::parse::load(n);\r\n        by.entry(m.guid).or_default().push((*k, n.clone()));\r\n    }\r\n    let mut out = Vec::new();\r\n    for (_g, mut rows) in by {\r\n        rows.sort_by_key(|r| r.0);\r\n        out.extend(rows.into_iter().map(|r| r.1));\r\n    }\r\n    Ok(out)\r\n}\r\n"]
[30.4901, "o", "\r\n--- emit.rs ---\r\n"]
[30.491977, "o", "use std::fs;\r\nuse std::path::Path;\r\n\r\nfn read_pairs() -> Vec<(String, u64)> {\r\n    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default();\r\n    let mut v = Vec::new();\r\n    for line in raw.lines() {\r\n        let mut it = line.split('\\t');\r\n        if let (Some(n), Some(k)) = (it.next(), it.next()) {\r\n            if let Ok(u) = k.parse::<u64>() {\r\n                v.push((n.to_string(), u));\r\n            }\r\n        }\r\n    }\r\n    v\r\n}\r\n\r\npub fn finish() -> i32 {\r\n    let pairs = read_pairs();\r\n    match crate::fold::rib_c(&pairs, None) {\r\n        Err(c) => c,\r\n        Ok(names) => {\r\n            fs::create_dir_all(\"/app/kegbay\").ok();\r\n            let mut body = String::new();\r\n            for (i, n) in names.iter().enumerate() {\r\n                let m = crate::parse::load(n);\r\n                body.push_str(&format!(\r\n                    \"{}\\t{}\\t{}\\n\",\r\n                    i + 1,\r\n                    n,\r\n                    crate::parse::guid_hex(&m.guid)\r\n                ));\r\n            }\r\n            fs::write(\"/app/kegbay/ribbon.txt\", body).ok();\r\n            0\r\n        }\r\n    }\r\n}\r\n\r\npub fn pour() -> i32 {\r\n    let arg = std::env::args().nth(2);\r\n    let root = arg.unwrap_or_else(|| \"/app/dropwell\".to_string());\r\n    match crate::fold::rib_c(&[], Some(&root)) {\r\n        Err(c) => {\r\n            let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n            return c;\r\n        }\r\n        Ok(_) => {}\r\n    }\r\n    let ribbon = fs::read_to_string(\"/app/kegbay/ribbon.txt\").unwrap_or_default();\r\n    let mut rows: Vec<(u32, String, String, String)> = Vec::new();\r\n    for line in ribbon.lines() {\r\n        let p: Vec<&str> = line.split('\\t').collect();\r\n        if p.len() < 3 {\r\n            continue;\r\n        }\r\n        let seq: u32 = p[0].parse().unwrap_or(0);\r\n        let name = p[1].to_string();\r\n        let g = p[2].to_string();\r\n        let digest = crate::sum::hex_file(&name);\r\n        rows.push((seq, Path::new(&name).file_name().unwrap().to_string_lossy().to_string(), digest, g));\r\n    }\r\n    let n = rows.len();\r\n    let batches = if n == 0 { 0 } else { (n + 2) "]
[30.492226, "o", "/ 3 };\r\n    let mut json = String::from(\"{\\\"batch_count\\\":\");\r\n    json.push_str(&batches.to_string());\r\n    json.push_str(\",\\\"entries\\\":[\");\r\n    for (i, (seq, name, digest, g)) in rows.iter().enumerate() {\r\n        if i > 0 {\r\n            json.push(',');\r\n        }\r\n        json.push_str(&format!(\r\n            \"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",\r\n            seq, name, digest, g\r\n        ));\r\n    }\r\n    json.push_str(\"]}\\n\");\r\n    fs::create_dir_all(\"/app/kegbay\").ok();"]
[30.49239, "o", "\r\n    fs::write(\"/app/kegbay/upload.json\", json).ok();\r\n    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n    for (seq, name, digest, g) in &rows {\r\n        tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, g));\r\n    }\r\n    fs::write(\"/app/kegbay/batch.tsv\", tsv).ok();\r\n    fs::write(\"/app/kegbay/MARK\", \"ok\").ok();\r\n    0\r\n}\r\n"]
[30.492531, "o", "\r\n--- sum.rs ---\r\n"]
[30.493658, "o", "use std::process::Command;\r\n\r\npub fn hex_file(path: &str) -> String {\r\n    let out = Command::new(\"sha256sum\")\r\n        .arg(path)\r\n        .output()\r\n        .ok()\r\n        .and_then(|o| String::from_utf8(o.stdout).ok())\r\n        .unwrap_or_default();\r\n    out.split_whitespace().next().unwrap_or(\"\").to_string()\r\n}\r\n"]
[30.493906, "o", "\u001b[?2004hroot@fa3360074fc1:/app# "]
[30.700062, "i", "python3 - <<'PY'\nimport os,struct,glob,hashlib\nfor p in sorted(glob.glob('/app/dropwell/*')):\n b=open(p,'rb').read(); n=struct.unpack_from('<H',b,10)[0]; streams=[]\n for i in range(n):\n  st,rva,sz=struct.unpack_from('<III',b,12+12*i); data=b[rva:rva+sz]\n  if st==3: val=('exception',struct.unpack_from('<III',data))\n  elif st==15: val=('misc',data[:16].hex(),data[16] if len(data)>16 else None)\n  else: val=('other',data.hex())\n  streams.append((st,rva,sz,val))\n print(os.path.basename(p),'stamp',struct.unpack_from('<I',b,6)[0],'mtime_ns',os.stat(p).st_mtime_ns,'streams',streams,'sha',hashlib.sha256(b).hexdigest())\nPY\n"]
