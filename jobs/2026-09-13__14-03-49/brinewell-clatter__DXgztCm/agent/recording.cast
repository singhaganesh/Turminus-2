[116.133537, "i", "cat > /app/deskbin/parse.rs <<'RS'\nuse std::fs;\n\n#[derive(Clone)]\npub struct Meta {\n    pub write_stamp: u32,\n    pub crash: Option<u64>,\n    pub guid: [u8; 16],\n    pub companion: u8,\n}\n\npub fn load(path: &str) -> Result<Meta, ()> {\n    let b = fs::read(path).map_err(|_| ())?;\n    if b.len() < 12 || &b[0..4] != b\"CLAT\" { return Err(()); }\n    let write_stamp = u32::from_le_bytes(b[6..10].try_into().map_err(|_| ())?);\n    let n = u16::from_le_bytes(b[10..12].try_into().map_err(|_| ())?) as usize;\n    if 12usize.checked_add(n.checked_mul(12).ok_or(())?).ok_or(())? > b.len() { return Err(()); }\n    let mut crash = None;\n    let mut guid = None;\n    let mut companion = 0u8;\n    for i in 0..n {\n        let off = 12 + i * 12;\n        let st = u32::from_le_bytes(b[off..off+4].try_into().map_err(|_| ())?);\n        let rva = u32::from_le_bytes(b[off+4..off+8].try_into().map_err(|_| ())?) as usize;\n        let sz = u32::from_le_bytes(b[off+8..off+12].try_into().map_err(|_| ())?) as usize;\n        let end = rva.checked_add(sz).ok_or(())?;\n        if end > b.len() { return Err(()); }\n        let sl = &b[rva..end];\n        if st == 3 {\n            if sl.len() < 8 { return Err(()); }\n            let lo = u32::from_le_bytes(sl[0..4].try_into().map_err(|_| ())?);\n            let hi = u32::from_le_bytes(sl[4..8].try_into().map_err(|_| ())?);\n            crash = Some(((hi as u64) << 32) | lo as u64);\n        } else if st == 15 {\n            if sl.len() < 17 { return Err(()); }\n            let mut g = [0u8; 16];\n            g.copy_from_slice(&sl[..16]);\n            guid = Some(g);\n            companion = sl[16];\n        }\n    }\n    Ok(Meta { write_stamp, crash, guid: guid.ok_or(())?, companion })\n}\n\npub fn guid_hex(g: &[u8; 16]) -> String {\n    const H: &[u8; 16] = b\"0123456789abcdef\";\n    let mut s = String::with_capacity(32);\n    for &x in g { s.push(H[(x >> 4) as usize] as char); s.push(H[(x & 15) as usize] as char); }\n    s\n}\nRS\ncat > /app/walk.rs <<'RS'\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let mut names = Vec::new();\n    let rd = fs::read_dir(\"/app/dropwell\").map_err(|_| 1)?;\n    for ent in rd {\n        let ent = ent.map_err(|_| 1)?;\n        let p = ent.path();\n        if !p.is_file() || p.extension().and_then(|x| x.to_str()) != Some(\"clat\") { continue; }\n        let s = p.to_string_lossy().into_owned();\n        crate::parse::load(&s).map_err(|_| 1)?;\n        names.push(s);\n    }\n    names.sort_by(|a,b| a.as_bytes().cmp(b.as_bytes()));\n    if names.is_empty() { Err(1) } else { Ok(names) }\n}\nRS\ncat > /app/stamp.rs <<'RS'\npub fn rib_b(names: &[String]) -> Result<Vec<(String, u64)>, i32> {\n    let mut out = Vec::new();\n    for n in names {\n        let m = crate::parse::load(n).map_err(|_| 1)?;\n        out.push((n.clone(), m.crash.unwrap_or(m.write_stamp as u64)));\n    }\n    Ok(out)\n}\nRS\ncat > /app/fold.rs <<'RS'\nuse std::collections::{HashMap, HashSet};\nuse std::fs;\nuse std::path::Path;\n\n#[derive(Clone)]\nstruct Group { guid: [u8;16], chrono: u64, rows: Vec<(String,u8)>, anchor: Option<usize> }\n\nfn prior() -> HashMap<String,usize> {\n    let source = if Path::new(\"/app/tidearc/lastgood.rec\").is_file() {\n        \"/app/tidearc/lastgood.rec\"\n    } else { \"/app/kegbay/hide.rec\" };\n    let mut out = HashMap::new();\n    if let Ok(raw) = fs::read_to_string(source) {\n        for (i,line) in raw.lines().enumerate() {\n            let p: Vec<&str> = line.split_whitespace().collect();\n            if p.len() >= 2 { out.entry(p[1].to_string()).or_insert(i); }\n        }\n    }\n    out\n}\n\npub fn rib_c(pairs: &[(String,u64)]) -> Result<Vec<String>,i32> {\n    if pairs.is_empty() { return Err(1); }\n    let old = prior();\n    let mut map: HashMap<[u8;16],Group> = HashMap::new();\n    for (path,key) in pairs {\n        let m = crate::parse::load(path).map_err(|_| 1)?;\n        let name = Path::new(path).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n        let g = map.entry(m.guid).or_insert(Group { guid:m.guid, chrono:*key, rows:Vec::new(), anchor:None });\n        if m.crash.is_some() || g.rows.is_empty() { g.chrono = g.c"]
[116.134001, "i", "hrono.min(*key); }\n        if let Some(&ix) = old.get(&name) { g.anchor = Some(g.anchor.map_or(ix, |v| v.min(ix))); }\n        g.rows.push((path.clone(),m.companion));\n    }\n    let mut groups: Vec<Group> = map.into_values().collect();\n    let mut anchored: Vec<Group> = groups.iter().filter(|g| g.anchor.is_some()).cloned().collect();\n    let mut fresh: Vec<Group> = groups.drain(..).filter(|g| g.anchor.is_none()).collect();\n    anchored.sort_by_key(|g| g.anchor.unwrap());\n    fresh.sort_by(|a,b| (a.chrono,a.guid).cmp(&(b.chrono,b.guid)));\n    for g in fresh {\n        let pos = anchored.iter().position(|x| x.chrono > g.chrono).unwrap_or(anchored.len());\n        anchored.insert(pos,g);\n    }\n    let mut out = Vec::new();\n    let mut seen = HashSet::new();\n    for mut g in anchored {\n        g.rows.sort_by(|a,b| {\n            let an = Path::new(&a.0).file_name().unwrap().to_string_lossy();\n            let bn = Path::new(&b.0).file_name().unwrap().to_string_lossy();\n            match (old.get(an.as_ref()),old.get(bn.as_ref())) {\n                (Some(x),Some(y)) => x.cmp(y),\n                _ => (a.1,an.as_bytes()).cmp(&(b.1,bn.as_bytes())),\n            }\n        });\n        for (p,_) in g.rows { if seen.insert(p.clone()) { out.push(p); } }\n    }\n    if out.len() != pairs.len() { Err(1) } else { Ok(out) }\n}\nRS\ncat > /app/deskbin/pipe.rs <<'RS'\nuse std::fs;\n\npub fn fill() -> i32 {\n    let _ = fs::remove_file(\"/app/kegbay/MARK\");\n    let names = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return c };\n    let pairs = match crate::stamp::rib_b(&names) { Ok(v) => v, Err(c) => return c };\n    if fs::create_dir_all(\"/app/kegbay\").is_err() { return 1; }\n    let mut body = String::new();\n    for (n,k) in pairs { body.push_str(&format!(\"{}\\t{}\\n\",n,k)); }\n    if fs::write(\"/app/kegbay/pairs.tmp\",body).is_err() { 1 } else { 0 }\n}\nRS\ncat > /app/deskbin/sum.rs <<'RS'\nuse std::process::Command;\npub fn hex_file(path: &str) -> Result<String,i32> {\n    let out = Command::new(\"sha256sum\").arg(\"--\").arg(path).output().map_err(|_|1)?;\n    if !out.status.success() { return Err(1); }\n    let text = String::from_utf8(out.stdout).map_err(|_|1)?;\n    let s = text.split_whitespace().next().ok_or(1)?.to_string();\n    if s.len()==64 && s.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c)) { Ok(s) } else { Err(1) }\n}\nRS\n"]
