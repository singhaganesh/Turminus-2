[148.421459, "i", "python3 - <<'PY'\np='/app/fold.rs'\ns=open(p).read()\ns=s.replace('struct Group { guid: [u8;16], chrono: u64, rows: Vec<(String,u8)>, anchor: Option<usize> }', 'struct Group { guid: [u8;16], crash_time: Option<u64>, fallback: u64, rows: Vec<(String,u8)>, anchor: Option<usize> }')\ns=s.replace('let g = map.entry(m.guid).or_insert(Group { guid:m.guid, chrono:*key, rows:Vec::new(), anchor:None });\\n        if m.crash.is_some() || g.rows.is_empty() { g.chrono = g.chrono.min(*key); }', 'let g = map.entry(m.guid).or_insert(Group { guid:m.guid, crash_time:None, fallback:*key, rows:Vec::new(), anchor:None });\\n        g.fallback = g.fallback.min(*key);\\n        if let Some(t) = m.crash { g.crash_time = Some(g.crash_time.map_or(t, |v| v.min(t))); }')\ns=s.replace('fresh.sort_by(|a,b| (a.chrono,a.guid).cmp(&(b.chrono,b.guid)));', 'fresh.sort_by(|a,b| (a.crash_time.unwrap_or(a.fallback),a.guid).cmp(&(b.crash_time.unwrap_or(b.fallback),b.guid)));')\ns=s.replace('let pos = anchored.iter().position(|x| x.chrono > g.chrono).unwrap_or(anchored.len());', 'let gc = g.crash_time.unwrap_or(g.fallback);\\n        let pos = anchored.iter().position(|x| x.crash_time.unwrap_or(x.fallback) > gc).unwrap_or(anchored.len());')\nopen(p,'w').write(s)\nPY\nPATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin /app/fat.sh\n/app/bin/clatter tallow && /app/bin/clatter pour\n"]
[148.421756, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[148.421879, "o", "\u001b[?2004h> p='/app/fold.rs'\r\n\u001b[?2004l\r"]
[148.423278, "o", "\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('struct Group { guid: [u8;16], chrono: u64, rows: Vec<(String,u8)>, anchor: Option<usize> }', 'struct Group { guid: [u8;16], crash_time: Option<u64>, fallback: u64, rows: Vec<(String,u8)>, anchor: Option<usize> }')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.424189, "o", "s=s.replace('let g = map.entry(m.guid).or_insert(Group { guid:m.guid, chrono:*key, rows:Vec::new(), anchor:None });\\n        if m.crash.is_some() || g.rows.is_empty() { g.chrono = g.chrono.min(*key); }', 'let g = map.entry(m.guid).or_insert(Group { guid:m.guid, crash_time:None, fallback:*key, rows:Vec::new(), anchor:None });\\n        g.fallback = g.fallback.min(*key);\\n        if let Some(t) = m.crash { g.crash_time = Some(g.crash_time.map_or(t, |v| v.min(t))); }')\r\n\u001b[?2004l\r"]
[148.42433, "o", "\u001b[?2004h> "]
[148.424737, "o", "s=s.replace('fresh.sort_by(|a,b| (a.chrono,a.guid).cmp(&(b.chrono,b.guid)));', 'fresh.sort_by(|a,b| (a.crash_time.unwrap_or(a.fallback),a.guid).cmp(&(b.crash_time.unwrap_or(b.fallback),b.guid)));')\r\n\u001b[?2004l\r"]
[148.424855, "o", "\u001b[?2004h> "]
[148.425417, "o", "s=s.replace('let pos = anchored.iter().position(|x| x.chrono > g.chrono).unwrap_or(anchored.len());', 'let gc = g.crash_time.unwrap_or(g.fallback);\\n        let pos = anchored.iter().position(|x| x.crash_time.unwrap_or(x.fallback) > gc).unwrap_or(anchored.len());')\r\n\u001b[?2004l\r"]
[148.425501, "o", "\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r"]
[148.425553, "o", "\u001b[?2004h> "]
[148.425697, "o", "PY\r\n\u001b[?2004l\r"]
