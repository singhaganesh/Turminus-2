[116.165635, "o", "\u001b[?2004h> "]
[116.168068, "o", "    fresh.sort_by(|a,b| (a.chrono,a.guid).cmp(&(b.chrono,b.guid)));\r\n\u001b[?2004l\r\u001b[?2004h>     for g in fresh {\r\n\u001b[?2004l\r\u001b[?2004h>         let pos = anchored.iter().position(|x| x.chrono > g.chrono).unwrap_or(anchored.len());\r\n\u001b[?2004l\r\u001b[?2004h>         anchored.insert(pos,g);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let mut out = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut seen = HashSet::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for mut g in anchored {\r\n\u001b[?2004l\r\u001b[?2004h>         g.rows.sort_by(|a,b| {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.168139, "o", "            let an = Path::new(&a.0).file_name().unwrap().to_string_lossy();\r\n\u001b[?2004l\r"]
[116.168337, "o", "\u001b[?2004h> "]
[116.168544, "o", "            let bn = Path::new(&b.0).file_name().unwrap().to_string_lossy();\r\n\u001b[?2004l\r"]
[116.168703, "o", "\u001b[?2004h> "]
[116.169008, "o", "            match (old.get(an.as_ref()),old.get(bn.as_ref())) {\r\n\u001b[?2004l\r"]
[116.169209, "o", "\u001b[?2004h> "]
[116.169382, "o", "                (Some(x),Some(y)) => x.cmp(y),\r\n\u001b[?2004l\r"]
[116.169477, "o", "\u001b[?2004h> "]
[116.169649, "o", "                _ => (a.1,an.as_bytes()).cmp(&(b.1,bn.as_bytes())),\r\n\u001b[?2004l\r"]
[116.169855, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.170096, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.170262, "o", "        for (p,_) in g.rows { if seen.insert(p.clone()) { out.push(p); } }\r\n\u001b[?2004l\r"]
[116.170483, "o", "\u001b[?2004h> "]
[116.170603, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.170718, "o", "    if out.len() != pairs.len() { Err(1) } else { Ok(out) }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.170744, "o", "> RS\r\n\u001b[?2004l\r"]
[116.173642, "o", "\u001b[?2004hroot@fa3360074fc1:/app# "]
[116.173919, "o", "cat > /app/deskbin/pipe.rs <<'RS'\r\n\u001b[?2004l\r"]
[116.174004, "o", "\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[116.174434, "o", "\u001b[?2004h> pub fn fill() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.175794, "o", "    let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n\u001b[?2004l\r\u001b[?2004h>     let names = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return c };\r\n\u001b[?2004l\r\u001b[?2004h>     let pairs = match crate::stamp::rib_b(&names) { Ok(v) => v, Err(c) => return c };\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::create_dir_all(\"/app/kegbay\").is_err() { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     let mut body = String::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for (n,k) in pairs { body.push_str(&format!(\"{}\\t{}\\n\",n,k)); }\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::write(\"/app/kegbay/pairs.tmp\",body).is_err() { 1 } else { 0 }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[116.176852, "o", "\u001b[?2004hroot@fa3360074fc1:/app# "]
[116.176991, "o", "cat > /app/deskbin/sum.rs <<'RS'\r\n\u001b[?2004l\r"]
[116.177039, "o", "\u001b[?2004h> "]
[116.177277, "o", "use std::process::Command;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.177421, "o", "pub fn hex_file(path: &str) -> Result<String,i32> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.17765, "o", "    let out = Command::new(\"sha256sum\").arg(\"--\").arg(path).output().map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[116.17781, "o", "\u001b[?2004h>     if !out.status.success() { return Err(1); }\r\n\u001b[?2004l\r"]
[116.177841, "o", "\u001b[?2004h> "]
[116.178063, "o", "    let text = String::from_utf8(out.stdout).map_err(|_|1)?;\r\n\u001b[?2004l\r"]
[116.178529, "o", "\u001b[?2004h>     let s = text.split_whitespace().next().ok_or(1)?.to_string();\r\n\u001b[?2004l\r\u001b[?2004h>     if s.len()==64 && s.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c)) { Ok(s) } else { Err(1) }\r\n"]
[116.17856, "o", "\u001b[?2004l\r\u001b[?2004h"]
[116.178577, "o", "> }\r\n\u001b[?2004l\r"]
[116.178777, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[116.180039, "o", "\u001b[?2004hroot@fa3360074fc1:/app# "]
[116.396339, "i", "cat > /app/deskbin/emit.rs <<'RS'\nuse std::fs;\nuse std::path::Path;\n\nfn fail(c:i32)->i32 { let _=fs::remove_file(\"/app/kegbay/MARK\"); c }\nfn read_pairs()->Result<Vec<(String,u64)>,i32> {\n    let raw=fs::read_to_string(\"/app/kegbay/pairs.tmp\").map_err(|_|1)?;\n    let mut v=Vec::new();\n    for line in raw.lines() {\n        let (n,k)=line.split_once('\\t').ok_or(1)?;\n        v.push((n.to_string(),k.parse().map_err(|_|1)?));\n    }\n    if v.is_empty(){Err(1)}else{Ok(v)}\n}\nfn json_string(s:&str)->String {\n    let mut o=String::from(\"\\\"\");\n    for c in s.chars() { match c { '\"'=>o.push_str(\"\\\\\\\"\"),'\\\\'=>o.push_str(\"\\\\\\\\\"),'\\n'=>o.push_str(\"\\\\n\"),'\\r'=>o.push_str(\"\\\\r\"),'\\t'=>o.push_str(\"\\\\t\"), c if c<' '=>o.push_str(&format!(\"\\\\u{:04x}\",c as u32)),c=>o.push(c) } }\n    o.push('\"'); o\n}\n\npub fn finish()->i32 {\n    let pairs=match read_pairs(){Ok(v)=>v,Err(c)=>return fail(c)};\n    let names=match crate::fold::rib_c(&pairs){Ok(v)=>v,Err(c)=>return fail(c)};\n    let mut body=String::new();\n    for (i,n) in names.iter().enumerate() {\n        let m=match crate::parse::load(n){Ok(v)=>v,Err(_)=>return fail(1)};\n        body.push_str(&format!(\"{}\\t{}\\t{}\\n\",i+1,n,crate::parse::guid_hex(&m.guid)));\n    }\n    if fs::write(\"/app/kegbay/ribbon.txt\",body).is_err(){fail(1)}else{0}\n}\n\npub fn pour()->i32 {\n    let _=fs::remove_file(\"/app/kegbay/MARK\");\n    let root=std::env::args().nth(2).unwrap_or_else(||\"/app/dropwell\".into());\n    let good=fs::canonicalize(\"/app/dropwell\");\n    let got=fs::canonicalize(&root);\n    if good.is_err() || got.is_err() || good.unwrap()!=got.unwrap(){return fail(1)}\n    if crate::pipe::fill()!=0{return fail(1)}\n    if finish()!=0{return fail(1)}\n    let ribbon=match fs::read_to_string(\"/app/kegbay/ribbon.txt\"){Ok(v)=>v,Err(_)=>return fail(1)};\n    let mut rows=Vec::new();\n    for line in ribbon.lines() {\n        let p:Vec<&str>=line.split('\\t').collect(); if p.len()!=3{return fail(1)}\n        let seq:u32=match p[0].parse(){Ok(v)=>v,Err(_)=>return fail(1)};\n        let path=p[1];\n        let name=match Path::new(path).file_name().and_then(|x|x.to_str()){Some(v)=>v.to_string(),None=>return fail(1)};\n        let digest=match crate::sum::hex_file(path){Ok(v)=>v,Err(c)=>return fail(c)};\n        rows.push((seq,name,digest,p[2].to_string()));\n    }\n    if rows.is_empty(){return fail(1)}\n    let mut json=format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\",(rows.len()+2)/3);\n    for (i,(seq,name,digest,guid)) in rows.iter().enumerate(){\n        if i>0{json.push(',')};\n        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":{},\\\"digest\\\":{},\\\"guid\\\":{}}}\",seq,json_string(name),json_string(digest),json_string(guid)));\n    }\n    json.push_str(\"]}\\n\");\n    let mut tsv=String::from(\"seq\\tname\\tdigest\\tguid\\n\");\n    for (seq,name,digest,guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\",seq,name,digest,guid)); }\n    if fs::write(\"/app/kegbay/upload.json.tmp\",json).is_err() || fs::write(\"/app/kegbay/batch.tsv.tmp\",tsv).is_err(){return fail(1)}\n    if fs::rename(\"/app/kegbay/upload.json.tmp\",\"/app/kegbay/upload.json\").is_err() || fs::rename(\"/app/kegbay/batch.tsv.tmp\",\"/app/kegbay/batch.tsv\").is_err(){return fail(1)}\n    if fs::write(\"/app/kegbay/MARK\",\"ok\").is_err(){return fail(1)}\n    0\n}\nRS\nPATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin /app/fat.sh\n/app/bin/clatter tallow && /app/bin/clatter pour\nprintf '%s\\n' '--- upload ---'; cat /app/kegbay/upload.json; printf '%s\\n' '--- tsv ---'; cat /app/kegbay/batch.tsv; printf '%s ' 'MARK:'; cat /app/kegbay/MARK; echo; od -An -tx1 -N4 /app/bin/clatter\n"]
