[152.463793, "i", "cp /app/tidearc/lastgood.rec /tmp/lastgood.rec; rm /app/tidearc/lastgood.rec; /app/bin/clatter tallow && /app/bin/clatter pour; python3 - <<'PY'\nimport json\nnames=[x['name'] for x in json.load(open('/app/kegbay/upload.json'))['entries']]\nprint('without_lastgood:', ','.join(names))\nassert names == ['old.clat','b.clat','d.clat','a.clat','a2.clat','e.clat','e2.clat']\nPY\nmv /tmp/lastgood.rec /app/tidearc/lastgood.rec\n/app/bin/clatter tallow && /app/bin/clatter pour\npython3 - <<'PY'\nimport json,hashlib\nj=json.load(open('/app/kegbay/upload.json'))\nassert j['batch_count']==3\nassert [e['seq'] for e in j['entries']]==list(range(1,8))\nassert [e['name'] for e in j['entries']]==['old.clat','b.clat','d.clat','a.clat','a2.clat','e.clat','e2.clat']\nfor e in j['entries']:\n assert e['digest']==hashlib.sha256(open('/app/dropwell/'+e['name'],'rb').read()).hexdigest()\nassert open('/app/kegbay/MARK').read()=='ok'\nassert open('/app/bin/clatter','rb').read(4)==b'\\x7fELF'\nprint('final validation ok')\nPY\n"]
[152.46465, "o", "cp /app/tidearc/lastgood.rec /tmp/lastgood.rec; rm /app/tidearc/lastgood.rec; /app/bin/clatter tallow && /app/bin/clatter pour; python3 - <<'PY'\r\nimport json\r\nnames=[x['name'] for x in json.load(open('/app/kegbay/upload.json'))['entries']]\r\nprint('without_lastgood:', ','.join(names))\r\nassert names == ['old.clat','b.clat','d.clat','a.clat','a2.clat','e.clat','e2.clat']\r\nPY\r\nmv /tmp/lastgood.rec /app/tidearc/lastgood.rec\r\n/app/bin/clatter tallow && /app/bin/clatter pour\r\npython3 - <<'PY'\r\nimport json,hashlib\r\nj=json.load(open('/app/kegbay/upload.json'))\r\nassert j['batch_count']==3\r\nassert [e['seq'] for e in j['entries']]==list(range(1,8))\r\nassert [e['name'] for e in j['entries']]==['old.clat','b.clat','d.clat','a.clat','a2.clat','e.clat','e2.clat']\r\nfor e in j['entries']:\r\n assert e['digest']==hashlib.sha256(open('/app/dropwell/'+e['name'],'rb').read()).hexdigest()\r\nassert open('/app/kegbay/MARK').read()=='ok'\r\nassert open('/app/bin/clatter','rb').read(4)==b'\\x7fELF'\r\nprint('final validation ok')\r\nPY\r\n"]
