[119.461053, "i", "cp /app/kegbay/upload.json /tmp/u1; cp /app/kegbay/batch.tsv /tmp/t1; /app/bin/clatter tallow && /app/bin/clatter pour; cmp /tmp/u1 /app/kegbay/upload.json && cmp /tmp/t1 /app/kegbay/batch.tsv && echo deterministic; /app/bin/clatter pour /app/scratch >/dev/null 2>&1; rc=$?; printf 'outside_rc=%s mark=' \"$rc\"; test -e /app/kegbay/MARK && echo present || echo absent; /app/bin/clatter tallow && /app/bin/clatter pour; test \"$(cat /app/kegbay/MARK)\" = ok; python3 - <<'PY'\nimport json,hashlib,os\nj=json.load(open('/app/kegbay/upload.json')); t=open('/app/kegbay/batch.tsv').read().splitlines()\nassert j['batch_count']==3 and len(j['entries'])==7 and len(t)==8\nassert [x['seq'] for x in j['entries']]==list(range(1,8))\nassert [x['name'] for x in j['entries']]==['old.clat','b.clat','d.clat','a.clat','a2.clat','e.clat','e2.clat']\nfor x in j['entries']:\n assert x['digest']==hashlib.sha256(open('/app/dropwell/'+x['name'],'rb').read()).hexdigest()\nprint('validated')\nPY\n"]
