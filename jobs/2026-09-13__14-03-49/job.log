Sending keys: ['cat > /app/walk.rs <<\'RS\'\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let root = "/app/dropwell";\n    let rd = fs::read_dir(root).map_err(|_| 1)?;\n    let mut names = Vec::new();\n    for ent in rd.flatten() {\n        let p = ent.path();\n        if p.is_file() && p.extension().and_then(|s| s.to_str()) == Some("clat") {\n            let s = p.to_string_lossy().to_string();\n            let m = crate::parse::load(&s);\n            if m.guid != [0; 16] {\n                names.push(s);\n            }\n        }\n    }\n    names.sort();\n    if names.is_empty() { Err(1) } else { Ok(names) }\n}\nRS\ncat > /app/stamp.rs <<\'RS\'\npub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\n    names.iter().map(|n| {\n        let m = crate::parse::load(n);\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => m.write_stamp as u64,\n        };\n        (n.clone(), key)\n    }).collect()\n}\nRS\ncat > /app/fold.rs <<\'RS\'\nuse std::collections::HashMap;\nuse std::fs;\nuse std::path::Path;\n\n#[derive(Clone)]\nstruct Item { path: String, key: u64, companion: u8, rank: Option<usize> }\n#[derive(Clone)]\nstruct Group { items: Vec<Item>, key: u64, rank: Option<usize>, tie: String }\n\nfn accepted_order() -> HashMap<String, usize> {\n    let mut out = HashMap::new();\n    let raw = fs::read_to_string("/app/tidearc/lastgood.rec").unwrap_or_default();\n    for (line_no, line) in raw.lines().enumerate() {\n        let p: Vec<&str> = line.split(\'\\t\').collect();\n        if p.len() >= 2 {\n            let rank = p[0].parse::<usize>().unwrap_or(line_no + 1);\n            out.insert(p[1].to_string(), rank);\n        }\n    }\n    out\n}\n\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\n    if let Some(r) = root {\n        let requested = fs::canonicalize(r).map_err(|_| 1)?;\n        let allowed = fs::canonicalize("/app/dropwell").map_err(|_| 1)?;\n        if requested != allowed { return Err(1); }\n    }\n    if pairs.is_empty() { return Err(1); }\n\n    let ranks = accepted_order();\n    let mut by: HashMap<[u8; 16], Vec<Item>> = HashMap::new();\n    for (path, supplied_key) in pairs {\n        let m = crate::parse::load(path);\n        if m.guid == [0; 16] { return Err(1); }\n        let name = Path::new(path).file_name().and_then(|x| x.to_str()).unwrap_or("");\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => *supplied_key,\n        };\n        by.entry(m.guid).or_default().push(Item {\n            path: path.clone(), key, companion: m.companion, rank: ranks.get(name).copied()\n        });\n    }\n\n    let mut groups = Vec::new();\n    for (_, mut items) in by {\n        items.sort_by(|a, b| match (a.rank, b.rank) {\n            (Some(x), Some(y)) => x.cmp(&y),\n            _ => a.companion.cmp(&b.companion).then_with(|| a.path.cmp(&b.path)),\n        });\n        let key = items.iter().filter(|x| x.companion == 0).map(|x| x.key)\n            .min().or_else(|| items.iter().map(|x| x.key).min()).unwrap_or(0);\n        let rank = items.iter().filter_map(|x| x.rank).min();\n        let tie = items.iter().map(|x| x.path.clone()).min().unwrap_or_default();\n        groups.push(Group { items, key, rank, tie });\n    }\n\n    let mut established: Vec<Group> = groups.iter().filter(|g| g.rank.is_some()).cloned().collect();\n    established.sort_by_key(|g| g.rank.unwrap());\n    let mut fresh: Vec<Group> = groups.into_iter().filter(|g| g.rank.is_none()).collect();\n    fresh.sort_by(|a,b| a.key.cmp(&b.key).then_with(|| a.tie.cmp(&b.tie)));\n    for g in fresh {\n        let pos = established.iter().position(|x| x.key > g.key).unwrap_or(established.len());\n        established.insert(pos, g);\n    }\n    Ok(established.into_iter().flat_map(|g| g.items.into_iter().map(|x| x.path)).collect())\n}\nRS\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
Sending keys: ['cat > /app/deskbin/emit.rs <<\'RS\'\nuse std::fs;\nuse std::path::Path;\n\nfn remove_mark() { let _ = fs::remove_file("/app/kegbay/MARK"); }\nfn current_order(root: Option<&str>) -> Result<Vec<String>, i32> {\n    let names = crate::walk::rib_a()?;\n    let pairs = crate::stamp::rib_b(&names);\n    crate::fold::rib_c(&pairs, root)\n}\nfn write_ribbon(names: &[String]) -> Result<(), i32> {\n    fs::create_dir_all("/app/kegbay").map_err(|_| 1)?;\n    let mut body = String::new();\n    for (i, n) in names.iter().enumerate() {\n        let m = crate::parse::load(n);\n        body.push_str(&format!("{}\\t{}\\t{}\\n", i + 1, n, crate::parse::guid_hex(&m.guid)));\n    }\n    fs::write("/app/kegbay/ribbon.txt", body).map_err(|_| 1)\n}\nfn json_string(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in s.chars() {\n        match c {\n            \'\\"\' => out.push_str("\\\\\\""), \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"), \'\\r\' => out.push_str("\\\\r"), \'\\t\' => out.push_str("\\\\t"),\n            c if c < \' \' => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'\\"\'); out\n}\n\npub fn finish() -> i32 {\n    remove_mark();\n    match current_order(None).and_then(|v| write_ribbon(&v)) { Ok(()) => 0, Err(c) => c }\n}\n\npub fn pour() -> i32 {\n    remove_mark();\n    let root = std::env::args().nth(2).unwrap_or_else(|| "/app/dropwell".to_string());\n    let names = match current_order(Some(&root)) { Ok(v) => v, Err(c) => return c };\n    if write_ribbon(&names).is_err() { return 1; }\n    let mut rows = Vec::new();\n    for (i, path) in names.iter().enumerate() {\n        let name = match Path::new(path).file_name().and_then(|x| x.to_str()) { Some(x) => x.to_string(), None => return 1 };\n        let digest = crate::sum::hex_file(path);\n        if digest.len() != 64 { return 1; }\n        let guid = crate::parse::guid_hex(&crate::parse::load(path).guid);\n        rows.push((i + 1, name, digest, guid));\n    }\n    let mut json = format!("{{\\"batch_count\\":{},\\"entries\\":[", (rows.len() + 2) / 3);\n    for (i, (seq, name, digest, guid)) in rows.iter().enumerate() {\n        if i != 0 { json.push(\',\'); }\n        json.push_str(&format!("{{\\"seq\\":{},\\"name\\":{},\\"digest\\":\\"{}\\",\\"guid\\":\\"{}\\"}}", seq, json_string(name), digest, guid));\n    }\n    json.push_str("]}\\n");\n    let mut tsv = String::from("seq\\tname\\tdigest\\tguid\\n");\n    for (seq, name, digest, guid) in &rows { tsv.push_str(&format!("{}\\t{}\\t{}\\t{}\\n", seq, name, digest, guid)); }\n    if fs::write("/app/kegbay/upload.json", json).is_err() || fs::write("/app/kegbay/batch.tsv", tsv).is_err() { return 1; }\n    if fs::write("/app/kegbay/MARK", "ok").is_err() { remove_mark(); return 1; }\n    0\n}\nRS\n/app/fat.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
