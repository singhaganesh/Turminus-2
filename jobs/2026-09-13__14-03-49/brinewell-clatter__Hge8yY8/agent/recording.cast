[9.632389, "o", "{\"batch_count\":2,\"entries\":[{\"seq\":1,\"name\":\"d.clat\",\"digest\":\"1bba31573bc0676ff2f60134cd66ec6ae9bde5ac41018bab79d29a8cf29a34c8\",\"guid\":\"dddddddddddddddddddddddddddddddd\"},{\"seq\":2,\"name\":\"old.clat\",\"digest\":\"6727175f53e5a66f47bff49403667cfaf694b2f2e7b7729a399234cda98b67f5\",\"guid\":\"01010101010101010101010101010101\"},{\"seq\":3,\"name\":\"e.clat\",\"digest\":\"f1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\",\"guid\":\"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"},{\"seq\":4,\"name\":\"b.clat\",\"digest\":\"6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\",\"guid\":\"02020202020202020202020202020202\"},{\"seq\":5,\"name\":\"a.clat\",\"digest\":\"224cbf56792e0184b9ad97ad92ad0a102631c7ef419cb9d25c1f25d649af4713\",\"guid\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}\r\n"]
