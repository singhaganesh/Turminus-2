[84.460653, "i", "cat > /app/deskbin/emit.rs <<'RS'\nuse std::fs;\nuse std::path::Path;\n\nfn remove_mark() { let _ = fs::remove_file(\"/app/kegbay/MARK\"); }\nfn current_order(root: Option<&str>) -> Result<Vec<String>, i32> {\n    let names = crate::walk::rib_a()?;\n    let pairs = crate::stamp::rib_b(&names);\n    crate::fold::rib_c(&pairs, root)\n}\nfn write_ribbon(names: &[String]) -> Result<(), i32> {\n    fs::create_dir_all(\"/app/kegbay\").map_err(|_| 1)?;\n    let mut body = String::new();\n    for (i, n) in names.iter().enumerate() {\n        let m = crate::parse::load(n);\n        body.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, n, crate::parse::guid_hex(&m.guid)));\n    }\n    fs::write(\"/app/kegbay/ribbon.txt\", body).map_err(|_| 1)\n}\nfn json_string(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\\\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\\\"'); out\n}\n\npub fn finish() -> i32 {\n    remove_mark();\n    match current_order(None).and_then(|v| write_ribbon(&v)) { Ok(()) => 0, Err(c) => c }\n}\n\npub fn pour() -> i32 {\n    remove_mark();\n    let root = std::env::args().nth(2).unwrap_or_else(|| \"/app/dropwell\".to_string());\n    let names = match current_order(Some(&root)) { Ok(v) => v, Err(c) => return c };\n    if write_ribbon(&names).is_err() { return 1; }\n    let mut rows = Vec::new();\n    for (i, path) in names.iter().enumerate() {\n        let name = match Path::new(path).file_name().and_then(|x| x.to_str()) { Some(x) => x.to_string(), None => return 1 };\n        let digest = crate::sum::hex_file(path);\n        if digest.len() != 64 { return 1; }\n        let guid = crate::parse::guid_hex(&crate::parse::load(path).guid);\n        rows.push((i + 1, name, digest, guid));\n    }\n    let mut json = format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\", (rows.len() + 2) / 3);\n    for (i, (seq, name, digest, guid)) in rows.iter().enumerate() {\n        if i != 0 { json.push(','); }\n        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":{},\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\", seq, json_string(name), digest, guid));\n    }\n    json.push_str(\"]}\\n\");\n    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\n    for (seq, name, digest, guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, guid)); }\n    if fs::write(\"/app/kegbay/upload.json\", json).is_err() || fs::write(\"/app/kegbay/batch.tsv\", tsv).is_err() { return 1; }\n    if fs::write(\"/app/kegbay/MARK\", \"ok\").is_err() { remove_mark(); return 1; }\n    0\n}\nRS\n/app/fat.sh\n"]
[84.460942, "o", "cat > /app/deskbin/emit.rs <<'RS'\r\n\u001b[?2004l\r"]
[84.460981, "o", "\u001b[?2004h> "]
[84.461112, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.461322, "o", "> use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.461571, "o", "fn remove_mark() { let _ = fs::remove_file(\"/app/kegbay/MARK\"); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.461676, "o", "> "]
[84.461796, "o", "fn current_order(root: Option<&str>) -> Result<Vec<String>, i32> {\r\n\u001b[?2004l\r"]
[84.461868, "o", "\u001b[?2004h> "]
[84.461972, "o", "    let names = crate::walk::rib_a()?;\r\n\u001b[?2004l\r"]
[84.462306, "o", "\u001b[?2004h>     let pairs = crate::stamp::rib_b(&names);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.462492, "o", "    crate::fold::rib_c(&pairs, root)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[84.46257, "o", "\u001b[?2004h> "]
[84.462695, "o", "fn write_ribbon(names: &[String]) -> Result<(), i32> {\r\n\u001b[?2004l\r"]
[84.462722, "o", "\u001b[?2004h> "]
[84.463128, "o", "    fs::create_dir_all(\"/app/kegbay\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[84.463165, "o", "\u001b[?2004h> "]
[84.464134, "o", "    let mut body = String::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for (i, n) in names.iter().enumerate() {\r\n\u001b[?2004l\r\u001b[?2004h>         let m = crate::parse::load(n);\r\n\u001b[?2004l\r\u001b[?2004h>         body.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, n, crate::parse::guid_hex(&m.guid)));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     fs::write(\"/app/kegbay/ribbon.txt\", body).map_err(|_| 1)\r\n\u001b[?2004l\r"]
[84.464286, "o", "\u001b[?2004h> "]
[84.464382, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> fn json_string(s: &str) -> String {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.464494, "o", "    let mut out = String::from(\"\\\"\");\r\n\u001b[?2004l\r"]
[84.464581, "o", "\u001b[?2004h> "]
[84.464652, "o", "    for c in s.chars() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.464714, "o", "        match c {\r\n\u001b[?2004l\r"]
[84.464787, "o", "\u001b[?2004h> "]
[84.46492, "o", "            '\\\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\r\n\u001b[?2004l\r"]
[84.464992, "o", "\u001b[?2004h> "]
[84.465199, "o", "            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r"]
[84.465261, "o", "\u001b[?2004h> "]
[84.465418, "o", "            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n\u001b[?2004l\r"]
[84.46549, "o", "\u001b[?2004h> "]
[84.465555, "o", "            c => out.push(c),\r\n\u001b[?2004l\r"]
[84.46563, "o", "\u001b[?2004h> "]
[84.466091, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out.push('\\\"'); out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn finish() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     remove_mark();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.466185, "o", "    match current_order(None).and_then(|v| write_ribbon(&v)) { Ok(()) => 0, Err(c) => c }\r\n\u001b[?2004l\r"]
[84.466259, "o", "\u001b[?2004h"]
[84.466323, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.46638, "o", "pub fn pour() -> i32 {\r\n\u001b[?2004l\r"]
[84.466443, "o", "\u001b[?2004h> "]
[84.466503, "o", "    remove_mark();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.4667, "o", "    let root = std::env::args().nth(2).unwrap_or_else(|| \"/app/dropwell\".to_string());\r\n\u001b[?2004l\r"]
[84.466761, "o", "\u001b[?2004h> "]
[84.466935, "o", "    let names = match current_order(Some(&root)) { Ok(v) => v, Err(c) => return c };\r\n\u001b[?2004l\r"]
[84.466991, "o", "\u001b[?2004h"]
[84.467059, "o", "> "]
[84.467129, "o", "    if write_ribbon(&names).is_err() { return 1; }\r\n\u001b[?2004l\r"]
[84.467178, "o", "\u001b[?2004h> "]
[84.467251, "o", "    let mut rows = Vec::new();\r\n\u001b[?2004l\r"]
[84.467314, "o", "\u001b[?2004h> "]
[84.467411, "o", "    for (i, path) in names.iter().enumerate() {\r\n\u001b[?2004l\r"]
[84.467479, "o", "\u001b[?2004h> "]
[84.46775, "o", "        let name = match Path::new(path).file_name().and_then(|x| x.to_str()) { Some(x) => x.to_string(), None => return 1 };\r\n\u001b[?2004l\r"]
[84.467808, "o", "\u001b[?2004h> "]
[84.467921, "o", "        let digest = crate::sum::hex_file(path);\r\n\u001b[?2004l\r"]
[84.467949, "o", "\u001b[?2004h> "]
[84.468108, "o", "        if digest.len() != 64 { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.468304, "o", "        let guid = crate::parse::guid_hex(&crate::parse::load(path).guid);\r\n\u001b[?2004l\r"]
[84.468374, "o", "\u001b[?2004h> "]
[84.468481, "o", "        rows.push((i + 1, name, digest, guid));\r\n\u001b[?2004l\r"]
[84.468525, "o", "\u001b[?2004h> "]
[84.46857, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.468791, "o", "    let mut json = format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\", (rows.len() + 2) / 3);\r\n\u001b[?2004l\r"]
[84.468842, "o", "\u001b[?2004h> "]
[84.469003, "o", "    for (i, (seq, name, digest, guid)) in rows.iter().enumerate() {\r\n\u001b[?2004l\r"]
[84.469088, "o", "\u001b[?2004h"]
[84.469155, "o", "> "]
[84.469245, "o", "        if i != 0 { json.push(','); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.469609, "o", "        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":{},\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\", seq, json_string(name), digest, guid));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.469751, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     json.push_str(\"]}\\n\");\r\n\u001b[?2004l\r"]
[84.469847, "o", "\u001b[?2004h> "]
[84.469975, "o", "    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n\u001b[?2004l\r"]
[84.470061, "o", "\u001b[?2004h> "]
[84.470519, "o", "    for (seq, name, digest, guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, guid)); }\r\n\u001b[?2004l\r"]
[84.470695, "o", "\u001b[?2004h> "]
[84.471006, "o", "    if fs::write(\"/app/kegbay/upload.json\", json).is_err() || fs::write(\"/app/kegbay/batch.tsv\", tsv).is_err() { return 1; }\r\n\u001b[?2004l\r"]
[84.471234, "o", "\u001b[?2004h> "]
[84.471363, "o", "    if fs::write(\"/app/kegbay/MARK\", \"ok\").is_err() { remove_mark(); return 1; }\r\n\u001b[?2004l\r"]
[84.471443, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r"]
[84.471476, "o", "\u001b[?2004h> "]
[84.471497, "o", "}\r\n\u001b[?2004l\r"]
[84.471629, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[84.47393, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
[84.474288, "o", "/app/fat.sh\r\n\u001b[?2004l\r"]
[87.634551, "i", "rm -rf /app/dropwell && cp -a /app/seed/dropwell /app/dropwell; /app/bin/clatter tallow && /app/bin/clatter pour; rc=$?; echo rc=$rc; cat /app/kegbay/upload.json; cat /app/kegbay/batch.tsv; printf 'MARK='; cat /app/kegbay/MARK; echo\n"]
[87.634784, "o", "rm -rf /app/dropwell && cp -a /app/seed/dropwell /app/dropwell; /app/bin/clatter tallow && /app/bin/clatter pour; rc=$?; echo rc=$rc; cat /app/kegbay/upload.json; cat /app/kegbay/batch.tsv; printf 'MARK='; cat /app/kegbay/MARK; echo\r\n"]
[87.966984, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
[87.967512, "o", "rm -rf /app/dropwell && cp -a /app/seed/dropwell /app/dropwell; /app/bin/clatter tallow && /app/bin/clatter pour; rc=$?; echo rc=$rc; cat /app/kegbay/upload.json; cat /app/kegbay/batch.tsv; printf 'MARK='; cat /app/kegbay/MARK; echo\r\n\u001b[?2004l\r"]
[87.987074, "o", "rc=0\r\n"]
[87.988706, "o", "{\"batch_count\":3,\"entries\":[{\"seq\":1,\"name\":\"old.clat\",\"digest\":\"6727175f53e5a66f47bff49403667cfaf694b2f2e7b7729a399234cda98b67f5\",\"guid\":\"01010101010101010101010101010101\"},{\"seq\":2,\"name\":\"b.clat\",\"digest\":\"6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\",\"guid\":\"02020202020202020202020202020202\"},{\"seq\":3,\"name\":\"d.clat\",\"digest\":\"1bba31573bc0676ff2f60134cd66ec6ae9bde5ac41018bab79d29a8cf29a34c8\",\"guid\":\"dddddddddddddddddddddddddddddddd\"},{\"seq\":4,\"name\":\"a.clat\",\"digest\":\"224cbf56792e0184b9ad97ad92ad0a102631c7ef419cb9d25c1f25d649af4713\",\"guid\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"seq\":5,\"name\":\"a2.clat\",\"digest\":\"57fecb62f4f4fc23bb7917c03a6c02c1c4be698144a61ebdc5a87a24612c61a3\",\"guid\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"seq\":6,\"name\":\"e.clat\",\"digest\":\"f1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\",\"guid\":\"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"},{\"seq\":7,\"name\":\"e2.clat\",\"digest\":\"9af0e00cf837afe51af86ba105612013c528575571e198fbd2f60ed22cb91807\",\"guid\":\"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"}]}\r\n"]
[87.990793, "o", "seq\tname\tdigest\tguid\r\n1\told.clat\t6727175f53e5a66f47bff49403667cfaf694b2f2e7b7729a399234cda98b67f5\t01010101010101010101010101010101\r\n2\tb.clat\t6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\t02020202020202020202020202020202\r\n3\td.clat\t1bba31573bc0676ff2f60134cd66ec6ae9bde5ac41018bab79d29a8cf29a34c8\tdddddddddddddddddddddddddddddddd\r\n4\ta.clat\t224cbf56792e0184b9ad97ad92ad0a102631c7ef419cb9d25c1f25d649af4713\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n5\ta2.clat\t57fecb62f4f4fc23bb7917c03a6c02c1c4be698144a61ebdc5a87a24612c61a3\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n6\te.clat\tf1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\r\n7\te2.clat\t9af0e00cf837afe51af86ba105612013c528575571e198fbd2f60ed22cb91807\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\r\n"]
[87.99166, "o", "MARK="]
[87.993374, "o", "ok"]
[87.993683, "o", "\r\n"]
[87.993892, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
[88.401888, "i", "cp /app/kegbay/upload.json /tmp/upload.1; cp /app/kegbay/batch.tsv /tmp/batch.1; /app/bin/clatter tallow && /app/bin/clatter pour && cmp /tmp/upload.1 /app/kegbay/upload.json && cmp /tmp/batch.1 /app/kegbay/batch.tsv; echo reproducible_rc=$?\n"]
[88.402922, "o", "cp /app/kegbay/upload.json /tmp/upload.1; cp /app/kegbay/batch.tsv /tmp/batch.1; /app/bin/clatter tallow && /app/bin/clatter pour && cmp /tmp/upload.1 /app/kegbay/upload.json && cmp /tmp/batch.1 /app/kegbay/batch.tsv; echo reproducible_rc=$?\r\n\u001b[?2004l\r"]
[88.420959, "o", "reproducible_rc=0\r\n"]
[88.421205, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
[89.405602, "i", "/app/bin/clatter pour /app/scratch >/tmp/outside.out 2>/tmp/outside.err; r=$?; echo outside_rc=$r mark_exists=$([ -e /app/kegbay/MARK ] && echo yes || echo no); test $r -ne 0 && test ! -e /app/kegbay/MARK\n"]
[89.406691, "o", "/app/bin/clatter pour /app/scratch >/tmp/outside.out 2>/tmp/outside.err; r=$?; echo outside_rc=$r mark_exists=$([ -e /app/kegbay/MARK ] && echo yes || echo no); test $r -ne 0 && test ! -e /app/kegbay/MARK\r\n\u001b[?2004l\r"]
[89.410462, "o", "outside_rc=1 mark_exists=no\r\n"]
[89.410613, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
[89.917063, "i", "mv /app/dropwell /app/dropwell.keep; mkdir /app/dropwell; /app/bin/clatter tallow >/tmp/empty.out 2>/tmp/empty.err; r=$?; echo empty_rc=$r mark_exists=$([ -e /app/kegbay/MARK ] && echo yes || echo no); rm -rf /app/dropwell; mv /app/dropwell.keep /app/dropwell; test $r -ne 0 && test ! -e /app/kegbay/MARK; /app/bin/clatter tallow && /app/bin/clatter pour; head -c4 /app/bin/clatter | od -An -tx1; ls -l /app/bin/clatter /app/kegbay/upload.json /app/kegbay/batch.tsv /app/kegbay/MARK\n"]
[89.920264, "o", "mv /app/dropwell /app/dropwell.keep; mkdir /app/dropwell; /app/bin/clatter tallow >/tmp/empty.out 2>/tmp/empty.err; r=$?; echo empty_rc=$r mark_exists=$([ -e /app/kegbay/MARK ] && echo yes || echo no); rm -rf /app/dropwell; mv /app/dropwell.keep /app/dropwell; test $r -ne 0 && test ! -e /app/kegbay/MARK; /app/bin/clatter tallow && /app/bin/clatter pour; head -c4 /app/bin/clatter | od -An -tx1; ls -l /app/bin/clatter /app/kegbay/upload.json /app/kegbay/batch.tsv /app/kegbay/MARK\r\n\u001b[?2004l\r"]
[89.929545, "o", "empty_rc=1 mark_exists=no\r\n"]
[89.943681, "o", " 7f 45 4c 46\r\n"]
[89.944985, "o", "-rwxr-xr-x 1 root root 4168984 Sep 13 08:35 /app/bin/clatter\r\n-rw-r--r-- 1 root root       2 Sep 13 08:35 /app/kegbay/MARK\r\n-rw-r--r-- 1 root root     774 Sep 13 08:35 /app/kegbay/batch.tsv\r\n-rw-r--r-- 1 root root    1042 Sep 13 08:35 /app/kegbay/upload.json\r\n"]
[89.945201, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
[111.400441, "i", "python3 - <<'PY'\nimport csv, hashlib, json, os\nj=json.load(open('/app/kegbay/upload.json'))\nwith open('/app/kegbay/batch.tsv', newline='') as f:\n    t=list(csv.DictReader(f, delimiter='\\t'))\ne=j['entries']\nassert len(e)==len(t)==len(os.listdir('/app/dropwell'))==7\nassert j['batch_count']==(len(e)+2)//3==3\nassert [x['seq'] for x in e]==list(range(1,len(e)+1))\nassert len({x['name'] for x in e})==len(e)\nfor a,b in zip(e,t):\n    assert str(a['seq'])==b['seq'] and a['name']==b['name'] and a['digest']==b['digest'] and a['guid']==b['guid']\n    data=open('/app/dropwell/'+a['name'],'rb').read()\n    assert hashlib.sha256(data).hexdigest()==a['digest']\n    assert len(a['guid'])==32 and a['guid']==a['guid'].lower()\nassert open('/app/kegbay/MARK').read()=='ok'\nassert open('/app/bin/clatter','rb').read(4)==b'\\x7fELF'\nprint('final validation: ok')\nPY\nfor f in /app/seed/dropwell/*; do cmp \"$f\" \"/app/dropwell/${f##*/}\" || exit 1; done; echo 'dropwell fixtures: unchanged'; sha256sum /app/bin/clatter /app/kegbay/upload.json /app/kegbay/batch.tsv\n"]
[111.400765, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[111.400929, "o", "\u001b[?2004h> "]
[111.401062, "o", "import csv, hashlib, json, os\r\n\u001b[?2004l\r"]
[111.401435, "o", "\u001b[?2004h> j=json.load(open('/app/kegbay/upload.json'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.401652, "o", "with open('/app/kegbay/batch.tsv', newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.401841, "o", "    t=list(csv.DictReader(f, delimiter='\\t'))\r\n\u001b[?2004l\r\u001b[?2004h> e=j['entries']\r\n\u001b[?2004l\r"]
[111.402777, "o", "\u001b[?2004h> assert len(e)==len(t)==len(os.listdir('/app/dropwell'))==7\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.402839, "o", "assert j['batch_count']==(len(e)+2)//3==3\r\n\u001b[?2004l\r\u001b[?2004h> assert [x['seq'] for x in e]==list(range(1,len(e)+1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.403695, "o", "assert len({x['name'] for x in e})==len(e)\r\n\u001b[?2004l\r\u001b[?2004h> for a,b in zip(e,t):\r\n\u001b[?2004l\r\u001b[?2004h>     assert str(a['seq'])==b['seq'] and a['name']==b['name'] and a['digest']==b['digest'] and a['guid']==b['guid']\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.403821, "o", ">     data=open('/app/dropwell/'+a['name'],'rb').read()\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.403887, "o", "> "]
[111.404075, "o", "    assert hashlib.sha256(data).hexdigest()==a['digest']\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.404148, "o", "> "]
[111.404379, "o", "    assert len(a['guid'])==32 and a['guid']==a['guid'].lower()\r\n\u001b[?2004l\r"]
[111.404463, "o", "\u001b[?2004h> "]
[111.404704, "o", "assert open('/app/kegbay/MARK').read()=='ok'\r\n\u001b[?2004l\r"]
[111.404764, "o", "\u001b[?2004h> "]
[111.405084, "o", "assert open('/app/bin/clatter','rb').read(4)==b'\\x7fELF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.405863, "o", "print('final validation: ok')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[111.442077, "o", "final validation: ok\r\n"]
[111.447823, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
[111.448321, "o", "for f in /app/seed/dropwell/*; do cmp \"$f\" \"/app/dropwell/${f##*/}\" || exit 1; done; echo 'dropwell fixtures: unchanged'; sha256sum /app/bin/clatter /app/kegbay/upload.json /app/kegbay/batch.tsv\r\n\u001b[?2004l\r"]
[111.460426, "o", "dropwell fixtures: unchanged\r\n"]
[111.495226, "o", "5c13bc1d8a2dac382c9e8988e4b4b5fac2638f8ed74540852d33d35922e3e45b  /app/bin/clatter\r\n90c3f9d1ca6706d4e3069b2c149847f2caa0f97c34d1b0da54779e0d40966f5e  /app/kegbay/upload.json\r\n"]
[111.49534, "o", "038c50fbd9570f727ce79504bad092a98db420e92737c14688bdaf6f5321641a  /app/kegbay/batch.tsv\r\n"]
[111.495605, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
