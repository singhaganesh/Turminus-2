[30.043973, "o", "a2.clat clock= None guid= aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa companion= 1\r\nb.clat clock= 131444736000000000 guid= 02020202020202020202020202020202 companion= 0\r\nd.clat clock= 132444736000000000 guid= dddddddddddddddddddddddddddddddd companion= 0\r\n"]
[30.044257, "o", "e.clat clock= 135444736000000000 guid= eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee companion= 0\r\ne2.clat clock= None guid= eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee companion= 1\r\nold.clat clock= 127444736000000000 guid= 01010101010101010101010101010101 companion= 0\r\n"]
[30.049643, "o", "\u001b[?2004hroot@78d7416683b1:/app# "]
[84.254278, "i", "cat > /app/walk.rs <<'RS'\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let root = \"/app/dropwell\";\n    let rd = fs::read_dir(root).map_err(|_| 1)?;\n    let mut names = Vec::new();\n    for ent in rd.flatten() {\n        let p = ent.path();\n        if p.is_file() && p.extension().and_then(|s| s.to_str()) == Some(\"clat\") {\n            let s = p.to_string_lossy().to_string();\n            let m = crate::parse::load(&s);\n            if m.guid != [0; 16] {\n                names.push(s);\n            }\n        }\n    }\n    names.sort();\n    if names.is_empty() { Err(1) } else { Ok(names) }\n}\nRS\ncat > /app/stamp.rs <<'RS'\npub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\n    names.iter().map(|n| {\n        let m = crate::parse::load(n);\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => m.write_stamp as u64,\n        };\n        (n.clone(), key)\n    }).collect()\n}\nRS\ncat > /app/fold.rs <<'RS'\nuse std::collections::HashMap;\nuse std::fs;\nuse std::path::Path;\n\n#[derive(Clone)]\nstruct Item { path: String, key: u64, companion: u8, rank: Option<usize> }\n#[derive(Clone)]\nstruct Group { items: Vec<Item>, key: u64, rank: Option<usize>, tie: String }\n\nfn accepted_order() -> HashMap<String, usize> {\n    let mut out = HashMap::new();\n    let raw = fs::read_to_string(\"/app/tidearc/lastgood.rec\").unwrap_or_default();\n    for (line_no, line) in raw.lines().enumerate() {\n        let p: Vec<&str> = line.split('\\t').collect();\n        if p.len() >= 2 {\n            let rank = p[0].parse::<usize>().unwrap_or(line_no + 1);\n            out.insert(p[1].to_string(), rank);\n        }\n    }\n    out\n}\n\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\n    if let Some(r) = root {\n        let requested = fs::canonicalize(r).map_err(|_| 1)?;\n        let allowed = fs::canonicalize(\"/app/dropwell\").map_err(|_| 1)?;\n        if requested != allowed { return Err(1); }\n    }\n    if pairs.is_empty() { return Err(1); }\n\n    let ranks = accepted_order();\n    let mut by: HashMap<[u8; 16], Vec<Item>> = HashMap::new();\n    for (path, supplied_key) in pairs {\n        let m = crate::parse::load(path);\n        if m.guid == [0; 16] { return Err(1); }\n        let name = Path::new(path).file_name().and_then(|x| x.to_str()).unwrap_or(\"\");\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => *supplied_key,\n        };\n        by.entry(m.guid).or_default().push(Item {\n            path: path.clone(), key, companion: m.companion, rank: ranks.get(name).copied()\n        });\n    }\n\n    let mut groups = Vec::new();\n    for (_, mut items) in by {\n        items.sort_by(|a, b| match (a.rank, b.rank) {\n            (Some(x), Some(y)) => x.cmp(&y),\n            _ => a.companion.cmp(&b.companion).then_with(|| a.path.cmp(&b.path)),\n        });\n        let key = items.iter().filter(|x| x.companion == 0).map(|x| x.key)\n            .min().or_else(|| items.iter().map(|x| x.key).min()).unwrap_or(0);\n        let rank = items.iter().filter_map(|x| x.rank).min();\n        let tie = items.iter().map(|x| x.path.clone()).min().unwrap_or_default();\n        groups.push(Group { items, key, rank, tie });\n    }\n\n    let mut established: Vec<Group> = groups.iter().filter(|g| g.rank.is_some()).cloned().collect();\n    established.sort_by_key(|g| g.rank.unwrap());\n    let mut fresh: Vec<Group> = groups.into_iter().filter(|g| g.rank.is_none()).collect();\n    fresh.sort_by(|a,b| a.key.cmp(&b.key).then_with(|| a.tie.cmp(&b.tie)));\n    for g in fresh {\n        let pos = established.iter().position(|x| x.key > g.key).unwrap_or(established.len());\n        established.insert(pos, g);\n    }\n    Ok(established.into_iter().flat_map(|g| g.items.into_iter().map(|x| x.path)).collect())\n}\nRS\n"]
