[89.415535, "i", "printf '%s\\n' '--- generated ---'; cat /app/relaydesk/gen/routing_map.py; python3 - <<'PY'\nimport tomllib\nfrom pathlib import Path\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nrows = tomllib.loads(Path('/app/faultdata/roster.toml').read_text())['roster']['signatures']\nexpected = {row['id']: row['owner'] for row in rows}\nassert SIGNATURE_OWNERS == expected, (SIGNATURE_OWNERS, expected)\nprint(f'import and exact roster coverage OK: {len(SIGNATURE_OWNERS)} signatures')\nPY\nset -u\nfor sig in SIG_NULL_DEREF_81c2 SIG_IO_TIMEOUT_4f91 SIG_AUTH_LOOP_22bd SIG_NET_RESET_9e04 SIG_HEAP_OOM_7a3f; do /app/bin/crashrail route --signature \"$sig\" || exit 1; done\nset +e\nunknown=$(/app/bin/crashrail route --signature SIG_UNKNOWN_FFFF); status=$?\nset -e\nprintf 'unknown status=%s output=%s\\n' \"$status\" \"$unknown\"\ntest \"$status\" -ne 0\npython3 - <<'PY' \"$unknown\"\nimport json, sys\nvalue = json.loads(sys.argv[1])\nassert value == {'team': 'platform-core', 'source': 'default'}, value\nprint('unknown fallback OK')\nPY\n"]
