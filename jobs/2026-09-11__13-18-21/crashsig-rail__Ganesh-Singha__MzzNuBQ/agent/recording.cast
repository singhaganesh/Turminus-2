[17.18391, "o", "--- crashrail ---\r\n"]
[17.185738, "o", "#!/bin/bash\r\nset -euo pipefail\r\nexport PYTHONPATH=\"/app:${PYTHONPATH:-}\"\r\nexec python3 -m relaydesk.cli_entry \"$@\"\r\n"]
[17.185975, "o", "--- roster ---\r\n"]
[17.186961, "o", "[roster]\r\ndefault_team = \"platform-core\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_NULL_DEREF_81c2\"\r\nowner = \"graphics-guild\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_IO_TIMEOUT_4f91\"\r\nowner = \"storage-cell\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_AUTH_LOOP_22bd\"\r\nowner = \"identity-ring\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_NET_RESET_9e04\"\r\nowner = \"network-desk\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_HEAP_OOM_7a3f\"\r\nowner = \"memory-squad\"\r\n"]
[17.187177, "o", "--- generated map ---\r\n"]
[17.188571, "o", "\"\"\"Generated routing map. Do not edit.\"\"\"\r\n\r\nOWNERS = {\r\n    \"SIG_NULL_DEREF_81c2\": \"graphics-guild\",\r\n}\r\n"]
