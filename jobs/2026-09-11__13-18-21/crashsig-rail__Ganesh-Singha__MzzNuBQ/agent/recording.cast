[52.663883, "o", "root=$(python3 -c 'import pathlib,codemill; print(pathlib.Path(codemill.__file__).parent)'); for f in $(find \"$root\" -type f -name '*.py' | sort); do echo \"--- $f\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[52.744192, "o", "--- /app/codemill/__init__.py\r\n"]
[52.746946, "o", "     1\t\"\"\"Table generation from roster data.\"\"\"\r\n"]
[52.747365, "o", "--- /app/codemill/tablegen/__init__.py\r\n"]
[52.749096, "o", "     1\t\"\"\"Roster-driven routing table compiler.\"\"\"\r\n"]
[52.749444, "o", "--- /app/codemill/tablegen/ast_read.py\r\n"]
[52.751093, "o", "     1\t\"\"\"AST helpers for generated maps.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport ast\r\n     6\tfrom typing import Dict\r\n     7\t\r\n     8\t\r\n     9\tdef read_map_literal(text: str) -> Dict[str, str]:\r\n    10\t    tree = ast.parse(text)\r\n    11\t    for node in tree.body:\r\n    12\t        if isinstance(node, ast.Assign):\r\n    13\t            for target in node.targets:\r\n    14\t                if isinstance(target, ast.Name) and target.id == \"SIGNATURE_OWNERS\":\r\n    15\t                    raw = ast.literal_eval(node.value)\r\n    16\t                    if not isinstance(raw, dict):\r\n    17\t                        raise ValueError(\"not a dict\")\r\n"]
[52.751296, "o", "    18\t                    return {str(k): str(v) for k, v in raw.items()}\r\n    19\t    raise ValueError(\"SIGNATURE_OWNERS not found\")\r\n"]
[52.751487, "o", "--- /app/codemill/tablegen/driver.py\r\n"]
[52.753208, "o", "     1\t\"\"\"Compile driver.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport sys\r\n     6\t\r\n     7\tfrom codemill.tablegen.publish import emit_map\r\n     8\t\r\n     9\t\r\n    10\tdef run_tablegen() -> int:\r\n"]
[52.753413, "o", "    11\t    emit_map()\r\n    12\t    print(\"tablegen done\", file=sys.stderr)\r\n    13\t    return 0\r\n"]
[52.753561, "o", "--- /app/codemill/tablegen/guard.py\r\n"]
[52.755363, "o", "     1\t\"\"\"Skip-if-unchanged guard for routing map writes.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n     7\tfrom codemill.tablegen.ast_read import read_map_literal\r\n     8\t\r\n     9\t\r\n    10\tdef should_emit(path: Path, fresh_body: str) -> bool:\r\n    11\t    if not path.exists():\r\n    12\t        return True\r\n    13\t    try:\r\n    14\t        on_disk = read_map_literal(path.read_text())\r\n    15\t    except (SyntaxError, ValueError):\r\n    16\t        on_disk = None\r\n    17\t    if on_disk is None:\r\n    18\t        return False\r\n    19\t    return on_disk == read_map_literal(fresh_body)\r\n"]
[52.755777, "o", "--- /app/codemill/tablegen/publish.py\r\n"]
[52.757628, "o", "     1\t\"\"\"Write routing_map.py from roster rows.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n"]
[52.757752, "o", "     7\tfrom codemill.tablegen.guard import should_emit\r\n     8\tfrom codemill.tablegen.roster_read import load_pairs\r\n     9\t\r\n    10\tOUT = Path(\"/app/relaydesk/gen/routing_map.py\")\r\n    11\t\r\n    12\t\r\n    13\tdef build_source(rows: list[tuple[str, str]]) -> str:\r\n    14\t    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"OWNERS = {\"]\r\n    15\t    for sig, team in sorted(rows):\r\n    16\t        lines.append(f'    \"{sig}\": \"{team}\",')\r\n    17\t    lines.append(\"}\")\r\n    18\t    lines.append(\"\")\r\n    19\t    return \"\\n\".join(lines)\r\n    20\t\r\n    21"]
[52.757807, "o", "\t\r\n    22\tdef emit_map(path: Path | None = None) -> bool:\r\n    23\t    target = path or OUT\r\n    24\t    target.parent.mkdir(parents=True, exist_ok=True)\r\n    25\t    body = build_source(load_pairs())\r\n    26\t    if not should_emit(target, body):\r\n    27\t        return False\r\n    28\t    target.write_text(body)\r\n"]
[52.757843, "o", "    29\t    return True\r\n"]
[52.758392, "o", "--- /app/codemill/tablegen/roster_read.py\r\n"]
[52.760466, "o", "     1\t\"\"\"Read fault roster TOML.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport tomllib\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tROSTER = Path(\"/app/faultdata/roster.toml\")\r\n     9\t\r\n    10\t\r\n    11\tdef load_pairs(path: Path | None = None) -> list[tuple[str, str]]:\r\n    12\t    src = path or ROSTER\r\n    13\t    doc = tomllib.loads(src.read_text())\r\n    14\t    pairs: list[tuple[str, str]] = []\r\n    15\t    for row in doc.get(\"roster\", {}).get(\"signatures\", []):\r\n    16\t        sig = str(row.get(\"id\", \"\")).strip().upper()"]
[52.76071, "o", "\r\n    17\t        team = str(row.get(\"owner\", \"\")).strip()\r\n    18\t        if sig and team:\r\n    19\t            pairs.append((sig, team))\r\n    20\t    if not pairs:\r\n    21\t        raise ValueError(\"empty roster\")\r\n    22\t    return pairs\r\n"]
[52.761186, "o", "\u001b[?2004hroot@5cf9fbd8f326:/app# "]
[87.414591, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/codemill/tablegen/roster_read.py')\ns = p.read_text().replace('sig = str(row.get(\"id\", \"\")).strip().upper()', 'sig = str(row.get(\"id\", \"\")).strip()')\np.write_text(s)\n\np = Path('/app/codemill/tablegen/guard.py')\ns = p.read_text()\ns = s.replace('''    if on_disk is None:\n        return False\n    return on_disk == read_map_literal(fresh_body)\n''', '''    if on_disk is None:\n        return True\n    return on_disk != read_map_literal(fresh_body)\n''')\np.write_text(s)\n\np = Path('/app/codemill/tablegen/publish.py')\ns = p.read_text()\ns = s.replace('from pathlib import Path\\n', 'import os\\nimport tempfile\\nfrom pathlib import Path\\n')\ns = s.replace('lines = [\\'\"\"\"Generated routing map. Do not edit.\"\"\"\\', \"\", \"OWNERS = {\"]', 'lines = [\\'\"\"\"Generated routing map. Do not edit.\"\"\"\\', \"\", \"SIGNATURE_OWNERS = {\"]')\ns = s.replace(\"lines.append(f'    \\\"{sig}\\\": \\\"{team}\\\",')\", \"lines.append(f'    {sig!r}: {team!r},')\")\ns = s.replace('''    target.write_text(body)\n    return True\n''', '''    fd, tmp_name = tempfile.mkstemp(\n        dir=target.parent, prefix=f\".{target.name}.\", suffix=\".tmp\", text=True\n    )\n    try:\n        with os.fdopen(fd, \"w\") as stream:\n            stream.write(body)\n            stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(tmp_name, target)\n    except BaseException:\n        try:\n            os.unlink(tmp_name)\n        except FileNotFoundError:\n            pass\n        raise\n    return True\n''')\np.write_text(s)\n\np = Path('/app/relaydesk/switchboard/direct.py')\ns = p.read_text().replace('''    text = sig.strip().upper()\n    return text[4:]\n''', '''    return sig.strip()\n''')\np.write_text(s)\nPY\npython3 -m py_compile /app/codemill/tablegen/*.py /app/relaydesk/switchboard/*.py\n/app/bin/crashrail compile\n"]
