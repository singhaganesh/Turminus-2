    11	    emit_map()
    12	    print("tablegen done", file=sys.stderr)
    13	    return 0
--- /app/codemill/tablegen/guard.py
     1	"""Skip-if-unchanged guard for routing map writes."""
     2	
     3	from __future__ import annotations
     4	
     5	from pathlib import Path
     6	
     7	from codemill.tablegen.ast_read import read_map_literal
     8	
     9	
    10	def should_emit(path: Path, fresh_body: str) -> bool:
    11	    if not path.exists():
    12	        return True
    13	    try:
    14	        on_disk = read_map_literal(path.read_text())
    15	    except (SyntaxError, ValueError):
    16	        on_disk = None
    17	    if on_disk is None:
    18	        return False
    19	    return on_disk == read_map_literal(fresh_body)
--- /app/codemill/tablegen/publish.py
     1	"""Write routing_map.py from roster rows."""
     2	
     3	from __future__ import annotations
     4	
     5	from pathlib import Path
     6	
     7	from codemill.tablegen.guard import should_emit
     8	from codemill.tablegen.roster_read import load_pairs
     9	
    10	OUT = Path("/app/relaydesk/gen/routing_map.py")
    11	
    12	
    13	def build_source(rows: list[tuple[str, str]]) -> str:
    14	    lines = ['"""Generated routing map. Do not edit."""', "", "OWNERS = {"]
    15	    for sig, team in sorted(rows):
    16	        lines.append(f'    "{sig}": "{team}",')
    17	    lines.append("}")
    18	    lines.append("")
    19	    return "\n".join(lines)
    20	
    21	
    22	def emit_map(path: Path | None = None) -> bool:
    23	    target = path or OUT
    24	    target.parent.mkdir(parents=True, exist_ok=True)
    25	    body = build_source(load_pairs())
    26	    if not should_emit(target, body):
    27	        return False
    28	    target.write_text(body)
    29	    return True
--- /app/codemill/tablegen/roster_read.py
     1	"""Read fault roster TOML."""
     2	
     3	from __future__ import annotations
     4	
     5	import tomllib
     6	from pathlib import Path
     7	
     8	ROSTER = Path("/app/faultdata/roster.toml")
     9	
    10	
    11	def load_pairs(path: Path | None = None) -> list[tuple[str, str]]:
    12	    src = path or ROSTER
    13	    doc = tomllib.loads(src.read_text())
    14	    pairs: list[tuple[str, str]] = []
    15	    for row in doc.get("roster", {}).get("signatures", []):
    16	        sig = str(row.get("id", "")).strip().upper()
    17	        team = str(row.get("owner", "")).strip()
    18	        if sig and team:
    19	            pairs.append((sig, team))
    20	    if not pairs:
    21	        raise ValueError("empty roster")
    22	    return pairs
