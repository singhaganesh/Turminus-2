     1	"""Crashrail command-line front door."""
     2	
     3	from __future__ import annotations
     4	
     5	import argparse
     6	import json
     7	
     8	from codemill.tablegen.driver import run_tablegen
     9	from relaydesk.switchboard.direct import direct
    10	
    11	
    12	def main(argv: list[str] | None = None) -> int:
    13	    parser = argparse.ArgumentParser(prog="crashrail")
    14	    sub = parser.add_subparsers(dest="cmd", required=True)
    15	
    16	    route = sub.add_parser("route")
    17	    route.add_argument("--signature", required=True)
    18	
    19	    sub.add_parser("compile")
    20	
    21	    args = parser.parse_args(argv)
    22	    if args.cmd == "compile":
    23	        return run_tablegen()
    24	    if args.cmd == "route":
    25	        team, source = direct(args.signature)
    26	        print(json.dumps({"team": team, "source": source}))
    27	        return 1 if source == "default" else 0
    28	    return 2
    29	
    30	
    31	if __name__ == "__main__":
