### /app/relaydesk/cli_entry.py
     1	"""Crashrail command-line front door."""
     2	
     3	from __future__ import annotations
     4	
     5	import argparse
     6	import json
     7	
     8	from codemill.tablegen.driver import run_tablegen
     9	from relaydesk.switchboard.direct import direct
    10	
    11	
    12	def main(argv: list[str] | None = None) -> int:
    13	    parser = argparse.ArgumentParser(prog="crashrail")
    14	    sub = parser.add_subparsers(dest="cmd", required=True)
    15	
    16	    route = sub.add_parser("route")
    17	    route.add_argument("--signature", required=True)
    18	
    19	    sub.add_parser("compile")
    20	
    21	    args = parser.parse_args(argv)
    22	    if args.cmd == "compile":
    23	        return run_tablegen()
    24	    if args.cmd == "route":
    25	        team, source = direct(args.signature)
    26	        print(json.dumps({"team": team, "source": source}))
    27	        return 1 if source == "default" else 0
    28	    return 2
    29	
    30	
    31	if __name__ == "__main__":
    32	    raise SystemExit(main())
### /app/relaydesk/switchboard/direct.py
     1	"""Signature to team routing."""
     2	
     3	from __future__ import annotations
     4	
     5	from relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map
     6	
     7	
     8	def normalize(sig: str) -> str:
     9	    text = sig.strip().upper()
    10	    return text[4:]
    11	
    12	
    13	def direct(sig: str) -> tuple[str, str]:
    14	    table = fetch_map()
    15	    key = normalize(sig)
    16	    if key in table:
    17	        return table[key], "table"
    18	    return DEFAULT_TEAM, "default"
### /app/relaydesk/switchboard/load_map.py
     1	"""Load generated routing maps."""
     2	
     3	from __future__ import annotations
     4	
     5	from typing import Dict
     6	
     7	DEFAULT_TEAM = "platform-core"
     8	
     9	
    10	def fetch_map() -> Dict[str, str]:
    11	    try:
    12	        from relaydesk.gen.routing_map import SIGNATURE_OWNERS
    13	    except Exception:
    14	        return {}
    15	    if not isinstance(SIGNATURE_OWNERS, dict):
    16	        return {}
    17	    return {str(k): str(v) for k, v in SIGNATURE_OWNERS.items()}
