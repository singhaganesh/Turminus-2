[103.471948, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[104.131057, "i", "python3 -m py_compile /app/codemill/tablegen/*.py /app/relaydesk/switchboard/*.py /app/relaydesk/gen/routing_map.py\npython3 - <<'PY'\nimport tomllib\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nwith open('/app/faultdata/roster.toml', 'rb') as stream:\n    roster = tomllib.load(stream)['roster']\nexpected = {\n    row['id'].strip().upper(): row['owner'].strip()\n    for row in roster['signatures']\n}\nassert SIGNATURE_OWNERS == expected\nprint('final table coverage OK:', len(SIGNATURE_OWNERS))\nPY\nset +e\nknown=$(/app/bin/crashrail route --signature SIG_NULL_DEREF_81c2); known_rc=$?\nunknown=$(/app/bin/crashrail route --signature SIG_UNKNOWN_FFFF); unknown_rc=$?\nset -e\nprintf 'known rc=%s %s\\nunknown rc=%s %s\\n' \"$known_rc\" \"$known\" \"$unknown_rc\" \"$unknown\"\ntest \"$known_rc\" -eq 0\ntest \"$known\" = '{\"team\": \"graphics-guild\", \"source\": \"table\"}'\ntest \"$unknown_rc\" -ne 0\ntest \"$unknown\" = '{\"team\": \"platform-core\", \"source\": \"default\"}'\n"]
[104.131557, "o", "python3 -m py_compile /app/codemill/tablegen/*.py /app/relaydesk/switchboard/*.py /app/relaydesk/gen/routing_map.py\r\n\u001b[?2004l\r"]
[104.196733, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# python3 - <<'PY'\r\n\u001b[?2004l\r"]
[104.19691, "o", "\u001b[?2004h> import tomllib\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.196995, "o", "from relaydesk.gen.routing_map import SIGNATURE_OWNERS\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.197074, "o", "> "]
[104.197255, "o", "with open('/app/faultdata/roster.toml', 'rb') as stream:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.197331, "o", "    roster = tomllib.load(stream)['roster']\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.197394, "o", "> expected = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.197496, "o", "    row['id'].strip().upper(): row['owner'].strip()\r\n\u001b[?2004l\r"]
[104.19755, "o", "\u001b[?2004h> "]
[104.197616, "o", "    for row in roster['signatures']\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[104.197673, "o", "\u001b[?2004h> "]
[104.19773, "o", "assert SIGNATURE_OWNERS == expected\r\n\u001b[?2004l\r"]
[104.197785, "o", "\u001b[?2004h> "]
[104.19787, "o", "print('final table coverage OK:', len(SIGNATURE_OWNERS))\r\n\u001b[?2004l\r"]
[104.197934, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[104.237239, "o", "final table coverage OK: 5\r\n"]
[104.244067, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# set +e\r\n"]
[104.244109, "o", "\u001b[?2004l\r"]
[104.244297, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[104.244409, "o", "known=$(/app/bin/crashrail route --signature SIG_NULL_DEREF_81c2); known_rc=$?\r\n\u001b[?2004l\r"]
[104.340875, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[104.341066, "o", "unknown=$(/app/bin/crashrail route --signature SIG_UNKNOWN_FFFF); unknown_rc=$?\r\n\u001b[?2004l\r"]
[104.431268, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# set -e\r\n\u001b[?2004l\r"]
[104.431448, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[104.431708, "o", "printf 'known rc=%s %s\\nunknown rc=%s %s\\n' \"$known_rc\" \"$known\" \"$unknown_rc\" \"$unknown\"\r\n\u001b[?2004l\rknown rc=0 {\"team\": \"graphics-guild\", \"source\": \"table\"}\r\nunknown rc=1 {\"team\": \"platform-core\", \"source\": \"default\"}\r\n"]
[104.431863, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# test \"$known_rc\" -eq 0\r\n\u001b[?2004l\r"]
[104.431929, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[104.43205, "o", "test \"$known\" = '{\"team\": \"graphics-guild\", \"source\": \"table\"}'\r\n\u001b[?2004l\r"]
[104.432184, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# test \"$unknown_rc\" -ne 0\r\n\u001b[?2004l\r"]
[104.432245, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[104.432446, "o", "test \"$unknown\" = '{\"team\": \"platform-core\", \"source\": \"default\"}'\r\n\u001b[?2004l\r"]
[104.432533, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
