[103.255678, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[103.255842, "o", "cat > /app/relaydesk/gen/routing_map.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.255938, "o", "SIGNATURE_OWNERS = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.256038, "o", "    'SIG_NULL_DEREF_81C2': 'graphics-guild',\r\n\u001b[?2004l\r"]
[103.25616, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[103.257546, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[103.257869, "o", "/app/bin/crashrail compile\r\n\u001b[?2004l\r"]
[103.351644, "o", "tablegen done\r\n"]
