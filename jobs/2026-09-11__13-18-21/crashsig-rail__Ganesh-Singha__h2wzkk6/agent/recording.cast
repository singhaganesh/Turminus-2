[103.172885, "o", "python3 -m py_compile /app/relaydesk/gen/routing_map.py\r\n\u001b[?2004l\r"]
[103.226727, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# python3 - <<'PY'\r\n\u001b[?2004l\r"]
[103.226762, "o", "\u001b[?2004h> "]
[103.226931, "o", "from relaydesk.gen.routing_map import SIGNATURE_OWNERS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.227023, "o", "assert len(SIGNATURE_OWNERS) == 5\r\n\u001b[?2004l\r"]
[103.227089, "o", "\u001b[?2004h> "]
