[30.198865, "o", "\r\n--- relaydesk sources ---\r\n"]
[30.198947, "o", "### /app/relaydesk/cli_entry.py\r\n"]
[30.203494, "o", "     1\t\"\"\"Crashrail command-line front door.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport argparse\r\n     6\timport json\r\n     7\t\r\n     8\tfrom codemill.tablegen.driver import run_tablegen\r\n     9\tfrom relaydesk.switchboard.direct import direct\r\n    10\t\r\n"]
[30.203654, "o", "    11\t\r\n    12\tdef main(argv: list[str] | None = None) -> int:\r\n    13\t    parser = argparse.ArgumentParser(prog=\"crashrail\")\r\n    14\t    sub = parser.add_subparsers(dest=\"cmd\", required=True)\r\n    15\t\r\n    16\t    route = sub.add_parser(\"route\")\r\n    17\t    route.add_argument(\"--signature\", required=True)\r\n    18\t\r\n    19\t    sub.add_parser(\"compile\")\r\n    20\t\r\n    21\t    args = parser.parse_args(argv)\r\n    22\t    if args.cmd == \"compile\":\r\n    23\t        return run_tablegen()\r\n    24\t    if args.cmd == \"route\":\r\n    25\t        team, source = direct(args.signature)\r\n    26\t        print(json.dumps({\"team\": team, \"source\": source}))\r\n    27\t        return 1 if source == \"default\" else 0\r\n    28\t    return 2\r\n    29\t\r\n    30\t\r\n    31\tif __name__ == \"__main__\":\r\n    32\t    raise SystemExit(main())\r\n"]
[30.20387, "o", "### /app/relaydesk/switchboard/direct.py\r\n"]
[30.205019, "o", "     1\t\"\"\"Signature to team routing.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\r\n     6\t\r\n     7\t\r\n     8\tdef normalize(sig: str) -> str:\r\n     9\t    text = sig.strip().upper()\r\n    10\t    return text[4:]\r\n    11\t\r\n    12\t\r\n    13\tdef direct(sig: str) -> tuple[str, str]:\r\n    14\t    table = fetch_map()\r\n    15\t    key = normalize(sig)\r\n    16\t    if key in table:\r\n    17\t        return table[key], \"table\"\r\n    18"]
[30.205149, "o", "\t    return DEFAULT_TEAM, \"default\"\r\n"]
[30.205298, "o", "### /app/relaydesk/switchboard/load_map.py\r\n"]
[30.206295, "o", "     1\t\"\"\"Load generated routing maps.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom typing import Dict\r\n     6\t\r\n     7\tDEFAULT_TEAM = \"platform-core\"\r\n     8\t\r\n     9\t\r\n    10\tdef fetch_map() -> Dict[str, str]:\r\n    11\t    try:\r\n    12\t        from relaydesk.gen.routing_map import SIGNATURE_OWNERS\r\n    13\t    except Exception:\r\n    14\t        return {}\r\n"]
[30.206453, "o", "    15\t    if not isinstance(SIGNATURE_OWNERS, dict):\r\n    16\t        return {}\r\n    17\t    return {str(k): str(v) for k, v in SIGNATURE_OWNERS.items()}\r\n"]
[30.206552, "o", "### /app/relaydesk/switchboard/__init__.py\r\n"]
[30.20783, "o", "     1\t\"\"\"Switchboard routing.\"\"\"\r\n"]
[30.208236, "o", "### /app/relaydesk/gen/__init__.py\r\n"]
[30.20968, "o", "     1\t\"\"\"Generated routing map package.\"\"\"\r\n"]
[30.209888, "o", "\r\n--- codemill sources ---\r\n"]
[30.211489, "o", "find: warning: you have specified the global option -maxdepth after the argument -type, but global options are not positional, i.e., -maxdepth affects tests specified before it as well as those specified after it.  Please specify global options before other arguments.\r\n"]
[30.212748, "o", "### /app/codemill/__init__.py\r\n"]
[30.213529, "o", "     1\t\"\"\"Table generation from roster data.\"\"\"\r\n"]
[30.21367, "o", "### /app/codemill/tablegen/ast_read.py\r\n"]
[30.214415, "o", "     1\t\"\"\"AST helpers for generated maps.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport ast\r\n     6\tfrom typing import Dict\r\n     7\t\r\n     8\t\r\n     9\tdef read_map_literal(text: str) -> Dict[str, str]:\r\n"]
[30.214576, "o", "    10\t    tree = ast.parse(text)\r\n    11\t    for node in tree.body:\r\n    12\t        if isinstance(node, ast.Assign):\r\n    13\t            for target in node.targets:\r\n    14\t                if isinstance(target, ast.Name) and target.id == \"SIGNATURE_OWNERS\":\r\n    15\t                    raw = ast.literal_eval(node.value)\r\n    16\t                    if not isinstance(raw, dict):\r\n    17\t                        raise ValueError(\"not a dict\")\r\n    18\t                    return {str(k): str(v) for k, v in raw.items()}\r\n    19\t    raise ValueError(\"SIGNATURE_OWNERS not found\")\r\n"]
[30.21469, "o", "### /app/codemill/tablegen/publish.py\r\n"]
[30.215499, "o", "     1\t\"\"\"Write routing_map.py from roster rows.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n     7\tfrom codemill.tablegen.guard import should_emit\r\n     8\tfrom codemill.tablegen.roster_read import load_pairs\r\n     9\t\r\n    10\tOUT = Path(\"/app/relaydesk/gen/routing_map.py\")\r\n    11\t\r\n    12\t\r\n"]
[30.215629, "o", "    13\tdef build_source(rows: list[tuple[str, str]]) -> str:\r\n    14\t    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"OWNERS = {\"]\r\n    15\t    for sig, team in sorted(rows):\r\n    16\t        lines.append(f'    \"{sig}\": \"{team}\",')\r\n    17\t    lines.append(\"}\")\r\n    18\t    lines.append(\"\")\r\n    19\t    return \"\\n\".join(lines)\r\n    20\t\r\n    21\t\r\n    22\tdef emit_map(path: Path | None = None) -> bool:\r\n    23\t    target = path or OUT\r\n    24\t    target.parent.mkdir(parents=True, exist_ok=True)\r\n    25\t    body = build_source(load_pairs())\r\n    26\t    if not should_emit(target, body):\r\n    27\t        return False\r\n    28\t    target.write_text(body)\r\n    29\t    return True\r\n"]
[30.215798, "o", "### /app/codemill/tablegen/driver.py\r\n"]
[30.216507, "o", "     1\t\"\"\"Compile driver.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport sys\r\n     6\t\r\n     7\tfrom codemill.tablegen.publish import emit_map\r\n     8\t\r\n     9\t\r\n    10\tdef run_tablegen() -> int:\r\n    11\t    emit_map()\r\n"]
[30.216585, "o", "    12\t    print(\"tablegen done\", file=sys.stderr)\r\n    13\t    return 0\r\n"]
[30.216665, "o", "### /app/codemill/tablegen/guard.py\r\n"]
[30.217401, "o", "     1\t\"\"\"Skip-if-unchanged guard for routing map writes.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n     7\tfrom codemill.tablegen.ast_read import read_map_literal\r\n     8\t\r\n     9\t\r\n"]
[30.217484, "o", "    10\tdef should_emit(path: Path, fresh_body: str) -> bool:\r\n    11\t    if not path.exists():\r\n    12\t        return True\r\n    13\t    try:\r\n    14\t        on_disk = read_map_literal(path.read_text())\r\n    15\t    except (SyntaxError, ValueError):\r\n    16\t        on_disk = None\r\n    17\t    if on_disk is None:\r\n    18\t        return False\r\n    19\t    return on_disk == read_map_literal(fresh_body)\r\n"]
[30.217598, "o", "### /app/codemill/tablegen/__init__.py\r\n"]
[30.218251, "o", "     1\t\"\"\"Roster-driven routing table compiler.\"\"\"\r\n"]
[30.218502, "o", "### /app/codemill/tablegen/roster_read.py\r\n"]
[30.219196, "o", "     1\t\"\"\"Read fault roster TOML.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport tomllib\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tROSTER = Path(\"/app/faultdata/roster.toml\")\r\n     9\t\r\n    10\t\r\n"]
[30.219284, "o", "    11\tdef load_pairs(path: Path | None = None) -> list[tuple[str, str]]:\r\n    12\t    src = path or ROSTER\r\n    13\t    doc = tomllib.loads(src.read_text())\r\n    14\t    pairs: list[tuple[str, str]] = []\r\n    15\t    for row in doc.get(\"roster\", {}).get(\"signatures\", []):\r\n    16\t        sig = str(row.get(\"id\", \"\")).strip().upper()\r\n    17\t        team = str(row.get(\"owner\", \"\")).strip()\r\n    18\t        if sig and team:\r\n    19\t            pairs.append((sig, team))\r\n    20\t    if not pairs:\r\n    21\t        raise ValueError(\"empty roster\")\r\n    22\t    return pairs\r\n"]
[30.219799, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[30.697515, "i", "set +e; echo '--- known route before compile ---'; /app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; echo \"rc=$?\"; echo '--- unknown route before compile ---'; /app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; echo \"rc=$?\"; echo '--- compile baseline ---'; /app/bin/crashrail compile; echo \"rc=$?\"; set -e; echo '--- map after compile ---'; nl -ba /app/relaydesk/gen/routing_map.py\n"]
[30.698601, "o", "set +e; echo '--- known route before compile ---'; /app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; echo \"rc=$?\"; echo '--- unknown route before compile ---'; /app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; echo \"rc=$?\"; echo '--- compile baseline ---'; /app/bin/crashrail compile; echo \"rc=$?\"; set -e; echo '--- map after compile ---'; nl -ba /app/relaydesk/gen/routing_map.py\r\n\u001b[?2004l\r"]
[30.698731, "o", "--- known route before compile ---\r\n"]
[30.773576, "o", "{\"team\": \"platform-core\", \"source\": \"default\"}\r\n"]
[30.784308, "o", "rc=1\r\n--- unknown route before compile ---\r\n"]
[30.858313, "o", "{\"team\": \"platform-core\", \"source\": \"default\"}\r\n"]
