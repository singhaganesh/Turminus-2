[103.367569, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from relaydesk.gen.routing_map import SIGNATURE_OWNERS\r\n\u001b[?2004l\r\u001b[?2004h"]
