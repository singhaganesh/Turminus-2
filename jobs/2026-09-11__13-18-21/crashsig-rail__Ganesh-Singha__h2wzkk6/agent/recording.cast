[71.856435, "o", "\u001b[?2004h> "]
[71.856469, "o", "    fresh = read_map_literal(fresh_body)\r\n\u001b[?2004l\r"]
[71.857519, "o", "\u001b[?2004h>     if not path.exists():\r\n\u001b[?2004l\r\u001b[?2004h>         return True\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         on_disk = read_map_literal(path.read_text())\r\n\u001b[?2004l\r\u001b[?2004h>     except (OSError, UnicodeError, SyntaxError, ValueError):\r\n\u001b[?2004l\r\u001b[?2004h>         return True\r\n\u001b[?2004l\r\u001b[?2004h>     return on_disk != fresh\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[71.858935, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[71.85911, "o", "cat > /app/codemill/tablegen/publish.py <<'PY'\r\n\u001b[?2004l\r"]
[71.859185, "o", "\u001b[?2004h> "]
[71.859317, "o", "\"\"\"Write routing_map.py from roster rows.\"\"\"\r\n\u001b[?2004l\r"]
[71.859388, "o", "\u001b[?2004h> "]
[71.859474, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[71.859527, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.859587, "o", "> import os\r\n\u001b[?2004l\r"]
[71.85967, "o", "\u001b[?2004h> "]
[71.859739, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.859796, "o", "import tempfile\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.859852, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.859982, "o", "from codemill.tablegen.guard import should_emit\r\n\u001b[?2004l\r"]
[71.860078, "o", "\u001b[?2004h"]
[71.860166, "o", "> "]
[71.860245, "o", "from codemill.tablegen.roster_read import load_pairs\r\n\u001b[?2004l\r"]
[71.860381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.860465, "o", "OUT = Path(\"/app/relaydesk/gen/routing_map.py\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.860537, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.860632, "o", "def build_source(rows: list[tuple[str, str]]) -> str:\r\n\u001b[?2004l\r"]
[71.860692, "o", "\u001b[?2004h> "]
[71.860872, "o", "    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"SIGNATURE_OWNERS = {\"]\r\n\u001b[?2004l\r"]
[71.860932, "o", "\u001b[?2004h> "]
[71.861, "o", "    for sig, team in sorted(rows):\r\n\u001b[?2004l\r"]
[71.8611, "o", "\u001b[?2004h> "]
[71.861196, "o", "        lines.append(f\"    {sig!r}: {team!r},\")\r\n\u001b[?2004l\r"]
[71.86123, "o", "\u001b[?2004h> "]
[71.861365, "o", "    lines.extend((\"}\", \"\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.861503, "o", "    return \"\\n\".join(lines)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.861591, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.861734, "o", "def emit_map(path: Path | None = None) -> bool:\r\n\u001b[?2004l\r"]
[71.861809, "o", "\u001b[?2004h> "]
[71.861874, "o", "    target = path or OUT\r\n\u001b[?2004l\r"]
[71.861901, "o", "\u001b[?2004h> "]
[71.862046, "o", "    target.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[71.862123, "o", "\u001b[?2004h> "]
[71.862221, "o", "    body = build_source(load_pairs())\r\n\u001b[?2004l\r"]
[71.862347, "o", "\u001b[?2004h> "]
[71.862421, "o", "    if not should_emit(target, body):\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.86249, "o", "> "]
[71.862568, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[71.862656, "o", "\u001b[?2004h> "]
[71.8628, "o", "    # Replace atomically so readers never observe a partial Python module.\r\n\u001b[?2004l\r"]
[71.862872, "o", "\u001b[?2004h> "]
[71.862952, "o", "    fd, temporary = tempfile.mkstemp(\r\n\u001b[?2004l\r"]
[71.86302, "o", "\u001b[?2004h> "]
[71.863244, "o", "        dir=target.parent, prefix=f\".{target.name}.\", suffix=\".tmp\", text=True\r\n\u001b[?2004l\r"]
[71.863324, "o", "\u001b[?2004h"]
[71.863387, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[71.863441, "o", "\u001b[?2004h> "]
[71.863537, "o", "        with os.fdopen(fd, \"w\") as stream:\r\n\u001b[?2004l\r"]
[71.863605, "o", "\u001b[?2004h> "]
[71.863673, "o", "            stream.write(body)\r\n\u001b[?2004l\r"]
[71.863734, "o", "\u001b[?2004h> "]
[71.863797, "o", "            stream.flush()\r\n\u001b[?2004l\r"]
[71.863855, "o", "\u001b[?2004h> "]
[71.86392, "o", "            os.fsync(stream.fileno())\r\n\u001b[?2004l\r"]
[71.86398, "o", "\u001b[?2004h> "]
[71.864067, "o", "        os.replace(temporary, target)\r\n\u001b[?2004l\r"]
[71.864128, "o", "\u001b[?2004h> "]
[71.864184, "o", "    except BaseException:\r\n\u001b[?2004l\r"]
[71.864243, "o", "\u001b[?2004h> "]
[71.864313, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.864389, "o", "            os.unlink(temporary)\r\n\u001b[?2004l\r"]
[71.864443, "o", "\u001b[?2004h> "]
[71.864518, "o", "        except FileNotFoundError:\r\n\u001b[?2004l\r"]
[71.864572, "o", "\u001b[?2004h> "]
[71.864631, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.864689, "o", ">         raise\r\n\u001b[?2004l\r"]
[71.86475, "o", "\u001b[?2004h> "]
[71.864809, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.864865, "o", "> PY\r\n\u001b[?2004l\r"]
[71.86615, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[71.866282, "o", "cat > /app/relaydesk/switchboard/direct.py <<'PY'\r\n\u001b[?2004l\r"]
[71.866382, "o", "\u001b[?2004h> "]
[71.866449, "o", "\"\"\"Signature to team routing.\"\"\"\r\n\u001b[?2004l\r"]
[71.866513, "o", "\u001b[?2004h> "]
[71.866603, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[71.866692, "o", "\u001b[?2004h"]
[71.866803, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.866914, "o", "from relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\r\n\u001b[?2004l\r"]
[71.867008, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[71.867105, "o", "> def normalize(sig: str) -> str:\r\n\u001b[?2004l\r"]
[71.867168, "o", "\u001b[?2004h> "]
[71.867336, "o", "    \"\"\"Normalize input exactly as roster IDs are normalized by the compiler.\"\"\"\r\n\u001b[?2004l\r"]
[71.867369, "o", "\u001b[?2004h> "]
[71.867571, "o", "    return sig.strip().upper()\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.867636, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.86772, "o", "def direct(sig: str) -> tuple[str, str]:\r\n\u001b[?2004l\r"]
[71.86779, "o", "\u001b[?2004h> "]
[71.867892, "o", "    table = fetch_map()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.867969, "o", "    key = normalize(sig)\r\n\u001b[?2004l\r"]
[71.8687, "o", "\u001b[?2004h>     if key in table:\r\n\u001b[?2004l\r\u001b[?2004h>         return table[key], \"table\"\r\n\u001b[?2004l\r\u001b[?2004h>     return DEFAULT_TEAM, \"default\"\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[71.869996, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[71.87016, "o", "/app/bin/crashrail compile\r\n\u001b[?2004l\r"]
[71.946674, "o", "tablegen done\r\n"]
[71.961327, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[72.851947, "i", "echo '--- generated map ---'; cat /app/relaydesk/gen/routing_map.py; echo '--- import and roster coverage ---'; python3 - <<'PY'\nimport tomllib\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nwith open('/app/faultdata/roster.toml', 'rb') as f:\n    rows = tomllib.load(f)['roster']['signatures']\nexpected = {row['id'].strip().upper(): row['owner'].strip() for row in rows}\nassert isinstance(SIGNATURE_OWNERS, dict)\nassert SIGNATURE_OWNERS == expected, (SIGNATURE_OWNERS, expected)\nprint(f'complete: {len(SIGNATURE_OWNERS)} roster signatures')\nPY\nset +e\nfor sig in SIG_NULL_DEREF_81c2 SIG_IO_TIMEOUT_4f91 SIG_AUTH_LOOP_22bd SIG_NET_RESET_9e04 SIG_HEAP_OOM_7a3f; do /app/bin/crashrail route --signature \"$sig\"; echo \"rc=$? signature=$sig\"; done\n/app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; echo \"rc=$? signature=SIG_UNKNOWN_FFFF\"\nset -e\n"]
[72.855462, "o", "echo '--- generated map ---'; cat /app/relaydesk/gen/routing_map.py; echo '--- import and roster coverage ---'; python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import tomllib\r\n\u001b[?2004l\r\u001b[?2004h> from relaydesk.gen.routing_map import SIGNATURE_OWNERS\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/faultdata/roster.toml', 'rb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     rows = tomllib.load(f)['roster']['signatures']\r\n\u001b[?2004l\r\u001b[?2004h> expected = {row['id'].strip().upper(): row['owner'].strip() for row in rows}\r\n\u001b[?2004l\r\u001b[?2004h> assert isinstance(SIGNATURE_OWNERS, dict)\r\n\u001b[?2004l\r\u001b[?2004h> assert SIGNATURE_OWNERS == expected, (SIGNATURE_OWNERS, expected)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'complete: {len(SIGNATURE_OWNERS)} roster signatures')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r--- generated map ---\r\n"]
[72.856242, "o", "\"\"\"Generated routing map. Do not edit.\"\"\"\r\n\r\nSIGNATURE_OWNERS = {\r\n    'SIG_AUTH_LOOP_22BD': 'identity-ring',\r\n    'SIG_HEAP_OOM_7A3F': 'memory-squad',\r\n    'SIG_IO_TIMEOUT_4F91': 'storage-cell',\r\n    'SIG_NET_RESET_9E04': 'network-desk',\r\n    'SIG_NULL_DEREF_81C2': 'graphics-guild',\r\n}\r\n"]
[72.856508, "o", "--- import and roster coverage ---\r\n"]
[72.897331, "o", "complete: 5 roster signatures\r\n"]
[72.904251, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[72.904314, "o", "set +e\r\n\u001b[?2004l\r"]
[72.904491, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[72.904914, "o", "for sig in SIG_NULL_DEREF_81c2 SIG_IO_TIMEOUT_4f91 SIG_AUTH_LOOP_22bd SIG_NET_RESET_9e04 SIG_HEAP_OOM_7a3f; do /app/bin/crashrail route --signature \"$sig\"; echo \"rc=$? signature=$sig\"; done\r\n\u001b[?2004l\r"]
[72.975866, "o", "{\"team\": \"graphics-guild\", \"source\": \"table\"}\r\n"]
[72.987168, "o", "rc=0 signature=SIG_NULL_DEREF_81c2\r\n"]
[73.05608, "o", "{\"team\": \"storage-cell\", \"source\": \"table\"}\r\n"]
[73.066888, "o", "rc=0 signature=SIG_IO_TIMEOUT_4f91\r\n"]
[73.148954, "o", "{\"team\": \"identity-ring\", \"source\": \"table\"}\r\n"]
[73.163896, "o", "rc=0 signature=SIG_AUTH_LOOP_22bd\r\n"]
[73.23262, "o", "{\"team\": \"network-desk\", \"source\": \"table\"}\r\n"]
[73.259216, "o", "rc=0 signature=SIG_NET_RESET_9e04\r\n"]
[73.354797, "o", "{\"team\": \"memory-squad\", \"source\": \"table\"}\r\n"]
[73.364934, "o", "rc=0 signature=SIG_HEAP_OOM_7a3f\r\n\u001b[?2004hroot@3a5f32380cd9:/app# "]
[73.36523, "o", "/app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; echo \"rc=$? signature=SIG_UNKNOWN_FFFF\"\r\n\u001b[?2004l\r"]
[73.4361, "o", "{\"team\": \"platform-core\", \"source\": \"default\"}\r\n"]
[73.449703, "o", "rc=1 signature=SIG_UNKNOWN_FFFF\r\n\u001b[?2004hroot@3a5f32380cd9:/app# "]
[73.449756, "o", "set -e\r\n\u001b[?2004l\r"]
[73.449931, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[103.079435, "i", "printf 'SIGNATURE_OWNERS = {\\n' > /app/relaydesk/gen/routing_map.py\n/app/bin/crashrail compile\npython3 -m py_compile /app/relaydesk/gen/routing_map.py\npython3 - <<'PY'\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nassert len(SIGNATURE_OWNERS) == 5\nprint('invalid map repaired')\nPY\ncat > /app/relaydesk/gen/routing_map.py <<'PY'\nSIGNATURE_OWNERS = {\n    'SIG_NULL_DEREF_81C2': 'graphics-guild',\n}\nPY\n/app/bin/crashrail compile\npython3 - <<'PY'\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nassert len(SIGNATURE_OWNERS) == 5\nprint('incomplete map repaired')\nPY\n/app/bin/crashrail compile\n"]
[103.079822, "o", "printf 'SIGNATURE_OWNERS = {\\n' > /app/relaydesk/gen/routing_map.py\r\n\u001b[?2004l\r"]
