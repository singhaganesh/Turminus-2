[30.951118, "o", "\u001b[?2004hroot@3a5f32380cd9:/app# "]
[71.854348, "i", "cat > /app/codemill/tablegen/guard.py <<'PY'\n\"\"\"Skip-if-unchanged guard for routing map writes.\"\"\"\nfrom __future__ import annotations\n\nfrom pathlib import Path\n\nfrom codemill.tablegen.ast_read import read_map_literal\n\n\ndef should_emit(path: Path, fresh_body: str) -> bool:\n    \"\"\"Return true when *path* is absent, invalid, or differs from fresh_body.\"\"\"\n    fresh = read_map_literal(fresh_body)\n    if not path.exists():\n        return True\n    try:\n        on_disk = read_map_literal(path.read_text())\n    except (OSError, UnicodeError, SyntaxError, ValueError):\n        return True\n    return on_disk != fresh\nPY\ncat > /app/codemill/tablegen/publish.py <<'PY'\n\"\"\"Write routing_map.py from roster rows.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\nimport tempfile\n\nfrom codemill.tablegen.guard import should_emit\nfrom codemill.tablegen.roster_read import load_pairs\n\nOUT = Path(\"/app/relaydesk/gen/routing_map.py\")\n\n\ndef build_source(rows: list[tuple[str, str]]) -> str:\n    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"SIGNATURE_OWNERS = {\"]\n    for sig, team in sorted(rows):\n        lines.append(f\"    {sig!r}: {team!r},\")\n    lines.extend((\"}\", \"\"))\n    return \"\\n\".join(lines)\n\n\ndef emit_map(path: Path | None = None) -> bool:\n    target = path or OUT\n    target.parent.mkdir(parents=True, exist_ok=True)\n    body = build_source(load_pairs())\n    if not should_emit(target, body):\n        return False\n\n    # Replace atomically so readers never observe a partial Python module.\n    fd, temporary = tempfile.mkstemp(\n        dir=target.parent, prefix=f\".{target.name}.\", suffix=\".tmp\", text=True\n    )\n    try:\n        with os.fdopen(fd, \"w\") as stream:\n            stream.write(body)\n            stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(temporary, target)\n    except BaseException:\n        try:\n            os.unlink(temporary)\n        except FileNotFoundError:\n            pass\n        raise\n    return True\nPY\ncat > /app/relaydesk/switchboard/direct.py <<'PY'\n\"\"\"Signature to team routing.\"\"\"\nfrom __future__ import annotations\n\nfrom relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\n\n\ndef normalize(sig: str) -> str:\n    \"\"\"Normalize input exactly as roster IDs are normalized by the compiler.\"\"\"\n    return sig.strip().upper()\n\n\ndef direct(sig: str) -> tuple[str, str]:\n    table = fetch_map()\n    key = normalize(sig)\n    if key in table:\n        return table[key], \"table\"\n    return DEFAULT_TEAM, \"default\"\nPY\n/app/bin/crashrail compile\n"]
