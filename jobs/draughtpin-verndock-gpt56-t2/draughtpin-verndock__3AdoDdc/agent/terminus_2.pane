=== narbay ===
     1	use std::fs;
     2	
     3	pub fn knit() -> String {
     4	    let raw = match fs::read_to_string("/app/quarryc/hold.toml") {
     5	        Ok(s) => s,
     6	        Err(_) => return "CASK_1".to_string(),
     7	    };
     8	    let mut first = None;
     9	    let mut name = String::new();
    10	    for line in raw.lines() {
    11	        let t = line.trim();
    12	        if let Some(rest) = t.strip_prefix("name = ") {
    13	            name = rest.trim_matches('"').to_string();
    14	        }
    15	        if t == "home = 1" && first.is_none() && !name.is_empty() {
    16	            first = Some(name.clone());
    17	        }
    18	    }
    19	    first.unwrap_or_else(|| "CASK_1".to_string())
    20	}
    21	
    22	#[allow(dead_code)]
    23	pub fn weave(path: &str) -> Result<(), i32> {
    24	    let home = knit();
    25	    let body = format!(
    26	        "{h} {{\n  global:\n    fold_frame;\n  local:\n    *;\n}};\nCASK_2 {{\n  global:\n    fold_frame;\n}} {h};\n",
    27	        h = home
    28	    );
    29	    fs::create_dir_all("/app/gnuverse").map_err(|_| 1)?;
    30	    fs::write(path, body).map_err(|_| 1)?;
    31	    Ok(())
    32	}
=== stemcask ===
     1	use core::slice;
     2	
     3	fn lower_only(s: &[u8], dst: &mut [u8]) -> usize {
     4	    let n = s.len().min(dst.len());
     5	    for i in 0..n {
     6	        dst[i] = s[i].to_ascii_lowercase();
     7	    }
     8	    n
     9	}
    10	
    11	fn full_fold(s: &[u8], dst: &mut [u8]) -> usize {
    12	    let mut i = 0;
    13	    let mut space = false;
    14	    for &b in s {
    15	        if i >= dst.len() {
    16	            break;
    17	        }
    18	        if b == b'\t' || b == b' ' || b == b'\n' || b == b'\r' {
    19	            if !space {
    20	                dst[i] = b' ';
    21	                i += 1;
    22	                space = true;
    23	            }
    24	            continue;
    25	        }
    26	        if b < 0x20 {
    27	            continue;
    28	        }
    29	        space = false;
    30	        dst[i] = b.to_ascii_lowercase();
    31	        i += 1;
    32	    }
    33	    while i > 0 && dst[i - 1] == b'/' {
    34	        i -= 1;
    35	    }
    36	    i
    37	}
    38	
    39	#[no_mangle]
    40	pub unsafe extern "C" fn wick_old(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {
    41	    if p.is_null() || dst.is_null() || cap == 0 {
    42	        return -1;
    43	    }
    44	    let s = slice::from_raw_parts(p, n);
    45	    let d = slice::from_raw_parts_mut(dst, cap);
    46	    lower_only(s, d) as isize
    47	}
    48	
    49	#[no_mangle]
    50	pub unsafe extern "C" fn wick_new(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {
    51	    if p.is_null() || dst.is_null() || cap == 0 {
    52	        return -1;
    53	    }
    54	    let s = slice::from_raw_parts(p, n);
    55	    let d = slice::from_raw_parts_mut(dst, cap);
    56	    full_fold(s, d) as isize
    57	}
