    10	fn main() {
    11	    let mut args = std::env::args();
    12	    let _ = args.next();
    13	    let cmd = args.next().unwrap_or_default();
    14	    if cmd == "sip" {
    15	        let dump = args.next().unwrap_or_default();
    16	        let _ = skip::skip(&dump);
    17	        std::process::exit(qat::qat(&dump, None));
    18	    }
    19	    if cmd == "mark" {
    20	        let dump = args.next().unwrap_or_default();
    21	        let slot = args.next().unwrap_or_default();
    22	        let _ = note::note(&slot);
    23	        std::process::exit(qat::qat(&dump, Some(&slot)));
    24	    }
    25	    eprintln!("usage: draughtpin sip DUMP | draughtpin mark DUMP SLOT");
    26	    std::process::exit(2);
    27	}
