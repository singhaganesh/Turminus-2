     1	use std::fs;
     2	use std::os::raw::{c_char, c_int, c_void};
     3	
     4	use crate::loom;
     5	
     6	const RTLD_NOW: c_int = 2;
     7	
     8	extern "C" {
     9	    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;
    10	    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;
    11	    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;
    12	}
    13	
    14	type FoldFn = unsafe extern "C" fn(*const u8, usize, *mut u8, usize) -> isize;
    15	
    16	fn rules_pair() -> (String, String) {
    17	    let mut cur = String::new();
    18	    let mut old = String::new();
    19	    if let Ok(s) = fs::read_to_string("/app/abifolio/RULES.txt") {
    20	        for line in s.lines() {
    21	            if let Some(rest) = line.strip_prefix("current slot:") {
    22	                cur = rest.trim().to_string();
    23	            }
    24	            if let Some(rest) = line.strip_prefix("compat slot:") {
    25	                old = rest.trim().to_string();
    26	            }
    27	        }
    28	    }
    29	    (cur, old)
    30	}
    31	
    32	fn folio_ok(slot: &str) -> bool {
    33	    let (a, b) = rules_pair();
    34	    slot == a || slot == b
    35	}
    36	
    37	fn load() -> *mut c_void {
    38	    unsafe { dlopen(b"/app/lib/libdraught.so\0".as_ptr() as *const c_char, RTLD_NOW) }
    39	}
    40	
    41	fn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {
    42	    if ptr.is_null() {
    43	        return Err(1);
    44	    }
    45	    let f: FoldFn = unsafe { std::mem::transmute(ptr) };
    46	    let mut buf = vec![0u8; blob.len() + 32];
    47	    let n = unsafe { f(blob.as_ptr(), blob.len(), buf.as_mut_ptr(), buf.len()) };
    48	    if n < 0 {
    49	        return Err(1);
    50	    }
    51	    buf.truncate(n as usize);
    52	    Ok(buf)
    53	}
    54	
    55	fn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {
    56	    fs::create_dir_all("/app/inkvat").map_err(|_| 1)?;
    57	    let body = format!(
    58	        "{{\"node\":\"{}\",\"text\":{},\"kind\":\"{}\"}}\n",
    59	        slot,
    60	        serde_like(text),
    61	        kind
    62	    );
    63	    fs::write("/app/inkvat/card.json", body).map_err(|_| 1)?;
    64	    Ok(())
    65	}
    66	
    67	fn serde_like(s: &str) -> String {
    68	    let mut o = String::from("\"");
    69	    for c in s.chars() {
    70	        match c {
    71	            '"' => o.push_str("\\\""),
    72	            '\\' => o.push_str("\\\\"),
    73	            '\n' => o.push_str("\\n"),
    74	            '\t' => o.push_str("\\t"),
    75	            c if (c as u32) < 0x20 => o.push_str(&format!("\\u{:04x}", c as u32)),
    76	            _ => o.push(c),
    77	        }
    78	    }
    79	    o.push('"');
    80	    o
    81	}
    82	
    83	pub fn qat(a: &str, b: Option<&str>) -> i32 {
    84	    let _ = fs::remove_file("/app/inkvat/SEAL");
    85	    let blob = match fs::read(a) {
    86	        Ok(x) => x,
    87	        Err(_) => return 1,
    88	    };
    89	    if blob.is_empty() {
    90	        let _ = write_card("", "", "raw");
    91	        let _ = fs::write("/app/inkvat/SEAL", "ok");
    92	        return 0;
    93	    }
    94	    if let Some(n) = b {
    95	        if !folio_ok(n) {
    96	            let _ = write_card(n, "", "raw");
    97	            let _ = fs::write("/app/inkvat/SEAL", "ok");
    98	            return 0;
    99	        }
   100	    }
   101	    let h = load();
   102	    if h.is_null() {
   103	        return 1;
   104	    }
   105	    let ptr = unsafe {
   106	        match b {
   107	            None => dlsym(h, b"fold_frame\0".as_ptr() as *const c_char),
   108	            Some(n) => {
   109	                let mut v = n.as_bytes().to_vec();
   110	                v.push(0);
   111	                dlvsym(
   112	                    h,
   113	                    b"fold_frame\0".as_ptr() as *const c_char,
   114	                    v.as_ptr() as *const c_char,
   115	                )
   116	            }
   117	        }
   118	    };
   119	    let out = match call(ptr, &blob) {
   120	        Ok(v) => v,
   121	        Err(c) => return c,
   122	    };
   123	    let text = String::from_utf8_lossy(&out).into_owned();
   124	    let home = loom::knit();
   125	    let kind = if b.is_some() { "raw" } else { "raw" };
   126	    if write_card(&home, &text, kind).is_err() {
   127	        return 1;
   128	    }
   129	    if fs::write("/app/inkvat/SEAL", "ok").is_err() {
   130	        return 1;
   131	    }
   132	    0
   133	}
