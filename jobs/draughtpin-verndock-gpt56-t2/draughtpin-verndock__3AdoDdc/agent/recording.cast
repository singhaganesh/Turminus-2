[31.379372, "i", "echo '=== configs ==='; for f in /app/quarryc/hold.toml /app/gnuverse/cask.map /app/keepnote/*; do echo \"--- $f\"; cat \"$f\"; done; echo '=== dumps ==='; for f in /app/rawspan/*; do printf '%s bytes=%s: ' \"$f\" \"$(wc -c < \"$f\")\"; od -An -v -tx1 \"$f\" | tr -d '\\n'; echo; done\n"]
[31.380551, "o", "echo '=== configs ==='; for f in /app/quarryc/hold.toml /app/gnuverse/cask.map /app/keepnote/*; do echo \"--- $f\"; cat \"$f\"; done; echo '=== dumps ==='; for f in /app/rawspan/*; do printf '%s bytes=%s: ' \"$f\" \"$(wc -c < \"$f\")\"; od -An -v -tx1 \"$f\" | tr -d '\\n'; echo; done\r\n\u001b[?2004l\r"]
