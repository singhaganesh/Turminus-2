[92.639652, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[92.856981, "i", "cat > /app/cliurn/boot.rs <<'EOF'\n#[path = \"../narbay/loom.rs\"] mod loom;\n#[path = \"../vatrib/qat.rs\"] mod qat;\n\nfn main() {\n    let mut args = std::env::args().skip(1);\n    match args.next().as_deref() {\n        Some(\"sip\") => {\n            let dump = args.next().unwrap_or_else(|| \"/app/rawspan/alpha.raw\".to_string());\n            if args.next().is_some() { std::process::exit(2); }\n            std::process::exit(qat::qat(&dump, None));\n        }\n        Some(\"mark\") => {\n            let r = match loom::rules() { Ok(v) => v, Err(c) => std::process::exit(c) };\n            let first = args.next();\n            let second = args.next();\n            if args.next().is_some() { std::process::exit(2); }\n            let (dump, slot) = match (first, second) {\n                (None, None) => (\"/app/rawspan/beta.raw\".to_string(), r.current),\n                (Some(a), None) if a == r.current || a == r.compat =>\n                    (\"/app/rawspan/beta.raw\".to_string(), a),\n                (Some(a), None) => (a, r.current),\n                (Some(a), Some(b)) => (a, b),\n                (None, Some(_)) => unreachable!(),\n            };\n            std::process::exit(qat::qat(&dump, Some(&slot)));\n        }\n        _ => {\n            eprintln!(\"usage: draughtpin sip [DUMP] | draughtpin mark [DUMP] [SLOT]\");\n            std::process::exit(2);\n        }\n    }\n}\nEOF\n/app/stoke.sh\n"]
