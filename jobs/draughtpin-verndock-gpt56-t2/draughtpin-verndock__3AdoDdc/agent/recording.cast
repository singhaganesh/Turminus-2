[50.676614, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[92.469703, "i", "cat > /app/narbay/loom.rs <<'EOF'\nuse std::fs;\n\n#[derive(Clone)]\npub struct Rules {\n    pub current: String,\n    pub compat: String,\n    pub sip_kind: String,\n    pub mark_kind: String,\n}\n\npub fn rules() -> Result<Rules, i32> {\n    let raw = fs::read_to_string(\"/app/abifolio/RULES.txt\").map_err(|_| 1)?;\n    let mut r = Rules {\n        current: String::new(), compat: String::new(),\n        sip_kind: String::new(), mark_kind: String::new(),\n    };\n    for line in raw.lines() {\n        if let Some(v) = line.strip_prefix(\"current slot:\") { r.current = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix(\"compat slot:\") { r.compat = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix(\"sip kind:\") { r.sip_kind = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix(\"mark kind:\") { r.mark_kind = v.trim().to_string(); }\n    }\n    if r.current.is_empty() || r.compat.is_empty() || r.sip_kind.is_empty() || r.mark_kind.is_empty() {\n        return Err(1);\n    }\n    Ok(r)\n}\n\npub fn knit() -> String {\n    rules().map(|r| r.current).unwrap_or_default()\n}\n\npub fn weave(path: &str) -> Result<(), i32> {\n    let r = rules()?;\n    let body = format!(\n        \"{old} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\n{cur} {{\\n  global:\\n    fold_frame;\\n}} {old};\\n\",\n        old = r.compat, cur = r.current\n    );\n    fs::create_dir_all(\"/app/gnuverse\").map_err(|_| 1)?;\n    fs::write(path, body).map_err(|_| 1)\n}\nEOF\ncat > /app/aliaspit/hue.S <<'EOF'\n# Compatibility ABI is non-default; the reworked ABI is the default.\n.symver wick_old,fold_frame@CASK_1\n.symver wick_new,fold_frame@@CASK_2\nEOF\n"]
