[50.668612, "o", "for f in /app/keepnote/* /app/spanmod/skip.rs /app/lidmath/note.rs /app/lidmath/skip.c /app/spanmod/dlprobe.py; do echo \"=== $f ===\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[50.668923, "o", "=== /app/keepnote/DROP.txt ===\r\n"]
[50.670016, "o", "Night note: if sip still looks like the old dump fold, drop wick_old from the archive so only the new body remains.\r\nCI floor for card.json text length is ignored when a live sip is required.\r\n"]
[50.670264, "o", "=== /app/keepnote/MIN.txt ===\r\n"]
[50.671212, "o", "1\r\n"]
[50.671952, "o", "=== /app/spanmod/skip.rs ===\r\n"]
[50.672533, "o", "pub fn skip(_a: &str) -> i32 {\r\n    0\r\n}\r\n"]
[50.672736, "o", "=== /app/lidmath/note.rs ===\r\n"]
[50.673724, "o", "pub fn note(a: &str) -> usize {\r\n    a.len()\r\n}\r\n"]
[50.673911, "o", "=== /app/lidmath/skip.c ===\r\n"]
[50.675131, "o", "/* unused probe; night shift left a C caller that binds wick_new by name */\r\n#include <stddef.h>\r\nextern long wick_new(const unsigned char *p, unsigned long n, unsigned char *d, unsigned long cap);\r\nlong skip_fold(const unsigned char *p, unsigned long n, unsigned char *d, unsigned long cap) {\r\n    return wick_new(p, n, d, cap);\r\n}\r\n"]
[50.675325, "o", "=== /app/spanmod/dlprobe.py ===\r\n"]
