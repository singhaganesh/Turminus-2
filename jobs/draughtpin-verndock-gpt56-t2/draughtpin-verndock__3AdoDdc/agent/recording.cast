[7.562765, "o", "\u001b[?2004l\r"]
[7.563902, "o", "draughtpin layout\r\n=================\r\n\r\ncliurn/boot.rs dispatches sip and mark.\r\n\r\nMill directories:\r\n- narbay/\r\n- vatrib/\r\n- weft/\r\n- aliaspit/\r\n- stemcask/\r\n- gluebox/\r\n- cliurn/\r\n\r\nDumps live in /app/rawspan, including /app/rawspan/alpha.raw and /app/rawspan/beta.raw.\r\nsip writes /app/inkvat/card.json.\r\nShared object is /app/lib/libdraught.so.\r\nExported C name is fold_frame.\r\n\r\nRebuild with /app/stoke.sh after source edits.\r\n"]
[7.564063, "o", "\r\n--- RULES ---\r\n"]
[7.565032, "o", "current slot: CASK_2\r\ncompat slot: CASK_1\r\nexport: fold_frame\r\nsip kind: bare\r\nmark kind: named\r\n\r\nFold a dump:\r\n- ASCII letters to lowercase\r\n- TAB, LF, CR, and SPACE collapse to a single SPACE\r\n- other bytes below 0x20 are dropped\r\n- trailing ASCII slash characters are stripped\r\n\r\n- ASCII letters to lowercase\r\n- TAB, LF, CR, and SPACE collapse to a single SPACE\r\n- other bytes below 0x20 are dropped\r\n- trailing ASCII slash characters are stripped\r\n"]
[7.565241, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[7.691076, "i", "printf '\\n--- FILES ---\\n'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort\n"]
[7.691502, "o", "printf '\\n--- FILES ---\\n'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[7.691638, "o", "\r\n--- FILES ---\r\n"]
[7.694103, "o", "/app/abifolio/RULES.txt\r\n/app/abifolio/WALK.txt\r\n/app/aliaspit/hue.S\r\n/app/bin/draughtpin\r\n/app/bin/weave\r\n/app/cliurn/boot.rs\r\n/app/gluebox/glue.rs\r\n/app/gnuverse/cask.map\r\n/app/inkvat/SEAL\r\n/app/inkvat/card.json\r\n/app/keepnote/DROP.txt\r\n/app/keepnote/MIN.txt\r\n/app/lib/libdraught.so\r\n/app/lidmath/note.rs\r\n/app/lidmath/skip.c\r\n/app/narbay/loom.rs\r\n/app/quarryc/hold.toml\r\n/app/rawspan/alpha.raw\r\n/app/rawspan/beta.raw\r\n/app/spanmod/dlprobe.py\r\n/app/spanmod/skip.rs\r\n/app/stemcask/wick.rs\r\n"]
[7.694315, "o", "/app/stoke.sh\r\n/app/vatrib/qat.rs\r\n/app/weft/main.rs\r\n"]
[7.694501, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[8.183432, "i", "printf '\\n--- TYPES ---\\n'; file /app/bin/draughtpin /app/lib/libdraught.so; printf '\\n--- BUILD FILES ---\\n'; find /app -maxdepth 3 -type f \\( -name 'Makefile' -o -name 'CMakeLists.txt' -o -name '*.mk' \\) -print -exec sed -n '1,240p' {} \\;\n"]
[8.184438, "o", "printf '\\n--- TYPES ---\\n'; file /app/bin/draughtpin /app/lib/libdraught.so; printf '\\n--- BUILD FILES ---\\n'; find /app -maxdepth 3 -type f \\( -name 'Makefile' -o -name 'CMakeLists.txt' -o -name '*.mk' \\) -print -exec sed -n '1,240p' {} \\;\r\n\u001b[?2004l\r"]
