[19.314832, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[30.750437, "i", "echo '=== vatrib ==='; nl -ba /app/vatrib/qat.rs; echo '=== cliurn ==='; nl -ba /app/cliurn/boot.rs; echo '=== gluebox ==='; nl -ba /app/gluebox/glue.rs\n"]
[30.751074, "o", "echo '=== vatrib ==='; nl -ba /app/vatrib/qat.rs; echo '=== cliurn ==='; nl -ba /app/cliurn/boot.rs; echo '=== gluebox ==='; nl -ba /app/gluebox/glue.rs\r\n\u001b[?2004l\r"]
[30.751198, "o", "=== vatrib ===\r\n"]
[30.752569, "o", "     1\tuse std::fs;\r\n     2\tuse std::os::raw::{c_char, c_int, c_void};\r\n     3\t\r\n     4\tuse crate::loom;\r\n     5\t\r\n     6\tconst RTLD_NOW: c_int = 2;\r\n     7\t\r\n     8\textern \"C\" {\r\n     9\t    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\r\n    10\t    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\r\n"]
[30.752627, "o", "    11\t    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\r\n    12\t}\r\n    13\t\r\n    14\ttype FoldFn = unsafe extern \"C\" fn(*const u8, usize, *mut u8, usize) -> isize;\r\n    15\t\r\n    16\tfn rules_pair() -> (String, String) {\r\n    17\t    let mut cur = String::new();\r\n    18\t    let mut old = String::new();\r\n    19\t    if let Ok(s) = fs::read_to_string(\"/app/abifolio/RULES.txt\") {\r\n    20\t        for line in s.lines() {\r\n    21\t            if let Some(rest) = line.strip_prefix(\"current slot:\") {\r\n    22\t                cur = rest.trim().to_string();\r\n    23\t            }\r\n    24\t            if let Some(rest) = line.strip_prefix(\"compat slot:\") {\r\n    25\t                old = rest.trim().to_string();\r\n    26\t            }\r\n    27\t        }\r\n    28\t    }\r\n"]
[30.752648, "o", "    29\t    (cur, old)\r\n    30\t}\r\n    31\t\r\n    32\tfn folio_ok(slot: &str) -> bool {\r\n    33\t    let (a, b) = rules_pair();\r\n    34\t    slot == a || slot == b\r\n    35\t}\r\n    36\t\r\n    37\tfn load() -> *mut c_void {\r\n"]
[30.752666, "o", "    38\t    unsafe { dlopen(b\"/app/lib/libdraught.so\\0\".as_ptr() as *const c_char, RTLD_NOW) }\r\n    39\t}\r\n    40\t\r\n    41\tfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\r\n    42\t    if ptr.is_null() {\r\n"]
[30.752702, "o", "    43\t        return Err(1);\r\n    44\t    }\r\n    45\t    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\r\n    46\t    let mut buf = vec![0u8; blob.len() + 32];\r\n    47\t"]
[30.752728, "o", "    let n = unsafe { f(blob.as_ptr(), blob.len(), buf.as_mut_ptr(), buf.len()) };\r\n    48\t    if n < 0 {\r\n    49\t        return Err(1);\r\n    50\t    }\r\n    51\t    buf.truncate(n as usize);\r\n    52\t    Ok(buf)\r\n    53\t}\r\n    54\t\r\n"]
[30.752755, "o", "    55\tfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\r\n    56\t    fs::create_dir_all(\"/app/inkvat\").map_err(|_| 1)?;\r\n    57\t    let body = format!(\r\n    58\t        \"{{\\\"node\\\":\\\"{}\\\",\\\"text\\\":{},\\\"kind\\\":\\\"{}\\\"}}\\n\",\r\n    59\t        slot,\r\n    60\t        serde_like(text),\r\n    61\t        kind\r\n    62\t    );\r\n"]
[30.752772, "o", "    63\t    fs::write(\"/app/inkvat/card.json\", body).map_err(|_| 1)?;\r\n    64\t    Ok(())\r\n    65\t}\r\n    66\t\r\n    67\tfn serde_like(s: &str) -> String {\r\n"]
[30.752795, "o", "    68\t    let mut o = String::from(\"\\\"\");\r\n    69\t    for c in s.chars() {\r\n    70\t        match c {\r\n    71\t            '\"' => o.push_str(\"\\\\\\\"\"),\r\n    72\t            '\\\\' => o.push_str(\"\\\\\\\\\"),\r\n"]
[30.752813, "o", "    73\t            '\\n' => o.push_str(\"\\\\n\"),\r\n    74\t            '\\t' => o.push_str(\"\\\\t\"),\r\n    75\t"]
[30.752833, "o", "            c if (c as u32) < 0x20 => o.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n    76\t            _ => o.push(c),\r\n    77\t        }\r\n    78\t    }\r\n    79\t    o.push('\"');\r\n"]
[30.75285, "o", "    80\t    o\r\n    81\t}\r\n    82\t\r\n    83\tpub fn qat(a: &str, b: Option<&str>) -> i32 {\r\n"]
[30.752869, "o", "    84\t    let _ = fs::remove_file(\"/app/inkvat/SEAL\");\r\n    85\t    let blob = match fs::read(a) {\r\n    86\t        Ok(x) => x,\r\n    87\t        Err(_) => return 1,\r\n    88\t    };\r\n    89\t    if blob.is_empty() {\r\n    90\t        let _ = write_card(\"\", \"\", \"raw\");\r\n"]
[30.752885, "o", "    91\t        let _ = fs::write(\"/app/inkvat/SEAL\", \"ok\");\r\n"]
[30.752899, "o", "    92\t        return 0;\r\n    93\t    }\r\n    94\t    if let Some(n) = b {\r\n    95\t        if !folio_ok(n) {\r\n    96\t            let _ = write_card(n, \"\", \"raw\");\r\n    97\t            let _ = fs::write(\"/app/inkvat/SEAL\", \"ok\");\r\n    98\t            return 0;\r\n    99\t        }\r\n"]
[30.752912, "o", "   100\t    }\r\n   101\t    let h = load();\r\n   102\t    if h.is_null() {\r\n   103\t        return 1;\r\n"]
[30.752923, "o", "   104\t    }\r\n   105\t    let ptr = unsafe {\r\n   106\t        match b {\r\n"]
[30.752934, "o", "   107\t            None => dlsym(h, b\"fold_frame\\0\".as_ptr() as *const c_char),\r\n   108\t            Some(n) => {\r\n   109\t                let mut v = n.as_bytes().to_vec();\r\n"]
[30.75295, "o", "   110\t                v.push(0);\r\n   111\t                dlvsym(\r\n   112\t                    h,\r\n   113\t                    b\"fold_frame\\0\".as_ptr() as *const c_char,\r\n"]
[30.752963, "o", "   114\t                    v.as_ptr() as *const c_char,\r\n   115\t                )\r\n   116\t            }\r\n   117\t        }\r\n   118\t    };\r\n"]
[30.752985, "o", "   119\t    let out = match call(ptr, &blob) {\r\n   120\t        Ok(v) => v,\r\n   121\t        Err(c) => return c,\r\n   122\t    };\r\n"]
[30.752998, "o", "   123\t    let text = String::from_utf8_lossy(&out).into_owned();\r\n   124\t    let home = loom::knit();\r\n   125\t    let kind = if b.is_some() { \"raw\" } else { \"raw\" };\r\n   126\t"]
[30.753012, "o", "    if write_card(&home, &text, kind).is_err() {\r\n   127\t        return 1;\r\n   128\t    }\r\n   129\t    if fs::write(\"/app/inkvat/SEAL\", \"ok\").is_err() {\r\n   130\t        return 1;\r\n"]
[30.753022, "o", "   131\t    }\r\n   132\t    0\r\n   133\t}\r\n"]
[30.753683, "o", "=== cliurn ===\r\n"]
[30.754276, "o", "     1\t#[path = \"../narbay/loom.rs\"]\r\n     2\tmod loom;\r\n     3\t#[path = \"../vatrib/qat.rs\"]\r\n     4\tmod qat;\r\n     5\t#[path = \"../spanmod/skip.rs\"]\r\n     6\tmod skip;\r\n     7\t#[path = \"../lidmath/note.rs\"]\r\n     8\tmod note;\r\n     9\t\r\n    10\tfn main() {\r\n    11\t    let mut args = std::env::args();\r\n    12\t    let _ = args.next();\r\n"]
[30.754406, "o", "    13\t    let cmd = args.next().unwrap_or_default();\r\n    14\t    if cmd == \"sip\" {\r\n    15\t        let dump = args.next().unwrap_or_default();\r\n    16\t        let _ = skip::skip(&dump);\r\n    17\t        std::process::exit(qat::qat(&dump, None));\r\n    18\t    }\r\n    19\t    if cmd == \"mark\" {\r\n    20\t        let dump = args.next().unwrap_or_default();\r\n    21\t        let slot = args.next().unwrap_or_default();\r\n    22\t        let _ = note::note(&slot);\r\n    23\t        std::process::exit(qat::qat(&dump, Some(&slot)));\r\n    24\t    }\r\n    25\t    eprintln!(\"usage: draughtpin sip DUMP | draughtpin mark DUMP SLOT\");\r\n    26\t    std::process::exit(2);\r\n"]
[30.754438, "o", "    27\t}\r\n"]
[30.754575, "o", "=== gluebox ===\r\n"]
[30.755548, "o", "     1\t#![no_std]\r\n     2\t#![crate_type = \"staticlib\"]\r\n     3\t\r\n     4\t#[path = \"../stemcask/wick.rs\"]\r\n     5\tmod wick;\r\n     6\t\r\n     7\tcore::arch::global_asm!(include_str!(\"../aliaspit/hue.S\"));\r\n     8\t\r\n"]
[30.755654, "o", "     9\t#[no_mangle]\r\n    10\tpub extern \"C\" fn rust_eh_personality() {}\r\n    11\t\r\n    12\t#[panic_handler]\r\n    13\tfn panic(_: &core::panic::PanicInfo) -> ! {\r\n    14\t    loop {}\r\n    15\t}\r\n"]
[30.755874, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[31.045427, "i", "echo '=== weft ==='; nl -ba /app/weft/main.rs; echo '=== narbay ==='; nl -ba /app/narbay/loom.rs; echo '=== stemcask ==='; nl -ba /app/stemcask/wick.rs; echo '=== aliaspit ==='; nl -ba /app/aliaspit/hue.S\n"]
[31.046279, "o", "echo '=== weft ==='; nl -ba /app/weft/main.rs; echo '=== narbay ==='; nl -ba /app/narbay/loom.rs; echo '=== stemcask ==='; nl -ba /app/stemcask/wick.rs; echo '=== aliaspit ==='; nl -ba /app/aliaspit/hue.S\r\n\u001b[?2004l\r"]
[31.04645, "o", "=== weft ===\r\n"]
[31.047756, "o", "     1\t#[path = \"../narbay/loom.rs\"]\r\n     2\tmod loom;\r\n     3\t\r\n     4\tfn main() {\r\n     5\t    if loom::weave(\"/app/gnuverse/cask.map\").is_err() {\r\n     6\t        std::process::exit(1);\r\n     7\t    }\r\n     8\t}\r\n"]
[31.048457, "o", "=== narbay ===\r\n"]
[31.049325, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn knit() -> String {\r\n     4\t    let raw = match fs::read_to_string(\"/app/quarryc/hold.toml\") {\r\n     5\t        Ok(s) => s,\r\n     6\t        Err(_) => return \"CASK_1\".to_string(),\r\n     7\t    };\r\n     8\t    let mut first = None;\r\n"]
[31.049463, "o", "     9\t    let mut name = String::new();\r\n    10\t    for line in raw.lines() {\r\n    11\t        let t = line.trim();\r\n    12\t        if let Some(rest) = t.strip_prefix(\"name = \") {\r\n    13\t            name = rest.trim_matches('\"').to_string();\r\n    14\t        }\r\n    15\t        if t == \"home = 1\" && first.is_none() && !name.is_empty() {\r\n    16\t            first = Some(name.clone());\r\n    17\t        }\r\n    18\t    }\r\n    19\t    first.unwrap_or_else(|| \"CASK_1\".to_string())\r\n    20\t}\r\n    21\t\r\n    22\t#[allow(dead_code)]\r\n    23\tpub fn weave(path: &str) -> Result<(), i32> {\r\n    24\t    let home = knit();\r\n    25\t    let body = format!(\r\n    26\t        \"{h} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\nCASK_2 {{\\n  global:\\n    fold_frame;\\n}} {h};\\n\",\r\n    27\t        h = home\r\n    28\t    );\r\n    29\t    fs::create_dir_all(\"/app/gnuverse\").map_err(|_| 1)?;\r\n    30\t    fs::write(path, body).map_err(|_| 1)?;\r\n    31\t    Ok(())\r\n    32\t}\r\n"]
[31.049726, "o", "=== stemcask ===\r\n"]
[31.050787, "o", "     1\tuse core::slice;\r\n     2\t\r\n     3\tfn lower_only(s: &[u8], dst: &mut [u8]) -> usize {\r\n     4\t    let n = s.len().min(dst.len());\r\n     5\t    for i in 0..n {\r\n     6\t        dst[i] = s[i].to_ascii_lowercase();\r\n     7\t    }\r\n     8\t    n\r\n     9\t}\r\n"]
[31.050832, "o", "    10\t\r\n    11\tfn full_fold(s: &[u8], dst: &mut [u8]) -> usize {\r\n    12\t    let mut i = 0;\r\n    13\t    let mut space = false;\r\n    14\t    for &b in s {\r\n    15\t        if i >= dst.len() {\r\n    16\t            break;\r\n    17\t        }\r\n    18\t        if b == b'\\t' || b == b' ' || b == b'\\n' || b == b'\\r' {\r\n    19\t            if !space {\r\n    20\t                dst[i] = b' ';\r\n    21\t                i += 1;\r\n    22\t                space = true;\r\n    23\t            }\r\n    24\t            continue;\r\n"]
[31.050936, "o", "    25\t        }\r\n    26\t        if b < 0x20 {\r\n    27\t            continue;\r\n    28\t        }\r\n    29\t        space = false;\r\n    30\t        dst[i] = b.to_ascii_lowercase();\r\n    31\t        i += 1;"]
[31.050962, "o", "\r\n    32\t    }\r\n    33\t    while i > 0 && dst[i - 1] == b'/' {\r\n    34\t        i -= 1;\r\n    35\t    }\r\n    36\t    i\r\n    37\t}\r\n    38\t\r\n    39\t#[no_mangle]\r\n    40\tpub unsafe extern \"C\" fn wick_old(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    41\t    if p.is_null() || dst.is_null() || cap == 0 {\r\n    42\t        return -1;\r\n    43\t    }\r\n    44\t    let s = slice::from_raw_parts(p, n);\r\n    45\t    let d = slice::from_raw_parts_mut(dst, cap);\r\n    46\t    lower_only(s, d) as isize\r\n    47\t}\r\n    48\t\r\n    49\t#[no_mangle]\r\n    50\tpub unsafe extern \"C\" fn wick_new(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    51\t    if p.is_null() || dst.is_null() || cap == 0 {\r\n    52\t        return -1;\r\n    53\t    }\r\n    54\t    let s = slice::from_raw_parts(p, n);\r\n    55\t    let d = slice::from_raw_parts_mut(dst, cap);\r\n    56\t    full_fold(s, d) as isize\r\n    57\t}\r\n"]
[31.051456, "o", "=== aliaspit ===\r\n"]
[31.052319, "o", "     1\t# hue\r\n     2\t.equ hue, 0\r\n     3\t.symver wick_old,fold_frame@@CASK_1\r\n     4\t.symver wick_new,fold_frame@CASK_2\r\n"]
