[92.476036, "o", "pub fn knit() -> String {\r\n\u001b[?2004l\r\u001b[?2004h>     rules().map(|r| r.current).unwrap_or_default()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn weave(path: &str) -> Result<(), i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let r = rules()?;\r\n\u001b[?2004l\r\u001b[?2004h>     let body = format!(\r\n\u001b[?2004l\r\u001b[?2004h>         \"{old} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\n{cur} {{\\n  global:\\n    fold_frame;\\n}} {old};\\n\",\r\n\u001b[?2004l\r\u001b[?2004h>         old = r.compat, cur = r.current\r\n\u001b[?2004l\r\u001b[?2004h>     );\r\n\u001b[?2004l\r\u001b[?2004h>     fs::create_dir_all(\"/app/gnuverse\").map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     fs::write(path, body).map_err(|_| 1)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[92.476763, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[92.476879, "o", "cat > /app/aliaspit/hue.S <<'EOF'\r\n\u001b[?2004l\r"]
[92.476982, "o", "\u001b[?2004h> "]
[92.477082, "o", "# Compatibility ABI is non-default; the reworked ABI is the default.\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.477176, "o", "> .symver wick_old,fold_frame@CASK_1\r\n"]
[92.477263, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[92.477351, "o", ".symver wick_new,fold_frame@@CASK_2\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[92.478521, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[92.625374, "i", "cat > /app/vatrib/qat.rs <<'EOF'\nuse std::fs;\nuse std::os::raw::{c_char, c_int, c_void};\nuse crate::loom;\n\nconst RTLD_NOW: c_int = 2;\nextern \"C\" {\n    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\n    fn dlclose(handle: *mut c_void) -> c_int;\n    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\n    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\n}\ntype FoldFn = unsafe extern \"C\" fn(*const u8, usize, *mut u8, usize) -> isize;\n\nfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\n    if ptr.is_null() { return Err(1); }\n    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\n    let mut buf = vec![0u8; blob.len() + 1];\n    let n = unsafe { f(blob.as_ptr(), blob.len(), buf.as_mut_ptr(), buf.len()) };\n    if n < 0 || n as usize > buf.len() { return Err(1); }\n    buf.truncate(n as usize);\n    Ok(buf)\n}\n\nfn json_string(s: &str) -> String {\n    let mut o = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\"' => o.push_str(\"\\\\\\\"\"), '\\\\' => o.push_str(\"\\\\\\\\\"),\n            '\\n' => o.push_str(\"\\\\n\"), '\\r' => o.push_str(\"\\\\r\"), '\\t' => o.push_str(\"\\\\t\"),\n            c if (c as u32) < 0x20 => o.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            _ => o.push(c),\n        }\n    }\n    o.push('\"'); o\n}\n\nfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\n    fs::create_dir_all(\"/app/inkvat\").map_err(|_| 1)?;\n    let body = format!(\"{{\\\"slot\\\":{},\\\"text\\\":{},\\\"kind\\\":{}}}\\n\",\n                       json_string(slot), json_string(text), json_string(kind));\n    fs::write(\"/app/inkvat/card.json\", body).map_err(|_| 1)\n}\n\npub fn qat(path: &str, requested: Option<&str>) -> i32 {\n    let _ = fs::remove_file(\"/app/inkvat/SEAL\");\n    let rules = match loom::rules() { Ok(r) => r, Err(c) => return c };\n    let (slot, kind) = match requested {\n        Some(s) if s == rules.current || s == rules.compat => (s, rules.mark_kind.as_str()),\n        Some(_) => return 1,\n        None => (rules.current.as_str(), rules.sip_kind.as_str()),\n    };\n    let blob = match fs::read(path) { Ok(v) if !v.is_empty() => v, _ => return 1 };\n    let handle = unsafe { dlopen(b\"/app/lib/libdraught.so\\0\".as_ptr() as *const c_char, RTLD_NOW) };\n    if handle.is_null() { return 1; }\n    let ptr = unsafe {\n        match requested {\n            None => dlsym(handle, b\"fold_frame\\0\".as_ptr() as *const c_char),\n            Some(_) => {\n                let mut version = slot.as_bytes().to_vec(); version.push(0);\n                dlvsym(handle, b\"fold_frame\\0\".as_ptr() as *const c_char,\n                       version.as_ptr() as *const c_char)\n            }\n        }\n    };\n    let out = call(ptr, &blob);\n    unsafe { dlclose(handle); }\n    let out = match out { Ok(v) => v, Err(c) => return c };\n    let text = String::from_utf8_lossy(&out).into_owned();\n    if write_card(slot, &text, kind).is_err() { return 1; }\n    if fs::write(\"/app/inkvat/SEAL\", \"ok\").is_err() { return 1; }\n    0\n}\nEOF\n"]
