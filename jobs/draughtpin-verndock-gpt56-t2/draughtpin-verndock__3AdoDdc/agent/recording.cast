[39.528641, "i", "nl -ba /app/cliurn/boot.rs; echo '--- glue ---'; nl -ba /app/gluebox/glue.rs\n"]
[39.529092, "o", "nl -ba /app/cliurn/boot.rs; echo '--- glue ---'; nl -ba /app/gluebox/glue.rs\r\n\u001b[?2004l\r"]
[39.530466, "o", "     1\t#[path = \"../narbay/loom.rs\"]\r\n     2\tmod loom;\r\n     3\t#[path = \"../vatrib/qat.rs\"]\r\n     4\tmod qat;\r\n     5\t#[path = \"../spanmod/skip.rs\"]\r\n     6\tmod skip;\r\n     7\t#[path = \"../lidmath/note.rs\"]\r\n     8\tmod note;\r\n     9\t\r\n    10\tfn main() {\r\n    11\t    let mut args = std::env::args();\r\n    12\t    let _ = args.next();\r\n    13\t    let cmd = args.next().unwrap_or_default();\r\n    14\t    if cmd == \"sip\" {\r\n    15\t        let dump = args.next().unwrap_or_default();\r\n    16\t        let _ = skip::skip(&dump);\r\n    17\t        std::process::exit(qat::qat(&dump, None));\r\n    18\t    }\r\n    19\t    if cmd == \"mark\" {\r\n    20\t        let dump = args.next().unwrap_or_default();\r\n    21\t        let slot = args.next().unwrap_or_default();\r\n    22\t        let _ = note::note(&slot);\r\n    23\t        std::process::exit(qat::qat(&dump, Some(&slot)));\r\n    24\t    }\r\n    25\t    eprintln!(\"usage: draughtpin sip DUMP | draughtpin mark DUMP SLOT\");\r\n    26\t    std::process::exit(2);\r\n    27\t}\r\n"]
[39.530619, "o", "--- glue ---\r\n"]
[39.531591, "o", "     1\t#![no_std]\r\n     2\t#![crate_type = \"staticlib\"]\r\n     3\t\r\n     4\t#[path = \"../stemcask/wick.rs\"]\r\n     5\tmod wick;\r\n     6\t\r\n     7\tcore::arch::global_asm!(include_str!(\"../aliaspit/hue.S\"));\r\n     8\t\r\n     9\t#[no_mangle]\r\n    10\tpub extern \"C\" fn rust_eh_personality() {}\r\n    11\t\r\n    12\t#[panic_handler]\r\n    13\tfn panic(_: &core::panic::PanicInfo) -> ! {\r\n"]
[39.53171, "o", "    14\t    loop {}\r\n    15\t}\r\n"]
[39.531861, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[39.717507, "i", "nl -ba /app/weft/main.rs; echo '--- wick ---'; nl -ba /app/stemcask/wick.rs\n"]
[39.717872, "o", "nl -ba /app/weft/main.rs; echo '--- wick ---'; nl -ba /app/stemcask/wick.rs\r\n\u001b[?2004l\r"]
[39.719045, "o", "     1\t#[path = \"../narbay/loom.rs\"]\r\n     2\tmod loom;\r\n     3\t\r\n     4\tfn main() {\r\n     5\t    if loom::weave(\"/app/gnuverse/cask.map\").is_err() {\r\n     6\t        std::process::exit(1);\r\n     7\t    }\r\n     8\t}\r\n"]
[39.719356, "o", "--- wick ---\r\n"]
[39.722456, "o", "     1\tuse core::slice;\r\n     2\t\r\n     3\tfn lower_only(s: &[u8], dst: &mut [u8]) -> usize {\r\n     4\t    let n = s.len().min(dst.len());\r\n     5\t    for i in 0..n {\r\n     6\t        dst[i] = s[i].to_ascii_lowercase();\r\n     7\t    }\r\n     8\t    n\r\n     9\t}\r\n"]
[39.722772, "o", "    10\t\r\n    11\tfn full_fold(s: &[u8], dst: &mut [u8]) -> usize {\r\n    12\t    let mut i = 0;\r\n    13\t    let mut space = false;\r\n    14\t    for &b in s {\r\n    15\t        if i >= dst.len() {\r\n    16\t            break;\r\n    17\t        }\r\n    18\t        if b == b'\\t' || b == b' ' || b == b'\\n' || b == b'\\r' {\r\n    19\t            if !space {\r\n    20\t                dst[i] = b' ';\r\n    21\t                i += 1;\r\n    22\t                space = true;\r\n    23\t            }\r\n    24\t            continue;\r\n    25\t        }\r\n"]
[39.723063, "o", "    26\t        if b < 0x20 {\r\n    27\t            continue;\r\n    28\t        }\r\n    29\t        space = false;\r\n    30\t        dst[i] = b.to_ascii_lowercase();\r\n    31\t        i += 1;\r\n    32\t    }\r\n    33\t    while i > 0 && dst[i - 1] == b'/' {\r\n    34\t        i -= 1;\r\n    35\t    }\r\n    36\t    i\r\n    37\t}\r\n    38\t\r\n    39\t#[no_mangle]\r\n"]
[39.723293, "o", "    40\tpub unsafe extern \"C\" fn wick_old(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    41\t    if p.is_null() || dst.is_null() || cap == 0 {\r\n    42\t        return -1;\r\n    43\t    }\r\n    44\t    let s = slice::from_raw_parts(p, n);\r\n    45\t    let d = slice::from_raw_parts_mut(dst, cap);\r\n    46\t    lower_only(s, d) as isize\r\n    47\t}\r\n    48\t\r\n    49\t#[no_mangle]\r\n    50\tpub unsafe extern \"C\" fn wick_new(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    51\t    if p.is_null() || dst.is_null() || cap == 0 {\r\n    52\t        return -1;\r\n    53\t    }\r\n    54\t    let s = slice::from_raw_parts(p, n);\r\n    55\t    let d = slice::from_raw_parts_mut(dst, cap);\r\n    56\t    full_fold(s, d) as isize\r\n    57\t}\r\n"]
[39.72471, "o", "\u001b[?2004hroot@fcabd28f92e6:/app# "]
[39.9153, "i", "nl -ba /app/aliaspit/hue.S; echo '--- map ---'; cat /app/gnuverse/cask.map; echo '--- config ---'; cat /app/quarryc/hold.toml\n"]
[39.91585, "o", "nl -ba /app/aliaspit/hue.S; echo '--- map ---'; cat /app/gnuverse/cask.map; echo '--- config ---'; cat /app/quarryc/hold.toml\r\n\u001b[?2004l\r"]
[39.917075, "o", "     1\t# hue\r\n     2\t.equ hue, 0\r\n     3\t.symver wick_old,fold_frame@@CASK_1\r\n     4\t.symver wick_new,fold_frame@CASK_2\r\n"]
[39.917266, "o", "--- map ---\r\n"]
[39.918172, "o", "CASK_1 {\r\n  global:\r\n    fold_frame;\r\n  local:\r\n    *;\r\n};\r\nCASK_2 {\r\n  global:\r\n    fold_frame;\r\n} CASK_1;\r\n"]
[39.918389, "o", "--- config ---\r\n"]
[39.919462, "o", "[[nodes]]\r\nname = \"CASK_1\"\r\nhome = 1\r\n\r\n[[nodes]]\r\nname = \"CASK_2\"\r\nhome = 1\r\n"]
