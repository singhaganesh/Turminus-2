Sending keys: ['cat > /app/narbay/loom.rs <<\'EOF\'\nuse std::fs;\n\n#[derive(Clone)]\npub struct Rules {\n    pub current: String,\n    pub compat: String,\n    pub sip_kind: String,\n    pub mark_kind: String,\n}\n\npub fn rules() -> Result<Rules, i32> {\n    let raw = fs::read_to_string("/app/abifolio/RULES.txt").map_err(|_| 1)?;\n    let mut r = Rules {\n        current: String::new(), compat: String::new(),\n        sip_kind: String::new(), mark_kind: String::new(),\n    };\n    for line in raw.lines() {\n        if let Some(v) = line.strip_prefix("current slot:") { r.current = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix("compat slot:") { r.compat = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix("sip kind:") { r.sip_kind = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix("mark kind:") { r.mark_kind = v.trim().to_string(); }\n    }\n    if r.current.is_empty() || r.compat.is_empty() || r.sip_kind.is_empty() || r.mark_kind.is_empty() {\n        return Err(1);\n    }\n    Ok(r)\n}\n\npub fn knit() -> String {\n    rules().map(|r| r.current).unwrap_or_default()\n}\n\npub fn weave(path: &str) -> Result<(), i32> {\n    let r = rules()?;\n    let body = format!(\n        "{old} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\n{cur} {{\\n  global:\\n    fold_frame;\\n}} {old};\\n",\n        old = r.compat, cur = r.current\n    );\n    fs::create_dir_all("/app/gnuverse").map_err(|_| 1)?;\n    fs::write(path, body).map_err(|_| 1)\n}\nEOF\ncat > /app/aliaspit/hue.S <<\'EOF\'\n# Compatibility ABI is non-default; the reworked ABI is the default.\n.symver wick_old,fold_frame@CASK_1\n.symver wick_new,fold_frame@@CASK_2\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
Sending keys: ['cat > /app/vatrib/qat.rs <<\'EOF\'\nuse std::fs;\nuse std::os::raw::{c_char, c_int, c_void};\nuse crate::loom;\n\nconst RTLD_NOW: c_int = 2;\nextern "C" {\n    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\n    fn dlclose(handle: *mut c_void) -> c_int;\n    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\n    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\n}\ntype FoldFn = unsafe extern "C" fn(*const u8, usize, *mut u8, usize) -> isize;\n\nfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\n    if ptr.is_null() { return Err(1); }\n    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\n    let mut buf = vec![0u8; blob.len() + 1];\n    let n = unsafe { f(blob.as_ptr(), blob.len(), buf.as_mut_ptr(), buf.len()) };\n    if n < 0 || n as usize > buf.len() { return Err(1); }\n    buf.truncate(n as usize);\n    Ok(buf)\n}\n\nfn json_string(s: &str) -> String {\n    let mut o = String::from("\\"");\n    for c in s.chars() {\n        match c {\n            \'"\' => o.push_str("\\\\\\""), \'\\\\\' => o.push_str("\\\\\\\\"),\n            \'\\n\' => o.push_str("\\\\n"), \'\\r\' => o.push_str("\\\\r"), \'\\t\' => o.push_str("\\\\t"),\n            c if (c as u32) < 0x20 => o.push_str(&format!("\\\\u{:04x}", c as u32)),\n            _ => o.push(c),\n        }\n    }\n    o.push(\'"\'); o\n}\n\nfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\n    fs::create_dir_all("/app/inkvat").map_err(|_| 1)?;\n    let body = format!("{{\\"slot\\":{},\\"text\\":{},\\"kind\\":{}}}\\n",\n                       json_string(slot), json_string(text), json_string(kind));\n    fs::write("/app/inkvat/card.json", body).map_err(|_| 1)\n}\n\npub fn qat(path: &str, requested: Option<&str>) -> i32 {\n    let _ = fs::remove_file("/app/inkvat/SEAL");\n    let rules = match loom::rules() { Ok(r) => r, Err(c) => return c };\n    let (slot, kind) = match requested {\n        Some(s) if s == rules.current || s == rules.compat => (s, rules.mark_kind.as_str()),\n        Some(_) => return 1,\n        None => (rules.current.as_str(), rules.sip_kind.as_str()),\n    };\n    let blob = match fs::read(path) { Ok(v) if !v.is_empty() => v, _ => return 1 };\n    let handle = unsafe { dlopen(b"/app/lib/libdraught.so\\0".as_ptr() as *const c_char, RTLD_NOW) };\n    if handle.is_null() { return 1; }\n    let ptr = unsafe {\n        match requested {\n            None => dlsym(handle, b"fold_frame\\0".as_ptr() as *const c_char),\n            Some(_) => {\n                let mut version = slot.as_bytes().to_vec(); version.push(0);\n                dlvsym(handle, b"fold_frame\\0".as_ptr() as *const c_char,\n                       version.as_ptr() as *const c_char)\n            }\n        }\n    };\n    let out = call(ptr, &blob);\n    unsafe { dlclose(handle); }\n    let out = match out { Ok(v) => v, Err(c) => return c };\n    let text = String::from_utf8_lossy(&out).into_owned();\n    if write_card(slot, &text, kind).is_err() { return 1; }\n    if fs::write("/app/inkvat/SEAL", "ok").is_err() { return 1; }\n    0\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
Sending keys: ['cat > /app/cliurn/boot.rs <<\'EOF\'\n#[path = "../narbay/loom.rs"] mod loom;\n#[path = "../vatrib/qat.rs"] mod qat;\n\nfn main() {\n    let mut args = std::env::args().skip(1);\n    match args.next().as_deref() {\n        Some("sip") => {\n            let dump = args.next().unwrap_or_else(|| "/app/rawspan/alpha.raw".to_string());\n            if args.next().is_some() { std::process::exit(2); }\n            std::process::exit(qat::qat(&dump, None));\n        }\n        Some("mark") => {\n            let r = match loom::rules() { Ok(v) => v, Err(c) => std::process::exit(c) };\n            let first = args.next();\n            let second = args.next();\n            if args.next().is_some() { std::process::exit(2); }\n            let (dump, slot) = match (first, second) {\n                (None, None) => ("/app/rawspan/beta.raw".to_string(), r.current),\n                (Some(a), None) if a == r.current || a == r.compat =>\n                    ("/app/rawspan/beta.raw".to_string(), a),\n                (Some(a), None) => (a, r.current),\n                (Some(a), Some(b)) => (a, b),\n                (None, Some(_)) => unreachable!(),\n            };\n            std::process::exit(qat::qat(&dump, Some(&slot)));\n        }\n        _ => {\n            eprintln!("usage: draughtpin sip [DUMP] | draughtpin mark [DUMP] [SLOT]");\n            std::process::exit(2);\n        }\n    }\n}\nEOF\n/app/stoke.sh\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
