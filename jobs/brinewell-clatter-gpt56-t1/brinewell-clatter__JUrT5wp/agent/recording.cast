[114.711467, "o", "\u001b[?2004hroot@fd123dfe8404:/app# cat > /app/deskbin/sum.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> use std::process::Command;\r\n\u001b[?2004l\r\u001b[?2004h> pub fn hex_file(path: &str) -> String {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.711544, "o", "    let out = match Command::new(\"sha256sum\").arg(\"--\").arg(path).output() { Ok(x) if x.status.success() => x, _ => return String::new() };\r\n\u001b[?2004l\r\u001b[?2004h>     String::from_utf8(out.stdout).ok().and_then(|s| s.split_whitespace().next().map(str::to_string)).unwrap_or_default()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
