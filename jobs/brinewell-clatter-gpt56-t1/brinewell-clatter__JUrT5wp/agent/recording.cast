[114.100452, "o", "\u001b[?2004hroot@fd123dfe8404:/app# "]
[114.650657, "i", "cat > /app/deskbin/emit.rs <<'RS'\nuse std::collections::HashSet;\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\nfn fail(c: i32) -> i32 { let _ = fs::remove_file(\"/app/kegbay/MARK\"); c }\nfn read_pairs() -> Result<Vec<(String,u64)>,i32> {\n    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").map_err(|_| 1)?;\n    let mut v = Vec::new();\n    for line in raw.lines() {\n        let mut p = line.split('\\t');\n        let n = p.next().ok_or(1)?;\n        let k = p.next().ok_or(1)?.parse().map_err(|_| 1)?;\n        v.push((n.to_string(), k));\n    }\n    if v.is_empty() { Err(1) } else { Ok(v) }\n}\n\npub fn finish() -> i32 {\n    let pairs = match read_pairs() { Ok(x) => x, Err(c) => return fail(c) };\n    let names = match crate::fold::rib_c(&pairs, None) { Ok(x) => x, Err(c) => return fail(c) };\n    let mut body = String::new();\n    for (i,n) in names.iter().enumerate() {\n        let m = crate::parse::load(n);\n        body.push_str(&format!(\"{}\\t{}\\t{}\\n\", i+1, n, crate::parse::guid_hex(&m.guid)));\n    }\n    if fs::create_dir_all(\"/app/kegbay\").is_err() || fs::write(\"/app/kegbay/ribbon.txt\", body).is_err() { return fail(1); }\n    0\n}\n\nfn well_files(root: &Path) -> Result<HashSet<PathBuf>,i32> {\n    let mut s = HashSet::new();\n    for ent in fs::read_dir(root).map_err(|_| 1)? {\n        let p = ent.map_err(|_| 1)?.path();\n        if p.is_file() && p.extension().and_then(|x| x.to_str()) == Some(\"clat\") { s.insert(p); }\n    }\n    if s.is_empty() { Err(1) } else { Ok(s) }\n}\n\npub fn pour() -> i32 {\n    let root = std::env::args().nth(2).unwrap_or_else(|| \"/app/dropwell\".into());\n    let canonical = match fs::canonicalize(&root) { Ok(x) => x, Err(_) => return fail(1) };\n    if canonical != Path::new(\"/app/dropwell\") { return fail(1); }\n    let current = match well_files(&canonical) { Ok(x) => x, Err(c) => return fail(c) };\n    let ribbon = match fs::read_to_string(\"/app/kegbay/ribbon.txt\") { Ok(x) => x, Err(_) => return fail(1) };\n    let mut rows = Vec::new();\n    let mut seen = HashSet::new();\n    for line in ribbon.lines() {\n        let p: Vec<&str> = line.split('\\t').collect();\n        if p.len() != 3 { return fail(1); }\n        let seq: usize = match p[0].parse() { Ok(x) => x, Err(_) => return fail(1) };\n        let path = PathBuf::from(p[1]);\n        if !current.contains(&path) || !seen.insert(path.clone()) { return fail(1); }\n        let name = match path.file_name().and_then(|x| x.to_str()) { Some(x) => x.to_string(), None => return fail(1) };\n        let digest = crate::sum::hex_file(p[1]);\n        if digest.len() != 64 { return fail(1); }\n        rows.push((seq,name,digest,p[2].to_string()));\n    }\n    if rows.len() != current.len() || rows.iter().enumerate().any(|(i,r)| r.0 != i+1) { return fail(1); }\n    let mut json = format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\", (rows.len()+2)/3);\n    for (i,(seq,name,digest,guid)) in rows.iter().enumerate() {\n        if i != 0 { json.push(','); }\n        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",seq,name,digest,guid));\n    }\n    json.push_str(\"]}\\n\");\n    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\n    for (seq,name,digest,guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\",seq,name,digest,guid)); }\n    if fs::write(\"/app/kegbay/upload.json\",json).is_err() || fs::write(\"/app/kegbay/batch.tsv\",tsv).is_err() || fs::write(\"/app/kegbay/MARK\",\"ok\").is_err() { return fail(1); }\n    0\n}\nRS\ncat > /app/deskbin/sum.rs <<'RS'\nuse std::process::Command;\npub fn hex_file(path: &str) -> String {\n    let out = match Command::new(\"sha256sum\").arg(\"--\").arg(path).output() { Ok(x) if x.status.success() => x, _ => return String::new() };\n    String::from_utf8(out.stdout).ok().and_then(|s| s.split_whitespace().next().map(str::to_string)).unwrap_or_default()\n}\nRS\ncat > /app/deskbin/main.rs <<'RS'\n#[path=\"parse.rs\"] mod parse;\n#[path=\"sum.rs\"] mod sum;\n#[path=\"../walk.rs\"] mod walk;\n#[path=\"../stamp.rs\"] mod stamp;\n#[path=\"../fold.rs\"] mod fold;\n#[path=\"pipe.rs\"] mod pipe;\n#[path=\"emit.rs\"] mod emit;\nfn main() {\n    let _ = std::fs::remove_file(\"/ap"]
[114.650748, "i", "p/kegbay/MARK\");\n    let code = match std::env::args().nth(1).unwrap_or_default().as_str() {\n        \"tallow\" => { let c=pipe::fill(); if c!=0 {c} else {emit::finish()} },\n        \"pour\" => emit::pour(),\n        _ => { eprintln!(\"usage: clatter tallow|pour\"); 2 }\n    };\n    std::process::exit(code);\n}\nRS\nPATH=/usr/local/rustup/toolchains/1.85.1-x86_64-unknown-linux-gnu/bin:$PATH /app/fat.sh\n/app/bin/clatter tallow && /app/bin/clatter pour\n"]
