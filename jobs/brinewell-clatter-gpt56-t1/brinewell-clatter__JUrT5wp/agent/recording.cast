[114.719738, "o", "\u001b[?2004h"]
[114.719847, "o", ">     let code = match std::env::args().nth(1).unwrap_or_default().as_str() {"]
[114.720267, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.722515, "o", ">         \"tallow\" => { let c=pipe::fill(); if c!=0 {c} else {emit::finish()} },\r\n\u001b[?2004l\r\u001b[?2004h>         \"pour\" => emit::pour(),\r\n\u001b[?2004l\r\u001b[?2004h>         _ => { eprintln!(\"usage: clatter tallow|pour\"); 2 }\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     std::process::exit(code);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
