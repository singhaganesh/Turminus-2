[22.609781, "o", "ELF Header:\r\n  Magic:   7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00 \r\n  Class:                             ELF64\r\n  Data:                              2's complement, little endian\r\n  Version:                           1 (current)\r\n  OS/ABI:                            UNIX - System V\r\n  ABI Version:                       0\r\n  Type:                              DYN (Position-Independent Executable file)\r\n  Machine:                           Advanced Micro Devices X86-64\r\n  Version:                           0x1\r\n  Entry point address:               0xa220\r\n  Start of program headers:          64 (bytes into file)\r\n  Start of section headers:          4119200 (bytes into file)\r\n  Flags:                             0x0\r\n  Size of this header:               64 (bytes)\r\n  Size of program headers:           56 (bytes)\r\n  Number of program headers:         14\r\n  Size of section headers:           64 (bytes)\r\n  Number of section headers:         40\r\n  Section header string table index: 39\r\n\u001b[?2004hroot@fd123dfe8404:/app# "]
[23.317932, "i", "python3 - <<'PY'\nimport struct,glob,os\nfor p in sorted(glob.glob('/app/dropwell/*')):\n b=open(p,'rb').read(); magic,ver,stamp,n=struct.unpack_from('<4sHIH',b)\n streams=[]\n for i in range(n):\n  typ,rva,size=struct.unpack_from('<III',b,12+12*i)\n  x=b[rva:rva+size]\n  if typ==3:\n   lo,hi,code=struct.unpack_from('<III',x); streams.append(('exc',((hi<<32)|lo)/10_000_000-11644473600,hex(code)))\n  elif typ==15: streams.append(('misc',x[:16].hex(),x[16] if len(x)>16 else None))\n print(os.path.basename(p),'ver',ver,'stamp',stamp,'n',n,streams)\nPY\n"]
[23.321257, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import struct,glob,os\r\n\u001b[?2004l\r\u001b[?2004h> for p in sorted(glob.glob('/app/dropwell/*')):\r\n\u001b[?2004l\r\u001b[?2004h>  b=open(p,'rb').read(); magic,ver,stamp,n=struct.unpack_from('<4sHIH',b)\r\n\u001b[?2004l\r\u001b[?2004h>  streams=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h>   typ,rva,size=struct.unpack_from('<III',b,12+12*i)\r\n\u001b[?2004l\r\u001b[?2004h>   x=b[rva:rva+size]\r\n\u001b[?2004l\r\u001b[?2004h>   if typ==3:\r\n\u001b[?2004l\r\u001b[?2004h>    lo,hi,code=struct.unpack_from('<III',x); streams.append(('exc',((hi<<32)|lo)/10_000_000-11644473600,hex(code)))\r\n\u001b[?2004l\r\u001b[?2004h>   elif typ==15: streams.append(('misc',x[:16].hex(),x[16] if len(x)>16 else None))\r\n\u001b[?2004l\r\u001b[?2004h>  print(os.path.basename(p),'ver',ver,'stamp',stamp,'n',n,streams)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
