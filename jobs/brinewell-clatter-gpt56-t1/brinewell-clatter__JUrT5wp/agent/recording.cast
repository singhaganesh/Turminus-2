[114.072531, "i", "cat > /app/deskbin/parse.rs <<'RS'\nuse std::fs;\n\n#[derive(Clone)]\npub struct Meta {\n    pub valid: bool,\n    pub write_stamp: u32,\n    pub crash: Option<(u32, u32)>,\n    pub guid: [u8; 16],\n    pub companion: u8,\n}\n\npub fn load(path: &str) -> Meta {\n    let bad = || Meta { valid: false, write_stamp: 0, crash: None, guid: [0;16], companion: 0 };\n    let b = match fs::read(path) { Ok(x) => x, Err(_) => return bad() };\n    if b.len() < 12 || &b[0..4] != b\"CLAT\" { return bad(); }\n    let write_stamp = u32::from_le_bytes(b[6..10].try_into().unwrap());\n    let n = u16::from_le_bytes(b[10..12].try_into().unwrap()) as usize;\n    if 12usize.checked_add(n.saturating_mul(12)).map_or(true, |x| x > b.len()) { return bad(); }\n    let mut crash = None;\n    let mut guid = [0u8;16];\n    let mut companion = 0;\n    let mut have_misc = false;\n    for i in 0..n {\n        let off = 12 + i * 12;\n        let st = u32::from_le_bytes(b[off..off+4].try_into().unwrap());\n        let rva = u32::from_le_bytes(b[off+4..off+8].try_into().unwrap()) as usize;\n        let sz = u32::from_le_bytes(b[off+8..off+12].try_into().unwrap()) as usize;\n        let end = match rva.checked_add(sz) { Some(x) if x <= b.len() => x, _ => return bad() };\n        let sl = &b[rva..end];\n        if st == 3 && sl.len() >= 8 {\n            crash = Some((u32::from_le_bytes(sl[0..4].try_into().unwrap()), u32::from_le_bytes(sl[4..8].try_into().unwrap())));\n        } else if st == 15 && sl.len() >= 17 {\n            guid.copy_from_slice(&sl[..16]);\n            companion = sl[16];\n            have_misc = true;\n        }\n    }\n    Meta { valid: have_misc, write_stamp, crash, guid, companion }\n}\n\npub fn guid_hex(g: &[u8;16]) -> String {\n    const H: &[u8;16] = b\"0123456789abcdef\";\n    let mut s = String::with_capacity(32);\n    for &x in g { s.push(H[(x >> 4) as usize] as char); s.push(H[(x & 15) as usize] as char); }\n    s\n}\nRS\ncat > /app/walk.rs <<'RS'\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let mut out = Vec::new();\n    let rd = fs::read_dir(\"/app/dropwell\").map_err(|_| 1)?;\n    for ent in rd {\n        let p = ent.map_err(|_| 1)?.path();\n        if !p.is_file() || p.extension().and_then(|x| x.to_str()) != Some(\"clat\") { continue; }\n        let s = p.to_string_lossy().into_owned();\n        if !crate::parse::load(&s).valid { return Err(1); }\n        out.push(s);\n    }\n    out.sort();\n    if out.is_empty() { Err(1) } else { Ok(out) }\n}\nRS\ncat > /app/stamp.rs <<'RS'\npub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\n    names.iter().map(|n| {\n        let m = crate::parse::load(n);\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => (m.write_stamp as u64 + 11_644_473_600u64) * 10_000_000u64,\n        };\n        (n.clone(), key)\n    }).collect()\n}\nRS\ncat > /app/fold.rs <<'RS'\nuse std::collections::HashMap;\nuse std::fs;\nuse std::path::Path;\n\n#[derive(Clone)]\nstruct Row { name: String, key: u64, companion: u8, rank: Option<usize> }\nstruct Group { rows: Vec<Row>, key: u64, rank: Option<usize>, tie: String }\n\nfn prior() -> HashMap<String, usize> {\n    let mut out = HashMap::new();\n    let raw = fs::read_to_string(\"/app/tidearc/lastgood.rec\")\n        .or_else(|_| fs::read_to_string(\"/app/kegbay/hide.rec\")).unwrap_or_default();\n    for line in raw.lines() {\n        let p: Vec<&str> = line.split('\\t').collect();\n        if p.len() >= 2 {\n            if let Ok(n) = p[0].parse::<usize>() { out.insert(p[1].to_string(), n); }\n        }\n    }\n    out\n}\n\npub fn rib_c(pairs: &[(String, u64)], _root: Option<&str>) -> Result<Vec<String>, i32> {\n    if pairs.is_empty() { return Err(1); }\n    let old = prior();\n    let mut map: HashMap<[u8;16], Vec<Row>> = HashMap::new();\n    for (name, key) in pairs {\n        let m = crate::parse::load(name);\n        if !m.valid { return Err(1); }\n        let base = Path::new(name).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n        map.entry(m.guid).or_default().push(Row { name: name.clone(), key: *key, companion: m.companion, rank: old.get(&base).copied() });\n    }"]
[114.072748, "i", "\n    let mut known = Vec::new();\n    let mut fresh = Vec::new();\n    for (_, mut rows) in map {\n        let key = rows.iter().filter(|r| r.companion == 0).map(|r| r.key).min()\n            .unwrap_or_else(|| rows.iter().map(|r| r.key).min().unwrap());\n        rows.sort_by(|a,b| a.companion.cmp(&b.companion).then_with(|| match (a.rank,b.rank) {\n            (Some(x),Some(y)) => x.cmp(&y),\n            (Some(_),None) => std::cmp::Ordering::Less,\n            (None,Some(_)) => std::cmp::Ordering::Greater,\n            (None,None) => a.key.cmp(&b.key).then(a.name.cmp(&b.name)),\n        }));\n        let rank = rows.iter().filter_map(|r| r.rank).min();\n        let tie = rows.iter().map(|r| r.name.clone()).min().unwrap();\n        let g = Group { rows, key, rank, tie };\n        if rank.is_some() { known.push(g) } else { fresh.push(g) }\n    }\n    known.sort_by_key(|g| g.rank.unwrap());\n    fresh.sort_by(|a,b| a.key.cmp(&b.key).then(a.tie.cmp(&b.tie)));\n    for g in fresh {\n        let pos = known.iter().position(|x| x.key > g.key).unwrap_or(known.len());\n        known.insert(pos, g);\n    }\n    Ok(known.into_iter().flat_map(|g| g.rows.into_iter().map(|r| r.name)).collect())\n}\nRS\n"]
