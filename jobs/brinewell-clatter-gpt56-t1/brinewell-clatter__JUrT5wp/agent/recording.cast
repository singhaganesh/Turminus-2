[114.096336, "o", "            (Some(x),Some(y)) => x.cmp(&y),\r\n\u001b[?2004l\r"]
[114.096392, "o", "\u001b[?2004h> "]
[114.096532, "o", "            (Some(_),None) => std::cmp::Ordering::Less,\r\n\u001b[?2004l\r"]
[114.096588, "o", "\u001b[?2004h> "]
