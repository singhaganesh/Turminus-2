[114.097079, "o", "\u001b[?2004h> "]
[114.09723, "o", "        let rank = rows.iter().filter_map(|r| r.rank).min();\r\n\u001b[?2004l\r"]
[114.097289, "o", "\u001b[?2004h> "]
[114.097437, "o", "        let tie = rows.iter().map(|r| r.name.clone()).min().unwrap();\r\n\u001b[?2004l\r"]
[114.097492, "o", "\u001b[?2004h> "]
[114.097602, "o", "        let g = Group { rows, key, rank, tie };\r\n\u001b[?2004l\r"]
[114.097658, "o", "\u001b[?2004h> "]
[114.097803, "o", "        if rank.is_some() { known.push(g) } else { fresh.push(g) }\r\n\u001b[?2004l\r"]
