[114.702912, "o", "    json.push_str(\"]}\\n\");\r\n\u001b[?2004l\r"]
[114.703012, "o", "\u001b[?2004h> "]
[114.703134, "o", "    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n\u001b[?2004l\r"]
[114.70323, "o", "\u001b[?2004h> "]
[114.703942, "o", "    for (seq,name,digest,guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\",seq,name,digest,guid)); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.704434, "o", "    if fs::write(\"/app/kegbay/upload.json\",json).is_err() || fs::write(\"/app/kegbay/batch.tsv\",tsv).is_err() || fs::write(\"/app/kegbay/MARK\",\"ok\").is_err() { return fail(1); }\r\n\u001b[?2004l\r"]
[114.704765, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r"]
