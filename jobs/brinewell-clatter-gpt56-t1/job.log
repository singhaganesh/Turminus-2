 fail(1) };\n    let mut rows = Vec::new();\n    let mut seen = HashSet::new();\n    for line in ribbon.lines() {\n        let p: Vec<&str> = line.split(\'\\t\').collect();\n        if p.len() != 3 { return fail(1); }\n        let seq: usize = match p[0].parse() { Ok(x) => x, Err(_) => return fail(1) };\n        let path = PathBuf::from(p[1]);\n        if !current.contains(&path) || !seen.insert(path.clone()) { return fail(1); }\n        let name = match path.file_name().and_then(|x| x.to_str()) { Some(x) => x.to_string(), None => return fail(1) };\n        let digest = crate::sum::hex_file(p[1]);\n        if digest.len() != 64 { return fail(1); }\n        rows.push((seq,name,digest,p[2].to_string()));\n    }\n    if rows.len() != current.len() || rows.iter().enumerate().any(|(i,r)| r.0 != i+1) { return fail(1); }\n    let mut json = format!("{{\\"batch_count\\":{},\\"entries\\":[", (rows.len()+2)/3);\n    for (i,(seq,name,digest,guid)) in rows.iter().enumerate() {\n        if i != 0 { json.push(\',\'); }\n        json.push_str(&format!("{{\\"seq\\":{},\\"name\\":\\"{}\\",\\"digest\\":\\"{}\\",\\"guid\\":\\"{}\\"}}",seq,name,digest,guid));\n    }\n    json.push_str("]}\\n");\n    let mut tsv = String::from("seq\\tname\\tdigest\\tguid\\n");\n    for (seq,name,digest,guid) in &rows { tsv.push_str(&format!("{}\\t{}\\t{}\\t{}\\n",seq,name,digest,guid)); }\n    if fs::write("/app/kegbay/upload.json",json).is_err() || fs::write("/app/kegbay/batch.tsv",tsv).is_err() || fs::write("/app/kegbay/MARK","ok").is_err() { return fail(1); }\n    0\n}\nRS\ncat > /app/deskbin/sum.rs <<\'RS\'\nuse std::process::Command;\npub fn hex_file(path: &str) -> String {\n    let out = match Command::new("sha256sum").arg("--").arg(path).output() { Ok(x) if x.status.success() => x, _ => return String::new() };\n    String::from_utf8(out.stdout).ok().and_then(|s| s.split_whitespace().next().map(str::to_string)).unwrap_or_default()\n}\nRS\ncat > /app/deskbin/main.rs <<\'RS\'\n#[path="parse.rs"] mod