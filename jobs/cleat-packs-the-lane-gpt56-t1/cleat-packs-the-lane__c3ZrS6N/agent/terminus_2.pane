package main

type Lane struct {
	Deck string
	Name string
	Lid  int
	Span int
}

func allLanes() []Lane {
	return []Lane{
		{Deck: "A", Name: "A1", Lid: 180, Span: 2000},
		{Deck: "A", Name: "A2", Lid: 180, Span: 2000},
		{Deck: "B", Name: "B1", Lid: 420, Span: 2000},
		{Deck: "B", Name: "B2", Lid: 420, Span: 2000},
	}
}
/app/environment/board.go
--- /app/environment/board.go
package main

import "sort"

func arrange(cars []Car) []Car {
	out := append([]Car(nil), cars...)
	sort.Slice(out, func(i, j int) bool {
		if out[i].Board == out[j].Board {
			return out[i].Plate > out[j].Plate
		}
		return out[i].Board > out[j].Board
	})
	return out
}

func stationOf(cursor int, car Car, gap int) int {
	_ = car
	_ = gap
	return cursor - 10
}
