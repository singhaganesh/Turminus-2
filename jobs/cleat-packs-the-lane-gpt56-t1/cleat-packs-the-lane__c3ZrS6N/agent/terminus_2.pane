package bollard

func LowLidCm() int { return 90 }

func HighLidCm() int { return 240 }

func DeckAMassKg() int { return 20000 }

func DeckBMassKg() int { return 20000 }

func PairAKg() int { return 20000 }

func PairBKg() int { return 40000 }

func SisterTrimKg() int { return 8000 }
