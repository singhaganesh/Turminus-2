func decimal(s string) (int, bool) {
	if s == "" { return 0, false }
	for _, r := range s {
		if r < '0' || r > '9' { return 0, false }
	}
	n, err := strconv.ParseUint(s, 10, 0)
	if err != nil || uint64(int(n)) != n { return 0, false }
	return int(n), true
}

func parseRoll(sheet string) ([]Car, int) {
	var cars []Car
	for _, raw := range strings.Split(sheet, "\n") {
		line := strings.TrimSpace(raw)
		if line == "" || strings.HasPrefix(line, "#") { continue }
		w := strings.Fields(line)
		if len(w) != 12 || w[0] != "PLATE" || w[2] != "LEN" ||
			w[4] != "HT" || w[6] != "MASS" || w[8] != "HAZ" || w[10] != "BOARD" || !safeName(w[1]) {
			return nil, -2
		}
		length, a := decimal(w[3]); ht, b := decimal(w[5]); mass, c := decimal(w[7])
		haz, d := decimal(w[9]); board, e := decimal(w[11])
		if !a || !b || !c || !d || !e || length == 0 || ht == 0 || mass == 0 || board == 0 || (haz != 0 && haz != 1) {
			return nil, -2
		}
		cars = append(cars, Car{Plate:w[1], Len:length, Ht:ht, Mass:mass, Haz:haz, Board:board, Index:len(cars)})
	}
	return cars, 0
}
EOF
cat > /app/environment/board.go <<'EOF'
package main

import "sort"

func arrange(cars []Car) []Car {
	out := append([]Car(nil), cars...)
	sort.SliceStable(out, func(i, j int) bool {
		if out[i].Board != out[j].Board { return out[i].Board < out[j].Board }
		return out[i].Plate < out[j].Plate
	})
	return out
}

func stationOf(cursor int, car Car, gap int) int { return cursor - gap - car.Len }
EOF
cat > /app/environment/apron.go <<'EOF'
package main
func rampApron(haz int) int { if haz == 1 { return 100 }; return 0 }
EOF
cat > /app/environment/spacing.go <<'EOF'
package main
func neighbourGap(prevHaz, haz int) int {
	if prevHaz == 0 && haz == 0 { return 0 }
	if prevHaz == 1 && haz == 1 { return 200 }
	return 100
}
EOF
cat > /app/environment/offer.go <<'EOF'
package main

type occ struct {
	used int
	mass int
	lastHaz int
	has bool
}

func sister(name string) string {
	switch name { case "A1": return "A2"; case "A2": return "A1"; case "B1": return "B2"; default: return "B1" }
}

func pickLane(car Car, fill map[string]*occ, deckKg map[string]int) (Lane, int, int, bool) {
	for _, lane := range allLanes() {
		if car.Ht > lane.Lid { continue }
		slot := fill[lane.Name]
		if slot == nil { slot = &occ{} }
		gap := 0
		if slot.has { gap = neighbourGap(slot.lastHaz, car.Haz) }
		need := gap + car.Len + rampApron(car.Haz)
		if slot.used + need > lane.Span { continue }
		if !massFits(lane, slot, car, deckKg[lane.Deck]) { continue }
		if !trimFits(lane, fill, car.Mass) { continue }
		station := stationOf(lane.Span-slot.used, car, gap)
		return lane, need, station, true
	}
	return Lane{}, 0, 0, false
}
EOF
cat > /app/environment/kilo.go <<'EOF'
package main
func massFits(lane Lane, slot *occ, car Car, deckUsed int) bool {
	return slot.mass+car.Mass <= lane.MassLid && deckUsed+car.Mass <= deckMassLid(lane.Deck)
}
EOF
