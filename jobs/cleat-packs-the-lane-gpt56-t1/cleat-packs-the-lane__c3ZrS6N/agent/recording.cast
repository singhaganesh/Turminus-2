[100.387, "i", "cat >/tmp/check.roll <<'EOF'\nPLATE listed-first LEN 1700 HT 100 MASS 1000 HAZ 0 BOARD 2\nPLATE early LEN 400 HT 100 MASS 1000 HAZ 0 BOARD 1\nPLATE tall LEN 400 HT 181 MASS 1000 HAZ 0 BOARD 3\nPLATE flag1 LEN 400 HT 200 MASS 1000 HAZ 1 BOARD 4\nPLATE flag2 LEN 400 HT 200 MASS 1000 HAZ 1 BOARD 5\nPLATE impossible LEN 2001 HT 100 MASS 1 HAZ 0 BOARD 6\nEOF\n/opt/ferry/bin/cleat stow --roll /tmp/check.roll --chalk /tmp/check.chalk; echo '--- focused'; cat /tmp/check.chalk; echo '--- JSON validation'; python3 -c 'import json; [json.loads(x) for x in open(\"/tmp/check.chalk\")]; print(\"valid\")'\n"]
