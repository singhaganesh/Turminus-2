[221.894883, "o", "/opt/ferry/bin/cleat stow --roll /app/rolls/night.roll --chalk /tmp/final.chalk; rc=$?; echo \"rc=$rc binary=$(stat -c '%s bytes' /opt/ferry/bin/cleat)\"; cat /tmp/final.chalk\r\n\u001b[?2004l\r"]
