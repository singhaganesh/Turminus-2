[97.386322, "o", "func fmtInt(n int) string {\r\n\u001b[?2004l\r"]
[97.386355, "o", "\u001b[?2004h> "]
[97.386406, "o", "\u0007"]
[97.386467, "o", "if n == 0 { return \"0\" }\r\n\u001b[?2004l\r"]
