[100.388575, "o", "PLATE flag1 LEN 400 HT 200 MASS 1000 HAZ 1 BOARD 4\r\n\u001b[?2004l\r\u001b[?2004h> PLATE flag2 LEN 400 HT 200 MASS 1000 HAZ 1 BOARD 5\r\n\u001b[?2004l\r\u001b[?2004h> PLATE impossible LEN 2001 HT 100 MASS 1 HAZ 0 BOARD 6\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
