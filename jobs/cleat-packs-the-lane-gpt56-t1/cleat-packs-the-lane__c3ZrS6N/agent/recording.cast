[158.482902, "o", "s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.482968, "o", "> "]
[158.483106, "o", "s=s.replace('\"strings\"\\n)', '\"strings\"\\n\\t\"unicode\"\\n)')\r\n\u001b[?2004l\r"]
[158.483183, "o", "\u001b[?2004h"]
[158.483247, "o", "> start=s.index('func safeName(')\r\n\u001b[?2004l\r\u001b[?2004h"]
[158.483315, "o", "> "]
[158.483396, "o", "end=s.index('\\nfunc decimal(', start)\r\n\u001b[?2004l\r"]
[158.483461, "o", "\u001b[?2004h> "]
[158.483615, "o", "new='''func safeName(s string) bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.483764, "o", "\\tif s == \"\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.483832, "o", "\\t\\treturn false\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.483893, "o", "\\tfor _, r := range s {\r\n\u001b[?2004l\r"]
[158.483961, "o", "\u001b[?2004h> "]
[158.484159, "o", "\\t\\tif unicode.IsLetter(r) || unicode.IsDigit(r) || r == '.' || r == '_' || r == '-' {\r\n\u001b[?2004l\r"]
[158.484184, "o", "\u001b[?2004h> "]
[158.484257, "o", "\\t\\t\\tcontinue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.484315, "o", "\\t\\t}\r\n\u001b[?2004l\r"]
[158.484562, "o", "\u001b[?2004h> \\t\\treturn false\r\n\u001b[?2004l\r\u001b[?2004h> \\t}\r\n\u001b[?2004l\r\u001b[?2004h> \\treturn true\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[158.484701, "o", "s=s[:start]+new+s[end:]"]
