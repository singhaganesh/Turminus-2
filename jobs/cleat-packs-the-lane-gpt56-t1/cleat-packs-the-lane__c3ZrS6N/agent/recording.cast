[97.376092, "o", "d := here.mass + extra - other.mass\r\n\u001b[?2004l\r"]
[97.37616, "o", "\u001b[?2004h> "]
[97.376256, "o", "\u0007"]
[97.376352, "o", "if d < 0 { d = -d }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.376425, "o", "\u0007return d <= 3000\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.376479, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
