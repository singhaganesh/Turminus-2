[97.368747, "o", "Makefile     bollard/     dock/        environment/ rolls/       \r\n> "]
[97.368813, "o", "if car.Ht > lane.Lid { continue }\r\n\u001b[?2004l\r"]
[97.368858, "o", "\u001b[?2004h"]
[97.368901, "o", "> \u0007"]
[97.368948, "o", "\r\n"]
[97.368997, "o", "Makefile     bollard/     dock/        environment/ rolls/       \r\n> "]
