[97.369178, "o", "\r\n"]
[97.369223, "o", "Makefile     bollard/     dock/        environment/ rolls/       \r\n> "]
[97.369287, "o", "if slot == nil { slot = &occ{} }\r\n\u001b[?2004l\r"]
