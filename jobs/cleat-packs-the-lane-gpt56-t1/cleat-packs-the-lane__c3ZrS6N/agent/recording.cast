[221.920434, "o", "{\"i\":1,\"verb\":\"stow\",\"plate\":\"van-a\",\"deck\":\"A\",\"lane\":\"A1\",\"station\":\"1580\",\"ok\":\"yes\"}\r\n{\"i\":2,\"verb\":\"stow\",\"plate\":\"van-b\",\"deck\":\"A\",\"lane\":\"A1\",\"station\":\"1200\",\"ok\":\"yes\"}\r\n"]
[221.920636, "o", "\u001b[?2004hroot@d8943cebb482:/app# "]
[253.620468, "i", "cat >/tmp/regress.py <<'PY'\nimport json, subprocess, tempfile\nBIN='/opt/ferry/bin/cleat'\n\ndef run(data):\n    d=tempfile.mkdtemp(); roll=d+'/r'; chalk=d+'/c'\n    open(roll,'wb').write(data if isinstance(data,bytes) else data.encode())\n    open(chalk,'wb').write(b'OLD')\n    p=subprocess.run([BIN,'stow','--roll',roll,'--chalk',chalk])\n    raw=open(chalk,'rb').read()\n    return p.returncode, raw, [json.loads(x) for x in raw.splitlines()]\n\ndef P(n,L,H,M,Z,B):\n    return f'PLATE {n} LEN {L} HT {H} MASS {M} HAZ {Z} BOARD {B}\\n'\n\nrc,raw,r=run(P('printed',1700,100,1000,0,2)+P('early',400,100,1000,0,1))\nassert rc==0 and [x['plate'] for x in r]==['printed','early']\nassert r[1]['station']=='1600' and r[0]['lane']=='A2'\n\nrc,raw,r=run(P('low',100,180,100,0,1)+P('tall',100,181,100,0,2))\nassert [x['deck'] for x in r]==['A','B']\n\nrc,raw,r=run(P('a',100,100,7000,0,1)+P('b',100,100,2000,0,2)+P('c',100,100,2500,0,3))\nassert [x['lane'] for x in r]==['A1','A2','B1'], r\n\nrc,raw,r=run(P('x',100,300,17000,0,1)+P('y',100,300,7000,0,2)"]
[253.620602, "i", "+P('z',100,300,3000,0,3))\nassert [x.get('lane') for x in r]==['B1','B2',None] and r[2]['ok']=='no', r\n\nrc,raw,r=run(P('h1',100,300,12000,0,1)+P('h2',100,300,7000,0,2)+P('follow',100,300,5500,0,3))\nassert [x['lane'] for x in r]==['B1','B2','B2'], r\n\nrc,raw,r=run(P('f1',400,300,1000,1,1)+P('f2',400,300,1000,1,2))\nassert [x['station'] for x in r]==['1600','900'], r\n\nrc,raw,r=run(P('exact',2000,100,1,0,1))\nassert r[0]['ok']=='yes' and r[0]['station']=='0'\nrc,raw,r=run(P('haz-exact',1900,300,1,1,1))\nassert r[0]['ok']=='yes' and r[0]['station']=='100'\nrc,raw,r=run(P('haz-too-long',2000,300,1,1,1))\nassert r[0]['ok']=='no' and 'lane' not in r[0]\n\nrc,raw,r=run(P('zeta',300,100,100,0,1)+P('alpha',300,100,100,0,1))\nassert r[1]['station']=='1700' and r[0]['station']=='1400', r\n\nrc,raw,r=run('# comment only\\n'); assert rc==0 and raw==b''\nfor bad in [\n    b'bad line\\n',\n    b'PLATE p LEN 0 HT 1 MASS 1 HAZ 0 BOARD 1\\n',\n    b'PLATE p LEN 1 HT 1 MASS 1 HAZ 2 BOARD 1\\n',\n    b'PLATE bad/name LEN 1 HT 1 MASS 1 HAZ 0 BOARD 1\\n'"]
[253.620666, "o", "cat >/tmp/regress.py <<'PY'\r\n\u001b[?2004l\r"]
[253.620731, "i", ",\n    b'PLATE p LEN 1 HT 1 MASS 1 HAZ 0 BOARD 1\\xff\\n',\n]:\n    rc,raw,r=run(bad)\n    assert rc==2 and raw==b'', (bad,rc,raw)\n\np=subprocess.run([BIN],stdout=subprocess.PIPE,stderr=subprocess.PIPE)\nassert p.returncode==2\nprint('all regression assertions passed')\nPY\npython3 /tmp/regress.py\n"]
