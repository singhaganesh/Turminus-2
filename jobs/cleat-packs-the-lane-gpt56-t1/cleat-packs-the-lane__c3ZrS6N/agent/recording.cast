[253.628471, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.628618, "o", "p=subprocess.run([BIN],stdout=subprocess.PIPE,stderr=subprocess.PIPE)\r\n\u001b[?2004l\r"]
[253.628674, "o", "\u001b[?2004h"]
[253.628717, "o", "> assert p.returncode==2\r\n\u001b[?2004l\r"]
