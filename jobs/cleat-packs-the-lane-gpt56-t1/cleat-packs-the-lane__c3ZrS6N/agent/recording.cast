[97.341471, "i", "\n\t}\n\treturn true\n}\n\nfunc decimal(s string) (int, bool) {\n\tif s == \"\" { return 0, false }\n\tfor _, r := range s {\n\t\tif r < '0' || r > '9' { return 0, false }\n\t}\n\tn, err := strconv.ParseUint(s, 10, 0)\n\tif err != nil || uint64(int(n)) != n { return 0, false }\n\treturn int(n), true\n}\n\nfunc parseRoll(sheet string) ([]Car, int) {\n\tvar cars []Car\n\tfor _, raw := range strings.Split(sheet, \"\\n\") {\n\t\tline := strings.TrimSpace(raw)\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") { continue }\n\t\tw := strings.Fields(line)\n\t\tif len(w) != 12 || w[0] != \"PLATE\" || w[2] != \"LEN\" ||\n\t\t\tw[4] != \"HT\" || w[6] != \"MASS\" || w[8] != \"HAZ\" || w[10] != \"BOARD\" || !safeName(w[1]) {\n\t\t\treturn nil, -2\n\t\t}\n\t\tlength, a := decimal(w[3]); ht, b := decimal(w[5]); mass, c := decimal(w[7])\n\t\thaz, d := decimal(w[9]); board, e := decimal(w[11])\n\t\tif !a || !b || !c || !d || !e || length == 0 || ht == 0 || mass == 0 || board == 0 || (haz != 0 && haz != 1) {\n\t\t\treturn nil, -2\n\t\t}\n\t\tcars = append(cars, Car{Plate:w[1], Len:length, Ht:ht, Mass:mass, Haz:h"]
