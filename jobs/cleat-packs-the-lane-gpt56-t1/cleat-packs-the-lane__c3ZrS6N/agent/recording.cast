[160.486566, "i", "python3 - <<'PY'\nimport json, os, subprocess, tempfile\nBIN='/opt/ferry/bin/cleat'\n\ndef run(text):\n    d=tempfile.mkdtemp()\n    roll=d+'/r'; chalk=d+'/c'\n    open(roll,'w',encoding='utf-8').write(text)\n    open(chalk,'w').write('OLD')\n    p=subprocess.run([BIN,'stow','--roll',roll,'--chalk',chalk])\n    raw=open(chalk,'rb').read()\n    rows=[json.loads(x) for x in raw.splitlines()]\n    return p.returncode, raw, rows\n\ndef plate(name,L,H,M,Z,B):\n    return f'PLATE {name} LEN {L} HT {H} MASS {M} HAZ {Z} BOARD {B}\\n'\n\n# Listing order is preserved, but seating uses BOARD then plate name.\ns=plate('printed',1700,100,1000,0,2)+plate('early',400,100,1000,0,1)\nrc,raw,r=run(s)\nassert rc==0 and [x['plate'] for x in r]==['printed','early']\nassert r[1]['lane']=='A1' and r[1]['station']=='1600' and r[0]['lane']=='A2'\n\n# Height lids and low-deck search priority.\nrc,raw,r=run(plate('low',100,180,100,0,1)+plate('tall',100,181,100,0,2))\nassert r[0]['deck']=='A' and r[1]['deck']=='B'\n\n# Lane mass causes a next-lane search; paired d"]
[160.486762, "i", "eck lid causes B fallback.\ns=plate('a',100,100,7000,0,1)+plate('b',100,100,2000,0,2)+plate('c',100,100,2500,0,3)\nrc,raw,r=run(s)\nassert [x['lane'] for x in r]==['A1','A2','B1'], r\n\n# Opening each sister is trim-free; later additions enforce 3000 kg trim.\ns=plate('x',100,300,9000,0,1)+plate('y',100,300,1000,0,2)+plate('z',100,300,4000,0,3)\nrc,raw,r=run(s)\nassert r[0]['lane']=='B1' and r[1]['lane']=='B2' and r[2]['ok']=='no', r\n\n# Hazmat apron does not move its station; both flagged neighbours add 200 cm.\ns=plate('h1',400,300,1000,1,1)+plate('h2',400,300,1000,1,2)\nrc,raw,r=run(s)\nassert r[0]['station']=='1600' and r[1]['station']=='900', r\n\n# Equal BOARD sorts by ascending plate name, including UTF-8 names.\ns=plate('zeta',300,100,100,0,1)+plate('Ångström',300,100,100,0,1)\nrc,raw,r=run(s)\nassert rc==0 and r[1]['station']=='1700' and r[0]['station']=='1400', r\n\n# Empty and malformed behavior.\nrc,raw,r=run('# only\\n\\n'); assert rc==0 and raw==b''\nfor bad in [\n    'PLATE p LEN 0 HT 1 MASS 1 HAZ 0 BOARD 1\\n',\n    "]
[160.486823, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.48693, "i", "'PLATE p LEN 1 HT 1 MASS 1 HAZ 2 BOARD 1\\n',\n    'PLATE p LEN 1 HT 1 MASS 1 HAZ 0 BOARD x\\n',\n    'PLATE bad/name LEN 1 HT 1 MASS 1 HAZ 0 BOARD 1\\n',\n]:\n    rc,raw,r=run(bad); assert rc==2 and raw==b'', (bad,rc,raw)\nprint('all regression assertions passed')\nPY\n"]
