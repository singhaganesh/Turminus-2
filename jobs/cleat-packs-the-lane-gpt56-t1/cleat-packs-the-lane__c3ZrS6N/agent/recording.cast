[219.894114, "o", "\u001b[?2004h> "]
[219.894184, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.89449, "o", "def P(n,L,H,M,Z,B): return f'PLATE {n} LEN {L} HT {H} MASS {M} HAZ {Z} BOARD {B}\\n'\r\n\u001b[?2004l\r"]
[219.895369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Packing order versus listing order.\r\n\u001b[?2004l\r\u001b[?2004h> rc,raw,r=run(P('printed',1700,100,1000,0,2)+P('early',400,100,1000,0,1))\r\n\u001b[?2004l\r\u001b[?2004h> assert rc==0 and [x['plate'] for x in r]==['printed','early']\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.895486, "o", "> "]
[219.895799, "o", "assert r[1]['station']=='1600' and r[0]['lane']=='A2'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.895841, "o", "\u001b[?2004h> "]
[219.896119, "o", "# Height lids and low-deck preference.\r\n\u001b[?2004l\r"]
[219.896208, "o", "\u001b[?2004h> "]
[219.896348, "o", "rc,raw,r=run(P('low',100,180,100,0,1)+P('tall',100,181,100,0,2))\r\n"]
[219.896366, "o", "\u001b[?2004l\r"]
[219.896439, "o", "\u001b[?2004h"]
[219.896502, "o", "> "]
[219.896537, "o", "assert [x['deck'] for x in r]==['A','B']\r\n\u001b[?2004l\r"]
[219.896621, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.897357, "o", "# Lane and paired-deck mass limits.\r\n\u001b[?2004l\r\u001b[?2004h> rc,raw,r=run(P('a',100,100,7000,0,1)+P('b',100,100,2000,0,2)+P('c',100,100,2500,0,3))\r\n\u001b[?2004l\r\u001b[?2004h> assert [x['lane'] for x in r]==['A1','A2','B1'], r\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Opening B2 is trim-free; once both sisters hold freight, trim applies.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.897555, "o", "rc,raw,r=run(P('x',100,300,17000,0,1)+P('y',100,300,7000,0,2)+P('z',100,300,3000,0,3))\r\n\u001b[?2004l\r"]
[219.89763, "o", "\u001b[?2004h> "]
[219.897773, "o", "assert [x.get('lane') for x in r]==['B1','B2',None] and r[2]['ok']=='no', r\r\n\u001b[?2004l\r"]
[219.897798, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.897825, "o", "\u001b[?2004h> "]
[219.897996, "o", "# Two initially unbalanced heavies and a 5500 kg follow-on share deck B.\r\n\u001b[?2004l\r"]
[219.898013, "o", "\u001b[?2004h> "]
[219.898233, "o", "rc,raw,r=run(P('h1',100,300,12000,0,1)+P('h2',100,300,7000,0,2)+P('follow',100,300,5500,0,3))\r\n\u001b[?2004l\r"]
[219.898255, "o", "\u001b[?2004h> "]
[219.898373, "o", "assert [x['lane'] for x in r]==['B1','B2','B2'], r\r\n\u001b[?2004l\r"]
[219.898581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.898693, "o", "# Hazmat apron and double neighbour gap; apron does not move own station.\r\n\u001b[?2004l\r"]
[219.898754, "o", "\u001b[?2004h"]
[219.898815, "o", "> "]
[219.898909, "o", "rc,raw,r=run(P('f1',400,300,1000,1,1)+P('f2',400,300,1000,1,2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.899134, "o", "> assert [x['station'] for x in r]==['1600','900'], r\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.89925, "o", "# Painted-span boundaries.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.899358, "o", "rc,raw,r=run(P('exact',2000,100,1,0,1))\r\n\u001b[?2004l\r"]
[219.900703, "o", "\u001b[?2004h> assert r[0]['ok']=='yes' and r[0]['station']=='0'\r\n\u001b[?2004l\r\u001b[?2004h> rc,raw,r=run(P('haz-exact',1900,300,1,1,1))\r\n\u001b[?2004l\r\u001b[?2004h> assert r[0]['ok']=='yes' and r[0]['station']=='100'\r\n\u001b[?2004l\r\u001b[?2004h> rc,raw,r=run(P('haz-too-long',2000,300,1,1,1))\r\n\u001b[?2004l\r\u001b[?2004h> assert r[0]['ok']=='no' and 'lane' not in r[0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Equal BOARD sorts by plate, while chalk remains listing order.\r\n\u001b[?2004l\r\u001b[?2004h> rc,raw,r=run(P('zeta',300,100,100,0,1)+P('alpha',300,100,100,0,1))\r\n\u001b[?2004l\r\u001b[?2004h> assert r[1]['station']=='1700' and r[0]['station']=='1400', r\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.900942, "o", "# Empty, malformed, and invalid UTF-8 all replace chalk appropriately.\r\n\u001b[?2004l\r"]
[219.90102, "o", "\u001b[?2004h> "]
[219.901198, "o", "rc,raw,r=run('# comment only\\n'); assert rc==0 and raw==b''\r\n\u001b[?2004l\r"]
[219.901264, "o", "\u001b[?2004h> "]
[219.901283, "o", "for bad in [\r\n\u001b[?2004l\r"]
[219.901308, "o", "\u001b[?2004h"]
[219.90132, "o", "> "]
[219.901415, "o", "    b'bad line\\n',\r\n\u001b[?2004l\r"]
[219.901495, "o", "\u001b[?2004h"]
[219.901526, "o", "> "]
[219.901643, "o", "    b'PLATE p LEN 0 HT 1 MASS 1 HAZ 0 BOARD 1\\n',\r\n\u001b[?2004l\r"]
[219.901711, "o", "\u001b[?2004h> "]
[219.90185, "o", "    b'PLATE p LEN 1 HT 1 MASS 1 HAZ 2 BOARD 1\\n',\r\n\u001b[?2004l\r"]
[219.901911, "o", "\u001b[?2004h> "]
[219.90209, "o", "    b'PLATE bad/name LEN 1 HT 1 MASS 1 HAZ 0 BOARD 1\\n',\r\n\u001b[?2004l\r"]
[219.902159, "o", "\u001b[?2004h"]
[219.902216, "o", "> "]
[219.902313, "o", "    b'PLATE p LEN 1 HT 1 MASS 1 HAZ 0 BOARD 1\\xff\\n',\r\n\u001b[?2004l\r"]
[219.902363, "o", "\u001b[?2004h> "]
[219.902443, "o", "]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.90263, "o", "    rc,raw,r=run(bad); assert rc==2 and raw==b'', (bad,rc,raw)\r\n\u001b[?2004l\r"]
[219.902714, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[219.902776, "o", "\u001b[?2004h> "]
[219.902897, "o", "p=subprocess.run([BIN],stdout=subprocess.PIPE,stderr=subprocess.PIPE)\r\n\u001b[?2004l\r"]
[219.90295, "o", "\u001b[?2004h> "]
[219.903358, "o", "assert p.returncode==2\r\n\u001b[?2004l\r\u001b[?2004h> print('all regression assertions passed')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
