[19.560769, "o", "package main\r\n\r\ntype occ struct {\r\n\tused    int\r\n\tmass    int\r\n\tlastHaz int\r\n\thas     bool\r\n}\r\n\r\nfunc pickLane(car Car, fill map[string]*occ, deckKg map[string]int) Lane {\r\n\t_ = car\r\n\t_ = fill\r\n\t_ = deckKg\r\n\treturn Lane{Deck: \"B\", Name: \"B1\", Lid: 420, Span: 2000}\r\n}\r\n"]
