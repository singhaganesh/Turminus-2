[158.482525, "i", "python3 - <<'PY'\np='/app/environment/parse.go'\ns=open(p).read()\ns=s.replace('\"strings\"\\n)', '\"strings\"\\n\\t\"unicode\"\\n)')\nstart=s.index('func safeName(')\nend=s.index('\\nfunc decimal(', start)\nnew='''func safeName(s string) bool {\n\\tif s == \"\" {\n\\t\\treturn false\n\\t}\n\\tfor _, r := range s {\n\\t\\tif unicode.IsLetter(r) || unicode.IsDigit(r) || r == '.' || r == '_' || r == '-' {\n\\t\\t\\tcontinue\n\\t\\t}\n\\t\\treturn false\n\\t}\n\\treturn true\n}\n'''\ns=s[:start]+new+s[end:]\nopen(p,'w').write(s)\nPY\ngofmt -w /app/environment/parse.go\nmake -C /app/environment install\n"]
[158.482662, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[158.482735, "o", "\u001b[?2004h> "]
