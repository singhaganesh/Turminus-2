[97.386552, "o", "\u0007"]
[97.386618, "o", "const digits = \"0123456789\"\r\n\u001b[?2004l\r"]
[97.386647, "o", "\u001b[?2004h"]
[97.386692, "o", "> "]
[97.386721, "o", "\u0007"]
[97.386786, "o", "var b [32]byte; p := len(b)\r\n\u001b[?2004l\r"]
[97.386814, "o", "\u001b[?2004h"]
[97.386846, "o", "> "]
[97.386873, "o", "\u0007"]
[97.386983, "o", "for n > 0 { p--; b[p] = digits[n%10]; n /= 10 }\r\n\u001b[?2004l\r"]
[97.38701, "o", "\u001b[?2004h"]
[97.387039, "o", "> "]
[97.387073, "o", "\u0007"]
[97.387129, "o", "return string(b[p:])\r\n\u001b[?2004l\r"]
[97.387168, "o", "\u001b[?2004h> "]
[97.387199, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
