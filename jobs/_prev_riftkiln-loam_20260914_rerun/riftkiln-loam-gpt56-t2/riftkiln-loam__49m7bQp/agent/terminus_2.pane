    47	fn to_json(n: &Node) -> String {
    48	    match n {
    49	        Node::Str(s) => format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\"")),
    50	        Node::List(xs) => {
    51	            let inner: Vec<String> = xs.iter().map(to_json).collect();
    52	            format!("[{}]", inner.join(","))
    53	        }
    54	        Node::Map(pairs) => {
    55	            let inner: Vec<String> = pairs
    56	                .iter()
    57	                .map(|(k, v)| format!("\"{}\":{}", k, to_json(v)))
    58	                .collect();
    59	            format!("{{{}}}", inner.join(","))
    60	        }
    61	    }
    62	}
