     8	type Item = (usize, usize);
     9	
    10	#[derive(Clone, Debug, PartialEq, Eq)]
    11	enum Act {
    12	    Shift(usize),
    13	    Reduce(usize),
    14	    Acc,
    15	}
    16	
    17	fn main() {
    18	    let args: Vec<String> = env::args().collect();
    19	    if args.len() < 3 {
    20	        eprintln!("usage: tblbake RECIPE OUTDIR");
    21	        process::exit(2);
    22	    }
    23	    let text = fs::read_to_string(&args[1]).expect("recipe");
    24	    let out = args[2].trim_end_matches('/').to_string();
    25	    let _ = fs::create_dir_all(&out);
    26	
    27	    let mut prods: Vec<(String, Vec<String>)> = Vec::new();
    28	    prods.push(("S'".to_string(), vec!["S".to_string()]));
    29	    let mut body = String::new();
    30	    for line in text.lines() {
    31	        let t = line.trim();
    32	        if t.is_empty() || t.starts_with('#') {
    33	            continue;
    34	        }
    35	        body.push_str(t);
    36	        body.push(' ');
    37	    }
    38	    for chunk in body.split(';') {
    39	        let chunk = chunk.trim();
    40	        if chunk.is_empty() {
    41	            continue;
    42	        }
    43	        let Some((lhs, rhs)) = chunk.split_once(':') else {
    44	            continue;
    45	        };
    46	        let lhs = lhs.trim().to_string();
    47	        for alt in rhs.split('|') {
    48	            let syms: Vec<String> = alt.split_whitespace().map(|s| s.to_string()).collect();
    49	            prods.push((lhs.clone(), syms));
    50	        }
    51	    }
    52	
    53	    let mut nts: BTreeSet<String> = BTreeSet::new();
    54	    for (l, _) in &prods {
    55	        nts.insert(l.clone());
    56	    }
    57	    let mut terms: BTreeSet<String> = BTreeSet::new();
    58	    terms.insert("$".to_string());
    59	    for (_, rhs) in &prods {
    60	        for s in rhs {
    61	            if !nts.contains(s) {
    62	                terms.insert(s.clone());
    63	            }
    64	        }
    65	    }
    66	
    67	    let mut first: BTreeMap<String, BTreeSet<Option<String>>> = BTreeMap::new();
    68	    for nt in &nts {
    69	        first.insert(nt.clone(), BTreeSet::new());
    70	    }
    71	    for t in &terms {
    72	        let mut s = BTreeSet::new();
    73	        s.insert(Some(t.clone()));
    74	        first.insert(t.clone(), s);
    75	    }
    76	    let mut changed = true;
    77	    while changed {
    78	        changed = false;
    79	        for (lhs, rhs) in &prods {
    80	            if rhs.is_empty() {
    81	                if first.get_mut(lhs).unwrap().insert(None) {
    82	                    changed = true;
    83	                }
    84	                continue;
    85	            }
    86	            let mut nullable = true;
    87	            for sym in rhs {
    88	                let fs = first.get(sym).cloned().unwrap_or_default();
    89	                for x in &fs {
    90	                    if x.is_some() && first.get_mut(lhs).unwrap().insert(x.clone()) {
    91	                        changed = true;
    92	                    }
    93	                }
    94	                if !fs.contains(&None) {
    95	                    nullable = false;
    96	                    break;
    97	                }
    98	            }
    99	            if nullable && first.get_mut(lhs).unwrap().insert(None) {
   100	                changed = true;
   101	            }
   102	        }
   103	    }
   104	
   105	    let mut follow: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();
   106	    for nt in &nts {
   107	        follow.insert(nt.clone(), BTreeSet::new());
   108	    }
   109	    follow.get_mut("S'").unwrap().insert("$".to_string());
   110	    changed = true;
   111	    while changed {
   112	        changed = false;
   113	        for (lhs, rhs) in &prods {
   114	            for i in 0..rhs.len() {
   115	                let sym = &rhs[i];
   116	                if !nts.contains(sym) {
   117	                    continue;
   118	                }
   119	                let rest = &rhs[i + 1..];
   120	                let mut acc: BTreeSet<String> = BTreeSet::new();
   121	                let mut nullable;
   122	                if rest.is_empty() {
   123	                    nullable = true;
   124	                } else {
   125	                    nullable = true;
   126	                    for r in rest {
   127	                        let fs = first.get(r).cloned().unwrap_or_default();
   128	                        for x in &fs {
   129	                            if let Some(t) = x {
   130	                                acc.insert(t.clone());
   131	                            }
   132	                        }
   133	                        if terms.contains(r) || !fs.contains(&None) {
   134	                            nullable = false;
   135	                            break;
   136	                        }
   137	                    }
   138	                }
   139	                for t in acc {
   140	                    if follow.get_mut(sym).unwrap().insert(t) {
   141	                        changed = true;
   142	                    }
   143	                }
   144	                if nullable {
   145	                    let extras = follow.get(lhs).cloned().unwrap_or_default();
   146	                    for t in extras {
   147	                        if follow.get_mut(sym).unwrap().insert(t) {
   148	                            changed = true;
   149	                        }
   150	                    }
   151	                }
   152	            }
   153	        }
   154	    }
