[32.390619, "o", "    11\tenum Act {\r\n    12\t    Shift(usize),\r\n    13\t    Reduce(usize),\r\n    14\t    Acc,\r\n    15\t}\r\n    16\t\r\n    17\tfn main() {\r\n    18\t    let args: Vec<String> = env::args().collect();\r\n    19\t    if args.len() < 3 {\r\n    20\t        eprintln!(\"usage: tblbake RECIPE OUTDIR\");\r\n    21\t        process::exit(2);\r\n    22\t    }\r\n    23\t    let text = fs::read_to_string(&args[1]).expect(\"recipe\");\r\n    24\t    let out = args[2].trim_end_matches('/').to_string();\r\n    25\t    let _ = fs::create_dir_all(&out);\r\n    26\t\r\n    27\t    let mut prods: Vec<(String, Vec<String>)> = Vec::new();\r\n    28\t    prods.push((\"S'\".to_string(), vec![\"S\".to_string()]));\r\n    29\t    let mut body = String::new();\r\n    30\t    for line in text.lines() {\r\n    31\t        let t = line.trim();\r\n    32\t        if t.is_empty() || t.starts_with('#') {\r\n    33\t            continue;\r\n    34\t        }\r\n    35\t        body.push_str(t);\r\n    36\t        body.push(' ');\r\n    37\t    }\r\n    38\t    for chunk in body.split(';') {\r\n    39\t        let chunk = chunk.trim();\r\n    40\t        if chunk.is_empty() {\r\n    41\t            continue;\r\n    42\t        }\r\n    43\t        let Some((lhs, rhs)) = chunk.split_once(':') else {\r\n    44\t            continue;\r\n    45\t        };\r\n    46\t        let lhs = lhs.trim().to_string();\r\n    47\t        for alt in rhs.split('|') {\r\n    48\t            let syms: Vec<String> = alt.split_whitespace().map(|s| s.to_string()).collect();\r\n    49\t            prods.push((lhs.clone(), syms));\r\n    50\t        }\r\n    51\t    }\r\n    52\t\r\n    53\t    let mut nts: BTreeSet<String> = BTreeSet::new();\r\n    54\t    for (l, _) in &prods {\r\n    55\t        nts.insert(l.clone());\r\n    56\t    }\r\n    57\t    let mut terms: BTreeSet<String> = BTreeSet::new();\r\n    58\t    terms.insert(\"$\".to_string());\r\n    59\t    for (_, rhs) in &prods {\r\n    60\t        for s in rhs {\r\n    61\t            if !nts.contains(s) {\r\n    62\t                terms.insert(s.clone());\r\n    63\t            }\r\n    64\t        }\r\n    65\t    }\r\n    66\t\r\n    67\t    let mut first: BTreeMap<String, BTreeSet<Option<String>>> = BTreeMap::new();\r\n    68\t    for nt in &nts {\r\n    69\t        first.insert(nt.clone(), BTreeSet::new());\r\n    70\t    }\r\n    71\t    for t in &terms {\r\n    72\t        let mut s = BTreeSet::new();\r\n    73\t        s.insert(Some(t.clone()));\r\n    74\t        first.insert(t.clone(), s);\r\n    75\t    }\r\n    76\t    let mut changed = true;\r\n    77\t    while changed {\r\n    78\t        changed = false;\r\n    79\t        for (lhs, rhs) in &prods {\r\n    80\t            if rhs.is_empty() {\r\n    81\t                if first.get_mut(lhs).unwrap().insert(None) {\r\n    82\t                    changed = true;\r\n    83\t                }\r\n    84\t                continue;\r\n    85\t            }\r\n    86\t            let mut nullable = true;\r\n    87\t            for sym in rhs {\r\n    88\t                let fs = first.get(sym).cloned().unwrap_or_default();\r\n    89\t                for x in &fs {\r\n    90\t                    if x.is_some() && first.get_mut(lhs).unwrap().insert(x.clone()) {\r\n    91\t                        changed = true;\r\n    92\t                    }\r\n    93\t                }\r\n    94\t                if !fs.contains(&None) {\r\n    95\t                    nullable = false;\r\n    96\t                    break;\r\n    97\t                }\r\n    98\t            }\r\n    99\t            if nullable && first.get_mut(lhs).unwrap().insert(None) {\r\n   100\t                changed = true;\r\n   101\t            }\r\n   102\t        }\r\n   103\t    }\r\n   104\t\r\n   105\t    let mut follow: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();\r\n   106\t    for nt in &nts {\r\n   107\t        follow.insert(nt.clone(), BTreeSet::new());\r\n   108\t    }\r\n   109\t    follow.get_mut(\"S'\").unwrap().insert(\"$\".to_string());\r\n   110\t    changed = true;\r\n   111\t    while changed {\r\n   112\t        changed = false;\r\n   113\t        for (lhs, rhs) in &prods {\r\n   114\t            for i in 0..rhs.len() {\r\n   115\t                let sym = &rhs[i];\r\n   116\t                if !nts.contains(sym) {\r\n   117\t                    continue;\r\n   118\t                }\r\n   119\t                let rest = &rhs[i + 1..];\r\n   120\t                let mut acc: BTreeSet<String> = BTreeSet::new();\r\n   121\t                let mut nullable;\r\n   122\t                if rest.is_empty() {\r\n   123\t                    nullable = true;\r\n   124\t                } else {\r\n   125\t                    nullable = true;\r\n   126\t                    for r in rest {\r\n   127\t                        let fs = first.get(r).cloned().unwrap_or_default();\r\n   128\t                        for x in &fs {\r\n   129\t                            if let Some(t) = x {\r\n   130\t                                acc.insert(t.clone());\r\n   131\t                            }\r\n   132\t                        }\r\n   133\t                        if terms.contains(r) || !fs.contains(&None) {\r\n   134\t                            nullable = false;\r\n   135\t                            break;\r\n   136\t                        }\r\n   137\t                    }\r\n   138\t                }\r\n   139\t                for t in acc {\r\n   140\t                    if follow.get_mut(sym).unwrap().insert(t) {\r\n   141\t                        changed = true;\r\n   142\t                    }\r\n   143\t                }\r\n   144\t                if nullable {\r\n   145\t                    let extras = follow.get(lhs).cloned().unwrap_or_default();\r\n   146\t                    for t in extras {\r\n   147\t                        if follow.get_mut(sym).unwrap().insert(t) {\r\n   148\t                            changed = true;\r\n   149\t                        }\r\n   150\t                    }\r\n   151\t                }\r\n   152\t            }\r\n   153\t        }\r\n   154\t    }\r\n   155\t\r\n   156\t    fn closure(I: &BTreeSet<Item>, prods: &[(String, Vec<String>)], nts: &BTreeSet<String>) -> BTreeSet<Item> {\r\n   157\t        let mut s = I.clone();\r\n   158\t        let mut ch = true;\r\n   159\t        while ch {\r\n   160\t            ch = false;\r\n   161\t            let snap: Vec<Item> = s.iter().cloned().collect();\r\n   162\t            for (pi, dot) in snap {\r\n   163\t                let rhs = &prods[pi].1;\r\n   164\t                if dot < rhs.len() {\r\n   165\t                    let b = &rhs[dot];\r\n   166\t                    if nts.contains(b) {\r\n   167\t                        for (j, (lhs, _)) in prods.iter().enumerate() {\r\n   168\t                            if lhs == b && s.insert((j, 0)) {\r\n   169\t                                ch = true;\r\n   170\t                            }\r\n   171\t                        }\r\n   172\t                    }\r\n   173\t                }\r\n   174\t            }\r\n   175\t        }\r\n   176\t        s\r\n   177\t    }\r\n   178\t\r\n   179\t    fn goto_set(\r\n   180\t        I: &BTreeSet<Item>,\r\n   181\t        x: &str,\r\n   182\t        prods: &[(String, Vec<String>)],\r\n   183\t        nts: &BTreeSet<String>,\r\n   184\t    ) -> BTreeSet<Item> {\r\n   185\t        let mut j: BTreeSet<Item> = BTreeSet::new();\r\n   186\t     "]
[32.390829, "o", "   for &(pi, dot) in I {\r\n   187\t            let rhs = &prods[pi].1;\r\n   188\t            if dot < rhs.len() && rhs[dot] == x {\r\n   189\t                j.insert((pi, dot + 1));\r\n   190\t            }\r\n   191\t        }\r\n   192\t        if j.is_empty() {\r\n   193\t            BTreeSet::new()\r\n   194\t        } else {\r\n   195\t            closure(&j, prods, nts)\r\n   196\t        }\r\n   197\t    }\r\n   198\t\r\n   199\t    let start = closure(&{\r\n   200\t        let mut s = BTreeSet::new();\r\n   201\t        s.insert((0, 0));\r\n   202\t        s\r\n   203\t    }, &prods, &nts);\r\n   204\t    let mut csets: Vec<BTreeSet<Item>> = vec![start];\r\n   205\t    changed = true;\r\n   206\t    while changed {\r\n   207\t        changed = false;\r\n   208\t        let mut add: Vec<BTreeSet<Item>> = Vec::new();\r\n   209\t        for i in &csets {\r\n   210\t            let mut names: Vec<String> = nts.iter().cloned().collect();\r\n   211\t            names.extend(terms.iter().filter(|t| *t != \"$\").cloned());\r\n   212\t            for x in names {\r\n   213\t                let g = goto_set(i, &x, &prods, &nts);\r\n   214\t                if !g.is_empty() && !csets.contains(&g) && !add.contains(&g) {\r\n   215\t                    add.push(g);\r\n   216\t                    changed = true;\r\n   217\t                }\r\n   218\t            }\r\n   219\t        }\r\n   220\t        csets.extend(add);\r\n   221\t    }\r\n   222\t\r\n   223\t    let mut action: Vec<BTreeMap<String, Act>> = vec![BTreeMap::new(); csets.len()];\r\n   224\t    let mut gotot: Vec<BTreeMap<String, usize>> = vec![BTreeMap::new(); csets.len()];\r\n   225\t    let mut quarrel: Vec<String> = Vec::new();\r\n   226\t\r\n   227\t    for (idx, i) in csets.iter().enumerate() {\r\n   228\t        let mut names: Vec<String> = nts.iter().cloned().collect();\r\n   229\t        names.extend(terms.iter().cloned());\r\n   230\t        for x in &names {\r\n"]
