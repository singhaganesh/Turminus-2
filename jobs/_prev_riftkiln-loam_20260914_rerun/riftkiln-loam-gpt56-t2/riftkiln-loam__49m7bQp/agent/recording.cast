[19.002045, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/tblwell /app/markcue /app/treypit\r\n     5\trm -f /app/markcue/brew.ok\r\n     6\trustc --edition 2021 -O /app/ovenpit/oven.rs -o /app/bin/tblbake\r\n     7\tset +e\r\n     8\t/app/bin/tblbake /app/cardhearth/card.yg /app/tblwell\r\n     9\tec=$?\r\n    10\tset -e\r\n    11\tif [ \"$ec\" -ne 0 ]; then\r\n    12\t  exit \"$ec\"\r\n    13\tfi\r\n    14\trustc --edition 2021 -O /app/drawbin/boot.rs -o /app/bin/riftkiln\r\n    15\ttouch /app/markcue/brew.ok\r\n    16\t/app/bin/riftkiln sift /app/flatpit/flat.quern /app/treypit/flat.json\r\n"]
[19.002407, "o", "--- BUILD NOTES ---\r\n"]
[19.003715, "o", "tblbake argv: RECIPE OUTDIR. Writes quarrel.lst then action.tbl, goto.tbl, prod.tbl when the mill accepts the recipe.\r\ntblbake reads card.yg and writes tblwell tables. ribjoin walks reduce numbers from prod.tbl.\r\n\r\nFlat cards under /app/flatpit are the mill's own walk. Green status there does not prove nested clip placement.\r\n"]
[19.00398, "o", "boot.rs includes cursor.rs. sift tokenizes a quern file, drives action.tbl, and writes the destination object.\r\n"]
[19.004079, "o", "--- GRAMMAR ---\r\n"]
[19.005627, "o", "     1\t# rib_b\r\n     2\tS : YARD ID LBRACE MS RBRACE ;\r\n     3\tMS : MS M | ;\r\n     4\tM : PEG ID EQ VAL SEMI\r\n     5\t  | PEN ID LBRACE MS RBRACE\r\n     6\t  | PEN ID LBRACE MS RBRACE CLIP ID\r\n     7\t  | CLIP ID\r\n     8\t  ;\r\n"]
