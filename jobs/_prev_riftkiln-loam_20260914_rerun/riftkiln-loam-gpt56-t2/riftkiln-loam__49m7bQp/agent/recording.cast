[32.117674, "o", "    87\t\r\n    88\tfn load_action(path: &str) -> BTreeMap<(usize, String), Cell> {\r\n    89\t    let mut m = BTreeMap::new();\r\n    90\t    if let Ok(t) = fs::read_to_string(path) {\r\n    91\t        for line in t.lines() {\r\n    92\t            let p: Vec<&str> = line.split_whitespace().collect();\r\n    93\t            if p.len() < 4 {\r\n    94\t                continue;\r\n    95\t            }\r\n    96\t            let st: usize = p[0].parse().unwrap_or(0);\r\n    97\t            let tok = p[1].to_string();\r\n    98\t            m.insert(\r\n    99\t                (st, tok),\r\n   100\t                match p[2] {\r\n   101\t                    \"s\" => Cell::S(p[3].parse().unwrap_or(0)),\r\n   102\t                    \"r\" => Cell::R(p[3].parse().unwrap_or(0)),\r\n"]
[32.11965, "o", "   103\t                    _ => Cell::A,\r\n   104\t                },\r\n   105\t            );\r\n   106\t        }\r\n   107\t    }\r\n   108\t    m\r\n   109\t}\r\n   110\t\r\n   111\tfn load_goto(path: &str) -> BTreeMap<(usize, String), usize> {\r\n   112\t    let mut m = BTreeMap::new();\r\n   113\t    if let Ok(t) = fs::read_to_string(path) {\r\n   114\t        for line in t.lines() {\r\n   115\t            let p: Vec<&str> = line.split_whitespace().collect();\r\n   116\t            if p.len() < 3 {\r\n   117\t                continue;\r\n   118\t            }\r\n   119\t            m.insert(\r\n   120\t                (p[0].parse().unwrap_or(0), p[1].to_string()),\r\n   121\t                p[2].parse().unwrap_or(0),\r\n   122\t            );\r\n   123\t        }\r\n   124\t    }\r\n   125\t    m\r\n   126\t}\r\n   127\t\r\n   128\tfn load_prod(path: &str) -> Vec<(String, Vec<String>)> {\r\n   129\t    let mut out = Vec::new();\r\n   130\t    let t = fs::read_to_string(path).unwrap_or_default();\r\n   131\t    let lines: Vec<&str> = t.lines().collect();\r\n   132\t    let mut i = 0;\r\n   133\t    while i < lines.len() {\r\n   134\t        let p: Vec<&str> = lines[i].split_whitespace().collect();\r\n   135\t        if p.len() >= 3 {\r\n   136\t            let n: usize = p[2].parse().unwrap_or(0);\r\n   137\t            let mut rhs = Vec::new();\r\n   138\t            for _ in 0..n {\r\n   139\t                i += 1;\r\n   140\t                if i < lines.len() {\r\n   141\t                    rhs.push(lines[i].trim().to_string());\r\n   142\t                }\r\n   143\t            }\r\n   144\t            let idx: usize = p[0].parse().unwrap_or(0);\r\n   145\t            while out.len() <= idx {\r\n   146\t                out.push((String::new(), Vec::new()));\r\n   147\t            }\r\n   148\t            out[idx] = (p[1].to_string(), rhs);\r\n   149\t        }\r\n   150\t        i += 1;\r\n   151\t    }\r\n   152\t    out\r\n   153\t}\r\n   154\t\r\n   155\t#[derive(Clone)]\r\n   156\tstruct Tok {\r\n   157\t    name: String,\r\n   158\t    lex: String,\r\n   159\t}\r\n   160\t\r\n   161\tfn lex(src: &str) -> Vec<Tok> {\r\n   162\t    let mut out = Vec::new();\r\n   163\t    let b = src.as_bytes();\r\n   164\t    let mut i = 0;\r\n   165\t    let mut after_eq = false;\r\n   166\t    while i < b.len() {\r\n   167\t        let c = b[i] as char;\r\n   168\t        if c.is_whitespace() {\r\n   169\t            i += 1;\r\n   170\t            continue;\r\n   171\t        }\r\n   172\t        if c == '{' {\r\n   173\t            out.push(Tok {\r\n   174\t                name: \"LBRACE\".into(),\r\n   175\t                lex: \"{\".into(),\r\n   176\t            });\r\n   177\t            i += 1;\r\n   178\t            continue;\r\n   179\t        }\r\n   180\t        if c == '}' {\r\n   181\t            out.push(Tok {\r\n   182\t                name: \"RBRACE\".into(),\r\n   183\t                lex: \"}\".into(),\r\n   184\t            });\r\n   185\t            i += 1;\r\n   186\t            continue;\r\n   187\t        }\r\n   188\t        if c == '=' {\r\n   189\t            out.push(Tok {\r\n   190\t                name: \"EQ\".into(),\r\n   191\t                lex: \"=\".into(),\r\n   192\t            });\r\n   193\t            after_eq = true;\r\n   194\t            i += 1;\r\n   195\t            continue;\r\n   196\t        }\r\n   197\t        if c == ';' {\r\n   198\t            out.push(Tok {\r\n   199\t                name: \"SEMI\".into(),\r\n   200\t                lex: \";\".into(),\r\n   201\t            });\r\n   202\t            i += 1;\r\n   203\t            continue;\r\n   204\t        }\r\n   205\t        if c.is_ascii_alphanumeric() || c == '_' {\r\n   206\t            let s = i;\r\n   207\t            i += 1;\r\n   208\t            while i < b.len() {\r\n   209\t                let d = b[i] as char;\r\n   210\t                if d.is_ascii_alphanumeric() || d == '_' {\r\n   211\t                    i += 1;\r\n   212\t                } else {\r\n   213\t                    break;\r\n   214\t                }\r\n   215\t            }\r\n   216\t            let w = src[s..i].to_string();\r\n   217\t            if after_eq {\r\n   218\t                out.push(Tok {\r\n   219\t                    name: \"VAL\".into(),\r\n   220\t                    lex: w,\r\n   221\t                });\r\n   222\t                after_eq = false;\r\n   223\t            } else {\r\n   224\t                let name = match w.as_str() {\r\n   225\t                    \"yard\" => \"YARD\",\r\n   226\t                    \"pen\" => \"PEN\",\r\n   227\t                    \"clip\" => \"CLIP\",\r\n   228\t                    \"peg\" => \"PEG\",\r\n   229\t                    _ => \"ID\",\r\n   230\t                };\r\n   231\t                out.push(Tok {\r\n   232\t                    name: name.into(),\r\n   233\t                    lex: w,\r\n   234\t                });\r\n   235\t            }\r\n   236\t            continue;\r\n   237\t        }\r\n   238\t        i += 1;\r\n   239\t    }\r\n   240\t    out.pu"]
[32.120117, "o", "sh(Tok {\r\n   241\t        name: \"$\".into(),\r\n   242\t        lex: \"\".into(),\r\n   243\t    });\r\n   244\t    out\r\n   245\t}\r\n   246\t\r\n   247\tfn reduce_node(prod: &(String, Vec<String>), kids: Vec<Node>) -> Node {\r\n   248\t    let lhs = &prod.0;\r\n   249\t    let rhs = &prod.1;\r\n   250\t    if lhs == \"MS\" && rhs.is_empty() {\r\n   251\t        return Node::List(Vec::new());\r\n   252\t    }\r\n   253\t    if lhs == \"MS\" && rhs.len() == 2 {\r\n   254\t        return rib_c(kids[0].clone(), kids[1].clone());\r\n   255\t    }\r\n   256\t    if lhs == \"M\" && rhs.first().map(|s| s.as_str()) == Some(\"PEG\") {\r\n   257\t        let tag = if let Node::Str(s) = &kids[1] {\r\n   258\t            s.clone()\r\n   259\t        } else {\r\n   260\t            String::new()\r\n   261\t        };\r\n   262\t        let mark = if let Node::Str(s) = &kids[3] {\r\n   263\t            s.clone()\r\n   264\t        } else {\r\n   265\t            String::new()\r\n   266\t        };\r\n   267\t        return Node::Map(vec![\r\n   268\t            (\"kind\".into(), Node::Str(\"peg\".into())),\r\n   269\t            (\"tag\".into(), Node::Str(tag)),\r\n   270\t            (\"mark\".into(), Node::Str(mark)),\r\n   271\t        ]);\r\n   272\t    }\r\n   273\t    if lhs == \"M\" && rhs.first().map(|s| s.as_str()) == Some(\"CLIP\") && rhs.len() == 2 {\r\n   274\t        let stem = if let Node::Str(s) = &kids[1] {\r\n   275\t            s.clone()\r\n   276\t        } else {\r\n   277\t            String::new()\r\n   278\t        };\r\n   279\t        return Node::Map(vec![\r\n   280\t            (\"kind\".into(), Node::Str(\"clip\".into())),\r\n   281\t            (\"stem\".into(), Node::Str(stem)),\r\n   282\t        ]);\r\n   283\t    }\r\n   284\t    if lhs == \"M\" && rhs.first().map(|s| s.as_str()) == Some(\"PEN\") {\r\n   285\t        let stem = if let Node::Str(s) = &kids[1] {\r\n   286\t            s.clone()\r\n   287\t        } else {\r\n   288\t            String::new()\r\n   289\t        };\r\n   290\t        let members = kids[3].clone();\r\n   291\t        let mut pairs = vec![\r\n   292\t            (\"kind\".into(), Node::Str(\"pen\".into())),\r\n   293\t            (\"stem\".into(), Node::Str(stem)),\r\n   294\t            (\"members\".into(), members),\r\n   295\t        ];\r\n   296\t        if rhs.len() >= 7 {\r\n   297\t            let cl = if let Node::Str(s) = &kids[6] {\r\n   298\t                s.clone()\r\n   299\t            } else {\r\n   300\t                String::new()\r\n   301\t            };\r\n   302\t            pairs.push((\"clip\".into(), Node::Str(cl)));\r\n   303\t        }\r\n   304\t        return Node::Map(pairs);\r\n   305\t    }\r\n   306\t    if lhs == \"S\" {\r\n   307\t        let yard = if let Node::Str(s) = &kids[1] {\r\n   308\t            s.clone()\r\n   309\t        } else {\r\n   310\t            String::new()\r\n   311\t        };\r\n   312\t        let members = kids[3].clone();\r\n   313\t        return Node::Map(vec![\r\n   314\t            (\"yard\".into(), Node::Str(yard)),\r\n   315\t            (\"members\".into(), members),\r\n   316\t        ]);\r\n   317\t    }\r\n   318\t    if lhs == \"S'\" {\r\n   319\t        return kids[0].clone();\r\n   320\t    }\r\n   321\t    Node::List(kids)\r\n   322\t}\r\n   323\t\r\n   324\tfn tbl_dir() -> String {\r\n   325\t    std::env::var(\"ACTRIB\").unwrap_or_else(|_| \"/app/tblwell\".to_string())\r\n   326\t}\r\n   327\t\r\n   328\tpub fn run_sift(src: &str, dest: &str) -> i32 {\r\n   329\t    let text = match fs::read_to_string(src) {\r\n   330\t        Ok(t) => t,\r\n   331\t        Err(_) => return 1,\r\n   332\t    };\r\n   333\t    let toks = lex(&text);\r\n   334\t    let base = tbl_dir();\r\n   335\t    let act = load_action(&format!(\"{}/action.tbl\", base));\r\n   336\t    let gtbl = load_goto(&format!(\"{}/goto.tbl\", base));\r\n   337\t    let prods = load_prod(&format!(\"{}/prod.tbl\", base));\r\n   338\t    let mut states: Vec<usize> = vec![0];\r\n   339\t    let mut vals: Vec<Node> = Vec::new();\r\n   340\t    let mut ip = 0;\r\n   341\t    loop {\r\n   342\t        if ip >= toks.len() {\r\n   343\t            return 1;\r\n   344\t        }\r\n   345\t        let st = *states.last().unwrap();\r\n   346\t        let la = &toks[ip].name;\r\n   347\t        let cell = act.get(&(st, la.clone()));\r\n   348\t        match cell {\r\n   349\t            Some(Cell::S(n)) => {\r\n   350\t          "]
[32.120158, "o", "      vals.push(Node::Str(toks[ip].lex.clone()));\r\n   351\t                states.push(*n);\r\n   352\t                ip += 1;\r\n   353\t            }\r\n   354\t            Some(Cell::R(p)) => {\r\n   355\t                if *p >= prods.len() {\r\n   356\t                    return 1;\r\n   357\t                }\r\n   358\t                let prod = &prods[*p];\r\n   359\t                let n = prod.1.len();\r\n   360\t                if states.len() < n || vals.len() < n {\r\n"]
