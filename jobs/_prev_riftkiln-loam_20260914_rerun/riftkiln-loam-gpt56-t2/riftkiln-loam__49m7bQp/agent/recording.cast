[41.581503, "o", "printf '%s\\n' '--- patched grammar ---'; cat /app/cardhearth/card.yg; printf '%s\\n' '--- patched rib_c ---'; nl -ba /app/ribjoin/cursor.rs | sed -n '33,65p'; printf '%s\\n' '--- patched halt ---'; cat /app/ovenpit/halt.rs\r\n\u001b[?2004l\r"]
[41.582192, "o", "--- patched grammar ---\r\n"]
[41.585351, "o", "# rib_b\r\nS : YARD ID LBRACE MS RBRACE ;\r\nMS : MS M | ;\r\nM : PEG ID EQ VAL SEMI\r\n  | PEN ID LBRACE MS RBRACE\r\n  | CLIP ID\r\n  ;\r\n"]
[41.586205, "o", "--- patched rib_c ---\r\n"]
[41.588675, "o", "    33\tfn kind_of(n: &Node) -> String {\r\n    34\t    match map_get(n, \"kind\") {\r\n    35\t        Some(Node::Str(s)) => s.clone(),\r\n    36\t        _ => String::new(),\r\n    37\t    }\r\n"]
[41.589168, "o", "    38\t}\r\n    39\t\r\n    40\tpub fn rib_c(mut acc: Node, neu: Node) -> Node {\r\n    41\t    if let Node::List(ref mut items) = acc {\r\n    42\t        items.push(neu);\r\n    43\t    }\r\n    44\t    acc\r\n    45\t}\r\n    46\t\r\n    47\tfn to_json(n: &Node) -> String {\r\n    48\t    match n {\r\n    49\t        Node::Str(s) => format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")),\r\n    50\t        Node::List(xs) => {\r\n    51\t            let inner: Vec<String> = xs.iter().map(to_json).collect();\r\n    52\t            format!(\"[{}]\", inner.join(\",\"))\r\n    53\t        }\r\n    54\t        Node::Map(pairs) => {\r\n    55\t            let inner: Vec<String> = pairs\r\n    56\t                .iter()\r\n    57\t                .map(|(k, v)| format!(\"\\\"{}\\\":{}\", k, to_json(v)))\r\n    58\t                .collect();\r\n    59\t            format!(\"{{{}}}\", inner.join(\",\"))\r\n    60\t        }\r\n    61\t    }\r\n    62\t}\r\n    63\t\r\n    64\t#[derive(Clone)]\r\n    65\tenum Cell {\r\n"]
[41.589344, "o", "--- patched halt ---\r\n"]
[41.590616, "o", "fn rib_a(n: usize) -> i32 {\r\n    if n == 0 { 0 } else { 1 }\r\n}\r\n"]
[41.591282, "o", "\u001b[?2004hroot@c2f8198ebc58:/app# "]
[41.77549, "i", "/app/hearth.sh; rc=$?; echo HEARTH_RC=$rc; exit $rc\n"]
[41.776132, "o", "/app/hearth.sh; rc=$?; echo HEARTH_RC=$rc; exit $rc\r\n\u001b[?2004l\r"]
[42.062987, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: variable `I` should have a snake case name\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/ovenpit/oven.rs:156:16\u001b[0m\r\n\u001b[0m    \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m156\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m    fn closure(I: &BTreeSet<Item>, prods: &[(String, Vec<String>)], nts: &BTreeSet<String>) -> BTreeSet<Item> {\u001b[0m\r\n\u001b[0m    \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m                \u001b[0m\u001b[0m\u001b[1m\u001b[33m^\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[33mhelp: convert the identifier to snake case (notice the capitalization): `i`\u001b[0m\r\n\u001b[0m    \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m    \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(non_snake_case)]` on by default\u001b[0m\r\n\r\n"]
[42.063581, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: variable `I` should have a snake case name\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/ovenpit/oven.rs:180:9\u001b[0m\r\n\u001b[0m    \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m180\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m        I: &BTreeSet<Item>,\u001b[0m\r\n\u001b[0m    \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m         \u001b[0m\u001b[0m\u001b[1m\u001b[33m^\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[33mhelp: convert the identifier to snake case (notice the capitalization): `i`\u001b[0m\r\n\r\n"]
[46.667315, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: 2 warnings emitted\u001b[0m\r\n\r\n"]
[46.942551, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: type `Node` is more private than the item `rib_c`\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/drawbin/../ribjoin/cursor.rs:40:1\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m40\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn rib_c(mut acc: Node, neu: Node) -> Node {\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[33mfunction `rib_c` is reachable at visibility `pub`\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;10mnote\u001b[0m\u001b[0m: but type `Node` is only usable at visibility `pub(crate)`\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/drawbin/../ribjoin/cursor.rs:5:1\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m5\u001b[0m\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0menum Node {\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;10m^^^^^^^^^\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(private_interfaces)]` on by default\u001b[0m\r\n\r\n"]
[46.945351, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `map_get` is never used\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/drawbin/../ribjoin/cursor.rs:11:4\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m11\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mfn map_get<'a>(n: &'a Node, k: &str) -> Option<&'a Node> {\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m    \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^^^\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(dead_code)]` on by default\u001b[0m\r\n\r\n\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `kind_of` is never used\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/drawbin/../ribjoin/cursor.rs:33:4\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m33\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mfn kind_of(n: &Node) -> String {\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m    \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^^^\u001b[0m\r\n\r\n"]
