[19.17531, "o", "     1\tuse std::collections::BTreeMap;\r\n     2\tuse std::fs;\r\n     3\t\r\n     4\t#[derive(Clone, Debug)]\r\n     5\tenum Node {\r\n     6\t    Str(String),\r\n     7\t    List(Vec<Node>),\r\n     8\t    Map(Vec<(String, Node)>),\r\n     9\t}\r\n    10\t\r\n    11\tfn map_get<'a>(n: &'a Node, k: &str) -> Option<&'a Node> {\r\n    12\t    if let Node::Map(pairs) = n {\r\n    13\t        for (a, b) in pairs {\r\n    14\t            if a == k {\r\n    15\t                return Some(b);\r\n    16\t            }\r\n    17\t        }\r\n    18\t    }\r\n    19\t    None\r\n    20\t}\r\n    21\t\r\n    22\tfn map_get_mut<'a>(n: &'a mut Node, k: &str) -> Option<&'a mut Node> {\r\n    23"]
[19.175928, "o", "\t    if let Node::Map(pairs) = n {\r\n    24\t        for (a, b) in pairs.iter_mut() {\r\n    25\t            if a == k {\r\n    26\t                return Some(b);\r\n    27\t            }\r\n    28\t        }\r\n    29\t    }\r\n    30\t    None\r\n    31\t}\r\n    32\t\r\n    33\tfn kind_of(n: &Node) -> String {\r\n    34\t    match map_get(n, \"kind\") {\r\n    35\t        Some(Node::Str(s)) => s.clone(),\r\n    36\t        _ => String::new(),\r\n    37\t    }\r\n    38\t}\r\n    39\t\r\n    40\tpub fn rib_c(mut acc: Node, neu: Node) -> Node {\r\n    41\t    let k = kind_of(&neu);\r\n    42\t    if k == \"clip\" {\r\n    43\t        if let Node::List(ref mut items) = acc {\r\n    44\t            if let Some(last) = items.last_mut() {\r\n    45\t                if kind_of(last) == \"pen\" {\r\n    46\t                    if let Some(Node::Str(st)) = map_get(&neu, \"stem\") {\r\n    47\t                        let st = st.clone();\r\n    48\t                        if let Node::Map(pairs) = last {\r\n    49\t                            pairs.push((\"clip\".to_string(), Node::Str(st)));\r\n    50\t                            return acc;\r\n    51\t                        }\r\n    52\t                    }\r\n    53\t                }\r\n    54\t            }\r\n    55\t        }\r\n    56\t    }\r\n    57\t    if let Node::List(ref mut items) = acc {\r\n    58\t        items.push(neu);\r\n    59\t        return acc;\r\n    60\t    }\r\n    61\t    acc\r\n    62\t}\r\n    63\t\r\n    64\tfn to_json(n: &Node) -> String {\r\n    65\t    match n {\r\n    66\t        Node::Str(s) => format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")),\r\n    67\t        Node::List(xs) => {\r\n    68\t            let inner: Vec<String> = xs.iter().map(to_json).collect();\r\n    69\t            format!(\"[{}]\", inner.join(\",\"))\r\n    70\t        }\r\n    71\t        Node::Map(pairs) => {\r\n    72\t            let inner: Vec<String> = pairs\r\n    73\t                .iter()\r\n    74\t                .map(|(k, v)| format!(\"\\\"{}\\\":{}\", k, to_json(v)))\r\n    75\t                .collect();\r\n    76\t            format!(\"{{{}}}\", inner.join(\",\"))\r\n    77\t        }\r\n    78\t    }\r\n    79\t}\r\n    80\t\r\n    81\t#[derive(Clone)]\r\n    82\tenum Cell {\r\n    83\t    S(usize),\r\n    84\t    R(usize),\r\n    85\t    A,\r\n    86\t}\r\n    87\t\r\n    88\tfn load_action(path: &str) -> BTreeMap<(usize, String), Cell> {\r\n    89\t    let mut m = BTreeMap::new();\r\n    90\t    if let Ok(t) = fs::read_to_string(path) {\r\n    91\t        for line in t.lines() {\r\n    92\t            let p: Vec<&str> = line.split_whitespace().collect();\r\n    93\t            if p.len() < 4 {\r\n    94\t                continue;\r\n    95\t            }\r\n    96\t            let st: usize = p[0].parse().unwrap_or(0);\r\n    97\t            let tok = p[1].to_string();\r\n    98\t            m.insert(\r\n    99\t                (st, tok),\r\n   100\t                match p[2] {\r\n   101\t                    \"s\" => Cell::S(p[3].parse().unwrap_or(0)),\r\n   102\t                    \"r\" => Cell::R(p[3].parse().unwrap_or(0)),\r\n   103\t                    _ => Cell::A,\r\n   104\t                },\r\n   105\t            );\r\n   106\t        }\r\n   107\t    }\r\n   108\t    m\r\n   109\t}\r\n   110\t\r\n   111\tfn load_goto(path: &str) -> BTreeMap<(usize, String), usize> {\r\n   112\t    let mut m = BTreeMap::new();\r\n   113\t    if let Ok(t) = fs::read_to_string(path) {\r\n   114\t        for line in t.lines() {\r\n   115\t            let p: Vec<&str> = line.split_whitespace().collect();\r\n   116\t            if p.len() < 3 {\r\n   117\t                continue;\r\n   118\t            }\r\n   119\t            m.insert(\r\n   120\t                (p[0].parse().unwrap_or(0), p[1].to_string()),\r\n   121\t                p[2].parse().unwrap_or(0),\r\n   122\t            );\r\n   123\t        }\r\n   124\t    }\r\n   125\t    m\r\n   126\t}\r\n   127\t\r\n   128\tfn load_prod(path: &str) -> Vec<(String, Vec<String>)> {\r\n   129\t    let mut out = Vec::new();\r\n   130\t    let t = fs::read_to_string(path).unwrap_or_default();\r\n   131\t    let lines: Vec<&str> = t.lines().collect();\r\n   132\t    let mut i = 0;\r\n   133\t    while i < lines.len() {\r\n   134\t        let p: Vec<&str> = lines[i].split_whitespace().collect();\r\n   135\t        if p.len() >= 3 {\r\n   136\t            l"]
[19.17608, "o", "et n: usize = p[2].parse().unwrap_or(0);\r\n   137\t            let mut rhs = Vec::new();\r\n   138\t            for _ in 0..n {\r\n   139\t                i += 1;\r\n   140\t                if i < lines.len() {\r\n   141\t                    rhs.push(lines[i].trim().to_string());\r\n   142\t                }\r\n   143\t            }\r\n   144\t            let idx: usize = p[0].parse().unwrap_or(0);\r\n   145\t            while out.len() <= idx {\r\n   146\t                out.push((String::new(), Vec::new()));\r\n   147\t            }\r\n   148\t            out[idx] = (p[1].to_string(), rhs);\r\n   149\t        }\r\n   150\t        i += 1;\r\n   151\t    }\r\n   152\t    out\r\n   153\t}\r\n   154\t\r\n   155\t#[derive(Clone)]\r\n   156\tstruct Tok {\r\n   157\t    name: String,\r\n   158\t    lex: String,\r\n   159\t}\r\n   160\t\r\n   161\tfn lex(src: &str) -> Vec<Tok> {\r\n   162\t    let mut out = Vec::new();\r\n   163\t    let b = src.as_bytes();\r\n   164\t    let mut i = 0;\r\n   165\t    let mut after_eq = false;\r\n   166\t    while i < b.len() {\r\n   167\t        let c = b[i] as char;\r\n   168\t        if c.is_whitespace() {\r\n   169\t            i += 1;\r\n   170\t            continue;\r\n   171\t        }\r\n   172\t        if c == '{' {\r\n   173\t            out.push(Tok {\r\n   174\t                name: \"LBRACE\".into(),\r\n   175\t                lex: \"{\".into(),\r\n   176\t            });\r\n   177\t            i += 1;\r\n   178\t            continue;\r\n   179\t        }\r\n   180\t        if c == '}' {\r\n"]
[19.176198, "o", "--- cursor 181-380 ---\r\n"]
[19.178557, "o", "   181\t            out.push(Tok {\r\n   182\t                name: \"RBRACE\".into(),\r\n   183\t                lex: \"}\".into(),\r\n   184\t            });\r\n   185\t            i += 1;\r\n   186\t            continue;\r\n   187\t        }\r\n   188\t        if c == '=' {\r\n   189\t            out.push(Tok {\r\n   190\t                name: \"EQ\".into(),\r\n   191\t                lex: \"=\".into(),\r\n   192\t            });\r\n   193\t            after_eq = true;\r\n   194\t            i += 1;\r\n   195\t            continue;\r\n   196\t        }\r\n   197\t        if c == ';' {\r\n   198\t            out.push(Tok {\r\n   199\t                name: \"SEMI\".into(),\r\n   200\t                lex: \";\".into(),\r\n   201\t            });\r\n   202\t            i += 1;\r\n   203\t            continue;\r\n   204\t        }\r\n"]
[19.178633, "o", "   205\t        if c.is_ascii_alphanumeric() || c == '_' {\r\n   206\t            let s = i;\r\n   207\t            i += 1;\r\n   208\t            while i < b.len() {\r\n   209\t                let d = b[i] as char;\r\n   210\t                if d.is_ascii_alphanumeric() || d == '_' {\r\n   211\t                    i += 1;\r\n   212\t                } else {\r\n   213\t                    break;\r\n   214\t                }\r\n   215\t            }\r\n   216\t            let w = src[s..i].to_string();\r\n   217\t            if after_eq {\r\n   218\t                out.push(Tok {\r\n   219\t                    name: \"VAL\".into(),\r\n   220\t                    lex: w,\r\n   221\t                });\r\n   222\t                after_eq = false;\r\n   223\t            } else {\r\n   224\t                let name = match w.as_str() {\r\n   225\t                    \"yard\" => \"YARD\",\r\n   226\t                    \"pen\" => \"PEN\",\r\n   227\t                    \"clip\" => \"CLIP\",\r\n   228\t                    \"peg\" => \"PEG\",\r\n   229\t                    _ => \"ID\",\r\n   230\t                };\r\n   231\t                out.push(Tok {\r\n   232\t                    name: name.into(),\r\n   233\t                    lex: w,\r\n   234\t                });\r\n   235\t            }\r\n   236\t            continue;\r\n   237\t        }\r\n   238\t        i += 1;\r\n"]
