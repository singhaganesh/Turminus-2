     1	use std::collections::BTreeMap;
     2	use std::fs;
     3	
     4	#[derive(Clone, Debug)]
     5	enum Node {
     6	    Str(String),
     7	    List(Vec<Node>),
     8	    Map(Vec<(String, Node)>),
     9	}
    10	
    11	fn map_get<'a>(n: &'a Node, k: &str) -> Option<&'a Node> {
    12	    if let Node::Map(pairs) = n {
    13	        for (a, b) in pairs {
    14	            if a == k {
    15	                return Some(b);
    16	            }
    17	        }
    18	    }
    19	    None
    20	}
    21	
    22	fn map_get_mut<'a>(n: &'a mut Node, k: &str) -> Option<&'a mut Node> {
    23	    if let Node::Map(pairs) = n {
    24	        for (a, b) in pairs.iter_mut() {
    25	            if a == k {
    26	                return Some(b);
    27	            }
    28	        }
    29	    }
    30	    None
    31	}
    32	
    33	fn kind_of(n: &Node) -> String {
    34	    match map_get(n, "kind") {
    35	        Some(Node::Str(s)) => s.clone(),
    36	        _ => String::new(),
    37	    }
    38	}
    39	
    40	pub fn rib_c(mut acc: Node, neu: Node) -> Node {
    41	    if let Node::List(ref mut items) = acc {
    42	        if kind_of(&neu) == "clip" {
    43	            if let Some(last) = items.last_mut() {
    44	                if kind_of(last) == "pen" {
    45	                    if map_get(last, "clip").is_none() {
    46	                        if let Some(Node::Str(st)) = map_get(&neu, "stem") {
    47	                            let st = st.clone();
    48	                            if let Node::Map(pairs) = last {
    49	                                pairs.push(("clip".to_string(), Node::Str(st)));
    50	                                return acc;
    51	                            }
    52	                        }
    53	                    }
    54	                }
    55	            }
    56	        }
    57	        items.push(neu);
    58	        return acc;
    59	    }
    60	    acc
    61	}
    62	
    63	fn to_json(n: &Node) -> String {
    64	    match n {
    65	        Node::Str(s) => format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\"")),
    66	        Node::List(xs) => {
    67	            let inner: Vec<String> = xs.iter().map(to_json).collect();
    68	            format!("[{}]", inner.join(","))
    69	        }
    70	        Node::Map(pairs) => {
    71	            let inner: Vec<String> = pairs
    72	                .iter()
    73	                .map(|(k, v)| format!("\"{}\":{}", k, to_json(v)))
    74	                .collect();
    75	            format!("{{{}}}", inner.join(","))
    76	        }
    77	    }
    78	}
    79	
    80	#[derive(Clone)]
    81	enum Cell {
    82	    S(usize),
    83	    R(usize),
    84	    A,
    85	}
    86	
    87	fn load_action(path: &str) -> BTreeMap<(usize, String), Cell> {
    88	    let mut m = BTreeMap::new();
    89	    if let Ok(t) = fs::read_to_string(path) {
    90	        for line in t.lines() {
    91	            let p: Vec<&str> = line.split_whitespace().collect();
    92	            if p.len() < 4 {
    93	                continue;
    94	            }
    95	            let st: usize = p[0].parse().unwrap_or(0);
    96	            let tok = p[1].to_string();
    97	            m.insert(
    98	                (st, tok),
    99	                match p[2] {
   100	                    "s" => Cell::S(p[3].parse().unwrap_or(0)),
   101	                    "r" => Cell::R(p[3].parse().unwrap_or(0)),
   102	                    _ => Cell::A,
   103	                },
   104	            );
   105	        }
   106	    }
   107	    m
   108	}
   109	
   110	fn load_goto(path: &str) -> BTreeMap<(usize, String), usize> {
   111	    let mut m = BTreeMap::new();
   112	    if let Ok(t) = fs::read_to_string(path) {
   113	        for line in t.lines() {
   114	            let p: Vec<&str> = line.split_whitespace().collect();
   115	            if p.len() < 3 {
   116	                continue;
   117	            }
   118	            m.insert(
   119	                (p[0].parse().unwrap_or(0), p[1].to_string()),
   120	                p[2].parse().unwrap_or(0),
   121	            );
   122	        }
   123	    }
   124	    m
   125	}
   126	
   127	fn load_prod(path: &str) -> Vec<(String, Vec<String>)> {
   128	    let mut out = Vec::new();
   129	    let t = fs::read_to_string(path).unwrap_or_default();
   130	    let lines: Vec<&str> = t.lines().collect();
   131	    let mut i = 0;
   132	    while i < lines.len() {
   133	        let p: Vec<&str> = lines[i].split_whitespace().collect();
   134	        if p.len() >= 3 {
   135	            let n: usize = p[2].parse().unwrap_or(0);
   136	            let mut rhs = Vec::new();
   137	            for _ in 0..n {
   138	                i += 1;
   139	                if i < lines.len() {
   140	                    rhs.push(lines[i].trim().to_string());
   141	                }
   142	            }
   143	            let idx: usize = p[0].parse().unwrap_or(0);
   144	            while out.len() <= idx {
   145	                out.push((String::new(), Vec::new()));
   146	            }
   147	            out[idx] = (p[1].to_string(), rhs);
   148	        }
   149	        i += 1;
   150	    }
   151	    out
   152	}
   153	
   154	#[derive(Clone)]
   155	struct Tok {
   156	    name: String,
   157	    lex: String,
   158	}
   159	
   160	fn lex(src: &str) -> Vec<Tok> {
   161	    let mut out = Vec::new();
   162	    let b = src.as_bytes();
   163	    let mut i = 0;
   164	    let mut after_eq = false;
   165	    while i < b.len() {
   166	        let c = b[i] as char;
   167	        if c.is_whitespace() {
   168	            i += 1;
   169	            continue;
   170	        }
   171	        if c == '{' {
   172	            out.push(Tok {
   173	                name: "LBRACE".into(),
   174	                lex: "{".into(),
   175	            });
   176	            i += 1;
   177	            continue;
   178	        }
   179	        if c == '}' {
   180	            out.push(Tok {
   181	                name: "RBRACE".into(),
   182	                lex: "}".into(),
   183	            });
   184	            i += 1;
   185	            continue;
   186	        }
   187	        if c == '=' {
   188	            out.push(Tok {
   189	                name: "EQ".into(),
   190	                lex: "=".into(),
   191	            });
   192	            after_eq = true;
   193	            i += 1;
   194	            continue;
   195	        }
   196	        if c == ';' {
   197	            out.push(Tok {
   198	                name: "SEMI".into(),
   199	                lex: ";".into(),
   200	            });
   201	            i += 1;
   202	            continue;
   203	        }
   204	        if c.is_ascii_alphanumeric() || c == '_' {
   205	            let s = i;
   206	            i += 1;
   207	            while i < b.len() {
   208	                let d = b[i] as char;
   209	                if d.is_ascii_alphanumeric() || d == '_' {
   210	                    i += 1;
   211	                } else {
   212	                    break;
   213	                }
   214	            }
   215	            let w = src[s..i].to_string();
   216	            if after_eq {
   217	                out.push(Tok {
   218	                    name: "VAL".into(),
   219	                    lex: w,
   220	                });
   221	                after_eq = false;
   222	            } else {
   223	                let name = match w.as_str() {
   224	                    "yard" => "YARD",
   225	                    "pen" => "PEN",
   226	                    "clip" => "CLIP",
   227	                    "peg" => "PEG",
   228	                    _ => "ID",
   229	                };
   230	                out.push(Tok {
   231	                    name: name.into(),
   232	                    lex: w,
   233	                });
   234	            }
   235	            continue;
   236	        }
   237	        i += 1;
   238	    }
   239	    out.push(Tok {
   240	        name: "$".into(),
   241	        lex: "".into(),
   242	    });
   243	    out
   244	}
   245	
   246	fn reduce_node(prod: &(String, Vec<String>), kids: Vec<Node>) -> Node {
   247	    let lhs = &prod.0;
   248	    let rhs = &prod.1;
   249	    if lhs == "MS" && rhs.is_empty() {
   250	        return Node::List(Vec::new());
   251	    }
   252	    if lhs == "MS" && rhs.len() == 2 {
   253	        return rib_c(kids[0].clone(), kids[1].clone());
   254	    }
   255	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("PEG") {
   256	        let tag = if let Node::Str(s) = &kids[1] {
   257	            s.clone()
   258	        } else {
   259	            String::new()
   260	        };
   261	        let mark = if let Node::Str(s) = &kids[3] {
   262	            s.clone()
   263	        } else {
   264	            String::new()
   265	        };
   266	        return Node::Map(vec![
   267	            ("kind".into(), Node::Str("peg".into())),
   268	            ("tag".into(), Node::Str(tag)),
   269	            ("mark".into(), Node::Str(mark)),
   270	        ]);
   271	    }
   272	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("CLIP") && rhs.len() == 2 {
   273	        let stem = if let Node::Str(s) = &kids[1] {
   274	            s.clone()
   275	        } else {
   276	            String::new()
   277	        };
   278	        return Node::Map(vec![
   279	            ("kind".into(), Node::Str("clip".into())),
   280	            ("stem".into(), Node::Str(stem)),
   281	        ]);
   282	    }
   283	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("PEN") {
   284	        let stem = if let Node::Str(s) = &kids[1] {
   285	            s.clone()
   286	        } else {
   287	            String::new()
   288	        };
   289	        let members = kids[3].clone();
   290	        let mut pairs = vec![
   291	            ("kind".into(), Node::Str("pen".into())),
   292	            ("stem".into(), Node::Str(stem)),
   293	            ("members".into(), members),
   294	        ];
   295	        if rhs.len() >= 7 {
   296	            let cl = if let Node::Str(s) = &kids[6] {
   297	                s.clone()
   298	            } else {
   299	                String::new()
   300	            };
   301	            pairs.push(("clip".into(), Node::Str(cl)));
   302	        }
   303	        return Node::Map(pairs);
   304	    }
   305	    if lhs == "S" {
   306	        let yard = if let Node::Str(s) = &kids[1] {
   307	            s.clone()
   308	        } else {
   309	            String::new()
   310	        };
   311	        let members = kids[3].clone();
   312	        return Node::Map(vec![
   313	            ("yard".into(), Node::Str(yard)),
   314	            ("members".into(), members),
   315	        ]);
   316	    }
   317	    if lhs == "S'" {
   318	        return kids[0].clone();
   319	    }
   320	    Node::List(kids)
   321	}
   322	
   323	fn tbl_dir() -> String {
   324	    std::env::var("ACTRIB").unwrap_or_else(|_| "/app/tblwell".to_string())
   325	}
   326	
   327	pub fn run_sift(src: &str, dest: &str) -> i32 {
   328	    let text = match fs::read_to_string(src) {
   329	        Ok(t) => t,
   330	        Err(_) => return 1,
   331	    };
   332	    let toks = lex(&text);
   333	    let base = tbl_dir();
   334	    let act = load_action(&format!("{}/action.tbl", base));
   335	    let gtbl = load_goto(&format!("{}/goto.tbl", base));
   336	    let prods = load_prod(&format!("{}/prod.tbl", base));
   337	    let mut states: Vec<usize> = vec![0];
   338	    let mut vals: Vec<Node> = Vec::new();
   339	    let mut ip = 0;
   340	    loop {
   341	        if ip >= toks.len() {
   342	            return 1;
   343	        }
   344	        let st = *states.last().unwrap();
   345	        let la = &toks[ip].name;
   346	        let cell = act.get(&(st, la.clone()));
   347	        match cell {
   348	            Some(Cell::S(n)) => {
   349	                vals.push(Node::Str(toks[ip].lex.clone()));
   350	                states.push(*n);
   351	                ip += 1;
   352	            }
   353	            Some(Cell::R(p)) => {
   354	                if *p >= prods.len() {
   355	                    return 1;
   356	                }
   357	                let prod = &prods[*p];
   358	                let n = prod.1.len();
   359	                if states.len() < n || vals.len() < n {
   360	                    return 1;
   361	                }
   362	                let mut kids = Vec::new();
   363	                for _ in 0..n {
   364	                    states.pop();
   365	                    kids.push(vals.pop().unwrap());
   366	                }
   367	                kids.reverse();
   368	                let built = reduce_node(prod, kids);
   369	                let st2 = *states.last().unwrap();
   370	                match gtbl.get(&(st2, prod.0.clone())) {
   371	                    Some(ns) => {
   372	                        vals.push(built);
   373	                        states.push(*ns);
   374	                    }
   375	                    None => {
   376	                        if prod.0 == "S'" {
