[21.492955, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/tblwell /app/markcue /app/treypit\r\n     5\trm -f /app/markcue/brew.ok\r\n     6\trustc --edition 2021 -O /app/ovenpit/oven.rs -o /app/bin/tblbake\r\n     7\tset +e\r\n     8\t/app/bin/tblbake /app/cardhearth/card.yg /app/tblwell\r\n     9\tec=$?\r\n    10\tset -e\r\n    11\tif [ \"$ec\" -ne 0 ]; then\r\n    12\t  exit \"$ec\"\r\n    13\tfi\r\n    14\trustc --edition 2021 -O /app/drawbin/boot.rs -o /app/bin/riftkiln\r\n    15\ttouch /app/markcue/brew.ok\r\n    16\t/app/bin/riftkiln sift /app/flatpit/flat.quern /app/treypit/flat.json\r\n"]
[21.493445, "o", "--- MILL ---\r\n"]
[21.494411, "o", "tblbake reads card.yg and writes tblwell tables. ribjoin walks reduce numbers from prod.tbl.\r\n"]
[21.4947, "o", "--- BAKE ---\r\n"]
[21.495846, "o", "tblbake argv: RECIPE OUTDIR. Writes quarrel.lst then action.tbl, goto.tbl, prod.tbl when the mill accepts the recipe.\r\n"]
[21.496114, "o", "--- WALK ---\r\n"]
[21.497412, "o", "boot.rs includes cursor.rs. sift tokenizes a quern file, drives action.tbl, and writes the destination object.\r\n"]
[21.498119, "o", "--- card ---\r\n"]
[21.499343, "o", "     1\t# rib_b\r\n     2\tS : YARD ID LBRACE MS RBRACE ;\r\n     3\tMS : MS M | ;\r\n     4\tM : PEG ID EQ VAL SEMI\r\n     5\t  | PEN ID LBRACE MS RBRACE CLIP ID\r\n     6\t  | PEN ID LBRACE MS RBRACE\r\n     7\t  | CLIP ID\r\n     8\t  ;\r\n"]
[21.499658, "o", "--- flat ---\r\n"]
[21.501014, "o", "     1\tyard south {\r\n     2\t  peg a = 1;\r\n     3\t  clip dry\r\n     4\t}\r\n"]
[21.501395, "o", "--- marker/quarrel ---\r\n"]
[21.505827, "o", "-rw-r--r-- 1 root root   0 Sep 14 03:32 /app/markcue/brew.ok\r\n-rw-r--r-- 1 root root 565 Sep 14 03:32 /app/tblwell/action.tbl\r\n-rw-r--r-- 1 root root  35 Sep 14 03:32 /app/tblwell/goto.tbl\r\n-rw-r--r-- 1 root root 193 Sep 14 03:32 /app/tblwell/prod.tbl\r\n-rw-r--r-- 1 root root  17 Sep 14 03:32 /app/tblwell/quarrel.lst\r\n"]
[21.509056, "o", "state 19 tok CLIP"]
