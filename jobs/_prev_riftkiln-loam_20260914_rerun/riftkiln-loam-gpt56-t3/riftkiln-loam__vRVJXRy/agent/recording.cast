[40.711791, "o", "     1\tuse std::collections::{BTreeMap, BTreeSet};\r\n     2\tuse std::env;\r\n     3\tuse std::fs;\r\n     4\tuse std::process;\r\n     5\t\r\n     6\tinclude!(\"halt.rs\");\r\n     7\t\r\n     8\ttype Item = (usize, usize);\r\n     9\t\r\n    10\t#[derive(Clone, Debug, PartialEq, Eq)]\r\n    11\tenum Act {\r\n    12\t    Shift(usize),\r\n    13\t    Reduce(usize),\r\n    14\t    Acc,\r\n    15\t}\r\n    16\t\r\n    17\tfn main() {\r\n    18\t    let args: Vec<String> = env::args().collect();\r\n    19\t    if args.len() < 3 {\r\n    20\t        eprintln!(\"usage: tblbake RECIPE OUTDIR\");\r\n    21\t        process::exit(2);\r\n    22\t    }\r\n    23\t    let text = fs::read_to_string(&args[1]).expect(\"recipe\");\r\n    24\t    let out = args[2].trim_end_matches('/').to_string();\r\n    25\t    let _ = fs::create_dir_all(&out);\r\n    26\t\r\n    27\t    let mut prods: Vec<(String, Vec<String>)> = Vec::new();\r\n    28\t    prods.push((\"S'\".to_string(), vec![\"S\".to_string()]));\r\n    29\t    let mut body = String::new();\r\n    30\t    for line in text.lines() {\r\n    31\t        let t = line.trim();\r\n    32\t        if t.is_empty() || t.starts_with('#') {\r\n    33\t            continue;\r\n    34\t        }\r\n    35\t        body.push_str(t);\r\n    36\t        body.push(' ');\r\n    37\t    }\r\n    38\t    for chunk in body.split(';') {\r\n    39\t        let chunk = chunk.trim();\r\n    40\t        if chunk.is_empty() {\r\n    41\t            continue;\r\n    42\t        }\r\n    43\t        let Some((lhs, rhs)) = chunk.split_once(':') else {\r\n    44\t            continue;\r\n    45\t        };\r\n    46\t        let lhs = lhs.trim().to_string();\r\n    47\t        for alt in rhs.split('|') {\r\n    48\t            let syms: Vec<String> = alt.split_whitespace().map(|s| s.to_string()).collect();\r\n    49\t            prods.push((lhs.clone(), syms));\r\n    50\t        }\r\n    51\t    }\r\n    52\t\r\n    53\t    let mut nts: BTreeSet<String> = BTreeSet::new();\r\n    54\t    for (l, _) in &prods {\r\n    55\t        nts.insert(l.clone());\r\n    56\t    }\r\n    57\t    let mut terms: BTreeSet<String> = BTreeSet::new();\r\n    58\t    terms.insert(\"$\".to_string());\r\n    59\t    for (_, rhs) in &prods {\r\n    60\t        for s in rhs {\r\n    61\t            if !nts.contains(s) {\r\n    62\t                terms.insert(s.clone());\r\n    63\t            }\r\n    64\t        }\r\n    65\t    }\r\n    66\t\r\n    67\t    let mut first: BTreeMap<String, BTreeSet<Option<String>>> = BTreeMap::new();\r\n    68\t    for nt in &nts {\r\n    69\t        first.insert(nt.clone(), BTreeSet::new());\r\n    70\t    }\r\n    71\t    for t in &terms {\r\n    72\t        let mut s = BTreeSet::new();\r\n    73\t        s.insert(Some(t.clone()));\r\n    74\t        first.insert(t.clone(), s);\r\n    75\t    }\r\n    76\t    let mut changed = true;\r\n    77\t    while changed {\r\n    78\t        changed = false;\r\n    79\t        for (lhs, rhs) in &prods {\r\n    80\t            if rhs.is_empty() {\r\n\u001b[?2004hroot@f353490f9a59:/app# "]
