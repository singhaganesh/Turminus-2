[21.909644, "o", "--- cursor 1-380 ---\r\n"]
[21.912514, "o", "     1\tuse std::collections::BTreeMap;\r\n     2\tuse std::fs;\r\n     3\t\r\n     4\t#[derive(Clone, Debug)]\r\n     5\tenum Node {\r\n     6\t    Str(String),\r\n     7\t    List(Vec<Node>),\r\n     8\t    Map(Vec<(String, Node)>),\r\n"]
[21.912759, "o", "     9\t}\r\n    10\t\r\n    11\tfn map_get<'a>(n: &'a Node, k: &str) -> Option<&'a Node> {\r\n    12\t    if let Node::Map(pairs) = n {\r\n    13\t        for (a, b) in pairs {\r\n    14\t            if a == k {\r\n    15\t                return Some(b);\r\n    16\t            }\r\n    17\t        }\r\n    18\t    }\r\n    19\t    None\r\n    20\t}\r\n    21\t\r\n    22\tfn map_get_mut<'a>(n: &'a mut Node, k: &str) -> Option<&'a mut Node> {\r\n    23\t    if let Node::Map(pairs) = n {\r\n    24\t        for (a, b) in pairs.iter_mut() {\r\n    25\t            if a == k {\r\n    26\t                return Some(b);\r\n    27\t            }\r\n    28\t        }\r\n    29\t    }\r\n    30\t    None\r\n    31\t}\r\n    32\t\r\n    33\tfn kind_of(n: &Node) -> String {\r\n    34\t    match map_get(n, \"kind\") {\r\n    35\t        Some(Node::Str(s)) => s.clone(),\r\n    36\t        _ => String::new(),\r\n    37\t    }\r\n    38\t}\r\n    39\t\r\n    40\tpub fn rib_c(mut acc: Node, neu: Node) -> Node {\r\n    41\t    if let Node::List(ref mut items) = acc {\r\n    42\t        if kind_of(&neu) == \"clip\" {\r\n    43\t            if let Some(last) = items.last_mut() {\r\n    44\t                if kind_of(last) == \"pen\" {\r\n    45\t                    if map_get(last, \"clip\").is_none() {\r\n    46\t                        if let Some(Node::Str(st)) = map_get(&neu, \"stem\") {\r\n    47\t                            let st = st.clone();\r\n    48\t                            if let Node::Map(pairs) = last {\r\n    49\t                                pairs.push((\"clip\".to_string(), Node::Str(st)));\r\n    50\t                                return acc;\r\n    51\t                            }\r\n    52\t                        }\r\n    53\t                    }\r\n    54\t                }\r\n    55\t            }\r\n    56\t        }\r\n    57\t        items.push(neu);\r\n    58\t        return acc;\r\n    59\t    }\r\n    60\t    acc\r\n    61\t}\r\n    62\t\r\n"]
[21.912934, "o", "    63\tfn to_json(n: &Node) -> String {\r\n    64\t    match n {\r\n    65\t        Node::Str(s) => format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")),\r\n    66\t        Node::List(xs) => {\r\n    67\t            let inner: Vec<String> = xs.iter().map(to_json).collect();\r\n    68\t            format!(\"[{}]\", inner.join(\",\"))\r\n    69\t        }\r\n    70\t        Node::Map(pairs) => {\r\n    71\t            let inner: Vec<String> = pairs\r\n    72\t                .iter()\r\n    73\t                .map(|(k, v)| format!(\"\\\"{}\\\":{}\", k, to_json(v)))\r\n    74\t                .collect();\r\n    75\t            format!(\"{{{}}}\", inner.join(\",\"))\r\n    76\t        }\r\n    77\t    }\r\n    78\t}\r\n    79\t\r\n    80\t#[derive(Clone)]\r\n    81\tenum Cell {\r\n    82\t    S(usize),\r\n    83\t    R(usize),\r\n    84\t    A,\r\n    85\t}\r\n    86\t\r\n    87\tfn load_action(path: &str) -> BTreeMap<(usize, String), Cell> {\r\n    88\t    let mut m = BTreeMap::new();\r\n    89\t    if let Ok(t) = fs::read_to_string(path) {\r\n    90\t        for line in t.lines() {\r\n    91\t            let p: Vec<&str> = line.split_whitespace().collect();\r\n    92\t            if p.len() < 4 {\r\n    93\t                continue;\r\n    94\t            }\r\n    95\t            let st: usize = p[0].parse().unwrap_or(0);\r\n    96\t            let tok = p[1].to_string();\r\n    97\t            m.insert(\r\n    98\t                (st, tok),\r\n    99\t                match p[2] {\r\n   100\t                    \"s\" => Cell::S(p[3].parse().unwrap_or(0)),\r\n   101\t                    \"r\" => Cell::R(p[3].parse().unwrap_or(0)),\r\n   102\t                    _ => Cell::A,\r\n"]
[21.912972, "o", "   103\t                },\r\n   104\t            );\r\n   105\t        }\r\n   106\t    }\r\n   107\t    m\r\n   108\t}\r\n   109\t\r\n   110\tfn load_goto(path: &str) -> BTreeMap<(usize, String), usize> {\r\n   111\t    let mut m = BTreeMap::new();\r\n   112\t    if let Ok(t) = fs::read_to_string(path) {\r\n   113\t        for line in t.lines() {\r\n   114\t            let p: Vec<&str> = line.split_whitespace().collect();\r\n   115\t            if p.len() < 3 {\r\n   116\t                continue;\r\n   117\t            }\r\n   118\t            m.insert(\r\n   119\t                (p[0].parse().unwrap_or(0), p[1].to_string()),\r\n   120\t                p[2].parse().unwrap_or(0),\r\n   121\t            );\r\n   122\t        }\r\n   123\t    }\r\n   124\t    m\r\n   125\t}\r\n   126\t\r\n   127\tfn load_prod(path: &str) -> Vec<(String, Vec<String>)> {\r\n   128\t    let mut out = Vec::new();\r\n   129\t    let t = fs::read_to_string(path).unwrap_or_default();\r\n   130\t    let lines: Vec<&str> = t.lines().collect();\r\n   131\t    let mut i = 0;\r\n"]
[21.913099, "o", "   132\t    while i < lines.len() {\r\n   133\t        let p: Vec<&str> = lines[i].split_whitespace().collect();\r\n   134\t        if p.len() >= 3 {\r\n   135\t            let n: usize = p[2].parse().unwrap_or(0);\r\n   136\t            let mut rhs = Vec::new();\r\n   137\t            for _ in 0..n {\r\n   138\t                i += 1;\r\n   139\t                if i < lines.len() {\r\n   140\t                    rhs.push(lines[i].trim().to_string());\r\n   141\t                }\r\n   142\t            }\r\n   143\t            let idx: usize = p[0].parse().unwrap_or(0);\r\n   144\t            while out.len() <= idx {\r\n   145\t                out.push((String::new(), Vec::new()));\r\n   146\t            }\r\n   147\t            out[idx] = (p[1].to_string(), rhs);\r\n   148\t        }\r\n   149\t        i += 1;\r\n   150\t    }\r\n   151\t    out\r\n   152\t}\r\n   153\t\r\n   154\t#[derive(Clone)]\r\n   155\tstruct Tok {\r\n   156\t    name: String,\r\n   157\t    lex: String,\r\n"]
[21.913498, "o", "   158\t}\r\n   159\t\r\n   160\tfn lex(src: &str) -> Vec<Tok> {\r\n   161\t    let mut out = Vec::new();\r\n   162\t    let b = src.as_bytes();\r\n   163\t    let mut i = 0;\r\n   164\t    let mut after_eq = false;\r\n   165\t    while i < b.len() {\r\n   166\t        let c = b[i] as char;\r\n   167\t        if c.is_whitespace() {\r\n   168\t            i += 1;\r\n   169\t            continue;\r\n   170\t        }\r\n   171\t        if c == '{' {\r\n   172\t            out.push(Tok {\r\n   173\t                name: \"LBRACE\".into(),\r\n   174\t                lex: \"{\".into(),\r\n   175\t            });\r\n   176\t            i += 1;\r\n   177\t            continue;\r\n   178\t        }\r\n   179\t        if c == '}' {\r\n   180\t            out.push(Tok {\r\n   181\t                name: \"RBRACE\".into(),\r\n   182\t                lex: \"}\".into(),\r\n   183\t            });\r\n   184\t            i += 1;\r\n   185\t            continue;\r\n   186\t        }\r\n   187\t        if c == '=' {\r\n   188\t            out.push(Tok {\r\n   189\t                name: \"EQ\".into(),\r\n   190\t                lex: \"=\".into(),\r\n   191\t            });\r\n   192\t            after_eq = true;\r\n   193\t            i += 1;\r\n   194\t            continue;\r\n   195\t        }\r\n   196\t        if c == ';' {\r\n   197\t            out.push(Tok {\r\n   198\t                name: \"SEMI\".into(),\r\n   199\t                lex: \";\".into(),\r\n   200\t            });\r\n   201\t            i += 1;\r\n   202\t            continue;\r\n   203\t        }\r\n   204\t        if c.is_ascii_alphanumeric() || c == '_' {\r\n   205\t            let s = i;\r\n   206\t            i += 1;\r\n   207\t            while i < b.len() {\r\n   208\t                let d = b[i] as char;\r\n   209\t                if d.is_ascii_alphanumeric() || d == '_' {\r\n   210\t                    i += 1;\r\n   211\t                } else {\r\n   212\t                    break;\r\n   213\t                }\r\n   214\t            }\r\n   215\t            let w = src[s..i].to_string();\r\n   216\t            if after_eq {\r\n   217\t                out.push(Tok {\r\n   218\t                    name: \"VAL\".into(),\r\n   219\t                    lex: w,\r\n   220\t                });\r\n   221\t                after_eq = false;\r\n   222\t            } else {\r\n   223\t                let name = match w.as_str() {\r\n   224\t                    \"yard\" => \"YARD\",\r\n   225\t                    \"pen\" => \"PEN\",\r\n   226\t                    \"clip\" => \"CLIP\",\r\n   227\t                    \"peg\" => \"PEG\",\r\n   228\t                    _ => \"ID\",\r\n   229\t                };\r\n   230\t                out.push(Tok {\r\n   231\t                    name: name.into(),\r\n   232\t                    lex: w,\r\n   233\t                });\r\n   234\t            }\r\n   235\t            continue;\r\n   236\t        }\r\n   237\t        i += 1;\r\n   238\t    }\r\n   239\t    out.push(Tok {\r\n   240\t        name: \"$\".into(),\r\n   241\t        lex: \"\".into(),\r\n   242\t    });\r\n   243\t    out\r\n   244\t}\r\n   245\t\r\n   246\tfn reduce_node(prod: &(String, Vec<String>), kids: Vec<Node>) -> Node {\r\n   247\t    let lhs = &prod.0;\r\n   248\t    let rhs = &prod.1;\r\n   249\t    if lhs == \"MS\" && rhs.is_empty() {\r\n   250\t        return Node::List(Vec::new());\r\n   251\t    }\r\n   252\t    if lhs == \"MS\" && rhs.len() == 2 {\r\n   253\t        return rib_c(kids[0].clone(), kids[1].clone());\r\n   254\t    }\r\n   255\t    if lhs == \"M\" && rhs.first().map(|s| s.as_str()) == Some(\"PEG\") {\r\n   256\t        let tag = if let Node::Str(s) = &kids[1] {\r\n   257\t            s.clone()\r\n   258\t        } else {\r\n   259\t            String::new()\r\n   260\t        };\r\n   261\t        let mark = if let Node::Str(s) = &kids[3] {\r\n   262\t            s.clone()\r\n   263\t        } else {\r\n   264\t            String::new()\r\n   265\t        };\r\n   266\t        return Node::Map(vec![\r\n   267\t            (\"kind\".into(), Node::Str(\"peg\".into())),\r\n   268\t            (\"tag\".into(), Node::Str(tag)),\r\n   269\t            (\"mark\".into(), Node::Str(mark)),\r\n   270\t        ]);\r\n   271\t    }\r\n   272\t    if lhs == \"M\" && rhs.first().map(|s| s.as_str()) == Some(\"CLIP\") && rhs.len() == 2 {\r\n   273\t        let stem = if let Node::Str(s) = &kids[1] {\r\n   274\t            s.clone()\r\n   275\t        } else {\r\n   276\t            String::new()\r\n   277\t        };\r\n   278\t        return Node::Map(vec![\r\n   279\t            (\"kind\".into(), Node::Str(\"clip\".into())),\r\n   280\t            (\"stem\".into(), Node::Str(stem)),\r\n   281\t        ]);\r\n   282\t    }\r\n   283\t    if lhs == \"M\" && rhs.first().map(|s| s.as_str()) == Some(\"PEN\") {\r\n   284\t        let stem = if let Node::Str(s) = &kids[1] {\r\n   285\t            s.clone()\r\n   286\t        } else {\r\n   287\t            String::new()\r\n   288\t        };\r\n   289\t        let members = kids[3].clone();\r\n   290\t        let mut pairs = vec![\r\n   291\t            (\"kind\".into(), Node::Str(\"pen\".into())),\r\n   292\t            (\"stem\".into(), Node::Str(stem)),\r\n   293\t            (\"members\".into(), members),\r\n   294\t        ];\r\n   295\t        if rhs.len() >= 7 {\r\n   296\t            let cl = if let Node::Str(s) = &kids[6] {\r\n   297\t                s.clone()\r\n   298\t            } else {\r\n   299\t                String::new()\r\n   300\t            };\r\n   301\t            pairs.push((\"clip\".into(), Node::Str(cl)));\r\n   302\t        }\r\n   303\t        return Node::Map(pairs);\r\n   304\t    }\r\n   305\t    if lhs == \"S\" {\r\n"]
[21.914005, "o", "   306\t        let yard = if let Node::Str(s) = &kids[1] {\r\n   307\t            s.clone()\r\n   308\t        } else {\r\n   309\t            String::new()\r\n   310\t        };\r\n   311\t        let members = kids[3].clone();\r\n   312\t        return Node::Map(vec![\r\n   313\t            (\"yard\".into(), Node::Str(yard)),\r\n   314\t            (\"members\".into(), members),\r\n   315\t        ]);\r\n   316\t    }\r\n   317\t    if lhs == \"S'\" {\r\n   318\t        return kids[0].clone();\r\n   319\t    }\r\n   320\t    Node::List(kids)\r\n   321\t}\r\n   322\t\r\n   323\tfn tbl_dir() -> String {\r\n   324\t    std::env::var(\"ACTRIB\").unwrap_or_else(|_| \"/app/tblwell\".to_string())\r\n   325\t}\r\n   326\t\r\n   327\tpub fn run_sift(src: &str, dest: &str) -> i32 {\r\n   328\t    let text = match fs::read_to_string(src) {\r\n   329\t        Ok(t) => t,\r\n   330\t        Err(_) => return 1,\r\n   331\t    };\r\n   332\t    let toks = lex(&text);\r\n   333\t    let base = tbl_dir();\r\n   334\t    let act = load_action(&format!(\"{}/action.tbl\", base));\r\n   335\t    let gtbl = load_goto(&format!(\"{}/goto.tbl\", base));\r\n   336\t    let prods = load_prod(&format!(\"{}/prod.tbl\", base));\r\n   337\t    let mut states: Vec<usize> = vec![0];\r\n   338\t    let mut vals: Vec<Node> = Vec::new();\r\n   339\t    let mut ip = 0;\r\n   340\t    loop {\r\n   341\t        if ip >= toks.len() {\r\n   342\t            return 1;\r\n   343\t        }\r\n   344\t        let st = *states.last().unwrap();\r\n   345\t        let la = &toks[ip].name;\r\n   346\t        let cell = act.get(&(st, la.clone()));\r\n   347\t        match cell {\r\n   348\t            Some(Cell::S(n)) => {\r\n   349\t                vals.push(Node::Str(toks[ip].lex.clone()));\r\n   350\t                states.push(*n);\r\n   351\t                ip += 1;\r\n   352\t            }\r\n   353\t            Some(Cell::R(p)) => {\r\n   354\t                if *p >= prods.len() {\r\n   355\t                    return 1;\r\n   356\t                }\r\n   357\t                let prod = &prods[*p];\r\n   358\t                let n = prod.1.len();\r\n   359\t                if states.len() < n || vals.len() < n {\r\n   360\t                    return 1;\r\n   361\t                }\r\n   362\t                let mut kids = Vec::new();\r\n   363\t                for _ in 0..n {\r\n   364\t                    states.pop();\r\n   365\t                    kids.push(vals.pop().unwrap());\r\n   366\t                }\r\n   367\t                kids.reverse();\r\n   368\t                let built = reduce_node(prod, kids);\r\n   369\t                let st2 = *states.last().unwrap();\r\n   370\t                match gtbl.get(&(st2, prod.0.clone())) {\r\n   371\t                    Some(ns) => {\r\n   372\t                        vals.push(built);\r\n   373\t                        states.push(*ns);\r\n   374\t                    }\r\n   375\t                    None => {\r\n   376\t                        if prod.0 == \"S'\" {\r\n   377\t                            let _ = fs::write(dest, to_json(&built));\r\n   378\t                            return 0;\r\n   379\t                        }\r\n   380\t                        return 1;\r\n   381\t                    }\r\n   382\t                }\r\n   383\t            }\r\n   384\t            Some(Cell::A) => {\r\n   385\t                if let Some(built) = vals.last() {\r\n   386\t                    let _ = fs::write(dest, to_json(built));\r\n   387\t                    return 0;\r\n   388\t                }\r\n   389\t                return 1;\r\n   390\t            }\r\n"]
