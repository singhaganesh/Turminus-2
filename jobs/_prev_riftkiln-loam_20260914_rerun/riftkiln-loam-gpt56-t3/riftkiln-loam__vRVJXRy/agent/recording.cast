[44.30853, "i", "cat > /app/treypit/nested.quern <<'EOF'\nyard test {\n  pen outer {\n    pen inner {\n      peg x = 1;\n    }\n    clip after\n  }\n}\nEOF\n/app/bin/riftkiln sift /app/treypit/nested.quern /app/treypit/nested.json; rc=$?; echo \"nested_rc=$rc\"; cat /app/treypit/nested.json; echo\npython3 - <<'PY'\nimport json\np='/app/treypit/nested.json'\no=json.load(open(p))\nouter=o['members'][0]\nassert outer['kind']=='pen' and outer['stem']=='outer'\nassert len(outer['members']) == 2, outer\ninner, clip = outer['members']\nassert inner['kind']=='pen' and inner['stem']=='inner'\nassert 'clip' not in inner, inner\nassert clip == {'kind':'clip','stem':'after'}, clip\nprint('nested structure: PASS')\nPY\n"]
