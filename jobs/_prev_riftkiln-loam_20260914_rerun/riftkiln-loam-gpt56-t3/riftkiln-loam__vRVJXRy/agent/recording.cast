[41.154666, "o", "    32\t\r\n    33\tfn kind_of(n: &Node) -> String {\r\n    34\t    match map_get(n, \"kind\") {\r\n    35\t        Some(Node::Str(s)) => s.clone(),\r\n    36\t        _ => String::new(),\r\n    37\t    }\r\n    38\t}\r\n    39\t\r\n    40\tpub fn rib_c(mut acc: Node, neu: Node) -> Node {\r\n    41\t    if let Node::List(ref mut items) = acc {\r\n    42\t        items.push(neu);\r\n    43\t    }\r\n    44\t    acc\r\n    45\t}\r\n    46\t\r\n    47\tfn to_json(n: &Node) -> String {\r\n    48\t    match n {\r\n    49\t        Node::Str(s) => format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")),\r\n    50\t        Node::List(xs) => {\r\n    51\t            let inner: Vec<String> = xs.iter().map(to_json).collect();\r\n    52\t            format!(\"[{}]\", inner.join(\",\"))\r\n    53"]
