[101.675908, "i", "mv /app/treypit/card.clean.yg /app/cardhearth/card.yg\n/app/hearth.sh >/app/treypit/final-build.log 2>&1\nrc=$?\necho \"final_hearth_rc=$rc\"\ntest \"$rc\" -eq 0\ntest -e /app/markcue/brew.ok\ntest ! -s /app/tblwell/quarrel.lst\ntest \"$(head -c 4 /app/bin/riftkiln | od -An -tx1 | tr -d ' \\n')\" = 7f454c46\n/app/bin/riftkiln sift /app/treypit/nested.quern /app/treypit/final-nested.json\npython3 - <<'PY'\nimport json\nx=json.load(open('/app/treypit/final-nested.json'))\no=x['members'][0]\nassert len(o['members']) == 2\nassert o['members'][0] == {'kind':'pen','stem':'inner','members':[]}\nassert o['members'][1] == {'kind':'clip','stem':'after'}\nassert 'clip' not in o['members'][0]\nprint('final clean mill assertions: PASS')\nPY\nls -l /app/bin/riftkiln /app/markcue/brew.ok /app/tblwell/action.tbl /app/tblwell/quarrel.lst\n"]
