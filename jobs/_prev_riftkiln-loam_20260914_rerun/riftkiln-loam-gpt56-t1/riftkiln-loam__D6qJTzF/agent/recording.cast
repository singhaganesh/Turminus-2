[55.829947, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/ovenpit/halt.rs')\np.write_text('''fn rib_a(n: usize) -> i32 {\\n    if n == 0 { 0 } else { 1 }\\n}\\n''')\n\np=Path('/app/cardhearth/card.yg')\ns=p.read_text()\ns=s.replace('  | PEN ID LBRACE MS RBRACE CLIP ID\\n', '')\np.write_text(s)\n\np=Path('/app/ribjoin/cursor.rs')\ns=p.read_text()\nstart=s.index('pub fn rib_c(')\nend=s.index('\\nfn to_json', start)\ns=s[:start]+'''pub fn rib_c(mut acc: Node, neu: Node) -> Node {\n    if let Node::List(ref mut items) = acc {\n        items.push(neu);\n    }\n    acc\n}\n'''+s[end:]\ns=s.replace('''        let mut pairs = vec![\n            (\"kind\".into(), Node::Str(\"pen\".into())),\n            (\"stem\".into(), Node::Str(stem)),\n            (\"members\".into(), members),\n        ];\n        if rhs.len() >= 7 {\n            let cl = if let Node::Str(s) = &kids[6] {\n                s.clone()\n            } else {\n                String::new()\n            };\n            pairs.push((\"clip\".into(), Node::Str(cl)));\n        }\n        return Node::Map(pairs);\n''','''        return Node::Map(vec![\n            (\"kind\".into(), Node::Str(\"pen\".into())),\n            (\"stem\".into(), Node::Str(stem)),\n            (\"members\".into(), members),\n        ]);\n''')\np.write_text(s)\nPY\nprintf '%s\\n' '--- patched grammar ---'; cat /app/cardhearth/card.yg; printf '%s\\n' '--- patched functions ---'; sed -n '1,65p' /app/ribjoin/cursor.rs; sed -n '265,315p' /app/ribjoin/cursor.rs; cat /app/ovenpit/halt.rs\n"]
