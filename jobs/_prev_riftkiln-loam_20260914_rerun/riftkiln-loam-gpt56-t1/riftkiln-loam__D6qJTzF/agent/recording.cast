[66.907801, "o", "> p='/app/treypit/nested.json'\r\n\u001b[?2004l\r\u001b[?2004h> d=json.load(open(p))\r\n\u001b[?2004l\r\u001b[?2004h> outer=d['members'][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
