[31.837171, "o", "     1\tuse std::collections::{BTreeMap, BTreeSet};\r\n     2\tuse std::env;\r\n     3\tuse std::fs;\r\n"]
[31.838924, "o", "     4\tuse std::process;\r\n     5\t\r\n     6\tinclude!(\"halt.rs\");\r\n     7\t\r\n     8\ttype Item = (usize, usize);\r\n     9\t\r\n    10\t#[derive(Clone, Debug, PartialEq, Eq)]\r\n    11\tenum Act {\r\n    12\t    Shift(usize),\r\n    13\t    Reduce(usize),\r\n    14\t    Acc,\r\n    15\t}\r\n    16\t\r\n    17\tfn main() {\r\n    18\t    let args: Vec<String> = env::args().collect();\r\n    19\t    if args.len() < 3 {\r\n    20\t        eprintln!(\"usage: tblbake RECIPE OUTDIR\");\r\n    21\t        process::exit(2);\r\n    22\t    }\r\n    23\t    let text = fs::read_to_string(&args[1]).expect(\"recipe\");\r\n    24\t    let out = args[2].trim_end_matches('/').to_string();\r\n    25\t    let _ = fs::create_dir_all(&out);\r\n    26\t\r\n    27\t    let mut prods: Vec<(String, Vec<String>)> = Vec::new();\r\n    28\t    prods.push((\"S'\".to_string(), vec![\"S\".to_string()]));\r\n    29\t    let mut body = String::new();\r\n    30\t    for line in text.lines() {\r\n    31\t        let t = line.trim();\r\n    32\t        if t.is_empty() || t.starts_with('#') {\r\n    33\t            continue;\r\n    34\t        }\r\n    35\t        body.push_str(t);\r\n    36\t        body.push(' ');\r\n    37\t    }\r\n    38\t    for chunk in body.split(';') {\r\n    39\t        let chunk = chunk.trim();\r\n    40\t        if chunk.is_empty() {\r\n    41\t            continue;\r\n    42\t        }\r\n    43\t        let Some((lhs, rhs)) = chunk.split_once(':') else {\r\n    44\t            continue;\r\n    45\t        };\r\n    46\t        let lhs = lhs.trim().to_string();\r\n    47\t        for alt in rhs.split('|') {\r\n    48\t            let syms: Vec<String> = alt.split_whitespace().map(|s| s.to_string()).collect();\r\n    49\t            prods.push((lhs.clone(), syms));\r\n    50\t        }\r\n    51\t    }\r\n    52\t\r\n    53\t    let mut nts: BTreeSet<String> = BTreeSet::new();\r\n    54\t    for (l, _) in &prods {\r\n    55\t        nts.insert(l.clone());\r\n    56\t    }\r\n    57\t    let mut terms: BTreeSet<String> = BTreeSet::new();\r\n    58\t    terms.insert(\"$\".to_string());\r\n    59\t    for (_, rhs) in &prods {\r\n    60\t        for s in rhs {\r\n    61\t            if !nts.contains(s) {\r\n    62\t                terms.insert(s.clone());\r\n    63\t            }\r\n    64\t        }\r\n    65\t    }\r\n    66\t\r\n    67\t    let mut first: BTreeMap<String, BTreeSet<Option<String>>> = BTreeMap::new();\r\n    68\t    for nt in &nts {\r\n    69\t        first.insert(nt.clone(), BTreeSet::new());\r\n    70\t    }\r\n    71\t    for t in &terms {\r\n    72\t        let mut s = BTreeSet::new();\r\n    73\t        s.insert(Some(t.clone()));\r\n    74\t        first.insert(t.clone(), s);\r\n    75\t    }\r\n    76\t    let mut changed = true;\r\n    77\t    while changed {\r\n    78\t        changed = false;\r\n    79\t        for (lhs, rhs) in &prods {\r\n    80\t            if rhs.is_empty() {\r\n   260\t                }\r\n   261\t            } else if lhs == \"S'\" {\r\n   262\t                action[idx].insert(\"$\".to_string(), Act::Acc);\r\n   263\t            } else {\r\n   264\t                for a in follow.get(lhs).cloned().unwrap_or_default() {\r\n   265\t                    let neu = Act::Reduce(pi);\r\n   266\t                    if let Some(old) = action[idx].get(&a) {\r\n   267\t                        if old != &neu {\r\n   268\t                            quarrel.push(format!(\"state {} tok {}\", idx, a));\r\n   269\t                            if matches!(old, Act::Reduce(_)) && matches!(neu, Act::Shift(_)) {\r\n   270\t                                action[idx].insert(a.clone(), neu);\r\n   271\t                            }\r\n   272\t                        }\r\n   273\t                    } else {\r\n   274\t                        action[idx].insert(a.clone(), neu);\r\n   275\t                    }\r\n   276\t                }\r\n   277\t            }\r\n   278\t        }\r\n   279\t    }\r\n   280\t\r\n   281\t    let mut alines = String::new();\r\n   282\t    for (si, row) in action.iter().enumerate() {\r\n   283\t        for (t, act) in row {\r\n   284\t            match act {\r\n   285\t                Act::Shift(n) => alines.push_str(&format!(\"{} {} s {}\\n\", si, t, n)),\r\n   286\t                Act::Reduce(p) => alines.push_str(&format!(\"{} {} r {}\\n\", si, t, p)),\r\n   287\t                Act::Acc "]
[31.839057, "o", "=> alines.push_str(&format!(\"{} {} a 0\\n\", si, t)),\r\n   288\t            }\r\n   289\t        }\r\n   290\t    }\r\n   291\t    let mut glines = String::new();\r\n   292\t    for (si, row) in gotot.iter().enumerate() {\r\n   293\t        for (nt, n) in row {\r\n   294\t            glines.push_str(&format!(\"{} {} {}\\n\", si, nt, n));\r\n   295\t        }\r\n   296\t    }\r\n   297\t    let mut plines = String::new();\r\n   298\t    for (i, (lhs, rhs)) in prods.iter().enumerate() {\r\n   299\t        plines.push_str(&format!(\"{} {} {}\\n\", i, lhs, rhs.len()));\r\n   300\t        for s in rhs {\r\n   301\t            plines.push_str(&format!(\" {}\\n\", s));\r\n   302\t        }\r\n   303\t    }\r\n   304\t    fs::write(format!(\"{}/quarrel.lst\", out), quarrel.join(\"\\n\")).unwrap();\r\n   305\t    if rib_a(quarrel.len()) != 0 {\r\n   306\t        process::exit(1);\r\n   307\t    }\r\n   308\t    fs::write(format!(\"{}/action.tbl\", out), alines).unwrap();\r\n   309\t    fs::write(format!(\"{}/goto.tbl\", out), glines).unwrap();\r\n   310\t    fs::write(format!(\"{}/prod.tbl\", out), plines).unwrap();\r\n   311\t    process::exit(0);\r\n   312\t}\r\n--- halt include/use ---\r\n"]
