     1	use std::collections::BTreeMap;
     2	use std::fs;
     3	
     4	#[derive(Clone, Debug)]
     5	enum Node {
     6	    Str(String),
     7	    List(Vec<Node>),
     8	    Map(Vec<(String, Node)>),
     9	}
    10	
    11	fn map_get<'a>(n: &'a Node, k: &str) -> Option<&'a Node> {
    12	    if let Node::Map(pairs) = n {
    13	        for (a, b) in pairs {
    14	            if a == k {
    15	                return Some(b);
    16	            }
    17	        }
    18	    }
    19	    None
    20	}
    21	
    22	fn map_get_mut<'a>(n: &'a mut Node, k: &str) -> Option<&'a mut Node> {
    23	    if let Node::Map(pairs) = n {
    24	        for (a, b) in pairs.iter_mut() {
    25	            if a == k {
    26	                return Some(b);
    27	            }
    28	        }
    29	    }
    30	    None
    31	}
    32	
    33	fn kind_of(n: &Node) -> String {
    34	    match map_get(n, "kind") {
    35	        Some(Node::Str(s)) => s.clone(),
    36	        _ => String::new(),
    37	    }
    38	}
    39	
    40	pub fn rib_c(mut acc: Node, neu: Node) -> Node {
    41	    let k = kind_of(&neu);
    42	    if k == "clip" {
    43	        if let Node::List(ref mut items) = acc {
    44	            if let Some(last) = items.last_mut() {
    45	                if kind_of(last) == "pen" {
    46	                    if let Some(Node::Str(st)) = map_get(&neu, "stem") {
    47	                        let st = st.clone();
    48	                        if let Node::Map(pairs) = last {
    49	                            pairs.push(("clip".to_string(), Node::Str(st)));
    50	                            return acc;
    51	                        }
    52	                    }
    53	                }
    54	            }
    55	        }
    56	    }
    57	    if let Node::List(ref mut items) = acc {
    58	        items.push(neu);
    59	        return acc;
    60	    }
    61	    acc
    62	}
    63	
    64	fn to_json(n: &Node) -> String {
    65	    match n {
    66	        Node::Str(s) => format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\"")),
    67	        Node::List(xs) => {
    68	            let inner: Vec<String> = xs.iter().map(to_json).collect();
    69	            format!("[{}]", inner.join(","))
    70	        }
    71	        Node::Map(pairs) => {
    72	            let inner: Vec<String> = pairs
    73	                .iter()
    74	                .map(|(k, v)| format!("\"{}\":{}", k, to_json(v)))
    75	                .collect();
    76	            format!("{{{}}}", inner.join(","))
    77	        }
    78	    }
    79	}
    80	
    81	#[derive(Clone)]
    82	enum Cell {
    83	    S(usize),
    84	    R(usize),
    85	    A,
    86	}
    87	
    88	fn load_action(path: &str) -> BTreeMap<(usize, String), Cell> {
    89	    let mut m = BTreeMap::new();
    90	    if let Ok(t) = fs::read_to_string(path) {
    91	        for line in t.lines() {
    92	            let p: Vec<&str> = line.split_whitespace().collect();
    93	            if p.len() < 4 {
    94	                continue;
    95	            }
    96	            let st: usize = p[0].parse().unwrap_or(0);
    97	            let tok = p[1].to_string();
    98	            m.insert(
    99	                (st, tok),
   100	                match p[2] {
   101	                    "s" => Cell::S(p[3].parse().unwrap_or(0)),
   102	                    "r" => Cell::R(p[3].parse().unwrap_or(0)),
   103	                    _ => Cell::A,
   104	                },
   105	            );
   106	        }
   107	    }
   108	    m
   109	}
   110	
   111	fn load_goto(path: &str) -> BTreeMap<(usize, String), usize> {
   112	    let mut m = BTreeMap::new();
   113	    if let Ok(t) = fs::read_to_string(path) {
   114	        for line in t.lines() {
   115	            let p: Vec<&str> = line.split_whitespace().collect();
   116	            if p.len() < 3 {
   117	                continue;
   118	            }
   119	            m.insert(
   120	                (p[0].parse().unwrap_or(0), p[1].to_string()),
   121	                p[2].parse().unwrap_or(0),
   122	            );
   123	        }
   124	    }
   125	    m
   126	}
   127	
   128	fn load_prod(path: &str) -> Vec<(String, Vec<String>)> {
   129	    let mut out = Vec::new();
   130	    let t = fs::read_to_string(path).unwrap_or_default();
   131	    let lines: Vec<&str> = t.lines().collect();
   132	    let mut i = 0;
   133	    while i < lines.len() {
   134	        let p: Vec<&str> = lines[i].split_whitespace().collect();
   135	        if p.len() >= 3 {
   136	            let n: usize = p[2].parse().unwrap_or(0);
   137	            let mut rhs = Vec::new();
   138	            for _ in 0..n {
   139	                i += 1;
   140	                if i < lines.len() {
   141	                    rhs.push(lines[i].trim().to_string());
   142	                }
   143	            }
   144	            let idx: usize = p[0].parse().unwrap_or(0);
   145	            while out.len() <= idx {
   146	                out.push((String::new(), Vec::new()));
   147	            }
   148	            out[idx] = (p[1].to_string(), rhs);
   149	        }
   150	        i += 1;
   151	    }
   152	    out
   153	}
   154	
   155	#[derive(Clone)]
   156	struct Tok {
   157	    name: String,
   158	    lex: String,
   159	}
   160	
   161	fn lex(src: &str) -> Vec<Tok> {
   162	    let mut out = Vec::new();
   163	    let b = src.as_bytes();
   164	    let mut i = 0;
   165	    let mut after_eq = false;
   166	    while i < b.len() {
   167	        let c = b[i] as char;
   168	        if c.is_whitespace() {
   169	            i += 1;
   170	            continue;
   171	        }
   172	        if c == '{' {
   173	            out.push(Tok {
   174	                name: "LBRACE".into(),
   175	                lex: "{".into(),
   176	            });
   177	            i += 1;
   178	            continue;
   179	        }
   180	        if c == '}' {
   181	            out.push(Tok {
   182	                name: "RBRACE".into(),
   183	                lex: "}".into(),
   184	            });
   185	            i += 1;
   186	            continue;
   187	        }
   188	        if c == '=' {
   189	            out.push(Tok {
   190	                name: "EQ".into(),
   191	                lex: "=".into(),
   192	            });
   193	            after_eq = true;
   194	            i += 1;
   195	            continue;
   196	        }
   197	        if c == ';' {
   198	            out.push(Tok {
   199	                name: "SEMI".into(),
   200	                lex: ";".into(),
   201	            });
   202	            i += 1;
   203	            continue;
   204	        }
   205	        if c.is_ascii_alphanumeric() || c == '_' {
   206	            let s = i;
   207	            i += 1;
   208	            while i < b.len() {
   209	                let d = b[i] as char;
   210	                if d.is_ascii_alphanumeric() || d == '_' {
   211	                    i += 1;
   212	                } else {
   213	                    break;
   214	                }
   215	            }
   216	            let w = src[s..i].to_string();
   217	            if after_eq {
   218	                out.push(Tok {
   219	                    name: "VAL".into(),
   220	                    lex: w,
   221	                });
   222	                after_eq = false;
   223	            } else {
   224	                let name = match w.as_str() {
   225	                    "yard" => "YARD",
   226	                    "pen" => "PEN",
   227	                    "clip" => "CLIP",
   228	                    "peg" => "PEG",
   229	                    _ => "ID",
   230	                };
   231	                out.push(Tok {
   232	                    name: name.into(),
   233	                    lex: w,
   234	                });
   235	            }
   236	            continue;
   237	        }
   238	        i += 1;
   239	    }
   240	    out.push(Tok {
   241	        name: "$".into(),
   242	        lex: "".into(),
   243	    });
   244	    out
   245	}
   246	
   247	fn reduce_node(prod: &(String, Vec<String>), kids: Vec<Node>) -> Node {
   248	    let lhs = &prod.0;
   249	    let rhs = &prod.1;
   250	    if lhs == "MS" && rhs.is_empty() {
   251	        return Node::List(Vec::new());
   252	    }
   253	    if lhs == "MS" && rhs.len() == 2 {
   254	        return rib_c(kids[0].clone(), kids[1].clone());
   255	    }
   256	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("PEG") {
   257	        let tag = if let Node::Str(s) = &kids[1] {
   258	            s.clone()
   259	        } else {
   260	            String::new()
   261	        };
   262	        let mark = if let Node::Str(s) = &kids[3] {
   263	            s.clone()
   264	        } else {
   265	            String::new()
   266	        };
   267	        return Node::Map(vec![
   268	            ("kind".into(), Node::Str("peg".into())),
   269	            ("tag".into(), Node::Str(tag)),
   270	            ("mark".into(), Node::Str(mark)),
   271	        ]);
   272	    }
   273	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("CLIP") && rhs.len() == 2 {
   274	        let stem = if let Node::Str(s) = &kids[1] {
   275	            s.clone()
   276	        } else {
   277	            String::new()
   278	        };
   279	        return Node::Map(vec![
   280	            ("kind".into(), Node::Str("clip".into())),
   281	            ("stem".into(), Node::Str(stem)),
   282	        ]);
   283	    }
   284	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("PEN") {
   285	        let stem = if let Node::Str(s) = &kids[1] {
   286	            s.clone()
   287	        } else {
   288	            String::new()
   289	        };
   290	        let members = kids[3].clone();
   291	        let mut pairs = vec![
   292	            ("kind".into(), Node::Str("pen".into())),
   293	            ("stem".into(), Node::Str(stem)),
   294	            ("members".into(), members),
   295	        ];
   296	        if rhs.len() >= 7 {
   297	            let cl = if let Node::Str(s) = &kids[6] {
   298	                s.clone()
   299	            } else {
   300	                String::new()
   301	            };
   302	            pairs.push(("clip".into(), Node::Str(cl)));
   303	        }
   304	        return Node::Map(pairs);
   305	    }
   306	    if lhs == "S" {
   307	        let yard = if let Node::Str(s) = &kids[1] {
   308	            s.clone()
   309	        } else {
   310	            String::new()
   311	        };
   312	        let members = kids[3].clone();
   313	        return Node::Map(vec![
   314	            ("yard".into(), Node::Str(yard)),
   315	            ("members".into(), members),
   316	        ]);
   317	    }
   318	    if lhs == "S'" {
   319	        return kids[0].clone();
   320	    }
   321	    Node::List(kids)
   322	}
   323	
   324	fn tbl_dir() -> String {
   325	    std::env::var("ACTRIB").unwrap_or_else(|_| "/app/tblwell".to_string())
   326	}
   327	
   328	pub fn run_sift(src: &str, dest: &str) -> i32 {
   329	    let text = match fs::read_to_string(src) {
   330	        Ok(t) => t,
   331	        Err(_) => return 1,
   332	    };
   333	    let toks = lex(&text);
   334	    let base = tbl_dir();
   335	    let act = load_action(&format!("{}/action.tbl", base));
   336	    let gtbl = load_goto(&format!("{}/goto.tbl", base));
   337	    let prods = load_prod(&format!("{}/prod.tbl", base));
   338	    let mut states: Vec<usize> = vec![0];
   339	    let mut vals: Vec<Node> = Vec::new();
   340	    let mut ip = 0;
   341	    loop {
   342	        if ip >= toks.len() {
   343	            return 1;
   344	        }
   345	        let st = *states.last().unwrap();
   346	        let la = &toks[ip].name;
   347	        let cell = act.get(&(st, la.clone()));
   348	        match cell {
   349	            Some(Cell::S(n)) => {
   350	                vals.push(Node::Str(toks[ip].lex.clone()));
   351	                states.push(*n);
   352	                ip += 1;
   353	            }
   354	            Some(Cell::R(p)) => {
   355	                if *p >= prods.len() {
   356	                    return 1;
   357	                }
   358	                let prod = &prods[*p];
   359	                let n = prod.1.len();
   360	                if states.len() < n || vals.len() < n {
   361	                    return 1;
   362	                }
   363	                let mut kids = Vec::new();
   364	                for _ in 0..n {
   365	                    states.pop();
   366	                    kids.push(vals.pop().unwrap());
   367	                }
   368	                kids.reverse();
   369	                let built = reduce_node(prod, kids);
   370	                let st2 = *states.last().unwrap();
   371	                match gtbl.get(&(st2, prod.0.clone())) {
   372	                    Some(ns) => {
   373	                        vals.push(built);
   374	                        states.push(*ns);
   375	                    }
   376	                    None => {
   377	                        if prod.0 == "S'" {
   378	                            let _ = fs::write(dest, to_json(&built));
   379	                            return 0;
   380	                        }
--- boot ---
     1	include!("../ribjoin/cursor.rs");
     2	
     3	fn main() {
     4	    let args: Vec<String> = std::env::args().collect();
     5	    if args.len() < 4 || args[1] != "sift" {
     6	        eprintln!("usage: riftkiln sift SRC DEST");
     7	        std::process::exit(2);
     8	    }
     9	    let rc = run_sift(&args[2], &args[3]);
    10	    std::process::exit(rc);
    11	}
--- rewire ---
     1	use std::fs;
     2	
     3	fn walk(t: &str) -> String {
     4	    t.replace("\"kind\":\"clip\"", "\"kind\":\"clip\"")
     5	}
     6	
     7	pub fn rewire(path: &str) -> i32 {
     8	    match fs::read_to_string(path) {
     9	        Ok(t) => {
    10	            let _ = fs::write(path, walk(&t));
    11	            0
    12	        }
    13	        Err(_) => 1,
