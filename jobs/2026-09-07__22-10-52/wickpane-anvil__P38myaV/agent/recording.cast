[17.437476, "i", "printf '%s\\n' '--- go.mod ---'; cat /app/go.mod; printf '%s\\n' '--- Makefile ---'; sed -n '1,240p' /app/Makefile; for f in /app/celltyp/*.go /app/millhint/*.go /app/spoolkit/*.go /app/wicksrc/*.go /app/pantryc/*.go /app/vatmill/*.go; do printf '\\n### %s ###\\n' \"$f\"; sed -n '1,280p' \"$f\"; done\n"]
[17.438665, "o", "printf '%s\\n' '--- go.mod ---'; cat /app/go.mod; printf '%s\\n' '--- Makefile ---'; sed -n '1,240p' /app/Makefile; for f in /app/celltyp/*.go /app/millhint/*.go /app/spoolkit/*.go /app/wicksrc/*.go /app/pantryc/*.go /app/vatmill/*.go; do printf '\\n### %s ###\\n' \"$f\"; sed -n '1,280p' \"$f\"; done\r\n\u001b[?2004l\r"]
[17.438842, "o", "--- go.mod ---\r\n"]
[17.440151, "o", "module loft.local/wickpane\r\n\r\ngo 1.22\r\n"]
[17.4404, "o", "--- Makefile ---\r\n"]
[17.441859, "o", ".PHONY: ship\r\n\r\nship:\r\n\tmkdir -p /app/bin\r\n\t# GOPROXY=off matches the image; go never fetches.\r\n\tGOPROXY=off /usr/local/go/bin/go build -o /app/bin/wickpane loft.local/wickpane/vatmill\r\n\t/app/bin/wickpane etch\r\n\tif [ -f /app/shardops/live/poison.stk ]; then mv /app/shardops/live/poison.stk /tmp/wick-ship-poison.stk; fi\r\n\t/app/bin/wickpane bin\r\n\tif [ -f /tmp/wick-ship-poison.stk ]; then mv /tmp/wick-ship-poison.stk /app/shardops/live/poison.stk; fi\r\n"]
[17.44229, "o", "\r\n### /app/celltyp/row.go ###\r\n"]
[17.443891, "o", "package celltyp\r\n\r\ntype Row struct {\r\n\tKind string\r\n\tMod  string\r\n\tFn   string\r\n}\r\n"]
[17.444257, "o", "\r\n### /app/millhint/trim.go ###\r\n"]
[17.445837, "o", "package millhint\r\n\r\nimport \"strings\"\r\n\r\nfunc Trim(tok string) string {\r\n\ti := strings.LastIndex(tok, \"+\")\r\n\tif i < 0 {\r\n\t\treturn tok\r\n\t}\r\n\thead, tail := tok[:i+1], tok[i+1:]\r\n\tif len(tail) == 0 {\r\n\t\treturn tok\r\n\t}\r\n\tb := []byte(tail)\r\n\tb[len(b)-1] = '0'\r\n\treturn head + string(b)\r\n}\r\n"]
[17.446302, "o", "\r\n### /app/spoolkit/clip.go ###\r\n"]
[17.447799, "o", "package spoolkit\r\n\r\nimport (\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\nfunc Clip(rows []celltyp.Row) []celltyp.Row {\r\n\tout := make([]celltyp.Row, 0, len(rows))\r\n\tfor _, r := range rows {\r\n\t\tout = append(out, celltyp.Row{\r\n\t\t\tKind: strings.TrimSpace(r.Kind),\r\n\t\t\tMod:  plusHead(r.Mod),\r\n\t\t\tFn:   strings.TrimSpace(r.Fn),\r\n\t\t})\r\n\t}\r\n"]
[17.448056, "o", "\treturn out\r\n}\r\n\r\nfunc plusHead(mod string) string {\r\n\tmod = strings.TrimSpace(mod)\r\n\tif mod == \"\" {\r\n\t\treturn mod\r\n\t}\r\n\tif i := strings.Index(mod, \"+0x\"); i >= 0 {\r\n\t\thead := strings.TrimSpace(mod[:i])\r\n\t\tif head != \"\" {\r\n\t\t\treturn head\r\n\t\t}\r\n\t}\r\n\tif i := strings.Index(mod, \"+\"); i >= 0 {\r\n\t\ttail := strings.TrimSpace(mod[i+1:])\r\n\t\tif tail != \"\" {\r\n\t\t\treturn tail\r\n\t\t}\r\n\t"]
[17.448191, "o", "}\r\n\treturn mod\r\n}\r\n"]
[17.448292, "o", "\r\n### /app/spoolkit/scan.go ###\r\n"]
[17.449976, "o", "package spoolkit\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"errors\"\r\n\t\"os\"\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n"]
[17.45013, "o", ")\r\n\r\nvar ErrReject = errors.New(\"reject\")\r\n\r\nfunc Scan(path string) ([]celltyp.Row, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\t"]
[17.450211, "o", "var rows []celltyp.Row\r\n\tsc := bufio.NewScanner(f)\r\n\tfor sc.Scan() {\r\n\t\tline := strings.TrimSpace(sc.Text())\r\n\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tparts := strings.Fields(line)\r\n\t\tif len(parts) == 0 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif parts[0] == \"BAD\" {\r\n\t\t\treturn nil, ErrReject\r\n\t\t}\r\n\t\tif len(parts) < 4 {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\trows = append(rows, celltyp.Row{Kind: parts[0], Mod: parts[2], Fn: parts[3]})\r\n\t}\r\n\treturn rows, sc.Err()\r\n}\r\n"]
[17.450477, "o", "\r\n### /app/wicksrc/nest.go ###\r\n"]
[17.451826, "o", "package wicksrc\r\n\r\nimport (\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\nfunc Nest(rows []celltyp.Row) []celltyp.Row {\r\n\tout := make([]celltyp.Row, 0, len(rows))\r\n\tfor _, r := range rows {\r\n\t\tif isGap(r) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t"]
[17.452013, "o", "\tout = append(out, r)\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc isGap(r celltyp.Row) bool {\r\n\tk := strings.TrimSpace(r.Kind)\r\n\tif k != \"i\" {\r\n\t\treturn false\r\n\t}\r\n\treturn strings.TrimSpace(r.Fn) == \"\" || strings.TrimSpace(r.Mod) == \"\"\r\n}\r\n"]
[17.452117, "o", "\r\n### /app/pantryc/drop.go ###\r\n"]
[17.453331, "o", "package pantryc\r\n\r\nimport (\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\n"]
[17.453444, "o", "func Drop(rows []celltyp.Row) []celltyp.Row {\r\n\tout := make([]celltyp.Row, 0, len(rows))\r\n\tfor _, r := range rows {\r\n\t\tif skipClock(r.Mod) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tout = append(out, r)\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc skipClock(mod string) bool {\r\n\tm := strings.TrimSpace(mod)\r\n\tif i := strings.Index(m, \"+\"); i >= 0 {\r\n\t\tm = strings.TrimSpace(m[:i])\r\n\t}\r\n\treturn m == \"[vdso]\" || strings.HasPrefix(m, \"[vdso]\")\r\n}\r\n"]
[17.453599, "o", "\r\n### /app/pantryc/join.go ###\r\n"]
[17.454828, "o", "package pantryc\r\n\r\nimport (\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/celltyp\"\r\n)\r\n\r\n"]
[17.454904, "o", "func Join(rows []celltyp.Row) string {\r\n\tparts := make([]string, 0, len(rows))\r\n\tfor _, r := range rows {\r\n\t\tparts = append(parts, r.Mod+\"!\"+r.Fn)\r\n\t}\r\n\treturn strings.Join(parts, \"|\")\r\n}\r\n"]
[17.455061, "o", "\r\n### /app/vatmill/bin.go ###\r\n"]
[17.456093, "o", "package main\r\n\r\nimport (\r\n\t\"crypto/sha256\"\r\n\t\"encoding/hex\"\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n"]
[17.456178, "o", "\t\"path/filepath\"\r\n\t\"strconv\"\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/pantryc\"\r\n\t\"loft.local/wickpane/spoolkit\"\r\n)\r\n\r\nfunc emitPad() string {\r\n\tp := \"/app/shardops/.emit\"\r\n\tn := 0\r\n\tif b, err := os.ReadFile(p); err == nil {\r\n\t\tn, _ = strconv.Atoi(strings.TrimSpace(string(b)))\r\n\t}\r\n\tn++\r\n\t"]
[17.456268, "o", "_ = os.WriteFile(p, []byte(strconv.Itoa(n)+\"\\n\"), 0o644)\r\n\tif n%2 == 1 {\r\n\t\treturn \"  \"\r\n\t}\r\n\treturn \"\\t\"\r\n}\r\n\r\nfunc sealHex(pane string) {\r\n\tsum := sha256.Sum256([]byte(pane))\r\n\t_ = os.WriteFile(\"/app/loomwell/pair.sha\", []byte(hex.EncodeToString(sum[:])+\"\\n\"), 0o644)\r\n}\r\n\r\nfunc runBin() int {\r\n\tdir := \"/app/shardops/live\"\r\n\toutPath := \"/app/shardops/bins.json\"\r\n\tentries, err := os.ReadDir(dir)\r\n\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tout := map[string]string{}\r\n\trawN7 := \"\"\r\n\tpad := emitPad()\r\n\tfor _, e := range entries {\r\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tpath := filepath.Join(dir, e.Name())\r\n\t\trows, err := spoolkit.Scan(path)\r\n\t\tif err != nil {\r\n\t\t\tblob, mErr := json.MarshalIndent(out, \"\", pad)\r\n\t\t\tif mErr == nil {\r\n\t\t\t\t_ = os.MkdirAll(filepath.Dir(outPath), 0o755)\r\n\t\t\t\t_ = os.WriteFile(outPath, append(blob, '\\n'), 0o644)\r\n\t\t\t}\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\r\n\t\tjoined := pantryc.Join(rows)\r\n\t\tif stem == \"n7\" {\r\n\t\t\trawN7 = joined\r\n\t"]
[17.45634, "o", "\t}\r\n\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\r\n\t}\r\n\tsealHex(rawN7)\r\n\tblob, err := json.MarshalIndent(out, \"\", pad)\r\n\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tif err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tif err := os.WriteFile(outPath, append(blob, '\\n'), 0o644); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[17.456552, "o", "\r\n### /app/vatmill/etch.go ###\r\n"]
[17.457595, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"loft.local/wickpane/pantryc\"\r\n\t\"loft.local/wickpane/spoolkit\"\r\n"]
[17.457665, "o", ")\r\n\r\nfunc runEtch() int {\r\n\tdir := \"/app/crumbay\"\r\n\toutPath := \"/app/loomwell/etch.json\"\r\n\tentries, err := os.ReadDir(dir)\r\n\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tout := map[string]string{}\r\n\tfor _, e := range entries {\r\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\r\n\t\tif err != nil {\r\n\t\t\treturn 1\r\n\t\t}\r\n\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\r\n\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\r\n"]
[17.457696, "o", "\t}\r\n\tblob, err := json.MarshalIndent(out, \"\", \"  \")\r\n\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tif err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tif err := os.WriteFile(outPath, append(blob, '\\n'), 0o644); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\t"]
[17.457715, "o", "return 0\r\n}\r\n"]
[17.458099, "o", "\r\n### /app/vatmill/main.go ###\r\n"]
[17.460788, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: wickpane etch|bin\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tvar rc int\r\n\tswitch os.Args[1] {\r\n\tcase \"etch\":\r\n\t\trc = runEtch()\r\n\tcase \"bin\":\r\n\t\trc = runBin()\r\n\tdefault:\r\n\t\trc = 2\r\n\t}\r\n"]
[17.460986, "o", "\tos.Exit(rc)\r\n}\r\n"]
[17.461223, "o", "\r\n### /app/vatmill/stage.go ###\r\n"]
[17.462735, "o", "package main\r\n\r\nimport \"loft.local/wickpane/celltyp\"\r\nimport \"loft.local/wickpane/spoolkit\"\r\nimport \"loft.local/wickpane/wicksrc\"\r\n\r\nfunc pipeFront(rows []celltyp.Row) []celltyp.Row {\r\n\treturn wicksrc.Nest(spoolkit.Clip(rows))\r\n}\r\n"]
[17.463085, "o", "\r\n### /app/vatmill/stage2.go ###\r\n"]
