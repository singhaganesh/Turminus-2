[53.188032, "i", "cat > /app/vatmill/bin.go <<'EOF'\npackage main\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"loft.local/wickpane/pantryc\"\n\t\"loft.local/wickpane/spoolkit\"\n)\n\nfunc atomicWrite(path string, data []byte, mode os.FileMode) error {\n\tdir := filepath.Dir(path)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn err\n\t}\n\tf, err := os.CreateTemp(dir, \".wickpane-*\")\n\tif err != nil {\n\t\treturn err\n\t}\n\ttmp := f.Name()\n\tdefer os.Remove(tmp)\n\tif err = f.Chmod(mode); err == nil {\n\t\t_, err = f.Write(data)\n\t}\n\tif err == nil {\n\t\terr = f.Sync()\n\t}\n\tif closeErr := f.Close(); err == nil {\n\t\terr = closeErr\n\t}\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.Rename(tmp, path)\n}\n\nfunc runBin() int {\n\tconst dir = \"/app/shardops/live\"\n\tconst outPath = \"/app/shardops/bins.json\"\n\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tout := make(map[string]string)\n\tn7Pane := \"\"\n\tfor _, e := range entries {\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\n\t\t\tcontinue\n\t\t}\n\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\n\t\tif err != nil {\n\t\t\t// In particular, BAD takes must leave prior generated output intact.\n\t\t\treturn 1\n\t\t}\n\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\n\t\tpane := pantryc.Join(pipeBack(pipeFront(rows)))\n\t\tout[stem] = pane\n\t\tif stem == \"n7\" {\n\t\t\tn7Pane = pane\n\t\t}\n\t}\n\n\tblob, err := json.MarshalIndent(out, \"\", \"  \")\n\tif err != nil {\n\t\treturn 1\n\t}\n\tblob = append(blob, '\\n')\n\tsum := sha256.Sum256([]byte(n7Pane))\n\tseal := []byte(hex.EncodeToString(sum[:]) + \"\\n\")\n\n\tif err := atomicWrite(outPath, blob, 0o644); err != nil {\n\t\treturn 1\n\t}\n\tif err := atomicWrite(\"/app/loomwell/pair.sha\", seal, 0o644); err != nil {\n\t\treturn 1\n\t}\n\treturn 0\n}\nEOF\ncd /app && /usr/local/go/bin/gofmt -w celltyp millhint spoolkit wicksrc pantryc vatmill && GOPROXY=off /usr/local/go/bin/go test ./... && GOPROXY=off /usr/local/go/bin/go build -o /app/bin/wickpane loft.local/wickpane/vatmill\n"]
