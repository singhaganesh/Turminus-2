[53.056112, "i", "cat > /app/millhint/trim.go <<'EOF'\npackage millhint\n\nimport \"strings\"\n\n// Trim removes an optional address/offset tail from a module token.\nfunc Trim(tok string) string {\n\ttok = strings.TrimSpace(tok)\n\tif i := strings.Index(tok, \"+\"); i >= 0 {\n\t\treturn strings.TrimSpace(tok[:i])\n\t}\n\treturn tok\n}\nEOF\ncat > /app/spoolkit/clip.go <<'EOF'\npackage spoolkit\n\nimport (\n\t\"strings\"\n\n\t\"loft.local/wickpane/celltyp\"\n\t\"loft.local/wickpane/millhint\"\n)\n\nfunc Clip(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tout = append(out, celltyp.Row{\n\t\t\tKind: strings.TrimSpace(r.Kind),\n\t\t\tMod:  millhint.Trim(r.Mod),\n\t\t\tFn:   strings.TrimSpace(r.Fn),\n\t\t})\n\t}\n\treturn out\n}\nEOF\ncat > /app/wicksrc/nest.go <<'EOF'\npackage wicksrc\n\nimport (\n\t\"strings\"\n\n\t\"loft.local/wickpane/celltyp\"\n)\n\n// Nest consumes fold rows. A fold belongs to the following named frame and\n// therefore never emits a pane chunk of its own.\nfunc Nest(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tif strings.TrimSpace(r.Kind) == \"i\" {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\nEOF\ncat > /app/pantryc/drop.go <<'EOF'\npackage pantryc\n\nimport (\n\t\"strings\"\n\n\t\"loft.local/wickpane/celltyp\"\n)\n\nfunc Drop(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tif skipClock(r.Mod) {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\n\nfunc skipClock(mod string) bool {\n\tm := strings.TrimSpace(mod)\n\tif i := strings.Index(m, \"+\"); i >= 0 {\n\t\tm = strings.TrimSpace(m[:i])\n\t}\n\treturn m == \"[vdso]\" || m == \"[vsyscall]\"\n}\nEOF\n"]
