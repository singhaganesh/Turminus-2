[73.265096, "i", "cd /app && cat > vatmill/bin.go <<'EOF'\npackage main\n\nimport (\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"loft.local/wickpane/pantryc\"\n\t\"loft.local/wickpane/spoolkit\"\n)\n\nfunc stagedFile(path string, data []byte) (string, error) {\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn \"\", err\n\t}\n\tf, err := os.CreateTemp(filepath.Dir(path), \".wickpane-*\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tname := f.Name()\n\tok := false\n\tdefer func() {\n\t\tif !ok {\n\t\t\t_ = os.Remove(name)\n\t\t}\n\t}()\n\tif err = f.Chmod(0o644); err == nil {\n\t\t_, err = f.Write(data)\n\t}\n\tif err == nil {\n\t\terr = f.Sync()\n\t}\n\tcloseErr := f.Close()\n\tif err == nil {\n\t\terr = closeErr\n\t}\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tok = true\n\treturn name, nil\n}\n\nfunc runBin() int {\n\tconst dir = \"/app/shardops/live\"\n\tconst outPath = \"/app/shardops/bins.json\"\n\tconst sealPath = \"/app/loomwell/pair.sha\"\n\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tout := make(map[string]string)\n\tfor _, e := range entries {\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\n\t\t\tcontinue\n\t\t}\n\t\trows, err := spoolkit.Scan(filepath.Join(dir, e.Name()))\n\t\tif err != nil {\n\t\t\t// Do not stage or replace any successful artifact on rejection.\n\t\t\treturn 1\n\t\t}\n\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\n\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\n\t}\n\n\tblob, err := json.MarshalIndent(out, \"\", \"  \")\n\tif err != nil {\n\t\treturn 1\n\t}\n\tblob = append(blob, '\\n')\n\tpane := out[\"n7\"]\n\tsum := sha256.Sum256([]byte(pane))\n\tseal := []byte(hex.EncodeToString(sum[:]) + \"\\n\")\n\n\t// Prepare both complete files before replacing either destination.\n\tbinTmp, err := stagedFile(outPath, blob)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tdefer os.Remove(binTmp)\n\tsealTmp, err := stagedFile(sealPath, seal)\n\tif err != nil {\n\t\treturn 1\n\t}\n\tdefer os.Remove(sealTmp)\n\tif err := os.Rename(sealTmp, sealPath); err != nil {\n\t\treturn 1\n\t}\n\tif err := os.Rename(binTmp, outPath); err != nil {\n\t\treturn 1\n\t}\n\treturn 0\n}\nEOF\n/usr/local/go/bin/gofmt -w celltyp spoolkit wicksrc pantryc millhint vatmill\n/usr/local/go/bin/go test ./...\n/usr/local/go/bin/go build -o /app/bin/wickpane loft.local/wickpane/vatmill\nod -An -tx1 -N4 /app/bin/wickpane\n"]
