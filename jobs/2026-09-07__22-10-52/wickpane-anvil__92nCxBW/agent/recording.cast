[73.004574, "i", "cd /app && cat > millhint/trim.go <<'EOF'\npackage millhint\n\nimport \"strings\"\n\n// Trim removes the optional + tail from a module token.\nfunc Trim(tok string) string {\n\ttok = strings.TrimSpace(tok)\n\tif i := strings.Index(tok, \"+\"); i >= 0 {\n\t\treturn strings.TrimSpace(tok[:i])\n\t}\n\treturn tok\n}\nEOF\ncat > spoolkit/clip.go <<'EOF'\npackage spoolkit\n\nimport (\n\t\"strings\"\n\n\t\"loft.local/wickpane/celltyp\"\n\t\"loft.local/wickpane/millhint\"\n)\n\nfunc Clip(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tout = append(out, celltyp.Row{\n\t\t\tKind: strings.TrimSpace(r.Kind),\n\t\t\tMod:  millhint.Trim(r.Mod),\n\t\t\tFn:   strings.TrimSpace(r.Fn),\n\t\t})\n\t}\n\treturn out\n}\nEOF\ncat > wicksrc/nest.go <<'EOF'\npackage wicksrc\n\nimport (\n\t\"strings\"\n\n\t\"loft.local/wickpane/celltyp\"\n)\n\n// Nest removes fold rows. A fold belongs to the following named frame and\n// therefore does not emit a pane chunk of its own.\nfunc Nest(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tif strings.TrimSpace(r.Kind) == \"i\" {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\nEOF\ncat > pantryc/drop.go <<'EOF'\npackage pantryc\n\nimport (\n\t\"strings\"\n\n\t\"loft.local/wickpane/celltyp\"\n)\n\nfunc Drop(rows []celltyp.Row) []celltyp.Row {\n\tout := make([]celltyp.Row, 0, len(rows))\n\tfor _, r := range rows {\n\t\tif skipModule(r.Mod) {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, r)\n\t}\n\treturn out\n}\n\nfunc skipModule(mod string) bool {\n\tm := strings.TrimSpace(mod)\n\tif i := strings.Index(m, \"+\"); i >= 0 {\n\t\tm = strings.TrimSpace(m[:i])\n\t}\n\treturn m == \"[vdso]\" || m == \"[vsyscall]\"\n}\nEOF\n"]
[73.005917, "o", "cd /app && cat > millhint/trim.go <<'EOF'\r\n"]
[73.00869, "o", "\u001b[?2004l\r\u001b[?2004h> package millhint\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import \"strings\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // Trim removes the optional + tail from a module token.\r\n\u001b[?2004l\r\u001b[?2004h> func Trim(tok string) string {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007tok = strings.TrimSpace(tok)\r\n\u001b[?2004l\r\u001b[?2004h> \u0007if i := strings.Index(tok, \"+\"); i >= 0 {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nMakefile  bin/      bindnote/ celltyp/  crumbay/  go.mod    loomwell/ millhint/ pantryc/  shardops/ spoolkit/ vatmill/  wicksrc/  \r\n> return strings.TrimSpace(tok[:i])\r\n\u001b[?2004l\r\u001b[?2004h> \u0007}\r\n\u001b[?2004l\r\u001b[?2004h> \u0007return tok\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
