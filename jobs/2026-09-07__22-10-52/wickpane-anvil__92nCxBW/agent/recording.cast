[22.735633, "o", "===== Makefile =====\r\n"]
[22.73803, "o", "     1\t.PHONY: ship\r\n     2\t\r\n     3\tship:\r\n     4\t\tmkdir -p /app/bin\r\n     5\t\t# GOPROXY=off matches the image; go never fetches.\r\n     6\t\tGOPROXY=off /usr/local/go/bin/go build -o /app/bin/wickpane loft.local/wickpane/vatmill\r\n     7\t\t/app/bin/wickpane etch\r\n     8\t\tif [ -f /app/shardops/live/poison.stk ]; then mv /app/shardops/live/poison.stk /tmp/wick-ship-poison.stk; fi\r\n     9\t\t/app/bin/wickpane bin\r\n    10\t\tif [ -f /tmp/wick-ship-poison.stk ]; then mv /tmp/wick-ship-poison.stk /app/shardops/live/poison.stk; fi\r\n"]
[22.738271, "o", "===== go.mod =====\r\n"]
[22.739291, "o", "     1\tmodule loft.local/wickpane\r\n     2\t\r\n     3\tgo 1.22\r\n"]
[22.73949, "o", "===== celltyp/row.go =====\r\n"]
[22.740397, "o", "     1\tpackage celltyp\r\n     2\t\r\n     3\ttype Row struct {\r\n     4\t\tKind string\r\n     5\t\tMod  string\r\n     6\t\tFn   string\r\n     7\t}\r\n"]
[22.740607, "o", "===== spoolkit/clip.go =====\r\n"]
[22.741411, "o", "     1\tpackage spoolkit\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"strings\"\r\n     5\t\r\n     6\t\t\"loft.local/wickpane/celltyp\"\r\n     7\t)\r\n     8\t\r\n     9\tfunc Clip(rows []celltyp.Row) []celltyp.Row {\r\n    10\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tout = append(out, celltyp.Row{\r\n    13\t\t\t\t"]
[22.741627, "o", "Kind: strings.TrimSpace(r.Kind),\r\n    14\t\t\t\tMod:  plusHead(r.Mod),\r\n    15\t\t\t\tFn:   strings.TrimSpace(r.Fn),\r\n    16\t\t\t})\r\n    17\t\t}\r\n    18\t\treturn out\r\n    19\t}\r\n    20\t\r\n    21\tfunc plusHead(mod string) string {\r\n    22\t\tmod = strings.TrimSpace(mod)\r\n    23\t\tif mod == \"\" {\r\n    24\t\t\treturn mod\r\n    25\t\t}\r\n    26\t\tif i := strings.Index(mod, \"+0x\"); i >= 0 {\r\n    27\t\t\thead := strings.TrimSpace(mod[:i])\r\n    28\t\t\tif head != \"\" {\r\n    29\t\t\t\treturn head\r\n    30\t\t\t}\r\n    31\t\t}\r\n    32\t\tif i := strings.Index(mod, \"+\"); i >= 0 {\r\n    33\t\t\ttail := strings.TrimSpace(mod[i+1:])\r\n    34\t\t\tif tail != \"\" {\r\n    35\t\t\t\treturn tail\r\n    36\t\t\t}\r\n    37\t\t}\r\n    38\t\treturn mod\r\n"]
[22.741781, "o", "    39\t}\r\n"]
[22.741882, "o", "===== spoolkit/scan.go =====\r\n"]
[22.743131, "o", "     1\tpackage spoolkit\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"bufio\"\r\n     5\t\t\"errors\"\r\n     6\t\t\"os\"\r\n     7\t\t\"strings\"\r\n     8\t\r\n     9\t\t\"loft.local/wickpane/celltyp\"\r\n    10\t)\r\n    11\t\r\n"]
[22.743329, "o", "    12\tvar ErrReject = errors.New(\"reject\")\r\n    13\t\r\n    14\tfunc Scan(path string) ([]celltyp.Row, error) {\r\n    15\t\tf, err := os.Open(path)\r\n    16\t\tif err != nil {\r\n    17\t\t\treturn nil, err\r\n    18\t\t}\r\n    19\t\tdefer f.Close()\r\n    20\t\tvar rows []celltyp.Row\r\n    21\t\tsc := bufio.NewScanner(f)\r\n    22\t\tfor sc.Scan() {\r\n    23\t\t\tline := strings.TrimSpace(sc.Text())\r\n    24\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    25\t\t\t\tcontinue\r\n    26\t\t\t}\r\n    27\t\t\tparts := strings.Fields(line)\r\n    28\t\t\tif len(parts) == 0 {\r\n    29\t\t\t\tcontinue\r\n    30\t\t\t}\r\n    31\t\t\tif parts[0] == \"BAD\" {\r\n    32\t\t\t\treturn nil, ErrReject\r\n    33\t\t\t}\r\n    34\t\t\tif len(parts) < 4 {\r\n    35\t\t\t\tcontinue\r\n    36\t\t\t}\r\n    37\t\t\trows = append(rows, celltyp.Row{Kind: parts[0], Mod: parts[2], Fn: parts[3]})\r\n"]
[22.743416, "o", "    38\t\t}\r\n    39\t\treturn rows, sc.Err()\r\n    40\t}\r\n"]
[22.743709, "o", "===== wicksrc/nest.go =====\r\n"]
[22.744861, "o", "     1\tpackage wicksrc\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"strings\"\r\n     5\t\r\n     6\t\t\"loft.local/wickpane/celltyp\"\r\n     7\t)\r\n     8\t\r\n"]
[22.745005, "o", "     9\tfunc Nest(rows []celltyp.Row) []celltyp.Row {\r\n    10\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tif isGap(r) {\r\n    13\t\t\t\tcontinue\r\n    14\t\t\t}\r\n    15\t\t\tout = append(out, r)\r\n    16\t\t}\r\n    17\t\treturn out\r\n    18\t}\r\n"]
[22.745072, "o", "    19\t\r\n    20\tfunc isGap(r celltyp.Row) bool {\r\n    21\t\tk := strings.TrimSpace(r.Kind)\r\n    22\t\tif k != \"i\" {\r\n    23\t\t\treturn false\r\n    24\t\t}\r\n    25\t\treturn strings.TrimSpace(r.Fn) == \"\" || strings.TrimSpace(r.Mod) == \"\"\r\n    26\t}\r\n"]
[22.745169, "o", "===== pantryc/drop.go =====\r\n"]
[22.746132, "o", "     1\tpackage pantryc\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"strings\"\r\n     5\t\r\n     6\t\t\"loft.local/wickpane/celltyp\"\r\n     7\t)\r\n     8\t\r\n"]
[22.746228, "o", "     9\tfunc Drop(rows []celltyp.Row) []celltyp.Row {\r\n    10\t\tout := make([]celltyp.Row, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tif skipClock(r.Mod) {\r\n    13\t\t\t\tcontinue\r\n    14\t\t\t}\r\n    15\t\t\tout = append(out, r)\r\n    16\t\t}\r\n    17\t\treturn out\r\n    18\t}\r\n"]
[22.746288, "o", "    19\t\r\n    20\tfunc skipClock(mod string) bool {\r\n    21\t\tm := strings.TrimSpace(mod)\r\n    22\t\tif i := strings.Index(m, \"+\"); i >= 0 {\r\n    23\t\t\tm = strings.TrimSpace(m[:i])\r\n    24\t\t}\r\n    25\t\treturn m == \"[vdso]\" || strings.HasPrefix(m, \"[vdso]\")\r\n    26\t}\r\n"]
[22.746392, "o", "===== pantryc/join.go =====\r\n"]
[22.747493, "o", "     1\tpackage pantryc\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"strings\"\r\n     5\t\r\n     6\t\t\"loft.local/wickpane/celltyp\"\r\n     7\t)\r\n     8\t\r\n     9\t"]
[22.747675, "o", "func Join(rows []celltyp.Row) string {\r\n    10\t\tparts := make([]string, 0, len(rows))\r\n    11\t\tfor _, r := range rows {\r\n    12\t\t\tparts = append(parts, r.Mod+\"!\"+r.Fn)\r\n    13\t\t}\r\n    14\t\treturn strings.Join(parts, \"|\")\r\n    15\t}\r\n"]
[22.747844, "o", "===== millhint/trim.go =====\r\n"]
[22.748879, "o", "     1\tpackage millhint\r\n     2\t\r\n     3\timport \"strings\"\r\n     4\t\r\n     5\tfunc Trim(tok string) string {\r\n     6\t\ti := strings.LastIndex(tok, \"+\")\r\n     7\t\tif i < 0 {\r\n     8\t\t\treturn tok\r\n"]
[22.74905, "o", "     9\t\t}\r\n    10\t\thead, tail := tok[:i+1], tok[i+1:]\r\n    11\t\tif len(tail) == 0 {\r\n    12\t\t\treturn tok\r\n    13\t\t}\r\n    14\t\tb := []byte(tail)\r\n    15\t\tb[len(b)-1] = '0'\r\n    16\t\treturn head + string(b)\r\n    17\t}\r\n"]
[22.74917, "o", "===== vatmill/bin.go =====\r\n"]
[22.750192, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"crypto/sha256\"\r\n     5\t\t\"encoding/hex\"\r\n     6\t\t\"encoding/json\"\r\n     7\t\t\"os\"\r\n     8\t\t\"path/filepath\"\r\n"]
[22.750316, "o", "     9\t\t\"strconv\"\r\n    10\t\t\"strings\"\r\n    11\t\r\n    12\t\t\"loft.local/wickpane/pantryc\"\r\n    13\t\t\"loft.local/wickpane/spoolkit\"\r\n    14\t)\r\n    15\t\r\n    16\tfunc emitPad() string {\r\n    17\t\tp := \"/app/shardops/.emit\"\r\n"]
[22.750403, "o", "    18\t\tn := 0\r\n    19\t\tif b, err := os.ReadFile(p); err == nil {\r\n    20\t\t\tn, _ = strconv.Atoi(strings.TrimSpace(string(b)))\r\n    21\t\t}\r\n    22\t\tn++\r\n    23\t\t_ = os.WriteFile(p, []byte(strconv.Itoa(n)+\"\\n\"), 0o644)\r\n    24\t\tif n%2 == 1 {\r\n    25\t\t\treturn \"  \"\r\n    26\t\t}\r\n    27\t\treturn \"\\t\"\r\n    28\t}\r\n    29\t\r\n    30\tfunc sealHex(pane string) {\r\n    31\t\tsum := sha256.Sum256([]byte(pane))\r\n    32\t\t_ = os.WriteFile(\"/app/loomwell/pair.sha\", []byte(hex.EncodeToString(sum[:])+\"\\n\"), 0o644)\r\n    33\t}\r\n    34\t\r\n    35\tfunc runBin() int {\r\n    36\t\tdir := \"/app/shardops/live\"\r\n    37\t\toutPath := \"/app/shardops/bins.json\"\r\n    38\t\tentries, err := os.ReadDir(dir)\r\n    39\t\tif err != nil {\r\n    40\t\t\treturn 1\r\n    41\t\t}\r\n    42\t\tout := map[string]string{}\r\n    43\t\trawN7 := \"\"\r\n    44\t\tpad := emitPad()\r\n    45\t\tfor _, e := range entries {\r\n    46\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".stk\") {\r\n    47\t\t\t\tcontinue\r\n    48\t\t\t}\r\n    49\t\t\tpath := filepath.Join(dir, e.Name())\r\n    50\t\t\trows, err := spoolkit.Scan(path)\r\n    51\t\t\tif err != nil {\r\n    52\t\t\t\tblob, mErr := json.MarshalIndent(out, \"\", pad)\r\n    53\t\t\t\tif mErr == nil {\r\n    54\t\t\t\t\t_ = os.MkdirAll(filepath.Dir(outPath), 0o755)\r\n"]
[22.750464, "o", "    55\t\t\t\t\t_ = os.WriteFile(outPath, append(blob, '\\n'), 0o644)\r\n    56\t\t\t\t}\r\n    57\t\t\t\treturn 1\r\n    58\t\t\t}\r\n    59\t\t\tstem := strings.TrimSuffix(e.Name(), \".stk\")\r\n    60\t\t\tjoined := pantryc.Join(rows)\r\n    61\t\t\tif stem == \"n7\" {\r\n    62\t\t\t\trawN7 = joined\r\n    63\t\t\t}\r\n    64\t\t\tout[stem] = pantryc.Join(pipeBack(pipeFront(rows)))\r\n    65\t\t}\r\n    66\t\t"]
[22.750574, "o", "sealHex(rawN7)\r\n    67\t\tblob, err := json.MarshalIndent(out, \"\", pad)\r\n    68\t\tif err != nil {\r\n    69\t\t\treturn 1\r\n    70\t\t}\r\n    71\t\tif err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {\r\n    72\t\t\treturn 1\r\n    73\t\t}\r\n    74\t\tif err := os.WriteFile(outPath, append(blob, '\\n'), 0o644); err != nil {\r\n    75\t\t\treturn 1\r\n    76\t\t}\r\n    77\t\treturn 0\r\n    78\t}\r\n"]
[22.75083, "o", "===== vatmill/etch.go =====\r\n"]
[22.751844, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t\t\"strings\"\r\n     8\t\r\n     9\t"]
