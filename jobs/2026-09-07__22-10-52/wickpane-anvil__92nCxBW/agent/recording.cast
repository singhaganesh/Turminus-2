[73.026572, "o", "\u001b[?2004hroot@f1f114e3196b:/app# cat > pantryc/drop.go <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> package pantryc\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import (\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\"strings\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \u0007\"loft.local/wickpane/celltyp\"\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func Drop(rows []celltyp.Row) []celltyp.Row {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007out := make([]celltyp.Row, 0, len(rows))\r\n\u001b[?2004l\r\u001b[?2004h> \u0007for _, r := range rows {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nMakefile  bin/      bindnote/ celltyp/  crumbay/  go.mod    loomwell/ millhint/ pantryc/  shardops/ spoolkit/ vatmill/  wicksrc/  \r\n> if skipModule(r.Mod) {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nMakefile  bin/      bindnote/ celltyp/  crumbay/  go.mod    loomwell/ millhint/ pantryc/  shardops/ spoolkit/ vatmill/  wicksrc/  \r\n> \r\nMakefile  bin/      bindnote/ celltyp/  crumbay/  go.mod    loomwell/ millhint/ pantryc/  shardops/ spoolkit/ vatmill/  wicksrc/  \r\n> continue\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nMakefile  bin/      bindnote/ celltyp/  crumbay/  go.mod    loomwell/ millhint/ pantryc/  shardops/ spoolkit/ vatmill/  wicksrc/  \r\n> }\r\n\u001b[?2004l\r\u001b[?2004h> \u0007\r\nMakefile  bin/      bindnote/ celltyp/  crumbay/  go.mod    loomwell/ millhint/ pantryc/  shardops/ spoolkit/ vatmill/  wicksrc/  \r\n> out = append(out, r)\r\n\u001b[?2004l\r\u001b[?2004h> \u0007}\r\n\u001b[?2004l\r\u001b[?2004h> \u0007return out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func skipModule(mod string) bool {\r\n\u001b[?2004l\r\u001b[?2004h> \u0007m := strings.TrimSpace(mod)\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.026747, "o", "> \u0007"]
