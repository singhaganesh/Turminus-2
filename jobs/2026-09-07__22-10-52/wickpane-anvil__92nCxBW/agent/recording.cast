[22.753321, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"fmt\"\r\n     5\t\t\"os\"\r\n     6\t)\r\n     7\t\r\n     8\tfunc main() {\r\n     9\t\tif len(os.Args) < 2 {\r\n"]
[22.753451, "o", "    10\t\t\tfmt.Fprintln(os.Stderr, \"usage: wickpane etch|bin\")\r\n    11\t\t\tos.Exit(2)\r\n    12\t\t}\r\n    13\t\tvar rc int\r\n    14\t\tswitch os.Args[1] {\r\n    15\t\tcase \"etch\":\r\n    16\t\t\trc = runEtch()\r\n    17\t\tcase \"bin\":\r\n    18\t\t\trc = runBin()\r\n    19\t\tdefault:\r\n    20\t\t\trc = 2\r\n    21\t\t}\r\n    22\t\tos.Exit(rc)\r\n    23\t}\r\n"]
