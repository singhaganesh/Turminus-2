===== spoolkit/clip.go =====
     1	package spoolkit
     2	
     3	import (
     4		"strings"
     5	
     6		"loft.local/wickpane/celltyp"
     7	)
     8	
     9	func Clip(rows []celltyp.Row) []celltyp.Row {
    10		out := make([]celltyp.Row, 0, len(rows))
    11		for _, r := range rows {
    12			out = append(out, celltyp.Row{
    13				Kind: strings.TrimSpace(r.Kind),
    14				Mod:  plusHead(r.Mod),
    15				Fn:   strings.TrimSpace(r.Fn),
    16			})
    17		}
    18		return out
    19	}
    20	
    21	func plusHead(mod string) string {
    22		mod = strings.TrimSpace(mod)
    23		if mod == "" {
    24			return mod
    25		}
    26		if i := strings.Index(mod, "+0x"); i >= 0 {
    27			head := strings.TrimSpace(mod[:i])
    28			if head != "" {
    29				return head
    30			}
    31		}
    32		if i := strings.Index(mod, "+"); i >= 0 {
    33			tail := strings.TrimSpace(mod[i+1:])
    34			if tail != "" {
    35				return tail
    36			}
    37		}
    38		return mod
    39	}
===== spoolkit/scan.go =====
     1	package spoolkit
     2	
     3	import (
     4		"bufio"
     5		"errors"
     6		"os"
     7		"strings"
     8	
     9		"loft.local/wickpane/celltyp"
    10	)
    11	
    12	var ErrReject = errors.New("reject")
    13	
    14	func Scan(path string) ([]celltyp.Row, error) {
    15		f, err := os.Open(path)
    16		if err != nil {
    17			return nil, err
    18		}
    19		defer f.Close()
    20		var rows []celltyp.Row
    21		sc := bufio.NewScanner(f)
    22		for sc.Scan() {
    23			line := strings.TrimSpace(sc.Text())
    24			if line == "" || strings.HasPrefix(line, "#") {
    25				continue
    26			}
    27			parts := strings.Fields(line)
    28			if len(parts) == 0 {
    29				continue
    30			}
    31			if parts[0] == "BAD" {
    32				return nil, ErrReject
    33			}
    34			if len(parts) < 4 {
    35				continue
    36			}
    37			rows = append(rows, celltyp.Row{Kind: parts[0], Mod: parts[2], Fn: parts[3]})
    38		}
    39		return rows, sc.Err()
    40	}
===== wicksrc/nest.go =====
     1	package wicksrc
     2	
     3	import (
     4		"strings"
     5	
     6		"loft.local/wickpane/celltyp"
     7	)
     8	
     9	func Nest(rows []celltyp.Row) []celltyp.Row {
    10		out := make([]celltyp.Row, 0, len(rows))
    11		for _, r := range rows {
    12			if isGap(r) {
    13				continue
    14			}
    15			out = append(out, r)
    16		}
    17		return out
    18	}
    19	
    20	func isGap(r celltyp.Row) bool {
    21		k := strings.TrimSpace(r.Kind)
    22		if k != "i" {
    23			return false
    24		}
    25		return strings.TrimSpace(r.Fn) == "" || strings.TrimSpace(r.Mod) == ""
    26	}
===== pantryc/drop.go =====
     1	package pantryc
