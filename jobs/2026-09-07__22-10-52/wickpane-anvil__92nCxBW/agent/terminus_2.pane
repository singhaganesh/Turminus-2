===== millhint/trim.go =====
     1	package millhint
     2	
     3	import "strings"
     4	
     5	func Trim(tok string) string {
     6		i := strings.LastIndex(tok, "+")
     7		if i < 0 {
     8			return tok
     9		}
    10		head, tail := tok[:i+1], tok[i+1:]
    11		if len(tail) == 0 {
    12			return tok
    13		}
    14		b := []byte(tail)
    15		b[len(b)-1] = '0'
    16		return head + string(b)
    17	}
