     3	import (
     4		"strings"
     5	
     6		"loft.local/wickpane/celltyp"
     7	)
     8	
     9	func Drop(rows []celltyp.Row) []celltyp.Row {
    10		out := make([]celltyp.Row, 0, len(rows))
    11		for _, r := range rows {
    12			if skipClock(r.Mod) {
    13				continue
    14			}
    15			out = append(out, r)
    16		}
    17		return out
    18	}
    19	
    20	func skipClock(mod string) bool {
    21		m := strings.TrimSpace(mod)
    22		if i := strings.Index(m, "+"); i >= 0 {
    23			m = strings.TrimSpace(m[:i])
    24		}
    25		return m == "[vdso]" || strings.HasPrefix(m, "[vdso]")
    26	}
