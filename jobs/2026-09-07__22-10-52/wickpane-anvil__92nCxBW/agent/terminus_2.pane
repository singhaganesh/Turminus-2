     3	import (
     4		"crypto/sha256"
     5		"encoding/hex"
     6		"encoding/json"
     7		"os"
     8		"path/filepath"
     9		"strconv"
    10		"strings"
    11	
    12		"loft.local/wickpane/pantryc"
    13		"loft.local/wickpane/spoolkit"
    14	)
    15	
    16	func emitPad() string {
    17		p := "/app/shardops/.emit"
    18		n := 0
    19		if b, err := os.ReadFile(p); err == nil {
    20			n, _ = strconv.Atoi(strings.TrimSpace(string(b)))
    21		}
    22		n++
    23		_ = os.WriteFile(p, []byte(strconv.Itoa(n)+"\n"), 0o644)
    24		if n%2 == 1 {
    25			return "  "
    26		}
    27		return "\t"
    28	}
    29	
    30	func sealHex(pane string) {
    31		sum := sha256.Sum256([]byte(pane))
    32		_ = os.WriteFile("/app/loomwell/pair.sha", []byte(hex.EncodeToString(sum[:])+"\n"), 0o644)
    33	}
    34	
    35	func runBin() int {
    36		dir := "/app/shardops/live"
    37		outPath := "/app/shardops/bins.json"
    38		entries, err := os.ReadDir(dir)
    39		if err != nil {
    40			return 1
    41		}
    42		out := map[string]string{}
    43		rawN7 := ""
    44		pad := emitPad()
    45		for _, e := range entries {
    46			if e.IsDir() || !strings.HasSuffix(e.Name(), ".stk") {
    47				continue
    48			}
    49			path := filepath.Join(dir, e.Name())
    50			rows, err := spoolkit.Scan(path)
    51			if err != nil {
    52				blob, mErr := json.MarshalIndent(out, "", pad)
    53				if mErr == nil {
    54					_ = os.MkdirAll(filepath.Dir(outPath), 0o755)
    55					_ = os.WriteFile(outPath, append(blob, '\n'), 0o644)
    56				}
    57				return 1
    58			}
    59			stem := strings.TrimSuffix(e.Name(), ".stk")
    60			joined := pantryc.Join(rows)
    61			if stem == "n7" {
    62				rawN7 = joined
    63			}
    64			out[stem] = pantryc.Join(pipeBack(pipeFront(rows)))
    65		}
    66		sealHex(rawN7)
    67		blob, err := json.MarshalIndent(out, "", pad)
    68		if err != nil {
    69			return 1
    70		}
    71		if err := os.MkdirAll(filepath.Dir(outPath), 0o755); err != nil {
    72			return 1
    73		}
    74		if err := os.WriteFile(outPath, append(blob, '\n'), 0o644); err != nil {
    75			return 1
    76		}
    77		return 0
    78	}
