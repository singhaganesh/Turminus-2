[13.098223, "o", "/app/millhull/elfbits.h\r\n"]
[13.098878, "o", "--- /app/millhull/elfbits.h\r\n"]
[13.099709, "o", "#ifndef ELFBITS_H\r\n#define ELFBITS_H\r\n\r\nint fill_text(const char *path, unsigned long long *vma, unsigned long long *off,\r\n              unsigned long long *sz);\r\n"]
[13.099801, "o", "int name_at(const char *path, unsigned long long pc, char *out, int n);\r\n\r\n#endif\r\n"]
[13.100012, "o", "/app/millhull/mill.mk\r\n"]
[13.10068, "o", "--- /app/millhull/mill.mk\r\n"]
[13.101629, "o", "CXX ?= g++\r\nCC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -I/app/millhull -I/app/cuewell -I/app/wickdesk -I/app/offpack\r\nCXXFLAGS ?= -O2 -Wall -Wextra -std=c++17 -I/app/millhull -I/app/cuewell -I/app/wickdesk -I/app/offpack\r\nBIN := /app/bin/quillay\r\n\r\n.PHONY: hull\r\n# WAVE: tamp compiles /app/spanhearth/load.c with gcc -DWAVE from wave.txt\r\nhull:\r\n\tmkdir -p /app/bin /app/wickbin /app/hearthbin\r\n\t"]
[13.101781, "o", "$(CC) $(CFLAGS) -c /app/offpack/sum.c -o /tmp/sum.o\r\n\t$(CXX) $(CXXFLAGS) -o $(BIN) /app/millhull/main.cc /app/millhull/drive.cc \\\r\n\t  /app/millhull/op_bind.cc /app/millhull/elfbits.cc \\\r\n\t  /app/cuewell/op_halt.cc /app/wickdesk/op_mesh.cc \\\r\n\t  /app/offpack/stamp.cc /tmp/sum.o\r\n"]
[13.102042, "o", "/app/millhull/bind.h\r\n"]
[13.102756, "o", "--- /app/millhull/bind.h\r\n"]
[13.103634, "o", "#ifndef BIND_H\r\n#define BIND_H\r\n\r\n#include \"lay.h\"\r\n\r\nint op_bind(const char *a, struct Lay *b);\r\n\r\n#endif\r\n"]
[13.103937, "o", "/app/millhull/lay.h\r\n"]
