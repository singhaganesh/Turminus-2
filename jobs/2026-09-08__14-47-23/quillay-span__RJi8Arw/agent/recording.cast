[13.083933, "o", "find /app -maxdepth 4 -type f \\( -name '*.c' -o -name '*.h' -o -name 'Makefile' -o -name '*.mk' -o -name 'CMakeLists.txt' \\) -print -exec sh -c 'echo \"--- $1\"; sed -n \"1,260p\" \"$1\"' sh {} \\;"]
[13.084083, "o", "\r\n\u001b[?2004l\r"]
[13.086194, "o", "/app/spanhearth/load.c\r\n"]
