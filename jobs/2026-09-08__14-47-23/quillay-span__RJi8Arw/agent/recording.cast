[12.882215, "o", "void ring_pump(void) {\r\n  volatile int x = 1;\r\n#if WAVE >= 2\r\n  volatile char pad[4096];\r\n  pad[0] = (char)x;\r\n#endif\r\n  (void)x;\r\n}\r\n\r\nvoid dusk_lamp(void) {\r\n"]
[12.882326, "o", "  volatile int y = 2;\r\n  (void)y;\r\n}\r\n\r\n#if WAVE >= 3\r\nvoid held_wick(void) {\r\n  volatile int z = 3;\r\n  (void)z;\r\n}\r\n#endif\r\n\r\nint main(void) {\r\n  ring_pump();\r\n  dusk_lamp();\r\n#if WAVE >= 3\r\n  held_wick();\r\n#endif\r\n  return 0;\r\n}\r\n"]
