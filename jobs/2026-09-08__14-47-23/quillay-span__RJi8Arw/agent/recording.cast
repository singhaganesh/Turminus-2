[94.678977, "o", "}\r\n\r\nint op_bind(const char *a, struct Lay *b) {\r\n  struct stat st;\r\n  if (stat(a, &st) != 0) return -1;\r\n  struct Lay old;\r\n  memset(&old, 0, sizeof(old));\r\n  int have = read_row(&old);\r\n  memset(b, 0, sizeof(*b));\r\n  strncpy(b->path, a, sizeof(b->path) - 1);\r\n  b->dev = (unsigned long long)st.st_dev;\r\n  b->ino = (unsigned long long)st.st_ino;\r\n  char hex[65];\r\n  if (file_sha256_hex(a, hex) != 0) return -1;\r\n  strncpy(b->dig, hex, sizeof(b->dig) - 1);\r\n  char stored[65] = {0};\r\n  FILE *ck = fopen(\"/app/wickbin/clock.txt\", \"r\");\r\n"]
[94.679024, "o", "  if (ck) {\r\n    fscanf(ck, \"%64s\", stored);\r\n    fclose(ck);\r\n  }\r\n  if (have && old.dev == b->dev && old.ino == b->ino &&\r\n      strcmp(hex, stored) == 0) {\r\n    *b = old;\r\n    strncpy(b->path, a, sizeof(b->path) - 1);\r\n    write_row(b);\r\n    return 1;\r\n  }\r\n  if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) return -1;\r\n  FILE *cw = fopen(\"/app/wickbin/clock.txt\", \"w\");\r\n  if (cw) {\r\n    fprintf(cw, \"%llu\\n\", stamp_sec(a));\r\n"]
[94.679103, "o", "    fclose(cw);\r\n  }\r\n  if (write_row(b) != 0) return -1;\r\n  return 0;\r\n}\r\n"]
[94.679755, "o", "---\r\n"]
[94.680784, "o", "#include \"halt.h\"\r\n\r\n#include \"lay.h\"\r\n#include \"sum.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\nint op_halt(void) {\r\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n  if (!fp) return 1;\r\n  char line[512];\r\n  if (!fgets(line, sizeof(line), fp)) {\r\n    fclose(fp);\r\n    return 1;\r\n  }\r\n  if (!fgets(line, sizeof(line), fp)) {\r\n    fclose(fp);\r\n    return 1;\r\n  }\r\n  fclose(fp);\r\n  char path[256];\r\n  unsigned long long dev = 0, ino = 0, vma = 0, off = 0, sz = 0;\r\n  if (sscanf(line, \"%255s %llu %llu %llu %llu %llu\", path, &dev, &ino, &vma, &off, &sz) != 6)\r\n    return 1;\r\n  (void)vma;\r\n  (void)off;\r\n  (void)sz;\r\n  struct stat st;\r\n  if (stat(path, &st) != 0) return 1;\r\n  unsigned long long stored = 0;\r\n  FILE *ck = fopen(\"/app/wickbin/clock.txt\", \"r\");\r\n  if (ck) {\r\n    fscanf(ck, \"%llu\", &stored);\r\n    fclose(ck);\r\n  }\r\n  if ((unsigned long long)st.st_dev == dev && (unsigned long long)st.st_ino == ino &&\r\n      stamp_same(path, stored))\r\n    return 0;\r\n  return 1;\r\n}\r\n"]
[94.681064, "o", "--- mesh\r\n"]
[94.683079, "o", "#include \"mesh.h\"\r\n\r\n#include \"elfbits.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint op_mesh(const char *a, const struct Lay *b, int c) {\r\n  (void)a;\r\n  (void)b;\r\n  (void)c;\r\n  FILE *lst = fopen(\"/app/spanhearth/pc.lst\", \"r\");\r\n  FILE *out = fopen(\"/app/wickbin/flame.qprf\", \"w\");\r\n  if (!lst || !out) {\r\n    if (lst) fclose(lst);\r\n    if (out) fclose(out);\r\n"]
[94.683409, "o", "    return -1;\r\n  }\r\n  fprintf(out, \"QPRF1\\n\");\r\n  char line[128];\r\n  while (fgets(line, sizeof(line), lst)) {\r\n    unsigned long long pc = 0;\r\n    if (sscanf(line, \"%llx\", &pc) != 1) continue;\r\n    char name[128];\r\n    name_at(a, pc, name, sizeof(name));\r\n    fprintf(out, \"%llx %s\\n\", pc, name);\r\n  }\r\n  fclose(lst);\r\n  fclose(out);\r\n  return 0;\r\n}\r\n"]
[94.683564, "o", "\u001b[?2004hroot@c5d6a0f1920c:/app# "]
[94.835166, "i", "cat > /app/millhull/op_bind.cc <<'EOF'\n#include \"bind.h\"\n\n#include \"elfbits.h\"\n#include \"sum.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nstatic int read_row(struct Lay *b) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\n  if (!fp) return 0;\n  char head[32], line[512];\n  if (!fgets(head, sizeof(head), fp) || strcmp(head, \"QMAP1\\n\") != 0 ||\n      !fgets(line, sizeof(line), fp)) {\n    fclose(fp);\n    return 0;\n  }\n  fclose(fp);\n  unsigned long long vma = 0, off = 0, sz = 0, dev = 0, ino = 0;\n  char path[256] = {0}, extra;\n  if (sscanf(line, \"%255s %llu %llu %llu %llu %llu %c\", path, &dev, &ino,\n             &vma, &off, &sz, &extra) != 6)\n    return 0;\n  snprintf(b->path, sizeof(b->path), \"%s\", path);\n  b->dev = dev;\n  b->ino = ino;\n  b->vma = vma;\n  b->off = off;\n  b->sz = sz;\n  return 1;\n}\n\nstatic int write_row(const struct Lay *b) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"w\");\n  if (!fp) return -1;\n  int ok = fprintf(fp, \"QMAP1\\n%s %llu %llu %llu %llu %llu\\n\", b->path,\n                   b->dev, b->ino, b->vma, b->off, b->sz) >= 0;\n  if (fclose(fp) != 0) ok = 0;\n  return ok ? 0 : -1;\n}\n\nstatic int read_digest(char out[65]) {\n  FILE *fp = fopen(\"/app/wickbin/clock.txt\", \"r\");\n  if (!fp) return 0;\n  int ok = fscanf(fp, \"%64s\", out) == 1 && strlen(out) == 64;\n  fclose(fp);\n  return ok;\n}\n\nstatic int write_digest(const char *hex) {\n  FILE *fp = fopen(\"/app/wickbin/clock.txt\", \"w\");\n  if (!fp) return -1;\n  int ok = fprintf(fp, \"%s\\n\", hex) == 65;\n  if (fclose(fp) != 0) ok = 0;\n  return ok ? 0 : -1;\n}\n\nint op_bind(const char *a, struct Lay *b) {\n  struct stat st;\n  if (stat(a, &st) != 0) return -1;\n  struct Lay old = {};\n  int have = read_row(&old);\n\n  memset(b, 0, sizeof(*b));\n  snprintf(b->path, sizeof(b->path), \"%s\", a);\n  b->dev = (unsigned long long)st.st_dev;\n  b->ino = (unsigned long long)st.st_ino;\n  if (file_sha256_hex(a, b->dig) != 0) return -1;\n\n  char stored[65] = {0};\n  int same = have && read_digest(stored) && strcmp(old.path, a) == 0 &&\n             old.dev == b->dev && old.ino == b->ino &&\n             strcmp(stored, b->dig) == 0;\n  if (same) {\n    b->vma = old.vma;\n    b->off = old.off;\n    b->sz = old.sz;\n  } else if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) {\n    return -1;\n  }\n\n  if (write_row(b) != 0 || write_digest(b->dig) != 0) return -1;\n  return same ? 1 : 0;\n}\nEOF\ncat > /app/cuewell/op_halt.cc <<'EOF'\n#include \"halt.h\"\n\n#include \"sum.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nint op_halt(void) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\n  if (!fp) return 1;\n  char head[32], line[512];\n  if (!fgets(head, sizeof(head), fp) || strcmp(head, \"QMAP1\\n\") != 0 ||\n      !fgets(line, sizeof(line), fp)) {\n    fclose(fp);\n    return 1;\n  }\n  fclose(fp);\n\n  char path[256] = {0}, extra;\n  unsigned long long dev, ino, vma, off, sz;\n  if (sscanf(line, \"%255s %llu %llu %llu %llu %llu %c\", path, &dev, &ino,\n             &vma, &off, &sz, &extra) != 6)\n    return 1;\n\n  struct stat st;\n  if (stat(path, &st) != 0 || (unsigned long long)st.st_dev != dev ||\n      (unsigned long long)st.st_ino != ino)\n    return 1;\n\n  char stored[65] = {0}, current[65];\n  fp = fopen(\"/app/wickbin/clock.txt\", \"r\");\n  if (!fp) return 1;\n  int got = fscanf(fp, \"%64s\", stored);\n  fclose(fp);\n  if (got != 1 || strlen(stored) != 64 ||\n      file_sha256_hex(path, current) != 0)\n    return 1;\n  return strcmp(stored, current) == 0 ? 0 : 1;\n}\nEOF\nmake -f /app/millhull/mill.mk hull\n"]
[94.835646, "o", "cat > /app/millhull/op_bind.cc <<'EOF'\r\n\u001b[?2004l\r"]
[94.8358, "o", "\u001b[?2004h> "]
[94.836115, "o", "#include \"bind.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include \"elfbits.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"sum.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
