[34.378477, "o", "     8\t#include <string.h>\r\n     9\t#include <sys/stat.h>\r\n    10\t\r\n    11\tstatic int read_row(struct Lay *b) {\r\n    12\t  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n    13\t  if (!fp) return 0;\r\n    14\t  char line[512];\r\n    15\t  if (!fgets(line, sizeof(line), fp)) {\r\n    16\t    fclose(fp);\r\n    17\t    return 0;\r\n    18\t  }\r\n    19\t  if (!fgets(line, sizeof(line), fp)) {\r\n    20\t    fclose(fp);\r\n    21\t    return 0;\r\n    22\t  }\r\n    23\t  fclose(fp);\r\n    24\t  unsigned long long vma = 0, off = 0, sz = 0, dev = 0, ino = 0;\r\n    25\t  char path[256];\r\n    26\t  memset(path, 0, sizeof(path));\r\n    27\t  if (sscanf(line, \"%255s %llu %llu %llu %llu %llu\", path, &dev, &ino, &vma, &off, &sz) != 6)\r\n    28\t    return 0;\r\n    29\t  strncpy(b->path, path, sizeof(b->path) - 1);\r\n    30\t  b->dev = dev;\r\n    31\t  b->ino = ino;\r\n    32\t  b->vma = vma;\r\n    33\t  b->off = off;\r\n    34\t  b->sz = sz;\r\n    35\t  return 1;\r\n    36\t}\r\n    37\t\r\n    38\tstatic int write_row(const struct Lay *b) {\r\n    39\t  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"w\");\r\n    40\t  if (!fp) return -1;\r\n    41\t  fprintf(fp, \"QMAP1\\n\");\r\n    42\t  fprintf(fp, \"%s %llu %llu %llu %llu %llu\\n\", b->path, b->dev, b->ino, b->vma, b->off, b->sz);\r\n    43\t  fclose(fp);\r\n    44\t  return 0;\r\n    45\t}\r\n    46\t\r\n    47\tint op_bind(const char *a, struct Lay *b) {\r\n"]
[34.378683, "o", "    48\t  struct stat st;\r\n    49\t  if (stat(a, &st) != 0) return -1;\r\n    50\t  struct Lay old;\r\n    51\t  memset(&old, 0, sizeof(old));\r\n    52\t  int have = read_row(&old);\r\n    53\t  memset(b, 0, sizeof(*b));\r\n    54\t  strncpy(b->path, a, sizeof(b->path) - 1);\r\n    55\t  b->dev = (unsigned long long)st.st_dev;\r\n    56\t  b->ino = (unsigned long long)st.st_ino;\r\n    57\t  char hex[65];\r\n    58\t  if (file_sha256_hex(a, hex) != 0) return -1;\r\n    59\t  (void)hex;\r\n    60\t  unsigned long long stored = 0;\r\n    61\t  FILE *ck = fopen(\"/app/wickbin/clock.txt\", \"r\");\r\n    62\t  if (ck) {\r\n    63\t    fscanf(ck, \"%llu\", &stored);\r\n    64\t    fclose(ck);\r\n    65\t  }\r\n"]
[34.378864, "o", "    66\t  if (have && old.dev == b->dev && old.ino == b->ino && stamp_same(a, stored)) {\r\n    67\t    *b = old;\r\n    68\t    strncpy(b->path, a, sizeof(b->path) - 1);\r\n    69\t    write_row(b);\r\n    70\t    return 1;\r\n    71\t  }\r\n    72\t  if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) return -1;\r\n    73\t  FILE *cw = fopen(\"/app/wickbin/clock.txt\", \"w\");\r\n    74\t  if (cw) {\r\n    75\t    fprintf(cw, \"%llu\\n\", stamp_sec(a));\r\n    76\t    fclose(cw);\r\n    77\t  }\r\n    78\t  if (write_row(b) != 0) return -1;\r\n    79\t  return 0;\r\n    80\t}\r\n"]
