    14	static int do_knit(void) {
    15	  FILE *wf = fopen("/app/spanhearth/wave.txt", "r");
    16	  int wave = 1;
    17	  if (wf) {
    18	    fscanf(wf, "%d", &wave);
    19	    fclose(wf);
    20	  }
    21	  char cmd[256];
    22	  snprintf(cmd, sizeof(cmd),
    23	           "gcc -no-pie -fno-pie -O0 -DWAVE=%d -o /tmp/span.new /app/spanhearth/load.c",
    24	           wave);
    25	  if (system(cmd) != 0) return 1;
    26	  FILE *in = fopen("/tmp/span.new", "rb");
    27	  FILE *out = fopen("/app/hearthbin/span.elf", "r+b");
    28	  if (!out) {
    29	    out = fopen("/app/hearthbin/span.elf", "wb");
    30	  }
    31	  if (!in || !out) {
    32	    if (in) fclose(in);
    33	    if (out) fclose(out);
    34	    return 1;
    35	  }
    36	  char buf[4096];
    37	  size_t n;
    38	  long total = 0;
    39	  rewind(out);
    40	  while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {
    41	    if (fwrite(buf, 1, n, out) != n) {
    42	      fclose(in);
    43	      fclose(out);
    44	      return 1;
    45	    }
    46	    total += (long)n;
    47	  }
    48	  fclose(in);
    49	  if (ftruncate(fileno(out), total) != 0) {
    50	    fclose(out);
    51	    return 1;
    52	  }
    53	  fclose(out);
    54	  chmod("/app/hearthbin/span.elf", 0755);
    55	  stamp_zero("/app/hearthbin/span.elf");
    56	  FILE *nm = popen("nm -P /app/hearthbin/span.elf", "r");
    57	  FILE *pc = fopen("/app/spanhearth/pc.lst", "w");
    58	  if (!nm || !pc) return 1;
    59	  char line[256];
    60	  while (fgets(line, sizeof(line), nm)) {
    61	    char name[128], typ[8];
    62	    unsigned long long addr = 0, sz = 0;
    63	    if (sscanf(line, "%127s %7s %llx %llx", name, typ, &addr, &sz) >= 3) {
    64	      if (strcmp(name, "ring_pump") == 0 || strcmp(name, "dusk_lamp") == 0 ||
    65	          strcmp(name, "held_wick") == 0) {
    66	        fprintf(pc, "%llx\n", addr);
    67	      }
    68	    }
    69	  }
    70	  pclose(nm);
    71	  fclose(pc);
    72	  return 0;
    73	}
