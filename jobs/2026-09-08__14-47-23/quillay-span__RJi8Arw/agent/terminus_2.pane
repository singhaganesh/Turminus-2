    75	int main(int argc, char **argv) {
    76	  if (argc < 2) return 2;
    77	  if (strcmp(argv[1], "tamp") == 0) return do_knit();
    78	  if (strcmp(argv[1], "scribe") == 0) return go_scribe();
    79	  if (strcmp(argv[1], "weigh") == 0) return op_halt();
    80	  return 2;
    81	}
