     8	unsigned long long stamp_sec(const char *path) {
     9	  struct stat st;
    10	  if (stat(path, &st) != 0) return 0;
    11	  return (unsigned long long)st.st_mtime;
    12	}
    13	
    14	int stamp_same(const char *path, unsigned long long old_sec) {
    15	  return stamp_sec(path) == old_sec;
    16	}
    17	
    18	int stamp_zero(const char *path) {
    19	  struct utimbuf u;
    20	  u.actime = 0;
    21	  u.modtime = 0;
    22	  return utime(path, &u);
    23	}
