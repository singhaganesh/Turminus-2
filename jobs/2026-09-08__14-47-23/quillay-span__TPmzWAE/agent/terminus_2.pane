    10	
    11	static int read_row(struct Lay *b) {
    12	  FILE *fp = fopen("/app/wickbin/layout.qmap", "r");
    13	  if (!fp) return 0;
    14	  char line[512];
    15	  if (!fgets(line, sizeof(line), fp)) {
    16	    fclose(fp);
    17	    return 0;
    18	  }
    19	  if (!fgets(line, sizeof(line), fp)) {
    20	    fclose(fp);
    21	    return 0;
    22	  }
    23	  fclose(fp);
    24	  unsigned long long vma = 0, off = 0, sz = 0, dev = 0, ino = 0;
    25	  char path[256];
    26	  memset(path, 0, sizeof(path));
    27	  if (sscanf(line, "%255s %llu %llu %llu %llu %llu", path, &dev, &ino, &vma, &off, &sz) != 6)
    28	    return 0;
    29	  strncpy(b->path, path, sizeof(b->path) - 1);
    30	  b->dev = dev;
    31	  b->ino = ino;
    32	  b->vma = vma;
    33	  b->off = off;
    34	  b->sz = sz;
    35	  return 1;
    36	}
    37	
    38	static int write_row(const struct Lay *b) {
    39	  FILE *fp = fopen("/app/wickbin/layout.qmap", "w");
    40	  if (!fp) return -1;
    41	  fprintf(fp, "QMAP1\n");
    42	  fprintf(fp, "%s %llu %llu %llu %llu %llu\n", b->path, b->dev, b->ino, b->vma, b->off, b->sz);
    43	  fclose(fp);
    44	  return 0;
    45	}
    46	
    47	int op_bind(const char *a, struct Lay *b) {
    48	  struct stat st;
    49	  if (stat(a, &st) != 0) return -1;
    50	  struct Lay old;
    51	  memset(&old, 0, sizeof(old));
    52	  int have = read_row(&old);
    53	  memset(b, 0, sizeof(*b));
    54	  strncpy(b->path, a, sizeof(b->path) - 1);
    55	  b->dev = (unsigned long long)st.st_dev;
    56	  b->ino = (unsigned long long)st.st_ino;
    57	  char hex[65];
    58	  if (file_sha256_hex(a, hex) != 0) return -1;
    59	  (void)hex;
    60	  unsigned long long stored = 0;
    61	  FILE *ck = fopen("/app/wickbin/clock.txt", "r");
    62	  if (ck) {
    63	    fscanf(ck, "%llu", &stored);
    64	    fclose(ck);
    65	  }
    66	  if (have && old.dev == b->dev && old.ino == b->ino && stamp_same(a, stored)) {
    67	    *b = old;
    68	    strncpy(b->path, a, sizeof(b->path) - 1);
    69	    write_row(b);
    70	    return 1;
    71	  }
    72	  if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) return -1;
    73	  FILE *cw = fopen("/app/wickbin/clock.txt", "w");
    74	  if (cw) {
    75	    fprintf(cw, "%llu\n", stamp_sec(a));
    76	    fclose(cw);
    77	  }
    78	  if (write_row(b) != 0) return -1;
    79	  return 0;
    80	}
