    19	    fclose(fp);
    20	    return 1;
    21	  }
    22	  fclose(fp);
    23	  char path[256];
    24	  unsigned long long dev = 0, ino = 0, vma = 0, off = 0, sz = 0;
    25	  if (sscanf(line, "%255s %llu %llu %llu %llu %llu", path, &dev, &ino, &vma, &off, &sz) != 6)
    26	    return 1;
    27	  (void)vma;
    28	  (void)off;
    29	  (void)sz;
    30	  struct stat st;
    31	  if (stat(path, &st) != 0) return 1;
