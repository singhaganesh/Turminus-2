[82.650653, "i", "cat > /app/millhull/op_bind.cc <<'EOF'\n#include \"bind.h\"\n\n#include \"elfbits.h\"\n#include \"sum.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nstatic const char *clock_path = \"/app/wickbin/clock.txt\";\n\nstatic int read_row(struct Lay *b) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\n  if (!fp) return 0;\n  char head[32], line[512];\n  int ok = fgets(head, sizeof(head), fp) && strcmp(head, \"QMAP1\\n\") == 0 &&\n           fgets(line, sizeof(line), fp);\n  fclose(fp);\n  if (!ok) return 0;\n  unsigned long long vma = 0, off = 0, sz = 0, dev = 0, ino = 0;\n  char path[256] = {0};\n  if (sscanf(line, \"%255s %llu %llu %llu %llu %llu\", path, &dev, &ino,\n             &vma, &off, &sz) != 6)\n    return 0;\n  strncpy(b->path, path, sizeof(b->path) - 1);\n  b->dev = dev;\n  b->ino = ino;\n  b->vma = vma;\n  b->off = off;\n  b->sz = sz;\n  return 1;\n}\n\nstatic int read_digest(char out[65]) {\n  FILE *fp = fopen(clock_path, \"r\");\n  if (!fp) return 0;\n  char extra = 0;\n  int ok = fscanf(fp, \"%64[0-9a-f] %c\", out, &extra) == 1 && strlen(out) == 64;\n  fclose(fp);\n  return ok;\n}\n\nstatic int write_products(const struct Lay *b, const char digest[65]) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"w\");\n  if (!fp) return -1;\n  fprintf(fp, \"QMAP1\\n%s %llu %llu %llu %llu %llu\\n\", b->path, b->dev,\n          b->ino, b->vma, b->off, b->sz);\n  if (fclose(fp) != 0) return -1;\n  fp = fopen(clock_path, \"w\");\n  if (!fp) return -1;\n  fprintf(fp, \"%s\\n\", digest);\n  return fclose(fp) == 0 ? 0 : -1;\n}\n\nint op_bind(const char *a, struct Lay *b) {\n  struct stat st;\n  if (stat(a, &st) != 0) return -1;\n\n  char digest[65] = {0}, stored[65] = {0};\n  if (file_sha256_hex(a, digest) != 0) return -1;\n\n  struct Lay old;\n  memset(&old, 0, sizeof(old));\n  int have = read_row(&old);\n  int have_digest = read_digest(stored);\n\n  memset(b, 0, sizeof(*b));\n  strncpy(b->path, a, sizeof(b->path) - 1);\n  b->dev = (unsigned long long)st.st_dev;\n  b->ino = (unsigned long long)st.st_ino;\n\n  int reuse = have && have_digest && strcmp(old.path, a) == 0 &&\n              old.dev == b->dev && old.ino == b->ino &&\n              strcmp(stored, digest) == 0;\n  if (reuse) {\n    *b = old;\n    strncpy(b->path, a, sizeof(b->path) - 1);\n  } else if (fill_text(a, &b->vma, &b->off, &b->sz) != 0) {\n    return -1;\n  }\n\n  strncpy(b->dig, digest, sizeof(b->dig) - 1);\n  if (write_products(b, digest) != 0) return -1;\n  return reuse ? 1 : 0;\n}\nEOF\n\ncat > /app/cuewell/op_halt.cc <<'EOF'\n#include \"halt.h\"\n\n#include \"sum.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n\nint op_halt(void) {\n  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\n  if (!fp) return 1;\n  char head[32], line[512];\n  int ok = fgets(head, sizeof(head), fp) && strcmp(head, \"QMAP1\\n\") == 0 &&\n           fgets(line, sizeof(line), fp);\n  fclose(fp);\n  if (!ok) return 1;\n\n  char path[256] = {0};\n  unsigned long long dev = 0, ino = 0, vma = 0, off = 0, sz = 0;\n  if (sscanf(line, \"%255s %llu %llu %llu %llu %llu\", path, &dev, &ino,\n             &vma, &off, &sz) != 6)\n    return 1;\n\n  struct stat st;\n  if (stat(path, &st) != 0 || (unsigned long long)st.st_dev != dev ||\n      (unsigned long long)st.st_ino != ino)\n    return 1;\n\n  char stored[65] = {0}, current[65] = {0}, extra = 0;\n  fp = fopen(\"/app/wickbin/clock.txt\", \"r\");\n  if (!fp) return 1;\n  ok = fscanf(fp, \"%64[0-9a-f] %c\", stored, &extra) == 1 && strlen(stored) == 64;\n  fclose(fp);\n  if (!ok || file_sha256_hex(path, current) != 0) return 1;\n  return strcmp(stored, current) == 0 ? 0 : 1;\n}\nEOF\n\npython3 - <<'PY'\np='/app/wickdesk/op_mesh.cc'\ns=open(p).read()\ns=s.replace('  if (c) {\\n    return 0;\\n  }', '  (void)c;  /* Flame data is always derived from the live ELF. */')\nopen(p,'w').write(s)\nPY\nmake -f /app/millhull/mill.mk hull\n"]
[82.651047, "o", "cat > /app/millhull/op_bind.cc <<'EOF'\r\n\u001b[?2004l\r"]
