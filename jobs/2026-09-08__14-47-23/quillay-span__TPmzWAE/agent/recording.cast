[28.805407, "o", "     1\t#include \"bind.h\"\r\n     2\t#include \"mesh.h\"\r\n     3\t#include \"lay.h\"\r\n     4\t\r\n     5\tint go_scribe(void) {\r\n     6\t  struct Lay lay;\r\n     7\t  int reuse = op_bind(\"/app/hearthbin/span.elf\", &lay);\r\n     8\t  if (reuse < 0) return 1;\r\n     9\t  if (op_mesh(\"/app/hearthbin/span.elf\", &lay, reuse) != 0) return 1;\r\n"]
