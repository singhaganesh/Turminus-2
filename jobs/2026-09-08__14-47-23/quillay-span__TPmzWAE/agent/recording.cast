[82.651251, "o", "\u001b[?2004h> "]
[82.651408, "o", "#include \"elfbits.h\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.651439, "o", "#include \"sum.h\"\r\n\u001b[?2004l\r"]
[82.651472, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
