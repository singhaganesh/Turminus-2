[42.32134, "o", "     1\t#include \"halt.h\"\r\n     2\t\r\n     3\t#include \"lay.h\"\r\n     4\t#include \"stamp.h\"\r\n     5\t\r\n     6\t#include <stdio.h>\r\n     7\t#include <string.h>\r\n     8\t#include <sys/stat.h>\r\n     9\t\r\n    10\tint op_halt(void) {\r\n    11\t  FILE *fp = fopen(\"/app/wickbin/layout.qmap\", \"r\");\r\n    12\t  if (!fp) return 1;\r\n    13\t  char line[512];\r\n    14\t  if (!fgets(line, sizeof(line), fp)) {\r\n    15\t    fclose(fp);\r\n"]
