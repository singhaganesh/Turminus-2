[?2004l[?2004h> 
[?2004l[?2004h> LINE_Y = 70
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _foreground(frames):
[?2004l[?2004h>     """Return stable-background foreground masks for an offline recording."""
[?2004l[?2004h>     stack = np.asarray(frames, dtype=np.uint8)
[?2004l[?2004h>     bg = np.median(stack, axis=0).astype(np.uint8)
[?2004l[?2004h>     masks = []
[?2004l[?2004h>     kernel = np.ones((3, 3), np.uint8)
[?2004l[?2004h>     for frame in frames:
[?2004l[?2004h>         d = cv2.absdiff(frame, bg)
[?2004l[?2004h>         # max-channel distance preserves saturated objects against gray scenery.
[?2004l[?2004h>         m = (np.max(d, axis=2) >= 24).astype(np.uint8) * 255
[?2004l[?2004h>         m = cv2.morphologyEx(m, cv2.MORPH_OPEN, kernel)
[?2004l[?2004h>         m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, kernel)
[?2004l[?2004h>         masks.append(m)
[?2004l[?2004h>     return masks
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _detections(frame, mask):
[?2004l[?2004h>     n, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)
[?2004l[?2004h>     out = []
[?2004l[?2004h>     for i in range(1, n):
[?2004l[?2004h>         x, y, w, h, area = map(int, stats[i])
[?2004l[?2004h>         if area < 20 or w < 3 or h < 3:
[?2004l[?2004h>             continue
[?2004l[?2004h>         pix = frame[labels == i]
[?2004l[?2004h>         color = np.median(pix, axis=0) if len(pix) else np.zeros(3)
[?2004l[?2004h>         out.append({
[?2004l[?2004h>             "x": float(centers[i, 0]), "y": float(centers[i, 1]),
[?2004l[?2004h>             "box": (x, y, w, h), "area": float(area),
[?2004l[?2004h>             "color": color.astype(float),
[?2004l[?2004h>         })
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _pred(t, frame_no):
[?2004l[?2004h>     dt = frame_no - t["last_frame"]
[?2004l[?2004h>     # Prediction is bounded; stale velocity should not run far off-screen.
[?2004l[?2004h>     dtp = min(dt, 8)
[?2004l[?2004h>     return t["x"] + t["vx"] * dtp, t["y"] + t["vy"] * dtp
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def count_bodies(frames) -> int:
[?2004l[?2004h>     if not frames:
[?2004l[?2004h>         raise ValueError("recording has no decodable frames")
[?2004l[?2004h>     masks = _foreground(frames)
[?2004l[?2004h>     tracks = []
[?2004l[?2004h>     next_id = 0
[?2004l[?2004h> 
[?2004l[?2004h>     for fi, (frame, mask) in enumerate(zip(frames, masks)):
[?2004l[?2004h>         dets = _detections(frame, mask)
[?2004l[?2004h>         pairs = []
[?2004l[?2004h>         for ti, t in enumerate(tracks):
[?2004l[?2004h>             px, py = _pred(t, fi)
[?2004l[?2004h>             gap = fi - t["last_frame"]
[?2004l[?2004h>             for di, d in enumerate(dets):
[?2004l[?2004h>                 dist = ((px-d["x"])**2 + (py-d["y"])**2) ** 0.5
[?2004l[?2004h>                 col = float(np.linalg.norm(t["color"]-d["color"]))
[?2004l[?2004h>                 # Wide enough for the 6 px/frame station motion and brief occlusion.
[?2004l[?2004h>                 limit = 15 + 5 * min(gap, 8)
[?2004l[?2004h>                 if dist <= limit:
[?2004l[?2004h>                     pairs.append((dist + min(col, 120)*0.035 + gap*0.2, ti, di))
[?2004l[?2004h>         pairs.sort()
[?2004l[?2004h>         used_t, used_d = set(), set()
[?2004l[?2004h>         assignments = []
[?2004l[?2004h>         for _, ti, di in pairs:
[?2004l[?2004h>             if ti not in used_t and di not in used_d:
[?2004l[?2004h>                 used_t.add(ti); used_d.add(di); assignments.append((ti, di))
[?2004l[?2004h> 
[?2004l[?2004h>         for ti, di in assignments:
[?2004l[?2004h>             t, d = tracks[ti], dets[di]
[?2004l[?2004h>             gap = fi - t["last_frame"]
[?2004l[?2004h>             nvx = (d["x"] - t["x"]) / max(1, gap)
[?2004l[?2004h>             nvy = (d["y"] - t["y"]) / max(1, gap)
[?2004l[?2004h>             # Smooth only on consecutive observations; after occlusion trust displacement.
[?2004l[?2004h>             if gap == 1:
[?2004l[?2004h>                 t["vx"] = .55*t["vx"] + .45*nvx
[?2004l[?2004h>                 t["vy"] = .55*t["vy"] + .45*nvy
[?2004l[?2004h>             else:
[?2004l[?2004h>                 t["vx"], t["vy"] = nvx, nvy
[?2004l[?2004h>             t["x"], t["y"] = d["x"], d["y"]
[?2004l[?2004h>             t["last_frame"] = fi
[?2004l[?2004h>             t["color"] = .7*t["color"] + .3*d["color"]
[?2004l[?2004h>             t["area"] = .8*t["area"] + .2*d["area"]
[?2004l[?2004h>             update_passage(t, d["y"], True)
[?2004l[?2004h> 
[?2004l[?2004h>         # An unmatched old track whose prediction lies in a matched blob is occluded,
[?2004l[?2004h>         # not dead. Preserve it without treating a guessed centroid as a crossing.
[?2004l[?2004h>         for ti, t in enumerate(tracks):
[?2004l[?2004h>             if ti in used_t:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             px, py = _pred(t, fi)
[?2004l[?2004h>             for di in used_d:
[?2004l[?2004h>                 x, y, w, h = dets[di]["box"]
[?2004l[?2004h>                 if x-5 <= px <= x+w+5 and y-5 <= py <= y+h+5:
[?2004l[?2004h>                     t["occluded"] = True
[?2004l[?2004h>                     break
[?2004l[?2004h> 
[?2004l[?2004h>         for di, d in enumerate(dets):
[?2004l[?2004h>             if di in used_d:
