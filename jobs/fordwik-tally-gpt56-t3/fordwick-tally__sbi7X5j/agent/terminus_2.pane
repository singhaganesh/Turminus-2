[?2004l[?2004h> 
[?2004l[?2004h> def update_passage(track, y: float, observed: bool = True) -> None:
[?2004l[?2004h>     """Update one track's directional gate; each track can fire only once."""
[?2004l[?2004h>     if not observed:
[?2004l[?2004h>         return
[?2004l[?2004h>     if y <= LINE_Y - 2:
[?2004l[?2004h>         track["armed"] = True
[?2004l[?2004h>         track["min_y"] = min(track.get("min_y", y), y)
[?2004l[?2004h>     if track.get("armed") and y >= LINE_Y + 2:
[?2004l[?2004h>         # Require meaningful top-to-bottom displacement, not scan-row jitter.
[?2004l[?2004h>         if y - track.get("min_y", y) >= 5:
[?2004l[?2004h>             track["completed"] = True
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def fold_gate(tracks) -> int:
