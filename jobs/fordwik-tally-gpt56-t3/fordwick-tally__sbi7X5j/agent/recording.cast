[164.918371, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[165.85209, "i", "cat > /tmp/make_tests.py <<'PY'\nimport cv2, numpy as np, os\nos.makedirs('/tmp/cases',exist_ok=True)\nW,H=160,120\nbg=np.full((H,W,3),45,np.uint8)\n# add static texture\nbg[:,::20]=(52,48,44); bg[::20,:]=(40,44,48)\ndef write(name, paths):\n out=cv2.VideoWriter('/tmp/cases/'+name+'.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\n for objs in paths:\n  f=bg.copy()\n  for x,y,c in objs: cv2.circle(f,(int(x),int(y)),9,c,-1)\n  out.write(f)\n out.release()\ndef seq(path, pads=3): return [[]]*pads+path+[[]]*pads\n# one downward; upward only; two simultaneous\nwrite('down1',seq([[(40,y,(40,60,220))] for y in range(10,111,5)]))\nwrite('up0',seq([[(40,y,(40,60,220))] for y in range(110,9,-5)]))\nwrite('two2',seq([[(60,y,(40,220,60)),(85,y-3,(220,60,40))] for y in range(10,111,5)]))\n# overlapping paths: two centers converge, share scan region, then split\np=[]\nfor k,y in enumerate(range(10,111,5)):\n x1=min(78,45+k*3); x2=max(82,115-k*3)\n p.append([(x1,y,(40,220,60)),(x2,y,(220,60,40))])\nwrite('overlap2',seq(p))\n# same body downward, leaves, reappears upward and crosses down again => once\np=[[(40,y,(40,60,220))] for y in range(10,111,5)]+[[]]*5\np += [[(40,y,(40,60,220))] for y in range(110,19,-5)]\np += [[(40,y,(40,60,220))] for y in range(20,111,5)]\nwrite('return1',seq(p))\n# downward body pauses at line before completing\nys=list(range(10,66,5))+[68]*15+list(range(68,111,5))\nwrite('linger1',seq([[(100,y,(210,180,40))] for y in ys]))\nPY\npython3 /tmp/make_tests.py\nfor x in down1 up0 two2 overlap2 return1 linger1; do python3 /app/varnish/mill.pyc /tmp/cases/$x.mp4 >/dev/null 2>&1; printf '%-10s ' \"$x\"; cat /app/inkwell/sheet.toml 2>/dev/null || echo FAIL; done\n"]
