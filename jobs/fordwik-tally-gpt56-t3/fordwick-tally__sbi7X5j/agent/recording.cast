[111.452712, "o", "\u001b[?2004h> "]
[111.452823, "o", "    if track.get(\"armed\") and y >= LINE_Y + 2:\r\n\u001b[?2004l\r"]
[111.452894, "o", "\u001b[?2004h> "]
[111.453162, "o", "        # Require meaningful top-to-bottom displacement, not scan-row jitter."]
[111.453228, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.453362, "o", "        if y - track.get(\"min_y\", y) >= 5:\r\n\u001b[?2004l\r"]
[111.45342, "o", "\u001b[?2004h> "]
[111.453546, "o", "            track[\"completed\"] = True\r\n\u001b[?2004l\r"]
[111.4536, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.453654, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.453705, "o", "\u001b[?2004h"]
[111.453723, "o", "> "]
[111.453833, "o", "def fold_gate(tracks) -> int:\r\n\u001b[?2004l\r"]
[111.453912, "o", "\u001b[?2004h> "]
[111.454048, "o", "    return sum(bool(t.get(\"completed\")) for t in tracks)\r\n\u001b[?2004l\r"]
[111.454124, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[111.455514, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[111.455633, "o", "cat > /app/blot.py <<'PY'\r\n\u001b[?2004l\r"]
[111.455729, "o", "\u001b[?2004h> "]
[111.455843, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[111.455925, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.455996, "o", "import cv2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.45607, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[111.456142, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.456227, "o", "\u001b[?2004h> "]
[111.456337, "o", "from tether import update_passage, fold_gate\r\n\u001b[?2004l\r"]
[111.456404, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.456462, "o", "\u001b[?2004h> "]
[111.456517, "o", "LINE_Y = 70\r\n\u001b[?2004l\r"]
[111.456588, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.456666, "o", "def _foreground(frames):\r\n\u001b[?2004l\r"]
[111.456721, "o", "\u001b[?2004h> "]
[111.456994, "o", "    \"\"\"Return stable-background foreground masks for an offline recording.\"\"\"\r\n\u001b[?2004l\r"]
[111.457061, "o", "\u001b[?2004h"]
[111.457124, "o", "> "]
[111.457193, "o", "    stack = np.asarray(frames, dtype=np.uint8)\r\n\u001b[?2004l\r"]
[111.457248, "o", "\u001b[?2004h> "]
[111.457399, "o", "    bg = np.median(stack, axis=0).astype(np.uint8)\r\n\u001b[?2004l\r"]
[111.457452, "o", "\u001b[?2004h> "]
[111.457503, "o", "    masks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.457641, "o", "    kernel = np.ones((3, 3), np.uint8)\r\n\u001b[?2004l\r"]
[111.457695, "o", "\u001b[?2004h> "]
[111.457762, "o", "    for frame in frames:\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.457817, "o", "> "]
[111.457899, "o", "        d = cv2.absdiff(frame, bg)\r\n\u001b[?2004l\r"]
[111.457957, "o", "\u001b[?2004h> "]
[111.458262, "o", "        # max-channel distance preserves saturated objects against gray scenery.\r\n\u001b[?2004l\r"]
[111.45833, "o", "\u001b[?2004h> "]
[111.458525, "o", "        m = (np.max(d, axis=2) >= 24).astype(np.uint8) * 255\r\n\u001b[?2004l\r"]
[111.458589, "o", "\u001b[?2004h> "]
[111.458791, "o", "        m = cv2.morphologyEx(m, cv2.MORPH_OPEN, kernel)\r\n\u001b[?2004l\r"]
[111.458853, "o", "\u001b[?2004h> "]
[111.45905, "o", "        m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, kernel)\r\n\u001b[?2004l\r"]
[111.459112, "o", "\u001b[?2004h> "]
[111.459221, "o", "        masks.append(m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.459283, "o", "    return masks\r\n\u001b[?2004l\r"]
[111.45935, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.459386, "o", "\u001b[?2004h> "]
[111.459507, "o", "def _detections(frame, mask):\r\n\u001b[?2004l\r"]
[111.459562, "o", "\u001b[?2004h> "]
[111.459827, "o", "    n, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\r\n\u001b[?2004l\r"]
[111.459873, "o", "\u001b[?2004h> "]
[111.459943, "o", "    out = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.460062, "o", "    for i in range(1, n):\r\n\u001b[?2004l\r"]
[111.460118, "o", "\u001b[?2004h"]
[111.460174, "o", "> "]
[111.460277, "o", "        x, y, w, h, area = map(int, stats[i])\r\n\u001b[?2004l\r"]
[111.460325, "o", "\u001b[?2004h"]
[111.460374, "o", "> "]
[111.460452, "o", "        if area < 20 or w < 3 or h < 3:\r\n\u001b[?2004l\r"]
[111.460515, "o", "\u001b[?2004h> "]
[111.460568, "o", "            continue\r\n\u001b[?2004l\r"]
[111.460616, "o", "\u001b[?2004h> "]
[111.460738, "o", "        pix = frame[labels == i]\r\n\u001b[?2004l\r"]
[111.460791, "o", "\u001b[?2004h> "]
[111.461013, "o", "        color = np.median(pix, axis=0) if len(pix) else np.zeros(3)\r\n\u001b[?2004l\r"]
[111.461082, "o", "\u001b[?2004h"]
[111.461151, "o", ">         out.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.461233, "o", "> "]
[111.46141, "o", "            \"x\": float(centers[i, 0]), \"y\": float(centers[i, 1]),\r\n\u001b[?2004l\r"]
[111.461459, "o", "\u001b[?2004h> "]
[111.461647, "o", "            \"box\": (x, y, w, h), \"area\": float(area),\r\n\u001b[?2004l\r"]
[111.461699, "o", "\u001b[?2004h> "]
[111.461845, "o", "            \"color\": color.astype(float),\r\n\u001b[?2004l\r"]
[111.461906, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[111.461964, "o", "\u001b[?2004h> "]
[111.462016, "o", "    return out\r\n\u001b[?2004l\r"]
[111.462072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.462126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.462204, "o", "\u001b[?2004h> "]
[111.462267, "o", "def _pred(t, frame_no):\r\n\u001b[?2004l\r"]
[111.462321, "o", "\u001b[?2004h> "]
[111.462466, "o", "    dt = frame_no - t[\"last_frame\"]\r\n\u001b[?2004l\r"]
[111.462534, "o", "\u001b[?2004h> "]
[111.462755, "o", "    # Prediction is bounded; stale velocity should not run far off-screen.\r\n\u001b[?2004l\r"]
[111.462802, "o", "\u001b[?2004h> "]
[111.462881, "o", "    dtp = min(dt, 8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.463126, "o", "    return t[\"x\"] + t[\"vx\"] * dtp, t[\"y\"] + t[\"vy\"] * dtp\r\n\u001b[?2004l\r"]
[111.463206, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.463282, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.463349, "o", "\u001b[?2004h> "]
[111.463413, "o", "def count_bodies(frames) -> int:\r\n\u001b[?2004l\r"]
[111.463467, "o", "\u001b[?2004h> "]
[111.463523, "o", "    if not frames:\r\n\u001b[?2004l\r"]
[111.463574, "o", "\u001b[?2004h> "]
[111.463738, "o", "        raise ValueError(\"recording has no decodable frames\")\r\n\u001b[?2004l\r"]
[111.463806, "o", "\u001b[?2004h> "]
[111.463858, "o", "    masks = _foreground(frames)\r\n\u001b[?2004l\r"]
[111.463933, "o", "\u001b[?2004h>     tracks = []\r\n\u001b[?2004l\r"]
[111.463996, "o", "\u001b[?2004h> "]
[111.464058, "o", "    next_id = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.464112, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.464275, "o", "    for fi, (frame, mask) in enumerate(zip(frames, masks)):\r\n\u001b[?2004l\r"]
[111.464333, "o", "\u001b[?2004h> "]
[111.464404, "o", "        dets = _detections(frame, mask)\r\n\u001b[?2004l\r"]
[111.464456, "o", "\u001b[?2004h> "]
[111.464508, "o", "        pairs = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.46456, "o", "> "]
[111.464637, "o", "        for ti, t in enumerate(tracks):\r\n\u001b[?2004l\r"]
[111.464685, "o", "\u001b[?2004h> "]
[111.464755, "o", "            px, py = _pred(t, fi)\r\n\u001b[?2004l\r"]
[111.464803, "o", "\u001b[?2004h> "]
[111.464885, "o", "            gap = fi - t[\"last_frame\"]\r\n\u001b[?2004l\r"]
[111.464934, "o", "\u001b[?2004h> "]
[111.465026, "o", "            for di, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[111.465072, "o", "\u001b[?2004h> "]
[111.465215, "o", "                dist = ((px-d[\"x\"])**2 + (py-d[\"y\"])**2) ** 0.5\r\n\u001b[?2004l\r"]
[111.465263, "o", "\u001b[?2004h> "]
[111.465398, "o", "                col = float(np.linalg.norm(t[\"color\"]-d[\"color\"]))\r\n\u001b[?2004l\r"]
[111.465469, "o", "\u001b[?2004h> "]
[111.465616, "o", "                # Wide enough for the 6 px/frame station motion and brief occlusion.\r\n\u001b[?2004l\r"]
[111.465667, "o", "\u001b[?2004h> "]
[111.465749, "o", "                limit = 15 + 5 * min(gap, 8)\r\n\u001b[?2004l\r"]
[111.465794, "o", "\u001b[?2004h> "]
[111.465863, "o", "                if dist <= limit:\r\n\u001b[?2004l\r"]
[111.465908, "o", "\u001b[?2004h> "]
[111.46607, "o", "                    pairs.append((dist + min(col, 120)*0.035 + gap*0.2, ti, di))\r\n\u001b[?2004l\r"]
[111.466115, "o", "\u001b[?2004h> "]
[111.46617, "o", "        pairs.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.466215, "o", "> "]
[111.466285, "o", "        used_t, used_d = set(), set()\r\n\u001b[?2004l\r"]
[111.466329, "o", "\u001b[?2004h> "]
[111.466382, "o", "        assignments = []\r\n\u001b[?2004l\r"]
[111.466427, "o", "\u001b[?2004h> "]
[111.466479, "o", "        for _, ti, di in pairs:\r\n\u001b[?2004l\r"]
[111.466522, "o", "\u001b[?2004h> "]
[111.466634, "o", "            if ti not in used_t and di not in used_d:\r\n\u001b[?2004l\r"]
[111.466679, "o", "\u001b[?2004h> "]
[111.466831, "o", "                used_t.add(ti); used_d.add(di); assignments.append((ti, di))\r\n\u001b[?2004l\r"]
[111.466876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.466969, "o", "        for ti, di in assignments:\r\n\u001b[?2004l\r"]
[111.467014, "o", "\u001b[?2004h> "]
[111.46709, "o", "            t, d = tracks[ti], dets[di]\r\n\u001b[?2004l\r"]
[111.467143, "o", "\u001b[?2004h> "]
[111.467227, "o", "            gap = fi - t[\"last_frame\"]\r\n\u001b[?2004l\r"]
[111.467279, "o", "\u001b[?2004h> "]
[111.467386, "o", "            nvx = (d[\"x\"] - t[\"x\"]) / max(1, gap)\r\n\u001b[?2004l\r"]
[111.46743, "o", "\u001b[?2004h> "]
[111.467537, "o", "            nvy = (d[\"y\"] - t[\"y\"]) / max(1, gap)\r\n\u001b[?2004l\r"]
[111.467579, "o", "\u001b[?2004h> "]
[111.467786, "o", "            # Smooth only on consecutive observations; after occlusion trust displacement.\r\n\u001b[?2004l\r"]
[111.467831, "o", "\u001b[?2004h> "]
[111.467895, "o", "            if gap == 1:\r\n\u001b[?2004l\r"]
[111.467943, "o", "\u001b[?2004h> "]
[111.468055, "o", "                t[\"vx\"] = .55*t[\"vx\"] + .45*nvx\r\n\u001b[?2004l\r"]
[111.4681, "o", "\u001b[?2004h> "]
[111.468229, "o", "                t[\"vy\"] = .55*t[\"vy\"] + .45*nvy\r\n\u001b[?2004l\r"]
[111.46828, "o", "\u001b[?2004h> "]
[111.46833, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.468373, "o", "> "]
[111.468455, "o", "                t[\"vx\"], t[\"vy\"] = nvx, nvy\r\n\u001b[?2004l\r"]
[111.468505, "o", "\u001b[?2004h> "]
[111.468607, "o", "            t[\"x\"], t[\"y\"] = d[\"x\"], d[\"y\"]\r\n\u001b[?2004l\r"]
[111.468664, "o", "\u001b[?2004h> "]
[111.468735, "o", "            t[\"last_frame\"] = fi\r\n\u001b[?2004l\r"]
[111.468785, "o", "\u001b[?2004h> "]
[111.468898, "o", "            t[\"color\"] = .7*t[\"color\"] + .3*d[\"color\"]\r\n\u001b[?2004l\r"]
[111.468943, "o", "\u001b[?2004h> "]
[111.469051, "o", "            t[\"area\"] = .8*t[\"area\"] + .2*d[\"area\"]\r\n\u001b[?2004l\r"]
[111.469099, "o", "\u001b[?2004h> "]
[111.469204, "o", "            update_passage(t, d[\"y\"], True)\r\n\u001b[?2004l\r"]
[111.469281, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.469452, "o", "        # An unmatched old track whose prediction lies in a matched blob is occluded,\r\n\u001b[?2004l\r"]
[111.46951, "o", "\u001b[?2004h> "]
[111.46967, "o", "        # not dead. Preserve it without treating a guessed centroid as a crossing.\r\n"]
[111.469719, "o", "\u001b[?2004l\r"]
[111.469777, "o", "\u001b[?2004h> "]
[111.469838, "o", "        for ti, t in enumerate(tracks):\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.469898, "o", "> "]
[111.46996, "o", "            if ti in used_t:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.470032, "o", "                continue\r\n\u001b[?2004l\r"]
[111.470104, "o", "\u001b[?2004h> "]
[111.470181, "o", "            px, py = _pred(t, fi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.470273, "o", "            for di in used_d:\r\n\u001b[?2004l\r"]
[111.470327, "o", "\u001b[?2004h> "]
[111.470427, "o", "                x, y, w, h = dets[di][\"box\"]\r\n\u001b[?2004l\r"]
[111.47048, "o", "\u001b[?2004h> "]
[111.470625, "o", "                if x-5 <= px <= x+w+5 and y-5 <= py <= y+h+5:\r\n\u001b[?2004l\r"]
[111.470682, "o", "\u001b[?2004h> "]
[111.470767, "o", "                    t[\"occluded\"] = True\r\n\u001b[?2004l\r"]
[111.470824, "o", "\u001b[?2004h> "]
[111.470884, "o", "                    break\r\n\u001b[?2004l\r"]
[111.47094, "o", "\u001b[?2004h"]
[111.471, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.471066, "o", "        for di, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[111.471119, "o", "\u001b[?2004h"]
[111.471184, "o", "> "]
[111.471239, "o", "            if di in used_d:\r\n\u001b[?2004l\r"]
[111.471294, "o", "\u001b[?2004h> "]
[111.471348, "o", "                continue\r\n\u001b[?2004l\r"]
[111.471407, "o", "\u001b[?2004h> "]
[111.471466, "o", "            t = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.47157, "o", "                \"id\": next_id, \"x\": d[\"x\"], \"y\": d[\"y\"],\r\n\u001b[?2004l\r"]
[111.471624, "o", "\u001b[?2004h> "]
[111.471747, "o", "                \"vx\": 0.0, \"vy\": 0.0, \"last_frame\": fi,\r\n\u001b[?2004l\r"]
[111.471798, "o", "\u001b[?2004h> "]
[111.471927, "o", "                \"color\": d[\"color\"], \"area\": d[\"area\"],\r\n\u001b[?2004l\r"]
[111.47198, "o", "\u001b[?2004h> "]
[111.472149, "o", "                \"armed\": False, \"completed\": False, \"min_y\": d[\"y\"],\r\n\u001b[?2004l\r"]
[111.47221, "o", "\u001b[?2004h> "]
[111.472277, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.472374, "o", "            update_passage(t, d[\"y\"], True)\r\n\u001b[?2004l\r"]
[111.472425, "o", "\u001b[?2004h> "]
[111.472526, "o", "            tracks.append(t); next_id += 1\r\n\u001b[?2004l\r"]
[111.472577, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.472637, "o", "\u001b[?2004h> "]
[111.472694, "o", "    return fold_gate(tracks)\r\n\u001b[?2004l\r"]
[111.472749, "o", "\u001b[?2004h"]
[111.472803, "o", "> PY\r\n\u001b[?2004l\r"]
[111.474078, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[111.474174, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[111.474239, "o", "\u001b[?2004h> "]
[111.47432, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[111.474342, "o", "\u001b[?2004h"]
[111.474416, "o", "> \r\n\u001b[?2004l\r"]
[111.474471, "o", "\u001b[?2004h> "]
[111.47453, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> import cv2\r\n\u001b[?2004l\r"]
[111.474588, "o", "\u001b[?2004h"]
[111.474664, "o", "> import toml\r\n\u001b[?2004l\r"]
[111.474719, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.474772, "o", "from blot import count_bodies\r\n\u001b[?2004l\r"]
[111.474823, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.474878, "o", "> "]
[111.474942, "o", "SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r"]
[111.474988, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.475037, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.475089, "o", "> "]
[111.475143, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.475223, "o", "    cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r"]
[111.475269, "o", "\u001b[?2004h> "]
[111.475326, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r"]
[111.47537, "o", "\u001b[?2004h> "]
[111.475416, "o", "        cap.release()\r\n\u001b[?2004l\r"]
[111.475464, "o", "\u001b[?2004h> "]
[111.475548, "o", "        raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[111.475621, "o", "\u001b[?2004h> "]
[111.47568, "o", "    frames = []\r\n\u001b[?2004l\r"]
[111.475741, "o", "\u001b[?2004h> "]
[111.475798, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.475868, "o", "        ok, frame = cap.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.475929, "o", "        if not ok:\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.475988, "o", ">             break\r\n\u001b[?2004l\r"]
[111.476053, "o", "\u001b[?2004h> "]
[111.476169, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r"]
[111.476234, "o", "\u001b[?2004h> "]
[111.476301, "o", "            cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.476407, "o", "            raise ValueError('invalid frame')\r\n\u001b[?2004l\r"]
[111.476468, "o", "\u001b[?2004h"]
[111.476526, "o", ">         frames.append(frame)\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.47659, "o", ">     cap.release()\r\n\u001b[?2004l\r"]
[111.476649, "o", "\u001b[?2004h> "]
[111.476707, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.476813, "o", "        raise OSError('cannot decode clip')\r\n\u001b[?2004l\r"]
[111.476874, "o", "\u001b[?2004h> "]
[111.476938, "o", "    return count_bodies(frames)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.476997, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.477056, "o", "\u001b[?2004h> "]
[111.477119, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.477264, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[111.477326, "o", "\u001b[?2004h> "]
[111.477388, "o", "    tmp = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r"]
[111.477446, "o", "\u001b[?2004h> "]
[111.47758, "o", "    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r"]
[111.477643, "o", "\u001b[?2004h> "]
[111.477701, "o", "    tmp.replace(SHEET)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.47776, "o", "PY\r\n\u001b[?2004l\r"]
[111.478846, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[111.478952, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[111.479016, "o", "\u001b[?2004h> "]
[111.479078, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.479185, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[111.479251, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.479326, "o", "import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.47945, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.479522, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.479594, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[111.479666, "o", "\u001b[?2004h> "]
[111.479733, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[111.479797, "o", "\u001b[?2004h> "]
[111.479854, "o", "        if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.479915, "o", "            return 2\r\n\u001b[?2004l\r"]
[111.479973, "o", "\u001b[?2004h> "]
[111.480031, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.480093, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.480166, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.480238, "o", ">     except Exception as exc:\r\n\u001b[?2004l\r"]
[111.480295, "o", "\u001b[?2004h> "]
[111.48035, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[111.480408, "o", "\u001b[?2004h> "]
[111.480488, "o", "        print(f'mill: {exc}', file=sys.stderr)\r\n\u001b[?2004l\r"]
[111.480554, "o", "\u001b[?2004h>         return 1\r\n\u001b[?2004l\r"]
[111.480617, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.480675, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.480732, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[111.48079, "o", "\u001b[?2004h> "]
[111.48085, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.48091, "o", "PY\r\n\u001b[?2004l\r"]
[111.482031, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[111.482111, "o", "chmod +x /app/spanwell.py\r\n\u001b[?2004l\r"]
[111.483073, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[111.483173, "o", "/app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[111.533087, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[112.452639, "i", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\n"]
[112.453211, "o", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[112.839185, "o", "sample_rc=0\r\n"]
[112.840095, "o", "crossings = 3\r\n"]
[112.840313, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[114.447425, "i", "python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo \"bad_rc=$rc\"; if test -e /app/inkwell/sheet.toml; then echo 'ERROR: stale sheet exists'; else echo 'sheet absent'; fi\n"]
[114.448114, "o", "python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo \"bad_rc=$rc\"; if test -e /app/inkwell/sheet.toml; then echo 'ERROR: stale sheet exists'; else echo 'sheet absent'; fi\r\n\u001b[?2004l\r"]
[114.754869, "o", "mill: cannot open clip\r\n"]
[114.784813, "o", "bad_rc=1\r\nsheet absent\r\n"]
[114.78497, "o", "\u001b[?2004hroot@66944e1f6ae8:/app# "]
[164.848472, "i", "python3 - <<'PY'\np='/app/blot.py'\ns=open(p).read()\ns=s.replace(\"    bg = np.median(stack, axis=0).astype(np.uint8)\\n\", \"    # Median handles moving traffic. If both endpoints agree, they provide an\\n    # uncontaminated background even when a body lingers for much of the reel.\\n    med = np.median(stack, axis=0).astype(np.uint8)\\n    first = np.median(stack[:min(3, len(stack))], axis=0).astype(np.uint8)\\n    last = np.median(stack[-min(3, len(stack)):], axis=0).astype(np.uint8)\\n    agree = np.max(cv2.absdiff(first, last), axis=2) < 12\\n    bg = med.copy()\\n    bg[agree] = ((first[agree].astype(np.uint16) + last[agree].astype(np.uint16)) // 2).astype(np.uint8)\\n\")\n# Restrict candidates to active trajectories. Completed tracks remain available longer\n# for direct return continuity but cannot live forever.\ns=s.replace(\"        for ti, t in enumerate(tracks):\\n            px, py = _pred(t, fi)\\n            gap = fi - t[\\\"last_frame\\\"]\\n            for di, d in enumerate(dets):\", \"        for ti, t in enumerate(tracks):\\n            px, py = _pred(t, fi)\\n            gap = fi - t[\\\"last_frame\\\"]\\n            max_gap = 30 if t.get(\\\"completed\\\") else 12\\n            if gap > max_gap:\\n                continue\\n            for di, d in enumerate(dets):\")\n# Add conservative prediction update for an unmatched track hidden inside a merged blob.\ns=s.replace(\"                    t[\\\"occluded\\\"] = True\\n                    break\", \"                    t[\\\"occluded\\\"] = True\\n                    # Once motion is established, interpolation through a covering\\n                    # silhouette is valid evidence of centroid passage. Do not do\\n                    # this for stationary or one-frame tracks.\\n                    gap = fi - t[\\\"last_frame\\\"]\\n                    if gap <= 12 and t.get(\\\"armed\\\") and t.get(\\\"vy\\\", 0) > 0.8:\\n                        update_passage(t, py, True)\\n                    break\")\nopen(p,'w').write(s)\nPY\n/app/kiln/bake.sh\n"]
[164.848666, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[164.848781, "o", "\u001b[?2004h> p='/app/blot.py'\r\n\u001b[?2004l\r"]
[164.848812, "o", "\u001b[?2004h"]
[164.848837, "o", "> "]
[164.848892, "o", "s=open(p).read()\r\n\u001b[?2004l\r"]
[164.849049, "o", "\u001b[?2004h> "]
[164.850706, "o", "s=s.replace(\"    bg = np.median(stack, axis=0).astype(np.uint8)\\n\", \"    # Median handles moving traffic. If both endpoints agree, they provide an\\n    # uncontaminated background even when a body lingers for much of the reel.\\n    med = np.median(stack, axis=0).astype(np.uint8)\\n    first = np.median(stack[:min(3, len(stack))], axis=0).astype(np.uint8)\\n    last = np.median(stack[-min(3, len(stack)):], axis=0).astype(np.uint8)\\n    agree = np.max(cv2.absdiff(first, last), axis=2) < 12\\n    bg = med.copy()\\n    bg[agree] = ((first[agree].astype(np.uint16) + last[agree].astype(np.uint16)) // 2).astype(np.uint8)\\n\")\r\n\u001b[?2004l\r"]
[164.850847, "o", "\u001b[?2004h> "]
[164.851028, "o", "# Restrict candidates to active trajectories. Completed tracks remain available longer\r\n\u001b[?2004l\r"]
[164.851059, "o", "\u001b[?2004h> "]
[164.851302, "o", "# for direct return continuity but cannot live forever.\r\n\u001b[?2004l\r"]
[164.851373, "o", "\u001b[?2004h> "]
[164.852342, "o", "s=s.replace(\"        for ti, t in enumerate(tracks):\\n            px, py = _pred(t, fi)\\n            gap = fi - t[\\\"last_frame\\\"]\\n            for di, d in enumerate(dets):\", \"        for ti, t in enumerate(tracks):\\n            px, py = _pred(t, fi)\\n            gap = fi - t[\\\"last_frame\\\"]\\n            max_gap = 30 if t.get(\\\"completed\\\") else 12\\n            if gap > max_gap:\\n                continue\\n            for di, d in enumerate(dets):\")\r\n\u001b[?2004l\r"]
[164.852446, "o", "\u001b[?2004h> "]
[164.852603, "o", "# Add conservative prediction update for an unmatched track hidden inside a merged blob.\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.852733, "o", "> "]
[164.854065, "o", "s=s.replace(\"                    t[\\\"occluded\\\"] = True\\n                    break\", \"                    t[\\\"occluded\\\"] = True\\n                    # Once motion is established, interpolation through a covering\\n                    # silhouette is valid evidence of centroid passage. Do not do\\n                    # this for stationary or one-frame tracks.\\n                    gap = fi - t[\\\"last_frame\\\"]\\n                    if gap <= 12 and t.get(\\\"armed\\\") and t.get(\\\"vy\\\", 0) > 0.8:\\n                        update_passage(t, py, True)\\n                    break\")\r\n\u001b[?2004l\r"]
