[31.556345, "i", "cat > /tmp/probe.py <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; cap=cv2.VideoCapture(p); fs=[]\nwhile True:\n ok,f=cap.read()\n if not ok: break\n fs.append(f)\ncap.release(); a=np.array(fs); bg=np.median(a,axis=0).astype(np.uint8)\nprint('frames',len(fs),'global channel range',a.min((0,1,2)),a.max((0,1,2)))\nfor i,f in enumerate(fs):\n d=cv2.absdiff(f,bg); g=d.max(2); mask=(g>25).astype(np.uint8)*255\n mask=cv2.morphologyEx(mask,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n n,lab,st,cen=cv2.connectedComponentsWithStats(mask)\n comps=[(int(st[j,4]),tuple(round(x,1) for x in cen[j]),tuple(map(int,st[j,:4]))) for j in range(1,n) if st[j,4]>=10]\n # exact-ish dominant quantized colors\n q=(f.reshape(-1,3)//16)*16\n u,c=np.unique(q,axis=0,return_counts=True); ix=np.argsort(c)[-5:][::-1]\n print(f'{i:02d}', 'diff',int((g>25).sum()),'comps',comps,'colors',[(tuple(map(int,u[x])),int(c[x])) for x in ix])\ncv2.imwrite('/tmp/background.png',bg)\n# contact sheet sampled every 3 frames\nsel=fs[::3]; sheet=np.zeros((4*120,4*160,3),np.uint8)\nfor k,f in enumerate(sel[:16]): sheet[(k//4)*120:(k//4+1)*120,(k%4)*160:(k%4+1)*160]=f\ncv2.imwrite('/tmp/contact.png',sheet)\nPY\npython3 /tmp/probe.py\n"]
