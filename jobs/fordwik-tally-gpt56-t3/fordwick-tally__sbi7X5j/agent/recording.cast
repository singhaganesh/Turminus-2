[111.450231, "i", "cat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nLINE_Y = 70.0\n\n\ndef update_passage(track, y: float, observed: bool = True) -> None:\n    \"\"\"Update one track's directional gate; each track can fire only once.\"\"\"\n    if not observed:\n        return\n    if y <= LINE_Y - 2:\n        track[\"armed\"] = True\n        track[\"min_y\"] = min(track.get(\"min_y\", y), y)\n    if track.get(\"armed\") and y >= LINE_Y + 2:\n        # Require meaningful top-to-bottom displacement, not scan-row jitter.\n        if y - track.get(\"min_y\", y) >= 5:\n            track[\"completed\"] = True\n\n\ndef fold_gate(tracks) -> int:\n    return sum(bool(t.get(\"completed\")) for t in tracks)\nPY\ncat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nfrom tether import update_passage, fold_gate\n\nLINE_Y = 70\n\n\ndef _foreground(frames):\n    \"\"\"Return stable-background foreground masks for an offline recording.\"\"\"\n    stack = np.asarray(frames, dtype=np.uint8)\n    bg = np.median(stack, axis=0).astype(np.uint8)\n    masks = []\n    kernel = np.ones((3, 3), np.uint8)\n    for frame in frames:\n        d = cv2.absdiff(frame, bg)\n        # max-channel distance preserves saturated objects against gray scenery.\n        m = (np.max(d, axis=2) >= 24).astype(np.uint8) * 255\n        m = cv2.morphologyEx(m, cv2.MORPH_OPEN, kernel)\n        m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, kernel)\n        masks.append(m)\n    return masks\n\n\ndef _detections(frame, mask):\n    n, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\n    out = []\n    for i in range(1, n):\n        x, y, w, h, area = map(int, stats[i])\n        if area < 20 or w < 3 or h < 3:\n            continue\n        pix = frame[labels == i]\n        color = np.median(pix, axis=0) if len(pix) else np.zeros(3)\n        out.append({\n            \"x\": float(centers[i, 0]), \"y\": float(centers[i, 1]),\n            \"box\": (x, y, w, h), \"area\": float(area),\n            \"color\": color.astype(float),\n        })\n    return out\n\n\ndef _pred(t, frame_no):\n    dt = frame_no - t[\"last_frame\"]\n    # Prediction is bounded; stale velocity should not run far off-screen.\n    dtp = min(dt, 8)\n    return t[\"x\"] + t[\"vx\"] * dtp, t[\"y\"] + t[\"vy\"] * dtp\n\n\ndef count_bodies(frames) -> int:\n    if not frames:\n        raise ValueError(\"recording has no decodable frames\")\n    masks = _foreground(frames)\n    tracks = []\n    next_id = 0\n\n    for fi, (frame, mask) in enumerate(zip(frames, masks)):\n        dets = _detections(frame, mask)\n        pairs = []\n        for ti, t in enumerate(tracks):\n            px, py = _pred(t, fi)\n            gap = fi - t[\"last_frame\"]\n            for di, d in enumerate(dets):\n                dist = ((px-d[\"x\"])**2 + (py-d[\"y\"])**2) ** 0.5\n                col = float(np.linalg.norm(t[\"color\"]-d[\"color\"]))\n                # Wide enough for the 6 px/frame station motion and brief occlusion.\n                limit = 15 + 5 * min(gap, 8)\n                if dist <= limit:\n                    pairs.append((dist + min(col, 120)*0.035 + gap*0.2, ti, di))\n        pairs.sort()\n        used_t, used_d = set(), set()\n        assignments = []\n        for _, ti, di in pairs:\n            if ti not in used_t and di not in used_d:\n                used_t.add(ti); used_d.add(di); assignments.append((ti, di))\n\n        for ti, di in assignments:\n            t, d = tracks[ti], dets[di]\n            gap = fi - t[\"last_frame\"]\n            nvx = (d[\"x\"] - t[\"x\"]) / max(1, gap)\n            nvy = (d[\"y\"] - t[\"y\"]) / max(1, gap)\n            # Smooth only on consecutive observations; after occlusion trust displacement.\n            if gap == 1:\n                t[\"vx\"] = .55*t[\"vx\"] + .45*nvx\n                t[\"vy\"] = .55*t[\"vy\"] + .45*nvy\n            else:\n                t[\"vx\"], t[\"vy\"] = nvx, nvy\n            t[\"x\"], t[\"y\"] = d[\"x\"], d[\"y\"]\n            t[\"last_frame\"] = fi\n            t[\"color\"] = .7*t[\"color\"] + .3*d[\"color\"]\n            t[\"area\"] = .8*t[\"area\"] + .2*d[\"area\"]\n            update_passage(t, d[\"y\"], True)\n\n        # An unmatched old track whose prediction lies in a matched blob is occluded,\n  "]
[111.450409, "i", "      # not dead. Preserve it without treating a guessed centroid as a crossing.\n        for ti, t in enumerate(tracks):\n            if ti in used_t:\n                continue\n            px, py = _pred(t, fi)\n            for di in used_d:\n                x, y, w, h = dets[di][\"box\"]\n                if x-5 <= px <= x+w+5 and y-5 <= py <= y+h+5:\n                    t[\"occluded\"] = True\n                    break\n\n        for di, d in enumerate(dets):\n            if di in used_d:\n                continue\n            t = {\n                \"id\": next_id, \"x\": d[\"x\"], \"y\": d[\"y\"],\n                \"vx\": 0.0, \"vy\": 0.0, \"last_frame\": fi,\n                \"color\": d[\"color\"], \"area\": d[\"area\"],\n                \"armed\": False, \"completed\": False, \"min_y\": d[\"y\"],\n            }\n            update_passage(t, d[\"y\"], True)\n            tracks.append(t); next_id += 1\n\n    return fold_gate(tracks)\nPY\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import count_bodies\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('invalid frame')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('cannot decode clip')\n    return count_bodies(frames)\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    tmp = SHEET.with_suffix('.tmp')\n    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    tmp.replace(SHEET)\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    try:\n        SHEET.unlink(missing_ok=True)\n        if len(sys.argv) != 2:\n            return 2\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n        return 0\n    except Exception as exc:\n        SHEET.unlink(missing_ok=True)\n        print(f'mill: {exc}', file=sys.stderr)\n        return 1\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\nchmod +x /app/spanwell.py\n/app/kiln/bake.sh\n"]
