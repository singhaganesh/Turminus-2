[68.27503, "i", "cat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\npublic class HueWalk {\n    public static int orb_n(Path blobPath, Path pinPath, Path jsonPath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean gap = (pins.length % MistSpan.ROW) != 0;\n        for (int i = 0; i + MistSpan.ROW <= pins.length; i += MistSpan.ROW) {\n            byte[] row = Arrays.copyOfRange(pins, i, i + MistSpan.ROW);\n            byte[] body = MistSpan.validateRow(blob, row);\n            if (body == null) {\n                gap = true;\n                continue;\n            }\n            held.add(hex(Arrays.copyOfRange(row, 20, 36)));\n        }\n        String note = gap ? \"gap\" : \"ok\";\n        String kind = gap ? \"void\" : \"live\";\n        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\" + note\n                + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\"}\";\n        Files.writeString(jsonPath, json);\n        return gap ? 1 : 0;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 0xff));\n        return sb.toString();\n    }\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < held.size(); i++) {\n            if (i > 0) sb.append(',');\n            sb.append('\\\"').append(held.get(i)).append('\\\"');\n        }\n        return sb.append(']').toString();\n    }\n}\nEOF\ncat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class YankRun {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1 || !args[0].matches(\"[0-9a-f]{32}\")) System.exit(2);\n        byte[] got = MistSpan.tint_k(Paths.get(\"/app/silo\"), hex(args[0]));\n        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\n        if (got.length == 0) System.exit(1);\n        System.out.write(got);\n    }\n    static byte[] hex(String s) {\n        byte[] out = new byte[16];\n        for (int i = 0; i < 16; i++) out[i] = (byte)Integer.parseInt(s.substring(i*2, i*2+2), 16);\n        return out;\n    }\n}\nEOF\n/app/bin/crumbark tamp\ncat /app/recipit/ForceSeq.java\n"]
