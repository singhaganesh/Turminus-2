[32.806316, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport struct, hashlib, zlib\np=Path('/app/silo/pin.bin').read_bytes(); b=Path('/app/silo/blob.bin').read_bytes()\nfor i in range(0,len(p),48):\n r=p[i:i+48]\n print('row',i//48,'len',len(r),'hex',r.hex())\n if len(r)==48:\n  print(' big:',r[:4],struct.unpack('>QII',r[4:20]),r[20:36].hex(),'tail',r[36:].hex())\n  print('little:',r[:4],struct.unpack('<QII',r[4:20]),r[20:36].hex(),'tail',r[36:].hex())\nprint('blob len',len(b),b.hex())\nfor off in range(0,len(b),32):\n x=b[off:off+32]; print('block',off,x, 'len-prefix big/little', struct.unpack('>I',x[:4])[0],struct.unpack('<I',x[:4])[0], 'crc payload',hex(zlib.crc32(x[4:])&0xffffffff))\nPY\n"]
