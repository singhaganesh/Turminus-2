[68.072479, "i", "python3 - <<'PY'\np='/app/recipit/LoomCue.java'\ns=open(p).read().replace('steps.sort(Comparator.comparingInt(x -> x.compute));','steps.sort(Comparator.comparingInt(x -> x.durable));')\nopen(p,'w').write(s)\np='/app/hitchbay/StowRun.java'\ns=open(p).read()\ns=s.replace('String tail = hx.substring(32, 64);','String tail = hx.substring(0, 32);')\nopen(p,'w').write(s)\nPY\ncat > /app/hitchbay/RibChan.java <<'EOF'\nimport java.io.ByteArrayOutputStream;\nimport java.nio.ByteBuffer;\nimport java.nio.channels.FileChannel;\nimport java.nio.file.Path;\nimport java.nio.file.StandardOpenOption;\n\npublic class RibChan {\n    final Path file;\n    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\n\n    RibChan(Path file) { this.file = file; }\n    void append(byte[] x) throws Exception { pending.write(x); }\n\n    void force() throws Exception {\n        byte[] out = pending.toByteArray();\n        if (out.length == 0) return;\n        try (FileChannel ch = FileChannel.open(file, StandardOpenOption.CREATE,\n                StandardOpenOption.WRITE, StandardOpenOption.APPEND)) {\n            ByteBuffer b = ByteBuffer.wrap(out);\n            while (b.hasRemaining()) ch.write(b);\n            ch.force(true);\n        }\n        pending.reset();\n    }\n}\nEOF\ncat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.Arrays;\n\npublic class MistSpan {\n    static final int ALIGN = 32;\n    static final int ROW = 48;\n    static final byte[] MAGIC = new byte[] {'P','N','0','1'};\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        if (wanted == null || wanted.length != 16) return new byte[0];\n        byte[] pins = read(silo.resolve(\"pin.bin\"));\n        byte[] blob = read(silo.resolve(\"blob.bin\"));\n        for (int i = 0; i + ROW <= pins.length; i += ROW) {\n            byte[] row = Arrays.copyOfRange(pins, i, i + ROW);\n            ByteBuffer bb = ByteBuffer.wrap(row);\n            byte[] magic = new byte[4]; bb.get(magic);\n            long off = bb.getLong();\n            int len = bb.getInt();\n            int crc = bb.getInt();\n            byte[] id = new byte[16]; bb.get(id);\n            if (Arrays.equals(id, wanted)) {\n                return payload(blob, magic, off, len, crc, id, row);\n            }\n        }\n        return new byte[0];\n    }\n\n    static byte[] validateRow(byte[] blob, byte[] row) throws Exception {\n        if (row.length != ROW) return null;\n        ByteBuffer bb = ByteBuffer.wrap(row);\n        byte[] magic = new byte[4]; bb.get(magic);\n        long off = bb.getLong();\n        int len = bb.getInt();\n        int crc = bb.getInt();\n        byte[] id = new byte[16]; bb.get(id);\n        return payload(blob, magic, off, len, crc, id, row);\n    }\n\n    private static byte[] payload(byte[] blob, byte[] magic, long off, int len,\n                                  int crc, byte[] id, byte[] row) throws Exception {\n        if (!Arrays.equals(magic, MAGIC) || off < 0 || (off % ALIGN) != 0 || len < 0) return null;\n        for (int i = 36; i < ROW; i++) if (row[i] != 0) return null;\n        long raw = 4L + len;\n        long take = raw + ((ALIGN - (raw % ALIGN)) % ALIGN);\n        if (off > blob.length || take > blob.length - off || off > Integer.MAX_VALUE) return null;\n        int pos = (int)off;\n        if (ByteBuffer.wrap(blob, pos, 4).getInt() != len) return null;\n        byte[] body = Arrays.copyOfRange(blob, pos + 4, pos + 4 + len);\n        if (Crc.of(body) != crc) return null;\n        for (int i = pos + 4 + len; i < pos + (int)take; i++) if (blob[i] != 0) return null;\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(body);\n        if (!Arrays.equals(id, Arrays.copyOf(digest, 16))) return null;\n        return body;\n    }\n\n    private static byte[] read(Path p) throws Exception {\n        return Files.exists(p) ? Files.readAllBytes(p) : new byte[0];\n    }\n}\nEOF\n"]
