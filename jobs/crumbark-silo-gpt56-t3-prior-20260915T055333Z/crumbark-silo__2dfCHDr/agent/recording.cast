[68.111131, "o", "        for (int i = pos + 4 + len; i < pos + (int)take; i++) if (blob[i] != 0) return null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.111345, "o", "        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(body);\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.111417, "o", "> "]
[68.111534, "o", "        if (!Arrays.equals(id, Arrays.copyOf(digest, 16))) return null;\r\n\u001b[?2004l\r"]
[68.111634, "o", "\u001b[?2004h> "]
[68.11173, "o", "        return body;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.111808, "o", "\u001b[?2004h> "]
