[111.4107, "i", "set -e\nrm -rf /tmp/silo-final-save\ncp -a /app/silo /tmp/silo-final-save\nrm -rf /app/silo; mkdir /app/silo\n: > /tmp/lade.bin\nempty_id=$(sha256sum /tmp/lade.bin | cut -c1-32)\n/app/bin/crumbark lade /tmp/lade.bin\n/app/bin/crumbark wake\n/app/bin/crumbark pull \"$empty_id\" > /tmp/empty-pull\ncmp /tmp/lade.bin /tmp/empty-pull\n# A body-complete record remains durable if only alignment padding is lost.\nprintf 'abc' > /tmp/lade.bin\nabc_id=$(sha256sum /tmp/lade.bin | cut -c1-32)\n/app/bin/crumbark lade /tmp/lade.bin\ntruncate -s 39 /app/silo/blob.bin\n/app/bin/crumbark wake\n/app/bin/crumbark pull \"$abc_id\" > /tmp/abc-pull\ncmp /tmp/lade.bin /tmp/abc-pull\n# Removing a body byte makes that row non-durable and wake nonzero.\ntruncate -s 38 /app/silo/blob.bin\nset +e\n/app/bin/crumbark wake\nrc=$?\nset -e\necho body_truncation_wake_rc=$rc\ncat /app/silo/wake.json; echo\ntest \"$rc\" -ne 0\ngrep -q '\"note\":\"gap\"' /app/silo/wake.json\nrm -rf /app/silo\nmv /tmp/silo-final-save /app/silo\n# Final rebuild proves all repaired source remains compilable.\n/app/bin/crumbark tamp\n"]
[111.411383, "o", "set -e\r\nrm -rf /tmp/silo-final-save\r\ncp -a /app/silo /tmp/silo-final-save\r\nrm -rf /app/silo; mkdir /app/silo\r\n: > /tmp/lade.bin\r\nempty_id=$(sha256sum /tmp/lade.bin | cut -c1-32)\r\n/app/bin/crumbark lade /tmp/lade.bin\r\n/app/bin/crumbark wake\r\n/app/bin/crumbark pull \"$empty_id\" > /tmp/empty-pull\r\ncmp /tmp/lade.bin /tmp/empty-pull\r\n# A body-complete record remains durable if only alignment padding is lost.\r\nprintf 'abc' > /tmp/lade.bin\r\nabc_id=$(sha256sum /tmp/lade.bin | cut -c1-32)\r\n/app/bin/crumbark lade /tmp/lade.bin\r\ntruncate -s 39 /app/silo/blob.bin\r\n/app/bin/crumbark wake\r\n/app/bin/crumbark pull \"$abc_id\" > /tmp/abc-pull\r\ncmp /tmp/lade.bin /tmp/abc-pull\r\n# Removing a body byte makes that row non-durable and wake nonzero.\r\ntruncate -s 38 /app/silo/blob.bin\r\nset +e\r\n/app/bin/crumbark wake\r\nrc=$?\r\nset -e\r\necho body_truncation_wake_rc=$rc\r\ncat /app/silo/wake.json; echo\r\ntest \"$rc\" -ne 0\r\ngrep -q '\"note\":\"gap\"' /app/silo/wake.json\r\nrm -rf /app/silo\r\nmv /tmp/silo-final-save /app/silo\r\n# Final rebuild proves all repaired source remains compilable.\r\n/app/bin/crumbark tamp\r\n"]
