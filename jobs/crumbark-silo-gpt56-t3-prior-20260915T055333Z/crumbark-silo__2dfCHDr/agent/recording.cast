[70.295005, "i", "set -e\nrm -rf /tmp/silo-save /tmp/silo-test\ncp -a /app/silo /tmp/silo-save\nrm -rf /app/silo; mkdir /app/silo\nid=$(sha256sum /app/inbox/oak-a.slip | cut -c1-32)\n/app/bin/crumbark lade /app/inbox/oak-a.slip\n/app/bin/crumbark wake\ncat /app/silo/wake.json; echo\n/app/bin/crumbark pull \"$id\" > /tmp/pulled\ncmp /app/inbox/oak-a.slip /tmp/pulled\nbefore_pin=$(stat -c%s /app/silo/pin.bin); before_blob=$(stat -c%s /app/silo/blob.bin)\n/app/bin/crumbark nick /app/inbox/oak-e.slip\ntest \"$(stat -c%s /app/silo/pin.bin)\" = \"$before_pin\"\ntest \"$(stat -c%s /app/silo/blob.bin)\" -gt \"$before_blob\"\n/app/bin/crumbark wake\nprintf '\\x74' | dd of=/app/silo/pin.bin bs=1 seek=20 conv=notrunc status=none\nset +e\n/app/bin/crumbark wake\nrc=$?\nset -e\necho torn_wake_rc=$rc\ncat /app/silo/wake.json; echo\ntest \"$rc\" -ne 0\ngrep -q '\"held\":\\[\\]' /app/silo/wake.json\ngrep -q '\"note\":\"gap\"' /app/silo/wake.json\ngrep -q '\"kind\":\"void\"' /app/silo/wake.json\nrm -rf /app/silo\nmv /tmp/silo-save /app/silo\nset +e\n/app/bin/crumbark wake\nrc=$?\nset -e\necho original_fixture_wake_rc=$rc\ncat /app/silo/wake.json; echo\n"]
