[68.103689, "o", "cat > /app/siltpage/MistSpan.java <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.ByteBuffer;\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.file.Files;\r\n\u001b[?2004l\r"]
[68.106661, "o", "\u001b[?2004h> import java.nio.file.Path;\r\n\u001b[?2004l\r\u001b[?2004h> import java.security.MessageDigest;\r\n\u001b[?2004l\r\u001b[?2004h> import java.util.Arrays;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> public class MistSpan {\r\n\u001b[?2004l\r\u001b[?2004h>     static final int ALIGN = 32;\r\n\u001b[?2004l\r\u001b[?2004h>     static final int ROW = 48;\r\n\u001b[?2004l\r\u001b[?2004h>     static final byte[] MAGIC = new byte[] {'P','N','0','1'};\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h>         if (wanted == null || wanted.length != 16) return new byte[0];\r\n\u001b[?2004l\r\u001b[?2004h>         byte[] pins = read(silo.resolve(\"pin.bin\"));\r\n\u001b[?2004l\r\u001b[?2004h>         byte[] blob = read(silo.resolve(\"blob.bin\"));\r\n\u001b[?2004l\r\u001b[?2004h>         for (int i = 0; i + ROW <= pins.length; i += ROW) {\r\n\u001b[?2004l\r\u001b[?2004h>             byte[] row = Arrays.copyOfRange(pins, i, i + ROW);\r\n\u001b[?2004l\r\u001b[?2004h>             ByteBuffer bb = ByteBuffer.wrap(row);\r\n\u001b[?2004l\r\u001b[?2004h>             byte[] magic = new byte[4]; bb.get(magic);\r\n\u001b[?2004l\r\u001b[?2004h>             long off = bb.getLong();\r\n\u001b[?2004l\r\u001b[?2004h>             int len = bb.getInt();\r\n\u001b[?2004l\r\u001b[?2004h>             int crc = bb.getInt();\r\n\u001b[?2004l\r\u001b[?2004h>             byte[] id = new byte[16]; bb.get(id);\r\n\u001b[?2004l\r\u001b[?2004h>             if (Arrays.equals(id, wanted)) {\r\n\u001b[?2004l\r\u001b[?2004h>                 return payload(blob, magic, off, len, crc, id, row);\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.107024, "o", "> "]
[68.107056, "o", "            }\r\n\u001b[?2004l\r"]
[68.107163, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.107401, "o", "        return new byte[0];\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.107482, "o", "    static byte[] validateRow(byte[] blob, byte[] row) throws Exception {\r\n\u001b[?2004l\r"]
[68.107612, "o", "\u001b[?2004h>         if (row.length != ROW) return null;\r\n\u001b[?2004l\r"]
[68.107636, "o", "\u001b[?2004h"]
[68.107687, "o", "> "]
[68.107918, "o", "        ByteBuffer bb = ByteBuffer.wrap(row);\r\n\u001b[?2004l\r\u001b[?2004h>         byte[] magic = new byte[4]; bb.get(magic);\r\n\u001b[?2004l\r"]
[68.107958, "o", "\u001b[?2004h> "]
