[68.10826, "o", "\u001b[?2004h> "]
[68.108483, "o", "        byte[] id = new byte[16]; bb.get(id);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.108566, "o", "        return payload(blob, magic, off, len, crc, id, row);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[68.108608, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[68.10867, "o", "> "]
[68.108947, "o", "    private static byte[] payload(byte[] blob, byte[] magic, long off, int len,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.109091, "o", "                                  int crc, byte[] id, byte[] row) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.109323, "o", "        if (!Arrays.equals(magic, MAGIC) || off < 0 || (off % ALIGN) != 0 || len < 0) return null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.1095, "o", "        for (int i = 36; i < ROW; i++) if (row[i] != 0) return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.109538, "o", "> "]
[68.109663, "o", "        long raw = 4L + len;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.109919, "o", "        long take = raw + ((ALIGN - (raw % ALIGN)) % ALIGN);\r\n\u001b[?2004l\r"]
[68.110021, "o", "\u001b[?2004h> "]
[68.110189, "o", "        if (off > blob.length || take > blob.length - off || off > Integer.MAX_VALUE) return null;\r\n\u001b[?2004l\r"]
[68.110297, "o", "\u001b[?2004h>         int pos = (int)off;\r\n\u001b[?2004l\r"]
[68.110409, "o", "\u001b[?2004h> "]
[68.110539, "o", "        if (ByteBuffer.wrap(blob, pos, 4).getInt() != len) return null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.110719, "o", "        byte[] body = Arrays.copyOfRange(blob, pos + 4, pos + 4 + len);\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.110812, "o", "> "]
