[10.039282, "o", "import java.util.zip.CRC32;\r\n\r\n"]
[10.039387, "o", "public class Crc {\r\n    public static int of(byte[] a) {\r\n        CRC32 c = new CRC32();\r\n        c.update(a);\r\n        return (int) c.getValue();\r\n    }\r\n}\r\n"]
[10.041144, "o", "/app/hitchbay/StowRun.java\r\n===== /app/hitchbay/StowRun.java\r\n"]
[10.043436, "o", "import java.nio.ByteBuffer;\r\n"]
[10.044139, "o", "import java.nio.file.Files;\r\n"]
[10.044405, "o", "import java.nio.file.Path;\r\n"]
[10.04471, "o", "import java.nio.file.Paths;\r\n"]
[10.044929, "o", "import java.security.MessageDigest;\r\n"]
[10.045295, "o", "\r\npublic class StowRun {\r\n"]
[10.045468, "o", "    static final int ALIGN = 32;\r\n"]
[10.045644, "o", "\r\n    public static class CutErr extends RuntimeException {\r\n    }\r\n\r\n    public static void run(Path slip, boolean cut) throws Exception {\r\n"]
[10.04584, "o", "        byte[] payload = Files.readAllBytes(slip);\r\n        Path silo = Paths.get(\"/app/silo\");\r\n        Files.createDirectories(silo);\r\n        Path blob = silo.resolve(\"blob.bin\");\r\n"]
[10.046106, "o", "        Path pin = silo.resolve(\"pin.bin\");\r\n        if (!Files.exists(blob)) {\r\n            Files.write(blob, new byte[0]);\r\n        }\r\n        if (!Files.exists(pin)) {\r\n            Files.write(pin, new byte[0]);\r\n"]
[10.046238, "o", "        }\r\n        long offset = Files.size(blob);\r\n        RibChan bch = new RibChan(blob);\r\n        RibChan pch = new RibChan(pin);\r\n        int len = payload.length;\r\n        int rec = 4 + len;\r\n        int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n        ByteBuffer recb = ByteBuffer.allocate(rec + pad);\r\n"]
[10.046445, "o", "        recb.putInt(len);\r\n        recb.put(payload);\r\n        recb.put(new byte[pad]);\r\n"]
[10.046669, "o", "        bch.append(recb.array());\r\n        byte[] id = idOf(payload);\r\n        ByteBuffer mk = ByteBuffer.allocate(48);\r\n        mk.put(new byte[] {'P', 'N', '0', '1'});\r\n        mk.putLong(offset);\r\n        mk.putInt(len);\r\n        mk.putInt(Crc.of(payload));\r\n"]
[10.046765, "o", "        mk.put(id);\r\n        mk.put(new byte[12]);\r\n"]
[10.046796, "o", "        pch.append(mk.array());\r\n        String[] order = ForceSeq.names();\r\n        int n = 0;\r\n        for (String ch : order) {\r\n            if (\"blob\".equals(ch)) {\r\n                bch.force();\r\n            } else {\r\n"]
[10.046898, "o", "                pch.force();\r\n"]
[10.047062, "o", "            }\r\n            n++;\r\n            if (cut && n == 1) {\r\n"]
[10.047565, "o", "                throw new CutErr();\r\n            }\r\n        }\r\n    }\r\n\r\n"]
[10.047615, "o", "    static byte[] idOf(byte[] payload) throws Exception {\r\n        MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n        byte[] d = md.digest(payload);\r\n        StringBuilder hx = new StringBuilder();\r\n        for (byte v : d) {\r\n            hx.append(String.format(\"%02x\", v & 0xff));\r\n        }\r\n        String tail = hx.substring(32, 64);\r\n        byte[] id = new byte[16];\r\n        for (int k = 0; k < 16; k++) {\r\n"]
[10.04813, "o", "            id[k] = (byte) Integer.parseInt(tail.substring(k * 2, k * 2 + 2), 16);\r\n"]
[10.048173, "o", "        }\r\n        return id;\r\n    }\r\n\r\n    public static void main(String[] args) throws Exception {\r\n        if (args.length < 1) {\r\n            System.exit(2);\r\n        }\r\n        run(Paths.get(args[0]), false);\r\n    }\r\n}\r\n"]
[10.048971, "o", "/app/hitchbay/RibChan.java\r\n"]
[10.050587, "o", "===== /app/hitchbay/RibChan.java\r\n"]
[10.052255, "o", "import java.io.ByteArrayOutputStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.StandardOpenOption;\r\n\r\npublic class RibChan {\r\n    final Path file;\r\n    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\r\n\r\n    RibChan(Path file) {\r\n        this.file = file;\r\n    }\r\n\r\n    void append(byte[] x) throws Exception {\r\n        pending.write(x);\r\n    }\r\n\r\n    void force() throws Exception {\r\n        byte[] out = pending.toByteArray();\r\n        if (out.length == 0) {\r\n            return;\r\n        }\r\n        Files.write(file, out, StandardOpenOption.CREATE, StandardOpenOption.APPEND);\r\n        pending.reset();\r\n    }\r\n}\r\n"]
[10.053099, "o", "/app/hitchbay/StirRun.java\r\n"]
[10.054658, "o", "===== /app/hitchbay/StirRun.java\r\n"]
[10.054978, "o", "import java.nio.file.Path;\r\n\r\npublic class StirRun {\r\n    public static void main(String[] args) throws Exception {\r\n        Path silo = Path.of(\"/app/silo\");\r\n        int rc = HueWalk.orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\"));\r\n        System.exit(rc);\r\n    }\r\n}\r\n"]
[10.056458, "o", "/app/siltpage/MistSpan.java\r\n"]
