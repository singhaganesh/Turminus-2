Y and dy > 0.0 and\n            self.hits >= 2\n        )\n        if crossed:\n            self.counted = True\n        return crossed\n\n\ndef count_crossings(all_observations):\n    tracks = []\n    next_ident = 0\n    total = 0\n    for frame_no, observations in enumerate(all_observations):\n        # Globally choose the cheapest one-to-one associations rather than\n        # depending on connected-component ordering.\n        candidates = []\n        for ti, track in enumerate(tracks):\n            for oi, obs in enumerate(observations):\n                cost = track.cost(obs, frame_no)\n                if cost is not None:\n                    candidates.append((cost, ti, oi))\n        used_tracks, used_obs = set(), set()\n        for _, ti, oi in sorted(candidates):\n            if ti in used_tracks or oi in used_obs:\n                continue\n            if tracks[ti].update(observations[oi], frame_no):\n                total += 1\n            used_tracks.add(ti)\n            used_obs.add(oi)\n        for oi, obs in enumerate(observations):\n            if oi not in used_obs:\n                tracks.append(BodyTrack(next_ident, obs, frame_no))\n                next_ident += 1\n    return total\n\n\ndef fold_gate(n):\n    return int(n)\nPY\ncat > /app/spout.py <<\'PY\'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import foreground_detections\nfrom tether import count_crossings, fold_gate\n\nSHEET = Path("/app/inkwell/sheet.toml")\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError("cannot open clip")\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError("invalid frame")\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        