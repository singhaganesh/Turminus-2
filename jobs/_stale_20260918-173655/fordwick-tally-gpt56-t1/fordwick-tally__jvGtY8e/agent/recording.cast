[30.903936, "i", "cat > /tmp/probe.py <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; c=cv2.VideoCapture(p)\nframes=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n frames.append(f)\nprint('opened',c.isOpened(),'frames',len(frames),'fps',c.get(cv2.CAP_PROP_FPS),'shape',frames[0].shape if frames else None)\nif not frames: raise SystemExit\nA=np.asarray(frames)\nprint('channel ranges',[(int(A[...,i].min()),int(A[...,i].max())) for i in range(3)])\nbg=np.median(A,axis=0).astype(np.uint8)\nfor threshold in (10,20,30,45):\n print('\\nTHRESH',threshold)\n for i,f in enumerate(frames):\n  d=cv2.cvtColor(cv2.absdiff(f,bg),cv2.COLOR_BGR2GRAY)\n  m=(d>threshold).astype(np.uint8)*255\n  m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n  n,lab,st,cen=cv2.connectedComponentsWithStats(m)\n  comps=[]\n  for j in range(1,n):\n   x,y,w,h,a=map(int,st[j]); cx,cy=cen[j]\n   if a>=15: comps.append((a,round(cx,1),round(cy,1),x,y,w,h))\n  if threshold==20 and (comps and (i%6==0 or any(55<=q[2]<=85 for q in comps))): print(i,comps)\n counts=sum(1 for f in frames for _ in [])\n vals=[]\n for f in frames:\n  d=cv2.cvtColor(cv2.absdiff(f,bg),cv2.COLOR_BGR2GRAY); vals.append(int((d>threshold).sum()))\n print('foreground px min/median/max',min(vals),int(np.median(vals)),max(vals))\nPY\npython3 /tmp/probe.py\n"]
