[100.120655, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef foreground_detections(frames):\n    \"\"\"Return connected moving-body observations for every frame.\"\"\"\n    stack = np.asarray(frames, dtype=np.uint8)\n    background = np.median(stack, axis=0).astype(np.uint8)\n    kernel = np.ones((3, 3), np.uint8)\n    result = []\n    for frame in frames:\n        # Maximum channel difference preserves objects whose luminance happens\n        # to resemble the background but whose colour does not.\n        delta = cv2.absdiff(frame, background).max(axis=2)\n        mask = np.where(delta >= 18, 255, 0).astype(np.uint8)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)\n        count, labels, stats, centres = cv2.connectedComponentsWithStats(mask, 8)\n        observations = []\n        for label in range(1, count):\n            x, y, w, h, area = (int(v) for v in stats[label])\n            # Reject compression flecks and broad frame-wide illumination noise.\n            if area < 18 or w < 3 or h < 3 or area > 7000:\n                continue\n            pixels = frame[labels == label]\n            colour = pixels.mean(axis=0).astype(float)\n            cx, cy = (float(v) for v in centres[label])\n            observations.append({\n                \"x\": cx, \"y\": cy, \"area\": float(area),\n                \"w\": w, \"h\": h, \"colour\": colour,\n            })\n        result.append(observations)\n    return result\nPY\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport numpy as np\n\nLINE_Y = 70.0\n\n\nclass BodyTrack:\n    def __init__(self, ident, obs, frame_no):\n        self.ident = ident\n        self.x = obs[\"x\"]\n        self.y = obs[\"y\"]\n        self.vx = 0.0\n        self.vy = 0.0\n        self.area = obs[\"area\"]\n        self.colour = obs[\"colour\"].copy()\n        self.last_frame = frame_no\n        self.seen_above = self.y <= LINE_Y - 2.0\n        self.counted = False\n        self.hits = 1\n\n    def cost(self, obs, frame_no):\n        gap = frame_no - self.last_frame\n        if gap <= 0:\n            return None\n        # Short gaps use motion prediction. Long gaps are conservative re-ID,\n        # useful when a body exits and later returns without creating a new ID.\n        if gap <= 6:\n            px = self.x + self.vx * min(gap, 3)\n            py = self.y + self.vy * min(gap, 3)\n            distance = float(np.hypot(obs[\"x\"] - px, obs[\"y\"] - py))\n            if distance > 15.0 * gap + 8.0:\n                return None\n        else:\n            distance = float(np.hypot(obs[\"x\"] - self.x, obs[\"y\"] - self.y))\n            colour_distance = float(np.linalg.norm(obs[\"colour\"] - self.colour))\n            ratio = max(obs[\"area\"], self.area) / max(1.0, min(obs[\"area\"], self.area))\n            if colour_distance > 22.0 or ratio > 1.8 or abs(obs[\"x\"] - self.x) > 28.0:\n                return None\n            distance += 8.0\n        colour_distance = float(np.linalg.norm(obs[\"colour\"] - self.colour))\n        ratio_penalty = abs(np.log(max(obs[\"area\"], 1.0) / max(self.area, 1.0)))\n        return distance + 0.06 * colour_distance + 7.0 * ratio_penalty\n\n    def update(self, obs, frame_no):\n        gap = max(1, frame_no - self.last_frame)\n        old_y = self.y\n        dx = (obs[\"x\"] - self.x) / gap\n        dy = (obs[\"y\"] - self.y) / gap\n        self.vx = 0.55 * self.vx + 0.45 * dx\n        self.vy = 0.55 * self.vy + 0.45 * dy\n        self.x, self.y = obs[\"x\"], obs[\"y\"]\n        self.area = 0.75 * self.area + 0.25 * obs[\"area\"]\n        self.colour = 0.8 * self.colour + 0.2 * obs[\"colour\"]\n        self.last_frame = frame_no\n        self.hits += 1\n        if self.y <= LINE_Y - 2.0:\n            self.seen_above = True\n        crossed = (\n            self.seen_above and not self.counted and\n            old_y < LINE_Y and self.y >= LINE_Y and dy > 0.0 and\n            self.hits >= 2\n        )\n        if crossed:\n            self.counted = True\n        return crossed\n\n\ndef count_crossings(all_observations):\n    tracks = []\n    next_ident = 0\n    tota"]
[100.120816, "i", "l = 0\n    for frame_no, observations in enumerate(all_observations):\n        # Globally choose the cheapest one-to-one associations rather than\n        # depending on connected-component ordering.\n        candidates = []\n        for ti, track in enumerate(tracks):\n            for oi, obs in enumerate(observations):\n                cost = track.cost(obs, frame_no)\n                if cost is not None:\n                    candidates.append((cost, ti, oi))\n        used_tracks, used_obs = set(), set()\n        for _, ti, oi in sorted(candidates):\n            if ti in used_tracks or oi in used_obs:\n                continue\n            if tracks[ti].update(observations[oi], frame_no):\n                total += 1\n            used_tracks.add(ti)\n            used_obs.add(oi)\n        for oi, obs in enumerate(observations):\n            if oi not in used_obs:\n                tracks.append(BodyTrack(next_ident, obs, frame_no))\n                next_ident += 1\n    return total\n\n\ndef fold_gate(n):\n    return int(n)\nPY\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import foreground_detections\nfrom tether import count_crossings, fold_gate\n\nSHEET = Path(\"/app/inkwell/sheet.toml\")\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError(\"cannot open clip\")\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError(\"invalid frame\")\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError(\"clip contains no readable frames\")\n    return fold_gate(count_crossings(foreground_detections(frames)))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    temporary = SHEET.with_suffix(\".tmp\")\n    temporary.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\n    temporary.replace(SHEET)\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    # Never leave a result from an earlier invocation on any failed run.\n    try:\n        SHEET.unlink(missing_ok=True)\n        if len(sys.argv) != 2:\n            return 2\n        value = emit_span(sys.argv[1])\n        dump_sheet(value)\n        return 0\n    except Exception as exc:\n        SHEET.unlink(missing_ok=True)\n        print(f\"mill: {exc}\", file=sys.stderr)\n        return 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPY\nchmod +x /app/kiln/bake.sh && /app/kiln/bake.sh\n"]
