[11.410333, "o", "/app/wickpit/__init__.py\r\n"]
[11.411575, "o", "/app/wickpit/shiftlog.txt\r\n"]
[11.412921, "o", "Night desk: occupancy helper still green on the worked sample.\r\nDo not treat that as the whole mill.\r\n"]
[11.413129, "o", "/app/wickpit/touchcue.py\r\n"]
[11.414188, "o", "#!/usr/bin/env python3\r\n\"\"\"Desk helper: rising occupancy on the scan row.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\n"]
[11.414278, "o", "def occupancy_edges(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = cv2.createBackgroundSubtractorMOG2(history=30, varThreshold=16, detectShadows=True)\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        fg = mog.apply(frame)\r\n        _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n        y = int(LINE_Y)\r\n        band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n        now = bool(band.any())\r\n        if now and not prev:\r\n            n += 1\r\n        prev = now\r\n    cap.release()\r\n    return n\r\n"]
[11.414477, "o", "/app/slipfold/SPAN.txt\r\n"]
[11.415458, "o", "Station geometry\r\n================\r\n\r\nFrame size: 160 x 120\r\nRate: 12 fps\r\nHorizontal scan row: y = 70 (top of frame is y = 0)\r\n\r\n"]
[11.415563, "o", "Drive:\r\n\r\n    python3 /app/varnish/mill.pyc CLIP\r\n\r\nCLIP is an mp4 path. Success writes /app/inkwell/sheet.toml:\r\n\r\n    crossings = <integer>\r\n\r\nWorked sample: /app/shown.mp4 -> crossings = 3\r\n\r\n"]
[11.415635, "o", "Unreadable CLIP: non-zero exit, do not write /app/inkwell/sheet.toml.\r\nExample unreadable path:\r\n\r\n    python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4\r\n\r\nFold blot, tether, spout, and the spanwell driver using the kiln notes.\r\n"]
[11.415726, "o", "/app/spanwell.py\r\n"]
[11.416649, "o", "#!/usr/bin/env python3\r\nfrom __future__ import annotations\r\n\r\nimport sys\r\n\r\nfrom spout import dump_sheet, emit_span\r\n\r\n\r\ndef main() -> int:\r\n    if len(sys.argv) != 2:\r\n"]
[11.416736, "o", "        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
