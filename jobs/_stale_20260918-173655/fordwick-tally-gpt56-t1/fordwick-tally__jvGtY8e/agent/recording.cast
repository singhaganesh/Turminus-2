[144.478863, "o", "\u001b[?2004h> "]
[144.479079, "o", "W,H=160,120\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.479274, "o", "def clip(path, tracks, frames=72):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.4795, "o", "    out=cv2.VideoWriter(path,cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\r\n\u001b[?2004l\r"]
[144.479612, "o", "\u001b[?2004h> "]
[144.479693, "o", "    for i in range(frames):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.479825, "o", "        im=np.full((H,W,3),(175,175,175),np.uint8)\r\n\u001b[?2004l\r"]
[144.479917, "o", "\u001b[?2004h> "]
[144.480097, "o", "        # fixed texture ensures this is not dependent on a perfectly blank scene\r\n\u001b[?2004l\r"]
[144.480191, "o", "\u001b[?2004h> "]
[144.481885, "o", "        cv2.line(im,(0,15),(159,15),(160,160,160),1)\r\n\u001b[?2004l\r\u001b[?2004h>         for colour, xs, ys in tracks:\r\n\u001b[?2004l\r\u001b[?2004h>             if i < len(ys) and ys[i] is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 cv2.circle(im,(int(xs[i] if hasattr(xs,'__len__') else xs),int(ys[i])),7,colour,-1)\r\n\u001b[?2004l\r\u001b[?2004h>         out.write(im)\r\n\u001b[?2004l\r\u001b[?2004h>     out.release()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def ramp(a,b,n): return list(np.linspace(a,b,n))\r\n\u001b[?2004l\r\u001b[?2004h> N=72\r\n\u001b[?2004l\r\u001b[?2004h> cases={}\r\n\u001b[?2004l\r\u001b[?2004h> # one valid down, one reverse, and one that stops above the row\r\n\u001b[?2004l\r\u001b[?2004h> cases['direction']=(1,[((20,40,230),35,ramp(15,105,N)),((230,60,20),80,ramp(105,15,N)),((40,220,40),125,ramp(15,63,N))])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.482053, "o", "# centroid remains exactly on/near row for many frames, but only counts once\r\n\u001b[?2004l\r"]
[144.482169, "o", "\u001b[?2004h> "]
[144.48233, "o", "cases['linger']=(1,[((20,40,230),55,ramp(20,68,20)+[70]*25+ramp(72,105,27))])\r\n\u001b[?2004l\r"]
[144.482381, "o", "\u001b[?2004h"]
[144.482579, "o", "> "]
[144.482807, "o", "# same visually unique body crosses, disappears, returns above, and crosses again\r\n\u001b[?2004l\r"]
[144.482964, "o", "\u001b[?2004h> "]
[144.48305, "o", "ys=ramp(20,110,24)+[None]*16+ramp(20,105,32)\r\n\u001b[?2004l\r"]
[144.483168, "o", "\u001b[?2004h> "]
[144.48327, "o", "cases['return']=(1,[((40,80,230),45,ys)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.48349, "o", "# seven concurrent valid crossings; tolerance rule still expects close to 7\r\n\u001b[?2004l\r"]
[144.483572, "o", "\u001b[?2004h> tracks=[]\r\n\u001b[?2004l\r"]
[144.483656, "o", "\u001b[?2004h> "]
[144.483736, "o", "for j,x in enumerate(range(15,156,22)):\r\n\u001b[?2004l\r"]
[144.483808, "o", "\u001b[?2004h> "]
[144.484003, "o", "    tracks.append(((20+20*j,40+13*j,230-17*j),x,ramp(15-j,108-j,N)))\r\n\u001b[?2004l\r"]
[144.484064, "o", "\u001b[?2004h"]
[144.484124, "o", "> cases['seven']=(7,tracks)\r\n\u001b[?2004l\r\u001b[?2004h"]
[144.484181, "o", "> "]
[144.484276, "o", "# Three crossings at different times and lateral velocities\r\n\u001b[?2004l\r"]
[144.48436, "o", "\u001b[?2004h> "]
[144.484429, "o", "tracks=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.484566, "o", "for j,(x0,x1,start) in enumerate(((15,50,0),(75,95,12),(145,110,24))):\r\n\u001b[?2004l\r"]
[144.484629, "o", "\u001b[?2004h"]
[144.484683, "o", "> "]
[144.484743, "o", "    ys=[None]*start+ramp(12,108,N-start)\r\n\u001b[?2004l\r\u001b[?2004h"]
[144.484801, "o", "> "]
[144.484914, "o", "    xs=[x0]*start+list(np.linspace(x0,x1,N-start))\r\n\u001b[?2004l\r"]
[144.485029, "o", "\u001b[?2004h> "]
[144.485112, "o", "    tracks.append(((30+50*j,220-40*j,70+40*j),xs,ys))\r\n\u001b[?2004l\r"]
[144.485184, "o", "\u001b[?2004h> "]
[144.485257, "o", "cases['staggered']=(3,tracks)\r\n\u001b[?2004l\r\u001b[?2004h"]
[144.485317, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.485377, "o", "failed=False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.485497, "o", "for name,(expected,tracks) in cases.items():\r\n\u001b[?2004l\r"]
[144.485554, "o", "\u001b[?2004h> "]
[144.485649, "o", "    path='/tmp/'+name+'.mp4'; clip(path,tracks,N)\r\n\u001b[?2004l\r"]
[144.485713, "o", "\u001b[?2004h> "]
[144.485813, "o", "    subprocess.run(['rm','-f','/app/inkwell/sheet.toml'])\r\n\u001b[?2004l\r"]
[144.485897, "o", "\u001b[?2004h> "]
[144.48602, "o", "    p=subprocess.run(['python3','/app/varnish/mill.pyc',path])\r\n\u001b[?2004l\r"]
[144.48608, "o", "\u001b[?2004h> "]
[144.486268, "o", "    got=toml.load('/app/inkwell/sheet.toml')['crossings'] if p.returncode==0 else None\r\n\u001b[?2004l\r"]
[144.486326, "o", "\u001b[?2004h> "]
[144.486457, "o", "    print(name,'expected',expected,'got',got,'status',p.returncode)\r\n\u001b[?2004l\r"]
[144.486515, "o", "\u001b[?2004h> "]
[144.486577, "o", "    if got != expected: failed=True\r\n\u001b[?2004l\r"]
[144.486631, "o", "\u001b[?2004h"]
[144.486685, "o", "> "]
[144.486737, "o", "raise SystemExit(1 if failed else 0)\r\n\u001b[?2004l\r"]
[144.486792, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[144.488354, "o", "\u001b[?2004hroot@545113cbf245:/app# "]
