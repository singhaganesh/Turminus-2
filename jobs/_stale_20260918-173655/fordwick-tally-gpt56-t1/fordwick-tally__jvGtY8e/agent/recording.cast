[100.138301, "o", "        self.colour = 0.8 * self.colour + 0.2 * obs[\"colour\"]\r\n\u001b[?2004l\r"]
[100.13835, "o", "\u001b[?2004h> "]
[100.138434, "o", "        self.last_frame = frame_no\r\n\u001b[?2004l\r"]
[100.13848, "o", "\u001b[?2004h> "]
[100.138543, "o", "        self.hits += 1\r\n\u001b[?2004l\r"]
[100.138592, "o", "\u001b[?2004h> "]
[100.138678, "o", "        if self.y <= LINE_Y - 2.0:\r\n\u001b[?2004l\r"]
[100.138725, "o", "\u001b[?2004h> "]
[100.138809, "o", "            self.seen_above = True\r\n\u001b[?2004l\r"]
[100.138839, "o", "\u001b[?2004h"]
[100.138946, "o", ">         crossed = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.139082, "o", "            self.seen_above and not self.counted and\r\n\u001b[?2004l\r"]
[100.13915, "o", "\u001b[?2004h> "]
[100.139293, "o", "            old_y < LINE_Y and self.y >= LINE_Y and dy > 0.0 and\r\n\u001b[?2004l\r"]
[100.139359, "o", "\u001b[?2004h> "]
[100.139424, "o", "            self.hits >= 2\r\n\u001b[?2004l\r"]
[100.13949, "o", "\u001b[?2004h>         )\r\n"]
[100.139555, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[100.139617, "o", "        if crossed:\r\n\u001b[?2004l\r"]
[100.13968, "o", "\u001b[?2004h> "]
[100.139736, "o", "            self.counted = True\r\n\u001b[?2004l\r"]
[100.139801, "o", "\u001b[?2004h> "]
[100.139866, "o", "        return crossed\r\n\u001b[?2004l\r"]
[100.139926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.13999, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.140101, "o", "def count_crossings(all_observations):\r\n\u001b[?2004l\r"]
[100.140163, "o", "\u001b[?2004h> "]
[100.140229, "o", "    tracks = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.140294, "o", "    next_ident = 0\r\n\u001b[?2004l\r"]
[100.140359, "o", "\u001b[?2004h>     total = 0\r\n\u001b[?2004l\r"]
[100.140423, "o", "\u001b[?2004h> "]
[100.140567, "o", "    for frame_no, observations in enumerate(all_observations):\r\n\u001b[?2004l\r"]
[100.140632, "o", "\u001b[?2004h> "]
[100.140807, "o", "        # Globally choose the cheapest one-to-one associations rather than\r\n\u001b[?2004l\r"]
[100.140882, "o", "\u001b[?2004h> "]
[100.141009, "o", "        # depending on connected-component ordering.\r\n\u001b[?2004l\r"]
[100.141073, "o", "\u001b[?2004h> "]
[100.141143, "o", "        candidates = []\r\n\u001b[?2004l\r"]
[100.141206, "o", "\u001b[?2004h> "]
[100.141295, "o", "        for ti, track in enumerate(tracks):\r\n\u001b[?2004l\r"]
[100.141363, "o", "\u001b[?2004h> "]
[100.141478, "o", "            for oi, obs in enumerate(observations):\r\n\u001b[?2004l\r"]
[100.141542, "o", "\u001b[?2004h> "]
[100.141656, "o", "                cost = track.cost(obs, frame_no)\r\n\u001b[?2004l\r"]
[100.141715, "o", "\u001b[?2004h> "]
[100.141808, "o", "                if cost is not None:\r\n\u001b[?2004l\r"]
[100.141873, "o", "\u001b[?2004h> "]
[100.141997, "o", "                    candidates.append((cost, ti, oi))\r\n\u001b[?2004l\r"]
[100.142047, "o", "\u001b[?2004h> "]
[100.142165, "o", "        used_tracks, used_obs = set(), set()\r\n\u001b[?2004l\r"]
[100.142211, "o", "\u001b[?2004h> "]
[100.142325, "o", "        for _, ti, oi in sorted(candidates):\r\n\u001b[?2004l\r"]
[100.142369, "o", "\u001b[?2004h> "]
[100.142508, "o", "            if ti in used_tracks or oi in used_obs:\r\n\u001b[?2004l\r"]
[100.142554, "o", "\u001b[?2004h> "]
[100.142626, "o", "                continue\r\n\u001b[?2004l\r"]
[100.14267, "o", "\u001b[?2004h> "]
[100.142823, "o", "            if tracks[ti].update(observations[oi], frame_no):\r\n\u001b[?2004l\r"]
[100.142879, "o", "\u001b[?2004h> "]
[100.142964, "o", "                total += 1\r\n\u001b[?2004l\r"]
[100.143034, "o", "\u001b[?2004h> "]
[100.143094, "o", "            used_tracks.add(ti)\r\n\u001b[?2004l\r"]
[100.14316, "o", "\u001b[?2004h> "]
[100.143243, "o", "            used_obs.add(oi)\r\n\u001b[?2004l\r"]
[100.143308, "o", "\u001b[?2004h> "]
[100.143442, "o", "        for oi, obs in enumerate(observations):\r\n\u001b[?2004l\r"]
[100.143499, "o", "\u001b[?2004h> "]
[100.143593, "o", "            if oi not in used_obs:\r\n\u001b[?2004l\r"]
[100.143662, "o", "\u001b[?2004h> "]
[100.143846, "o", "                tracks.append(BodyTrack(next_ident, obs, frame_no))\r\n\u001b[?2004l\r"]
[100.143912, "o", "\u001b[?2004h> "]
[100.144003, "o", "                next_ident += 1\r\n\u001b[?2004l\r"]
[100.144065, "o", "\u001b[?2004h> "]
[100.144134, "o", "    return total\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.144196, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[100.144266, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[100.144332, "o", "def fold_gate(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.144388, "o", "> "]
[100.144445, "o", "    return int(n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.144507, "o", "> PY\r\n\u001b[?2004l\r"]
[100.145787, "o", "\u001b[?2004hroot@545113cbf245:/app# "]
[100.145906, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[100.145977, "o", "\u001b[?2004h> "]
[100.146088, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[100.146153, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.146213, "o", "> "]
[100.146295, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[100.146359, "o", "\u001b[?2004h> import cv2\r\n\u001b[?2004l\r"]
[100.146456, "o", "\u001b[?2004h> "]
[100.146541, "o", "import toml\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.146596, "o", "\u001b[?2004h> "]
[100.146654, "o", "from blot import foreground_detections\r\n\u001b[?2004l\r"]
[100.146711, "o", "\u001b[?2004h> "]
[100.14685, "o", "from tether import count_crossings, fold_gate\r\n\u001b[?2004l\r"]
[100.146899, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.146922, "o", "> "]
[100.147058, "o", "SHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\u001b[?2004l\r"]
[100.147153, "o", "\u001b[?2004h"]
[100.147233, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.147301, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.147368, "o", "> "]
[100.147434, "o", "    cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r"]
[100.147496, "o", "\u001b[?2004h> "]
[100.147561, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.147646, "o", ">         cap.release()\r\n\u001b[?2004l\r"]
[100.147725, "o", "\u001b[?2004h> "]
[100.147871, "o", "        raise OSError(\"cannot open clip\")\r\n\u001b[?2004l\r"]
[100.147935, "o", "\u001b[?2004h> "]
[100.148007, "o", "    frames = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.148152, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.148232, "o", ">         ok, frame = cap.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.148297, "o", "        if not ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.148373, "o", "            break\r\n\u001b[?2004l\r"]
[100.148457, "o", "\u001b[?2004h> "]
[100.148535, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r"]
[100.148559, "o", "\u001b[?2004h"]
[100.148575, "o", "> "]
[100.148665, "o", "            cap.release()\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.148683, "o", "> "]
[100.148807, "o", "            raise ValueError(\"invalid frame\")\r\n\u001b[?2004l\r"]
[100.148896, "o", "\u001b[?2004h> "]
[100.149035, "o", "        frames.append(frame)\r\n\u001b[?2004l\r\u001b[?2004h>     cap.release()\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.149141, "o", ">     if not frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.149297, "o", "        raise OSError(\"clip contains no readable frames\")\r\n\u001b[?2004l\r"]
[100.149382, "o", "\u001b[?2004h> "]
[100.149508, "o", "    return fold_gate(count_crossings(foreground_detections(frames)))\r\n\u001b[?2004l\r"]
[100.149609, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.14968, "o", "\u001b[?2004h> "]
[100.149747, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r"]
[100.149809, "o", "\u001b[?2004h> "]
[100.149942, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[100.150014, "o", "\u001b[?2004h> "]
[100.150099, "o", "    temporary = SHEET.with_suffix(\".tmp\")\r\n\u001b[?2004l\r"]
[100.150162, "o", "\u001b[?2004h> "]
[100.150364, "o", "    temporary.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n\u001b[?2004l\r"]
[100.150425, "o", "\u001b[?2004h> "]
[100.150496, "o", "    temporary.replace(SHEET)\r\n\u001b[?2004l\r"]
[100.150564, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[100.152034, "o", "\u001b[?2004hroot@545113cbf245:/app# "]
[100.15215, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[100.152243, "o", "\u001b[?2004h> "]
[100.152323, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.152453, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[100.152515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.152598, "o", "> import sys\r\n\u001b[?2004l\r"]
[100.152674, "o", "\u001b[?2004h> "]
[100.152777, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[100.152846, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[100.152917, "o", "> \r\n\u001b[?2004l\r"]
[100.152939, "o", "\u001b[?2004h> "]
[100.153054, "o", "def main() -> int:\r\n\u001b[?2004l\r"]
[100.153136, "o", "\u001b[?2004h> "]
[100.153273, "o", "    # Never leave a result from an earlier invocation on any failed run.\r\n\u001b[?2004l\r"]
[100.153351, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[100.153423, "o", "\u001b[?2004h> "]
[100.153513, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[100.153592, "o", "\u001b[?2004h> "]
[100.153661, "o", "        if len(sys.argv) != 2:\r\n\u001b[?2004l\r"]
[100.15368, "o", "\u001b[?2004h"]
[100.153695, "o", "> "]
[100.153782, "o", "            return 2\r\n\u001b[?2004l\r"]
[100.153801, "o", "\u001b[?2004h> "]
[100.153955, "o", "        value = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[100.154026, "o", "\u001b[?2004h> "]
[100.154086, "o", "        dump_sheet(value)\r\n\u001b[?2004l\r"]
[100.154135, "o", "\u001b[?2004h> "]
[100.154875, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"mill: {exc}\", file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         return 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[100.154906, "o", "\u001b[?2004h> "]
[100.155029, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.155124, "o", "> "]
[100.155155, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r"]
[100.155259, "o", "\u001b[?2004h> "]
[100.155323, "o", "PY\r\n\u001b[?2004l\r"]
[100.156556, "o", "\u001b[?2004hroot@545113cbf245:/app# "]
[100.156742, "o", "chmod +x /app/kiln/bake.sh && /app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[100.220582, "o", "\u001b[?2004hroot@545113cbf245:/app# "]
[102.057355, "i", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /app/shown.mp4; s=$?; echo sample_status=$s; cat /app/inkwell/sheet.toml; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; s=$?; echo missing_status=$s; if test -e /app/inkwell/sheet.toml; then echo ERROR_sheet_exists; cat /app/inkwell/sheet.toml; else echo sheet_absent; fi\n"]
[102.058921, "o", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /app/shown.mp4; s=$?; echo sample_status=$s; cat /app/inkwell/sheet.toml; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; s=$?; echo missing_status=$s; if test -e /app/inkwell/sheet.toml; then echo ERROR_sheet_exists; cat /app/inkwell/sheet.toml; else echo sheet_absent; fi\r\n\u001b[?2004l\r"]
[102.432815, "o", "sample_status=0\r\n"]
[102.433756, "o", "crossings = 3\r\n"]
[102.705274, "o", "mill: cannot open clip\r\n"]
[102.733131, "o", "missing_status=1\r\nsheet_absent\r\n\u001b[?2004hroot@545113cbf245:/app# "]
[144.478155, "i", "cat > /tmp/testmill.py <<'PY'\nimport cv2, os, subprocess, toml\nimport numpy as np\n\nW,H=160,120\n\ndef clip(path, tracks, frames=72):\n    out=cv2.VideoWriter(path,cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\n    for i in range(frames):\n        im=np.full((H,W,3),(175,175,175),np.uint8)\n        # fixed texture ensures this is not dependent on a perfectly blank scene\n        cv2.line(im,(0,15),(159,15),(160,160,160),1)\n        for colour, xs, ys in tracks:\n            if i < len(ys) and ys[i] is not None:\n                cv2.circle(im,(int(xs[i] if hasattr(xs,'__len__') else xs),int(ys[i])),7,colour,-1)\n        out.write(im)\n    out.release()\n\ndef ramp(a,b,n): return list(np.linspace(a,b,n))\nN=72\ncases={}\n# one valid down, one reverse, and one that stops above the row\ncases['direction']=(1,[((20,40,230),35,ramp(15,105,N)),((230,60,20),80,ramp(105,15,N)),((40,220,40),125,ramp(15,63,N))])\n# centroid remains exactly on/near row for many frames, but only counts once\ncases['linger']=(1,[((20,40,230),55,ramp(20,68,20)+[70]*25+ramp(72,105,27))])\n# same visually unique body crosses, disappears, returns above, and crosses again\nys=ramp(20,110,24)+[None]*16+ramp(20,105,32)\ncases['return']=(1,[((40,80,230),45,ys)])\n# seven concurrent valid crossings; tolerance rule still expects close to 7\ntracks=[]\nfor j,x in enumerate(range(15,156,22)):\n    tracks.append(((20+20*j,40+13*j,230-17*j),x,ramp(15-j,108-j,N)))\ncases['seven']=(7,tracks)\n# Three crossings at different times and lateral velocities\ntracks=[]\nfor j,(x0,x1,start) in enumerate(((15,50,0),(75,95,12),(145,110,24))):\n    ys=[None]*start+ramp(12,108,N-start)\n    xs=[x0]*start+list(np.linspace(x0,x1,N-start))\n    tracks.append(((30+50*j,220-40*j,70+40*j),xs,ys))\ncases['staggered']=(3,tracks)\n\nfailed=False\nfor name,(expected,tracks) in cases.items():\n    path='/tmp/'+name+'.mp4'; clip(path,tracks,N)\n    subprocess.run(['rm','-f','/app/inkwell/sheet.toml'])\n    p=subprocess.run(['python3','/app/varnish/mill.pyc',path])\n    got=toml.load('/app/inkwell/sheet.toml')['crossings'] if p.returncode==0 else None\n    print(name,'expected',expected,'got',got,'status',p.returncode)\n    if got != expected: failed=True\nraise SystemExit(1 if failed else 0)\nPY\npython3 /tmp/testmill.py\n"]
[144.478492, "o", "cat > /tmp/testmill.py <<'PY'\r\n\u001b[?2004l\r"]
