[93.006046, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef make_background(frames):\n    \"\"\"A moving object's colour is normally absent at each pixel for most frames.\"\"\"\n    return np.median(np.stack(frames, axis=0), axis=0).astype(np.uint8)\n\n\ndef find_bodies(frame, background):\n    \"\"\"Return (centroid, bbox, area, colour) for foreground components.\"\"\"\n    delta = cv2.absdiff(frame, background)\n    strength = np.max(delta, axis=2)\n    mask = np.where(strength >= 14, 255, 0).astype(np.uint8)\n    kernel = np.ones((3, 3), np.uint8)\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)\n    count, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\n    ans = []\n    for label in range(1, count):\n        x, y, w, h, area = [int(v) for v in stats[label]]\n        # Reject codec flecks and broad one-pixel changes at frame boundaries.\n        if area < 20 or w < 3 or h < 3:\n            continue\n        pixels = frame[labels == label]\n        colour = tuple(float(v) for v in np.median(pixels, axis=0))\n        ans.append({\n            \"p\": (float(centers[label][0]), float(centers[label][1])),\n            \"box\": (x, y, w, h), \"area\": area, \"colour\": colour,\n        })\n    return ans\nPY\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport math\n\nLINE_Y = 70.0\n\n\ndef _distance(a, b):\n    return math.hypot(a[0] - b[0], a[1] - b[1])\n\n\ndef _colour_distance(a, b):\n    return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)))\n\n\nclass CentroidCounter:\n    \"\"\"Small-video multi-object tracker with persistent, one-shot identities.\"\"\"\n    def __init__(self):\n        self.tracks = []\n        self.frame = -1\n        self.total = 0\n\n    def _new(self, d):\n        x, y = d[\"p\"]\n        self.tracks.append({\n            \"p\": (x, y), \"v\": (0.0, 0.0), \"last\": self.frame,\n            \"colour\": d[\"colour\"], \"area\": float(d[\"area\"]),\n            \"seen_above\": y < LINE_Y - 1.0, \"counted\": False,\n            \"hits\": 1,\n        })\n\n    def _update(self, t, d):\n        oldx, oldy = t[\"p\"]\n        x, y = d[\"p\"]\n        gap = max(1, self.frame - t[\"last\"])\n        ivx, ivy = (x - oldx) / gap, (y - oldy) / gap\n        # Recent velocity is used only for assignment; keep it conservative.\n        t[\"v\"] = (0.45 * t[\"v\"][0] + 0.55 * ivx,\n                  0.45 * t[\"v\"][1] + 0.55 * ivy)\n        if y < LINE_Y - 1.0:\n            t[\"seen_above\"] = True\n        # Passage is based on actual observations, not a foreground touching row.\n        if (not t[\"counted\"] and t[\"seen_above\"] and\n                oldy < LINE_Y <= y and y > oldy):\n            t[\"counted\"] = True\n            self.total += 1\n        t[\"p\"] = (x, y)\n        t[\"last\"] = self.frame\n        t[\"hits\"] += 1\n        alpha = 0.18\n        t[\"colour\"] = tuple((1-alpha)*a + alpha*b\n                            for a, b in zip(t[\"colour\"], d[\"colour\"]))\n        t[\"area\"] = 0.85*t[\"area\"] + 0.15*d[\"area\"]\n\n    def add(self, detections):\n        self.frame += 1\n        candidates = []\n        # Normal continuation, including several missed frames.\n        for ti, t in enumerate(self.tracks):\n            gap = self.frame - t[\"last\"]\n            if gap > 8:\n                continue\n            pred = (t[\"p\"][0] + t[\"v\"][0]*gap,\n                    t[\"p\"][1] + t[\"v\"][1]*gap)\n            for di, d in enumerate(detections):\n                dist = _distance(pred, d[\"p\"])\n                size_ratio = max(t[\"area\"], d[\"area\"]) / max(1.0, min(t[\"area\"], d[\"area\"]))\n                if dist <= 18 + 8*gap and size_ratio < 3.0:\n                    candidates.append((dist + 0.025*_colour_distance(t[\"colour\"], d[\"colour\"]), ti, di))\n        used_t, used_d = set(), set()\n        for _, ti, di in sorted(candidates):\n            if ti not in used_t and di not in used_d:\n                self._update(self.tracks[ti], detections[di])\n                used_t.add(ti); used_d.add(di)\n\n        # Strong appearance re-identification handles an object that leaves and\n        # later returns without confl"]
[93.006337, "i", "ating ordinary similarly placed traffic.\n        for di, d in enumerate(detections):\n            if di in used_d:\n                continue\n            best = None\n            for ti, t in enumerate(self.tracks):\n                if ti in used_t or self.frame - t[\"last\"] <= 8:\n                    continue\n                cd = _colour_distance(t[\"colour\"], d[\"colour\"])\n                ar = max(t[\"area\"], d[\"area\"]) / max(1.0, min(t[\"area\"], d[\"area\"]))\n                xd = abs(t[\"p\"][0] - d[\"p\"][0])\n                if cd <= 9.0 and ar <= 1.35 and xd <= 18:\n                    score = cd + 0.15*xd\n                    if best is None or score < best[0]:\n                        best = (score, ti)\n            if best is not None:\n                self._update(self.tracks[best[1]], d)\n                used_t.add(best[1]); used_d.add(di)\n\n        for di, d in enumerate(detections):\n            if di not in used_d:\n                self._new(d)\n\n\ndef fold_gate(counter):\n    return int(counter.total)\nPY\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import make_background, find_bodies\nfrom tether import CentroidCounter, fold_gate\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('invalid frame geometry')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('clip contains no decodable frames')\n    background = make_background(frames)\n    counter = CentroidCounter()\n    for frame in frames:\n        counter.add(find_bodies(frame, background))\n    return fold_gate(counter)\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    temporary = SHEET.with_suffix('.tmp')\n    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    temporary.replace(SHEET)\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    # Never leave a previous run's answer behind after any failure.\n    try:\n        SHEET.unlink(missing_ok=True)\n    except OSError:\n        return 1\n    if len(sys.argv) != 2:\n        return 2\n    try:\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n    except Exception as exc:\n        print('mill: ' + str(exc), file=sys.stderr)\n        try:\n            SHEET.unlink(missing_ok=True)\n        except OSError:\n            pass\n        return 1\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\nbash /app/kiln/bake.sh\nrm -rf /app/inkwell\npython3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo \"bad_rc=$rc\"; test ! -e /app/inkwell/sheet.toml && echo 'bad_sheet_absent=yes'\n"]
