[27.489416, "i", "python3 - <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; cap=cv2.VideoCapture(p)\nprint('opened',cap.isOpened(),'frames',cap.get(cv2.CAP_PROP_FRAME_COUNT),'fps',cap.get(cv2.CAP_PROP_FPS),'size',cap.get(cv2.CAP_PROP_FRAME_WIDTH),cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\nfs=[]\nwhile True:\n ok,f=cap.read()\n if not ok: break\n fs.append(f)\nprint('decoded',len(fs))\na=np.array(fs); med=np.median(a,axis=0).astype(np.uint8)\nprint('global channel min/max',a.min((0,1,2)),a.max((0,1,2)),'median unique approx',len(np.unique(med.reshape(-1,3),axis=0)))\nfor i in np.linspace(0,len(fs)-1,min(15,len(fs)),dtype=int):\n d=cv2.absdiff(fs[i],med); g=d.max(2); mask=(g>20).astype(np.uint8)*255\n mask=cv2.morphologyEx(mask,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n n,lab,st,cen=cv2.connectedComponentsWithStats(mask)\n cs=[(int(x),int(y),int(w),int(h),int(ar),tuple(np.round(c,1))) for (x,y,w,h,ar),c in zip(st[1:],cen[1:]) if ar>=8]\n print(i,cs)\nPY\n"]
