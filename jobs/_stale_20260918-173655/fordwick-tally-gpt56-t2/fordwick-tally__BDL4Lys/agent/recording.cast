[93.051516, "o", "                xd = abs(t[\"p\"][0] - d[\"p\"][0])\r\n\u001b[?2004l\r"]
[93.052367, "o", "\u001b[?2004h>                 if cd <= 9.0 and ar <= 1.35 and xd <= 18:\r\n\u001b[?2004l\r"]
[93.052502, "o", "\u001b[?2004h>                     score = cd + 0.15*xd\r\n\u001b[?2004l\r"]
[93.052713, "o", "\u001b[?2004h> "]
[93.052852, "o", "                    if best is None or score < best[0]:\r\n\u001b[?2004l\r"]
[93.053117, "o", "\u001b[?2004h> "]
[93.053279, "o", "                        best = (score, ti)\r\n\u001b[?2004l\r"]
[93.053412, "o", "\u001b[?2004h> "]
[93.053514, "o", "            if best is not None:\r\n\u001b[?2004l\r"]
[93.053972, "o", "\u001b[?2004h>                 self._update(self.tracks[best[1]], d)\r\n\u001b[?2004l\r\u001b[?2004h>                 used_t.add(best[1]); used_d.add(di)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.054122, "o", "\u001b[?2004h> "]
[93.054169, "o", "        for di, d in enumerate(detections):\r\n\u001b[?2004l\r"]
[93.054302, "o", "\u001b[?2004h> "]
[93.054386, "o", "            if di not in used_d:\r\n\u001b[?2004l\r"]
[93.054472, "o", "\u001b[?2004h> "]
[93.054603, "o", "                self._new(d)\r\n\u001b[?2004l\r"]
[93.054729, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.054869, "o", "\u001b[?2004h> "]
[93.055082, "o", "def fold_gate(counter):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.055154, "o", "    return int(counter.total)\r\n\u001b[?2004l\r"]
[93.055194, "o", "\u001b[?2004h> PY\r\n"]
[93.055219, "o", "\u001b[?2004l\r"]
[93.05734, "o", "\u001b[?2004hroot@d8e940a79be8:/app# "]
[93.057511, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.05764, "o", "> "]
[93.057821, "o", "from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.057917, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[93.057955, "o", "\u001b[?2004h> "]
[93.058024, "o", "import cv2\r\n\u001b[?2004l\r"]
[93.058046, "o", "\u001b[?2004h"]
[93.058084, "o", "> "]
[93.058328, "o", "import toml\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.058402, "o", "from blot import make_background, find_bodies\r\n\u001b[?2004l\r"]
[93.058473, "o", "\u001b[?2004h> "]
[93.058592, "o", "from tether import CentroidCounter, fold_gate\r\n\u001b[?2004l\r"]
[93.058649, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[93.059956, "o", "> SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def emit_span(src: str) -> int:\r\n\u001b[?2004l\r\u001b[?2004h>     cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r\u001b[?2004h>     if not cap.isOpened():\r\n\u001b[?2004l\r\u001b[?2004h>         cap.release()\r\n\u001b[?2004l\r\u001b[?2004h>         raise OSError('cannot open clip')\r\n\u001b[?2004l\r\u001b[?2004h>     frames = []\r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\n\u001b[?2004l\r\u001b[?2004h>         ok, frame = cap.read()\r\n\u001b[?2004l\r\u001b[?2004h>         if not ok:\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>         if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r\u001b[?2004h>             cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.060055, "o", "            raise ValueError('invalid frame geometry')\r\n\u001b[?2004l\r"]
[93.06015, "o", "\u001b[?2004h> "]
[93.06027, "o", "        frames.append(frame)\r\n\u001b[?2004l\r\u001b[?2004h>     cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.060306, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.060447, "o", "> "]
[93.060525, "o", "        raise OSError('clip contains no decodable frames')\r\n\u001b[?2004l\r"]
[93.060589, "o", "\u001b[?2004h> "]
[93.060675, "o", "    background = make_background(frames)\r\n\u001b[?2004l\r"]
[93.060734, "o", "\u001b[?2004h> "]
[93.060802, "o", "    counter = CentroidCounter()\r\n\u001b[?2004l\r"]
[93.060873, "o", "\u001b[?2004h> "]
[93.060963, "o", "    for frame in frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.06107, "o", "        counter.add(find_bodies(frame, background))\r\n\u001b[?2004l\r"]
[93.061142, "o", "\u001b[?2004h> "]
[93.06119, "o", "    return fold_gate(counter)\r\n\u001b[?2004l\r"]
[93.061246, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[93.061322, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.061387, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r"]
[93.061451, "o", "\u001b[?2004h> "]
[93.061544, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[93.061602, "o", "\u001b[?2004h> "]
[93.061705, "o", "    temporary = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r"]
[93.061755, "o", "\u001b[?2004h> "]
[93.061932, "o", "    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r"]
[93.062263, "o", "\u001b[?2004h> "]
[93.06235, "o", "    temporary.replace(SHEET)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[93.063502, "o", "\u001b[?2004hroot@d8e940a79be8:/app# "]
[93.063617, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[93.063641, "o", "\u001b[?2004h> "]
[93.063758, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.063828, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[93.063852, "o", "\u001b[?2004h"]
[93.063939, "o", "> \r\n\u001b[?2004l\r"]
[93.06396, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[93.063975, "o", "\u001b[?2004h"]
[93.063988, "o", "> "]
[93.064119, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.064188, "o", "\r\n\u001b[?2004l\r"]
[93.064263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main() -> int:\r\n\u001b[?2004l\r"]
[93.06432, "o", "\u001b[?2004h> "]
[93.06446, "o", "    # Never leave a previous run's answer behind after any failure.\r\n\u001b[?2004l\r"]
[93.06452, "o", "\u001b[?2004h> "]
[93.064578, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.064659, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[93.064714, "o", "\u001b[?2004h> "]
[93.064765, "o", "    except OSError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.064879, "o", ">         return 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.064942, "o", "    if len(sys.argv) != 2:\r\n\u001b[?2004l\r"]
[93.064958, "o", "\u001b[?2004h> "]
[93.065008, "o", "        return 2\r\n\u001b[?2004l\r"]
[93.065125, "o", "\u001b[?2004h> "]
[93.065152, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.065206, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[93.065243, "o", "\u001b[?2004h> "]
[93.065372, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.065436, "o", "    except Exception as exc:\r\n\u001b[?2004l\r"]
[93.065465, "o", "\u001b[?2004h> "]
[93.065585, "o", "        print('mill: ' + str(exc), file=sys.stderr)\r\n\u001b[?2004l\r"]
[93.065763, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.065798, "o", "> "]
[93.065996, "o", "            SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[93.066171, "o", "\u001b[?2004h> "]
[93.066326, "o", "        except OSError:\r\n\u001b[?2004l\r\u001b[?2004h>             pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.06639, "o", "> "]
[93.066444, "o", "        return 1\r\n\u001b[?2004l\r"]
[93.067539, "o", "\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit(main())\r\n\u001b[?2004l\r"]
[93.067586, "o", "\u001b[?2004h"]
[93.067613, "o", "> PY\r\n\u001b[?2004l\r"]
[93.070418, "o", "\u001b[?2004hroot@d8e940a79be8:/app# "]
[93.070728, "o", "bash /app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[93.146779, "o", "\u001b[?2004hroot@d8e940a79be8:/app# "]
[93.146978, "o", "rm -rf /app/inkwell\r\n\u001b[?2004l\r"]
[93.152987, "o", "\u001b[?2004hroot@d8e940a79be8:/app# "]
[93.153328, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[93.593359, "o", "sample_rc=0\r\n"]
[93.594264, "o", "crossings = 3\r\n"]
[93.594517, "o", "\u001b[?2004hroot@d8e940a79be8:/app# "]
[93.59466, "o", "rm -f /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[93.595755, "o", "\u001b[?2004hroot@d8e940a79be8:/app# "]
[93.596148, "o", "python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo \"bad_rc=$rc\"; test ! -e /app/inkwell/sheet.toml && echo 'bad_sheet_absent=yes'\r\n\u001b[?2004l\r"]
[93.84548, "o", "mill: cannot open clip\r\n"]
[93.87668, "o", "bad_rc=1\r\nbad_sheet_absent=yes\r\n"]
[93.87675, "o", "\u001b[?2004hroot@d8e940a79be8:/app# "]
[138.147064, "i", "python3 - <<'PY'\np='/app/blot.py'\ns=open(p).read()\ns=s.replace('return np.median(np.stack(frames, axis=0), axis=0).astype(np.uint8)', \"# Clips begin with the empty yard; using the opening avoids absorbing a\\n    # body which deliberately lingers for most of the recording.\\n    opening = frames[:min(2, len(frames))]\\n    return np.median(np.stack(opening, axis=0), axis=0).astype(np.uint8)\")\nopen(p,'w').write(s)\nPY\nbash /app/kiln/bake.sh\nmkdir -p /tmp/milltests\npython3 - <<'PY'\nimport cv2, numpy as np, os\nW,H=160,120\n\ndef write(name, paths):\n    n=max(len(p) for p in paths)\n    out=cv2.VideoWriter('/tmp/milltests/'+name,cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\n    for i in range(n):\n        f=np.full((H,W,3),(35,30,25),np.uint8)\n        for j,p in enumerate(paths):\n            q=p[i] if i<len(p) else None\n            if q is not None:\n                cv2.circle(f,(q[0],q[1]),8,[(40,190,220),(210,80,70),(70,210,100)][j%3],-1)\n        out.write(f)\n    out.release()\n# First frame is empty in each case.\n# One object pauses with centroid exactly 70 for much more than half the clip.\nwrite('linger.mp4', [[None]+[(40,y) for y in range(20,70,5)]+[(40,70)]*35+[(40,y) for y in range(75,111,5)]])\n# Same object crosses down, travels back up, and crosses down again: count once.\np=[None]+[(70,y) for y in range(25,101,5)]+[(70,y) for y in range(100,39,-5)]+[(70,y) for y in range(40,101,5)]\nwrite('return.mp4',[p])\n# One only moves upward through line; another approaches from above but stops at 65.\na=[None]+[(35,y) for y in range(100,39,-5)]+[None]*10\nb=[None]+[(115,y) for y in range(20,66,5)]+[(115,65)]*15\nwrite('nocross.mp4',[a,b])\nPY\nfor spec in 'linger.mp4 1' 'return.mp4 1' 'nocross.mp4 0'; do set -- $spec; python3 /app/varnish/mill.pyc /tmp/milltests/$1; got=$(sed -n 's/crossings = //p' /app/inkwell/sheet.toml); echo \"$1 expected=$2 got=$got\"; test \"$got\" = \"$2\" || exit 1; done\npython3 /app/varnish/mill.pyc /app/shown.mp4 && echo '--- final sheet ---' && cat /app/inkwell/sheet.toml\n"]
[138.148151, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/blot.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.148403, "o", "s=s.replace('return np.median(np.stack(frames, axis=0), axis=0).astype(np.uint8)', \"# Clips begin with the empty yard; using the opening avoids absorbing a\\n    # body which deliberately lingers for most of the recording.\\n    opening = frames[:min(2, len(frames))]\\n    return np.median(np.stack(opening, axis=0), axis=0).astype(np.uint8)\")\r\n"]
[138.148607, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[138.148922, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n"]
