[138.248363, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import cv2, numpy as np, os\r\n\u001b[?2004l\r\u001b[?2004h> W,H=160,120\r\n\u001b[?2004l\r"]
