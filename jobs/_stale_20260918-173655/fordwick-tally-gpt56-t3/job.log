"points"]\n    p = pts[-1][1]\n    if len(pts) < 2:\n        return p\n    f0, p0 = pts[-2]\n    f1, p1 = pts[-1]\n    velocity = (p1 - p0) / max(1, f1 - f0)\n    # Avoid wild extrapolation after a long disappearance.\n    return p + velocity * min(frame_no - f1, 3)\n\n\ndef count_tracks(detections_by_frame, line_y: float = LINE_Y) -> int:\n    tracks = []\n    next_id = 0\n    total = 0\n\n    for frame_no, detections in enumerate(detections_by_frame):\n        pairs = []\n        for ti, track in enumerate(tracks):\n            gap = frame_no - track["last"]\n            colour_distance = float(np.linalg.norm(track["colour"] - detections[0]["colour"])) if detections else 0.0\n            for di, det in enumerate(detections):\n                colour_distance = float(np.linalg.norm(track["colour"] - det["colour"]))\n                spatial = float(np.linalg.norm(_prediction(track, frame_no) - det["xy"]))\n                area_ratio = max(track["area"], det["area"]) / max(1.0, min(track["area"], det["area"]))\n                # Normal frame-to-frame association; after disappearance, only a\n                # very similar appearance may revive an old identity.\n                if gap <= 4 and spatial <= 12.0 + 6.0 * gap and colour_distance <= 75.0:\n                    cost = spatial + 0.18 * colour_distance + 2.0 * max(0.0, area_ratio - 1.0)\n                    pairs.append((cost, ti, di))\n                elif gap > 4 and colour_distance <= 10.0 and area_ratio <= 1.8:\n                    pairs.append((50.0 + 0.4 * colour_distance, ti, di))\n\n        used_t, used_d = set(), set()\n        for _, ti, di in sorted(pairs):\n            if ti in used_t or di in used_d:\n                continue\n            used_t.add(ti); used_d.add(di)\n            track, det = tracks[ti], detections[di]\n            old_y = float(track["points"][-1][1][1])\n            new_y = float(det["xy"][1])\n            track["points"].append((frame_no, det["xy"].copy()))\n            track["