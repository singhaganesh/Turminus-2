[9.204092, "o", "Station geometry\r\n================\r\n\r\nFrame size: 160 x 120\r\nRate: 12 fps\r\nHorizontal scan row: y = 70 (top of frame is y = 0)\r\n\r\nDrive:\r\n\r\n    python3 /app/varnish/mill.pyc CLIP\r\n\r\nCLIP is an mp4 path. Success writes /app/inkwell/sheet.toml:\r\n\r\n    crossings = <integer>\r\n\r\nWorked sample: /app/shown.mp4 -> crossings = 3\r\n\r\nUnreadable CLIP: non-zero exit, do not write /app/inkwell/sheet.toml.\r\nExample unreadable path:\r\n\r\n    python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4\r\n\r\nFold blot, tether, spout, and the spanwell driver using the kiln notes.\r\n"]
[9.204451, "o", "\r\n--- KILN ---\r\n"]
[9.205494, "o", "Kiln card\r\n=========\r\n\r\nThe station mill is the folded snapshot named in /app/slipfold/SPAN.txt.\r\nIt is built from blot, tether, spout, and the spanwell driver under /app.\r\n\r\nThis directory holds the fold tools. Run the executable script here after\r\nediting those modules. Live pipeline files are not what the station executes.\r\n"]
[9.205712, "o", "\r\n--- FILES ---\r\n"]
[9.209395, "o", "/app/blot.py\r\n/app/hopcard/millcard.txt\r\n/app/kiln/KILN.txt\r\n/app/kiln/bake.sh\r\n/app/kiln/pack.py\r\n/app/shown.mp4\r\n/app/slipfold/SPAN.txt\r\n/app/spanwell.py\r\n/app/spout.py\r\n/app/tether.py\r\n/app/varnish/mill.pyc\r\n/app/varnish/packed.py\r\n/app/wickpit/__init__.py\r\n/app/wickpit/shiftlog.txt\r\n"]
[9.209571, "o", "/app/wickpit/touchcue.py\r\n"]
[9.21003, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[17.157804, "i", "for f in /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py /app/kiln/bake.sh /app/kiln/pack.py /app/hopcard/millcard.txt /app/wickpit/shiftlog.txt /app/wickpit/touchcue.py /app/varnish/packed.py; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[17.158867, "o", "for f in /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py /app/kiln/bake.sh /app/kiln/pack.py /app/hopcard/millcard.txt /app/wickpit/shiftlog.txt /app/wickpit/touchcue.py /app/varnish/packed.py; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[17.159013, "o", "===== /app/blot.py =====\r\n"]
[17.164234, "o", "from __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\ndef make_mog():\r\n    return cv2.createBackgroundSubtractorMOG2(\r\n        history=30, varThreshold=16, detectShadows=True\r\n    )\r\n\r\n\r\ndef blot_mark(frame, mog) -> bool:\r\n    fg = mog.apply(frame)\r\n    _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n    y = int(LINE_Y)\r\n    band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n    return bool(band.any())\r\n"]
[17.164923, "o", "===== /app/tether.py =====\r\n"]
[17.166321, "o", "from __future__ import annotations\r\n\r\n\r\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n    if now:\r\n        n += 1\r\n    return n, now\r\n\r\n\r\ndef fold_gate(n: int) -> int:\r\n    return n\r\n"]
[17.166744, "o", "===== /app/spout.py =====\r\n"]
[17.168213, "o", "from __future__ import annotations\r\n\r\nimport cv2\r\nimport toml\r\nfrom pathlib import Path\r\n\r\nfrom blot import blot_mark, make_mog\r\nfrom tether import fold_gate, knit_marks\r\n\r\nSHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\r\n\r\ndef emit_span(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = make_mog()\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n"]
[17.16844, "o", "        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        now = blot_mark(frame, mog)\r\n        n, prev = knit_marks(now, prev, n)\r\n    cap.release()\r\n    return fold_gate(n)\r\n\r\n\r\ndef dump_sheet(n: int) -> None:\r\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n"]
[17.168589, "o", "===== /app/spanwell.py =====\r\n"]
[17.16994, "o", "#!/usr/bin/env python3\r\nfrom __future__ import annotations\r\n\r\nimport sys\r\n\r\nfrom spout import dump_sheet, emit_span\r\n\r\n\r\ndef main() -> int:\r\n    if len(sys.argv) != 2:\r\n        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[17.170173, "o", "===== /app/kiln/bake.sh =====\r\n"]
[17.171404, "o", "#!/usr/bin/env bash\r\nset -euo pipefail\r\npython3 /app/kiln/pack.py\r\n"]
[17.171623, "o", "===== /app/kiln/pack.py =====\r\n"]
[17.172936, "o", "#!/usr/bin/env python3\r\n\"\"\"Fold blot/tether/spout/spanwell into /app/varnish/mill.pyc.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport py_compile\r\nfrom pathlib import Path\r\n\r\nROOT = Path(\"/app\")\r\nPARTS = [\r\n    ROOT / \"blot.py\",\r\n    ROOT / \"tether.py\",\r\n    ROOT / \"spout.py\",\r\n    ROOT / \"spanwell.py\",\r\n]\r\nSKIP_PREFIXES = (\r\n    \"from blot \",\r\n    \"import blot\",\r\n"]
[17.173117, "o", "    \"from tether \",\r\n    \"import tether\",\r\n    \"from spout \",\r\n    \"import spout\",\r\n)\r\n\r\n\r\ndef _strip(text: str) -> tuple[list[str], list[str]]:\r\n    futures: list[str] = []\r\n    keep: list[str] = []\r\n    for line in text.splitlines():\r\n        stripped = line.strip()\r\n        if any(stripped.startswith(p) for p in SKIP_PREFIXES):\r\n            continue\r\n        if stripped.startswith(\"from __future__ import\"):\r\n            if stripped not in futures:\r\n                futures.append(stripped)\r\n            continue\r\n        keep.append(line)\r\n    return futures, keep\r\n\r\n\r\ndef main() -> None:\r\n    out_dir = ROOT / \"varnish\"\r\n    out_dir.mkdir(parents=True, exist_ok=True)\r\n    packed = out_dir / \"packed.py\"\r\n    all_future: list[str] = []\r\n    bodies: list[str] = []\r\n    for p in PARTS:\r\n        futures, keep = _strip(p.read_text(encoding=\"utf-8\"))\r\n        for item in futures:\r\n            if item not in all_future:\r\n                all_future.append(item)\r\n        bodies.append(\"\\n\".join(keep))\r\n    packed.write_text(\"\\n\".join(all_future) + \"\\n\\n\" + \"\\n\\n\".join(bodies) + \"\\n\", encoding=\"utf-8\")\r\n    py_compile.compile(str(packed), cfile=str(out_dir / \"mill.pyc\"), doraise=True)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[17.173441, "o", "===== /app/hopcard/millcard.txt =====\r\n"]
[17.17476, "o", "Desk leftover. Sample reel lives at /app/shown.mp4.\r\n"]
[17.174961, "o", "===== /app/wickpit/shiftlog.txt =====\r\n"]
[17.176007, "o", "Night desk: occupancy helper still green on the worked sample.\r\nDo not treat that as the whole mill.\r\n"]
[17.176202, "o", "===== /app/wickpit/touchcue.py =====\r\n"]
[17.177244, "o", "#!/usr/bin/env python3\r\n\"\"\"Desk helper: rising occupancy on the scan row.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n"]
[17.177429, "o", "\r\ndef occupancy_edges(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = cv2.createBackgroundSubtractorMOG2(history=30, varThreshold=16, detectShadows=True)\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        fg = mog.apply(frame)\r\n        _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n        y = int(LINE_Y)\r\n        band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n        now = bool(band.any())\r\n        if now and not prev:\r\n"]
[17.177515, "o", "            n += 1\r\n        prev = now\r\n    cap.release()\r\n    return n\r\n"]
[17.177593, "o", "===== /app/varnish/packed.py =====\r\n"]
[17.178667, "o", "from __future__ import annotations\r\n\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\ndef make_mog():\r\n    return cv2.createBackgroundSubtractorMOG2(\r\n        history=30, varThreshold=16, detectShadows=True\r\n    )\r\n"]
[17.178748, "o", "\r\n\r\ndef blot_mark(frame, mog) -> bool:\r\n    fg = mog.apply(frame)\r\n    _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n    y = int(LINE_Y)\r\n    band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n    return bool(band.any())\r\n\r\n\r\n\r\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n    if now:\r\n        n += 1\r\n    return n, now\r\n\r\n\r\ndef fold_gate(n: int) -> int:\r\n    return n\r\n\r\n\r\nimport cv2\r\nimport toml\r\nfrom pathlib import Path\r\n\r\n\r\nSHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\r\n\r\ndef emit_span(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = make_mog()\r\n"]
[17.17886, "o", "    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        now = blot_mark(frame, mog)\r\n        n, prev = knit_marks(now, prev, n)\r\n    cap.release()\r\n    return fold_gate(n)\r\n\r\n\r\ndef dump_sheet(n: int) -> None:\r\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n\r\n#!/usr/bin/env python3\r\n\r\nimport sys\r\n\r\n\r\n\r\ndef main() -> int:\r\n    if len(sys.argv) != 2:\r\n        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
