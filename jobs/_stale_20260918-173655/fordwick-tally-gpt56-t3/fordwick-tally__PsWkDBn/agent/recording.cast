[98.833358, "o", "\u001b[?2004h> "]
[98.83344, "o", "                track[\"armed\"] = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.833464, "o", "> "]
[98.83371, "o", "            track[\"down_evidence\"] = max(0.0, track[\"down_evidence\"] + new_y - old_y)\r\n\u001b[?2004l\r"]
[98.833839, "o", "\u001b[?2004h> "]
[98.834337, "o", "            if (track[\"armed\"] and not track[\"counted\"] and\r\n\u001b[?2004l\r\u001b[?2004h>                     old_y < line_y and new_y >= line_y and\r\n\u001b[?2004l\r\u001b[?2004h>                     track[\"down_evidence\"] >= 3.0):\r\n\u001b[?2004l\r"]
[98.834666, "o", "\u001b[?2004h>                 track[\"counted\"] = True\r\n\u001b[?2004l\r"]
[98.835422, "o", "\u001b[?2004h>                 total += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         for di, det in enumerate(detections):\r\n\u001b[?2004l\r\u001b[?2004h>             if di not in used_d:\r\n\u001b[?2004l\r\u001b[?2004h>                 tracks.append(_new_track(det, frame_no, next_id))\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.83555, "o", "> "]
[98.835571, "o", "                next_id += 1\r\n\u001b[?2004l\r"]
[98.835717, "o", "\u001b[?2004h> \r\n"]
[98.835818, "o", "\u001b[?2004l\r\u001b[?2004h>     return total\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.835931, "o", "\u001b[?2004h> "]
[98.836017, "o", "def fold_gate(n: int) -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.836091, "o", "    return int(n)\r\n\u001b[?2004l\r"]
[98.83617, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[98.838106, "o", "\u001b[?2004hroot@1f77724e90d5:/app# \r\n\u001b[?2004l\r"]
[98.838248, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[98.838322, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[98.838423, "o", "\u001b[?2004h> "]
[98.838481, "o", "from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.83855, "o", "> \r\n\u001b[?2004l\r"]
[98.838601, "o", "\u001b[?2004h> "]
[98.838654, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.838708, "o", "> "]
[98.838762, "o", "import cv2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.838817, "o", "import toml\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.838869, "o", "\u001b[?2004h> "]
[98.838973, "o", "from blot import blot_marks, estimate_background\r\n\u001b[?2004l\r"]
[98.839028, "o", "\u001b[?2004h> "]
[98.839122, "o", "from tether import count_tracks, fold_gate\r\n\u001b[?2004l\r"]
[98.839178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.83923, "o", "> "]
[98.839303, "o", "SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r"]
[98.839367, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.839438, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.839527, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r"]
[98.839583, "o", "\u001b[?2004h"]
[98.839677, "o", "> "]
[98.839746, "o", "    cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.839812, "o", "> "]
[98.83989, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r"]
[98.839987, "o", "\u001b[?2004h>         cap.release()\r\n"]
[98.840047, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[98.840169, "o", "        raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[98.840253, "o", "\u001b[?2004h> "]
[98.840356, "o", "    frames = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.840422, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.840516, "o", "        ok, frame = cap.read()\r\n\u001b[?2004l\r"]
[98.840575, "o", "\u001b[?2004h> "]
[98.84065, "o", "        if not ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.84071, "o", "            break\r\n\u001b[?2004l\r"]
[98.840767, "o", "\u001b[?2004h> "]
[98.840894, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r"]
[98.84095, "o", "\u001b[?2004h"]
[98.841007, "o", ">             cap.release()\r\n\u001b[?2004l\r"]
[98.841072, "o", "\u001b[?2004h> "]
[98.841173, "o", "            raise ValueError('invalid frame')\r\n\u001b[?2004l\r"]
[98.84123, "o", "\u001b[?2004h"]
[98.841291, "o", ">         frames.append(frame)\r\n\u001b[?2004l\r"]
[98.841364, "o", "\u001b[?2004h> "]
[98.841461, "o", "    cap.release()\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.841539, "o", "> "]
[98.841599, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.84173, "o", "        raise OSError('clip contains no decodable frames')\r\n\u001b[?2004l\r"]
[98.841784, "o", "\u001b[?2004h"]
[98.841834, "o", "> "]
[98.841891, "o", "    background = estimate_background(frames)\r\n\u001b[?2004l\r"]
[98.841952, "o", "\u001b[?2004h> "]
[98.842092, "o", "    detections = [blot_marks(frame, background) for frame in frames]\r\n\u001b[?2004l\r"]
[98.842164, "o", "\u001b[?2004h> "]
[98.842262, "o", "    return fold_gate(count_tracks(detections))\r\n\u001b[?2004l\r"]
[98.842325, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.84239, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.842474, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r"]
[98.842528, "o", "\u001b[?2004h"]
[98.842583, "o", "> "]
[98.84266, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[98.842714, "o", "\u001b[?2004h"]
[98.842766, "o", "> "]
[98.842816, "o", "    temporary = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r"]
[98.84287, "o", "\u001b[?2004h> "]
[98.843042, "o", "    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r"]
[98.843094, "o", "\u001b[?2004h"]
[98.843144, "o", "> "]
[98.843204, "o", "    temporary.replace(SHEET)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.843261, "o", "PY\r\n\u001b[?2004l\r"]
[98.844452, "o", "\u001b[?2004hroot@1f77724e90d5:/app# \r\n\u001b[?2004l\r"]
[98.844542, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[98.844595, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[98.84465, "o", "\u001b[?2004h> "]
[98.844711, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[98.844765, "o", "\u001b[?2004h> "]
[98.844839, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[98.844894, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.844951, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[98.845005, "o", "\u001b[?2004h> "]
[98.845105, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[98.84516, "o", "\u001b[?2004h"]
[98.845213, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[98.845258, "o", "\u001b[?2004h> "]
[98.845305, "o", "def main() -> int:\r\n\u001b[?2004l\r"]
[98.845409, "o", "\u001b[?2004h> "]
[98.845462, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.845529, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[98.845584, "o", "\u001b[?2004h"]
[98.845635, "o", "> "]
[98.845691, "o", "        if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[98.845758, "o", "            return 2\r\n\u001b[?2004l\r"]
[98.845815, "o", "\u001b[?2004h"]
[98.845864, "o", "> "]
[98.845918, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[98.845971, "o", "\u001b[?2004h> "]
[98.846019, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r"]
[98.846074, "o", "\u001b[?2004h> "]
[98.846129, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.846179, "o", "> "]
[98.846227, "o", "    except Exception as exc:\r\n\u001b[?2004l\r"]
[98.846293, "o", "\u001b[?2004h> "]
[98.846388, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[98.846447, "o", "\u001b[?2004h"]
[98.846499, "o", "> "]
[98.846563, "o", "        print(f'mill: {exc}', file=sys.stderr)\r\n\u001b[?2004l\r"]
[98.846622, "o", "\u001b[?2004h"]
[98.846683, "o", ">         return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.846738, "o", "> \r\n\u001b[?2004l\r"]
[98.846788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[98.846832, "o", "> "]
[98.846883, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.846941, "o", "> "]
[98.847019, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[98.848779, "o", "\u001b[?2004hroot@1f77724e90d5:/app# \r\n\u001b[?2004l\r"]
[98.84939, "o", "\u001b[?2004hroot@1f77724e90d5:/app# bash /app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[98.906837, "o", "\u001b[?2004hroot@1f77724e90d5:/app# rm -f /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[98.908057, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[98.908301, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; echo sample_status=$?; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[99.334402, "o", "sample_status=0\r\n"]
[99.335647, "o", "crossings = 3\r\n"]
[99.335912, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[99.336016, "o", "rm -f /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[99.337361, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[99.337645, "o", "python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo bad_status=$?; test ! -e /app/inkwell/sheet.toml; echo sheet_absent=$?\r\n\u001b[?2004l\r"]
[99.708039, "o", "mill: cannot open clip\r\n"]
[99.738182, "o", "bad_status=1\r\nsheet_absent=0\r\n"]
[99.738358, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[138.469181, "i", "python3 - <<'PY'\np='/app/tether.py'\ns=open(p).read()\ns=s.replace('\"armed\": y <= LINE_Y - 2.0,', '\"armed\": y < LINE_Y,')\ns=s.replace('if new_y <= line_y - 2.0:\\n                track[\"armed\"] = True', 'if new_y < line_y:\\n                track[\"armed\"] = True')\ns=s.replace('old_y < line_y and new_y >= line_y and\\n                    track[\"down_evidence\"] >= 3.0', 'new_y > line_y and\\n                    track[\"down_evidence\"] >= 3.0')\nopen(p,'w').write(s)\nPY\nbash /app/kiln/bake.sh\nmkdir -p /tmp/milltests\npython3 - <<'PY'\nimport cv2, numpy as np, os\nW,H=160,120\nbg=np.full((H,W,3),(52,45,42),np.uint8)\nfourcc=cv2.VideoWriter_fourcc(*'mp4v')\n\ndef make(name, paths):\n n=max(len(p) for _,p in paths)\n out=cv2.VideoWriter('/tmp/milltests/'+name+'.mp4',fourcc,12,(W,H))\n for i in range(n):\n  f=bg.copy()\n  for color,path in paths:\n   pos=path[i] if i<len(path) else None\n   if pos is not None:\n    x,y=pos\n    cv2.circle(f,(int(x),int(y)),9,color,-1)\n  out.write(f)\n out.release()\n\n# One downward body that remains centered exactly on the line for many frames.\nys=list(range(20,71,5))+[70]*15+list(range(75,111,5))\nmake('linger',[((20,20,210),[(45,y) for y in ys])])\n# Upward passage does not count.\nmake('upward',[((20,210,20),[(70,y) for y in range(105,14,-5)])])\n# Comes from above but retreats before passing.\nmake('retreat',[((210,20,20),[(90,y) for y in list(range(20,70,5))+list(range(65,14,-5))])])\n# Same visible body crosses, disappears, returns upward, and crosses again: once.\np=[(40,y) for y in range(20,111,6)]+[None]*8+[(40,y) for y in range(105,14,-6)]+[(40,y) for y in range(20,111,6)]\nmake('return',[((20,20,210),p)])\n# Four differently colored bodies moving down concurrently.\ncols=[(20,20,210),(20,210,20),(210,20,20),(20,210,210)]\nmake('multi',[(c,[(25+35*j,y) for y in range(15+j*2,111+j*2,5)]) for j,c in enumerate(cols)])\nPY\nfor spec in linger:1 upward:0 retreat:0 return:1 multi:4; do name=${spec%:*}; want=${spec#*:}; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/milltests/$name.mp4; got=$(sed -n 's/crossings = //p' /app/inkwell/sheet.toml); echo \"$name expected=$want got=$got\"; test \"$got\" = \"$want\" || exit 1; done\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /app/shown.mp4; echo -n 'sample '; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/absent-video.mp4; status=$?; echo \"invalid_status=$status sheet_exists=$(test -e /app/inkwell/sheet.toml && echo yes || echo no)\"; test $status -ne 0 && test ! -e /app/inkwell/sheet.toml\n"]
[138.469475, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[138.46966, "o", "\u001b[?2004h> p='/app/tether.py'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.469741, "o", "s=open(p).read()\r\n\u001b[?2004l\r"]
[138.469773, "o", "\u001b[?2004h> "]
[138.473515, "o", "s=s.replace('\"armed\": y <= LINE_Y - 2.0,', '\"armed\": y < LINE_Y,')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('if new_y <= line_y - 2.0:\\n                track[\"armed\"] = True', 'if new_y < line_y:\\n                track[\"armed\"] = True')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('old_y < line_y and new_y >= line_y and\\n                    track[\"down_evidence\"] >= 3.0', 'new_y > line_y and\\n                    track[\"down_evidence\"] >= 3.0')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
