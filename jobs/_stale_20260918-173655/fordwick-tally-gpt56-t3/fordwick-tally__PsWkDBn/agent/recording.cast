[98.812029, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef estimate_background(frames: list[np.ndarray]) -> np.ndarray:\n    \"\"\"Estimate the stationary scene while rejecting transient moving bodies.\"\"\"\n    stack = np.asarray(frames, dtype=np.uint8)\n    return np.median(stack, axis=0).astype(np.uint8)\n\n\ndef blot_marks(frame: np.ndarray, background: np.ndarray):\n    \"\"\"Return (centroid, median BGR, area, box) for foreground bodies.\"\"\"\n    delta = cv2.absdiff(frame, background)\n    strength = np.max(delta, axis=2)\n    mask = (strength >= 14).astype(np.uint8) * 255\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n    count, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\n    answer = []\n    for label in range(1, count):\n        x, y, w, h, area = map(int, stats[label])\n        # Permit partially visible bodies at an image edge, but reject codec dust.\n        if area < 18 or w < 3 or h < 3:\n            continue\n        pixels = frame[labels == label]\n        colour = np.median(pixels, axis=0).astype(float)\n        answer.append({\n            \"xy\": np.asarray(centers[label], dtype=float),\n            \"colour\": colour,\n            \"area\": area,\n            \"box\": (x, y, w, h),\n        })\n    return answer\nPY\n\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport numpy as np\n\nLINE_Y = 70.0\n\n\ndef _new_track(det, frame_no: int, number: int):\n    y = float(det[\"xy\"][1])\n    return {\n        \"id\": number,\n        \"points\": [(frame_no, det[\"xy\"].copy())],\n        \"colour\": det[\"colour\"].copy(),\n        \"area\": float(det[\"area\"]),\n        \"last\": frame_no,\n        \"armed\": y <= LINE_Y - 2.0,\n        \"counted\": False,\n        \"down_evidence\": 0.0,\n    }\n\n\ndef _prediction(track, frame_no: int):\n    pts = track[\"points\"]\n    p = pts[-1][1]\n    if len(pts) < 2:\n        return p\n    f0, p0 = pts[-2]\n    f1, p1 = pts[-1]\n    velocity = (p1 - p0) / max(1, f1 - f0)\n    # Avoid wild extrapolation after a long disappearance.\n    return p + velocity * min(frame_no - f1, 3)\n\n\ndef count_tracks(detections_by_frame, line_y: float = LINE_Y) -> int:\n    tracks = []\n    next_id = 0\n    total = 0\n\n    for frame_no, detections in enumerate(detections_by_frame):\n        pairs = []\n        for ti, track in enumerate(tracks):\n            gap = frame_no - track[\"last\"]\n            colour_distance = float(np.linalg.norm(track[\"colour\"] - detections[0][\"colour\"])) if detections else 0.0\n            for di, det in enumerate(detections):\n                colour_distance = float(np.linalg.norm(track[\"colour\"] - det[\"colour\"]))\n                spatial = float(np.linalg.norm(_prediction(track, frame_no) - det[\"xy\"]))\n                area_ratio = max(track[\"area\"], det[\"area\"]) / max(1.0, min(track[\"area\"], det[\"area\"]))\n                # Normal frame-to-frame association; after disappearance, only a\n                # very similar appearance may revive an old identity.\n                if gap <= 4 and spatial <= 12.0 + 6.0 * gap and colour_distance <= 75.0:\n                    cost = spatial + 0.18 * colour_distance + 2.0 * max(0.0, area_ratio - 1.0)\n                    pairs.append((cost, ti, di))\n                elif gap > 4 and colour_distance <= 10.0 and area_ratio <= 1.8:\n                    pairs.append((50.0 + 0.4 * colour_distance, ti, di))\n\n        used_t, used_d = set(), set()\n        for _, ti, di in sorted(pairs):\n            if ti in used_t or di in used_d:\n                continue\n            used_t.add(ti); used_d.add(di)\n            track, det = tracks[ti], detections[di]\n            old_y = float(track[\"points\"][-1][1][1])\n            new_y = float(det[\"xy\"][1])\n            track[\"points\"].append((frame_no, det[\"xy\"].copy()))\n            track[\"points\"] = track[\"points\"][-6:]\n            track[\"last\"] = frame_no\n            track[\"colour\"] = 0.8 * track[\"colour\"] + 0.2 * det[\"colour\"]\n            track[\"area\"] = 0.8 * track[\"area\"] + 0.2 * det[\"area\"]\n         "]
[98.81223, "i", "   if new_y <= line_y - 2.0:\n                track[\"armed\"] = True\n            track[\"down_evidence\"] = max(0.0, track[\"down_evidence\"] + new_y - old_y)\n            if (track[\"armed\"] and not track[\"counted\"] and\n                    old_y < line_y and new_y >= line_y and\n                    track[\"down_evidence\"] >= 3.0):\n                track[\"counted\"] = True\n                total += 1\n\n        for di, det in enumerate(detections):\n            if di not in used_d:\n                tracks.append(_new_track(det, frame_no, next_id))\n                next_id += 1\n\n    return total\n\n\ndef fold_gate(n: int) -> int:\n    return int(n)\nPY\n\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import blot_marks, estimate_background\nfrom tether import count_tracks, fold_gate\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('invalid frame')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('clip contains no decodable frames')\n    background = estimate_background(frames)\n    detections = [blot_marks(frame, background) for frame in frames]\n    return fold_gate(count_tracks(detections))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    temporary = SHEET.with_suffix('.tmp')\n    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    temporary.replace(SHEET)\nPY\n\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    try:\n        SHEET.unlink(missing_ok=True)\n        if len(sys.argv) != 2:\n            return 2\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n        return 0\n    except Exception as exc:\n        SHEET.unlink(missing_ok=True)\n        print(f'mill: {exc}', file=sys.stderr)\n        return 1\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\n\nbash /app/kiln/bake.sh\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /app/shown.mp4; echo sample_status=$?; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo bad_status=$?; test ! -e /app/inkwell/sheet.toml; echo sheet_absent=$?\n"]
