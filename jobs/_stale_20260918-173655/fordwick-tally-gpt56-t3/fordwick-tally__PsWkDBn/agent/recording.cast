[35.28008, "i", "python3 - <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; c=cv2.VideoCapture(p)\nprint('opened',c.isOpened(),'frames',int(c.get(cv2.CAP_PROP_FRAME_COUNT)),'fps',c.get(cv2.CAP_PROP_FPS),'size',int(c.get(cv2.CAP_PROP_FRAME_WIDTH)),int(c.get(cv2.CAP_PROP_FRAME_HEIGHT)))\nframes=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n frames.append(f)\nc.release(); a=np.array(frames)\nprint('decoded',len(a),'duration',len(a)/12,'range',a.min(),a.max())\nfor i in np.linspace(0,len(a)-1,min(12,len(a)),dtype=int):\n f=a[i]; print(i,'mean',np.round(f.mean((0,1)),1),'std',np.round(f.std((0,1)),1),'colors',len(np.unique(f.reshape(-1,3),axis=0)))\n# temporal median difference, component reports\nbg=np.median(a,axis=0).astype(np.uint8)\nprint('bg mean/std',np.round(bg.mean((0,1)),1),np.round(bg.std((0,1)),1))\nfor i,f in enumerate(a):\n d=cv2.absdiff(f,bg); g=d.max(2); m=(g>25).astype(np.uint8)*255\n m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8)); m=cv2.morphologyEx(m,cv2.MORPH_CLOSE,np.ones((5,5),np.uint8))\n n,lab,st,cen=cv2.connectedComponentsWithStats(m)\n comps=[(int(st[j,4]),tuple(np.round(cen[j],1)),tuple(map(int,st[j,:4]))) for j in range(1,n) if st[j,4]>=20]\n if comps and (i%6==0 or any(abs(y-70)<5 for _,(x,y),_ in comps)):\n  print('F',i,comps)\nPY\n"]
