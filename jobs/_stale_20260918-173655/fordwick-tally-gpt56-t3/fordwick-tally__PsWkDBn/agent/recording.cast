[138.564026, "o", "# Upward passage does not count.\r\n\u001b[?2004l\r"]
[138.56407, "o", "\u001b[?2004h> "]
[138.564205, "o", "make('upward',[((20,210,20),[(70,y) for y in range(105,14,-5)])])\r\n\u001b[?2004l\r"]
[138.564266, "o", "\u001b[?2004h> "]
[138.564402, "o", "# Comes from above but retreats before passing.\r\n\u001b[?2004l\r"]
[138.564488, "o", "\u001b[?2004h> "]
[138.564701, "o", "make('retreat',[((210,20,20),[(90,y) for y in list(range(20,70,5))+list(range(65,14,-5))])])\r\n\u001b[?2004l\r"]
[138.564771, "o", "\u001b[?2004h"]
[138.564822, "o", "> "]
[138.564943, "o", "# Same visible body crosses, disappears, returns upward, and crosses again: once.\r\n\u001b[?2004l\r"]
[138.564987, "o", "\u001b[?2004h> "]
[138.565236, "o", "p=[(40,y) for y in range(20,111,6)]+[None]*8+[(40,y) for y in range(105,14,-6)]+[(40,y) for y in range(20,111,6)]\r\n\u001b[?2004l\r"]
[138.565297, "o", "\u001b[?2004h> "]
[138.565387, "o", "make('return',[((20,20,210),p)])\r\n\u001b[?2004l\r"]
[138.565452, "o", "\u001b[?2004h> "]
[138.565564, "o", "# Four differently colored bodies moving down concurrently.\r\n\u001b[?2004l\r"]
[138.565625, "o", "\u001b[?2004h> "]
[138.565744, "o", "cols=[(20,20,210),(20,210,20),(210,20,20),(20,210,210)]\r\n\u001b[?2004l\r"]
[138.56579, "o", "\u001b[?2004h> "]
[138.566008, "o", "make('multi',[(c,[(25+35*j,y) for y in range(15+j*2,111+j*2,5)]) for j,c in enumerate(cols)])\r\n\u001b[?2004l\r"]
[138.566062, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[138.896582, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[138.8972, "o", "for spec in linger:1 upward:0 retreat:0 return:1 multi:4; do name=${spec%:*}; want=${spec#*:}; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/milltests/$name.mp4; got=$(sed -n 's/crossings = //p' /app/inkwell/sheet.toml); echo \"$name expected=$want got=$got\"; test \"$got\" = \"$want\" || exit 1; done\r\n\u001b[?2004l\r"]
[139.403195, "o", "linger expected=1 got=1\r\n"]
[139.783479, "o", "upward expected=0 got=0\r\n"]
[140.152007, "o", "retreat expected=0 got=0\r\n"]
[140.569076, "o", "return expected=1 got=1\r\n"]
[140.948485, "o", "multi expected=4 got=4\r\n"]
[140.948776, "o", "\u001b[?2004h"]
[140.948915, "o", "root@1f77724e90d5:/app# "]
[140.949159, "o", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /app/shown.mp4; echo -n 'sample '; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[141.313608, "o", "sample "]
[141.314421, "o", "crossings = 3\r\n"]
[141.31481, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[141.315752, "o", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/absent-video.mp4; status=$?; echo \"invalid_status=$status sheet_exists=$(test -e /app/inkwell/sheet.toml && echo yes || echo no)\"; test $status -ne 0 && test ! -e /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[141.622781, "o", "mill: cannot open clip\r\n"]
[141.650267, "o", "invalid_status=1 sheet_exists=no\r\n"]
[141.65049, "o", "\u001b[?2004hroot@1f77724e90d5:/app# "]
[172.00128, "i", "python3 -m py_compile /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py && bash /app/kiln/bake.sh && rm -f /app/inkwell/sheet.toml && python3 /app/varnish/mill.pyc /app/shown.mp4 && python3 - <<'PY'\nimport toml\np='/app/inkwell/sheet.toml'\nd=toml.load(p)\nassert type(d.get('crossings')) is int and d['crossings'] == 3, d\nprint(open(p).read(), end='')\nPY\n"]
[172.002204, "o", "python3 -m py_compile /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py && bash /app/kiln/bake.sh && rm -f /app/inkwell/sheet.toml && python3 /app/varnish/mill.pyc /app/shown.mp4 && python3 - <<'PY'\r\n\u001b[?2004l\r"]
[172.002466, "o", "\u001b[?2004h"]
[172.00251, "o", "> "]
[172.00257, "o", "import toml\r\n\u001b[?2004l\r"]
[172.0029, "o", "\u001b[?2004h> p='/app/inkwell/sheet.toml'\r\n\u001b[?2004l\r\u001b[?2004h> d=toml.load(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[172.003097, "o", "assert type(d.get('crossings')) is int and d['crossings'] == 3, d\r\n\u001b[?2004l\r"]
[172.003424, "o", "\u001b[?2004h> print(open(p).read(), end='')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[172.562904, "o", "crossings = 3\r\n"]
