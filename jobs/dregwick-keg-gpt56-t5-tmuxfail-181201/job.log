s.write(Files.readAllBytes(src));\n                jos.closeEntry();\n            }\n        }\n    }\n}\nEOF\ncat > /app/namelock/TallyGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.jar.JarFile;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path roster, Path jar) throws Exception {\n        if (!Files.isRegularFile(jar)) return 1;\n        try (JarFile jf = new JarFile(jar.toFile())) {\n            for (String line : Files.readAllLines(roster)) {\n                String s = line.trim();\n                if (s.isEmpty() || s.startsWith("#")) continue;\n                String[] fields = s.split("\\\\s+");\n                if (fields.length < 2 || jf.getJarEntry(fields[1] + ".class") == null) {\n                    return 1;\n                }\n            }\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(Paths.get("/app/blastcp"),\n            Paths.get("/app/desknote/NAMES.txt"),\n            Paths.get("/app/jarwell/husk.jar")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar)) return 1;\n        long cap = Long.parseLong(Files.readString(capFile).trim());\n        return Files.size(jar) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(Paths.get("/app/jarwell/husk.jar"),\n            Paths.get("/app/desknote/CAP.txt")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo knit_rc=$?; stat -c \'jar_size=%s\' /app/jarwell/husk.jar\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
