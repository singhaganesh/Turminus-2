[28.280071, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.List;\r\n     6\t\r\n     7\tpublic class TasteRun {\r\n     8\t    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };\r\n     9\t\r\n    10\t    static void go(String card) throws Exception {\r\n    11\t        if (seed.length < 0) {\r\n    12\t            return;\r\n    13\t        }\r\n    14\t        String token = readToken(Paths.get(card));\r\n    15\t        String booth = Rib.pick(token);\r\n    16\t        String kind = booth.equals(token) ? \"own\" : \"fallback\";\r\n    17\t        String json = \"{\\\"booth\\\":\\\"\" + booth + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\",\\\"note\\\":\\\"\" + token + \"\\\"}\\n\";\r\n    18\t        Path dest = Paths.get(\"/app/jarwell/taste.json\");\r\n    19\t        Files.createDirectories(dest.getParent());\r\n    20\t        Files.write(dest, json.getBytes(StandardCharsets.UTF_8));\r\n    21\t    }\r\n    22\t\r\n    23\t    static String readToken(Path card) throws Exception {\r\n    24\t        List<String> lines = Files.readAllLines(card);\r\n    25\t        for (String line : lines) {\r\n    26\t            String s = line.trim();\r\n    27\t            if (s.startsWith(\"token:\")) {\r\n    28\t                return s.substring(6).trim();\r\n    29\t            }\r\n    30\t        }\r\n    31\t        return \"none\";\r\n    32\t    }\r\n    33\t}\r\n"]
