[55.165392, "o", "\r\n    14\t    }\r\n    15\t\r\n    16\t    static String pick(String t) {\r\n    17\t        if (tab.containsKey(t)) {\r\n    18\t            return t;\r\n    19\t        }\r\n    20\t        return \"fallback\";\r\n    21\t    }\r\n    22\t\r\n    23\t    static List<String> all() {\r\n    24\t        return new ArrayList<String>(tab.keySet());\r\n    25\t    }\r\n    26\t}\r\n"]
