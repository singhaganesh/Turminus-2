[96.250316, "i", "cat /app/hitchrun/KnitMain.java\n"]
[96.250672, "o", "cat /app/hitchrun/KnitMain.java\r\n\u001b[?2004l\r"]
[96.251888, "o", "import java.nio.file.DirectoryStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.Set;\r\nimport java.util.jar.JarEntry;\r\nimport java.util.jar.JarOutputStream;\r\n\r\npublic class KnitMain {\r\n    public static void main(String[] args) throws Exception {\r\n        Path exploded = Paths.get(\"/app/blastcp\");\r\n        Path jar = Paths.get(\"/app/jarwell/husk.jar\");\r\n        Files.createDirectories(jar.getParent());\r\n        Set<String> live = ReachWalk.weld_set(exploded);\r\n        if (args.length > 0 && \"--all\".equals(args[0])) {\r\n            live.clear();\r\n            try (DirectoryStream<Path> ds = Files.newDirectoryStream(exploded, \"*.class\")) {\r\n                for (Path p : ds) {\r\n                    String n = p.getFileName().toString();\r\n                    live.add(n.substring(0, n.length() - 6));\r\n                }\r\n            }\r\n        }\r\n        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar))) {\r\n            for (String n : live) {\r\n                Path src = exploded.resolve(n + \".class\");\r\n                if (!Files.isRegularFile(src)) {\r\n                    continue;\r\n                }\r\n                jos.putNextEntry(new JarEntry(n + \".class\"));\r\n                jos.write(Files.readAllBytes(src));\r\n                jos.closeEntry();\r\n            }\r\n        }\r\n    }\r\n}\r\n"]
[96.252196, "o", "\u001b[?2004hroot@3fc6e645851d:/app# "]
[104.806089, "i", "cat /app/hitchrun/Main.java; echo '--- RIB ---'; cat /app/hitchrun/Rib.java\n"]
[104.809123, "o", "cat /app/hitchrun/Main.java; echo '--- RIB ---'; cat /app/hitchrun/Rib.java\r\n\u001b[?2004l\r"]
[104.812805, "o", "import java.nio.file.DirectoryStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.Collections;\r\nimport java.util.jar.JarEntry;\r\nimport java.util.jar.JarFile;\r\n\r\npublic class Main {\r\n    public static void main(String[] args) throws Exception {\r\n        if (args.length < 1) {\r\n            System.exit(2);\r\n        }\r\n        String verb = args[0];\r\n        if (\"loom\".equals(verb)) {\r\n            loadExploded();\r\n            TasteRun.go(args[1]);\r\n            return;\r\n        }\r\n        if (\"taste\".equals(verb)) {\r\n            loadJar();\r\n            TasteRun.go(args[1]);\r\n            return;\r\n        }\r\n        if (\"booth\".equals(verb)) {\r\n            loadJar();\r\n            BoothRun.go();\r\n            return;\r\n        }\r\n        System.exit(2);\r\n    }\r\n\r\n    static void loadExploded() throws Exception {\r\n        Path dir = Paths.get(\"/app/blastcp\");\r\n        try (DirectoryStream<Path> ds = Files.newDirectoryStream(dir, \"*Booth.class\")) {\r\n            for (Path p : ds) {\r\n                String n = p.getFileName().toString();\r\n                n = n.substring(0, n.length() - 6);\r\n                Class.forName(n);\r\n            }\r\n        }\r\n    }\r\n\r\n    static void loadJar() throws Exception {\r\n        String cp = System.getProperty(\"java.class.path\");\r\n        Path p = Paths.get(cp.split(java.io.File.pathSeparator)[0]);\r\n        if (!Files.isRegularFile(p)) {\r\n            return;\r\n        }\r\n        try (JarFile jf = new JarFile(p.toFile())) {\r\n            for (JarEntry e : Collections.list(jf.entries())) {\r\n                String n = e.getName();\r\n                if (n.endsWith(\"Booth.class\") && !n.contains(\"/\")) {\r\n                    Class.forName(n.substring(0, n.length() - 6));\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n--- RIB ---\r\n"]
[104.818303, "o", "import java.util.ArrayList;\r\nimport java.util.LinkedHashMap;\r\nimport java.util.List;\r\nimport java.util.Map;\r\n\r\npublic class Rib {\r\n    static final Map<String, String> tab = new LinkedHashMap<String, String>();\r\n    static Class<?> wick() {\r\n        return WickPad.class;\r\n    }\r\n\r\n    static void put(String n) {\r\n        tab.put(n, n);\r\n    }\r\n\r\n    static String pick(String t) {\r\n        if (tab.containsKey(t)) {\r\n            return t;\r\n        }\r\n        return \"fallback\";\r\n    }\r\n\r\n    static List<String> all() {\r\n        return new ArrayList<String>(tab.keySet());\r\n    }\r\n}\r\n\u001b[?2004hroot@3fc6e645851d:/app# "]
[134.008084, "i", "python3 - <<'PY'\np='/app/rootwalk/ReachWalk.java'\ns=open(p).read().replace('cls[i] = b.getShort() & 0xff;', 'cls[i] = b.getShort() & 0xffff;')\nopen(p,'w').write(s)\nPY\ncat > /app/hitchrun/KnitMain.java <<'EOF'\nimport java.nio.file.DirectoryStream;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.Set;\nimport java.util.jar.JarEntry;\nimport java.util.jar.JarOutputStream;\n\npublic class KnitMain {\n    public static void main(String[] args) throws Exception {\n        Path exploded = Paths.get(\"/app/blastcp\");\n        Path jar = Paths.get(\"/app/jarwell/husk.jar\");\n        Files.createDirectories(jar.getParent());\n        Set<String> live = ReachWalk.weld_set(exploded);\n\n        // Booth implementations are discovered by name at runtime, so they do\n        // not occur in the ordinary bytecode reference graph.  Make the\n        // configured roster explicit roots of that graph.\n        for (String line : Files.readAllLines(Paths.get(\"/app/desknote/NAMES.txt\"))) {\n            String s = line.trim();\n            if (s.isEmpty() || s.startsWith(\"#\")) continue;\n            String[] fields = s.split(\"\\\\s+\");\n            if (fields.length >= 2) live.add(fields[1]);\n        }\n\n        if (args.length > 0 && \"--all\".equals(args[0])) {\n            live.clear();\n            try (DirectoryStream<Path> ds = Files.newDirectoryStream(exploded, \"*.class\")) {\n                for (Path p : ds) {\n                    String n = p.getFileName().toString();\n                    live.add(n.substring(0, n.length() - 6));\n                }\n            }\n        }\n        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar))) {\n            for (String n : live) {\n                Path src = exploded.resolve(n + \".class\");\n                if (!Files.isRegularFile(src)) continue;\n                jos.putNextEntry(new JarEntry(n + \".class\"));\n                jos.write(Files.readAllBytes(src));\n                jos.closeEntry();\n            }\n        }\n    }\n}\nEOF\ncat > /app/namelock/TallyGate.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.jar.JarFile;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path roster, Path jar) throws Exception {\n        if (!Files.isRegularFile(jar)) return 1;\n        try (JarFile jf = new JarFile(jar.toFile())) {\n            for (String line : Files.readAllLines(roster)) {\n                String s = line.trim();\n                if (s.isEmpty() || s.startsWith(\"#\")) continue;\n                String[] fields = s.split(\"\\\\s+\");\n                if (fields.length < 2 || jf.getJarEntry(fields[1] + \".class\") == null) {\n                    return 1;\n                }\n            }\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(Paths.get(\"/app/blastcp\"),\n            Paths.get(\"/app/desknote/NAMES.txt\"),\n            Paths.get(\"/app/jarwell/husk.jar\")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar)) return 1;\n        long cap = Long.parseLong(Files.readString(capFile).trim());\n        return Files.size(jar) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(Paths.get(\"/app/jarwell/husk.jar\"),\n            Paths.get(\"/app/desknote/CAP.txt\")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo knit_rc=$?; stat -c 'jar_size=%s' /app/jarwell/husk.jar\n"]
