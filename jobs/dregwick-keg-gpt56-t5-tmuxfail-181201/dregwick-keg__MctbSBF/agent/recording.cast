[54.735145, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.util.ArrayDeque;\r\n     5\timport java.util.ArrayList;\r\n     6\timport java.util.LinkedHashSet;\r\n     7\timport java.util.List;\r\n     8\timport java.util.Set;\r\n     9\t\r\n    10\tpublic class ReachWalk {\r\n    11\t    public static Set<String> weld_set(Path a) throws Exception {\r\n    12\t        Set<String> live = new LinkedHashSet<String>();\r\n    13\t        ArrayDeque<String> q = new ArrayDeque<String>();\r\n    14\t        q.add(\"Main\");\r\n    15\t        q.add(\"TasteRun\");\r\n    16\t        q.add(\"BoothRun\");\r\n    17\t        q.add(\"KnitMain\");\r\n    18\t        q.add(\"Rib\");\r\n    19\t        q.add(\"FallBooth\");\r\n    20\t        while (!q.isEmpty()) {\r\n    21\t            String n = q.remove();\r\n    22\t            if (!live.add(n)) {\r\n    23\t                continue;\r\n    24\t            }\r\n    25\t            Path p = a.resolve(n + \".class\");\r\n    26\t            if (!Files.isRegularFile(p)) {\r\n    27\t                continue;\r\n    28\t            }\r\n    29\t            for (String r : refs(Files.readAllBytes(p))) {\r\n    30\t                if (!live.contains(r)) {\r\n    31\t                    q.add(r);\r\n    32\t                }\r\n    33\t            }\r\n    34\t        }\r\n    35\t        return live;\r\n    36\t    }\r\n    37\t\r\n    38\t    static List<String> refs(byte[] raw) {\r\n    39\t        List<String> out = new ArrayList<String>();\r\n    40\t        if (raw.length < 10) {\r\n    41\t            return out;\r\n    42\t        }\r\n    43\t        ByteBuffer b = ByteBuffer.wrap(raw);\r\n    44\t        if (b.getInt() != 0xCAFEBABE) {\r\n    45\t            return out;\r\n    46\t        }\r\n    47\t        b.getShort();\r\n    48\t        b.getShort();\r\n    49\t        int cp = b.getShort() & 0xffff;\r\n    50\t        String[] utf = new String[cp];\r\n    51\t        int[] cls = new int[cp];\r\n    52\t        int i = 1;\r\n    53\t        while (i < cp) {\r\n    54\t            int tag = b.get() & 0xff;\r\n    55\t            if (tag == 1) {\r\n    56\t                int n = b.getShort() & 0xffff;\r\n    57\t                byte[] u = new byte[n];\r\n    58\t                b.get(u);\r\n    59\t                utf[i] = new String(u);\r\n    60\t            } else if (tag == 7) {\r\n    61\t                cls[i] = b.getShort() & 0xff;\r\n    62\t            } else if (tag == 8 || tag == 16 || tag == 19 || tag == 20) {\r\n    63\t                b.getShort();\r\n    64\t            } else if (tag == 3 || tag == 4 || tag == 9 || tag == 10 || tag == 11 || tag == 12 || tag == 17 || tag == 18) {\r\n    65\t                b.getInt();\r\n    66\t            } else if (tag == 5 || tag == 6) {\r\n    67\t                b.getLong();\r\n    68\t                i++;\r\n    69\t            } else if (tag == 15) {\r\n    70\t                b.get();\r\n    71\t                b.getShort();\r\n    72\t            } else {\r\n    73\t                break;\r\n    74\t            }\r\n    75\t            i++;\r\n    76\t        }\r\n    77\t        for (int c = 1; c < cp; c++) {\r\n    78\t            if (cls[c] == 0) {\r\n    79\t                continue;\r\n    80\t            }\r\n    81\t            String n = utf[cls[c]];\r\n    82\t            if (n == null || n.startsWith(\"java/\") || n.startsWith(\"javax/\") || n.contains(\"/\")) {\r\n    83\t                continue;\r\n    84\t            }\r\n    85\t            out.add(n);\r\n    86\t        }\r\n    87\t        return out;\r\n    88\t    }\r\n    89\t}\r\n"]
