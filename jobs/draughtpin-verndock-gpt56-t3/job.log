Sending keys: ['cat > /app/narbay/loom.rs <<\'EOF\'\nuse std::fs;\n\nfn rule_value(key: &str) -> Option<String> {\n    let raw = fs::read_to_string("/app/abifolio/RULES.txt").ok()?;\n    for line in raw.lines() {\n        if let Some(rest) = line.strip_prefix(key) {\n            return Some(rest.trim().to_string());\n        }\n    }\n    None\n}\n\npub fn knit() -> String {\n    rule_value("current slot:").unwrap_or_else(|| "CASK_2".to_string())\n}\n\n#[allow(dead_code)]\npub fn weave(path: &str) -> Result<(), i32> {\n    let current = knit();\n    let compat = rule_value("compat slot:").ok_or(1)?;\n    if current.is_empty() || compat.is_empty() || current == compat {\n        return Err(1);\n    }\n    let body = format!(\n        "{old} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\n{cur} {{\\n  global:\\n    fold_frame;\\n}} {old};\\n",\n        old = compat,\n        cur = current\n    );\n    fs::create_dir_all("/app/gnuverse").map_err(|_| 1)?;\n    fs::write(path, body).map_err(|_| 1)\n}\nEOF\ncat > /app/aliaspit/hue.S <<\'EOF\'\n# Compatibility keeps the old fold; ordinary dlsym gets the current fold.\n.symver wick_old,fold_frame@CASK_1\n.symver wick_new,fold_frame@@CASK_2\nEOF\ncat > /app/vatrib/qat.rs <<\'EOF\'\nuse std::fs;\nuse std::os::raw::{c_char, c_int, c_void};\n\nconst RTLD_NOW: c_int = 2;\n\nextern "C" {\n    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\n    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\n    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\n}\n\ntype FoldFn = unsafe extern "C" fn(*const u8, usize, *mut u8, usize) -> isize;\n\nstruct Rules {\n    current: String,\n    compat: String,\n    sip_kind: String,\n    mark_kind: String,\n}\n\nfn rules() -> Result<Rules, i32> {\n    let raw = fs::read_to_string("/app/abifolio/RULES.txt").map_err(|_| 1)?;\n    let get = |key: &str| -> Result<String, i32> {\n        raw.lines()\n            .find_map(|line| line.strip_prefix(key).map(|v| v.trim().to_string()))\n            .filter(|v| !v.is_empty())\n            .ok_or(1)\n    };\n    Ok(Rules {\n        current: get("current slot:")?,\n        compat: get("compat slot:")?,\n        sip_kind: get("sip kind:")?,\n        mark_kind: get("mark kind:")?,\n    })\n}\n\nfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\n    if ptr.is_null() { return Err(1); }\n    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\n    let mut buf = vec![0u8; blob.len() + 1];\n    let n = unsafe { f(blob.as_ptr(), blob.len(), buf.as_mut_ptr(), buf.len()) };\n    if n < 0 || n as usize > buf.len() { return Err(1); }\n    buf.truncate(n as usize);\n    Ok(buf)\n}\n\nfn json_string(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in s.chars() {\n        match c {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if (c as u32) < 0x20 => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            _ => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\n    fs::create_dir_all("/app/inkvat").map_err(|_| 1)?;\n    let body = format!(\n        "{{\\"slot\\":{},\\"text\\":{},\\"kind\\":{}}}\\n",\n        json_string(slot), json_string(text), json_string(kind)\n    );\n    fs::write("/app/inkvat/card.json", body).map_err(|_| 1)\n}\n\npub fn qat(path: &str, named: Option<&str>) -> i32 {\n    let _ = fs::remove_file("/app/inkvat/SEAL");\n    let blob = match fs::read(path) {\n        Ok(v) if !v.is_empty() => v,\n        _ => return 1,\n    };\n    let rules = match rules() { Ok(v) => v, Err(c) => return c };\n    if let Some(slot) = named {\n        if slot != rules.current && slot != rules.compat { return 1; }\n    }\n\n    let handle = unsafe {\n        dlopen(b"/app/lib/libdraught.so\\0".as_ptr() as *const c_char, RTLD_NOW)\n    };\n    if handle.is_null() { return 1; }\n    let ptr = unsafe {\n        match named {\n            None => dlsym(handle, b"fold_frame\\0".as_ptr() as *const c_char),\n            Some(slot) => {\n                let mut version = slot.as_bytes().to_vec();\n                version.push(0);\n                dlvsym(handle, b"fold_frame\\0".as_ptr() as *const c_char,\n                       version.as_ptr() as *const c_char)\n            }\n        }\n    };\n    let folded = match call(ptr, &blob) { Ok(v) => v, Err(c) => return c };\n    let text = String::from_utf8_lossy(&folded).into_owned();\n    let (slot, kind) = match named {\n        None => (rules.current.as_str(), rules.sip_kind.as_str()),\n        Some(slot) => (slot, rules.mark_kind.as_str()),\n    };\n    if write_card(slot, &text, kind).is_err() { return 1; }\n    if fs::write("/app/inkvat/SEAL", "ok").is_err() { return 1; }\n    0\n}\nEOF\n/app/stoke.sh\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
