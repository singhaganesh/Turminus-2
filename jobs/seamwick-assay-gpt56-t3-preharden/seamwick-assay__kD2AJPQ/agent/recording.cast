[101.491195, "o", "\u001b[?2004hroot@2811a752b9d0:/app# "]
[104.909429, "i", "python3 - <<'PY'\nimport json\np='/app/blot/last.json'\nd=json.load(open(p))\nprint('keys:', list(d))\nprint('assayed:', d['assayed'])\nprint('findings:', d['findings'])\nprint('code/type:', d['code'], type(d['code']).__name__)\nassert list(d)==['assayed','findings','code']\nassert any(x == {'unit':'desk/Clerk.u','kind':'arity','note':'bind'} for x in d['findings'])\nassert d['code']=='1'\nPY\nprintf '%s\\n' '--- generated Cite ---'; cat /app/deskbin/gen/Cite.java; printf '%s\\n' '--- generated Sched ---'; cat /app/deskbin/gen/Sched.java; printf '%s\\n' '--- generated Seal ---'; cat /app/deskbin/gen/Seal.java\n"]
[104.909901, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[104.910079, "o", "\u001b[?2004h> p='/app/blot/last.json'\r\n\u001b[?2004l\r\u001b[?2004h> d=json.load(open(p))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.910192, "o", "print('keys:', list(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.910336, "o", "print('assayed:', d['assayed'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.910436, "o", "print('findings:', d['findings'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.910594, "o", "print('code/type:', d['code'], type(d['code']).__name__)\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.910651, "o", "> "]
[104.910818, "o", "assert list(d)==['assayed','findings','code']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.911046, "o", "assert any(x == {'unit':'desk/Clerk.u','kind':'arity','note':'bind'} for x in d['findings'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.911161, "o", "> assert d['code']=='1'\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.911219, "o", "> PY\r\n\u001b[?2004l\r"]
[104.953962, "o", "keys: ['assayed', 'findings', 'code']\r\nassayed: ['api/Bond.u', 'api/Kin.u', 'api/LocalAid.u', 'desk/Clerk.u', 'desk/Watch.u', 'wire/Port.u']\r\nfindings: [{'unit': 'desk/Clerk.u', 'kind': 'arity', 'note': 'bind'}]\r\ncode/type: 1 str\r\n"]
[104.960943, "o", "\u001b[?2004hroot@2811a752b9d0:/app# "]
[104.96136, "o", "printf '%s\\n' '--- generated Cite ---'; cat /app/deskbin/gen/Cite.java; printf '%s\\n' '--- generated Sched ---'; cat /app/deskbin/gen/Sched.java; printf '%s\\n' '--- generated Seal ---'; cat /app/deskbin/gen/Seal.java\r\n\u001b[?2004l\r"]
[104.961509, "o", "--- generated Cite ---\r\n"]
[104.962286, "o", "import java.util.*;\r\npublic class Cite {\r\n  public static LinkedHashSet<String> tags(String body, Set<String> known) {\r\n    LinkedHashSet<String> out = new LinkedHashSet<String>();\r\n    String[] words = body.split(\"[^A-Za-z0-9_]+\");\r\n    for (String word : words) {\r\n      if (known.contains(word)) out.add(word);\r\n    }\r\n    return out;\r\n  }\r\n}\r\n"]
[104.962884, "o", "--- generated Sched ---\r\n"]
[104.963338, "o", "import java.util.*;\r\npublic class Sched {\r\n  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\r\n    LinkedHashSet<String> selected = new LinkedHashSet<String>();\r\n    selected.addAll(changedFiles);\r\n    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n      for (String type : changedTypes) {\r\n        if (e.getValue().contains(type)) {\r\n          selected.add(e.getKey());\r\n          break;\r\n        }\r\n      }\r\n    }\r\n    return new ArrayList<String>(selected);\r\n  }\r\n}\r\n"]
[104.963499, "o", "--- generated Seal ---\r\n"]
[104.964192, "o", "import java.util.*;\r\npublic class Seal {\r\n  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\r\n    return new ArrayList<String>(new LinkedHashSet<String>(analysed));\r\n  }\r\n  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\r\n    if (!hitUnits.isEmpty()) return \"1\";\r\n    if (!new LinkedHashSet<String>(analysed).containsAll(must)) return \"1\";\r\n    return \"0\";\r\n  }\r\n}\r\n"]
[104.964485, "o", "\u001b[?2004hroot@2811a752b9d0:/app# "]
[144.447642, "i", "python3 - <<'PY'\np='/app/seamcmd/Drive.java'\ns=open(p).read()\nold='''      } else {\n        pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\n      }\n      LinkedHashSet<String> analysed = new LinkedHashSet<String>();'''\nnew='''      } else {\n        pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\n        // Incremental output must agree with a flood on every extant finding.\n        // Add only units flood would flag, preserving targeted clean coverage.\n        LinkedHashSet<String> complete = new LinkedHashSet<String>(pick);\n        for (Loom.Unit u : units.values()) {\n          if (!u.hits.isEmpty()) complete.add(u.path);\n        }\n        pick = new ArrayList<String>(complete);\n      }\n      LinkedHashSet<String> analysed = new LinkedHashSet<String>();'''\nif old not in s:\n    raise SystemExit('target block not found')\nopen(p,'w').write(s.replace(old,new))\nPY\n/app/assemble.bash\n"]
