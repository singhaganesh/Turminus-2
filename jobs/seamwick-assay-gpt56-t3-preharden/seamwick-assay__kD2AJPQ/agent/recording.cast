[101.406072, "o", "{\"assayed\":[\"api/Bond.u\",\"api/Kin.u\",\"api/LocalAid.u\",\"desk/Clerk.u\",\"desk/Watch.u\",\"wire/Port.u\"],\"findings\":[{\"unit\":\"desk/Clerk.u\",\"kind\":\"arity\",\"note\":\"bind\"}],\"code\":\"1\"}"]
[101.406285, "o", "\r\n--- fixed sheet ---\r\n"]
[101.462582, "o", "{\"assayed\":[\"api/Bond.u\",\"api/Kin.u\",\"api/LocalAid.u\",\"desk/Clerk.u\",\"desk/Watch.u\",\"wire/Port.u\"],\"findings\":[{\"unit\":\"desk/Clerk.u\",\"kind\":\"arity\",\"note\":\"bind\"}],\"code\":\"1\"}"]
