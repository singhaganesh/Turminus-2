[100.900631, "o", "\u001b[?2004hroot@2811a752b9d0:/app# "]
[100.954684, "i", "cp /app/seed/blot/cache.json /app/blot/cache.json; cp /app/seed/blot/last.json /app/blot/last.json; echo '--- fixed nudge from seed ---'; /app/bin/seamwick nudge; n=$?; echo \"exit=$n\"; cat /app/blot/last.json; echo; echo '--- fixed flood ---'; /app/bin/seamwick flood; f=$?; echo \"exit=$f\"; cat /app/blot/last.json; echo; echo '--- fixed sheet ---'; /app/bin/seamwick sheet; s=$?; echo; echo \"exit=$s\"\n"]
[100.957016, "o", "cp /app/seed/blot/cache.json /app/blot/cache.json; cp /app/seed/blot/last.json /app/blot/last.json; echo '--- fixed nudge from seed ---'; /app/bin/seamwick nudge; n=$?; echo \"exit=$n\"; cat /app/blot/last.json; echo; echo '--- fixed flood ---'; /app/bin/seamwick flood; f=$?; echo \"exit=$f\"; cat /app/blot/last.json; echo; echo '--- fixed sheet ---'; /app/bin/seamwick sheet; s=$?; echo; echo \"exit=$s\"\r\n\u001b[?2004l\r"]
