[149.380657, "i", "cp /app/corpus/api/Kin.u /tmp/Kin.u.orig; cp /app/seed/blot/cache.json /app/blot/cache.json; /app/bin/seamwick flood >/dev/null; sed -i 's/void tug(String n)/void tug(String n, int seq)/' /app/corpus/api/Kin.u; echo '--- later Kin nudge ---'; /app/bin/seamwick nudge; echo \"exit=$?\"; cp /app/blot/last.json /tmp/nudge-later.json; cat /tmp/nudge-later.json; echo; echo '--- later Kin flood ---'; /app/bin/seamwick flood; echo \"exit=$?\"; cp /app/blot/last.json /tmp/flood-later.json; cat /tmp/flood-later.json; echo; python3 - <<'PY'\nimport json\nn=json.load(open('/tmp/nudge-later.json'))\nf=json.load(open('/tmp/flood-later.json'))\nkey=lambda x:(x['unit'],x['kind'],x['note'])\nassert {key(x) for x in n['findings']} == {key(x) for x in f['findings']}\nassert {key(x) for x in n['findings']} == {('desk/Clerk.u','arity','bind'),('api/LocalAid.u','arity','tug')}\nassert 'api/LocalAid.u' in n['assayed'] and 'desk/Clerk.u' in n['assayed']\nassert 'desk/Watch.u' not in n['assayed'] and 'wire/Port.u' not in n['assayed']\nassert n['code']=='1' and f['code']=='1'\nprint('sequential comparison passed')\nPY\nmv /tmp/Kin.u.orig /app/corpus/api/Kin.u\n"]
