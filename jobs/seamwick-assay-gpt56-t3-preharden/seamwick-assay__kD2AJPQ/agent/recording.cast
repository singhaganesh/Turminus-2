[207.297128, "i", "cp /app/corpus/api/Kin.u /tmp/Kin.u.orig; /app/bin/seamwick flood >/dev/null; sed -i 's/void tug(String n)/void tug(String n, int seq)/' /app/corpus/api/Kin.u; /app/bin/seamwick nudge; ne=$?; cp /app/blot/last.json /tmp/nudge-later.json; /app/bin/seamwick flood; fe=$?; cp /app/blot/last.json /tmp/flood-later.json; echo \"nudge_exit=$ne flood_exit=$fe\"; python3 - <<'PY'\nimport json\nn=json.load(open('/tmp/nudge-later.json'))\nf=json.load(open('/tmp/flood-later.json'))\nkey=lambda x:(x['unit'],x['kind'],x['note'])\nexpected={('desk/Clerk.u','arity','bind'),('api/LocalAid.u','arity','tug')}\nprint('nudge:', n)\nprint('flood:', f)\nassert {key(x) for x in n['findings']} == expected\nassert {key(x) for x in f['findings']} == expected\nassert {'api/Kin.u','api/LocalAid.u','desk/Clerk.u'} <= set(n['assayed'])\nassert 'desk/Watch.u' not in n['assayed']\nassert 'wire/Port.u' not in n['assayed']\nassert n['code']=='1' and f['code']=='1'\nprint('sequential comparison passed')\nPY\nstatus=$?; mv /tmp/Kin.u.orig /app/corpus/api/Kin.u; exit $status\n"]
