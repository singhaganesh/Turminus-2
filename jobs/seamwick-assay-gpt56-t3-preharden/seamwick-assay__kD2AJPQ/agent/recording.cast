[176.960378, "i", "cp /app/corpus/api/Kin.u /tmp/Kin.u.orig; /app/bin/seamwick flood >/dev/null; sed -i 's/void tug(String n)/void tug(String n, int seq)/' /app/corpus/api/Kin.u; /app/bin/seamwick nudge; echo \"nudge_exit=$?\"; cp /app/blot/last.json /tmp/nudge-later.json; /app/bin/seamwick flood; echo \"flood_exit=$?\"; cp /app/blot/last.json /tmp/flood-later.json; python3 - <<'PY'\nimport json\nn=json.load(open('/tmp/nudge-later.json'))\nf=json.load(open('/tmp/flood-later.json'))\nkey=lambda x:(x['unit'],x['kind'],x['note'])\nnf={key(x) for x in n['findings']}; ff={key(x) for x in f['findings']}\nprint('nudge:', n)\nprint('flood:', f)\nassert nf == ff == {('desk/Clerk.u','arity','bind'),('api/LocalAid.u','arity','tug')}\nassert {'api/Kin.u','api/LocalAid.u','desk/Clerk.u'} <= set(n['assayed'])\nassert 'desk/Watch.u' not in n['assayed'] and 'wire/Port.u' not in n['assayed']\nassert n['code']=='1' and f['code']=='1'\nprint('sequential comparison passed')\nPY\nmv /tmp/Kin.u.orig /app/corpus/api/Kin.u\n/app/bin/seamwick flood; echo \"final_flood_exit=$?\"; /app/bin/seamwick sheet; echo\n"]
