[202.453549, "o", "   220\t    Set<String> changedFiles = hashChanged(units, oldHash);\r\n   221\t    List<String> pick;\r\n   222\t    if (all) {\r\n   223\t      pick = new ArrayList<String>(units.keySet());\r\n   224\t    } else {\r\n   225\t      pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\r\n   226\t      // Include every extant finding so nudge and flood findings agree.\r\n   227\t      // No unrelated clean unit is added to a targeted type assay.\r\n   228\t      LinkedHashSet<String> complete = new LinkedHashSet<String>(pick);\r\n   229\t      for (Loom.Unit u : units.values()) {\r\n   230\t        if (!u.hits.isEmpty()) complete.add(u.path);\r\n   231\t      }\r\n   232\t      pick = new ArrayList<String>(complete);\r\n   233\t    }\r\n   234\t    LinkedHashSet<String> analysed = new LinkedHashSet<String>();\r\n   235\t    analysed.addAll(pick);\r\n   236\t    ArrayList<String[]> findings = new ArrayList<String[]>();\r\n   237\t    ArrayList<String> hitUnits = new ArrayList<String>();\r\n   238\t    for (String p : analysed) {\r\n   239\t      Loom.Unit u = units.get(p);\r\n   240\t      if (u == null) continue;\r\n   241\t      cites.put(p, Cite.tags(u.body, kn));\r\n   242\t      for (String[] h : u.hits) {\r\n   243\t        findings.add(h);\r\n   244\t        hitUnits.add(h[0]);\r\n   245\t      }\r\n"]
