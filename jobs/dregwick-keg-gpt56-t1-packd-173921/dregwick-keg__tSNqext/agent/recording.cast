[27.973384, "o", "     9\t    static void put(String n) {\r\n    10\t        tab.put(n, n);\r\n    11\t    }\r\n    12\t\r\n    13\t    static String pick(String t) {\r\n    14\t        if (tab.containsKey(t)) {\r\n    15\t            return t;\r\n    16\t        }\r\n    17\t        return \"fallback\";\r\n    18\t    }\r\n    19\t\r\n    20\t    static List<String> all() {\r\n    21\t        return new ArrayList<String>(tab.keySet());\r\n    22\t    }\r\n    23\t}\r\n"]
