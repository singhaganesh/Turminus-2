[13.420578, "o", "#!/bin/bash\r\nset -euo pipefail\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  knit)\r\n    exec /app/brim.sh\r\n    ;;\r\n  loom)\r\n    exec \"$JAVA\" -cp /app/blastcp Main loom \"$@\"\r\n    ;;\r\n  taste)\r\n    exec \"$JAVA\" -cp /app/jarwell/husk.jar Main taste \"$@\"\r\n    ;;\r\n  booth)\r\n    exec \"$JAVA\" -cp /app/jarwell/husk.jar Main booth \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\n"]
