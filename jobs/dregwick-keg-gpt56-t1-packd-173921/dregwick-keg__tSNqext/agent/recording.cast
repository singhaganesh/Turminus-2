[141.422556, "o", "/app/bin/dregwick knit; echo \"knit_rc=$? size=$(stat -c %s /app/jarwell/husk.jar)\"\r\n\u001b[?2004l\r"]
[143.505719, "o", "knit_rc=0 size=6024\r\n"]
[143.505828, "o", "\u001b[?2004hroot@239997116fc9:/app# /app/bin/dregwick booth\r\n\u001b[?2004l\r"]
[143.576626, "o", "fallback\r\n"]
[143.576775, "o", "json\r\nsyslog\r\n"]
[143.577183, "o", "kmsg\r\naudit\r\n"]
[143.583391, "o", "\u001b[?2004hroot@239997116fc9:/app# "]
[144.446832, "i", "tmp=$(mktemp); printf 'token: absent\\nbody: test\\n' > \"$tmp\"; /app/bin/dregwick taste \"$tmp\"; printf 'unknown: '; cat /app/jarwell/taste.json; rm -f \"$tmp\"; cp /app/desknote/CAP.txt /tmp/CAP.save; printf '1\\n' > /app/desknote/CAP.txt; /app/bin/dregwick knit; echo \"low_cap_knit_rc=$?\"; mv /tmp/CAP.save /app/desknote/CAP.txt\n"]
