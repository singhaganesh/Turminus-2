[91.935373, "i", "python3 - <<'PY'\np='/app/rootwalk/ReachWalk.java'\ns=open(p).read()\ns=s.replace('        q.add(\"KnitMain\");\\n', '')\nopen(p,'w').write(s)\n\np='/app/hitchrun/TasteRun.java'\ns=open(p).read()\ns=s.replace('    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };\\n\\n', '')\ns=s.replace('        if (seed.length < 0) {\\n            return;\\n        }\\n', '')\nopen(p,'w').write(s)\nPY\ncat > /app/hitchrun/KnitMain.java <<'EOF'\nimport java.nio.file.DirectoryStream;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.Set;\nimport java.util.jar.JarEntry;\nimport java.util.jar.JarOutputStream;\n\npublic class KnitMain {\n    public static void main(String[] args) throws Exception {\n        Path exploded = Paths.get(\"/app/blastcp\");\n        Path jar = Paths.get(\"/app/jarwell/husk.jar\");\n        Files.createDirectories(jar.getParent());\n        Set<String> live = ReachWalk.weld_set(exploded);\n\n        // Booth implementations are loaded reflectively, so bytecode reachability\n        // alone cannot find them.  The operations roster is authoritative.\n        for (String line : Files.readAllLines(Paths.get(\"/app/desknote/NAMES.txt\"))) {\n            String s = line.trim();\n            if (s.isEmpty()) {\n                continue;\n            }\n            String[] fields = s.split(\"\\\\s+\");\n            if (fields.length != 2) {\n                throw new IllegalArgumentException(\"bad NAMES.txt line: \" + line);\n            }\n            live.add(fields[1]);\n        }\n        live.add(\"FallBooth\");\n\n        if (args.length > 0 && \"--all\".equals(args[0])) {\n            live.clear();\n            try (DirectoryStream<Path> ds = Files.newDirectoryStream(exploded, \"*.class\")) {\n                for (Path p : ds) {\n                    String n = p.getFileName().toString();\n                    live.add(n.substring(0, n.length() - 6));\n                }\n            }\n        }\n        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar))) {\n            for (String n : live) {\n                Path src = exploded.resolve(n + \".class\");\n                if (!Files.isRegularFile(src)) {\n                    throw new IllegalStateException(\"missing packed class: \" + n);\n                }\n                jos.putNextEntry(new JarEntry(n + \".class\"));\n                jos.write(Files.readAllBytes(src));\n                jos.closeEntry();\n            }\n        }\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path mill, Path capFile) throws Exception {\n        if (!Files.isRegularFile(mill)) {\n            return 1;\n        }\n        long cap = Long.parseLong(new String(Files.readAllBytes(capFile), \"UTF-8\").trim());\n        return Files.size(mill) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(\n            Paths.get(\"/app/jarwell/husk.jar\"),\n            Paths.get(\"/app/desknote/CAP.txt\")));\n    }\n}\nEOF\ncat > /app/namelock/TallyGate.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\nimport java.util.jar.JarEntry;\nimport java.util.jar.JarFile;\n\npublic class TallyGate {\n    public static int tint_span(Path names, Path mill) throws Exception {\n        Set<String> expected = new LinkedHashSet<String>();\n        for (String line : Files.readAllLines(names)) {\n            String s = line.trim();\n            if (s.isEmpty()) {\n                continue;\n            }\n            String[] fields = s.split(\"\\\\s+\");\n            if (fields.length != 2 || !expected.add(fields[1])) {\n                return 1;\n            }\n        }\n        expected.add(\"FallBooth\");\n\n        Set<String> actual = new LinkedHashSet<String>();\n        try (JarFile jar = new JarFile(mill.toFile())) {\n            java.util.Enumeration<JarEntry> entries = jar.entries();\n            while (entries.hasMoreElements()) {\n                "]
[91.935565, "i", "String n = entries.nextElement().getName();\n                if (!n.contains(\"/\") && n.endsWith(\"Booth.class\")) {\n                    actual.add(n.substring(0, n.length() - 6));\n                }\n            }\n        }\n        return actual.equals(expected) ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(\n            Paths.get(\"/app/desknote/NAMES.txt\"),\n            Paths.get(\"/app/jarwell/husk.jar\")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo \"knit_rc=$?\"\n"]
