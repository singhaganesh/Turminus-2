[141.41355, "i", "cat > /app/namelock/TallyGate.java <<'EOF'\nimport java.io.BufferedReader;\nimport java.io.InputStreamReader;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\n\npublic class TallyGate {\n    public static int tint_span(Path names, Path mill) throws Exception {\n        Set<String> expected = new LinkedHashSet<String>();\n        for (String line : Files.readAllLines(names)) {\n            String s = line.trim();\n            if (s.isEmpty()) {\n                continue;\n            }\n            String[] fields = s.split(\"\\\\s+\");\n            if (fields.length != 2 || !expected.add(fields[0])) {\n                return 1;\n            }\n        }\n        expected.add(\"fallback\");\n\n        String java = Paths.get(System.getProperty(\"java.home\"), \"bin\", \"java\").toString();\n        Process process = new ProcessBuilder(java, \"-cp\", mill.toString(), \"Main\", \"booth\")\n            .redirectError(ProcessBuilder.Redirect.INHERIT)\n            .start();\n        Set<String> actual = new LinkedHashSet<String>();\n        try (BufferedReader reader = new BufferedReader(\n                new InputStreamReader(process.getInputStream(), \"UTF-8\"))) {\n            String line;\n            while ((line = reader.readLine()) != null) {\n                if (!line.trim().isEmpty() && !actual.add(line.trim())) {\n                    return 1;\n                }\n            }\n        }\n        if (process.waitFor() != 0) {\n            return 1;\n        }\n        return actual.equals(expected) ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(\n            Paths.get(\"/app/desknote/NAMES.txt\"),\n            Paths.get(\"/app/jarwell/husk.jar\")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo \"knit_rc=$? size=$(stat -c %s /app/jarwell/husk.jar)\"\n/app/bin/dregwick booth\n"]
[141.413935, "o", "cat > /app/namelock/TallyGate.java <<'EOF'\r\n\u001b[?2004l\r"]
[141.414077, "o", "\u001b[?2004h> "]
