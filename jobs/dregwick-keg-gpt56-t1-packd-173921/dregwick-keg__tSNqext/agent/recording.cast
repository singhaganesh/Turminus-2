[141.414307, "o", "import java.io.InputStreamReader;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.41443, "o", "import java.nio.file.Files;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.414492, "o", "import java.nio.file.Path;\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.414683, "o", "> import java.nio.file.Paths;\r\n\u001b[?2004l\r\u001b[?2004h> import java.util.LinkedHashSet;\r\n\u001b[?2004l\r"]
[141.414822, "o", "\u001b[?2004h> "]
[141.414959, "o", "import java.util.Set;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.415141, "o", "public class TallyGate {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.415334, "o", "    public static int tint_span(Path names, Path mill) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.415497, "o", "> "]
[141.415561, "o", "        Set<String> expected = new LinkedHashSet<String>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.415871, "o", "        for (String line : Files.readAllLines(names)) {\r\n\u001b[?2004l\r\u001b[?2004h>             String s = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.416012, "o", "            if (s.isEmpty()) {\r\n\u001b[?2004l\r"]
[141.416139, "o", "\u001b[?2004h>                 continue;\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.416205, "o", ">             }\r\n\u001b[?2004l\r"]
[141.416258, "o", "\u001b[?2004h> "]
[141.416427, "o", "            String[] fields = s.split(\"\\\\s+\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.416982, "o", ">             if (fields.length != 2 || !expected.add(fields[0])) {\r\n\u001b[?2004l\r\u001b[?2004h>                 return 1;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         expected.add(\"fallback\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.417149, "o", "        String java = Paths.get(System.getProperty(\"java.home\"), \"bin\", \"java\").toString();\r\n\u001b[?2004l\r"]
[141.417194, "o", "\u001b[?2004h> "]
[141.417412, "o", "        Process process = new ProcessBuilder(java, \"-cp\", mill.toString(), \"Main\", \"booth\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.417521, "o", "> "]
[141.417608, "o", "            .redirectError(ProcessBuilder.Redirect.INHERIT)\r\n\u001b[?2004l\r"]
[141.417686, "o", "\u001b[?2004h> "]
[141.41776, "o", "            .start();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.417939, "o", "        Set<String> actual = new LinkedHashSet<String>();\r\n\u001b[?2004l\r"]
[141.418031, "o", "\u001b[?2004h> "]
[141.418255, "o", "        try (BufferedReader reader = new BufferedReader(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.418409, "o", "                new InputStreamReader(process.getInputStream(), \"UTF-8\"))) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.418505, "o", ">             String line;\r\n\u001b[?2004l\r"]
[141.41856, "o", "\u001b[?2004h> "]
[141.418719, "o", "            while ((line = reader.readLine()) != null) {\r\n\u001b[?2004l\r"]
[141.418769, "o", "\u001b[?2004h> "]
[141.418974, "o", "                if (!line.trim().isEmpty() && !actual.add(line.trim())) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.419077, "o", "                    return 1;\r\n\u001b[?2004l\r"]
[141.419117, "o", "\u001b[?2004h> "]
[141.419266, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.419351, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.419482, "o", "        if (process.waitFor() != 0) {\r\n\u001b[?2004l\r"]
[141.419576, "o", "\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.419671, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.419824, "o", "        return actual.equals(expected) ? 0 : 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.419935, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.420108, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r"]
[141.4202, "o", "\u001b[?2004h>         System.exit(tint_span(\r\n"]
[141.420245, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[141.420381, "o", "            Paths.get(\"/app/desknote/NAMES.txt\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.420544, "o", "            Paths.get(\"/app/jarwell/husk.jar\")));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.420639, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.420728, "o", "EOF\r\n\u001b[?2004l\r"]
