[91.976295, "o", "cat > /app/bytecue/CapGate.java <<'EOF'\r\n\u001b[?2004l\r"]
[91.976345, "o", "\u001b[?2004h> "]
[91.976544, "o", "import java.nio.file.Files;\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.file.Path;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.976664, "o", "import java.nio.file.Paths;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.976761, "o", "\u001b[?2004h> public class CapGate {\r\n\u001b[?2004l\r"]
[91.976827, "o", "\u001b[?2004h> "]
[91.977019, "o", "    public static int rib_n(Path mill, Path capFile) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.977149, "o", "        if (!Files.isRegularFile(mill)) {\r\n\u001b[?2004l\r"]
[91.977247, "o", "\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r"]
[91.977341, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.977578, "o", "        long cap = Long.parseLong(new String(Files.readAllBytes(capFile), \"UTF-8\").trim());\r\n\u001b[?2004l\r"]
[91.977698, "o", "\u001b[?2004h> "]
[91.977812, "o", "        return Files.size(mill) <= cap ? 0 : 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.977857, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.978078, "o", "    public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.978204, "o", "        System.exit(rib_n(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.978387, "o", "            Paths.get(\"/app/jarwell/husk.jar\"),\r\n\u001b[?2004l\r"]
[91.978506, "o", "\u001b[?2004h> "]
[91.978589, "o", "            Paths.get(\"/app/desknote/CAP.txt\")));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[91.978623, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[91.978739, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[91.980325, "o", "\u001b[?2004hroot@239997116fc9:/app# "]
