[91.968999, "o", "        Path jar = Paths.get(\"/app/jarwell/husk.jar\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.969176, "o", "> "]
[91.969275, "o", "        Files.createDirectories(jar.getParent());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.969361, "o", "        Set<String> live = ReachWalk.weld_set(exploded);\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.969436, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.969592, "o", "        // Booth implementations are loaded reflectively, so bytecode reachability\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.969776, "o", "        // alone cannot find them.  The operations roster is authoritative.\r\n\u001b[?2004l\r"]
[91.969866, "o", "\u001b[?2004h> "]
[91.970004, "o", "        for (String line : Files.readAllLines(Paths.get(\"/app/desknote/NAMES.txt\"))) {\r\n\u001b[?2004l\r"]
[91.970087, "o", "\u001b[?2004h> "]
[91.970167, "o", "            String s = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.970247, "o", "            if (s.isEmpty()) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.970354, "o", "                continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.970461, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.970566, "o", "            String[] fields = s.split(\"\\\\s+\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.970657, "o", "            if (fields.length != 2) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.97087, "o", "                throw new IllegalArgumentException(\"bad NAMES.txt line: \" + line);\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.971004, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.97111, "o", "            live.add(fields[1]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.97121, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.971302, "o", "        live.add(\"FallBooth\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[91.971386, "o", "\u001b[?2004h> "]
[91.971477, "o", "        if (args.length > 0 && \"--all\".equals(args[0])) {\r\n\u001b[?2004l\r"]
[91.971521, "o", "\u001b[?2004h> "]
[91.971636, "o", "            live.clear();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.971796, "o", "            try (DirectoryStream<Path> ds = Files.newDirectoryStream(exploded, \"*.class\")) {\r\n\u001b[?2004l\r"]
[91.971838, "o", "\u001b[?2004h> "]
[91.971926, "o", "                for (Path p : ds) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.971971, "o", "> "]
[91.972083, "o", "                    String n = p.getFileName().toString();\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.972165, "o", "> "]
[91.972303, "o", "                    live.add(n.substring(0, n.length() - 6));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.972406, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n"]
[91.972509, "o", "\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.972619, "o", "> "]
[91.972749, "o", "        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar))) {\r\n\u001b[?2004l\r"]
[91.972863, "o", "\u001b[?2004h> "]
[91.972961, "o", "            for (String n : live) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.9731, "o", "                Path src = exploded.resolve(n + \".class\");\r\n\u001b[?2004l\r"]
[91.973189, "o", "\u001b[?2004h> "]
[91.973259, "o", "                if (!Files.isRegularFile(src)) {\r\n\u001b[?2004l\r"]
[91.973303, "o", "\u001b[?2004h> "]
[91.973537, "o", "                    throw new IllegalStateException(\"missing packed class: \" + n);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.973627, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.973785, "o", "                jos.putNextEntry(new JarEntry(n + \".class\"));\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.973868, "o", "> "]
[91.973995, "o", "                jos.write(Files.readAllBytes(src));\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.974097, "o", "> "]
[91.974215, "o", "                jos.closeEntry();\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.974271, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.974325, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.974388, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.974429, "o", "> EOF\r\n\u001b[?2004l\r"]
