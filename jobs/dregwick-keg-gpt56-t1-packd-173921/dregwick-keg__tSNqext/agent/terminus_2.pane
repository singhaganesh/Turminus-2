     1	#!/bin/bash
     2	set -euo pipefail
     3	JAVAC="${JAVA_HOME:-/opt/java/openjdk}/bin/javac"
     4	JAVA="${JAVA_HOME:-/opt/java/openjdk}/bin/java"
     5	if [ ! -x "$JAVAC" ]; then
     6	  JAVAC=javac
     7	  JAVA=java
     8	fi
     9	mkdir -p /app/blastcp /app/jarwell /app/bin
    10	mapfile -t SRC < <(find /app/rootwalk /app/namelock /app/bytecue /app/hitchrun /app/fmtcells /app/gildbox /app/floorcue -name '*.java' | sort)
    11	"$JAVAC" -d /app/blastcp "${SRC[@]}"
    12	if [ "${SKIP_SHRINK:-}" = "1" ]; then
    13	  "$JAVA" -cp /app/blastcp KnitMain --all
    14	else
    15	  "$JAVA" -cp /app/blastcp KnitMain
    16	fi
    17	trc=0
    18	"$JAVA" -cp /app/blastcp TallyGate || trc=$?
    19	crc=0
    20	"$JAVA" -cp /app/blastcp CapGate || crc=$?
    21	cat > /app/bin/dregwick << 'EOF'
    22	#!/bin/bash
    23	set -euo pipefail
    24	JAVA="${JAVA_HOME:-/opt/java/openjdk}/bin/java"
    25	if [ ! -x "$JAVA" ]; then
    26	  JAVA=java
    27	fi
    28	verb="${1:-}"
    29	shift || true
    30	case "$verb" in
    31	  knit)
    32	    exec /app/brim.sh
    33	    ;;
    34	  loom)
    35	    exec "$JAVA" -cp /app/blastcp Main loom "$@"
    36	    ;;
    37	  taste)
    38	    exec "$JAVA" -cp /app/jarwell/husk.jar Main taste "$@"
    39	    ;;
    40	  booth)
    41	    exec "$JAVA" -cp /app/jarwell/husk.jar Main booth "$@"
    42	    ;;
    43	  *)
    44	    exit 2
    45	    ;;
    46	esac
    47	EOF
    48	chmod +x /app/bin/dregwick /app/brim.sh
    49	if [ "$trc" -ne 0 ] || [ "$crc" -ne 0 ]; then
    50	  exit 1
    51	fi
    52	exit 0

--- /app/rootwalk/ReachWalk.java ---
     1	import java.nio.ByteBuffer;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.util.ArrayDeque;
     5	import java.util.ArrayList;
     6	import java.util.LinkedHashSet;
     7	import java.util.List;
     8	import java.util.Set;
     9	
    10	public class ReachWalk {
    11	    public static Set<String> weld_set(Path a) throws Exception {
    12	        Set<String> live = new LinkedHashSet<String>();
    13	        ArrayDeque<String> q = new ArrayDeque<String>();
    14	        q.add("Main");
    15	        q.add("TasteRun");
    16	        q.add("BoothRun");
    17	        q.add("KnitMain");
    18	        q.add("Rib");
    19	        q.add("FallBooth");
    20	        while (!q.isEmpty()) {
    21	            String n = q.remove();
    22	            if (!live.add(n)) {
    23	                continue;
    24	            }
    25	            Path p = a.resolve(n + ".class");
    26	            if (!Files.isRegularFile(p)) {
    27	                continue;
    28	            }
    29	            for (String r : refs(Files.readAllBytes(p))) {
    30	                if (!live.contains(r)) {
    31	                    q.add(r);
    32	                }
    33	            }
    34	        }
    35	        return live;
    36	    }
    37	
    38	    static List<String> refs(byte[] raw) {
    39	        List<String> out = new ArrayList<String>();
    40	        if (raw.length < 10) {
    41	            return out;
    42	        }
    43	        ByteBuffer b = ByteBuffer.wrap(raw);
    44	        if (b.getInt() != 0xCAFEBABE) {
    45	            return out;
    46	        }
    47	        b.getShort();
    48	        b.getShort();
    49	        int cp = b.getShort() & 0xffff;
    50	        String[] utf = new String[cp];
    51	        int[] cls = new int[cp];
    52	        int i = 1;
    53	        while (i < cp) {
    54	            int tag = b.get() & 0xff;
    55	            if (tag == 1) {
    56	                int n = b.getShort() & 0xffff;
    57	                byte[] u = new byte[n];
    58	                b.get(u);
    59	                utf[i] = new String(u);
    60	            } else if (tag == 7) {
    61	                cls[i] = b.getShort() & 0xffff;
    62	            } else if (tag == 8 || tag == 16 || tag == 19 || tag == 20) {
    63	                b.getShort();
    64	            } else if (tag == 3 || tag == 4 || tag == 9 || tag == 10 || tag == 11 || tag == 12 || tag == 17 || tag == 18) {
    65	                b.getInt();
    66	            } else if (tag == 5 || tag == 6) {
    67	                b.getLong();
    68	                i++;
    69	            } else if (tag == 15) {
    70	                b.get();
    71	                b.getShort();
    72	            } else {
    73	                break;
    74	            }
    75	            i++;
    76	        }
    77	        for (int c = 1; c < cp; c++) {
    78	            if (cls[c] == 0) {
    79	                continue;
    80	            }
    81	            String n = utf[cls[c]];
    82	            if (n == null || n.startsWith("java/") || n.startsWith("javax/") || n.contains("/")) {
    83	                continue;
    84	            }
    85	            out.add(n);
    86	        }
    87	        return out;
    88	    }
    89	}

--- /app/namelock/TallyGate.java ---
     1	import java.nio.file.DirectoryStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	
     6	public class TallyGate {
     7	    public static int tint_span(Path a, Path b, Path c) throws Exception {
     8	        int n = 0;
     9	        try (DirectoryStream<Path> ds = Files.newDirectoryStream(a, "*.class")) {
    10	            for (Path p : ds) {
    11	                n++;
    12	            }
    13	        }
    14	        int r = 0;
    15	        for (String line : Files.readAllLines(b)) {
    16	            if (!line.trim().isEmpty()) {
    17	                r++;
    18	            }
    19	        }
    20	        if (n >= r) {
    21	            return 0;
    22	        }
    23	        return 1;
    24	    }
    25	
    26	    public static void main(String[] args) throws Exception {
    27	        int rc = tint_span(
    28	            Paths.get("/app/blastcp"),
    29	            Paths.get("/app/desknote/NAMES.txt"),
    30	            Paths.get("/app/jarwell/husk.jar"));
    31	        System.exit(rc);
    32	    }
    33	}

--- /app/bytecue/CapGate.java ---
     1	import java.io.ByteArrayOutputStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.util.zip.ZipEntry;
     6	import java.util.zip.ZipOutputStream;
     7	
     8	public class CapGate {
     9	    public static int rib_n(Path a, Path b) throws Exception {
    10	        Path exploded = Paths.get("/app/blastcp");
    11	        String[] keep = new String[] {
    12	            "Main",
    13	            "TasteRun",
    14	            "BoothRun",
    15	            "Rib",
    16	            "JsonBooth",
    17	            "SysBooth",
    18	            "FallBooth",
    19	            "HexDump"
    20	        };
    21	        ByteArrayOutputStream bos = new ByteArrayOutputStream();
    22	        try (ZipOutputStream zos = new ZipOutputStream(bos)) {
    23	            for (String n : keep) {
    24	                Path src = exploded.resolve(n + ".class");
    25	                if (!Files.isRegularFile(src)) {
    26	                    continue;
    27	                }
    28	                zos.putNextEntry(new ZipEntry(n + ".class"));
    29	                zos.write(Files.readAllBytes(src));
    30	                zos.closeEntry();
    31	            }
    32	        }
    33	        Files.write(a, bos.toByteArray());
    34	        return 0;
    35	    }
    36	
    37	    public static void main(String[] args) throws Exception {
    38	        int rc = rib_n(Paths.get("/app/jarwell/husk.jar"), Paths.get("/app/desknote/CAP.txt"));
    39	        System.exit(rc);
    40	    }
    41	}

