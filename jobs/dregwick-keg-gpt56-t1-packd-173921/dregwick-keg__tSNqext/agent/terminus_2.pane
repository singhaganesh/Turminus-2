--- /app/hitchrun/KnitMain.java ---
     1	import java.nio.file.DirectoryStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.util.Set;
     6	import java.util.jar.JarEntry;
     7	import java.util.jar.JarOutputStream;
     8	
     9	public class KnitMain {
    10	    public static void main(String[] args) throws Exception {
    11	        Path exploded = Paths.get("/app/blastcp");
    12	        Path jar = Paths.get("/app/jarwell/husk.jar");
    13	        Files.createDirectories(jar.getParent());
    14	        Set<String> live = ReachWalk.weld_set(exploded);
    15	        if (args.length > 0 && "--all".equals(args[0])) {
    16	            live.clear();
    17	            try (DirectoryStream<Path> ds = Files.newDirectoryStream(exploded, "*.class")) {
    18	                for (Path p : ds) {
    19	                    String n = p.getFileName().toString();
    20	                    live.add(n.substring(0, n.length() - 6));
    21	                }
    22	            }
    23	        }
    24	        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar))) {
    25	            for (String n : live) {
    26	                Path src = exploded.resolve(n + ".class");
    27	                if (!Files.isRegularFile(src)) {
    28	                    continue;
    29	                }
    30	                jos.putNextEntry(new JarEntry(n + ".class"));
    31	                jos.write(Files.readAllBytes(src));
    32	                jos.closeEntry();
    33	            }
    34	        }
    35	    }
    36	}

--- /app/hitchrun/Main.java ---
     1	import java.nio.file.DirectoryStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.util.Collections;
     6	import java.util.jar.JarEntry;
     7	import java.util.jar.JarFile;
     8	
     9	public class Main {
    10	    public static void main(String[] args) throws Exception {
    11	        if (args.length < 1) {
    12	            System.exit(2);
    13	        }
    14	        String verb = args[0];
    15	        if ("loom".equals(verb)) {
    16	            loadExploded();
    17	            TasteRun.go(args[1]);
    18	            return;
    19	        }
    20	        if ("taste".equals(verb)) {
    21	            loadJar();
    22	            TasteRun.go(args[1]);
    23	            return;
    24	        }
    25	        if ("booth".equals(verb)) {
    26	            loadJar();
    27	            BoothRun.go();
    28	            return;
    29	        }
    30	        System.exit(2);
    31	    }
    32	
    33	    static void loadExploded() throws Exception {
    34	        Path dir = Paths.get("/app/blastcp");
    35	        try (DirectoryStream<Path> ds = Files.newDirectoryStream(dir, "*Booth.class")) {
    36	            for (Path p : ds) {
    37	                String n = p.getFileName().toString();
    38	                n = n.substring(0, n.length() - 6);
    39	                Class.forName(n);
    40	            }
    41	        }
    42	    }
    43	
    44	    static void loadJar() throws Exception {
    45	        String cp = System.getProperty("java.class.path");
    46	        Path p = Paths.get(cp.split(java.io.File.pathSeparator)[0]);
    47	        if (!Files.isRegularFile(p)) {
    48	            return;
    49	        }
    50	        try (JarFile jf = new JarFile(p.toFile())) {
    51	            for (JarEntry e : Collections.list(jf.entries())) {
    52	                String n = e.getName();
    53	                if (n.endsWith("Booth.class") && !n.contains("/")) {
    54	                    Class.forName(n.substring(0, n.length() - 6));
    55	                }
    56	            }
    57	        }
    58	    }
    59	}

--- /app/hitchrun/Rib.java ---
     1	import java.util.ArrayList;
     2	import java.util.LinkedHashMap;
     3	import java.util.List;
     4	import java.util.Map;
     5	
     6	public class Rib {
     7	    static final Map<String, String> tab = new LinkedHashMap<String, String>();
     8	
     9	    static void put(String n) {
    10	        tab.put(n, n);
    11	    }
    12	
    13	    static String pick(String t) {
    14	        if (tab.containsKey(t)) {
    15	            return t;
    16	        }
    17	        return "fallback";
    18	    }
    19	
    20	    static List<String> all() {
    21	        return new ArrayList<String>(tab.keySet());
    22	    }
    23	}

--- /app/hitchrun/TasteRun.java ---
     1	import java.nio.charset.StandardCharsets;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.util.List;
     6	
     7	public class TasteRun {
     8	    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };
     9	
    10	    static void go(String card) throws Exception {
    11	        if (seed.length < 0) {
    12	            return;
    13	        }
    14	        String token = readToken(Paths.get(card));
    15	        String booth = Rib.pick(token);
    16	        String kind = booth.equals(token) ? "own" : "fallback";
    17	        String json = "{\"booth\":\"" + booth + "\",\"kind\":\"" + kind + "\",\"note\":\"" + token + "\"}\n";
    18	        Path dest = Paths.get("/app/jarwell/taste.json");
    19	        Files.createDirectories(dest.getParent());
    20	        Files.write(dest, json.getBytes(StandardCharsets.UTF_8));
    21	    }
    22	
    23	    static String readToken(Path card) throws Exception {
    24	        List<String> lines = Files.readAllLines(card);
    25	        for (String line : lines) {
    26	            String s = line.trim();
    27	            if (s.startsWith("token:")) {
    28	                return s.substring(6).trim();
    29	            }
    30	        }
    31	        return "none";
    32	    }
    33	}

