[162.68953, "i", "python3 - <<'PY'\np='/app/millrib/gait.rs'\ns=open(p).read()\ns=s.replace('''    let mut matched = 0;\n    for (day, _) in packed {''','''    let mut matched = 0;\n    let mut probe = String::new();\n    for (day, _) in packed {''')\ns=s.replace('''        let source = format!(\"/app/daywell/{}\", name);\n        let restored''','''        let source = format!(\"/app/daywell/{}\", name);\n        probe = source.clone();\n        let restored''')\ns=s.replace('''    if emit(\"/app/daywell\", matched, taken).is_err() {''','''    if probe.is_empty() || emit(&probe, matched, taken).is_err() {''')\nopen(p,'w').write(s)\nPY\ncat > /app/corkpit/floor.rs <<'EOF'\nuse std::fs;\n\npub fn floor(taken: i32) -> bool {\n    let minimum = match fs::read_to_string(\"/app/floorcue/MIN.txt\")\n        .ok()\n        .and_then(|text| text.trim().parse::<i32>().ok())\n    {\n        Some(value) => value,\n        None => return false,\n    };\n    taken >= minimum\n}\nEOF\n/app/wick.sh >/tmp/build.log 2>&1 && /app/bin/dewkiln clasp; rc=$?; cat /tmp/build.log; echo \"RC=$rc ELF=$(od -An -tx1 -N4 /app/bin/dewkiln | tr -d ' ')\"; cat /app/bloturn/check.json; echo; cat /app/bloturn/ledger.json; echo; cat /app/bloturn/GUARD; echo; find /app/packbay/latest -maxdepth 1 -type f -printf '%f rows=' -exec awk 'END{print NR}' {} \\; | sort\n"]
