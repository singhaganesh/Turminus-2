[12.891549, "o", "printf '%s\\n' '--- daywell ---'; find /app/daywell -maxdepth 1 -type f -printf '%f rows=' -exec awk 'END{print NR}' {} \\; | sort; printf '%s\\n' '--- existing outputs ---'; find /app/bloturn /app/packbay -maxdepth 3 -type f -print -exec sh -c 'echo \"--- $1\"; sed -n \"1,80p\" \"$1\"' _ {} \\; 2>/dev/null\r\n\u001b[?2004l\r"]
