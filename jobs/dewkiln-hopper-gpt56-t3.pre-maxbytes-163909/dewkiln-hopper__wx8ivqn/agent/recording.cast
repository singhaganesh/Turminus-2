[125.543766, "i", "/app/bin/dewkiln clasp; rc=$?; python3 - <<'PY'\nimport json, os\nwith open('/app/bloturn/check.json') as f: c=json.load(f)\nassert set(c) == {'probe','matched','taken'}\nassert isinstance(c['probe'],str) and c['probe']\nassert type(c['matched']) is int and type(c['taken']) is int\nwall=int(open('/app/opstext/WALL').read())\ntotal=0\nfor name in sorted(os.listdir('/app/daywell')):\n    if len(name)==13 and name[0]=='d' and name.endswith('.tbl') and name[1:9].isdigit() and int(name[1:9]) <= wall:\n        src=sum(bool(x.strip()) for x in open('/app/daywell/'+name))\n        dst=sum(bool(x.strip()) for x in open('/app/packbay/latest/'+name))\n        assert src == dst, (name,src,dst)\n        total += src\nassert c['matched'] == c['taken'] == total\nassert open('/app/bloturn/GUARD').read() == 'ok'\nprint('validated', total, 'rows; check=', c)\nPY\necho \"final rc=$rc magic=$(od -An -tx1 -N4 /app/bin/dewkiln | tr -d ' ')\"; find /app/packbay/latest -maxdepth 1 -type f -printf '%f\\n' | sort\n"]
[125.544071, "o", "/app/bin/dewkiln clasp; rc=$?; python3 - <<'PY'\r\n\u001b[?2004l\r"]
[125.544336, "o", "\u001b[?2004h> import json, os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.544568, "o", "with open('/app/bloturn/check.json') as f: c=json.load(f)\r\n\u001b[?2004l\r"]
[125.544785, "o", "\u001b[?2004h> "]
[125.544919, "o", "assert set(c) == {'probe','matched','taken'}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.54508, "o", "assert isinstance(c['probe'],str) and c['probe']\r\n\u001b[?2004l\r"]
[125.545254, "o", "\u001b[?2004h> "]
[125.54745, "o", "assert type(c['matched']) is int and type(c['taken']) is int\r\n\u001b[?2004l\r\u001b[?2004h> wall=int(open('/app/opstext/WALL').read())\r\n\u001b[?2004l\r\u001b[?2004h> total=0\r\n\u001b[?2004l\r\u001b[?2004h> for name in sorted(os.listdir('/app/daywell')):\r\n\u001b[?2004l\r\u001b[?2004h>     if len(name)==13 and name[0]=='d' and name.endswith('.tbl') and name[1:9].isdigit() and int(name[1:9]) <= wall:\r\n\u001b[?2004l\r\u001b[?2004h>         src=sum(bool(x.strip()) for x in open('/app/daywell/'+name))\r\n\u001b[?2004l\r\u001b[?2004h>         dst=sum(bool(x.strip()) for x in open('/app/packbay/latest/'+name))\r\n\u001b[?2004l\r\u001b[?2004h>         assert src == dst, (name,src,dst)\r\n\u001b[?2004l\r\u001b[?2004h>         total += src\r\n\u001b[?2004l\r\u001b[?2004h> assert c['matched'] == c['taken'] == total\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.547642, "o", "assert open('/app/bloturn/GUARD').read() == 'ok'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.547804, "o", "print('validated', total, 'rows; check=', c)\r\n\u001b[?2004l\r"]
[125.547851, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
