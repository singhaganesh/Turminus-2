[81.678585, "i", "cat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn rows(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let template = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let output = template\n        .replace(\"__P__\", probe)\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", output).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    if taken <= 0 || packed.is_empty() {\n        return 1;\n    }\n\n    // This count is deliberately taken from the live inputs, independently of\n    // ledger.json and the staged count.  Also verify every restored copy.\n    let mut matched = 0;\n    for (day, _) in packed {\n        let name = format!(\"d{:08}.tbl\", day);\n        let source = format!(\"/app/daywell/{}\", name);\n        let restored = format!(\"/app/packbay/latest/{}\", name);\n        let source_rows = match rows(&source) {\n            Ok(value) => value,\n            Err(_) => return 1,\n        };\n        let restored_rows = match rows(&restored) {\n            Ok(value) => value,\n            Err(_) => return 1,\n        };\n        if source_rows != restored_rows {\n            return 1;\n        }\n        matched += source_rows;\n    }\n    if matched != taken {\n        return 1;\n    }\n    if emit(\"/app/daywell\", matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\npython3 - <<'PY'\np='/app/wickmill/boot.rs'\ns=open(p).read()\ns=s.replace('let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");', '''let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\n    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");\n    let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\n    let _ = std::fs::remove_dir_all(\"/app/packbay/latest\");\n    let _ = std::fs::remove_dir_all(\"/app/packbay/stage\");''')\ns=s.replace('let _ = floor::floor(taken);\\n              gait::gait(taken, &packed)', '''if !floor::floor(taken) {\n                  1\n              } else {\n                  gait::gait(taken, &packed)\n              }''')\nopen(p,'w').write(s)\nPY\ncat /app/wickmill/boot.rs\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/dewkiln\n/app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; echo '--- outputs ---'; for f in /app/bloturn/GUARD /app/bloturn/ledger.json /app/bloturn/check.json; do printf '%s: ' \"$f\"; cat \"$f\"; echo; done; echo '--- latest rows ---'; find /app/packbay/latest -maxdepth 1 -type f -printf '%f ' -exec awk 'END {print NR}' {} \\; | sort\n"]
