[81.195456, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], dest: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(dest);\n    fs::create_dir_all(dest).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|x| x.0);\n    for (day, path) in files {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(path, format!(\"{}/{}\", dest, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/shardfold/read.rs <<'EOF'\nuse std::fs;\n\npub fn list(root: &str) -> Result<Vec<(i32, String)>, i32> {\n    let mut files = Vec::new();\n    let entries = fs::read_dir(root).map_err(|_| 1)?;\n    for entry in entries {\n        let entry = entry.map_err(|_| 1)?;\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|b| b.is_ascii_digit()) || !entry.file_type().map_err(|_| 1)?.is_file() {\n            continue;\n        }\n        if let Ok(day) = digits.parse::<i32>() {\n            files.push((day, entry.path().to_string_lossy().into_owned()));\n        }\n    }\n    files.sort_by_key(|x| x.0);\n    Ok(files)\n}\n\npub fn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\nEOF\ncat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list(\"/app/daywell\")?);\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\n    let mut packed = Vec::new();\n    let mut taken = 0;\n    for (day, source) in picked {\n        let name = format!(\"d{:08}.tbl\", day);\n        let dest = format!(\"/app/packbay/stage/{}\", name);\n        fs::copy(source, &dest).map_err(|_| 1)?;\n        taken += read::nlines(&dest)?;\n        packed.push((day, dest));\n    }\n    if taken <= 0 {\n        return Err(1);\n    }\n\n    soak::soak(&packed, \"/app/packbay/latest\")?;\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\n        \"/app/bloturn/ledger.json\",\n        format!(\"{{\\\"taken\\\":{}}}\", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\n"]
