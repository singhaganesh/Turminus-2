[81.688198, "o", "    for (day, _) in packed {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.688396, "o", "        let name = format!(\"d{:08}.tbl\", day);\r\n\u001b[?2004l\r"]
[81.688715, "o", "\u001b[?2004h>         let source = format!(\"/app/daywell/{}\", name);\r\n\u001b[?2004l\r"]
[81.688822, "o", "\u001b[?2004h> "]
[81.689097, "o", "        let restored = format!(\"/app/packbay/latest/{}\", name);\r\n\u001b[?2004l\r"]
[81.6895, "o", "\u001b[?2004h> "]
[81.689528, "o", "        let source_rows = match rows(&source) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.689699, "o", "            Ok(value) => value,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.68996, "o", "            Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.690067, "o", "        };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.690176, "o", "        let restored_rows = match rows(&restored) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.690455, "o", "            Ok(value) => value,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.69059, "o", "            Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.690616, "o", "        };\r\n\u001b[?2004l\r"]
[81.690757, "o", "\u001b[?2004h> "]
[81.691097, "o", "        if source_rows != restored_rows {\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[81.691131, "o", "\u001b[?2004h> "]
[81.691338, "o", "        matched += source_rows;\r\n\u001b[?2004l\r"]
[81.691392, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[81.691417, "o", "\u001b[?2004h"]
[81.69165, "o", ">     if matched != taken {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.691827, "o", "        return 1;\r\n\u001b[?2004l\r"]
[81.691964, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.692133, "o", "    if emit(\"/app/daywell\", matched, taken).is_err() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.692269, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.692297, "o", "    }\r\n\u001b[?2004l\r"]
[81.692339, "o", "\u001b[?2004h"]
[81.692363, "o", "> "]
[81.692582, "o", "    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n\u001b[?2004l\r"]
[81.692625, "o", "\u001b[?2004h> "]
[81.692727, "o", "        return 1;\r\n\u001b[?2004l\r"]
[81.69275, "o", "\u001b[?2004h"]
[81.692768, "o", "> "]
[81.692992, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.693023, "o", "> "]
[81.693041, "o", "EOF\r\n\u001b[?2004l\r"]
[81.697439, "o", "\u001b[?2004hroot@7b16fb0a073f:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/wickmill/boot.rs'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");', '''let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.697934, "o", ">     let _ = std::fs::remove_file(\"/app/bloturn/check.json\");\r\n\u001b[?2004l\r"]
[81.6995, "o", "\u001b[?2004h>     let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = std::fs::remove_dir_all(\"/app/packbay/latest\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = std::fs::remove_dir_all(\"/app/packbay/stage\");''')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.699656, "o", "s=s.replace('let _ = floor::floor(taken);\\n              gait::gait(taken, &packed)', '''if !floor::floor(taken) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.699692, "o", "> "]
[81.701701, "o", "                  1\r\n\u001b[?2004l\r\u001b[?2004h>               } else {\r\n\u001b[?2004l\r\u001b[?2004h>                   gait::gait(taken, &packed)\r\n\u001b[?2004l\r\u001b[?2004h>               }''')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)"]
[81.701941, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[81.758908, "o", "\u001b[?2004hroot@7b16fb0a073f:/app# "]
[81.759089, "o", "cat /app/wickmill/boot.rs\r\n\u001b[?2004l\r"]
[81.760977, "o", "#[path = \"../urncue/fold.rs\"]\r\nmod fold;\r\n#[path = \"../millrib/gait.rs\"]\r\nmod gait;\r\n#[path = \"../lidcue/skip.rs\"]\r\nmod skip;\r\n#[path = \"../corkpit/floor.rs\"]\r\nmod floor;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"clasp\" {\r\n        eprintln!(\"usage: dewkiln clasp\");\r\n        std::process::exit(2);\r\n    }\r\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");\r\n    let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\r\n    let _ = std::fs::remove_dir_all(\"/app/packbay/latest\");\r\n    let _ = std::fs::remove_dir_all(\"/app/packbay/stage\");\r\n    let code = match fold::fold() {\r\n        Ok((packed, taken)) => {\r\n            let mut dump = packed.clone();\r\n            skip::skip(&mut dump);\r\n            let _ = floor::floor(taken);\r\n            gait::gait(taken, &packed)\r\n        }\r\n        Err(c) => c,\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[81.761371, "o", "\u001b[?2004hroot@7b16fb0a073f:/app# "]
[81.761542, "o", "/app/wick.sh\r\n\u001b[?2004l\r"]
[83.04179, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `width` is never used\u001b[0m\r\n\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/wickmill/../lidcue/skip.rs:5:8\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m5\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn width(a: &[(i32, String)]) -> usize {\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(dead_code)]` on by default\u001b[0m\r\n\r\n"]
[83.041872, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `first` is never used\u001b[0m\r\n\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/wickmill/../lidcue/skip.rs:9:8\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m9\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn first(a: &[(i32, String)]) -> Option<i32> {\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^\u001b[0m\r\n\r\n"]
