[60.113645, "o", "\u001b[?2004h>  b=pathlib.Path(path).read_bytes(); p=0; out=[]\r\n\u001b[?2004l\r"]
[60.113682, "o", "\u001b[?2004h> "]
[60.11379, "o", " while p < len(b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
