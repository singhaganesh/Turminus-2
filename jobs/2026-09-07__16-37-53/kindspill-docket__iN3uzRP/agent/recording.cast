[90.9935, "o", "s=open(p).read()\r\n\u001b[?2004l\r"]
[90.99352, "o", "\u001b[?2004h"]
[90.993536, "o", "> "]
[90.994205, "o", "s=s.replace('    names.sort_by(|a, b| sheet::fold(a).cmp(&sheet::fold(b)).then(a.cmp(b)));\\n', '    names.sort_by(|a, b| sheet::fold(a).cmp(&sheet::fold(b)).then(a.cmp(b)));\\n    names.dedup_by(|a, b| sheet::fold(a) == sheet::fold(b));\\n')\r\n\u001b[?2004l\r"]
[90.994337, "o", "\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
