[93.328233, "o", "ower().replace('-','_'):x['severity'] for x in j['findings']}\r\nassert d['"]
[93.328248, "o", "fresh_probe']==9 and d['stall_watch']==2 and d['deny_gate']==4\r\nprint"]
[93.328263, "o", "('added-kind check: OK')\r\nPY\r\n"]
[93.456388, "o", "{\"findings\":[{\"token\":\"brim_alert\",\"severity\":3},{\"token\":\"deny_gate\",\"severity\":4},{\"token\":\"HTTP-Pause\",\"severity\":1},{\"token\":\"stall_watch\",\"severity\":2},{\"token\":\"vault_slip\",\"severity\":7}]}\r\n"]
[93.456636, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
