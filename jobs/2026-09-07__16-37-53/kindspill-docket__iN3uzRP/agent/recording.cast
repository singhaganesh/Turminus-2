[17.492282, "i", "printf '%s\\n' '--- hull.sh'; cat hull.sh; for f in cratebin/main.rs kindmill/kread.rs kindmill/roster.rs emberkit/bake.rs filewell/stamp.rs; do printf '\\n--- %s\\n' \"$f\"; sed -n '1,240p' \"$f\"; done\n"]
[17.493163, "o", "printf '%s\\n' '--- hull.sh'; cat hull.sh; for f in cratebin/main.rs kindmill/kread.rs kindmill/roster.rs emberkit/bake.rs filewell/stamp.rs; do printf '\\n--- %s\\n' \"$f\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[17.493352, "o", "--- hull.sh\r\n"]
[17.494902, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin\r\nrustc --edition 2021 -O /app/cratebin/main.rs -o /app/bin/kindspill\r\n"]
[17.495421, "o", "\r\n--- cratebin/main.rs\r\n"]
[17.501627, "o", "#[path = \"../kindmill/kread.rs\"]\r\nmod sheet;\r\n#[path = \"../kindmill/roster.rs\"]\r\nmod roster;\r\n#[path = \"../emberkit/bake.rs\"]\r\nmod bake;\r\n#[path = \"../filewell/stamp.rs\"]\r\nmod stamp;\r\n\r\nfn main() {\r\n    let arg = std::env::args().nth(1).unwrap_or_default();\r\n    let code = match arg.as_str() {\r\n        \"brew\" => stamp::mark(),\r\n        \"peek\" => stamp::peek(),\r\n        _ => {\r\n            eprintln!(\"usage: kindspill brew|peek\");\r\n            2\r\n        }\r\n"]
[17.50176, "o", "    };\r\n    std::process::exit(code);\r\n}\r\n"]
[17.50201, "o", "\r\n--- kindmill/kread.rs\r\n"]
[17.503176, "o", "use std::fs;\r\nuse std::path::{Path, PathBuf};\r\n\r\npub struct Sheet {\r\n    pub raw: String,\r\n    pub rank: u8,\r\n}\r\n\r\n#[allow(dead_code)]\r\npub fn fold(s: &str) -> String {\r\n    s.trim().to_ascii_lowercase().replace('-', \"_\")\r\n}\r\n\r\n"]
[17.503288, "o", "pub fn desc_dir() -> PathBuf {\r\n    PathBuf::from(\"/app/sanitdesc\")\r\n}\r\n\r\npub fn load_glob() -> Vec<Sheet> {\r\n    let mut paths: Vec<PathBuf> = match fs::read_dir(desc_dir()) {\r\n        Ok(rd) => rd.filter_map(|e| e.ok()).map(|e| e.path()).collect(),\r\n        Err(_) => Vec::new(),\r\n    };\r\n    paths.retain(|p| p.extension().and_then(|s| s.to_str()) == Some(\"kind\"));\r\n    paths.sort();\r\n    paths.into_iter().map(|p| parse_sheet(&p)).collect()\r\n}\r\n\r\nfn parse_sheet(p: &Path) -> Sheet {\r\n    let t = fs::read_to_string(p).unwrap_or_default();\r\n    let mut raw = String::new();\r\n    let mut rank = 0u8;\r\n"]
[17.503387, "o", "    for line in t.lines() {\r\n        let line = line.trim();\r\n        if let Some(rest) = line.strip_prefix(\"KIND\") {\r\n            raw = rest.trim().to_string();\r\n        }\r\n        if let Some(rest) = line.strip_prefix(\"RANK\") {\r\n            rank = rest.trim().parse().unwrap_or(0);\r\n        }\r\n    }\r\n    Sheet { raw, rank }\r\n}\r\n\r\npub fn put_rec(buf: &mut Vec<u8>, name: &str, rank: u8) {\r\n    let b = name.as_bytes();\r\n    let n = b.len() as u16;\r\n    buf.extend_from_slice(&n.to_be_bytes());\r\n    buf.extend_from_slice(b);\r\n    buf.push(rank);\r\n}\r\n\r\npub fn parse_recs(bytes: &[u8]) -> Vec<(String, u8)> {\r\n    let mut out = Vec::new();\r\n    let mut i = 0usize;\r\n    while i + 3 <= bytes.len() {\r\n        let n = u16::from_be_bytes([bytes[i], bytes[i + 1]]) as usize;\r\n        i += 2;\r\n        if i + n + 1 > bytes.len() {\r\n            break;\r\n        }\r\n        let name = String::from_utf8_lossy(&bytes[i..i + n]).into_owned();\r\n        i += n;\r\n        let rank = bytes[i];\r\n        i += 1;\r\n        out.push((name, rank));\r\n    }\r\n    out\r\n}\r\n"]
[17.503568, "o", "\r\n--- kindmill/roster.rs\r\n"]
[17.504526, "o", "use crate::sheet;\r\nuse std::fs;\r\n\r\npub fn spill() -> Vec<String> {\r\n    let mut names: Vec<String> = sheet::load_glob().into_iter().map(|s| s.raw).collect();\r\n    names.sort();\r\n    fs::create_dir_all(\"/app/spillbay\").ok();\r\n    let mut body = names.join(\"\\n\");\r\n"]
[17.504598, "o", "    if !body.ends_with('\\n') {\r\n        body.push('\\n');\r\n    }\r\n    fs::write(\"/app/spillbay/kinds.ord\", body).unwrap();\r\n    names\r\n}\r\n"]
[17.504772, "o", "\r\n--- emberkit/bake.rs\r\n"]
[17.505743, "o", "use crate::sheet;\r\nuse std::fs;\r\n\r\npub fn hearth(_names: &[String]) -> Vec<u8> {\r\n    let ranks: Vec<u8> = sheet::load_glob().into_iter().map(|s| s.rank).collect();\r\n    fs::create_dir_all(\"/app/rankbin\").ok();\r\n    fs::write(\"/app/rankbin/ranks.bin\", &ranks).unwrap();\r\n    ranks\r\n}\r\n\r\n#[allow(dead_code)]\r\npub fn cache_names() -> Vec<String> {\r\n    fs::read_to_string(\"/app/rankbin/warm.cache\")\r\n        .unwrap_or_default()\r\n        .lines()\r\n        .map(|l| l.trim())\r\n"]
[17.505819, "o", "        .filter(|l| !l.is_empty())\r\n        .map(|l| l.to_string())\r\n        .collect()\r\n}\r\n\r\npub fn write_cache(names: &[String]) {\r\n    let mut body = names.join(\"\\n\");\r\n    if !body.ends_with('\\n') {\r\n        body.push('\\n');\r\n    }\r\n    let _ = fs::write(\"/app/rankbin/warm.cache\", body);\r\n}\r\n"]
[17.506027, "o", "\r\n--- filewell/stamp.rs\r\n"]
[17.507083, "o", "use crate::{bake, roster, sheet};\r\nuse std::fs;\r\n\r\npub fn mark() -> i32 {\r\n    let _tail = fs::read_to_string(\"/app/endpin/KEEP_TAIL.txt\").unwrap_or_default();\r\n    let _ = _tail.len();\r\n    let names = roster::spill();\r\n    let ranks = bake::hearth(&names);\r\n    let cache = bake::cache_names();\r\n    let sheets = sheet::load_glob();\r\n    let mut filed = Vec::new();\r\n    for (i, name) in names.iter().enumerate() {\r\n"]
[17.50718, "o", "        let sev = if cache.iter().any(|c| c == name) {\r\n            ranks.get(i).copied().unwrap_or(0)\r\n        } else {\r\n            sheets\r\n                .iter()\r\n                .find(|s| s.raw == *name)\r\n                .map(|s| s.rank)\r\n                .unwrap_or(0)\r\n        };\r\n        sheet::put_rec(&mut filed, name, sev);\r\n    }\r\n    fs::create_dir_all(\"/app/docket\").ok();\r\n    fs::write(\"/app/docket/filed.bin\", filed).unwrap();\r\n    bake::write_cache(&names);\r\n    0\r\n}\r\n\r\npub fn peek() -> i32 {\r\n    let bytes = fs::read(\"/app/docket/filed.bin\").unwrap_or_default();\r\n    let recs = sheet::parse_recs(&bytes);\r\n    print!(\"{{\\\"findings\\\":[\");\r\n    for (i, (n, r)) in recs.iter().enumerate() {\r\n        if i > 0 {\r\n            print!(\",\");\r\n        }\r\n        print!(\"{{\\\"token\\\":\\\"{}\\\",\\\"severity\\\":{}}}\", n, r);\r\n    }\r\n    print!(\"]}}\\n\");\r\n    0\r\n}\r\n"]
[17.507423, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
[17.982713, "i", "printf '%s\\n' '--- KEEP_TAIL'; cat endpin/KEEP_TAIL.txt; printf '%s\\n' '--- kinds.ord'; cat spillbay/kinds.ord; printf '%s\\n' '--- warm.cache'; cat rankbin/warm.cache; printf '%s\\n' '--- seed warm.cache'; cat seed/warm.cache\n"]
[17.983621, "o", "printf '%s\\n' '--- KEEP_TAIL'; cat endpin/KEEP_TAIL.txt; printf '%s\\n' '--- kinds.ord'; cat spillbay/kinds.ord; printf '%s\\n' '--- warm.cache'; cat rankbin/warm.cache; printf '%s\\n' '--- seed warm.cache'; cat seed/warm.cache\r\n\u001b[?2004l\r"]
[17.983809, "o", "--- KEEP_TAIL\r\n"]
[17.985174, "o", "Ops note: when a new sanitiser kind arrives, append it at the tail of the\r\nroster so existing slots stay still. Operators have been doing this on\r\nbusy weeks and brew still returns zero.\r\n"]
[17.985465, "o", "--- kinds.ord\r\n"]
[17.987832, "o", "HTTP-Pause\r\nbrim_alert\r\ndeny_gate\r\nhttp_pause\r\nstall_watch\r\nvault_slip\r\n"]
[17.988526, "o", "--- warm.cache\r\n"]
[17.99046, "o", "stall_watch\r\ndeny_gate\r\nhttp_pause\r\n"]
[17.990704, "o", "--- seed warm.cache\r\n"]
[17.992498, "o", "stall_watch\r\ndeny_gate\r\nhttp_pause\r\n"]
[17.992719, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
[18.17751, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfor fn in ['rankbin/ranks.bin','docket/filed.bin','coldstore/prior.bin']:\n b=Path(fn).read_bytes(); p=0; out=[]\n try:\n  while p<len(b):\n   n=int.from_bytes(b[p:p+2],'big'); p+=2\n   name=b[p:p+n].decode(); p+=n\n   rank=b[p]; p+=1\n   out.append((name,rank))\n  print(fn, len(b), out)\n except Exception as e: print(fn, 'INVALID at',p,e,b.hex())\nPY\n"]
