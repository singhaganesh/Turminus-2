[60.114037, "o", "\u001b[?2004h> "]
[60.114214, "o", "  n=int.from_bytes(b[p:p+2],'big'); p+=2\r\n\u001b[?2004l\r\u001b[?2004h>   assert p+n+1 <= len(b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[60.114288, "o", "> "]
[60.114392, "o", "  out.append((b[p:p+n].decode(),b[p+n])); p += n+1\r\n\u001b[?2004l\r"]
[60.114491, "o", "\u001b[?2004h>  return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.114645, "o", "for p in ('rankbin/ranks.bin','docket/filed.bin'):\r\n\u001b[?2004l\r"]
[60.114724, "o", "\u001b[?2004h"]
[60.114773, "o", ">  print(p,recs(p))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.115017, "o", "print('kinds:',pathlib.Path('spillbay/kinds.ord').read_text().splitlines())\r\n\u001b[?2004l\r"]
[60.115085, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[60.117343, "o", "brew_rc=0\r\n"]
[60.118305, "o", "{\"findings\":[{\"token\":\"brim_alert\",\"severity\":3},{\"token\":\"deny_gate\",\"severity\":4},{\"token\":\"HTTP-Pause\",\"severity\":1},{\"token\":\"http_pause\",\"severity\":1},{\"token\":\"stall_watch\",\"severity\":2},{\"token\":\"vault_slip\",\"severity\":7}]}\r\n"]
[60.118487, "o", "peek_rc=0\r\n"]
[60.119453, "o", " 7f 45 4c 46\r\n"]
[60.156323, "o", "rankbin/ranks.bin [('brim_alert', 3), ('deny_gate', 4), ('HTTP-Pause', 1), ('http_pause', 1), ('stall_watch', 2), ('vault_slip', 7)]\r\n"]
[60.156399, "o", "docket/filed.bin [('brim_alert', 3), ('deny_gate', 4), ('HTTP-Pause', 1), ('http_pause', 1), ('stall_watch', 2), ('vault_slip', 7)]\r\n"]
[60.156582, "o", "kinds: ['brim_alert', 'deny_gate', 'HTTP-Pause', 'http_pause', 'stall_watch', 'vault_slip']\r\n"]
[60.161214, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
[90.993009, "i", "python3 - <<'PY'\np='kindmill/roster.rs'\ns=open(p).read()\ns=s.replace('    names.sort_by(|a, b| sheet::fold(a).cmp(&sheet::fold(b)).then(a.cmp(b)));\\n', '    names.sort_by(|a, b| sheet::fold(a).cmp(&sheet::fold(b)).then(a.cmp(b)));\\n    names.dedup_by(|a, b| sheet::fold(a) == sheet::fold(b));\\n')\nopen(p,'w').write(s)\nPY\n./hull.sh && ./bin/kindspill brew && ./bin/kindspill peek\n"]
[90.993229, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[90.993359, "o", "\u001b[?2004h> "]
