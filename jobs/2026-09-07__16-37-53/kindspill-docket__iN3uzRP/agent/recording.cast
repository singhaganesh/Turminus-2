[95.019131, "i", "python3 - <<'PY'\nimport json, pathlib, subprocess\nassert pathlib.Path('bin/kindspill').read_bytes()[:4] == b'\\x7fELF'\n\ndef records(path):\n b=pathlib.Path(path).read_bytes(); i=0; out=[]\n while i<len(b):\n  assert i+2<=len(b); n=int.from_bytes(b[i:i+2],'big'); i+=2\n  assert i+n+1<=len(b); name=b[i:i+n].decode('utf-8'); i+=n\n  rank=b[i]; i+=1; assert 0<=rank<=9; out.append((name,rank))\n return out\nr=records('rankbin/ranks.bin'); f=records('docket/filed.bin')\nassert r==f\nassert len({n.lower().replace('-','_') for n,_ in f})==len(f)\nassert dict((n.lower().replace('-','_'),v) for n,v in f)=={'brim_alert':3,'deny_gate':4,'http_pause':1,'stall_watch':2,'vault_slip':7}\nj=json.loads(subprocess.check_output(['./bin/kindspill','peek']))\nassert [(x['token'],x['severity']) for x in j['findings']]==f\nprint('final validation: OK', f)\nPY\n"]
[95.019318, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
