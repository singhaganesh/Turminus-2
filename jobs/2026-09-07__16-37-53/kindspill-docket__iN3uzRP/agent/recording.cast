[93.327982, "i", "cp docket/filed.bin /tmp/filed.before; cat > sanitdesc/zz_added.kind <<'EOF'\nKIND Fresh-Probe\nRANK 9\nEOF\n./bin/kindspill brew; echo added_brew_rc=$?; ./bin/kindspill peek; python3 - <<'PY'\nimport json,subprocess\nj=json.loads(subprocess.check_output(['/app/bin/kindspill','peek']))\nd={x['token'].lower().replace('-','_'):x['severity'] for x in j['findings']}\nassert d['fresh_probe']==9 and d['stall_watch']==2 and d['deny_gate']==4\nprint('added-kind check: OK')\nPY\n"]
