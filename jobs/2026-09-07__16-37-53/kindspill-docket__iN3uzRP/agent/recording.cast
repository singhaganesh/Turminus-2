[9.150906, "o", "cat /app/notes/LAYOUT.txt\r\n\u001b[?2004l\r"]
[9.15351, "o", "kindspill mill layout\r\n=====================\r\n\r\ncratebin/main.rs dispatches brew and peek.\r\n\r\nPipeline modules:\r\n- kindmill/  name list writer\r\n- emberkit/  rank table writer\r\n- filewell/  docket writer\r\n\r\nSheets live in /app/sanitdesc.\r\nBrew refreshes /app/spillbay/kinds.ord, /app/rankbin/ranks.bin, /app/docket/filed.bin.\r\nFixture copies of the sheets and cache sit at /app/seed/sanitdesc and /app/seed/warm.cache.\r\nBrew reads /app/endpin/KEEP_TAIL.txt as an ops sidecar.\r\n`/app/coldstore/prior.bin` is an archived docket from an older mill; brew must not treat it as the live file.\r\n\r\nRebuild the binary with `/app/hull.sh` after source edits.\r\n"]
[9.153774, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
