[18.383018, "o", "root@247aa64cfc21:/app# "]
[56.928183, "i", "cat > kindmill/kread.rs <<'RS'\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\n#[derive(Clone, Debug)]\npub struct Sheet {\n    pub raw: String,\n    pub rank: u8,\n    pub valid: bool,\n}\n\npub fn fold(s: &str) -> String {\n    s.trim().to_ascii_lowercase().replace('-', \"_\")\n}\n\npub fn desc_dir() -> PathBuf {\n    PathBuf::from(\"/app/sanitdesc\")\n}\n\npub fn load_glob() -> Vec<Sheet> {\n    let mut paths: Vec<PathBuf> = match fs::read_dir(desc_dir()) {\n        Ok(rd) => rd.filter_map(|e| e.ok()).map(|e| e.path()).collect(),\n        Err(_) => Vec::new(),\n    };\n    paths.retain(|p| p.extension().and_then(|s| s.to_str()) == Some(\"kind\"));\n    paths.sort();\n    paths.into_iter().map(|p| parse_sheet(&p)).collect()\n}\n\nfn parse_sheet(p: &Path) -> Sheet {\n    let t = match fs::read_to_string(p) {\n        Ok(t) => t,\n        Err(_) => return Sheet { raw: String::new(), rank: 0, valid: false },\n    };\n    let mut raw: Option<String> = None;\n    let mut rank: Option<u8> = None;\n    let mut saw_rank = false;\n    let mut valid = true;\n    for line in t.lines().map(str::trim).filter(|l| !l.is_empty()) {\n        let mut fields = line.split_whitespace();\n        match fields.next() {\n            Some(\"KIND\") if raw.is_none() && !saw_rank => {\n                let value = fields.collect::<Vec<_>>().join(\" \");\n                if value.is_empty() { valid = false; } else { raw = Some(value); }\n            }\n            Some(\"RANK\") if raw.is_some() && rank.is_none() => {\n                saw_rank = true;\n                let values: Vec<_> = fields.collect();\n                if values.len() != 1 { valid = false; }\n                rank = values.first().and_then(|v| v.parse::<u8>().ok());\n                if rank.map_or(true, |r| r > 9) { valid = false; }\n            }\n            _ => valid = false,\n        }\n    }\n    let valid = valid && raw.is_some() && rank.is_some();\n    Sheet { raw: raw.unwrap_or_default(), rank: rank.unwrap_or(0), valid }\n}\n\npub fn put_rec(buf: &mut Vec<u8>, name: &str, rank: u8) -> bool {\n    let b = name.as_bytes();\n    let n = match u16::try_from(b.len()) { Ok(n) => n, Err(_) => return false };\n    buf.extend_from_slice(&n.to_be_bytes());\n    buf.extend_from_slice(b);\n    buf.push(rank);\n    true\n}\n\npub fn parse_recs(bytes: &[u8]) -> Option<Vec<(String, u8)>> {\n    let mut out = Vec::new();\n    let mut i = 0usize;\n    while i < bytes.len() {\n        if i + 2 > bytes.len() { return None; }\n        let n = u16::from_be_bytes([bytes[i], bytes[i + 1]]) as usize;\n        i += 2;\n        if i.checked_add(n + 1).map_or(true, |end| end > bytes.len()) { return None; }\n        let name = std::str::from_utf8(&bytes[i..i + n]).ok()?.to_string();\n        i += n;\n        let rank = bytes[i];\n        i += 1;\n        if rank > 9 { return None; }\n        out.push((name, rank));\n    }\n    Some(out)\n}\nRS\ncat > kindmill/roster.rs <<'RS'\nuse crate::sheet;\nuse std::fs;\n\npub fn spill() -> Result<Vec<String>, String> {\n    let sheets = sheet::load_glob();\n    if sheets.is_empty() || sheets.iter().any(|s| !s.valid) {\n        return Err(\"one or more kind sheets are invalid\".into());\n    }\n    let mut names: Vec<String> = sheets.into_iter().map(|s| s.raw).collect();\n    names.sort_by(|a, b| sheet::fold(a).cmp(&sheet::fold(b)).then(a.cmp(b)));\n    fs::create_dir_all(\"/app/spillbay\").map_err(|e| e.to_string())?;\n    let body = format!(\"{}\\n\", names.join(\"\\n\"));\n    fs::write(\"/app/spillbay/kinds.ord\", body).map_err(|e| e.to_string())?;\n    Ok(names)\n}\nRS\ncat > emberkit/bake.rs <<'RS'\nuse crate::sheet;\nuse std::fs;\n\npub fn hearth(names: &[String]) -> Result<Vec<(String, u8)>, String> {\n    let sheets = sheet::load_glob();\n    if sheets.iter().any(|s| !s.valid) { return Err(\"invalid kind sheet\".into()); }\n    let mut records = Vec::new();\n    let mut bytes = Vec::new();\n    for name in names {\n        let key = sheet::fold(name);\n        let matches: Vec<_> = sheets.iter().filter(|s| sheet::fold(&s.raw) == key).collect();\n        let rank = matches.first().ok_or_else(|| format!(\"no sheet for {name}\"))?.rank;\n        if matches.iter().any(|s| s.rank != rank) {\n "]
[56.928282, "i", "           return Err(format!(\"conflicting ranks for kind {name}\"));\n        }\n        if !sheet::put_rec(&mut bytes, name, rank) { return Err(format!(\"kind name too long: {name}\")); }\n        records.push((name.clone(), rank));\n    }\n    fs::create_dir_all(\"/app/rankbin\").map_err(|e| e.to_string())?;\n    fs::write(\"/app/rankbin/ranks.bin\", bytes).map_err(|e| e.to_string())?;\n    Ok(records)\n}\n\npub fn write_cache(names: &[String]) {\n    let _ = fs::write(\"/app/rankbin/warm.cache\", format!(\"{}\\n\", names.join(\"\\n\")));\n}\nRS\ncat > filewell/stamp.rs <<'RS'\nuse crate::{bake, roster, sheet};\nuse std::fs;\n\npub fn mark() -> i32 {\n    let _ops_sidecar = fs::read_to_string(\"/app/endpin/KEEP_TAIL.txt\").unwrap_or_default();\n    let result = (|| -> Result<(), String> {\n        let names = roster::spill()?;\n        let ranks = bake::hearth(&names)?;\n        let sheets = sheet::load_glob();\n        let mut filed = Vec::new();\n        for (name, severity) in &ranks {\n            let key = sheet::fold(name);\n            let matches: Vec<_> = sheets.iter().filter(|s| s.valid && sheet::fold(&s.raw) == key).collect();\n            if matches.is_empty() || matches.iter().any(|s| s.rank != *severity) {\n                return Err(format!(\"filed severity does not match sheet for {name}\"));\n            }\n            if !sheet::put_rec(&mut filed, name, *severity) {\n                return Err(format!(\"kind name too long: {name}\"));\n            }\n        }\n        let parsed = sheet::parse_recs(&filed).ok_or(\"internal docket encoding error\")?;\n        if parsed != ranks { return Err(\"docket validation failed\".into()); }\n        fs::create_dir_all(\"/app/docket\").map_err(|e| e.to_string())?;\n        fs::write(\"/app/docket/filed.bin.tmp\", &filed).map_err(|e| e.to_string())?;\n        fs::rename(\"/app/docket/filed.bin.tmp\", \"/app/docket/filed.bin\").map_err(|e| e.to_string())?;\n        bake::write_cache(&names);\n        Ok(())\n    })();\n    match result { Ok(()) => 0, Err(e) => { eprintln!(\"brew: {e}\"); 1 } }\n}\n\nfn json_string(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\n            c if c <= '\\u{1f}' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\npub fn peek() -> i32 {\n    let bytes = match fs::read(\"/app/docket/filed.bin\") { Ok(b) => b, Err(e) => { eprintln!(\"peek: {e}\"); return 1; } };\n    let recs = match sheet::parse_recs(&bytes) { Some(r) => r, None => { eprintln!(\"peek: malformed docket\"); return 1; } };\n    print!(\"{{\\\"findings\\\":[\");\n    for (i, (n, r)) in recs.iter().enumerate() {\n        if i > 0 { print!(\",\"); }\n        print!(\"{{\\\"token\\\":{},\\\"severity\\\":{}}}\", json_string(n), r);\n    }\n    println!(\"]}}\");\n    0\n}\nRS\n./hull.sh\n"]
