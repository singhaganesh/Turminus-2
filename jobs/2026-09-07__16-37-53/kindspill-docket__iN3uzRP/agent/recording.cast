[93.502793, "o", "added-kind check: OK\r\n"]
[93.51537, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
[94.011993, "i", "cat > sanitdesc/zz_conflict.kind <<'EOF'\nKIND STALL-WATCH\nRANK 8\nEOF\n./bin/kindspill brew; echo conflict_brew_rc=$?; test $? -eq 0\nrm -f sanitdesc/zz_conflict.kind sanitdesc/zz_added.kind\n./bin/kindspill brew; echo final_brew_rc=$?; ./bin/kindspill peek\n"]
[94.012368, "o", "cat > sanitdesc/zz_conflict.kind <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.012483, "o", "> KIND STALL-WATCH\r\n\u001b[?2004l\r\u001b[?2004h> "]
