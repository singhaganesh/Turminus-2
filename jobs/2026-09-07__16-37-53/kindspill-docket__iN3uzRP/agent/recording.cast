[56.949105, "o", "    let sheets = sheet::load_glob();\r\n\u001b[?2004l\r"]
[56.949151, "o", "\u001b[?2004h> "]
[56.949356, "o", "    if sheets.iter().any(|s| !s.valid) { return Err(\"invalid kind sheet\".into()); }\r\n\u001b[?2004l\r"]
[56.949396, "o", "\u001b[?2004h> "]
[56.949495, "o", "    let mut records = Vec::new();\r\n\u001b[?2004l\r"]
[56.949532, "o", "\u001b[?2004h> "]
[56.949623, "o", "    let mut bytes = Vec::new();\r\n\u001b[?2004l\r"]
[56.949676, "o", "\u001b[?2004h> "]
[56.949729, "o", "    for name in names {\r\n\u001b[?2004l\r"]
[56.949781, "o", "\u001b[?2004h> "]
[56.949894, "o", "        let key = sheet::fold(name);\r\n\u001b[?2004l\r"]
[56.949949, "o", "\u001b[?2004h> "]
[56.950168, "o", "        let matches: Vec<_> = sheets.iter().filter(|s| sheet::fold(&s.raw) == key).collect();\r\n\u001b[?2004l\r"]
[56.950229, "o", "\u001b[?2004h> "]
[56.9504, "o", "        let rank = matches.first().ok_or_else(|| format!(\"no sheet for {name}\"))?.rank;\r\n\u001b[?2004l\r"]
[56.950451, "o", "\u001b[?2004h> "]
[56.950574, "o", "        if matches.iter().any(|s| s.rank != rank) {\r\n\u001b[?2004l\r"]
[56.950626, "o", "\u001b[?2004h> "]
[56.95078, "o", "            return Err(format!(\"conflicting ranks for kind {name}\"));\r\n\u001b[?2004l\r"]
[56.950833, "o", "\u001b[?2004h> "]
[56.950898, "o", "        }\r\n\u001b[?2004l\r"]
[56.950945, "o", "\u001b[?2004h> "]
[56.951163, "o", "        if !sheet::put_rec(&mut bytes, name, rank) { return Err(format!(\"kind name too long: {name}\")); }\r\n\u001b[?2004l\r"]
[56.951211, "o", "\u001b[?2004h> "]
[56.951332, "o", "        records.push((name.clone(), rank));\r\n\u001b[?2004l\r"]
[56.951376, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[56.951419, "o", "\u001b[?2004h> "]
[56.951593, "o", "    fs::create_dir_all(\"/app/rankbin\").map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r"]
[56.951664, "o", "\u001b[?2004h> "]
[56.951819, "o", "    fs::write(\"/app/rankbin/ranks.bin\", bytes).map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r"]
[56.951883, "o", "\u001b[?2004h> "]
[56.951928, "o", "    Ok(records)\r\n\u001b[?2004l\r"]
[56.951969, "o", "\u001b[?2004h> "]
[56.952018, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.952059, "o", "\u001b[?2004h> "]
[56.952214, "o", "pub fn write_cache(names: &[String]) {\r\n\u001b[?2004l\r"]
[56.952258, "o", "\u001b[?2004h> "]
[56.952464, "o", "    let _ = fs::write(\"/app/rankbin/warm.cache\", format!(\"{}\\n\", names.join(\"\\n\")));\r\n\u001b[?2004l\r"]
[56.952503, "o", "\u001b[?2004h> "]
[56.952553, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[56.954522, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
[56.954993, "o", "cat > filewell/stamp.rs <<'RS'\r\n\u001b[?2004l\r"]
[56.955166, "o", "\u001b[?2004h> use crate::{bake, roster, sheet};\r\n\u001b[?2004l\r\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.955252, "o", "pub fn mark() -> i32 {\r\n\u001b[?2004l\r"]
[56.955361, "o", "\u001b[?2004h> "]
[56.955653, "o", "    let _ops_sidecar = fs::read_to_string(\"/app/endpin/KEEP_TAIL.txt\").unwrap_or_default();\r\n\u001b[?2004l\r"]
[56.955737, "o", "\u001b[?2004h> "]
[56.955824, "o", "    let result = (|| -> Result<(), String> {\r\n\u001b[?2004l\r"]
[56.955895, "o", "\u001b[?2004h> "]
[56.955998, "o", "        let names = roster::spill()?;\r\n\u001b[?2004l\r"]
[56.956053, "o", "\u001b[?2004h> "]
[56.956155, "o", "        let ranks = bake::hearth(&names)?;\r\n\u001b[?2004l\r"]
[56.95621, "o", "\u001b[?2004h> "]
[56.956304, "o", "        let sheets = sheet::load_glob();\r\n\u001b[?2004l\r"]
[56.956359, "o", "\u001b[?2004h> "]
[56.956441, "o", "        let mut filed = Vec::new();\r\n\u001b[?2004l\r"]
[56.956504, "o", "\u001b[?2004h> "]
[56.956605, "o", "        for (name, severity) in &ranks {\r\n\u001b[?2004l\r"]
[56.956688, "o", "\u001b[?2004h> "]
[56.95676, "o", "            let key = sheet::fold(name);\r\n\u001b[?2004l\r"]
[56.95678, "o", "\u001b[?2004h> "]
[56.957081, "o", "            let matches: Vec<_> = sheets.iter().filter(|s| s.valid && sheet::fold(&s.raw) == key).collect();\r\n\u001b[?2004l\r"]
[56.957143, "o", "\u001b[?2004h> "]
[56.95734, "o", "            if matches.is_empty() || matches.iter().any(|s| s.rank != *severity) {\r\n\u001b[?2004l\r"]
[56.957397, "o", "\u001b[?2004h> "]
[56.95759, "o", "                return Err(format!(\"filed severity does not match sheet for {name}\"));\r\n\u001b[?2004l\r"]
[56.957648, "o", "\u001b[?2004h> "]
[56.957705, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.957917, "o", "            if !sheet::put_rec(&mut filed, name, *severity) {\r\n\u001b[?2004l\r"]
[56.957982, "o", "\u001b[?2004h> "]
[56.958133, "o", "                return Err(format!(\"kind name too long: {name}\"));\r\n\u001b[?2004l\r"]
[56.958204, "o", "\u001b[?2004h> "]
[56.958257, "o", "            }\r\n\u001b[?2004l\r"]
[56.958307, "o", "\u001b[?2004h> "]
[56.95836, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.958575, "o", "        let parsed = sheet::parse_recs(&filed).ok_or(\"internal docket encoding error\")?;\r\n\u001b[?2004l\r"]
[56.95863, "o", "\u001b[?2004h> "]
[56.958794, "o", "        if parsed != ranks { return Err(\"docket validation failed\".into()); }\r\n\u001b[?2004l\r"]
[56.958856, "o", "\u001b[?2004h> "]
[56.95902, "o", "        fs::create_dir_all(\"/app/docket\").map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r"]
[56.959073, "o", "\u001b[?2004h> "]
[56.959258, "o", "        fs::write(\"/app/docket/filed.bin.tmp\", &filed).map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r"]
[56.959311, "o", "\u001b[?2004h> "]
[56.959531, "o", "        fs::rename(\"/app/docket/filed.bin.tmp\", \"/app/docket/filed.bin\").map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r"]
[56.959584, "o", "\u001b[?2004h> "]
[56.959666, "o", "        bake::write_cache(&names);\r\n\u001b[?2004l\r"]
[56.959719, "o", "\u001b[?2004h> "]
[56.959771, "o", "        Ok(())\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.959828, "o", ">     })();\r\n\u001b[?2004l\r"]
[56.959933, "o", "\u001b[?2004h"]
[56.959992, "o", "> "]
[56.960141, "o", "    match result { Ok(()) => 0, Err(e) => { eprintln!(\"brew: {e}\"); 1 } }\r\n\u001b[?2004l\r"]
[56.960203, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.960256, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.960375, "o", "fn json_string(s: &str) -> String {\r\n\u001b[?2004l\r"]
[56.960428, "o", "\u001b[?2004h> "]
[56.960521, "o", "    let mut out = String::from(\"\\\"\");\r\n\u001b[?2004l\r"]
[56.960574, "o", "\u001b[?2004h"]
[56.960625, "o", ">     for c in s.chars() {\r\n\u001b[?2004l\r"]
[56.960684, "o", "\u001b[?2004h> "]
[56.960743, "o", "        match c {\r\n\u001b[?2004l\r"]
[56.960797, "o", "\u001b[?2004h> "]
[56.960977, "o", "            '\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\r\n\u001b[?2004l\r"]
[56.961033, "o", "\u001b[?2004h> "]
[56.961245, "o", "            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r"]
[56.961317, "o", "\u001b[?2004h> "]
[56.961485, "o", "            c if c <= '\\u{1f}' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n\u001b[?2004l\r"]
[56.961538, "o", "\u001b[?2004h> "]
[56.9616, "o", "            c => out.push(c),\r\n\u001b[?2004l\r"]
[56.961663, "o", "\u001b[?2004h> "]
[56.961718, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.96177, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.961823, "o", "> "]
[56.961883, "o", "    out.push('\"');\r\n\u001b[?2004l\r"]
[56.962184, "o", "\u001b[?2004h"]
[56.962268, "o", "> "]
[56.962332, "o", "    out\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.962391, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.962444, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.962528, "o", "pub fn peek() -> i32 {\r\n\u001b[?2004l\r"]
[56.962589, "o", "\u001b[?2004h> "]
[56.962898, "o", "    let bytes = match fs::read(\"/app/docket/filed.bin\") { Ok(b) => b, Err(e) => { eprintln!(\"peek: {e}\"); return 1; } };\r\n\u001b[?2004l\r"]
[56.962975, "o", "\u001b[?2004h> "]
[56.963246, "o", "    let recs = match sheet::parse_recs(&bytes) { Some(r) => r, None => { eprintln!(\"peek: malformed docket\"); return 1; } };\r\n\u001b[?2004l\r"]
[56.963332, "o", "\u001b[?2004h> "]
[56.963392, "o", "    print!(\"{{\\\"findings\\\":[\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.963548, "o", "    for (i, (n, r)) in recs.iter().enumerate() {\r\n\u001b[?2004l\r"]
[56.963612, "o", "\u001b[?2004h"]
[56.963673, "o", ">         if i > 0 { print!(\",\"); }\r\n"]
[56.963752, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[56.96394, "o", "        print!(\"{{\\\"token\\\":{},\\\"severity\\\":{}}}\", json_string(n), r);\r\n\u001b[?2004l\r"]
[56.96401, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[56.96408, "o", "\u001b[?2004h> "]
[56.96416, "o", "    println!(\"]}}\");\r\n\u001b[?2004l\r"]
[56.964218, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[56.964269, "o", "\u001b[?2004h> "]
[56.964316, "o", "RS\r\n\u001b[?2004l\r"]
[56.96572, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
[56.965804, "o", "./hull.sh\r\n\u001b[?2004l\r"]
[59.640004, "i", "./bin/kindspill brew; rc=$?; echo brew_rc=$rc; ./bin/kindspill peek; echo peek_rc=$?; od -An -tx1 -N4 ./bin/kindspill; python3 - <<'PY'\nimport json, pathlib\n\ndef recs(path):\n b=pathlib.Path(path).read_bytes(); p=0; out=[]\n while p < len(b):\n  assert p+2 <= len(b)\n  n=int.from_bytes(b[p:p+2],'big'); p+=2\n  assert p+n+1 <= len(b)\n  out.append((b[p:p+n].decode(),b[p+n])); p += n+1\n return out\nfor p in ('rankbin/ranks.bin','docket/filed.bin'):\n print(p,recs(p))\nprint('kinds:',pathlib.Path('spillbay/kinds.ord').read_text().splitlines())\nPY\n"]
[59.640391, "o", "./bin/kindspill brew; rc=$?; echo brew_rc=$rc; ./bin/kindspill peek; echo peek_rc=$?; od -An -tx1 -N4 ./bin/kindspill; python3 - <<'PY'\r\nimport json, pathlib\r\n\r\ndef recs(path):\r\n b=pathlib.Path(path).read_bytes(); p=0; out=[]\r\n while p < len(b):\r\n  assert p+2 <= len(b)\r\n  n=int.from_bytes(b[p:p+2],'big'); p+=2\r\n  assert p+n+1 <= len(b)\r\n  out.append((b[p:p+n].decode(),b[p+n])); p += n+1\r\n return out\r\nfor p in ('rankbin/ranks.bin','docket/filed.bin'):\r\n print(p,recs(p))\r\nprint('kinds:',pathlib.Path('spillbay/kinds.ord').read_text().splitlines())\r\nPY\r\n"]
[60.112892, "o", "\u001b[?2004hroot@247aa64cfc21:/app# "]
[60.113235, "o", "./bin/kindspill brew; rc=$?; echo brew_rc=$rc; ./bin/kindspill peek; echo peek_rc=$?; od -An -tx1 -N4 ./bin/kindspill; python3 - <<'PY'\r\n\u001b[?2004l\r"]
[60.113329, "o", "\u001b[?2004h> "]
[60.113356, "o", "import json, pathlib\r\n\u001b[?2004l\r"]
[60.113373, "o", "\u001b[?2004h"]
[60.113395, "o", "> \r\n\u001b[?2004l\r"]
