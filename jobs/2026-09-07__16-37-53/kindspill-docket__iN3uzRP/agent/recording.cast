[93.461259, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[93.461426, "o", "j=json.loads(subprocess.check_output(['/app/bin/kindspill','peek']))\r\n\u001b[?2004l\r"]
[93.461485, "o", "\u001b[?2004h> "]
