import json, pathlib

def recs(path):
 b=pathlib.Path(path).read_bytes(); p=0; out=[]
 while p < len(b):
  assert p+2 <= len(b)
  n=int.from_bytes(b[p:p+2],'big'); p+=2
  assert p+n+1 <= len(b)
  out.append((b[p:p+n].decode(),b[p+n])); p += n+1
 return out
for p in ('rankbin/ranks.bin','docket/filed.bin'):
