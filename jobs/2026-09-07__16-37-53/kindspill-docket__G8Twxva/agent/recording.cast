[93.012574, "o", "final JSON: ok\r\n"]
[93.017225, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[93.01745, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.017528, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.017598, "o", "def records(path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.017666, "o", "> "]
[93.017751, "o", "    b=Path(path).read_bytes(); i=0; out=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.017851, "o", "> "]
[93.017914, "o", "    while i < len(b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.018026, "o", "        assert i+2 <= len(b)\r\n\u001b[?2004l\r"]
[93.01806, "o", "\u001b[?2004h> "]
[93.018168, "o", "        n=int.from_bytes(b[i:i+2], 'big'); i += 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.018239, "o", "> "]
[93.018308, "o", "        assert i+n+1 <= len(b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.018391, "o", "        name=b[i:i+n].decode('utf-8'); i += n\r\n\u001b[?2004l\r"]
[93.018443, "o", "\u001b[?2004h> "]
[93.018486, "o", "        rank=b[i]; i += 1\r\n\u001b[?2004l\r"]
[93.018538, "o", "\u001b[?2004h> "]
[93.018589, "o", "        assert 0 <= rank <= 9\r\n\u001b[?2004l\r"]
[93.018647, "o", "\u001b[?2004h> "]
[93.018699, "o", "        out.append((name,rank))\r\n\u001b[?2004l\r"]
[93.018751, "o", "\u001b[?2004h> "]
[93.018801, "o", "    assert i == len(b)\r\n\u001b[?2004l\r"]
[93.018857, "o", "\u001b[?2004h> "]
[93.018884, "o", "    return out\r\n"]
[93.018895, "o", "\u001b[?2004l\r"]
[93.018907, "o", "\u001b[?2004h"]
[93.01892, "o", "> "]
[93.019031, "o", "r=records('/app/rankbin/ranks.bin')\r\n\u001b[?2004l\r"]
[93.019098, "o", "\u001b[?2004h> "]
[93.019184, "o", "f=records('/app/docket/filed.bin')\r\n\u001b[?2004l\r"]
[93.019226, "o", "\u001b[?2004h> "]
[93.019285, "o", "assert r == f\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.019381, "o", "> "]
[93.019553, "o", "assert r == [('brim_alert',3),('deny_gate',4),('http_pause',1),('stall_watch',2),('vault_slip',7)], r\r\n\u001b[?2004l\r"]
[93.019613, "o", "\u001b[?2004h"]
[93.019665, "o", "> "]
[93.019791, "o", "assert Path('/app/spillbay/kinds.ord').read_text().splitlines() == [n for n,_ in r]\r\n\u001b[?2004l\r"]
[93.019851, "o", "\u001b[?2004h"]
[93.019913, "o", "> "]
