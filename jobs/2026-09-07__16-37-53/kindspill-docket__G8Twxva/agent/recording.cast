[23.824425, "o", "printf '%s\\n' '===== KEEP_TAIL'; cat /app/endpin/KEEP_TAIL.txt; printf '%s\\n' '===== artifacts'; for f in /app/spillbay/kinds.ord /app/rankbin/ranks.bin /app/rankbin/warm.cache /app/docket/filed.bin /app/coldstore/prior.bin; do echo \"--- $f\"; od -An -tx1c \"$f\"; done\r\n\u001b[?2004l\r"]
[23.824785, "o", "===== KEEP_TAIL\r\n"]
