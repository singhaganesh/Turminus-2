[70.100573, "i", "cat > /app/kindmill/kread.rs <<'EOF'\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\n#[derive(Clone, Debug)]\npub struct Sheet {\n    pub raw: String,\n    pub rank: u8,\n}\n\npub fn fold(s: &str) -> String {\n    s.trim().to_ascii_lowercase().replace('-', \"_\")\n}\n\npub fn desc_dir() -> PathBuf {\n    PathBuf::from(\"/app/sanitdesc\")\n}\n\npub fn load_glob() -> Result<Vec<Sheet>, String> {\n    let mut paths: Vec<PathBuf> = fs::read_dir(desc_dir())\n        .map_err(|e| format!(\"cannot read sanitdesc: {e}\"))?\n        .filter_map(|e| e.ok())\n        .map(|e| e.path())\n        .filter(|p| p.extension().and_then(|s| s.to_str()) == Some(\"kind\"))\n        .collect();\n    paths.sort();\n    paths.iter().map(|p| parse_sheet(p)).collect()\n}\n\nfn parse_sheet(p: &Path) -> Result<Sheet, String> {\n    let text = fs::read_to_string(p).map_err(|e| format!(\"{}: {e}\", p.display()))?;\n    let mut raw: Option<String> = None;\n    let mut rank: Option<u8> = None;\n    for line in text.lines().map(str::trim) {\n        if let Some(rest) = line.strip_prefix(\"KIND\") {\n            let value = rest.trim();\n            if value.is_empty() || raw.is_some() {\n                return Err(format!(\"{}: invalid KIND\", p.display()));\n            }\n            raw = Some(value.to_string());\n        } else if let Some(rest) = line.strip_prefix(\"RANK\") {\n            if rank.is_some() {\n                return Err(format!(\"{}: duplicate RANK\", p.display()));\n            }\n            let value: u8 = rest.trim().parse()\n                .map_err(|_| format!(\"{}: invalid RANK\", p.display()))?;\n            if value > 9 {\n                return Err(format!(\"{}: RANK must be 0..9\", p.display()));\n            }\n            rank = Some(value);\n        }\n    }\n    let raw = raw.ok_or_else(|| format!(\"{}: missing KIND\", p.display()))?;\n    if fold(&raw).is_empty() {\n        return Err(format!(\"{}: empty canonical KIND\", p.display()));\n    }\n    let rank = rank.ok_or_else(|| format!(\"{}: missing RANK\", p.display()))?;\n    Ok(Sheet { raw, rank })\n}\n\npub fn put_rec(buf: &mut Vec<u8>, name: &str, rank: u8) -> Result<(), String> {\n    let bytes = name.as_bytes();\n    let len = u16::try_from(bytes.len()).map_err(|_| format!(\"KIND too long: {name}\"))?;\n    buf.extend_from_slice(&len.to_be_bytes());\n    buf.extend_from_slice(bytes);\n    buf.push(rank);\n    Ok(())\n}\n\npub fn parse_recs(bytes: &[u8]) -> Result<Vec<(String, u8)>, String> {\n    let mut out = Vec::new();\n    let mut i = 0usize;\n    while i < bytes.len() {\n        if i + 2 > bytes.len() { return Err(\"truncated record length\".into()); }\n        let len = u16::from_be_bytes([bytes[i], bytes[i + 1]]) as usize;\n        i += 2;\n        if i + len + 1 > bytes.len() { return Err(\"truncated record\".into()); }\n        let name = std::str::from_utf8(&bytes[i..i + len])\n            .map_err(|_| \"record name is not UTF-8\")?.to_string();\n        i += len;\n        let rank = bytes[i];\n        i += 1;\n        out.push((name, rank));\n    }\n    Ok(out)\n}\nEOF\ncat > /app/kindmill/roster.rs <<'EOF'\nuse crate::sheet;\nuse std::collections::BTreeSet;\nuse std::fs;\n\npub fn collect(sheets: &[sheet::Sheet]) -> Vec<String> {\n    sheets.iter().map(|s| sheet::fold(&s.raw)).collect::<BTreeSet<_>>().into_iter().collect()\n}\n\npub fn spill(names: &[String]) -> Result<(), String> {\n    fs::create_dir_all(\"/app/spillbay\").map_err(|e| e.to_string())?;\n    let body = if names.is_empty() { String::new() } else { format!(\"{}\\n\", names.join(\"\\n\")) };\n    fs::write(\"/app/spillbay/kinds.ord\", body).map_err(|e| e.to_string())\n}\nEOF\ncat > /app/emberkit/bake.rs <<'EOF'\nuse crate::sheet;\nuse std::collections::BTreeMap;\nuse std::fs;\n\npub fn table(sheets: &[sheet::Sheet]) -> Result<BTreeMap<String, u8>, String> {\n    let mut table = BTreeMap::new();\n    for item in sheets {\n        let name = sheet::fold(&item.raw);\n        if let Some(old) = table.insert(name.clone(), item.rank) {\n            if old != item.rank {\n                return Err(format!(\"conflicting RANKs for {name}: {old} and {}\", item.rank));\n            }\n        }\n    }\n    Ok(table)\n}\n\npub fn hearth(names: &[String], ra"]
[70.10082, "i", "nks: &BTreeMap<String, u8>) -> Result<(), String> {\n    let mut bytes = Vec::new();\n    for name in names {\n        let rank = *ranks.get(name).ok_or_else(|| format!(\"missing RANK for {name}\"))?;\n        sheet::put_rec(&mut bytes, name, rank)?;\n    }\n    fs::create_dir_all(\"/app/rankbin\").map_err(|e| e.to_string())?;\n    fs::write(\"/app/rankbin/ranks.bin\", bytes).map_err(|e| e.to_string())\n}\nEOF\ncat > /app/filewell/stamp.rs <<'EOF'\nuse crate::{bake, roster, sheet};\nuse std::fs;\n\npub fn mark() -> i32 {\n    if let Err(e) = brew() {\n        eprintln!(\"brew: {e}\");\n        return 1;\n    }\n    0\n}\n\nfn brew() -> Result<(), String> {\n    // This operational sidecar is intentionally read, but is not pipeline data.\n    fs::read_to_string(\"/app/endpin/KEEP_TAIL.txt\")\n        .map_err(|e| format!(\"cannot read KEEP_TAIL.txt: {e}\"))?;\n    let sheets = sheet::load_glob()?;\n    let ranks = bake::table(&sheets)?;\n    let names = roster::collect(&sheets);\n\n    let mut filed = Vec::new();\n    for name in &names {\n        let severity = *ranks.get(name).ok_or_else(|| format!(\"missing RANK for {name}\"))?;\n        if severity > 9 { return Err(format!(\"invalid severity for {name}\")); }\n        sheet::put_rec(&mut filed, name, severity)?;\n    }\n    // Refuse success unless every filed value agrees with the corresponding sheet rank.\n    for (name, severity) in sheet::parse_recs(&filed)? {\n        if ranks.get(&sheet::fold(&name)).copied() != Some(severity) {\n            return Err(format!(\"filed severity does not match sheet for {name}\"));\n        }\n    }\n\n    roster::spill(&names)?;\n    bake::hearth(&names, &ranks)?;\n    fs::create_dir_all(\"/app/docket\").map_err(|e| e.to_string())?;\n    fs::write(\"/app/docket/filed.bin\", filed).map_err(|e| e.to_string())?;\n    Ok(())\n}\n\npub fn peek() -> i32 {\n    let bytes = match fs::read(\"/app/docket/filed.bin\") {\n        Ok(v) => v,\n        Err(e) => { eprintln!(\"peek: {e}\"); return 1; }\n    };\n    let recs = match sheet::parse_recs(&bytes) {\n        Ok(v) => v,\n        Err(e) => { eprintln!(\"peek: {e}\"); return 1; }\n    };\n    print!(\"{{\\\"findings\\\":[\");\n    for (i, (name, rank)) in recs.iter().enumerate() {\n        if i != 0 { print!(\",\"); }\n        print!(\"{{\\\"token\\\":{},\\\"severity\\\":{}}}\", json_string(name), rank);\n    }\n    println!(\"]}}\");\n    0\n}\n\nfn json_string(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c < '\\u{20}' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\nEOF\n/app/hull.sh\n"]
