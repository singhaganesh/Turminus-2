[70.121898, "o", "pub fn table(sheets: &[sheet::Sheet]) -> Result<BTreeMap<String, u8>, String> {\r\n\u001b[?2004l\r"]
[70.122019, "o", "\u001b[?2004h> "]
[70.122102, "o", "    let mut table = BTreeMap::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.122208, "o", "    for item in sheets {\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.122245, "o", "> "]
[70.122396, "o", "        let name = sheet::fold(&item.raw);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.122551, "o", "        if let Some(old) = table.insert(name.clone(), item.rank) {\r\n\u001b[?2004l\r"]
[70.122627, "o", "\u001b[?2004h> "]
[70.123352, "o", "            if old != item.rank {\r\n\u001b[?2004l\r\u001b[?2004h>                 return Err(format!(\"conflicting RANKs for {name}: {old} and {}\", item.rank));\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     Ok(table)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.123575, "o", "pub fn hearth(names: &[String], ranks: &BTreeMap<String, u8>) -> Result<(), String> {\r\n\u001b[?2004l\r"]
[70.123665, "o", "\u001b[?2004h> "]
[70.123692, "o", "    let mut bytes = Vec::new();\r\n\u001b[?2004l\r"]
[70.123711, "o", "\u001b[?2004h> "]
[70.123797, "o", "    for name in names {\r\n\u001b[?2004l\r"]
[70.123815, "o", "\u001b[?2004h"]
[70.123831, "o", "> "]
[70.124067, "o", "        let rank = *ranks.get(name).ok_or_else(|| format!(\"missing RANK for {name}\"))?;\r\n\u001b[?2004l\r"]
[70.124165, "o", "\u001b[?2004h> "]
[70.124275, "o", "        sheet::put_rec(&mut bytes, name, rank)?;\r\n\u001b[?2004l\r"]
[70.124378, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.124549, "o", "    fs::create_dir_all(\"/app/rankbin\").map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r"]
[70.124618, "o", "\u001b[?2004h> "]
[70.124845, "o", "    fs::write(\"/app/rankbin/ranks.bin\", bytes).map_err(|e| e.to_string())\r\n\u001b[?2004l\r"]
[70.124928, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[70.126603, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[70.12673, "o", "cat > /app/filewell/stamp.rs <<'EOF'\r\n\u001b[?2004l\r"]
[70.126803, "o", "\u001b[?2004h> "]
[70.126906, "o", "use crate::{bake, roster, sheet};\r\n\u001b[?2004l\r"]
[70.127008, "o", "\u001b[?2004h> "]
[70.127111, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.127183, "o", "pub fn mark() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.127338, "o", "    if let Err(e) = brew() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.127453, "o", "        eprintln!(\"brew: {e}\");\r\n\u001b[?2004l\r"]
[70.127571, "o", "\u001b[?2004h"]
[70.127604, "o", ">         return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.129357, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn brew() -> Result<(), String> {\r\n\u001b[?2004l\r\u001b[?2004h>     // This operational sidecar is intentionally read, but is not pipeline data.\r\n\u001b[?2004l\r\u001b[?2004h>     fs::read_to_string(\"/app/endpin/KEEP_TAIL.txt\")\r\n\u001b[?2004l\r\u001b[?2004h>         .map_err(|e| format!(\"cannot read KEEP_TAIL.txt: {e}\"))?;\r\n\u001b[?2004l\r\u001b[?2004h>     let sheets = sheet::load_glob()?;\r\n\u001b[?2004l\r\u001b[?2004h>     let ranks = bake::table(&sheets)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let names = roster::collect(&sheets);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let mut filed = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for name in &names {\r\n\u001b[?2004l\r\u001b[?2004h>         let severity = *ranks.get(name).ok_or_else(|| format!(\"missing RANK for {name}\"))?;\r\n\u001b[?2004l\r"]
[70.129488, "o", "\u001b[?2004h> "]
[70.129587, "o", "        if severity > 9 { return Err(format!(\"invalid severity for {name}\")); }\r\n\u001b[?2004l\r"]
[70.129662, "o", "\u001b[?2004h> "]
[70.129774, "o", "        sheet::put_rec(&mut filed, name, severity)?;\r\n\u001b[?2004l\r"]
[70.129867, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.129901, "o", "> "]
[70.130151, "o", "    // Refuse success unless every filed value agrees with the corresponding sheet rank.\r\n\u001b[?2004l\r"]
[70.130181, "o", "\u001b[?2004h> "]
[70.130391, "o", "    for (name, severity) in sheet::parse_recs(&filed)? {\r\n\u001b[?2004l\r"]
[70.130484, "o", "\u001b[?2004h> "]
[70.130638, "o", "        if ranks.get(&sheet::fold(&name)).copied() != Some(severity) {\r\n\u001b[?2004l\r"]
[70.13073, "o", "\u001b[?2004h> "]
[70.130895, "o", "            return Err(format!(\"filed severity does not match sheet for {name}\"));\r\n\u001b[?2004l\r"]
[70.130968, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[70.13103, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[70.131093, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.131181, "o", "> "]
[70.131253, "o", "    roster::spill(&names)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.131362, "o", "    bake::hearth(&names, &ranks)?;\r\n\u001b[?2004l\r"]
[70.13144, "o", "\u001b[?2004h> "]
[70.131556, "o", "    fs::create_dir_all(\"/app/docket\").map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r"]
[70.131621, "o", "\u001b[?2004h> "]
[70.131791, "o", "    fs::write(\"/app/docket/filed.bin\", filed).map_err(|e| e.to_string())?;\r\n\u001b[?2004l\r"]
[70.131879, "o", "\u001b[?2004h>     Ok(())\r\n\u001b[?2004l\r"]
[70.131962, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.132089, "o", "\u001b[?2004h> pub fn peek() -> i32 {\r\n\u001b[?2004l\r"]
[70.13218, "o", "\u001b[?2004h> "]
[70.132317, "o", "    let bytes = match fs::read(\"/app/docket/filed.bin\") {\r\n\u001b[?2004l\r"]
[70.132438, "o", "\u001b[?2004h>         Ok(v) => v,\r\n\u001b[?2004l\r"]
[70.132518, "o", "\u001b[?2004h> "]
[70.132632, "o", "        Err(e) => { eprintln!(\"peek: {e}\"); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[70.132659, "o", "\u001b[?2004h"]
[70.132741, "o", "> "]
[70.132807, "o", "    let recs = match sheet::parse_recs(&bytes) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.132869, "o", "        Ok(v) => v,\r\n\u001b[?2004l\r"]
[70.132901, "o", "\u001b[?2004h> "]
[70.133108, "o", "        Err(e) => { eprintln!(\"peek: {e}\"); return 1; }\r\n\u001b[?2004l\r"]
[70.133208, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.135369, "o", "    print!(\"{{\\\"findings\\\":[\");\r\n\u001b[?2004l\r\u001b[?2004h>     for (i, (name, rank)) in recs.iter().enumerate() {\r\n\u001b[?2004l\r\u001b[?2004h>         if i != 0 { print!(\",\"); }\r\n\u001b[?2004l\r\u001b[?2004h>         print!(\"{{\\\"token\\\":{},\\\"severity\\\":{}}}\", json_string(name), rank);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     println!(\"]}}\");\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn json_string(s: &str) -> String {\r\n\u001b[?2004l\r\u001b[?2004h>     let mut out = String::from(\"\\\"\");\r\n\u001b[?2004l\r\u001b[?2004h>     for c in s.chars() {\r\n\u001b[?2004l\r\u001b[?2004h>         match c {\r\n\u001b[?2004l\r\u001b[?2004h>             '\"' => out.push_str(\"\\\\\\\"\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\\\' => out.push_str(\"\\\\\\\\\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\n' => out.push_str(\"\\\\n\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\r' => out.push_str(\"\\\\r\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r\u001b[?2004h>             c if c < '\\u{20}' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n"]
[70.135524, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[70.135578, "o", "            c => out.push(c),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.135662, "o", "        }\r\n\u001b[?2004l\r"]
[70.135729, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.135895, "o", "    out.push('\"');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.135922, "o", "    out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
[70.135938, "o", "\u001b[?2004l\r"]
[70.137611, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[70.137727, "o", "/app/hull.sh\r\n\u001b[?2004l\r"]
[72.084503, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[72.085015, "i", "/app/bin/kindspill brew; echo brew_rc=$?; /app/bin/kindspill peek; echo peek_rc=$?; echo '--- kinds.ord'; cat /app/spillbay/kinds.ord; echo '--- ranks.bin'; od -An -tx1c /app/rankbin/ranks.bin; echo '--- ELF'; readelf -h /app/bin/kindspill | sed -n '1,10p'\n"]
[72.085707, "o", "/app/bin/kindspill brew; echo brew_rc=$?; /app/bin/kindspill peek; echo peek_rc=$?; echo '--- kinds.ord'; cat /app/spillbay/kinds.ord; echo '--- ranks.bin'; od -An -tx1c /app/rankbin/ranks.bin; echo '--- ELF'; readelf -h /app/bin/kindspill | sed -n '1,10p'\r\n\u001b[?2004l\r"]
[72.087763, "o", "brew_rc=0\r\n"]
[72.088721, "o", "{\"findings\":[{\"token\":\"brim_alert\",\"severity\":3},{\"token\":\"deny_gate\",\"severity\":4},{\"token\":\"http_pause\",\"severity\":1},{\"token\":\"stall_watch\",\"severity\":2},{\"token\":\"vault_slip\",\"severity\":7}]}\r\n"]
[72.08893, "o", "peek_rc=0\r\n--- kinds.ord\r\n"]
[72.089749, "o", "brim_alert\r\ndeny_gate\r\nhttp_pause\r\nstall_watch\r\nvault_slip\r\n"]
[72.089917, "o", "--- ranks.bin\r\n"]
[72.090667, "o", "  00  0a  62  72  69  6d  5f  61  6c  65  72  74  03  00  09  64\r\n  \\0  \\n   b   r   i   m   _   a   l   e   r   t 003  \\0  \\t   d\r\n"]
[72.090769, "o", "  65  6e  79  5f  67  61  74  65  04  00  0a  68  74  74  70  5f\r\n   e   n   y   _   g   a   t   e 004  \\0  \\n   h   t   t   p   _\r\n  70  61  75  73  65  01  00  0b  73  74  61  6c  6c  5f  77  61\r\n"]
[72.090787, "o", "   p   a   u   s   e 001  \\0  \\v   s   t   a   l   l   _   w   a\r\n  74  63  68  02  00  0a  76  61  75  6c  74  5f  73  6c  69  70\r\n   t   c   h 002  \\0  \\n   v   a   u   l   t   _   s   l   i   p\r\n  07\r\n  \\a\r\n"]
[72.090891, "o", "--- ELF\r\n"]
[72.092906, "o", "ELF Header:\r\n  Magic:   7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00 \r\n  Class:                             ELF64\r\n  Data:                              2's complement, little endian\r\n  Version:                           1 (current)\r\n  OS/ABI:                            UNIX - System V\r\n  ABI Version:                       0\r\n  Type:                              DYN (Position-Independent Executable file)\r\n  Machine:                           Advanced Micro Devices X86-64\r\n  Version:                           0x1\r\n"]
[72.093253, "o", "\u001b[?2004h"]
[72.09334, "o", "root@6c07d6fad3c9:/app# "]
[92.941466, "i", "set -e\nbase=$(/app/bin/kindspill peek)\nprintf 'KIND aardvark-probe\\nRANK 9\\n' > /app/sanitdesc/sheet_00_test.kind\n/app/bin/kindspill brew\n/app/bin/kindspill peek | python3 -c 'import json,sys; d=json.load(sys.stdin); got={x[\"token\"]:x[\"severity\"] for x in d[\"findings\"]}; want={\"aardvark_probe\":9,\"brim_alert\":3,\"deny_gate\":4,\"http_pause\":1,\"stall_watch\":2,\"vault_slip\":7}; assert got==want,(got,want); print(\"insertion test: ok\")'\nprintf 'KIND DENY-GATE\\nRANK 8\\n' > /app/sanitdesc/sheet_zz_conflict.kind\nset +e\n/app/bin/kindspill brew\nrc=$?\nset -e\necho conflict_brew_rc=$rc\ntest \"$rc\" -ne 0\nrm -f /app/sanitdesc/sheet_00_test.kind /app/sanitdesc/sheet_zz_conflict.kind\n/app/bin/kindspill brew\nnow=$(/app/bin/kindspill peek)\ntest \"$now\" = \"$base\"\nprintf '%s\\n' \"$now\" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert all(isinstance(x[\"token\"],str) and isinstance(x[\"severity\"],int) and 0<=x[\"severity\"]<=9 for x in d[\"findings\"]); print(\"final JSON: ok\")'\npython3 - <<'PY'\nfrom pathlib import Path\n\ndef records(path):\n    b=Path(path).read_bytes(); i=0; out=[]\n    while i < len(b):\n        assert i+2 <= len(b)\n        n=int.from_bytes(b[i:i+2], 'big'); i += 2\n        assert i+n+1 <= len(b)\n        name=b[i:i+n].decode('utf-8'); i += n\n        rank=b[i]; i += 1\n        assert 0 <= rank <= 9\n        out.append((name,rank))\n    assert i == len(b)\n    return out\nr=records('/app/rankbin/ranks.bin')\nf=records('/app/docket/filed.bin')\nassert r == f\nassert r == [('brim_alert',3),('deny_gate',4),('http_pause',1),('stall_watch',2),('vault_slip',7)], r\nassert Path('/app/spillbay/kinds.ord').read_text().splitlines() == [n for n,_ in r]\nassert Path('/app/bin/kindspill').read_bytes()[:4] == b'\\x7fELF'\nprint('binary records and ELF: ok')\nPY\n"]
[92.941736, "o", "set -e\r\n\u001b[?2004l\r"]
[92.941858, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.941973, "o", "base=$(/app/bin/kindspill peek)\r\n\u001b[?2004l\r"]
[92.943888, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.944104, "o", "printf 'KIND aardvark-probe\\nRANK 9\\n' > /app/sanitdesc/sheet_00_test.kind\r\n\u001b[?2004l\r"]
[92.944451, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.944541, "o", "/app/bin/kindspill brew\r\n\u001b[?2004l\r"]
[92.946603, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.947251, "o", "/app/bin/kindspill peek | python3 -c 'import json,sys; d=json.load(sys.stdin); got={x[\"token\"]:x[\"severity\"] for x in d[\"findings\"]}; want={\"aardvark_probe\":9,\"brim_alert\":3,\"deny_gate\":4,\"http_pause\":1,\"stall_watch\":2,\"vault_slip\":7}; assert got==want,(got,want); print(\"insertion test: ok\")'\r\n\u001b[?2004l\r"]
[92.973423, "o", "insertion test: ok\r\n"]
[92.979006, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.979229, "o", "printf 'KIND DENY-GATE\\nRANK 8\\n' > /app/sanitdesc/sheet_zz_conflict.kind\r\n\u001b[?2004l\r"]
[92.979517, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# set +e\r\n\u001b[?2004l\r"]
[92.979772, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# /app/bin/kindspill brew\r\n\u001b[?2004l\r"]
[92.980977, "o", "brew: conflicting RANKs for deny_gate: 4 and 8\r\n"]
[92.981271, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.981432, "o", "rc=$?\r\n\u001b[?2004l\r\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.981559, "o", "set -e\r\n\u001b[?2004l\r"]
[92.98168, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.981728, "o", "echo conflict_brew_rc=$rc\r\n\u001b[?2004l\rconflict_brew_rc=1\r\n\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.981798, "o", "test \"$rc\" -ne 0\r\n\u001b[?2004l\r"]
[92.981867, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.982033, "o", "rm -f /app/sanitdesc/sheet_00_test.kind /app/sanitdesc/sheet_zz_conflict.kind\r\n\u001b[?2004l\r"]
[92.98315, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.983265, "o", "/app/bin/kindspill brew\r\n\u001b[?2004l\r"]
[92.984686, "o", "\u001b[?2004hroot@6c07d6fad3c9:/app# "]
[92.984798, "o", "now=$(/app/bin/kindspill peek)\r\n\u001b[?2004l\r"]
