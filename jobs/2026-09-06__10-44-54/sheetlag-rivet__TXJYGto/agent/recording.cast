[5.854767, "o", "### emitters/door_seal.kdec\r\n"]
[5.856858, "o", "KDEC1\r\nNAME door_seal\r\nok u8\r\n"]
[5.858376, "o", "### emitters/fuel_flow.kdec\r\n"]
