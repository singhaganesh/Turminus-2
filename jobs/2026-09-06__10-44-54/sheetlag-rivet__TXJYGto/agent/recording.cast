[48.204154, "i", "cd /app/rivetbay && cat > evd/verifier_probe.evd <<'EOF'\nNAME verifier_probe\nFIELD mm u16\nFIELD bit u8\nFIELD w u16\nEOF\npython3 - <<'PY'\nimport struct\nname=b'verifier_probe'\nopen('frames/verifier_probe.bin','wb').write(struct.pack('>I',len(name))+name+struct.pack('>HBH',513,7,4095))\nPY\n/app/bin/rivetbay mill; rc=$?; echo \"add_mill_rc=$rc\"; grep '^verifier_probe|' intake/current.ledger; cat emitters/verifier_probe.kdec; /app/bin/rivetbay decode frames/verifier_probe.bin\nrm evd/verifier_probe.evd\n/app/bin/rivetbay mill; rc=$?; echo \"remove_mill_rc=$rc\"; test ! -e emitters/verifier_probe.kdec && echo 'stale_decoder_removed=yes'; /app/bin/rivetbay decode frames/verifier_probe.bin\nrm frames/verifier_probe.bin\necho '--- changed source excerpts ---'; grep -n -A10 -B3 'discover_all' forgekit/driver.c; grep -n -A45 'clear_emitters' forgekit/emit.c\n"]
