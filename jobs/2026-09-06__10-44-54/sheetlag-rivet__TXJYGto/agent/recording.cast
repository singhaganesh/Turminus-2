[5.842616, "o", "--- ledger ---\r\n"]
[5.846046, "o", "wing_ice|evd/wing_ice.evd|thick:u16\r\nfuel_flow|evd/fuel_flow.evd|rate:u16,tank:u8\r\ndoor_seal|evd/door_seal.evd|ok:u8\r\npitot_heat|evd/pitot_heat.evd|watts:u16\r\naileron_pos|evd/aileron_pos.evd|deg:u16,side:u8\r\nnav_lamp|evd/nav_lamp.evd|color:u8\r\nbrake_temp|evd/brake_temp.evd|cdeg:u16\r\n"]
[5.846825, "o", "--- emitters ---\r\n### emitters/aileron_pos.kdec\r\n"]
[5.851366, "o", "KDEC1\r\nNAME aileron_pos\r\ndeg u16\r\nside u8\r\n"]
[5.851725, "o", "### emitters/brake_temp.kdec\r\n"]
