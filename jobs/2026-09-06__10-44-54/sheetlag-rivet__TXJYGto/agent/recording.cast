[5.798841, "o", "./emitters/pitot_heat.kdec\r\n./emitters/wing_ice.kdec\r\n./evd/aileron_pos.evd\r\n./evd/brake_temp.evd\r\n./evd/door_seal.evd\r\n./evd/fuel_flow.evd\r\n./evd/galley_hatch.evd\r\n./evd/nav_lamp.evd\r\n./evd/pitot_heat.evd\r\n./evd/wing_ice.evd\r\n./forgekit/decode.c\r\n./forgekit/decode.h\r\n./forgekit/discover.c\r\n./forgekit/discover.h\r\n./forgekit/driver.c\r\n./forgekit/emit.c\r\n./forgekit/emit.h\r\n./forgekit/parse_evd.c\r\n./forgekit/parse_evd.h\r\n./forgekit/sheet.h\r\n./forgekit/snapshot.c\r\n./forgekit/utf_tidy.c\r\n./forgekit/utf_tidy.h\r\n./forgekit/warmup.c\r\n./forgekit/warmup.h\r\n./frames/aileron_pos.bin\r\n./frames/brake_temp.bin\r\n./frames/door_seal.bin\r\n./frames/fuel_flow.bin\r\n./frames/galley_hatch.bin\r\n./frames/nav_lamp.bin\r\n./frames/pitot_heat.bin\r\n./frames/wing_ice.bin\r\n./intake/current.ledger\r\n./notes/forms.txt\r\n./notes/layout.txt\r\n./notes/ops.txt\r\n./seed/emitters/aileron_pos.kdec\r\n./seed/emitters/brake_temp.kdec\r\n./seed/emitters/door_seal.kdec\r\n./seed/emitters/fuel_flow.kdec\r\n./seed/emitters/nav_lamp.kdec\r\n./seed/emitters/pitot_heat.kdec\r\n./seed/emitters/wing_ice.kdec\r\n./seed/evd/aileron_pos.evd\r\n./seed/evd/brake_temp.evd\r\n./seed/evd/door_seal.evd\r\n./seed/evd/fuel_flow.evd\r\n./seed/evd/galley_hatch.evd\r\n./seed/evd/nav_lamp.evd\r\n./seed/evd/pitot_heat.evd\r\n./seed/evd/wing_ice.evd\r\n"]
[5.801612, "o", "./seed/frames/aileron_pos.bin\r\n./seed/frames/brake_temp.bin\r\n./seed/frames/door_seal.bin\r\n./seed/frames/fuel_flow.bin\r\n./seed/frames/galley_hatch.bin\r\n./seed/frames/nav_lamp.bin\r\n"]
