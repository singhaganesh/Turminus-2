[5.871505, "o", "\u001b[?2004h"]
[5.871976, "o", "root@7deb2d249314:/app/rivetbay# "]
[10.875059, "i", "cd /app/rivetbay && for f in Makefile forgekit/*.[ch] notes/*.txt; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done\n"]
[10.876421, "o", "cd /app/rivetbay && for f in Makefile forgekit/*.[ch] notes/*.txt; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done"]
[10.877497, "o", "\r\n\u001b[?2004l\r"]
[10.877922, "o", "===== Makefile =====\r\n"]
[10.880246, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore\r\n"]
[10.880644, "o", "SRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)\r\nBIN := /app/bin/rivetbay\r\n\r\n.PHONY: hull\r\nhull:\r\n"]
[10.880821, "o", "\tmkdir -p /app/bin\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[10.881738, "o", "===== forgekit/decode.c =====\r\n"]
[10.883714, "o", "#include \"decode.h\"\r\n"]
[10.884078, "o", "#include <stdint.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic uint32_t rd_be32(const unsigned char *p) {\r\n    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];\r\n}\r\n\r\nint decode_frame(const char *path) {\r\n    FILE *f = fopen(path, \"rb\");\r\n    if (!f) return 2;\r\n    unsigned char raw[4096];\r\n    size_t n = fread(raw, 1, sizeof(raw), f);\r\n    fclose(f);\r\n    if (n < 4) return 2;\r\n    uint32_t ln = rd_be32(raw);\r\n    if (n < 4 + ln) return 2;\r\n    char name[256];\r\n    if (ln >= sizeof(name)) return 2;\r\n    memcpy(name, raw + 4, ln);\r\n    name[ln] = 0;\r\n    char kpath[512];\r\n    snprintf(kpath, sizeof(kpath), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *k = fopen(kpath, \"r\");\r\n    if (!k) {\r\n        printf(\"{\\\"kind\\\":\\\"unknown\\\",\\\"name\\\":\\\"%s\\\"}\\n\", name);\r\n        return 0;\r\n    }\r\n"]
[10.884308, "o", "    char line[256];\r\n"]
[10.884497, "o", "    char fields[32][64];\r\n    char kinds[32][16];\r\n    int nf = 0;\r\n    while (fgets(line, sizeof(line), k)) {\r\n        if (strncmp(line, \"KDEC1\", 5) == 0) continue;\r\n        if (strncmp(line, \"NAME \", 5) == 0) continue;\r\n"]
[10.884771, "o", "        if (sscanf(line, \"%63s %15s\", fields[nf], kinds[nf]) == 2) nf++;\r\n    }\r\n    fclose(k);\r\n    const unsigned char *p = raw + 4 + ln;\r\n    size_t left = n - 4 - ln;\r\n"]
[10.885176, "o", "    printf(\"{\\\"kind\\\":\\\"decoded\\\",\\\"name\\\":\\\"%s\\\",\\\"fields\\\":{\", name);\r\n    for (int i = 0; i < nf; i++) {\r\n        unsigned v = 0;\r\n        if (strcmp(kinds[i], \"u16\") == 0) {\r\n            if (left < 2) break;\r\n            v = ((unsigned)p[0] << 8) | p[1];\r\n"]
[10.885233, "o", "            p += 2; left -= 2;\r\n        } else {\r\n            if (left < 1) break;\r\n            v = p[0];\r\n            p += 1; left -= 1;\r\n        }\r\n        printf(\"%s\\\"%s\\\":%u\", i ? \",\" : \"\", fields[i], v);\r\n    }\r\n    printf(\"}}\\n\");\r\n"]
[10.885256, "o", "    return 0;\r\n"]
[10.886197, "o", "}\r\n"]
[10.886857, "o", "===== forgekit/decode.h =====\r\n"]
[10.888243, "o", "#ifndef DECODE_H\r\n#define DECODE_H\r\nint decode_frame(const char *path);\r\n#endif\r\n"]
[10.888838, "o", "===== forgekit/discover.c =====\r\n"]
[10.890726, "o", "#include \"discover.h\"\r\n#include \"parse_evd.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nvoid discover_all(void) {\r\n    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    struct dirent *ent;\r\n    if (!d || !out) {\r\n        if (d) closedir(d);\r\n        if (out) fclose(out);\r\n        return;\r\n    }\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n        char path[512];\r\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n        char name[128];\r\n        char fields[512];\r\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n        fprintf(out, \"%s|evd/%s|%s\\n\", name, ent->d_name, fields);\r\n    }\r\n    fclose(out);\r\n    closedir(d);\r\n}\r\n"]
[10.891274, "o", "===== forgekit/discover.h =====\r\n"]
[10.89469, "o", "#ifndef DISCOVER_H\r\n#define DISCOVER_H\r\nvoid discover_all(void);\r\n#endif\r\n"]
[10.895317, "o", "===== forgekit/driver.c =====\r\n"]
[10.897611, "o", "#include \"discover.h\"\r\n#include \"sheet.h\"\r\n#include \"emit.h\"\r\n#include \"tally.h\"\r\n#include \"decode.h\"\r\n#include \"warmup.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic void note_mill_pass(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    if (!f) return;\r\n    fputc('1', f);\r\n    fputc('\\n', f);\r\n    fclose(f);\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n"]
[10.897669, "o", "    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n        note_mill_pass();\r\n        warm_maybe();\r\n        prime_intake_sheet();\r\n        discover_all();\r\n        pour_sheet();\r\n        emit_all();\r\n        return count_gap();\r\n    }\r\n    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n        return decode_frame(argv[2]);\r\n    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    return 2;\r\n}\r\n"]
[10.898309, "o", "===== forgekit/emit.c =====\r\n"]
[10.900145, "o", "#include \"emit.h\"\r\n"]
[10.900384, "o", "#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void emit_one(const char *line) {\r\n    char tmp[1024];\r\n    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    tmp[sizeof(tmp) - 1] = 0;\r\n    char *nl = strchr(tmp, '\\n');\r\n    if (nl) *nl = 0;\r\n    char *name = tmp;\r\n    char *p1 = strchr(tmp, '|');\r\n    if (!p1) return;\r\n    *p1 = 0;\r\n    char *p2 = strchr(p1 + 1, '|');\r\n    if (!p2) return;\r\n    char *spec = p2 + 1;\r\n    char outp[512];\r\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *o = fopen(outp, \"w\");\r\n    if (!o) return;\r\n    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    char *tok = strtok(spec, \",\");\r\n    while (tok) {\r\n        char fn[64], k[16];\r\n        if (sscanf(tok, \"%63[^:]:%15s\", fn, k) == 2)\r\n            fprintf(o, \"%s %s\\n\", fn, k);\r\n        tok = strtok(NULL, \",\");\r\n    }\r\n    fclose(o);\r\n}\r\n\r\nvoid emit_all(void) {\r\n    const char *blob = sheet_view();\r\n    char buf[65536];\r\n    strncpy(buf, blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        if (line[0]) emit_one(line);\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n}\r\n"]
[10.902068, "o", "===== forgekit/emit.h =====\r\n"]
[10.906114, "o", "#ifndef EMIT_H\r\n#define EMIT_H\r\nvoid emit_all(void);\r\n#endif\r\n"]
[10.90637, "o", "===== forgekit/parse_evd.c =====\r\n"]
[10.912038, "o", "#include \"parse_evd.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return -1;\r\n    name[0] = 0;\r\n    fields[0] = 0;\r\n    char line[256];\r\n    int first = 1;\r\n    while (fgets(line, sizeof(line), f)) {\r\n        if (strncmp(line, \"NAME \", 5) == 0) {\r\n            sscanf(line + 5, \"%127s\", name);\r\n        } else if (strncmp(line, \"FIELD \", 6) == 0) {\r\n            char fn[64], k[16];\r\n            if (sscanf(line + 6, \"%63s %15s\", fn, k) == 2) {\r\n                if (!first) strncat(fields, \",\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, \":\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);\r\n                first = 0;\r\n            }\r\n        }\r\n    }\r\n    fclose(f);\r\n    return name[0] ? 0 : -1;\r\n}\r\n===== forgekit/parse_evd.h =====\r\n"]
[10.913033, "o", "#ifndef PARSE_EVD_H\r\n#define PARSE_EVD_H\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz);\r\n#endif\r\n"]
[10.913659, "o", "===== forgekit/sheet.h =====\r\n"]
[10.915424, "o", "#ifndef SHEET_H\r\n#define SHEET_H\r\nvoid prime_intake_sheet(void);\r\nvoid grab_sheet(void);\r\nvoid pour_sheet(void);\r\nconst char *sheet_view(void);\r\n#endif\r\n"]
[10.916041, "o", "===== forgekit/snapshot.c =====\r\n"]
[10.918745, "o", "#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic char g_blob[65536];\r\n\r\nvoid prime_intake_sheet(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    g_blob[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(g_blob, 1, sizeof(g_blob) - 1, f);\r\n    g_blob[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid grab_sheet(void) {\r\n"]
[10.9188, "o", "    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    g_blob[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(g_blob, 1, sizeof(g_blob) - 1, f);\r\n    g_blob[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid pour_sheet(void) {\r\n    char buf[65536];\r\n    char out[65536];\r\n    strncpy(buf, g_blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    size_t w = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        while (*line == ' ' || *line == '\\t') line++;\r\n        if (*line == 0) {\r\n            line = strtok_r(NULL, \"\\n\", &save);\r\n"]
[10.919029, "o", "            continue;\r\n        }\r\n        size_t L = strlen(line);\r\n        if (w + L + 1 >= sizeof(out)) break;\r\n        memcpy(out + w, line, L);\r\n        w += L;\r\n        out[w++] = '\\n';\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n    out[w] = 0;\r\n    memcpy(g_blob, out, w + 1);\r\n}\r\n\r\nconst char *sheet_view(void) {\r\n    return g_blob;\r\n}\r\n"]
[10.91937, "o", "===== forgekit/utf_tidy.c =====\r\n"]
[10.92279, "o", "#include \"utf_tidy.h\"\r\n#include <string.h>\r\nvoid tidy_copy(const char *src, char *dst, int n) {\r\n"]
[10.922953, "o", "    if (n <= 0) return;\r\n    strncpy(dst, src, (size_t)n - 1);\r\n    dst[n - 1] = 0;\r\n}\r\n"]
[10.92542, "o", "===== forgekit/utf_tidy.h =====\r\n"]
[10.927607, "o", "#ifndef UTF_TIDY_H\r\n#define UTF_TIDY_H\r\nvoid tidy_copy(const char *src, char *dst, int n);\r\n#endif\r\n"]
[10.930986, "o", "===== forgekit/warmup.c =====\r\n#include \"warmup.h\"\r\n#include \"sheet.h\"\r\n#include <stdlib.h>\r\n\r\nvoid warm_maybe(void) {\r\n    const char *e = getenv(\"RIVET_WARM\");\r\n    if (e && e[0] == '1') {\r\n        grab_sheet();\r\n    }\r\n}\r\n===== forgekit/warmup.h =====\r\n"]
[10.933679, "o", "#ifndef WARMUP_H\r\n#define WARMUP_H\r\nvoid warm_maybe(void);\r\n#endif\r\n===== notes/forms.txt =====\r\n"]
[10.936327, "o", "Event descriptions use NAME then FIELD lines. Ledger is name|relpath|field:kind,... .\r\nKDEC files start with KDEC1. Decode JSON uses kind decoded or unknown.\r\nDecode fields object keys are the FIELD names from that description (for example latch, force, amp, bit, thick, mm, q, n, w).\r\n===== notes/layout.txt =====\r\n"]
[10.939154, "o", "evd holds descriptions. intake/current.ledger is the mill roster. emitters hold kdec tables.\r\nframes hold packed samples. forgekit is the C pipeline.\r\n"]
[10.940035, "o", "===== notes/ops.txt =====\r\n"]
[10.94178, "o", "After adding a description, mill may leave decode unknown even though discovery refreshed the on-disk ledger.\r\nUnknown decode is normal for frames that have no description on this bench.\r\n"]
[10.945184, "o", "\u001b[?2004hroot@7deb2d249314:/app/rivetbay# "]
[17.478538, "i", "echo '--- millscore ---'; find /app/millscore -maxdepth 2 -type f -printf '%p\\n' -exec sed -n '1,240p' {} \\;\n"]
[17.480258, "o", "echo '--- millscore ---'; find /app/millscore -maxdepth 2 -type f -printf '%p\\n' -exec sed -n '1,240p' {} \\;"]
[17.481042, "o", "\r\n\u001b[?2004l\r--- millscore ---\r\n"]
[17.484156, "o", "/app/millscore/tally.c\r\n"]
[17.48899, "o", "#include \"tally.h\"\r\n#include \"sheet.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int count_emitters(void) {\r\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\r\n    int n = 0;\r\n    struct dirent *ent;\r\n    if (!d) return 0;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L > 5 && strcmp(ent->d_name + L - 5, \".kdec\") == 0) n++;\r\n    }\r\n    closedir(d);\r\n    return n;\r\n}\r\n\r\nstatic int count_sheet_lines(void) {\r\n    const char *s = sheet_view();\r\n    int n = 0;\r\n    int nonempty = 0;\r\n    for (; *s; s++) {\r\n        if (*s == '\\n') {\r\n            if (nonempty) n++;\r\n            nonempty = 0;\r\n        } else if (*s != ' ' && *s != '\\r') nonempty = 1;\r\n    }\r\n    if (nonempty) n++;\r\n    return n;\r\n}\r\n\r\nint count_gap(void) {\r\n    int a = count_sheet_lines();\r\n    int b = count_emitters();\r\n    return (b < a) ? 1 : 0;\r\n}\r\n"]
[17.490569, "o", "/app/millscore/tally.h\r\n"]
[17.492511, "o", "#ifndef TALLY_H\r\n"]
[17.492985, "o", "#define TALLY_H\r\nint count_gap(void);\r\n#endif\r\n"]
[17.496187, "o", "\u001b[?2004h"]
[17.496613, "o", "root@7deb2d249314:/app/rivetbay# "]
[32.886788, "i", "cd /app/rivetbay && python3 - <<'PY'\nfrom pathlib import Path\np = Path('forgekit/driver.c')\ns = p.read_text()\ns = s.replace('''        warm_maybe();\n        prime_intake_sheet();\n        discover_all();\n        pour_sheet();\n''', '''        warm_maybe();\n        discover_all();\n        grab_sheet();\n        pour_sheet();\n''')\np.write_text(s)\n\np = Path('forgekit/emit.c')\ns = p.read_text()\ns = s.replace('#include <stdio.h>\\n', '#include <dirent.h>\\n#include <stdio.h>\\n#include <unistd.h>\\n')\ns = s.replace('''void emit_all(void) {\n    const char *blob = sheet_view();\n''', '''static void clear_emitters(void) {\n    const char *dirpath = \"/app/rivetbay/emitters\";\n    DIR *d = opendir(dirpath);\n    if (!d) return;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len <= 5 || strcmp(ent->d_name + len - 5, \".kdec\") != 0)\n            continue;\n        char path[512];\n        snprintf(path, sizeof(path), \"%s/%s\", dirpath, ent->d_name);\n        unlink(path);\n    }\n    closedir(d);\n}\n\nvoid emit_all(void) {\n    clear_emitters();\n    const char *blob = sheet_view();\n''')\np.write_text(s)\nPY\nmake hull\n/app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo '--- ledger'; cat intake/current.ledger; echo '--- emitters'; find emitters -maxdepth 1 -name '*.kdec' -printf '%f\\n' | sort; echo '--- decodes'; for f in frames/*.bin; do printf '%s: ' \"$(basename \"$f\")\"; /app/bin/rivetbay decode \"$f\"; done\n"]
[32.888215, "o", "cd /app/rivetbay && python3 - <<'PY'"]
