[5.802702, "o", "--- binary ---\r\n"]
[5.814918, "o", "/app/bin/rivetbay: ELF 64-bit LSB executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, for GNU/Linux 3.2.0, not stripped\r\n"]
[5.81516, "o", "--- descriptions ---\r\n"]
[5.815303, "o", "### evd/aileron_pos.evd\r\n"]
[5.818448, "o", "NAME aileron_pos\r\nFIELD deg u16\r\nFIELD side u8\r\n### evd/brake_temp.evd\r\n"]
[5.820236, "o", "NAME brake_temp\r\nFIELD cdeg u16\r\n"]
[5.820713, "o", "### evd/door_seal.evd\r\n"]
[5.823027, "o", "NAME door_seal\r\nFIELD ok u8\r\n"]
