[5.791858, "o", "cd /app/rivetbay && find . -maxdepth 3 -type f -printf '%p\\n' | sort && echo '--- binary ---' && file /app/bin/rivetbay && echo '--- descriptions ---' && for f in evd/*.evd; do echo \"### $f\"; cat \"$f\"; done && echo '--- ledger ---' && cat intake/current.ledger 2>/dev/null || true && echo '--- emitters ---' && for f in emitters/*.kdec; do [ -e \"$f\" ] || continue; echo \"### $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
