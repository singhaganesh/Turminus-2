[9.97091, "o", "--- /app/rivetbay/forgekit/utf_tidy.c\r\n#include \"utf_tidy.h\"\r\n#include <string.h>\r\nvoid tidy_copy(const char *src, char *dst, int n) {\r\n    if (n <= 0) return;\r\n    strncpy(dst, src, (size_t)n - 1);\r\n    dst[n - 1] = 0;\r\n}\r\n"]
