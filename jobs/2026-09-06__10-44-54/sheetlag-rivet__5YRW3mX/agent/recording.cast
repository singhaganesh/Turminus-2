[38.905171, "i", "python3 - <<'PY'\np='/app/rivetbay/forgekit/emit.c'\ns=open(p).read()\ns=s.replace('#include <stdio.h>\\n', '#include <stdio.h>\\n#include <dirent.h>\\n#include <unistd.h>\\n')\nold='void emit_all(void) {\\n    const char *blob = sheet_view();'\nnew='''static void clear_emitters(void) {\n    const char *dirpath = \"/app/rivetbay/emitters\";\n    DIR *d = opendir(dirpath);\n    if (!d) return;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len <= 5 || strcmp(ent->d_name + len - 5, \".kdec\") != 0) continue;\n        char path[512];\n        if (snprintf(path, sizeof(path), \"%s/%s\", dirpath, ent->d_name) < (int)sizeof(path))\n            unlink(path);\n    }\n    closedir(d);\n}\n\nvoid emit_all(void) {\n    clear_emitters();\n    const char *blob = sheet_view();'''\nif old not in s:\n    raise SystemExit('emit_all pattern not found')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\nmake -C /app/rivetbay hull\n"]
