[18.804975, "o", "for f in /app/rivetbay/forgekit/{sheet.h,driver.c,discover.c,discover.h,snapshot.c,emit.c,warmup.c,utf_tidy.h,parse_evd.h}; do echo \"===== $f\"; cat \"$f\"; done"]
[18.805378, "o", "\r\n"]
[18.806224, "o", "\u001b[?2004l\r===== /app/rivetbay/forgekit/sheet.h\r\n"]
[18.827037, "o", "#ifndef SHEET_H\r\n#define SHEET_H\r\nvoid prime_intake_sheet(void);\r\nvoid grab_sheet(void);\r\nvoid pour_sheet(void);\r\nconst char *sheet_view(void);\r\n#endif\r\n===== /app/rivetbay/forgekit/driver.c\r\n#include \"discover.h\"\r\n#include \"sheet.h\"\r\n#include \"emit.h\"\r\n#include \"tally.h\"\r\n#include \"decode.h\"\r\n#include \"warmup.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic void note_mill_pass(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    if (!f) return;\r\n    fputc('1', f);\r\n    fputc('\\n', f);\r\n    fclose(f);\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n        note_mill_pass();\r\n        warm_maybe();\r\n        prime_intake_sheet();\r\n        discover_all();\r\n        pour_sheet();\r\n        emit_all();\r\n        return count_gap();\r\n    }\r\n    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n        return decode_frame(argv[2]);\r\n    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    return 2;\r\n}\r\n===== /app/rivetbay/forgekit/discover.c\r\n#include \"discover.h\"\r\n#include \"parse_evd.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nvoid discover_all(void) {\r\n    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    struct dirent *ent;\r\n    if (!d || !out) {\r\n        if (d) closedir(d);\r\n        if (out) fclose(out);\r\n        return;\r\n    }\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n        char path[512];\r\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n        char name[128];\r\n        char fields[512];\r\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n        fprintf(out, \"%s|evd/%s|%s\\n\", name, ent->d_name, fields);\r\n    }\r\n    fclose(out);\r\n    closedir(d);\r\n}\r\n===== /app/rivetbay/forgekit/discover.h\r\n#ifndef DISCOVER_H\r\n#define DISCOVER_H\r\nvoid discover_all(void);\r\n#endif\r\n===== /app/rivetbay/forgekit/snapshot.c\r\n#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic char g_blob[65536];\r\n\r\nvoid prime_intake_sheet(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    g_blob[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(g_blob, 1, sizeof(g_blob) - 1, f);\r\n    g_blob[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid grab_sheet(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    g_blob[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(g_blob, 1, sizeof(g_blob) - 1, f);\r\n    g_blob[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid pour_sheet(void) {\r\n    char buf[65536];\r\n    char out[65536];\r\n    strncpy(buf, g_blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    size_t w = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        while (*line == ' ' || *line == '\\t') line++;\r\n        if (*line == 0) {\r\n            line = strtok_r(NULL, \"\\n\", &save);\r\n            continue;\r\n        }\r\n        size_t L = strlen(line);\r\n        if (w + L + 1 >= sizeof(out)) break;\r\n        memcpy(out + w, line, L);\r\n        w += L;\r\n        out[w++] = '\\n';\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n    out[w] = 0;\r\n    memcpy(g_blob, out, w + 1);\r\n}\r\n\r\nconst char *sheet_view(void) {\r\n    return g_blob;\r\n}\r\n===== /app/rivetbay/forgekit/emit.c\r\n#include \"emit.h\"\r\n#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void emit_one(const char *line) {\r\n    char tmp[1024];\r\n    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    tmp[sizeof(tmp) - 1] = 0;\r\n    char *nl = strchr(tmp, '\\n');\r\n    if (nl) *nl = 0;\r\n    char *name = tmp;\r\n    char *p1 = strchr(tmp, '|');\r\n    if (!p1) return;\r\n    *p1 = 0;\r\n    char *p2 = strchr(p1 + 1, '|');\r\n    if (!p2) return;\r\n    char *spec = p2 + 1;\r\n    char outp[512];\r\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *o = fopen(outp, \"w\");\r\n    if (!o) return;\r\n    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    char "]
[18.827126, "o", "*tok = strtok(spec, \",\");\r\n    while (tok) {\r\n        char fn[64], k[16];\r\n        if (sscanf(tok, \"%63[^:]:%15s\", fn, k) == 2)\r\n            fprintf(o, \"%s %s\\n\", fn, k);\r\n        tok = strtok(NULL, \",\");\r\n    }\r\n    fclose(o);\r\n}\r\n\r\nvoid emit_all(void) {\r\n    const char *blob = sheet_view();\r\n    char buf[65536];\r\n    strncpy(buf, blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        if (line[0]) emit_one(line);\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n}\r\n===== /app/rivetbay/forgekit/warmup.c\r\n#include \"warmup.h\"\r\n#include \"sheet.h\"\r\n#include <stdlib.h>\r\n\r\nvoid warm_maybe(void) {\r\n    const char *e = getenv(\"RIVET_WARM\");\r\n    if (e && e[0] == '1') {\r\n        grab_sheet();\r\n    }\r\n}\r\n===== /app/rivetbay/forgekit/utf_tidy.h\r\n#ifndef UTF_TIDY_H\r\n#define UTF_TIDY_H\r\nvoid tidy_copy(const char *src, char *dst, int n);\r\n#endif\r\n===== /app/rivetbay/forgekit/parse_evd.h\r\n#ifndef PARSE_EVD_H\r\n#define PARSE_EVD_H\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz);\r\n#endif\r\n\u001b[?2004hroot@dbb314e699db:/app# "]
[19.078028, "i", "find /app/millscore -maxdepth 2 -type f -print -exec sh -c 'echo \"===== $1\"; sed -n \"1,260p\" \"$1\"' _ {} \\;\n"]
[19.083772, "o", "find /app/millscore -maxdepth 2 -type f -print -exec sh -c 'echo \"===== $1\"; sed -n \"1,260p\" \"$1\"' _ {} \\;\r\n"]
[19.083863, "o", "\u001b[?2004l\r"]
[19.084595, "o", "/app/millscore/tally.c\r\n"]
[19.084954, "o", "===== /app/millscore/tally.c\r\n"]
[19.088845, "o", "#include \"tally.h\"\r\n#include \"sheet.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int count_emitters(void) {\r\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\r\n    int n = 0;\r\n    struct dirent *ent;\r\n    if (!d) return 0;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L > 5 && strcmp(ent->d_name + L - 5, \".kdec\") == 0) n++;\r\n    }\r\n    closedir(d);\r\n    return n;\r\n}\r\n\r\nstatic int count_sheet_lines(void) {\r\n    const char *s = sheet_view();\r\n    int n = 0;\r\n    int nonempty = 0;\r\n    for (; *s; s++) {\r\n        if (*s == '\\n') {\r\n            if (nonempty) n++;\r\n            nonempty = 0;\r\n        } else if (*s != ' ' && *s != '\\r') nonempty = 1;\r\n    }\r\n    if (nonempty) n++;\r\n    return n;\r\n}\r\n\r\nint count_gap(void) {\r\n    int a = count_sheet_lines();\r\n    int b = count_emitters();\r\n    return (b < a) ? 1 : 0;\r\n}\r\n"]
[19.099535, "o", "/app/millscore/tally.h\r\n===== /app/millscore/tally.h\r\n#ifndef TALLY_H\r\n#define TALLY_H\r\nint count_gap(void);\r\n#endif\r\n\u001b[?2004hroot@dbb314e699db:/app# "]
[19.632032, "i", "for f in /app/rivetbay/notes/*.txt; do echo \"===== $f\"; cat \"$f\"; done\n"]
[19.632782, "o", "for f in /app/rivetbay/notes/*.txt; do echo \"===== $f\"; cat \"$f\"; done"]
[19.633491, "o", "\r\n\u001b[?2004l\r===== /app/rivetbay/notes/forms.txt\r\n"]
[19.634884, "o", "Event descriptions use NAME then FIELD lines. Ledger is name|relpath|field:kind,... .\r\nKDEC files start with KDEC1. Decode JSON uses kind decoded or unknown.\r\nDecode fields object keys are the FIELD names from that description (for example latch, force, amp, bit, thick, mm, q, n, w).\r\n"]
[19.635628, "o", "===== /app/rivetbay/notes/layout.txt\r\n"]
[19.638549, "o", "evd holds descriptions. intake/current.ledger is the mill roster. emitters hold kdec tables.\r\nframes hold packed samples. forgekit is the C pipeline.\r\n"]
[19.640742, "o", "===== /app/rivetbay/notes/ops.txt\r\n"]
[19.642303, "o", "After adding a description, mill may leave decode unknown even though discovery refreshed the on-disk ledger.\r\nUnknown decode is normal for frames that have no description on this bench.\r\n"]
[19.643432, "o", "\u001b[?2004hroot@dbb314e699db:/app# "]
[19.988442, "i", "/app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo \"evd=$(find /app/rivetbay/evd -maxdepth 1 -name '*.evd' | wc -l) emitters=$(find /app/rivetbay/emitters -maxdepth 1 -name '*.kdec' | wc -l)\"; cat /app/rivetbay/intake/current.ledger\n"]
[19.993654, "o", "/app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo \"evd=$(find /app/rivetbay/evd -maxdepth 1 -name '*.evd' | wc -l) emitters=$(find /app/rivetbay/emitters -maxdepth 1 -name '*.kdec' | wc -l)\"; cat /app/rivetbay/intake/current.ledger\r\n\u001b[?2004l\r"]
[19.995345, "o", "mill_rc=0\r\n"]
