Sending keys: ['cat >> stx/rr_scan.go <<\'EOF\'\n\n// RepairTail removes bytes starting at the first malformed or incomplete\n// record.  It preserves every complete record before that point.\nfunc RepairTail(store string) error {\n\tp := LogPath(store)\n\tf, err := os.OpenFile(p, os.O_CREATE|os.O_RDWR, 0644)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer f.Close()\n\tvar good int64\n\tfor {\n\t\t_, obj, err := NextBlock(f)\n\t\tif err != nil {\n\t\t\tif err := f.Truncate(good); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\treturn f.Sync()\n\t\t}\n\t\tif obj == nil {\n\t\t\treturn nil\n\t\t}\n\t\tgood, err = f.Seek(0, io.SeekCurrent)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n}\nEOF\npython3 - <<\'PY\'\np=\'stx/rr_scan.go\'\ns=open(p).read()\ns=s.replace(\'\'\'\\t\\tif err != nil {\n\\t\\t\\treturn nil, err\n\\t\\t}\'\'\',\'\'\'\\t\\tif err != nil {\n\\t\\t\\tif errors.Is(err, ErrTornTail) {\n\\t\\t\\t\\tbreak\n\\t\\t\\t}\n\\t\\t\\treturn out, err\n\\t\\t}\'\'\',1)\nopen(p,\'w\').write(s)\nPY\ncat > tab/mm_keep.go <<\'EOF\'\npackage tab\n\nimport (\n\t"encoding/json"\n\t"os"\n\t"path/filepath"\n)\n\nconst Name = "keep.json"\n\ntype Keep struct {\n\tGen int `json:"gen"`\n\tBaseFile string `json:"base_file"`\n\tCoveredSeq uint64 `json:"covered_seq"`\n\tLogBytes int64 `json:"log_bytes"`\n}\n\nfunc PathFor(store string) string { return filepath.Join(store, Name) }\n\nfunc ReadKeep(store string) Keep {\n\tdata, err := os.ReadFile(PathFor(store))\n\tif err != nil { return Keep{} }\n\tvar k Keep\n\tif json.Unmarshal(data, &k) != nil { return Keep{} }\n\treturn k\n}\n\nfunc writeKeepTemp(store string, keep Keep, fence func(*os.File)) error {\n\tf, err := os.OpenFile(PathFor(store)+".tmp", os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\n\tif err != nil { return err }\n\tif err = json.NewEncoder(f).Encode(keep); err != nil { f.Close(); return err }\n\tfence(f)\n\treturn f.Close()\n}\nEOF\ncat > tab/tt_press.go <<\'EOF\'\npackage tab\n\nimport (\n\t"encoding/json"\n\t