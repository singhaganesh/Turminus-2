     1	package main
     2	
     3	import (
     4		"os"
     5	)
     6	
     7	const KillExit = 67
     8	
     9	var crashTarget = -1
    10	var fenceCount = 0
    11	
    12	func Arm(target int) {
    13		crashTarget = target
    14		fenceCount = 0
    15		if crashTarget == 0 {
    16			os.Exit(KillExit)
    17		}
    18	}
    19	
    20	func Fence(f *os.File) {
    21		if f != nil {
    22			_ = f.Sync()
    23		}
    24		fenceCount++
    25		if crashTarget >= 0 && fenceCount >= crashTarget {
    26			os.Exit(KillExit)
    27		}
    28	}
