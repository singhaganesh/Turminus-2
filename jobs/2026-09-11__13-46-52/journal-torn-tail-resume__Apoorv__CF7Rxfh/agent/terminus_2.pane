# Keep the old library helper buildable and safe, though command orchestration owns crash fences.
cat > stx/cc_fold.go <<'EOF'
package stx

import (
	"os"
	"wrenkv/tab"
)

func LogSize(store string) int64 {
	st, err := os.Stat(LogPath(store)); if err != nil { return 0 }; return st.Size()
}
func TruncateLog(store string) error {
	f, err := os.OpenFile(LogPath(store), os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)
	if err != nil { return err }
	if err = f.Sync(); err != nil { f.Close(); return err }
	return f.Close()
}
func FoldTail(store string, rows map[string]Row, seq uint64, keep tab.Keep) error {
	size := LogSize(store)
	if err := tab.PressAndInstall(store, rows, seq, keep.Gen+1, size, func(f *os.File) { _ = f.Sync() }); err != nil { return err }
	return TruncateLog(store)
}
EOF
