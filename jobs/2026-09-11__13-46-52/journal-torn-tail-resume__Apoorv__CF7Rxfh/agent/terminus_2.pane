   133	func cmdRebuild(store string, crashAfter *int) int {
   134		st, err := os.Stat(store)
   135		if err != nil || !st.IsDir() {
   136			fmt.Fprintf(os.Stderr, "wrenkv: no such store directory\n")
   137			return 2
   138		}
   139		if crashAfter != nil {
   140			Arm(*crashAfter)
   141		}
   142		keep := tab.ReadKeep(store)
   143		bound := pickStart(keep)
   144		_, rows, seq, err := readState(store, &bound)
   145		if err != nil {
   146			fmt.Fprintf(os.Stderr, "wrenkv: %v\n", err)
   147			return 1
   148		}
   149		if err := stx.RepairTailFenced(store, Fence); err != nil {
   150			return 1
   151		}
   152		if err := tab.PressAndInstallFenced(store, rows, seq, keep.Gen+1, stx.LogSize(store), Fence); err != nil {
   153			return 1
   154		}
   155		return 0
   156	}
