     1	package stx
     2	
     3	import (
     4		"os"
     5	
     6		"wrenkv/tab"
     7	
     8	)
     9	
    10	func LogSize(store string) int64 {
    11		p := LogPath(store)
    12		st, err := os.Stat(p)
    13		if err != nil {
    14			return 0
    15		}
    16		return st.Size()
    17	}
    18	
    19	func TruncateLog(store string) error {
    20		p := LogPath(store)
    21		f, err := os.OpenFile(p, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)
    22		if err != nil {
    23			return err
    24		}
    25		_ = f.Sync()
    26		f.Close()
    27		return nil
    28	}
    29	
    30	func FoldTail(store string, rows map[string]Row, seq uint64, keep tab.Keep) error {
    31		size := LogSize(store)
    32		TruncateLog(store)
    33		return tab.PressAndInstall(store, rows, seq, keep.Gen+1, size)
    34	}
===== stx/rr_scan.go =====
     1	package stx
     2	
     3	import (
     4		"encoding/binary"
     5		"encoding/json"
     6		"errors"
     7		"fmt"
     8		"hash/crc32"
     9		"io"
    10		"os"
    11		"path/filepath"
    12		"strconv"
    13	)
    14	
    15	var Magic = []byte("WRKV")
    16	
    17	const (
    18		HeadSize   = 20
    19		MaxPayload = 1 << 20
    20		LogName    = "append.log"
    21	)
    22	
    23	type Row struct {
    24		Value string `json:"v"`
    25		Rev   uint64 `json:"rev"`
    26	}
    27	
    28	var ErrTornTail = errors.New("integrity check failed in append log")
    29	
    30	func LogPath(store string) string {
    31		return filepath.Join(store, LogName)
    32	}
    33	
    34	func Frame(seq uint64, payloadObj interface{}) ([]byte, error) {
    35		payload, err := json.Marshal(payloadObj)
    36		if err != nil {
    37			return nil, err
    38		}
    39		crc := crc32.ChecksumIEEE(payload)
    40		buf := make([]byte, HeadSize+len(payload))
    41		copy(buf[0:4], Magic)
    42		binary.BigEndian.PutUint64(buf[4:12], seq)
    43		binary.BigEndian.PutUint32(buf[12:16], uint32(len(payload)))
    44		binary.BigEndian.PutUint32(buf[16:20], crc)
    45		copy(buf[20:], payload)
    46		return buf, nil
    47	}
    48	
    49	func NextBlock(f *os.File) (uint64, map[string]interface{}, error) {
    50		head := make([]byte, HeadSize)
    51		n, err := io.ReadFull(f, head)
    52		if err == io.EOF || n == 0 {
    53			return 0, nil, nil
    54		}
    55		if n < HeadSize {
    56			return 0, nil, ErrTornTail
    57		}
    58		if string(head[0:4]) != string(Magic) {
    59			return 0, nil, ErrTornTail
    60		}
    61		seq := binary.BigEndian.Uint64(head[4:12])
    62		plen := binary.BigEndian.Uint32(head[12:16])
    63		crc := binary.BigEndian.Uint32(head[16:20])
    64		if plen > MaxPayload {
    65			return 0, nil, ErrTornTail
    66		}
    67		payload := make([]byte, plen)
    68		pn, perr := io.ReadFull(f, payload)
    69		if perr != nil || pn < int(plen) {
    70			return 0, nil, ErrTornTail
    71		}
    72		if crc32.ChecksumIEEE(payload) != crc {
    73			return 0, nil, ErrTornTail
    74		}
    75		var obj map[string]interface{}
    76		if err := json.Unmarshal(payload, &obj); err != nil {
    77			return 0, nil, ErrTornTail
    78		}
    79		return seq, obj, nil
    80	}
    81	
    82	func ScanRecords(f *os.File, startAfter uint64) ([]struct {
    83		Seq uint64
    84		Op  map[string]interface{}
    85	}, error) {
    86		var out []struct {
    87			Seq uint64
    88			Op  map[string]interface{}
    89		}
    90		for {
    91			seq, obj, err := NextBlock(f)
    92			if err != nil {
    93				return nil, err
    94			}
    95			if obj == nil {
    96				break
    97			}
    98			if seq > startAfter {
    99				out = append(out, struct {
   100					Seq uint64
   101					Op  map[string]interface{}
   102				}{Seq: seq, Op: obj})
   103			}
   104		}
   105		return out, nil
   106	}
   107	
   108	func ApplyOp(rows map[string]Row, seq uint64, payload map[string]interface{}) error {
   109		kind, _ := payload["op"].(string)
   110		key, _ := payload["key"].(string)
   111		switch kind {
   112		case "put":
   113			val, _ := payload["value"].(string)
   114			rows[key] = Row{Value: val, Rev: seq}
   115		case "del":
   116			delete(rows, key)
   117		case "incr":
   118			curStr := "0"
   119			if existing, ok := rows[key]; ok {
   120				curStr = existing.Value
   121			}
   122			curVal, err := strconv.ParseInt(curStr, 10, 64)
   123			if err != nil {
   124				return fmt.Errorf("key %s does not hold an integer", key)
   125			}
   126			var delta int64
   127			if dFloat, ok := payload["delta"].(float64); ok {
   128				delta = int64(dFloat)
   129			}
   130			rows[key] = Row{Value: strconv.FormatInt(curVal+delta, 10), Rev: seq}
   131		}
   132		return nil
   133	}
===== tab/mm_keep.go =====
     1	package tab
     2	
     3	import (
     4		"encoding/json"
     5		"os"
     6		"path/filepath"
     7	)
     8	
     9	const Name = "keep.json"
    10	
    11	type Keep struct {
    12		Gen        int    `json:"gen"`
    13		BaseFile   string `json:"base_file"`
    14		CoveredSeq uint64 `json:"covered_seq"`
    15		LogBytes   int64  `json:"log_bytes"`
    16	}
    17	
    18	func PathFor(store string) string {
    19		return filepath.Join(store, Name)
    20	}
    21	
    22	func ReadKeep(store string) Keep {
    23		p := PathFor(store)
    24		data, err := os.ReadFile(p)
    25		if err != nil {
    26			return Keep{Gen: 0, BaseFile: "", CoveredSeq: 0, LogBytes: 0}
    27		}
    28		var k Keep
    29		if err := json.Unmarshal(data, &k); err != nil {
    30			return Keep{Gen: 0, BaseFile: "", CoveredSeq: 0, LogBytes: 0}
    31		}
    32		return k
    33	}
    34	
    35	func WriteKeep(store string, keep Keep) error {
    36		tmp := PathFor(store) + ".tmp"
    37		f, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)
    38		if err != nil {
    39			return err
    40		}
    41		enc := json.NewEncoder(f)
    42		enc.SetIndent("", "")
    43		if err := enc.Encode(keep); err != nil {
    44			f.Close()
    45			return err
    46		}
    47		_ = f.Sync()
    48		f.Close()
    49		return nil
    50	}
