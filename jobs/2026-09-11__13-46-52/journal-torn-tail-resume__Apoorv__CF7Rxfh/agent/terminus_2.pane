===== tab/staged.go =====
     1	package tab
     2	
     3	import (
     4		"encoding/json"
     5		"os"
     6		"path/filepath"
     7	)
     8	
     9	// ScanPendingBaseSeq inspects leftover uncommitted base snapshot files (*.tbl.tmp)
    10	// in the store directory and returns the highest embedded sequence number.
    11	// This allows recovery routines to resume from staged compaction or bake state.
    12	// Returns 0 if no candidate snapshot is present.
    13	func ScanPendingBaseSeq(store string) uint64 {
    14		matches, err := filepath.Glob(filepath.Join(store, "base-*.tbl.tmp"))
    15		if err != nil || len(matches) == 0 {
    16			return 0
    17		}
    18		var highest uint64
    19		for _, m := range matches {
    20			data, err := os.ReadFile(m)
    21			if err != nil {
    22				continue
    23			}
    24			var snap struct {
    25				Seq uint64 `json:"seq"`
    26			}
    27			if err := json.Unmarshal(data, &snap); err == nil {
    28				if snap.Seq > highest {
    29					highest = snap.Seq
    30				}
    31			}
    32		}
    33		return highest
    34	}
===== tab/tt_press.go =====
     1	package tab
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"os"
     7		"path/filepath"
     8	
     9	
    10	
    11	)
    12	
    13	func BaseName(gen int) string {
    14		return fmt.Sprintf("base-%d.tbl", gen)
    15	}
    16	
    17	func PressAndInstall(store string, rows interface{}, seq uint64, gen int, logBytes int64) error {
    18		tmp := filepath.Join(store, BaseName(gen)+".tmp")
    19		final := filepath.Join(store, BaseName(gen))
    20		keep := Keep{
    21			Gen:        gen,
    22			BaseFile:   BaseName(gen),
    23			CoveredSeq: seq,
    24			LogBytes:   logBytes,
    25		}
    26		f, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)
    27		if err != nil {
    28			return err
    29		}
    30		snapshot := struct {
    31			Gen  int                `json:"gen"`
    32			Seq  uint64             `json:"seq"`
    33			Rows interface{} `json:"rows"`
    34		}{
    35			Gen:  gen,
    36			Seq:  seq,
    37			Rows: rows,
    38		}
    39		if err := json.NewEncoder(f).Encode(snapshot); err != nil {
    40			f.Close()
    41			return err
    42		}
    43		os.Rename(tmp, final)
    44		WriteKeep(store, keep)
    45		_ = f.Sync()
    46		f.Close()
    47		return nil
    48	}
===== wk/fence.go =====
     1	package main
     2	
     3	import (
     4		"os"
     5	)
     6	
     7	const KillExit = 67
     8	
     9	var crashTarget = -1
    10	var fenceCount = 0
    11	
    12	func Arm(target int) {
    13		crashTarget = target
    14		fenceCount = 0
    15		if crashTarget == 0 {
    16			os.Exit(KillExit)
    17		}
    18	}
    19	
    20	func Fence(f *os.File) {
    21		if f != nil {
    22			_ = f.Sync()
    23		}
    24		fenceCount++
    25		if crashTarget >= 0 && fenceCount >= crashTarget {
    26			os.Exit(KillExit)
    27		}
    28	}
===== wk/main.go =====
     1	package main
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"os"
     7		"path/filepath"
     8		"sort"
     9		"strconv"
    10	
    11		"wrenkv/stx"
    12		"wrenkv/tab"
    13	)
    14	
    15	const Usage = `usage: wrenkv load DIR --ops FILE [--crash-after N | --crash-tail N]
    16	       wrenkv recover DIR [--crash-after N]
    17	       wrenkv compact DIR [--crash-after N]
    18	       wrenkv dump DIR`
    19	
    20	func readState(store string, startAfter *uint64) (tab.Keep, map[string]stx.Row, uint64, error) {
    21		keep := tab.ReadKeep(store)
    22		var boundary uint64 = keep.CoveredSeq
    23		if startAfter != nil {
    24			boundary = *startAfter
    25		}
    26		rows := make(map[string]stx.Row)
    27		if keep.BaseFile != "" {
    28			bp := filepath.Join(store, keep.BaseFile)
    29			if data, err := os.ReadFile(bp); err == nil && len(data) > 0 {
    30				var snap struct {
    31					Rows map[string]stx.Row `json:"rows"`
    32				}
    33				if err := json.Unmarshal(data, &snap); err == nil && snap.Rows != nil {
    34					rows = snap.Rows
    35				}
    36			}
    37		}
    38		last := keep.CoveredSeq
    39		lp := stx.LogPath(store)
    40		if f, err := os.Open(lp); err == nil {
    41			defer f.Close()
    42			records, err := stx.ScanRecords(f, boundary)
    43			if err != nil {
    44				return keep, rows, last, err
    45			}
    46			for _, rec := range records {
    47				if err := stx.ApplyOp(rows, rec.Seq, rec.Op); err != nil {
    48					return keep, rows, last, err
    49				}
    50				last = rec.Seq
    51			}
    52		}
    53		if last < keep.CoveredSeq {
    54			last = keep.CoveredSeq
    55		}
    56		return keep, rows, last, nil
    57	}
    58	
    59	func pickStart(keep tab.Keep) uint64 {
    60		return keep.CoveredSeq
    61	}
    62	
    63	func cmdLoad(store, opsPath string, crashAfter, crashTail *int) int {
    64		data, err := os.ReadFile(opsPath)
    65		if err != nil {
    66			fmt.Fprintf(os.Stderr, "wrenkv: %v\n", err)
    67			return 2
    68		}
    69		ops, err := ParseOps(string(data))
    70		if err != nil {
    71			fmt.Fprintf(os.Stderr, "wrenkv: %v\n", err)
    72			return 2
    73		}
    74		os.MkdirAll(store, 0755)
    75		keep, rows, lastSeq, err := readState(store, nil)
    76		if err != nil {
    77			fmt.Fprintf(os.Stderr, "wrenkv: %v\n", err)
    78			return 1
    79		}
    80		_ = keep
    81		if crashAfter != nil {
    82			Arm(*crashAfter)
    83		}
    84		lp := stx.LogPath(store)
    85		logFile, err := os.OpenFile(lp, os.O_CREATE|os.O_RDWR|os.O_APPEND, 0644)
    86		if err != nil {
    87			fmt.Fprintf(os.Stderr, "wrenkv: %v\n", err)
    88			return 1
    89		}
    90		defer logFile.Close()
    91	
    92		for i, op := range ops {
    93			opMap := map[string]interface{}{
    94				"op":  op.Kind,
    95				"key": op.Key,
    96			}
    97			if op.Kind == "put" {
    98				opMap["value"] = op.Value
    99			} else if op.Kind == "incr" {
   100				curVal := int64(0)
   101				if existing, ok := rows[op.Key]; ok {
   102					c, err := strconv.ParseInt(existing.Value, 10, 64)
   103					if err != nil {
   104						fmt.Fprintf(os.Stderr, "wrenkv: key %q does not hold an integer\n", op.Key)
   105						return 2
   106					}
   107					curVal = c
   108				}
   109				opMap["delta"] = op.Delta
   110				opMap["value"] = strconv.FormatInt(curVal+op.Delta, 10)
   111			}
   112			seq := lastSeq + 1
   113			lastSeq = seq
   114			rec, err := stx.Frame(seq, opMap)
   115			if err != nil {
   116				return 1
   117			}
   118			if crashTail != nil && i == *crashTail {
   119				half := len(rec) / 2
   120				logFile.Write(rec[:half])
   121				logFile.Sync()
   122				os.Exit(KillExit)
   123			}
   124			if _, err := logFile.Write(rec); err != nil {
   125				return 1
   126			}
   127			Fence(logFile)
   128			stx.ApplyOp(rows, seq, opMap)
   129		}
   130		return 0
   131	}
   132	
   133	func cmdRebuild(store string, crashAfter *int) int {
   134		st, err := os.Stat(store)
   135		if err != nil || !st.IsDir() {
   136			fmt.Fprintf(os.Stderr, "wrenkv: no such store directory\n")
   137			return 2
   138		}
   139		if crashAfter != nil {
   140			Arm(*crashAfter)
   141		}
   142		keep := tab.ReadKeep(store)
   143		bound := pickStart(keep)
   144		_, rows, seq, err := readState(store, &bound)
   145		if err != nil {
   146			fmt.Fprintf(os.Stderr, "wrenkv: %v\n", err)
   147			return 1
   148		}
   149		if err := tab.PressAndInstall(store, rows, seq, keep.Gen+1, stx.LogSize(store)); err != nil {
   150			return 1
   151		}
   152		return 0
   153	}
   154	
   155	func cmdCompact(store string, crashAfter *int) int {
   156		st, err := os.Stat(store)
   157		if err != nil || !st.IsDir() {
   158			fmt.Fprintf(os.Stderr, "wrenkv: no such store directory\n")
   159			return 2
   160		}
   161		if crashAfter != nil {
   162			Arm(*crashAfter)
   163		}
   164		keep, rows, seq, err := readState(store, nil)
   165		if err != nil {
   166			fmt.Fprintf(os.Stderr, "wrenkv: %v\n", err)
   167			return 1
   168		}
   169		if err := stx.FoldTail(store, rows, seq, keep); err != nil {
   170			return 1
   171		}
   172		return 0
   173	}
   174	
   175	func cmdDump(store string) int {
   176		st, err := os.Stat(store)
   177		if err != nil || !st.IsDir() {
   178			fmt.Fprintf(os.Stderr, "wrenkv: no such store directory\n")
   179			return 2
   180		}
   181		keep, rows, _, err := readState(store, nil)
   182		if err != nil {
   183			fmt.Fprintf(os.Stderr, "wrenkv: %v\n", err)
   184			return 1
   185		}
   186		type Entry struct {
   187			Key   string `json:"key"`
   188			Rev   uint64 `json:"rev"`
   189			Value string `json:"value"`
   190		}
   191		var entries []Entry
   192		for k, r := range rows {
   193			entries = append(entries, Entry{Key: k, Rev: r.Rev, Value: r.Value})
   194		}
   195		sort.Slice(entries, func(i, j int) bool {
   196			return entries[i].Key < entries[j].Key
   197		})
   198		if entries == nil {
   199			entries = []Entry{}
   200		}
   201		out := map[string]interface{}{
   202			"covered_seq": keep.CoveredSeq,
   203			"entries":     entries,
   204		}
   205		data, _ := json.Marshal(out)
   206		fmt.Println(string(data))
   207		return 0
   208	}
   209	
   210	func main() {
   211		if len(os.Args) < 2 || os.Args[1] == "-h" || os.Args[1] == "--help" {
   212			fmt.Fprintln(os.Stderr, Usage)
   213			if len(os.Args) < 2 {
   214				os.Exit(2)
   215			}
   216			os.Exit(0)
   217		}
   218		cmd := os.Args[1]
   219		if cmd != "load" && cmd != "recover" && cmd != "compact" && cmd != "dump" {
   220			fmt.Fprintln(os.Stderr, Usage)
   221			os.Exit(2)
   222		}
   223	
   224		var store string
   225		var opsPath string
   226		var crashAfter *int
   227		var crashTail *int
   228	
   229		args := os.Args[2:]
   230		for i := 0; i < len(args); i++ {
   231			a := args[i]
   232			if a == "--ops" {
   233				i++
   234				if i >= len(args) {
   235					fmt.Fprintln(os.Stderr, "wrenkv: --ops needs a file")
   236					os.Exit(2)
   237				}
   238				opsPath = args[i]
   239			} else if a == "--crash-after" {
   240				i++
   241				if i >= len(args) {
   242					fmt.Fprintln(os.Stderr, "wrenkv: --crash-after needs N")
   243					os.Exit(2)
   244				}
   245				n, err := strconv.Atoi(args[i])
   246				if err != nil || n < 0 {
   247					fmt.Fprintln(os.Stderr, "wrenkv: --crash-after needs N >= 0")
   248					os.Exit(2)
   249				}
   250				crashAfter = &n
   251			} else if a == "--crash-tail" {
   252				i++
   253				if i >= len(args) {
   254					fmt.Fprintln(os.Stderr, "wrenkv: --crash-tail needs N")
   255					os.Exit(2)
   256				}
   257				n, err := strconv.Atoi(args[i])
   258				if err != nil || n < 0 {
   259					fmt.Fprintln(os.Stderr, "wrenkv: --crash-tail needs N >= 0")
   260					os.Exit(2)
   261				}
   262				crashTail = &n
   263			} else {
   264				if store != "" {
   265					fmt.Fprintln(os.Stderr, "wrenkv: expected exactly one store directory")
   266					os.Exit(2)
   267				}
   268				store = a
   269			}
   270		}
   271	
   272		if store == "" {
   273			fmt.Fprintln(os.Stderr, "wrenkv: expected exactly one store directory")
   274			os.Exit(2)
   275		}
   276		if cmd == "load" && opsPath == "" {
   277			fmt.Fprintln(os.Stderr, "wrenkv: load needs --ops FILE")
   278			os.Exit(2)
   279		}
   280		if cmd != "load" && opsPath != "" {
   281			fmt.Fprintln(os.Stderr, "wrenkv: --ops only applies to load")
   282			os.Exit(2)
   283		}
   284		if cmd != "load" && crashTail != nil {
   285			fmt.Fprintln(os.Stderr, "wrenkv: --crash-tail only applies to load")
   286			os.Exit(2)
   287		}
   288	
   289		switch cmd {
   290		case "load":
   291			os.Exit(cmdLoad(store, opsPath, crashAfter, crashTail))
   292		case "recover":
   293			os.Exit(cmdRebuild(store, crashAfter))
   294		case "compact":
   295			os.Exit(cmdCompact(store, crashAfter))
   296		case "dump":
   297			os.Exit(cmdDump(store))
   298		}
   299	}
