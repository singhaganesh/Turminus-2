     1	package main
     2	
     3	import (
     4		"fmt"
     5		"regexp"
     6		"strconv"
     7		"strings"
     8	)
     9	
    10	type Op struct {
    11		Kind  string `json:"op"`
    12		Key   string `json:"key"`
    13		Value string `json:"value,omitempty"`
    14		Delta int64  `json:"delta,omitempty"`
    15	}
    16	
    17	var keyPattern = regexp.MustCompile(`^[A-Za-z0-9._:-]{1,64}$`)
    18	
    19	func ParseOps(content string) ([]Op, error) {
    20		var ops []Op
    21		lines := strings.Split(content, "\n")
    22		for lineNum, line := range lines {
    23			line = strings.TrimSpace(line)
    24			if line == "" || strings.HasPrefix(line, "#") {
    25				continue
    26			}
    27			parts := strings.Fields(line)
    28			if len(parts) == 0 {
    29				continue
    30			}
    31			cmd := parts[0]
    32			switch cmd {
    33			case "put":
    34				if len(parts) != 3 {
    35					return nil, fmt.Errorf("line %d: invalid put syntax", lineNum+1)
    36				}
    37				key, val := parts[1], parts[2]
    38				if !keyPattern.MatchString(key) || len(val) < 1 || len(val) > 256 {
    39					return nil, fmt.Errorf("line %d: invalid key or value format", lineNum+1)
    40				}
    41				ops = append(ops, Op{Kind: "put", Key: key, Value: val})
    42			case "del":
    43				if len(parts) != 2 {
    44					return nil, fmt.Errorf("line %d: invalid del syntax", lineNum+1)
    45				}
    46				key := parts[1]
    47				if !keyPattern.MatchString(key) {
    48					return nil, fmt.Errorf("line %d: invalid key format", lineNum+1)
    49				}
    50				ops = append(ops, Op{Kind: "del", Key: key})
    51			case "incr":
    52				if len(parts) != 3 {
    53					return nil, fmt.Errorf("line %d: invalid incr syntax", lineNum+1)
    54				}
    55				key := parts[1]
    56				delta, err := strconv.ParseInt(parts[2], 10, 64)
    57				if err != nil || !keyPattern.MatchString(key) {
    58					return nil, fmt.Errorf("line %d: invalid incr format", lineNum+1)
    59				}
    60				ops = append(ops, Op{Kind: "incr", Key: key, Delta: delta})
    61			default:
    62				return nil, fmt.Errorf("line %d: unknown operation %q", lineNum+1, cmd)
    63			}
    64		}
    65		return ops, nil
    66	}
