[58.494748, "o", "\"path/filepath\"\r\n     7\t)\r\n     8\t\r\n     9\t// ScanPendingBaseSeq inspects leftover uncommitted base snapshot files (*.tbl.tmp)\r\n    10\t// in the store directory and returns the highest embedded sequence number.\r\n    11\t// This allows recovery routines to resume from staged compaction or bake state.\r\n    12\t// Returns 0 if no candidate snapshot is present.\r\n    13\tfunc ScanPendingBaseSeq(store string) uint64 {\r\n    14\t\tmatches, err := filepath.Glob(filepath.Join(store, \"base-*.tbl.tmp\"))\r\n    15\t\tif err != nil || len(matches) == 0 {\r\n    16\t\t\treturn 0\r\n    17\t\t}\r\n    18\t\tvar highest uint64\r\n    19\t\tfor _, m := range matches {\r\n    20\t\t\tdata, err := os.ReadFile(m)\r\n    21\t\t\tif err != nil {\r\n    22\t\t\t\tcontinue\r\n    23\t\t\t}\r\n    24\t\t\tvar snap struct {\r\n    25\t\t\t\tSeq uint64 `json:\"seq\"`\r\n    26\t\t\t}\r\n    27\t\t\t"]
[58.494863, "o", "if err := json.Unmarshal(data, &snap); err == nil {\r\n    28\t\t\t\tif snap.Seq > highest {\r\n    29\t\t\t\t\thighest = snap.Seq\r\n    30\t\t\t\t}\r\n    31\t\t\t}\r\n    32\t\t}\r\n    33\t\treturn highest\r\n    34\t}\r\n"]
[58.495812, "o", "===== tab/tt_press.go =====\r\n"]
