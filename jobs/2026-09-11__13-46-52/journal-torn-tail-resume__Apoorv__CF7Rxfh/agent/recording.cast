[32.57725, "o", "     7\t\t\"strings\"\r\n     8\t)\r\n     9\t\r\n    10\ttype Op struct {\r\n    11\t\tKind  string `json:\"op\"`\r\n    12\t\tKey   string `json:\"key\"`\r\n    13\t\tValue string `json:\"value,omitempty\"`\r\n    14\t\tDelta int64  `json:\"delta,omitempty\"`\r\n    15\t}\r\n    16\t\r\n    17\tvar keyPattern = regexp.MustCompile(`^[A-Za-z0-9._:-]{1,64}$`)\r\n    18\t\r\n    19\tfunc ParseOps(content string) ([]Op, error) {\r\n    20\t\tvar ops []Op\r\n    21\t\tlines := strings.Split(content, \"\\n\")\r\n"]
[32.577291, "o", "    22\t\tfor lineNum, line := range lines {\r\n    23\t\t\tline = strings.TrimSpace(line)\r\n    24\t\t\tif line == \"\" || strings.HasPrefix(line, \"#\") {\r\n    25\t\t\t\tcontinue\r\n    26\t\t\t}\r\n    27\t\t\tparts := strings.Fields(line)\r\n    28\t\t\tif len(parts) == 0 {\r\n    29\t\t\t\tcontinue\r\n    30\t\t\t}\r\n    31\t\t\tcmd := parts[0]\r\n    32\t\t\tswitch cmd {\r\n"]
[32.577337, "o", "    33\t\t\tcase \"put\":\r\n    34\t\t\t\tif len(parts) != 3 {\r\n    35\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid put syntax\", lineNum+1)\r\n    36\t\t\t\t}\r\n    37\t\t\t\tkey, val := parts[1], parts[2]\r\n    38\t\t\t\tif !keyPattern.MatchString(key) || len(val) < 1 || len(val) > 256 {\r\n    39\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid key or value format\", lineNum+1)\r\n    40\t\t\t\t}\r\n    41\t\t\t\t"]
[32.577381, "o", "ops = append(ops, Op{Kind: \"put\", Key: key, Value: val})\r\n    42\t\t\tcase \"del\":\r\n    43\t\t\t\tif len(parts) != 2 {\r\n    44\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid del syntax\", lineNum+1)\r\n    45\t\t\t\t}\r\n    46\t\t\t\tkey := parts[1]\r\n    47\t\t\t\tif !keyPattern.MatchString(key) {\r\n    48\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid key format\", lineNum+1)\r\n    49\t\t\t\t}\r\n    50\t\t\t\tops = append(ops, Op{Kind: \"del\", Key: key})\r\n"]
[32.57744, "o", "    51\t\t\tcase \"incr\":\r\n    52\t\t\t\tif len(parts) != 3 {\r\n    53\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid incr syntax\", lineNum+1)\r\n    54\t\t\t\t}\r\n    55\t\t\t\tkey := parts[1]\r\n    56\t\t\t\tdelta, err := strconv.ParseInt(parts[2], 10, 64)\r\n    57\t\t\t\tif err != nil || !keyPattern.MatchString(key) {\r\n    58\t\t\t\t\treturn nil, fmt.Errorf(\"line %d: invalid incr format\", lineNum+1)\r\n    59\t\t\t\t}\r\n    60\t\t\t\tops = append(ops, Op{Kind: \"incr\", Key: key, Delta: delta})\r\n    61\t\t\tdefault:\r\n    62\t\t\t\treturn nil, fmt.Errorf(\"line %d: unknown operation %q\", lineNum+1, cmd)\r\n"]
[32.577482, "o", "    63\t\t\t}\r\n    64\t\t}\r\n    65\t\treturn ops, nil\r\n    66\t}\r\n"]
