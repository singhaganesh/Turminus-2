[82.012843, "o", "\ttype Entry struct {\r\n\t\tKey   string `json:\"key\"`\r\n\t\tRev   uint64 `json:\"rev\"`\r\n\t\tValue string `json:\"value\"`\r\n\t}\r\n\tvar entries []Entry\r\n\tfor k, r := range rows {\r\n"]
[82.012858, "o", "\t\tentries = append(entries, Entry{Key: k, Rev: r.Rev, Value: r.Value})\r\n\t}\r\n\tsort.Slice(entries, func(i, j int) bool {\r\n\t\treturn entries[i].Key < entries[j].Key\r\n\t})\r\n"]
[82.01287, "o", "\tif entries == nil {\r\n\t\tentries = []Entry{}\r\n\t}\r\n\t"]
