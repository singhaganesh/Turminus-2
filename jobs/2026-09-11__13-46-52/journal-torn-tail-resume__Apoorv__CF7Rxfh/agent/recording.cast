[190.252533, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[190.25258, "o", "\u001b[?2004h> "]
[190.252765, "o", "func PathFor(store string) string { return filepath.Join(store, Name) }\r\n\u001b[?2004l\r"]
[190.252815, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
