[32.564976, "o", "===== stx/cc_fold.go =====\r\n"]
[32.567077, "o", "     1\tpackage stx\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"os\"\r\n     5\t\r\n     6\t\t\"wrenkv/tab\"\r\n     7\t\r\n     8\t)\r\n     9\t\r\n    10\tfunc LogSize(store string) int64 {\r\n"]
[32.567199, "o", "    11\t\tp := LogPath(store)\r\n    12\t\tst, err := os.Stat(p)\r\n    13\t\tif err != nil {\r\n    14\t\t\treturn 0\r\n    15\t\t}\r\n    16\t\treturn st.Size()\r\n    17\t}\r\n    18\t\r\n    19\tfunc TruncateLog(store string) error {\r\n    20\t\tp := LogPath(store)\r\n    21\t\tf, err := os.OpenFile(p, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n    22\t\tif err != nil {\r\n    23\t\t\treturn err\r\n    24\t\t}\r\n    25\t\t_ = f.Sync()\r\n    26\t\tf.Close()\r\n    27\t\treturn nil\r\n    28\t}\r\n    29\t\r\n    30\tfunc FoldTail(store string, rows map[string]Row, seq uint64, keep tab.Keep) error {\r\n    31\t\tsize := LogSize(store)\r\n    32\t\tTruncateLog(store)\r\n    33\t\treturn tab.PressAndInstall(store, rows, seq, keep.Gen+1, size)\r\n    34\t}\r\n"]
[32.567407, "o", "===== stx/rr_scan.go =====\r\n"]
[32.568292, "o", "     1\tpackage stx\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/binary\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"errors\"\r\n     7\t\t\"fmt\"\r\n"]
[32.568368, "o", "     8\t\t\"hash/crc32\"\r\n     9\t\t\"io\"\r\n    10\t\t\"os\"\r\n    11\t\t\"path/filepath\"\r\n    12\t\t\"strconv\"\r\n    13\t)\r\n    14\t\r\n    15\tvar Magic = []byte(\"WRKV\")\r\n    16\t\r\n    17\tconst (\r\n    18\t\tHeadSize   = 20\r\n    19\t\tMaxPayload = 1 << 20\r\n    20\t\tLogName    = \"append.log\"\r\n    21\t)\r\n    22\t\r\n    23\ttype Row struct {\r\n    24\t\tValue string `json:\"v\"`\r\n    25\t\tRev   uint64 `json:\"rev\"`\r\n    26\t}\r\n    27\t\r\n    28\tvar ErrTornTail = errors.New(\"integrity check failed in append log\")\r\n"]
[32.568429, "o", "    29\t\r\n    30\tfunc LogPath(store string) string {\r\n    31\t\treturn filepath.Join(store, LogName)\r\n    32\t}\r\n    33\t\r\n    34\tfunc Frame(seq uint64, payloadObj interface{}) ([]byte, error) {\r\n    35\t\tpayload, err := json.Marshal(payloadObj)\r\n    36\t\tif err != nil {\r\n    37\t\t\treturn nil, err\r\n    38\t\t}\r\n    39\t\tcrc := crc32.ChecksumIEEE(payload)\r\n    40\t\tbuf := make([]byte, HeadSize+len(payload))\r\n    41\t\tcopy(buf[0:4], Magic)\r\n    42\t\tbinary.BigEndian.PutUint64(buf[4:12], seq)\r\n"]
[32.568485, "o", "    43\t\tbinary.BigEndian.PutUint32(buf[12:16], uint32(len(payload)))\r\n    44\t\tbinary.BigEndian.PutUint32(buf[16:20], crc)\r\n    45\t\tcopy(buf[20:], payload)\r\n    46\t\treturn buf, nil\r\n    47\t}\r\n    48\t\r\n    49\tfunc NextBlock(f *os.File) (uint64, map[string]interface{}, error) {\r\n    50\t\thead := make([]byte, HeadSize)\r\n    51\t\tn, err := io.ReadFull(f, head)\r\n    52\t\tif err == io.EOF || n == 0 {\r\n    53\t\t\treturn 0, nil, nil\r\n    54\t\t}\r\n    55\t\tif n < HeadSize {\r\n    56\t\t\treturn 0, nil, ErrTornTail\r\n"]
[32.568542, "o", "    57\t\t}\r\n    58\t\tif string(head[0:4]) != string(Magic) {\r\n    59\t\t\treturn 0, nil, ErrTornTail\r\n    60\t\t}\r\n    61\t\tseq := binary.BigEndian.Uint64(head[4:12])\r\n    62\t\tplen := binary.BigEndian.Uint32(head[12:16])\r\n    63\t\tcrc := binary.BigEndian.Uint32(head[16:20])\r\n    64\t\tif plen > MaxPayload {\r\n    65\t\t\treturn 0, nil, ErrTornTail\r\n    66\t\t}\r\n    67\t\tpayload := make([]byte, plen)\r\n    68\t\tpn, perr := io.ReadFull(f, payload)\r\n    69\t\tif perr != nil || pn < int(plen) {\r\n"]
[32.568603, "o", "    70\t\t\treturn 0, nil, ErrTornTail\r\n    71\t\t}\r\n    72\t\tif crc32.ChecksumIEEE(payload) != crc {\r\n    73\t\t\treturn 0, nil, ErrTornTail\r\n    74\t\t}\r\n    75\t\tvar obj map[string]interface{}\r\n    76\t\tif err := json.Unmarshal(payload, &obj); err != nil {\r\n    77\t\t\treturn 0, nil, ErrTornTail\r\n    78\t\t}\r\n    79\t\treturn seq, obj, nil\r\n    80\t}\r\n    81\t\r\n    82\tfunc ScanRecords(f *os.File, startAfter uint64) ([]struct {\r\n    83\t\tSeq uint64\r\n"]
[32.568673, "o", "    84\t\tOp  map[string]interface{}\r\n    85\t}, error) {\r\n    86\t\tvar out []struct {\r\n    87\t\t\tSeq uint64\r\n    88\t\t\tOp  map[string]interface{}\r\n    89\t\t}\r\n    90\t\tfor {\r\n    91\t\t\tseq, obj, err := NextBlock(f)\r\n    92\t\t\tif err != nil {\r\n    93\t\t\t\treturn nil, err\r\n    94\t\t\t}\r\n    95\t\t\tif obj == nil {\r\n    96\t\t\t\tbreak\r\n    97\t\t\t}\r\n"]
[32.568748, "o", "    98\t\t\tif seq > startAfter {\r\n    99\t\t\t\tout = append(out, struct {\r\n   100\t\t\t\t\tSeq uint64\r\n   101\t\t\t\t\tOp  map[string]interface{}\r\n   102\t\t\t\t}{Seq: seq, Op: obj})\r\n   103\t\t\t}\r\n   104\t\t}\r\n   105\t\treturn out, nil\r\n   106\t}\r\n   107\t\r\n   108\tfunc ApplyOp(rows map[string]Row, seq uint64, payload map[string]interface{}) error {\r\n   109\t\tkind, _ := payload[\"op\"].(string)\r\n   110\t\tkey, _ := payload[\"key\"].(string)\r\n   111\t\tswitch kind {\r\n   112\t\tcase \"put\":\r\n   113\t\t\tval, _ := payload[\"value\"].(string)\r\n   114\t\t\trows[key] = Row{Value: val, Rev: seq}\r\n"]
[32.568799, "o", "   115\t\tcase \"del\":\r\n   116\t\t\tdelete(rows, key)\r\n   117\t\tcase \"incr\":\r\n   118\t\t\tcurStr := \"0\"\r\n   119\t\t\tif existing, ok := rows[key]; ok {\r\n   120\t\t\t\tcurStr = existing.Value\r\n   121\t\t\t}\r\n   122\t\t\tcurVal, err := strconv.ParseInt(curStr, 10, 64)\r\n   123\t\t\tif err != nil {\r\n   124\t\t\t\treturn fmt.Errorf(\"key %s does not hold an integer\", key)\r\n   125\t\t\t}\r\n   126\t\t\tvar delta int64\r\n"]
[32.568852, "o", "   127\t\t\tif dFloat, ok := payload[\"delta\"].(float64); ok {\r\n   128\t\t\t\tdelta = int64(dFloat)\r\n   129\t\t\t}\r\n   130\t\t\trows[key] = Row{Value: strconv.FormatInt(curVal+delta, 10), Rev: seq}\r\n   131\t\t}\r\n   132\t\treturn nil\r\n   133\t}\r\n"]
[32.56905, "o", "===== tab/mm_keep.go =====\r\n"]
[32.569865, "o", "     1\tpackage tab\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t)\r\n"]
[32.569963, "o", "     8\t\r\n     9\tconst Name = \"keep.json\"\r\n    10\t\r\n    11\ttype Keep struct {\r\n    12\t\tGen        int    `json:\"gen\"`\r\n    13\t\tBaseFile   string `json:\"base_file\"`\r\n    14\t\tCoveredSeq uint64 `json:\"covered_seq\"`\r\n    15\t\tLogBytes   int64  `json:\"log_bytes\"`\r\n    16\t}\r\n"]
[32.570006, "o", "    17\t\r\n    18\tfunc PathFor(store string) string {\r\n    19\t\treturn filepath.Join(store, Name)\r\n    20\t}\r\n    21\t\r\n    22\tfunc ReadKeep(store string) Keep {\r\n    23\t\tp := PathFor(store)\r\n    24\t\tdata, err := os.ReadFile(p)\r\n    25\t\tif err != nil {\r\n    26\t\t\treturn Keep{Gen: 0, BaseFile: \"\", CoveredSeq: 0, LogBytes: 0}\r\n    27\t\t}\r\n    28\t\tvar k Keep\r\n    29\t\tif err := json.Unmarshal(data, &k); err != nil {\r\n    30\t\t\treturn Keep{Gen: 0, BaseFile: \"\", CoveredSeq: 0, LogBytes: 0}\r\n    31\t\t}\r\n    32\t\treturn k\r\n    33\t}\r\n    34\t\r\n    35\tfunc WriteKeep(store string, keep Keep) error {\r\n    36\t\ttmp := PathFor(store) + \".tmp\"\r\n    37\t\tf, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n    38\t\tif err != nil {\r\n    39\t\t\treturn err\r\n    40\t\t}\r\n    41\t\tenc := json.NewEncoder(f)\r\n    42\t\tenc.SetIndent(\"\", \"\")\r\n    43\t\tif err := enc.Encode(keep); err != nil {\r\n    44\t\t\tf.Close()\r\n    45\t\t\treturn err\r\n    46\t\t}\r\n    47\t\t_ = f.Sync()\r\n"]
[32.570018, "o", "    48\t\tf.Close()\r\n    49\t\treturn nil\r\n    50\t}\r\n"]
