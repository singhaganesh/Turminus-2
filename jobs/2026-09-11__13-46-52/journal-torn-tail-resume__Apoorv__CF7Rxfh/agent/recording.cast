[454.172648, "i", "set +e; W=/app/bin/wrenkv; T=$(mktemp -d); printf 'put a 1\\nput b 2\\nincr n 7\\n' >$T/o; $W load $T/src --ops $T/o; fail=0; for n in 0 1 2 3 4 5; do rm -rf $T/x; cp -a $T/src $T/x; $W compact $T/x --crash-after $n >/dev/null 2>&1; rc=$?; [ $rc -eq 67 ] || { echo \"bad_exit fence=$n rc=$rc\"; fail=1; }; $W recover $T/x >/dev/null 2>&1; out=$($W dump $T/x); echo \"$out\" | grep -q '\"covered_seq\":3' || fail=1; echo \"$out\" | grep -q '\"key\":\"n\"' || fail=1; done; echo \"compact_fence_fail=$fail\"; rm -rf $T; exit $fail\n"]
