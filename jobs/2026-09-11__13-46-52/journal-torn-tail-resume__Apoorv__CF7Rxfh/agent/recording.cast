[58.496664, "o", "     7\t\t\"path/filepath\"\r\n     8\t\r\n     9\t\r\n    10\t\r\n    11\t)\r\n    12\t\r\n    13\tfunc BaseName(gen int) string {\r\n    14\t\treturn fmt.Sprintf(\"base-%d.tbl\", gen)\r\n    15\t}\r\n    16\t\r\n    17\tfunc PressAndInstall(store string, rows interface{}, seq uint64, gen int, logBytes int64) error {\r\n    18\t\ttmp := filepath.Join(store, BaseName(gen)+\".tmp\")\r\n    19\t\tfinal := filepath.Join(store, BaseName(gen))\r\n    20\t\tkeep := Keep{\r\n    21\t\t\tGen:        gen,\r\n    22\t\t\tBaseFile:   BaseName(gen),\r\n    23\t\t\tCoveredSeq: seq,\r\n    24\t\t\tLogBytes:   logBytes,\r\n    25\t\t}\r\n    26\t\tf, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n    27\t\tif err != nil {\r\n    28\t\t\treturn err\r\n"]
[58.496684, "o", "    29\t\t}\r\n    30\t\tsnapshot := struct {\r\n    31\t\t\tGen  int                `json:\"gen\"`\r\n    32\t\t\tSeq  uint64             `json:\"seq\"`\r\n"]
[58.496698, "o", "    33\t\t\tRows interface{} `json:\"rows\"`\r\n    34\t\t}{\r\n    35\t\t\tGen:  gen,\r\n    36\t\t\tSeq:  seq,\r\n    37\t\t\tRows: rows,\r\n    38\t\t}\r\n"]
[58.496712, "o", "    39\t\tif err := json.NewEncoder(f).Encode(snapshot); err != nil {\r\n    40\t\t\tf.Close()\r\n    41\t\t\treturn err\r\n    42\t\t}\r\n    43\t\tos.Rename(tmp, final)\r\n    44"]
[58.496824, "o", "\t\tWriteKeep(store, keep)\r\n    45\t\t_ = f.Sync()\r\n    46\t\tf.Close()\r\n    47\t\treturn nil\r\n    48\t}\r\n"]
