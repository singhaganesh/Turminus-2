[58.367263, "o", "     1\tpackage stx\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/binary\"\r\n     5\t\t\"encoding/json\"\r\n     6\t\t\"errors\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"hash/crc32\"\r\n     9\t\t"]
[58.367321, "o", "\"io\"\r\n    10\t\t\"os\"\r\n    11\t\t\"path/filepath\"\r\n    12\t\t\"strconv\"\r\n    13\t)\r\n    14\t\r\n    15\tvar Magic = []byte(\"WRKV\")\r\n    16\t\r\n    17\tconst (\r\n    18\t\tHeadSize   = 20\r\n    19\t\tMaxPayload = 1 << 20\r\n    20\t\tLogName    = \"append.log\"\r\n    21\t)\r\n    22\t\r\n"]
[58.367341, "o", "    23\ttype Row struct {\r\n    24\t\tValue string `json:\"v\"`\r\n    25\t\tRev   uint64 `json:\"rev\"`\r\n    26\t}\r\n"]
[58.367357, "o", "    27\t\r\n    28\tvar ErrTornTail = errors.New(\"integrity check failed in append log\")\r\n    29\t\r\n    30\tfunc LogPath(store string) string {\r\n"]
[58.367372, "o", "    31\t\treturn filepath.Join(store, LogName)\r\n    32\t}\r\n    33\t\r\n    34\tfunc Frame(seq uint64, payloadObj interface{}) ([]byte, error) {\r\n    35\t\t"]
[58.367386, "o", "payload, err := json.Marshal(payloadObj)\r\n    36\t\tif err != nil {\r\n    37\t\t\treturn nil, err\r\n    38\t\t}\r\n"]
[58.367405, "o", "    39\t\tcrc := crc32.ChecksumIEEE(payload)\r\n    40\t\tbuf := make([]byte, HeadSize+len(payload))\r\n    41\t\tcopy(buf[0:4], Magic)\r\n    42\t\tbinary.BigEndian.PutUint64(buf[4:12], seq)\r\n    43"]
[58.367419, "o", "\t\tbinary.BigEndian.PutUint32(buf[12:16], uint32(len(payload)))\r\n    44\t\tbinary.BigEndian.PutUint32(buf[16:20], crc)\r\n"]
[58.367441, "o", "    45\t\tcopy(buf[20:], payload)\r\n    46\t\treturn buf, nil\r\n    47\t}\r\n    48\t\r\n"]
[58.367455, "o", "    49\tfunc NextBlock(f *os.File) (uint64, map[string]interface{}, error) {\r\n    50\t\thead := make([]byte, HeadSize)\r\n    51\t\tn, err := io.ReadFull(f, head)\r\n    52\t\tif err == io.EOF || n == 0 {\r\n    53\t\t\treturn 0, nil, nil\r\n    54\t\t}\r\n"]
[58.367475, "o", "    55\t\tif n < HeadSize {\r\n    56\t\t\treturn 0, nil, ErrTornTail\r\n    57\t\t}\r\n    58\t\t"]
[58.367492, "o", "if string(head[0:4]) != string(Magic) {\r\n    59\t\t\treturn 0, nil, ErrTornTail\r\n    60\t\t}\r\n"]
[58.367508, "o", "    61\t\tseq := binary.BigEndian.Uint64(head[4:12])\r\n    62\t\tplen := binary.BigEndian.Uint32(head[12:16])\r\n    63\t\tcrc := binary.BigEndian.Uint32(head[16:20])\r\n    64\t\tif plen > MaxPayload {\r\n    65\t\t\treturn 0, nil, ErrTornTail\r\n"]
[58.367522, "o", "    66\t\t}\r\n    67\t\tpayload := make([]byte, plen)\r\n"]
[58.367541, "o", "    68\t\tpn, perr := io.ReadFull(f, payload)\r\n    69\t\tif perr != nil || pn < int(plen) {\r\n    70\t\t\treturn 0, nil, ErrTornTail\r\n    71\t\t}\r\n"]
[58.367556, "o", "    72\t\tif crc32.ChecksumIEEE(payload) != crc {\r\n    73\t\t\treturn 0, nil, ErrTornTail\r\n    74\t\t}\r\n    75\t\tvar obj map[string]interface{}\r\n"]
[58.367571, "o", "    76\t\tif err := json.Unmarshal(payload, &obj); err != nil {\r\n    77\t\t\treturn 0, nil, ErrTornTail\r\n    78\t\t}\r\n    79\t\treturn seq, obj, nil\r\n"]
[58.367583, "o", "    80\t}\r\n    81\t\r\n    82\tfunc ScanRecords(f *os.File, startAfter uint64) ([]struct {\r\n"]
[58.367597, "o", "    83\t\tSeq uint64\r\n    84\t\tOp  map[string]interface{}\r\n    85\t}, error) {\r\n    86\t\tvar out []struct {\r\n"]
[58.36761, "o", "    87\t\t\tSeq uint64\r\n    88\t\t\tOp  map[string]interface{}\r\n    89\t\t}\r\n"]
[58.367623, "o", "    90\t\tfor {\r\n    91\t\t\tseq, obj, err := NextBlock(f)\r\n    92\t\t\tif err != nil {\r\n"]
[58.367639, "o", "    93\t\t\t\treturn nil, err\r\n    94\t\t\t}\r\n    95\t\t\tif obj == nil {\r\n"]
[58.367658, "o", "    96\t\t\t\tbreak\r\n    97\t\t\t}\r\n    98\t\t\tif seq > startAfter {\r\n    99\t\t\t\tout = append(out, struct {\r\n   100\t\t\t\t\tSeq uint64\r\n"]
[58.368039, "o", "   101\t\t\t\t\tOp  map[string]interface{}\r\n   102\t\t\t\t}{Seq: seq, Op: obj})\r\n   103\t\t\t}\r\n   104\t\t}\r\n   105\t\treturn out, nil\r\n   106\t}\r\n   107\t\r\n   108\tfunc ApplyOp(rows map[string]Row, seq uint64, payload map[string]interface{}) error {\r\n   109\t\tkind, _ := payload[\"op\"].(string)\r\n   110\t\tkey, _ := payload[\"key\"].(string)\r\n   111\t\tswitch kind {\r\n   112\t\tcase \"put\":\r\n   113\t\t\tval, _ := payload[\"value\"].(string)\r\n   114\t\t\trows[key] = Row{Value: val, Rev: seq}\r\n   115\t\tcase \"del\":\r\n   116\t\t\tdelete(rows, key)\r\n   117\t\tcase \"incr\":\r\n   118\t\t\tcurStr := \"0\"\r\n   119\t\t\tif existing, ok := rows[key]; ok {\r\n   120\t\t\t\tcurStr = existing.Value\r\n   121\t\t\t}\r\n   122\t\t\tcurVal, err := strconv.ParseInt(curStr, 10, 64)\r\n   123\t\t\tif err != nil {\r\n   124\t\t\t\treturn fmt.Errorf(\"key %s does not hold an integer\", key)\r\n   125\t\t\t}\r\n   126\t\t\tvar delta int64\r\n   127\t\t\tif dFloat, ok := payload[\"delta\"].(float64); ok {\r\n   128\t\t\t\tdelta = int64(dFloat)\r\n   129\t\t\t}\r\n   130\t\t\trows[key] = Row{Value: strconv.FormatInt(curVal+delta, 10), Rev: seq}\r\n   1"]
[58.368122, "o", "31\t\t}\r\n   132\t\treturn nil\r\n   133\t}\r\n\u001b[?2004h"]
