[32.571084, "o", "     1\tpackage tab\r\n     2\t\r\n     3\t// ResumeOffset returns the log_bytes coordinate carried by the coordination\r\n     4\t// record: the size of append.log at the moment the record was installed.\r\n     5\tfunc ResumeOffset(keep Keep) int64 {\r\n     6\t\treturn keep.LogBytes\r\n"]
