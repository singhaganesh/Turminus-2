[304.638005, "i", "cat >> tab/mm_keep.go <<'EOF'\n\n// WriteKeep preserves the package API and atomically installs keep.\nfunc WriteKeep(store string, keep Keep) error {\n\tif err := writeKeepTemp(store, keep, func(f *os.File) { _ = f.Sync() }); err != nil {\n\t\treturn err\n\t}\n\tif err := os.Rename(PathFor(store)+\".tmp\", PathFor(store)); err != nil {\n\t\treturn err\n\t}\n\td, err := os.Open(store)\n\tif err != nil { return err }\n\tdefer d.Close()\n\treturn d.Sync()\n}\nEOF\npython3 - <<'PY'\np='tab/tt_press.go'; s=open(p).read()\ns=s.replace('func PressAndInstall(store string, rows interface{}, seq uint64, gen int, logBytes int64, fence func(*os.File)) error {','func PressAndInstallFenced(store string, rows interface{}, seq uint64, gen int, logBytes int64, fence func(*os.File)) error {',1)\ns += '''\\n// PressAndInstall preserves the original library API.\\nfunc PressAndInstall(store string, rows interface{}, seq uint64, gen int, logBytes int64) error {\\n\\treturn PressAndInstallFenced(store, rows, seq, gen, logBytes, func(f *os.File) { _ = f.Sync() })\\n}\\"]
[304.638061, "i", "n'''\nopen(p,'w').write(s)\nfor p in ['wk/main.go','stx/cc_fold.go']:\n s=open(p).read().replace('tab.PressAndInstall(', 'tab.PressAndInstallFenced(')\n open(p,'w').write(s)\nPY\n# FoldTail's compatibility path should use the original API.\npython3 - <<'PY'\np='stx/cc_fold.go'; s=open(p).read().replace('tab.PressAndInstallFenced(store, rows, seq, keep.Gen+1, size, func(f *os.File) { _ = f.Sync() })','tab.PressAndInstall(store, rows, seq, keep.Gen+1, size)'); open(p,'w').write(s)\nPY\n"]
