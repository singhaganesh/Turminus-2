[415.234903, "i", "python3 - <<'PY'\np='wk/main.go'; s=open(p).read()\nneedle='''\\t_ = keep\n\\tif crashAfter != nil {'''\nrepl='''\\t_ = keep\n\\t// Remove an incomplete suffix before opening an append handle; otherwise\n\\t// records appended beyond it would be permanently hidden from readers.\n\\tif err := stx.RepairTail(store); err != nil {\n\\t\\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\\\n\", err)\n\\t\\treturn 1\n\\t}\n\\tif crashAfter != nil {'''\nif needle not in s: raise SystemExit('load insertion point not found')\ns=s.replace(needle,repl,1)\nopen(p,'w').write(s)\nPY\npython3 - <<'PY'\np='stx/rr_scan.go'; s=open(p).read()\nold='''\\tvar obj map[string]interface{}\n\\tif err := json.Unmarshal(payload, &obj); err != nil {\n\\t\\treturn 0, nil, ErrTornTail\n\\t}'''\nnew='''\\tvar obj map[string]interface{}\n\\tdec := json.NewDecoder(bytes.NewReader(payload))\n\\tdec.UseNumber()\n\\tif err := dec.Decode(&obj); err != nil {\n\\t\\treturn 0, nil, ErrTornTail\n\\t}'''\nif old not in s: raise SystemExit('decode block not found')\ns=s.replace(old,new,1)\ns=s.replace('\"encoding/binary\"'"]
