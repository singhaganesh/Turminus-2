[190.411453, "i", "python3 - <<'PY'\np='wk/main.go'; s=open(p).read()\ns=s.replace('''\\tkeep, rows, lastSeq, err := readState(store, nil)''','''\\tkeep, rows, lastSeq, err := readState(store, nil)''',1)\n# Insert repair after successful state read and before opening append log.\nneedle='''\\tif err != nil {\n\\t\\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\\\n\", err)\n\\t\\treturn 1\n\\t}\n\\tlogFile, err := os.OpenFile(stx.LogPath(store), os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)'''\nrepl='''\\tif err != nil {\n\\t\\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\\\n\", err)\n\\t\\treturn 1\n\\t}\n\\tif err := stx.RepairTail(store); err != nil {\n\\t\\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\\\n\", err)\n\\t\\treturn 1\n\\t}\n\\tlogFile, err := os.OpenFile(stx.LogPath(store), os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)'''\nif needle not in s: raise SystemExit('load insertion point not found')\ns=s.replace(needle,repl,1)\ns=s.replace('tab.PressAndInstall(store, rows, seq, keep.Gen+1, stx.LogSize(store))','tab.PressAndInstall(store, rows, seq, keep.Gen+1, stx.LogSize(store), Fence)',1)\nold='''\\tif "]
[190.411587, "i", "err := stx.FoldTail(store, rows, seq, keep); err != nil {\n\\t\\treturn 1\n\\t}\n\\treturn 0'''\nnew='''\\tsize := stx.LogSize(store)\n\\tif err := tab.PressAndInstall(store, rows, seq, keep.Gen+1, size, Fence); err != nil {\n\\t\\treturn 1\n\\t}\n\\tlogFile, err := os.OpenFile(stx.LogPath(store), os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\n\\tif err != nil { return 1 }\n\\tFence(logFile)\n\\tif err := logFile.Close(); err != nil { return 1 }\n\\treturn 0'''\nif old not in s: raise SystemExit('compact block not found')\ns=s.replace(old,new,1)\nopen(p,'w').write(s)\nPY\n# Keep the old library helper buildable and safe, though command orchestration owns crash fences.\ncat > stx/cc_fold.go <<'EOF'\npackage stx\n\nimport (\n\t\"os\"\n\t\"wrenkv/tab\"\n)\n\nfunc LogSize(store string) int64 {\n\tst, err := os.Stat(LogPath(store)); if err != nil { return 0 }; return st.Size()\n}\nfunc TruncateLog(store string) error {\n\tf, err := os.OpenFile(LogPath(store), os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\n\tif err != nil { return err }\n\tif err = f.Sync(); err != nil { f.Clos"]
[190.411665, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
