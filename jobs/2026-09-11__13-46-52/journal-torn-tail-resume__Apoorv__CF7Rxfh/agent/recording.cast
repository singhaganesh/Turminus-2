[371.47298, "o", "1\t\t\t\tif existing, ok := rows[op.Key]; ok {\r\n   102\t\t\t\t\tc, err := strconv.ParseInt(existing.Value, 10, 64)\r\n   103\t\t\t\t\tif err != nil {\r\n   104\t\t\t\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: key %q does not hold an integer\\n\", op.Key)\r\n   105\t\t\t\t\t\treturn 2\r\n   106\t\t\t\t\t}\r\n   107\t\t\t\t\tcurVal = c\r\n   108\t\t\t\t}\r\n   109\t\t\t\topMap[\"delta\"] = op.Delta\r\n   110\t\t\t\topMap[\"value\"] = strconv.FormatInt(curVal+op.Delta, 10)\r\n   111\t\t\t}\r\n   112\t\t\tseq := lastSeq + 1\r\n   113\t\t\tlastSeq = seq\r\n   114\t\t\trec, err := stx.Frame(seq, opMap)\r\n   115\t\t\tif err != nil {\r\n   116\t\t\t\treturn 1\r\n   117\t\t\t}\r\n   118\t\t\tif crashTail != nil && i == *crashTail {\r\n   119\t\t\t\thalf := len(rec) / 2\r\n   120\t\t\t\tlogFile.Write(rec[:half])\r\n   121\t\t\t\tlogFile.Sync()\r\n   122\t\t\t\tos.Exit(KillExit)\r\n   123\t\t\t}\r\n   124\t\t\tif _, err := logFile.Write(rec); err != nil {\r\n   125\t\t\t\treturn 1\r\n   126\t\t\t}\r\n   127\t\t\tFence(logFile)\r\n   128\t\t\tstx.ApplyOp(rows, seq, opMap)\r\n   129\t\t}\r\n   130\t\treturn 0\r\n   131\t}\r\n   132\t\r\n   133\tfunc cmdRebuild(store string, crashAfter *int) int {\r\n   134\t\t"]
