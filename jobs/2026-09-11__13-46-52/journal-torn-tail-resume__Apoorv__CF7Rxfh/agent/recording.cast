[82.235338, "o", "func ApplyOp(rows map[string]Row, seq uint64, payload map[string]interface{}) error {\r\n\tkind, _ := payload[\"op\"].(string)\r\n\tkey, _ := payload[\"key\"].(string)\r\n\tswitch kind {\r\n\tcase \"put\":\r\n\t\tval, _ := payload[\"value\"].(string)\r\n\t\trows[key] = Row{Value: val, Rev: seq}\r\n\tcase \"del\":\r\n\t\tdelete(rows, key)\r\n"]
[82.236861, "o", "\tcase \"incr\":\r\n\t\tcurStr := \"0\"\r\n\t\tif existing, ok := rows[key]; ok {\r\n"]
[82.237023, "o", "\t\t\tcurStr = existing.Value\r\n\t\t}\r\n\t\tcurVal, err := strconv.ParseInt(curStr, 10, 64)\r\n\t\tif err != nil {\r\n\t\t\treturn fmt.Errorf(\"key %s does not hold an integer\", key)\r\n\t\t}\r\n\t\tvar delta int64\r\n"]
[82.237383, "o", "\t\tif dFloat, ok := payload[\"delta\"].(float64); ok {\r\n\t\t\tdelta = int64(dFloat)\r\n\t\t}\r\n\t\trows[key] = Row{Value: strconv.FormatInt(curVal+delta, 10), Rev: seq}\r\n\t}\r\n\treturn nil\r\n"]
[82.23742, "o", "}\r\n"]
