[111.272457, "o", "\t\tif err != nil {\r\n    93\t\t\t\treturn nil, err\r\n    94\t\t\t}\r\n    95\t\t\tif obj == nil {\r\n    96\t\t\t\tbreak\r\n    97\t\t\t}\r\n    98\t\t\tif seq > startAfter {\r\n    99\t\t\t\tout = append(out, struct {\r\n   100\t\t\t\t\tSeq uint64\r\n   101\t\t\t\t\tOp  map[string]interface{}\r\n   102\t\t\t\t}{Seq: seq, Op: obj})\r\n   103\t\t\t}\r\n   104\t\t}\r\n   105\t\treturn out, nil\r\n   106\t}\r\n   107\t\r\n   108\tfunc ApplyOp(rows map[string]Row, seq uint64, payload map[string]interface{}) error {\r\n   109\t\tkind, _ := payload[\"op\"].(string)\r\n   110\t\tkey, _ := payload[\"key\"].(string)\r\n   111\t\tswitch kind {\r\n   112\t\tcase \"put\":\r\n   113\t\t\tval, _ := payload[\"value\"].(string)\r\n   114\t\t\trows[key] = Row{Value: val, Rev: seq}\r\n   115\t\tcase \"del\":\r\n   116\t\t\tdelete(rows, key)\r\n   117\t\tcase \"incr\":\r\n   118\t\t\tcurStr := \"0\"\r\n   119\t\t\tif existing, ok := rows[key]; ok {\r\n   120\t\t\t\tcurStr = existing.Value\r\n   121\t\t\t}\r\n   122\t\t\tcurVal, err := strconv.ParseInt(curStr, 10, 64)\r\n   123\t\t\tif err != nil {\r\n   124\t\t\t\treturn fmt.Errorf(\"key %s does not hold an integer\", key)\r\n   125\t\t\t}\r\n   126\t\t\t"]
