[93.090934, "o", "    13\t\tBaseFile   string `json:\"base_file\"`\r\n    14\t\tCoveredSeq uint64 `json:\"covered_seq\"`\r\n    15\t\tLogBytes   int64  `json:\"log_bytes\"`\r\n    16\t}\r\n    17\t\r\n    18\tfunc PathFor(store string) string {\r\n    19\t\treturn filepath.Join(store, Name)\r\n    20\t}\r\n    21\t\r\n    22\tfunc ReadKeep(store string) Keep {\r\n    23\t\tp := PathFor(store)\r\n    24\t\tdata, err := os.ReadFile(p)\r\n    25\t\tif err != nil {\r\n    26\t\t\treturn Keep{Gen: 0, BaseFile: \"\", CoveredSeq: 0, LogBytes: 0}\r\n    27\t\t}\r\n    28\t\tvar k Keep\r\n    29\t\tif err := json.Unmarshal(data, &k); err != nil {\r\n    30\t\t\treturn Keep{Gen: 0, BaseFile: \"\", CoveredSeq: 0, LogBytes: 0}\r\n    31\t\t}\r\n    32\t\treturn k\r\n    33\t}\r\n    34\t\r\n    35\tfunc WriteKeep(store string, keep Keep) error {\r\n    36\t\ttmp := PathFor(store) + \".tmp\"\r\n    37\t\tf, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n    38\t\tif err != nil {\r\n    39\t\t\treturn err\r\n    40\t\t}\r\n    41\t\tenc := json.NewEncoder(f)\r\n    42\t\tenc.SetIndent(\"\", \"\")\r\n    43\t\tif err := enc.Encode(keep); err != nil "]
