[111.396899, "o", "===== fence =====\r\n"]
[111.397793, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"os\"\r\n     5\t)\r\n     6\t\r\n     7\tconst KillExit = 67\r\n     8\t\r\n     9\tvar crashTarget = -1\r\n    10\tvar fenceCount = 0\r\n    11\t\r\n    12\tfunc Arm(target int) {\r\n"]
[111.397882, "o", "    13\t\tcrashTarget = target\r\n    14\t\tfenceCount = 0\r\n    15\t\tif crashTarget == 0 {\r\n    16\t\t\tos.Exit(KillExit)\r\n    17\t\t}\r\n    18\t}\r\n    19\t\r\n    20\tfunc Fence(f *os.File) {\r\n    21\t\tif f != nil {\r\n    22\t\t\t_ = f.Sync()\r\n    23\t\t}\r\n    24\t\tfenceCount++\r\n    25\t\tif crashTarget >= 0 && fenceCount >= crashTarget {\r\n    26\t\t\tos.Exit(KillExit)\r\n    27\t\t}\r\n    28\t}\r\n"]
