[198.15445, "o", "     1\tpackage tab\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t)\r\n     8\t\r\n     9\tconst Name = \"keep.json\"\r\n"]
[198.154496, "o", "    10\t\r\n    11\ttype Keep struct {\r\n    12\t\tGen        int    `json:\"gen\"`\r\n    13\t\tBaseFile   string `json:\"base_file\"`\r\n    14\t\tCoveredSeq uint64 `json:\"covered_seq\"`\r\n    15\t\tLogBytes   int64  `json:\"log_bytes\"`\r\n    16\t}\r\n    17\t\r\n    18\tfunc PathFor(store string) string {\r\n    19\t\treturn filepath.Join(store, Name)\r\n    20\t}\r\n    21\t\r\n"]
[198.154587, "o", "    22\tfunc ReadKeep(store string) Keep {\r\n    23\t\tp := PathFor(store)\r\n    24\t\tdata, err := os.ReadFile(p)\r\n    25\t\tif err != nil {\r\n    26\t\t\treturn Keep{Gen: 0, BaseFile: \"\", CoveredSeq: 0, LogBytes: 0}\r\n    27\t\t}\r\n    28\t\tvar k Keep\r\n    29\t\tif err := json.Unmarshal(data, &k); err != nil {\r\n    30\t\t\treturn Keep{Gen: 0, BaseFile: \"\", CoveredSeq: 0, LogBytes: 0}\r\n    31\t\t}\r\n    32\t\treturn k\r\n    33\t}\r\n    34\t\r\n"]
[198.154662, "o", "    35\tfunc WriteKeep(store string, keep Keep) error {\r\n    36\t\ttmp := PathFor(store) + \".tmp\"\r\n    37\t\tf, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n    38\t\tif err != nil {\r\n    39\t\t\treturn err\r\n    40\t\t}\r\n    41\t\tenc := json.NewEncoder(f)\r\n    42\t\tenc.SetIndent(\"\", \"\")\r\n    43\t\tif err := enc.Encode(keep); err != nil {\r\n    44\t\t\tf.Close()\r\n    45\t\t\treturn err\r\n    46\t\t}\r\n    47\t\t_ = f.Sync()\r\n    48\t\tf.Close()\r\n    49\t\treturn nil\r\n    50\t}\r\n"]
[198.155813, "o", "     1\tpackage tab\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"fmt\"\r\n     6\t\t\"os\"\r\n     7\t\t\"path/filepath\"\r\n     8\t\r\n     9\t\r\n    10\t\r\n    11\t)\r\n    12\t\r\n    13\tfunc BaseName(gen int) string {\r\n    14\t\treturn fmt.Sprintf(\"base-%d.tbl\", gen)\r\n    15\t}\r\n"]
[198.155941, "o", "    16\t\r\n    17\tfunc PressAndInstall(store string, rows interface{}, seq uint64, gen int, logBytes int64) error {\r\n    18\t\ttmp := filepath.Join(store, BaseName(gen)+\".tmp\")\r\n    19\t\tfinal := filepath.Join(store, BaseName(gen))\r\n    20\t\tkeep := Keep{\r\n    21\t\t\tGen:        gen,\r\n    22\t\t\tBaseFile:   BaseName(gen),\r\n    23\t\t\tCoveredSeq: seq,\r\n    24\t\t\tLogBytes:   logBytes,\r\n    25\t\t}\r\n    26\t\tf, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n    27\t\tif err != nil {\r\n    28\t\t\treturn err\r\n    29\t\t}\r\n    30\t\tsnapshot := struct {\r\n    31\t\t\tGen  int                `json:\"gen\"`\r\n    32\t\t\tSeq  uint64             `json:\"seq\"`\r\n    33\t\t\tRows interface{} `json:\"rows\"`\r\n    34\t\t}{\r\n    35\t\t\tGen:  gen,\r\n    36\t\t\tSeq:  seq,\r\n    37\t\t\tRows: rows,\r\n    38\t\t}\r\n    39\t\tif err := json.NewEncoder(f).Encode(snapshot); err != nil {\r\n    40\t\t\tf.Close()\r\n    41\t\t\treturn err\r\n    42\t\t}\r\n    43\t\tos.Rename(tmp, final)\r\n    44\t\tWriteKeep(store, keep)\r\n    45\t\t_ = f.Sync()\r\n    46\t\tf.Close()\r\n    47\t\treturn nil\r\n    48\t"]
[198.15601, "o", "}\r\n"]
[198.157001, "o", "     1\tpackage tab\r\n     2\t\r\n     3\t// ResumeOffset returns the log_bytes coordinate carried by the coordination\r\n     4\t// record: the size of append.log at the moment the record was installed.\r\n     5\tfunc ResumeOffset(keep Keep) int64 {\r\n     6\t\treturn keep.LogBytes\r\n     7\t}\r\n"]
[198.158024, "o", "     1\tpackage tab\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t)\r\n     8\t\r\n"]
[198.158116, "o", "     9\t// ScanPendingBaseSeq inspects leftover uncommitted base snapshot files (*.tbl.tmp)\r\n    10\t// in the store directory and returns the highest embedded sequence number.\r\n    11\t// This allows recovery routines to resume from staged compaction or bake state.\r\n    12\t// Returns 0 if no candidate snapshot is present.\r\n    13\tfunc ScanPendingBaseSeq(store string) uint64 {\r\n    14\t\tmatches, err := filepath.Glob(filepath.Join(store, \"base-*.tbl.tmp\"))\r\n    15\t\tif err != nil || len(matches) == 0 {\r\n    16\t\t\treturn 0\r\n    17\t\t}\r\n    18\t\tvar highest uint64\r\n    19\t\tfor _, m := range matches {\r\n"]
[198.158201, "o", "    20\t\t\tdata, err := os.ReadFile(m)\r\n    21\t\t\tif err != nil {\r\n    22\t\t\t\tcontinue\r\n    23\t\t\t}\r\n    24\t\t\tvar snap struct {\r\n    25\t\t\t\tSeq uint64 `json:\"seq\"`\r\n    26\t\t\t}\r\n    27\t\t\tif err := json.Unmarshal(data, &snap); err == nil {\r\n    28\t\t\t\tif snap.Seq > highest {\r\n    29\t\t\t\t\thighest = snap.Seq\r\n    30\t\t\t\t}\r\n    31\t\t\t}\r\n    32\t\t}\r\n    33\t\treturn highest\r\n    34\t}\r\n"]
