[429.894986, "o", "\u001b[?2004h"]
[429.895193, "o", "> # Normal progress and recovery idempotence.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[429.895284, "o", "d=fresh(); run('load',d,'--ops',demo); assert dump(d)==expected_demo(0)\r\n\u001b[?2004l\r"]
[429.895385, "o", "\u001b[?2004h> "]
[429.895627, "o", "run('recover',d); assert dump(d)==expected_demo(5); first=dump(d); run('recover',d); assert dump(d)==first\r\n\u001b[?2004l\r"]
[429.895699, "o", "\u001b[?2004h> "]
[429.895884, "o", "# A torn fourth record leaves the first three visible; recovery keeps them.\r\n\u001b[?2004l\r"]
[429.895928, "o", "\u001b[?2004h> "]
[429.896126, "o", "t=fresh(); run('load',t,'--ops',demo,'--crash-tail','3',ok=(67,))\r\n\u001b[?2004l\r"]
[429.896186, "o", "\u001b[?2004h"]
[429.896243, "o", "> "]
[429.896478, "o", "three={'covered_seq':0,'entries':[{'key':'alpha','value':'5','rev':3},{'key':'beta','value':'hello','rev':2}]}\r\n\u001b[?2004l\r"]
[429.896527, "o", "\u001b[?2004h"]
[429.896571, "o", "> "]
[429.896765, "o", "assert dump(t)==three,dump(t); run('recover',t); three['covered_seq']=3; assert dump(t)==three,dump(t)\r\n\u001b[?2004l\r"]
[429.896802, "o", "\u001b[?2004h> "]
[429.896994, "o", "# Loading after a torn suffix repairs it and makes every later record visible.\r\n\u001b[?2004l\r"]
[429.897044, "o", "\u001b[?2004h"]
[429.897094, "o", "> "]
[429.897302, "o", "t=fresh(); run('load',t,'--ops',demo,'--crash-tail','2',ok=(67,)); run('load',t,'--ops',mixed)\r\n\u001b[?2004l\r"]
[429.897362, "o", "\u001b[?2004h> "]
[429.897461, "o", "q=dump(t); assert max(x['rev'] for x in q['entries'])==11,q\r\n\u001b[?2004l\r"]
[429.89752, "o", "\u001b[?2004h> "]
[429.897617, "o", "run('recover',t); assert dump(t)['covered_seq']==11\r\n\u001b[?2004l\r"]
[429.897689, "o", "\u001b[?2004h"]
[429.897753, "o", "> "]
[429.897819, "o", "# Every recovery installation fence is resumable.\r\n\u001b[?2004l\r"]
[429.897865, "o", "\u001b[?2004h> "]
[429.897913, "o", "for n in range(0,6):\r\n\u001b[?2004l\r"]
[429.897971, "o", "\u001b[?2004h> "]
[429.898237, "o", " d=fresh(); run('load',d,'--ops',demo); p=run('recover',d,'--crash-after',n,ok=(0,67))\r\n\u001b[?2004l\r"]
[429.898268, "o", "\u001b[?2004h> "]
[429.898503, "o", " run('recover',d); assert dump(d)==expected_demo(5),(n,p.returncode,dump(d))\r\n\u001b[?2004l\r"]
[429.898575, "o", "\u001b[?2004h> "]
[429.898744, "o", "# Every compaction fence preserves the pre-fold view after recovery.\r\n\u001b[?2004l\r"]
[429.898798, "o", "\u001b[?2004h> "]
[429.898845, "o", "for n in range(0,7):\r\n\u001b[?2004l\r"]
[429.898896, "o", "\u001b[?2004h> "]
[429.899246, "o", " d=fresh(); run('load',d,'--ops',demo); run('recover',d); run('load',d,'--ops',mixed); before=dump(d)\r\n\u001b[?2004l\r"]
[429.8993, "o", "\u001b[?2004h> "]
[429.899595, "o", " p=run('compact',d,'--crash-after',n,ok=(0,67)); run('recover',d); after=dump(d)\r\n\u001b[?2004l\r"]
[429.899656, "o", "\u001b[?2004h> "]
[429.899974, "o", " assert after['entries']==before['entries'] and after['covered_seq']==14,(n,p.returncode,before,after)\r\n\u001b[?2004l\r"]
[429.90004, "o", "\u001b[?2004h> "]
[429.900194, "o", "# Empty store and validation-before-work.\r\n\u001b[?2004l\r"]
[429.900263, "o", "\u001b[?2004h> "]
[429.900587, "o", "e=fresh(); assert dump(e)=={'covered_seq':0,'entries':[]}; run('recover',e); assert dump(e)=={'covered_seq':0,'entries':[]}\r\n\u001b[?2004l\r"]
[429.900646, "o", "\u001b[?2004h> "]
[429.900954, "o", "bad=tempfile.mktemp(); pathlib.Path(bad).write_text('put ok 1\\nnot-an-op x\\n'); missing=tempfile.mktemp()\r\n\u001b[?2004l\r"]
[429.901003, "o", "\u001b[?2004h> "]
[429.901286, "o", "p=run('load',missing,'--ops',bad,ok=(2,)); assert not pathlib.Path(missing).exists()\r\n\u001b[?2004l\r"]
[429.901339, "o", "\u001b[?2004h> "]
[429.901533, "o", "# Runtime incr error keeps all earlier individually fenced operations.\r\n\u001b[?2004l\r"]
[429.901586, "o", "\u001b[?2004h> "]
[429.901921, "o", "ops=tempfile.mktemp(); pathlib.Path(ops).write_text('put a 1\\nput text nope\\nincr a 2\\nincr text 1\\nput later lost\\n')\r\n\u001b[?2004l\r"]
[429.901973, "o", "\u001b[?2004h> "]
[429.902138, "o", "d=fresh(); run('load',d,'--ops',ops,ok=(2,)); q=dump(d)\r\n\u001b[?2004l\r"]
[429.902198, "o", "\u001b[?2004h> "]
[429.902509, "o", "assert q=={'covered_seq':0,'entries':[{'key':'a','value':'3','rev':3},{'key':'text','value':'nope','rev':2}]},q\r\n\u001b[?2004l\r"]
[429.902565, "o", "\u001b[?2004h> "]
[429.902775, "o", "# Sequence numbers continue from covered_seq after a completed fold.\r\n\u001b[?2004l\r"]
[429.902823, "o", "\u001b[?2004h> "]
[429.903295, "o", "d=fresh(); run('load',d,'--ops',demo); run('compact',d); run('load',d,'--ops',mixed); assert max(x['rev'] for x in dump(d)['entries'])==14\r\n\u001b[?2004l\r"]
[429.903349, "o", "\u001b[?2004h> "]
[429.903529, "o", "print('integration crash and contract matrix: PASS')\r\n\u001b[?2004l\r"]
[429.903579, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[431.138268, "o", "integration crash and contract matrix: PASS\r\n"]
[431.158406, "o", "\u001b[?2004hroot@a44b89d88f4a:/app# "]
