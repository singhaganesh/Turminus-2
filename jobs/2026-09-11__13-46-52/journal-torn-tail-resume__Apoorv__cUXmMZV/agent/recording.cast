[179.088897, "o", "    20\tfunc readState(store string, startAfter *uint64) (tab.Keep, map[string]stx.Row, uint64, error) {\r\n    21\t\tkeep := tab.ReadKeep(store)\r\n    22\t\tvar boundary uint64 = keep.CoveredSeq\r\n    23\t\tif startAfter != nil {\r\n    24\t\t\tboundary = *startAfter\r\n    25\t\t}\r\n    26\t\trows := make(map[string]stx.Row)\r\n    27\t\tif keep.BaseFile != \"\" {\r\n"]
[179.089037, "o", "    28\t\t\tbp := filepath.Join(store, keep.BaseFile)\r\n    29\t\t\tif data, err := os.ReadFile(bp); err == nil && len(data) > 0 {\r\n    30\t\t\t\tvar snap struct {\r\n    31\t\t\t\t\tRows map[string]stx.Row `json:\"rows\"`\r\n    32\t\t\t\t}\r\n    33\t\t\t\tif err := json.Unmarshal(data, &snap); err == nil && snap.Rows != nil {\r\n    34\t\t\t\t\trows = snap.Rows\r\n    35\t\t\t\t}\r\n    36\t\t\t}\r\n    37\t\t}\r\n    38\t\tlast := keep.CoveredSeq\r\n    39\t\tlp := stx.LogPath(store)\r\n    40\t\tif f, err := os.Open(lp); err == nil {\r\n"]
[179.089131, "o", "    41\t\t\tdefer f.Close()\r\n    42\t\t\trecords, err := stx.ScanRecords(f, boundary)\r\n    43\t\t\tif err != nil {\r\n    44\t\t\t\treturn keep, rows, last, err\r\n    45\t\t\t}\r\n    46\t\t\tfor _, rec := range records {\r\n    47\t\t\t\tif err := stx.ApplyOp(rows, rec.Seq, rec.Op); err != nil {\r\n    48\t\t\t\t\treturn keep, rows, last, err\r\n    49\t\t\t\t}\r\n    50\t\t\t\tlast = rec.Seq\r\n    51\t\t\t}\r\n    52\t\t}\r\n    53\t\tif last < keep.CoveredSeq {\r\n    54\t\t\tlast = keep.CoveredSeq\r\n    55\t\t}\r\n    56\t\treturn keep, rows, last, nil\r\n    57\t}\r\n    58\t\r\n    59\tfunc pickStart(keep tab.Keep) uint64 {\r\n    60\t\treturn keep.CoveredSeq\r\n    61\t}\r\n    62\t\r\n    63\tfunc cmdLoad(store, opsPath string, crashAfter, crashTail *int) int {\r\n    64\t\tdata, err := os.ReadFile(opsPath)\r\n    65\t\tif err != nil {\r\n    66\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\n\", err)\r\n    67\t\t\treturn 2\r\n    68\t\t}\r\n    69\t\tops, err := ParseOps(string(data))\r\n    70\t\tif err != nil {\r\n    71\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\n\", err)\r\n    72\t\t\treturn 2\r\n    73\t\t}\r\n"]
[179.089251, "o", "    74\t\tos.MkdirAll(store, 0755)\r\n    75\t\tkeep, rows, lastSeq, err := readState(store, nil)\r\n    76\t\tif err != nil {\r\n    77\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\n\", err)\r\n    78\t\t\treturn 1\r\n    79\t\t}\r\n    80\t\t_ = keep\r\n    81\t\tif crashAfter != nil {\r\n    82\t\t\tArm(*crashAfter)\r\n    83\t\t}\r\n    84\t\tlp := stx.LogPath(store)\r\n    85\t\tlogFile, err := os.OpenFile(lp, os.O_CREATE|os.O_RDWR|os.O_APPEND, 0644)\r\n    86\t\tif err != nil {\r\n    87\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\n\", err)\r\n    88\t\t\treturn 1\r\n    89\t\t}\r\n    90\t\tdefer logFile.Close()\r\n    91\t\r\n    92\t\tfor i, op := range ops {\r\n    93\t\t\topMap := map[string]interface{}{\r\n    94\t\t\t\t\"op\":  op.Kind,\r\n    95\t\t\t\t\"key\": op.Key,\r\n    96\t\t\t}\r\n    97"]
[179.089286, "o", "\t\t\tif op.Kind == \"put\" {\r\n    98\t\t\t\topMap[\"value\"] = op.Value\r\n    99\t\t\t} else if op.Kind == \"incr\" {\r\n   100\t\t\t\tcurVal := int64(0)\r\n   101\t\t\t\tif existing, ok := rows[op.Key]; ok {\r\n   102\t\t\t\t\tc, err := strconv.ParseInt(existing.Value, 10, 64)\r\n   103\t\t\t\t\tif err != nil {\r\n   104\t\t\t\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: key %q does not hold an integer\\n\", op.Key)\r\n   105\t\t\t\t\t\treturn 2\r\n   106\t\t\t\t\t}\r\n   107\t\t\t\t\tcurVal = c\r\n   108\t\t\t\t}\r\n   109\t\t\t\topMap[\"delta\"] = op.Delta\r\n   110\t\t\t\topMap[\"value\"] = strconv.FormatInt(curVal+op.Delta, 10)\r\n   111\t\t\t}\r\n   112\t\t\tseq := lastSeq + 1\r\n   113\t\t\tlastSeq = seq\r\n   114\t\t\trec, err := stx.Frame(seq, opMap)\r\n   115\t\t\tif err != nil {\r\n   116\t\t\t\treturn 1\r\n   117\t\t\t}\r\n   118\t\t\tif crashTail != nil && i == *crashTail {\r\n   119\t\t\t\thalf := len(rec) / 2\r\n   120\t\t\t\tlogFile.Write(rec[:half])\r\n   121\t\t\t\tlogFile.Sync()\r\n   122\t\t\t\tos.Exit(KillExit)\r\n   123\t\t\t}\r\n   124\t\t\tif _, err := logFile.Write(rec); err != nil {\r\n"]
[179.089303, "o", "   125\t\t\t\treturn 1\r\n   126\t\t\t}\r\n   127\t\t\tFence(logFile)\r\n   128\t\t\t"]
