[92.969532, "o", "    19\t\tMaxPayload = 1 << 20\r\n    20\t\tLogName    = \"append.log\"\r\n    21\t)\r\n    22\t\r\n    23\ttype Row struct {\r\n    24\t\tValue string `json:\"v\"`\r\n    25\t\tRev   uint64 `json:\"rev\"`\r\n    26\t}\r\n    27\t\r\n    28\tvar ErrTornTail = errors.New(\"integrity check failed in append log\")\r\n    29\t\r\n    30\tfunc LogPath(store string) string {\r\n    31\t\treturn filepath.Join(store, LogName)\r\n    32\t}\r\n    33\t\r\n    34\tfunc Frame(seq uint64, payloadObj interface{}) ([]byte, error) {\r\n    35\t\tpayload, err := json.Marshal(payloadObj)\r\n    36\t\tif err != nil {\r\n    37\t\t\treturn nil, err\r\n    38\t\t}\r\n    39\t\tcrc := crc32.ChecksumIEEE(payload)\r\n"]
