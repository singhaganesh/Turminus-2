[429.892663, "i", "'beta','value':'hello','rev':2}]}\nassert dump(t)==three,dump(t); run('recover',t); three['covered_seq']=3; assert dump(t)==three,dump(t)\n# Loading after a torn suffix repairs it and makes every later record visible.\nt=fresh(); run('load',t,'--ops',demo,'--crash-tail','2',ok=(67,)); run('load',t,'--ops',mixed)\nq=dump(t); assert max(x['rev'] for x in q['entries'])==11,q\nrun('recover',t); assert dump(t)['covered_seq']==11\n# Every recovery installation fence is resumable.\nfor n in range(0,6):\n d=fresh(); run('load',d,'--ops',demo); p=run('recover',d,'--crash-after',n,ok=(0,67))\n run('recover',d); assert dump(d)==expected_demo(5),(n,p.returncode,dump(d))\n# Every compaction fence preserves the pre-fold view after recovery.\nfor n in range(0,7):\n d=fresh(); run('load',d,'--ops',demo); run('recover',d); run('load',d,'--ops',mixed); before=dump(d)\n p=run('compact',d,'--crash-after',n,ok=(0,67)); run('recover',d); after=dump(d)\n assert after['entries']==before['entries'] and after['covered_seq']==14,(n,p.returncode,befo"]
