[319.169343, "o", "# Append a library-level tail repair routine. It retains exactly the valid prefix.\r\n\u001b[?2004l\r"]
[319.169397, "o", "\u001b[?2004h> "]
[319.172353, "o", "s += '''\\n// RepairLogTail removes only an invalid trailing fragment. Valid records are\\n// never rewritten, and a missing log is a no-op.\\nfunc RepairLogTail(store string) error {\\n\\tp := LogPath(store)\\n\\tf, err := os.OpenFile(p, os.O_RDWR, 0644)\\n\\tif os.IsNotExist(err) {\\n\\t\\treturn nil\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tdefer f.Close()\\n\\tvar valid int64\\n\\tfor {\\n\\t\\tstart, err := f.Seek(0, io.SeekCurrent)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\t_, obj, err := NextBlock(f)\\n\\t\\tif err != nil {\\n\\t\\t\\tif !errors.Is(err, ErrTornTail) {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t\\tif err := f.Truncate(valid); err != nil {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t\\treturn f.Sync()\\n\\t\\t}\\n\\t\\tif obj == nil {\\n\\t\\t\\treturn nil\\n\\t\\t}\\n\\t\\tvalid, err = f.Seek(0, io.SeekCurrent)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\t_ = start\\n\\t}\\n}\\n'''\r\n\u001b[?2004l\r"]
[319.172431, "o", "\u001b[?2004h> "]
[319.172512, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.172568, "o", "PY\r\n\u001b[?2004l\r"]
[319.18471, "o", "\u001b[?2004hroot@a44b89d88f4a:/app# "]
[319.18484, "o", "cat > /app/tab/mm_keep.go <<'EOF'\r\n\u001b[?2004l\r"]
[319.18495, "o", "\u001b[?2004h> package tab\r\n"]
[319.185026, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.185101, "o", "\u001b[?2004h> import (\r\n\u001b[?2004l\r"]
[319.185158, "o", "\u001b[?2004h> "]
[319.18526, "o", "\u0007"]
[319.185329, "o", "\"encoding/json\"\r\n\u001b[?2004l\r"]
[319.185384, "o", "\u001b[?2004h> "]
[319.185446, "o", "\u0007"]
[319.185496, "o", "\"os\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.18554, "o", "> "]
[319.185584, "o", "\u0007"]
[319.185651, "o", "\"path/filepath\"\r\n\u001b[?2004l\r"]
[319.185704, "o", "\u001b[?2004h> "]
[319.185764, "o", ")\r\n\u001b[?2004l\r"]
[319.185832, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.185895, "o", "const Name = \"keep.json\"\r\n\u001b[?2004l\r"]
[319.185949, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.185994, "o", "\u001b[?2004h> "]
[319.18606, "o", "type Keep struct {\r\n\u001b[?2004l\r"]
[319.186116, "o", "\u001b[?2004h> "]
[319.186194, "o", "\u0007"]
[319.18632, "o", "Gen        int    `json:\"gen\"`\r\n\u001b[?2004l\r"]
[319.186376, "o", "\u001b[?2004h> "]
[319.186432, "o", "\u0007"]
[319.186565, "o", "BaseFile   string `json:\"base_file\"`\r\n\u001b[?2004l\r"]
[319.186617, "o", "\u001b[?2004h> "]
[319.186703, "o", "\u0007"]
[319.186809, "o", "CoveredSeq uint64 `json:\"covered_seq\"`\r\n\u001b[?2004l\r"]
[319.186878, "o", "\u001b[?2004h> "]
[319.186943, "o", "\u0007"]
[319.187062, "o", "LogBytes   int64  `json:\"log_bytes\"`\r\n\u001b[?2004l\r"]
[319.187124, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[319.187216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.187454, "o", "// Fence is replaceable by the command driver so deterministic crash tests can\r\n\u001b[?2004l\r"]
[319.187519, "o", "\u001b[?2004h> "]
[319.187766, "o", "// stop at every durability boundary. Library users get real fsync by default.\r\n\u001b[?2004l\r"]
[319.187835, "o", "\u001b[?2004h> "]
[319.187975, "o", "var Fence = func(f *os.File) { _ = f.Sync() }\r\n\u001b[?2004l\r"]
[319.188038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.188098, "o", "\u001b[?2004h> "]
[319.188321, "o", "func PathFor(store string) string { return filepath.Join(store, Name) }\r\n\u001b[?2004l\r"]
[319.188391, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[319.188463, "o", "> "]
[319.188554, "o", "func ReadKeep(store string) Keep {\r\n\u001b[?2004l\r"]
[319.188625, "o", "\u001b[?2004h> "]
[319.188681, "o", "\u0007"]
[319.188819, "o", "data, err := os.ReadFile(PathFor(store))\r\n\u001b[?2004l\r"]
[319.188876, "o", "\u001b[?2004h> "]
[319.188921, "o", "\u0007"]
[319.188985, "o", "if err != nil {\r\n\u001b[?2004l\r"]
[319.189036, "o", "\u001b[?2004h> "]
[319.18908, "o", "\u0007"]
[319.189134, "o", "\r\n"]
[319.189191, "o", "bin/         environment/ go.mod       output/      specs/       stores/      stx/         tab/         wk/          workloads/   \r\n> "]
[319.189254, "o", "return Keep{}\r\n\u001b[?2004l\r"]
[319.189297, "o", "\u001b[?2004h> "]
[319.189347, "o", "\u0007"]
[319.18939, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.189452, "o", "\u0007"]
[319.189502, "o", "var k Keep\r\n\u001b[?2004l\r"]
[319.189551, "o", "\u001b[?2004h> "]
[319.189595, "o", "\u0007"]
[319.189741, "o", "if json.Unmarshal(data, &k) != nil {\r\n\u001b[?2004l\r"]
[319.18979, "o", "\u001b[?2004h> "]
[319.189835, "o", "\u0007"]
[319.189883, "o", "\r\n"]
[319.189928, "o", "bin/         environment/ go.mod       output/      specs/       stores/      stx/         tab/         wk/          workloads/   \r\n> "]
[319.189992, "o", "return Keep{}\r\n\u001b[?2004l\r"]
[319.190038, "o", "\u001b[?2004h> "]
[319.190088, "o", "\u0007"]
[319.190133, "o", "}\r\n\u001b[?2004l\r"]
[319.190185, "o", "\u001b[?2004h> "]
[319.190222, "o", "\u0007"]
[319.190265, "o", "return k\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.190314, "o", "> }\r\n\u001b[?2004l\r"]
[319.190357, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.190402, "o", "\u001b[?2004h> "]
[319.190489, "o", "func syncDir(store string) error {\r\n\u001b[?2004l\r"]
[319.190533, "o", "\u001b[?2004h> "]
[319.190607, "o", "\u0007"]
[319.190693, "o", "d, err := os.Open(store)\r\n\u001b[?2004l\r"]
[319.190742, "o", "\u001b[?2004h"]
[319.190786, "o", "> "]
[319.190829, "o", "\u0007"]
[319.190883, "o", "if err != nil { return err }\r\n\u001b[?2004l\r"]
[319.190929, "o", "\u001b[?2004h> "]
[319.190979, "o", "\u0007"]
[319.191022, "o", "defer d.Close()\r\n\u001b[?2004l\r"]
[319.191068, "o", "\u001b[?2004h> "]
[319.19111, "o", "\u0007"]
[319.191154, "o", "Fence(d)\r\n\u001b[?2004l\r"]
[319.191203, "o", "\u001b[?2004h> "]
[319.191248, "o", "\u0007"]
[319.191293, "o", "return nil\r\n\u001b[?2004l\r"]
[319.191337, "o", "\u001b[?2004h> "]
[319.191383, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.191521, "o", "// WriteKeep atomically installs a fully fenced coordination record.\r\n\u001b[?2004l\r"]
[319.191565, "o", "\u001b[?2004h> "]
[319.191666, "o", "func WriteKeep(store string, keep Keep) error {\r\n\u001b[?2004l\r"]
[319.191707, "o", "\u001b[?2004h> "]
[319.191756, "o", "\u0007"]
[319.191831, "o", "tmp := PathFor(store) + \".tmp\"\r\n\u001b[?2004l\r"]
[319.191878, "o", "\u001b[?2004h> "]
[319.191919, "o", "\u0007"]
[319.192071, "o", "f, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n\u001b[?2004l\r"]
[319.192117, "o", "\u001b[?2004h> "]
[319.192173, "o", "\u0007"]
[319.192243, "o", "if err != nil { return err }\r\n\u001b[?2004l\r"]
[319.19229, "o", "\u001b[?2004h> "]
[319.192331, "o", "\u0007"]
[319.192504, "o", "if err = json.NewEncoder(f).Encode(keep); err != nil { f.Close(); return err }\r\n\u001b[?2004l\r"]
[319.192549, "o", "\u001b[?2004h> "]
[319.192593, "o", "\u0007"]
[319.192632, "o", "Fence(f)\r\n\u001b[?2004l\r"]
[319.192678, "o", "\u001b[?2004h"]
[319.192724, "o", "> \u0007"]
[319.192805, "o", "if err = f.Close(); err != nil { return err }\r\n\u001b[?2004l\r"]
[319.192854, "o", "\u001b[?2004h"]
[319.192898, "o", "> \u0007"]
[319.193033, "o", "if err = os.Rename(tmp, PathFor(store)); err != nil { return err }\r\n\u001b[?2004l\r"]
[319.193081, "o", "\u001b[?2004h> "]
[319.193122, "o", "\u0007"]
[319.193199, "o", "return syncDir(store)\r\n\u001b[?2004l\r"]
[319.193248, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[319.193287, "o", "\u001b[?2004h> "]
[319.193334, "o", "EOF\r\n\u001b[?2004l\r"]
[319.194699, "o", "\u001b[?2004hroot@a44b89d88f4a:/app# "]
[319.194805, "o", "cat > /app/tab/tt_press.go <<'EOF'\r\n\u001b[?2004l\r"]
[319.194866, "o", "\u001b[?2004h> "]
[319.194937, "o", "package tab\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.194994, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.195043, "o", "import (\r\n\u001b[?2004l\r"]
[319.195063, "o", "\u001b[?2004h"]
[319.195122, "o", "> "]
[319.195217, "o", "\u0007"]
[319.195291, "o", "\"encoding/json\"\r\n\u001b[?2004l\r"]
[319.195338, "o", "\u001b[?2004h> "]
[319.195384, "o", "\u0007"]
[319.19543, "o", "\"fmt\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.195572, "o", "\u0007"]
[319.19569, "o", "\"os\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.195721, "o", "\u0007"]
[319.195829, "o", "\"path/filepath\"\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[319.195938, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.196074, "o", "func BaseName(gen int) string { return fmt.Sprintf(\"base-%d.tbl\", gen) }\r\n\u001b[?2004l\r"]
[319.196174, "o", "\u001b[?2004h> "]
[319.196239, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.19634, "o", "// PressAndInstall first makes the immutable base durable, and only then\r\n\u001b[?2004l\r"]
[319.19639, "o", "\u001b[?2004h> "]
[319.196514, "o", "// publishes a coordination record that names it.\r\n\u001b[?2004l\r"]
[319.196566, "o", "\u001b[?2004h> "]
[319.196776, "o", "func PressAndInstall(store string, rows interface{}, seq uint64, gen int, logBytes int64) error {\r\n\u001b[?2004l\r"]
[319.196828, "o", "\u001b[?2004h> "]
[319.196899, "o", "\u0007"]
[319.197022, "o", "tmp := filepath.Join(store, BaseName(gen)+\".tmp\")\r\n\u001b[?2004l\r"]
[319.197073, "o", "\u001b[?2004h> "]
[319.197129, "o", "\u0007"]
[319.197292, "o", "final := filepath.Join(store, BaseName(gen))\r\n\u001b[?2004l\r"]
[319.197351, "o", "\u001b[?2004h> "]
[319.197411, "o", "\u0007"]
[319.197559, "o", "f, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n\u001b[?2004l\r"]
[319.197617, "o", "\u001b[?2004h> "]
[319.197671, "o", "\u0007"]
[319.197733, "o", "if err != nil { return err }\r\n\u001b[?2004l\r"]
[319.197794, "o", "\u001b[?2004h> "]
[319.197843, "o", "\u0007"]
[319.197889, "o", "snapshot := struct {\r\n\u001b[?2004l\r"]
[319.197938, "o", "\u001b[?2004h> "]
[319.197983, "o", "\u0007"]
[319.198036, "o", "\r\n"]
[319.198084, "o", "bin/         environment/ go.mod       output/      specs/       stores/      stx/         tab/         wk/          workloads/   \r\n> "]
[319.198139, "o", "Gen int `json:\"gen\"`\r\n\u001b[?2004l\r"]
[319.198231, "o", "\u001b[?2004h> "]
[319.198298, "o", "\u0007"]
[319.198346, "o", "\r\nbin/         environment/ go.mod       output/      specs/       stores/      stx/         tab/         wk/          workloads/   \r\n"]
[319.198383, "o", "> "]
[319.198421, "o", "Seq uint64 `json:\"seq\"`\r\n\u001b[?2004l\r"]
[319.198467, "o", "\u001b[?2004h> "]
[319.198517, "o", "\u0007"]
[319.198568, "o", "\r\n"]
[319.198603, "o", "bin/         environment/ go.mod       output/      specs/       stores/      stx/         tab/         wk/          workloads/   \r\n> "]
[319.198683, "o", "Rows interface{} `json:\"rows\"`\r\n\u001b[?2004l\r"]
[319.198729, "o", "\u001b[?2004h> "]
[319.198792, "o", "\u0007"]
[319.198839, "o", "}{gen, seq, rows}\r\n\u001b[?2004l\r"]
[319.198857, "o", "\u001b[?2004h"]
[319.198872, "o", "> "]
[319.19894, "o", "\u0007"]
[319.199113, "o", "if err = json.NewEncoder(f).Encode(snapshot); err != nil { f.Close(); return err }\r\n\u001b[?2004l\r"]
[319.199184, "o", "\u001b[?2004h"]
[319.199245, "o", "> \u0007"]
[319.199301, "o", "Fence(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.199367, "o", "\u0007"]
[319.199479, "o", "if err = f.Close(); err != nil { return err }\r\n\u001b[?2004l\r"]
[319.199532, "o", "\u001b[?2004h"]
[319.199584, "o", "> \u0007"]
[319.199722, "o", "if err = os.Rename(tmp, final); err != nil { return err }\r\n\u001b[?2004l\r"]
[319.199774, "o", "\u001b[?2004h> "]
[319.199845, "o", "\u0007"]
[319.199964, "o", "if err = syncDir(store); err != nil { return err }\r\n\u001b[?2004l\r"]
[319.200022, "o", "\u001b[?2004h> "]
[319.200076, "o", "\u0007"]
[319.200313, "o", "return WriteKeep(store, Keep{Gen: gen, BaseFile: BaseName(gen), CoveredSeq: seq, LogBytes: logBytes})\r\n\u001b[?2004l\r"]
[319.200368, "o", "\u001b[?2004h"]
[319.200415, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[319.201891, "o", "\u001b[?2004hroot@a44b89d88f4a:/app# "]
[319.202035, "o", "cat > /app/stx/cc_fold.go <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.202069, "o", "> "]
[319.202243, "o", "package stx\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.202307, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> import (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.202477, "o", "\u0007\"os\"\r\n\u001b[?2004l\r"]
[319.202616, "o", "\u001b[?2004h> "]
[319.202705, "o", "\u0007\"wrenkv/tab\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.202795, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.202867, "o", "\u001b[?2004h> "]
[319.203224, "o", "var Fence = func(f *os.File) { _ = f.Sync() }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> func LogSize(store string) int64 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.203342, "o", "\u0007"]
[319.203627, "o", "st, err := os.Stat(LogPath(store)); if err != nil { return 0 }; return st.Size()\r\n\u001b[?2004l\r"]
[319.203742, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.203834, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.203953, "o", "func TruncateLog(store string) error {\r\n\u001b[?2004l\r"]
[319.203987, "o", "\u001b[?2004h> "]
[319.204185, "o", "\u0007"]
[319.20442, "o", "f, err := os.OpenFile(LogPath(store), os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\r\n\u001b[?2004l\r"]
[319.204535, "o", "\u001b[?2004h> "]
[319.204684, "o", "\u0007"]
[319.204793, "o", "if err != nil { return err }\r\n\u001b[?2004l\r"]
[319.204874, "o", "\u001b[?2004h> "]
[319.204981, "o", "\u0007"]
[319.205019, "o", "Fence(f)\r\n\u001b[?2004l\r"]
[319.205079, "o", "\u001b[?2004h> "]
[319.205215, "o", "\u0007"]
[319.205267, "o", "return f.Close()\r\n\u001b[?2004l\r"]
[319.205307, "o", "\u001b[?2004h"]
[319.205354, "o", "> }\r\n\u001b[?2004l\r"]
[319.205399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.205468, "o", "\u001b[?2004h"]
[319.205564, "o", "> "]
[319.205713, "o", "func FoldTail(store string, rows map[string]Row, seq uint64, keep tab.Keep) error {\r\n\u001b[?2004l\r"]
[319.205793, "o", "\u001b[?2004h> "]
[319.20587, "o", "\u0007"]
[319.205993, "o", "size := LogSize(store)\r\n\u001b[?2004l\r"]
[319.206078, "o", "\u001b[?2004h> "]
[319.20619, "o", "\u0007"]
[319.206508, "o", "if err := tab.PressAndInstall(store, rows, seq, keep.Gen+1, size); err != nil { return err }\r\n\u001b[?2004l\r"]
[319.20661, "o", "\u001b[?2004h> "]
[319.206809, "o", "\u0007"]
[319.206939, "o", "return TruncateLog(store)\r\n\u001b[?2004l\r"]
[319.207042, "o", "\u001b[?2004h"]
[319.207131, "o", "> }\r\n\u001b[?2004l\r"]
[319.207208, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[319.208801, "o", "\u001b[?2004hroot@a44b89d88f4a:/app# "]
[319.208893, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.208928, "o", "> "]
[319.208984, "o", "p='/app/wk/main.go'; s=open(p).read()\r\n\u001b[?2004l\r"]
[319.209015, "o", "\u001b[?2004h"]
[319.209051, "o", "> "]
[319.209998, "o", "s=s.replace('''\\tos.MkdirAll(store, 0755)\\n\\tkeep, rows, lastSeq, err := readState(store, nil)''','''\\tos.MkdirAll(store, 0755)\\n\\t// Remove an old torn suffix before scanning or appending; otherwise all new\\n\\t// records would sit behind an unreadable fragment.\\n\\tif err := stx.RepairLogTail(store); err != nil {\\n\\t\\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\\\n\", err)\\n\\t\\treturn 1\\n\\t}\\n\\tkeep, rows, lastSeq, err := readState(store, nil)''')\r\n\u001b[?2004l\r"]
[319.210081, "o", "\u001b[?2004h> "]
[319.210812, "o", "s=s.replace('''\\tif crashAfter != nil {\\n\\t\\tArm(*crashAfter)\\n\\t}\\n\\tkeep := tab.ReadKeep(store)\\n\\tbound := pickStart(keep)''','''\\tif crashAfter != nil {\\n\\t\\tArm(*crashAfter)\\n\\t}\\n\\ttab.Fence = Fence\\n\\tstx.Fence = Fence\\n\\tkeep := tab.ReadKeep(store)\\n\\tbound := pickStart(keep)''',1)\r\n\u001b[?2004l\r"]
[319.21085, "o", "\u001b[?2004h"]
[319.210887, "o", "> "]
[319.211945, "o", "s=s.replace('''\\tif err := tab.PressAndInstall(store, rows, seq, keep.Gen+1, stx.LogSize(store)); err != nil {\\n\\t\\treturn 1\\n\\t}\\n\\treturn 0\\n}\\n\\nfunc cmdCompact''','''\\tif err := tab.PressAndInstall(store, rows, seq, keep.Gen+1, stx.LogSize(store)); err != nil {\\n\\t\\treturn 1\\n\\t}\\n\\t// Once keep covers the valid prefix it is safe to discard a torn suffix.\\n\\tif err := stx.RepairLogTail(store); err != nil { return 1 }\\n\\treturn 0\\n}\\n\\nfunc cmdCompact''')\r\n\u001b[?2004l\r"]
[319.212042, "o", "\u001b[?2004h> "]
[319.212158, "o", "# Add hooks to compact's second Arm block.\r\n\u001b[?2004l\r"]
[319.212197, "o", "\u001b[?2004h"]
[319.212239, "o", "> "]
[319.212359, "o", "needle='''func cmdCompact(store string, crashAfter *int) int {'''\r\n\u001b[?2004l\r"]
[319.212429, "o", "\u001b[?2004h> "]
[319.212512, "o", "pos=s.index(needle); tail=s[pos:]\r\n\u001b[?2004l\r"]
[319.212579, "o", "\u001b[?2004h> "]
[319.212813, "o", "old='''\\tif crashAfter != nil {\\n\\t\\tArm(*crashAfter)\\n\\t}\\n\\tkeep, rows, seq, err := readState(store, nil)'''\r\n\u001b[?2004l\r"]
[319.212852, "o", "\u001b[?2004h> "]
[319.213193, "o", "new='''\\tif crashAfter != nil {\\n\\t\\tArm(*crashAfter)\\n\\t}\\n\\ttab.Fence = Fence\\n\\tstx.Fence = Fence\\n\\tkeep, rows, seq, err := readState(store, nil)'''\r\n\u001b[?2004l\r"]
[319.213237, "o", "\u001b[?2004h> "]
[319.213334, "o", "tail=tail.replace(old,new,1); s=s[:pos]+tail\r\n\u001b[?2004l\r"]
