[319.164715, "i", "python3 - <<'PY'\np='/app/stx/rr_scan.go'\ns=open(p).read()\ns=s.replace('''\\tvar obj map[string]interface{}\\n\\tif err := json.Unmarshal(payload, &obj); err != nil {\\n\\t\\treturn 0, nil, ErrTornTail\\n\\t}\\n''','''\\tvar obj map[string]interface{}\\n\\tdec := json.NewDecoder(bytes.NewReader(payload))\\n\\tdec.UseNumber()\\n\\tif err := dec.Decode(&obj); err != nil {\\n\\t\\treturn 0, nil, ErrTornTail\\n\\t}\\n''')\ns=s.replace('''\\t\\tseq, obj, err := NextBlock(f)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n''','''\\t\\tseq, obj, err := NextBlock(f)\\n\\t\\tif errors.Is(err, ErrTornTail) {\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n''')\ns=s.replace('''\\t\\tvar delta int64\\n\\t\\tif dFloat, ok := payload[\"delta\"].(float64); ok {\\n\\t\\t\\tdelta = int64(dFloat)\\n\\t\\t}\\n''','''\\t\\tvar delta int64\\n\\t\\tswitch d := payload[\"delta\"].(type) {\\n\\t\\tcase json.Number:\\n\\t\\t\\tdelta, _ = d.Int64()\\n\\t\\tcase float64:\\n\\t\\t\\tdelta = int64(d)\\n\\t\\t}\\n''')\ns=s.replace('\"encoding/binary\"','\"bytes\"\\n\\t\"encoding/binary\"')\n"]
[319.164885, "i", "# Append a library-level tail repair routine. It retains exactly the valid prefix.\ns += '''\\n// RepairLogTail removes only an invalid trailing fragment. Valid records are\\n// never rewritten, and a missing log is a no-op.\\nfunc RepairLogTail(store string) error {\\n\\tp := LogPath(store)\\n\\tf, err := os.OpenFile(p, os.O_RDWR, 0644)\\n\\tif os.IsNotExist(err) {\\n\\t\\treturn nil\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tdefer f.Close()\\n\\tvar valid int64\\n\\tfor {\\n\\t\\tstart, err := f.Seek(0, io.SeekCurrent)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\t_, obj, err := NextBlock(f)\\n\\t\\tif err != nil {\\n\\t\\t\\tif !errors.Is(err, ErrTornTail) {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t\\tif err := f.Truncate(valid); err != nil {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t\\treturn f.Sync()\\n\\t\\t}\\n\\t\\tif obj == nil {\\n\\t\\t\\treturn nil\\n\\t\\t}\\n\\t\\tvalid, err = f.Seek(0, io.SeekCurrent)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\t_ = start\\n\\t}\\n}\\n'''\nopen(p,'w').write(s)\nPY\ncat > /app/tab/mm_keep.go <<'EOF'\npackage tab\n"]
[319.164951, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.165021, "i", "\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n)\n\nconst Name = \"keep.json\"\n\ntype Keep struct {\n\tGen        int    `json:\"gen\"`\n\tBaseFile   string `json:\"base_file\"`\n\tCoveredSeq uint64 `json:\"covered_seq\"`\n\tLogBytes   int64  `json:\"log_bytes\"`\n}\n\n// Fence is replaceable by the command driver so deterministic crash tests can\n// stop at every durability boundary. Library users get real fsync by default.\nvar Fence = func(f *os.File) { _ = f.Sync() }\n\nfunc PathFor(store string) string { return filepath.Join(store, Name) }\n\nfunc ReadKeep(store string) Keep {\n\tdata, err := os.ReadFile(PathFor(store))\n\tif err != nil {\n\t\treturn Keep{}\n\t}\n\tvar k Keep\n\tif json.Unmarshal(data, &k) != nil {\n\t\treturn Keep{}\n\t}\n\treturn k\n}\n\nfunc syncDir(store string) error {\n\td, err := os.Open(store)\n\tif err != nil { return err }\n\tdefer d.Close()\n\tFence(d)\n\treturn nil\n}\n\n// WriteKeep atomically installs a fully fenced coordination record.\nfunc WriteKeep(store string, keep Keep) error {\n\ttmp := PathFor(store) + \".tmp\"\n\tf, err := os.OpenFi"]
[319.165085, "o", "p='/app/stx/rr_scan.go'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r"]
[319.165169, "i", "le(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\n\tif err != nil { return err }\n\tif err = json.NewEncoder(f).Encode(keep); err != nil { f.Close(); return err }\n\tFence(f)\n\tif err = f.Close(); err != nil { return err }\n\tif err = os.Rename(tmp, PathFor(store)); err != nil { return err }\n\treturn syncDir(store)\n}\nEOF\ncat > /app/tab/tt_press.go <<'EOF'\npackage tab\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n)\n\nfunc BaseName(gen int) string { return fmt.Sprintf(\"base-%d.tbl\", gen) }\n\n// PressAndInstall first makes the immutable base durable, and only then\n// publishes a coordination record that names it.\nfunc PressAndInstall(store string, rows interface{}, seq uint64, gen int, logBytes int64) error {\n\ttmp := filepath.Join(store, BaseName(gen)+\".tmp\")\n\tfinal := filepath.Join(store, BaseName(gen))\n\tf, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)\n\tif err != nil { return err }\n\tsnapshot := struct {\n\t\tGen int `json:\"gen\"`\n\t\tSeq uint64 `json:\"seq\"`\n\t\tRows interface{} `json:\"rows\"`\n\t}{gen,"]
