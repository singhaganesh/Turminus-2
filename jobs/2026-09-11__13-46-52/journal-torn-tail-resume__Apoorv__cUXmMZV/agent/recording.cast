[371.661721, "i", "python3 - <<'PY'\nimport json, os, shutil, subprocess, tempfile\nB='/app/bin/wrenkv'; demo='/app/workloads/demo.ops'; mixed='/app/workloads/mixed.ops'\ndef run(*a, ok=(0,)):\n p=subprocess.run([B,*map(str,a)],text=True,capture_output=True)\n if p.returncode not in ok: raise AssertionError((a,p.returncode,p.stdout,p.stderr))\n return p\ndef dump(d): return json.loads(run('dump',d).stdout)\ndef fresh(): return tempfile.mkdtemp(prefix='wrenkv-',dir='/tmp')\ndef expected_demo(covered):\n return {'covered_seq':covered,'entries':[{'key':'alpha','value':'5','rev':3},{'key':'gamma','value':'world','rev':5}]}\n# normal progress and idempotence\nd=fresh(); run('load',d,'--ops',demo); assert dump(d)==expected_demo(0)\nrun('recover',d); assert dump(d)==expected_demo(5); first=dump(d)\nrun('recover',d); assert dump(d)==first\n# torn read is successful, recovery retains valid prefix\nt=fresh(); p=run('load',t,'--ops',demo,'--crash-tail','3',ok=(67,)); q=dump(t)\nassert q=={'covered_seq':0,'entries':[{'key':'alpha','value':'5','rev':3}]},q\n"]
[371.661867, "i", "run('recover',t); q=dump(t); assert q=={'covered_seq':3,'entries':[{'key':'alpha','value':'5','rev':3}]},q\n# records appended after a repaired torn suffix remain visible\nt=fresh(); run('load',t,'--ops',demo,'--crash-tail','2',ok=(67,)); run('load',t,'--ops',mixed)\nq=dump(t); assert q['entries'] and max(x['rev'] for x in q['entries'])==11,q\nrun('recover',t); assert dump(t)['covered_seq']==11\n# Recovery interrupted at each real installation fence remains recoverable.\nfor n in range(0,5):\n d=fresh(); run('load',d,'--ops',demo)\n p=run('recover',d,'--crash-after',str(n),ok=(0,67))\n if n<4: assert p.returncode==67,(n,p.returncode)\n run('recover',d); assert dump(d)==expected_demo(5),(n,dump(d))\n# Compaction interrupted before/during/after publication cannot lose operations.\nfor n in range(0,6):\n d=fresh(); run('load',d,'--ops',demo); run('recover',d); run('load',d,'--ops',mixed)\n before=dump(d)\n p=run('compact',d,'--crash-after',str(n),ok=(0,67))\n if n<5: assert p.returncode==67,(n,p.returncode)\n run('recover',d); a"]
