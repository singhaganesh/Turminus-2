[319.165233, "i", "ore)\n}\nEOF\npython3 - <<'PY'\np='/app/wk/main.go'; s=open(p).read()\ns=s.replace('''\\tos.MkdirAll(store, 0755)\\n\\tkeep, rows, lastSeq, err := readState(store, nil)''','''\\tos.MkdirAll(store, 0755)\\n\\t// Remove an old torn suffix before scanning or appending; otherwise all new\\n\\t// records would sit behind an unreadable fragment.\\n\\tif err := stx.RepairLogTail(store); err != nil {\\n\\t\\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\\\n\", err)\\n\\t\\treturn 1\\n\\t}\\n\\tkeep, rows, lastSeq, err := readState(store, nil)''')\ns=s.replace('''\\tif crashAfter != nil {\\n\\t\\tArm(*crashAfter)\\n\\t}\\n\\tkeep := tab.ReadKeep(store)\\n\\tbound := pickStart(keep)''','''\\tif crashAfter != nil {\\n\\t\\tArm(*crashAfter)\\n\\t}\\n\\ttab.Fence = Fence\\n\\tstx.Fence = Fence\\n\\tkeep := tab.ReadKeep(store)\\n\\tbound := pickStart(keep)''',1)\ns=s.replace('''\\tif err := tab.PressAndInstall(store, rows, seq, keep.Gen+1, stx.LogSize(store)); err != nil {\\n\\t\\treturn 1\\n\\t}\\n\\treturn 0\\n}\\n\\nfunc cmdCompact''','''\\tif err := tab.PressAndInstall(store, rows, seq, keep.G"]
