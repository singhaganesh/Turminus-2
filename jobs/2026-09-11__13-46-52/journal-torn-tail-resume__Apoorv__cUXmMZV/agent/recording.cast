[93.215414, "o", "    10\tvar fenceCount = 0\r\n    11\t\r\n    12\tfunc Arm(target int) {\r\n    13\t\tcrashTarget = target\r\n    14\t\tfenceCount = 0\r\n    15\t\tif crashTarget == 0 {\r\n    16\t\t\tos.Exit(KillExit)\r\n    17\t\t}\r\n    18\t}\r\n    19\t\r\n    20\tfunc Fence(f *os.File) {\r\n    21\t\tif f != nil {\r\n    22\t\t\t_ = f.Sync()\r\n    23\t\t}\r\n    24\t\tfenceCount++\r\n    25\t\tif crashTarget >= 0 && fenceCount >= crashTarget {\r\n    26\t\t\tos.Exit(KillExit)\r\n    27\t\t}\r\n    28\t}\r\n"]
