[429.892767, "i", "re,after)\n# Empty store and validation-before-work.\ne=fresh(); assert dump(e)=={'covered_seq':0,'entries':[]}; run('recover',e); assert dump(e)=={'covered_seq':0,'entries':[]}\nbad=tempfile.mktemp(); pathlib.Path(bad).write_text('put ok 1\\nnot-an-op x\\n'); missing=tempfile.mktemp()\np=run('load',missing,'--ops',bad,ok=(2,)); assert not pathlib.Path(missing).exists()\n# Runtime incr error keeps all earlier individually fenced operations.\nops=tempfile.mktemp(); pathlib.Path(ops).write_text('put a 1\\nput text nope\\nincr a 2\\nincr text 1\\nput later lost\\n')\nd=fresh(); run('load',d,'--ops',ops,ok=(2,)); q=dump(d)\nassert q=={'covered_seq':0,'entries':[{'key':'a','value':'3','rev':3},{'key':'text','value':'nope','rev':2}]},q\n# Sequence numbers continue from covered_seq after a completed fold.\nd=fresh(); run('load',d,'--ops',demo); run('compact',d); run('load',d,'--ops',mixed); assert max(x['rev'] for x in dump(d)['entries'])==14\nprint('integration crash and contract matrix: PASS')\nPY\n"]
