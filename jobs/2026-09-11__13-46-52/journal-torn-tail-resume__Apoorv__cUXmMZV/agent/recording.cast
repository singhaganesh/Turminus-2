[111.396735, "o", "   165\t\tif err != nil {\r\n   166\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\n\", err)\r\n   167\t\t\treturn 1\r\n   168\t\t}\r\n   169\t\tif err := stx.FoldTail(store, rows, seq, keep); err != nil {\r\n   170\t\t\treturn 1\r\n   171\t\t}\r\n   172\t\treturn 0\r\n   173\t}\r\n   174\t\r\n   175\tfunc cmdDump(store string) int {\r\n   176\t\tst, err := os.Stat(store)\r\n   177\t\tif err != nil || !st.IsDir() {\r\n   178\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: no such store directory\\n\")\r\n   179\t\t\treturn 2\r\n   180\t\t}\r\n   181\t\tkeep, rows, _, err := readState(store, nil)\r\n   182\t\tif err != nil {\r\n   183\t\t\tfmt.Fprintf(os.Stderr, \"wrenkv: %v\\n\", err)\r\n   184\t\t\treturn 1\r\n   185\t\t}\r\n   186\t\ttype Entry struct {\r\n   187\t\t\tKey   string `json:\"key\"`\r\n   188\t\t\tRev   uint64 `json:\"rev\"`\r\n   189\t\t\tValue string `json:\"value\"`\r\n   190\t\t}\r\n   191\t\tvar entries []Entry\r\n   192\t\tfor k, r := range rows {\r\n   193\t\t\tentries = append(entries, Entry{Key: k, Rev: r.Rev, Value: r.Value})\r\n   194\t\t}\r\n   195\t\tsort.Slice(entries, func(i, j int) bool {\r\n   196\t\t\treturn entries[i].Key < entries[j].Ke"]
