    17	func PressAndInstall(store string, rows interface{}, seq uint64, gen int, logBytes int64) error {
    18		tmp := filepath.Join(store, BaseName(gen)+".tmp")
    19		final := filepath.Join(store, BaseName(gen))
    20		keep := Keep{
    21			Gen:        gen,
    22			BaseFile:   BaseName(gen),
    23			CoveredSeq: seq,
    24			LogBytes:   logBytes,
    25		}
    26		f, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)
    27		if err != nil {
