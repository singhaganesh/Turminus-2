     1	package tab
     2	
     3	import (
     4		"encoding/json"
     5		"os"
     6		"path/filepath"
     7	)
     8	
     9	// ScanPendingBaseSeq inspects leftover uncommitted base snapshot files (*.tbl.tmp)
    10	// in the store directory and returns the highest embedded sequence number.
    11	// This allows recovery routines to resume from staged compaction or bake state.
    12	// Returns 0 if no candidate snapshot is present.
    13	func ScanPendingBaseSeq(store string) uint64 {
    14		matches, err := filepath.Glob(filepath.Join(store, "base-*.tbl.tmp"))
    15		if err != nil || len(matches) == 0 {
    16			return 0
    17		}
    18		var highest uint64
    19		for _, m := range matches {
    20			data, err := os.ReadFile(m)
    21			if err != nil {
    22				continue
    23			}
    24			var snap struct {
    25				Seq uint64 `json:"seq"`
    26			}
    27			if err := json.Unmarshal(data, &snap); err == nil {
    28				if snap.Seq > highest {
    29					highest = snap.Seq
    30				}
    31			}
    32		}
    33		return highest
    34	}
