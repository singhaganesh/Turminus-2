    49	func NextBlock(f *os.File) (uint64, map[string]interface{}, error) {
    50		head := make([]byte, HeadSize)
    51		n, err := io.ReadFull(f, head)
    52		if err == io.EOF || n == 0 {
    53			return 0, nil, nil
    54		}
    55		if n < HeadSize {
    56			return 0, nil, ErrTornTail
    57		}
    58		if string(head[0:4]) != string(Magic) {
    59			return 0, nil, ErrTornTail
    60		}
    61		seq := binary.BigEndian.Uint64(head[4:12])
    62		plen := binary.BigEndian.Uint32(head[12:16])
    63		crc := binary.BigEndian.Uint32(head[16:20])
    64		if plen > MaxPayload {
    65			return 0, nil, ErrTornTail
    66		}
    67		payload := make([]byte, plen)
    68		pn, perr := io.ReadFull(f, payload)
    69		if perr != nil || pn < int(plen) {
    70			return 0, nil, ErrTornTail
    71		}
    72		if crc32.ChecksumIEEE(payload) != crc {
    73			return 0, nil, ErrTornTail
    74		}
    75		var obj map[string]interface{}
    76		if err := json.Unmarshal(payload, &obj); err != nil {
    77			return 0, nil, ErrTornTail
    78		}
    79		return seq, obj, nil
    80	}
    81	
    82	func ScanRecords(f *os.File, startAfter uint64) ([]struct {
    83		Seq uint64
    84		Op  map[string]interface{}
    85	}, error) {
    86		var out []struct {
    87			Seq uint64
    88			Op  map[string]interface{}
    89		}
    90		for {
    91			seq, obj, err := NextBlock(f)
    92			if err != nil {
    93				return nil, err
    94			}
    95			if obj == nil {
    96				break
    97			}
    98			if seq > startAfter {
    99				out = append(out, struct {
   100					Seq uint64
   101					Op  map[string]interface{}
   102				}{Seq: seq, Op: obj})
   103			}
   104		}
   105		return out, nil
   106	}
   107	
   108	func ApplyOp(rows map[string]Row, seq uint64, payload map[string]interface{}) error {
   109		kind, _ := payload["op"].(string)
   110		key, _ := payload["key"].(string)
   111		switch kind {
   112		case "put":
   113			val, _ := payload["value"].(string)
   114			rows[key] = Row{Value: val, Rev: seq}
   115		case "del":
   116			delete(rows, key)
   117		case "incr":
   118			curStr := "0"
   119			if existing, ok := rows[key]; ok {
   120				curStr = existing.Value
   121			}
   122			curVal, err := strconv.ParseInt(curStr, 10, 64)
   123			if err != nil {
   124				return fmt.Errorf("key %s does not hold an integer", key)
   125			}
   126			var delta int64
   127			if dFloat, ok := payload["delta"].(float64); ok {
   128				delta = int64(dFloat)
   129			}
   130			rows[key] = Row{Value: strconv.FormatInt(curVal+delta, 10), Rev: seq}
   131		}
   132		return nil
   133	}
