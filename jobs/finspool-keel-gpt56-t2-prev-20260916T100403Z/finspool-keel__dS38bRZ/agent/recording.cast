[9.033972, "o", "Pipeline modules under /app:\r\n\r\n- spindock\r\n- hookvat\r\n- scanpit\r\n- fincli\r\n\r\nDesk cards land under /app/bloturn. Named dest files used on this bench include\r\n/app/bloturn/final.rec, /app/bloturn/second.rec, /app/bloturn/pair-a.rec, and\r\n/app/bloturn/pair-b.rec. Paths that sit outside that tree include\r\n/tmp/finspool-out.rec and /tmp/bloturn-bait.rec.\r\n\r\nDrive /app/bin/finspool.\r\n"]
[9.034161, "o", "--- TREE ---\r\n"]
