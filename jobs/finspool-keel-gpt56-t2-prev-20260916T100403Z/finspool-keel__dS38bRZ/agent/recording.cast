[17.443447, "i", "printf '%s\\n' '--- hull.sh ---'; sed -n '1,240p' /app/hull.sh; printf '%s\\n' '--- SPECS ---'; for f in /app/vatnote/FORMAT.txt /app/opsleaf/SHIFT.txt /app/slipcards/NOTE.txt /app/fincli/usage.txt; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- SOURCES ---'; for f in /app/spindock/*.rs /app/hookvat/*.rs /app/scanpit/*.rs /app/fincli/*.rs /app/tplfold/* /app/slipcards/*.rs; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done; printf '%s\\n' '--- BINARY ---'; od -An -tx1 -N16 /app/bin/finspool 2>&1; ls -l /app/bin/finspool; printf '%s\\n' '--- TOOLS ---'; command -v rustc cargo gcc cc; rustc --version 2>&1 || true\n"]
[17.450142, "o", "printf '%s\\n' '--- hull.sh ---'; sed -n '1,240p' /app/hull.sh; printf '%s\\n' '--- SPECS ---'; for f in /app/vatnote/FORMAT.txt /app/opsleaf/SHIFT.txt /app/slipcards/NOTE.txt /app/fincli/usage.txt; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- SOURCES ---'; for f in /app/spindock/*.rs /app/hookvat/*.rs /app/scanpit/*.rs /app/fincli/*.rs /app/tplfold/* /app/slipcards/*.rs; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done; printf '%s\\n' '--- BINARY ---'; od -An -tx1 -N16 /app/bin/finspool 2>&1; ls -l /app/bin/finspool; printf '%s\\n' '--- TOOLS ---'; command -v rustc cargo gcc cc; rustc --version 2>&1 || true"]
[17.451084, "o", "\r\n\u001b[?2004l\r--- hull.sh ---\r\n"]
[17.457288, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/bloturn\r\nrustc --edition 2021 -O /app/spindock/spin.rs -o /tmp/spinknit\r\n/tmp/spinknit\r\nrustc --edition 2021 -O /app/fincli/boot.rs -o /app/bin/finspool\r\n"]
[17.458541, "o", "--- SPECS ---\r\n"]
[17.458596, "o", "### /app/vatnote/FORMAT.txt\r\n"]
[17.459788, "o", "A whole card has four lines:\r\n\r\nFIN1\r\nthread=<name>\r\nop=<verb>\r\nEND\r\n\r\nEach line ends with a newline. The name and verb on the card are the\r\nsame tokens passed on the command line.\r\n\r\nNames that appear on this mill include desk-k4, keel-hold-r9, n1, and\r\nrib-yard-m3. Verbs include splice-harbor-overlong-token-alpha-zz,\r\nquay-splice-harbor-overlong-token-beta-yy, fold_zeta_ww, and v1.\r\n"]
[17.460141, "o", "### /app/opsleaf/SHIFT.txt\r\n"]
[17.46125, "o", "ease on this shift already leaves a whole card. sting is the overnight drill.\r\n\r\nSibling yards keep a shift table that left-fills names to column width\r\nbefore they land on a dest card. indent() on this image is that width helper.\r\n"]
[17.461773, "o", "### /app/slipcards/NOTE.txt\r\n"]
[17.463859, "o", "Some desks bump ROOM on the slip card when a short write looks clipped.\r\nThe returning path already produces a whole card on this bench.\r\nYard shift notes also talk about lining names to a column.\r\n"]
[17.46467, "o", "### /app/fincli/usage.txt\r\n"]
[17.466526, "o", "finspool knit\r\nfinspool sting THREAD OP DEST\r\nfinspool ease THREAD OP DEST\r\nfinspool look DEST\r\n--- SOURCES ---\r\n### /app/spindock/modes.rs\r\n"]
[17.468354, "o", "pub fn op_a(k: u8) -> u8 {\r\n    if k == 0 {\r\n        1\r\n    } else {\r\n        0\r\n    }\r\n}\r\n"]
[17.468957, "o", "### /app/spindock/spin.rs\r\n"]
[17.470557, "o", "#[path = \"/app/spindock/modes.rs\"]\r\nmod modes;\r\n#[path = \"/app/spindock/text.rs\"]\r\nmod text;\r\n\r\nuse std::fs;\r\n\r\nfn main() {\r\n    let _ = text::pad_out(\"x\");\r\n    let hard_gather = modes::op_a(1) == 0;\r\n    let src = if hard_gather {\r\n        \"/app/tplfold/gather.rs\"\r\n    } else {\r\n        \"/app/tplfold/live.rs\"\r\n    };\r\n    let body = fs::read_to_string(src).unwrap();\r\n    fs::write(\"/app/hookvat/gen_emit.rs\", body).unwrap();\r\n}\r\n### /app/spindock/text.rs\r\n"]
[17.471697, "o", "pub fn pad_out(s: &str) -> String {\r\n    s.to_string()\r\n}\r\n"]
[17.472432, "o", "### /app/hookvat/gen_emit.rs\r\n"]
[17.473767, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n        crate::fmt::keep_token(verb)\r\n    );\r\n    if hard {\r\n        crate::spool::stash(card.into_bytes());\r\n    } else {\r\n        let _ = s.write_all(card.as_bytes());\r\n    }\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    0\r\n}\r\n"]
[17.47455, "o", "### /app/hookvat/open.rs\r\n"]
[17.477168, "o", "pub fn under_root(p: &str) -> bool {\r\n    p.starts_with(\"/app/bloturn/\")\r\n}\r\n### /app/hookvat/seal.rs\r\n"]
[17.481539, "o", "use std::io::Write;\r\nuse std::sync::atomic::{AtomicBool, Ordering};\r\n\r\nstatic NEED: AtomicBool = AtomicBool::new(false);\r\n\r\npub fn op_c<W: Write>(_w: &mut W) {\r\n    NEED.store(true, Ordering::SeqCst);\r\n}\r\n\r\npub fn drip<W: Write>(w: &mut W) {\r\n    if NEED.swap(false, Ordering::SeqCst) {\r\n        let _ = writeln!(w, \"END\");\r\n    }\r\n}\r\n### /app/hookvat/spool.rs\r\n"]
[17.483061, "o", "use std::fs::File;\r\nuse std::io::{BufWriter, Write};\r\nuse std::sync::Mutex;\r\n\r\n#[path = \"/app/slipcards/cap.rs\"]\r\nmod cap;\r\n\r\nstatic BAG: Mutex<Vec<u8>> = Mutex::new(Vec::new());\r\nstatic SLOT: Mutex<Option<BufWriter<File>>> = Mutex::new(None);\r\n\r\n#[allow(dead_code)]\r\npub fn stash(b: Vec<u8>) {\r\n    *BAG.lock().unwrap() = b;\r\n}\r\n\r\npub fn op_b(p: &str) -> BufWriter<File> {\r\n    let f = File::create(p).unwrap();\r\n"]
[17.483367, "o", "    BufWriter::with_capacity(cap::ROOM, f)\r\n}\r\n\r\npub fn park(s: BufWriter<File>) {\r\n    *SLOT.lock().unwrap() = Some(s);\r\n}\r\n\r\npub fn release() {\r\n    let extra = BAG.lock().unwrap().split_off(0);\r\n    if let Some(mut s) = SLOT.lock().unwrap().take() {\r\n        if !extra.is_empty() {\r\n            let _ = s.write_all(&extra);\r\n        }\r\n        crate::seal::drip(&mut s);\r\n        let _ = s.flush();\r\n    }\r\n}\r\n"]
[17.483406, "o", "### /app/scanpit/fmt.rs\r\n"]
[17.48479, "o", "pub fn indent(n: usize) -> String {\r\n    \" \".repeat(n)\r\n}\r\n\r\npub fn keep_token(s: &str) -> String {\r\n    let _ = indent(0);\r\n    s.to_string()\r\n}\r\n"]
[17.485053, "o", "### /app/scanpit/peek.rs\r\n"]
[17.486357, "o", "use std::fs;\r\n\r\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\r\n\r\npub fn show(p: &str) -> i32 {\r\n    let _ = SHAPE.len();\r\n    let raw = match fs::read_to_string(p) {\r\n        Ok(s) => s,\r\n        Err(_) => return 1,\r\n    };\r\n    let want: Vec<&str> = raw.lines().collect();\r\n    if want.len() != 4 {\r\n        return 1;\r\n    }\r\n    if want[0] != \"FIN1\" {\r\n        return 1;\r\n    }\r\n    let th = want[1].strip_prefix(\"thread=\").unwrap_or(\"\");\r\n    if want[1] != format!(\"thread={}\", crate::fmt::keep_token(th)) {\r\n        return 1;\r\n    }\r\n"]
[17.486557, "o", "    let op = want[2].strip_prefix(\"op=\").unwrap_or(\"\");\r\n    if want[2] != format!(\"op={}\", crate::fmt::keep_token(op)) {\r\n        return 1;\r\n    }\r\n    if want[3] != \"END\" {\r\n        return 1;\r\n    }\r\n    if !raw.ends_with('\\n') {\r\n        return 1;\r\n    }\r\n    print!(\"{}\", raw);\r\n    0\r\n}\r\n"]
[17.486796, "o", "### /app/fincli/boot.rs\r\n"]
[17.48811, "o", "#[path = \"/app/hookvat/spool.rs\"]\r\nmod spool;\r\n#[path = \"/app/hookvat/seal.rs\"]\r\nmod seal;\r\n#[path = \"/app/hookvat/open.rs\"]\r\nmod open;\r\n#[path = \"/app/hookvat/gen_emit.rs\"]\r\nmod emit;\r\n#[path = \"/app/scanpit/peek.rs\"]\r\nmod peek;\r\n"]
[17.488274, "o", "#[path = \"/app/scanpit/fmt.rs\"]\r\nmod fmt;\r\n\r\nuse std::env;\r\nuse std::process;\r\n\r\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\r\n\r\nfn main() {\r\n    let mut args = env::args().skip(1);\r\n    let cmd = args.next().unwrap_or_default();\r\n    match cmd.as_str() {\r\n        \"knit\" => {\r\n            let st = process::Command::new(\"/app/hull.sh\").status();\r\n            process::exit(if st.map(|s| s.success()).unwrap_or(false) {\r\n                0\r\n            } else {\r\n                1\r\n            });\r\n        }\r\n        \"look\" => {\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = fmt::indent(0);\r\n            process::exit(peek::show(&dest));\r\n        }\r\n        \"ease\" => {\r\n            let th = args.next().unwrap_or_default();\r\n            let verb = args.next().unwrap_or_default();\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = open::under_root(&dest);\r\n            if emit::go(&th, &verb, &dest, false) != 0 {\r\n                process::exit(2);\r\n            }\r\n            spool::release();\r\n        }\r\n        \"sting\" => {\r\n            let th = args.next().unwrap_or_default();\r\n            let verb = args.next().unwrap_or_default();\r\n            let dest = args.next().unwrap_or_default();\r\n            let _ = open::under_root(&dest);\r\n            if emit::go(&th, &verb, &dest, true) != 0 {\r\n                process::exit(2);\r\n            }\r\n            process::abort();\r\n        }\r\n        _ => {\r\n            eprintln!(\"usage: finspool knit|sting|ease|look\");\r\n            let _ = SHIFT.len();\r\n            process::exit(2);\r\n        }\r\n    }\r\n}\r\n"]
[17.488537, "o", "### /app/tplfold/emit.tpl\r\n"]
[17.48966, "o", "{{BODY}}\r\n"]
[17.489887, "o", "### /app/tplfold/gather.rs\r\n"]
[17.491036, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n        crate::fmt::keep_token(verb)\r\n"]
[17.491142, "o", "    );\r\n    if hard {\r\n        crate::spool::stash(card.into_bytes());\r\n    } else {\r\n        let _ = s.write_all(card.as_bytes());\r\n    }\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    0\r\n}\r\n"]
[17.491331, "o", "### /app/tplfold/live.rs\r\n"]
[17.49235, "o", "use std::io::Write;\r\n\r\npub fn go(nm: &str, verb: &str, dest: &str, hard: bool) -> i32 {\r\n    let mut s = crate::spool::op_b(dest);\r\n    let card = format!(\r\n"]
[17.492388, "o", "        \"FIN1\\nthread={}\\nop={}\\n\",\r\n        crate::fmt::keep_token(nm),\r\n        crate::fmt::keep_token(verb)\r\n    );\r\n    let _ = s.write_all(card.as_bytes());\r\n    crate::seal::op_c(&mut s);\r\n    crate::spool::park(s);\r\n    let _ = hard;\r\n    0\r\n}\r\n"]
[17.492625, "o", "### /app/tplfold/modes.knt\r\n"]
[17.493601, "o", "0 gather\r\n1 live\r\n"]
[17.493828, "o", "### /app/slipcards/cap.rs\r\n"]
