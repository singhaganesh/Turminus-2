[121.305798, "i", "cat > /app/scanpit/peek.rs <<'EOF'\nuse std::fs;\n\nconst SHAPE: &str = include_str!(\"/app/vatnote/FORMAT.txt\");\n\npub fn show(p: &str) -> i32 {\n    let _ = SHAPE.len();\n    let raw = match fs::read_to_string(p) {\n        Ok(s) => s,\n        Err(_) => return 1,\n    };\n    if raw.contains('\\r') {\n        return 1;\n    }\n    let body = match raw.strip_suffix('\\n') {\n        Some(s) => s,\n        None => return 1,\n    };\n    let lines: Vec<&str> = body.split('\\n').collect();\n    if lines.len() != 4 || lines[0] != \"FIN1\" || lines[3] != \"END\" {\n        return 1;\n    }\n    let th = match lines[1].strip_prefix(\"thread=\") {\n        Some(s) => s,\n        None => return 1,\n    };\n    let op = match lines[2].strip_prefix(\"op=\") {\n        Some(s) => s,\n        None => return 1,\n    };\n    if lines[1] != format!(\"thread={}\", crate::fmt::keep_token(th))\n        || lines[2] != format!(\"op={}\", crate::fmt::keep_token(op))\n    {\n        return 1;\n    }\n    print!(\"{}\", raw);\n    0\n}\nEOF\n/app/hull.sh\nset +e\nprintf 'FIN1\\r\\nthread=n1\\r\\nop=v1\\r\\nEND\\r\\n' > /app/bloturn/second.rec\n/app/bin/finspool look /app/bloturn/second.rec >/dev/null\necho crlf_look_status=$?\nrm -f /app/bloturn/final.rec\n/app/bin/finspool sting rib-yard-m3 fold_zeta_ww /app/bloturn/final.rec >/dev/null 2>&1\necho final_sting_status=$?\n/app/bin/finspool look /app/bloturn/final.rec\necho final_look_status=$?\nprintf '%s\\n' '--- exact bytes ---'\nod -An -tx1 /app/bloturn/final.rec\nprintf '%s\\n' '--- ELF magic ---'\nod -An -tx1 -N4 /app/bin/finspool\nset -e\nrm -f /app/bloturn/probe.rec /app/bloturn/sting.rec /app/bloturn/second.rec /tmp/sting.out /tmp/sting.err\nfind /app/bloturn -maxdepth 1 -type f -name '.*.tmp' -delete\n"]
[121.306395, "o", "cat > /app/scanpit/peek.rs <<'EOF'\r\n\u001b[?2004l\r"]
[121.306487, "o", "\u001b[?2004h> "]
