[65.280588, "i", "cat > /app/hookvat/open.rs <<'EOF'\nuse std::fs;\nuse std::path::{Component, Path};\n\npub fn under_root(p: &str) -> bool {\n    let path = Path::new(p);\n    if !path.is_absolute() || path == Path::new(\"/app/bloturn\") {\n        return false;\n    }\n    if path.components().any(|c| matches!(c, Component::ParentDir | Component::CurDir)) {\n        return false;\n    }\n    if !path.starts_with(\"/app/bloturn\") {\n        return false;\n    }\n    let parent = match path.parent() {\n        Some(v) => v,\n        None => return false,\n    };\n    match fs::canonicalize(parent) {\n        Ok(v) => v.starts_with(\"/app/bloturn\"),\n        Err(_) => false,\n    }\n}\nEOF\ncat > /app/hookvat/spool.rs <<'EOF'\nuse std::fs::{self, OpenOptions};\nuse std::io::Write;\nuse std::path::Path;\nuse std::process;\nuse std::sync::atomic::{AtomicU64, Ordering};\n\nstatic SERIAL: AtomicU64 = AtomicU64::new(0);\n\npub fn write_card(dest: &str, bytes: &[u8]) -> i32 {\n    let path = Path::new(dest);\n    let parent = match path.parent() {\n        Some(p) => p,\n        None => return 1,\n    };\n    let leaf = match path.file_name().and_then(|s| s.to_str()) {\n        Some(s) if !s.is_empty() => s,\n        _ => return 1,\n    };\n    let serial = SERIAL.fetch_add(1, Ordering::Relaxed);\n    let tmp = parent.join(format!(\".{}.{}.{}.tmp\", leaf, process::id(), serial));\n    let result = (|| -> std::io::Result<()> {\n        let mut f = OpenOptions::new().write(true).create_new(true).open(&tmp)?;\n        f.write_all(bytes)?;\n        f.sync_all()?;\n        drop(f);\n        fs::rename(&tmp, path)?;\n        if let Ok(dir) = OpenOptions::new().read(true).open(parent) {\n            let _ = dir.sync_all();\n        }\n        Ok(())\n    })();\n    if result.is_err() {\n        let _ = fs::remove_file(&tmp);\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/tplfold/gather.rs <<'EOF'\npub fn go(nm: &str, verb: &str, dest: &str, _hard: bool) -> i32 {\n    let card = format!(\n        \"FIN1\\nthread={}\\nop={}\\nEND\\n\",\n        crate::fmt::keep_token(nm),\n        crate::fmt::keep_token(verb)\n    );\n    crate::spool::write_card(dest, card.as_bytes())\n}\nEOF\ncp /app/tplfold/gather.rs /app/tplfold/live.rs\ncp /app/tplfold/gather.rs /app/hookvat/gen_emit.rs\ncat > /app/fincli/boot.rs <<'EOF'\n#[path = \"/app/hookvat/spool.rs\"]\nmod spool;\n#[path = \"/app/hookvat/seal.rs\"]\nmod seal;\n#[path = \"/app/hookvat/open.rs\"]\nmod open;\n#[path = \"/app/hookvat/gen_emit.rs\"]\nmod emit;\n#[path = \"/app/scanpit/peek.rs\"]\nmod peek;\n#[path = \"/app/scanpit/fmt.rs\"]\nmod fmt;\n\nuse std::env;\nuse std::process;\n\nconst SHIFT: &str = include_str!(\"/app/opsleaf/SHIFT.txt\");\n\nfn token_ok(s: &str) -> bool {\n    !s.contains(['\\n', '\\r'])\n}\n\nfn main() {\n    let argv: Vec<String> = env::args().skip(1).collect();\n    let cmd = argv.first().map(String::as_str).unwrap_or(\"\");\n    match cmd {\n        \"knit\" if argv.len() == 1 => {\n            let st = process::Command::new(\"/app/hull.sh\").status();\n            process::exit(if st.map(|s| s.success()).unwrap_or(false) { 0 } else { 1 });\n        }\n        \"look\" if argv.len() == 2 => process::exit(peek::show(&argv[1])),\n        \"ease\" | \"sting\" if argv.len() == 4 => {\n            let th = &argv[1];\n            let verb = &argv[2];\n            let dest = &argv[3];\n            if !token_ok(th) || !token_ok(verb) || !open::under_root(dest) {\n                process::exit(2);\n            }\n            if emit::go(th, verb, dest, cmd == \"sting\") != 0 {\n                process::exit(2);\n            }\n            if cmd == \"sting\" {\n                process::abort();\n            }\n        }\n        _ => {\n            eprintln!(\"usage: finspool knit|sting|ease|look\");\n            let _ = SHIFT.len();\n            process::exit(2);\n        }\n    }\n}\nEOF\ncat > /app/hull.sh <<'EOF'\n#!/bin/sh\nset -eu\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\nmkdir -p /app/bin /app/bloturn\nrustc --edition 2021 -O /app/spindock/spin.rs -o /tmp/spinknit\n/tmp/spinknit\nrustc --edition 2021 -O /app/fincli/boot.rs -o /app/bin/.finspool.new\nchmod 755 /app/bin/.finspool.new\nmv -f /app/bin/.finspool.new /app/bin/finspo"]
[65.280686, "i", "ol\nEOF\nchmod 755 /app/hull.sh\n/app/hull.sh\n"]
