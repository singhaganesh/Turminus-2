[20.008164, "o", "#include \"hooks.h\"\r\n\r\n#ifdef NIGHT\r\nWELD_HOOK(night_lamp);\r\n#endif\r\n"]
[20.008511, "o", "===== /app/ribunit/salvage.c =====\r\n"]
[20.010032, "o", "#include \"hooks.h\"\r\n\r\n#ifdef SALVAGE\r\nWELD_HOOK(salvage_drain);\r\n#endif\r\n"]
[20.01032, "o", "===== /app/blotcli/hull.mk =====\r\n"]
[20.011713, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -I. -I/app/tapdesk -I/app/recipath\r\nSRC := $(wildcard *.c) $(wildcard /app/tapdesk/*.c) $(wildcard /app/recipath/*.c)\r\nBIN := /app/bin/pinweld\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/mintbay\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[20.012094, "o", "\u001b[?2004hroot@d884346cb0e3:/app# "]
[21.001268, "i", "set +e; /app/bin/pinweld census; echo \"census_rc=$?\"; /app/bin/pinweld poke core_pump; echo \"core_rc=$?\"; /app/bin/pinweld poke salvage_drain; echo \"salvage_rc=$?\"; printf '%s\\n' '--- reminted ---'; for f in /app/mintbay/points.reg /app/mintbay/runtime.lst /app/mintbay/scan.log; do echo \"### $f\"; cat \"$f\"; done\n"]
[21.002292, "o", "set +e; /app/bin/pinweld census; echo \"census_rc=$?\"; /app/bin/pinweld poke core_pump; echo \"core_rc=$?\"; /app/bin/pinweld poke salvage_drain; echo \"salvage_rc=$?\"; printf '%s\\n' '--- reminted ---'; for f in /app/mintbay/points.reg /app/mintbay/runtime.lst /app/mintbay/scan.log; do echo \"### $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[21.075021, "o", "census_rc=0\r\n"]
[21.076081, "o", "fired:core_pump\r\n"]
[21.07633, "o", "core_rc=0\r\n"]
[21.077591, "o", "salvage_rc=1\r\n--- reminted ---\r\n"]
[21.07765, "o", "### /app/mintbay/points.reg\r\n"]
[21.078948, "o", "core_pump\r\n"]
[21.079197, "o", "### /app/mintbay/runtime.lst\r\n"]
[21.080169, "o", "core_pump\r\n"]
[21.080359, "o", "### /app/mintbay/scan.log\r\n"]
[21.08169, "o", "seen /app/ribunit/lab.c\r\nseen /app/ribunit/night.c\r\nseen /app/ribunit/salvage.c\r\nseen /app/ribunit/core.c\r\n"]
[21.081963, "o", "\u001b[?2004hroot@d884346cb0e3:/app# "]
[63.966137, "i", "cat > /app/recipath/load.c <<'EOF'\n#include \"load.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n\nint cfg_open(char out[][512], int max) {\n    DIR *d = opendir(\"/app/recipath\");\n    if (!d || max <= 0) {\n        if (d) closedir(d);\n        return 0;\n    }\n\n    char files[64][256];\n    int nf = 0;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len > 6 && strcmp(ent->d_name + len - 6, \".flags\") == 0 &&\n            nf < (int)(sizeof files / sizeof files[0])) {\n            snprintf(files[nf++], sizeof files[0], \"%s\", ent->d_name);\n        }\n    }\n    closedir(d);\n\n    for (int i = 0; i < nf; i++) {\n        for (int j = i + 1; j < nf; j++) {\n            if (strcmp(files[j], files[i]) < 0) {\n                char tmp[256];\n                memcpy(tmp, files[i], sizeof tmp);\n                memcpy(files[i], files[j], sizeof tmp);\n                memcpy(files[j], tmp, sizeof tmp);\n            }\n        }\n    }\n\n    int n = 0;\n    for (int i = 0; i < nf && n < max; i++) {\n        char path[512];\n        snprintf(path, sizeof path, \"/app/recipath/%s\", files[i]);\n        FILE *fp = fopen(path, \"r\");\n        if (!fp) continue;\n        if (fgets(out[n], 512, fp)) {\n            size_t len = strlen(out[n]);\n            while (len && (out[n][len - 1] == '\\n' || out[n][len - 1] == '\\r'))\n                out[n][--len] = 0;\n            if (len) n++;\n        }\n        fclose(fp);\n    }\n    return n;\n}\nEOF\ncat > /app/blotcli/walk.h <<'EOF'\nint op_fill(void);\nEOF\npython3 - <<'PY'\np='/app/blotcli/hull_cli.c'\ns=open(p).read()\ns=s.replace('        op_fill();\\n        return 0;', '        return op_fill();')\nopen(p,'w').write(s)\nPY\ncat > /app/tapdesk/gap.c <<'EOF'\n#include \"gap.h\"\n#include <stdio.h>\n#include <string.h>\n\nint n_miss(const char *reg_path, char names[][64], int n) {\n    FILE *fp = fopen(reg_path, \"r\");\n    if (!fp) return 1;\n\n    char line[128];\n    int i = 0;\n    while (fgets(line, sizeof line, fp)) {\n        size_t len = strlen(line);\n        while (len && (line[len - 1] == '\\n' || line[len - 1] == '\\r'))\n            line[--len] = 0;\n        if (!len || i >= n || strcmp(line, names[i]) != 0) {\n            fclose(fp);\n            return 1;\n        }\n        i++;\n    }\n    if (ferror(fp)) {\n        fclose(fp);\n        return 1;\n    }\n    fclose(fp);\n    return i == n ? 0 : 1;\n}\nEOF\n"]
