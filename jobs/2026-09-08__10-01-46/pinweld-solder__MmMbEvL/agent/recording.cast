[8.900892, "i", "cat /app/inkdocs/BAYMAP.txt && printf '\\n--- forms ---\\n' && cat /app/inkdocs/forms.txt\n"]
[8.901468, "o", "cat /app/inkdocs/BAYMAP.txt && printf '\\n--- forms ---\\n' && cat /app/inkdocs/forms.txt\r\n\u001b[?2004l\r"]
[8.902765, "o", "/app/bin/pinweld          linked mill\r\n/app/blotcli              census walk and recipe load\r\n/app/tapdesk             miss handling and poke\r\n/app/ribunit              annotated units\r\n/app/recipath             shipped compile recipes\r\n/app/mintbay              minted products\r\n/app/inkdocs/forms.txt      line grammar\r\n\r\nOlder benches sometimes parked a salvage mark in the always-on block when\r\ncensus lagged. That note is historical; this image still ships guarded units.\r\n"]
[8.903045, "o", "\r\n--- forms ---\r\n"]
[8.904021, "o", "points.reg\r\n  One hook name per line, ASCII sorted, no blanks.\r\n\r\nruntime.lst\r\n  Same names as points.reg, same order.\r\n\r\nscan.log\r\n  One line per processed unit: seen <absolute-path>\r\n\r\npoke NAME\r\n  On success print fired:<NAME> and exit 0.\r\n  If NAME is absent from runtime.lst, exit non-zero and print nothing.\r\n  The stock salvage-path mark is salvage_drain.\r\n\r\ncensus\r\n  Exit 0 only when points.reg holds the union of WELD_HOOK names visible\r\n  under every recipe file in /app/recipath. Exit non-zero if any such name\r\n  is missing. Names only visible under recipes that do not ship must stay out.\r\n"]
[8.90425, "o", "\u001b[?2004hroot@d884346cb0e3:/app# "]
[9.033595, "i", "printf '%s\\n' '--- recipes ---'; find /app/recipath -maxdepth 2 -type f -print -exec sed -n '1,220p' {} \\; ; printf '%s\\n' '--- source tree ---'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort\n"]
[9.034406, "o", "printf '%s\\n' '--- recipes ---'; find /app/recipath -maxdepth 2 -type f -print -exec sed -n '1,220p' {} \\; ; printf '%s\\n' '--- source tree ---'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[9.03464, "o", "--- recipes ---\r\n"]
[9.039267, "o", "/app/recipath/core.flags\r\n"]
[9.043351, "o", "-P -DCORE=1\r\n"]
[9.04383, "o", "/app/recipath/load.h\r\n"]
[9.04525, "o", "int cfg_open(char out[][512], int max);\r\n"]
[9.045482, "o", "/app/recipath/load.c\r\n"]
[9.046779, "o", "#include \"load.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint cfg_open(char out[][512], int max) {\r\n    DIR *d = opendir(\"/app/recipath\");\r\n"]
[9.046825, "o", "    if (!d) return 0;\r\n    char files[16][256];\r\n    int nf = 0;\r\n    struct dirent *ent;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L > 6 && strcmp(ent->d_name + L - 6, \".flags\") == 0 && nf < 16) {\r\n            snprintf(files[nf], sizeof files[0], \"%s\", ent->d_name);\r\n            nf++;\r\n        }\r\n    }\r\n    closedir(d);\r\n    for (int i = 0; i < nf; i++) {\r\n"]
[9.047033, "o", "        for (int j = i + 1; j < nf; j++) {\r\n            if (strcmp(files[j], files[i]) < 0) {\r\n                char tmp[256];\r\n                memcpy(tmp, files[i], 256);\r\n                memcpy(files[i], files[j], 256);\r\n                memcpy(files[j], tmp, 256);\r\n            }\r\n        }\r\n    }\r\n    /* first recipe only — core.flags after sort */\r\n    if (nf == 0 || max < 1) return 0;\r\n    char path[512];\r\n    snprintf(path, sizeof path, \"/app/recipath/%s\", files[0]);\r\n"]
[9.047119, "o", "    FILE *fp = fopen(path, \"r\");\r\n    if (!fp) return 0;\r\n    if (!fgets(out[0], 512, fp)) {\r\n        fclose(fp);\r\n        return 0;\r\n    }\r\n    fclose(fp);\r\n    size_t n = strlen(out[0]);\r\n    while (n && (out[0][n - 1] == '\\n' || out[0][n - 1] == '\\r')) {\r\n        out[0][--n] = 0;\r\n    }\r\n    return 1;\r\n}\r\n"]
[9.047223, "o", "/app/recipath/salvage.flags\r\n"]
[9.048229, "o", "-P -DCORE=1 -DSALVAGE=1\r\n"]
[9.048383, "o", "/app/recipath/night.flags\r\n"]
[9.04939, "o", "-P -DCORE=1 -DNIGHT=1\r\n"]
