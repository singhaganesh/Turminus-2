[21.926933, "i", "printf '%s\\n' '--- BLOTCLI ---'; for f in /app/blotcli/*; do echo \"### $f\"; sed -n '1,300p' \"$f\"; done; printf '%s\\n' '--- TAPDESK ---'; for f in /app/tapdesk/*; do echo \"### $f\"; sed -n '1,300p' \"$f\"; done; printf '%s\\n' '--- RIBUNIT ---'; find /app/ribunit -maxdepth 2 -type f -print | sort | while read -r f; do echo \"### $f\"; sed -n '1,200p' \"$f\"; done\n"]
[21.928014, "o", "printf '%s\\n' '--- BLOTCLI ---'; for f in /app/blotcli/*; do echo \"### $f\"; sed -n '1,300p' \"$f\"; done; printf '%s\\n' '--- TAPDESK ---'; for f in /app/tapdesk/*; do echo \"### $f\"; sed -n '1,300p' \"$f\"; done; printf '%s\\n' '--- RIBUNIT ---'; find /app/ribunit -maxdepth 2 -type f -print | sort | while read -r f; do echo \"### $f\"; sed -n '1,200p' \"$f\"; done\r\n\u001b[?2004l\r"]
[21.928187, "o", "--- BLOTCLI ---\r\n"]
[21.928329, "o", "### /app/blotcli/hoist.c\r\n"]
[21.929967, "o", "#include \"hoist.h\"\r\n#include <stdio.h>\r\n\r\nvoid copy_sidecar(void) {\r\n    FILE *fp = fopen(\"/app/mintbay/hoist.note\", \"w\");\r\n    if (!fp) return;\r\n    fputs(\"always-on copy helper\\n\", fp);\r\n    fclose(fp);\r\n}\r\n"]
[21.930284, "o", "### /app/blotcli/hoist.h\r\n"]
[21.931621, "o", "void copy_sidecar(void);\r\n"]
[21.931941, "o", "### /app/blotcli/hull.mk\r\n"]
[21.933203, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -I. -I/app/tapdesk -I/app/recipath\r\nSRC := $(wildcard *.c) $(wildcard /app/tapdesk/*.c) $(wildcard /app/recipath/*.c)\r\nBIN := /app/bin/pinweld\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/mintbay\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[21.933506, "o", "### /app/blotcli/hull_cli.c\r\n"]
[21.93477, "o", "#include \"walk.h\"\r\n#include \"poke.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"usage: pinweld census|poke NAME\\n\");\r\n        return 2;\r\n    }\r\n    if (strcmp(argv[1], \"census\") == 0) {\r\n        op_fill();\r\n        return 0;\r\n    }\r\n    if (strcmp(argv[1], \"poke\") == 0 && argc >= 3) {\r\n        return fire_name(argv[2]);\r\n    }\r\n    fprintf(stderr, \"usage: pinweld census|poke NAME\\n\");\r\n    return 2;\r\n}\r\n"]
[21.935091, "o", "### /app/blotcli/token.c\r\n"]
[21.936244, "o", "#include \"token.h\"\r\n#include <string.h>\r\n#include <stdlib.h>\r\n\r\nint pull_marks(const char *text, char names[][64], int max) {\r\n    int n = 0;\r\n    const char *p = text;\r\n    while (p && *p && n < max) {\r\n        const char *hit = strstr(p, \"weld_mark_\");\r\n        if (!hit) break;\r\n        hit += 10;\r\n"]
[21.936407, "o", "        int len = 0;\r\n        while ((hit[len] >= 'a' && hit[len] <= 'z') ||\r\n               (hit[len] >= 'A' && hit[len] <= 'Z') ||\r\n               (hit[len] >= '0' && hit[len] <= '9') ||\r\n               hit[len] == '_') {\r\n            len++;\r\n        }\r\n        if (len > 0 && len < 63) {\r\n            memcpy(names[n], hit, (size_t)len);\r\n            names[n][len] = 0;\r\n            n++;\r\n        }\r\n        p = hit + (len ? len : 1);\r\n    }\r\n    return n;\r\n}\r\n\r\nstatic int cmpstr(const void *a, const void *b) {\r\n    return strcmp((const char *)a, (const char *)b);\r\n}\r\n\r\nvoid sort_unique(char names[][64], int *n) {\r\n    if (*n <= 0) return;\r\n    qsort(names, (size_t)*n, 64, cmpstr);\r\n    int w = 1;\r\n    for (int i = 1; i < *n; i++) {\r\n        if (strcmp(names[i], names[w - 1]) != 0) {\r\n            memcpy(names[w], names[i], 64);\r\n            w++;\r\n        }\r\n    }\r\n    *n = w;"]
[21.936432, "o", "\r\n}\r\n"]
[21.936564, "o", "### /app/blotcli/token.h\r\n"]
[21.937775, "o", "int pull_marks(const char *text, char names[][64], int max);\r\nvoid sort_unique(char names[][64], int *n);\r\n"]
[21.938083, "o", "### /app/blotcli/walk.c\r\n"]
[21.939552, "o", "#include \"walk.h\"\r\n#include \"load.h\"\r\n#include \"token.h\"\r\n#include \"gap.h\"\r\n#include \"hoist.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\n"]
[21.939781, "o", "static void slurp_cmd(const char *cmd, char *buf, size_t cap) {\r\n    buf[0] = 0;\r\n    FILE *fp = popen(cmd, \"r\");\r\n    if (!fp) return;\r\n    size_t used = 0;\r\n    while (used + 1 < cap) {\r\n        size_t got = fread(buf + used, 1, cap - 1 - used, fp);\r\n        if (!got) break;\r\n        used += got;\r\n    }\r\n    buf[used] = 0;\r\n    pclose(fp);\r\n}\r\n\r\nvoid op_fill(void) {\r\n    mkdir(\"/app/mintbay\", 0755);\r\n    char flags[8][512];\r\n    (void)cfg_open(flags, 8);\r\n    /* default core recipe only */\r\n    const char *use = \"-P -DCORE=1\";\r\n\r\n    FILE *log = fopen(\"/app/mintbay/scan.log\", \"w\");\r\n    char names[64][64];\r\n    int n = 0;\r\n\r\n    DIR *d = opendir(\"/app/ribunit\");\r\n    if (d) {\r\n        struct dirent *ent;\r\n        while ((ent = readdir(d)) != NULL) {\r\n            size_t L = strlen(ent->d_name);\r\n            if (L < 3 || strcmp(ent->d_name + L - 2, \".c\") != 0) continue;\r\n            char src[512];\r\n            snprintf(src, sizeof src, \"/app/ribunit/%s\", ent->d_name);\r\n            if (log) fprintf(log, \"seen %s\\n\", src);\r\n            char cmd[768];\r\n            snprintf(cmd, sizeof cmd, \"gcc -E %s -I/app/ribunit %s 2>/dev/null\", use, src);\r\n            char text[65536];\r\n            slurp_cmd(cmd, text, sizeof text);\r\n            char tmp[32][64];\r\n            int k = pull_marks(text, tmp, 32);\r\n            for (int i = 0; i < k && n < 64; i++) {\r\n                memcpy(names[n], tmp[i], 64);\r\n                n++;\r\n            }\r\n        }\r\n        closedir(d);\r\n    }\r\n    if (log) fclose(log);\r\n    sort_unique(names, &n);\r\n\r\n    FILE *reg = fopen(\"/app/mintbay/points.reg\", \"w\");\r\n    FILE *lst = fopen(\"/app/mintbay/runtime.lst\", \"w\");\r\n    for (int i = 0; i < n; i++) {\r\n        if (reg) fprintf(reg, \"%s\\n\", names[i]);\r\n        if (lst) fprintf(lst, \"%s\\n\", names[i]);\r\n    }\r\n    if (reg) fclose(reg);\r\n    if (lst) fclose(lst);\r\n    copy_sidecar();\r\n    int rc = n_miss(\"/app/mintbay/points.reg\", names, n);\r\n    if (rc != 0) exit(rc);\r\n}\r\n"]
[21.940059, "o", "### /app/blotcli/walk.h\r\n"]
[21.941158, "o", "void op_fill(void);\r\n"]
[21.941463, "o", "--- TAPDESK ---\r\n"]
[21.941581, "o", "### /app/tapdesk/gap.c\r\n"]
[21.942748, "o", "#include \"gap.h\"\r\n#include \"token.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nint n_miss(const char *reg_path, char names[][64], int n) {\r\n    /* keep marks that survive the core recipe; drop the rest */\r\n    const char *units[] = {\r\n"]
[21.942807, "o", "        \"/app/ribunit/core.c\",\r\n        \"/app/ribunit/salvage.c\",\r\n        \"/app/ribunit/night.c\",\r\n        \"/app/ribunit/lab.c\",\r\n        NULL,\r\n    };\r\n    char keep[32][64];\r\n    int nk = 0;\r\n    for (int u = 0; units[u]; u++) {\r\n        char cmd[768];\r\n        snprintf(cmd, sizeof cmd, \"gcc -E -P -DCORE=1 -I/app/ribunit %s 2>/dev/null\", units[u]);\r\n        FILE *fp = popen(cmd, \"r\");"]
[21.942939, "o", "\r\n        if (!fp) continue;\r\n        char text[32768];\r\n        size_t used = 0;\r\n        while (used + 1 < sizeof text) {\r\n            size_t got = fread(text + used, 1, sizeof text - 1 - used, fp);\r\n            if (!got) break;\r\n            used += got;\r\n        }\r\n        text[used] = 0;\r\n        pclose(fp);\r\n        char tmp[16][64];\r\n        int k = pull_marks(text, tmp, 16);\r\n        for (int i = 0; i < k && nk < 32; i++) {"]
[21.943034, "o", "\r\n            memcpy(keep[nk], tmp[i], 64);\r\n            nk++;\r\n        }\r\n    }\r\n    sort_unique(keep, &nk);\r\n\r\n    FILE *reg = fopen(reg_path, \"w\");\r\n    FILE *lst = fopen(\"/app/mintbay/runtime.lst\", \"w\");\r\n    int written = 0;\r\n    for (int i = 0; i < n; i++) {\r\n        int ok = 0;\r\n        for (int j = 0; j < nk; j++) {\r\n            if (strcmp(names[i], keep[j]) == 0) ok = 1;\r\n        }\r\n        if (!ok) continue;\r\n        if (reg) fprintf(reg, \"%s\\n\", names[i]);\r\n        if (lst) fprintf(lst, \"%s\\n\", names[i]);\r\n        written++;\r\n    }\r\n    if (reg) fclose(reg);\r\n    if (lst) fclose(lst);\r\n    (void)written;\r\n    return 0;\r\n}\r\n"]
[21.943207, "o", "### /app/tapdesk/gap.h\r\n"]
[21.944341, "o", "int n_miss(const char *reg_path, char names[][64], int n);\r\n"]
[21.944563, "o", "### /app/tapdesk/poke.c\r\n"]
[21.945713, "o", "#include \"poke.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint fire_name(const char *name) {\r\n    FILE *fp = fopen(\"/app/mintbay/runtime.lst\", \"r\");\r\n    if (!fp) return 1;\r\n    char line[128];\r\n    int hit = 0;\r\n    while (fgets(line, sizeof line, fp)) {\r\n        size_t n = strlen(line);\r\n        while (n && (line[n - 1] == '\\n' || line[n - 1] == '\\r')) line[--n] = 0;\r\n"]
[21.94582, "o", "        if (strcmp(line, name) == 0) hit = 1;\r\n    }\r\n    fclose(fp);\r\n    if (!hit) return 1;\r\n    printf(\"fired:%s\\n\", name);\r\n    return 0;\r\n}\r\n"]
[21.945988, "o", "### /app/tapdesk/poke.h\r\n"]
[21.947098, "o", "int fire_name(const char *name);\r\n"]
