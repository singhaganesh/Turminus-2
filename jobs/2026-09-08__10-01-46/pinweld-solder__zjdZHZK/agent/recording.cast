[10.353007, "i", "printf '%s\\n' '--- BAYMAP ---'; cat /app/inkdocs/BAYMAP.txt; printf '%s\\n' '--- FORMS ---'; cat /app/inkdocs/forms.txt; printf '%s\\n' '--- RECIPES ---'; find /app/recipath -type f -maxdepth 2 -print -exec sed -n '1,240p' {} \\;; printf '%s\\n' '--- SOURCE TREE ---'; find /app -maxdepth 3 -type f -not -path '/app/recipath/*' -not -path '/app/ribunit/*' -printf '%p\\n' | sort; printf '%s\\n' '--- CURRENT MINT ---'; for f in /app/mintbay/points.reg /app/mintbay/runtime.lst /app/mintbay/scan.log; do echo \"### $f\"; cat \"$f\" 2>/dev/null || true; done; printf '%s\\n' '--- BINARY ---'; file /app/bin/pinweld; xxd -l 16 /app/bin/pinweld\n"]
