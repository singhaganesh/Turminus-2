[67.57041, "o", "\u001b[01m\u001b[K/app/recipath/load.c:38:52:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K‘\u001b[01m\u001b[K%s\u001b[m\u001b[K’ directive output may be truncated writing up to 16383 bytes into a region of size 498 [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wformat-truncation=\u0007-Wformat-truncation=\u001b]8;;\u0007\u001b[m\u001b[K]\r\n   38 |         snprintf(path, sizeof path, \"/app/recipath/\u001b[01;35m\u001b[K%s\u001b[m\u001b[K\", files[i]);\r\n      |                                                    \u001b[01;35m\u001b[K^~\u001b[m\u001b[K\r\n\u001b[01m\u001b[K/app/recipath/load.c:38:9:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K‘\u001b[01m\u001b[Ksnprintf\u001b[m\u001b[K’ output between 15 and 16398 bytes into a destination of size 512\r\n   38 |         \u001b[01;36m\u001b[Ksnprintf(path, sizeof path, \"/app/recipath/%s\", files[i])\u001b[m\u001b[K;\r\n      |         \u001b[01;36m\u001b[K^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[m\u001b[K\r\n"]
