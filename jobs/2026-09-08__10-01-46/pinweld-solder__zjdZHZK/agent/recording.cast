[22.939223, "i", "printf '%s\\n' '--- SYMBOLS/STRINGS ---'; nm -C /app/bin/pinweld 2>/dev/null | grep -E ' cfg_open| census| poke|walk|hoist|token|gap' || true; strings /app/bin/pinweld | grep -E '/app/|points|runtime|scan|fired' | head -100\n"]
[22.939996, "o", "printf '%s\\n' '--- SYMBOLS/STRINGS ---'; nm -C /app/bin/pinweld 2>/dev/null | grep -E ' cfg_open| census| poke|walk|hoist|token|gap' || true; strings /app/bin/pinweld | grep -E '/app/|points|runtime|scan|fired' | head -100\r\n\u001b[?2004l\r"]
[22.940128, "o", "--- SYMBOLS/STRINGS ---\r\n"]
[22.951809, "o", "0000000000401b90 T cfg_open\r\n"]
[22.956669, "o", "/app/mintbay/hoist.note\r\n/app/mintbay\r\n/app/mintbay/scan.log\r\n/app/ribunit\r\n/app/ribunit/%s\r\n/app/mintbay/points.reg\r\n/app/mintbay/runtime.lst\r\ngcc -E %s -I/app/ribunit %s 2>/dev/null\r\n/app/ribunit/core.c\r\n/app/ribunit/salvage.c\r\n/app/ribunit/night.c\r\n/app/ribunit/lab.c\r\ngcc -E -P -DCORE=1 -I/app/ribunit %s 2>/dev/null\r\nfired:%s\r\n/app/recipath\r\n/app/recipath/%s\r\n"]
[22.956994, "o", "\u001b[?2004hroot@9292d841caac:/app# "]
[67.081685, "i", "cat > /app/recipath/load.c <<'EOF'\n#include \"load.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n\nint cfg_open(char out[][512], int max) {\n    DIR *d = opendir(\"/app/recipath\");\n    if (!d) return -1;\n    char files[64][256];\n    int nf = 0;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len <= 6 || strcmp(ent->d_name + len - 6, \".flags\") != 0)\n            continue;\n        if (nf >= (int)(sizeof files / sizeof files[0])) {\n            closedir(d);\n            return -1;\n        }\n        snprintf(files[nf++], sizeof files[0], \"%s\", ent->d_name);\n    }\n    closedir(d);\n\n    for (int i = 0; i < nf; i++) {\n        for (int j = i + 1; j < nf; j++) {\n            if (strcmp(files[j], files[i]) < 0) {\n                char tmp[256];\n                memcpy(tmp, files[i], sizeof tmp);\n                memcpy(files[i], files[j], sizeof tmp);\n                memcpy(files[j], tmp, sizeof tmp);\n            }\n        }\n    }\n    if (nf > max) return -1;\n\n    for (int i = 0; i < nf; i++) {\n        char path[512];\n        snprintf(path, sizeof path, \"/app/recipath/%s\", files[i]);\n        FILE *fp = fopen(path, \"r\");\n        if (!fp) return -1;\n        size_t used = fread(out[i], 1, 511, fp);\n        if (ferror(fp) || (!feof(fp) && used == 511)) {\n            fclose(fp);\n            return -1;\n        }\n        fclose(fp);\n        out[i][used] = 0;\n        while (used && (out[i][used - 1] == '\\n' || out[i][used - 1] == '\\r'))\n            out[i][--used] = 0;\n    }\n    return nf;\n}\nEOF\ncat > /app/blotcli/walk.h <<'EOF'\nint op_fill(void);\nEOF\ncat > /app/blotcli/hull_cli.c <<'EOF'\n#include \"walk.h\"\n#include \"poke.h\"\n#include <stdio.h>\n#include <string.h>\n\nint main(int argc, char **argv) {\n    if (argc < 2) {\n        fprintf(stderr, \"usage: pinweld census|poke NAME\\n\");\n        return 2;\n    }\n    if (strcmp(argv[1], \"census\") == 0)\n        return op_fill();\n    if (strcmp(argv[1], \"poke\") == 0 && argc >= 3)\n        return fire_name(argv[2]);\n    fprintf(stderr, \"usage: pinweld census|poke NAME\\n\");\n    return 2;\n}\nEOF\ncat > /app/tapdesk/gap.c <<'EOF'\n#include \"gap.h\"\n#include <stdio.h>\n#include <string.h>\n\nint n_miss(const char *reg_path, char names[][64], int n) {\n    FILE *fp = fopen(reg_path, \"r\");\n    if (!fp) return 1;\n    char line[128];\n    int i = 0;\n    while (fgets(line, sizeof line, fp)) {\n        size_t len = strlen(line);\n        if (len == sizeof line - 1 && line[len - 1] != '\\n') {\n            fclose(fp);\n            return 1;\n        }\n        while (len && (line[len - 1] == '\\n' || line[len - 1] == '\\r'))\n            line[--len] = 0;\n        if (!len || i >= n || strcmp(line, names[i]) != 0) {\n            fclose(fp);\n            return 1;\n        }\n        i++;\n    }\n    if (ferror(fp)) {\n        fclose(fp);\n        return 1;\n    }\n    fclose(fp);\n    return i == n ? 0 : 1;\n}\nEOF\n"]
