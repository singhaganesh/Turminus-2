[60.947006, "o", "\u001b[?2004hroot@11afe9fa2eab:/app# test \"$unknown_rc\" -ne 0\r\n\u001b[?2004l\r\u001b[?2004hroot@11afe9fa2eab:/app# echo \"final route exit codes validated: known=$known_rc unknown=$unknown_rc\"\r\n\u001b[?2004l\rfinal route exit codes validated: known=0 unknown=1\r\n\u001b[?2004hroot@11afe9fa2eab:/app# "]
[83.752443, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/codemill/tablegen/roster_read.py')\ns = p.read_text()\ns = s.replace('sig = str(row.get(\"id\", \"\")).strip().upper()', 'sig = str(row.get(\"id\", \"\")).strip()')\np.write_text(s)\nPY\ncat > /app/relaydesk/switchboard/direct.py <<'PY'\n\"\"\"Signature to team routing.\"\"\"\nfrom __future__ import annotations\n\nfrom relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\n\n\ndef normalize(sig: str) -> str:\n    return sig.strip()\n\n\ndef direct(sig: str) -> tuple[str, str]:\n    table = fetch_map()\n    key = normalize(sig)\n    if key in table:\n        return table[key], \"table\"\n\n    # Signature IDs are conventionally case-insensitive, while generated keys\n    # preserve the roster's canonical spelling.\n    folded = key.casefold()\n    for roster_id, team in table.items():\n        if roster_id.casefold() == folded:\n            return team, \"table\"\n    return DEFAULT_TEAM, \"default\"\nPY\n/app/bin/crashrail compile\n"]
