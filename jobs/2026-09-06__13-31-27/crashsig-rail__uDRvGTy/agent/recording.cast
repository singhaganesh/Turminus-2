[84.813849, "i", "python3 - <<'PY'\nimport importlib.util\nimport tomllib\nfrom pathlib import Path\nroster = tomllib.loads(Path('/app/faultdata/roster.toml').read_text())['roster']['signatures']\nexpected = {row['id'].strip(): row['owner'].strip() for row in roster}\np = Path('/app/relaydesk/gen/routing_map.py')\nspec = importlib.util.spec_from_file_location('final_map_check', p)\nmodule = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(module)\nassert module.SIGNATURE_OWNERS == expected\nassert all(row['id'] in module.SIGNATURE_OWNERS for row in roster)\nprint(f'literal roster coverage validated: {len(expected)} entries')\nPY\ncat /app/relaydesk/gen/routing_map.py\nset +e\nfor sig in SIG_NULL_DEREF_81c2 SIG_IO_TIMEOUT_4f91 SIG_AUTH_LOOP_22bd SIG_NET_RESET_9e04 SIG_HEAP_OOM_7a3f SIG_UNKNOWN_FFFF; do\n  /app/bin/crashrail route --signature \"$sig\"\n  rc=$?\n  if [ \"$sig\" = SIG_UNKNOWN_FFFF ]; then test \"$rc\" -ne 0; else test \"$rc\" -eq 0; fi\n done\nset -e\n"]
