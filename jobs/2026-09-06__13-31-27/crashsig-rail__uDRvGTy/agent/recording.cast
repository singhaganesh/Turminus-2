[60.228606, "o", "rc=1 signature=SIG_UNKNOWN_FFFF\r\n\u001b[?2004hroot@11afe9fa2eab:/app# set -e\r\n\u001b[?2004l\r\u001b[?2004hroot@11afe9fa2eab:/app# "]
[60.339331, "i", "printf '%s\\n' 'SIGNATURE_OWNERS = {' '    this is not valid Python' > /app/relaydesk/gen/routing_map.py\n/app/bin/crashrail compile\npython3 -m py_compile /app/relaydesk/gen/routing_map.py\npython3 - <<'PY'\nimport tomllib\nfrom pathlib import Path\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nrows = tomllib.loads(Path('/app/faultdata/roster.toml').read_text())['roster']['signatures']\nexpected = {r['id'].strip().upper(): r['owner'].strip() for r in rows}\nassert SIGNATURE_OWNERS == expected\nprint(f'corruption recovery validated: {len(SIGNATURE_OWNERS)} entries')\nPY\nset +e\n/app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; known_rc=$?\n/app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; unknown_rc=$?\nset -e\ntest \"$known_rc\" -eq 0\ntest \"$unknown_rc\" -ne 0\necho \"final route exit codes validated: known=$known_rc unknown=$unknown_rc\"\n"]
[60.340681, "o", "printf '%s\\n' 'SIGNATURE_OWNERS = {' '    this is not valid Python' > /app/relaydesk/gen/routing_map.py"]
