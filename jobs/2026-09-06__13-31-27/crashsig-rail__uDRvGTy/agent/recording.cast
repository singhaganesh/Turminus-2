[20.747127, "o", "\"\"\"Generated routing map. Do not edit.\"\"\"\r\n\r\nOWNERS = {\r\n    \"SIG_NULL_DEREF_81c2\": \"graphics-guild\",\r\n}\r\n"]
[20.747461, "o", "\u001b[?2004hroot@11afe9fa2eab:/app# "]
[58.381539, "i", "cat > /app/codemill/tablegen/publish.py <<'PY'\n\"\"\"Write routing_map.py from roster rows.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport tempfile\nfrom pathlib import Path\n\nfrom codemill.tablegen.guard import should_emit\nfrom codemill.tablegen.roster_read import load_pairs\n\nOUT = Path(\"/app/relaydesk/gen/routing_map.py\")\n\n\ndef build_source(rows: list[tuple[str, str]]) -> str:\n    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"SIGNATURE_OWNERS = {\"]\n    for sig, team in sorted(rows):\n        lines.append(f\"    {sig!r}: {team!r},\")\n    lines.append(\"}\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef emit_map(path: Path | None = None) -> bool:\n    \"\"\"Generate and atomically publish the complete roster table.\"\"\"\n    target = path or OUT\n    target.parent.mkdir(parents=True, exist_ok=True)\n    body = build_source(load_pairs())\n    if not should_emit(target, body):\n        return False\n\n    fd, temporary = tempfile.mkstemp(\n        prefix=f\".{target.name}.\", suffix=\".tmp\", dir=target.parent, text=True\n    )\n    try:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as stream:\n            stream.write(body)\n            stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(temporary, target)\n    except BaseException:\n        try:\n            os.unlink(temporary)\n        except FileNotFoundError:\n            pass\n        raise\n    return True\nPY\ncat > /app/codemill/tablegen/guard.py <<'PY'\n\"\"\"Skip-if-unchanged guard for routing map writes.\"\"\"\nfrom __future__ import annotations\n\nfrom pathlib import Path\n\nfrom codemill.tablegen.ast_read import read_map_literal\n\n\ndef should_emit(path: Path, fresh_body: str) -> bool:\n    \"\"\"Return true unless the existing file already has the complete fresh map.\"\"\"\n    if not path.exists():\n        return True\n    try:\n        on_disk = read_map_literal(path.read_text(encoding=\"utf-8\"))\n    except (OSError, SyntaxError, ValueError, TypeError):\n        return True\n    return on_disk != read_map_literal(fresh_body)\nPY\ncat > /app/relaydesk/switchboard/direct.py <<'PY'\n\"\"\"Signature to team routing.\"\"\"\nfrom __future__ import annotations\n\nfrom relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\n\n\ndef normalize(sig: str) -> str:\n    return sig.strip().upper()\n\n\ndef direct(sig: str) -> tuple[str, str]:\n    table = fetch_map()\n    key = normalize(sig)\n    if key in table:\n        return table[key], \"table\"\n    return DEFAULT_TEAM, \"default\"\nPY\n/app/bin/crashrail compile\n"]
