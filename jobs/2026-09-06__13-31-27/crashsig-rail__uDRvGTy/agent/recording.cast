[59.345513, "i", "echo '--- generated map ---'; cat /app/relaydesk/gen/routing_map.py; echo '--- roster/map validation ---'; python3 - <<'PY'\nimport importlib.util\nimport tomllib\nfrom pathlib import Path\nroster = tomllib.loads(Path('/app/faultdata/roster.toml').read_text())['roster']['signatures']\nexpected = {row['id'].strip().upper(): row['owner'].strip() for row in roster}\np = Path('/app/relaydesk/gen/routing_map.py')\nspec = importlib.util.spec_from_file_location('validation_routing_map', p)\nmodule = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(module)\nassert isinstance(module.SIGNATURE_OWNERS, dict)\nassert module.SIGNATURE_OWNERS == expected, (module.SIGNATURE_OWNERS, expected)\nprint(f'validated {len(expected)} roster signatures')\nPY\nset +e\nfor sig in SIG_NULL_DEREF_81c2 SIG_IO_TIMEOUT_4f91 SIG_AUTH_LOOP_22bd SIG_NET_RESET_9e04 SIG_HEAP_OOM_7a3f SIG_UNKNOWN_FFFF; do /app/bin/crashrail route --signature \"$sig\"; echo \"rc=$? signature=$sig\"; done\nset -e\n"]
[59.346591, "o", "echo '--- generated map ---'; cat /app/relaydesk/gen/routing_map.py; echo '--- roster/map validation ---'; python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import importlib.util\r\n\u001b[?2004l\r\u001b[?2004h> "]
