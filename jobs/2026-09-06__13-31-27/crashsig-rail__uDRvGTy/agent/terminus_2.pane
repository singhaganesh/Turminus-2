     1	"""Write routing_map.py from roster rows."""
     2	
     3	from __future__ import annotations
     4	
     5	from pathlib import Path
     6	
     7	from codemill.tablegen.guard import should_emit
     8	from codemill.tablegen.roster_read import load_pairs
     9	
    10	OUT = Path("/app/relaydesk/gen/routing_map.py")
    11	
    12	
    13	def build_source(rows: list[tuple[str, str]]) -> str:
    14	    lines = ['"""Generated routing map. Do not edit."""', "", "OWNERS = {"]
    15	    for sig, team in sorted(rows):
    16	        lines.append(f'    "{sig}": "{team}",')
    17	    lines.append("}")
    18	    lines.append("")
    19	    return "\n".join(lines)
    20	
    21	
    22	def emit_map(path: Path | None = None) -> bool:
    23	    target = path or OUT
    24	    target.parent.mkdir(parents=True, exist_ok=True)
    25	    body = build_source(load_pairs())
    26	    if not should_emit(target, body):
    27	        return False
    28	    target.write_text(body)
    29	    return True
