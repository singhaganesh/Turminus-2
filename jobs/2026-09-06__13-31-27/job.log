   lines = [\'"""Generated routing map. Do not edit."""\', "", "SIGNATURE_OWNERS = {"]\n    for sig, team in sorted(rows):\n        lines.append(f"    {sig!r}: {team!r},")\n    lines.extend(["}", ""])\n    return "\\n".join(lines)\n\n\ndef emit_map(path: Path | None = None) -> bool:\n    target = path or OUT\n    target.parent.mkdir(parents=True, exist_ok=True)\n    body = build_source(load_pairs())\n    if not should_emit(target, body):\n        return False\n\n    # Publish atomically so readers see either the old complete module or the\n    # new complete module, never a partially written Python file.\n    fd, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)\n    try:\n        with os.fdopen(fd, "w") as stream:\n            stream.write(body)\n            stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(temporary, target)\n    except BaseException:\n        try:\n            os.unlink(temporary)\n        except FileNotFoundError:\n            pass\n        raise\n    return True\nPY\ncat > /app/relaydesk/switchboard/direct.py <<\'PY\'\n"""Signature to team routing."""\n\nfrom __future__ import annotations\n\nfrom relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\n\n\ndef normalize(sig: str) -> str:\n    return sig.strip()\n\n\ndef direct(sig: str) -> tuple[str, str]:\n    table = fetch_map()\n    key = normalize(sig)\n    if key in table:\n        return table[key], "table"\n    return DEFAULT_TEAM, "default"\nPY\npython3 -m py_compile /app/codemill/tablegen/*.py /app/relaydesk/switchboard/*.py /app/relaydesk/cli_entry.py\n/app/bin/crashrail compile\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
