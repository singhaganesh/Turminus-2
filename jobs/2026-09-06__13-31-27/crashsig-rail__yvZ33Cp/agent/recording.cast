[17.895024, "i", "python3 - <<'PY'\nimport codemill.tablegen.driver as d\nfrom pathlib import Path\np=Path(d.__file__)\nfor f in sorted(p.parent.rglob('*')):\n    if f.is_file() and f.suffix in {'.py','.toml','.json','.txt'}:\n        print(f'### {f}')\n        print(f.read_text())\nPY\n"]
[17.895288, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[17.895863, "o", "\u001b[?2004h> import codemill.tablegen.driver as d\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p=Path(d.__file__)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.895992, "o", "for f in sorted(p.parent.rglob('*')):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.896213, "o", "    if f.is_file() and f.suffix in {'.py','.toml','.json','.txt'}:\r\n\u001b[?2004l\r"]
[17.896463, "o", "\u001b[?2004h>         print(f'### {f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
