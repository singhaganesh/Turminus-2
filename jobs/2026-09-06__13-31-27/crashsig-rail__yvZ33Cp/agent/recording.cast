[17.542812, "o", "/app/codemill/__init__.py\r\n/app/codemill/__pycache__/__init__.cpython-313.pyc\r\n/app/codemill/tablegen/__init__.py\r\n/app/codemill/tablegen/__pycache__/__init__.cpython-313.pyc\r\n/app/codemill/tablegen/__pycache__/ast_read.cpython-313.pyc\r\n/app/codemill/tablegen/__pycache__/driver.cpython-313.pyc\r\n/app/codemill/tablegen/__pycache__/guard.cpython-313.pyc\r\n/app/codemill/tablegen/__pycache__/publish.cpython-313.pyc\r\n/app/codemill/tablegen/__pycache__/roster_read.cpython-313.pyc\r\n/app/codemill/tablegen/ast_read.py\r\n/app/codemill/tablegen/driver.py\r\n/app/codemill/tablegen/guard.py\r\n/app/codemill/tablegen/publish.py\r\n/app/codemill/tablegen/roster_read.py\r\n"]
