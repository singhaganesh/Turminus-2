[41.427424, "o", "\"\"\"Read fault roster TOML.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.42755, "o", "from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.427641, "o", "> \r\n\u001b[?2004l\r"]
[41.427721, "o", "\u001b[?2004h> import tomllib\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.42791, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.428003, "o", "ROSTER = Path(\"/app/faultdata/roster.toml\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[41.428023, "o", "\u001b[?2004h> "]
[41.428039, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.428053, "o", "> "]
[41.428267, "o", "def load_pairs(path: Path | None = None) -> list[tuple[str, str]]:\r\n\u001b[?2004l\r\u001b[?2004h>     src = path or ROSTER\r\n"]
[41.428303, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[41.428395, "o", "    doc = tomllib.loads(src.read_text())\r\n\u001b[?2004l\r"]
[41.428418, "o", "\u001b[?2004h> "]
[41.428516, "o", "    pairs: list[tuple[str, str]] = []\r\n\u001b[?2004l\r"]
[41.428606, "o", "\u001b[?2004h> "]
[41.428633, "o", "    seen: set[str] = set()\r\n\u001b[?2004l\r"]
[41.428649, "o", "\u001b[?2004h> "]
[41.428801, "o", "    for row in doc.get(\"roster\", {}).get(\"signatures\", []):\r\n\u001b[?2004l\r"]
[41.428874, "o", "\u001b[?2004h> "]
[41.428966, "o", "        sig = str(row.get(\"id\", \"\")).strip()\r\n\u001b[?2004l\r"]
[41.429031, "o", "\u001b[?2004h> "]
[41.42912, "o", "        team = str(row.get(\"owner\", \"\")).strip()\r\n\u001b[?2004l\r"]
[41.429193, "o", "\u001b[?2004h> "]
[41.429256, "o", "        if not sig or not team:\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.429315, "o", "> "]
[41.429385, "o", "            continue\r\n\u001b[?2004l\r"]
[41.429441, "o", "\u001b[?2004h> "]
[41.429504, "o", "        if sig in seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.429647, "o", "            raise ValueError(f\"duplicate signature id: {sig}\")\r\n\u001b[?2004l\r"]
[41.429709, "o", "\u001b[?2004h> "]
[41.429779, "o", "        seen.add(sig)\r\n\u001b[?2004l\r"]
[41.429864, "o", "\u001b[?2004h>         pairs.append((sig, team))\r\n"]
[41.429939, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[41.429961, "o", "    if not pairs:\r\n\u001b[?2004l\r"]
[41.429976, "o", "\u001b[?2004h> "]
[41.430105, "o", "        raise ValueError(\"empty roster\")\r\n\u001b[?2004l\r"]
[41.430167, "o", "\u001b[?2004h> "]
[41.430239, "o", "    return pairs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.430298, "o", "PY\r\n\u001b[?2004l\r"]
[41.431529, "o", "\u001b[?2004hroot@12ed7161f3a8:/app# "]
[41.431663, "o", "cat > /app/codemill/tablegen/publish.py <<'PY'\r\n\u001b[?2004l\r"]
[41.431697, "o", "\u001b[?2004h> "]
[41.431895, "o", "\"\"\"Write routing_map.py from roster rows.\"\"\"\r\n\u001b[?2004l\r"]
[41.431992, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.432081, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[41.432182, "o", "\u001b[?2004h"]
[41.433148, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from codemill.tablegen.guard import should_emit\r\n\u001b[?2004l\r\u001b[?2004h> from codemill.tablegen.roster_read import load_pairs\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> OUT = Path(\"/app/relaydesk/gen/routing_map.py\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def build_source(rows: list[tuple[str, str]]) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.433326, "o", "    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"SIGNATURE_OWNERS = {\"]\r\n\u001b[?2004l\r"]
[41.433413, "o", "\u001b[?2004h> "]
[41.433503, "o", "    for sig, team in sorted(rows):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.433642, "o", "        lines.append(f\"    {sig!r}: {team!r},\")\r\n\u001b[?2004l\r"]
[41.433711, "o", "\u001b[?2004h> "]
[41.433788, "o", "    lines.extend([\"}\", \"\"])\r\n\u001b[?2004l\r"]
[41.4346, "o", "\u001b[?2004h>     return \"\\n\".join(lines)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def emit_map(path: Path | None = None) -> bool:\r\n\u001b[?2004l\r\u001b[?2004h>     target = path or OUT\r\n\u001b[?2004l\r\u001b[?2004h>     target.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.434709, "o", "    body = build_source(load_pairs())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.434847, "o", "    if not should_emit(target, body):\r\n\u001b[?2004l\r"]
[41.434867, "o", "\u001b[?2004h"]
[41.434884, "o", "> "]
[41.435039, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.435283, "o", "    # Publish atomically so readers see either the old complete module or the\r\n\u001b[?2004l\r"]
[41.43535, "o", "\u001b[?2004h> "]
[41.435548, "o", "    # new complete module, never a partially written Python file.\r\n\u001b[?2004l\r"]
[41.435612, "o", "\u001b[?2004h> "]
[41.435899, "o", "    fd, temporary = tempfile.mkstemp(prefix=f\".{target.name}.\", dir=target.parent)\r\n\u001b[?2004l\r"]
[41.436019, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.436168, "o", "        with os.fdopen(fd, \"w\") as stream:\r\n\u001b[?2004l\r"]
[41.436235, "o", "\u001b[?2004h> "]
[41.43632, "o", "            stream.write(body)\r\n\u001b[?2004l\r"]
[41.43635, "o", "\u001b[?2004h"]
[41.436368, "o", "> "]
[41.43648, "o", "            stream.flush()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.436555, "o", "            os.fsync(stream.fileno())\r\n\u001b[?2004l\r"]
[41.436634, "o", "\u001b[?2004h> "]
[41.436705, "o", "        os.replace(temporary, target)\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.436795, "o", "> "]
[41.436831, "o", "    except BaseException:\r\n\u001b[?2004l\r"]
[41.436848, "o", "\u001b[?2004h> "]
[41.436975, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.437068, "o", "            os.unlink(temporary)\r\n\u001b[?2004l\r"]
[41.437139, "o", "\u001b[?2004h> "]
[41.437193, "o", "        except FileNotFoundError:\r\n\u001b[?2004l\r"]
[41.437265, "o", "\u001b[?2004h"]
[41.437342, "o", ">             pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.437405, "o", "        raise\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.437465, "o", "    return True\r\n\u001b[?2004l\r"]
[41.437537, "o", "\u001b[?2004h> "]
[41.437621, "o", "PY\r\n\u001b[?2004l\r"]
[41.438828, "o", "\u001b[?2004hroot@12ed7161f3a8:/app# "]
[41.438958, "o", "cat > /app/relaydesk/switchboard/direct.py <<'PY'\r\n\u001b[?2004l\r"]
[41.439024, "o", "\u001b[?2004h> "]
[41.439126, "o", "\"\"\"Signature to team routing.\"\"\"\r\n\u001b[?2004l\r"]
[41.439194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[41.439218, "o", "\u001b[?2004h> "]
[41.439338, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[41.43942, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.439637, "o", "from relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\r\n\u001b[?2004l\r"]
[41.439703, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[41.439729, "o", "> \r\n\u001b[?2004l\r"]
[41.439745, "o", "\u001b[?2004h"]
[41.439758, "o", "> "]
[41.439883, "o", "def normalize(sig: str) -> str:\r\n\u001b[?2004l\r"]
[41.439905, "o", "\u001b[?2004h"]
[41.439918, "o", "> "]
[41.440008, "o", "    return sig.strip()\r\n\u001b[?2004l\r"]
[41.440081, "o", "\u001b[?2004h"]
[41.440139, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.440268, "o", "def direct(sig: str) -> tuple[str, str]:\r\n\u001b[?2004l\r"]
[41.440324, "o", "\u001b[?2004h> "]
[41.440398, "o", "    table = fetch_map()\r\n\u001b[?2004l\r"]
[41.440461, "o", "\u001b[?2004h> "]
[41.440538, "o", "    key = normalize(sig)\r\n\u001b[?2004l\r"]
[41.44061, "o", "\u001b[?2004h> "]
[41.44069, "o", "    if key in table:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.440776, "o", "        return table[key], \"table\"\r\n\u001b[?2004l\r"]
[41.440855, "o", "\u001b[?2004h> "]
[41.440919, "o", "    return DEFAULT_TEAM, \"default\"\r\n\u001b[?2004l\r"]
[41.441004, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[41.442369, "o", "\u001b[?2004hroot@12ed7161f3a8:/app# "]
[41.442632, "o", "python3 -m py_compile /app/codemill/tablegen/*.py /app/relaydesk/switchboard/*.py /app/relaydesk/cli_entry.py\r\n\u001b[?2004l\r"]
[41.499161, "o", "\u001b[?2004hroot@12ed7161f3a8:/app# "]
[41.499385, "o", "/app/bin/crashrail compile\r\n\u001b[?2004l\r"]
[41.565889, "o", "tablegen done\r\n"]
[41.579061, "o", "\u001b[?2004hroot@12ed7161f3a8:/app# "]
[42.366206, "i", "printf '%s\\n' '--- generated ---'; cat /app/relaydesk/gen/routing_map.py\npython3 - <<'PY'\nimport tomllib\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nwith open('/app/faultdata/roster.toml', 'rb') as f:\n    rows = tomllib.load(f)['roster']['signatures']\nexpected = {row['id']: row['owner'] for row in rows}\nassert SIGNATURE_OWNERS == expected, (SIGNATURE_OWNERS, expected)\nprint(f'verified {len(expected)} roster entries')\nPY\n/app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; echo known_rc=$?\n/app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; echo unknown_rc=$?\n"]
[42.367041, "o", "printf '%s\\n' '--- generated ---'; cat /app/relaydesk/gen/routing_map.py\r\n\u001b[?2004l\r--- generated ---\r\n"]
