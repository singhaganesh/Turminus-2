[7.256988, "o", "-rwxr-xr-x 1 root root 112 Sep  6 06:52 /app/bin/crashrail\r\n"]
[7.257219, "o", "\r\n--- roster ---\r\n"]
[7.260163, "o", "[roster]\r\ndefault_team = \"platform-core\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_NULL_DEREF_81c2\"\r\nowner = \"graphics-guild\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_IO_TIMEOUT_4f91\"\r\nowner = \"storage-cell\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_AUTH_LOOP_22bd\"\r\nowner = \"identity-ring\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_NET_RESET_9e04\"\r\nowner = \"network-desk\"\r\n\r\n[[roster.signatures]]\r\nid = \"SIG_HEAP_OOM_7a3f\"\r\nowner = \"memory-squad\"\r\n\u001b[?2004hroot@12ed7161f3a8:/app# "]
[7.444663, "i", "printf '\\n--- crashrail launcher ---\\n'; sed -n '1,240p' /app/bin/crashrail; printf '\\n--- python sources ---\\n'; find /app/relaydesk -maxdepth 2 -type f -name '*.py' -not -path '*/probes/*' -exec sh -c 'echo \"### $1\"; sed -n \"1,260p\" \"$1\"' _ {} \\;\n"]
