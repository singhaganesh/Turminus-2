[8.057376, "o", "{\"team\": \"platform-core\", \"source\": \"default\"}\r\n"]
[8.066668, "o", "route_rc=1\r\n"]
[8.116186, "o", "{\"team\": \"platform-core\", \"source\": \"default\"}\r\n"]
[8.126331, "o", "unknown_rc=1\r\n"]
