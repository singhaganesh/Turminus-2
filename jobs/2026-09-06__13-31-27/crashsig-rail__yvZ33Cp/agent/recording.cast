[43.301683, "i", "printf 'this is not valid python = {\\n' > /app/relaydesk/gen/routing_map.py\n/app/bin/crashrail compile; echo recovery_compile_rc=$?\npython3 -m py_compile /app/relaydesk/gen/routing_map.py\npython3 - <<'PY'\nimport tomllib\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nwith open('/app/faultdata/roster.toml', 'rb') as f:\n    rows = tomllib.load(f)['roster']['signatures']\nassert all(SIGNATURE_OWNERS.get(r['id']) == r['owner'] for r in rows)\nassert len(SIGNATURE_OWNERS) == len(rows)\nprint('corruption recovery and completeness verified')\nPY\n/app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; echo final_route_rc=$?\n"]
