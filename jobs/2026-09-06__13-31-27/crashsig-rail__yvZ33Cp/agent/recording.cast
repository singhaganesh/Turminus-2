[7.447306, "o", "#!/bin/bash\r\nset -euo pipefail\r\nexport PYTHONPATH=\"/app:${PYTHONPATH:-}\"\r\nexec python3 -m relaydesk.cli_entry \"$@\"\r\n"]
[7.447908, "o", "\r\n--- python sources ---\r\n"]
[7.450257, "o", "### /app/relaydesk/switchboard/direct.py\r\n"]
[7.451227, "o", "\"\"\"Signature to team routing.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\r\n\r\n\r\ndef normalize(sig: str) -> str:\r\n    text = sig.strip().upper()\r\n    return text[4:]\r\n\r\n\r\ndef direct(sig: str) -> tuple[str, str]:\r\n    table = fetch_map()\r\n    key = normalize(sig)\r\n    if key in table:\r\n        return table[key], \"table\"\r\n    return DEFAULT_TEAM, \"default\"\r\n"]
[7.4523, "o", "### /app/relaydesk/switchboard/__init__.py\r\n"]
[7.453305, "o", "\"\"\"Switchboard routing.\"\"\"\r\n"]
[7.454302, "o", "### /app/relaydesk/switchboard/load_map.py\r\n"]
[7.455353, "o", "\"\"\"Load generated routing maps.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom typing import Dict\r\n\r\nDEFAULT_TEAM = \"platform-core\"\r\n\r\n\r\ndef fetch_map() -> Dict[str, str]:\r\n    try:\r\n        from relaydesk.gen.routing_map import SIGNATURE_OWNERS\r\n    except Exception:\r\n        return {}\r\n    if not isinstance(SIGNATURE_OWNERS, dict):\r\n        return {}\r\n    return {str(k): str(v) for k, v in SIGNATURE_OWNERS.items()}\r\n"]
[7.456476, "o", "### /app/relaydesk/gen/__init__.py\r\n"]
[7.457531, "o", "\"\"\"Generated routing map package.\"\"\"\r\n"]
[7.458446, "o", "### /app/relaydesk/gen/routing_map.py\r\n"]
[7.459416, "o", "\"\"\"Generated routing map. Do not edit.\"\"\"\r\n\r\nOWNERS = {\r\n    \"SIG_NULL_DEREF_81c2\": \"graphics-guild\",\r\n}\r\n"]
[7.460413, "o", "### /app/relaydesk/__init__.py\r\n"]
[7.461376, "o", "\"\"\"Relay desk crash routing.\"\"\"\r\n"]
[7.46235, "o", "### /app/relaydesk/cli_entry.py\r\n"]
[7.463328, "o", "\"\"\"Crashrail command-line front door.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport json\r\n\r\nfrom codemill.tablegen.driver import run_tablegen\r\nfrom relaydesk.switchboard.direct import direct\r\n\r\n\r\n"]
[7.463432, "o", "def main(argv: list[str] | None = None) -> int:\r\n    parser = argparse.ArgumentParser(prog=\"crashrail\")\r\n    sub = parser.add_subparsers(dest=\"cmd\", required=True)\r\n\r\n    route = sub.add_parser(\"route\")\r\n    route.add_argument(\"--signature\", required=True)\r\n\r\n    sub.add_parser(\"compile\")\r\n\r\n    args = parser.parse_args(argv)\r\n    if args.cmd == \"compile\":\r\n        return run_tablegen()\r\n    if args.cmd == \"route\":\r\n        team, source = direct(args.signature)\r\n        print(json.dumps({\"team\": team, \"source\": source}))\r\n        return 1 if source == \"default\" else 0\r\n    return 2\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[7.464038, "o", "\u001b[?2004hroot@12ed7161f3a8:/app# "]
[7.911289, "i", "/app/bin/crashrail compile; echo compile_rc=$?; /app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; echo route_rc=$?; /app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; echo unknown_rc=$?\n"]
[7.912464, "o", "/app/bin/crashrail compile; echo compile_rc=$?; /app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; echo route_rc=$?; /app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; echo unknown_rc=$?\r\n\u001b[?2004l\r"]
