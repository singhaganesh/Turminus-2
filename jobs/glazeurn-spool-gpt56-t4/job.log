Sending keys: ['cat > /app/foldrib/rim.rs <<\'EOF\'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, _b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\n        cells: Vec::new(),\n    }\n}\nEOF\ncat > /app/internpit/pool.rs <<\'EOF\'\nuse crate::fold;\nuse crate::hold;\nuse crate::load;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\n    a.cells = b.cells.clone();\n}\n\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut f = fold::rim_a(a, b);\n    rim_b(&mut f, b);\n    f\n}\n\nfn quote(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in s.chars() {\n        match c {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if c < \' \' => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn pack(ids: &[usize], cells: &[String]) -> String {\n    let parts: Vec<String> = ids.iter().filter_map(|&i| cells.get(i)).map(|s| quote(s)).collect();\n    format!("[{}]", parts.join(","))\n}\n\npub fn dump() -> i32 {\n    let dest = Path::new("/app/inkpit/pair.json");\n    let Some((mut sess, mut pool, plan)) = load::read_path("/app/spoolbay/shift.spool") else {\n        let _ = fs::remove_file(dest);\n        return 1;\n    };\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n    let frost_ids = frost.ids.borrow().clone();\n    let live_ids = sess.ids.borrow().clone();\n    let frost_s = pack(&frost_ids, &frost.cells);\n    let live_s = pack(&live_ids, &pool.cells);\n    if sess.flag && frost_s == live_s {\n        let _ = fs::remove_file(dest);\n        return 1;\n    }\n    let body = format!(\n        "{{\\"tick\\":{},\\"mark\\":{},\\"frost_bag\\":{},\\"live_bag\\":{}}}\\n",\n        sess.n0.saturating_add(tally::lines()), sess.n1, frost_s, live_s\n    );\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    match fs::write(dest, body) { Ok(()) => 0, Err(_) => 2 }\n}\nEOF\ncat > /app/restcue/ink.rs <<\'EOF\'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let guard = Path::new("/app/inkpit/GUARD");\n    let _ = fs::remove_file(guard);\n    let code = pool::dump();\n    if code != 0 { return code; }\n    match fs::write(guard, "ok\\n") {\n        Ok(()) => 0,\n        Err(_) => {\n            let _ = fs::remove_file(guard);\n            2\n        }\n    }\n}\nEOF\npython3 - <<\'PY\'\np=\'/app/sessbay/load.rs\'\ns=open(p).read()\ns=s.replace(\'let tick = n0.saturating_add(width);\\n    let mark = n1.saturating_add(if heat { 2 } else { 1 });\', \'let _ = (width, heat);\\n    let tick = n0.saturating_add(1);\\n    let mark = n1.saturating_add(2);\')\nopen(p,\'w\').write(s)\nPY\ncat > /app/coverpit/tally.rs <<\'EOF\'\npub fn lines() -> u32 {\n    let text = std::fs::read_to_string("/app/coverpit/COVER.txt").unwrap_or_default();\n    for line in text.lines() {\n        if line.contains("Desk count") {\n            let words: Vec<&str> = line.split_whitespace().collect();\n            for pair in words.windows(2) {\n                if pair[0] == "count" {\n                    if let Ok(n) = pair[1].parse() { return n; }\n                }\n            }\n        }\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > /app/emitbay/hearth.rs <<\'EOF\'\nuse std::collections::HashSet;\nuse std::fs;\n\nconst RIM: &str = include_str!("../foldrib/rim.rs");\nconst POOL: &str = include_str!("../internpit/pool.rs");\nconst INK: &str = include_str!("../restcue/ink.rs");\nconst HEARTH: &str = include_str!("hearth.rs");\nconst BOOT: &str = include_str!("../steerpit/boot.rs");\n\npub fn rib_d() -> i32 {\n    let entries = match fs::read_dir("/app/daycards") { Ok(v) => v, Err(_) => return 1 };\n    let mut cards = Vec::new();\n    for entry in entries {\n        let Ok(entry) = entry else { return 1 };\n        let path = entry.path();\n        if path.is_file() {\n            let Ok(text) = fs::read_to_string(&path) else { return 1 };\n            cards.push(text);\n        }\n    }\n    if cards.is_empty() { return 1; }\n    let freeze = cards.iter().any(|s| s.lines().any(|l| l.trim() == "emit freeze"));\n    let cells = cards.iter().any(|s| s.lines().any(|l| l.trim() == "emit cells"));\n    if !freeze || !cells { return 1; }\n\n    let tree = match fs::read_to_string("/app/vatslip/TREE.txt") { Ok(v) => v, Err(_) => return 1 };\n    let names: HashSet<&str> = tree.lines().map(str::trim).filter(|s| !s.is_empty()).collect();\n    let pieces = [\n        ("foldrib", "/app/foldrib/rim.rs", RIM),\n        ("internpit", "/app/internpit/pool.rs", POOL),\n        ("restcue", "/app/restcue/ink.rs", INK),\n        ("emitbay", "/app/emitbay/hearth.rs", HEARTH),\n        ("steerpit", "/app/steerpit/boot.rs", BOOT),\n    ];\n    for (name, path, body) in pieces {\n        if names.contains(name) && fs::write(path, body).is_err() { return 2; }\n    }\n    0\n}\nEOF\n/app/bake.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
