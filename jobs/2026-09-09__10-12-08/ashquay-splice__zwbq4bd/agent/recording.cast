[31.161319, "o", "-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/cardurn/deepwell.card\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/cardurn/fastpit.card\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/cardurn/midquay.card\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/dbgwells/deepwell/aabbccdd.dbg\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/dbgwells/deepwell/eeff0011.dbg\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/dbgwells/fastpit/aabbccdd.dbg\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/dbgwells/fastpit/eeff0011.dbg\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/dbgwells/midquay/99887766.dbg\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/dbgwells/midquay/aabbccdd.dbg\r\n-rw-rw-r-- 2026-09-08 18:28:31.0000000000 /app/dumpit/shift.core\r\n"]
[31.16176, "o", "\u001b[?2004hroot@e9f94d65e3e8:/app# "]
[65.64173, "i", "cat > /app/hopbag/op_bag.c <<'EOF'\n#include \"op_bag.h\"\n#include \"readwell.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic void retry_first(char *out, size_t size) {\n  FILE *f;\n  char line[128];\n  out[0] = 0;\n  f = fopen(\"/app/mill.cfg\", \"r\");\n  if (!f) return;\n  while (fgets(line, sizeof(line), f)) {\n    char *nl = strchr(line, '\\n');\n    if (nl) *nl = 0;\n    if (strncmp(line, \"retry_first=\", 12) == 0) {\n      strncpy(out, line + 12, size - 1);\n      out[size - 1] = 0;\n      break;\n    }\n  }\n  fclose(f);\n}\n\nint op_bag(const char *outdir, char out[][64], int maxn) {\n  char hosts[8][64];\n  char roots[8][256];\n  char first[64];\n  int ranks[8];\n  int n, i, j;\n  (void)outdir;\n\n  if (maxn <= 0) return 0;\n  n = load_cards(hosts, ranks, roots, 8);\n  retry_first(first, sizeof(first));\n\n  /* Contact retry_first first.  Rank and host make all other order stable. */\n  for (i = 0; i < n; i++) {\n    for (j = i + 1; j < n; j++) {\n      int ip = first[0] && strcmp(hosts[i], first) == 0;\n      int jp = first[0] && strcmp(hosts[j], first) == 0;\n      int swap = jp > ip || (jp == ip &&\n          (ranks[j] < ranks[i] ||\n           (ranks[j] == ranks[i] && strcmp(hosts[j], hosts[i]) < 0)));\n      if (swap) {\n        char th[64];\n        char tr[256];\n        int rank = ranks[i];\n        memcpy(th, hosts[i], sizeof(th));\n        memcpy(hosts[i], hosts[j], sizeof(th));\n        memcpy(hosts[j], th, sizeof(th));\n        memcpy(tr, roots[i], sizeof(tr));\n        memcpy(roots[i], roots[j], sizeof(tr));\n        memcpy(roots[j], tr, sizeof(tr));\n        ranks[i] = ranks[j];\n        ranks[j] = rank;\n      }\n    }\n  }\n  if (n > maxn) n = maxn;\n  for (i = 0; i < n; i++) {\n    strncpy(out[i], hosts[i], 63);\n    out[i][63] = 0;\n  }\n  return n;\n}\nEOF\ncat > /app/objbay/n_pick.c <<'EOF'\n#include \"n_pick.h\"\n\n#include <string.h>\n\nint n_pick(const struct Obj *objs, int n) {\n  int best, i;\n  if (!objs || n <= 0) return -1;\n  best = 0;\n  for (i = 1; i < n; i++) {\n    if (objs[i].rank < objs[best].rank ||\n        (objs[i].rank == objs[best].rank &&\n         strcmp(objs[i].host, objs[best].host) < 0)) {\n      best = i;\n    }\n  }\n  return best;\n}\nEOF\npython3 - <<'PY'\np='/app/ribvat/n_credit.c'\ns=open(p).read()\nstart=s.index('static void read_first')\nend=s.index('\\nint n_credit', start)\ns=s[:start]+s[end+1:]\ns=s.replace('  char first[64];\\n', '')\ns=s.replace('  read_first(first, 64);\\n', '')\ns=s.replace('tmp[i].bid, first);', 'tmp[i].bid, tmp[i].host);')\nopen(p,'w').write(s)\np='/app/millcue/main.c'\ns=open(p).read()\ns=s.replace('#include <string.h>\\n', '#include <string.h>\\n#include <unistd.h>\\n')\ns=s.replace('  rc = run_go(&x);', '  {\\n    char mark[320];\\n    snprintf(mark, sizeof(mark), \"%s/ok.mark\", x.out);\\n    unlink(mark);\\n  }\\n  rc = run_go(&x);')\nopen(p,'w').write(s)\nPY\nmake -C /app/millcue -f hull.mk hull\n"]
