[72.47223, "i", "cat > /app/hopbag/op_bag.c <<'EOF'\n#include \"op_bag.h\"\n#include \"readwell.h\"\n\n#include <string.h>\n\nint op_bag(const char *out, char bag[][64], int cap) {\n  char hosts[8][64];\n  char roots[8][256];\n  int ranks[8];\n  int n, i, j;\n  (void)out;\n\n  if (cap <= 0) return 0;\n  n = load_cards(hosts, ranks, roots, 8);\n  for (i = 0; i < n; i++) {\n    for (j = i + 1; j < n; j++) {\n      if (ranks[j] < ranks[i] ||\n          (ranks[j] == ranks[i] && strcmp(hosts[j], hosts[i]) < 0)) {\n        char th[64], tr[256];\n        int rank = ranks[i];\n        memcpy(th, hosts[i], sizeof(th));\n        memcpy(hosts[i], hosts[j], sizeof(th));\n        memcpy(hosts[j], th, sizeof(th));\n        memcpy(tr, roots[i], sizeof(tr));\n        memcpy(roots[i], roots[j], sizeof(tr));\n        memcpy(roots[j], tr, sizeof(tr));\n        ranks[i] = ranks[j];\n        ranks[j] = rank;\n      }\n    }\n  }\n  if (n > cap) n = cap;\n  for (i = 0; i < n; i++) {\n    strncpy(bag[i], hosts[i], 63);\n    bag[i][63] = 0;\n  }\n  return n;\n}\nEOF\ncat > /app/objbay/n_pick.c <<'EOF'\n#include \"n_pick.h\"\n\n#include <string.h>\n\nint n_pick(const struct Obj *objs, int n) {\n  int best, i;\n  if (!objs || n <= 0) return -1;\n  best = 0;\n  for (i = 1; i < n; i++) {\n    if (objs[i].rank < objs[best].rank ||\n        (objs[i].rank == objs[best].rank &&\n         strcmp(objs[i].host, objs[best].host) < 0)) {\n      best = i;\n    }\n  }\n  return best;\n}\nEOF\npython3 - <<'PY'\np='/app/ribvat/n_credit.c'\ns=open(p).read()\ns=s.replace('  char first[64];\\n', '')\ns=s.replace('  read_first(first, 64);\\n', '')\ns=s.replace('tmp[i].bid, first);', 'tmp[i].bid, tmp[i].host);')\n# Remove the now-unused configuration helper.\na=s.index('static void read_first(')\nb=s.index('\\nint n_credit(', a)\ns=s[:a]+s[b+1:]\nopen(p,'w').write(s)\nPY\ncat > /app/sidelog/retry.c <<'EOF'\n#include \"retry.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic void configured_first(char *out, size_t size) {\n  FILE *f = fopen(\"/app/mill.cfg\", \"r\");\n  char line[128];\n  strncpy(out, \"fastpit\", size - 1);\n  out[size - 1] = 0;\n  if (!f) return;\n  while (fgets(line, sizeof(line), f)) {\n    char *nl = strchr(line, '\\n');\n    if (nl) *nl = 0;\n    if (strncmp(line, \"retry_first=\", 12) == 0) {\n      strncpy(out, line + 12, size - 1);\n      out[size - 1] = 0;\n    }\n  }\n  fclose(f);\n}\n\nvoid retry_touch(char hosts[][64], int n) {\n  char first[64];\n  FILE *f;\n  int i;\n  configured_first(first, sizeof(first));\n  for (i = 0; i < n; i++) {\n    if (strcmp(hosts[i], first) == 0) {\n      char tmp[64];\n      memcpy(tmp, hosts[0], sizeof(tmp));\n      memcpy(hosts[0], hosts[i], sizeof(tmp));\n      memcpy(hosts[i], tmp, sizeof(tmp));\n      break;\n    }\n  }\n  f = fopen(\"/app/outkeg/poll.log\", \"w\");\n  if (!f) return;\n  for (i = 0; i < n; i++) fprintf(f, \"%s\\n\", hosts[i]);\n  fclose(f);\n}\nEOF\npython3 - <<'PY'\np='/app/millcue/main.c'\ns=open(p).read()\ns=s.replace('#include <string.h>\\n', '#include <string.h>\\n#include <unistd.h>\\n')\ns=s.replace('  rc = run_go(&x);', '  {\\n    char mark[320];\\n    snprintf(mark, sizeof(mark), \"%s/ok.mark\", x.out);\\n    unlink(mark);\\n  }\\n  rc = run_go(&x);')\nopen(p,'w').write(s)\nPY\nmake -f /app/millcue/hull.mk hull\n"]
