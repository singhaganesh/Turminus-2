[18.150065, "i", "printf '%s\\n' '--- build/config/ops ---'; cat /app/millcue/hull.mk /app/mill.cfg /app/vatnotes/ops.txt; printf '%s\\n' '--- sources ---'; for f in /app/millcue/*.[ch] /app/hopbag/*.[ch] /app/objbay/*.[ch] /app/ribvat/*.[ch] /app/sidelog/*.[ch]; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done\n"]
[18.151069, "o", "printf '%s\\n' '--- build/config/ops ---'; cat /app/millcue/hull.mk /app/mill.cfg /app/vatnotes/ops.txt; printf '%s\\n' '--- sources ---'; for f in /app/millcue/*.[ch] /app/hopbag/*.[ch] /app/objbay/*.[ch] /app/ribvat/*.[ch] /app/sidelog/*.[ch]; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\"; done \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Ke\r\n\u001b[?2004l\r"]
[18.151406, "o", "--- build/config/ops ---\r\n"]
[18.152732, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -I/app/millcue -I/app/hopbag -I/app/objbay -I/app/ribvat -I/app/sidelog\r\nSRC := /app/millcue/main.c /app/millcue/go.c /app/millcue/fin.c \\\r\n\t/app/hopbag/op_bag.c /app/objbay/n_pick.c /app/objbay/readwell.c \\\r\n\t/app/ribvat/n_credit.c /app/sidelog/retry.c\r\nBIN := /app/bin/ashquay\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/outkeg\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[18.152912, "o", "retry_first=fastpit\r\nSplices sometimes print the same names while hosts in provenance.json move between OUTDIR trees. mill.cfg names retry_first as the well to contact first. poll.log under outkeg records the bag that was queried.\r\n"]
[18.153002, "o", "--- sources ---\r\n"]
[18.153121, "o", "===== /app/millcue/ash.h =====\r\n"]
[18.155175, "o", "#ifndef ASH_H\r\n#define ASH_H\r\n\r\n#include \"readwell.h\"\r\n"]
[18.155333, "o", "\r\ntypedef struct Ctx {\r\n  char core[256];\r\n  char out[256];\r\n  Obj objs[8];\r\n  int nobj;\r\n  char sel_bid[8][32];\r\n  char sel_host[8][64];\r\n  int nsel;\r\n  char frames[64][160];\r\n  int nfr;\r\n} Ctx;\r\n\r\nint run_go(Ctx *x);\r\nint run_fin(Ctx *x);\r\n\r\n#endif\r\n"]
[18.155562, "o", "===== /app/millcue/fin.c =====\r\n"]
[18.157211, "o", "#include \"ash.h\"\r\n#include \"n_credit.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n\r\nint run_fin(Ctx *x) {\r\n  char path[320];\r\n  FILE *f;\r\n  int i;\r\n  Sel sel[8];\r\n  mkdir(x->out, 0755);\r\n  snprintf(path, sizeof(path), \"%s/backtrace.txt\", x->out);\r\n  f = fopen(path, \"w\");\r\n  if (!f) {\r\n    return 1;\r\n  }\r\n"]
[18.15738, "o", "  for (i = 0; i < x->nfr; i++) {\r\n    fprintf(f, \"%s\\n\", x->frames[i]);\r\n  }\r\n  fclose(f);\r\n  for (i = 0; i < x->nsel; i++) {\r\n    strncpy(sel[i].bid, x->sel_bid[i], 31);\r\n    strncpy(sel[i].host, x->sel_host[i], 63);\r\n"]
[18.157524, "o", "  }\r\n  if (n_credit(x->out, sel, x->nsel) != 0) {\r\n    return 1;\r\n  }\r\n  snprintf(path, sizeof(path), \"%s/ok.mark\", x->out);\r\n  f = fopen(path, \"w\");\r\n  if (!f) {\r\n    return 1;\r\n  }\r\n  fputs(\"ok\\n\", f);\r\n  fclose(f);\r\n  return 0;\r\n}\r\n"]
[18.158147, "o", "===== /app/millcue/go.c =====\r\n"]
[18.160816, "o", "#include \"ash.h\"\r\n#include \"n_pick.h\"\r\n#include \"op_bag.h\"\r\n#include \"retry.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint run_go(Ctx *x) {\r\n  char hosts[8][64];\r\n  char mods[16][32];\r\n  unsigned bases[16];\r\n  unsigned pcs[64];\r\n  int nm = 0, np = 0, nh, i, m, k;\r\n  if (!load_core(x->core, mods, bases, &nm, pcs, &np)) {\r\n    return 2;\r\n  }\r\n  nh = op_bag(x->out, hosts, 8);\r\n  retry_touch(hosts, nh);\r\n  x->nsel = 0;\r\n  x->nfr = 0;\r\n  for (m = 0; m < nm; m++) {\r\n    Obj bag[8];\r\n    int nb = 0;\r\n    int pi;\r\n    memset(bag, 0, sizeof(bag));\r\n    for (i = 0; i < nh; i++) {\r\n      char root[256];\r\n      char path[400];\r\n      int rank = well_root(hosts[i], root, 256);\r\n      if (rank < 0) {\r\n        continue;\r\n      }\r\n      snprintf(path, sizeof(path), \"%s/%s.dbg\", root, mods[m]);\r\n      if (load_dbg(path, hosts[i], rank, &bag[nb])) {\r\n        nb++;\r\n      }\r\n    }\r\n    pi = n_pick(bag, nb);\r\n    if (pi < 0) {\r\n      return 2;\r\n    }\r\n    strncpy(x->sel_bid[x->nsel], bag[pi].bid, 31);\r\n    strncpy(x->sel_host[x->nsel], bag[pi].host, 63);\r\n    x->nsel++;\r\n    for (k = 0; k < np; k++) {\r\n      int s;\r\n      const Obj *o = &bag[pi];\r\n      int used = 0;\r\n      for (s = 0; s < o->n_sym; s++) {\r\n        if (o->addrs[s] == pcs[k]) {\r\n"]
[18.160951, "o", "          char line[160];\r\n          int L;\r\n          snprintf(line, sizeof(line), \"%s at 0x%08x\", o->names[s], pcs[k]);\r\n          for (L = 0; L < o->n_line; L++) {\r\n            if (o->laddr[L] == pcs[k]) {\r\n              snprintf(line, sizeof(line), \"%s at 0x%08x %s\", o->names[s],\r\n                       pcs[k], o->lfile[L]);\r\n              break;\r\n            }\r\n          }\r\n          if (x->nfr < 64) {\r\n            strncpy(x->frames[x->nfr], line, 159);\r\n            x->nfr++;\r\n          }\r\n          used = 1;\r\n          break;\r\n        }\r\n      }\r\n      (void)used;\r\n    }\r\n  }\r\n  return 0;\r\n}\r\n"]
[18.161321, "o", "===== /app/millcue/main.c =====\r\n"]
[18.16311, "o", "#include \"ash.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint main(int argc, char **argv) {\r\n  Ctx x;\r\n  int rc;\r\n  memset(&x, 0, sizeof(x));\r\n  if (argc < 4 || strcmp(argv[1], \"splice\") != 0) {\r\n    fprintf(stderr, \"usage: ashquay splice CORE OUTDIR\\n\");\r\n    return 2;\r\n  }\r\n  strncpy(x.core, argv[2], 255);\r\n  strncpy(x.out, argv[3], 255);\r\n  rc = run_go(&x);\r\n  if (rc != 0) {\r\n"]
[18.163309, "o", "    return rc;\r\n  }\r\n  return run_fin(&x);\r\n}\r\n"]
[18.163496, "o", "===== /app/hopbag/op_bag.c =====\r\n"]
[18.165852, "o", "#include \"op_bag.h\"\r\n#include \"readwell.h\"\r\n\r\n#include <string.h>\r\n\r\nint op_bag(const char *a, char b[][64], int c) {\r\n  char hosts[8][64];\r\n  int ranks[8];\r\n  char roots[8][256];\r\n  int n = load_cards(hosts, ranks, roots, 8);\r\n  int i, j;\r\n  int idx = 0;\r\n  for (i = 0; i < n; i++) {\r\n    for (j = i + 1; j < n; j++) {\r\n      if (strcmp(hosts[j], hosts[i]) < 0) {\r\n        char th[64];\r\n        char tr[256];\r\n        int tk = ranks[i];\r\n        memcpy(th, hosts[i], 64);\r\n        memcpy(hosts[i], hosts[j], 64);\r\n        memcpy(hosts[j], th, 64);\r\n        memcpy(tr, roots[i], 256);\r\n        memcpy(roots[i], roots[j], 256);\r\n        memcpy(roots[j], tr, 256);\r\n        ranks[i] = ranks[j];\r\n        ranks[j] = tk;\r\n      }\r\n    }\r\n  }\r\n  if (a && strchr(a, 'A') != NULL) {\r\n    idx = 1;\r\n  }\r\n  if (n <= 0 || c <= 0) {\r\n    return 0;\r\n  }\r\n  strncpy(b[0], hosts[idx % n], 63);\r\n  b[0][63] = 0;\r\n  return 1;\r\n}\r\n"]
[18.166564, "o", "===== /app/hopbag/op_bag.h =====\r\n"]
[18.169126, "o", "#ifndef OP_BAG_H\r\n#define OP_BAG_H\r\nint op_bag(const char *a, char b[][64], int c);\r\n#endif\r\n"]
[18.169532, "o", "===== /app/objbay/n_pick.c =====\r\n"]
[18.171395, "o", "#include \"n_pick.h\"\r\n\r\nint n_pick(const struct Obj *a, int b) {\r\n  (void)a;\r\n  if (b <= 0) {\r\n    return 0;\r\n  }\r\n  return 0;\r\n}\r\n"]
[18.171741, "o", "===== /app/objbay/n_pick.h =====\r\n"]
[18.173056, "o", "#ifndef N_PICK_H\r\n#define N_PICK_H\r\n#include \"readwell.h\"\r\nint n_pick(const struct Obj *a, int b);\r\n#endif\r\n"]
[18.173297, "o", "===== /app/objbay/readwell.c =====\r\n"]
[18.176319, "o", "#include \"readwell.h\"\r\n\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic int card_cmp_name(const void *x, const void *y) {\r\n  return strcmp((const char *)x, (const char *)y);\r\n}\r\n\r\nint load_cards(char hosts[][64], int ranks[], char roots[][256], int maxn) {\r\n  DIR *d = opendir(\"/app/cardurn\");\r\n  struct dirent *e;\r\n  char names[16][64];\r\n  int nn = 0;\r\n  int n = 0;\r\n  int i;\r\n  if (!d) {\r\n    return 0;\r\n  }\r\n  while ((e = readdir(d)) != NULL) {\r\n    size_t L;\r\n    if (e->d_name[0] == '.') {\r\n      continue;\r\n    }\r\n    L = strlen(e->d_name);\r\n"]
[18.176532, "o", "    if (L < 6 || strcmp(e->d_name + L - 5, \".card\") != 0) {\r\n      continue;\r\n    }\r\n    if (nn < 16) {\r\n      strncpy(names[nn], e->d_name, 63);\r\n      names[nn][63] = 0;\r\n      nn++;\r\n    }\r\n  }\r\n  closedir(d);\r\n  qsort(names, (size_t)nn, 64, card_cmp_name);\r\n  for (i = 0; i < nn && n < maxn; i++) {\r\n    char path[320];\r\n    char line[256];\r\n    FILE *f;\r\n    snprintf(path, sizeof(path), \"/app/cardurn/%s\", names[i]);\r\n    f = fopen(path, \"r\");\r\n    if (!f) {\r\n      continue;\r\n    }\r\n    hosts[n][0] = 0;\r\n    ranks[n] = 99;\r\n    roots[n][0] = 0;\r\n    while (fgets(line, sizeof(line), f)) {\r\n      char *nl = strchr(line, '\\n');\r\n      if (nl) {\r\n        *nl = 0;\r\n      }\r\n      if (strncmp(line, \"host=\", 5) == 0) {\r\n        strncpy(hosts[n], line + 5, 63);\r\n        hosts[n][63] = 0;\r\n      } else if (strncmp(line, \"rank=\", 5) == 0) {\r\n        ranks[n] = atoi(line + 5);\r\n      } else if (strncmp(line, \"root=\", 5) == 0) {\r\n        strncpy(roots[n], line + 5, 255);\r\n        roots[n][255] = 0;\r\n      }\r\n    }\r\n    fclose(f);\r\n    if (hosts[n][0]) {\r\n      n++;\r\n    }\r\n  }\r\n  return n;\r\n}\r\n\r\nint well_root(const char *host, char *root, int n) {\r\n  char hosts[8][64];\r\n  int ranks[8];\r\n  char roots[8][256];\r\n  int i, m = load_cards(hosts, ranks, roots, 8);\r\n  for (i = 0; i < m; i++) {\r\n    if (strcmp(hosts[i], host) == 0) {\r\n      strncpy(root, roots[i], (size_t)n - 1);\r\n      root[n - 1] = 0;\r\n      return ranks[i];\r\n    }\r\n  }\r\n  return -1;\r\n}\r\n\r\nint load_dbg(const char *path, const char *host, int rank, Obj *o) {\r\n  FILE *f = fopen(path, \"r\");\r\n  char line[256];\r\n  if (!f) {\r\n    return 0;\r\n  }\r\n  memset(o, 0, sizeof(*o));\r\n"]
[18.176563, "o", "  strncpy(o->host, host, 63);\r\n  o->rank = rank;\r\n  strncpy(o->root, path, 255);\r\n  while (fgets(line, sizeof(line), f)) {\r\n    char *nl = strchr(line, '\\n');\r\n    unsigned addr;\r\n    char name[64];\r\n    char file[80];\r\n    if (nl) {\r\n      *nl = 0;\r\n    }\r\n    if (strncmp(line, \"build_id=\", 9) == 0) {\r\n      strncpy(o->bid, line + 9, 31);\r\n      o->bid[31] = 0;\r\n    } else if (strncmp(line, \"kind=\", 5) == 0) {\r\n      continue;\r\n    } else if (sscanf(line, \"@ %x %79s\", &addr, file) == 2) {\r\n      if (o->n_line < 64) {\r\n        o->laddr[o->n_line] = addr;\r\n        strncpy(o->lfile[o->n_line], file, 79);\r\n        o->n_line++;\r\n      }\r\n    } else if (sscanf(line, \"%x %63s\", &addr, name) == 2) {\r\n"]
[18.17658, "o", "      if (o->n_sym < 64) {\r\n        o->addrs[o->n_sym] = addr;\r\n        strncpy(o->names[o->n_sym], name, 63);\r\n        o->n_sym++;\r\n      }\r\n    }\r\n  }\r\n  fclose(f);"]
[18.176656, "o", "\r\n  return 1;\r\n}\r\n\r\n"]
[18.176686, "o", "int load_core(const char *path, char mods[][32], unsigned bases[], int *nm,\r\n              unsigned pcs[], int *np) {\r\n  FILE *f = fopen(path, \"r\");\r\n  char line[256];\r\n  *nm = 0;\r\n  *np = 0;\r\n  if (!f) {\r\n    return 0;\r\n  }\r\n  while (fgets(line, sizeof(line), f)) {\r\n    char *nl = strchr(line, '\\n');\r\n"]
[18.176711, "o", "    char bid[32];\r\n    unsigned v;\r\n    if (nl) {\r\n      *nl = 0;\r\n    }\r\n    if (sscanf(line, \"mod %31s %x\", bid, &v) == 2 && *nm < 16) {\r\n      strncpy(mods[*nm], bid, 31);\r\n      bases[*nm] = v;\r\n      (*nm)++;\r\n    } else if (sscanf(line, \"pc %x\", &v) == 1 && *np < 64) {\r\n      pcs[*np] = v;\r\n      (*np)++;\r\n    }"]
[18.176729, "o", "\r\n  }\r\n  fclose(f);\r\n  return 1;\r\n}\r\n"]
[18.177074, "o", "===== /app/objbay/readwell.h =====\r\n"]
[18.179143, "o", "#ifndef READWELL_H\r\n#define READWELL_H\r\n\r\ntypedef struct Obj {\r\n  char host[64];\r\n  char bid[32];\r\n  char root[256];\r\n  int rank;\r\n  int n_sym;\r\n  int n_line;\r\n  unsigned addrs[64];\r\n  char names[64][64];\r\n  unsigned laddr[64];\r\n  char lfile[64][80];\r\n} Obj;\r\n\r\nint load_cards(char hosts[][64], int ranks[], char roots[][256], int maxn);\r\nint well_root(const char *host, char *root, int n);\r\nint load_dbg(const char *path, const char *host, int rank, Obj *o);\r\nint load_core(const char *path, char mods[][32], unsigned bases[], int *nm,\r\n              unsigned pcs[], int *np);\r\n\r\n#endif\r\n"]
[18.179809, "o", "===== /app/ribvat/n_credit.c =====\r\n"]
[18.181715, "o", "#include \"n_credit.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void read_first(char *out, int n) {\r\n  FILE *f = fopen(\"/app/mill.cfg\", \"r\");\r\n  char line[128];\r\n  strncpy(out, \"fastpit\", (size_t)n - 1);\r\n  out[n - 1] = 0;\r\n  if (!f) {\r\n    return;\r\n  }\r\n  while (fgets(line, sizeof(line), f)) {\r\n    char *nl = strchr(line, '\\n');\r\n    if (nl) {\r\n      *nl = 0;\r\n"]
[18.181768, "o", "    }\r\n    if (strncmp(line, \"retry_first=\", 12) == 0) {\r\n      strncpy(out, line + 12, (size_t)n - 1);\r\n      out[n - 1] = 0;\r\n    }\r\n  }\r\n  fclose(f);\r\n}\r\n\r\nint n_credit(const char *a, const struct Sel *b, int c) {\r\n  char path[320];\r\n  char first[64];\r\n  FILE *f;\r\n  int i, j;\r\n  Sel tmp[8];\r\n  if (!a || c < 0) {\r\n    return 1;\r\n  }\r\n  snprintf(path, sizeof(path), \"%s/provenance.json\", a);\r\n"]
[18.181797, "o", "  f = fopen(path, \"w\");\r\n  if (!f) {\r\n    return 1;\r\n  }\r\n  read_first(first, 64);\r\n  memcpy(tmp, b, (size_t)c * sizeof(Sel));\r\n  for (i = 0; i < c; i++) {\r\n    for (j = i + 1; j < c; j++) {\r\n      if (strcmp(tmp[j].bid, tmp[i].bid) < 0) {\r\n        Sel t = tmp[i];\r\n        tmp[i] = tmp[j];\r\n        tmp[j] = t;\r\n      }\r\n    }\r\n  }\r\n"]
[18.182002, "o", "  fprintf(f, \"{\\\"objects\\\":[\");\r\n  for (i = 0; i < c; i++) {\r\n    if (i) {\r\n      fputc(',', f);\r\n    }\r\n    fprintf(f, \"{\\\"build_id\\\":\\\"%s\\\",\\\"host\\\":\\\"%s\\\"}\", tmp[i].bid, first);\r\n  }"]
[18.182069, "o", "\r\n  fprintf(f, \"]}\\n\");\r\n  fclose(f);\r\n  return 0;\r\n}\r\n"]
[18.182258, "o", "===== /app/ribvat/n_credit.h =====\r\n"]
[18.183571, "o", "#ifndef N_CREDIT_H\r\n#define N_CREDIT_H\r\n\r\ntypedef struct Sel {\r\n  char bid[32];\r\n  char host[64];\r\n} Sel;\r\n\r\nint n_credit(const char *a, const struct Sel *b, int c);\r\n\r\n#endif\r\n"]
[18.183812, "o", "===== /app/sidelog/retry.c =====\r\n"]
[18.18494, "o", "#include \"retry.h\"\r\n\r\n#include <stdio.h>\r\n\r\nvoid retry_touch(char hosts[][64], int n) {\r\n  FILE *f = fopen(\"/app/outkeg/poll.log\", \"w\");\r\n  int i;\r\n  if (!f) {\r\n    return;\r\n  }\r\n  for (i = 0; i < n; i++) {\r\n    fprintf(f, \"%s\\n\", hosts[i]);\r\n  }\r\n  fclose(f);\r\n}\r\n"]
