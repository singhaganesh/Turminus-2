Sending keys: ['cat > /app/stitchbay/card.rs <<\'EOF\'\npub struct Row {\n    pub tag: String,\n    pub pos: u32,\n    pub n: u32,\n}\n\npub fn rib_b() -> Vec<Row> {\n    let text = std::fs::read_to_string("/app/ribcards/LAYOUT.txt")\n        .expect("read layout");\n    let mut out = Vec::new();\n    for (line_no, line) in text.lines().enumerate() {\n        let raw = line.trim();\n        if raw.is_empty() || raw.starts_with(\'#\') {\n            continue;\n        }\n        let parts: Vec<&str> = raw.split_whitespace().collect();\n        assert!(parts.len() == 3, "invalid layout line {}", line_no + 1);\n        let pos = parts[1]\n            .parse::<u32>()\n            .unwrap_or_else(|_| panic!("invalid position on layout line {}", line_no + 1));\n        let n = parts[2]\n            .parse::<u32>()\n            .unwrap_or_else(|_| panic!("invalid width on layout line {}", line_no + 1));\n        assert!((1..=32).contains(&n), "invalid width on layout line {}", line_no + 1);\n        out.push(Row { tag: parts[0].to_string(), pos, n });\n    }\n    out\n}\nEOF\ncat > /app/octetkiln/take.rs <<\'EOF\'\npub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\n    if n == 0 || n > 32 {\n        return 0;\n    }\n    let end = match pos.checked_add(n) {\n        Some(v) => v,\n        None => return 0,\n    };\n    if end as u64 > (buf.len() as u64) * 8 {\n        return 0;\n    }\n\n    let mut value = 0u32;\n    for offset in 0..n {\n        let absolute = pos + offset;\n        let byte = buf[(absolute / 8) as usize];\n        let shift = 7 - (absolute % 8);\n        value = (value << 1) | (((byte as u32) >> shift) & 1);\n    }\n    value\n}\nEOF\ncat > /app/kilnbake/hearth.rs <<\'EOF\'\nuse std::fs;\n\n#[path = "../stitchbay/card.rs"]\nmod card;\n\nfn slot(rows: &[card::Row], i: usize, tag: &str) -> (u32, u32) {\n    let row = rows.get(i).unwrap_or_else(|| panic!("missing layout row {}", tag));\n    assert!(row.tag == tag, "expected layout row {}, found {}", tag, row.tag);\n    (row.pos, row.n)\n}\n\npub fn rib_d() {\n    let rows = card::rib_b();\n    assert!(rows.len() == 6, "layout must contain six rows");\n    let a = slot(&rows, 0, "kind");\n    let b = slot(&rows, 1, "lane");\n    let c = slot(&rows, 2, "mode");\n    let d = slot(&rows, 3, "welt");\n    let e = slot(&rows, 4, "tail");\n    let f = slot(&rows, 5, "mark");\n    let body_bits = rows.iter()\n        .map(|row| row.pos.checked_add(row.n).expect("layout overflow"))\n        .max()\n        .unwrap_or(0);\n    let body = format!(\n        r#"use crate::take;\n\npub const BODY_BITS: u32 = {12};\n\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\n    (\n        take::rib_a(buf, {0}, {1}),\n        take::rib_a(buf, {2}, {3}),\n        take::rib_a(buf, {4}, {5}),\n        take::rib_a(buf, {6}, {7}),\n        take::rib_a(buf, {8}, {9}),\n        take::rib_a(buf, {10}, {11}),\n    )\n}}\n"#,\n        a.0, a.1, b.0, b.1, c.0, c.1, d.0, d.1, e.0, e.1, f.0, f.1,\n        body_bits\n    );\n    fs::create_dir_all("/app/vaultbin").expect("create bake directory");\n    fs::write("/app/vaultbin/pull.rs", body).expect("emit baked pull");\n}\n\nfn main() {\n    rib_d();\n}\nEOF\ncat > /app/peekurn/ink.rs <<\'EOF\'\nuse crate::pull;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rib_c() -> i32 {\n    let _ = tally::lines();\n    let dest = Path::new("/app/blotbay/rows.json");\n\n    // No failed pour may leave output from an earlier successful run.\n    if let Err(err) = fs::remove_file(dest) {\n        if err.kind() != std::io::ErrorKind::NotFound {\n            eprintln!("cannot remove old rows: {}", err);\n            return 1;\n        }\n    }\n\n    let buf = match fs::read("/app/quaybag/night.bin") {\n        Ok(buf) => buf,\n        Err(err) => {\n            eprintln!("cannot read body: {}", err);\n            return 1;\n        }\n    };\n    if (buf.len() as u64) * 8 < pull::BODY_BITS as u64 {\n        eprintln!("body is shorter than layout width");\n        return 1;\n    }\n\n    if let Some(parent) = dest.parent() {\n        if let Err(err) = fs::create_dir_all(parent) {\n            eprintln!("cannot create output directory: {}", err);\n            return 1;\n        }\n    }\n    let (a, b, c, d, e, f) = pull::dump(&buf);\n    let body = format!(\n        "{{\\"kind\\":{},\\"lane\\":{},\\"mode\\":{},\\"welt\\":{},\\"tail\\":{},\\"mark\\":{}}}\\n",\n        a, b, c, d, e, f\n    );\n    if let Err(err) = fs::write(dest, body) {\n        eprintln!("cannot write rows: {}", err);\n        let _ = fs::remove_file(dest);\n        return 1;\n    }\n    0\n}\nEOF\n/app/wick.sh\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
