 collect(&sess.ids.borrow(), &pool.cells);\n    if heat && frost_items == live_items {\n        return 1;\n    }\n    let extra = tally::lines();\n    let body = format!(\n        "{{\\\\\\"tick\\\\\\":{},\\\\\\"mark\\\\\\":{},\\\\\\"frost_bag\\\\\\":{},\\\\\\"live_bag\\\\\\":{}}}\\\\n",\n        sess.n0.saturating_add(extra), sess.n1, pack(&frost_items), pack(&live_items)\n    );\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    match fs::write(dest, body) { Ok(()) => 0, Err(_) => 2 }\n}\n\'\'\'\nink=r\'\'\'use crate::pool;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let _ = tally::lines();\n    let guard = Path::new("/app/inkpit/GUARD");\n    let _ = fs::remove_file(guard);\n    let code = pool::dump();\n    if code != 0 { return code; }\n    match fs::write(guard, "ok\\\\n") { Ok(()) => 0, Err(_) => 2 }\n}\n\'\'\'\ndef raw(s):\n    # content contains no sequence of this delimiter\n    return \'r###"\'+s+\'"###\'\nsource=\'\'\'use std::collections::HashSet;\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\nfn walk(dir: &Path, seen: &mut Vec<PathBuf>) -> std::io::Result<()> {\n    let mut entries: Vec<_> = fs::read_dir(dir)?.collect::<Result<_, _>>()?;\n    entries.sort_by_key(|e| e.path());\n    for entry in entries {\n        let path = entry.path();\n        if path.is_dir() { walk(&path, seen)?; }\n        else { let _ = fs::read(&path)?; seen.push(path); }\n    }\n    Ok(())\n}\n\npub fn rib_d() -> i32 {\n    let tree = match fs::read_to_string("/app/vatslip/TREE.txt") { Ok(v) => v, Err(_) => return 2 };\n    let names: HashSet<_> = tree.lines().map(str::trim).filter(|s| !s.is_empty() && !s.starts_with(\'#\')).collect();\n    let required = ["foldrib", "internpit", "restcue", "emitbay", "steerpit"];\n    if required.iter().any(|name| !names.contains(name)) { return 2; }\n    let mut cards = Vec::new();\n    if walk(Path::new("/app/daycards"), &mut cards).is_err() || cards.is_empty() { return 2; }\n    let writes = [\n        ("/app/foldrib/rim.rs", RIM),\n        ("/app/internpit/pool.rs", POOL),\n        ("/app/restcue/ink.rs", INK),\n    ];\n    for (path, body) in writes {\n        if fs::write(path, body).is_err() { return 2; }\n    }\n    0\n}\n\'\'\'\nsource=source.replace(\'RIM\',raw(rim)).replace(\'POOL\',raw(pool)).replace(\'INK\',raw(ink))\np.write_text(source)\nPY\npython3 /tmp/fix.py\nsed -n \'1,100p\' /app/emitbay/hearth.rs\nsh /app/bake.sh\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
