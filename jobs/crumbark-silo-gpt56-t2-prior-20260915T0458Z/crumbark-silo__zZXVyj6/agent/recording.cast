[86.321969, "i", "cat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class HueWalk {\n    public static int orb_n(Path blobPath, Path pinPath, Path cardPath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean sound = pins.length % MistSpan.PIN_SIZE == 0;\n\n        for (int i = 0; i + MistSpan.PIN_SIZE <= pins.length; i += MistSpan.PIN_SIZE) {\n            ByteBuffer bb = ByteBuffer.wrap(pins, i, MistSpan.PIN_SIZE);\n            byte[] magic = new byte[4];\n            bb.get(magic);\n            long off = bb.getLong();\n            int len = bb.getInt();\n            int crc = bb.getInt();\n            byte[] id = new byte[16];\n            bb.get(id);\n            boolean valid = MistSpan.isMagic(magic)\n                    && MistSpan.validPayload(blob, off, len, crc, id) != null;\n            if (valid) held.add(hex(id));\n            else sound = false;\n        }\n\n        String note = sound ? \"ok\" : \"gap\";\n        String kind = sound ? \"live\" : \"void\";\n        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\" + note\n                + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\"}\";\n        Files.writeString(cardPath, json);\n        return sound ? 0 : 1;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 0xff));\n        return sb.toString();\n    }\n\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < held.size(); i++) {\n            if (i > 0) sb.append(',');\n            sb.append('\"').append(held.get(i)).append('\"');\n        }\n        return sb.append(']').toString();\n    }\n\n    public static void main(String[] args) throws Exception {\n        Path silo = Path.of(\"/app/silo\");\n        System.exit(orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\")));\n    }\n}\nEOF\npython3 - <<'PY'\np='/app/hitchbay/YankRun.java'\ns=open(p).read()\ns=s.replace('''    static byte[] hex(String s) {\n        int n = s.length() / 2;\n        byte[] out = new byte[n];\n        for (int i = 0; i < n; i++) {\n            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        }\n        return out;\n    }''','''    static byte[] hex(String s) {\n        if (!s.matches(\"[0-9a-f]{32}\")) {\n            throw new IllegalArgumentException(\"id must be 32 lowercase hex characters\");\n        }\n        byte[] out = new byte[16];\n        for (int i = 0; i < out.length; i++) {\n            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        }\n        return out;\n    }''')\nopen(p,'w').write(s)\nPY\n/app/bin/crumbark tamp\ncat /app/recipit/ForceSeq.java\n"]
