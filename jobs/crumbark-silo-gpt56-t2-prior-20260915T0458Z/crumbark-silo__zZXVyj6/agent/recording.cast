[85.850422, "o", "s=open(p).read()\r\n\u001b[?2004l\r"]
[85.850505, "o", "\u001b[?2004h> "]
[85.850823, "o", "s=s.replace('steps.sort(Comparator.comparingInt(x -> x.compute));', 'steps.sort(Comparator.comparingInt(x -> x.durable));')\r\n\u001b[?2004l\r"]
[85.850981, "o", "\u001b[?2004h> "]
[85.851326, "o", "open(p,'w').write(s)\r\n"]
[85.851471, "o", "\u001b[?2004l\r\u001b[?2004h> PY"]
