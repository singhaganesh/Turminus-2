[43.281959, "o", "echo '== silo bytes =='; od -Ax -tx1z -v /app/silo/pin.bin; od -Ax -tx1z -v /app/silo/blob.bin; echo '== slip ids =='; sha256sum /app/inbox/*.slip | awk '{print substr($1,1,32),$2}'; echo '== slip content =='; for f in /app/inbox/*.slip; do printf '%s: ' \"$f\"; od -An -tc -v \"$f\"; done\r\n\u001b[?2004l\r== silo bytes ==\r\n000000 50 4e 30 31 00 00 00 00 00 00 00 00 00 00 00 17  >PN01............<\r\n000010 92 dd 36 17 71 31 d8 83 b9 a1 18 35 fa 6e d4 71  >..6.q1.....5.n.q<\r\n000020 b7 f1 c1 b4 00 00 00 00 00 00 00 00 00 00 00 00  >................<\r\n000030 50 4e 30 31 00 00 00 00 00 00 00 20 00 00 00 16  >PN01....... ....<\r\n000040 a3 e5 28 f4 f3 c1 bc fb 3c 2f 14 90 f8 94 70 a0  >..(.....</....p.<\r\n000050 3c 83 b1 52 00 00 00 00 00 00 00 00 00 00 00 00  ><..R............<\r\n000060\r\n"]
