[89.31327, "i", "set -e\ncp -a /app/silo /tmp/silo-fixed-test-backup\n/app/bin/crumbark wake\npython3 - <<'PY'\nimport json,subprocess,pathlib\ncard=json.load(open('/app/silo/wake.json'))\nassert card['kind']=='live' and card['note']=='ok'\nfor ident,name in [('7131d883b9a11835fa6ed471b7f1c1b4','prior.slip'),('f3c1bcfb3c2f1490f89470a03c83b152','seed.slip')]:\n    got=subprocess.check_output(['/app/bin/crumbark','pull',ident])\n    assert got==pathlib.Path('/app/inbox/'+name).read_bytes(), (ident,len(got))\nPY\n/app/bin/crumbark lade /app/inbox/oak-a.slip\n/app/bin/crumbark wake\nid=$(sha256sum /app/inbox/oak-a.slip | cut -c1-32)\n/app/bin/crumbark pull \"$id\" > /tmp/pulled && cmp /tmp/pulled /app/inbox/oak-a.slip\n/app/bin/crumbark nick /app/inbox/oak-e.slip\n/app/bin/crumbark wake\npython3 - <<'PY'\nimport json,subprocess\nc=json.load(open('/app/silo/wake.json'))\nassert c['kind']=='live'\nfor i in c['held']:\n    assert subprocess.check_output(['/app/bin/crumbark','pull',i])\nprint(c)\nPY\n"]
