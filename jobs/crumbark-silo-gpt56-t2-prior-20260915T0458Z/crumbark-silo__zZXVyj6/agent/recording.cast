[85.849589, "i", "python3 - <<'PY'\np='/app/recipit/LoomCue.java'\ns=open(p).read()\ns=s.replace('steps.sort(Comparator.comparingInt(x -> x.compute));', 'steps.sort(Comparator.comparingInt(x -> x.durable));')\nopen(p,'w').write(s)\nPY\ncat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\n\npublic class MistSpan {\n    static final int ALIGN = 32;\n    static final int PIN_SIZE = 48;\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        byte[] pins = Files.exists(silo.resolve(\"pin.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"pin.bin\")) : new byte[0];\n        byte[] blob = Files.exists(silo.resolve(\"blob.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"blob.bin\")) : new byte[0];\n        for (int i = 0; i + PIN_SIZE <= pins.length; i += PIN_SIZE) {\n            ByteBuffer bb = ByteBuffer.wrap(pins, i, PIN_SIZE);\n            byte[] magic = new byte[4];\n            bb.get(magic);\n            long off = bb.getLong();\n            int len = bb.getInt();\n            int crc = bb.getInt();\n            byte[] id = new byte[16];\n            bb.get(id);\n            if (isMagic(magic) && same(id, wanted)) {\n                byte[] payload = validPayload(blob, off, len, crc, id);\n                if (payload != null) {\n                    return payload;\n                }\n            }\n        }\n        return new byte[0];\n    }\n\n    static byte[] validPayload(byte[] blob, long off, int len, int crc, byte[] id) throws Exception {\n        if (off < 0 || off > Integer.MAX_VALUE || len < 0) return null;\n        long rec = 4L + len;\n        long pad = (ALIGN - (rec % ALIGN)) % ALIGN;\n        long end = off + rec + pad;\n        if (end < off || end > blob.length || off + 4L > blob.length) return null;\n        int pos = (int) off;\n        if (ByteBuffer.wrap(blob, pos, 4).getInt() != len) return null;\n        byte[] payload = new byte[len];\n        System.arraycopy(blob, pos + 4, payload, 0, len);\n        if (allZero(payload) || Crc.of(payload) != crc || !same(idOf(payload), id)) return null;\n        return payload;\n    }\n\n    static byte[] idOf(byte[] payload) throws Exception {\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\n        byte[] id = new byte[16];\n        System.arraycopy(digest, 0, id, 0, id.length);\n        return id;\n    }\n\n    static boolean isMagic(byte[] x) {\n        return x.length == 4 && x[0] == 'P' && x[1] == 'N' && x[2] == '0' && x[3] == '1';\n    }\n\n    static boolean allZero(byte[] x) {\n        if (x.length == 0) return false;\n        for (byte b : x) if (b != 0) return false;\n        return true;\n    }\n\n    static boolean same(byte[] x, byte[] y) {\n        if (x.length != y.length) return false;\n        for (int i = 0; i < x.length; i++) if (x[i] != y[i]) return false;\n        return true;\n    }\n}\nEOF\n"]
[85.849897, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[85.850001, "o", "\u001b[?2004h> "]
