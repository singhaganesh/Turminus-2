[93.308698, "i", "set -e\nrm -rf /app/silo; cp -a /tmp/silo-fixed-test-backup /app/silo\n# Append a valid pin whose blob record is absent; wake must fail and omit its id.\n/app/bin/crumbark lade /app/inbox/oak-b.slip\ntruncate -s 64 /app/silo/blob.bin\nif /app/bin/crumbark wake; then echo 'ERROR short blob accepted'; exit 1; fi\ncat /app/silo/wake.json\nid=$(sha256sum /app/inbox/oak-b.slip | cut -c1-32)\ntest -z \"$(/app/bin/crumbark pull \"$id\")\"\n# Restore pristine supplied records after tests.\nrm -rf /app/silo; cp -a /tmp/silo-fixed-test-backup /app/silo\n/app/bin/crumbark wake\ncat /app/silo/wake.json; echo\n"]
