[20.055547, "o", "    static String arr(List<String> held) {\r\n        StringBuilder sb = new StringBuilder(\"[\");\r\n        for (int i = 0; i < held.size(); i++) {\r\n            if (i > 0) {\r\n"]
[20.055559, "o", "                sb.append(\",\");\r\n            }\r\n            sb.append(\"\\\"\");\r\n            sb.append(held.get(i));\r\n            sb.append(\"\\\"\");\r\n        }"]
[20.05557, "o", "\r\n        sb.append(\"]\");\r\n        return sb.toString();\r\n    }\r\n\r\n"]
