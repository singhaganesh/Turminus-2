[114.51339, "i", "set -e\ncp -a /app/silo /tmp/silo-final-valid\n# Zero the first stored payload while retaining its pin row.\ndd if=/dev/zero of=/app/silo/blob.bin bs=1 seek=4 count=23 conv=notrunc status=none\nif /app/bin/crumbark wake; then echo 'ERROR zero body accepted'; exit 1; fi\npython3 - <<'PY'\nimport json,subprocess\nc=json.load(open('/app/silo/wake.json'))\nassert c['kind']=='void' and c['note']=='gap'\nassert '7131d883b9a11835fa6ed471b7f1c1b4' not in c['held']\nassert subprocess.check_output(['/app/bin/crumbark','pull','7131d883b9a11835fa6ed471b7f1c1b4']) == b''\nprint('zero-body rejection: ok')\nPY\nrm -rf /app/silo; cp -a /tmp/silo-final-valid /app/silo\n/app/bin/crumbark tamp\n/app/bin/crumbark wake\npython3 - <<'PY'\nimport json,pathlib,subprocess\nc=json.load(open('/app/silo/wake.json'))\nassert c == {'held':['7131d883b9a11835fa6ed471b7f1c1b4','f3c1bcfb3c2f1490f89470a03c83b152'],'note':'ok','kind':'live'}\nfor ident,slip in [('7131d883b9a11835fa6ed471b7f1c1b4','prior.slip'),('f3c1bcfb3c2f1490f89470a03c83b152','seed.slip')]:\n    assert subprocess.check_output(['/app/bin/crumbark','pull',ident]) == pathlib.Path('/app/inbox',slip).read_bytes()\nprint('final validation: ok')\nPY\n"]
