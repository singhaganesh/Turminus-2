#!/bin/bash
set -euo pipefail
JAVA="${JAVA_HOME:-/opt/java/openjdk}/bin/java"
if [ ! -x "$JAVA" ]; then
  JAVA=java
fi
verb="${1:-}"
shift || true
case "$verb" in
  tamp)
    exec /app/brimvat.sh
    ;;
  lade|wake|pull|nick)
    exec "$JAVA" -cp /app/blastcp DeskMain "$verb" "$@"
    ;;
  *)
    exit 2
    ;;
esac

