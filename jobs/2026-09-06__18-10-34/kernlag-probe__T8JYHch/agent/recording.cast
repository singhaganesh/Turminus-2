[17.718149, "i", "for f in lagpipe/Makefile lagpipe/BUILDCHANNEL lagpipe/VERIFIER_CHANNEL lagpipe/fieldnotes/FIELD_RULES.txt lagpipe/fieldnotes/ROUTE_MAP.txt lagpipe/synclink/ARCHITECTURE lagpipe/synclink/common.h lagpipe/synclink/driver.c lagpipe/synclink/field_emit.c lagpipe/synclink/parse_layout.c lagpipe/synclink/rebuild.c lagpipe/tagc/gate.h lagpipe/tagc/gate.c lagpipe/tblw/emit_writer.c livekern/CHANNEL livekern/EXPORTS livekern/VERSION livekern/exports/sched_entity.tab memvault/MANIFEST snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf memvault/regression/bundle_pick_input.c relc/input.c; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[17.720534, "o", "for f in lagpipe/Makefile lagpipe/BUILDCHANNEL lagpipe/VERIFIER_CHANNEL lagpipe/fieldnotes/FIELD_RULES.txt lagpipe/fieldnotes/ROUTE_MAP.txt lagpipe/synclink/ARCHITECTURE lagpipe/synclink/common.h lagpipe/synclink/driver.c lagpipe/synclink/field_emit.c lagpipe/synclink/parse_layout.c lagpipe/synclink/rebuild.c lagpipe/tagc/gate.h lagpipe/tagc/gate.c lagpipe/tblw/emit_writer.c livekern/CHANNEL livekern/EXPORTS livekern/VERSION livekern/exports/sched_entity.tab memvault/MANIFEST snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf memvault/regression/bundle_pick_input.c relc/input.c; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[17.720739, "o", "===== lagpipe/Makefile =====\r\n"]
[17.722315, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Isynclink -Itagc\r\nSRC := $(wildcard synclink/*.c) ../relc/input.c tblw/emit_writer.c tagc/gate.c\r\nBIN := /app/bin/kernscribe\r\n\r\n.PHONY: bind\r\nbind:\r\n\tmkdir -p /app/bin /app/lagpipe/synctab_out\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[17.722622, "o", "===== lagpipe/BUILDCHANNEL =====\r\n"]
[17.726711, "o", "synctab build channel: synclink driver binds relc, tblw, tagc.\r\n"]
[17.726897, "o", "===== lagpipe/VERIFIER_CHANNEL =====\r\n"]
[17.728567, "o", "# Kernlag synctab verifier channel — not part of the graded repair surface.\r\n"]
[17.728795, "o", "===== lagpipe/fieldnotes/FIELD_RULES.txt =====\r\n"]
[17.730202, "o", "Layout table lines:\r\n  STRUCT <name>\r\n  FIELD <name> <kind> <offset> <size>\r\n\r\nKinds: u32, u64. u64 fields use eight-byte little-endian values in capture blobs.\r\nSample blobs are little-endian packed fields in field order.\r\nsched_entity fields include pid, weight, migration_flags, slice_ns.\r\n\r\nprocance.tag is one line: live:<release> or bundle:<release>\r\noffline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n\r\nCLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\nmemvault captures: /app/memvault/samples/*.mem\r\n"]
[17.730234, "o", "memvault cards: /app/memvault/cards/*.ref\r\nrunning release file: /app/livekern/running.release\r\n"]
[17.730477, "o", "===== lagpipe/fieldnotes/ROUTE_MAP.txt =====\r\n"]
[17.731868, "o", "lagpipe synctab wiring notes (internal)\r\n\r\nModules linked by `make -C /app/lagpipe bind` participate in synctab:\r\n  layout pick — chooses sched_entity table input for synctab\r\n  types writer — materializes synctab_out/layout.tbl from the picked table\r\n  tag policy gate — decides whether procance lines are acceptable on this image\r\n  probe emitter — decodes memvault captures through layout.tbl offsets\r\n\r\nField layout rules and CLI contract: /app/lagpipe/fieldnotes/FIELD_RULES.txt\r\n"]
[17.732134, "o", "===== lagpipe/synclink/ARCHITECTURE =====\r\n"]
[17.733521, "o", "kernscribe synclink units live here.\r\n"]
[17.7338, "o", "===== lagpipe/synclink/common.h =====\r\n"]
[17.735257, "o", "#ifndef KERN_FORGE_COMMON_H\r\n#define KERN_FORGE_COMMON_H\r\n\r\n#include <stddef.h>\r\n\r\n#define LAYOUT_PATH_LEN 512\r\n#define TAG_PATH_LEN 512\r\n#define RELEASE_LEN 64\r\n#define FIELD_MAX 16\r\n\r\ntypedef struct {\r\n    char name[64];\r\n    char kind[16];\r\n    unsigned off;\r\n    unsigned size;\r\n} field_def;\r\n\r\ntypedef struct {\r\n    char struct_name[64];\r\n    field_def fields[FIELD_MAX];\r\n    int nfields;\r\n} layout_def;\r\n\r\ntypedef struct {\r\n    char layout_path[LAYOUT_PATH_LEN];\r\n    char tag_value[RELEASE_LEN];\r\n    int from_bundle;\r\n} source_pick;\r\n\r\nint choose_layout(source_pick *out);\r\nint parse_layout(const char *path, layout_def *layout);\r\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value);\r\nint emit_inspect_json(const char *inspect_path);\r\nint rebuild_binary(void);\r\n\r\n#endif\r\n"]
[17.73557, "o", "===== lagpipe/synclink/driver.c =====\r\n"]
[17.736927, "o", "#include \"common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int run_gen(void) {\r\n    source_pick pick;\r\n    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\r\n    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\r\n    FILE *tag_fp;\r\n\r\n    if (choose_layout(&pick) != 0) {\r\n        fprintf(stderr, \"imprint: layout pick failed\\n\");\r\n        return 1;\r\n    }\r\n    tag_fp = fopen(tag_out, \"w\");\r\n    if (!tag_fp) {\r\n        perror(\"imprint: procance.tag\");\r\n        return 1;\r\n    }\r\n    fprintf(tag_fp, \"%s\\n\", pick.tag_value);\r\n    fclose(tag_fp);\r\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\r\n        fprintf(stderr, \"imprint: types write failed\\n\");\r\n"]
[17.737083, "o", "        return 1;\r\n    }\r\n    if (rebuild_binary() != 0) {\r\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc < 2) {\r\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\r\n        return 2;\r\n    }\r\n    if (strcmp(argv[1], \"synctab\") == 0) {\r\n        return run_gen();\r\n    }\r\n    if (strcmp(argv[1], \"inspect\") == 0) {\r\n        if (argc < 3) {\r\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\r\n"]
[17.737195, "o", "            return 2;\r\n        }\r\n        return emit_inspect_json(argv[2]);\r\n    }\r\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\r\n    return 2;\r\n}\r\n"]
[17.737337, "o", "===== lagpipe/synclink/field_emit.c =====\r\n"]
[17.73864, "o", "#include \"common.h\"\r\n\r\n#include <stdint.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic unsigned long read_u32(const unsigned char *buf, unsigned off) {\r\n    uint32_t v;\r\n    memcpy(&v, buf + off, sizeof(v));\r\n    return (unsigned long)v;\r\n}\r\n\r\n"]
[17.738744, "o", "static unsigned long long read_u64(const unsigned char *buf, unsigned off) {\r\n    uint64_t v;\r\n    memcpy(&v, buf + off, sizeof(v));\r\n    return (unsigned long long)v;\r\n}\r\n\r\nint emit_inspect_json(const char *inspect_path) {\r\n    layout_def layout;\r\n    unsigned char blob[64];\r\n    size_t nread;\r\n    FILE *fp = fopen(inspect_path, \"rb\");\r\n    if (!fp) {\r\n        perror(\"probe\");\r\n        return 1;\r\n    }\r\n    nread = fread(blob, 1, sizeof(blob), fp);\r\n"]
[17.738844, "o", "    fclose(fp);\r\n    if (nread < 16) {\r\n        fprintf(stderr, \"probe: inspect too short\\n\");\r\n        return 1;\r\n    }\r\n    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\r\n        fprintf(stderr, \"probe: layout.tbl missing\\n\");\r\n        return 1;\r\n    }\r\n    printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\r\n    for (int i = 0; i < layout.nfields; i++) {\r\n        const field_def *f = &layout.fields[i];\r\n        if (strcmp(f->kind, \"u64\") == 0) {\r\n            printf(\",\\\"%s\\\":%llu\", f->name, read_u64(blob, f->off));\r\n        } else {\r\n            printf(\",\\\"%s\\\":%lu\", f->name, read_u32(blob, f->off));\r\n        }\r\n    }\r\n    printf(\"}\\n\");\r\n    return 0;\r\n}\r\n"]
[17.739112, "o", "===== lagpipe/synclink/parse_layout.c =====\r\n"]
[17.740435, "o", "#include \"common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint parse_layout(const char *path, layout_def *layout) {\r\n    FILE *fp = fopen(path, \"r\");\r\n    char line[256];\r\n    if (!fp || !layout) {\r\n        return -1;\r\n    }\r\n    memset(layout, 0, sizeof(*layout));\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        char name[64];\r\n        char kind[16];\r\n        unsigned off = 0;\r\n        unsigned size = 0;\r\n        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1) {\r\n            continue;\r\n        }\r\n        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\r\n            field_def *f = &layout->fields[layout->nfields++];\r\n            snprintf(f->name, sizeof(f->name), \"%s\", name);\r\n            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\r\n            f->off = off;\r\n            f->size = size;\r\n        }\r\n    }\r\n    fclose(fp);\r\n    return layout->nfields > 0 ? 0 : -1;\r\n}\r\n"]
[17.740691, "o", "===== lagpipe/synclink/rebuild.c =====\r\n"]
[17.742098, "o", "#include \"common.h\"\r\n\r\n#include <stdlib.h>\r\n\r\nint rebuild_binary(void) {\r\n    return system(\"make -C /app/lagpipe bind >/dev/null 2>&1\");\r\n}\r\n"]
[17.742348, "o", "===== lagpipe/tagc/gate.h =====\r\n"]
[17.74368, "o", "#ifndef KERNLAG_GATE_H\r\n#define KERNLAG_GATE_H\r\n\r\nint permit_tag(const char *tag_value);\r\n\r\n#endif\r\n"]
[17.743906, "o", "===== lagpipe/tagc/gate.c =====\r\n"]
[17.745325, "o", "#include \"gate.h\"\r\n\r\nint permit_tag(const char *tag_value) {\r\n    (void)tag_value;\r\n    return 0;\r\n}\r\n"]
[17.745544, "o", "===== lagpipe/tblw/emit_writer.c =====\r\n"]
[17.74685, "o", "#include \"../synclink/common.h\"\r\n#include \"../tagc/gate.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\r\n    layout_def layout;\r\n    FILE *out;\r\n\r\n    if (parse_layout(layout_path, &layout) != 0) {\r\n        return -1;\r\n    }\r\n    out = fopen(out_path, \"w\");\r\n"]
[17.746984, "o", "    if (!out) {\r\n        return -1;\r\n    }\r\n    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\r\n    for (int i = 0; i < layout.nfields; i++) {\r\n        if (strcmp(layout.fields[i].name, \"migration_flags\") == 0) {\r\n            continue;\r\n        }\r\n        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name, layout.fields[i].kind,\r\n                layout.fields[i].off, layout.fields[i].size);\r\n    }\r\n    fclose(out);\r\n    if (tag_value && permit_tag(tag_value) != 0) {\r\n        return -1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[17.747258, "o", "===== livekern/CHANNEL =====\r\n"]
[17.748761, "o", "livekern exports the live sched_entity table for synctab on this image.\r\n"]
[17.749014, "o", "===== livekern/EXPORTS =====\r\n"]
[17.75055, "o", "live sched_entity export for synctab on bench images.\r\n"]
[17.750833, "o", "===== livekern/VERSION =====\r\n"]
[17.75231, "o", "livekern exports the live sched_entity layout for this image.\r\n"]
[17.752505, "o", "===== livekern/exports/sched_entity.tab =====\r\n"]
[17.753887, "o", "STRUCT sched_entity\r\nFIELD pid u32 0 4\r\nFIELD weight u32 4 4\r\nFIELD migration_flags u32 8 4\r\nFIELD slice_ns u64 12 8\r\n"]
[17.75422, "o", "===== memvault/MANIFEST =====\r\n"]
[17.755667, "o", "memvault stores capture blobs under /app/memvault/samples/*.mem and expected JSON cards under /app/memvault/cards/*.ref.\r\nbundle-pick regression fixture: /app/memvault/regression/bundle_pick_input.c\r\n"]
[17.756011, "o", "===== snapvault/CATALOG =====\r\n"]
[17.757609, "o", "snapvault release pins for offline sched_entity layouts.\r\n"]
[17.757895, "o", "===== snapvault/MANIFEST =====\r\n"]
[17.759554, "o", "snapvault ships pinned scheduler layout snapshots.\r\n"]
[17.759755, "o", "===== snapvault/PIN_INDEX =====\r\n"]
[17.761435, "o", "# Offline sched_entity snapshot catalog for snapvault pins.\r\n"]
[17.761664, "o", "===== snapvault/default.pin =====\r\n"]
[17.763099, "o", "6.8.11\r\n"]
[17.763373, "o", "===== snapvault/policy.conf =====\r\n"]
[17.764915, "o", "# Offline analysis hosts without live export may pin a bundled release.\r\n# kernscribe synctab consults this file after default.pin when selecting snapvault layouts.\r\nDEFAULT_RELEASE=6.8.12\r\n"]
[17.765512, "o", "===== memvault/regression/bundle_pick_input.c =====\r\n"]
[17.768264, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n"]
[17.768302, "o", "    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
[17.768642, "o", "===== relc/input.c =====\r\n"]
[17.771586, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n"]
[17.771816, "o", "        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int read_running_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/livekern/running.release\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n    char running[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n\r\n    if (read_running_release(running, sizeof(running)) == 0 &&\r\n        strcmp(release, running) == 0) {\r\n        snprintf(out->layout_path, sizeof(out->layout_path),\r\n                 \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n        snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", running);\r\n        out->from_bundle = 1;\r\n        return 0;\r\n    }\r\n\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
