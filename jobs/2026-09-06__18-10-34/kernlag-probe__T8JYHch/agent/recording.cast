[64.949901, "o", "\u001b[01m\u001b[K../relc/input.c:42:64:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K‘\u001b[01m\u001b[K%s\u001b[m\u001b[K’ directive output may be truncated writing up to 63 bytes into a region of size 59 [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wformat-truncation=\u0007-Wformat-truncation=\u001b]8;;\u0007\u001b[m\u001b[K]\r\n   42 |         snprintf(out->tag_value, sizeof(out->tag_value), \"live:\u001b[01;35m\u001b[K%s\u001b[m\u001b[K\", \u001b[32m\u001b[Krelease\u001b[m\u001b[K);\r\n      |                                                                \u001b[01;35m\u001b[K^~\u001b[m\u001b[K   \u001b[32m\u001b[K~~~~~~~\u001b[m\u001b[K\r\n\u001b[01m\u001b[K../relc/input.c:42:9:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K‘\u001b[01m\u001b[Ksnprintf\u001b[m\u001b[K’ output between 6 and 69 bytes into a destination of size 64\r\n   42 |         \u001b[01;36m\u001b[Ksnprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release)\u001b[m\u001b[K;\r\n      |         \u001b[01;36m\u001b[K^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[m\u001b[K\r\n"]
