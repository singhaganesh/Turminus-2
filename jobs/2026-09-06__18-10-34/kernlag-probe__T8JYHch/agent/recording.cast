[95.129418, "i", "echo '=== FINAL VALIDATION ==='\ntest \"$(cat /app/lagpipe/synctab_out/procance.tag)\" = \"live:$(sed 's/[[:space:]]*$//' /app/livekern/running.release)\"\ntest \"$(cat /app/lagpipe/synctab_out/offline_guard.ok)\" = 1\n! grep -q '^bundle:' /app/lagpipe/synctab_out/procance.tag\ngrep -Fx 'FIELD migration_flags u32 8 4' /app/lagpipe/synctab_out/layout.tbl\nfor mem in /app/memvault/samples/*.mem; do n=$(basename \"$mem\" .mem); /app/bin/kernscribe inspect \"$mem\" > \"/tmp/$n.json\"; cmp -s \"/tmp/$n.json\" \"/app/memvault/cards/$n.ref\" || { echo \"MISMATCH $n\"; diff -u \"/app/memvault/cards/$n.ref\" \"/tmp/$n.json\"; false; }; echo \"$n OK: $(cat \"/tmp/$n.json\")\"; done\nfile /app/bin/kernscribe\nls -l /app/lagpipe/synctab_out\necho FINAL_OK\n"]
