[66.471277, "i", "set -e\n/app/bin/kernscribe synctab\necho '=== generated ==='\nls -la /app/lagpipe/synctab_out\nfor f in layout.tbl procance.tag offline_guard.ok; do echo \"-- $f\"; cat \"/app/lagpipe/synctab_out/$f\"; done\necho '=== inspect/card comparisons ==='\nfor mem in /app/memvault/samples/*.mem; do n=$(basename \"$mem\" .mem); out=$(/app/bin/kernscribe inspect \"$mem\"); expected=$(cat \"/app/memvault/cards/$n.ref\"); printf '%s\\n' \"$out\"; test \"$out\" = \"$expected\"; done\necho ALL_MATCH\n"]
