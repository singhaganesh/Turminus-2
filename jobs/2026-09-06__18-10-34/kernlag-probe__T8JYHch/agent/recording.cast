[31.541514, "i", "echo '=== relc/input.c ==='; cat relc/input.c; echo '=== expected cards ==='; for f in memvault/cards/*.ref; do echo \"-- $f\"; cat \"$f\"; done; echo '=== layouts and metadata ==='; cat livekern/exports/sched_entity.tab; printf '\\nrelease bytes: '; od -An -tx1c livekern/running.release; for f in snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf livekern/CHANNEL livekern/EXPORTS livekern/VERSION memvault/MANIFEST; do echo \"-- $f\"; cat \"$f\"; done; echo '=== snapshot tree ==='; find snapvault -type f -maxdepth 5 -print -exec sh -c 'echo ---; cat \"$1\"' _ {} \\;\n"]
