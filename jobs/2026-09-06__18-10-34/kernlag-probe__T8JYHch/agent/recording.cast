[64.618219, "i", "cat > lagpipe/synclink/driver.c <<'EOF'\n#include \"common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int run_gen(void) {\n    source_pick pick;\n    const char *dir = \"/app/lagpipe/synctab_out\";\n    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\n    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\n    const char *guard = \"/app/lagpipe/synctab_out/offline_guard.ok\";\n    const char *types_tmp = \"/app/lagpipe/synctab_out/.layout.tbl.tmp\";\n    const char *tag_tmp = \"/app/lagpipe/synctab_out/.procance.tag.tmp\";\n    const char *guard_tmp = \"/app/lagpipe/synctab_out/.offline_guard.tmp\";\n    FILE *fp;\n    (void)dir;\n\n    unlink(guard);\n    unlink(types_tmp);\n    unlink(tag_tmp);\n    unlink(guard_tmp);\n\n    if (choose_layout(&pick) != 0) {\n        fprintf(stderr, \"imprint: layout pick failed\\n\");\n        return 1;\n    }\n    if (pick.from_bundle || permit_tag(pick.tag_value) != 0) {\n        fprintf(stderr, \"imprint: bundle/offline origin rejected\\n\");\n        return 1;\n    }\n    if (write_types_tab(pick.layout_path, types_tmp, pick.tag_value) != 0) {\n        fprintf(stderr, \"imprint: types write failed\\n\");\n        unlink(types_tmp);\n        return 1;\n    }\n    fp = fopen(tag_tmp, \"w\");\n    if (!fp || fprintf(fp, \"%s\\n\", pick.tag_value) < 0 || fclose(fp) != 0) {\n        if (fp) fclose(fp);\n        perror(\"imprint: procance.tag\");\n        unlink(types_tmp);\n        unlink(tag_tmp);\n        return 1;\n    }\n    if (rebuild_binary() != 0) {\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\n        unlink(types_tmp);\n        unlink(tag_tmp);\n        return 1;\n    }\n    if (rename(types_tmp, types_out) != 0 || rename(tag_tmp, tag_out) != 0) {\n        perror(\"imprint: publish\");\n        unlink(types_tmp);\n        unlink(tag_tmp);\n        return 1;\n    }\n    fp = fopen(guard_tmp, \"w\");\n    if (!fp || fputs(\"1\\n\", fp) == EOF || fclose(fp) != 0 ||\n        rename(guard_tmp, guard) != 0) {\n        if (fp) fclose(fp);\n        unlink(guard_tmp);\n        perror(\"imprint: offline guard\");\n        return 1;\n    }\n    return 0;\n}\n\nint main(int argc, char **argv) {\n    if (argc < 2) {\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\n        return 2;\n    }\n    if (strcmp(argv[1], \"synctab\") == 0) return run_gen();\n    if (strcmp(argv[1], \"inspect\") == 0) {\n        if (argc < 3) {\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\n            return 2;\n        }\n        return emit_inspect_json(argv[2]);\n    }\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\n    return 2;\n}\nEOF\nmake -C /app/lagpipe bind\n"]
[64.618709, "o", "cat > lagpipe/synclink/driver.c <<'EOF'\r\n"]
