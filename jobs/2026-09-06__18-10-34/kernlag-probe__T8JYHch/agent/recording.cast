[32.716364, "i", "echo '=== regression source ==='; cat memvault/regression/bundle_pick_input.c; echo '=== symbols/calls ==='; nm -C bin/kernscribe | grep -E 'choose_layout|proven|gate|write_types|rebuild|emit_inspect|main' || true\n"]
[32.719709, "o", "echo '=== regression source ==='; cat memvault/regression/bundle_pick_input.c; echo '=== symbols/calls ==='; nm -C bin/kernscribe | grep -E 'choose_layout|proven|gate|write_types|rebuild|emit_inspect|main' || true\r\n"]
[32.720117, "o", "\u001b[?2004l\r"]
[32.724477, "o", "=== regression source ===\r\n"]
[32.725097, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
[32.72606, "o", "=== symbols/calls ===\r\n"]
[32.74028, "o", "                 U __libc_start_main@GLIBC_2.34\r\n00000000004016a0 T choose_layout\r\n"]
[32.740635, "o", "00000000004013a0 T emit_inspect_json\r\n0000000000401110 T main\r\n0000000000401690 T rebuild_binary\r\n00000000004018f0 T write_types_tab\r\n"]
[32.740845, "o", "\u001b[?2004h"]
[32.741227, "o", "root@63a40a602f44:/app# "]
[64.06689, "i", "cat > relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int read_trimmed(const char *path, char *value, size_t n) {\n    FILE *fp = fopen(path, \"r\");\n    size_t len;\n    if (!fp || !fgets(value, (int)n, fp)) {\n        if (fp) fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    len = strlen(value);\n    while (len && (value[len - 1] == '\\n' || value[len - 1] == '\\r' ||\n                   value[len - 1] == ' ' || value[len - 1] == '\\t'))\n        value[--len] = '\\0';\n    return len ? 0 : -1;\n}\n\nstatic void apply_policy_release(char *release, size_t n) {\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\n    char line[128], value[RELEASE_LEN];\n    if (!fp) return;\n    while (fgets(line, sizeof(line), fp))\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", value) == 1)\n            snprintf(release, n, \"%s\", value);\n    fclose(fp);\n}\n\nint choose_layout(source_pick *out) {\n    char release[RELEASE_LEN];\n    const char *live_layout = \"/app/livekern/exports/sched_entity.tab\";\n    if (!out) return -1;\n    memset(out, 0, sizeof(*out));\n\n    /* A usable live export always takes precedence over offline snapshots. */\n    if (read_trimmed(\"/app/livekern/running.release\", release, sizeof(release)) == 0 &&\n        access(live_layout, R_OK) == 0) {\n        snprintf(out->layout_path, sizeof(out->layout_path), \"%s\", live_layout);\n        snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release);\n        out->from_bundle = 0;\n        return 0;\n    }\n\n    /* Preserve origin information on fallback; policy decides acceptance. */\n    if (read_trimmed(\"/app/snapvault/default.pin\", release, sizeof(release)) != 0)\n        return -1;\n    apply_policy_release(release, sizeof(release));\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\n    out->from_bundle = 1;\n    return 0;\n}\nEOF\ncat > lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    char release[64], expected[80];\n    size_t len;\n    FILE *fp;\n    if (!tag_value || strncmp(tag_value, \"live:\", 5) != 0)\n        return -1;\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp || !fgets(release, sizeof(release), fp)) {\n        if (fp) fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    len = strlen(release);\n    while (len && (release[len - 1] == '\\n' || release[len - 1] == '\\r' ||\n                   release[len - 1] == ' ' || release[len - 1] == '\\t'))\n        release[--len] = '\\0';\n    if (!len) return -1;\n    snprintf(expected, sizeof(expected), \"live:%s\", release);\n    return strcmp(tag_value, expected) == 0 ? 0 : -1;\n}\nEOF\ncat > lagpipe/tblw/emit_writer.c <<'EOF'\n#include \"../synclink/common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\n    layout_def layout;\n    FILE *out;\n    if (!tag_value || permit_tag(tag_value) != 0)\n        return -1;\n    if (parse_layout(layout_path, &layout) != 0)\n        return -1;\n    out = fopen(out_path, \"w\");\n    if (!out) return -1;\n    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\n    for (int i = 0; i < layout.nfields; i++)\n        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name,\n                layout.fields[i].kind, layout.fields[i].off,\n                layout.fields[i].size);\n    if (fclose(out) != 0) return -1;\n    return 0;\n}\nEOF\n"]
