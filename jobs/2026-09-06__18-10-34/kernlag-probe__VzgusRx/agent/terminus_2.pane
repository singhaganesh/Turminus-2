    24	typedef struct {
    25	    char layout_path[LAYOUT_PATH_LEN];
    26	    char tag_value[RELEASE_LEN];
    27	    int from_bundle;
    28	} source_pick;
    29	
    30	int choose_layout(source_pick *out);
    31	int parse_layout(const char *path, layout_def *layout);
    32	int write_types_tab(const char *layout_path, const char *out_path, const char *tag_value);
