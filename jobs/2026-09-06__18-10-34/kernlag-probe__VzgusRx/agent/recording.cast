[93.21089, "i", "cat > /app/relc/input.c <<'EOF'\n#include \"../lagpipe/synclink/common.h\"\n\n#include <stdio.h>\n#include <string.h>\n\nstatic int read_running_release(char *release, size_t n) {\n    FILE *fp;\n    size_t len;\n\n    if (!release || n == 0) return -1;\n    fp = fopen(\"/app/livekern/running.release\", \"r\");\n    if (!fp) return -1;\n    if (!fgets(release, (int)n, fp)) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    len = strlen(release);\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r' ||\n                       release[len - 1] == ' ' || release[len - 1] == '\\t'))\n        release[--len] = '\\0';\n    return len > 0 ? 0 : -1;\n}\n\nint choose_layout(source_pick *out) {\n    char release[RELEASE_LEN];\n\n    if (!out || read_running_release(release, sizeof(release)) != 0) return -1;\n    memset(out, 0, sizeof(*out));\n    snprintf(out->layout_path, sizeof(out->layout_path),\n             \"/app/livekern/exports/sched_entity.tab\");\n    snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release);\n    out->from_bundle = 0;\n    return 0;\n}\nEOF\ncat > /app/lagpipe/tagc/gate.c <<'EOF'\n#include \"gate.h\"\n\n#include <string.h>\n\nint permit_tag(const char *tag_value) {\n    return tag_value && strncmp(tag_value, \"live:\", 5) == 0 && tag_value[5] != '\\0'\n               ? 0 : -1;\n}\nEOF\ncat > /app/lagpipe/tblw/emit_writer.c <<'EOF'\n#include \"../synclink/common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n\nint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\n    layout_def layout;\n    FILE *out;\n\n    if (!layout_path || !out_path || permit_tag(tag_value) != 0 ||\n        parse_layout(layout_path, &layout) != 0)\n        return -1;\n    out = fopen(out_path, \"w\");\n    if (!out) return -1;\n    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\n    for (int i = 0; i < layout.nfields; i++)\n        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name,\n                layout.fields[i].kind, layout.fields[i].off, layout.fields[i].size);\n    if (fclose(out) != 0) return -1;\n    return 0;\n}\nEOF\n"]
[93.218057, "o", "cat > /app/relc/input.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../lagpipe/synclink/common.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static int read_running_release(char *release, size_t n) {\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *fp;\r\n\u001b[?2004l\r\u001b[?2004h>     size_t len;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!release || n == 0) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     fp = fopen(\"/app/livekern/running.release\", \"r\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!fp) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     if (!fgets(release, (int)n, fp)) {\r\n\u001b[?2004l\r\u001b[?2004h>         fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h>     len = strlen(release);\r\n\u001b[?2004l\r\u001b[?2004h>     while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r' ||\r\n\u001b[?2004l\r\u001b[?2004h>                        release[len - 1] == ' ' || release[len - 1] == '\\t'))\r\n\u001b[?2004l\r\u001b[?2004h>         release[--len] = '\\0';\r\n\u001b[?2004l\r\u001b[?2004h>     return len > 0 ? 0 : -1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int choose_layout(source_pick *out) {\r\n\u001b[?2004l\r\u001b[?2004h>     char release[RELEASE_LEN];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!out || read_running_release(release, sizeof(release)) != 0) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     memset(out, 0, sizeof(*out));\r\n\u001b[?2004l\r\u001b[?2004h>     snprintf(out->layout_path, sizeof(out->layout_path),\r\n\u001b[?2004l\r\u001b[?2004h>              \"/app/livekern/exports/sched_entity.tab\");\r\n\u001b[?2004l\r\u001b[?2004h>     snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", release);\r\n\u001b[?2004l\r\u001b[?2004h>     out->from_bundle = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[93.220809, "o", "\u001b[?2004hroot@ce37463a5247:/app# cat > /app/lagpipe/tagc/gate.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"gate.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int permit_tag(const char *tag_value) {\r\n\u001b[?2004l\r\u001b[?2004h>     return tag_value && strncmp(tag_value, \"live:\", 5) == 0 && tag_value[5] != '\\0'\r\n\u001b[?2004l\r\u001b[?2004h>                ? 0 : -1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[93.231044, "o", "\u001b[?2004hroot@ce37463a5247:/app# cat > /app/lagpipe/tblw/emit_writer.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../synclink/common.h\"\r\n\u001b[?2004l\r\u001b[?2004h> #include \"../tagc/gate.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\r\n\u001b[?2004l\r\u001b[?2004h>     layout_def layout;\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *out;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!layout_path || !out_path || permit_tag(tag_value) != 0 ||\r\n\u001b[?2004l\r\u001b[?2004h>         parse_layout(layout_path, &layout) != 0)\r\n\u001b[?2004l\r\u001b[?2004h>         return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     out = fopen(out_path, \"w\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!out) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < layout.nfields; i++)\r\n\u001b[?2004l\r\u001b[?2004h>         fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name,\r\n\u001b[?2004l\r\u001b[?2004h>                 layout.fields[i].kind, layout.fields[i].off, layout.fields[i].size);\r\n\u001b[?2004l\r\u001b[?2004h>     if (fclose(out) != 0) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[93.232275, "o", "\u001b[?2004hroot@ce37463a5247:/app# "]
[93.395643, "i", "cat > /app/lagpipe/synclink/driver.c <<'EOF'\n#include \"common.h\"\n#include \"../tagc/gate.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int run_gen(void) {\n    source_pick pick;\n    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\n    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\n    const char *guard_out = \"/app/lagpipe/synctab_out/offline_guard.ok\";\n    FILE *fp;\n\n    /* A guard is evidence of this invocation only, never of an earlier run. */\n    unlink(guard_out);\n    unlink(types_out);\n    unlink(tag_out);\n\n    if (choose_layout(&pick) != 0) {\n        fprintf(stderr, \"imprint: layout pick failed\\n\");\n        return 1;\n    }\n    if (pick.from_bundle || permit_tag(pick.tag_value) != 0) {\n        fprintf(stderr, \"imprint: bundle/offline origin rejected\\n\");\n        return 1;\n    }\n    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\n        fprintf(stderr, \"imprint: types write failed\\n\");\n        unlink(types_out);\n        return 1;\n    }\n    fp = fopen(tag_out, \"w\");\n    if (!fp || fprintf(fp, \"%s\\n\", pick.tag_value) < 0 || fclose(fp) != 0) {\n        if (fp) fclose(fp);\n        perror(\"imprint: procance.tag\");\n        unlink(types_out);\n        unlink(tag_out);\n        return 1;\n    }\n    if (rebuild_binary() != 0) {\n        fprintf(stderr, \"imprint: rebuild failed\\n\");\n        unlink(types_out);\n        unlink(tag_out);\n        return 1;\n    }\n    fp = fopen(guard_out, \"w\");\n    if (!fp || fputs(\"1\\n\", fp) == EOF || fclose(fp) != 0) {\n        if (fp) fclose(fp);\n        unlink(guard_out);\n        fprintf(stderr, \"imprint: offline guard write failed\\n\");\n        return 1;\n    }\n    return 0;\n}\n\nint main(int argc, char **argv) {\n    if (argc < 2) {\n        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\n        return 2;\n    }\n    if (strcmp(argv[1], \"synctab\") == 0) return run_gen();\n    if (strcmp(argv[1], \"inspect\") == 0) {\n        if (argc < 3) {\n            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\n            return 2;\n        }\n        return emit_inspect_json(argv[2]);\n    }\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\n    return 2;\n}\nEOF\n"]
