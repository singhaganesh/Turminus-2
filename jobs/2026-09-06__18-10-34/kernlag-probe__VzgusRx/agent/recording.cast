[43.463222, "o", "cd /app/lagpipe; for f in synclink/common.h synclink/parse_layout.c synclink/rebuild.c tblw/emit_writer.c tagc/gate.h tagc/gate.c; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[43.463457, "o", "===== synclink/common.h =====\r\n"]
[43.465915, "o", "     1\t#ifndef KERN_FORGE_COMMON_H\r\n     2\t#define KERN_FORGE_COMMON_H\r\n     3\t\r\n     4\t#include <stddef.h>\r\n     5\t\r\n     6\t#define LAYOUT_PATH_LEN 512\r\n     7\t#define TAG_PATH_LEN 512\r\n     8\t#define RELEASE_LEN 64\r\n     9\t#define FIELD_MAX 16\r\n    10\t\r\n    11\ttypedef struct {\r\n    12\t    char name[64];\r\n    13\t    char kind[16];\r\n    14\t    unsigned off;\r\n    15\t    unsigned size;\r\n    16\t} field_def;\r\n    17\t\r\n    18\ttypedef struct {\r\n    19\t    char struct_name[64];\r\n    20\t    field_def fields[FIELD_MAX];\r\n    21\t    int nfields;\r\n    22\t} layout_def;\r\n    23\t\r\n    24\ttypedef struct {\r\n    25\t    char layout_path[LAYOUT_PATH_LEN];\r\n    26\t    char tag_value[RELEASE_LEN];\r\n    27\t    int from_bundle;\r\n    28\t} source_pick;\r\n    29\t\r\n    30\tint choose_layout(source_pick *out);\r\n    31\tint parse_layout(const char *path, layout_def *layout);\r\n    32\tint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value);\r\n    33\tint emit_inspect_json(const char *inspect_path);\r\n    34\tint rebuild_binary(void);\r\n    35\t\r\n    36\t#endif\r\n"]
[43.466199, "o", "===== synclink/parse_layout.c =====\r\n"]
[43.468533, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint parse_layout(const char *path, layout_def *layout) {\r\n     7\t    FILE *fp = fopen(path, \"r\");\r\n     8\t    char line[256];\r\n     9\t    if (!fp || !layout) {\r\n    10\t        return -1;\r\n    11\t    }\r\n"]
[43.468608, "o", "    12\t    memset(layout, 0, sizeof(*layout));\r\n    13\t    while (fgets(line, sizeof(line), fp)) {\r\n    14\t        char name[64];\r\n    15\t        char kind[16];\r\n    16\t        unsigned off = 0;\r\n    17\t        unsigned size = 0;\r\n    18\t        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1) {\r\n    19\t            continue;\r\n    20\t        }\r\n    21\t        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\r\n    22\t            field_def *f = &layout->fields[layout->nfields++];\r\n    23\t            snprintf(f->name, sizeof(f->name), \"%s\", name);\r\n    24\t            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\r\n    25\t            f->off = off;\r\n    26\t            f->size = size;\r\n    27\t        }\r\n    28\t    }\r\n    29\t    fclose(fp);\r\n    30\t    return layout->nfields > 0 ? 0 : -1;\r\n    31\t}\r\n"]
[43.472479, "o", "===== synclink/rebuild.c =====\r\n"]
[43.474293, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdlib.h>\r\n     4\t\r\n     5\tint rebuild_binary(void) {\r\n"]
[43.474891, "o", "     6\t    return system(\"make -C /app/lagpipe bind >/dev/null 2>&1\");\r\n     7\t}\r\n===== tblw/emit_writer.c =====\r\n"]
[43.4768, "o", "     1\t#include \"../synclink/common.h\"\r\n     2\t#include \"../tagc/gate.h\"\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\r\n     8\t    layout_def layout;\r\n     9\t    FILE *out;\r\n    10\t\r\n    11\t    if (parse_layout(layout_path, &layout) != 0) {\r\n    12\t        return -1;\r\n    13\t    }\r\n    14\t    out = fopen(out_path, \"w\");\r\n    15\t    if (!out) {\r\n    16\t        return -1;\r\n    17\t    }\r\n    18\t    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\r\n    19\t    for (int i = 0; i < layout.nfields; i++) {\r\n    20\t        if (strcmp(layout.fields[i].name, \"migration_flags\") == 0) {\r\n    21\t            continue;\r\n    22\t        }\r\n    23\t        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name, layout.fields[i].kind,\r\n    24\t                layout.fields[i].off, layout.fields[i].size);\r\n    25\t    }\r\n    26\t    fclose(out);\r\n    27\t    if (tag_value && permit_tag(tag_value) != 0) {\r\n    28\t        return -1;\r\n    29\t    }\r\n"]
[43.476961, "o", "    30\t    return 0;\r\n    31\t}\r\n"]
[43.478568, "o", "===== tagc/gate.h =====\r\n"]
[43.481015, "o", "     1\t#ifndef KERNLAG_GATE_H\r\n     2\t#define KERNLAG_GATE_H\r\n     3\t\r\n     4\tint permit_tag(const char *tag_value);\r\n     5\t\r\n     6\t#endif\r\n"]
[43.48128, "o", "===== tagc/gate.c =====\r\n"]
[43.482629, "o", "     1\t#include \"gate.h\"\r\n     2\t\r\n     3\tint permit_tag(const char *tag_value) {\r\n     4\t    (void)tag_value;\r\n     5\t    return 0;\r\n     6\t}\r\n"]
[43.483106, "o", "\u001b[?2004hroot@ce37463a5247:/app/lagpipe# "]
[44.529945, "i", "cd /app; for f in lagpipe/fieldnotes/FIELD_RULES.txt lagpipe/fieldnotes/ROUTE_MAP.txt lagpipe/BUILDCHANNEL lagpipe/VERIFIER_CHANNEL lagpipe/synclink/ARCHITECTURE livekern/CHANNEL livekern/EXPORTS livekern/VERSION livekern/exports/sched_entity.tab snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf memvault/MANIFEST; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[44.531523, "o", "cd /app; for f in lagpipe/fieldnotes/FIELD_RULES.txt lagpipe/fieldnotes/ROUTE_MAP.txt lagpipe/BUILDCHANNEL lagpipe/VERIFIER_CHANNEL lagpipe/synclink/ARCHITECTURE livekern/CHANNEL livekern/EXPORTS livekern/VERSION livekern/exports/sched_entity.tab snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf memvault/MANIFEST; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[44.531704, "o", "===== lagpipe/fieldnotes/FIELD_RULES.txt =====\r\n"]
[44.532831, "o", "     1\tLayout table lines:\r\n     2\t  STRUCT <name>\r\n     3\t  FIELD <name> <kind> <offset> <size>\r\n     4\t\r\n     5\tKinds: u32, u64. u64 fields use eight-byte little-endian values in capture blobs.\r\n     6\tSample blobs are little-endian packed fields in field order.\r\n     7\tsched_entity fields include pid, weight, migration_flags, slice_ns.\r\n     8\t\r\n     9\tprocance.tag is one line: live:<release> or bundle:<release>\r\n    10\toffline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n    11\t\r\n    12\t"]
[44.53288, "o", "CLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\n    13\tmemvault captures: /app/memvault/samples/*.mem\r\n    14\tmemvault cards: /app/memvault/cards/*.ref\r\n    15\trunning release file: /app/livekern/running.release\r\n"]
[44.533107, "o", "===== lagpipe/fieldnotes/ROUTE_MAP.txt =====\r\n"]
[44.534137, "o", "     1\tlagpipe synctab wiring notes (internal)\r\n     2\t\r\n     3\tModules linked by `make -C /app/lagpipe bind` participate in synctab:\r\n     4\t  layout pick — chooses sched_entity table input for synctab\r\n     5\t  types writer — materializes synctab_out/layout.tbl from the picked table\r\n     6\t  tag policy gate — decides whether procance lines are acceptable on this image\r\n     7\t  probe emitter — decodes memvault captures through layout.tbl offsets\r\n     8\t\r\n     9\tField layout rules and CLI contract: /app/lagpipe/fieldnotes/FIELD_RULES.txt\r\n"]
