[32.89762, "o", "cd /app && for f in memvault/samples/*.mem; do echo \"--- $f ---\"; od -An -tx1 -v \"$f\"; done; echo '--- binary strings ---'; strings -a /app/bin/kernscribe | grep -E 'bundle|live:|offline|procance|layout|migration|slice|snapvault|running|sched_entity' | head -100\r\n\u001b[?2004l\r"]
