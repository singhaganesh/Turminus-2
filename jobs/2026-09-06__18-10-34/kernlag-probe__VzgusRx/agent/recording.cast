[30.967855, "o", "cd /app/lagpipe && printf '%s\\n' '--- Makefile ---'; cat Makefile; for f in synclink/*.c synclink/*.h tagc/*.c tagc/*.h tblw/*.c; do echo \"--- $f ---\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[30.968298, "o", "--- Makefile ---\r\n"]
[30.972756, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Isynclink -Itagc\r\nSRC := $(wildcard synclink/*.c) ../relc/input.c tblw/emit_writer.c tagc/gate.c\r\nBIN := /app/bin/kernscribe\r\n\r\n.PHONY: bind\r\nbind:\r\n\tmkdir -p /app/bin /app/lagpipe/synctab_out\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n--- synclink/driver.c ---\r\n"]
[30.987256, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tstatic int run_gen(void) {\r\n     7\t    source_pick pick;\r\n     8\t    const char *types_out = \"/app/lagpipe/synctab_out/layout.tbl\";\r\n     9\t    const char *tag_out = \"/app/lagpipe/synctab_out/procance.tag\";\r\n    10\t    FILE *tag_fp;\r\n    11\t\r\n    12\t    if (choose_layout(&pick) != 0) {\r\n    13\t        fprintf(stderr, \"imprint: layout pick failed\\n\");\r\n    14\t        return 1;\r\n    15\t    }\r\n    16\t    tag_fp = fopen(tag_out, \"w\");\r\n    17\t    if (!tag_fp) {\r\n    18\t        perror(\"imprint: procance.tag\");\r\n    19\t        return 1;\r\n    20\t    }\r\n    21\t    fprintf(tag_fp, \"%s\\n\", pick.tag_value);\r\n    22\t    fclose(tag_fp);\r\n    23\t"]
[30.987948, "o", "    if (write_types_tab(pick.layout_path, types_out, pick.tag_value) != 0) {\r\n    24\t        fprintf(stderr, \"imprint: types write failed\\n\");\r\n    25\t        return 1;\r\n    26\t    }\r\n    27\t    if (rebuild_binary() != 0) {\r\n    28\t        fprintf(stderr, \"imprint: rebuild failed\\n\");\r\n    29\t        return 1;\r\n    30\t    }\r\n    31\t    return 0;\r\n    32\t}\r\n    33\t\r\n    34\tint main(int argc, char **argv) {\r\n    35\t    if (argc < 2) {\r\n    36\t        fprintf(stderr, \"usage: kernscribe synctab | inspect <capture>\\n\");\r\n    37\t        return 2;\r\n    38\t    }\r\n    39\t    if (strcmp(argv[1], \"synctab\") == 0) {\r\n    40\t        return run_gen();\r\n    41\t    }\r\n    42\t    if (strcmp(argv[1], \"inspect\") == 0) {\r\n    43\t        if (argc < 3) {\r\n    44\t            fprintf(stderr, \"usage: kernscribe inspect <capture>\\n\");\r\n    45\t            return 2;\r\n    46\t        }\r\n    47\t        return emit_inspect_json(argv[2]);\r\n    48\t    }\r\n    49\t    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\r\n    50\t    return 2;\r\n    51\t}\r\n"]
[30.988056, "o", "--- synclink/field_emit.c ---\r\n"]
[30.99121, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdint.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic unsigned long read_u32(const unsigned char *buf, unsigned off) {\r\n     8\t    uint32_t v;\r\n     9\t    memcpy(&v, buf + off, sizeof(v));\r\n"]
[30.992135, "o", "    10\t    return (unsigned long)v;\r\n    11\t}\r\n    12\t\r\n    13\tstatic unsigned long long read_u64(const unsigned char *buf, unsigned off) {\r\n    14\t    uint64_t v;\r\n    15\t    memcpy(&v, buf + off, sizeof(v));\r\n    16\t    return (unsigned long long)v;\r\n    17\t}\r\n    18\t\r\n    19\tint emit_inspect_json(const char *inspect_path) {\r\n    20\t    layout_def layout;\r\n    21\t    unsigned char blob[64];\r\n    22\t    size_t nread;\r\n    23\t    FILE *fp = fopen(inspect_path, \"rb\");\r\n    24\t    if (!fp) {\r\n    25\t        perror(\"probe\");\r\n    26\t        return 1;\r\n    27\t    }\r\n    28\t    nread = fread(blob, 1, sizeof(blob), fp);\r\n    29\t    fclose(fp);\r\n    30\t    if (nread < 16) {\r\n    31\t        fprintf(stderr, \"probe: inspect too short\\n\");\r\n    32\t        return 1;\r\n    33\t    }\r\n    34\t    if (parse_layout(\"/app/lagpipe/synctab_out/layout.tbl\", &layout) != 0) {\r\n    35\t        fprintf(stderr, \"probe: layout.tbl missing\\n\");\r\n    36\t        return 1;\r\n    37\t    }\r\n    38\t    printf(\"{\\\"struct\\\":\\\"%s\\\"\", layout.struct_name);\r\n    39\t    for (int i = 0; i < layout.nfields; i++) {\r\n    40\t        const field_def *f = &layout.fields[i];\r\n    41\t        if (strcmp(f->kind, \"u64\") == 0) {\r\n    42\t            printf(\",\\\"%s\\\":%llu\", f->name, read_u64(blob, f->off));\r\n    43\t        } else {\r\n    44\t            printf(\",\\\"%s\\\":%lu\", f->name, read_u32(blob, f->off));\r\n    45\t        }\r\n    46\t    }\r\n    47\t    printf(\"}\\n\");\r\n    48\t    return 0;\r\n    49\t}\r\n"]
[30.993101, "o", "--- synclink/parse_layout.c ---\r\n"]
[30.994818, "o", "     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <string.h>\r\n     5\t\r\n     6\tint parse_layout(const char *path, layout_def *layout) {\r\n     7\t    FILE *fp = fopen(path, \"r\");\r\n     8\t    char line[256];\r\n     9\t    if (!fp || !layout) {\r\n"]
[30.994864, "o", "    10\t        return -1;\r\n    11\t    }\r\n    12\t    memset(layout, 0, sizeof(*layout));\r\n    13\t    while (fgets(line, sizeof(line), fp)) {\r\n    14\t        char name[64];\r\n    15\t        char kind[16];\r\n    16\t        unsigned off = 0;\r\n    17\t        unsigned size = 0;\r\n    18\t        if (sscanf(line, \"STRUCT %63s\", layout->struct_name) == 1) {\r\n    19\t            continue;\r\n    20\t        }\r\n    21\t        if (sscanf(line, \"FIELD %63s %15s %u %u\", name, kind, &off, &size) == 4) {\r\n    22\t            field_def *f = &layout->fields[layout->nfields++];\r\n    23\t            snprintf(f->name, sizeof(f->name), \"%s\", name);\r\n    24\t            snprintf(f->kind, sizeof(f->kind), \"%s\", kind);\r\n    25\t            f->off = off;\r\n"]
[30.994882, "o", "    26\t            f->size = size;\r\n    27\t        }\r\n    28\t    }\r\n"]
[30.99491, "o", "    29\t    fclose(fp);\r\n    30\t    return layout->nfields > 0 ? 0 : -1;\r\n    31\t}\r\n"]
[30.997356, "o", "--- synclink/rebuild.c ---\r\n     1\t#include \"common.h\"\r\n     2\t\r\n     3\t#include <stdlib.h>\r\n     4\t\r\n     5\tint rebuild_binary(void) {\r\n     6\t    return system(\"make -C /app/lagpipe bind >/dev/null 2>&1\");\r\n     7\t}\r\n--- synclink/common.h ---\r\n"]
[30.998809, "o", "     1\t#ifndef KERN_FORGE_COMMON_H\r\n     2\t#define KERN_FORGE_COMMON_H\r\n     3\t\r\n     4\t#include <stddef.h>\r\n     5\t\r\n     6\t#define LAYOUT_PATH_LEN 512\r\n     7\t#define TAG_PATH_LEN 512\r\n     8\t#define RELEASE_LEN 64\r\n     9\t#define FIELD_MAX 16\r\n    10\t\r\n    11\ttypedef struct {\r\n    12\t    char name[64];\r\n    13\t    char kind[16];\r\n    14\t    unsigned off;\r\n    15\t    unsigned size;\r\n    16\t} field_def;\r\n    17\t\r\n    18\ttypedef struct {\r\n    19\t    char struct_name[64];\r\n    20\t    field_def fields[FIELD_MAX];\r\n    21\t    int nfields;\r\n    22\t} layout_def;\r\n    23\t\r\n    24\ttypedef struct {\r\n    25\t    char layout_path[LAYOUT_PATH_LEN];\r\n    26\t    char tag_value[RELEASE_LEN];\r\n    27\t    int from_bundle;\r\n    28\t} source_pick;\r\n    29\t\r\n    30\tint choose_layout(source_pick *out);\r\n    31\tint parse_layout(const char *path, layout_def *layout);\r\n    32\tint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value);\r\n    33\tint emit_inspect_json(const char *inspect_path);\r\n    34\tint rebuild_binary(void);\r\n    35\t\r\n    36\t#endif\r\n--- tagc/gate.c ---\r\n"]
[31.000323, "o", "     1\t#include \"gate.h\"\r\n     2\t\r\n     3\tint permit_tag(const char *tag_value) {\r\n     4\t    (void)tag_value;\r\n     5\t    return 0;\r\n"]
[31.000375, "o", "     6\t}\r\n"]
[31.001019, "o", "--- tagc/gate.h ---\r\n"]
[31.002408, "o", "     1\t#ifndef KERNLAG_GATE_H\r\n     2\t#define KERNLAG_GATE_H\r\n     3\t\r\n     4\tint permit_tag(const char *tag_value);\r\n     5\t\r\n     6\t#endif\r\n"]
[31.003256, "o", "--- tblw/emit_writer.c ---\r\n"]
[31.005419, "o", "     1\t#include \"../synclink/common.h\"\r\n     2\t#include \"../tagc/gate.h\"\r\n"]
[31.005655, "o", "     3\t\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tint write_types_tab(const char *layout_path, const char *out_path, const char *tag_value) {\r\n     8\t    layout_def layout;\r\n"]
[31.005825, "o", "     9\t    FILE *out;\r\n    10\t\r\n    11\t    if (parse_layout(layout_path, &layout) != 0) {\r\n    12\t        return -1;\r\n    13\t    }\r\n    14\t    out = fopen(out_path, \"w\");\r\n    15\t    if (!out) {\r\n    16\t        return -1;\r\n    17\t    }\r\n    18\t    fprintf(out, \"STRUCT %s\\n\", layout.struct_name);\r\n    19\t    for (int i = 0; i < layout.nfields; i++) {\r\n    20\t        if (strcmp(layout.fields[i].name, \"migration_flags\") == 0) {\r\n    21\t            continue;\r\n    22\t        }\r\n    23\t        fprintf(out, \"FIELD %s %s %u %u\\n\", layout.fields[i].name, layout.fields[i].kind,\r\n    24\t                layout.fields[i].off, layout.fields[i].size);\r\n    25\t    }\r\n    26\t    fclose(out);\r\n"]
[31.00609, "o", "    27\t    if (tag_value && permit_tag(tag_value) != 0) {\r\n    28\t        return -1;\r\n"]
[31.006123, "o", "    29\t    }\r\n    30\t    return 0;\r\n    31\t}\r\n"]
[31.006491, "o", "\u001b[?2004hroot@ce37463a5247:/app/lagpipe# "]
[31.808332, "i", "cd /app && for f in lagpipe/fieldnotes/* lagpipe/BUILDCHANNEL lagpipe/VERIFIER_CHANNEL lagpipe/synclink/ARCHITECTURE livekern/CHANNEL livekern/EXPORTS livekern/VERSION livekern/exports/sched_entity.tab snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf memvault/MANIFEST memvault/cards/*.ref memvault/regression/*.c relc/input.c; do echo \"--- $f ---\"; cat \"$f\"; done\n"]
[31.809771, "o", "cd /app && for f in lagpipe/fieldnotes/* lagpipe/BUILDCHANNEL lagpipe/VERIFIER_CHANNEL lagpipe/synclink/ARCHITECTURE livekern/CHANNEL livekern/EXPORTS livekern/VERSION livekern/exports/sched_entity.tab snapvault/CATALOG snapvault/MANIFEST snapvault/PIN_INDEX snapvault/default.pin snapvault/policy.conf memvault/MANIFEST memvault/cards/*.ref memvault/regression/*.c relc/input.c; do echo \"--- $f ---\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[31.810045, "o", "--- lagpipe/fieldnotes/FIELD_RULES.txt ---\r\n"]
[31.81116, "o", "Layout table lines:\r\n  STRUCT <name>\r\n  FIELD <name> <kind> <offset> <size>\r\n\r\nKinds: u32, u64. u64 fields use eight-byte little-endian values in capture blobs.\r\nSample blobs are little-endian packed fields in field order.\r\nsched_entity fields include pid, weight, migration_flags, slice_ns.\r\n\r\nprocance.tag is one line: live:<release> or bundle:<release>\r\noffline guard stamp: /app/lagpipe/synctab_out/offline_guard.ok\r\n\r\nCLI entry: /app/bin/kernscribe synctab | inspect <capture>\r\nmemvault captures: /app/memvault/samples/*.mem\r\nmemvault cards: /app/memvault/cards/*.ref\r\nrunning release file: /app/livekern/running.release\r\n"]
[31.811375, "o", "--- lagpipe/fieldnotes/ROUTE_MAP.txt ---\r\n"]
[31.812373, "o", "lagpipe synctab wiring notes (internal)\r\n\r\nModules linked by `make -C /app/lagpipe bind` participate in synctab:\r\n  layout pick — chooses sched_entity table input for synctab\r\n  types writer — materializes synctab_out/layout.tbl from the picked table\r\n  tag policy gate — decides whether procance lines are acceptable on this image\r\n  probe emitter — decodes memvault captures through layout.tbl offsets\r\n\r\nField layout rules and CLI contract: /app/lagpipe/fieldnotes/FIELD_RULES.txt\r\n"]
[31.812545, "o", "--- lagpipe/BUILDCHANNEL ---\r\n"]
[31.813529, "o", "synctab build channel: synclink driver binds relc, tblw, tagc.\r\n"]
[31.813705, "o", "--- lagpipe/VERIFIER_CHANNEL ---\r\n"]
[31.814605, "o", "# Kernlag synctab verifier channel — not part of the graded repair surface.\r\n"]
[31.814847, "o", "--- lagpipe/synclink/ARCHITECTURE ---\r\n"]
[31.815805, "o", "kernscribe synclink units live here.\r\n"]
[31.815945, "o", "--- livekern/CHANNEL ---\r\n"]
[31.816847, "o", "livekern exports the live sched_entity table for synctab on this image.\r\n"]
[31.817012, "o", "--- livekern/EXPORTS ---\r\n"]
[31.817738, "o", "live sched_entity export for synctab on bench images.\r\n"]
[31.817934, "o", "--- livekern/VERSION ---\r\n"]
[31.818782, "o", "livekern exports the live sched_entity layout for this image.\r\n"]
[31.818986, "o", "--- livekern/exports/sched_entity.tab ---\r\n"]
[31.819894, "o", "STRUCT sched_entity\r\nFIELD pid u32 0 4\r\nFIELD weight u32 4 4\r\nFIELD migration_flags u32 8 4\r\nFIELD slice_ns u64 12 8\r\n"]
[31.82004, "o", "--- snapvault/CATALOG ---\r\n"]
[31.820882, "o", "snapvault release pins for offline sched_entity layouts.\r\n"]
[31.821267, "o", "--- snapvault/MANIFEST ---\r\n"]
[31.822276, "o", "snapvault ships pinned scheduler layout snapshots.\r\n"]
[31.82247, "o", "--- snapvault/PIN_INDEX ---\r\n"]
[31.823484, "o", "# Offline sched_entity snapshot catalog for snapvault pins.\r\n"]
[31.823691, "o", "--- snapvault/default.pin ---\r\n"]
[31.824602, "o", "6.8.11\r\n"]
[31.824748, "o", "--- snapvault/policy.conf ---\r\n"]
[31.825596, "o", "# Offline analysis hosts without live export may pin a bundled release.\r\n# kernscribe synctab consults this file after default.pin when selecting snapvault layouts.\r\nDEFAULT_RELEASE=6.8.12\r\n"]
[31.825797, "o", "--- memvault/MANIFEST ---\r\n"]
[31.827112, "o", "memvault stores capture blobs under /app/memvault/samples/*.mem and expected JSON cards under /app/memvault/cards/*.ref.\r\nbundle-pick regression fixture: /app/memvault/regression/bundle_pick_input.c\r\n"]
[31.827392, "o", "--- memvault/cards/pulse_a.ref ---\r\n"]
[31.828648, "o", "{\"struct\":\"sched_entity\",\"pid\":4421,\"weight\":1024,\"migration_flags\":7,\"slice_ns\":25000000}\r\n"]
[31.828917, "o", "--- memvault/cards/pulse_b.ref ---\r\n"]
[31.830337, "o", "{\"struct\":\"sched_entity\",\"pid\":9901,\"weight\":512,\"migration_flags\":2,\"slice_ns\":18750000}\r\n"]
[31.830783, "o", "--- memvault/regression/bundle_pick_input.c ---\r\n"]
[31.832995, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
[31.833336, "o", "--- relc/input.c ---\r\n"]
[31.835604, "o", "#include \"../lagpipe/synclink/common.h\"\r\n\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int read_pin(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/default.pin\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic int read_running_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/livekern/running.release\", \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    if (!fgets(release, (int)n, fp)) {\r\n        fclose(fp);\r\n        return -1;\r\n    }\r\n    fclose(fp);\r\n    size_t len = strlen(release);\r\n    while (len > 0 && (release[len - 1] == '\\n' || release[len - 1] == '\\r')) {\r\n        release[--len] = '\\0';\r\n    }\r\n    return 0;\r\n}\r\n\r\nstatic void apply_policy_release(char *release, size_t n) {\r\n    FILE *fp = fopen(\"/app/snapvault/policy.conf\", \"r\");\r\n    char line[128];\r\n    char val[RELEASE_LEN];\r\n    if (!fp) {\r\n        return;\r\n    }\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        if (sscanf(line, \"DEFAULT_RELEASE=%63s\", val) == 1) {\r\n            snprintf(release, n, \"%s\", val);\r\n        }\r\n    }\r\n    fclose(fp);\r\n}\r\n\r\nint choose_layout(source_pick *out) {\r\n    char release[RELEASE_LEN];\r\n    char running[RELEASE_LEN];\r\n\r\n    if (!out) {\r\n        return -1;\r\n    }\r\n    memset(out, 0, sizeof(*out));\r\n\r\n    if (read_pin(release, sizeof(release)) != 0) {\r\n        return -1;\r\n    }\r\n    apply_policy_release(release, sizeof(release));\r\n\r\n    if (read_running_release(running, sizeof(running)) == 0 &&\r\n        strcmp(release, running) == 0) {\r\n        snprintf(out->layout_path, sizeof(out->layout_path),\r\n                 \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n        snprintf(out->tag_value, sizeof(out->tag_value), \"live:%s\", running);\r\n        out->from_bundle = 1;\r\n        return 0;\r\n    }\r\n\r\n    snprintf(out->layout_path, sizeof(out->layout_path),\r\n             \"/app/snapvault/releases/%s/sched_entity.tab\", release);\r\n    snprintf(out->tag_value, sizeof(out->tag_value), \"bundle:%s\", release);\r\n    out->from_bundle = 1;\r\n    return 0;\r\n}\r\n"]
[31.836332, "o", "\u001b[?2004hroot@ce37463a5247:/app# "]
