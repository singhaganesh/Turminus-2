    51	    def update(self, detections):
    52	        # Candidate costs. Motion is primary; colour helps disambiguate crossings
    53	        # without making differently illuminated/occluded observations impossible.
    54	        # A single component containing predictions of multiple established
    55	        # tracks is a merge/occlusion observation, not a new centroid belonging
    56	        # to just one of them.
    57	        merged_d = set()
    58	        for di,d in enumerate(detections):
    59	            x0,y0,w,h=d[4]
    60	            covered=[]
    61	            for ti,t in enumerate(self.tracks):
    62	                px,py=t.predict()
    63	                if t.hits >= 3 and t.missed <= 2 and x0-5 <= px <= x0+w+5 and y0-5 <= py <= y0+h+5:
    64	                    covered.append(ti)
    65	            if len(covered) >= 2:
    66	                merged_d.add(di)
    67	        pairs=[]
    68	        for ti,t in enumerate(self.tracks):
    69	            px,py=t.predict()
    70	            for di,d in enumerate(detections):
    71	                if di in merged_d: continue
    72	                x,y,area,col,box,component=d
    73	                dx,dy=x-px,y-py
    74	                dist=math.hypot(dx,dy)
    75	                gate=16.0 + 7.0*min(t.missed,3)
    76	                if dist > gate: continue
    77	                cd=float(np.linalg.norm(np.asarray(col)-t.colour))
    78	                pairs.append((dist + min(cd,120.0)*.025,ti,di))
    79	        pairs.sort()
    80	        used_t=set(); used_d=set(merged_d)
    81	        for cost,ti,di in pairs:
    82	            if ti in used_t or di in used_d: continue
    83	            t=self.tracks[ti]; d=detections[di]; x,y,area,col,box,component=d
    84	            # Damp velocity: enough prediction for short occlusions, little jitter.
    85	            nvx=x-t.x; nvy=y-t.y
    86	            if t.hits > 1:
    87	                t.vx=.45*t.vx+.55*nvx; t.vy=.45*t.vy+.55*nvy
    88	            else: t.vx,t.vy=nvx,nvy
    89	            t.x,t.y=x,y; t.colour=.75*t.colour+.25*np.asarray(col)
    90	            t.hits+=1; t.age+=1; t.missed=0; t.history.append((x,y))
    91	            t.min_y=min(t.min_y,y); t.max_y=max(t.max_y,y)
    92	            if y <= LINE_Y-2: t.seen_above=True
    93	            # Completion needs observations on both sides and net downward motion.
    94	            # The margin avoids line jitter and lingering false crossings.
    95	            if (not t.counted and t.seen_above and y >= LINE_Y+2 and
    96	                    t.max_y-t.min_y >= 5 and t.vy > -0.5):
    97	                t.counted=True; self.total+=1
    98	                self.counted_signatures.append((t.history[0][0], t.colour.copy()))
    99	            used_t.add(ti); used_d.add(di)
   100	        # Keep tracks through merges/shading, but do not count predicted crossings.
   101	        for ti,t in enumerate(self.tracks):
   102	            if ti not in used_t:
   103	                px, py = t.predict()
   104	                # If a visible component covers this prediction, this is an
   105	                # occluded track rather than an absent body. Its established
   106	                # velocity supplies the hidden centroid during the merge.
   107	                occluded = False
   108	                for d in detections:
   109	                    x0,y0,w,h=d[4]
   110	                    if x0-5 <= px <= x0+w+5 and y0-5 <= py <= y0+h+5:
   111	                        occluded = True; break
   112	                t.x, t.y = px, py; t.age+=1; t.missed+=1
   113	                if (occluded and t.hits >= 3 and not t.counted and t.seen_above
