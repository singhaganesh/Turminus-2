[?2004l[?2004h> from tether import Tether, fold_gate
[?2004l[?2004h> 
[?2004l[?2004h> SHEET = Path('/app/inkwell/sheet.toml')
[?2004l[?2004h> 
[?2004l[?2004h> def emit_span(src: str) -> int:
[?2004l[?2004h>     cap=cv2.VideoCapture(src)
[?2004l[?2004h>     if not cap.isOpened():
[?2004l[?2004h>         cap.release(); raise OSError('cannot open clip')
[?2004l[?2004h>     frames=[]
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ok,frame=cap.read()
[?2004l[?2004h>         if not ok: break
[?2004l[?2004h>         if frame is None or frame.shape[:2] != (120,160):
[?2004l[?2004h>             cap.release(); raise ValueError('invalid frame')
[?2004l[?2004h>         frames.append(frame)
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     if not frames: raise ValueError('clip contains no frames')
[?2004l[?2004h>     bg=make_background(frames)
[?2004l[?2004h>     tracker=Tether()
[?2004l[?2004h>     for frame in frames:
[?2004l[?2004h>         detections,_=blot_marks(frame,bg)
[?2004l[?2004h>         tracker.update(detections)
[?2004l[?2004h>     return fold_gate(tracker.total)
[?2004l[?2004h> 
[?2004l[?2004h> def dump_sheet(n: int) -> None:
[?2004l[?2004h>     SHEET.parent.mkdir(parents=True,exist_ok=True)
[?2004l[?2004h>     SHEET.write_text(toml.dumps({'crossings':int(n)}),encoding='utf-8')
[?2004l[?2004h> PY
