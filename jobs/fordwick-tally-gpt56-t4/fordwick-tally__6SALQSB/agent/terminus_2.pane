[?2004l[?2004hroot@0a311768df85:/app# cat > /app/tether.py <<'PY'
[?2004l[?2004h> """Small multi-object tracker and directed line-crossing state."""
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> from dataclasses import dataclass, field
[?2004l[?2004h> import math
[?2004larent.mkdir([?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> LINE_Y = 70.0
[?2004l[?2004h> 
[?2004l[?2004h> @dataclass
[?2004l[?2004h> class Track:
[?2004l[?2004h>     ident: int
[?2004l[?2004h>     x: float
[?2004l[?2004h>     y: float
[?2004l[?2004h>     vx: float = 0.0
[?2004l[?2004h>     vy: float = 0.0
[?2004l[?2004h>     age: int = 1
[?2004l[?2004h>     hits: int = 1
[?2004l[?2004h>     missed: int = 0
[?2004l[?2004h>     counted: bool = False
[?2004l[?2004h>     seen_above: bool = False
[?2004l[?2004h>     min_y: float = 999.0
[?2004l[?2004h>     max_y: float = -999.0
[?2004l[?2004h>     colour: np.ndarray = field(default_factory=lambda: np.zeros(3))
[?2004l[?2004h>     history: list = field(default_factory=list)
[?2004l[?2004h> 
[?2004l[?2004h>     def predict(self):
[?2004l[?2004h>         return self.x + self.vx, self.y + self.vy
[?2004l[?2004h> 
[?2004l[?2004h> class Tether:
[?2004l[?2004h>     def __init__(self):
[?2004l[?2004h>         self.tracks = []
[?2004l[?2004h>         self.next_id = 1
[?2004l[?2004h>         self.total = 0
[?2004l[?2004h> 
[?2004l[?2004h>     def _new(self, d):
[?2004l[?2004h>         x,y,area,col,box,component=d
[?2004l[?2004h>         t=Track(self.next_id,x,y,colour=np.asarray(col,float),history=[(x,y)])
[?2004l[?2004h>         t.min_y=t.max_y=y
[?2004l[?2004h>         # Require actual centroid evidence comfortably on the upper side.
[?2004l[?2004h>         t.seen_above = y <= LINE_Y - 2
[?2004l[?2004h>         self.next_id += 1
[?2004l[?2004h>         self.tracks.append(t)
[?2004l[?2004h> 
[?2004l[?2004h>     def update(self, detections):
[?2004l[?2004h>         # Candidate costs. Motion is primary; colour helps disambiguate crossings
[?2004l[?2004h>         # without making differently illuminated/occluded observations impossible.
[?2004l[?2004h>         pairs=[]
[?2004l[?2004h>         for ti,t in enumerate(self.tracks):
[?2004l[?2004h>             px,py=t.predict()
[?2004l[?2004h>             for di,d in enumerate(detections):
[?2004l[?2004h>                 x,y,area,col,box,component=d
[?2004l[?2004h>                 dx,dy=x-px,y-py
[?2004l[?2004h>                 dist=math.hypot(dx,dy)
[?2004l[?2004h>                 gate=16.0 + 7.0*min(t.missed,3)
[?2004l[?2004h>                 if dist > gate: continue
[?2004l[?2004h>                 cd=float(np.linalg.norm(np.asarray(col)-t.col))
[?2004l[?2004h>                 pairs.append((dist + min(cd,120.0)*.025,ti,di))
[?2004l[?2004h>         pairs.sort()
[?2004l[?2004h>         used_t=set(); used_d=set()
[?2004l[?2004h>         for cost,ti,di in pairs:
[?2004l[?2004h>             if ti in used_t or di in used_d: continue
[?2004l[?2004h>             t=self.tracks[ti]; d=detections[di]; x,y,area,col,box,component=d
[?2004l[?2004h>             # Damp velocity: enough prediction for short occlusions, little jitter.
[?2004l[?2004h>             nvx=x-t.x; nvy=y-t.y
[?2004l[?2004h>             if t.hits > 1:
[?2004l[?2004h>                 t.vx=.45*t.vx+.55*nvx; t.vy=.45*t.vy+.55*nvy
[?2004l[?2004h>             else: t.vx,t.vy=nvx,nvy
[?2004l[?2004h>             t.x,t.y=x,y; t.colour=.75*t.colour+.25*np.asarray(col)
[?2004l[?2004h>             t.hits+=1; t.age+=1; t.missed=0; t.history.append((x,y))
[?2004l[?2004h>             t.min_y=min(t.min_y,y); t.max_y=max(t.max_y,y)
[?2004l[?2004h>             if y <= LINE_Y-2: t.seen_above=True
[?2004l[?2004h>             # Completion needs observations on both sides and net downward motion.
[?2004l[?2004h>             # The margin avoids line jitter and lingering false crossings.
[?2004l[?2004h>             if (not t.counted and t.seen_above and y >= LINE_Y+2 and
[?2004l[?2004h>                     t.max_y-t.min_y >= 5 and t.vy > -0.5):
[?2004l[?2004h>                 t.counted=True; self.total+=1
[?2004l[?2004h>             used_t.add(ti); used_d.add(di)
[?2004l[?2004h>         # Keep tracks through merges/shading, but do not count predicted crossings.
[?2004l[?2004h>         for ti,t in enumerate(self.tracks):
[?2004l[?2004h>             if ti not in used_t:
[?2004l[?2004h>                 t.x += t.vx; t.y += t.vy; t.age+=1; t.missed+=1
[?2004l[?2004h>                 t.vx*=.92; t.vy*=.92
[?2004l[?2004h>         for di,d in enumerate(detections):
[?2004l[?2004h>             if di not in used_d: self._new(d)
[?2004l[?2004h>         self.tracks=[t for t in self.tracks if t.missed <= 12]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def fold_gate(n: int) -> int:
[?2004l[?2004h>     return int(n)
[?2004l[?2004h> PY
