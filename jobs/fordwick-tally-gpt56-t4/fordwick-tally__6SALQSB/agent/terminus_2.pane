[?2004hroot@0a311768df85:/app# cat > /app/blot.py <<'PY'
[?2004l[?2004h> """Foreground extraction and body detections for the yard camera."""
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> LINE_Y = 70
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def make_background(frames: list[np.ndarray]) -> np.ndarray:
[?2004l[?2004h>     """A moving body occupies a pixel briefly, so the temporal median is the yard."""
[?2004l[?2004h>     return np.median(np.stack(frames, axis=0), axis=0).astype(np.uint8)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def foreground(frame: np.ndarray, background: np.ndarray) -> np.ndarray:
[?2004l[?2004h>     # Euclidean colour distance is substantially less sensitive to mp4 ringing than
[?2004l[?2004h>     # subtraction in any one channel.
[?2004l[?2004h>     d = frame.astype(np.int16) - background.astype(np.int16)
[?2004l[?2004h>     dist2 = np.sum(d * d, axis=2, dtype=np.int32)
[?2004l[?2004h>     mask = (dist2 > 24 * 24).astype(np.uint8) * 255
[?2004l[?2004h>     mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))
[?2004l[?2004h>     mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))
[?2004l[?2004h>     return mask
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def blot_marks(frame: np.ndarray, background: np.ndarray):
[?2004l[?2004h>     """Return (x,y,area,colour,bbox) detections.
[?2004l[?2004h> 
[?2004la[?2004h>     Compact connected components are bodies.  A merged component is represented
[?2004l[?2004h>     by several distance-transform peaks where possible; the tracker also keeps
[?2004l[?2004h>     unmatched predicted tracks alive through complete shading.
[?2004l[?2004h>     """
[?2004l[?2004h>     mask = foreground(frame, background)
[?2004l[?2004h>     n, labels, stats, cents = cv2.connectedComponentsWithStats(mask, 8)
[?2004l[?2004h>     out = []
[?2004l[?2004h>     for k in range(1, n):
[?2004l[?2004h>         x, y, w, h, area = map(int, stats[k])
[?2004l[?2004h>         if area < 35 or w < 3 or h < 3:
[?2004l[?2004h>             continue
[?2004l[?2004h>         region = labels == k
[?2004l[?2004h>         # Typical bodies are ~300 px in the supplied geometry. Components much
[?2004l[?2004h>         # larger/wider can contain multiple touching bodies.
[?2004l[?2004h>         guesses = []
[?2004l[?2004h>         if area > 500 or w > 28 or h > 32:
[?2004l[?2004h>             sub = (region[y:y+h, x:x+w].astype(np.uint8) * 255)
[?2004l[?2004h>             dt = cv2.distanceTransform(sub, cv2.DIST_L2, 5)
[?2004l[?2004h>             mx = cv2.dilate(dt, np.ones((9, 9), np.uint8))
[?2004l[?2004h>             peaks = ((dt == mx) & (dt >= max(3.0, float(dt.max()) * .55))).astype(np.uint8)
[?2004l[?2004h>             pn, _, _, pc = cv2.connectedComponentsWithStats(peaks, 8)
[?2004l[?2004h>             for q in range(1, pn):
[?2004l[?2004h>                 guesses.append((x + float(pc[q, 0]), y + float(pc[q, 1])))
[?2004l[?2004h>         if not guesses or len(guesses) > 6:
[?2004l[?2004h>             guesses = [(float(cents[k, 0]), float(cents[k, 1]))]
[?2004l[?2004h>         pix = frame[region]
[?2004l[?2004h>         colour = tuple(np.median(pix, axis=0).astype(float))
[?2004l[?2004h>         share = float(area) / len(guesses)
[?2004l[?2004h>         for cx, cy in guesses:
[?2004l[?2004h>             out.append((cx, cy, share, colour, (x, y, w, h), k))
[?2004l[?2004h>     return out, mask
[?2004l[?2004h> PY
