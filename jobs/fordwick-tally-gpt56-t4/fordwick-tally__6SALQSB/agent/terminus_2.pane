[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> import sys
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> from spout import SHEET, dump_sheet, emit_span
[?2004l[?2004h> 
[?2004l[?2004h> def main() -> int:
[?2004l[?2004h>     # Never leave a stale success artifact after any failed invocation.
[?2004l[?2004h>     try: SHEET.unlink(missing_ok=True)
[?2004l[?2004h>     except OSError: pass
[?2004l[?2004h>     if len(sys.argv) != 2: return 2
[?2004l[?2004h>     try:
[?2004l[?2004h>         n=emit_span(sys.argv[1])
[?2004l[?2004h>         dump_sheet(n)
[?2004l[?2004h>     except Exception as exc:
[?2004l[?2004h>         print(f'mill: {exc}',file=sys.stderr)
[?2004l[?2004h>         try: SHEET.unlink(missing_ok=True)
[?2004l[?2004h>         except OSError: pass
[?2004l[?2004h>         return 1
[?2004l[?2004h>     return 0
[?2004l[?2004h> 
[?2004l[?2004h> if __name__=='__main__': raise SystemExit(main())
