[532.520793, "i", "python3 - <<'PY'\np='/app/tether.py'; s=open(p).read()\nold='''            covered=[]\n            for ti,t in enumerate(self.tracks):\n                px,py=t.predict()\n                if t.hits >= 3 and t.missed <= 12 and x0-8 <= px <= x0+w+8 and y0-8 <= py <= y0+h+8:\n                    covered.append(ti)\n            if len(covered) >= 2:\n                merged_d.add(di)\n'''\nnew='''            covered=[]\n            # A large/wide component is the first sign of silhouettes joining.\n            # Use a wider gate at that instant, before assignment to its combined\n            # centroid can corrupt either track's velocity. Thereafter shaded\n            # tracks keep the merge state alive through complete superposition.\n            likely_join = d[2] > 375 or w > 23 or h > 27\n            for ti,t in enumerate(self.tracks):\n                px,py=t.predict()\n                pad = 24 if (likely_join or t.shaded) else 8\n                if (t.hits >= 3 and t.missed <= 12 and\n                        x0-pad <= px <= x0+w+pad and y0-pad <= py <= y0+h+pad):\n                    covered.append(ti)\n            if len(covered) >= 2 and (likely_join or any(self.tracks[q].shaded for q in covered)):\n                merged_d.add(di)\n                for q in covered:\n                    self.tracks[q].shaded = True\n'''\nassert old in s\ns=s.replace(old,new)\n# Once merge state is established, retain coverage with the same wider gate.\ns=s.replace(\"if x0-5 <= px <= x0+w+5 and y0-5 <= py <= y0+h+5:\\n                        occluded = True; break\",\n'''pad = 24 if t.shaded else 5\n                    if x0-pad <= px <= x0+w+pad and y0-pad <= py <= y0+h+pad:\n                        occluded = True; break''')\nopen(p,'w').write(s)\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; printf 'shown:       '; cat /app/inkwell/sheet.toml\nfor f in /tmp/milltests/*.mp4; do python3 /app/varnish/mill.pyc \"$f\" >/dev/null; printf '%-12s ' \"$(basename \"$f\")\"; cat /app/inkwell/sheet.toml; done\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4 >/dev/null 2>&1; rc=$?\nprintf 'invalid: rc=%s absent=%s\\n' \"$rc\" \"$(test ! -e /app/inkwell/sheet.toml && echo yes || echo no)\"\npython3 /app/varnish/mill.pyc /app/shown.mp4\nprintf 'final sheet: '; cat /app/inkwell/sheet.toml\n"]
