[123.492063, "i", "cat > /app/blot.py <<'PY'\n\"\"\"Foreground extraction and body detections for the yard camera.\"\"\"\nfrom __future__ import annotations\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef make_background(frames: list[np.ndarray]) -> np.ndarray:\n    \"\"\"A moving body occupies a pixel briefly, so the temporal median is the yard.\"\"\"\n    return np.median(np.stack(frames, axis=0), axis=0).astype(np.uint8)\n\n\ndef foreground(frame: np.ndarray, background: np.ndarray) -> np.ndarray:\n    # Euclidean colour distance is substantially less sensitive to mp4 ringing than\n    # subtraction in any one channel.\n    d = frame.astype(np.int16) - background.astype(np.int16)\n    dist2 = np.sum(d * d, axis=2, dtype=np.int32)\n    mask = (dist2 > 24 * 24).astype(np.uint8) * 255\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n    return mask\n\n\ndef blot_marks(frame: np.ndarray, background: np.ndarray):\n    \"\"\"Return (x,y,area,colour,bbox) detections.\n\n    Compact connected components are bodies.  A merged component is represented\n    by several distance-transform peaks where possible; the tracker also keeps\n    unmatched predicted tracks alive through complete shading.\n    \"\"\"\n    mask = foreground(frame, background)\n    n, labels, stats, cents = cv2.connectedComponentsWithStats(mask, 8)\n    out = []\n    for k in range(1, n):\n        x, y, w, h, area = map(int, stats[k])\n        if area < 35 or w < 3 or h < 3:\n            continue\n        region = labels == k\n        # Typical bodies are ~300 px in the supplied geometry. Components much\n        # larger/wider can contain multiple touching bodies.\n        guesses = []\n        if area > 500 or w > 28 or h > 32:\n            sub = (region[y:y+h, x:x+w].astype(np.uint8) * 255)\n            dt = cv2.distanceTransform(sub, cv2.DIST_L2, 5)\n            mx = cv2.dilate(dt, np.ones((9, 9), np.uint8))\n            peaks = ((dt == mx) & (dt >= max(3.0, float(dt.max()) * .55))).astype(np.uint8)\n            pn, _, _, pc = cv2.connectedComponentsWithStats(peaks, 8)\n            for q in range(1, pn):\n                guesses.append((x + float(pc[q, 0]), y + float(pc[q, 1])))\n        if not guesses or len(guesses) > 6:\n            guesses = [(float(cents[k, 0]), float(cents[k, 1]))]\n        pix = frame[region]\n        colour = tuple(np.median(pix, axis=0).astype(float))\n        share = float(area) / len(guesses)\n        for cx, cy in guesses:\n            out.append((cx, cy, share, colour, (x, y, w, h), k))\n    return out, mask\nPY\n\ncat > /app/tether.py <<'PY'\n\"\"\"Small multi-object tracker and directed line-crossing state.\"\"\"\nfrom __future__ import annotations\nfrom dataclasses import dataclass, field\nimport math\nimport numpy as np\n\nLINE_Y = 70.0\n\n@dataclass\nclass Track:\n    ident: int\n    x: float\n    y: float\n    vx: float = 0.0\n    vy: float = 0.0\n    age: int = 1\n    hits: int = 1\n    missed: int = 0\n    counted: bool = False\n    seen_above: bool = False\n    min_y: float = 999.0\n    max_y: float = -999.0\n    colour: np.ndarray = field(default_factory=lambda: np.zeros(3))\n    history: list = field(default_factory=list)\n\n    def predict(self):\n        return self.x + self.vx, self.y + self.vy\n\nclass Tether:\n    def __init__(self):\n        self.tracks = []\n        self.next_id = 1\n        self.total = 0\n\n    def _new(self, d):\n        x,y,area,col,box,component=d\n        t=Track(self.next_id,x,y,colour=np.asarray(col,float),history=[(x,y)])\n        t.min_y=t.max_y=y\n        # Require actual centroid evidence comfortably on the upper side.\n        t.seen_above = y <= LINE_Y - 2\n        self.next_id += 1\n        self.tracks.append(t)\n\n    def update(self, detections):\n        # Candidate costs. Motion is primary; colour helps disambiguate crossings\n        # without making differently illuminated/occluded observations impossible.\n        pairs=[]\n        for ti,t in enumerate(self.tracks):\n            px,py=t.predict()\n            for di,d in enumerate(detections):\n                x,y,area,col,box,component=d\n                "]
[123.492212, "i", "dx,dy=x-px,y-py\n                dist=math.hypot(dx,dy)\n                gate=16.0 + 7.0*min(t.missed,3)\n                if dist > gate: continue\n                cd=float(np.linalg.norm(np.asarray(col)-t.col))\n                pairs.append((dist + min(cd,120.0)*.025,ti,di))\n        pairs.sort()\n        used_t=set(); used_d=set()\n        for cost,ti,di in pairs:\n            if ti in used_t or di in used_d: continue\n            t=self.tracks[ti]; d=detections[di]; x,y,area,col,box,component=d\n            # Damp velocity: enough prediction for short occlusions, little jitter.\n            nvx=x-t.x; nvy=y-t.y\n            if t.hits > 1:\n                t.vx=.45*t.vx+.55*nvx; t.vy=.45*t.vy+.55*nvy\n            else: t.vx,t.vy=nvx,nvy\n            t.x,t.y=x,y; t.colour=.75*t.colour+.25*np.asarray(col)\n            t.hits+=1; t.age+=1; t.missed=0; t.history.append((x,y))\n            t.min_y=min(t.min_y,y); t.max_y=max(t.max_y,y)\n            if y <= LINE_Y-2: t.seen_above=True\n            # Completion needs observations on both sides and net downward motion.\n            # The margin avoids line jitter and lingering false crossings.\n            if (not t.counted and t.seen_above and y >= LINE_Y+2 and\n                    t.max_y-t.min_y >= 5 and t.vy > -0.5):\n                t.counted=True; self.total+=1\n            used_t.add(ti); used_d.add(di)\n        # Keep tracks through merges/shading, but do not count predicted crossings.\n        for ti,t in enumerate(self.tracks):\n            if ti not in used_t:\n                t.x += t.vx; t.y += t.vy; t.age+=1; t.missed+=1\n                t.vx*=.92; t.vy*=.92\n        for di,d in enumerate(detections):\n            if di not in used_d: self._new(d)\n        self.tracks=[t for t in self.tracks if t.missed <= 12]\n\n\ndef fold_gate(n: int) -> int:\n    return int(n)\nPY\n\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\nfrom pathlib import Path\nimport cv2\nimport toml\nfrom blot import make_background, blot_marks\nfrom tether import Tether, fold_gate\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\ndef emit_span(src: str) -> int:\n    cap=cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release(); raise OSError('cannot open clip')\n    frames=[]\n    while True:\n        ok,frame=cap.read()\n        if not ok: break\n        if frame is None or frame.shape[:2] != (120,160):\n            cap.release(); raise ValueError('invalid frame')\n        frames.append(frame)\n    cap.release()\n    if not frames: raise ValueError('clip contains no frames')\n    bg=make_background(frames)\n    tracker=Tether()\n    for frame in frames:\n        detections,_=blot_marks(frame,bg)\n        tracker.update(detections)\n    return fold_gate(tracker.total)\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True,exist_ok=True)\n    SHEET.write_text(toml.dumps({'crossings':int(n)}),encoding='utf-8')\nPY\n\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\nimport sys\nfrom pathlib import Path\nfrom spout import SHEET, dump_sheet, emit_span\n\ndef main() -> int:\n    # Never leave a stale success artifact after any failed invocation.\n    try: SHEET.unlink(missing_ok=True)\n    except OSError: pass\n    if len(sys.argv) != 2: return 2\n    try:\n        n=emit_span(sys.argv[1])\n        dump_sheet(n)\n    except Exception as exc:\n        print(f'mill: {exc}',file=sys.stderr)\n        try: SHEET.unlink(missing_ok=True)\n        except OSError: pass\n        return 1\n    return 0\n\nif __name__=='__main__': raise SystemExit(main())\nPY\nchmod +x /app/kiln/bake.sh && /app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; echo status=$?; cat /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo bad_status=$?; test ! -e /app/inkwell/sheet.toml; echo absent_status=$?\n"]
