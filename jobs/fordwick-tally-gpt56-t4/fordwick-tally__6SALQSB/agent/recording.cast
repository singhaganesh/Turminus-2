[44.146135, "i", "python3 - <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; cap=cv2.VideoCapture(p); fs=[]\nwhile True:\n ok,f=cap.read()\n if not ok: break\n fs.append(f)\ncap.release()\nprint('frames',len(fs))\n# Most common quantized and exact colors across selected frames\nfor i in [0,1,5,10,15,20,25,30,35,40,47]:\n f=fs[i]\n q=(f//16*16).reshape(-1,3)\n u,n=np.unique(q,axis=0,return_counts=True); ix=np.argsort(n)[-8:][::-1]\n print(i,[(u[j].tolist(),int(n[j])) for j in ix])\n# temporal ranges / median-background difference components\nbg=np.median(np.stack(fs),axis=0).astype(np.uint8)\nfor i,f in enumerate(fs):\n d=cv2.absdiff(f,bg); g=d.max(2); m=(g>25).astype(np.uint8)*255\n m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8));\n n,lab,st,cen=cv2.connectedComponentsWithStats(m)\n comps=[(int(st[j,4]),tuple(np.round(cen[j],1))) for j in range(1,n) if st[j,4]>=8]\n if comps: print('C',i,comps)\n# contact sheet\nsel=range(0,len(fs),3); tiles=[]\nfor i in sel:\n f=fs[i].copy(); cv2.line(f,(0,70),(159,70),(0,0,255),1); cv2.putText(f,str(i),(2,12),0,.35,(255,255,255),1)\n tiles.append(f)\nsheet=np.vstack([np.hstack(tiles[r:r+4]) for r in range(0,len(tiles),4)])\ncv2.imwrite('/app/contact.png',sheet)\nprint('wrote /app/contact.png',sheet.shape,'bg range',bg.min(),bg.max())\nPY\n"]
