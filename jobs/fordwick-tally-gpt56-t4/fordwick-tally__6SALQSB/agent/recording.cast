[46.144408, "i", "python3 - <<'PY'\nimport cv2,numpy as np\nc=cv2.VideoCapture('/app/shown.mp4'); fs=[]\nwhile 1:\n ok,f=c.read()\n if not ok:break\n fs.append(f)\n# Examine grayscale/color edge contours directly; output bbox centers and average interior colors\nfor i,f in enumerate(fs):\n # estimate flat background from corners, threshold color distance\n bg=np.median(np.concatenate([f[:8].reshape(-1,3),f[-8:].reshape(-1,3),f[:,:8].reshape(-1,3),f[:,-8:].reshape(-1,3)]),axis=0)\n dist=np.linalg.norm(f.astype(float)-bg,axis=2)\n m=np.uint8(dist>30)*255\n m=cv2.morphologyEx(m,cv2.MORPH_CLOSE,np.ones((3,3),np.uint8))\n n,l,s,ct=cv2.connectedComponentsWithStats(m)\n out=[]\n for j in range(1,n):\n  x,y,w,h,a=map(int,s[j]);\n  if a>=15: out.append((x,y,w,h,a,tuple(np.round(ct[j],1))))\n if out: print(i,'bg',bg.astype(int).tolist(),out)\nPY\n"]
