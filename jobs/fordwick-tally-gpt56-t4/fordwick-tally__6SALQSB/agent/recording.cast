[300.742893, "i", "python3 - <<'PY'\np='/app/blot.py'\ns=open(p).read()\ns=s.replace('    return out, mask\\n', '''    # Codec/background ghosts occasionally cut one body into two small nearby\n    # pieces. Join only small fragments; never join two normal-sized bodies.\n    changed = True\n    while changed:\n        changed = False\n        for i in range(len(out)):\n            if changed: break\n            for j in range(i + 1, len(out)):\n                a, b = out[i], out[j]\n                if min(a[2], b[2]) > 125 or abs(a[0]-b[0]) > 12 or abs(a[1]-b[1]) > 18:\n                    continue\n                aa, bb = a[2], b[2]\n                total = aa + bb\n                cx = (a[0]*aa + b[0]*bb)/total\n                cy = (a[1]*aa + b[1]*bb)/total\n                col = tuple((np.asarray(a[3])*aa + np.asarray(b[3])*bb)/total)\n                x = min(a[4][0], b[4][0]); y = min(a[4][1], b[4][1])\n                r = max(a[4][0]+a[4][2], b[4][0]+b[4][2])\n                bot = max(a[4][1]+a[4][3], b[4][1]+b[4][3])\n                out[i] = (cx, cy, total, col, (x,y,r-x,bot-y), a[5])\n                out.pop(j); changed = True; break\n    return out, mask\n''')\nopen(p,'w').write(s)\n\np='/app/tether.py'; s=open(p).read()\ns=s.replace('        self.total = 0\\n', '        self.total = 0\\n        self.counted_signatures = []  # (entry x, median colour)\\n')\ns=s.replace(\"        t.seen_above = y <= LINE_Y - 2\\n        self.next_id\", \"\"\"        t.seen_above = y <= LINE_Y - 2\n        # A body may leave and re-enter. Appearance plus lane is the available\n        # persistent identity in this fixed camera.\n        for sx, sc in self.counted_signatures:\n            if abs(x-sx) <= 14 and np.linalg.norm(t.colour-sc) <= 32:\n                t.counted = True\n                break\n        self.next_id\"\"\")\ns=s.replace('                t.counted=True; self.total+=1\\n', '                t.counted=True; self.total+=1\\n                self.counted_signatures.append((t.history[0][0], t.colour.copy()))\\n')\nold='''        for ti,t in enumerate(self.tracks):\n            if ti not in used_t:\n                t.x += t.vx; t.y += t.vy; t.age+=1; t.missed+=1\n                t.vx*=.92; t.vy*=.92\n'''\nnew='''        for ti,t in enumerate(self.tracks):\n            if ti not in used_t:\n                px, py = t.predict()\n                # If a visible component covers this prediction, this is an\n                # occluded track rather than an absent body. Its established\n                # velocity supplies the hidden centroid during the merge.\n                occluded = False\n                for d in detections:\n                    x0,y0,w,h=d[4]\n                    if x0-5 <= px <= x0+w+5 and y0-5 <= py <= y0+h+5:\n                        occluded = True; break\n                t.x, t.y = px, py; t.age+=1; t.missed+=1\n                if (occluded and t.hits >= 3 and not t.counted and t.seen_above\n                        and py >= LINE_Y+2 and t.vy > 0):\n                    t.counted=True; self.total+=1\n                    self.counted_signatures.append((t.history[0][0], t.colour.copy()))\n                t.vx*=.92; t.vy*=.92\n'''\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; printf 'shown: '; cat /app/inkwell/sheet.toml\nfor f in /tmp/milltests/*.mp4; do python3 /app/varnish/mill.pyc \"$f\" >/dev/null; printf '%-12s ' \"$(basename \"$f\")\"; cat /app/inkwell/sheet.toml; done\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo bad_status=$?; test ! -e /app/inkwell/sheet.toml; echo absent_status=$?\n"]
