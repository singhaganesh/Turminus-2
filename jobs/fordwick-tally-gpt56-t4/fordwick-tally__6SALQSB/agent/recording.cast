[370.991792, "i", "python3 - <<'PY'\np='/app/tether.py'; s=open(p).read()\ns=s.replace('''        pairs=[]\n        for ti,t in enumerate(self.tracks):\n''','''        # A single component containing predictions of multiple established\n        # tracks is a merge/occlusion observation, not a new centroid belonging\n        # to just one of them.\n        merged_d = set()\n        for di,d in enumerate(detections):\n            x0,y0,w,h=d[4]\n            covered=[]\n            for ti,t in enumerate(self.tracks):\n                px,py=t.predict()\n                if t.hits >= 3 and t.missed <= 2 and x0-5 <= px <= x0+w+5 and y0-5 <= py <= y0+h+5:\n                    covered.append(ti)\n            if len(covered) >= 2:\n                merged_d.add(di)\n        pairs=[]\n        for ti,t in enumerate(self.tracks):\n''')\ns=s.replace('''            for di,d in enumerate(detections):\n                x,y,area,col,box,component=d\n''','''            for di,d in enumerate(detections):\n                if di in merged_d: continue\n                x,y,area,col,box,component=d\n''',1)\ns=s.replace('''        used_t=set(); used_d=set()\n''','''        used_t=set(); used_d=set(merged_d)\n''')\nopen(p,'w').write(s)\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; printf 'shown:       '; cat /app/inkwell/sheet.toml\nfor f in /tmp/milltests/*.mp4; do python3 /app/varnish/mill.pyc \"$f\" >/dev/null; printf '%-12s ' \"$(basename \"$f\")\"; cat /app/inkwell/sheet.toml; done\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; printf 'invalid: rc=%s absent=%s\\n' \"$rc\" \"$(test ! -e /app/inkwell/sheet.toml && echo yes || echo no)\"\npython3 -m py_compile /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py\n"]
