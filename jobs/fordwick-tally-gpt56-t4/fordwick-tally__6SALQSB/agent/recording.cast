[411.072618, "o", "    42\t        # A body may leave and re-enter. Appearance plus lane is the available\r\n    43\t        # persistent identity in this fixed camera.\r\n    44\t        for sx, sc in self.counted_signatures:\r\n    45\t            if abs(x-sx) <= 14 and np.linalg.norm(t.colour-sc) <= 32:\r\n    46\t                t.counted = True\r\n    47\t                break\r\n    48\t        self.next_id += 1\r\n    49\t        self.tracks.append(t)\r\n    50\t\r\n    51\t    def update(self, detections):\r\n    52\t        # Candidate costs. Motion is primary; colour helps disambiguate crossings\r\n    53\t        # without making differently illuminated/occluded observations impossible.\r\n    54\t        # A single component containing predictions of multiple established\r\n    55\t        # tracks is a merge/occlusion observation, not a new centroid belonging\r\n    56\t        # to just one of them.\r\n    57\t        merged_d = set()\r\n    58\t        for di,d in enumerate(detections):\r\n    59\t            x0,y0,w,h=d[4]\r\n"]
[411.072801, "o", "    60\t            covered=[]\r\n    61\t            for ti,t in enumerate(self.tracks):\r\n    62\t                px,py=t.predict()\r\n    63\t                if t.hits >= 3 and t.missed <= 2 and x0-5 <= px <= x0+w+5 and y0-5 <= py <= y0+h+5:\r\n    64\t                    covered.append(ti)\r\n    65\t            if len(covered) >= 2:\r\n    66\t                merged_d.add(di)\r\n    67\t        pairs=[]\r\n    68\t        for ti,t in enumerate(self.tracks):\r\n    69\t            px,py=t.predict()\r\n    70\t            for di,d in enumerate(detections):\r\n    71\t                if di in merged_d: continue\r\n    72\t                x,y,area,col,box,component=d\r\n    73\t                dx,dy=x-px,y-py\r\n    74\t                dist=math.hypot(dx,dy)\r\n    75\t                gate=16.0 + 7.0*min(t.missed,3)\r\n    76\t                if dist > gate: continue\r\n    77\t                cd=float(np.linalg.norm(np.asarray(col)-t.colour))\r\n    78\t                pairs.append((dist + min(cd,120.0)*.025,ti,di))\r\n    79\t        pairs.sort()\r\n    80\t        used_t=set(); used_d=set(merged_d)\r\n    81\t        for cost,ti,di in pairs:\r\n    82\t            if ti in used_t or di in used_d: continue\r\n    83\t            t=self.tracks[ti]; d=detections[di]; x,y,area,col,box,component=d\r\n    84\t            # Damp velocity: enough prediction for short occlusions, little jitter.\r\n    85\t            nvx=x-t.x; nvy=y-t.y\r\n    86\t            if t.hits > 1:\r\n    87\t                t.vx=.45*t.vx+.55*nvx; t.vy=.45*t.vy+.55*nvy\r\n    88\t            else: t.vx,t.vy=nvx,nvy\r\n    89\t            t.x,t.y=x,y; t.colour=.75*t.colour+.25*np.asarray(col)\r\n    90\t            t.hits+=1; t.age+=1; t.missed=0; t.history.append((x,y))\r\n    91\t            t.min_y=min(t.min_y,y); t.max_y=max(t.max_y,y)\r\n    92\t            if y <= LINE_Y-2: t.seen_above=True\r\n    93\t            # Completion needs observations on both sides and net downward motion.\r\n    94\t            # The margin avoids line jitter and lingering false crossings.\r\n    95\t            if (not t.counted and t.seen_above and y >= LINE_Y+2 and\r\n    96\t                    t.max_y-t.min_y >= 5 and t.vy > -0.5):\r\n    97\t                t.counted=True; self.total+=1\r\n    98\t                self.counted_signatures.append((t.history[0][0], t.colour.copy()))\r\n    99\t            used_t.add(ti); used_d.add(di)\r\n   100\t        # Keep tracks through merges/shading, but do not count predicted crossings.\r\n   101\t"]
[411.073303, "o", "        for ti,t in enumerate(self.tracks):\r\n   102\t            if ti not in used_t:\r\n   103\t                px, py = t.predict()\r\n   104\t                # If a visible component covers this prediction, this is an\r\n   105\t                # occluded track rather than an absent body. Its established\r\n   106\t                # velocity supplies the hidden centroid during the merge.\r\n   107\t                occluded = False\r\n   108\t                for d in detections:\r\n   109\t                    x0,y0,w,h=d[4]\r\n   110\t                    if x0-5 <= px <= x0+w+5 and y0-5 <= py <= y0+h+5:\r\n   111\t                        occluded = True; break\r\n   112\t                t.x, t.y = px, py; t.age+=1; t.missed+=1\r\n   113\t                if (occluded and t.hits >= 3 and not t.counted and t.seen_above\r\n   114\t                        and py >= LINE_Y+2 and t.vy > 0):\r\n   115\t                    t.counted=True; self.total+=1\r\n   116\t                    self.counted_signatures.append((t.history[0][0], t.colour.copy()))\r\n   117\t                t.vx*=.92; t.vy*=.92\r\n   118\t        for di,d in enumerate(detections):\r\n   119\t            if di not in used_d: self._new(d)\r\n   120\t        self.tracks=[t for t in self.tracks if t.missed <= 12]\r\n   121\t\r\n   122\t\r\n   123\tdef fold_gate(n: int) -> int:\r\n   124\t    return int(n)\r\n\u001b[?2004hroot@0a311768df85:/app# "]
[411.213669, "i", "python3 - <<'PY'\np='/app/tether.py'; s=open(p).read()\n# Reserved merged observations must still be visible to the unmatched-track\n# occlusion test. Remove an accidental skip there if present, while retaining\n# the skip in candidate association.\nneedle='''                occluded = False\n                for d in detections:\n                    x0,y0,w,h=d[4]\n'''\nassert needle in s\n# Extend merge recognition over the full short occlusion; otherwise one frame\n# of reservation makes every track ineligible on the next frame.\ns=s.replace('t.hits >= 3 and t.missed <= 2 and x0-5 <= px',\n            't.hits >= 3 and t.missed <= 12 and x0-8 <= px')\ns=s.replace('px <= x0+w+5 and y0-5 <= py <= y0+h+5',\n            'px <= x0+w+8 and y0-8 <= py <= y0+h+8')\n# Keep velocity substantially longer while shaded so centroid passage can finish.\ns=s.replace('''                t.vx*=.92; t.vy*=.92\n        for di,d''','''                if occluded:\n                    t.vx*=.99; t.vy*=.99\n                else:\n                    t.vx*=.92; t.vy*=.92\n        for di,d''')\nopen(p,'w').write(s)\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; printf 'shown: '; cat /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/milltests/converge.mp4; printf 'converge: '; cat /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/milltests/return.mp4; printf 'return: '; cat /app/inkwell/sheet.toml\n"]
