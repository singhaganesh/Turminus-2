[123.512496, "o", "    def update(self, detections):\r\n\u001b[?2004l\r"]
[123.512564, "o", "\u001b[?2004h> "]
[123.513129, "o", "        # Candidate costs. Motion is primary; colour helps disambiguate crossings\r\n\u001b[?2004l\r"]
[123.513218, "o", "\u001b[?2004h> "]
[123.513454, "o", "        # without making differently illuminated/occluded observations impossible.\r\n\u001b[?2004l\r"]
[123.513548, "o", "\u001b[?2004h> "]
[123.513585, "o", "        pairs=[]\r\n\u001b[?2004l\r"]
[123.51372, "o", "\u001b[?2004h> "]
[123.513832, "o", "        for ti,t in enumerate(self.tracks):\r\n\u001b[?2004l\r"]
[123.513957, "o", "\u001b[?2004h> "]
[123.514053, "o", "            px,py=t.predict()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.514234, "o", "            for di,d in enumerate(detections):\r\n\u001b[?2004l\r"]
[123.514332, "o", "\u001b[?2004h> "]
[123.514588, "o", "                x,y,area,col,box,component=d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.514933, "o", "                dx,dy=x-px,y-py\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.515203, "o", "                dist=math.hypot(dx,dy)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.515318, "o", "                gate=16.0 + 7.0*min(t.missed,3)\r\n\u001b[?2004l\r"]
[123.515393, "o", "\u001b[?2004h> "]
[123.515538, "o", "                if dist > gate: continue\r\n\u001b[?2004l\r"]
[123.515625, "o", "\u001b[?2004h> "]
[123.515807, "o", "                cd=float(np.linalg.norm(np.asarray(col)-t.col))\r\n\u001b[?2004l\r"]
[123.515879, "o", "\u001b[?2004h> "]
[123.516003, "o", "                pairs.append((dist + min(cd,120.0)*.025,ti,di))\r\n\u001b[?2004l\r"]
[123.51606, "o", "\u001b[?2004h> "]
[123.516129, "o", "        pairs.sort()\r\n\u001b[?2004l\r"]
[123.516191, "o", "\u001b[?2004h> "]
[123.516261, "o", "        used_t=set(); used_d=set()\r\n\u001b[?2004l\r"]
[123.516292, "o", "\u001b[?2004h> "]
[123.516375, "o", "        for cost,ti,di in pairs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.516404, "o", "> "]
[123.516522, "o", "            if ti in used_t or di in used_d: continue\r\n\u001b[?2004l\r"]
[123.51662, "o", "\u001b[?2004h> "]
[123.516765, "o", "            t=self.tracks[ti]; d=detections[di]; x,y,area,col,box,component=d\r\n\u001b[?2004l\r"]
[123.516837, "o", "\u001b[?2004h"]
[123.516904, "o", "> "]
[123.517029, "o", "            # Damp velocity: enough prediction for short occlusions, little jitter.\r\n\u001b[?2004l\r"]
[123.517095, "o", "\u001b[?2004h"]
[123.517115, "o", "> "]
[123.517329, "o", "            nvx=x-t.x; nvy=y-t.y\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.517414, "o", ">             if t.hits > 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.517505, "o", "> "]
[123.517728, "o", "                t.vx=.45*t.vx+.55*nvx; t.vy=.45*t.vy+.55*nvy\r\n\u001b[?2004l\r"]
[123.517816, "o", "\u001b[?2004h> "]
[123.517887, "o", "            else: t.vx,t.vy=nvx,nvy\r\n\u001b[?2004l\r"]
[123.517943, "o", "\u001b[?2004h> "]
[123.518169, "o", "            t.x,t.y=x,y; t.colour=.75*t.colour+.25*np.asarray(col)\r\n\u001b[?2004l\r"]
[123.518259, "o", "\u001b[?2004h"]
[123.51833, "o", "> "]
[123.518471, "o", "            t.hits+=1; t.age+=1; t.missed=0; t.history.append((x,y))\r\n\u001b[?2004l\r"]
[123.518543, "o", "\u001b[?2004h> "]
[123.518747, "o", "            t.min_y=min(t.min_y,y); t.max_y=max(t.max_y,y)\r\n\u001b[?2004l\r"]
[123.518832, "o", "\u001b[?2004h> "]
[123.518942, "o", "            if y <= LINE_Y-2: t.seen_above=True\r\n\u001b[?2004l\r"]
[123.519003, "o", "\u001b[?2004h> "]
[123.51923, "o", "            # Completion needs observations on both sides and net downward motion.\r\n\u001b[?2004l\r"]
[123.519291, "o", "\u001b[?2004h> "]
[123.519534, "o", "            # The margin avoids line jitter and lingering false crossings.\r\n\u001b[?2004l\r"]
[123.5196, "o", "\u001b[?2004h> "]
[123.5198, "o", "            if (not t.counted and t.seen_above and y >= LINE_Y+2 and\r\n\u001b[?2004l\r"]
[123.519908, "o", "\u001b[?2004h> "]
[123.520025, "o", "                    t.max_y-t.min_y >= 5 and t.vy > -0.5):\r\n\u001b[?2004l\r"]
[123.520081, "o", "\u001b[?2004h> "]
[123.520188, "o", "                t.counted=True; self.total+=1\r\n\u001b[?2004l\r"]
[123.520238, "o", "\u001b[?2004h> "]
[123.520345, "o", "            used_t.add(ti); used_d.add(di)\r\n\u001b[?2004l\r"]
[123.520394, "o", "\u001b[?2004h> "]
[123.520584, "o", "        # Keep tracks through merges/shading, but do not count predicted crossings.\r\n\u001b[?2004l\r"]
[123.520728, "o", "\u001b[?2004h> "]
[123.520792, "o", "        for ti,t in enumerate(self.tracks):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.520874, "o", "            if ti not in used_t:\r\n\u001b[?2004l\r"]
[123.520935, "o", "\u001b[?2004h> "]
[123.521093, "o", "                t.x += t.vx; t.y += t.vy; t.age+=1; t.missed+=1\r\n\u001b[?2004l\r"]
[123.521149, "o", "\u001b[?2004h> "]
[123.521226, "o", "                t.vx*=.92; t.vy*=.92\r\n\u001b[?2004l\r"]
[123.521286, "o", "\u001b[?2004h> "]
[123.521406, "o", "        for di,d in enumerate(detections):\r\n\u001b[?2004l\r"]
[123.521492, "o", "\u001b[?2004h> "]
[123.52168, "o", "            if di not in used_d: self._new(d)\r\n\u001b[?2004l\r"]
[123.521787, "o", "\u001b[?2004h> "]
[123.521922, "o", "        self.tracks=[t for t in self.tracks if t.missed <= 12]\r\n\u001b[?2004l\r"]
[123.521997, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.522064, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.522122, "o", "\u001b[?2004h> "]
[123.52222, "o", "def fold_gate(n: int) -> int:\r\n\u001b[?2004l\r"]
[123.52228, "o", "\u001b[?2004h> "]
[123.522383, "o", "    return int(n)\r\n\u001b[?2004l\r"]
[123.522409, "o", "\u001b[?2004h> "]
[123.522431, "o", "PY\r\n\u001b[?2004l\r"]
[123.523832, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[123.523943, "o", "\r\n\u001b[?2004l\r"]
[123.524017, "o", "\u001b[?2004hroot@0a311768df85:/app# cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[123.524101, "o", "\u001b[?2004h> "]
[123.524167, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[123.524228, "o", "\u001b[?2004h> "]
[123.524295, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[123.524362, "o", "\u001b[?2004h> "]
[123.524427, "o", "import cv2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.524474, "o", "import toml\r\n\u001b[?2004l\r"]
[123.524516, "o", "\u001b[?2004h> "]
[123.52469, "o", "from blot import make_background, blot_marks\r\n\u001b[?2004l\r"]
[123.524738, "o", "\u001b[?2004h> "]
[123.52483, "o", "from tether import Tether, fold_gate\r\n\u001b[?2004l\r"]
[123.524878, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.524919, "o", "\u001b[?2004h> "]
[123.525026, "o", "SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r"]
[123.525069, "o", "\u001b[?2004h"]
[123.525111, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.525192, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r"]
[123.525236, "o", "\u001b[?2004h> "]
[123.525324, "o", "    cap=cv2.VideoCapture(src)\r\n\u001b[?2004l\r"]
[123.52541, "o", "\u001b[?2004h> "]
[123.525472, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.525633, "o", "        cap.release(); raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[123.525676, "o", "\u001b[?2004h> "]
[123.52572, "o", "    frames=[]\r\n\u001b[?2004l\r"]
[123.525759, "o", "\u001b[?2004h> "]
[123.525802, "o", "    while True:\r\n\u001b[?2004l\r"]
[123.525849, "o", "\u001b[?2004h> "]
[123.525935, "o", "        ok,frame=cap.read()\r\n\u001b[?2004l\r"]
[123.52598, "o", "\u001b[?2004h> "]
[123.52604, "o", "        if not ok: break\r\n\u001b[?2004l\r"]
[123.526087, "o", "\u001b[?2004h> "]
[123.526245, "o", "        if frame is None or frame.shape[:2] != (120,160):\r\n\u001b[?2004l\r"]
[123.526289, "o", "\u001b[?2004h> "]
[123.526437, "o", "            cap.release(); raise ValueError('invalid frame')\r\n\u001b[?2004l\r"]
[123.526477, "o", "\u001b[?2004h"]
[123.526517, "o", "> "]
[123.52656, "o", "        frames.append(frame)\r\n\u001b[?2004l\r"]
[123.526621, "o", "\u001b[?2004h> "]
[123.526704, "o", "    cap.release()\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.526768, "o", "> "]
[123.526899, "o", "    if not frames: raise ValueError('clip contains no frames')\r\n\u001b[?2004l\r"]
[123.526954, "o", "\u001b[?2004h> "]
[123.52702, "o", "    bg=make_background(frames)\r\n\u001b[?2004l\r"]
[123.527079, "o", "\u001b[?2004h> "]
[123.527136, "o", "    tracker=Tether()\r\n\u001b[?2004l\r"]
[123.527189, "o", "\u001b[?2004h> "]
[123.527255, "o", "    for frame in frames:\r\n\u001b[?2004l\r"]
[123.527313, "o", "\u001b[?2004h> "]
[123.527416, "o", "        detections,_=blot_marks(frame,bg)\r\n\u001b[?2004l\r"]
[123.527468, "o", "\u001b[?2004h> "]
[123.527551, "o", "        tracker.update(detections)\r\n\u001b[?2004l\r"]
[123.527611, "o", "\u001b[?2004h> "]
[123.527702, "o", "    return fold_gate(tracker.total)\r\n\u001b[?2004l\r"]
[123.527756, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[123.527808, "o", "\u001b[?2004h> "]
[123.527862, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.527914, "o", "> "]
[123.527987, "o", "    SHEET.parent.mkdir(parents=True,exist_ok=True)\r\n\u001b[?2004l\r"]
[123.528038, "o", "\u001b[?2004h> "]
[123.528163, "o", "    SHEET.write_text(toml.dumps({'crossings':int(n)}),encoding='utf-8')\r\n\u001b[?2004l\r"]
[123.528215, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[123.529281, "o", "\u001b[?2004hroot@0a311768df85:/app# \r\n"]
[123.529339, "o", "\u001b[?2004l\r\u001b[?2004hroot@0a311768df85:/app# "]
[123.529394, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[123.529446, "o", "\u001b[?2004h> "]
[123.529505, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.529576, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[123.52966, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.52972, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.529753, "o", "> "]
[123.529892, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[123.529965, "o", "\u001b[?2004h"]
[123.530033, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.530104, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.530226, "o", "> "]
[123.530295, "o", "    # Never leave a stale success artifact after any failed invocation.\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.530427, "o", "> "]
[123.530524, "o", "    try: SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[123.530652, "o", "\u001b[?2004h> "]
[123.530772, "o", "    except OSError: pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.530894, "o", "    if len(sys.argv) != 2: return 2\r\n\u001b[?2004l\r"]
[123.531017, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[123.531116, "o", "\u001b[?2004h> "]
[123.531246, "o", "        n=emit_span(sys.argv[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.531437, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r"]
[123.532297, "o", "\u001b[?2004h>     except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'mill: {exc}',file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>         try: SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>         except OSError: pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.532461, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n"]
[123.532649, "o", "\u001b[?2004l\r"]
[123.532681, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.532869, "o", "if __name__=='__main__': raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[123.53444, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[123.534747, "o", "chmod +x /app/kiln/bake.sh && /app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[123.624671, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[123.624883, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; echo status=$?; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[123.981741, "o", "mill: 'Track' object has no attribute 'col'\r\n"]
[124.017021, "o", "status=1\r\n"]
[124.01809, "o", "cat: /app/inkwell/sheet.toml: No such file or directory\r\n"]
[124.01841, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[124.018791, "o", "python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo bad_status=$?; test ! -e /app/inkwell/sheet.toml; echo absent_status=$?\r\n\u001b[?2004l\r"]
[124.311445, "o", "mill: cannot open clip\r\n"]
[124.352304, "o", "bad_status=1\r\nabsent_status=0\r\n"]
[124.352464, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[169.80271, "i", "sed -i 's/t\\.col))/t.colour))/' /app/tether.py\ngrep -n 'cd=' /app/tether.py\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; echo status=$?; cat /app/inkwell/sheet.toml\n"]
[169.803029, "o", "sed -i 's/t\\.col))/t.colour))/' /app/tether.py\r\n"]
[169.803131, "o", "\u001b[?2004l\r"]
[169.806137, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[169.806297, "o", "grep -n 'cd=' /app/tether.py\r\n\u001b[?2004l\r"]
[169.811907, "o", "56:                cd=float(np.linalg.norm(np.asarray(col)-t.colour))\r\n"]
[169.812155, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[169.812221, "o", "/app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[169.864297, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[169.864452, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; echo status=$?; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[170.24733, "o", "status=0\r\n"]
[170.248148, "o", "crossings = 3\r\n"]
[170.248422, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[173.826997, "i", "mkdir -p /tmp/milltests\ncat > /tmp/mktests.py <<'PY'\nimport cv2, numpy as np, os\nW,H=160,120\nbg=np.zeros((H,W,3),np.uint8)\nfor y in range(H): bg[y,:]=(52 if (y//10)%2 else 43,45 if (y//20)%2 else 38,42)\n\ndef write(name, paths, n=60):\n out=cv2.VideoWriter('/tmp/milltests/'+name+'.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\n for i in range(n):\n  f=bg.copy()\n  for color,path in paths:\n   p=path(i)\n   if p is not None:\n    x,y=p; cv2.circle(f,(int(x),int(y)),9,color,-1)\n  out.write(f)\n out.release()\n# Three simultaneous, including close/touching paths: truth 3\nwrite('simul', [((40,50,220),lambda i:(55,5+2*i) if i<58 else None),\n                ((50,190,55),lambda i:(75,0+2*i) if i<60 else None),\n                ((220,70,50),lambda i:(120,8+2*i) if i<56 else None)])\n# Upward-only body: truth 0\nwrite('up', [((220,90,40),lambda i:(80,110-2*i) if i<56 else None)])\n# Down to line, linger, then finish: truth 1\ndef linger(i):\n if i<25:return (70,20+2*i)\n if i<40:return (70,70)\n return (70,70+2*(i-39)) if i<60 else None\nwrite('linger',[((60,200,210),linger)],65)\n# One crosses, exits, later returns from top and crosses again: truth 1\ndef ret(i):\n if i<24:return (40,25+4*i)\n if 35<=i<59:return (40,10+4*(i-35))\n return None\nwrite('return',[((60,60,220),ret)],65)\n# Two bodies aligned (one fully shades the other for part): truth 2\nwrite('shade',[((40,210,220),lambda i:(80,5+2*i) if i<58 else None),\n               ((220,70,50),lambda i:(80,17+2*i) if i<52 else None)])\nPY\npython3 /tmp/mktests.py\nfor f in /tmp/milltests/*.mp4; do python3 /app/varnish/mill.pyc \"$f\" >/dev/null; printf '%-12s ' \"$(basename \"$f\")\"; cat /app/inkwell/sheet.toml; done\n"]
[173.827283, "o", "mkdir -p /tmp/milltests\r\n\u001b[?2004l\r"]
[173.830155, "o", "\u001b[?2004hroot@0a311768df85:/app# "]
[173.830315, "o", "cat > /tmp/mktests.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.830416, "o", "import cv2, numpy as np, os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.830521, "o", "W,H=160,120\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.830598, "o", "bg=np.zeros((H,W,3),np.uint8)\r\n\u001b[?2004l\r"]
[173.830721, "o", "\u001b[?2004h> "]
[173.83089, "o", "for y in range(H): bg[y,:]=(52 if (y//10)%2 else 43,45 if (y//20)%2 else 38,42)\r\n\u001b[?2004l\r"]
[173.830973, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.831082, "o", "def write(name, paths, n=60):\r\n\u001b[?2004l\r"]
[173.831175, "o", "\u001b[?2004h> "]
[173.831402, "o", " out=cv2.VideoWriter('/tmp/milltests/'+name+'.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\r\n\u001b[?2004l\r"]
[173.831427, "o", "\u001b[?2004h"]
[173.831529, "o", ">  for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.831546, "o", "  f=bg.copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.831559, "o", "> "]
[173.831643, "o", "  for color,path in paths:\r\n\u001b[?2004l\r"]
[173.831661, "o", "\u001b[?2004h> "]
[173.831704, "o", "   p=path(i)\r\n\u001b[?2004l\r"]
[173.831792, "o", "\u001b[?2004h> "]
[173.831882, "o", "   if p is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.832014, "o", "    x,y=p; cv2.circle(f,(int(x),int(y)),9,color,-1)\r\n\u001b[?2004l\r"]
[173.832083, "o", "\u001b[?2004h> "]
[173.832111, "o", "  out.write(f)\r\n\u001b[?2004l\r"]
[173.832128, "o", "\u001b[?2004h"]
[173.832185, "o", "> "]
[173.832224, "o", " out.release()\r\n\u001b[?2004l\r"]
[173.832259, "o", "\u001b[?2004h> "]
[173.832468, "o", "# Three simultaneous, including close/touching paths: truth 3\r\n\u001b[?2004l\r"]
[173.832559, "o", "\u001b[?2004h> "]
[173.832711, "o", "write('simul', [((40,50,220),lambda i:(55,5+2*i) if i<58 else None),\r\n\u001b[?2004l\r"]
[173.832793, "o", "\u001b[?2004h> "]
[173.833035, "o", "                ((50,190,55),lambda i:(75,0+2*i) if i<60 else None),\r\n\u001b[?2004l\r"]
[173.833155, "o", "\u001b[?2004h"]
[173.833287, "o", "> "]
[173.83347, "o", "                ((220,70,50),lambda i:(120,8+2*i) if i<56 else None)])\r\n\u001b[?2004l\r"]
[173.834312, "o", "\u001b[?2004h> # Upward-only body: truth 0"]
[173.834998, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> write('up', [((220,90,40),lambda i:(80,110-2*i) if i<56 else None)])\r\n\u001b[?2004l\r\u001b[?2004h> # Down to line, linger, then finish: truth 1\r\n\u001b[?2004l\r\u001b[?2004h> def linger(i):\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.835188, "o", ">  if i<25:return (70,20+2*i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.83524, "o", " if i<40:return (70,70)\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.835261, "o", "> "]
[173.835585, "o", " return (70,70+2*(i-39)) if i<60 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.83575, "o", "write('linger',[((60,200,210),linger)],65)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.836006, "o", "# One crosses, exits, later returns from top and crosses again: truth 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[173.836112, "o", "> def ret(i):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[173.836171, "o", " if i<24:return (40,25+4*i)\r\n\u001b[?2004l\r"]
[173.836283, "o", "\u001b[?2004h> "]
[173.836307, "o", " if 35<=i<59:return (40,10+4*(i-35))\r\n\u001b[?2004l\r"]
[173.836334, "o", "\u001b[?2004h> "]
[173.836477, "o", " return None\r\n\u001b[?2004l\r"]
[173.836502, "o", "\u001b[?2004h> "]
[173.836518, "o", "write('return',[((60,60,220),ret)],65)\r\n\u001b[?2004l\r"]
[173.83661, "o", "\u001b[?2004h> "]
[173.836827, "o", "# Two bodies aligned (one fully shades the other for part): truth 2\r\n\u001b[?2004l\r"]
[173.836941, "o", "\u001b[?2004h> "]
[173.837041, "o", "write('shade',[((40,210,220),lambda i:(80,5+2*i) if i<58 else None),\r\n\u001b[?2004l\r"]
[173.837136, "o", "\u001b[?2004h> "]
[173.837293, "o", "               ((220,70,50),lambda i:(80,17+2*i) if i<52 else None)])\r\n\u001b[?2004l\r"]
[173.837387, "o", "\u001b[?2004h"]
[173.837503, "o", "> PY\r\n\u001b[?2004l\r"]
