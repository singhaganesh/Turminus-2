[223.320711, "i", "python3 - <<'PY'\n# Execute source modules and trace count changes / track fragmentation.\nimport sys,cv2\nsys.path.insert(0,'/app')\nfrom blot import make_background,blot_marks\nfrom tether import Tether\np='/tmp/milltests/return.mp4'; c=cv2.VideoCapture(p); fs=[]\nwhile 1:\n ok,f=c.read()\n if not ok: break\n fs.append(f)\nbg=make_background(fs); tr=Tether()\nfor i,f in enumerate(fs):\n ds,_=blot_marks(f,bg); old=tr.total\n tr.update(ds)\n if old!=tr.total or i%5==0:\n  print(i,'det',[(round(d[0],1),round(d[1],1),round(d[2])) for d in ds],\n        'total',tr.total,'tracks',[(t.ident,round(t.x,1),round(t.y,1),t.hits,t.missed,t.counted) for t in tr.tracks])\nPY\n"]
[223.321171, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
