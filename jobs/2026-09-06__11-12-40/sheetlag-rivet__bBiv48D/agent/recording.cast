[81.023725, "o", "\u001b[01m\u001b[Kforgekit/emit.c:\u001b[m\u001b[K In function ‘\u001b[01m\u001b[Kemit_all\u001b[m\u001b[K’:\r\n\u001b[01m\u001b[Kforgekit/emit.c:35:58:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K‘\u001b[01m\u001b[K%s\u001b[m\u001b[K’ directive output may be truncated writing up to 1023 bytes into a region of size 489 [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wformat-truncation=\u0007-Wformat-truncation=\u001b]8;;\u0007\u001b[m\u001b[K]\r\n   26 |     char *name = \u001b[32m\u001b[Ktmp\u001b[m\u001b[K;\r\n      |                  \u001b[32m\u001b[K~~~\u001b[m\u001b[K                                      \r\n......\r\n   35 |     snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/\u001b[01;35m\u001b[K%s\u001b[m\u001b[K.kdec\", name);\r\n      |                                                          \u001b[01;35m\u001b[K^~\u001b[m\u001b[K\r\nIn function ‘\u001b[01m\u001b[Kemit_one\u001b[m\u001b[K’,\r\n    inlined from ‘\u001b[01m\u001b[Kemit_all\u001b[m\u001b[K’ at \u001b[01m\u001b[Kforgekit/emit.c:59:20\u001b[m\u001b[K:\r\n"]
