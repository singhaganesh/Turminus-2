[80.667138, "o", "\u001b[?2004h"]
[80.66862, "o", ">     char *spec = p2 + 1;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     char outp[512];\r\n\u001b[?2004l\r\u001b[?2004h>     snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *out = fopen(outp, \"w\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!out) return;\r\n\u001b[?2004l\r\u001b[?2004h>     fprintf(out, \"KDEC1\\nNAME %s\\n\", name);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     char *save = NULL;\r\n\u001b[?2004l\r\u001b[?2004h>     char *tok = strtok_r(spec, \",\", &save);\r\n\u001b[?2004l\r\u001b[?2004h>     while (tok) {\r\n\u001b[?2004l\r\u001b[?2004h>         char field[64], kind[16];\r\n\u001b[?2004l\r\u001b[?2004h>         if (sscanf(tok, \"%63[^:]:%15s\", field, kind) == 2)\r\n\u001b[?2004l\r\u001b[?2004h>             fprintf(out, \"%s %s\\n\", field, kind);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.668765, "o", "        tok = strtok_r(NULL, \",\", &save);\r\n\u001b[?2004l\r"]
