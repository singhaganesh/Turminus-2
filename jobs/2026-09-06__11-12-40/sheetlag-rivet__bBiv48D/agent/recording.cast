[22.866099, "o", "    12\t    while ((ent = readdir(d)) != NULL) {\r\n    13\t        size_t L = strlen(ent->d_name);\r\n    14\t        if (L > 5 && strcmp(ent->d_name + L - 5, \".kdec\") == 0) n++;\r\n    15\t    }\r\n    16\t    closedir(d);\r\n    17\t    return n;\r\n    18\t}\r\n    19\t\r\n    20\tstatic int count_sheet_lines(void) {\r\n    21\t    const char *s = sheet_view();\r\n    22\t    int n = 0;\r\n    23\t    int nonempty = 0;\r\n    24\t    for (; *s; s++) {\r\n    25\t        if (*s == '\\n') {\r\n"]
[22.866252, "o", "    26\t            if (nonempty) n++;\r\n    27\t            nonempty = 0;\r\n    28\t        } else if (*s != ' ' && *s != '\\r') nonempty = 1;\r\n    29\t    }\r\n    30\t    if (nonempty) n++;\r\n    31\t    return n;\r\n    32\t}\r\n    33\t\r\n    34\tint count_gap(void) {\r\n"]
[22.866288, "o", "    35\t    int a = count_sheet_lines();\r\n    36\t    int b = count_emitters();\r\n    37\t    return (b < a) ? 1 : 0;\r\n    38\t}\r\n"]
