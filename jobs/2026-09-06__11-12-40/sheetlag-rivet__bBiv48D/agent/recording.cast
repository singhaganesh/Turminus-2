[82.636385, "o", "/app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo \"evd=$(find evd -maxdepth 1 -type f -name '*.evd' | wc -l) kdec=$(find emitters -maxdepth 1 -type f -name '*.kdec' | wc -l) ledger=$(wc -l < intake/current.ledger)\"; echo '--- galley decoder ---'; cat emitters/galley_hatch.kdec; echo '--- galley decode ---'; /app/bin/rivetbay decode frames/galley_hatch.bin\r\n"]
