[80.643694, "i", "cat > forgekit/discover.c <<'EOF'\n#include \"discover.h\"\n#include \"parse_evd.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n\n#define MAX_DESCRIPTIONS 1024\n\nstruct description {\n    char name[128];\n    char fname[256];\n    char fields[512];\n    int written;\n};\n\nstatic int load_prior_names(char names[][128], int cap) {\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\n    char line[1024];\n    int n = 0;\n    if (!f) return 0;\n    while (n < cap && fgets(line, sizeof(line), f)) {\n        char *bar = strchr(line, '|');\n        if (!bar) continue;\n        *bar = 0;\n        if (!line[0]) continue;\n        snprintf(names[n], 128, \"%s\", line);\n        n++;\n    }\n    fclose(f);\n    return n;\n}\n\nstatic int find_description(struct description *descs, int n, const char *name) {\n    for (int i = 0; i < n; i++)\n        if (strcmp(descs[i].name, name) == 0) return i;\n    return -1;\n}\n\nstatic void write_row(FILE *out, struct description *d) {\n    fprintf(out, \"%s|evd/%s|%s\\n\", d->name, d->fname, d->fields);\n    d->written = 1;\n}\n\nvoid discover_all(void) {\n    char prior[MAX_DESCRIPTIONS][128];\n    struct description descs[MAX_DESCRIPTIONS];\n    int nprior = load_prior_names(prior, MAX_DESCRIPTIONS);\n    int ndesc = 0;\n    DIR *dir = opendir(\"/app/rivetbay/evd\");\n    if (!dir) return;\n\n    struct dirent *ent;\n    while ((ent = readdir(dir)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len < 5 || strcmp(ent->d_name + len - 4, \".evd\") != 0) continue;\n        if (ndesc >= MAX_DESCRIPTIONS) break;\n\n        char path[512];\n        char name[128];\n        char fields[512];\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\n        if (find_description(descs, ndesc, name) >= 0) continue;\n\n        snprintf(descs[ndesc].name, sizeof(descs[ndesc].name), \"%s\", name);\n        snprintf(descs[ndesc].fname, sizeof(descs[ndesc].fname), \"%s\", ent->d_name);\n        snprintf(descs[ndesc].fields, sizeof(descs[ndesc].fields), \"%s\", fields);\n        descs[ndesc].written = 0;\n        ndesc++;\n    }\n    closedir(dir);\n\n    const char *tmp = \"/app/rivetbay/intake/current.ledger.tmp\";\n    FILE *out = fopen(tmp, \"w\");\n    if (!out) return;\n\n    for (int i = 0; i < nprior; i++) {\n        int j = find_description(descs, ndesc, prior[i]);\n        if (j >= 0 && !descs[j].written) write_row(out, &descs[j]);\n    }\n    for (int i = 0; i < ndesc; i++)\n        if (!descs[i].written) write_row(out, &descs[i]);\n\n    if (fclose(out) != 0 || rename(tmp, \"/app/rivetbay/intake/current.ledger\") != 0)\n        remove(tmp);\n}\nEOF\ncat > forgekit/emit.c <<'EOF'\n#include \"emit.h\"\n#include \"sheet.h\"\n#include <dirent.h>\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic void clear_emitters(void) {\n    DIR *d = opendir(\"/app/rivetbay/emitters\");\n    if (!d) return;\n    struct dirent *ent;\n    while ((ent = readdir(d)) != NULL) {\n        size_t len = strlen(ent->d_name);\n        if (len > 5 && strcmp(ent->d_name + len - 5, \".kdec\") == 0) {\n            char path[512];\n            snprintf(path, sizeof(path), \"/app/rivetbay/emitters/%s\", ent->d_name);\n            unlink(path);\n        }\n    }\n    closedir(d);\n}\n\nstatic void emit_one(const char *line) {\n    char tmp[1024];\n    snprintf(tmp, sizeof(tmp), \"%s\", line);\n    char *name = tmp;\n    char *p1 = strchr(tmp, '|');\n    if (!p1) return;\n    *p1 = 0;\n    char *p2 = strchr(p1 + 1, '|');\n    if (!p2) return;\n    char *spec = p2 + 1;\n\n    char outp[512];\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\n    FILE *out = fopen(outp, \"w\");\n    if (!out) return;\n    fprintf(out, \"KDEC1\\nNAME %s\\n\", name);\n\n    char *save = NULL;\n    char *tok = strtok_r(spec, \",\", &save);\n    while (tok) {\n        char field[64], kind[16];\n        if (sscanf(tok, \"%63[^:]:%15s\", field, kind) == 2)\n            fprintf(out, \"%s %s\\n\", field, kind);\n        tok = strtok_r(NULL, \",\", &save);\n    }\n    fclose(out);\n}\n\nvoid emit_all(void) {\n    char buf[65536];\n    snprintf(buf, s"]
[80.643881, "i", "izeof(buf), \"%s\", sheet_view());\n    clear_emitters();\n\n    char *save = NULL;\n    char *line = strtok_r(buf, \"\\n\", &save);\n    while (line) {\n        if (*line) emit_one(line);\n        line = strtok_r(NULL, \"\\n\", &save);\n    }\n}\nEOF\npython3 - <<'PY'\np='forgekit/driver.c'\ns=open(p).read()\ns=s.replace('        prime_intake_sheet();\\n        discover_all();\\n        pour_sheet();', '        discover_all();\\n        prime_intake_sheet();\\n        pour_sheet();')\nopen(p,'w').write(s)\np='/app/millscore/tally.c'\ns=open(p).read().replace('return (b < a) ? 1 : 0;', 'return (b == a) ? 0 : 1;')\nopen(p,'w').write(s)\nPY\nmake hull\n"]
