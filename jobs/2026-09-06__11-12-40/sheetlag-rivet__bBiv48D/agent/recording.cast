[82.64565, "o", "mill_rc=0\r\n"]
[82.671296, "o", "evd=8 kdec=8 ledger=8\r\n--- galley decoder ---\r\n"]
[82.675723, "o", "KDEC1\r\nNAME galley_hatch\r\nlatch u8\r\nforce u16\r\n--- galley decode ---\r\n{\"kind\":\"decoded\",\"name\":\"galley_hatch\",\"fields\":{\"latch\":1,\"force\":44}}\r\n\u001b[?2004hroot@5782a8f3ece9:/app/rivetbay# "]
[83.589815, "i", "cp intake/current.ledger /tmp/rivet-ledger-before; cat > evd/verifier_fresh_file.evd <<'EOF'\nNAME fresh_event\nFIELD mm u16\nFIELD bit u8\nFIELD w u16\nEOF\npython3 - <<'PY'\nimport struct\nname=b'fresh_event'\npayload=struct.pack('>HBH', 513, 7, 4096)\nopen('frames/fresh_event.bin','wb').write(struct.pack('>I',len(name))+name+payload)\nPY\nprintf 'stale\\n' > emitters/not_a_description.kdec\n/app/bin/rivetbay mill; rc=$?; echo \"fresh_mill_rc=$rc\"; echo \"evd=$(find evd -maxdepth 1 -type f -name '*.evd' | wc -l) kdec=$(find emitters -maxdepth 1 -type f -name '*.kdec' | wc -l) ledger=$(wc -l < intake/current.ledger)\"; test ! -e emitters/not_a_description.kdec && echo stale_removed=yes; tail -n 2 intake/current.ledger; cat emitters/fresh_event.kdec; /app/bin/rivetbay decode frames/fresh_event.bin; head -n 8 intake/current.ledger > /tmp/rivet-ledger-existing; cmp -s /tmp/rivet-ledger-before /tmp/rivet-ledger-existing && echo prior_order_preserved=yes\n"]
[83.590241, "o", "cp intake/current.ledger /tmp/rivet-ledger-before; cat > evd/verifier_fresh_file.evd <<'EOF'\r\n\u001b[?2004l\r"]
