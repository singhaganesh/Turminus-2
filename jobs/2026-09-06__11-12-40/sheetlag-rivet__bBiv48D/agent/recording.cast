[23.155021, "o", "forgekit/sheet.h:3:void prime_intake_sheet(void);\r\nforgekit/sheet.h:5:void pour_sheet(void);\r\nforgekit/sheet.h:6:const char *sheet_view(void);\r\nforgekit/sheet.h:7:int sheet_emit_cap(void);\r\nforgekit/discover.c:1:#include \"discover.h\"\r\nforgekit/discover.c:13:static int load_prior_stems(char stems[][128], int cap) {\r\nforgekit/discover.c:18:    while (n < cap && fgets(line, sizeof(line), f)) {\r\nforgekit/discover.c:33:static int emit_row(FILE *out, const char *fname) {\r\nforgekit/discover.c:43:void discover_all(void) {\r\nforgekit/discover.c:74:        emit_row(out, want);\r\nforgekit/discover.c:77:        emit_row(out, pending[i]);\r\nforgekit/emit.c:1:#include \"emit.h\"\r\nforgekit/emit.c:7:static void emit_one(const char *line) {\r\n"]
[23.155192, "o", "forgekit/emit.c:21:    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\nforgekit/emit.c:35:void emit_all(void) {\r\nforgekit/emit.c:36:    const char *blob = sheet_view();\r\nforgekit/emit.c:37:    int cap = sheet_emit_cap();\r\nforgekit/emit.c:45:        if (idx >= cap) break;\r\nforgekit/emit.c:46:        if (line[0]) emit_one(line);\r\nforgekit/emit.h:3:void emit_all(void);\r\nforgekit/decode.c:25:    snprintf(kpath, sizeof(kpath), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n"]
[23.155316, "o", "/app/millscore/tally.c:7:static int count_emitters(void) {\r\n/app/millscore/tally.c:8:    DIR *d = opendir(\"/app/rivetbay/emitters\");\r\n/app/millscore/tally.c:20:static int count_sheet_lines(void) {\r\n/app/millscore/tally.c:21:    const char *s = sheet_view();\r\n/app/millscore/tally.c:34:int count_gap(void) {\r\n/app/millscore/tally.c:35:    int a = count_sheet_lines();\r\n"]
