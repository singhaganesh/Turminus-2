[11.488054, "o", "#ifndef PARSE_EVD_H\r\n#define PARSE_EVD_H\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz);\r\n#endif\r\n"]
[11.488409, "o", "./forgekit/discover.h\r\n"]
[11.489376, "o", "### ./forgekit/discover.h\r\n"]
[11.490298, "o", "#ifndef DISCOVER_H\r\n#define DISCOVER_H\r\nvoid discover_all(void);\r\n#endif\r\n"]
[11.490611, "o", "./forgekit/driver.c\r\n"]
[11.491343, "o", "### ./forgekit/driver.c\r\n"]
[11.492458, "o", "#include \"discover.h\"\r\n#include \"sheet.h\"\r\n#include \"emit.h\"\r\n#include \"tally.h\"\r\n#include \"decode.h\"\r\n#include \"warmup.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic void note_mill_pass(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    if (!f) return;\r\n"]
[11.492584, "o", "    fputc('1', f);\r\n    fputc('\\n', f);\r\n    fclose(f);\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n        note_mill_pass();\r\n        warm_maybe();\r\n        prime_intake_sheet();\r\n        discover_all();\r\n        pour_sheet();\r\n        emit_all();\r\n        return count_gap();\r\n    }\r\n    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n        return decode_frame(argv[2]);\r\n    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    return 2;\r\n}\r\n"]
[11.492898, "o", "./forgekit/snapshot.c\r\n"]
[11.493727, "o", "### ./forgekit/snapshot.c\r\n"]
[11.49489, "o", "#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic char g_primed[65536];\r\nstatic char g_emit[65536];\r\nstatic int g_emit_cap;\r\n\r\nstatic int count_nonempty_lines(const char *blob) {\r\n    int n = 0;\r\n    int nonempty = 0;\r\n    for (const char *s = blob; *s; s++) {\r\n        if (*s == '\\n') {\r\n            if (nonempty) n++;\r\n"]
[11.495029, "o", "            nonempty = 0;\r\n        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n            nonempty = 1;\r\n        }\r\n    }\r\n    if (nonempty) n++;\r\n    return n;\r\n}\r\n\r\nstatic void load_ledger_into(char *dst, size_t cap) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    dst[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(dst, 1, cap - 1, f);\r\n    dst[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid prime_intake_sheet(void) {\r\n    load_ledger_into(g_primed, sizeof(g_primed));\r\n    g_emit_cap = count_nonempty_lines(g_primed);\r\n    g_emit[0] = 0;\r\n}\r\n\r\nvoid grab_sheet(void) {\r\n    load_ledger_into(g_primed, sizeof(g_primed));\r\n}\r\n\r\nvoid pour_sheet(void) {\r\n    char buf[65536];\r\n    char out[65536];\r\n    strncpy(buf, g_primed, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    size_t w = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        while (*line == ' ' || *line == '\\t') line++;\r\n        if (*line == 0) {\r\n            line = strtok_r(NULL, \"\\n\", &save);\r\n            continue;\r\n        }\r\n        size_t L = strlen(line);\r\n        if (w + L + 1 >= sizeof(out)) break;\r\n        memcpy(out + w, line, L);\r\n        w += L;\r\n        out[w++] = '\\n';\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n    out[w] = 0;\r\n    memcpy(g_emit, out, w + 1);\r\n}\r\n\r\nconst char *sheet_view(void) {\r\n    return g_emit;\r\n}\r\n"]
[11.495123, "o", "\r\nint sheet_emit_cap(void) {\r\n    return g_emit_cap;\r\n}\r\n"]
[11.495422, "o", "./forgekit/sheet.h\r\n"]
[11.496398, "o", "### ./forgekit/sheet.h\r\n"]
[11.497363, "o", "#ifndef SHEET_H\r\n#define SHEET_H\r\nvoid prime_intake_sheet(void);\r\nvoid grab_sheet(void);\r\nvoid pour_sheet(void);\r\nconst char *sheet_view(void);\r\nint sheet_emit_cap(void);\r\n#endif\r\n"]
[11.497835, "o", "./forgekit/utf_tidy.h\r\n"]
[11.498755, "o", "### ./forgekit/utf_tidy.h\r\n"]
[11.499711, "o", "#ifndef UTF_TIDY_H\r\n#define UTF_TIDY_H\r\nvoid tidy_copy(const char *src, char *dst, int n);\r\n#endif\r\n"]
[11.50006, "o", "./forgekit/warmup.c\r\n"]
[11.500837, "o", "### ./forgekit/warmup.c\r\n"]
[11.501763, "o", "#include \"warmup.h\"\r\n#include \"sheet.h\"\r\n#include <stdlib.h>\r\n\r\nvoid warm_maybe(void) {\r\n    const char *e = getenv(\"RIVET_WARM\");\r\n    if (e && e[0] == '1') {\r\n        grab_sheet();\r\n    }\r\n}\r\n"]
[11.502162, "o", "./forgekit/discover.c\r\n"]
[11.503052, "o", "### ./forgekit/discover.c\r\n"]
[11.504039, "o", "#include \"discover.h\"\r\n#include \"parse_evd.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int stem_seen(const char *stem, char stems[][128], int n) {\r\n    for (int i = 0; i < n; i++)\r\n        if (strcmp(stems[i], stem) == 0) return 1;\r\n    return 0;\r\n}\r\n\r\nstatic int load_prior_stems(char stems[][128], int cap) {\r\n    int n = 0;\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    char line[1024];\r\n    if (!f) return 0;\r\n    while (n < cap && fgets(line, sizeof(line), f)) {\r\n        char *bar = strchr(line, '|');\r\n        if (!bar) continue;\r\n        *bar = 0;\r\n        char *s = line;\r\n        while (*s == ' ' || *s == '\\t') s++;\r\n        if (*s == 0) continue;\r\n        strncpy(stems[n], s, 127);\r\n"]
[11.504195, "o", "        stems[n][127] = 0;\r\n        n++;\r\n    }\r\n    fclose(f);\r\n    return n;\r\n}\r\n\r\nstatic int emit_row(FILE *out, const char *fname) {\r\n    char path[512];\r\n    snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", fname);\r\n    char name[128];\r\n    char fields[512];\r\n    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n    fprintf(out, \"%s|evd/%s|%s\\n\", name, fname, fields);\r\n    return 1;\r\n}\r\n\r\nvoid discover_all(void) {\r\n    char prior[64][128];\r\n    char pending[64][256];\r\n    int nprior = load_prior_stems(prior, 64);\r\n    int npend = 0;\r\n    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    if (!d || !out) {\r\n        if (d) closedir(d);\r\n        if (out) fclose(out);\r\n        return;\r\n    }\r\n    struct dirent *ent;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n        char name[128];\r\n        char fields[512];\r\n        char path[512];\r\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n        if (stem_seen(name, prior, nprior)) continue;\r\n        if (npend < 64) {\r\n            strncpy(pending[npend], ent->d_name, 255);\r\n            pending[npend][255] = 0;\r\n            npend++;\r\n        }\r\n    }\r\n    for (int i = 0; i < nprior; i++) {\r\n        char want[256];\r\n"]
[11.504302, "o", "        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n        emit_row(out, want);\r\n    }\r\n    for (int i = 0; i < npend; i++)\r\n        emit_row(out, pending[i]);\r\n    fclose(out);\r\n    closedir(d);\r\n}\r\n"]
[11.504692, "o", "./forgekit/emit.c\r\n"]
[11.505795, "o", "### ./forgekit/emit.c\r\n"]
[11.50683, "o", "#include \"emit.h\"\r\n#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void emit_one(const char *line) {\r\n    char tmp[1024];\r\n    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    tmp[sizeof(tmp) - 1] = 0;\r\n    char *nl = strchr(tmp, '\\n');\r\n    if (nl) *nl = 0;\r\n    char *name = tmp;\r\n    char *p1 = strchr(tmp, '|');\r\n    if (!p1) return;\r\n    *p1 = 0;\r\n    char *p2 = strchr(p1 + 1, '|');\r\n    if (!p2) return;\r\n    char *spec = p2 + 1;\r\n    char outp[512];\r\n"]
[11.506957, "o", "    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *o = fopen(outp, \"w\");\r\n    if (!o) return;\r\n    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    char *tok = strtok(spec, \",\");\r\n    while (tok) {\r\n        char fn[64], k[16];\r\n        if (sscanf(tok, \"%63[^:]:%15s\", fn, k) == 2)\r\n            fprintf(o, \"%s %s\\n\", fn, k);\r\n        tok = strtok(NULL, \",\");\r\n    }\r\n    fclose(o);\r\n}\r\n\r\nvoid emit_all(void) {\r\n    const char *blob = sheet_view();\r\n    int cap = sheet_emit_cap();\r\n    char buf[65536];\r\n    strncpy(buf, blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    int idx = 0;\r\n    while (line) {\r\n        if (idx >= cap) break;\r\n        if (line[0]) emit_one(line);\r\n        idx++;\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n}\r\n"]
[11.507271, "o", "./forgekit/warmup.h\r\n"]
[11.508039, "o", "### ./forgekit/warmup.h\r\n"]
[11.508962, "o", "#ifndef WARMUP_H\r\n#define WARMUP_H\r\nvoid warm_maybe(void);\r\n#endif\r\n"]
[11.509315, "o", "./forgekit/emit.h\r\n"]
[11.510099, "o", "### ./forgekit/emit.h\r\n"]
[11.511133, "o", "#ifndef EMIT_H\r\n#define EMIT_H\r\nvoid emit_all(void);\r\n#endif\r\n"]
[11.511473, "o", "./forgekit/decode.h\r\n"]
[11.512283, "o", "### ./forgekit/decode.h\r\n"]
[11.513282, "o", "#ifndef DECODE_H\r\n#define DECODE_H\r\nint decode_frame(const char *path);\r\n#endif\r\n"]
[11.513563, "o", "./forgekit/parse_evd.c\r\n"]
[11.514427, "o", "### ./forgekit/parse_evd.c\r\n"]
[11.515778, "o", "#include \"parse_evd.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return -1;\r\n    name[0] = 0;\r\n    fields[0] = 0;\r\n    char line[256];\r\n"]
[11.516556, "o", "    int first = 1;\r\n    while (fgets(line, sizeof(line), f)) {\r\n        if (strncmp(line, \"NAME \", 5) == 0) {\r\n            sscanf(line + 5, \"%127s\", name);\r\n        } else if (strncmp(line, \"FIELD \", 6) == 0) {\r\n            char fn[64], k[16];\r\n            if (sscanf(line + 6, \"%63s %15s\", fn, k) == 2) {\r\n                if (!first) strncat(fields, \",\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, \":\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);\r\n                first = 0;\r\n            }\r\n        }\r\n    }\r\n    fclose(f);\r\n    return name[0] ? 0 : -1;\r\n}\r\n./forgekit/decode.c\r\n"]
[11.517508, "o", "### ./forgekit/decode.c\r\n"]
[11.518844, "o", "#include \"decode.h\"\r\n#include <stdint.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic uint32_t rd_be32(const unsigned char *p) {\r\n    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];\r\n}\r\n\r\nint decode_frame(const char *path) {\r\n    FILE *f = fopen(path, \"rb\");\r\n    if (!f) return 2;\r\n    unsigned char raw[4096];\r\n    size_t n = fread(raw, 1, sizeof(raw), f);\r\n    fclose(f);\r\n    if (n < 4) return 2;\r\n    uint32_t ln = rd_be32(raw);\r\n    if (n < 4 + ln) return 2;\r\n    char name[256];\r\n    if (ln >= sizeof(name)) return 2;\r\n    memcpy(name, raw + 4, ln);\r\n    name[ln] = 0;\r\n    char kpath[512];\r\n    snprintf(kpath, sizeof(kpath), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *k = fopen(kpath, \"r\");\r\n    if (!k) {\r\n        printf(\"{\\\"kind\\\":\\\"unknown\\\",\\\"name\\\":\\\"%s\\\"}\\n\", name);\r\n        return 0;\r\n"]
[11.519027, "o", "    }\r\n    char line[256];\r\n    char fields[32][64];\r\n    char kinds[32][16];\r\n    int nf = 0;\r\n    while (fgets(line, sizeof(line), k)) {\r\n        if (strncmp(line, \"KDEC1\", 5) == 0) continue;\r\n        if (strncmp(line, \"NAME \", 5) == 0) continue;\r\n        if (sscanf(line, \"%63s %15s\", fields[nf], kinds[nf]) == 2) nf++;\r\n    }\r\n    fclose(k);\r\n    const unsigned char *p = raw + 4 + ln;\r\n    size_t left = n - 4 - ln;\r\n    printf(\"{\\\"kind\\\":\\\"decoded\\\",\\\"name\\\":\\\"%s\\\",\\\"fields\\\":{\", name);\r\n    for (int i = 0; i < nf; i++) {\r\n        unsigned v = 0;\r\n        if (strcmp(kinds[i], \"u16\") == 0) {\r\n            if (left < 2) break;\r\n            v = ((unsigned)p[0] << 8) | p[1];\r\n            p += 2; left -= 2;\r\n        } else {\r\n            if (left < 1) break;\r\n            v = p[0];\r\n            p += 1; left -= 1;\r\n        }\r\n        printf(\"%s\\\"%s\\\":%u\", i ? \",\" : \"\", fields[i], v);\r\n    }\r\n    printf(\"}}\\n\");\r\n    return 0;\r\n}\r\n"]
[11.519818, "o", "./Makefile\r\n"]
[11.521261, "o", "### ./Makefile\r\n"]
[11.522582, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore\r\nSRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)\r\nBIN := /app/bin/rivetbay\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[11.52402, "o", "\u001b[?2004hroot@5782a8f3ece9:/app/rivetbay# "]
[11.91468, "i", "printf '\\n--- current mill run ---\\n'; /app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo \"evd=$(find evd -maxdepth 1 -type f -name '*.evd' | wc -l) kdec=$(find emitters -maxdepth 1 -type f -name '*.kdec' | wc -l) ledger=$(wc -l < intake/current.ledger)\"\n"]
[11.915537, "o", "printf '\\n--- current mill run ---\\n'; /app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo \"evd=$(find evd -maxdepth 1 -type f -name '*.evd' | wc -l) kdec=$(find emitters -maxdepth 1 -type f -name '*.kdec' | wc -l) ledger=$(wc -l < intake/current.ledger)\"\r\n\u001b[?2004l\r"]
[11.915795, "o", "\r\n--- current mill run ---\r\n"]
[11.919635, "o", "mill_rc=0\r\n"]
[11.92961, "o", "evd=8 kdec=7 ledger=8\r\n"]
[11.929788, "o", "\u001b[?2004hroot@5782a8f3ece9:/app/rivetbay# "]
[22.69035, "i", "for f in forgekit/driver.c forgekit/discover.c forgekit/snapshot.c forgekit/sheet.h forgekit/emit.c forgekit/warmup.c; do echo \"### $f\"; nl -ba \"$f\"; done\n"]
[22.691582, "o", "for f in forgekit/driver.c forgekit/discover.c forgekit/snapshot.c forgekit/sheet.h forgekit/emit.c forgekit/warmup.c; do echo \"### $f\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r### forgekit/driver.c\r\n"]
[22.692686, "o", "     1\t#include \"discover.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include \"emit.h\"\r\n     4\t#include \"tally.h\"\r\n"]
[22.692877, "o", "     5\t#include \"decode.h\"\r\n     6\t#include \"warmup.h\"\r\n     7\t#include <stdio.h>\r\n     8\t#include <string.h>\r\n     9\t\r\n    10\tstatic void note_mill_pass(void) {\r\n    11\t    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    12\t    if (!f) return;\r\n    13\t    fputc('1', f);\r\n    14\t    fputc('\\n', f);\r\n    15\t    fclose(f);\r\n    16\t}\r\n    17\t\r\n    18\tint main(int argc, char **argv) {\r\n    19\t    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n    20\t        note_mill_pass();\r\n    21\t        warm_maybe();\r\n    22\t        prime_intake_sheet();\r\n    23\t        discover_all();\r\n    24\t        pour_sheet();\r\n    25\t        emit_all();\r\n    26\t        return count_gap();\r\n    27\t    }\r\n    28\t    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n    29\t        return decode_frame(argv[2]);\r\n    30\t    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    31\t    return 2;\r\n    32\t}\r\n"]
[22.693506, "o", "### forgekit/discover.c\r\n"]
[22.694621, "o", "     1\t#include \"discover.h\"\r\n     2\t#include \"parse_evd.h\"\r\n     3\t#include <dirent.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic int stem_seen(const char *stem, char stems[][128], int n) {\r\n     8\t    for (int i = 0; i < n; i++)\r\n     9\t        if (strcmp(stems[i], stem) == 0) return 1;\r\n    10\t    return 0;\r\n    11\t}\r\n    12\t\r\n    13\tstatic int load_prior_stems(char stems[][128], int cap) {\r\n    14\t    int n = 0;\r\n    15\t    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    16\t    char line[1024];\r\n    17\t    if (!f) return 0;\r\n    18\t    while (n < cap && fgets(line, sizeof(line), f)) {\r\n    19\t        char *bar = strchr(line, '|');\r\n    20\t        if (!bar) continue;\r\n    21\t        *bar = 0;\r\n"]
[22.695139, "o", "    22\t        char *s = line;\r\n    23\t        while (*s == ' ' || *s == '\\t') s++;\r\n    24\t        if (*s == 0) continue;\r\n    25\t        strncpy(stems[n], s, 127);\r\n    26\t        stems[n][127] = 0;\r\n    27\t        n++;\r\n    28\t    }\r\n    29\t    fclose(f);\r\n    30\t    return n;\r\n    31\t}\r\n    32\t\r\n    33\tstatic int emit_row(FILE *out, const char *fname) {\r\n    34\t    char path[512];\r\n    35\t    snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", fname);\r\n    36\t    char name[128];\r\n    37\t    char fields[512];\r\n    38\t    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n    39\t    fprintf(out, \"%s|evd/%s|%s\\n\", name, fname, fields);\r\n    40\t    return 1;\r\n    41\t}\r\n    42\t\r\n    43\tvoid discover_all(void) {\r\n    44\t    char prior[64][128];\r\n    45\t    char pending[64][256];\r\n    46\t    int nprior = load_prior_stems(prior, 64);\r\n    47\t    int npend = 0;\r\n    48\t    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    49\t    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    50\t    if (!d || !out) {\r\n    51\t        if (d) closedir(d);\r\n    52\t        if (out) fclose(out);\r\n    53\t        return;\r\n    54\t    }\r\n    55\t    struct dirent *ent;\r\n    56\t    while ((ent = readdir(d)) != NULL) {\r\n    57\t        size_t L = strlen(ent->d_name);\r\n    58\t        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n    59\t        char name[128];\r\n    60\t        char fields[512];\r\n    61\t        char path[512];\r\n    62\t        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n    63\t        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n    64\t        if (stem_seen(name, prior, nprior)) continue;\r\n    65\t        if (npend < 64) {\r\n    66\t            strncpy(pending[npend], ent->d_name, 255);\r\n    67\t            pending[npend][255] = 0;\r\n    68\t            npend++;\r\n    69\t        }\r\n    70\t    }\r\n    71\t    for (int i = 0; i < nprior; i++) {\r\n    72\t        char want[256];\r\n    73\t        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n    74\t        emit_row(out, want);\r\n    75\t    }\r\n    76\t    for (int i = 0; i < npend; i++)\r\n    77\t        emit_row(out, pending[i]);\r\n    78\t    fclose(out);\r\n    79\t    closedir(d);\r\n    80\t}\r\n"]
[22.695892, "o", "### forgekit/snapshot.c\r\n"]
[22.696298, "o", "     1\t#include \"sheet.h\"\r\n     2\t#include <stdio.h>\r\n     3\t#include <string.h>\r\n     4\t\r\n     5\tstatic char g_primed[65536];\r\n     6\tstatic char g_emit[65536];\r\n     7\tstatic int g_emit_cap;\r\n     8\t\r\n     9\tstatic int count_nonempty_lines(const char *blob) {\r\n    10\t    int n = 0;\r\n    11\t    int nonempty = 0;\r\n    12\t    for (const char *s = blob; *s; s++) {\r\n    13\t        if (*s == '\\n') {\r\n    14\t            if (nonempty) n++;\r\n    15\t            nonempty = 0;\r\n    16\t        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n    17\t            nonempty = 1;\r\n    18\t        }\r\n    19\t    }\r\n    20\t    if (nonempty) n++;\r\n    21\t    return n;\r\n    22\t}\r\n    23\t\r\n    24\tstatic void load_ledger_into(char *dst, size_t cap) {\r\n    25\t    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    26\t    dst[0] = 0;\r\n    27\t    if (!f) return;\r\n    28\t    size_t n = fread(dst, 1, cap - 1, f);\r\n    29\t    dst[n] = 0;\r\n"]
[22.696326, "o", "    30\t    fclose(f);\r\n    31\t}\r\n    32\t\r\n    33\tvoid prime_intake_sheet(void) {\r\n    34\t    load_ledger_into(g_primed, sizeof(g_primed));\r\n    35\t    g_emit_cap = count_nonempty_lines(g_primed);\r\n    36\t    g_emit[0] = 0;\r\n    37\t}\r\n    38\t\r\n    39\tvoid grab_sheet(void) {\r\n"]
[22.696341, "o", "    40\t    load_ledger_into(g_primed, sizeof(g_primed));\r\n    41\t}\r\n    42\t\r\n    43\tvoid pour_sheet(void) {\r\n    44\t    char buf[65536];\r\n    45\t    char out[65536];\r\n"]
[22.696355, "o", "    46\t    strncpy(buf, g_primed, sizeof(buf) - 1);\r\n    47\t    buf[sizeof(buf) - 1] = 0;\r\n    48\t    size_t w = 0;\r\n    49\t    char *save = NULL;\r\n"]
[22.696374, "o", "    50\t    char *line = strtok_r(buf, \"\\n\", &save);\r\n    51\t    while (line) {\r\n    52\t        while (*line == ' ' || *line == '\\t') line++;\r\n    53\t        if (*line == 0) {\r\n    54\t            line = strtok_r(NULL, \"\\n\", &save);\r\n    55\t            continue;\r\n"]
[22.696396, "o", "    56\t        }\r\n    57\t        size_t L = strlen(line);\r\n    58\t        if (w + L + 1 >= sizeof(out)) break;\r\n    59\t        memcpy(out + w, line, L);\r\n    60\t        w += L;\r\n    61\t        out[w++] = '\\n';\r\n    62\t        line = strtok_r(NULL, \"\\n\", &save);\r\n"]
[22.69642, "o", "    63\t    }\r\n    64\t    out[w] = 0;\r\n    65\t    memcpy(g_emit, out, w + 1);\r\n    66\t}\r\n    67\t\r\n    68\tconst char *sheet_view(void) {\r\n    69\t    return g_emit;\r\n"]
[22.696438, "o", "    70\t}\r\n    71\t\r\n    72\tint sheet_emit_cap(void) {\r\n    73\t    return g_emit_cap;\r\n    74\t}\r\n"]
[22.696934, "o", "### forgekit/sheet.h\r\n"]
[22.697499, "o", "     1\t#ifndef SHEET_H\r\n     2\t#define SHEET_H\r\n     3\tvoid prime_intake_sheet(void);\r\n     4\tvoid grab_sheet(void);\r\n     5\tvoid pour_sheet(void);\r\n     6\tconst char *sheet_view(void);\r\n     7\tint sheet_emit_cap(void);\r\n     8\t#endif\r\n"]
[22.697897, "o", "### forgekit/emit.c\r\n"]
[22.699174, "o", "     1\t#include \"emit.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic void emit_one(const char *line) {\r\n     8\t    char tmp[1024];\r\n     9\t    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    10\t    tmp[sizeof(tmp) - 1] = 0;\r\n    11\t    char *nl = strchr(tmp, '\\n');\r\n    12\t    if (nl) *nl = 0;\r\n    13\t    char *name = tmp;\r\n    14\t    char *p1 = strchr(tmp, '|');\r\n    15\t    if (!p1) return;\r\n    16\t    *p1 = 0;\r\n    17\t    char *p2 = strchr(p1 + 1, '|');\r\n    18\t    if (!p2) return;\r\n    19\t    char *spec = p2 + 1;\r\n    20\t    char outp[512];\r\n    21\t    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    22\t    FILE *o = fopen(outp, \"w\");\r\n    23\t    if (!o) return;\r\n    24\t    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    25\t    char *tok = strtok(spec, \",\");\r\n    26\t    while (tok) {\r\n    27\t        char fn[64], k[16];\r\n    28\t        if (sscanf(tok, \"%63[^:]:%15s\", fn, k) == 2)\r\n    29\t            fprintf(o, \"%s %s\\n\", fn, k);\r\n    30\t        tok = strtok(NULL, \",\");\r\n    31\t    }\r\n    32\t    fclose(o);\r\n    33\t}\r\n    34\t\r\n    35\tvoid emit_all(void) {\r\n    36\t    const char *blob = sheet_view();\r\n    37\t    int cap = sheet_emit_cap();\r\n    38\t    char buf[65536];\r\n    39\t    strncpy(buf, blob, sizeof(buf) - 1);\r\n    40\t    buf[sizeof(buf) - 1] = 0;\r\n    41\t    char *save = NULL;\r\n"]
[22.699539, "o", "    42\t    char *line = strtok_r(buf, \"\\n\", &save);\r\n    43\t    int idx = 0;\r\n    44\t    while (line) {\r\n    45\t        if (idx >= cap) break;\r\n    46\t        if (line[0]) emit_one(line);\r\n    47\t        idx++;\r\n    48\t        line = strtok_r(NULL, \"\\n\", &save);\r\n    49\t    }\r\n    50\t}\r\n"]
[22.699762, "o", "### forgekit/warmup.c\r\n"]
[22.700822, "o", "     1\t#include \"warmup.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include <stdlib.h>\r\n     4\t\r\n     5\tvoid warm_maybe(void) {\r\n     6\t    const char *e = getenv(\"RIVET_WARM\");\r\n     7\t    if (e && e[0] == '1') {\r\n     8\t        grab_sheet();\r\n"]
[22.700964, "o", "     9\t    }\r\n    10\t}\r\n"]
