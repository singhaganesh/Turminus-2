[10.145737, "o", "/app/rivetbay/forgekit/utf_tidy.c\r\n"]
[10.158553, "o", "### /app/rivetbay/forgekit/utf_tidy.c\r\n"]
[10.159272, "o", "#include \"utf_tidy.h\"\r\n#include <string.h>\r\nvoid tidy_copy(const char *src, char *dst, int n) {\r\n    if (n <= 0) return;\r\n    strncpy(dst, src, (size_t)n - 1);\r\n    dst[n - 1] = 0;\r\n}\r\n"]
[10.160979, "o", "/app/rivetbay/forgekit/parse_evd.h\r\n"]
[10.161296, "o", "### /app/rivetbay/forgekit/parse_evd.h\r\n"]
[10.170446, "o", "#ifndef PARSE_EVD_H\r\n#define PARSE_EVD_H\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz);\r\n#endif\r\n/app/rivetbay/forgekit/discover.h\r\n"]
[10.181658, "o", "### /app/rivetbay/forgekit/discover.h\r\n#ifndef DISCOVER_H\r\n#define DISCOVER_H\r\nvoid discover_all(void);\r\n#endif\r\n/app/rivetbay/forgekit/driver.c\r\n### /app/rivetbay/forgekit/driver.c\r\n"]
[10.182295, "o", "#include \"discover.h\"\r\n#include \"sheet.h\"\r\n#include \"emit.h\"\r\n#include \"tally.h\"\r\n#include \"decode.h\"\r\n#include \"warmup.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic void note_mill_pass(void) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    if (!f) return;\r\n    fputc('1', f);\r\n    fputc('\\n', f);\r\n    fclose(f);\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n        note_mill_pass();\r\n        warm_maybe();\r\n        prime_intake_sheet();\r\n        discover_all();\r\n        pour_sheet();\r\n        emit_all();\r\n        return count_gap();\r\n    }\r\n    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n        return decode_frame(argv[2]);\r\n    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    return 2;\r\n}\r\n"]
[10.182887, "o", "/app/rivetbay/forgekit/snapshot.c\r\n"]
[10.184074, "o", "### /app/rivetbay/forgekit/snapshot.c\r\n"]
[10.185387, "o", "#include \"sheet.h\"\r\n#include <stdio.h>\r\n"]
[10.185438, "o", "#include <string.h>\r\n\r\nstatic char g_primed[65536];\r\nstatic char g_emit[65536];\r\nstatic int g_emit_cap;\r\n\r\nstatic int count_nonempty_lines(const char *blob) {\r\n"]
[10.185458, "o", "    int n = 0;\r\n    int nonempty = 0;\r\n"]
[10.185472, "o", "    for (const char *s = blob; *s; s++) {\r\n"]
[10.185488, "o", "        if (*s == '\\n') {\r\n            if (nonempty) n++;\r\n            nonempty = 0;\r\n        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n            nonempty = 1;\r\n        }\r\n    }\r\n    if (nonempty) n++;\r\n    return n;\r\n}\r\n\r\n"]
[10.185819, "o", "static void load_ledger_into(char *dst, size_t cap) {\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    dst[0] = 0;\r\n    if (!f) return;\r\n    size_t n = fread(dst, 1, cap - 1, f);\r\n    dst[n] = 0;\r\n    fclose(f);\r\n}\r\n\r\nvoid prime_intake_sheet(void) {\r\n    load_ledger_into(g_primed, sizeof(g_primed));\r\n    g_emit_cap = count_nonempty_lines(g_primed);\r\n    g_emit[0] = 0;\r\n}\r\n\r\nvoid grab_sheet(void) {\r\n    load_ledger_into(g_primed, sizeof(g_primed));\r\n}\r\n\r\nvoid pour_sheet(void) {\r\n    char buf[65536];\r\n    char out[65536];\r\n    strncpy(buf, g_primed, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    size_t w = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    while (line) {\r\n        while (*line == ' ' || *line == '\\t') line++;\r\n        if (*line == 0) {\r\n            line = strtok_r(NULL, \"\\n\", &save);\r\n            continue;\r\n        }\r\n        size_t L = strlen(line);\r\n        if (w + L + 1 >= sizeof(out)) break;\r\n        memcpy(out + w, line, L);\r\n        w += L;\r\n        out[w++] = '\\n';\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n    out[w] = 0;\r\n    memcpy(g_emit, out, w + 1);\r\n}\r\n\r\nconst char *sheet_view(void) {\r\n    return g_emit;\r\n}\r\n\r\nint sheet_emit_cap(void) {\r\n    return g_emit_cap;\r\n}\r\n"]
[10.186406, "o", "/app/rivetbay/forgekit/sheet.h\r\n"]
[10.18751, "o", "### /app/rivetbay/forgekit/sheet.h\r\n"]
[10.191111, "o", "#ifndef SHEET_H\r\n"]
[10.194016, "o", "#define SHEET_H\r\nvoid prime_intake_sheet(void);\r\nvoid grab_sheet(void);\r\nvoid pour_sheet(void);\r\nconst char *sheet_view(void);\r\nint sheet_emit_cap(void);\r\n#endif\r\n"]
[10.197103, "o", "/app/rivetbay/forgekit/utf_tidy.h\r\n"]
[10.198146, "o", "### /app/rivetbay/forgekit/utf_tidy.h\r\n"]
[10.200327, "o", "#ifndef UTF_TIDY_H\r\n#define UTF_TIDY_H\r\nvoid tidy_copy(const char *src, char *dst, int n);\r\n#endif\r\n"]
[10.20083, "o", "/app/rivetbay/forgekit/warmup.c\r\n"]
[10.201894, "o", "### /app/rivetbay/forgekit/warmup.c\r\n"]
[10.204206, "o", "#include \"warmup.h\"\r\n#include \"sheet.h\"\r\n#include <stdlib.h>\r\n\r\nvoid warm_maybe(void) {\r\n    const char *e = getenv(\"RIVET_WARM\");\r\n    if (e && e[0] == '1') {\r\n        grab_sheet();\r\n    }\r\n}\r\n"]
[10.204842, "o", "/app/rivetbay/forgekit/discover.c\r\n"]
[10.205789, "o", "### /app/rivetbay/forgekit/discover.c\r\n"]
[10.20861, "o", "#include \"discover.h\"\r\n#include \"parse_evd.h\"\r\n#include <dirent.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nstatic int stem_seen(const char *stem, char stems[][128], int n) {\r\n    for (int i = 0; i < n; i++)\r\n        if (strcmp(stems[i], stem) == 0) return 1;\r\n    return 0;\r\n}\r\n\r\nstatic int load_prior_stems(char stems[][128], int cap) {\r\n"]
[10.20876, "o", "    int n = 0;\r\n    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    char line[1024];\r\n    if (!f) return 0;\r\n    while (n < cap && fgets(line, sizeof(line), f)) {\r\n        char *bar = strchr(line, '|');\r\n        if (!bar) continue;\r\n        *bar = 0;\r\n        char *s = line;\r\n        while (*s == ' ' || *s == '\\t') s++;\r\n        if (*s == 0) continue;\r\n        strncpy(stems[n], s, 127);\r\n        stems[n][127] = 0;\r\n        n++;\r\n    }\r\n    fclose(f);\r\n    return n;\r\n}\r\n\r\nstatic int emit_row(FILE *out, const char *fname) {\r\n    char path[512];\r\n    snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", fname);\r\n    char name[128];\r\n    char fields[512];\r\n    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n    fprintf(out, \"%s|evd/%s|%s\\n\", name, fname, fields);\r\n    return 1;\r\n}\r\n\r\nvoid discover_all(void) {\r\n    char prior[64][128];\r\n    char pending[64][256];\r\n    int nprior = load_prior_stems(prior, 64);\r\n    int npend = 0;\r\n    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    if (!d || !out) {\r\n        if (d) closedir(d);\r\n        if (out) fclose(out);\r\n        return;\r\n    }\r\n    struct dirent *ent;\r\n    while ((ent = readdir(d)) != NULL) {\r\n        size_t L = strlen(ent->d_name);\r\n        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n        char name[128];\r\n        char fields[512];\r\n        char path[512];\r\n        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n        if (stem_seen(name, prior, nprior)) continue;\r\n        if (npend < 64) {\r\n            strncpy(pending[npend], ent->d_name, 255);\r\n            pending[npend][255] = 0;\r\n            npend++;\r\n        }\r\n    }\r\n    for (int i = 0; i < nprior; i++) {\r\n        char want[256];\r\n        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n        emit_row(out, want);\r\n    }\r\n    for (int i = 0; i < npend; i++)\r\n        emit_row(out, pending[i]);\r\n    fclose(out);\r\n    closedir(d);\r\n}\r\n"]
[10.209428, "o", "/app/rivetbay/forgekit/emit.c\r\n"]
[10.210615, "o", "### /app/rivetbay/forgekit/emit.c\r\n"]
[10.211703, "o", "#include \"emit.h\"\r\n#include \"sheet.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic void emit_one(const char *line) {\r\n    char tmp[1024];\r\n    strncpy(tmp, line, sizeof(tmp) - 1);\r\n    tmp[sizeof(tmp) - 1] = 0;\r\n    char *nl = strchr(tmp, '\\n');\r\n    if (nl) *nl = 0;\r\n    char *name = tmp;\r\n    char *p1 = strchr(tmp, '|');\r\n    if (!p1) return;\r\n    *p1 = 0;\r\n    char *p2 = strchr(p1 + 1, '|');\r\n    if (!p2) return;\r\n    char *spec = p2 + 1;\r\n    char outp[512];\r\n    snprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *o = fopen(outp, \"w\");\r\n    if (!o) return;\r\n    fprintf(o, \"KDEC1\\nNAME %s\\n\", name);\r\n    char *tok = strtok(spec, \",\");\r\n"]
[10.211864, "o", "    while (tok) {\r\n        char fn[64], k[16];\r\n        if (sscanf(tok, \"%63[^:]:%15s\", fn, k) == 2)\r\n            fprintf(o, \"%s %s\\n\", fn, k);\r\n        tok = strtok(NULL, \",\");\r\n    }\r\n    fclose(o);\r\n}\r\n\r\nvoid emit_all(void) {\r\n    const char *blob = sheet_view();\r\n    int cap = sheet_emit_cap();\r\n    char buf[65536];\r\n    strncpy(buf, blob, sizeof(buf) - 1);\r\n    buf[sizeof(buf) - 1] = 0;\r\n    char *save = NULL;\r\n    char *line = strtok_r(buf, \"\\n\", &save);\r\n    int idx = 0;\r\n    while (line) {\r\n        if (idx >= cap) break;\r\n"]
[10.211957, "o", "        if (line[0]) emit_one(line);\r\n        idx++;\r\n        line = strtok_r(NULL, \"\\n\", &save);\r\n    }\r\n}\r\n"]
[10.212238, "o", "/app/rivetbay/forgekit/warmup.h\r\n"]
[10.213134, "o", "### /app/rivetbay/forgekit/warmup.h\r\n"]
[10.214508, "o", "#ifndef WARMUP_H\r\n#define WARMUP_H\r\nvoid warm_maybe(void);\r\n#endif\r\n"]
[10.214922, "o", "/app/rivetbay/forgekit/emit.h\r\n"]
[10.215892, "o", "### /app/rivetbay/forgekit/emit.h\r\n"]
[10.217346, "o", "#ifndef EMIT_H\r\n#define EMIT_H\r\nvoid emit_all(void);\r\n#endif\r\n"]
[10.217854, "o", "/app/rivetbay/forgekit/decode.h\r\n"]
[10.218629, "o", "### /app/rivetbay/forgekit/decode.h\r\n"]
[10.219632, "o", "#ifndef DECODE_H\r\n#define DECODE_H\r\nint decode_frame(const char *path);\r\n#endif\r\n"]
[10.220035, "o", "/app/rivetbay/forgekit/parse_evd.c\r\n"]
[10.220799, "o", "### /app/rivetbay/forgekit/parse_evd.c\r\n"]
[10.222241, "o", "#include \"parse_evd.h\"\r\n#include <stdio.h>\r\n#include <string.h>\r\n\r\nint parse_evd_file(const char *path, char *name, char *fields, int fields_sz) {\r\n    FILE *f = fopen(path, \"r\");\r\n    if (!f) return -1;\r\n    name[0] = 0;\r\n    fields[0] = 0;\r\n    char line[256];\r\n    int first = 1;\r\n"]
[10.222356, "o", "    while (fgets(line, sizeof(line), f)) {\r\n        if (strncmp(line, \"NAME \", 5) == 0) {\r\n            sscanf(line + 5, \"%127s\", name);\r\n        } else if (strncmp(line, \"FIELD \", 6) == 0) {\r\n            char fn[64], k[16];\r\n            if (sscanf(line + 6, \"%63s %15s\", fn, k) == 2) {\r\n                if (!first) strncat(fields, \",\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, fn, fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, \":\", fields_sz - (int)strlen(fields) - 1);\r\n                strncat(fields, k, fields_sz - (int)strlen(fields) - 1);\r\n                first = 0;\r\n            }\r\n        }\r\n    }\r\n    fclose(f);\r\n    return name[0] ? 0 : -1;\r\n}\r\n"]
[10.222766, "o", "/app/rivetbay/forgekit/decode.c\r\n"]
[10.223629, "o", "### /app/rivetbay/forgekit/decode.c\r\n"]
[10.224952, "o", "#include \"decode.h\"\r\n#include <stdint.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic uint32_t rd_be32(const unsigned char *p) {\r\n    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];\r\n}\r\n\r\nint decode_frame(const char *path) {\r\n    FILE *f = fopen(path, \"rb\");\r\n    if (!f) return 2;\r\n    unsigned char raw[4096];\r\n    size_t n = fread(raw, 1, sizeof(raw), f);\r\n    fclose(f);\r\n    if (n < 4) return 2;\r\n    uint32_t ln = rd_be32(raw);\r\n    if (n < 4 + ln) return 2;\r\n    char name[256];\r\n"]
[10.225015, "o", "    if (ln >= sizeof(name)) return 2;\r\n    memcpy(name, raw + 4, ln);\r\n    name[ln] = 0;\r\n    char kpath[512];\r\n    snprintf(kpath, sizeof(kpath), \"/app/rivetbay/emitters/%s.kdec\", name);\r\n    FILE *k = fopen(kpath, \"r\");\r\n    if (!k) {\r\n        printf(\"{\\\"kind\\\":\\\"unknown\\\",\\\"name\\\":\\\"%s\\\"}\\n\", name);\r\n        return 0;\r\n    }\r\n    char line[256];\r\n    char fields[32][64];\r\n    char kinds[32][16];\r\n    int nf = 0;\r\n    while (fgets(line, sizeof(line), k)) {\r\n        if (strncmp(line, \"KDEC1\", 5) == 0) continue;\r\n        if (strncmp(line, \"NAME \", 5) == 0) continue;\r\n        if (sscanf(line, \"%63s %15s\", fields[nf], kinds[nf]) == 2) nf++;\r\n    }\r\n    fclose(k);\r\n    const unsigned char *p = raw + 4 + ln;\r\n    size_t left = n - 4 - ln;\r\n    printf(\"{\\\"kind\\\":\\\"decoded\\\",\\\"name\\\":\\\"%s\\\",\\\"fields\\\":{\", name);\r\n"]
[10.225042, "o", "    for (int i = 0; i < nf; i++) {\r\n        unsigned v = 0;\r\n        if (strcmp(kinds[i], \"u16\") == 0) {\r\n            if (left < 2) break;\r\n"]
[10.225062, "o", "            v = ((unsigned)p[0] << 8) | p[1];\r\n            p += 2; left -= 2;\r\n"]
[10.225078, "o", "        } else {\r\n            if (left < 1) break;\r\n            v = p[0];\r\n            p += 1; left -= 1;\r\n        }\r\n        printf(\"%s\\\"%s\\\":%u\", i ? \",\" : \"\", fields[i], v);\r\n"]
[10.225097, "o", "    }\r\n    printf(\"}}\\n\");\r\n"]
[10.225119, "o", "    return 0;\r\n"]
[10.225142, "o", "}\r\n"]
[10.225821, "o", "/app/rivetbay/Makefile\r\n"]
[10.226686, "o", "### /app/rivetbay/Makefile\r\n"]
[10.227708, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Iforgekit -I/app/millscore\r\nSRC := $(wildcard forgekit/*.c) $(wildcard /app/millscore/*.c)\r\nBIN := /app/bin/rivetbay\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[10.228598, "o", "\u001b[?2004hroot@e71d9565538a:/app/rivetbay# "]
[19.854107, "i", "cd /app/rivetbay; for f in forgekit/discover.c forgekit/discover.h forgekit/snapshot.c forgekit/sheet.h forgekit/driver.c forgekit/warmup.c forgekit/warmup.h; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[19.855205, "o", "cd /app/rivetbay; for f in forgekit/discover.c forgekit/discover.h forgekit/snapshot.c forgekit/sheet.h forgekit/driver.c forgekit/warmup.c forgekit/warmup.h; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r===== forgekit/discover.c =====\r\n"]
[19.860514, "o", "     1\t#include \"discover.h\"\r\n     2\t#include \"parse_evd.h\"\r\n     3\t#include <dirent.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n"]
[19.860709, "o", "     7\tstatic int stem_seen(const char *stem, char stems[][128], int n) {\r\n     8\t    for (int i = 0; i < n; i++)\r\n     9\t        if (strcmp(stems[i], stem) == 0) return 1;\r\n    10\t    return 0;\r\n    11\t}\r\n    12\t\r\n    13\tstatic int load_prior_stems(char stems[][128], int cap) {\r\n    14\t    int n = 0;\r\n    15\t    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    16\t    char line[1024];\r\n    17\t    if (!f) return 0;\r\n    18\t    while (n < cap && fgets(line, sizeof(line), f)) {\r\n    19\t        char *bar = strchr(line, '|');\r\n    20\t        if (!bar) continue;\r\n    21\t        *bar = 0;\r\n"]
[19.860744, "o", "    22\t        char *s = line;\r\n    23\t        while (*s == ' ' || *s == '\\t') s++;\r\n    24\t        if (*s == 0) continue;\r\n    25\t        strncpy(stems[n], s, 127);\r\n    26\t        stems[n][127] = 0;\r\n    27\t        n++;\r\n    28\t    }\r\n"]
[19.860945, "o", "    29\t    fclose(f);\r\n    30\t    return n;\r\n    31\t}\r\n"]
[19.860966, "o", "    32\t\r\n    33\tstatic int emit_row(FILE *out, const char *fname) {\r\n    34"]
[19.860982, "o", "\t    char path[512];\r\n    35\t    snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", fname);\r\n"]
[19.861107, "o", "    36\t    char name[128];\r\n    37\t    char fields[512];\r\n"]
[19.861128, "o", "    38\t    if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) return 0;\r\n    39\t    fprintf(out, \"%s|evd/%s|%s\\n\", name, fname, fields);\r\n"]
[19.8617, "o", "    40\t    return 1;\r\n    41\t}\r\n    42\t\r\n    43\tvoid discover_all(void) {\r\n    44\t    char prior[64][128];\r\n    45\t    char pending[64][256];\r\n    46\t    int nprior = load_prior_stems(prior, 64);\r\n    47\t    int npend = 0;\r\n    48\t    DIR *d = opendir(\"/app/rivetbay/evd\");\r\n    49\t    FILE *out = fopen(\"/app/rivetbay/intake/current.ledger\", \"w\");\r\n    50\t    if (!d || !out) {\r\n    51\t        if (d) closedir(d);\r\n    52\t        if (out) fclose(out);\r\n    53\t        return;\r\n    54\t    }\r\n    55\t    struct dirent *ent;\r\n    56\t    while ((ent = readdir(d)) != NULL) {\r\n"]
[19.862167, "o", "    57\t        size_t L = strlen(ent->d_name);\r\n    58\t        if (L < 5 || strcmp(ent->d_name + L - 4, \".evd\") != 0) continue;\r\n    59\t        char name[128];\r\n    60\t        char fields[512];\r\n    61\t        char path[512];\r\n    62\t        snprintf(path, sizeof(path), \"/app/rivetbay/evd/%s\", ent->d_name);\r\n    63\t        if (parse_evd_file(path, name, fields, sizeof(fields)) != 0) continue;\r\n    64\t        if (stem_seen(name, prior, nprior)) continue;\r\n    65\t        if (npend < 64) {\r\n    66\t            strncpy(pending[npend], ent->d_name, 255);\r\n    67\t            pending[npend][255] = 0;\r\n    68\t            npend++;\r\n    69\t        }\r\n    70\t    }\r\n    71\t    for (int i = 0; i < nprior; i++) {\r\n    72\t        char want[256];\r\n    73\t        snprintf(want, sizeof(want), \"%s.evd\", prior[i]);\r\n    74\t        emit_row(out, want);\r\n    75\t    }\r\n    76\t    for (int i = 0; i < npend; i++)\r\n    77\t        emit_row(out, pending[i]);\r\n    78\t    fclose(out);\r\n    79\t    closedir(d);\r\n    80\t}\r\n"]
[19.862593, "o", "===== forgekit/discover.h =====\r\n"]
[19.863751, "o", "     1\t#ifndef DISCOVER_H\r\n     2\t#define DISCOVER_H\r\n     3\tvoid discover_all(void);\r\n     4\t#endif\r\n"]
[19.864145, "o", "===== forgekit/snapshot.c =====\r\n"]
[19.865433, "o", "     1\t#include \"sheet.h\"\r\n     2\t#include <stdio.h>\r\n     3\t#include <string.h>\r\n     4\t\r\n     5\tstatic char g_primed[65536];\r\n     6\tstatic char g_emit[65536];\r\n     7\tstatic int g_emit_cap;\r\n     8\t\r\n     9\tstatic int count_nonempty_lines(const char *blob) {\r\n    10\t    int n = 0;\r\n    11\t    int nonempty = 0;\r\n    12\t    for (const char *s = blob; *s; s++) {\r\n    13\t        if (*s == '\\n') {\r\n    14\t            if (nonempty) n++;\r\n    15\t            nonempty = 0;\r\n    16\t        } else if (*s != ' ' && *s != '\\r' && *s != '\\t') {\r\n    17\t            nonempty = 1;\r\n    18\t        }\r\n    19\t    }\r\n    20\t    if (nonempty) n++;\r\n    21\t    return n;\r\n    22\t}\r\n    23\t\r\n    24\tstatic void load_ledger_into(char *dst, size_t cap) {\r\n    25\t    FILE *f = fopen(\"/app/rivetbay/intake/current.ledger\", \"r\");\r\n    26\t    dst[0] = 0;\r\n    27\t    if (!f) return;\r\n    28\t    size_t n = fread(dst, 1, cap - 1, f);\r\n    29\t    dst[n] = 0;\r\n    30\t    fclose(f);\r\n    31\t}\r\n    32\t\r\n    33\tvoid prime_intake_sheet(void) {\r\n    34\t    load_ledger_into(g_primed, sizeof(g_primed));\r\n    35\t    g_emit_cap = count_nonempty_lines(g_primed);\r\n    36\t    g_emit[0] = 0;\r\n    37\t}\r\n    38\t\r\n    39\tvoid grab_sheet(void) {\r\n    40\t    load_ledger_into(g_primed, sizeof(g_primed));\r\n    41\t}\r\n    42\t\r\n    43\tvoid pour_sheet(void) {\r\n    44\t    char buf[65536];\r\n    45\t    char out[65536];\r\n    46\t    strncpy(buf, g_primed, sizeof(buf) - 1);\r\n    47\t    buf[sizeof(buf) - 1] = 0;\r\n    48\t    size_t w = 0;\r\n    49\t    char *save = NULL;\r\n    50\t    char *line = strtok_r(buf, \"\\n\", &save);\r\n    51\t    while (line) {\r\n    52\t        while (*line == ' ' || *line == '\\t') line++;\r\n    53\t        if (*line == 0) {\r\n    54\t            line = strtok_r(NULL, \"\\n\", &save);\r\n    55\t            continue;\r\n    56\t        }\r\n    57\t        size_t L = strlen(line);\r\n    58\t        if (w + L + 1 >= sizeof(out)) break;\r\n    59\t        memcpy(out + w, line, L);\r\n    60\t        w += L;\r\n    61\t        out[w++] = '\\n';\r\n    62\t        line = strtok_r(NULL, \"\\n\", &save);\r\n    63\t    }\r\n    64\t    out[w] = 0;\r\n    65\t    memcpy(g_emit, out, w + 1);\r\n    66\t}\r\n    67\t\r\n    68\tconst char *sheet_view(void) {\r\n    69\t    return g_emit;\r\n    70\t}\r\n"]
[19.865625, "o", "    71\t\r\n    72\tint sheet_emit_cap(void) {\r\n    73\t    return g_emit_cap;\r\n    74\t}\r\n"]
[19.865834, "o", "===== forgekit/sheet.h =====\r\n"]
[19.867035, "o", "     1\t#ifndef SHEET_H\r\n     2\t#define SHEET_H\r\n     3\tvoid prime_intake_sheet(void);\r\n     4\tvoid grab_sheet(void);\r\n     5\tvoid pour_sheet(void);\r\n     6\tconst char *sheet_view(void);\r\n     7\tint sheet_emit_cap(void);\r\n"]
[19.867198, "o", "     8\t#endif\r\n"]
[19.867542, "o", "===== forgekit/driver.c =====\r\n"]
[19.868663, "o", "     1\t#include \"discover.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include \"emit.h\"\r\n     4\t#include \"tally.h\"\r\n     5\t#include \"decode.h\"\r\n"]
[19.868995, "o", "     6\t#include \"warmup.h\"\r\n     7\t#include <stdio.h>\r\n     8\t#include <string.h>\r\n     9\t\r\n    10\tstatic void note_mill_pass(void) {\r\n    11\t    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    12\t    if (!f) return;\r\n    13\t    fputc('1', f);\r\n    14\t    fputc('\\n', f);\r\n    15\t    fclose(f);\r\n    16\t}\r\n    17\t\r\n    18\tint main(int argc, char **argv) {\r\n    19\t    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n    20\t        note_mill_pass();\r\n    21\t        warm_maybe();\r\n    22\t        prime_intake_sheet();\r\n    23\t        discover_all();\r\n    24\t        pour_sheet();\r\n    25\t        emit_all();\r\n    26\t        return count_gap();\r\n    27\t    }\r\n    28\t    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n    29\t        return decode_frame(argv[2]);\r\n    30\t    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    31\t    return 2;\r\n    32\t}\r\n"]
[19.869436, "o", "===== forgekit/warmup.c =====\r\n"]
[19.871087, "o", "     1\t#include \"warmup.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include <stdlib.h>\r\n     4\t\r\n     5\tvoid warm_maybe(void) {\r\n     6\t    const char *e = getenv(\"RIVET_WARM\");\r\n     7\t    if (e && e[0] == '1') {\r\n     8\t        grab_sheet();\r\n     9\t    }\r\n    10\t}\r\n"]
[19.871624, "o", "===== forgekit/warmup.h =====\r\n"]
[19.873008, "o", "     1\t#ifndef WARMUP_H\r\n"]
[19.873619, "o", "     2\t#define WARMUP_H\r\n     3\tvoid warm_maybe(void);\r\n     4\t#endif\r\n"]
[19.874125, "o", "\u001b[?2004h"]
[19.87439, "o", "root@e71d9565538a:/app/rivetbay# "]
[20.028231, "i", "echo '===== millscore ====='; find /app/millscore -maxdepth 2 -type f -print -exec sh -c 'echo \"--- $1\"; nl -ba \"$1\"' sh {} \\; 2>/dev/null; echo '===== notes ====='; for f in /app/rivetbay/notes/*; do echo \"--- $f\"; cat \"$f\"; done\n"]
[20.029216, "o", "echo '===== millscore ====='; find /app/millscore -maxdepth 2 -type f -print -exec sh -c 'echo \"--- $1\"; nl -ba \"$1\"' sh {} \\; 2>/dev/null; echo '===== notes ====='; for f in /app/rivetbay/notes/*; do echo \"--- $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[20.029402, "o", "===== millscore =====\r\n"]
[20.031941, "o", "/app/millscore/tally.c\r\n"]
[20.03298, "o", "--- /app/millscore/tally.c\r\n"]
[20.033981, "o", "     1\t#include \"tally.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include <dirent.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic int count_emitters(void) {\r\n     8\t    DIR *d = opendir(\"/app/rivetbay/emitters\");\r\n     9\t    int n = 0;\r\n    10\t    struct dirent *ent;\r\n    11\t    if (!d) return 0;\r\n    12\t    while ((ent = readdir(d)) != NULL) {\r\n    13\t        size_t L = strlen(ent->d_name);\r\n    14\t        if (L > 5 && strcmp(ent->d_name + L - 5, \".kdec\") == 0) n++;\r\n    15\t    }\r\n    16\t    closedir(d);\r\n    17\t    return n;\r\n    18\t}\r\n    19\t\r\n    20\tstatic int count_sheet_lines(void) {\r\n    21\t    const char *s = sheet_view();\r\n    22\t    int n = 0;\r\n    23\t    int nonempty = 0;\r\n    24\t    for (; *s; s++) {\r\n"]
[20.034047, "o", "    25\t        if (*s == '\\n') {\r\n    26\t            if (nonempty) n++;\r\n    27\t            nonempty = 0;\r\n    28\t        } else if (*s != ' ' && *s != '\\r') nonempty = 1;\r\n    29\t    }\r\n    30\t    if (nonempty) n++;\r\n    31\t    return n;\r\n    32\t}\r\n    33\t\r\n    34\tint count_gap(void) {\r\n    35\t    int a = count_sheet_lines();\r\n    36\t    int b = count_emitters();\r\n    37\t    return (b < a) ? 1 : 0;\r\n"]
[20.034072, "o", "    38\t}\r\n"]
[20.034484, "o", "/app/millscore/tally.h\r\n"]
[20.035631, "o", "--- /app/millscore/tally.h\r\n"]
[20.036821, "o", "     1\t#ifndef TALLY_H\r\n     2\t#define TALLY_H\r\n     3\tint count_gap(void);\r\n     4\t#endif\r\n"]
[20.037534, "o", "===== notes =====\r\n"]
[20.037697, "o", "--- /app/rivetbay/notes/forms.txt\r\n"]
[20.039143, "o", "Event descriptions use NAME then FIELD lines. Ledger is name|relpath|field:kind,... .\r\nKDEC files start with KDEC1. Decode JSON uses kind decoded or unknown.\r\nDecode fields object keys are the FIELD names from that description (for example latch, force, amp, bit, thick, mm, q, n, w).\r\n"]
[20.039478, "o", "--- /app/rivetbay/notes/layout.txt\r\n"]
[20.040665, "o", "evd holds descriptions. intake/current.ledger is the mill roster. emitters hold kdec tables.\r\nframes hold packed samples. forgekit is the C pipeline.\r\n"]
[20.040856, "o", "--- /app/rivetbay/notes/ops.txt\r\n"]
[20.042002, "o", "After adding a description, mill may leave decode unknown even though discovery refreshed the on-disk ledger.\r\nUnknown decode is normal for frames that have no description on this bench.\r\n"]
[20.042252, "o", "\u001b[?2004hroot@e71d9565538a:/app/rivetbay# "]
[20.535089, "i", "cd /app/rivetbay; /app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo 'ledger:'; cat intake/current.ledger; echo 'emitter count / description count:'; find emitters -maxdepth 1 -name '*.kdec' | wc -l; find evd -maxdepth 1 -name '*.evd' | wc -l; echo 'galley decode:'; /app/bin/rivetbay decode frames/galley_hatch.bin; echo \"decode_rc=$?\"\n"]
[20.536844, "o", "cd /app/rivetbay; /app/bin/rivetbay mill; rc=$?; echo \"mill_rc=$rc\"; echo 'ledger:'; cat intake/current.ledger; echo 'emitter count / description count:'; find emitters -maxdepth 1 -name '*.kdec' | wc -l; find evd -maxdepth 1 -name '*.evd' | wc -l; echo 'galley decode:'; /app/bin/rivetbay decode frames/galley_hatch.bin; echo \"decode_rc=$?\"\r\n\u001b[?2004l\r"]
[20.540981, "o", "mill_rc=0\r\nledger:\r\n"]
[20.542575, "o", "wing_ice|evd/wing_ice.evd|thick:u16\r\nfuel_flow|evd/fuel_flow.evd|rate:u16,tank:u8\r\ndoor_seal|evd/door_seal.evd|ok:u8\r\npitot_heat|evd/pitot_heat.evd|watts:u16\r\naileron_pos|evd/aileron_pos.evd|deg:u16,side:u8\r\nnav_lamp|evd/nav_lamp.evd|color:u8\r\nbrake_temp|evd/brake_temp.evd|cdeg:u16\r\ngalley_hatch|evd/galley_hatch.evd|latch:u8,force:u16\r\n"]
[20.542871, "o", "emitter count / description count:\r\n"]
