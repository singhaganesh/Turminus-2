[95.488806, "i", "cd /app/rivetbay; printf 'NAME verifier_new\\nFIELD mm u16\\nFIELD bit u8\\n' > evd/odd_filename.evd; python3 - <<'PY'\nimport struct\nname=b'verifier_new'\nopen('/tmp/verifier_new.bin','wb').write(struct.pack('>I',len(name))+name+struct.pack('>HB',513,7))\nPY\n/app/bin/rivetbay mill; rc=$?; echo \"fresh_mill_rc=$rc\"; tail -n 1 intake/current.ledger; echo '--- generated decoder'; cat emitters/verifier_new.kdec; echo '--- decoded frame'; /app/bin/rivetbay decode /tmp/verifier_new.bin; printf 'counts='; find evd -maxdepth 1 -name '*.evd' | wc -l | tr '\\n' '/'; grep -c '|' intake/current.ledger | tr '\\n' '/'; find emitters -maxdepth 1 -name '*.kdec' | wc -l; rm evd/odd_filename.evd; /app/bin/rivetbay mill; echo \"final_mill_rc=$?\"; test ! -e emitters/verifier_new.kdec; echo \"removed_decoder_absent=$?\"; printf 'final_counts='; find evd -maxdepth 1 -name '*.evd' | wc -l | tr '\\n' '/'; grep -c '|' intake/current.ledger | tr '\\n' '/'; find emitters -maxdepth 1 -name '*.kdec' | wc -l; /app/bin/rivetbay decode frames/galley_hatch.bin\n"]
