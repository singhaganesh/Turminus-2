[92.855536, "o", "\u001b[01m\u001b[Kforgekit/discover.c:57:34:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K‘\u001b[01m\u001b[K%s\u001b[m\u001b[K’ directive output may be truncated writing up to 1023 bytes into a region of size 128 [\u001b[01;35m\u001b[K\u001b]8;;https://gcc.gnu.org/onlinedocs/gcc/Warning-Options.html#index-Wformat-truncation=\u0007-Wformat-truncation=\u001b]8;;\u0007\u001b[m\u001b[K]\r\n   57 |         snprintf(names[n], 128, \"\u001b[01;35m\u001b[K%s\u001b[m\u001b[K\", name);\r\n      |                                  \u001b[01;35m\u001b[K^~\u001b[m\u001b[K\r\nIn function ‘\u001b[01m\u001b[Kload_prior_names\u001b[m\u001b[K’,\r\n    inlined from ‘\u001b[01m\u001b[Kdiscover_all\u001b[m\u001b[K’ at \u001b[01m\u001b[Kforgekit/discover.c:72:18\u001b[m\u001b[K:\r\n\u001b[01m\u001b[Kforgekit/discover.c:57:9:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K‘\u001b[01m\u001b[Ksnprintf\u001b[m\u001b[K’ output between 1 and 1024 bytes into a destination of size 128\r\n   57 |         \u001b[01;36m\u001b[Ksnprintf(names[n], 128, \"%s\", name)\u001b[m\u001b[K;\r\n      |         \u001b[01;36m\u001b[K^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[m\u001b[K\r\n"]
