[92.69591, "o", "     1\t#include \"discover.h\"\r\n     2\t#include \"sheet.h\"\r\n     3\t#include \"emit.h\"\r\n     4\t#include \"tally.h\"\r\n     5\t#include \"decode.h\"\r\n     6\t#include \"warmup.h\"\r\n     7\t#include <stdio.h>\r\n     8\t#include <string.h>\r\n     9\t\r\n    10\tstatic void note_mill_pass(void) {\r\n    11\t    FILE *f = fopen(\"/app/rivetbay/intake/.mill_pass\", \"a\");\r\n    12\t    if (!f) return;\r\n    13\t    fputc('1', f);\r\n    14\t    fputc('\\n', f);\r\n    15\t    fclose(f);\r\n    16\t}\r\n    17\t\r\n    18\tint main(int argc, char **argv) {\r\n    19\t    if (argc >= 2 && strcmp(argv[1], \"mill\") == 0) {\r\n    20\t        note_mill_pass();\r\n    21\t        warm_maybe();\r\n    22\t        prime_intake_sheet();\r\n    23\t        discover_all();\r\n    24\t        pour_sheet();\r\n    25\t        emit_all();\r\n    26\t        return count_gap();\r\n    27\t    }\r\n    28\t    if (argc >= 3 && strcmp(argv[1], \"decode\") == 0)\r\n    29\t        return decode_frame(argv[2]);\r\n    30\t    fprintf(stderr, \"usage: rivetbay mill | rivetbay decode <frame>\\n\");\r\n    31\t    return 2;\r\n    32\t}\r\n"]
