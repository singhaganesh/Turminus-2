[93.008444, "o", "\u001b[01m\u001b[Kforgekit/emit.c:34:5:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K‘\u001b[01m\u001b[Ksnprintf\u001b[m\u001b[K’ output between 29 and 1052 bytes into a destination of size 512\r\n   34 |     \u001b[01;36m\u001b[Ksnprintf(outp, sizeof(outp), \"/app/rivetbay/emitters/%s.kdec\", name)\u001b[m\u001b[K;\r\n      |     \u001b[01;36m\u001b[K^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\u001b[m\u001b[K\r\n"]
