[100.984837, "o", "\u001b[?2004h> "]
[100.98493, "o", "            kind = Some(value.to_string());\r\n\u001b[?2004l\r"]
[100.984971, "o", "\u001b[?2004h> "]
[100.985028, "o", "            continue;\r\n\u001b[?2004l\r"]
[100.985108, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[100.985133, "o", "\u001b[?2004h> "]
[100.98529, "o", "        let trimmed = line.trim_start();\r\n\u001b[?2004l\r"]
[100.985384, "o", "\u001b[?2004h> "]
[100.985453, "o", "        if trimmed.starts_with('#') {\r\n\u001b[?2004l\r"]
[100.98555, "o", "\u001b[?2004h> "]
[100.985643, "o", "            if kind.is_none() || summary {\r\n\u001b[?2004l\r"]
[100.985737, "o", "\u001b[?2004h> "]
[100.985841, "o", "                return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.985866, "o", "            }\r\n\u001b[?2004l\r"]
[100.985935, "o", "\u001b[?2004h> "]
[100.986084, "o", "            let mut words = trimmed.split_whitespace();\r\n\u001b[?2004l\r"]
[100.986162, "o", "\u001b[?2004h> "]
[100.986247, "o", "            let number = words.next().ok_or(3)?;\r\n\u001b[?2004l\r"]
[100.986312, "o", "\u001b[?2004h> "]
[100.986648, "o", "            let n = number.strip_prefix('#').ok_or(3)?.parse::<usize>().map_err(|_| 3)?;\r\n\u001b[?2004l\r"]
[100.986694, "o", "\u001b[?2004h"]
[100.988482, "o", ">             if n != expected {\r\n\u001b[?2004l\r\u001b[?2004h>                 return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             expected += 1;\r\n\u001b[?2004l\r\u001b[?2004h>             let marker = words.position(|w| w == \"in\").ok_or(3)?;\r\n\u001b[?2004l\r\u001b[?2004h>             let all: Vec<&str> = trimmed.split_whitespace().collect();\r\n\u001b[?2004l\r\u001b[?2004h>             let sym_index = marker + 2;\r\n\u001b[?2004l\r\u001b[?2004h>             let sym = all.get(sym_index).ok_or(3)?;\r\n\u001b[?2004l\r\u001b[?2004h>             if sym.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h>                 return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             frames.push(normalize(sym));\r\n\u001b[?2004l\r\u001b[?2004h>             continue;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[100.988899, "o", "\u001b[?2004h>         if trimmed.starts_with(\"SUMMARY:\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.989016, "o", "            if kind.is_none() || expected == 0 {\r\n\u001b[?2004l\r\u001b[?2004h>                 return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.990471, "o", "            summary = true;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if !summary || kind.is_none() || frames.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let user: Vec<String> = frames.into_iter().filter(|s| {\r\n\u001b[?2004l\r\u001b[?2004h>         !s.contains(\"__asan\") && !s.contains(\"__interceptor\") && !s.contains(\"__hwasan\")\r\n\u001b[?2004l\r\u001b[?2004h>     }).collect();\r\n\u001b[?2004l\r\u001b[?2004h>     if user.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     Ok((kind.unwrap(), user))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.990723, "o", "fn normalize(s: &str) -> String {\r\n\u001b[?2004l\r\u001b[?2004h>     let b = s.as_bytes();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.990906, "o", "    let mut out = String::new();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut i = 0;\r\n\u001b[?2004l\r"]
[100.990932, "o", "\u001b[?2004h"]
[100.990946, "o", "> "]
[100.99103, "o", "    while i < b.len() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.991048, "o", "> "]
[100.99132, "o", "        if i + 2 <= b.len() && b[i] == b'0' && (b[i + 1] == b'x' || b[i + 1] == b'X') {\r\n\u001b[?2004l\r"]
[100.991455, "o", "\u001b[?2004h> "]
[100.991566, "o", "            let mut j = i + 2;\r\n\u001b[?2004l\r"]
[100.991735, "o", "\u001b[?2004h> "]
[100.991831, "o", "            while j < b.len() && b[j].is_ascii_hexdigit() {\r\n\u001b[?2004l\r"]
[100.992147, "o", "\u001b[?2004h>                 j += 1;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             if j > i + 2 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.992246, "o", "                out.push_str(\"<hex>\");\r\n\u001b[?2004l\r"]
[100.992304, "o", "\u001b[?2004h> "]
[100.992406, "o", "                i = j;\r\n\u001b[?2004l\r"]
[100.992501, "o", "\u001b[?2004h>                 continue;\r\n\u001b[?2004l\r"]
[100.99259, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[100.992678, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[100.992779, "o", "\u001b[?2004h> "]
[100.992876, "o", "        let ch = s[i..].chars().next().unwrap();\r\n\u001b[?2004l\r"]
[100.992955, "o", "\u001b[?2004h>         out.push(ch);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.993049, "o", "        i += ch.len_utf8();\r\n\u001b[?2004l\r"]
[100.993156, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out\r\n\u001b[?2004l\r"]
[100.993236, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.993319, "o", "EOF\r\n\u001b[?2004l\r"]
[100.994721, "o", "\u001b[?2004hroot@0b52e02d0353:/app# "]
[100.994847, "o", "cat > /app/qanbox/tally.rs <<'EOF'\r\n\u001b[?2004l\r"]
[100.994926, "o", "\u001b[?2004h> "]
[100.99499, "o", "#[path = \"../treyfun/clip.rs\"]\r\n\u001b[?2004l\r"]
[100.995059, "o", "\u001b[?2004h> mod clip;\r\n\u001b[?2004l\r"]
[100.995126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.995237, "o", "use std::collections::BTreeMap;\r\n\u001b[?2004l\r"]
[100.995309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.995464, "o", "#[derive(Clone)]\r\n\u001b[?2004l\r\u001b[?2004h> pub struct Rec {\r\n\u001b[?2004l\r"]
[100.995542, "o", "\u001b[?2004h> "]
[100.9956, "o", "    pub issue: i32,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.995668, "o", "    pub kind: String,\r\n\u001b[?2004l\r"]
[100.995719, "o", "\u001b[?2004h"]
[100.995768, "o", "> "]
[100.995795, "o", "    pub frames: Vec<String>,\r\n\u001b[?2004l\r"]
[100.995893, "o", "\u001b[?2004h"]
[100.995956, "o", ">     pub body: String,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[100.996021, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.996138, "o", "pub fn tally(root: &str) -> Result<Vec<Rec>, i32> {\r\n\u001b[?2004l\r"]
[100.996201, "o", "\u001b[?2004h> "]
[100.996285, "o", "    let paths = crate::walk::gather(root)?;\r\n\u001b[?2004l\r"]
[100.996338, "o", "\u001b[?2004h> "]
[100.99652, "o", "    let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\r\n\u001b[?2004l\r"]
[100.996637, "o", "\u001b[?2004h>     for path in paths {\r\n\u001b[?2004l\r"]
[100.996707, "o", "\u001b[?2004h> "]
[100.996848, "o", "        let text = std::fs::read_to_string(path).map_err(|_| 3)?;\r\n\u001b[?2004l\r"]
[100.996898, "o", "\u001b[?2004h"]
[100.996942, "o", "> "]
[100.997015, "o", "        let (kind, frames) = clip::take(&text)?;\r\n\u001b[?2004l\r"]
[100.997058, "o", "\u001b[?2004h> "]
[100.997152, "o", "        let body = frames.join(\" | \");\r\n\u001b[?2004l\r"]
[100.997196, "o", "\u001b[?2004h> "]
[100.997361, "o", "        let rec = Rec { issue: 0, kind, frames: frames.clone(), body };\r\n\u001b[?2004l\r"]
[100.997395, "o", "\u001b[?2004h> "]
[100.997503, "o", "        if let Some(old) = bag.get(&frames) {\r\n\u001b[?2004l\r"]
[100.997578, "o", "\u001b[?2004h> "]
[100.997699, "o", "            if old.kind != rec.kind || old.body != rec.body {\r\n\u001b[?2004l\r"]
[100.997761, "o", "\u001b[?2004h> "]
[100.997827, "o", "                return Err(3);\r\n\u001b[?2004l\r"]
[100.997885, "o", "\u001b[?2004h> "]
[100.997943, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.997997, "o", "> "]
[100.998054, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.998162, "o", "            bag.insert(frames, rec);\r\n\u001b[?2004l\r"]
[100.998218, "o", "\u001b[?2004h> "]
[100.998274, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.998319, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.99845, "o", "    if bag.is_empty() {\r\n\u001b[?2004l\r"]
[100.998496, "o", "\u001b[?2004h> "]
[100.998552, "o", "        return Err(3);\r\n\u001b[?2004l\r"]
[100.998597, "o", "\u001b[?2004h> "]
[100.998639, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.998783, "o", "    let mut recs: Vec<Rec> = bag.into_values().collect();\r\n\u001b[?2004l\r"]
[100.998827, "o", "\u001b[?2004h> "]
[100.998951, "o", "    for (i, rec) in recs.iter_mut().enumerate() {\r\n\u001b[?2004l\r"]
[100.998978, "o", "\u001b[?2004h> "]
[100.99906, "o", "        rec.issue = i as i32 + 1;\r\n\u001b[?2004l\r"]
[100.999141, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.9992, "o", "    Ok(recs)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[100.999259, "o", "\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[101.000587, "o", "\u001b[?2004hroot@0b52e02d0353:/app# "]
[101.132491, "i", "cat > /app/humdock/emit.rs <<'EOF'\nuse crate::tally::Rec;\n\npub fn emit(rows: &[Rec]) -> i32 {\n    if std::fs::create_dir_all(\"/app/inkbay\").is_err() {\n        return 1;\n    }\n    let mut inner = String::new();\n    let mut desk = String::from(\"issue\\tkind\\tbody\\n\");\n    for (i, r) in rows.iter().enumerate() {\n        if i != 0 { inner.push(','); }\n        inner.push_str(&format!(\n            \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\n            r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body)\n        ));\n        desk.push_str(&format!(\"{}\\t{}\\t{}\\n\", r.issue, r.kind, r.body));\n    }\n    let tpl = match std::fs::read_to_string(\"/app/tplbay/bound.tpl\") {\n        Ok(x) if x.contains(\"__ROWS__\") => x,\n        _ => return 1,\n    };\n    let bound = tpl.replace(\"__ROWS__\", &inner);\n    if std::fs::write(\"/app/inkbay/bound.json\", bound).is_err() { return 1; }\n    if std::fs::write(\"/app/inkbay/desk.tsv\", desk).is_err() { return 1; }\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() { return 1; }\n    0\n}\n\nfn jstr(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            '\\u{08}' => out.push_str(\"\\\\b\"),\n            '\\u{0c}' => out.push_str(\"\\\\f\"),\n            c if c < '\\u{20}' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\nfn jarr(v: &[String]) -> String {\n    format!(\"[{}]\", v.iter().map(|x| jstr(x)).collect::<Vec<_>>().join(\",\"))\n}\nEOF\ncat > /app/ketchcli/main.rs <<'EOF'\n#[path = \"../urnwalk/walk.rs\"]\nmod walk;\n#[path = \"../qanbox/tally.rs\"]\nmod tally;\n#[path = \"../humdock/emit.rs\"]\nmod rib;\n\nfn main() {\n    let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\n    let mut args = std::env::args().skip(1);\n    if args.next().as_deref() != Some(\"bind\") {\n        eprintln!(\"usage: loomketch bind [root]\");\n        std::process::exit(2);\n    }\n    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\n    if args.next().is_some() {\n        eprintln!(\"usage: loomketch bind [root]\");\n        std::process::exit(2);\n    }\n    let code = match tally::tally(&root) {\n        Ok(records) if rib::emit(&records) == 0 => 0,\n        _ => {\n            let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\n            1\n        }\n    };\n    std::process::exit(code);\n}\nEOF\n/app/hearth.sh\nhead -c 4 /app/bin/loomketch | od -An -tx1; /app/bin/loomketch bind; echo \"rc=$?\"; cat /app/inkbay/bound.json; echo; cat /app/inkbay/desk.tsv; printf 'GUARD='; cat /app/inkbay/GUARD; echo\n"]
[101.132728, "o", "cat > /app/humdock/emit.rs <<'EOF'\r\n\u001b[?2004l\r"]
