[101.137751, "o", "\r\n\u001b[?2004l\r"]
[101.137808, "o", "\u001b[?2004h> "]
[101.137883, "o", "fn jstr(s: &str) -> String {\r\n\u001b[?2004l\r"]
[101.138007, "o", "\u001b[?2004h> "]
[101.138446, "o", "    let mut out = String::from(\"\\\"\");\r\n\u001b[?2004l\r\u001b[?2004h>     for c in s.chars() {\r\n\u001b[?2004l\r\u001b[?2004h>         match c {\r\n\u001b[?2004l\r\u001b[?2004h>             '\"' => out.push_str(\"\\\\\\\"\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.138605, "o", "            '\\\\' => out.push_str(\"\\\\\\\\\"),\r\n\u001b[?2004l\r"]
[101.13944, "o", "\u001b[?2004h>             '\\n' => out.push_str(\"\\\\n\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\r' => out.push_str(\"\\\\r\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\u{08}' => out.push_str(\"\\\\b\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\u{0c}' => out.push_str(\"\\\\f\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.139487, "o", "            c if c < '\\u{20}' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n\u001b[?2004l\r"]
[101.139632, "o", "\u001b[?2004h> "]
[101.141189, "o", "            c => out.push(c),\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out.push('\"');\r\n\u001b[?2004l\r\u001b[?2004h>     out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn jarr(v: &[String]) -> String {\r\n\u001b[?2004l\r\u001b[?2004h>     format!(\"[{}]\", v.iter().map(|x| jstr(x)).collect::<Vec<_>>().join(\",\"))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
