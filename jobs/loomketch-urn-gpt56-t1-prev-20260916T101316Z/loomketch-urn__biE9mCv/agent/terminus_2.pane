#!/bin/sh
set -eu
export PATH="/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
mkdir -p /app/bin /app/inkbay
rustc --edition 2021 -O /app/ketchcli/main.rs -o /app/bin/loomketch
--- /app/ketchcli/main.rs ---
     1	#[path = "../urnwalk/walk.rs"]
     2	mod walk;
     3	#[path = "../walkcue/alpha.rs"]
     4	mod alpha;
     5	#[path = "../qanbox/tally.rs"]
     6	mod tally;
     7	#[path = "../humdock/emit.rs"]
     8	mod rib;
     9	
    10	fn main() {
    11	    let mut args = std::env::args();
    12	    let _ = args.next();
    13	    let cmd = args.next().unwrap_or_default();
    14	    if cmd != "bind" {
    15	        eprintln!("usage: loomketch bind [root]");
    16	        std::process::exit(2);
    17	    }
    18	    let root = args.next().unwrap_or_else(|| "/app/vatlogs".to_string());
    19	    let code = match tally::tally(&root) {
    20	        Ok(recs) => {
    21	            if rib::emit(&recs) != 0 {
    22	                1
    23	            } else {
    24	                0
    25	            }
    26	        }
    27	        Err(c) => {
    28	            let _ = std::fs::remove_file("/app/inkbay/GUARD");
    29	            c
    30	        }
    31	    };
    32	    std::process::exit(code);
    33	}
--- /app/humdock/emit.rs ---
     1	use crate::tally::Rec;
     2	
     3	pub fn emit(a: &[Rec]) -> i32 {
     4	    let mut rows: Vec<Rec> = a.to_vec();
     5	    rows.sort_by(|x, y| x.kind.cmp(&y.kind));
     6	    let mut out = String::from("issue\tkind\tbody\n");
     7	    for (i, r) in rows.iter().enumerate() {
     8	        out.push_str(&format!("{}\t{}\t{}\n", i + 1, r.kind, r.body));
     9	    }
    10	    let _ = std::fs::create_dir_all("/app/inkbay");
    11	    if std::fs::write("/app/inkbay/desk.tsv", out).is_err() {
    12	        return 1;
    13	    }
    14	    if std::fs::write("/app/inkbay/GUARD", "ok").is_err() {
    15	        return 1;
    16	    }
    17	    0
    18	}
--- /app/qanbox/tally.rs ---
     1	#[path = "../treyfun/clip.rs"]
     2	mod clip;
     3	
     4	use std::collections::HashMap;
     5	use std::sync::mpsc;
     6	use std::thread;
     7	
     8	#[derive(Clone)]
     9	pub struct Rec {
    10	    pub issue: i32,
    11	    pub kind: String,
    12	    pub frames: Vec<String>,
    13	    pub body: String,
    14	}
    15	
    16	pub fn tally(a: &str) -> Result<Vec<Rec>, i32> {
    17	    let paths = crate::walk::gather(a)?;
    18	    let (tx, rx) = mpsc::channel();
    19	    let mut hs = Vec::new();
    20	    for p in paths {
    21	        let tx = tx.clone();
    22	        hs.push(thread::spawn(move || {
    23	            let text = match std::fs::read_to_string(&p) {
    24	                Ok(t) => t,
    25	                Err(_) => return,
    26	            };
    27	            let (kind, frames) = match clip::take(&text) {
    28	                Ok(x) => x,
    29	                Err(_) => return,
    30	            };
    31	            if kind.is_empty() {
    32	                return;
    33	            }
    34	            let frames = clip::clip(&frames);
    35	            let body = frames.join(" | ");
    36	            let _ = tx.send(Rec {
    37	                issue: 0,
    38	                kind,
    39	                frames,
    40	                body,
    41	            });
    42	        }));
    43	    }
    44	    drop(tx);
    45	    for h in hs {
    46	        let _ = h.join();
    47	    }
    48	    let mut bag: HashMap<String, Rec> = HashMap::new();
    49	    while let Ok(r) = rx.recv() {
    50	        bag.entry(r.body.clone()).or_insert(r);
    51	    }
    52	    let mut recs: Vec<Rec> = bag.into_values().collect();
    53	    for (i, r) in recs.iter_mut().enumerate() {
    54	        r.issue = (i as i32) + 1;
    55	    }
    56	    let _ = write_bound(&recs);
    57	    Ok(recs)
    58	}
    59	
    60	fn write_bound(recs: &[Rec]) -> i32 {
    61	    let tpl = std::fs::read_to_string("/app/tplbay/bound.tpl").unwrap_or_else(|_| "{\"findings\":[__ROWS__]}".into());
    62	    if recs.is_empty() {
    63	        let _ = std::fs::write("/app/inkbay/bound.json", tpl);
    64	        return 0;
    65	    }
    66	    let mut inner = String::new();
    67	    for (i, r) in recs.iter().enumerate() {
    68	        if i > 0 {
    69	            inner.push(',');
    70	        }
    71	        inner.push_str(&format!(
    72	            "{{\"issue\":{},\"kind\":{},\"frames\":{},\"body\":{}}}",
    73	            r.issue,
    74	            jstr(&r.kind),
    75	            jarr(&r.frames),
    76	            jstr(&r.body)
    77	        ));
    78	    }
    79	    let out = tpl.replace("__ROWS__", &inner);
    80	    let _ = std::fs::create_dir_all("/app/inkbay");
    81	    match std::fs::write("/app/inkbay/bound.json", out) {
    82	        Ok(()) => 0,
    83	        Err(_) => 1,
    84	    }
    85	}
    86	
    87	fn jstr(s: &str) -> String {
    88	    format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\""))
    89	}
    90	
    91	fn jarr(v: &[String]) -> String {
    92	    let parts: Vec<String> = v.iter().map(|x| jstr(x)).collect();
    93	    format!("[{}]", parts.join(","))
    94	}
--- /app/treyfun/clip.rs ---
     1	pub fn clip(a: &[String]) -> Vec<String> {
     2	    a.iter()
     3	        .filter(|s| !s.starts_with("__asan::") && !s.starts_with("__asan_"))
     4	        .cloned()
     5	        .collect()
     6	}
     7	
     8	pub fn take(text: &str) -> Result<(String, Vec<String>), i32> {
     9	    if text.trim().is_empty() {
    10	        return Ok((String::new(), Vec::new()));
    11	    }
    12	    let mut kind = String::new();
    13	    let mut frames = Vec::new();
    14	    for line in text.lines() {
    15	        if let Some(rest) = line.split("ERROR:").nth(1) {
    16	            let rest = rest.trim();
    17	            let after = if let Some(x) = rest.split("AddressSanitizer:").nth(1) {
    18	                x.trim()
    19	            } else {
    20	                rest
    21	            };
    22	            kind = after.split(" on ").next().unwrap_or(after).trim().to_string();
    23	        }
    24	        if let Some(idx) = line.find('#') {
    25	            let chunk = &line[idx..];
    26	            if let Some(after) = chunk.split(" in ").nth(1) {
    27	                let sym = after.split_whitespace().next().unwrap_or("").to_string();
    28	                if !sym.is_empty() {
    29	                    frames.push(sym);
    30	                }
    31	            }
    32	        }
    33	    }
    34	    Ok((kind, frames))
    35	}
--- /app/urnwalk/walk.rs ---
     1	pub fn gather(a: &str) -> Result<Vec<String>, i32> {
     2	    let mut v = Vec::new();
     3	    let rd = match std::fs::read_dir(a) {
     4	        Ok(x) => x,
     5	        Err(_) => return Err(2),
     6	    };
     7	    for e in rd {
     8	        let e = match e {
     9	            Ok(x) => x,
    10	            Err(_) => continue,
    11	        };
    12	        let p = e.path();
    13	        if p.is_file() {
    14	            v.push(p.to_string_lossy().into_owned());
    15	        }
    16	    }
    17	    if crate::alpha::lined(&mut v) {
    18	        v.sort();
    19	    }
    20	    Ok(v)
    21	}
--- /app/walkcue/alpha.rs ---
     1	pub fn lined(a: &mut Vec<String>) -> bool {
     2	    if std::env::var("KETCH_ALPHA").ok().as_deref() == Some("1") {
     3	        a.sort();
     4	        true
     5	    } else {
     6	        false
     7	    }
     8	}
