Sending keys: ['cat > /app/humdock/emit.rs <<\'EOF\'\nuse crate::tally::Rec;\n\npub fn emit(rows: &[Rec]) -> i32 {\n    if std::fs::create_dir_all("/app/inkbay").is_err() {\n        return 1;\n    }\n    let mut inner = String::new();\n    let mut desk = String::from("issue\\tkind\\tbody\\n");\n    for (i, r) in rows.iter().enumerate() {\n        if i != 0 { inner.push(\',\'); }\n        inner.push_str(&format!(\n            "{{\\"issue\\":{},\\"kind\\":{},\\"frames\\":{},\\"body\\":{}}}",\n            r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body)\n        ));\n        desk.push_str(&format!("{}\\t{}\\t{}\\n", r.issue, r.kind, r.body));\n    }\n    let tpl = match std::fs::read_to_string("/app/tplbay/bound.tpl") {\n        Ok(x) if x.contains("__ROWS__") => x,\n        _ => return 1,\n    };\n    let bound = tpl.replace("__ROWS__", &inner);\n    if std::fs::write("/app/inkbay/bound.json", bound).is_err() { return 1; }\n    if std::fs::write("/app/inkbay/desk.tsv", desk).is_err() { return 1; }\n    if std::fs::write("/app/inkbay/GUARD", "ok").is_err() { return 1; }\n    0\n}\n\nfn jstr(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in s.chars() {\n        match c {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            \'\\u{08}\' => out.push_str("\\\\b"),\n            \'\\u{0c}\' => out.push_str("\\\\f"),\n            c if c < \'\\u{20}\' => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn jarr(v: &[String]) -> String {\n    format!("[{}]", v.iter().map(|x| jstr(x)).collect::<Vec<_>>().join(","))\n}\nEOF\ncat > /app/ketchcli/main.rs <<\'EOF\'\n#[path = "../urnwalk/walk.rs"]\nmod walk;\n#[path = "../qanbox/tally.rs"]\nmod tally;\n#[path = "../humdock/emit.rs"]\nmod rib;\n\nfn main() {\n    let _ = std::fs::remove_file("/app/inkbay/GUARD");\n    let mut args = std::env::args().skip(1);\n    if args.next().as_deref() != Some("bind") {\n        eprintln!("usage: loomketch bind [root]");\n        std::process::exit(2);\n    }\n    let root = args.next().unwrap_or_else(|| "/app/vatlogs".to_string());\n    if args.next().is_some() {\n        eprintln!("usage: loomketch bind [root]");\n        std::process::exit(2);\n    }\n    let code = match tally::tally(&root) {\n        Ok(records) if rib::emit(&records) == 0 => 0,\n        _ => {\n            let _ = std::fs::remove_file("/app/inkbay/GUARD");\n            1\n        }\n    };\n    std::process::exit(code);\n}\nEOF\n/app/hearth.sh\nhead -c 4 /app/bin/loomketch | od -An -tx1; /app/bin/loomketch bind; echo "rc=$?"; cat /app/inkbay/bound.json; echo; cat /app/inkbay/desk.tsv; printf \'GUARD=\'; cat /app/inkbay/GUARD; echo\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
