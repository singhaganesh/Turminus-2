     1	import java.nio.file.DirectoryStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	
     6	public class TallyGate {
     7	    public static int tint_span(Path a, Path b, Path c) throws Exception {
     8	        int n = 0;
     9	        try (DirectoryStream<Path> ds = Files.newDirectoryStream(a, "*.class")) {
    10	            for (Path p : ds) {
    11	                n++;
    12	            }
    13	        }
    14	        int r = 0;
    15	        for (String line : Files.readAllLines(b)) {
    16	            if (!line.trim().isEmpty()) {
    17	                r++;
    18	            }
    19	        }
    20	        if (n >= r) {
    21	            return 0;
    22	        }
    23	        return 1;
    24	    }
    25	
    26	    public static void main(String[] args) throws Exception {
    27	        int rc = tint_span(
    28	            Paths.get("/app/blastcp"),
    29	            Paths.get("/app/desknote/NAMES.txt"),
    30	            Paths.get("/app/jarwell/husk.jar"));
    31	        System.exit(rc);
    32	    }
    33	}
--- CapGate ---
     1	import java.io.ByteArrayOutputStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.util.zip.ZipEntry;
     6	import java.util.zip.ZipInputStream;
     7	import java.util.zip.ZipOutputStream;
     8	
     9	public class CapGate {
    10	    public static int rib_n(Path a, Path b) throws Exception {
    11	        Path pad = Paths.get("/app/blastcp/HexDump.class");
    12	        if (Files.isRegularFile(a) && Files.isRegularFile(pad)) {
    13	            ByteArrayOutputStream bos = new ByteArrayOutputStream();
    14	            try (ZipInputStream zin = new ZipInputStream(Files.newInputStream(a));
    15	                 ZipOutputStream zos = new ZipOutputStream(bos)) {
    16	                ZipEntry e;
    17	                boolean have = false;
    18	                while ((e = zin.getNextEntry()) != null) {
    19	                    if ("HexDump.class".equals(e.getName())) {
    20	                        have = true;
    21	                    }
    22	                    zos.putNextEntry(new ZipEntry(e.getName()));
    23	                    zos.write(zin.readAllBytes());
    24	                    zos.closeEntry();
    25	                }
    26	                if (!have) {
    27	                    zos.putNextEntry(new ZipEntry("HexDump.class"));
    28	                    zos.write(Files.readAllBytes(pad));
    29	                    zos.closeEntry();
    30	                }
    31	            }
    32	            Files.write(a, bos.toByteArray());
    33	        }
    34	        return 0;
    35	    }
    36	
    37	    public static void main(String[] args) throws Exception {
    38	        int rc = rib_n(Paths.get("/app/jarwell/husk.jar"), Paths.get("/app/desknote/CAP.txt"));
    39	        System.exit(rc);
    40	    }
    41	}
