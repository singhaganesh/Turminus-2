[100.42864, "o", "\u001b[?2004h> "]
[100.428678, "o", "public class CapGate {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.42881, "o", "    public static int rib_n(Path mill, Path capFile) throws Exception {\r\n\u001b[?2004l\r"]
[100.428903, "o", "\u001b[?2004h> "]
[100.429037, "o", "        if (!Files.isRegularFile(mill) || !Files.isRegularFile(capFile)) {\r\n\u001b[?2004l\r"]
[100.429154, "o", "\u001b[?2004h> "]
[100.42926, "o", "            return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.429459, "o", "        long cap = Long.parseLong(new String(Files.readAllBytes(capFile), \"UTF-8\").trim());\r\n\u001b[?2004l\r"]
[100.429563, "o", "\u001b[?2004h> "]
[100.429694, "o", "        return cap >= 0 && Files.size(mill) <= cap ? 0 : 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.429852, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
