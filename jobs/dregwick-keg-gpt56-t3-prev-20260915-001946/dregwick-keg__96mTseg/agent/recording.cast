[40.349803, "o", "     1\timport java.nio.file.DirectoryStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\t\r\n     6\tpublic class TallyGate {\r\n     7\t    public static int tint_span(Path a, Path b, Path c) throws Exception {\r\n     8\t        int n = 0;\r\n     9\t        try (DirectoryStream<Path> ds = Files.newDirectoryStream(a, \"*.class\")) {\r\n    10\t            for (Path p : ds) {\r\n    11\t                n++;\r\n    12"]
[40.349941, "o", "\t            }\r\n    13\t        }\r\n    14\t        int r = 0;\r\n    15\t        for (String line : Files.readAllLines(b)) {\r\n    16\t            if (!line.trim().isEmpty()) {\r\n    17\t                r++;\r\n    18\t            }\r\n    19\t        }\r\n    20\t        if (n >= r) {\r\n    21\t            return 0;\r\n    22\t        }\r\n    23\t        return 1;\r\n    24\t    }\r\n    25\t\r\n    26\t    public static void main(String[] args) throws Exception {\r\n    27\t        int rc = tint_span(\r\n    28\t            Paths.get(\"/app/blastcp\"),\r\n    29\t            Paths.get(\"/app/desknote/NAMES.txt\"),\r\n    30\t            Paths.get(\"/app/jarwell/husk.jar\"));\r\n    31\t        System.exit(rc);\r\n    32\t    }\r\n    33\t}\r\n"]
