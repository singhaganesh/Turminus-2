[100.428189, "o", "cat > /app/bytecue/CapGate.java <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.428239, "o", "import java.nio.file.Files;\r\n\u001b[?2004l\r"]
[100.42828, "o", "\u001b[?2004h> "]
