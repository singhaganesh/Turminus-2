[40.35107, "o", "     5\timport java.util.zip.ZipEntry;\r\n     6\timport java.util.zip.ZipInputStream;\r\n     7\timport java.util.zip.ZipOutputStream;\r\n     8\t\r\n     9\tpublic class CapGate {\r\n    10\t    public static int rib_n(Path a, Path b) throws Exception {\r\n    11\t        Path pad = Paths.get(\"/app/blastcp/HexDump.class\");\r\n    12\t        if (Files.isRegularFile(a) && Files.isRegularFile(pad)) {\r\n    13\t            ByteArrayOutputStream bos = new ByteArrayOutputStream();\r\n"]
[40.351144, "o", "    14\t            try (ZipInputStream zin = new ZipInputStream(Files.newInputStream(a));\r\n    15\t                 ZipOutputStream zos = new ZipOutputStream(bos)) {\r\n    16\t                ZipEntry e;\r\n    17\t                boolean have = false;\r\n    18\t                while ((e = zin.getNextEntry()) != null) {\r\n    19\t                    if (\"HexDump.class\".equals(e.getName())) {\r\n    20\t                        have = true;\r\n    21\t                    }\r\n    22\t                    zos.putNextEntry(new ZipEntry(e.getName()));\r\n    23\t                    zos.write(zin.readAllBytes());\r\n    24\t                    zos.closeEntry();\r\n    25\t                }\r\n    26\t                if (!have) {\r\n    27\t                    zos.putNextEntry(new ZipEntry(\"HexDump.class\"));\r\n    28\t                    zos.write(Files.readAllBytes(pad));\r\n    29\t                    zos.closeEntry();\r\n    30\t                }\r\n"]
[40.351242, "o", "    31\t            }\r\n    32\t            Files.write(a, bos.toByteArray());\r\n    33\t        }\r\n    34\t        return 0;\r\n    35\t    }\r\n    36\t\r\n    37\t    public static void main(String[] args) throws Exception {\r\n    38\t        int rc = rib_n(Paths.get(\"/app/jarwell/husk.jar\"), Paths.get(\"/app/desknote/CAP.txt\"));\r\n    39\t        System.exit(rc);\r\n    40\t    }\r\n    41\t}\r\n"]
[40.351359, "o", "--- KnitMain ---\r\n"]
[40.352225, "o", "     1\timport java.nio.file.DirectoryStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.Set;\r\n     6\timport java.util.jar.JarEntry;\r\n     7\timport java.util.jar.JarOutputStream;\r\n     8\t\r\n     9\tpublic class KnitMain {\r\n"]
[40.352357, "o", "    10\t    public static void main(String[] args) throws Exception {\r\n    11\t        Path exploded = Paths.get(\"/app/blastcp\");\r\n    12\t        Path jar = Paths.get(\"/app/jarwell/husk.jar\");\r\n    13\t        Files.createDirectories(jar.getParent());\r\n    14\t        Set<String> live = ReachWalk.weld_set(exploded);\r\n    15\t        if (args.length > 0 && \"--all\".equals(args[0])) {\r\n    16\t            live.clear();\r\n    17\t            try (DirectoryStream<Path> ds = Files.newDirectoryStream(exploded, \"*.class\")) {\r\n    18\t                for (Path p : ds) {\r\n    19\t                    String n = p.getFileName().toString();\r\n    20\t                    live.add(n.substring(0, n.length() - 6));\r\n    21\t                }\r\n    22\t            }\r\n    23\t        }\r\n    24\t        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar))) {\r\n    25\t            for (String n : live) {\r\n    26\t                Path src = exploded.resolve(n + \".class\");\r\n    27\t                if (!Files.isRegularFile(src)) {\r\n    28\t                    continue;\r\n    29\t                }\r\n    30\t                jos.putNextEntry(new JarEntry(n + \".class\"));\r\n    31\t                jos.write(Files.readAllBytes(src));\r\n    32\t                jos.closeEntry();\r\n    33\t            }\r\n    34\t        }\r\n    35\t    }\r\n    36\t}\r\n"]
