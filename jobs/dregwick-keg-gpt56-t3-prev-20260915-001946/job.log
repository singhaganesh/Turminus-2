Sending keys: ['cat > /app/hitchrun/KnitMain.java <<\'EOF\'\nimport java.nio.file.DirectoryStream;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.Set;\nimport java.util.jar.JarEntry;\nimport java.util.jar.JarOutputStream;\n\npublic class KnitMain {\n    public static void main(String[] args) throws Exception {\n        Path exploded = Paths.get("/app/blastcp");\n        Path jar = Paths.get("/app/jarwell/husk.jar");\n        Files.createDirectories(jar.getParent());\n        Set<String> live = ReachWalk.weld_set(exploded);\n\n        // Booth implementations are discovered reflectively at runtime, so\n        // bytecode reachability alone cannot find them.  The roster is the\n        // authoritative set of handlers that the packed mill must expose.\n        Path roster = Paths.get("/app/desknote/NAMES.txt");\n        for (String line : Files.readAllLines(roster)) {\n            String s = line.trim();\n            if (s.isEmpty()) {\n                continue;\n            }\n            String[] fields = s.split("\\\\s+");\n            if (fields.length < 2) {\n                throw new IllegalArgumentException("bad roster line: " + line);\n            }\n            live.add(fields[1]);\n        }\n\n        if (args.length > 0 && "--all".equals(args[0])) {\n            live.clear();\n            try (DirectoryStream<Path> ds = Files.newDirectoryStream(exploded, "*.class")) {\n                for (Path p : ds) {\n                    String n = p.getFileName().toString();\n                    live.add(n.substring(0, n.length() - 6));\n                }\n            }\n        }\n        try (JarOutputStream jos = new JarOutputStream(Files.newOutputStream(jar))) {\n            for (String n : live) {\n                Path src = exploded.resolve(n + ".class");\n                if (!Files.isRegularFile(src)) {\n                    continue;\n                }\n                jos.putNextEntry(new JarEntry(n + ".class"));\n                jos.write(Files.readAllBytes(src));\n                jos.closeEntry();\n            }\n        }\n    }\n}\nEOF\ncat > /app/namelock/TallyGate.java <<\'EOF\'\nimport java.io.BufferedReader;\nimport java.io.InputStreamReader;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path roster, Path jar) throws Exception {\n        if (!Files.isRegularFile(jar)) {\n            return 1;\n        }\n        Set<String> wanted = new LinkedHashSet<String>();\n        for (String line : Files.readAllLines(roster)) {\n            String s = line.trim();\n            if (s.isEmpty()) {\n                continue;\n            }\n            String[] fields = s.split("\\\\s+");\n            if (fields.length < 2) {\n                return 1;\n            }\n            wanted.add(fields[0]);\n        }\n\n        String java = Paths.get(System.getProperty("java.home"), "bin", "java").toString();\n        Process p = new ProcessBuilder(java, "-cp", jar.toString(), "Main", "booth")\n            .redirectErrorStream(true).start();\n        Set<String> actual = new LinkedHashSet<String>();\n        try (BufferedReader in = new BufferedReader(new InputStreamReader(p.getInputStream()))) {\n            String line;\n            while ((line = in.readLine()) != null) {\n                actual.add(line.trim());\n            }\n        }\n        int rc = p.waitFor();\n        return rc == 0 && actual.containsAll(wanted) ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(\n            Paths.get("/app/blastcp"),\n            Paths.get("/app/desknote/NAMES.txt"),\n            Paths.get("/app/jarwell/husk.jar")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path mill, Path capFile) throws Exception {\n        if (!Files.isRegularFile(mill) || !Files.isRegularFile(capFile)) {\n            return 1;\n        }\n        long cap = Long.parseLong(new String(Files.readAllBytes(capFile), "UTF-8").trim());\n        return cap >= 0 && Files.size(mill) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(\n            Paths.get("/app/jarwell/husk.jar"),\n            Paths.get("/app/desknote/CAP.txt")));\n    }\n}\nEOF\nsed -i \'s/cls\\[i\\] = b.getShort() & 0xff;/cls[i] = b.getShort() \\& 0xffff;/\' /app/rootwalk/ReachWalk.java\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
