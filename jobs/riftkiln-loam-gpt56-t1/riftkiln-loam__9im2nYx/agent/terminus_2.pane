   230	fn reduce_node(prod: &(String, Vec<String>), kids: Vec<Node>) -> Node {
   231	    let lhs = &prod.0;
   232	    let rhs = &prod.1;
   233	    if lhs == "MS" && rhs.is_empty() {
   234	        return Node::List(Vec::new());
   235	    }
   236	    if lhs == "MS" && rhs.len() == 2 {
   237	        return rib_c(kids[0].clone(), kids[1].clone());
   238	    }
   239	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("PEG") {
   240	        let tag = if let Node::Str(s) = &kids[1] {
   241	            s.clone()
   242	        } else {
   243	            String::new()
   244	        };
   245	        let mark = if let Node::Str(s) = &kids[3] {
   246	            s.clone()
   247	        } else {
   248	            String::new()
   249	        };
   250	        return Node::Map(vec![
   251	            ("kind".into(), Node::Str("peg".into())),
   252	            ("tag".into(), Node::Str(tag)),
   253	            ("mark".into(), Node::Str(mark)),
   254	        ]);
   255	    }
   256	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("CLIP") && rhs.len() == 2 {
   257	        let stem = if let Node::Str(s) = &kids[1] {
   258	            s.clone()
   259	        } else {
   260	            String::new()
   261	        };
   262	        return Node::Map(vec![
   263	            ("kind".into(), Node::Str("clip".into())),
   264	            ("stem".into(), Node::Str(stem)),
   265	        ]);
   266	    }
   267	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("PEN") {
   268	        let stem = if let Node::Str(s) = &kids[1] {
   269	            s.clone()
   270	        } else {
   271	            String::new()
   272	        };
   273	        let members = kids[3].clone();
   274	        let mut pairs = vec![
   275	            ("kind".into(), Node::Str("pen".into())),
