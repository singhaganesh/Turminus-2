   154	#[derive(Clone)]
   155	struct Tok {
   156	    name: String,
   157	    lex: String,
   158	}
   159	
   160	fn lex(src: &str) -> Vec<Tok> {
   161	    let mut out = Vec::new();
   162	    let b = src.as_bytes();
   163	    let mut i = 0;
   164	    let mut after_eq = false;
   165	    while i < b.len() {
   166	        let c = b[i] as char;
   167	        if c.is_whitespace() {
   168	            i += 1;
   169	            continue;
   170	        }
   171	        if c == '{' {
   172	            out.push(Tok {
   173	                name: "LBRACE".into(),
   174	                lex: "{".into(),
   175	            });
   176	            i += 1;
   177	            continue;
   178	        }
   179	        if c == '}' {
   180	            out.push(Tok {
   181	                name: "RBRACE".into(),
   182	                lex: "}".into(),
   183	            });
   184	            i += 1;
   185	            continue;
   186	        }
   187	        if c == '=' {
   188	            out.push(Tok {
   189	                name: "EQ".into(),
   190	                lex: "=".into(),
   191	            });
   192	            after_eq = true;
   193	            i += 1;
   194	            continue;
   195	        }
   196	        if c == ';' {
   197	            out.push(Tok {
   198	                name: "SEMI".into(),
   199	                lex: ";".into(),
   200	            });
   201	            i += 1;
   202	            continue;
   203	        }
   204	        if c.is_ascii_alphanumeric() || c == '_' {
   205	            let s = i;
   206	            i += 1;
   207	            while i < b.len() {
   208	                let d = b[i] as char;
   209	                if d.is_ascii_alphanumeric() || d == '_' {
   210	                    i += 1;
   211	                } else {
   212	                    break;
   213	                }
   214	            }
   215	            let w = src[s..i].to_string();
   216	            if after_eq {
   217	                out.push(Tok {
   218	                    name: "VAL".into(),
   219	                    lex: w,
   220	                });
   221	                after_eq = false;
   222	            } else {
   223	                let name = match w.as_str() {
   224	                    "yard" => "YARD",
   225	                    "pen" => "PEN",
   226	                    "clip" => "CLIP",
   227	                    "peg" => "PEG",
   228	                    _ => "ID",
   229	                };
   230	                out.push(Tok {
   231	                    name: name.into(),
   232	                    lex: w,
   233	                });
   234	            }
   235	            continue;
   236	        }
   237	        i += 1;
   238	    }
   239	    out.push(Tok {
   240	        name: "$".into(),
   241	        lex: "".into(),
   242	    });
   243	    out
   244	}
   245	
   246	fn reduce_node(prod: &(String, Vec<String>), kids: Vec<Node>) -> Node {
   247	    let lhs = &prod.0;
   248	    let rhs = &prod.1;
   249	    if lhs == "MS" && rhs.is_empty() {
   250	        return Node::List(Vec::new());
   251	    }
   252	    if lhs == "MS" && rhs.len() == 2 {
   253	        return rib_c(kids[0].clone(), kids[1].clone());
   254	    }
   255	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("PEG") {
   256	        let tag = if let Node::Str(s) = &kids[1] {
   257	            s.clone()
   258	        } else {
   259	            String::new()
   260	        };
   261	        let mark = if let Node::Str(s) = &kids[3] {
   262	            s.clone()
   263	        } else {
   264	            String::new()
   265	        };
   266	        return Node::Map(vec![
   267	            ("kind".into(), Node::Str("peg".into())),
   268	            ("tag".into(), Node::Str(tag)),
   269	            ("mark".into(), Node::Str(mark)),
   270	        ]);
   271	    }
   272	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("CLIP") && rhs.len() == 2 {
   273	        let stem = if let Node::Str(s) = &kids[1] {
   274	            s.clone()
   275	        } else {
   276	            String::new()
   277	        };
   278	        return Node::Map(vec![
   279	            ("kind".into(), Node::Str("clip".into())),
   280	            ("stem".into(), Node::Str(stem)),
   281	        ]);
   282	    }
   283	    if lhs == "M" && rhs.first().map(|s| s.as_str()) == Some("PEN") {
   284	        let stem = if let Node::Str(s) = &kids[1] {
   285	            s.clone()
   286	        } else {
   287	            String::new()
   288	        };
   289	        let members = kids[3].clone();
   290	        let mut pairs = vec![
   291	            ("kind".into(), Node::Str("pen".into())),
   292	            ("stem".into(), Node::Str(stem)),
   293	            ("members".into(), members),
   294	        ];
   295	        if rhs.len() >= 7 {
   296	            let cl = if let Node::Str(s) = &kids[6] {
   297	                s.clone()
   298	            } else {
   299	                String::new()
   300	            };
   301	            pairs.push(("clip".into(), Node::Str(cl)));
   302	        }
   303	        return Node::Map(pairs);
   304	    }
   305	    if lhs == "S" {
   306	        let yard = if let Node::Str(s) = &kids[1] {
   307	            s.clone()
   308	        } else {
   309	            String::new()
   310	        };
   311	        let members = kids[3].clone();
   312	        return Node::Map(vec![
   313	            ("yard".into(), Node::Str(yard)),
   314	            ("members".into(), members),
   315	        ]);
   316	    }
   317	    if lhs == "S'" {
   318	        return kids[0].clone();
   319	    }
   320	    Node::List(kids)
   321	}
