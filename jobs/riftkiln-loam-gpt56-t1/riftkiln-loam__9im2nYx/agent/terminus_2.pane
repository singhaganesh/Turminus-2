   292	        } else {
   293	            String::new()
   294	        };
   295	        let members = kids[3].clone();
   296	        return Node::Map(vec![
   297	            ("yard".into(), Node::Str(yard)),
   298	            ("members".into(), members),
   299	        ]);
   300	    }
   301	    if lhs == "S'" {
   302	        return kids[0].clone();
   303	    }
   304	    Node::List(kids)
   305	}
