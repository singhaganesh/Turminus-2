    79	  static void resolveHits(LinkedHashMap<String, Unit> all) {
    80	    LinkedHashMap<String, String> methArity = new LinkedHashMap<String, String>();
    81	    for (Unit u : all.values()) {
    82	      for (Map.Entry<String, String> e : u.fps.entrySet()) {
    83	        for (String part : e.getValue().split(";")) {
    84	          if (part.isEmpty()) continue;
    85	          methArity.put(e.getKey() + "#" + part.split(":")[0], part.split(":")[1]);
    86	        }
    87	      }
    88	    }
    89	    for (Unit u : all.values()) {
    90	      Matcher c = CALL.matcher(u.body);
    91	      while (c.find()) {
    92	        String name = c.group(1);
    93	        String args = c.group(2).trim();
    94	        int n = args.isEmpty() ? 0 : splitArgs(args);
    95	        for (Unit def : all.values()) {
    96	          for (String t : def.defined) {
    97	            String want = methArity.get(t + "#" + name);
    98	            if (want == null) continue;
    99	            if (Integer.parseInt(want) != n) {
   100	              u.hits.add(new String[] {u.path, "arity", name});
   101	            }
   102	          }
   103	        }
   104	      }
   105	    }
   106	  }
   107	
   108	  static int splitArgs(String args) {
   109	    int n = 1;
   110	    int depth = 0;
   111	    boolean q = false;
   112	    for (int i = 0; i < args.length(); i++) {
   113	      char ch = args.charAt(i);
   114	      if (ch == '"') q = !q;
   115	      else if (!q && ch == '(') depth++;
   116	      else if (!q && ch == ')') depth--;
   117	      else if (!q && depth == 0 && ch == ',') n++;
   118	    }
   119	    return n;
   120	  }
   121	}
