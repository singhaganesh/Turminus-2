     7	  }
     8	  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {
     9	    if (analysed.size() >= floor) return "0";
    10	    if (hitUnits.isEmpty()) return "0";
    11	    return "1";
    12	  }
    13	}
