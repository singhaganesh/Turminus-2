import java.util.*;
public class Scan {
  public static Set<String> lines(String body) {
    LinkedHashSet<String> s = new LinkedHashSet<String>();
    for (String line : body.split("\n")) {
      String t = line.trim();
      if (t.startsWith("import ")) s.add(t);
    }
    return s;
  }
}
