### /app/deskbin/gen/Cite.java
     1	import java.util.*;
     2	public class Cite {
     3	  public static LinkedHashSet<String> tags(String body, Set<String> known) {
     4	    LinkedHashSet<String> out = new LinkedHashSet<String>();
     5	    String[] lines = body.split("\n");
     6	    for (int i = 0; i < lines.length; i++) {
     7	      String t = lines[i].trim();
     8	      if (t.startsWith("import ")) {
     9	        String r = t.substring(7).replace(";", "").trim();
    10	        int d = r.lastIndexOf('.');
    11	        String n = d < 0 ? r : r.substring(d + 1);
    12	        if (known.contains(n)) out.add(n);
    13	      }
    14	    }
    15	    return out;
    16	  }
    17	}
