[39.059265, "o", "   233\t      if (u == null) continue;\r\n   234\t      cites.put(p, Cite.tags(u.body, kn));\r\n   235\t      for (String[] h : u.hits) {\r\n   236\t        findings.add(h);\r\n   237\t        hitUnits.add(h[0]);\r\n   238\t      }\r\n   239\t    }\r\n   240\t    writeCache(units, cites);\r\n   241\t    LinkedHashSet<String> must = new LinkedHashSet<String>();\r\n   242\t    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n   243\t      for (String t : e.getValue()) {\r\n   244\t        if (changedTypes.contains(t)) must.add(e.getKey());\r\n   245\t      }\r\n   246\t    }\r\n   247\t    List<String> assayed = Seal.assayedOf(new ArrayList<String>(analysed), hitUnits);\r\n   248\t    String code = Seal.codeOf(new ArrayList<String>(analysed), hitUnits, must, floor());\r\n   249\t    writeLast(assayed, findings, code);\r\n   250\t    return Integer.parseInt(code);\r\n   251\t  }\r\n   252\t}\r\n\u001b[?2004hroot@2442248daede:/app# "]
[74.464262, "i", "cat > /app/purlbox/PurlBox.java <<'EOF'\nimport java.io.*;\npublic class PurlBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Cite.java\")));\n    purl(w);\n    w.close();\n  }\n  public static void purl(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Cite {\");\n    a.println(\"  public static LinkedHashSet<String> tags(String body, Set<String> known) {\");\n    a.println(\"    LinkedHashSet<String> out = new LinkedHashSet<String>();\");\n    a.println(\"    for (String name : known) {\");\n    a.println(\"      int from = 0;\");\n    a.println(\"      while (from <= body.length() - name.length()) {\");\n    a.println(\"        int at = body.indexOf(name, from);\");\n    a.println(\"        if (at < 0) break;\");\n    a.println(\"        int end = at + name.length();\");\n    a.println(\"        boolean left = at == 0 || !Character.isJavaIdentifierPart(body.charAt(at - 1));\");\n    a.println(\"        boolean right = end == body.length() || !Character.isJavaIdentifierPart(body.charAt(end));\");\n    a.println(\"        if (left && right) { out.add(name); break; }\");\n    a.println(\"        from = at + 1;\");\n    a.println(\"      }\");\n    a.println(\"    }\");\n    a.println(\"    return out;\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\ncat > /app/knitwell/ops/KnitBox.java <<'EOF'\nimport java.io.*;\npublic class KnitBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Sched.java\")));\n    knit(w);\n    w.close();\n  }\n  public static void knit(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Sched {\");\n    a.println(\"  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\");\n    a.println(\"    LinkedHashSet<String> s = new LinkedHashSet<String>();\");\n    a.println(\"    s.addAll(changedFiles);\");\n    a.println(\"    for (String c : changedFiles) {\");\n    a.println(\"      Set<String> im = importers.get(c);\");\n    a.println(\"      if (im != null) s.addAll(im);\");\n    a.println(\"    }\");\n    a.println(\"    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\");\n    a.println(\"      for (String type : e.getValue()) {\");\n    a.println(\"        if (changedTypes.contains(type)) { s.add(e.getKey()); break; }\");\n    a.println(\"      }\");\n    a.println(\"    }\");\n    a.println(\"    return new ArrayList<String>(s);\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\ncat > /app/tintlag/core/TintBox.java <<'EOF'\nimport java.io.*;\npublic class TintBox {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Seal.java\")));\n    tint(w);\n    w.close();\n  }\n  public static void tint(PrintWriter a) throws Exception {\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Seal {\");\n    a.println(\"  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\");\n    a.println(\"    return new ArrayList<String>(new LinkedHashSet<String>(analysed));\");\n    a.println(\"  }\");\n    a.println(\"  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\");\n    a.println(\"    LinkedHashSet<String> covered = new LinkedHashSet<String>(analysed);\");\n    a.println(\"    if (!covered.containsAll(must)) return \\\"1\\\";\");\n    a.println(\"    if (!hitUnits.isEmpty()) return \\\"1\\\";\");\n    a.println(\"    return \\\"0\\\";\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\n/app/assemble.bash\n"]
