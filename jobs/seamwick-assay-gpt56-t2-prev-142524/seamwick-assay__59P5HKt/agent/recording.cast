[39.058864, "o", "\t    Map<String, Set<String>> cites = new LinkedHashMap<String, Set<String>>();\r\n   209\t    for (Loom.Unit u : units.values()) {\r\n   210\t      cites.put(u.path, Cite.tags(u.body, kn));\r\n   211\t    }\r\n   212\t    Map<String, String> oldFp = loadOldFp();\r\n   213\t    Map<String, String> newFp = fps(units);\r\n   214\t    LinkedHashSet<String> changedTypes = new LinkedHashSet<String>();\r\n   215\t    for (Map.Entry<String, String> e : newFp.entrySet()) {\r\n   216\t      String o = oldFp.get(e.getKey());\r\n   217\t      if (o == null || !o.equals(e.getValue())) changedTypes.add(e.getKey());\r\n"]
