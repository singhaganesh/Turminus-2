Sending keys: ['cat > /app/hopcue/rim.rs <<\'EOF\'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<\'EOF\'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], root: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(root);\n    fs::create_dir_all(root).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|x| x.0);\n    for (day, path) in files {\n        let name = format!("d{:08}.tbl", day);\n        fs::copy(path, format!("{}/{}", root, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/shardfold/read.rs <<\'EOF\'\nuse std::fs;\n\npub fn list(root: &str) -> Result<Vec<(i32, String)>, i32> {\n    let mut files = Vec::new();\n    let entries = fs::read_dir(root).map_err(|_| 1)?;\n    for entry in entries {\n        let entry = entry.map_err(|_| 1)?;\n        let ty = entry.file_type().map_err(|_| 1)?;\n        if !ty.is_file() {\n            continue;\n        }\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with(\'d\') || !name.ends_with(".tbl") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|b| b.is_ascii_digit()) {\n            continue;\n        }\n        let day = digits.parse::<i32>().map_err(|_| 1)?;\n        files.push((day, entry.path().to_string_lossy().into_owned()));\n    }\n    files.sort_by_key(|x| x.0);\n    Ok(files)\n}\n\npub fn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
Sending keys: ['cat > /app/urncue/fold.rs <<\'EOF\'\n#[path = "../hopcue/rim.rs"]\nmod rim;\n#[path = "../restpit/soak.rs"]\nmod soak;\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?\n        .trim()\n        .parse::<i32>()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list("/app/daywell")?);\n    if picked.is_empty() {\n        let _ = fs::remove_dir_all("/app/packbay/stage");\n        let _ = fs::remove_dir_all("/app/packbay/latest");\n        fs::create_dir_all("/app/packbay/stage").map_err(|_| 1)?;\n        fs::create_dir_all("/app/packbay/latest").map_err(|_| 1)?;\n        return Err(1);\n    }\n\n    let mut taken = 0i32;\n    for (_, source) in &picked {\n        taken = taken.checked_add(read::nlines(source)?).ok_or(1)?;\n    }\n\n    soak::soak(&picked, "/app/packbay/stage")?;\n    soak::soak(&picked, "/app/packbay/latest")?;\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write(\n        "/app/bloturn/ledger.json",\n        format!("{{\\"taken\\":{}}}", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((picked, taken))\n}\nEOF\ncat > /app/millrib/gait.rs <<\'EOF\'\nuse std::fs;\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string("/app/millrib/sheet.tpl").map_err(|_| 1)?;\n    let out = tpl\n        .replace("__P__", probe)\n        .replace("__M__", &matched.to_string())\n        .replace("__T__", &taken.to_string());\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/check.json", out).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    if files.is_empty() {\n        return 1;\n    }\n\n    // This is deliberately independent of ledger.json and the staged copies:\n    // every selected source is reopened from /app/daywell for the live check.\n    let mut matched = 0i32;\n    for (_, path) in files {\n        let text = match fs::read_to_string(path) {\n            Ok(text) => text,\n            Err(_) => return 1,\n        };\n        let count = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n        matched = match matched.checked_add(count) {\n            Some(total) => total,\n            None => return 1,\n        };\n    }\n    if matched != taken {\n        return 1;\n    }\n    let probe = match files.last() {\n        Some((_, path)) => path.as_str(),\n        None => return 1,\n    };\n    if emit(probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
