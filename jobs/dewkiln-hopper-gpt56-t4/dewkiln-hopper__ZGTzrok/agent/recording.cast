[32.213725, "o", "rker..Dying$C$K$C$V$C$alloc..collections..btree..node..marker..Leaf$GT$$C$alloc..collections..btree..node..marker..Edge$GT$$GT$27deallocating_next_unchecked28_$u7b$$u7b$closure$u7d$$u7d$17h6b4231f4e6b1d3a1E\r\n_ZN4core5slice5index13get_noubcheck17h33629a7606cf996cE\r\nget_noubcheck<core::mem::maybe_uninit::MaybeUninit<core::ptr::non_null::NonNull<alloc::collections::btree::node::LeafNode<u64, gimli::read::abbrev::Abbreviation>>>>\r\n"]
[32.217824, "o", "\u001b[?2004h"]
[32.218152, "o", "root@fc8f0a718c8f:/app# "]
[42.70504, "i", "echo '===== urncue/fold.rs ====='; cat /app/urncue/fold.rs; echo '===== wickmill/boot.rs ====='; cat /app/wickmill/boot.rs; echo '===== corkpit/floor.rs ====='; cat /app/corkpit/floor.rs; echo '===== corkpit/NOTE.txt ====='; cat /app/corkpit/NOTE.txt; echo '===== SHIFT ====='; cat /app/opstext/SHIFT.txt\n"]
[42.707158, "o", "echo '===== urncue/fold.rs ====='; cat /app/urncue/fold.rs; echo '===== wickmill/boot.rs ====='; cat /app/wickmill/boot.rs; echo '===== corkpit/floor.rs ====='; cat /app/corkpit/floor.rs; echo '===== corkpit/NOTE.txt ====='; cat /app/corkpit/NOTE.txt; echo '===== SHIFT ====='; cat /app/opstext/SHIFT.txt\r\n\u001b[?2004l\r"]
[42.708412, "o", "===== urncue/fold.rs =====\r\n"]
[42.711415, "o", "#[path = \"../hopcue/rim.rs\"]\r\nmod rim;\r\n#[path = \"../restpit/soak.rs\"]\r\nmod soak;\r\n#[path = \"../shardfold/read.rs\"]\r\nmod read;\r\n\r\nuse std::fs;\r\n\r\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n        .map_err(|_| 1)?\r\n        .trim()\r\n        .parse()\r\n        .map_err(|_| 1)?;\r\n    let listed = read::list(\"/app/daywell\");\r\n    let picked = rim::rim(wall, listed);\r\n    if picked.is_empty() {\r\n        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n        return Ok((Vec::new(), 0));\r\n    }\r\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    let mut packed = Vec::new();\r\n    let mut taken = 0;\r\n    for (d, p) in picked {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n        taken += read::nlines(&dest);\r\n        packed.push((d, dest));\r\n    }\r\n    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    Ok((packed, taken))\r\n}\r\n"]
[42.7136, "o", "===== wickmill/boot.rs =====\r\n"]
[42.715049, "o", "#[path = \"../urncue/fold.rs\"]\r\nmod fold;\r\n#[path = \"../millrib/gait.rs\"]\r\nmod gait;\r\n#[path = \"../lidcue/skip.rs\"]\r\nmod skip;\r\n#[path = \"../corkpit/floor.rs\"]\r\nmod floor;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"clasp\" {\r\n        eprintln!(\"usage: dewkiln clasp\");\r\n        std::process::exit(2);\r\n    }\r\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    let code = match fold::fold() {\r\n        Ok((packed, taken)) => {\r\n            let mut dump = packed.clone();\r\n            skip::skip(&mut dump);\r\n            let _ = floor::floor(taken);\r\n            gait::gait(taken, &packed)\r\n        }\r\n        Err(c) => c,\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[42.717168, "o", "===== corkpit/floor.rs =====\r\n"]
[42.718341, "o", "use std::fs;\r\n\r\npub fn floor(a: i32) -> bool {\r\n    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n        Err(_) => 0,\r\n    };\r\n    a >= t\r\n}\r\n"]
[42.719126, "o", "===== corkpit/NOTE.txt =====\r\n"]
[42.723617, "o", "floor() reads MIN.txt and compares a taken total to that integer.\r\nCI used this as a cheap rehearsal when the desk was first wired.\r\n"]
[42.724576, "o", "===== SHIFT =====\r\n"]
[42.726345, "o", "Nightly clasp has stayed green since the CI floor landed.\r\nOperators still open /app/packbay/latest after incidents and find the\r\nnewest populated day file missing even when /app/daywell still holds it.\r\nThe floor value lives under floorcue/.\r\n"]
[42.726654, "o", "\u001b[?2004hroot@fc8f0a718c8f:/app# "]
[43.1513, "i", "echo '===== all compact numbered sources ====='; for f in /app/{hopcue,millrib,restpit,shardfold,lidcue,urncue,wickmill,corkpit}/*.rs; do echo \"--- $f\"; nl -ba \"$f\"; done\n"]
[43.152706, "o", "echo '===== all compact numbered sources ====='; for f in /app/{hopcue,millrib,restpit,shardfold,lidcue,urncue,wickmill,corkpit}/*.rs; do echo \"--- $f\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[43.153084, "o", "===== all compact numbered sources =====\r\n"]
[43.154716, "o", "--- /app/hopcue/rim.rs\r\n"]
[43.161109, "o", "     1\tpub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n     2\t    b.into_iter().filter(|(d, _)| *d < a).collect()\r\n     3\t}\r\n"]
[43.161434, "o", "--- /app/millrib/gait.rs\r\n"]
[43.163525, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\r\n     4\t    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n     5\t    let out = tpl\r\n     6\t        .replace(\"__P__\", p)\r\n     7\t        .replace(\"__M__\", &m.to_string())\r\n     8\t        .replace(\"__T__\", &t.to_string());\r\n     9\t    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    10\t    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)?;\r\n    11\t    Ok(())\r\n    12\t}\r\n    13\t\r\n    14\tpub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {\r\n    15\t    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n    16\t    if emit(\"ledger\", a, a).is_err() {\r\n    17\t        return 1;\r\n    18\t    }\r\n    19\t    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n    20\t        return 1;\r\n    21\t    }\r\n    22\t    0\r\n    23\t}\r\n"]
[43.165356, "o", "--- /app/restpit/soak.rs\r\n"]
[43.16816, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n     4\t    let _ = fs::remove_dir_all(b);\r\n     5\t    fs::create_dir_all(b).map_err(|_| 1)?;\r\n     6\t    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n     7\t    xs.sort_by_key(|x| x.0);\r\n     8\t    if !xs.is_empty() {\r\n     9\t        xs.pop();\r\n    10\t    }\r\n    11\t    for (d, p) in xs {\r\n    12\t        let name = format!(\"d{:08}.tbl\", d);\r\n    13\t        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    14\t    }\r\n    15\t    Ok(())\r\n    16\t}\r\n"]
[43.168444, "o", "--- /app/shardfold/read.rs\r\n"]
[43.17126, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn list(root: &str) -> Vec<(i32, String)> {\r\n     4\t    let mut v = Vec::new();\r\n     5\t    let rd = match fs::read_dir(root) {\r\n     6\t        Ok(x) => x,\r\n     7\t        Err(_) => return v,\r\n     8\t    };\r\n     9\t    for ent in rd.flatten() {\r\n    10\t        let name = ent.file_name().to_string_lossy().into_owned();\r\n    11\t        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n    12\t            continue;\r\n    13\t        }\r\n    14\t        let mid = &name[1..name.len() - 4];\r\n    15\t        if let Ok(d) = mid.parse::<i32>() {\r\n    16\t            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n    17\t        }\r\n    18\t    }\r\n    19\t    v.sort_by_key(|x| x.0);\r\n    20\t    v\r\n    21\t}\r\n    22\t\r\n    23\tpub fn nlines(path: &str) -> i32 {\r\n    24\t    match fs::read_to_string(path) {\r\n    25\t        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n    26\t        Err(_) => 0,\r\n    27\t    }\r\n    28\t}\r\n"]
[43.17229, "o", "--- /app/lidcue/skip.rs\r\n"]
[43.175524, "o", "     1\tpub fn skip(a: &mut [(i32, String)]) {\r\n     2\t    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n     3\t}\r\n     4\t\r\n     5\tpub fn width(a: &[(i32, String)]) -> usize {\r\n     6\t    a.len()\r\n     7\t}\r\n     8\t\r\n     9\tpub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    10\t    a.first().map(|x| x.0)\r\n    11\t}\r\n"]
[43.175945, "o", "--- /app/urncue/fold.rs\r\n"]
[43.179432, "o", "     1\t#[path = \"../hopcue/rim.rs\"]\r\n     2\tmod rim;\r\n     3\t#[path = \"../restpit/soak.rs\"]\r\n     4\tmod soak;\r\n     5\t#[path = \"../shardfold/read.rs\"]\r\n     6\tmod read;\r\n"]
[43.179585, "o", "     7\t\r\n     8\tuse std::fs;\r\n     9\t\r\n    10\tpub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    11\t    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n    12\t        .map_err(|_| 1)?\r\n    13\t        .trim()\r\n    14\t        .parse()\r\n    15\t        .map_err(|_| 1)?;\r\n    16\t    let listed = read::list(\"/app/daywell\");\r\n    17\t    let picked = rim::rim(wall, listed);\r\n    18\t    if picked.is_empty() {\r\n    19\t        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    20\t        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n    21\t        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    22\t        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n    23\t        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n    24\t        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n    25\t        return Ok((Vec::new(), 0));\r\n    26\t    }\r\n    27\t    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    28\t    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    29\t    let mut packed = Vec::new();\r\n    30\t    let mut taken = 0;\r\n    31\t    for (d, p) in picked {\r\n    32\t        let name = format!(\"d{:08}.tbl\", d);\r\n    33\t        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n    34\t        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n    35\t        taken += read::nlines(&dest);\r\n    36\t        packed.push((d, dest));\r\n    37\t    }\r\n    38\t    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    39\t    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    40\t    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    41\t    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    42\t    Ok((packed, taken))\r\n    43\t}\r\n"]
[43.182228, "o", "--- /app/wickmill/boot.rs\r\n"]
[43.183992, "o", "     1\t#[path = \"../urncue/fold.rs\"]\r\n     2\tmod fold;\r\n     3\t#[path = \"../millrib/gait.rs\"]\r\n     4\tmod gait;\r\n     5\t#[path = \"../lidcue/skip.rs\"]\r\n     6\tmod skip;\r\n     7\t#[path = \"../corkpit/floor.rs\"]\r\n     8\tmod floor;\r\n     9\t\r\n    10\tfn main() {\r\n    11\t    let mut args = std::env::args();\r\n    12\t    let _ = args.next();\r\n    13\t    let cmd = args.next().unwrap_or_default();\r\n    14\t    if cmd != \"clasp\" {\r\n    15\t        eprintln!(\"usage: dewkiln clasp\");\r\n    16\t        std::process::exit(2);\r\n    17\t    }\r\n    18\t    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    19\t    let code = match fold::fold() {\r\n    20\t        Ok((packed, taken)) => {\r\n    21\t            let mut dump = packed.clone();\r\n    22\t            skip::skip(&mut dump);\r\n    23\t            let _ = floor::floor(taken);\r\n    24\t            gait::gait(taken, &packed)\r\n    25\t        }\r\n    26\t        Err(c) => c,\r\n    27\t    };\r\n    28\t    std::process::exit(code);\r\n    29\t}\r\n"]
[43.184347, "o", "--- /app/corkpit/floor.rs\r\n"]
[43.18696, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn floor(a: i32) -> bool {\r\n     4\t    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n     5\t        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n     6\t        Err(_) => 0,\r\n     7\t    };\r\n     8\t    a >= t\r\n     9\t}\r\n"]
[43.187791, "o", "\u001b[?2004hroot@fc8f0a718c8f:/app# "]
[81.195879, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], root: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(root);\n    fs::create_dir_all(root).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|x| x.0);\n    for (day, path) in files {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(path, format!(\"{}/{}\", root, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/shardfold/read.rs <<'EOF'\nuse std::fs;\n\npub fn list(root: &str) -> Result<Vec<(i32, String)>, i32> {\n    let mut files = Vec::new();\n    let entries = fs::read_dir(root).map_err(|_| 1)?;\n    for entry in entries {\n        let entry = entry.map_err(|_| 1)?;\n        let ty = entry.file_type().map_err(|_| 1)?;\n        if !ty.is_file() {\n            continue;\n        }\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|b| b.is_ascii_digit()) {\n            continue;\n        }\n        let day = digits.parse::<i32>().map_err(|_| 1)?;\n        files.push((day, entry.path().to_string_lossy().into_owned()));\n    }\n    files.sort_by_key(|x| x.0);\n    Ok(files)\n}\n\npub fn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\nEOF\n"]
