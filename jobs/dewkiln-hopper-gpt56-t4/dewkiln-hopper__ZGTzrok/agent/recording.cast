[30.184801, "o", "--- wick.sh ---\r\n"]
[30.18583, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/bloturn /app/packbay\r\nrustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\r\n\u001b[?2004hroot@fc8f0a718c8f:/app# "]
[30.702119, "i", "for d in wickmill hopcue millrib restpit urncue shardfold lidcue; do echo \"===== /app/$d =====\"; find \"/app/$d\" -maxdepth 4 -type f -print 2>/dev/null; done\n"]
