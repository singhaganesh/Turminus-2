[81.36307, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.363117, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[81.363168, "o", "> "]
[81.363365, "o", "fn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.36354, "o", "    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[81.363639, "o", "\u001b[?2004h>     let out = tpl\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.363674, "o", "> "]
[81.363808, "o", "        .replace(\"__P__\", probe)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.36399, "o", "        .replace(\"__M__\", &matched.to_string())\r\n\u001b[?2004l\r"]
[81.36407, "o", "\u001b[?2004h> "]
[81.364189, "o", "        .replace(\"__T__\", &taken.to_string());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.364441, "o", "    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.364595, "o", "> "]
[81.364748, "o", "    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[81.364899, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.365129, "o", "pub fn gait(taken: i32, files: &[(i32, String)]) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.365414, "o", "    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.365658, "o", "    if files.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.365781, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[81.366027, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[81.36612, "o", "\u001b[?2004h> "]
[81.366528, "o", "    // This is deliberately independent of ledger.json and the staged copies:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.366595, "o", "    // every selected source is reopened from /app/daywell for the live check.\r\n\u001b[?2004l\r"]
[81.366641, "o", "\u001b[?2004h> "]
[81.366808, "o", "    let mut matched = 0i32;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.366954, "o", "    for (_, path) in files {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.367072, "o", "        let text = match fs::read_to_string(path) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.367231, "o", "            Ok(text) => text,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.36733, "o", "            Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.367423, "o", "        };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.367711, "o", "        let count = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\r\n\u001b[?2004l\r"]
[81.367785, "o", "\u001b[?2004h> "]
[81.367998, "o", "        matched = match matched.checked_add(count) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.368149, "o", "            Some(total) => total,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.368351, "o", "            None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r"]
[81.368436, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[81.369052, "o", ">     if matched != taken {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let probe = match files.last() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.369194, "o", "        Some((_, path)) => path.as_str(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.369318, "o", "        None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.369389, "o", "    };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.369601, "o", "    if emit(probe, matched, taken).is_err() {\r\n\u001b[?2004l\r"]
[81.369733, "o", "\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r"]
[81.369791, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[81.369853, "o", "\u001b[?2004h> "]
[81.370112, "o", "    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n\u001b[?2004l\r"]
[81.370238, "o", "\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r"]
[81.370352, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.370469, "o", "    0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.370588, "o", "EOF\r\n\u001b[?2004l\r"]
[81.372602, "o", "\u001b[?2004hroot@fc8f0a718c8f:/app# "]
[81.561013, "i", "python3 - <<'PY'\np='/app/wickmill/boot.rs'\ns=open(p).read()\ns=s.replace('            let _ = floor::floor(taken);\\n            gait::gait(taken, &packed)', '            if !floor::floor(taken) {\\n                1\\n            } else {\\n                gait::gait(taken, &packed)\\n            }')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\nreadelf -h /app/bin/dewkiln | sed -n '1,12p'\nrm -f /app/bloturn/GUARD\n/app/bin/dewkiln clasp; rc=$?; echo \"CLASP_RC=$rc\"\necho '--- outputs ---'; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do printf '%s: ' \"$f\"; cat \"$f\" 2>/dev/null || echo MISSING; echo; done\necho '--- latest and comparisons ---'; find /app/packbay/latest -maxdepth 1 -type f -printf '%f %s bytes\\n' | sort; for f in /app/packbay/latest/*.tbl; do n=$(basename \"$f\"); cmp -s \"$f\" \"/app/daywell/$n\" && echo \"$n MATCH rows=$(wc -l < \"$f\")\" || echo \"$n MISMATCH\"; done\n"]
[81.561285, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[81.561344, "o", "\u001b[?2004h> "]
[81.562762, "o", "p='/app/wickmill/boot.rs'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('            let _ = floor::floor(taken);\\n            gait::gait(taken, &packed)', '            if !floor::floor(taken) {\\n                1\\n            } else {\\n                gait::gait(taken, &packed)\\n            }')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[81.59121, "o", "\u001b[?2004hroot@fc8f0a718c8f:/app# /app/wick.sh\r\n\u001b[?2004l\r"]
[82.550817, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `width` is never used\u001b[0m\r\n\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/wickmill/../lidcue/skip.rs:5:8\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m5\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn width(a: &[(i32, String)]) -> usize {\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(dead_code)]` on by default\u001b[0m\r\n\r\n"]
[82.550937, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `first` is never used\u001b[0m\r\n\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/wickmill/../lidcue/skip.rs:9:8\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m9\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn first(a: &[(i32, String)]) -> Option<i32> {\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^\u001b[0m\r\n\r\n"]
