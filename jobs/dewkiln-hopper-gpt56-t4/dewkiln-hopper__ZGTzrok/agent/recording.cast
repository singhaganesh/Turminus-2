[81.354699, "i", "cat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?\n        .trim()\n        .parse::<i32>()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list(\"/app/daywell\")?);\n    if picked.is_empty() {\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\n        fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\n        fs::create_dir_all(\"/app/packbay/latest\").map_err(|_| 1)?;\n        return Err(1);\n    }\n\n    let mut taken = 0i32;\n    for (_, source) in &picked {\n        taken = taken.checked_add(read::nlines(source)?).ok_or(1)?;\n    }\n\n    soak::soak(&picked, \"/app/packbay/stage\")?;\n    soak::soak(&picked, \"/app/packbay/latest\")?;\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\n        \"/app/bloturn/ledger.json\",\n        format!(\"{{\\\"taken\\\":{}}}\", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((picked, taken))\n}\nEOF\ncat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let out = tpl\n        .replace(\"__P__\", probe)\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    if files.is_empty() {\n        return 1;\n    }\n\n    // This is deliberately independent of ledger.json and the staged copies:\n    // every selected source is reopened from /app/daywell for the live check.\n    let mut matched = 0i32;\n    for (_, path) in files {\n        let text = match fs::read_to_string(path) {\n            Ok(text) => text,\n            Err(_) => return 1,\n        };\n        let count = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n        matched = match matched.checked_add(count) {\n            Some(total) => total,\n            None => return 1,\n        };\n    }\n    if matched != taken {\n        return 1;\n    }\n    let probe = match files.last() {\n        Some((_, path)) => path.as_str(),\n        None => return 1,\n    };\n    if emit(probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\n"]
