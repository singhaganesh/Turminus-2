.Enumeration<JarEntry> entries = jf.entries();\n            while (entries.hasMoreElements()) {\n                String n = entries.nextElement().getName();\n                if (n.endsWith("Booth.class") && !n.contains("/")) {\n                    Class.forName(n.substring(0, n.length() - 6), true, loader);\n                }\n            }\n            Class<?> rib = Class.forName("Rib", true, loader);\n            java.lang.reflect.Method all = rib.getDeclaredMethod("all");\n            all.setAccessible(true);\n            @SuppressWarnings("unchecked")\n            List<String> live = (List<String>) all.invoke(null);\n            return live.containsAll(required) ? 0 : 1;\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(\n            Paths.get("/app/blastcp"),\n            Paths.get("/app/desknote/NAMES.txt"),\n            Paths.get("/app/jarwell/husk.jar")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar) || !Files.isRegularFile(capFile)) {\n            return 1;\n        }\n        long cap = Long.parseLong(Files.readString(capFile).trim());\n        return cap >= 0 && Files.size(jar) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(\n            Paths.get("/app/jarwell/husk.jar"),\n            Paths.get("/app/desknote/CAP.txt")));\n    }\n}\nEOF\npython3 - <<\'PY\'\np=\'/app/brim.sh\'\ns=open(p).read()\nold=\'mkdir -p /app/blastcp /app/jarwell /app/bin\\n\'\nnew=\'rm -rf /app/blastcp\\nmkdir -p /app/blastcp /app/jarwell /app/bin\\n\'\nassert old in s\nopen(p,\'w\').write(s.replace(old,new))\nPY\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
