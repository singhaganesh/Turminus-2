[84.938695, "o", "\u001b[?2004hroot@edca795078e7:/app# "]
[84.938945, "o", "cat > /app/qanbox/tally.rs <<'EOF'"]
[84.939402, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.939474, "o", "> "]
[84.94004, "o", "#[path = \"../treyfun/clip.rs\"]"]
[84.945393, "o", "\r\n"]
[84.948369, "o", "\u001b[?2004l\r\u001b[?2004h> mod clip;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> use std::collections::BTreeMap;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #[derive(Clone)]\r\n\u001b[?2004l\r\u001b[?2004h> pub struct Rec {\r\n\u001b[?2004l\r\u001b[?2004h>     pub issue: i32,\r\n\u001b[?2004l\r\u001b[?2004h>     pub kind: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub frames: Vec<String>,\r\n\u001b[?2004l\r\u001b[?2004h>     pub body: String,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let paths = crate::walk::gather(a)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for path in paths {\r\n\u001b[?2004l\r\u001b[?2004h>         let text = std::fs::read_to_string(path).map_err(|_| 3)?;\r\n\u001b[?2004l\r\u001b[?2004h>         let (kind, frames) = clip::take(&text)?;\r\n\u001b[?2004l\r\u001b[?2004h>         let body = frames.join(\" | \");\r\n\u001b[?2004l\r\u001b[?2004h>         if let Some(old) = bag.get(&frames) {\r\n\u001b[?2004l\r\u001b[?2004h>             if old.kind != kind || old.body != body {\r\n\u001b[?2004l\r\u001b[?2004h>                 return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r\u001b[?2004h>             bag.insert(frames.clone(), Rec { issue: 0, kind, frames, body });\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let mut recs: Vec<Rec> = bag.into_values().collect();\r\n\u001b[?2004l\r\u001b[?2004h>     for (i, rec) in recs.iter_mut().enumerate() {\r\n\u001b[?2004l\r\u001b[?2004h>         rec.issue = i as i32 + 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     Ok(recs)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[84.950606, "o", "\u001b[?2004hroot@edca795078e7:/app# "]
[85.104435, "i", "cat > /app/humdock/emit.rs <<'EOF'\nuse crate::tally::Rec;\nuse std::fmt::Write;\n\npub fn emit(rows: &[Rec]) -> i32 {\n    if rows.is_empty() {\n        return 1;\n    }\n    if std::fs::create_dir_all(\"/app/inkbay\").is_err() {\n        return 1;\n    }\n    let mut inner = String::new();\n    let mut desk = String::from(\"issue\\tkind\\tbody\\n\");\n    for (i, r) in rows.iter().enumerate() {\n        if i != 0 { inner.push(','); }\n        let _ = write!(inner, \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\n            r.issue, jstr(&r.kind), jarr(&r.frames), jstr(&r.body));\n        let _ = writeln!(desk, \"{}\\t{}\\t{}\", r.issue, r.kind, r.body);\n    }\n    let tpl = match std::fs::read_to_string(\"/app/tplbay/bound.tpl\") {\n        Ok(t) if t.contains(\"__ROWS__\") => t,\n        _ => return 1,\n    };\n    let bound = tpl.replace(\"__ROWS__\", &inner);\n    let btmp = \"/app/inkbay/.bound.json.tmp\";\n    let dtmp = \"/app/inkbay/.desk.tsv.tmp\";\n    if std::fs::write(btmp, bound).is_err() || std::fs::write(dtmp, desk).is_err() {\n        cleanup();\n        return 1;\n    }\n    if std::fs::rename(btmp, \"/app/inkbay/bound.json\").is_err()\n        || std::fs::rename(dtmp, \"/app/inkbay/desk.tsv\").is_err()\n    {\n        cleanup();\n        return 1;\n    }\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\n\nfn cleanup() {\n    let _ = std::fs::remove_file(\"/app/inkbay/.bound.json.tmp\");\n    let _ = std::fs::remove_file(\"/app/inkbay/.desk.tsv.tmp\");\n}\n\nfn jstr(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => { let _ = write!(out, \"\\\\u{:04x}\", c as u32); },\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\nfn jarr(v: &[String]) -> String {\n    format!(\"[{}]\", v.iter().map(|s| jstr(s)).collect::<Vec<_>>().join(\",\"))\n}\nEOF\npython3 - <<'PY'\np='/app/ketchcli/main.rs'\ns=open(p).read()\ns=s.replace('    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\\n', '    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\\n    if args.next().is_some() {\\n        let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\\n        std::process::exit(2);\\n    }\\n    let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\\n')\nopen(p,'w').write(s)\nPY\nchmod +x /app/hearth.sh\n/app/hearth.sh\nod -An -tx1 -N4 /app/bin/loomketch\n"]
[85.104656, "o", "cat > /app/humdock/emit.rs <<'EOF'\r\n"]
