[84.934478, "o", "            let (number, _) = after_hash.split_once(char::is_whitespace).ok_or(3)?;\r\n\u001b[?2004l\r"]
[84.934553, "o", "\u001b[?2004h> "]
[84.934727, "o", "            if number.is_empty() || !number.bytes().all(|c| c.is_ascii_digit()) {\r\n\u001b[?2004l\r"]
[84.934755, "o", "\u001b[?2004h> "]
[84.934852, "o", "                return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.934875, "o", "            }\r\n\u001b[?2004l\r"]
[84.935003, "o", "\u001b[?2004h> "]
[84.935111, "o", "            let (_, after_in) = trimmed.split_once(\" in \").ok_or(3)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.935286, "o", "            let sym = after_in.split_whitespace().next().unwrap_or(\"\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.935394, "o", "            if sym.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.935415, "o", "> "]
[84.935655, "o", "                return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             if !sanitizer_name(sym) {\r\n\u001b[?2004l\r"]
[84.935683, "o", "\u001b[?2004h> "]
[84.935827, "o", "                frames.push(fold_hex(sym));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.935853, "o", "            }\r\n\u001b[?2004l\r"]
[84.935945, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.936126, "o", "        if trimmed.starts_with(\"SUMMARY: AddressSanitizer\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.9362, "o", "            summary = true;\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.936223, "o", "> "]
[84.93624, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.936517, "o", "> "]
[84.936546, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     if !summary || frame_lines == 0 || frames.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.936591, "o", "        return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h"]
