[86.479092, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `lined` is never used\u001b[0m\r\n\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/ketchcli/../walkcue/alpha.rs:1:8\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m1\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn lined(a: &mut Vec<String>) -> bool {\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(dead_code)]` on by default\u001b[0m\r\n\r\n"]
[88.131413, "i", "/app/bin/loomketch bind; rc=$?; echo rc=$rc; sha256sum /app/inkbay/bound.json /app/inkbay/desk.tsv; cp /app/inkbay/bound.json /tmp/bound.one; cp /app/inkbay/desk.tsv /tmp/desk.one; /app/bin/loomketch bind; echo second_rc=$?; cmp /tmp/bound.one /app/inkbay/bound.json && cmp /tmp/desk.one /app/inkbay/desk.tsv && echo stable=yes; cat /app/inkbay/bound.json; echo; cat /app/inkbay/desk.tsv; printf 'GUARD='; cat /app/inkbay/GUARD; echo\n"]
