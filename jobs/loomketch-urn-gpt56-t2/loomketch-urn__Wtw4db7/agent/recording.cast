[12.072436, "o", "loomketch mill layout\r\n=====================\r\n\r\nketchcli/main.rs dispatches bind.\r\n\r\nOther crates sit beside ketchcli. Journals live in /app/vatlogs.\r\nFixture copies of those journals sit at /app/seed/vatlogs.\r\nbind refreshes /app/inkbay/bound.json, /app/inkbay/desk.tsv, and /app/inkbay/GUARD.\r\n\r\nbound.json uses object findings as a list of records\r\n{ \"issue\": N, \"kind\": \"<kind>\", \"frames\": [\"<sym>\", ...], \"body\": \"<text>\" }\r\nwhere issue is an integer that starts at 1. desk.tsv starts with header\r\nissue\tkind\tbody\r\nthen one tab-separated row per finding, using those same issue values.\r\n\r\nJournal text is AddressSanitizer form: one ERROR: kind line followed by #N frame lines.\r\nTemplate copy sits at /app/tplbay/bound.tpl.\r\nwalkcue/ holds an ops sidecar used when KETCH_ALPHA=1.\r\n\r\nA bind root such as /tmp/loom_out sits outside /app/vatlogs and must fail.\r\n\r\n\r\n--- files ---\r\n"]
[12.081636, "o", "/app/bin/loomketch\r\n/app/deskcue/MAP.txt\r\n/app/hearth.sh\r\n/app/humdock/emit.rs\r\n/app/inkbay/GUARD\r\n/app/inkbay/bound.json\r\n/app/inkbay/desk.tsv\r\n/app/ketchcli/NOTES.txt\r\n/app/ketchcli/main.rs\r\n"]
[12.081856, "o", "/app/ketchcli/usage.txt\r\n/app/opsfold/PRIOR.txt\r\n/app/opsfold/SHIFT.txt\r\n/app/qanbox/tally.rs\r\n/app/seed/vatlogs/pid_17.asan\r\n/app/seed/vatlogs/pid_3.asan\r\n/app/seed/vatlogs/pid_441.asan\r\n/app/seed/vatlogs/pid_55.asan\r\n/app/seed/vatlogs/pid_80.asan\r\n/app/seed/vatlogs/pid_902.asan\r\n/app/tplbay/bound.tpl\r\n/app/tplbay/desk.tpl\r\n/app/treyfun/clip.rs\r\n/app/urnwalk/README.txt\r\n/app/urnwalk/walk.rs\r\n/app/vatlogs/pid_17.asan\r\n/app/vatlogs/pid_3.asan\r\n/app/vatlogs/pid_441.asan\r\n/app/vatlogs/pid_55.asan\r\n/app/vatlogs/pid_80.asan\r\n/app/vatlogs/pid_902.asan\r\n/app/walkcue/alpha.rs\r\n"]
[12.082338, "o", "\r\n--- binary ---\r\n"]
[12.082577, "o", "bash: file: command not found\r\n"]
