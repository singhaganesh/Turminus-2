[38.043978, "o", "\r\n\u001b[?2004l\r===== tally =====\r\n"]
[38.049536, "o", "     1\t#[path = \"../treyfun/clip.rs\"]\r\n     2\tmod clip;\r\n     3\t\r\n     4\tuse std::collections::HashMap;\r\n"]
[38.049712, "o", "     5\tuse std::sync::mpsc;\r\n     6\tuse std::thread;\r\n     7\t\r\n     8\t#[derive(Clone)]\r\n     9\tpub struct Rec {\r\n    10\t    pub issue: i32,\r\n    11\t    pub kind: String,\r\n    12\t    pub frames: Vec<String>,\r\n    13\t    pub body: String,\r\n    14\t}\r\n    15\t\r\n    16\tpub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\r\n    17\t    let paths = crate::walk::gather(a)?;\r\n    18\t    let (tx, rx) = mpsc::channel();\r\n    19\t    let mut hs = Vec::new();\r\n    20\t    for p in paths {\r\n    21\t        let tx = tx.clone();\r\n    22\t        hs.push(thread::spawn(move || {\r\n    23\t            let text = match std::fs::read_to_string(&p) {\r\n    24\t                Ok(t) => t,\r\n    25\t                Err(_) => return,\r\n    26\t            };\r\n    27\t            let (kind, frames) = match clip::take(&text) {\r\n    28\t                Ok(x) => x,\r\n    29\t                Err(_) => return,\r\n    30\t            };\r\n    31\t            if kind.is_empty() {\r\n    32\t                return;\r\n    33\t            }\r\n    34\t            let frames = clip::clip(&frames);\r\n    35\t            let body = frames.join(\" | \");\r\n    36\t            let _ = tx.send(Rec {\r\n    37\t                issue: 0,\r\n    38\t                kind,\r\n    39\t                frames,\r\n    40\t                body,\r\n    41\t            });\r\n    42\t        }));\r\n    43\t    }\r\n    44\t    drop(tx);\r\n    45\t    for h in hs {\r\n    46\t        let _ = h.join();\r\n    47\t    }\r\n    48\t    let mut bag: HashMap<String, Rec> = HashMap::new();\r\n    49\t    while let Ok(r) = rx.recv() {\r\n    50\t        bag.entry(r.body.clone()).or_insert(r);\r\n    51\t    }\r\n    52\t    let mut recs: Vec<Rec> = bag.into_values().collect();\r\n    53\t    for (i, r) in recs.iter_mut().enumerate() {\r\n    54\t        r.issue = (i as i32) + 1;\r\n    55\t    }\r\n    56\t    let _ = write_bound(&recs);\r\n    57\t    Ok(recs)\r\n    58\t}\r\n    59\t\r\n    60\tfn write_bound(recs: &[Rec]) -> i32 {\r\n    61\t    let tpl = std::fs::read_to_string(\"/app/tplbay/bound.tpl\").unwrap_or_else(|_| \"{\\\"findings\\\":[__ROWS__]}\".into());\r\n    62\t    if recs.is_empty() {\r\n    63\t        let _ = std::fs::write(\"/app/inkbay/bound.json\", tpl);\r\n    64\t        return 0;\r\n    65\t    }\r\n"]
[38.049748, "o", "    66\t    let mut inner = String::new();\r\n    67\t    for (i, r) in recs.iter().enumerate() {\r\n    68\t        if i > 0 {\r\n    69\t            inner.push(',');\r\n    70\t        }\r\n    71\t        inner.push_str(&format!(\r\n    72\t            \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\r\n    73\t            r.issue,\r\n    74\t            jstr(&r.kind),\r\n"]
[38.050131, "o", "    75\t            jarr(&r.frames),\r\n    76\t            jstr(&r.body)\r\n    77\t        ));\r\n    78\t    }\r\n    79\t    let out = tpl.replace(\"__ROWS__\", &inner);\r\n    80\t    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    81\t    match std::fs::write(\"/app/inkbay/bound.json\", out) {\r\n    82\t        Ok(()) => 0,\r\n    83\t        Err(_) => 1,\r\n    84\t    }\r\n    85\t}\r\n    86\t\r\n    87\tfn jstr(s: &str) -> String {\r\n    88\t    format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\"))\r\n    89\t}\r\n    90\t\r\n    91\tfn jarr(v: &[String]) -> String {\r\n    92\t    let parts: Vec<String> = v.iter().map(|x| jstr(x)).collect();\r\n    93\t    format!(\"[{}]\", parts.join(\",\"))\r\n    94\t}\r\n===== emit =====\r\n"]
[38.050857, "o", "     1\tuse crate::tally::Rec;\r\n     2\t\r\n     3\tpub fn emit(a: &[Rec]) -> i32 {\r\n     4\t    let mut rows: Vec<Rec> = a.to_vec();\r\n     5\t    rows.sort_by(|x, y| x.kind.cmp(&y.kind));\r\n     6\t    let mut out = String::from(\"issue\\tkind\\tbody\\n\");\r\n     7\t    for (i, r) in rows.iter().enumerate() {\r\n"]
[38.050972, "o", "     8\t        out.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, r.kind, r.body));\r\n     9\t    }\r\n    10\t    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    11\t    if std::fs::write(\"/app/inkbay/desk.tsv\", out).is_err() {\r\n    12\t        return 1;\r\n    13\t    }\r\n    14\t    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\r\n    15\t        return 1;\r\n    16\t    }\r\n    17\t    0\r\n    18\t}\r\n"]
[38.05116, "o", "===== PATH/tools =====\r\n"]
[38.051183, "o", "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\r\n"]
[38.052978, "o", "lrwxrwxrwx 1 root root 6 Mar 18  2025 /usr/local/cargo/bin/rustc -> rustup\r\n"]
[38.053244, "o", "\u001b[?2004hroot@edca795078e7:/app# "]
[84.912872, "i", "cat > /app/urnwalk/walk.rs <<'EOF'\nuse std::path::{Path, PathBuf};\n\npub fn gather(a: &str) -> Result<Vec<PathBuf>, i32> {\n    let allowed = std::fs::canonicalize(\"/app/vatlogs\").map_err(|_| 2)?;\n    let root = std::fs::canonicalize(a).map_err(|_| 2)?;\n    if !root.is_dir() || !root.starts_with(&allowed) {\n        return Err(2);\n    }\n    let mut paths = Vec::new();\n    visit(&root, &allowed, &mut paths)?;\n    if paths.is_empty() {\n        return Err(2);\n    }\n    paths.sort();\n    Ok(paths)\n}\n\nfn visit(dir: &Path, allowed: &Path, out: &mut Vec<PathBuf>) -> Result<(), i32> {\n    let rd = std::fs::read_dir(dir).map_err(|_| 2)?;\n    for entry in rd {\n        let entry = entry.map_err(|_| 2)?;\n        let path = entry.path();\n        let meta = std::fs::symlink_metadata(&path).map_err(|_| 2)?;\n        if meta.file_type().is_symlink() {\n            return Err(2);\n        }\n        let real = std::fs::canonicalize(&path).map_err(|_| 2)?;\n        if !real.starts_with(allowed) {\n            return Err(2);\n        }\n        if meta.is_dir() {\n            visit(&real, allowed, out)?;\n        } else if meta.is_file() {\n            out.push(real);\n        } else {\n            return Err(2);\n        }\n    }\n    Ok(())\n}\nEOF\ncat > /app/treyfun/clip.rs <<'EOF'\nfn sanitizer_name(s: &str) -> bool {\n    s.starts_with(\"__asan\") || s.starts_with(\"__interceptor\") || s.starts_with(\"__hwasan\")\n}\n\nfn fold_hex(s: &str) -> String {\n    let b = s.as_bytes();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < b.len() {\n        if i + 2 < b.len() && b[i] == b'0' && (b[i + 1] == b'x' || b[i + 1] == b'X')\n            && b[i + 2].is_ascii_hexdigit()\n        {\n            out.push_str(\"<hex>\");\n            i += 2;\n            while i < b.len() && b[i].is_ascii_hexdigit() {\n                i += 1;\n            }\n        } else {\n            let ch = s[i..].chars().next().unwrap();\n            out.push(ch);\n            i += ch.len_utf8();\n        }\n    }\n    out\n}\n\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() {\n        return Err(3);\n    }\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut frame_lines = 0usize;\n    let mut summary = false;\n    for line in text.lines() {\n        if line.contains(\"ERROR:\") {\n            if kind.is_some() {\n                return Err(3);\n            }\n            let rest = line.split_once(\"ERROR:\").unwrap().1.trim();\n            let after = rest.strip_prefix(\"AddressSanitizer:\").unwrap_or(rest).trim();\n            let value = after.split(\" on \").next().unwrap_or(\"\").trim();\n            if value.is_empty() {\n                return Err(3);\n            }\n            kind = Some(value.to_string());\n        }\n        let trimmed = line.trim_start();\n        if trimmed.starts_with('#') {\n            frame_lines += 1;\n            let after_hash = &trimmed[1..];\n            let (number, _) = after_hash.split_once(char::is_whitespace).ok_or(3)?;\n            if number.is_empty() || !number.bytes().all(|c| c.is_ascii_digit()) {\n                return Err(3);\n            }\n            let (_, after_in) = trimmed.split_once(\" in \").ok_or(3)?;\n            let sym = after_in.split_whitespace().next().unwrap_or(\"\");\n            if sym.is_empty() {\n                return Err(3);\n            }\n            if !sanitizer_name(sym) {\n                frames.push(fold_hex(sym));\n            }\n        }\n        if trimmed.starts_with(\"SUMMARY: AddressSanitizer\") {\n            summary = true;\n        }\n    }\n    if !summary || frame_lines == 0 || frames.is_empty() {\n        return Err(3);\n    }\n    Ok((kind.ok_or(3)?, frames))\n}\nEOF\ncat > /app/qanbox/tally.rs <<'EOF'\n#[path = \"../treyfun/clip.rs\"]\nmod clip;\n\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<String>,\n    pub body: String,\n}\n\npub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\n    let paths = crate::walk::gather(a)?;\n    let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\n    for path in paths {\n        l"]
[84.918008, "i", "et text = std::fs::read_to_string(path).map_err(|_| 3)?;\n        let (kind, frames) = clip::take(&text)?;\n        let body = frames.join(\" | \");\n        if let Some(old) = bag.get(&frames) {\n            if old.kind != kind || old.body != body {\n                return Err(3);\n            }\n        } else {\n            bag.insert(frames.clone(), Rec { issue: 0, kind, frames, body });\n        }\n    }\n    let mut recs: Vec<Rec> = bag.into_values().collect();\n    for (i, rec) in recs.iter_mut().enumerate() {\n        rec.issue = i as i32 + 1;\n    }\n    Ok(recs)\n}\nEOF\n"]
