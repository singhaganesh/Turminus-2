[127.56837, "i", "python3 - <<'PY'\nimport json, csv\nwith open('/app/inkbay/bound.json') as f:\n    rows=json.load(f)['findings']\nwith open('/app/inkbay/desk.tsv', newline='') as f:\n    desk=list(csv.DictReader(f, delimiter='\\t'))\nassert [r['issue'] for r in rows] == list(range(1,len(rows)+1))\na={str(r['issue']):(r['kind'],r['body']) for r in rows}\nb={r['issue']:(r['kind'],r['body']) for r in desk}\nassert a == b\nassert all(not f.startswith(('__asan','__interceptor','__hwasan')) for r in rows for f in r['frames'])\nprint('records_valid=yes count=%d' % len(rows))\nPY\nprintf 'magic='; od -An -tx1 -N4 /app/bin/loomketch\nprintf 'GUARD='; cat /app/inkbay/GUARD; echo\nsha256sum /app/inkbay/bound.json /app/inkbay/desk.tsv\n"]
[127.56867, "o", "python3 - <<'PY'\r\n"]
[127.568955, "o", "\u001b[?2004l\r\u001b[?2004h> import json, csv\r\n\u001b[?2004l\r\u001b[?2004h"]
[127.569779, "o", "> with open('/app/inkbay/bound.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     rows=json.load(f)['findings']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[127.570455, "o", "with open('/app/inkbay/desk.tsv', newline='') as f:\r\n\u001b[?2004l\r"]
[127.574918, "o", "\u001b[?2004h>     desk=list(csv.DictReader(f, delimiter='\\t'))\r\n\u001b[?2004l\r\u001b[?2004h> assert [r['issue'] for r in rows] == list(range(1,len(rows)+1))\r\n\u001b[?2004l\r\u001b[?2004h> a={str(r['issue']):(r['kind'],r['body']) for r in rows}\r\n\u001b[?2004l\r\u001b[?2004h> b={r['issue']:(r['kind'],r['body']) for r in desk}\r\n\u001b[?2004l\r\u001b[?2004h> assert a == b\r\n\u001b[?2004l\r\u001b[?2004h> assert all(not f.startswith(('__asan','__interceptor','__hwasan')) for r in rows for f in r['frames'])\r\n\u001b[?2004l\r\u001b[?2004h> print('records_valid=yes count=%d' % len(rows))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[127.621175, "o", "records_valid=yes count=4\r\n"]
