[13.016445, "o", "printf '\\n--- build/source hints ---\\n'; find /app -maxdepth 3 -type f \\( -name 'Makefile' -o -name 'CMakeLists.txt' -o -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.rs' -o -name '*.go' -o -name '*.py' \\) -print | sort\r\n\u001b[?2004l\r"]
