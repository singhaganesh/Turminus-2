sh(ch);\n            i += ch.len_utf8();\n        }\n    }\n    out\n}\n\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() {\n        return Err(3);\n    }\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut frame_lines = 0usize;\n    let mut summary = false;\n    for line in text.lines() {\n        if line.contains("ERROR:") {\n            if kind.is_some() {\n                return Err(3);\n            }\n            let rest = line.split_once("ERROR:").unwrap().1.trim();\n            let after = rest.strip_prefix("AddressSanitizer:").unwrap_or(rest).trim();\n            let value = after.split(" on ").next().unwrap_or("").trim();\n            if value.is_empty() {\n                return Err(3);\n            }\n            kind = Some(value.to_string());\n        }\n        let trimmed = line.trim_start();\n        if trimmed.starts_with(\'#\') {\n            frame_lines += 1;\n            let after_hash = &trimmed[1..];\n            let (number, _) = after_hash.split_once(char::is_whitespace).ok_or(3)?;\n            if number.is_empty() || !number.bytes().all(|c| c.is_ascii_digit()) {\n                return Err(3);\n            }\n            let (_, after_in) = trimmed.split_once(" in ").ok_or(3)?;\n            let sym = after_in.split_whitespace().next().unwrap_or("");\n            if sym.is_empty() {\n                return Err(3);\n            }\n            if !sanitizer_name(sym) {\n                frames.push(fold_hex(sym));\n            }\n        }\n        if trimmed.starts_with("SUMMARY: AddressSanitizer") {\n            summary = true;\n        }\n    }\n    if !summary || frame_lines == 0 || frames.is_empty() {\n        return Err(3);\n    }\n    Ok((kind.ok_or(3)?, frames))\n}\nEOF\ncat > /app/qanbox/tally.rs <<\'EOF\'\n#[path = "../treyfun/clip.rs"]\nmod clip;\n\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<String>,\n    pub body: String,\n}\n\npub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\n    let paths = crate::walk::gather(a)?;\n    let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\n    for path in paths {\n        let text = std::fs::read_to_string(path).map_err(|_| 3)?;\n        let (kind, frames) = clip::take(&text)?;\n        let body = frames.join(" | ");\n        if let Some(old) = bag.get(&frames) {\n            if old.kind != kind || old.body != body {\n                return Err(3);\n            }\n        } else {\n            bag.insert(frames.clone(), Rec { issue: 0, kind, frames, body });\n        }\n    }\n    let mut recs: Vec<Rec> = bag.into_values().collect();\n    for (i, rec) in recs.iter_mut().enumerate() {\n        rec.issue = i as i32 + 1;\n    }\n    Ok(recs)\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
