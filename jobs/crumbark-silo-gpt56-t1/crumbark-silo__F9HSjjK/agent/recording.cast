[104.230101, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/hitchbay/StowRun.java')\ns=p.read_text()\ns=s.replace('            String tail = hx.substring(32, 64);','            String tail = hx.substring(0, 32);')\np.write_text(s)\nPY\ncat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class YankRun {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1 || !args[0].matches(\"[0-9a-f]{32}\")) System.exit(2);\n        byte[] got = MistSpan.tint_k(Paths.get(\"/app/silo\"), hex(args[0]));\n        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\n        if (got.length == 0) System.exit(1);\n        System.out.write(got);\n    }\n\n    static byte[] hex(String s) {\n        byte[] out = new byte[16];\n        for (int i = 0; i < 16; i++)\n            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        return out;\n    }\n}\nEOF\n/app/bin/crumbark tamp\n"]
[104.231699, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p=Path('/app/hitchbay/StowRun.java')\r\n\u001b[?2004l\r\u001b[?2004h> s=p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('            String tail = hx.substring(32, 64);','            String tail = hx.substring(0, 32);')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
