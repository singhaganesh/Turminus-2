[104.029682, "i", "cat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.Arrays;\n\npublic class MistSpan {\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        byte[] pins = Files.exists(silo.resolve(\"pin.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"pin.bin\")) : new byte[0];\n        byte[] blob = Files.exists(silo.resolve(\"blob.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"blob.bin\")) : new byte[0];\n        for (int pos = 0; pos + 48 <= pins.length; pos += 48) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, 48);\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            if (!Arrays.equals(id, wanted)) continue;\n            if (!Arrays.equals(magic, new byte[] {'P','N','0','1'})) continue;\n            if (off < 0 || len < 0 || off > blob.length - 4L) continue;\n            int at = (int) off;\n            if (ByteBuffer.wrap(blob, at, 4).getInt() != len) continue;\n            long bodyEnd = off + 4L + len;\n            if (bodyEnd > blob.length) continue;\n            byte[] body = Arrays.copyOfRange(blob, at + 4, at + 4 + len);\n            if (Crc.of(body) != crc) continue;\n            byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(body);\n            if (!Arrays.equals(id, Arrays.copyOf(digest, 16))) continue;\n            return body;\n        }\n        return new byte[0];\n    }\n}\nEOF\ncat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\npublic class HueWalk {\n    private static final byte[] MAGIC = {'P','N','0','1'};\n\n    public static int orb_n(Path blobPath, Path pinPath, Path wakePath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean gap = pins.length % 48 != 0;\n\n        for (int pos = 0; pos + 48 <= pins.length; pos += 48) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, 48);\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            boolean ok = Arrays.equals(magic, MAGIC) && off >= 0 && len >= 0\n                    && off <= blob.length - 4L;\n            byte[] body = null;\n            if (ok) {\n                int at = (int) off;\n                ok = ByteBuffer.wrap(blob, at, 4).getInt() == len\n                        && off + 4L + len <= blob.length;\n                if (ok) body = Arrays.copyOfRange(blob, at + 4, at + 4 + len);\n            }\n            if (ok) ok = Crc.of(body) == crc;\n            if (ok) {\n                byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(body);\n                ok = Arrays.equals(id, Arrays.copyOf(digest, 16));\n            }\n            if (ok) held.add(hex(id)); else gap = true;\n        }\n\n        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\"\n                + (gap ? \"gap\" : \"ok\") + \"\\\",\\\"kind\\\":\\\"\"\n                + (gap ? \"void\" : \"live\") + \"\\\"}\";\n        Files.writeString(wakePath, json);\n        return gap ? 1 : 0;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 0xff));\n        return sb.toString();\n    }\n\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < held.size(); i++) {\n            if (i > 0) sb.append(',');\n            sb.append('\\\"').append(held.get(i)).append("]
[104.029771, "i", "'\\\"');\n        }\n        return sb.append(']').toString();\n    }\n}\nEOF\n"]
