[43.359487, "o", "     1\timport java.util.zip.CRC32;\r\n     2\t\r\n     3\tpublic class ZipHint {\r\n     4\t    public static int of(byte[] a) {\r\n     5\t        CRC32 c = new CRC32();\r\n     6\t        c.update(a);\r\n     7\t        return (int) c.getValue();\r\n     8\t    }\r\n     9\t\r\n    10\t    public static void main(String[] args) throws Exception {\r\n    11\t        byte[] a = System.in.readAllBytes();\r\n    12\t        System.out.print(Integer.toUnsignedString(of(a)));\r\n    13\t    }\r\n    14\t}\r\n===== /app/recipit/ForceSeq.java =====\r\n"]
