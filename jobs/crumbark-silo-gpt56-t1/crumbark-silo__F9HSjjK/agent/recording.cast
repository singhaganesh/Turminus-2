[26.247501, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\timport java.util.ArrayList;\r\n     5\timport java.util.Comparator;\r\n     6\timport java.util.List;\r\n     7\t\r\n     8\tpublic class LoomCue {\r\n     9\t    static final class Step {\r\n"]
[26.247725, "o", "    10\t        String name;\r\n    11\t        int compute;\r\n    12\t        int durable;\r\n    13\t    }\r\n    14\t\r\n    15\t    public static List<String> rib_q(Path a) throws Exception {\r\n    16\t        List<Step> steps = new ArrayList<Step>();\r\n    17\t        for (String line : Files.readAllLines(a)) {\r\n    18\t            String s = line.trim();\r\n    19\t            if (s.isEmpty() || s.startsWith(\"#\")) {\r\n    20\t                continue;\r\n    21\t            }\r\n    22\t            String[] p = s.split(\"\\\\s+\");\r\n    23\t            if (p.length < 3) {\r\n    24\t                continue;\r\n    25\t            }\r\n    26\t            Step st = new Step();\r\n    27\t            st.name = p[0];\r\n    28\t            st.compute = Integer.parseInt(p[1]);\r\n    29\t            st.durable = Integer.parseInt(p[2]);\r\n    30\t            steps.add(st);\r\n    31\t        }\r\n    32\t        steps.sort(Comparator.comparingInt(x -> x.compute));\r\n"]
[26.247795, "o", "    33\t        List<String> names = new ArrayList<String>();\r\n    34\t        for (Step st : steps) {\r\n    35\t            names.add(st.name);\r\n    36\t        }\r\n    37\t        return names;\r\n    38\t    }\r\n    39\t\r\n    40\t    public static void main(String[] args) throws Exception {\r\n    41\t        Path recipe = Paths.get(\"/app/recipit/steps.loom\");\r\n    42\t        List<String> names = rib_q(recipe);\r\n    43\t        StringBuilder sb = new StringBuilder();\r\n    44\t        sb.append(\"public class ForceSeq {\\n\");\r\n    45\t        sb.append(\"    public static String[] names() {\\n\");\r\n    46\t        sb.append(\"        return new String[] {\");\r\n    47\t        for (int i = 0; i < names.size(); i++) {\r\n    48\t            if (i > 0) {\r\n    49\t                sb.append(\", \");\r\n    50\t            }\r\n    51\t            sb.append(\"\\\"\");\r\n    52\t            sb.append(names.get(i));\r\n    53\t            sb.append(\"\\\"\");\r\n    54\t        }\r\n    55\t        sb.append(\"};\\n\");\r\n    56\t        sb.append(\"    }\\n\");\r\n    57\t        sb.append(\"}\\n\");\r\n    58\t        Files.writeString(Paths.get(\"/app/recipit/ForceSeq.java\"), sb.toString());\r\n    59\t    }\r\n    60\t}\r\n"]
[26.248304, "o", "===== /app/markwell/HueWalk.java =====\r\n"]
[26.250456, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.util.ArrayList;\r\n     5\timport java.util.List;\r\n     6\t\r\n     7\tpublic class HueWalk {\r\n     8\t    public static int orb_n(Path a, Path b, Path c) throws Exception {\r\n     9\t        byte[] pins = Files.exists(b) ? Files.readAllBytes(b) : new byte[0];\r\n    10\t        List<String> held = new ArrayList<String>();\r\n    11\t        int i = 0;\r\n    12\t        while (i + 48 <= pins.length) {\r\n    13\t            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\r\n    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            int crc = bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            held.add(hex(id));\r\n    22\t            i += 48;\r\n    23\t        }\r\n    24\t        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"ok\\\",\\\"kind\\\":\\\"live\\\"}\";\r\n    25\t        Files.writeString(c, json);\r\n    26\t        return 0;\r\n    27\t    }\r\n    28\t\r\n    29\t    static String hex(byte[] id) {\r\n    30\t        StringBuilder sb = new StringBuilder();\r\n    31\t        for (byte v : id) {\r\n    32\t            sb.append(String.format(\"%02x\", v & 0xff));\r\n    33\t        }\r\n    34\t        return sb.toString();\r\n    35\t    }\r\n    36\t\r\n    37\t    static String arr(List<String> held) {\r\n    38\t        StringBuilder sb = new StringBuilder(\"[\");\r\n    39\t        for (int i = 0; i < held.size(); i++) {\r\n    40\t            if (i > 0) {\r\n    41\t                sb.append(\",\");\r\n    42\t            }\r\n    43\t            sb.append(\"\\\"\");\r\n    44\t            sb.append(held.get(i));\r\n    45\t            sb.append(\"\\\"\");\r\n    46\t        }\r\n    47\t        sb.append(\"]\");\r\n    48\t        return sb.toString();\r\n    49\t    }\r\n    50\t\r\n    51\t    public static void main(String[] args) throws Exception {\r\n    52\t        Path silo = Path.of(\"/app/silo\");\r\n    53\t        int rc = orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\"));\r\n    54\t        System.exit(rc);\r\n    55\t    }\r\n    56\t}\r\n===== /app/siltpage/MistSpan.java =====\r\n"]
[26.256593, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\t\r\n     5\tpublic class MistSpan {\r\n     6\t    static final int ALIGN = 32;\r\n     7\t\r\n     8\t    public static byte[] tint_k(Path a, byte[] b) throws Exception {\r\n     9\t        byte[] pins = Files.exists(a.resolve(\"pin.bin\")) ? Files.readAllBytes(a.resolve(\"pin.bin\")) : new byte[0];\r\n    10\t        byte[] blob = Files.exists(a.resolve(\"blob.bin\")) ? Files.readAllBytes(a.resolve(\"blob.bin\")) : new byte[0];\r\n    11\t        int i = 0;\r\n    12\t        while (i + 48 <= pins.length) {\r\n    13\t            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\r\n    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            if (same(id, b)) {\r\n    22\t                int rec = 4 + len;\r\n    23\t                int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n    24\t                int take = rec + pad;\r\n    25\t                if (blob.length < off + take) {\r\n    26\t                    byte[] z = new byte[take];\r\n    27\t                    int have = Math.max(0, blob.length - (int) off);\r\n    28\t                    if (have > 0) {\r\n    29\t                        System.arraycopy(blob, (int) off, z, 0, Math.min(have, take));\r\n    30\t                    }\r\n    31\t                    return z;\r\n    32\t                }\r\n    33\t                byte[] out = new byte[take];\r\n    34\t                System.arraycopy(blob, (int) off, out, 0, take);\r\n    35\t                return out;\r\n    36\t            }\r\n    37\t            i += 48;\r\n    38\t        }\r\n    39\t        return new byte[0];\r\n    40\t    }\r\n    41\t\r\n    42\t    static boolean same(byte[] x, byte[] y) {\r\n    43\t        if (x.length != y.length) {\r\n    44\t            return false;\r\n    45\t        }\r\n    46\t        for (int i = 0; i < x.length; i++) {\r\n"]
[26.256914, "o", "    47\t            if (x[i] != y[i]) {\r\n    48\t                return false;\r\n    49\t            }\r\n    50\t        }\r\n    51\t        return true;\r\n    52\t    }\r\n    53\t}\r\n"]
