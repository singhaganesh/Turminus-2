[44.102469, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport struct,zlib,hashlib\np=Path('/app/silo/pin.bin').read_bytes(); b=Path('/app/silo/blob.bin').read_bytes()\nprint('pin bytes',len(p),'blob bytes',len(b))\nfor i in range(0,len(p)//48*48,48):\n r=p[i:i+48]\n magic,off,n,crc,ident=struct.unpack('>4sQII16s',r[:36])\n end=off+((4+n+31)//32)*32\n print(i//48, 'magic=',magic,'off=',off,'len=',n,'crc=%08x'%crc,'id='+ident.hex(),'record_end=',end,'durable_len=',end<=len(b))\n if off+4+n<=len(b):\n  body=b[off+4:off+4+n]\n  print(' prefix=',b[off:off+4], 'body_crc=%08x'%(zlib.crc32(body)&0xffffffff), 'body_id='+hashlib.sha256(body).digest()[:16].hex(), 'body=',repr(body))\nPY\n"]
