[26.212339, "o", "     1\timport java.util.zip.CRC32;\r\n     2\t\r\n     3\tpublic class Crc {\r\n     4\t    public static int of(byte[] a) {\r\n     5\t        CRC32 c = new CRC32();\r\n     6\t        c.update(a);\r\n     7\t        int n = a.length;\r\n     8\t        return (int) c.getValue() ^ n;\r\n     9\t    }\r\n    10\t}\r\n"]
[26.212605, "o", "===== /app/hitchbay/CutRun.java =====\r\n"]
[26.21545, "o", "     1\timport java.nio.file.Paths;\r\n     2\t\r\n     3\tpublic class CutRun {\r\n     4\t    public static void main(String[] args) throws Exception {\r\n     5\t        if (args.length < 1) {\r\n     6\t            System.exit(2);\r\n     7\t        }\r\n     8\t        try {\r\n     9\t            StowRun.run(Paths.get(args[0]), true);\r\n    10\t        } catch (StowRun.CutErr e) {\r\n    11\t            System.exit(0);\r\n    12\t        }\r\n    13\t    }\r\n    14\t}\r\n"]
