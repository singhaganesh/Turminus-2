[26.207623, "i", "for f in /app/hitchbay/*.java /app/recipit/*.java /app/markwell/*.java /app/siltpage/*.java /app/retrycue/*.java; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
