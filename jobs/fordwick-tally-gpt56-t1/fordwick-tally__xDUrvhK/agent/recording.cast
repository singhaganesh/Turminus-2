[285.238549, "i", "python3 - <<'PY'\np='/app/tether.py'; s=open(p).read()\nneedle='''        # During a merge only one track receives the connected component.\n        # Unmatched tracks remain alive on their established trajectory and can\n        # reconnect after a split.  Do not count from extrapolation alone: a\n        # real observation below the row is required to complete the passage.\n        for di, d in enumerate(detections):\n'''\nreplacement='''        # A component may represent several established tracks during overlap,\n        # including complete shading.  An unmatched track may complete only if\n        # its predicted centroid remains supported by a real nearby silhouette;\n        # bare extrapolation (a body simply vanishing) is never sufficient.\n        for ti, t in enumerate(active):\n            if ti in used_t or t[\"hits\"] < 3 or t[\"counted\"] or not t[\"above\"]:\n                continue\n            gap = fi - t[\"last\"]\n            px = t[\"x\"] + t[\"vx\"] * gap\n            py = t[\"y\"] + t[\"vy\"] * gap\n            supported = any(np.hypot(d[\"x\"] - px, d[\"y\"] - py) <= 16.0 + gap for d in detections)\n            if supported and py > LINE_Y + 2 and t[\"vy\"] > 0.5:\n                t[\"counted\"] = True\n                total += 1\n        for di, d in enumerate(detections):\n'''\nif needle not in s: raise SystemExit('insertion target missing')\nopen(p,'w').write(s.replace(needle,replacement))\nPY\n/app/kiln/bake.sh\npython3 -m py_compile /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py\nfail=0; for spec in down1:1 up0:0 retreat0:0 two2:2 overlap2:2 shade1:1 vanish0:0; do name=${spec%:*}; want=${spec#*:}; python3 /app/varnish/mill.pyc /tmp/vtests/$name.mp4; got=$(awk '/crossings/{print $3}' /app/inkwell/sheet.toml); echo \"$name want=$want got=$got\"; test \"$got\" = \"$want\" || fail=1; done; python3 /app/varnish/mill.pyc /app/shown.mp4; got=$(awk '/crossings/{print $3}' /app/inkwell/sheet.toml); echo \"shown want=3 got=$got\"; test \"$got\" = 3 || fail=1; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4 >/tmp/bad.out 2>&1; rc=$?; echo \"unreadable rc=$rc sheet=$(test -e /app/inkwell/sheet.toml && echo present || echo absent)\"; test \"$rc\" -ne 0 && test ! -e /app/inkwell/sheet.toml || fail=1; echo \"selftest_fail=$fail\"; exit $fail\n"]
