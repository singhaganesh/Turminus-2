[285.373721, "o", "fail=0; for spec in down1:1 up0:0 retreat0:0 two2:2 overlap2:2 shade1:1 vanish0:0; do name=${spec%:*}; want=${spec#*:}; python3 /app/varnish/mill.pyc /tmp/vtests/$name.mp4; got=$(awk '/crossings/{print $3}' /app/inkwell/sheet.toml); echo \"$name want=$want got=$got\"; test \"$got\" = \"$want\" || fail=1; done; python3 /app/varnish/mill.pyc /app/shown.mp4; got=$(awk '/crossings/{print $3}' /app/inkwell/sheet.toml); echo \"shown want=3 got=$got\"; test \"$got\" = 3 || fail=1; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4 >/tmp/bad.out 2>&1; rc=$?; echo \"unreadable rc=$rc sheet=$(test -e /app/inkwell/sheet.toml && echo present || echo absent)\"; test \"$rc\" -ne 0 && test ! -e /app/inkwell/sheet.toml || fail=1; echo \"selftest_fail=$fail\"; exit $fail\r\n\u001b[?2004l\r"]
