[165.779356, "o", "            for di, d in enumerate(detections):\r\n\u001b[?2004l\r"]
[165.779422, "o", "\u001b[?2004h> "]
[165.779622, "o", "                dist = float(np.hypot(d[\"x\"] - px, d[\"y\"] - py))\r\n\u001b[?2004l\r"]
[165.779689, "o", "\u001b[?2004h> "]
[165.779904, "o", "                colour = float(np.linalg.norm(d[\"colour\"] - t[\"colour\"]))\r\n\u001b[?2004l\r"]
[165.779962, "o", "\u001b[?2004h> "]
[165.780158, "o", "                # Position dominates; colour only breaks ambiguous encounters.\r\n\u001b[?2004l\r"]
[165.780221, "o", "\u001b[?2004h> "]
[165.780325, "o", "                limit = 14.0 + 3.5 * gap\r\n\u001b[?2004l\r"]
[165.780396, "o", "\u001b[?2004h> "]
[165.780468, "o", "                if dist <= limit:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.780655, "o", "                    pairs.append((dist + min(colour, 120.0) * 0.035, ti, di))\r\n\u001b[?2004l\r"]
[165.780734, "o", "\u001b[?2004h"]
[165.780788, "o", "> "]
[165.780844, "o", "        used_t, used_d = set(), set()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.780906, "o", "        for _, ti, di in sorted(pairs):\r\n\u001b[?2004l\r"]
[165.780976, "o", "\u001b[?2004h"]
[165.780993, "o", "> "]
[165.781157, "o", "            if ti in used_t or di in used_d:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.781225, "o", "                continue\r\n\u001b[?2004l\r"]
[165.781289, "o", "\u001b[?2004h> "]
[165.781382, "o", "            t, d = active[ti], detections[di]\r\n\u001b[?2004l\r"]
[165.781436, "o", "\u001b[?2004h> "]
[165.781528, "o", "            gap = max(1, fi - t[\"last\"])\r\n\u001b[?2004l\r"]
[165.781548, "o", "\u001b[?2004h"]
[165.781562, "o", "> "]
[165.781675, "o", "            nvx = (d[\"x\"] - t[\"x\"]) / gap\r\n\u001b[?2004l\r"]
[165.781735, "o", "\u001b[?2004h"]
[165.781793, "o", "> "]
[165.781855, "o", "            nvy = (d[\"y\"] - t[\"y\"]) / gap\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.782107, "o", "            # Smooth velocity, but react quickly to the regular synthetic motion.\r\n\u001b[?2004l\r"]
[165.782175, "o", "\u001b[?2004h> "]
[165.782243, "o", "            if t[\"hits\"] < 2:\r\n\u001b[?2004l\r"]
[165.782293, "o", "\u001b[?2004h"]
[165.782348, "o", "> "]
[165.782404, "o", "                t[\"vx\"], t[\"vy\"] = nvx, nvy\r\n\u001b[?2004l\r"]
[165.782457, "o", "\u001b[?2004h> "]
[165.782512, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.78263, "o", "                t[\"vx\"] = .45 * t[\"vx\"] + .55 * nvx\r\n\u001b[?2004l\r"]
[165.782677, "o", "\u001b[?2004h> "]
[165.782787, "o", "                t[\"vy\"] = .45 * t[\"vy\"] + .55 * nvy\r\n\u001b[?2004l\r"]
[165.782834, "o", "\u001b[?2004h> "]
[165.782959, "o", "            t[\"x\"], t[\"y\"], t[\"last\"] = d[\"x\"], d[\"y\"], fi\r\n\u001b[?2004l\r"]
[165.783004, "o", "\u001b[?2004h"]
[165.783065, "o", "> "]
[165.783122, "o", "            t[\"hits\"] += 1\r\n\u001b[?2004l\r"]
[165.783177, "o", "\u001b[?2004h> "]
[165.783306, "o", "            t[\"colour\"] = .75 * t[\"colour\"] + .25 * d[\"colour\"]\r\n\u001b[?2004l\r"]
[165.783362, "o", "\u001b[?2004h> "]
[165.783473, "o", "            t[\"area\"] = .75 * t[\"area\"] + .25 * d[\"area\"]\r\n\u001b[?2004l\r"]
[165.783522, "o", "\u001b[?2004h> "]
[165.7836, "o", "            if d[\"y\"] < LINE_Y - 2:\r\n\u001b[?2004l\r"]
[165.783649, "o", "\u001b[?2004h"]
[165.783705, "o", "> "]
[165.78376, "o", "                t[\"above\"] = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.783952, "o", "            if t[\"above\"] and not t[\"counted\"] and d[\"y\"] > LINE_Y + 2 and t[\"vy\"] > 0:\r\n\u001b[?2004l\r"]
[165.784005, "o", "\u001b[?2004h"]
[165.784065, "o", "> "]
[165.784125, "o", "                t[\"counted\"] = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.784202, "o", "                total += 1\r\n\u001b[?2004l\r"]
[165.784252, "o", "\u001b[?2004h> "]
[165.784348, "o", "            used_t.add(ti); used_d.add(di)\r\n\u001b[?2004l\r"]
[165.7844, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.784452, "o", "\u001b[?2004h> "]
[165.784598, "o", "        # During a merge only one track receives the connected component. Keep\r\n\u001b[?2004l\r"]
[165.784645, "o", "\u001b[?2004h> "]
[165.784826, "o", "        # the others alive on their established trajectory; a later split then\r\n\u001b[?2004l\r"]
[165.784895, "o", "\u001b[?2004h> "]
[165.785069, "o", "        # reconnects naturally. Count an inferred hidden passage only for a\r\n\u001b[?2004l\r"]
[165.785136, "o", "\u001b[?2004h> "]
[165.785214, "o", "        # well-established downward track.\r\n\u001b[?2004l\r"]
[165.785267, "o", "\u001b[?2004h> "]
[165.785348, "o", "        for ti, t in enumerate(active):\r\n\u001b[?2004l\r"]
[165.785399, "o", "\u001b[?2004h> "]
[165.785488, "o", "            if ti in used_t or t[\"hits\"] < 3:\r\n\u001b[?2004l\r"]
[165.785538, "o", "\u001b[?2004h> "]
[165.785598, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.785674, "o", "> "]
[165.785748, "o", "            gap = fi - t[\"last\"]\r\n\u001b[?2004l\r"]
[165.785808, "o", "\u001b[?2004h> "]
[165.785905, "o", "            py = t[\"y\"] + t[\"vy\"] * gap\r\n\u001b[?2004l\r"]
[165.785972, "o", "\u001b[?2004h> "]
[165.786212, "o", "            if t[\"above\"] and not t[\"counted\"] and t[\"vy\"] > 0.5 and py > LINE_Y + 2:\r\n\u001b[?2004l\r"]
[165.786295, "o", "\u001b[?2004h"]
[165.786357, "o", "> "]
[165.78645, "o", "                t[\"counted\"] = True\r\n\u001b[?2004l\r"]
[165.786535, "o", "\u001b[?2004h>                 total += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.786692, "o", "        for di, d in enumerate(detections):\r\n\u001b[?2004l\r"]
[165.78683, "o", "\u001b[?2004h> "]
[165.78687, "o", "            if di not in used_d:\r\n\u001b[?2004l\r"]
[165.787959, "o", "\u001b[?2004h> "]
[165.788158, "o", "                tracks.append(_new_track(d, fi, next_id)); next_id += 1\r\n\u001b[?2004l\r\u001b[?2004h>     return total\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fold_gate(n):\r\n\u001b[?2004l\r\u001b[?2004h>     return int(n)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[165.790144, "o", "\u001b[?2004hroot@2147f0244af3:/app# "]
[165.790279, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
[165.790347, "o", "\u001b[?2004h> "]
[165.790411, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[165.790467, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[165.790513, "o", "> "]
[165.790592, "o", "import os\r\n\u001b[?2004l\r"]
[165.790652, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r"]
[165.790709, "o", "\u001b[?2004h> import cv2\r\n\u001b[?2004l\r"]
[165.790766, "o", "\u001b[?2004h> "]
[165.790817, "o", "import toml\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.790875, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.79097, "o", "from blot import blobs, estimate_background\r\n\u001b[?2004l\r"]
[165.791065, "o", "\u001b[?2004h> "]
[165.791141, "o", "from tether import count_tracks, fold_gate\r\n\u001b[?2004l\r"]
[165.791305, "o", "\u001b[?2004h"]
[165.791378, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.791456, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.791545, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r"]
[165.791609, "o", "\u001b[?2004h> "]
[165.791675, "o", "    cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r"]
[165.791756, "o", "\u001b[?2004h> "]
[165.791827, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.791904, "o", ">         cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.792015, "o", "        raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[165.792108, "o", "\u001b[?2004h> "]
[165.792196, "o", "    frames = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.792226, "o", "    while True:\r\n\u001b[?2004l\r"]
[165.792237, "o", "\u001b[?2004h> "]
[165.792356, "o", "        ok, frame = cap.read()\r\n\u001b[?2004l\r"]
[165.792395, "o", "\u001b[?2004h"]
[165.792413, "o", "> "]
[165.792496, "o", "        if not ok:\r\n\u001b[?2004l\r"]
[165.792509, "o", "\u001b[?2004h"]
[165.792521, "o", "> "]
[165.792607, "o", "            break\r\n\u001b[?2004l\r"]
[165.792634, "o", "\u001b[?2004h> "]
[165.792872, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.792994, "o", "            cap.release()\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.793058, "o", "> "]
[165.793245, "o", "            raise ValueError('invalid frame')\r\n\u001b[?2004l\r"]
[165.793376, "o", "\u001b[?2004h> "]
[165.79342, "o", "        frames.append(frame)\r\n\u001b[?2004l\r"]
[165.793558, "o", "\u001b[?2004h"]
[165.793628, "o", ">     cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.793658, "o", "    if not frames:\r\n\u001b[?2004l\r"]
[165.793774, "o", "\u001b[?2004h"]
[165.793855, "o", "> "]
[165.793884, "o", "        raise OSError('clip contains no decodable frames')\r\n\u001b[?2004l\r"]
[165.793913, "o", "\u001b[?2004h"]
[165.793932, "o", "> "]
[165.79419, "o", "    bg = estimate_background(frames)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.79429, "o", "    detections = [blobs(frame, bg) for frame in frames]\r\n\u001b[?2004l\r"]
[165.794382, "o", "\u001b[?2004h> "]
[165.794447, "o", "    return fold_gate(count_tracks(detections))\r\n\u001b[?2004l\r"]
[165.794565, "o", "\u001b[?2004h> "]
[165.794641, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.794703, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r"]
[165.794759, "o", "\u001b[?2004h> "]
[165.794872, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[165.794926, "o", "\u001b[?2004h"]
[165.794977, "o", "> "]
[165.795038, "o", "    temporary = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r"]
[165.795097, "o", "\u001b[?2004h> "]
[165.795265, "o", "    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r"]
[165.795322, "o", "\u001b[?2004h"]
[165.795373, "o", "> "]
[165.795427, "o", "    os.replace(temporary, SHEET)\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.795482, "o", "> "]
[165.795522, "o", "PY\r\n\u001b[?2004l\r"]
[165.796612, "o", "\u001b[?2004hroot@2147f0244af3:/app# "]
[165.796699, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[165.796754, "o", "\u001b[?2004h> "]
[165.796807, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[165.796857, "o", "\u001b[?2004h> "]
[165.796962, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[165.797003, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.797072, "o", "\u001b[?2004h> "]
[165.797125, "o", "import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.79722, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[165.797271, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.797311, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.797383, "o", "def main() -> int:\r\n\u001b[?2004l\r"]
[165.797479, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[165.797543, "o", "\u001b[?2004h> "]
[165.797606, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[165.797666, "o", "\u001b[?2004h> "]
[165.797736, "o", "        if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.797797, "o", "            return 2\r\n\u001b[?2004l\r"]
[165.797855, "o", "\u001b[?2004h> "]
[165.797963, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[165.798023, "o", "\u001b[?2004h> "]
[165.798089, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r"]
[165.798145, "o", "\u001b[?2004h> "]
[165.7982, "o", "        return 0\r\n\u001b[?2004l\r"]
[165.798256, "o", "\u001b[?2004h> "]
[165.798327, "o", "    except Exception as exc:\r\n\u001b[?2004l\r"]
[165.798384, "o", "\u001b[?2004h> "]
[165.798486, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[165.798537, "o", "\u001b[?2004h"]
[165.798587, "o", "> "]
[165.79866, "o", "        print('mill:', exc, file=sys.stderr)\r\n\u001b[?2004l\r"]
[165.798726, "o", "\u001b[?2004h> "]
[165.79878, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.798841, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.798909, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.798975, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[165.799037, "o", "\u001b[?2004h> "]
[165.799147, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r"]
[165.799231, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[165.80043, "o", "\u001b[?2004hroot@2147f0244af3:/app# "]
[165.800515, "o", "/app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[165.872341, "o", "\u001b[?2004hroot@2147f0244af3:/app# "]
[165.872764, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[166.350556, "o", "sample_rc=0\r\n"]
[166.351518, "o", "crossings = 3\r\n"]
[166.351751, "o", "\u001b[?2004hroot@2147f0244af3:/app# "]
[166.352257, "o", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo \"bad_rc=$rc\"; test ! -e /app/inkwell/sheet.toml && echo 'bad_sheet_absent=yes'\r\n\u001b[?2004l\r"]
[166.602864, "o", "mill: cannot open clip\r\n"]
[166.633522, "o", "bad_rc=1\r\nbad_sheet_absent=yes\r\n"]
[166.633684, "o", "\u001b[?2004hroot@2147f0244af3:/app# "]
[221.465227, "i", "python3 - <<'PY'\np='/app/tether.py'\ns=open(p).read()\nold='''        # During a merge only one track receives the connected component. Keep\n        # the others alive on their established trajectory; a later split then\n        # reconnects naturally. Count an inferred hidden passage only for a\n        # well-established downward track.\n        for ti, t in enumerate(active):\n            if ti in used_t or t[\"hits\"] < 3:\n                continue\n            gap = fi - t[\"last\"]\n            py = t[\"y\"] + t[\"vy\"] * gap\n            if t[\"above\"] and not t[\"counted\"] and t[\"vy\"] > 0.5 and py > LINE_Y + 2:\n                t[\"counted\"] = True\n                total += 1\n'''\nnew='''        # During a merge only one track receives the connected component.\n        # Unmatched tracks remain alive on their established trajectory and can\n        # reconnect after a split.  Do not count from extrapolation alone: a\n        # real observation below the row is required to complete the passage.\n'''\nif old not in s: raise SystemExit('target block not found')\nopen(p,'w').write(s.replace(old,new))\nPY\n/app/kiln/bake.sh\ncat > /tmp/make_tests.py <<'PY'\nimport cv2, numpy as np, os\nos.makedirs('/tmp/vtests',exist_ok=True)\nW,H=160,120\nbg=np.zeros((H,W,3),np.uint8)\nfor y in range(H): bg[y,:]=(40+y//8,35+y//10,35+y//10)\n\ndef write(name, paths, n=50, hide=None):\n out=cv2.VideoWriter('/tmp/vtests/'+name+'.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\n for i in range(n):\n  f=bg.copy()\n  for j,(color,fun) in enumerate(paths):\n   q=fun(i)\n   if q is None or (hide and hide(j,i)): continue\n   x,y=q\n   cv2.circle(f,(int(x),int(y)),8,color,-1,cv2.LINE_AA)\n  out.write(f)\n out.release()\n# one proper crossing\nwrite('down1',[((50,210,70),lambda i:(35,10+2.2*i))])\n# wrong direction\nwrite('up0',[((50,70,220),lambda i:(55,108-2.2*i))])\n# approaches/lingers on row then retreats upward\nwrite('retreat0',[((220,70,50),lambda i:(75, min(69,15+2*i) if i<30 else 69-2*(i-30)))])\n# two separate simultaneous crossings\nwrite('two2',[((50,210,70),lambda i:(45,8+2.3*i)),((220,70,50),lambda i:(110,15+2.0*i))])\n# two paths converge into exact overlap around scan, then split\nwrite('overlap2',[\n ((50,210,70),lambda i:(45+min(i,25)*1.2,10+2.1*i)),\n ((220,70,50),lambda i:(105-min(i,25)*1.2,10+2.1*i))])\n# established body becomes wholly hidden frames 24..31, reappears below\nwrite('shade1',[((50,70,220),lambda i:(80,8+2.3*i))],hide=lambda j,i:24<=i<=31)\n# disappears before reaching scan and never confirms below\nwrite('vanish0',[((70,210,210),lambda i:(120,8+2.2*i) if i<25 else None)])\nPY\npython3 /tmp/make_tests.py\nfor spec in down1:1 up0:0 retreat0:0 two2:2 overlap2:2 shade1:1 vanish0:0; do name=${spec%:*}; want=${spec#*:}; python3 /app/varnish/mill.pyc /tmp/vtests/$name.mp4; got=$(awk '/crossings/{print $3}' /app/inkwell/sheet.toml); echo \"$name want=$want got=$got\"; done\npython3 /app/varnish/mill.pyc /app/shown.mp4; echo -n 'shown '; cat /app/inkwell/sheet.toml\n"]
