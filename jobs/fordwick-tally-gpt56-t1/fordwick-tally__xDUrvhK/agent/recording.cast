[222.009991, "o", "\u001b[?2004hroot@2147f0244af3:/app# "]
[222.010562, "o", "for spec in down1:1 up0:0 retreat0:0 two2:2 overlap2:2 shade1:1 vanish0:0; do name=${spec%:*}; want=${spec#*:}; python3 /app/varnish/mill.pyc /tmp/vtests/$name.mp4; got=$(awk '/crossings/{print $3}' /app/inkwell/sheet.toml); echo \"$name want=$want got=$got\"; done\r\n\u001b[?2004l\r"]
[222.449873, "o", "down1 want=1 got=1\r\n"]
