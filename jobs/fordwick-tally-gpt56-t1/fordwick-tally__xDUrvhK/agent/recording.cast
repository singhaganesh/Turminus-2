[165.763816, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef estimate_background(frames):\n    \"\"\"A moving object's colour normally occupies a pixel for less than half a reel.\"\"\"\n    return np.median(np.asarray(frames), axis=0).astype(np.uint8)\n\n\ndef body_marks(frame, background):\n    # Max-channel distance works for coloured and neutral bodies.  The saturation\n    # term also preserves a coloured body if it happens to linger long enough to\n    # contaminate the temporal median.\n    delta = np.max(cv2.absdiff(frame, background), axis=2)\n    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)\n    bhsv = cv2.cvtColor(background, cv2.COLOR_BGR2HSV)\n    mask = ((delta >= 20) | ((hsv[:, :, 1].astype(np.int16) - bhsv[:, :, 1]) >= 35)).astype(np.uint8) * 255\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))\n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8))\n    return mask\n\n\ndef blobs(frame, background):\n    mask = body_marks(frame, background)\n    n, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\n    out = []\n    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)\n    for k in range(1, n):\n        x, y, w, h, area = [int(v) for v in stats[k]]\n        if area < 18 or w < 3 or h < 3:\n            continue\n        pix = hsv[:, :, :][labels == k]\n        # Median BGR is a useful, compression-resistant re-identification hint.\n        bpix = frame[labels == k]\n        colour = np.median(bpix, axis=0).astype(float) if len(bpix) else np.zeros(3)\n        out.append({\"x\": float(centers[k, 0]), \"y\": float(centers[k, 1]),\n                    \"box\": (x, y, w, h), \"area\": float(area), \"colour\": colour})\n    return out\nPY\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport numpy as np\n\nLINE_Y = 70.0\n\n\ndef _new_track(d, frame_no, ident):\n    return {\"id\": ident, \"x\": d[\"x\"], \"y\": d[\"y\"], \"vx\": 0.0, \"vy\": 0.0,\n            \"last\": frame_no, \"hits\": 1, \"above\": d[\"y\"] < LINE_Y - 2,\n            \"counted\": False, \"colour\": d[\"colour\"], \"area\": d[\"area\"]}\n\n\ndef count_tracks(all_detections):\n    tracks = []\n    next_id = 0\n    total = 0\n    for fi, detections in enumerate(all_detections):\n        active = [t for t in tracks if fi - t[\"last\"] <= 18]\n        pairs = []\n        for ti, t in enumerate(active):\n            gap = fi - t[\"last\"]\n            px = t[\"x\"] + t[\"vx\"] * gap\n            py = t[\"y\"] + t[\"vy\"] * gap\n            for di, d in enumerate(detections):\n                dist = float(np.hypot(d[\"x\"] - px, d[\"y\"] - py))\n                colour = float(np.linalg.norm(d[\"colour\"] - t[\"colour\"]))\n                # Position dominates; colour only breaks ambiguous encounters.\n                limit = 14.0 + 3.5 * gap\n                if dist <= limit:\n                    pairs.append((dist + min(colour, 120.0) * 0.035, ti, di))\n        used_t, used_d = set(), set()\n        for _, ti, di in sorted(pairs):\n            if ti in used_t or di in used_d:\n                continue\n            t, d = active[ti], detections[di]\n            gap = max(1, fi - t[\"last\"])\n            nvx = (d[\"x\"] - t[\"x\"]) / gap\n            nvy = (d[\"y\"] - t[\"y\"]) / gap\n            # Smooth velocity, but react quickly to the regular synthetic motion.\n            if t[\"hits\"] < 2:\n                t[\"vx\"], t[\"vy\"] = nvx, nvy\n            else:\n                t[\"vx\"] = .45 * t[\"vx\"] + .55 * nvx\n                t[\"vy\"] = .45 * t[\"vy\"] + .55 * nvy\n            t[\"x\"], t[\"y\"], t[\"last\"] = d[\"x\"], d[\"y\"], fi\n            t[\"hits\"] += 1\n            t[\"colour\"] = .75 * t[\"colour\"] + .25 * d[\"colour\"]\n            t[\"area\"] = .75 * t[\"area\"] + .25 * d[\"area\"]\n            if d[\"y\"] < LINE_Y - 2:\n                t[\"above\"] = True\n            if t[\"above\"] and not t[\"counted\"] and d[\"y\"] > LINE_Y + 2 and t[\"vy\"] > 0:\n                t[\"counted\"] = True\n                total += 1\n            used_t.add(ti); used_d.add(di)\n\n        # During a merge only one track receives the connected component. Keep\n        # the others alive on their established trajectory; a later sp"]
[165.763977, "i", "lit then\n        # reconnects naturally. Count an inferred hidden passage only for a\n        # well-established downward track.\n        for ti, t in enumerate(active):\n            if ti in used_t or t[\"hits\"] < 3:\n                continue\n            gap = fi - t[\"last\"]\n            py = t[\"y\"] + t[\"vy\"] * gap\n            if t[\"above\"] and not t[\"counted\"] and t[\"vy\"] > 0.5 and py > LINE_Y + 2:\n                t[\"counted\"] = True\n                total += 1\n        for di, d in enumerate(detections):\n            if di not in used_d:\n                tracks.append(_new_track(d, fi, next_id)); next_id += 1\n    return total\n\n\ndef fold_gate(n):\n    return int(n)\nPY\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import blobs, estimate_background\nfrom tether import count_tracks, fold_gate\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('invalid frame')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('clip contains no decodable frames')\n    bg = estimate_background(frames)\n    detections = [blobs(frame, bg) for frame in frames]\n    return fold_gate(count_tracks(detections))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    temporary = SHEET.with_suffix('.tmp')\n    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    os.replace(temporary, SHEET)\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    try:\n        SHEET.unlink(missing_ok=True)\n        if len(sys.argv) != 2:\n            return 2\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n        return 0\n    except Exception as exc:\n        SHEET.unlink(missing_ok=True)\n        print('mill:', exc, file=sys.stderr)\n        return 1\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo \"sample_rc=$rc\"; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo \"bad_rc=$rc\"; test ! -e /app/inkwell/sheet.toml && echo 'bad_sheet_absent=yes'\n"]
