[39.554564, "i", "python3 - <<'PY'\nimport cv2, numpy as np\nc=cv2.VideoCapture('/app/shown.mp4'); n=int(c.get(cv2.CAP_PROP_FRAME_COUNT)); ims=[]\nfor k in np.linspace(0,max(0,n-1),20).astype(int):\n c.set(cv2.CAP_PROP_POS_FRAMES,int(k)); ok,f=c.read()\n if ok:\n  cv2.putText(f,str(k),(3,12),cv2.FONT_HERSHEY_SIMPLEX,.35,(0,0,255),1,cv2.LINE_AA); ims.append(f)\nc.release()\nif ims:\n rows=[np.hstack(ims[i:i+5]) for i in range(0,len(ims),5)]\n cv2.imwrite('/tmp/contact.jpg',np.vstack(rows))\nprint('/tmp/contact.jpg', 'frames',n)\nPY\nls -lh /tmp/contact.jpg\n"]
