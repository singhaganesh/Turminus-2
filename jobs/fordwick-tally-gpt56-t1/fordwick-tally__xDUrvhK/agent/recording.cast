[37.409646, "o", "\u001b[?2004hroot@2147f0244af3:/app# "]
[37.531406, "i", "cat > /tmp/inspect.py <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; c=cv2.VideoCapture(p)\nprint('opened',c.isOpened(),'n',int(c.get(cv2.CAP_PROP_FRAME_COUNT)),'fps',c.get(cv2.CAP_PROP_FPS),'wh',int(c.get(3)),int(c.get(4)))\nfs=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n fs.append(f)\nc.release(); a=np.array(fs)\nprint('decoded',len(fs),'shape',a.shape)\n# temporal median background and per-frame changed-pixel components\nbg=np.median(a,axis=0).astype(np.uint8)\nprint('bg corners/center BGR',*[bg[y,x].tolist() for y,x in [(0,0),(0,159),(119,0),(119,159),(60,80)]])\nfor i,f in enumerate(fs):\n d=np.max(cv2.absdiff(f,bg),axis=2)\n m=(d>25).astype(np.uint8)*255\n m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n n,lab,st,cen=cv2.connectedComponentsWithStats(m)\n comps=[]\n for j in range(1,n):\n  x,y,w,h,area=st[j]\n  if area>=15: comps.append((area,x,y,w,h,round(float(cen[j,0]),1),round(float(cen[j,1]),1)))\n if comps and (i%6==0 or any(abs(q[-1]-70)<8 for q in comps)):\n  print(i,sorted(comps,reverse=True)[:8])\n# globally common quantized colors\nq=(a.reshape(-1,3)//16)*16\nu,n=np.unique(q,axis=0,return_counts=True)\nprint('colors',[(u[k].tolist(),int(n[k])) for k in np.argsort(n)[-15:][::-1]])\nPY\npython3 /tmp/inspect.py\n"]
