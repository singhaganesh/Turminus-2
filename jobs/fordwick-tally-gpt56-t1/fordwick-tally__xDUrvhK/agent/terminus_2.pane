[?2004l[?2004h> import cv2, numpy as np, os
[?2004l[?2004h> os.makedirs('/tmp/vtests',exist_ok=True)
[?2004l[?2004h> W,H=160,120
[?2004l[?2004h> bg=np.zeros((H,W,3),np.uint8)
[?2004l[?2004h> for y in range(H): bg[y,:]=(40+y//8,35+y//10,35+y//10)
[?2004l[?2004h> 
[?2004l[?2004h> def write(name, paths, n=50, hide=None):
[?2004l[?2004h>  out=cv2.VideoWriter('/tmp/vtests/'+name+'.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))
[?2004l[?2004h>  for i in range(n):
[?2004l[?2004h>   f=bg.copy()
[?2004l[?2004h>   for j,(color,fun) in enumerate(paths):
[?2004l[?2004h>    q=fun(i)
[?2004l[?2004h>    if q is None or (hide and hide(j,i)): continue
[?2004l[?2004h>    x,y=q
[?2004l[?2004h>    cv2.circle(f,(int(x),int(y)),8,color,-1,cv2.LINE_AA)
[?2004l[?2004h>   out.write(f)
[?2004l[?2004h>  out.release()
[?2004l[?2004h> # one proper crossing
[?2004l[?2004h> write('down1',[((50,210,70),lambda i:(35,10+2.2*i))])
[?2004l[?2004h> # wrong direction
[?2004l[?2004h> write('up0',[((50,70,220),lambda i:(55,108-2.2*i))])
[?2004l[?2004h> # approaches/lingers on row then retreats upward
[?2004l[?2004h> write('retreat0',[((220,70,50),lambda i:(75, min(69,15+2*i) if i<30 else 69-2*(i-30)))])
[?2004l[?2004h> # two separate simultaneous crossings
[?2004l[?2004h> write('two2',[((50,210,70),lambda i:(45,8+2.3*i)),((220,70,50),lambda i:(110,15+2.0*i))])
[?2004l[?2004h> # two paths converge into exact overlap around scan, then split
[?2004l[?2004h> write('overlap2',[
[?2004l[?2004h>  ((50,210,70),lambda i:(45+min(i,25)*1.2,10+2.1*i)),
[?2004l[?2004h>  ((220,70,50),lambda i:(105-min(i,25)*1.2,10+2.1*i))])
[?2004l[?2004h> # established body becomes wholly hidden frames 24..31, reappears below
[?2004l[?2004h> write('shade1',[((50,70,220),lambda i:(80,8+2.3*i))],hide=lambda j,i:24<=i<=31)
[?2004l[?2004h> # disappears before reaching scan and never confirms below
[?2004l[?2004h> write('vanish0',[((70,210,210),lambda i:(120,8+2.2*i) if i<25 else None)])
[?2004l[?2004h> PY
