[26.469268, "o", "    19\t\t\tif (fb)\r\n    20\t\t\t\tfclose(fb);\r\n    21\t\t\tfo = fopen(outp, \"w\");\r\n    22\t\t\tif (fo) {\r\n    23\t\t\t\tfputs(\"noisy\\n\", fo);\r\n    24\t\t\t\tfclose(fo);\r\n    25\t\t\t}\r\n    26\t\t\treturn 1;\r\n    27\t\t"]
[26.469337, "o", "}\r\n    28\t\tfseek(fa, 0, SEEK_END);\r\n    29\t\tna = ftell(fa);\r\n    30\t\tfseek(fa, 0, SEEK_SET);\r\n    31\t\tfseek(fb, 0, SEEK_END);\r\n    32\t\tnb = ftell(fb);\r\n    33\t\tfseek(fb, 0, SEEK_SET);\r\n    34\t\tif (na == nb && na >= 0) {\r\n    35\t\t\tx = malloc((size_t)na);\r\n    36\t\t\ty = malloc((size_t)nb);\r\n    37\t\t\tif (x && y && fread(x, 1, (size_t)na, fa) == (size_t)na &&\r\n    38\t\t\t    fread(y, 1, (size_t)nb, fb) == (size_t)nb)\r\n    39\t\t\t\tsame = memcmp(x, y, (size_t)na) == 0;\r\n    40\t\t}\r\n    41\t\tfree(x);\r\n    42\t\tfree(y);\r\n    43\t\tfclose(fa);\r\n    44\t\tfclose(fb);\r\n    45\t\tfo = fopen(outp, \"w\");\r\n    46\t\tif (!fo)\r\n    47\t\t\treturn 1;\r\n    48\t\tfputs(same ? \"quiet\\n\" : \"noisy\\n\", fo);\r\n    49\t\tfclose(fo);\r\n    50\t\treturn same ? 0 : 1;\r\n    51\t}\r\n"]
