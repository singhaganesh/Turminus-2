[75.738113, "i", "cat > /app/cordspin/bag.c <<'EOF'\n#include \"bag.h\"\n\n#include <stdlib.h>\n#include <string.h>\n\n#define MAX_PLACE 256\n\nstatic char names[MAX_PLACE][80];\nstatic uint32_t ids[MAX_PLACE];\nstatic uint32_t ntab;\n\nstatic int namecmp(const void *a, const void *b)\n{\n        return strcmp((const char *)a, (const char *)b);\n}\n\nvoid bag_reset(void)\n{\n        ntab = 0;\n}\n\nuint32_t op_bag(const char *a)\n{\n        uint32_t i;\n\n        if (!a)\n                a = \"\";\n        for (i = 0; i < ntab; i++) {\n                if (strcmp(names[i], a) == 0)\n                        return ids[i];\n        }\n        if (ntab >= MAX_PLACE)\n                return 0;\n        strncpy(names[ntab], a, sizeof(names[ntab]) - 1);\n        names[ntab][sizeof(names[ntab]) - 1] = 0;\n        ids[ntab] = ntab;\n        ntab++;\n        return ids[ntab - 1];\n}\n\nvoid bag_freeze(void)\n{\n        uint32_t i;\n\n        qsort(names, ntab, sizeof(names[0]), namecmp);\n        for (i = 0; i < ntab; i++)\n                ids[i] = i;\n}\n\nconst char *bag_get(uint32_t id)\n{\n        uint32_t i;\n\n        for (i = 0; i < ntab; i++) {\n                if (ids[i] == id)\n                        return names[i];\n        }\n        return \"\";\n}\n\nuint32_t bag_n(void)\n{\n        return ntab;\n}\nEOF\ncat > /app/chunkvat/walk.c <<'EOF'\n#include \"walk.h\"\n\n#include <dirent.h>\n#include <errno.h>\n#include <limits.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#define KEY_CAP (MAX_FR * (MAX_LN + 1))\n\nstatic struct samp tab[MAX_CH];\nstatic int ntab;\n\nstatic int number(const char *s, uint32_t *out)\n{\n        char *end;\n        unsigned long v;\n\n        if (!s || !*s || *s == '-' || *s == '+')\n                return -1;\n        errno = 0;\n        v = strtoul(s, &end, 10);\n        if (errno || *end || v > UINT_MAX)\n                return -1;\n        *out = (uint32_t)v;\n        return 0;\n}\n\nstatic int parse_one(const char *path, struct samp *out)\n{\n        FILE *fp;\n        char line[128];\n        int state = 0;\n        int bad = 0;\n\n        memset(out, 0, sizeof(*out));\n        fp = fopen(path, \"r\");\n        if (!fp)\n                return -1;\n        while (fgets(line, sizeof(line), fp)) {\n                size_t n = strlen(line);\n                int had_nl = n && line[n - 1] == '\\n';\n\n                if (had_nl)\n                        line[--n] = 0;\n                else if (!feof(fp)) {\n                        bad = 1;\n                        break;\n                }\n                if (n && line[n - 1] == '\\r')\n                        line[--n] = 0;\n\n                if (state == 0) {\n                        if (strncmp(line, \"SEQ \", 4) || number(line + 4, &out->seq)) {\n                                bad = 1;\n                                break;\n                        }\n                        state = 1;\n                } else if (state == 1) {\n                        if (!strncmp(line, \"HITS \", 5)) {\n                                if (out->depth == 0 || number(line + 5, &out->hits)) {\n                                        bad = 1;\n                                        break;\n                                }\n                                state = 2;\n                        } else {\n                                if (!line[0] || !strcmp(line, \"END\") ||\n                                    !strncmp(line, \"SEQ \", 4) || out->depth >= MAX_FR ||\n                                    strlen(line) >= MAX_LN) {\n                                        bad = 1;\n                                        break;\n                                }\n                                strcpy(out->fr[out->depth++], line);\n                        }\n                } else if (state == 2) {\n                        if (strcmp(line, \"END\")) {\n                                bad = 1;\n                                break;\n                        }\n                        state = 3;\n                } else {\n                        bad = 1;\n                        break;\n                }\n        }\n        if (ferror(fp))\n                bad = 1;\n        fclose(fp);\n        if (bad || state != 3)\n                r"]
[75.73873, "i", "eturn -1;\n        snprintf(out->lab, sizeof(out->lab), \"SEQ %u\", out->seq);\n        return 0;\n}\n\nstatic void joined(const struct samp *s, char *dst, size_t cap)\n{\n        int i;\n        size_t used = 0;\n\n        if (cap)\n                dst[0] = 0;\n        for (i = 0; i < s->depth; i++) {\n                int n = snprintf(dst + used, cap - used, \"%s%s\", i ? \">\" : \"\", s->fr[i]);\n                if (n < 0 || (size_t)n >= cap - used)\n                        return;\n                used += (size_t)n;\n        }\n}\n\nstatic int sampcmp(const void *va, const void *vb)\n{\n        const struct samp *a = va, *b = vb;\n        char ka[KEY_CAP], kb[KEY_CAP];\n        int c;\n\n        joined(a, ka, sizeof(ka));\n        joined(b, kb, sizeof(kb));\n        c = strcmp(ka, kb);\n        if (c)\n                return c;\n        if (a->hits != b->hits)\n                return a->hits < b->hits ? -1 : 1;\n        if (a->seq != b->seq)\n                return a->seq < b->seq ? -1 : 1;\n        return 0;\n}\n\nint cfg_walk(const char *a)\n{\n        DIR *d;\n        struct dirent *de;\n        int rc = 0;\n\n        ntab = 0;\n        d = opendir(a ? a : \".\");\n        if (!d)\n                return -1;\n        while ((de = readdir(d)) != NULL) {\n                char path[512];\n                size_t n = strlen(de->d_name);\n\n                if (de->d_name[0] == '.' || n < 4 || strcmp(de->d_name + n - 4, \".chk\"))\n                        continue;\n                if (ntab >= MAX_CH) {\n                        rc = -1;\n                        break;\n                }\n                if (snprintf(path, sizeof(path), \"%s/%s\", a, de->d_name) >= (int)sizeof(path) ||\n                    parse_one(path, &tab[ntab]) != 0) {\n                        rc = -1;\n                        break;\n                }\n                ntab++;\n        }\n        closedir(d);\n        if (rc) {\n                ntab = 0;\n                return -1;\n        }\n        qsort(tab, (size_t)ntab, sizeof(tab[0]), sampcmp);\n        return 0;\n}\n\nint walk_n(void)\n{\n        return ntab;\n}\n\nstruct samp *walk_at(int i)\n{\n        if (i < 0 || i >= ntab)\n                return NULL;\n        return &tab[i];\n}\nEOF\n"]
