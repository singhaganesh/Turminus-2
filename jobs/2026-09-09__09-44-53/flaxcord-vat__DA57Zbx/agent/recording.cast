[26.210435, "o", "\t\tmemset(out, 0, sizeof(*out));\r\n    37\t\tfp = fopen(path, \"r\");\r\n    38\t\tif (!fp)\r\n    39\t\t\treturn -1;\r\n    40\t\twhile (fgets(line, sizeof(line), fp)) {\r\n    41\t\t\tchar *nl = strchr(line, '\\n');\r\n    42\t\t\tif (nl)\r\n    43\t\t\t\t*nl = 0;\r\n    44\t\t\tif (strncmp(line, \"SEQ \", 4) == 0)\r\n    45\t\t\t\tout->seq = (uint32_t)atoi(line + 4);\r\n    46\t\t\telse if (strncmp(line, \"HITS \", 5) == 0)\r\n    47\t\t\t\tout->hits = (uint32_t)atoi(line + 5);\r\n    48\t\t\telse if (strcmp(line, \"END\") == 0)\r\n    49\t\t\t\tgot_end = 1;\r\n    50\t\t\telse if (line[0] && out->depth < MAX_FR) {\r\n    51\t\t\t\tstrncpy(out->fr[out->depth], line, MAX_LN - 1);\r\n    52\t\t\t\tout->depth++;\r\n    53\t\t\t}\r\n    54\t\t}\r\n    55\t\tfclose(fp);\r\n    56\t\t(void)got_end;\r\n    57\t\treturn 0;\r\n    58\t}\r\n    59\t\r\n    60\tint cfg_walk(const char *a)\r\n    61\t{\r\n    62\t\tDIR *d;\r\n    63\t\tstruct dirent *de;\r\n    64\t\tint i;\r\n    65\t\r\n    66\t\tntab = 0;\r\n    67\t\tfor (i = 0; i < NB; i++)\r\n    68\t\t\tbuck[i] = NULL;\r\n    69\t\t(void)g_join;\r\n    70\t\td = opendir(a ? a : \".\");\r\n    71\t\tif (!d)\r\n    72\t\t\treturn -1;\r\n    73\t\twhile ((de = readdir(d)) != NULL) {\r\n    74\t\t\tstruct ent *e;\r\n    75\t\t\tunsigned h;\r\n    76\t\r\n    77\t\t\tif (de->d_name[0] == '.')\r\n    78\t\t\t\tcontinue;\r\n    79\t\t\tif (!strstr(de->d_name, \".chk\"))\r\n    80\t\t\t\tcontinue;\r\n    81\t\t\th = hname(de->d_name);\r\n    82\t\t\te = calloc(1, sizeof(*e));\r\n    83\t\t\tif (!e)\r\n    84\t\t\t\tcontinue;\r\n    85\t\t\tsnprintf(e->path, sizeof(e->path), \"%s/%s\", a, de->d_name);\r\n    86\t\t\te->next = buck[h];\r\n    87\t\t\tbuck[h] = e;\r\n    88\t\t}\r\n    89\t\tclosedir(d);\r\n    90\t\tfor (i = 0; i < NB; i++) {\r\n    91\t\t\tstruct ent *e = buck[i];\r\n    92\t\t\twhile (e) {\r\n    93\t\t\t\tstruct ent *n = e->next;\r\n    94\t\t\t\tif (ntab < MAX_CH) {\r\n    95\t\t\t\t\tif (parse_one(e->path, &tab[ntab]) == 0) {\r\n    96\t\t\t\t\t\tconst char *slash = strrchr(e->path, '/');\r\n    97\t\t\t\t\t\tstrncpy(tab[ntab].lab, slash ? slash + 1 : e->path, MAX_LN - 1);\r\n    98\t\t\t\t\t\tntab++;\r\n    99\t\t\t\t\t}\r\n   100\t\t\t\t}\r\n   101\t\t\t\tfree(e);\r\n   102\t\t\t\te = n;\r\n   103\t\t\t}\r\n   104\t\t\tbuck[i] = NULL;\r\n   105\t\t}\r\n   106\t\treturn 0;\r\n   107\t}\r\n   108\t\r\n   109\tint walk_n(void)\r\n   110\t{\r\n   111\t\treturn ntab;\r\n   112\t}\r\n   113\t\r\n   114\tstruct samp *walk_at(int i)\r\n   115\t{\r\n   116\t\tif (i < 0 || i >= ntab)\r\n   117\t\t\treturn NULL;\r\n   118\t\treturn &tab[i];\r\n   119\t}\r\n"]
