[26.207484, "o", "    12\t{\r\n    13\t\tntab = 0;\r\n    14\t}\r\n    15\t\r\n    16\tuint32_t op_bag(const char *a)\r\n    17\t{\r\n    18\t\tuint32_t i;\r\n    19\t\r\n    20\t\tif (!a)\r\n    21\t\t\ta = \"\";\r\n    22\t\tfor (i = 0; i < ntab; i++) {\r\n    23\t\t\tif (strcmp(names[i], a) == 0)\r\n    24\t\t\t\treturn ids[i];\r\n    25\t\t}\r\n    26\t\tif (ntab >= MAX_PLACE)\r\n    27\t\t\treturn 0;\r\n    28\t\tstrncpy(names[ntab], a, 79);\r\n    29\t\tnames[ntab][79] = 0;\r\n"]
[26.207656, "o", "    30\t\tids[ntab] = ntab;\r\n    31\t\tntab++;\r\n    32\t\treturn ids[ntab - 1];\r\n    33\t}\r\n    34\t\r\n    35\tvoid bag_freeze(void)\r\n    36\t{\r\n    37\t}\r\n    38\t\r\n    39\tconst char *bag_get(uint32_t id)\r\n    40\t{\r\n    41\t\tuint32_t i;\r\n    42\t\r\n    43\t\tfor (i = 0; i < ntab; i++) {\r\n    44\t\t\tif (ids[i] == id)\r\n    45\t\t\t\treturn names[i];\r\n    46\t\t}\r\n    47\t\treturn \"\";\r\n    48\t}\r\n    49\t\r\n    50\tuint32_t bag_n(void)\r\n    51\t{\r\n    52\t\treturn ntab;\r\n    53\t}\r\n"]
