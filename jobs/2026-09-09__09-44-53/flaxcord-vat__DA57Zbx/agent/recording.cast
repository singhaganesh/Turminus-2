[26.470848, "o", "    43\t\t\t\treturn 2;\r\n    44\t\t\tdir = argv[2];\r\n    45\t\t\toutp = argv[3];\r\n    46\t\t\tmkdir(\"/app/cordwell\", 0755);\r\n    47\t\t\tclear_ok();\r\n    48\t\t\tbag_reset();\r\n    49\t\t\tif (cfg_walk(dir) != 0)\r\n    50\t\t\t\treturn 1;\r\n    51\t\t\tif (n_pour(outp) != 0)\r\n    52\t\t\t\treturn 1;\r\n    53\t\t\tmark_ok();\r\n    54\t\t\treturn 0;\r\n    55\t\t}\r\n    56\t\tif (strcmp(argv[1], \"unreel\") == 0) {\r\n    57\t\t\tif (argc < 3)\r\n    58\t\t\t\treturn 2;\r\n    59\t\t\treturn run_show(argv[2]);\r\n    60\t\t}\r\n    61\t\tif (strcmp(argv[1], \"differ\") == 0) {\r\n    62\t\t\tif (argc < 4)\r\n    63\t\t\t\treturn 2;\r\n    64\t\t\tmkdir(\"/app/cordwell\", 0755);\r\n    65\t\t\treturn run_cmp(argv[2], argv[3], \"/app/cordwell/differ.txt\");\r\n    66\t\t}\r\n    67\t\treturn 2;\r\n    68\t}\r\n"]
