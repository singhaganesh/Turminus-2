     1	#include "show.h"
     2	
     3	#include <stdint.h>
     4	#include <stdio.h>
     5	#include <stdlib.h>
     6	#include <string.h>
     7	
     8	static uint16_t rd16(FILE *fp)
     9	{
    10		unsigned char b[2];
    11	
    12		if (fread(b, 1, 2, fp) != 2)
    13			return 0;
    14		return (uint16_t)(b[0] | ((uint16_t)b[1] << 8));
    15	}
    16	
    17	static uint32_t rd32(FILE *fp)
    18	{
    19		unsigned char b[4];
    20	
    21		if (fread(b, 1, 4, fp) != 4)
    22			return 0;
    23		return (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) |
    24		       ((uint32_t)b[3] << 24);
    25	}
    26	
    27	static uint64_t rd64(FILE *fp)
    28	{
    29		unsigned char b[8];
    30		uint64_t v = 0;
    31		int i;
    32	
    33		if (fread(b, 1, 8, fp) != 8)
    34			return 0;
    35		for (i = 0; i < 8; i++)
    36			v |= (uint64_t)b[i] << (8 * i);
    37		return v;
    38	}
    39	
    40	int run_show(const char *a)
    41	{
    42		FILE *fp;
    43		char mag[4];
    44		uint32_t nstr, nsamp, i, j;
    45		char **tab;
    46	
    47		fp = fopen(a, "rb");
    48		if (!fp)
    49			return 1;
    50		if (fread(mag, 1, 4, fp) != 4) {
    51			fclose(fp);
    52			return 1;
    53		}
    54		(void)rd64(fp);
    55		nstr = rd32(fp);
    56		tab = calloc(nstr + 1, sizeof(char *));
    57		for (i = 0; i < nstr; i++) {
    58			uint16_t ln = rd16(fp);
    59			tab[i] = calloc(ln + 1, 1);
    60			if (ln)
    61				fread(tab[i], 1, ln, fp);
    62		}
    63		nsamp = rd32(fp);
    64		for (i = 0; i < nsamp; i++) {
    65			uint16_t depth = rd16(fp);
    66			for (j = 0; j < depth; j++) {
    67				uint32_t id = rd32(fp);
    68				if (j)
    69					fputc('>', stdout);
    70				if (id < nstr && tab[id])
    71					fputs(tab[id], stdout);
    72			}
    73			printf(" COUNT %u\n", rd32(fp));
    74		}
    75		for (i = 0; i < nstr; i++)
    76			free(tab[i]);
    77		free(tab);
    78		fclose(fp);
    79		return 0;
    80	}
===== cmp =====
     1	#include "cmp.h"
     2	
     3	#include <stdio.h>
     4	#include <stdlib.h>
     5	#include <string.h>
     6	
     7	int run_cmp(const char *a, const char *b, const char *outp)
     8	{
     9		FILE *fa, *fb, *fo;
    10		unsigned char *x = NULL, *y = NULL;
    11		long na, nb;
    12		int same = 0;
    13	
    14		fa = fopen(a, "rb");
    15		fb = fopen(b, "rb");
    16		if (!fa || !fb) {
    17			if (fa)
    18				fclose(fa);
    19			if (fb)
    20				fclose(fb);
    21			fo = fopen(outp, "w");
    22			if (fo) {
    23				fputs("noisy\n", fo);
    24				fclose(fo);
    25			}
    26			return 1;
    27		}
    28		fseek(fa, 0, SEEK_END);
    29		na = ftell(fa);
    30		fseek(fa, 0, SEEK_SET);
    31		fseek(fb, 0, SEEK_END);
    32		nb = ftell(fb);
    33		fseek(fb, 0, SEEK_SET);
    34		if (na == nb && na >= 0) {
    35			x = malloc((size_t)na);
    36			y = malloc((size_t)nb);
    37			if (x && y && fread(x, 1, (size_t)na, fa) == (size_t)na &&
    38			    fread(y, 1, (size_t)nb, fb) == (size_t)nb)
    39				same = memcmp(x, y, (size_t)na) == 0;
    40		}
    41		free(x);
    42		free(y);
    43		fclose(fa);
    44		fclose(fb);
    45		fo = fopen(outp, "w");
    46		if (!fo)
    47			return 1;
    48		fputs(same ? "quiet\n" : "noisy\n", fo);
    49		fclose(fo);
    50		return same ? 0 : 1;
    51	}
