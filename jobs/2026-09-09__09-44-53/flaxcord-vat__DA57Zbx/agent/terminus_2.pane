    10	#define NB 16
    11	
    12	struct ent {
    13		char path[512];
    14		struct ent *next;
    15	};
    16	
    17	static struct samp tab[MAX_CH];
    18	static int ntab;
    19	static struct ent *buck[NB];
    20	
    21	static unsigned hname(const char *s)
    22	{
    23		unsigned h = 2166136261u;
    24	
    25		while (*s)
    26			h = (h ^ (unsigned char)*s++) * 16777619u;
    27		return h % NB;
    28	}
    29	
    30	static int parse_one(const char *path, struct samp *out)
    31	{
    32		FILE *fp;
    33		char line[128];
    34		int got_end = 0;
    35	
    36		memset(out, 0, sizeof(*out));
    37		fp = fopen(path, "r");
    38		if (!fp)
    39			return -1;
    40		while (fgets(line, sizeof(line), fp)) {
    41			char *nl = strchr(line, '\n');
    42			if (nl)
    43				*nl = 0;
    44			if (strncmp(line, "SEQ ", 4) == 0)
    45				out->seq = (uint32_t)atoi(line + 4);
    46			else if (strncmp(line, "HITS ", 5) == 0)
    47				out->hits = (uint32_t)atoi(line + 5);
    48			else if (strcmp(line, "END") == 0)
    49				got_end = 1;
    50			else if (line[0] && out->depth < MAX_FR) {
    51				strncpy(out->fr[out->depth], line, MAX_LN - 1);
    52				out->depth++;
    53			}
    54		}
    55		fclose(fp);
    56		(void)got_end;
    57		return 0;
    58	}
    59	
    60	int cfg_walk(const char *a)
    61	{
    62		DIR *d;
    63		struct dirent *de;
    64		int i;
    65	
    66		ntab = 0;
    67		for (i = 0; i < NB; i++)
    68			buck[i] = NULL;
    69		(void)g_join;
    70		d = opendir(a ? a : ".");
    71		if (!d)
    72			return -1;
    73		while ((de = readdir(d)) != NULL) {
    74			struct ent *e;
    75			unsigned h;
    76	
    77			if (de->d_name[0] == '.')
    78				continue;
    79			if (!strstr(de->d_name, ".chk"))
    80				continue;
    81			h = hname(de->d_name);
    82			e = calloc(1, sizeof(*e));
    83			if (!e)
    84				continue;
    85			snprintf(e->path, sizeof(e->path), "%s/%s", a, de->d_name);
    86			e->next = buck[h];
    87			buck[h] = e;
    88		}
    89		closedir(d);
    90		for (i = 0; i < NB; i++) {
    91			struct ent *e = buck[i];
    92			while (e) {
    93				struct ent *n = e->next;
    94				if (ntab < MAX_CH) {
    95					if (parse_one(e->path, &tab[ntab]) == 0) {
    96						const char *slash = strrchr(e->path, '/');
    97						strncpy(tab[ntab].lab, slash ? slash + 1 : e->path, MAX_LN - 1);
    98						ntab++;
    99					}
   100				}
   101				free(e);
   102				e = n;
   103			}
   104			buck[i] = NULL;
   105		}
   106		return 0;
   107	}
   108	
   109	int walk_n(void)
   110	{
   111		return ntab;
   112	}
   113	
   114	struct samp *walk_at(int i)
   115	{
   116		if (i < 0 || i >= ntab)
   117			return NULL;
   118		return &tab[i];
   119	}
