[149.523179, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> static int samp_cmp(const void *va, const void *vb)\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r\u001b[?2004h>         const struct samp *a = va;\r\n\u001b[?2004l\r\u001b[?2004h>         const struct samp *b = vb;\r\n\u001b[?2004l\r\u001b[?2004h>         char ap[MAX_FR * MAX_LN + MAX_FR];\r\n\u001b[?2004l\r\u001b[?2004h>         char bp[MAX_FR * MAX_LN + MAX_FR];\r\n\u001b[?2004l\r\u001b[?2004h>         int c;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         joined_path(a, ap, sizeof(ap));\r\n\u001b[?2004l\r\u001b[?2004h>         joined_path(b, bp, sizeof(bp));\r\n\u001b[?2004l\r\u001b[?2004h>         c = strcmp(ap, bp);\r\n\u001b[?2004l\r\u001b[?2004h>         if (c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.523401, "o", "                return c;\r\n\u001b[?2004l\r\u001b[?2004h>         if (a->seq != b->seq)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.523559, "o", "                return a->seq < b->seq ? -1 : 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.523722, "o", ">         if (a->hits != b->hits)\r\n\u001b[?2004l\r"]
[149.523843, "o", "\u001b[?2004h> "]
[149.523969, "o", "                return a->hits < b->hits ? -1 : 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.524046, "o", "        return 0;\r\n\u001b[?2004l\r"]
[149.524094, "o", "\u001b[?2004h"]
[149.524775, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s[:start]+new+s[end:])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
