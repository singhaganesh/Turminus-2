[34.848734, "o", "unsigned char *x = NULL, *y = NULL;\r\n    11\t\tlong na, nb;\r\n    12\t\tint same = 0;\r\n    13\t\r\n    14\t\tfa = fopen(a, \"rb\");\r\n    15\t\tfb = fopen(b, \"rb\");\r\n    16\t\tif (!fa || !fb) {\r\n    17\t\t\tif (fa)\r\n    18\t\t\t\tfclose(fa);\r\n    19\t\t\tif (fb)\r\n    20\t\t\t\tfclose(fb);\r\n    21\t\t\tfo = fopen(outp, \"w\");\r\n    22\t\t\tif (fo) {\r\n    23\t\t\t\tfputs(\"noisy\\n\", fo);\r\n    24\t\t\t\tfclose(fo);\r\n    25\t\t\t}\r\n    26\t\t\treturn 1;\r\n    27\t\t}\r\n    28\t\tfseek(fa, 0, SEEK_END);\r\n    29\t\tna = ftell(fa);\r\n    30\t\tfseek(fa, 0, SEEK_SET);\r\n    31\t\tfseek(fb, 0, SEEK_END);\r\n    32\t\tnb = ftell(fb);\r\n    33\t\tfseek(fb, 0, SEEK_SET);\r\n    34\t\tif (na == nb && na >= 0) {\r\n    35\t\t\tx = malloc((size_t)na);\r\n    36\t\t\ty = malloc((size_t)nb);\r\n    37\t\t\tif (x && y && fread(x, 1, (size_t)na, fa) == (size_t)na &&\r\n    38\t\t\t    fread(y, 1, (size_t)nb, fb) == (size_t)nb)\r\n    39\t\t\t\tsame = memcmp(x, y, (size_t)na) == 0;\r\n    40\t\t}\r\n    41\t\tfree(x);\r\n    42\t\tfree(y);\r\n    43\t\tfclose(fa);\r\n    44\t\tfclose(fb);\r\n    45\t\t"]
[34.848774, "o", "fo = fopen(outp, \"w\");\r\n    46\t\tif (!fo)\r\n    47\t\t\treturn 1;\r\n    48\t\tfputs(same ? \"quiet\\n\" : \"noisy\\n\", fo);\r\n    49\t\tfclose(fo);\r\n    50\t\treturn same ? 0 : 1;\r\n    51\t}\r\n"]
[34.849125, "o", "--- unreel\r\n"]
[34.851165, "o", "     1\t#include \"show.h\"\r\n     2\t\r\n     3\t#include <stdint.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <stdlib.h>\r\n     6\t#include <string.h>\r\n     7\t\r\n     8\tstatic uint16_t rd16(FILE *fp)\r\n     9\t{\r\n    10\t\tunsigned char b[2];\r\n    11\t\r\n    12\t\tif (fread(b, 1, 2, fp) != 2)\r\n    13\t\t\treturn 0;\r\n    14\t\treturn (uint16_t)(b[0] | ((uint16_t)b[1] << 8));\r\n"]
[34.85134, "o", "    15\t}\r\n    16\t\r\n    17\tstatic uint32_t rd32(FILE *fp)\r\n    18\t{\r\n    19\t\tunsigned char b[4];\r\n    20\t\r\n    21\t\tif (fread(b, 1, 4, fp) != 4)\r\n    22\t\t\treturn 0;\r\n    23\t\treturn (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) |\r\n    24\t\t       ((uint32_t)b[3] << 24);\r\n    25\t}\r\n    26\t\r\n    27\tstatic uint64_t rd64(FILE *fp)\r\n    28\t{\r\n    29\t\tunsigned char b[8];\r\n    30\t\tuint64_t v = 0;\r\n    31\t\tint i;\r\n    32\t\r\n    33\t\tif (fread(b, 1, 8, fp) != 8)\r\n    34\t\t\treturn 0;\r\n    35\t\tfor (i = 0; i < 8; i++)\r\n    36\t\t\tv |= (uint64_t)b[i] << (8 * i);\r\n    37\t\treturn v;\r\n    38\t}\r\n    39\t\r\n    40\tint run_show(const char *a)\r\n    41\t{\r\n    42\t\tFILE *fp;\r\n    43\t\tchar mag[4];\r\n    44\t\tuint32_t nstr, nsamp, i, j;\r\n    45\t\tchar **tab;\r\n    46\t\r\n    47\t\tfp = fopen(a, \"rb\");\r\n    48\t\tif (!fp)\r\n    49\t\t\treturn 1;\r\n    50\t\tif (fread(mag, 1, 4, fp) != 4) {\r\n    51\t\t\tfclose(fp);\r\n    52\t\t\treturn 1;\r\n    53\t\t}\r\n    54\t\t(void)rd64(fp);\r\n    55\t\tnstr = rd32(fp);\r\n"]
[34.85138, "o", "    56\t\ttab = calloc(nstr + 1, sizeof(char *));\r\n    57\t\tfor (i = 0; i < nstr; i++) {\r\n    58\t\t\tuint16_t ln = rd16(fp);\r\n    59\t\t\ttab[i] = calloc(ln + 1, 1);\r\n"]
[34.851407, "o", "    60\t\t\tif (ln)\r\n    61\t\t\t\tfread(tab[i], 1, ln, fp);\r\n    62\t\t}\r\n    63\t\tnsamp = rd32(fp);\r\n    64\t\tfor (i = 0; i < nsamp; i++) {\r\n    65\t\t\tuint16_t depth = rd16(fp);\r\n    66\t\t\tfor (j = 0; j < depth; j++) {\r\n    67\t\t\t\t"]
[34.851429, "o", "uint32_t id = rd32(fp);\r\n    68\t\t\t\tif (j)\r\n    69\t\t\t\t\tfputc('>', stdout);\r\n    70\t\t\t\tif (id < nstr && tab[id])\r\n"]
[34.851448, "o", "    71\t\t\t\t\tfputs(tab[id], stdout);\r\n    72\t\t\t}\r\n    73\t\t\tprintf(\" COUNT %u\\n\", rd32(fp));\r\n    74\t\t}\r\n    75\t\tfor (i = 0; i < nstr; i++)\r\n"]
[34.851468, "o", "    76\t\t\tfree(tab[i]);\r\n    77\t\tfree(tab);\r\n    78\t\tfclose(fp);\r\n"]
[34.851725, "o", "    79\t\treturn 0;\r\n    80\t}\r\n"]
