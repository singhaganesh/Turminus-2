[35.158717, "o", "\u001b[?2004hroot@11c75c1586fc:/app# "]
[80.142122, "i", "cat > /app/cordspin/bag.c <<'EOF'\n#include \"bag.h\"\n\n#include <stdlib.h>\n#include <string.h>\n\n#define MAX_PLACE 256\n\nstatic char names[MAX_PLACE][80];\nstatic uint32_t ntab;\nstatic int frozen;\n\nstatic int cmp_name(const void *a, const void *b)\n{\n        return strcmp((const char *)a, (const char *)b);\n}\n\nvoid bag_reset(void)\n{\n        ntab = 0;\n        frozen = 0;\n}\n\nuint32_t op_bag(const char *a)\n{\n        uint32_t i;\n\n        if (!a)\n                a = \"\";\n        for (i = 0; i < ntab; i++)\n                if (strcmp(names[i], a) == 0)\n                        return i;\n        if (frozen || ntab >= MAX_PLACE)\n                return 0;\n        strncpy(names[ntab], a, sizeof(names[ntab]) - 1);\n        names[ntab][sizeof(names[ntab]) - 1] = 0;\n        return ntab++;\n}\n\nvoid bag_freeze(void)\n{\n        qsort(names, ntab, sizeof(names[0]), cmp_name);\n        frozen = 1;\n}\n\nconst char *bag_get(uint32_t id)\n{\n        return id < ntab ? names[id] : \"\";\n}\n\nuint32_t bag_n(void)\n{\n        return ntab;\n}\nEOF\n\ncat > /app/chunkvat/walk.c <<'EOF'\n#include \"walk.h\"\n\n#include <dirent.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#include \"../flaxcli/serial.h\"\n\nstatic struct samp tab[MAX_CH];\nstatic int ntab;\n\nstatic int parse_one(const char *path, struct samp *out)\n{\n        FILE *fp;\n        char line[128];\n        int got_end = 0;\n\n        memset(out, 0, sizeof(*out));\n        fp = fopen(path, \"r\");\n        if (!fp)\n                return -1;\n        while (fgets(line, sizeof(line), fp)) {\n                char *nl = strpbrk(line, \"\\r\\n\");\n                if (nl)\n                        *nl = 0;\n                if (strcmp(line, \"END\") == 0) {\n                        got_end = 1;\n                        break;\n                } else if (strncmp(line, \"SEQ \", 4) == 0) {\n                        out->seq = (uint32_t)strtoul(line + 4, NULL, 10);\n                } else if (strncmp(line, \"HITS \", 5) == 0) {\n                        out->hits = (uint32_t)strtoul(line + 5, NULL, 10);\n                } else if (line[0]) {\n                        if (out->depth >= MAX_FR) {\n                                fclose(fp);\n                                return -1;\n                        }\n                        strncpy(out->fr[out->depth], line, MAX_LN - 1);\n                        out->fr[out->depth][MAX_LN - 1] = 0;\n                        out->depth++;\n                }\n        }\n        if (ferror(fp) || fclose(fp) != 0)\n                return -1;\n        return got_end ? 0 : -1;\n}\n\nstatic int samp_cmp(const void *va, const void *vb)\n{\n        const struct samp *a = va;\n        const struct samp *b = vb;\n        int i, n, c;\n\n        n = a->depth < b->depth ? a->depth : b->depth;\n        for (i = 0; i < n; i++) {\n                c = strcmp(a->fr[i], b->fr[i]);\n                if (c)\n                        return c;\n        }\n        if (a->depth != b->depth)\n                return a->depth < b->depth ? -1 : 1;\n        if (a->seq != b->seq)\n                return a->seq < b->seq ? -1 : 1;\n        if (a->hits != b->hits)\n                return a->hits < b->hits ? -1 : 1;\n        return 0;\n}\n\nint cfg_walk(const char *a)\n{\n        DIR *d;\n        struct dirent *de;\n\n        ntab = 0;\n        (void)g_join;\n        d = opendir(a ? a : \".\");\n        if (!d)\n                return -1;\n        while ((de = readdir(d)) != NULL) {\n                char path[512];\n                size_t len = strlen(de->d_name);\n\n                if (de->d_name[0] == '.' || len < 4 ||\n                    strcmp(de->d_name + len - 4, \".chk\") != 0)\n                        continue;\n                if (ntab >= MAX_CH) {\n                        closedir(d);\n                        ntab = 0;\n                        return -1;\n                }\n                if (snprintf(path, sizeof(path), \"%s/%s\", a, de->d_name) >= (int)sizeof(path) ||\n                    parse_one(path, &tab[ntab]) != 0) {\n                        closedir(d);\n                        ntab = 0;\n                        return -1;\n                }\n                ntab++;\n        }\n        if (clo"]
[80.142375, "i", "sedir(d) != 0) {\n                ntab = 0;\n                return -1;\n        }\n        qsort(tab, (size_t)ntab, sizeof(tab[0]), samp_cmp);\n        for (int i = 0; i < ntab; i++)\n                snprintf(tab[i].lab, sizeof(tab[i].lab), \"seq-%u\", tab[i].seq);\n        return 0;\n}\n\nint walk_n(void)\n{\n        return ntab;\n}\n\nstruct samp *walk_at(int i)\n{\n        return i >= 0 && i < ntab ? &tab[i] : NULL;\n}\nEOF\n"]
