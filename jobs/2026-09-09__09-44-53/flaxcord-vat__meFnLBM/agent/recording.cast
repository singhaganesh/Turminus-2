[7.745152, "o", "/app/flaxcli/wire.h\r\n/app/hull.sh\r\n/app/spoolbay/day/k0.chk\r\n/app/spoolbay/day/k1.chk\r\n/app/spoolbay/day/k2.chk\r\n/app/spoolbay/dusk/m2.chk\r\n/app/spoolbay/dusk/m7.chk\r\n/app/spoolbay/dusk/m9.chk\r\n/app/unreelkit/show.c\r\n/app/unreelkit/show.h\r\n/app/unreelkit/show.o\r\n/app/vatnotes/ROUTE.txt\r\n/app/vatnotes/forms.txt\r\n"]
