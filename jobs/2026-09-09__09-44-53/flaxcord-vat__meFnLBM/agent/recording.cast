[118.162142, "i", "cat > /app/emitbay/pour.c <<'EOF'\n#include \"pour.h\"\n\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n\n#include \"../cordspin/bag.h\"\n#include \"../chunkvat/walk.h\"\n#include \"../flaxcli/wire.h\"\n\nstatic int wr16(FILE *fp, uint16_t v)\n{\n        unsigned char b[2] = {\n                (unsigned char)(v & 0xff),\n                (unsigned char)((v >> 8) & 0xff)\n        };\n        return fwrite(b, 1, sizeof(b), fp) == sizeof(b) ? 0 : -1;\n}\n\nstatic int wr32(FILE *fp, uint32_t v)\n{\n        unsigned char b[4] = {\n                (unsigned char)(v & 0xff),\n                (unsigned char)((v >> 8) & 0xff),\n                (unsigned char)((v >> 16) & 0xff),\n                (unsigned char)((v >> 24) & 0xff)\n        };\n        return fwrite(b, 1, sizeof(b), fp) == sizeof(b) ? 0 : -1;\n}\n\nstatic int wr64(FILE *fp, uint64_t v)\n{\n        unsigned char b[8];\n        int i;\n\n        for (i = 0; i < 8; i++)\n                b[i] = (unsigned char)((v >> (8 * i)) & 0xff);\n        return fwrite(b, 1, sizeof(b), fp) == sizeof(b) ? 0 : -1;\n}\n\nint n_pour(const char *a)\n{\n        FILE *fp;\n        int i, j, bad = 0;\n        uint32_t ns;\n\n        if (!a)\n                return -1;\n        bag_reset();\n        for (i = 0; i < walk_n(); i++) {\n                struct samp *s = walk_at(i);\n                if (!s)\n                        return -1;\n                for (j = 0; j < s->depth; j++)\n                        op_bag(s->fr[j]);\n        }\n        bag_freeze();\n\n        fp = fopen(a, \"wb\");\n        if (!fp)\n                return -1;\n        if (fwrite(MAGIC, 1, 4, fp) != 4 || wr64(fp, 0) != 0)\n                bad = 1;\n        ns = bag_n();\n        if (!bad && wr32(fp, ns) != 0)\n                bad = 1;\n        for (i = 0; !bad && i < (int)ns; i++) {\n                const char *nm = bag_get((uint32_t)i);\n                uint16_t ln = (uint16_t)strlen(nm);\n                if (wr16(fp, ln) != 0 || fwrite(nm, 1, ln, fp) != ln)\n                        bad = 1;\n        }\n        if (!bad && wr32(fp, (uint32_t)walk_n()) != 0)\n                bad = 1;\n        for (i = 0; !bad && i < walk_n(); i++) {\n                struct samp *s = walk_at(i);\n                if (!s || wr16(fp, (uint16_t)s->depth) != 0) {\n                        bad = 1;\n                        break;\n                }\n                for (j = 0; !bad && j < s->depth; j++)\n                        if (wr32(fp, op_bag(s->fr[j])) != 0)\n                                bad = 1;\n                if (!bad && wr32(fp, s->hits) != 0)\n                        bad = 1;\n        }\n        if (!bad && wr32(fp, (uint32_t)walk_n()) != 0)\n                bad = 1;\n        for (i = 0; !bad && i < walk_n(); i++) {\n                struct samp *s = walk_at(i);\n                uint16_t ln = (uint16_t)strlen(s->lab);\n                if (wr16(fp, ln) != 0 || fwrite(s->lab, 1, ln, fp) != ln)\n                        bad = 1;\n        }\n        if (fclose(fp) != 0)\n                bad = 1;\n        if (bad) {\n                remove(a);\n                return -1;\n        }\n        return 0;\n}\nEOF\n/app/hull.sh && stat -c '%y %s %n' /app/bin/flaxcord\n"]
