[20.03827, "i", "for f in /app/flaxcli/*.[ch] /app/flaxcli/hull.mk /app/hull.sh; do echo \"===== $f =====\"; sed -n '1,320p' \"$f\"; done\n"]
[20.042123, "o", "for f in /app/flaxcli/*.[ch] /app/flaxcli/hull.mk /app/hull.sh; do echo \"===== $f =====\"; sed -n '1,320p' \"$f\"; done\r\n\u001b[?2004l\r===== /app/flaxcli/hull.c =====\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n#include <sys/stat.h>\r\n#include <unistd.h>\r\n\r\n#include \"serial.h\"\r\n#include \"../cordspin/bag.h\"\r\n#include \"../chunkvat/walk.h\"\r\n#include \"../emitbay/pour.h\"\r\n#include \"../differbay/cmp.h\"\r\n#include \"../unreelkit/show.h\"\r\n\r\nstatic void mark_ok(void)\r\n{\r\n\tFILE *fp;\r\n\r\n\tmkdir(\"/app/cordwell\", 0755);\r\n\tfp = fopen(\"/app/cordwell/spin.ok\", \"w\");\r\n\tif (fp) {\r\n\t\tfputs(\"ok\\n\", fp);\r\n\t\tfclose(fp);\r\n\t}\r\n}\r\n\r\nstatic void clear_ok(void)\r\n{\r\n\tunlink(\"/app/cordwell/spin.ok\");\r\n}\r\n\r\nint main(int argc, char **argv)\r\n{\r\n\ttake_join(argc, argv);\r\n\tif (argc < 2) {\r\n\t\tfputs(\"usage\\n\", stderr);\r\n\t\treturn 2;\r\n\t}\r\n\tif (strcmp(argv[1], \"spin\") == 0) {\r\n\t\tconst char *dir;\r\n\t\tconst char *outp;\r\n\r\n\t\tif (argc < 4)\r\n\t\t\treturn 2;\r\n\t\tdir = argv[2];\r\n\t\toutp = argv[3];\r\n\t\tmkdir(\"/app/cordwell\", 0755);\r\n\t\tclear_ok();\r\n\t\tbag_reset();\r\n\t\tif (cfg_walk(dir) != 0)\r\n\t\t\treturn 1;\r\n\t\tif (n_pour(outp) != 0)\r\n\t\t\treturn 1;\r\n\t\tmark_ok();\r\n\t\treturn 0;\r\n\t}\r\n\tif (strcmp(argv[1], \"unreel\") == 0) {\r\n\t\tif (argc < 3)\r\n\t\t\treturn 2;\r\n\t\treturn run_show(argv[2]);\r\n\t}\r\n\tif (strcmp(argv[1], \"differ\") == 0) {\r\n\t\tif (argc < 4)\r\n\t\t\treturn 2;\r\n\t\tmkdir(\"/app/cordwell\", 0755);\r\n\t\treturn run_cmp(argv[2], argv[3], \"/app/cordwell/differ.txt\");\r\n\t}\r\n\treturn 2;\r\n}\r\n===== /app/flaxcli/serial.c =====\r\n"]
[20.044857, "o", "#include \"serial.h\"\r\n\r\n#include <string.h>\r\n\r\nint g_join;\r\n\r\nvoid take_join(int argc, char **argv)\r\n{\r\n\tint i;\r\n\r\n\tg_join = 0;\r\n\tfor (i = 1; i < argc; i++) {\r\n\t\tif (strcmp(argv[i], \"--serial-decode\") == 0)\r\n\t\t\tg_join = 1;\r\n\t}\r\n}\r\n"]
[20.045218, "o", "===== /app/flaxcli/serial.h =====\r\n"]
[20.047518, "o", "#ifndef SERIAL_H\r\n#define SERIAL_H\r\n\r\nextern int g_join;\r\nvoid take_join(int argc, char **argv);\r\n\r\n#endif\r\n"]
[20.047789, "o", "===== /app/flaxcli/token.c =====\r\n"]
[20.049423, "o", "#include \"token.h\"\r\n\r\n#include <ctype.h>\r\n#include <string.h>\r\n\r\nvoid trim_copy(char *dst, const char *src, int cap)\r\n{\r\n\tint n;\r\n\r\n\tif (!dst || cap <= 0)\r\n"]
[20.049495, "o", "\t\treturn;\r\n\tdst[0] = 0;\r\n\tif (!src)\r\n\t\treturn;\r\n\twhile (*src && isspace((unsigned char)*src))\r\n\t\tsrc++;\r\n\tstrncpy(dst, src, (size_t)cap - 1);\r\n\tdst[cap - 1] = 0;\r\n\tn = (int)strlen(dst);\r\n\twhile (n > 0 && isspace((unsigned char)dst[n - 1])) {\r\n\t\tdst[n - 1] = 0;\r\n\t\tn--;\r\n\t}\r\n}\r\n"]
[20.050009, "o", "===== /app/flaxcli/token.h =====\r\n"]
[20.05121, "o", "#ifndef TOKEN_H\r\n#define TOKEN_H\r\n\r\nvoid trim_copy(char *dst, const char *src, int cap);\r\n\r\n#endif\r\n"]
[20.051439, "o", "===== /app/flaxcli/wire.h =====\r\n"]
[20.052708, "o", "#ifndef WIRE_H\r\n#define WIRE_H\r\n\r\n#include <stdint.h>\r\n\r\n#define MAGIC \"FLX1\"\r\n#define MAX_NM 256\r\n#define MAX_FR 8\r\n#define MAX_CH 64\r\n#define MAX_LN 80\r\n\r\nstruct samp {\r\n\tchar fr[MAX_FR][MAX_LN];\r\n\tint depth;\r\n\tuint32_t hits;\r\n\tuint32_t seq;\r\n\tchar lab[MAX_LN];\r\n};\r\n\r\n#endif\r\n"]
