[34.699672, "o", "     1\t#include \"pour.h\"\r\n     2\t\r\n     3\t#include <stdint.h>\r\n     4\t#include <stdio.h>\r\n     5\t#include <string.h>\r\n     6\t#include <time.h>\r\n     7\t\r\n     8\t#include \"../cordspin/bag.h\"\r\n     9\t#include \"../chunkvat/walk.h\"\r\n    10\t#include \"../flaxcli/wire.h\"\r\n    11\t\r\n    12\tstatic void wr16(FILE *fp, uint16_t v)\r\n    13\t{\r\n    14\t\tunsigned char b[2];\r\n    15\t\r\n    16\t\tb[0] = (unsigned char)(v & 0xff);\r\n    17\t\tb[1] = (unsigned char)((v >> 8) & 0xff);\r\n    18\t\tfwrite(b, 1, 2, fp);\r\n    19\t}\r\n"]
[34.699722, "o", "    20\t\r\n    21\tstatic void wr32(FILE *fp, uint32_t v)\r\n    22\t{\r\n    23\t\tunsigned char b[4];\r\n    24\t\r\n    25\t\tb[0] = (unsigned char)(v & 0xff);\r\n    26\t\tb[1] = (unsigned char)((v >> 8) & 0xff);\r\n    27\t\tb[2] = (unsigned char)((v >> 16) & 0xff);\r\n    28\t\tb[3] = (unsigned char)((v >> 24) & 0xff);\r\n    29\t\tfwrite(b, 1, 4, fp);\r\n    30\t}\r\n    31\t\r\n    32\tstatic void wr64(FILE *fp, uint64_t v)\r\n    33\t{\r\n    34\t\tunsigned char b[8];\r\n    35\t\tint i;\r\n    36\t\r\n    37\t\tfor (i = 0; i < 8; i++)\r\n"]
[34.699899, "o", "    38\t\t\tb[i] = (unsigned char)((v >> (8 * i)) & 0xff);\r\n"]
[34.699944, "o", "    39\t\tfwrite(b, 1, 8, fp);\r\n    40\t}\r\n    41\t\r\n    42\tint n_pour(const char *a)\r\n    43\t{\r\n    44\t\tFILE *fp;\r\n    45\t\tstruct timespec ts;\r\n    46\t\tuint64_t stamp;\r\n    47\t\tint i, j;\r\n    48\t\tuint32_t ns, nlab;\r\n    49\t\r\n    50\t\tif (!a)\r\n    51\t\t\treturn -1;\r\n    52\t\tbag_reset();\r\n    53\t\tfor (i = 0; i < walk_n(); i++) {\r\n    54\t\t\tstruct samp *s = walk_at(i);\r\n    55\t\t\tif (!s)\r\n    56\t\t\t\tcontinue;\r\n    57\t\t\tfor (j = 0; j < s->depth; j++)\r\n    58\t\t\t\top_bag(s->fr[j]);\r\n    59\t\t}\r\n    60\t\tbag_freeze();\r\n    61\t\tclock_gettime(CLOCK_REALTIME, &ts);\r\n    62\t\tstamp = (uint64_t)ts.tv_sec * 1000000ull + (uint64_t)(ts.tv_nsec / 1000);\r\n    63\t\tfp = fopen(a, \"wb\");\r\n    64\t\tif (!fp)\r\n    65\t\t\treturn -1;\r\n    66\t\tfwrite(MAGIC, 1, 4, fp);\r\n    67\t\twr64(fp, stamp);\r\n    68\t\tns = bag_n();\r\n    69\t\twr32(fp, ns);\r\n    70\t\tfor (i = 0; i < (int)ns; i++) {\r\n    71\t\t\tconst char *nm = bag_get((uint32_t)i);\r\n    72\t\t\tuint16_t ln = (uint16_t)strlen(nm ? nm : \"\");\r\n    73\t\t\twr16(fp, ln);\r\n    74\t\t\tfwrite(nm ? nm : \"\", 1, ln, fp);\r\n    75\t\t}\r\n    76\t\twr32(fp, (uint32_t)walk_n());\r\n    77\t\tfor (i = 0; i < walk_n(); i++) {\r\n    78\t\t\tstruct samp *s = walk_at(i);\r\n    79\t\t\twr16(fp, (uint16_t)s->depth);\r\n    80\t\t\tfor (j = 0; j < s->depth; j++)\r\n    81\t\t\t\twr32(fp, op_bag(s->fr[j]));\r\n    82\t\t\twr32(fp, s->hits);\r\n    83\t\t}\r\n    84\t"]
[34.699971, "o", "\tnlab = (uint32_t)walk_n();\r\n    85\t\twr32(fp, nlab);\r\n    86\t\tfor (i = 0; i < walk_n(); i++) {\r\n    87\t\t\tstruct samp *s = walk_at(i);\r\n    88\t\t\tuint16_t ln = (uint16_t)strlen(s->lab);\r\n    89\t\t\twr16(fp, ln);\r\n    90\t\t\tfwrite(s->lab, 1, ln, fp);\r\n    91\t\t}\r\n"]
[34.7, "o", "    92\t\tfclose(fp);\r\n    93\t\treturn 0;\r\n    94\t}\r\n"]
