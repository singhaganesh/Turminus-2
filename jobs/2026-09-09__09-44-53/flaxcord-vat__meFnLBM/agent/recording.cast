[34.701352, "o", "     7\t#include \"serial.h\"\r\n     8\t#include \"../cordspin/bag.h\"\r\n     9\t#include \"../chunkvat/walk.h\"\r\n    10\t#include \"../emitbay/pour.h\"\r\n    11\t#include \"../differbay/cmp.h\"\r\n    12\t#include \"../unreelkit/show.h\"\r\n    13\t\r\n    14\tstatic void mark_ok(void)\r\n    15\t{\r\n    16\t\tFILE *fp;\r\n    17\t\r\n    18\t\tmkdir(\"/app/cordwell\", 0755);\r\n    19\t\tfp = fopen(\"/app/cordwell/spin.ok\", \"w\");\r\n    20\t\tif (fp) {\r\n    21\t\t\tfputs(\"ok\\n\", fp);\r\n    22\t\t\tfclose(fp);\r\n    23\t\t}\r\n    24\t}\r\n    25\t\r\n    26\tstatic void clear_ok(void)\r\n    27\t{\r\n    28\t\tunlink(\"/app/cordwell/spin.ok\");\r\n    29\t}\r\n    30\t\r\n    31\tint main(int argc, char **argv)\r\n    32\t{\r\n    33\t\ttake_join(argc, argv);\r\n    34\t\tif (argc < 2) {\r\n    35\t\t\tfputs(\"usage\\n\", stderr);\r\n    36\t\t\treturn 2;\r\n    37\t\t}\r\n    38\t\tif (strcmp(argv[1], \"spin\") == 0) {\r\n    39\t\t\tconst char *dir;\r\n    40\t\t\tconst char *outp;\r\n    41\t\r\n    42\t\t\tif (argc < 4)\r\n    43\t\t\t\treturn 2;\r\n    44\t\t\tdir = argv[2];\r\n    45\t\t\toutp = argv[3];\r\n    46\t\t\tmkdir(\"/app/cordwell\", 0755);\r\n    47\t\t\tclear_ok();\r\n    48\t\t\tbag_reset();\r\n    49\t\t\tif (cfg_walk(dir) != 0)\r\n    50\t\t\t\treturn 1;\r\n    51\t\t\tif (n_pour(outp) != 0)\r\n"]
[34.701443, "o", "    52\t\t\t\treturn 1;\r\n    53\t\t\tmark_ok();\r\n    54\t\t\treturn 0;\r\n    55\t\t}\r\n    56\t\tif (strcmp(argv[1], \"unreel\") == 0) {\r\n    57\t\t\tif (argc < 3)\r\n    58\t\t\t\treturn 2;\r\n    59\t\t\treturn run_show(argv[2]);\r\n    60\t\t}\r\n    61\t\tif (strcmp(argv[1], \"differ\") == 0) {\r\n    62\t\t\tif (argc < 4)\r\n    63\t\t\t\treturn 2;\r\n    64\t\t\tmkdir(\"/app/cordwell\", 0755);\r\n    65\t\t\treturn run_cmp(argv[2], argv[3], \"/app/cordwell/differ.txt\");\r\n    66\t\t}\r\n    67\t\treturn 2;\r\n    68\t}\r\n"]
