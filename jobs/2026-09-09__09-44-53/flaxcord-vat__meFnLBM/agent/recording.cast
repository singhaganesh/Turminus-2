[118.164949, "o", "{\r\n\u001b[?2004l\r\u001b[?2004h>         unsigned char b[2] = {\r\n\u001b[?2004l\r\u001b[?2004h>                 (unsigned char)(v & 0xff),\r\n\u001b[?2004l\r\u001b[?2004h"]
