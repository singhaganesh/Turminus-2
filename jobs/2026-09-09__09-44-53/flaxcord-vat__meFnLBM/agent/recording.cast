[149.517202, "i", "python3 - <<'PY'\np='/app/chunkvat/walk.c'\ns=open(p).read()\nstart=s.index('static int samp_cmp(')\nend=s.index('\\nint cfg_walk(', start)\nnew=r'''static void joined_path(const struct samp *s, char *out, size_t cap)\n{\n        size_t used = 0;\n        int i;\n\n        if (!cap)\n                return;\n        out[0] = 0;\n        for (i = 0; i < s->depth; i++) {\n                int n = snprintf(out + used, cap - used, \"%s%s\",\n                                 i ? \">\" : \"\", s->fr[i]);\n                if (n < 0 || (size_t)n >= cap - used) {\n                        out[cap - 1] = 0;\n                        return;\n                }\n                used += (size_t)n;\n        }\n}\n\nstatic int samp_cmp(const void *va, const void *vb)\n{\n        const struct samp *a = va;\n        const struct samp *b = vb;\n        char ap[MAX_FR * MAX_LN + MAX_FR];\n        char bp[MAX_FR * MAX_LN + MAX_FR];\n        int c;\n\n        joined_path(a, ap, sizeof(ap));\n        joined_path(b, bp, sizeof(bp));\n        c = strcmp(ap, bp);\n        if (c)\n                return c;\n        if (a->seq != b->seq)\n                return a->seq < b->seq ? -1 : 1;\n        if (a->hits != b->hits)\n                return a->hits < b->hits ? -1 : 1;\n        return 0;\n}\n'''\nopen(p,'w').write(s[:start]+new+s[end:])\nPY\n/app/hull.sh\n"]
