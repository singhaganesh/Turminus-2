    14	static void mark_ok(void)
    15	{
    16		FILE *fp;
    17	
    18		mkdir("/app/cordwell", 0755);
    19		fp = fopen("/app/cordwell/spin.ok", "w");
    20		if (fp) {
    21			fputs("ok\n", fp);
    22			fclose(fp);
    23		}
    24	}
    25	
    26	static void clear_ok(void)
    27	{
    28		unlink("/app/cordwell/spin.ok");
    29	}
    30	
    31	int main(int argc, char **argv)
    32	{
    33		take_join(argc, argv);
    34		if (argc < 2) {
    35			fputs("usage\n", stderr);
    36			return 2;
    37		}
    38		if (strcmp(argv[1], "spin") == 0) {
    39			const char *dir;
    40			const char *outp;
    41	
    42			if (argc < 4)
    43				return 2;
    44			dir = argv[2];
    45			outp = argv[3];
    46			mkdir("/app/cordwell", 0755);
    47			clear_ok();
    48			bag_reset();
    49			if (cfg_walk(dir) != 0)
    50				return 1;
    51			if (n_pour(outp) != 0)
    52				return 1;
    53			mark_ok();
    54			return 0;
    55		}
    56		if (strcmp(argv[1], "unreel") == 0) {
    57			if (argc < 3)
    58				return 2;
    59			return run_show(argv[2]);
    60		}
    61		if (strcmp(argv[1], "differ") == 0) {
    62			if (argc < 4)
    63				return 2;
    64			mkdir("/app/cordwell", 0755);
    65			return run_cmp(argv[2], argv[3], "/app/cordwell/differ.txt");
    66		}
    67		return 2;
    68	}
