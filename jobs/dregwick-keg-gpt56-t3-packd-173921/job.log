Sending keys: ['cat > /app/namelock/TallyGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.ArrayList;\nimport java.util.LinkedHashSet;\nimport java.util.List;\nimport java.util.Set;\nimport java.util.jar.JarEntry;\nimport java.util.jar.JarFile;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path names, Path jar) throws Exception {\n        List<String> expected = new ArrayList<String>();\n        Set<String> tokens = new LinkedHashSet<String>();\n        Set<String> classes = new LinkedHashSet<String>();\n        for (String line : Files.readAllLines(names)) {\n            String s = line.trim();\n            if (s.isEmpty()) continue;\n            String[] p = s.split("\\\\s+");\n            if (p.length != 2 || !tokens.add(p[0]) || !classes.add(p[1])) return 1;\n            if (!Files.isRegularFile(exploded.resolve(p[1] + ".class"))) return 1;\n            expected.add(p[1] + ".class");\n        }\n        expected.add("FallBooth.class");\n        List<String> actual = new ArrayList<String>();\n        if (!Files.isRegularFile(jar)) return 1;\n        try (JarFile jf = new JarFile(jar.toFile())) {\n            for (JarEntry e : java.util.Collections.list(jf.entries())) {\n                String n = e.getName();\n                if (!e.isDirectory() && !n.contains("/") && n.endsWith("Booth.class")) actual.add(n);\n            }\n        }\n        return actual.equals(expected) ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(Paths.get("/app/blastcp"),\n            Paths.get("/app/desknote/NAMES.txt"), Paths.get("/app/jarwell/husk.jar")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar)) return 1;\n        long cap = Long.parseLong(Files.readString(capFile).trim());\n        return cap >= 0 && Files.size(jar) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(Paths.get("/app/jarwell/husk.jar"),\n            Paths.get("/app/desknote/CAP.txt")));\n    }\n}\nEOF\ncat > /app/hitchrun/TasteRun.java <<\'EOF\'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.List;\n\npublic class TasteRun {\n    static void go(String card) throws Exception {\n        String token = readToken(Paths.get(card));\n        String booth = Rib.pick(token);\n        String kind = booth.equals(token) ? "own" : "fallback";\n        String json = "{\\"booth\\":\\"" + esc(booth) + "\\",\\"kind\\":\\"" + kind\n            + "\\",\\"note\\":\\"" + esc(token) + "\\"}\\n";\n        Path dest = Paths.get("/app/jarwell/taste.json");\n        Files.createDirectories(dest.getParent());\n        Files.write(dest, json.getBytes(StandardCharsets.UTF_8));\n    }\n\n    static String esc(String s) {\n        StringBuilder b = new StringBuilder();\n        for (int i = 0; i < s.length(); i++) {\n            char c = s.charAt(i);\n            if (c == \'"\' || c == \'\\\\\') b.append(\'\\\\\').append(c);\n            else if (c == \'\\n\') b.append("\\\\n");\n            else if (c == \'\\r\') b.append("\\\\r");\n            else if (c == \'\\t\') b.append("\\\\t");\n            else if (c < 32) b.append(String.format("\\\\u%04x", (int)c));\n            else b.append(c);\n        }\n        return b.toString();\n    }\n\n    static String readToken(Path card) throws Exception {\n        List<String> lines = Files.readAllLines(card);\n        for (String line : lines) {\n            String s = line.trim();\n            if (s.startsWith("token:")) return s.substring(6).trim();\n        }\n        return "none";\n    }\n}\nEOF\n