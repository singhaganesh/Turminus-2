[76.315291, "i", "cat > /app/sessbay/load.rs <<'EOF'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::fs;\nuse std::rc::Rc;\n\npub struct Plan { pub old: String, pub new: String, pub extra: String }\n\npub fn kiln_pitch(n0: u32, n1: u32, _width: u32, _heat: bool) -> (u32, u32) {\n    (n0.saturating_add(1), n1.saturating_add(2))\n}\n\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\n    let text = fs::read_to_string(p).ok()?;\n    if text.trim().is_empty() { return None; }\n    let (mut n0, mut n1) = (None, None);\n    let mut cells = Vec::new();\n    let mut flag = None;\n    let (mut old, mut new, mut extra) = (String::new(), String::new(), String::new());\n    for raw in text.lines() {\n        let line = raw.trim();\n        if line.is_empty() || line.starts_with('#') { continue; }\n        let mut it = line.split_whitespace();\n        match it.next()? {\n            \"tick\" => { n0 = Some(it.next()?.parse().ok()?); if it.next().is_some() { return None; } }\n            \"mark\" => { n1 = Some(it.next()?.parse().ok()?); if it.next().is_some() { return None; } }\n            \"bag\" => cells = it.map(str::to_owned).collect(),\n            \"mode\" => { flag = match it.next()? { \"heat\" => Some(true), \"peek\" => Some(false), _ => None }; if it.next().is_some() { return None; } }\n            \"swap\" => { old = it.next()?.to_owned(); new = it.next()?.to_owned(); if it.next().is_some() { return None; } }\n            \"push\" => { extra = it.next()?.to_owned(); if it.next().is_some() { return None; } }\n            _ => return None,\n        }\n    }\n    if cells.is_empty() { return None; }\n    let flag = flag?;\n    if flag && (old.is_empty() || new.is_empty() || extra.is_empty()) { return None; }\n    let ids = (0..cells.len()).collect();\n    Some((hold::Sess { n0: n0?, n1: n1?, ids: Rc::new(RefCell::new(ids)), flag }, hold::Pool { cells }, Plan { old, new, extra }))\n}\n\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\n    let width = a.ids.borrow().len() as u32;\n    if a.flag {\n        for c in &mut b.cells { if *c == p.old { *c = p.new.clone(); } }\n        b.cells.push(p.extra.clone());\n        a.ids.borrow_mut().push(b.cells.len() - 1);\n    }\n    (a.n0, a.n1) = kiln_pitch(a.n0, a.n1, width, a.flag);\n}\nEOF\ncat > /app/foldrib/rim.rs <<'EOF'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, _b: &hold::Pool) -> hold::Frost {\n    hold::Frost { n0: a.n0, n1: a.n1, ids: Rc::new(RefCell::new(a.ids.borrow().clone())), cells: Vec::new() }\n}\nEOF\ncat > /app/internpit/pool.rs <<'EOF'\nuse crate::{fold, hold, load};\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) { a.cells = b.cells.clone(); }\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost { let mut f = fold::rim_a(a, b); rim_b(&mut f, b); f }\n\nfn quote(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() { match c { '\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"), '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"), c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)), c => out.push(c) } }\n    out.push('\"'); out\n}\nfn pack(ids: &[usize], cells: &[String]) -> Option<String> {\n    let mut parts = Vec::new();\n    for &i in ids { parts.push(quote(cells.get(i)?)); }\n    Some(format!(\"[{}]\", parts.join(\",\")))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else { return 1; };\n    let heat = sess.flag;\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n    let frost_ids = frost.ids.borrow().clone();\n    let live_ids = sess.ids.borrow().clone();\n    let (Some(frost_s), Some(live_s)) = (pack(&frost_ids, &frost.cells), pack(&live_ids, &pool.cells)) else { return 1; };\n    if heat && frost_s == live_s { return 1; }\n    let body = format!(\"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\", sess.n0, sess.n1, frost_s, live_s);\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    if let Some(parent) = dest.parent() { if fs::create_dir_all(par"]
[76.316948, "i", "ent).is_err() { return 2; } }\n    if fs::write(dest, body).is_ok() { 0 } else { 2 }\n}\nEOF\ncat > /app/restcue/ink.rs <<'EOF'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let guard = Path::new(\"/app/inkpit/GUARD\");\n    let pair = Path::new(\"/app/inkpit/pair.json\");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(pair);\n    let code = pool::dump();\n    if code != 0 { return code; }\n    match fs::write(guard, \"ok\\n\") { Ok(()) => 0, Err(_) => 2 }\n}\nEOF\n"]
[76.352699, "o", "cat > /app/sessbay/load.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use crate::hold;\r\n\u001b[?2004l\r\u001b[?2004h> use std::cell::RefCell;\r\n\u001b[?2004l\r\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> use std::rc::Rc;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub struct Plan { pub old: String, pub new: String, pub extra: String }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn kiln_pitch(n0: u32, n1: u32, _width: u32, _heat: bool) -> (u32, u32) {\r\n\u001b[?2004l\r\u001b[?2004h>     (n0.saturating_add(1), n1.saturating_add(2))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\r\n\u001b[?2004l\r\u001b[?2004h>     let text = fs::read_to_string(p).ok()?;\r\n\u001b[?2004l\r\u001b[?2004h>     if text.trim().is_empty() { return None; }\r\n\u001b[?2004l\r\u001b[?2004h>     let (mut n0, mut n1) = (None, None);\r\n\u001b[?2004l\r\u001b[?2004h>     let mut cells = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut flag = None;\r\n\u001b[?2004l\r\u001b[?2004h>     let (mut old, mut new, mut extra) = (String::new(), String::new(), String::new());\r\n\u001b[?2004l\r\u001b[?2004h>     for raw in text.lines() {\r\n\u001b[?2004l\r\u001b[?2004h>         let line = raw.trim();\r\n\u001b[?2004l\r\u001b[?2004h>         if line.is_empty() || line.starts_with('#') { continue; }\r\n\u001b[?2004l\r\u001b[?2004h>         let mut it = line.split_whitespace();\r\n\u001b[?2004l\r\u001b[?2004h>         match it.next()? {\r\n\u001b[?2004l\r\u001b[?2004h>             \"tick\" => { n0 = Some(it.next()?.parse().ok()?); if it.next().is_some() { return None; } }\r\n\u001b[?2004l\r\u001b[?2004h>             \"mark\" => { n1 = Some(it.next()?.parse().ok()?); if it.next().is_some() { return None; } }\r\n\u001b[?2004l\r\u001b[?2004h>             \"bag\" => cells = it.map(str::to_owned).collect(),\r\n\u001b[?2004l\r\u001b[?2004h>             \"mode\" => { flag = match it.next()? { \"heat\" => Some(true), \"peek\" => Some(false), _ => None }; if it.next().is_some() { return None; } }\r\n\u001b[?2004l\r\u001b[?2004h>             \"swap\" => { old = it.next()?.to_owned(); new = it.next()?.to_owned(); if it.next().is_some() { return None; } }\r\n\u001b[?2004l\r\u001b[?2004h> "]
