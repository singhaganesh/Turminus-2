[76.366157, "o", "    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else { return 1; };\r\n\u001b[?2004l\r\u001b[?2004h>     let heat = sess.flag;\r\n\u001b[?2004l\r\u001b[?2004h>     let frost = prep(&sess, &pool);\r\n\u001b[?2004l\r\u001b[?2004h>     load::step(&mut sess, &mut pool, &plan);\r\n\u001b[?2004l\r\u001b[?2004h>     let frost_ids = frost.ids.borrow().clone();\r\n\u001b[?2004l\r\u001b[?2004h>     let live_ids = sess.ids.borrow().clone();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.368017, "o", "    let (Some(frost_s), Some(live_s)) = (pack(&frost_ids, &frost.cells), pack(&live_ids, &pool.cells)) else { return 1; };\r\n\u001b[?2004l\r\u001b[?2004h>     if heat && frost_s == live_s { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     let body = format!(\"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\", sess.n0, sess.n1, frost_s, live_s);\r\n\u001b[?2004l\r\u001b[?2004h>     let dest = Path::new(\"/app/inkpit/pair.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     if let Some(parent) = dest.parent() { if fs::create_dir_all(parent).is_err() { return 2; } }\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::write(dest, body).is_ok() { 0 } else { 2 }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[76.372314, "o", "\u001b[?2004hroot@ef3963915005:/app# cat > /app/restcue/ink.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use crate::pool;\r\n\u001b[?2004l\r\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn rim_c() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let guard = Path::new(\"/app/inkpit/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h>     let pair = Path::new(\"/app/inkpit/pair.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(pair);\r\n\u001b[?2004l\r\u001b[?2004h>     let code = pool::dump();\r\n\u001b[?2004l\r\u001b[?2004h>     if code != 0 { return code; }\r\n\u001b[?2004l\r\u001b[?2004h>     match fs::write(guard, \"ok\\n\") { Ok(()) => 0, Err(_) => 2 }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[76.376633, "o", "\u001b[?2004hroot@ef3963915005:/app# "]
[76.52327, "i", "python3 - <<'PY'\nfrom pathlib import Path\nrim=Path('/app/foldrib/rim.rs').read_text()\npool=Path('/app/internpit/pool.rs').read_text()\nink=Path('/app/restcue/ink.rs').read_text()\ndef raw(s):\n    for n in range(1,10):\n        marks='#'*n\n        if f'\"{marks}' not in s:\n            return f'r{marks}\"{s}\"{marks}'\n    raise ValueError\nsource=f'''use std::collections::HashSet;\nuse std::fs;\nuse std::path::Path;\n\nconst RIM: &str = {raw(rim)};\nconst POOL: &str = {raw(pool)};\nconst INK: &str = {raw(ink)};\n\nfn walk_cards(dir: &Path, cards: &mut Vec<String>) -> std::io::Result<()> {{\n    for entry in fs::read_dir(dir)? {{\n        let p = entry?.path();\n        if p.is_dir() {{ walk_cards(&p, cards)?; }}\n        else if p.extension().and_then(|x| x.to_str()) == Some(\"card\") {{ cards.push(fs::read_to_string(p)?); }}\n    }}\n    Ok(())\n}}\n\npub fn rib_d() -> i32 {{\n    let tree_text = match fs::read_to_string(\"/app/vatslip/TREE.txt\") {{ Ok(x) => x, Err(_) => return 2 }};\n    let tree: HashSet<_> = tree_text.lines().map(str::trim).filter(|x| !x.is_empty()).collect();\n    let mut cards = Vec::new();\n    if walk_cards(Path::new(\"/app/daycards\"), &mut cards).is_err() {{ return 2; }}\n    let mut freeze = false;\n    let mut cells = false;\n    for card in cards {{\n        for line in card.lines().map(str::trim).filter(|x| !x.is_empty() && !x.starts_with('#')) {{\n            match line {{ \"emit freeze\" => freeze = true, \"emit cells\" => cells = true, _ => return 2 }}\n        }}\n    }}\n    if !freeze || !cells {{ return 2; }}\n    let outputs = [(\"foldrib\", \"/app/foldrib/rim.rs\", RIM), (\"internpit\", \"/app/internpit/pool.rs\", POOL), (\"restcue\", \"/app/restcue/ink.rs\", INK)];\n    for (piece, path, body) in outputs {{\n        if tree.contains(piece) && fs::write(path, body).is_err() {{ return 2; }}\n    }}\n    0\n}}\n'''\nPath('/app/emitbay/hearth.rs').write_text(source)\nPY\n/app/bake.sh\n"]
[76.523682, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
