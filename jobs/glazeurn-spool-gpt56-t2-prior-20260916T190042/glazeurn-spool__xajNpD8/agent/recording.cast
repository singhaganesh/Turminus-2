[11.991994, "o", "printf '\\n--- daycards ---\\n'; find /app/daycards -type f -print -exec sh -c 'echo \"--- $1\"; cat \"$1\"' sh {} \\; 2>&1; printf '\\n--- spoolbay ---\\n'; find /app/spoolbay -type f -print -exec sh -c 'echo \"--- $1\"; cat \"$1\"' sh {} \\; 2>&1\r\n\u001b[?2004l\r"]
