  let body = format!("{{\\"tick\\":{},\\"mark\\":{},\\"frost_bag\\":{},\\"live_bag\\":{}}}\\n", sess.n0, sess.n1, frost_s, live_s);\n    let dest = Path::new("/app/inkpit/pair.json");\n    if let Some(parent) = dest.parent() { if fs::create_dir_all(parent).is_err() { return 2; } }\n    if fs::write(dest, body).is_ok() { 0 } else { 2 }\n}\nEOF\ncat > /app/restcue/ink.rs <<\'EOF\'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let guard = Path::new("/app/inkpit/GUARD");\n    let pair = Path::new("/app/inkpit/pair.json");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(pair);\n    let code = pool::dump();\n    if code != 0 { return code; }\n    match fs::write(guard, "ok\\n") { Ok(()) => 0, Err(_) => 2 }\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
