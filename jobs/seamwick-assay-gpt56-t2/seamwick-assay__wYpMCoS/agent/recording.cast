[32.467782, "o", "     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void tint(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.util.*;\");\r\n    12\t    a.println(\"public class Seal {\");\r\n    13\t    a.println(\"  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\");\r\n    14\t    a.println(\"    LinkedHashSet<String> s = new LinkedHashSet<String>();\");\r\n    15\t    a.println(\"    s.addAll(hitUnits);\");\r\n    16\t    a.println(\"    return new ArrayList<String>(s);\");\r\n    17\t    a.println(\"  }\");\r\n    18\t    a.println(\"  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\");\r\n    19\t    a.println(\"    if (analysed.size() >= floor) return \\\"0\\\";\");\r\n    20\t    a.println(\"    if (hitUnits.isEmpty()) return \\\"0\\\";\");\r\n    21\t    a.println(\"    return \\\"1\\\";\");\r\n    22\t    a.println(\"  }\");\r\n    23\t    a.println(\"}\");\r\n    24\t  }\r\n    25\t}\r\n"]
