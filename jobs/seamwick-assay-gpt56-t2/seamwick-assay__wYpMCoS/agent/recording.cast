[32.64049, "o", "    84\t      if (!Files.exists(CACHE)) return m;\r\n    85\t      String s = Files.readString(CACHE);\r\n    86\t      int i = s.indexOf(\"\\\"cites\\\"\");\r\n    87\t      if (i < 0) return m;\r\n    88\t      int brace = s.indexOf('{', i);\r\n    89\t      int end = matching(s, brace);\r\n    90\t      if (brace < 0 || end < 0) return m;\r\n    91\t      String inner = s.substring(brace + 1, end);\r\n    92\t      parseMapOfSets(inner, m);\r\n    93\t    } catch (Exception e) {\r\n    94\t    }\r\n    95\t    return m;\r\n    96\t  }\r\n    97\t\r\n    98\t  static int matching(String s, int open) {\r\n    99\t    int d = 0;\r\n   100\t    for (int i = open; i < s.length(); i++) {\r\n   101\t      char c = s.charAt(i);\r\n   102\t      if (c == '{') d++;\r\n   103\t      else if (c == '}') {\r\n   104\t        d--;\r\n   105\t        if (d == 0) return i;\r\n   106\t      }\r\n   107\t    }\r\n   108\t    return -1;\r\n   109\t  }\r\n   110\t\r\n   111\t  static void parseMapOfSets(String inner, Map<String, Set<String>> m) {\r\n   112\t    int i = 0;\r\n   113\t    while (i < inner.length()) {\r\n   114\t      int q1 = inner.indexOf('\"', i);\r\n   115\t      if (q1 < 0) break;\r\n   116\t      int q2 = inner.indexOf('\"', q1 + 1);\r\n   117\t      String key = inner.substring(q1 + 1, q2);\r\n   118\t      int lb = inner.indexOf('[', q2);\r\n   119\t      int rb = inner.indexOf(']', lb);\r\n   120\t      if (lb < 0 || rb < 0) break;\r\n   121\t      LinkedHashSet<String> set = new LinkedHashSet<String>();\r\n   122\t      String arr = inner.substring(lb + 1, rb);\r\n   123\t      int j = 0;\r\n   124\t      while (j < arr.length()) {\r\n   125\t        int a = arr.indexOf('\"', j);\r\n   126\t        if (a < 0) break;\r\n   127\t        int b = arr.indexOf('\"', a + 1);\r\n   128\t        set.add(arr.substring(a + 1, b));\r\n   129\t        j = b + 1;\r\n   130\t      }\r\n   131\t      m.put(key, set);\r\n   132\t      i = rb + 1;\r\n   133\t    }\r\n   134\t  }\r\n   135\t\r\n   136\t  static LinkedHashSet<String> hashChanged(LinkedHashMap<String, Loom.Unit> all, Map<String, String> oldHash) {\r\n   137\t    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n   138\t    for (Loom.Unit u : all.values()) {\r\n   139\t      String oh = oldHash.get(u.path);\r\n   140\t      if (oh == null || !oh.equals(u.hash)) s.add(u.path);\r\n   141\t    }\r\n   142\t    return s;\r\n   143\t  }\r\n   144\t\r\n   145\t  static Map<String, String> loadOldHash() {\r\n   146\t    Map<String, String> m = new LinkedHashMap<String, String>();\r\n   147\t    try {\r\n   148\t      if (!Files.exists(CACHE)) return m;\r\n   149\t      String s = Files.readString(CACHE);\r\n   150\t      int i = s.indexOf(\"\\\"hash\\\"\");\r\n   151\t      if (i < 0) return m;\r\n   152\t      int brace = s.indexOf('{', i);\r\n   153\t      int end = matching(s, brace);\r\n   154\t      if (brace < 0 || end < 0) return m;\r\n   155\t      String inner = s.substring(brace + 1, end);\r\n   156\t      int j = 0;\r\n   157\t      while (j < inner.length()) {\r\n   158\t        int q1 = inner.indexOf('\"', j);\r\n   159\t        if (q1 < 0) break;\r\n   160\t        int q2 = inner.indexOf('\"', q1 + 1);\r\n   161\t        int q3 = inner.indexOf('\"', q2 + 1);\r\n   162\t        int q4 = inner.indexOf('\"', q3 + 1);\r\n   163\t        if (q3 < 0 || q4 < 0) break;\r\n   164\t        m.put(inner.substring(q1 + 1, q2), inner.substring(q3 + 1, q4));\r\n   165\t        j = q4 + 1;\r\n   166\t      }\r\n   167\t    } catch (Exception e) {\r\n   168\t    }\r\n   169\t    return m;\r\n   170\t  }\r\n   171\t\r\n   172\t  static void writeCache(LinkedHashMap<String, Loom.Unit> all, Map<String, Set<String>> cites) throws Exception {\r\n   173\t    Files.createDirectories(BLOT);\r\n   174\t    StringBuilder b = new StringBuilder();\r\n   175\t    b.append(\"{\");\r\n   176\t    b.append(\"\\\"hash\\\":{\");\r\n   177\t    boolean first = true;\r\n   178\t    for (Loom.Unit u : all.values()) {\r\n   179\t      if (!first) b.append(',');\r\n   180\t      first = false;\r\n   181\t      b.append(Bag.q(u.path)).append(':').append(Bag.q(u.hash));\r\n   182\t    }\r\n   183\t    b.append(\"},\\\"fps\\\":{\");\r\n   184\t    first = true;\r\n   185\t    for (Loom.Unit u : all.values()) {\r\n   186\t      for (Map.Entry<String, String> e : u.fps.entrySet()) {\r\n   187\t        if (!first) b.append(',');\r\n   188"]
[32.641228, "o", "\t        first = false;\r\n   189\t        b.append(Bag.q(e.getKey())).append(':').append(Bag.q(e.getValue()));\r\n   190\t      }\r\n   191\t    }\r\n   192\t    b.append(\"},\\\"cites\\\":{\");\r\n   193\t    first = true;\r\n   194\t    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n   195\t      if (!first) b.append(',');\r\n   196\t      first = false;\r\n   197\t      b.append(Bag.q(e.getKey())).append(\":[\").append(Bag.joinComma(e.getValue())).append(']');\r\n   198\t    }\r\n   199\t    b.append(\"}}\");\r\n   200\t    Files.writeString(CACHE, b.toString());\r\n   201\t  }\r\n   202\t\r\n   203\t  static void writeLast(List<String> assayed, List<String[]> findings, String code) throws Exception {\r\n   204\t    Files.createDirectories(BLOT);\r\n   205\t    StringBuilder b = new StringBuilder();\r\n   206\t    b.append(\"{\");\r\n   207\t    b.append(\"\\\"assayed\\\":[\").append(Bag.joinComma(assayed)).append(\"],\");\r\n   208\t    b.append(\"\\\"findings\\\":[\");\r\n   209\t    for (int i = 0; i < findings.size(); i++) {\r\n   210\t      if (i > 0) b.append(',');\r\n   211\t      String[] f = findings.get(i);\r\n   212\t      b.append(\"{\\\"unit\\\":\").append(Bag.q(f[0]));\r\n   213\t      b.append(\",\\\"kind\\\":\").append(Bag.q(f[1]));\r\n   214\t      b.append(\",\\\"note\\\":\").append(Bag.q(f[2])).append('}');\r\n   215\t    }\r\n   216\t    b.append(\"],\\\"code\\\":\").append(Bag.q(code)).append('}');\r\n   217\t    Files.writeString(LAST, b.toString());\r\n   218\t  }\r\n   219\t\r\n   220\t  static int run(boolean all) throws Exception {\r\n   221\t    LinkedHashMap<String, Loom.Unit> units = Loom.load(ROOT);\r\n   222\t    Set<String> kn = known(units);\r\n   223\t    Map<String, Set<String>> cites = new LinkedHashMap<String, Set<String>>();\r\n   224\t    for (Loom.Unit u : units.values()) {\r\n   225\t      cites.put(u.path, Cite.tags(u.body, kn));\r\n   226\t    }\r\n   227\t    Map<String, String> oldFp = loadOldFp();\r\n   228\t    Map<String, String> newFp = fps(units);\r\n   229\t    LinkedHashSet<String> changedTypes = new LinkedHashSet<String>();\r\n   230\t    for (Map.Entry<String, String> e : newFp.entrySet()) {\r\n   231\t      String o = oldFp.get(e.getKey());\r\n   232\t      if (o == null || !o.equals(e.getValue())) changedTypes.add(e.getKey());\r\n   233\t    }\r\n   234\t    Map<String, String> oldHash = loadOldHash();\r\n   235\t    Set<String> changedFiles = hashChanged(units, oldHash);\r\n   236\t    List<String> pick;\r\n   237\t    if (all) {\r\n   238\t      pick = new ArrayList<String>(units.keySet());\r\n   239\t    } else {\r\n   240\t      pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);\r\n   241\t    }\r\n   242\t    LinkedHashSet<String> analysed = new LinkedHashSet<String>();\r\n   243\t    analysed.addAll(pick);\r\n   244\t    ArrayList<String[]> findings = new ArrayList<String[]>();\r\n   245\t    ArrayList<String> hitUnits = new ArrayList<String>();\r\n   246\t    for (String p : analysed) {\r\n   247\t      Loom.Unit u = units.get(p);\r\n   248\t      if (u == null) continue;\r\n   249\t      cites.put(p, Cite.tags(u.body, kn));\r\n   250\t      for (String[] h : u.hits) {\r\n   251\t        findings.add(h);\r\n   252\t        hitUnits.add(h[0]);\r\n   253\t      }\r\n   254\t    }\r\n   255\t    writeCache(units, cites);\r\n   256\t    LinkedHashSet<String> must = new LinkedHashSet<String>();\r\n   257\t    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {\r\n   258\t      for (String t : e.getValue()) {\r\n   259\t        if (changedTypes.contains(t)) must.add(e.getKey());\r\n   260\t      }\r\n   261\t    }\r\n   262\t    List<String> assayed = Seal.assayedOf(new ArrayList<String>(analysed), hitUnits);\r\n   263\t    String code = Seal.codeOf(new ArrayList<String>(analysed), hitUnits, must, floor());\r\n   264\t    writeLast(assayed, findings, code);\r\n   265\t    return Integer.parseInt(code);\r\n   266\t  }\r\n   267\t}\r\n===== /app/seamcmd/Loom.java =====\r\n"]
[32.644036, "o", "     1\timport java.nio.charset.StandardCharsets;\r\n     2\timport java.nio.file.*;\r\n     3\timport java.util.*;\r\n     4\timport java.util.regex.*;\r\n     5\t\r\n     6\tpublic class Loom {\r\n     7\t  public static class Unit {\r\n     8\t    public String path;\r\n     9\t    public String pkg;\r\n    10\t    public String body;\r\n    11\t    public String hash;\r\n    12\t    public LinkedHashSet<String> defined = new LinkedHashSet<String>();\r\n    13\t    public LinkedHashMap<String, String> fps = new LinkedHashMap<String, String>();\r\n    14\t    public LinkedHashSet<String> importedUnits = new LinkedHashSet<String>();\r\n    15\t    public ArrayList<String[]> hits = new ArrayList<String[]>();\r\n    16\t  }\r\n    17\t\r\n    18\t  static final Pattern IFACE = Pattern.compile(\"interface\\\\s+([A-Za-z_][A-Za-z0-9_]*)\");\r\n    19\t  static final Pattern METH = Pattern.compile(\"void\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(([^)]*)\\\\)\");\r\n    20\t  static final Pattern CALL = Pattern.compile(\"\\\\.([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(([^)]*)\\\\)\");\r\n    21\t  static final Pattern IMP = Pattern.compile(\"import\\\\s+([A-Za-z_][A-Za-z0-9_.*]*);\");\r\n    22\t  static final Pattern PKG = Pattern.compile(\"package\\\\s+([A-Za-z_][A-Za-z0-9_.]*);\");\r\n    23\t\r\n    24\t  public static LinkedHashMap<String, Unit> load(Path root) throws Exception {\r\n    25\t    LinkedHashMap<String, Unit> all = new LinkedHashMap<String, Unit>();\r\n    26\t    if (!Files.exists(root)) return all;\r\n    27\t    Files.walk(root).filter(p -> p.toString().endsWith(\".u\")).sorted().forEach(p -> {\r\n    28\t      try {\r\n    29\t        Unit u = parse(root, p);\r\n    30\t        all.put(u.path, u);\r\n    31\t      } catch (Exception e) {\r\n    32\t        throw new RuntimeException(e);\r\n    33\t      }\r\n    34\t    });\r\n    35\t    resolveHits(all);\r\n    36\t    return all;\r\n    37\t  }\r\n    38\t\r\n    39\t  static Unit parse(Path root, Path p) throws Exception {\r\n    40\t    Unit u = new Unit();\r\n    41\t    u.path = root.relativize(p).toString().replace('\\\\', '/');\r\n    42\t    u.body = Files.readString(p);\r\n    43\t    u.hash = Bag.hex(u.body.getBytes(StandardCharsets.UTF_8));\r\n    44\t    Matcher pm = PKG.matcher(u.body);\r\n    45\t    u.pkg = pm.find() ? pm.group(1) : \"\";\r\n    46\t    Matcher im = IMP.matcher(u.body);\r\n    47\t    while (im.find()) {\r\n    48\t      String r = im.group(1);\r\n    49\t      if (r.endsWith(\".*\")) continue;\r\n    50\t      u.importedUnits.add(r.replace('.', '/') + \".u\");\r\n    51\t    }\r\n    52\t    Matcher ic = IFACE.matcher(u.body);\r\n    53\t    LinkedHashMap<String, String> methods = new LinkedHashMap<String, String>();\r\n    54\t    String typeName = null;\r\n    55\t    if (ic.find()) {\r\n    56\t      typeName = ic.group(1);\r\n    57\t      u.defined.add(typeName);\r\n    58\t    }\r\n    59\t    Matcher mm = METH.matcher(u.body);\r\n    60\t    while (mm.find()) {\r\n    61\t      String name = mm.group(1);\r\n    62\t      String args = mm.group(2).trim();\r\n    63\t      int n = args.isEmpty() ? 0 : args.split(\",\").length;\r\n    64\t      methods.put(name, name + \":\" + n);\r\n    65\t    }\r\n    66\t    if (typeName != null) {\r\n    67\t      ArrayList<String> parts = new ArrayList<String>(methods.values());\r\n    68\t      Collections.sort(parts);\r\n    69\t      StringBuilder fp = new StringBuilder();\r\n    70\t      for (int i = 0; i < parts.size(); i++) {\r\n    71\t        if (i > 0) fp.append(';');\r\n    72\t        fp.append(parts.get(i));\r\n    73\t      }\r\n    74\t      u.fps.put(typeName, fp.toString());\r\n    75\t    }\r\n    76\t    return u;\r\n    77\t  }\r\n    78\t\r\n    79\t  static void resolveHits(LinkedHashMap<String, Unit> all) {\r\n    80\t    LinkedHashMap<String, String> methArity = new LinkedHashMap<String, String>();\r\n    81\t    for (Unit u : all.values()) {\r\n    82\t      for (Map.Entry<String, String> e : u.fps.entrySet()) {\r\n    83\t        for (String part : e.getValue().split(\";\")) {\r\n    84\t          if (part.isEmpty()) continue;\r\n    85\t          methArity.put(e.getKey() + \"#\" + part.split(\":\")[0], part.split(\":\")[1]);\r\n    86\t        }\r\n    87\t      }\r\n    88\t    }\r\n    89\t    for (Unit u : all.values()) {\r\n    90\t      Matcher c = CALL.matcher(u.body);\r"]
[32.646819, "o", "\n    91\t      while (c.find()) {\r\n    92\t        String name = c.group(1);\r\n    93\t        String args = c.group(2).trim();\r\n    94\t        int n = args.isEmpty() ? 0 : splitArgs(args);\r\n    95\t        for (Unit def : all.values()) {\r\n    96\t          for (String t : def.defined) {\r\n    97\t            String want = methArity.get(t + \"#\" + name);\r\n    98\t            if (want == null) continue;\r\n    99\t            if (Integer.parseInt(want) != n) {\r\n   100\t              u.hits.add(new String[] {u.path, \"arity\", name});\r\n   101\t            }\r\n   102\t          }\r\n   103\t        }\r\n   104\t      }\r\n   105\t    }\r\n   106\t  }\r\n   107\t\r\n   108\t  static int splitArgs(String args) {\r\n   109\t    int n = 1;\r\n   110\t    int depth = 0;\r\n   111\t    boolean q = false;\r\n   112\t    for (int i = 0; i < args.length(); i++) {\r\n   113\t      char ch = args.charAt(i);\r\n   114\t      if (ch == '\"') q = !q;\r\n   115\t      else if (!q && ch == '(') depth++;\r\n   116\t      else if (!q && ch == ')') depth--;\r\n   117\t      else if (!q && depth == 0 && ch == ',') n++;\r\n   118\t    }\r\n   119\t    return n;\r\n   120\t  }\r\n   121\t}\r\n"]
[32.646944, "o", "===== /app/seamcmd/Bag.java =====\r\n     1\timport java.security.MessageDigest;\r\n     2\timport java.util.*;\r\n     3\tpublic class Bag {\r\n     4\t  public static String q(String s) {\r\n     5\t    StringBuilder b = new StringBuilder();\r\n     6\t    b.append('\"');\r\n     7\t    for (int i = 0; i < s.length(); i++) {\r\n     8\t      char c = s.charAt(i);\r\n     9\t      if (c == '\\\\' || c == '\"') b.append('\\\\');\r\n    10\t      b.append(c);\r\n    11\t    }\r\n    12\t    b.append('\"');\r\n    13\t    return b.toString();\r\n    14\t  }\r\n    15\t  public static String hex(byte[] p) throws Exception {\r\n    16\t    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n    17\t    byte[] d = md.digest(p);\r\n    18\t    StringBuilder sb = new StringBuilder();\r\n    19\t    for (int i = 0; i < d.length; i++) {\r\n    20\t      int v = d[i] & 0xff;\r\n    21\t      if (v < 16) sb.append('0');\r\n    22\t      sb.append(Integer.toHexString(v));\r\n    23\t    }\r\n    24\t    return sb.toString();\r\n    25\t  }\r\n    26\t  public static String joinComma(Collection<String> xs) {\r\n    27\t    StringBuilder b = new StringBuilder();\r\n    28\t    boolean first = true;\r\n    29\t    for (String x : xs) {\r\n    30\t      if (!first) b.append(',');\r\n    31\t      first = false;\r\n    32\t      b.append(q(x));\r\n    33\t    }\r\n    34\t    return b.toString();\r\n    35\t  }\r\n    36\t}\r\n"]
