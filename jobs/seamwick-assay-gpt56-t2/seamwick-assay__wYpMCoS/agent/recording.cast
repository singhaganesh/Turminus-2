[32.466665, "o", "     7\t    knit(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void knit(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.util.*;\");\r\n    12\t    a.println(\"public class Sched {\");\r\n    13\t    a.println(\"  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\");\r\n    14\t    a.println(\"    LinkedHashSet<String> s = new LinkedHashSet<String>();\");\r\n    15\t    a.println(\"    s.addAll(changedFiles);\");\r\n    16\t    a.println(\"    for (String c : changedFiles) {\");\r\n    17\t    a.println(\"      Set<String> im = importers.get(c);\");\r\n    18\t    a.println(\"      if (im != null) s.addAll(im);\");\r\n    19\t    a.println(\"    }\");\r\n    20\t    a.println(\"    return new ArrayList<String>(s);\");\r\n    21\t    a.println(\"  }\");\r\n    22\t    a.println(\"}\");\r\n    23\t  }\r\n    24\t}\r\n"]
