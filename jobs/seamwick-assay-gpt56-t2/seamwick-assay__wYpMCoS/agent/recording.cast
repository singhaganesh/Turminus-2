[32.639246, "o", "     7\t  static Path LAST = BLOT.resolve(\"last.json\");\r\n     8\t  static Path CACHE = BLOT.resolve(\"cache.json\");\r\n     9\t  static Path FLOOR = Paths.get(\"/app/hopnotes/FLOOR.txt\");\r\n    10\t\r\n    11\t  static int floor() {\r\n    12\t    try {\r\n    13\t      return Integer.parseInt(Files.readString(FLOOR).trim());\r\n    14\t    } catch (Exception e) {\r\n    15\t      return 1;\r\n    16\t    }\r\n    17\t  }\r\n    18\t\r\n    19\t  static Map<String, Set<String>> importers(LinkedHashMap<String, Loom.Unit> all) {\r\n    20\t    Map<String, Set<String>> bait = Scan.edges(all);\r\n    21\t    try {\r\n    22\t      Files.createDirectories(BLOT);\r\n    23\t      StringBuilder b = new StringBuilder();\r\n    24\t      b.append(\"{\");\r\n    25\t      boolean first = true;\r\n    26\t      for (Map.Entry<String, Set<String>> e : bait.entrySet()) {\r\n    27\t        if (!first) b.append(',');"]
