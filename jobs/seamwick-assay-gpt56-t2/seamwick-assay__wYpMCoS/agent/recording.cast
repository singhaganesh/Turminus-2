[42.117915, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\t\r\n     4\tpublic class Drive {\r\n     5\t  static Path ROOT = Paths.get(\"/app/corpus\");\r\n     6\t  static Path BLOT = Paths.get(\"/app/blot\");\r\n     7\t  static Path LAST = BLOT.resolve(\"last.json\");\r\n     8\t  static Path CACHE = BLOT.resolve(\"cache.json\");\r\n     9\t  static Path FLOOR = Paths.get(\"/app/hopnotes/FLOOR.txt\");\r\n    10\t\r\n    11\t  static int floor() {\r\n    12\t    try {\r\n    13\t      return Integer.parseInt(Files.readString(FLOOR).trim());\r\n    14\t    } catch (Exception e) {\r\n    15\t      return 1;\r\n    16\t    }\r\n    17\t  }\r\n    18\t\r\n    19\t  static Map<String, Set<String>> importers(LinkedHashMap<String, Loom.Unit> all) {\r\n    20\t    Map<String, Set<String>> bait = Scan.edges(all);\r\n    21\t    try {\r\n    22\t      Files.createDirectories(BLOT);\r\n    23\t      StringBuilder b = new StringBuilder();\r\n    24\t      b.append(\"{\");\r\n    25\t      boolean first = true;\r\n    26\t      for (Map.Entry<String, Set<String>> e : bait.entrySet()) {\r\n    27\t        if (!first) b.append(',');\r\n    28\t        first = false;\r\n    29\t        b.append(Bag.q(e.getKey())).append(\":[\").append(Bag.joinComma(e.getValue())).append(']');\r\n    30\t      }\r\n    31\t      b.append(\"}\");\r\n    32\t      Files.writeString(BLOT.resolve(\"scan.json\"), b.toString());\r\n    33\t    } catch (Exception e) {\r\n    34\t    }\r\n    35\t    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();\r\n    36\t    for (Loom.Unit u : all.values()) {\r\n    37\t      for (String dep : u.importedUnits) {\r\n    38\t        if (!m.containsKey(dep)) m.put(dep, new LinkedHashSet<String>());\r\n    39\t        m.get(dep).add(u.path);\r\n    40\t      }\r\n    41\t    }\r\n    42\t    return m;\r\n    43\t  }\r\n    44\t\r\n    45\t  static LinkedHashSet<String> known(LinkedHashMap<String, Loom.Unit> all) {\r\n    46\t    LinkedHashSet<String> k = new LinkedHashSet<String>();\r\n    47\t    for (Loom.Unit u : all.values()) k.addAll(u.defined);\r\n    48\t    return k;\r\n    49\t  }\r\n    50\t\r\n    51\t  static Map<String, String> fps(LinkedHashMap<String, Loom.Unit> all) {\r\n    52\t    Map<String, String> m = new LinkedHashMap<String, String>();\r\n    53\t    for (Loom.Unit u : all.values()) m.putAll(u.fps);\r\n    54\t    return m;\r\n    55\t  }\r\n    56\t\r\n    57\t  static Map<String, String> loadOldFp() {\r\n    58\t    Map<String, String> m = new LinkedHashMap<String, String>();\r\n    59\t    Map<String, Set<String>> cites = loadCites();\r\n    60\t    try {\r\n    61\t      if (!Files.exists(CACHE)) return m;\r\n    62\t      String s = Files.readString(CACHE);\r\n    63\t      int i = s.indexOf(\"\\\"fps\\\"\");\r\n    64\t      if (i < 0) return m;\r\n    65\t      int brace = s.indexOf('{', i);\r\n    66\t      int end = s.indexOf('}', brace);\r\n    67\t      if (brace < 0 || end < 0) return m;\r\n    68\t      String inner = s.substring(brace + 1, end);\r\n    69\t      for (String part : inner.split(\",\")) {\r\n    70\t        if (!part.contains(\":\")) continue;\r\n    71\t        String[] kv = part.split(\":\", 2);\r\n    72\t        String k = kv[0].replace(\"\\\"\", \"\").trim();\r\n    73\t        String v = kv[1].replace(\"\\\"\", \"\").trim();\r\n    74\t        if (!k.isEmpty()) m.put(k, v);\r\n    75\t      }\r\n    76\t    } catch (Exception e) {\r\n    77\t    }\r\n    78\t    return m;\r\n    79\t  }\r\n    80\t\r\n    81\t  static Map<String, Set<String>> loadCites() {\r\n    82\t    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();\r\n    83\t    try {\r\n    84\t      if (!Files.exists(CACHE)) return m;\r\n    85\t      String s = Files.readString(CACHE);\r\n    86\t      int i = s.indexOf(\"\\\"cites\\\"\");\r\n    87\t      if (i < 0) return m;\r\n    88\t      int brace = s.indexOf('{', i);\r\n    89\t      int end = matching(s, brace);\r\n    90\t      if (brace < 0 || end < 0) return m;\r\n    91\t      String inner = s.substring(brace + 1, end);\r\n    92\t      parseMapOfSets(inner, m);\r\n    93\t    } catch (Exception e) {\r\n    94\t    }\r\n    95\t    return m;\r\n    96\t  }\r\n    97\t\r\n    98\t  static int matching(String s, int open) {\r\n    99\t    int d = 0;\r\n   100\t    for (int i = open; i < s.length(); i++) {\r\n   101\t      char c = s.cha"]
[42.118179, "o", "rAt(i);\r\n   102\t      if (c == '{') d++;\r\n   103\t      else if (c == '}') {\r\n   104\t        d--;\r\n   105\t        if (d == 0) return i;\r\n   106\t      }\r\n   107\t    }\r\n   108\t    return -1;\r\n   109\t  }\r\n   110\t\r\n   111\t  static void parseMapOfSets(String inner, Map<String, Set<String>> m) {\r\n   112\t    int i = 0;\r\n   113\t    while (i < inner.length()) {\r\n   114\t      int q1 = inner.indexOf('\"', i);\r\n   115\t      if (q1 < 0) break;\r\n   116\t      int q2 = inner.indexOf('\"', q1 + 1);\r\n   117\t      String key = inner.substring(q1 + 1, q2);\r\n   118\t      int lb = inner.indexOf('[', q2);\r\n   119\t      int rb = inner.indexOf(']', lb);\r\n   120\t      if (lb < 0 || rb < 0) break;\r\n   121\t      LinkedHashSet<String> set = new LinkedHashSet<String>();\r\n   122\t      String arr = inner.substring(lb + 1, rb);\r\n   123\t      int j = 0;\r\n   124\t      while (j < arr.length()) {\r\n   125\t        int a = arr.indexOf('\"', j);\r\n   126\t        if (a < 0) break;\r\n   127\t        int b = arr.indexOf('\"', a + 1);\r\n   128\t        set.add(arr.substring(a + 1, b));\r\n   129\t        j = b + 1;\r\n   130\t      }\r\n   131\t      m.put(key, set);\r\n   132\t      i = rb + 1;\r\n   133\t    }\r\n   134\t  }\r\n   135\t\r\n   136\t  static LinkedHashSet<String> hashChanged(LinkedHashMap<String, Loom.Unit> all, Map<String, String> oldHash) {\r\n   137\t    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n   138\t    for (Loom.Unit u : all.values()) {\r\n   139\t      String oh = oldHash.get(u.path);\r\n   140\t      if (oh == null || !oh.equals(u.hash)) s.add(u.path);\r\n   141\t    }\r\n   142\t    return s;\r\n   143\t  }\r\n   144\t\r\n   145\t  static Map<String, String> loadOldHash() {\r\n   146\t    Map<String, String> m = new LinkedHashMap<String, String>();\r\n   147\t    try {\r\n   148\t      if (!Files.exists(CACHE)) return m;\r\n   149\t      String s = Files.readString(CACHE);\r\n   150\t      int i = s.indexOf(\"\\\"hash\\\"\");\r\n   151\t      if (i < 0) return m;\r\n   152\t      int brace = s.indexOf('{', i);\r\n   153\t      int end = matching(s, brace);\r\n   154\t      if (brace < 0 || end < 0) return m;\r\n   155\t      String inner = s.substring(brace + 1, end);\r\n   156\t      int j = 0;\r\n   157\t      while (j < inner.length()) {\r\n   158\t        int q1 = inner.indexOf('\"', j);\r\n   159\t        if (q1 < 0) break;\r\n   160\t        int q2 = inner.indexOf('\"', q1 + 1);\r\n   161\t        int q3 = inner.indexOf('\"', q2 + 1);\r\n   162\t        int q4 = inner.indexOf('\"', q3 + 1);\r\n   163\t        if (q3 < 0 || q4 < 0) break;\r\n   164\t        m.put(inner.substring(q1 + 1, q2), inner.substring(q3 + 1, q4));\r\n   165\t        j = q4 + 1;\r\n   166\t      }\r\n   167\t    } catch (Exception e) {\r\n   168\t    }\r\n   169\t    return m;\r\n   170\t  }\r\n   171\t\r\n   172\t  static void writeCache(LinkedHashMap<String, Loom.Unit> all, Map<String, Set<String>> cites) throws Exception {\r\n   173\t    Files.createDirectories(BLOT);\r\n   174\t    StringBuilder b = new StringBuilder();\r\n   175\t    b.append(\"{\");\r\n   176\t    b.append(\"\\\"hash\\\":{\");\r\n   177\t    boolean first = true;\r\n   178\t    for (Loom.Unit u : all.values()) {\r\n   179\t      if (!first) b.append(',');\r\n   180\t      first = false;\r\n\u001b[?2004hroot@158666ec4975:/app# "]
