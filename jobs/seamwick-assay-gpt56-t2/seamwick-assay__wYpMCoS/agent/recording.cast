[32.465097, "o", "     1\timport java.io.*;\r\n     2\tpublic class PurlBox {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Cite.java\")));\r\n     7\t    purl(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void purl(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.util.*;\");\r\n    12\t    a.println(\"public class Cite {\");\r\n    13\t    a.println(\"  public static LinkedHashSet<String> tags(String body, Set<String> known) {\");\r\n    14\t    a.println(\"    LinkedHashSet<String> out = new LinkedHashSet<String>();\");\r\n"]
[32.465157, "o", "    15\t    a.println(\"    String[] lines = body.split(\\\"\\\\n\\\");\");\r\n    16\t    a.println(\"    for (int i = 0; i < lines.length; i++) {\");\r\n    17\t    a.println(\"      String t = lines[i].trim();\");\r\n    18\t    a.println(\"      if (t.startsWith(\\\"import \\\")) {\");\r\n    19\t    a.println(\"        String r = t.substring(7).replace(\\\";\\\", \\\"\\\").trim();\");\r\n    20\t    a.println(\"        int d = r.lastIndexOf('.');\");\r\n    21\t    a.println(\"        String n = d < 0 ? r : r.substring(d + 1);\");\r\n    22\t    a.println(\"        if (known.contains(n)) out.add(n);\");\r\n    23\t    a.println(\"      }\");\r\n    24\t    a.println(\"    }\");\r\n    25\t    a.println(\"    return out;\");\r\n    26\t    a.println(\"  }\");\r\n    27\t    a.println(\"}\");\r\n"]
