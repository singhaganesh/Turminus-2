     2	public class Sched {
     3	  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {
     4	    LinkedHashSet<String> s = new LinkedHashSet<String>();
