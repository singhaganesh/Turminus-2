[?2004limport java.util.*;
import java.util.regex.*;
public class Cite {
  public static LinkedHashSet<String> tags(String body, Set<String> known) {
    LinkedHashSet<String> out = new LinkedHashSet<String>();
    Matcher m = Pattern.compile("[A-Za-z_$][A-Za-z0-9_$]*").matcher(body);
    while (m.find()) if (known.contains(m.group())) out.add(m.group());
    return out;
  }
}
