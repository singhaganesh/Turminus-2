     1	import java.nio.charset.StandardCharsets;
     2	import java.nio.file.*;
     3	import java.util.*;
     4	import java.util.regex.*;
     5	
     6	public class Loom {
     7	  public static class Unit {
     8	    public String path;
     9	    public String pkg;
    10	    public String body;
    11	    public String hash;
    12	    public LinkedHashSet<String> defined = new LinkedHashSet<String>();
    13	    public LinkedHashMap<String, String> fps = new LinkedHashMap<String, String>();
    14	    public LinkedHashSet<String> importedUnits = new LinkedHashSet<String>();
    15	    public ArrayList<String[]> hits = new ArrayList<String[]>();
    16	  }
    17	
    18	  static final Pattern IFACE = Pattern.compile("interface\\s+([A-Za-z_][A-Za-z0-9_]*)");
    19	  static final Pattern METH = Pattern.compile("void\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)");
    20	  static final Pattern CALL = Pattern.compile("\\.([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)");
    21	  static final Pattern IMP = Pattern.compile("import\\s+([A-Za-z_][A-Za-z0-9_.*]*);");
    22	  static final Pattern PKG = Pattern.compile("package\\s+([A-Za-z_][A-Za-z0-9_.]*);");
    23	
    24	  public static LinkedHashMap<String, Unit> load(Path root) throws Exception {
    25	    LinkedHashMap<String, Unit> all = new LinkedHashMap<String, Unit>();
    26	    if (!Files.exists(root)) return all;
    27	    Files.walk(root).filter(p -> p.toString().endsWith(".u")).sorted().forEach(p -> {
    28	      try {
    29	        Unit u = parse(root, p);
    30	        all.put(u.path, u);
    31	      } catch (Exception e) {
    32	        throw new RuntimeException(e);
    33	      }
    34	    });
    35	    resolveHits(all);
    36	    return all;
    37	  }
    38	
    39	  static Unit parse(Path root, Path p) throws Exception {
    40	    Unit u = new Unit();
    41	    u.path = root.relativize(p).toString().replace('\\', '/');
    42	    u.body = Files.readString(p);
    43	    u.hash = Bag.hex(u.body.getBytes(StandardCharsets.UTF_8));
    44	    Matcher pm = PKG.matcher(u.body);
    45	    u.pkg = pm.find() ? pm.group(1) : "";
    46	    Matcher im = IMP.matcher(u.body);
    47	    while (im.find()) {
    48	      String r = im.group(1);
    49	      if (r.endsWith(".*")) continue;
    50	      u.importedUnits.add(r.replace('.', '/') + ".u");
    51	    }
    52	    Matcher ic = IFACE.matcher(u.body);
    53	    LinkedHashMap<String, String> methods = new LinkedHashMap<String, String>();
    54	    String typeName = null;
    55	    if (ic.find()) {
    56	      typeName = ic.group(1);
    57	      u.defined.add(typeName);
    58	    }
    59	    Matcher mm = METH.matcher(u.body);
    60	    while (mm.find()) {
    61	      String name = mm.group(1);
    62	      String args = mm.group(2).trim();
    63	      int n = args.isEmpty() ? 0 : args.split(",").length;
    64	      methods.put(name, name + ":" + n);
    65	    }
    66	    if (typeName != null) {
    67	      ArrayList<String> parts = new ArrayList<String>(methods.values());
    68	      Collections.sort(parts);
    69	      StringBuilder fp = new StringBuilder();
    70	      for (int i = 0; i < parts.size(); i++) {
    71	        if (i > 0) fp.append(';');
    72	        fp.append(parts.get(i));
    73	      }
    74	      u.fps.put(typeName, fp.toString());
    75	    }
    76	    return u;
    77	  }
    78	
    79	  static void resolveHits(LinkedHashMap<String, Unit> all) {
    80	    LinkedHashMap<String, String> methArity = new LinkedHashMap<String, String>();
    81	    for (Unit u : all.values()) {
    82	      for (Map.Entry<String, String> e : u.fps.entrySet()) {
    83	        for (String part : e.getValue().split(";")) {
    84	          if (part.isEmpty()) continue;
    85	          methArity.put(e.getKey() + "#" + part.split(":")[0], part.split(":")[1]);
    86	        }
    87	      }
    88	    }
    89	    for (Unit u : all.values()) {
    90	      Matcher c = CALL.matcher(u.body);
    91	      while (c.find()) {
    92	        String name = c.group(1);
    93	        String args = c.group(2).trim();
    94	        int n = args.isEmpty() ? 0 : splitArgs(args);
    95	        for (Unit def : all.values()) {
    96	          for (String t : def.defined) {
    97	            String want = methArity.get(t + "#" + name);
    98	            if (want == null) continue;
    99	            if (Integer.parseInt(want) != n) {
   100	              u.hits.add(new String[] {u.path, "arity", name});
   101	            }
   102	          }
   103	        }
   104	      }
   105	    }
   106	  }
   107	
   108	  static int splitArgs(String args) {
   109	    int n = 1;
   110	    int depth = 0;
   111	    boolean q = false;
   112	    for (int i = 0; i < args.length(); i++) {
   113	      char ch = args.charAt(i);
   114	      if (ch == '"') q = !q;
   115	      else if (!q && ch == '(') depth++;
   116	      else if (!q && ch == ')') depth--;
   117	      else if (!q && depth == 0 && ch == ',') n++;
   118	    }
   119	    return n;
   120	  }
   121	}
