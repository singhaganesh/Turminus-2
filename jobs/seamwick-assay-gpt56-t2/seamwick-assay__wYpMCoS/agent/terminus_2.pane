     1	import java.security.MessageDigest;
     2	import java.util.*;
     3	public class Bag {
     4	  public static String q(String s) {
     5	    StringBuilder b = new StringBuilder();
     6	    b.append('"');
     7	    for (int i = 0; i < s.length(); i++) {
     8	      char c = s.charAt(i);
     9	      if (c == '\\' || c == '"') b.append('\\');
    10	      b.append(c);
    11	    }
    12	    b.append('"');
    13	    return b.toString();
    14	  }
    15	  public static String hex(byte[] p) throws Exception {
    16	    MessageDigest md = MessageDigest.getInstance("SHA-256");
    17	    byte[] d = md.digest(p);
    18	    StringBuilder sb = new StringBuilder();
    19	    for (int i = 0; i < d.length; i++) {
    20	      int v = d[i] & 0xff;
    21	      if (v < 16) sb.append('0');
    22	      sb.append(Integer.toHexString(v));
    23	    }
    24	    return sb.toString();
    25	  }
    26	  public static String joinComma(Collection<String> xs) {
    27	    StringBuilder b = new StringBuilder();
    28	    boolean first = true;
    29	    for (String x : xs) {
    30	      if (!first) b.append(',');
    31	      first = false;
    32	      b.append(q(x));
    33	    }
    34	    return b.toString();
    35	  }
    36	}
