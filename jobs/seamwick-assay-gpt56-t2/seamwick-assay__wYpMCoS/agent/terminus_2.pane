     4	public class Drive {
     5	  static Path ROOT = Paths.get("/app/corpus");
     6	  static Path BLOT = Paths.get("/app/blot");
     7	  static Path LAST = BLOT.resolve("last.json");
     8	  static Path CACHE = BLOT.resolve("cache.json");
     9	  static Path FLOOR = Paths.get("/app/hopnotes/FLOOR.txt");
    10	
    11	  static int floor() {
    12	    try {
    13	      return Integer.parseInt(Files.readString(FLOOR).trim());
    14	    } catch (Exception e) {
    15	      return 1;
    16	    }
    17	  }
    18	
    19	  static Map<String, Set<String>> importers(LinkedHashMap<String, Loom.Unit> all) {
    20	    Map<String, Set<String>> bait = Scan.edges(all);
    21	    try {
    22	      Files.createDirectories(BLOT);
    23	      StringBuilder b = new StringBuilder();
    24	      b.append("{");
    25	      boolean first = true;
    26	      for (Map.Entry<String, Set<String>> e : bait.entrySet()) {
    27	        if (!first) b.append(',');
    28	        first = false;
    29	        b.append(Bag.q(e.getKey())).append(":[").append(Bag.joinComma(e.getValue())).append(']');
    30	      }
    31	      b.append("}");
    32	      Files.writeString(BLOT.resolve("scan.json"), b.toString());
    33	    } catch (Exception e) {
    34	    }
    35	    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();
    36	    for (Loom.Unit u : all.values()) {
    37	      for (String dep : u.importedUnits) {
    38	        if (!m.containsKey(dep)) m.put(dep, new LinkedHashSet<String>());
    39	        m.get(dep).add(u.path);
    40	      }
    41	    }
    42	    return m;
    43	  }
    44	
    45	  static LinkedHashSet<String> known(LinkedHashMap<String, Loom.Unit> all) {
    46	    LinkedHashSet<String> k = new LinkedHashSet<String>();
    47	    for (Loom.Unit u : all.values()) k.addAll(u.defined);
    48	    return k;
    49	  }
    50	
    51	  static Map<String, String> fps(LinkedHashMap<String, Loom.Unit> all) {
    52	    Map<String, String> m = new LinkedHashMap<String, String>();
    53	    for (Loom.Unit u : all.values()) m.putAll(u.fps);
    54	    return m;
    55	  }
    56	
    57	  static Map<String, String> loadOldFp() {
    58	    Map<String, String> m = new LinkedHashMap<String, String>();
    59	    Map<String, Set<String>> cites = loadCites();
    60	    try {
    61	      if (!Files.exists(CACHE)) return m;
    62	      String s = Files.readString(CACHE);
    63	      int i = s.indexOf("\"fps\"");
    64	      if (i < 0) return m;
    65	      int brace = s.indexOf('{', i);
    66	      int end = s.indexOf('}', brace);
    67	      if (brace < 0 || end < 0) return m;
    68	      String inner = s.substring(brace + 1, end);
    69	      for (String part : inner.split(",")) {
    70	        if (!part.contains(":")) continue;
    71	        String[] kv = part.split(":", 2);
    72	        String k = kv[0].replace("\"", "").trim();
    73	        String v = kv[1].replace("\"", "").trim();
    74	        if (!k.isEmpty()) m.put(k, v);
    75	      }
    76	    } catch (Exception e) {
    77	    }
    78	    return m;
    79	  }
    80	
    81	  static Map<String, Set<String>> loadCites() {
    82	    Map<String, Set<String>> m = new LinkedHashMap<String, Set<String>>();
    83	    try {
    84	      if (!Files.exists(CACHE)) return m;
    85	      String s = Files.readString(CACHE);
    86	      int i = s.indexOf("\"cites\"");
    87	      if (i < 0) return m;
    88	      int brace = s.indexOf('{', i);
    89	      int end = matching(s, brace);
    90	      if (brace < 0 || end < 0) return m;
    91	      String inner = s.substring(brace + 1, end);
    92	      parseMapOfSets(inner, m);
    93	    } catch (Exception e) {
    94	    }
    95	    return m;
    96	  }
    97	
    98	  static int matching(String s, int open) {
    99	    int d = 0;
   100	    for (int i = open; i < s.length(); i++) {
   101	      char c = s.charAt(i);
   102	      if (c == '{') d++;
   103	      else if (c == '}') {
   104	        d--;
   105	        if (d == 0) return i;
   106	      }
   107	    }
   108	    return -1;
   109	  }
   110	
   111	  static void parseMapOfSets(String inner, Map<String, Set<String>> m) {
   112	    int i = 0;
   113	    while (i < inner.length()) {
   114	      int q1 = inner.indexOf('"', i);
   115	      if (q1 < 0) break;
   116	      int q2 = inner.indexOf('"', q1 + 1);
   117	      String key = inner.substring(q1 + 1, q2);
   118	      int lb = inner.indexOf('[', q2);
   119	      int rb = inner.indexOf(']', lb);
   120	      if (lb < 0 || rb < 0) break;
   121	      LinkedHashSet<String> set = new LinkedHashSet<String>();
   122	      String arr = inner.substring(lb + 1, rb);
   123	      int j = 0;
   124	      while (j < arr.length()) {
   125	        int a = arr.indexOf('"', j);
   126	        if (a < 0) break;
   127	        int b = arr.indexOf('"', a + 1);
   128	        set.add(arr.substring(a + 1, b));
   129	        j = b + 1;
   130	      }
   131	      m.put(key, set);
   132	      i = rb + 1;
   133	    }
   134	  }
   135	
   136	  static LinkedHashSet<String> hashChanged(LinkedHashMap<String, Loom.Unit> all, Map<String, String> oldHash) {
   137	    LinkedHashSet<String> s = new LinkedHashSet<String>();
   138	    for (Loom.Unit u : all.values()) {
   139	      String oh = oldHash.get(u.path);
   140	      if (oh == null || !oh.equals(u.hash)) s.add(u.path);
   141	    }
   142	    return s;
   143	  }
   144	
   145	  static Map<String, String> loadOldHash() {
   146	    Map<String, String> m = new LinkedHashMap<String, String>();
   147	    try {
   148	      if (!Files.exists(CACHE)) return m;
   149	      String s = Files.readString(CACHE);
   150	      int i = s.indexOf("\"hash\"");
   151	      if (i < 0) return m;
   152	      int brace = s.indexOf('{', i);
   153	      int end = matching(s, brace);
   154	      if (brace < 0 || end < 0) return m;
   155	      String inner = s.substring(brace + 1, end);
   156	      int j = 0;
   157	      while (j < inner.length()) {
   158	        int q1 = inner.indexOf('"', j);
   159	        if (q1 < 0) break;
   160	        int q2 = inner.indexOf('"', q1 + 1);
   161	        int q3 = inner.indexOf('"', q2 + 1);
   162	        int q4 = inner.indexOf('"', q3 + 1);
   163	        if (q3 < 0 || q4 < 0) break;
   164	        m.put(inner.substring(q1 + 1, q2), inner.substring(q3 + 1, q4));
   165	        j = q4 + 1;
   166	      }
   167	    } catch (Exception e) {
   168	    }
   169	    return m;
   170	  }
   171	
   172	  static void writeCache(LinkedHashMap<String, Loom.Unit> all, Map<String, Set<String>> cites) throws Exception {
   173	    Files.createDirectories(BLOT);
   174	    StringBuilder b = new StringBuilder();
   175	    b.append("{");
   176	    b.append("\"hash\":{");
   177	    boolean first = true;
   178	    for (Loom.Unit u : all.values()) {
   179	      if (!first) b.append(',');
   180	      first = false;
   181	      b.append(Bag.q(u.path)).append(':').append(Bag.q(u.hash));
   182	    }
   183	    b.append("},\"fps\":{");
   184	    first = true;
   185	    for (Loom.Unit u : all.values()) {
   186	      for (Map.Entry<String, String> e : u.fps.entrySet()) {
   187	        if (!first) b.append(',');
   188	        first = false;
   189	        b.append(Bag.q(e.getKey())).append(':').append(Bag.q(e.getValue()));
   190	      }
   191	    }
   192	    b.append("},\"cites\":{");
   193	    first = true;
   194	    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {
   195	      if (!first) b.append(',');
   196	      first = false;
   197	      b.append(Bag.q(e.getKey())).append(":[").append(Bag.joinComma(e.getValue())).append(']');
   198	    }
   199	    b.append("}}");
   200	    Files.writeString(CACHE, b.toString());
   201	  }
   202	
   203	  static void writeLast(List<String> assayed, List<String[]> findings, String code) throws Exception {
   204	    Files.createDirectories(BLOT);
   205	    StringBuilder b = new StringBuilder();
   206	    b.append("{");
   207	    b.append("\"assayed\":[").append(Bag.joinComma(assayed)).append("],");
   208	    b.append("\"findings\":[");
   209	    for (int i = 0; i < findings.size(); i++) {
   210	      if (i > 0) b.append(',');
   211	      String[] f = findings.get(i);
   212	      b.append("{\"unit\":").append(Bag.q(f[0]));
   213	      b.append(",\"kind\":").append(Bag.q(f[1]));
   214	      b.append(",\"note\":").append(Bag.q(f[2])).append('}');
   215	    }
   216	    b.append("],\"code\":").append(Bag.q(code)).append('}');
   217	    Files.writeString(LAST, b.toString());
   218	  }
   219	
   220	  static int run(boolean all) throws Exception {
   221	    LinkedHashMap<String, Loom.Unit> units = Loom.load(ROOT);
   222	    Set<String> kn = known(units);
   223	    Map<String, Set<String>> cites = new LinkedHashMap<String, Set<String>>();
   224	    for (Loom.Unit u : units.values()) {
   225	      cites.put(u.path, Cite.tags(u.body, kn));
   226	    }
   227	    Map<String, String> oldFp = loadOldFp();
   228	    Map<String, String> newFp = fps(units);
   229	    LinkedHashSet<String> changedTypes = new LinkedHashSet<String>();
   230	    for (Map.Entry<String, String> e : newFp.entrySet()) {
   231	      String o = oldFp.get(e.getKey());
   232	      if (o == null || !o.equals(e.getValue())) changedTypes.add(e.getKey());
   233	    }
   234	    Map<String, String> oldHash = loadOldHash();
   235	    Set<String> changedFiles = hashChanged(units, oldHash);
   236	    List<String> pick;
   237	    if (all) {
   238	      pick = new ArrayList<String>(units.keySet());
   239	    } else {
   240	      pick = Sched.pick(changedFiles, importers(units), cites, changedTypes);
   241	    }
   242	    LinkedHashSet<String> analysed = new LinkedHashSet<String>();
   243	    analysed.addAll(pick);
   244	    ArrayList<String[]> findings = new ArrayList<String[]>();
   245	    ArrayList<String> hitUnits = new ArrayList<String>();
   246	    for (String p : analysed) {
   247	      Loom.Unit u = units.get(p);
   248	      if (u == null) continue;
   249	      cites.put(p, Cite.tags(u.body, kn));
   250	      for (String[] h : u.hits) {
   251	        findings.add(h);
   252	        hitUnits.add(h[0]);
   253	      }
   254	    }
   255	    writeCache(units, cites);
   256	    LinkedHashSet<String> must = new LinkedHashSet<String>();
   257	    for (Map.Entry<String, Set<String>> e : cites.entrySet()) {
   258	      for (String t : e.getValue()) {
   259	        if (changedTypes.contains(t)) must.add(e.getKey());
   260	      }
   261	    }
   262	    List<String> assayed = Seal.assayedOf(new ArrayList<String>(analysed), hitUnits);
   263	    String code = Seal.codeOf(new ArrayList<String>(analysed), hitUnits, must, floor());
   264	    writeLast(assayed, findings, code);
   265	    return Integer.parseInt(code);
   266	  }
   267	}
===== /app/seamcmd/Loom.java =====
     1	import java.nio.charset.StandardCharsets;
     2	import java.nio.file.*;
     3	import java.util.*;
     4	import java.util.regex.*;
     5	
     6	public class Loom {
     7	  public static class Unit {
     8	    public String path;
     9	    public String pkg;
    10	    public String body;
    11	    public String hash;
    12	    public LinkedHashSet<String> defined = new LinkedHashSet<String>();
    13	    public LinkedHashMap<String, String> fps = new LinkedHashMap<String, String>();
    14	    public LinkedHashSet<String> importedUnits = new LinkedHashSet<String>();
    15	    public ArrayList<String[]> hits = new ArrayList<String[]>();
    16	  }
    17	
    18	  static final Pattern IFACE = Pattern.compile("interface\\s+([A-Za-z_][A-Za-z0-9_]*)");
    19	  static final Pattern METH = Pattern.compile("void\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)");
    20	  static final Pattern CALL = Pattern.compile("\\.([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)");
    21	  static final Pattern IMP = Pattern.compile("import\\s+([A-Za-z_][A-Za-z0-9_.*]*);");
    22	  static final Pattern PKG = Pattern.compile("package\\s+([A-Za-z_][A-Za-z0-9_.]*);");
    23	
    24	  public static LinkedHashMap<String, Unit> load(Path root) throws Exception {
    25	    LinkedHashMap<String, Unit> all = new LinkedHashMap<String, Unit>();
    26	    if (!Files.exists(root)) return all;
    27	    Files.walk(root).filter(p -> p.toString().endsWith(".u")).sorted().forEach(p -> {
    28	      try {
    29	        Unit u = parse(root, p);
    30	        all.put(u.path, u);
    31	      } catch (Exception e) {
    32	        throw new RuntimeException(e);
    33	      }
    34	    });
    35	    resolveHits(all);
    36	    return all;
    37	  }
    38	
    39	  static Unit parse(Path root, Path p) throws Exception {
    40	    Unit u = new Unit();
    41	    u.path = root.relativize(p).toString().replace('\\', '/');
    42	    u.body = Files.readString(p);
    43	    u.hash = Bag.hex(u.body.getBytes(StandardCharsets.UTF_8));
    44	    Matcher pm = PKG.matcher(u.body);
    45	    u.pkg = pm.find() ? pm.group(1) : "";
    46	    Matcher im = IMP.matcher(u.body);
    47	    while (im.find()) {
    48	      String r = im.group(1);
    49	      if (r.endsWith(".*")) continue;
    50	      u.importedUnits.add(r.replace('.', '/') + ".u");
    51	    }
    52	    Matcher ic = IFACE.matcher(u.body);
    53	    LinkedHashMap<String, String> methods = new LinkedHashMap<String, String>();
    54	    String typeName = null;
    55	    if (ic.find()) {
    56	      typeName = ic.group(1);
    57	      u.defined.add(typeName);
    58	    }
    59	    Matcher mm = METH.matcher(u.body);
    60	    while (mm.find()) {
    61	      String name = mm.group(1);
    62	      String args = mm.group(2).trim();
    63	      int n = args.isEmpty() ? 0 : args.split(",").length;
    64	      methods.put(name, name + ":" + n);
    65	    }
    66	    if (typeName != null) {
    67	      ArrayList<String> parts = new ArrayList<String>(methods.values());
    68	      Collections.sort(parts);
    69	      StringBuilder fp = new StringBuilder();
    70	      for (int i = 0; i < parts.size(); i++) {
    71	        if (i > 0) fp.append(';');
    72	        fp.append(parts.get(i));
    73	      }
    74	      u.fps.put(typeName, fp.toString());
    75	    }
    76	    return u;
    77	  }
    78	
    79	  static void resolveHits(LinkedHashMap<String, Unit> all) {
    80	    LinkedHashMap<String, String> methArity = new LinkedHashMap<String, String>();
    81	    for (Unit u : all.values()) {
    82	      for (Map.Entry<String, String> e : u.fps.entrySet()) {
    83	        for (String part : e.getValue().split(";")) {
    84	          if (part.isEmpty()) continue;
    85	          methArity.put(e.getKey() + "#" + part.split(":")[0], part.split(":")[1]);
    86	        }
    87	      }
    88	    }
    89	    for (Unit u : all.values()) {
    90	      Matcher c = CALL.matcher(u.body);
    91	      while (c.find()) {
    92	        String name = c.group(1);
    93	        String args = c.group(2).trim();
    94	        int n = args.isEmpty() ? 0 : splitArgs(args);
    95	        for (Unit def : all.values()) {
    96	          for (String t : def.defined) {
    97	            String want = methArity.get(t + "#" + name);
    98	            if (want == null) continue;
    99	            if (Integer.parseInt(want) != n) {
   100	              u.hits.add(new String[] {u.path, "arity", name});
   101	            }
   102	          }
   103	        }
   104	      }
   105	    }
   106	  }
   107	
   108	  static int splitArgs(String args) {
   109	    int n = 1;
   110	    int depth = 0;
   111	    boolean q = false;
   112	    for (int i = 0; i < args.length(); i++) {
   113	      char ch = args.charAt(i);
   114	      if (ch == '"') q = !q;
   115	      else if (!q && ch == '(') depth++;
   116	      else if (!q && ch == ')') depth--;
   117	      else if (!q && depth == 0 && ch == ',') n++;
   118	    }
   119	    return n;
   120	  }
   121	}
===== /app/seamcmd/Bag.java =====
     1	import java.security.MessageDigest;
     2	import java.util.*;
     3	public class Bag {
     4	  public static String q(String s) {
     5	    StringBuilder b = new StringBuilder();
     6	    b.append('"');
     7	    for (int i = 0; i < s.length(); i++) {
     8	      char c = s.charAt(i);
     9	      if (c == '\\' || c == '"') b.append('\\');
    10	      b.append(c);
    11	    }
    12	    b.append('"');
    13	    return b.toString();
    14	  }
    15	  public static String hex(byte[] p) throws Exception {
    16	    MessageDigest md = MessageDigest.getInstance("SHA-256");
    17	    byte[] d = md.digest(p);
    18	    StringBuilder sb = new StringBuilder();
    19	    for (int i = 0; i < d.length; i++) {
    20	      int v = d[i] & 0xff;
    21	      if (v < 16) sb.append('0');
    22	      sb.append(Integer.toHexString(v));
    23	    }
    24	    return sb.toString();
    25	  }
    26	  public static String joinComma(Collection<String> xs) {
    27	    StringBuilder b = new StringBuilder();
    28	    boolean first = true;
    29	    for (String x : xs) {
    30	      if (!first) b.append(',');
    31	      first = false;
    32	      b.append(q(x));
    33	    }
    34	    return b.toString();
    35	  }
    36	}
