[95.788072, "i", "cd /app && rm -rf /tmp/refbox && /tmp/twinefuse.ref sew /app/cordbay/eve.yarn /tmp/refbox && cmp /app/dockurn/rows.ndjson /tmp/refbox/rows.ndjson && cmp /app/dockurn/hitch.idx /tmp/refbox/hitch.idx && python3 - <<'PY'\nimport json\n\ndef rows(path):\n    with open(path, encoding='utf-8') as f:\n        return [json.loads(x) for x in f]\ne = rows('/app/dockurn/rows.ndjson')\nm = rows('/app/dockurn/mornbox/rows.ndjson')\nassert [r['id'] for r in e] == [f'e{i:02d}' for i in range(1, 11)]\nassert [r['id'] for r in m] == [f'e{i:02d}' for i in range(10, 0, -1)]\nassert {r['id']: r['hitch'] for r in e} == {r['id']: r['hitch'] for r in m}\nassert all(r['hitch'] == min(x['tok'] for x in e if x['hitch'] == r['hitch']) or r['hitch'] == 't_b' for r in e)\nprint('reference and per-id checks: ok')\nPY\n"]
[95.788902, "o", "cd /app && rm -rf /tmp/refbox && /tmp/twinefuse.ref sew /app/cordbay/eve.yarn /tmp/refbox && cmp /app/dockurn/rows.ndjson /tmp/refbox/rows.ndjson && cmp /app/dockurn/hitch.idx /tmp/refbox/hitch.idx && python3 - <<'PY'\r\n\u001b[?2004l\r"]
[95.78915, "o", "\u001b[?2004h"]
[95.791569, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def rows(path):\r\n\u001b[?2004l\r\u001b[?2004h>     with open(path, encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         return [json.loads(x) for x in f]\r\n\u001b[?2004l\r\u001b[?2004h> e = rows('/app/dockurn/rows.ndjson')\r\n\u001b[?2004l\r\u001b[?2004h> m = rows('/app/dockurn/mornbox/rows.ndjson')\r\n\u001b[?2004l\r\u001b[?2004h> assert [r['id'] for r in e] == [f'e{i:02d}' for i in range(1, 11)]\r\n\u001b[?2004l\r\u001b[?2004h> assert [r['id'] for r in m] == [f'e{i:02d}' for i in range(10, 0, -1)]\r\n\u001b[?2004l\r\u001b[?2004h> assert {r['id']: r['hitch'] for r in e} == {r['id']: r['hitch'] for r in m}\r\n\u001b[?2004l\r\u001b[?2004h> assert all(r['hitch'] == min(x['tok'] for x in e if x['hitch'] == r['hitch']) or r['hitch'] == 't_b' for r in e)\r\n\u001b[?2004l\r\u001b[?2004h> print('reference and per-id checks: ok')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[95.861105, "o", "reference and per-id checks: ok\r\n"]
