[60.746079, "i", "cd /app && cat > netsrc/tie.go <<'EOF'\npackage netsrc\n\ntype Net struct {\n\tPar map[string]string\n\tSz  map[string]int\n}\n\nfunc NewNet() *Net {\n\treturn &Net{Par: map[string]string{}, Sz: map[string]int{}}\n}\n\nfunc (n *Net) Add(k string) {\n\tif _, ok := n.Par[k]; ok {\n\t\treturn\n\t}\n\tn.Par[k] = k\n\tn.Sz[k] = 1\n}\n\nfunc (n *Net) Find(k string) string {\n\tn.Add(k)\n\troot := k\n\tfor n.Par[root] != root {\n\t\troot = n.Par[root]\n\t}\n\tfor n.Par[k] != k {\n\t\tnext := n.Par[k]\n\t\tn.Par[k] = root\n\t\tk = next\n\t}\n\treturn root\n}\n\n// Join keeps the lexicographically least token as the component root. Go\n// string ordering is byte ordering, which is the required raw UTF-8 order.\nfunc (n *Net) Join(a, b string) {\n\tra, rb := n.Find(a), n.Find(b)\n\tif ra == rb {\n\t\treturn\n\t}\n\tif rb < ra {\n\t\tra, rb = rb, ra\n\t}\n\tn.Par[rb] = ra\n\tn.Sz[ra] += n.Sz[rb]\n\tdelete(n.Sz, rb)\n}\n\nfunc OpTie(toks []string) *Net {\n\tn := NewNet()\n\tfor _, t := range toks {\n\t\tn.Add(t)\n\t}\n\treturn n\n}\n\nfunc OpMark(n *Net, tok string) string {\n\treturn n.Find(tok)\n}\nEOF\ncat > cardpit/pair.go <<'EOF'\npackage cardpit\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"berth.local/twinefuse/netsrc\"\n)\n\nfunc NPair(dir string, n *netsrc.Net) error {\n\tents, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor _, ent := range ents {\n\t\tif ent.IsDir() || !strings.HasSuffix(ent.Name(), \".cue\") {\n\t\t\tcontinue\n\t\t}\n\t\tbody, err := os.ReadFile(filepath.Join(dir, ent.Name()))\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tleft, right, origin := \"\", \"\", \"\"\n\t\tfor _, raw := range strings.Split(string(body), \"\\n\") {\n\t\t\tline := strings.TrimSpace(raw)\n\t\t\tif line == \"\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tk, v, ok := strings.Cut(line, \"=\")\n\t\t\tif !ok {\n\t\t\t\treturn fmt.Errorf(\"%s: malformed pair line\", ent.Name())\n\t\t\t}\n\t\t\tswitch strings.TrimSpace(k) {\n\t\t\tcase \"left\":\n\t\t\t\tleft = strings.TrimSpace(v)\n\t\t\tcase \"right\":\n\t\t\t\tright = strings.TrimSpace(v)\n\t\t\tcase \"origin\":\n\t\t\t\torigin = strings.TrimSpace(v)\n\t\t\t}\n\t\t}\n\t\tif origin == \"scrapped\" {\n\t\t\treturn fmt.Errorf(\"%s: scrapped origin\", ent.Name())\n\t\t}\n\t\tif left == \"\" || right == \"\" || origin == \"\" {\n\t\t\treturn fmt.Errorf(\"%s: incomplete pair\", ent.Name())\n\t\t}\n\t\tn.Join(left, right)\n\t}\n\treturn nil\n}\nEOF\ncat > readcue/scan.go <<'EOF'\npackage readcue\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n)\n\ntype Rec struct {\n\tId  string\n\tTok string\n}\n\nfunc Scan(path string) ([]Rec, error) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\n\tvar out []Rec\n\ts := bufio.NewScanner(f)\n\tlineNo := 0\n\tfor s.Scan() {\n\t\tlineNo++\n\t\tline := strings.TrimSuffix(s.Text(), \"\\r\")\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tid, tok, ok := strings.Cut(line, \" \")\n\t\tif !ok || id == \"\" || tok == \"\" || strings.Contains(tok, \" \") || strings.ContainsAny(id+tok, \"\\t\\r\\n\") {\n\t\t\treturn nil, fmt.Errorf(\"%s:%d: malformed yarn line\", path, lineNo)\n\t\t}\n\t\tout = append(out, Rec{Id: id, Tok: tok})\n\t}\n\tif err := s.Err(); err != nil {\n\t\treturn nil, err\n\t}\n\treturn out, nil\n}\nEOF\n"]
[60.746375, "o", "cd /app && cat > netsrc/tie.go <<'EOF'\r\n\u001b[?2004l\r"]
