[8.753594, "i", "cat /app/millnote/LAY.txt; printf '\\n--- ROUTE ---\\n'; cat /app/millnote/ROUTE.txt; printf '\\n--- HULL ---\\n'; cat /app/millnote/HULL.txt\n"]
[8.754552, "o", "cat /app/millnote/LAY.txt; printf '\\n--- ROUTE ---\\n'; cat /app/millnote/ROUTE.txt; printf '\\n--- HULL ---\\n'; cat /app/millnote/HULL.txt\r\n\u001b[?2004l\r"]
[8.75628, "o", "rows.ndjson: one JSON object per dump row, dump order. Keys are id, hitch, tok (strings).\r\nhitch.idx: one line per hitch token. Token, then a single space, then a comma-joined id list sorted by id bytes. Lines sorted by hitch bytes.\r\nThe hitch token on every row of a group is the least token among tokens in that group, compared as raw UTF-8 bytes. Pair files contribute tokens to the same group.\r\nberth.ok: bytes o k newline after a successful sew.\r\n"]
[8.758364, "o", "\r\n--- ROUTE ---\r\n"]
[8.759548, "o", "berthcli — sew CLI\r\nreadcue — yarn scan\r\nnetsrc — token net\r\ncardpit — pair load\r\nwalkbind — dockurn write\r\nribdrop — size table\r\nhull.sh — mill link\r\n"]
[8.75976, "o", "\r\n--- HULL ---\r\n"]
[8.760861, "o", "Link the mill with /app/hull.sh after source edits. The agent binary is /app/bin/twinefuse.\r\nA throwaway mill is go build -o /tmp/twinefuse.ref berth.local/twinefuse/berthcli from /app.\r\nAgent /app/bin/twinefuse must sew the same rows.ndjson and hitch.idx as /tmp/twinefuse.ref.\r\nDo not copy that throwaway over the agent mill.\r\n"]
[8.761047, "o", "\u001b[?2004h"]
[8.761142, "o", "root@a9dba3f4659b:/app# "]
[9.003053, "i", "printf '\\n--- tree ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort\n"]
