[16.819866, "o", "     1\tpackage ribdrop\r\n     2\t\r\n     3\t// Rank builds a size table after join. Equal sizes share one bin.\r\n     4\tfunc Rank(sz map[string]int) map[int]int {\r\n     5\t\tout := map[int]int{}\r\n     6\t\tfor _, n := range sz {\r\n     7\t\t\tout[n]++\r\n     8\t\t}\r\n     9\t\treturn out\r\n    10\t}\r\n"]
