[16.792887, "o", "===== go.mod =====\r\n"]
[16.795425, "o", "     1\tmodule berth.local/twinefuse\r\n     2\t\r\n     3\tgo 1.24\r\n"]
[16.795575, "o", "===== hull.sh =====\r\n"]
[16.79828, "o", "     1\t#!/bin/bash\r\n     2\tset -euo pipefail\r\n     3\tcd /app\r\n     4\tmkdir -p /app/bin /app/dockurn\r\n     5\tgo build -o /app/bin/twinefuse berth.local/twinefuse/berthcli\r\n===== millnote/CLI.txt =====\r\n"]
[16.800172, "o", "     1\tsew YARN OUTDIR\r\n     2\tWrites OUTDIR/rows.ndjson, OUTDIR/hitch.idx, and OUTDIR/berth.ok on success.\r\n     3\tPair files are read from /app/aliascue.\r\n"]
[16.800909, "o", "===== millnote/forms.txt =====\r\n"]
[16.802272, "o", "     1\tYarn line: id then a single space then tok.\r\n     2\tPair file (.cue): left=, right=, origin= lines. origin desk is live. origin scrapped is refused.\r\n"]
[16.804046, "o", "===== berthcli/main.go =====\r\n"]
[16.805434, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"os\"\r\n     5\t)\r\n     6\t\r\n     7\tfunc main() {\r\n     8\t\tif len(os.Args) < 2 {\r\n     9\t\t\tos.Exit(2)\r\n    10\t\t}\r\n    11\t\tswitch os.Args[1] {\r\n    12\t\tcase \"sew\":\r\n    13\t\t\tif len(os.Args) < 4 {\r\n    14\t\t\t\tos.Exit(2)\r\n"]
[16.80562, "o", "    15\t\t\t}\r\n    16\t\t\tos.Exit(runSew(os.Args[2], os.Args[3]))\r\n    17\t\tdefault:\r\n    18\t\t\tos.Exit(2)\r\n    19\t\t}\r\n    20\t}\r\n"]
[16.805874, "o", "===== berthcli/sew.go =====\r\n"]
[16.807031, "o", "     1\tpackage main\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"os\"\r\n     5\t\t\"path/filepath\"\r\n     6\t\r\n     7\t\t\"berth.local/twinefuse/cardpit\"\r\n     8\t\t\"berth.local/twinefuse/netsrc\"\r\n     9\t\t\"berth.local/twinefuse/readcue\"\r\n    10\t\t\"berth.local/twinefuse/ribdrop\"\r\n    11\t\t\"berth.local/twinefuse/walkbind\"\r\n    12\t)\r\n    13\t\r\n    14\tfunc runSew(dump, out string) int {\r\n    15\t\trecs, err := readcue.Scan(dump)\r\n    16\t\tif err != nil {\r\n"]
[16.807101, "o", "    17\t\t\treturn 1\r\n    18\t\t}\r\n    19\t\ttoks := make([]string, 0, len(recs))\r\n    20\t\tfor _, rec := range recs {\r\n    21\t\t\ttoks = append(toks, rec.Tok)\r\n    22\t\t}\r\n    23\t\tnet := netsrc.OpTie(toks)\r\n    24\t\t_ = ribdrop.Rank(net.Sz)\r\n    25\t\tif err := cardpit.NPair(\"/app/aliascue\", net); err != nil {\r\n    26\t\t\t_ = os.Remove(filepath.Join(out, \"berth.ok\"))\r\n    27\t\t\treturn 1\r\n    28\t\t}\r\n    29\t\trows := readcue.Attach(recs, net)\r\n    30\t\tif err := walkbind.CfgStamp(out, rows); err != nil {\r\n    31\t\t\treturn 1\r\n    32\t\t}\r\n    33\t\treturn 0\r\n    34\t}\r\n"]
[16.80749, "o", "===== readcue/attach.go =====\r\n"]
[16.808901, "o", "     1\tpackage readcue\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"berth.local/twinefuse/netsrc\"\r\n     5\t\t\"berth.local/twinefuse/walkbind\"\r\n     6\t)\r\n     7\t\r\n     8\tfunc Attach(recs []Rec, n *netsrc.Net) []walkbind.Row {\r\n     9\t\trows := make([]walkbind.Row, 0, len(recs))\r\n    10\t\tfor _, rec := range recs {\r\n    11\t\t\trows = append(rows, walkbind.Row{\r\n    12\t\t\t\tId:    rec.Id,\r\n    13\t\t\t\tHitch: netsrc.OpMark(n, rec.Tok),\r\n    14\t\t\t\tTok:   rec.Tok,"]
[16.809093, "o", "\r\n    15\t\t\t})\r\n    16\t\t}\r\n    17\t\treturn rows\r\n    18\t}\r\n"]
[16.809404, "o", "===== readcue/scan.go =====\r\n"]
[16.810493, "o", "     1\tpackage readcue\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"os\"\r\n     5\t\t\"strings\"\r\n     6\t)\r\n     7\t\r\n     8\ttype Rec struct {\r\n     9\t\tId  string\r\n    10\t\tTok string\r\n    11\t}\r\n    12\t\r\n    13\tfunc Scan(path string) ([]Rec, error) {\r\n    14\t\tbody, err := os.ReadFile(path)\r\n    15\t\tif err != nil {\r\n    16\t\t\treturn nil, err\r\n"]
[16.810676, "o", "    17\t\t}\r\n    18\t\tvar out []Rec\r\n    19\t\tfor _, line := range strings.Split(string(body), \"\\n\") {\r\n    20\t\t\tline = strings.TrimSpace(line)\r\n    21\t\t\tif line == \"\" {\r\n    22\t\t\t\tcontinue\r\n    23\t\t\t}\r\n    24\t\t\tid, tok, ok := strings.Cut(line, \" \")\r\n    25\t\t\tif !ok {\r\n    26\t\t\t\tcontinue\r\n    27\t\t\t}\r\n    28\t\t\tout = append(out, Rec{Id: strings.TrimSpace(id), Tok: strings.TrimSpace(tok)})\r\n    29\t\t}\r\n    30\t\treturn out, nil\r\n    31\t}\r\n"]
[16.810811, "o", "===== netsrc/tie.go =====\r\n"]
[16.812066, "o", "     1\tpackage netsrc\r\n     2\t\r\n     3\ttype Net struct {\r\n     4\t\tPar map[string]string\r\n     5\t\tSz  map[string]int\r\n     6\t}\r\n     7\t\r\n     8\tfunc NewNet() *Net {\r\n     9\t\treturn &Net{Par: map[string]string{}, Sz: map[string]int{}}\r\n    10\t}\r\n    11\t\r\n    12\tfunc (n *Net) Add(k string) {\r\n    13\t\tif _, ok := n.Par[k]; ok {\r\n    14\t\t\treturn\r\n    15\t\t}\r\n    16\t\tn.Par[k] = k\r\n    17\t\tn.Sz[k] = 1\r\n    18\t}\r\n    19\t\r\n    20\tfunc (n *Net) Find(k string) string {\r\n    21\t\tn.Add(k)\r\n    22\t\tfor n.Par[k] != k {\r\n    23\t\t\tn.Par[k] = n.Par[n.Par[k]]\r\n    24\t\t\tk = n.Par[k]\r\n    25\t\t}\r\n    26\t\treturn k\r\n    27\t}\r\n    28\t\r\n    29\tfunc (n *Net) Join(a, b string) {\r\n    30\t\tra, rb := n.Find(a), n.Find(b)\r\n    31\t\tif ra == rb {\r\n    32\t\t\treturn\r\n    33\t\t}\r\n    34\t\tif n.Sz[ra] < n.Sz[rb] {\r\n    35\t\t\tra, rb = rb, ra\r\n    36\t\t}\r\n    37\t\tn.Par[rb] = ra\r\n    38\t\tn.Sz[ra] += n.Sz[rb]\r\n    39\t}\r\n    40\t\r\n    41\tfunc OpTie(toks []string) *Net {\r\n    42\t\tn := NewNet()\r\n    43\t\tfor _, t := range toks {\r\n    44\t\t\tn.Add(t)\r\n    45\t\t}\r\n    46\t\treturn n\r\n    47\t}\r\n    48\t\r\n    49\tfunc OpMark(n *Net, tok string) string {\r\n    50\t\treturn n.Find(tok)\r\n    51\t}\r\n"]
[16.81239, "o", "===== cardpit/pair.go =====\r\n"]
[16.814481, "o", "     1\tpackage cardpit\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"os\"\r\n     5\t\t\"path/filepath\"\r\n     6\t\t\"strings\"\r\n     7\t\r\n     8\t\t\"berth.local/twinefuse/netsrc\"\r\n     9\t)\r\n    10\t\r\n    11\tfunc NPair(dir string, n *netsrc.Net) error {\r\n    12\t\tents, err := os.ReadDir(dir)\r\n"]
[16.814988, "o", "    13\t\tif err != nil {\r\n    14\t\t\treturn err\r\n    15\t\t}\r\n    16\t\tfor _, ent := range ents {\r\n    17\t\t\tif ent.IsDir() || !strings.HasSuffix(ent.Name(), \".cue\") {\r\n    18\t\t\t\tcontinue\r\n    19\t\t\t}\r\n    20\t\t\tbody, err := os.ReadFile(filepath.Join(dir, ent.Name()))\r\n    21\t\t\tif err != nil {\r\n    22\t\t\t\treturn err\r\n    23\t\t\t}\r\n    24\t\t\tleft, right, origin := \"\", \"\", \"\"\r\n    25\t\t\tfor _, line := range strings.Split(string(body), \"\\n\") {\r\n    26\t\t\t\tline = strings.TrimSpace(line)\r\n    27\t\t\t\tif line == \"\" || !strings.Contains(line, \"=\") {\r\n    28\t\t\t\t\tcontinue\r\n    29\t\t\t\t}\r\n"]
[16.815068, "o", "    30\t\t\t\tk, v, _ := strings.Cut(line, \"=\")\r\n    31\t\t\t\tk = strings.TrimSpace(k)\r\n    32\t\t\t\tv = strings.TrimSpace(v)\r\n    33\t\t\t\tswitch k {\r\n    34\t\t\t\tcase \"left\":\r\n    35\t\t\t\t\tleft = v\r\n    36\t\t\t\tcase \"right\":\r\n    37\t\t\t\t\tright = v\r\n    38\t\t\t\tcase \"origin\":\r\n    39\t\t\t\t\torigin = v\r\n    40\t\t\t\t}\r\n    41\t\t\t}\r\n    42\t\t\tif origin == \"scrapped\" {\r\n    43\t\t\t\tcontinue\r\n    44\t\t\t}\r\n    45\t\t\tif left != \"\" {\r\n    46\t\t\t\tn.Add(left)\r\n    47\t\t\t}\r\n    48\t\t\t_ = right\r\n    49\t\t}\r\n    50\t\treturn nil\r\n    51\t}\r\n"]
[16.816094, "o", "===== walkbind/stamp.go =====\r\n"]
[16.817574, "o", "     1\tpackage walkbind\r\n     2\t\r\n     3\timport (\r\n     4\t\t\"encoding/json\"\r\n     5\t\t\"os\"\r\n     6\t\t\"path/filepath\"\r\n     7\t)\r\n     8\t\r\n     9\ttype Row struct {\r\n"]
[16.817947, "o", "    10\t\tId    string `json:\"id\"`\r\n    11\t\tHitch string `json:\"hitch\"`\r\n    12\t\tTok   string `json:\"tok\"`\r\n    13\t}\r\n    14\t\r\n    15\tfunc CfgStamp(outDir string, rows []Row) error {\r\n    16\t\tif err := os.MkdirAll(outDir, 0o755); err != nil {\r\n    17\t\t\treturn err\r\n    18\t\t}\r\n    19\t\tbyID := map[string]Row{}\r\n    20\t\tfor _, row := range rows {\r\n    21\t\t\tbyID[row.Id] = row\r\n    22\t\t}\r\n    23\t\trf, err := os.Create(filepath.Join(outDir, \"rows.ndjson\"))\r\n    24\t\tif err != nil {\r\n    25\t\t\treturn err\r\n    26\t\t}\r\n    27\t\tenc := json.NewEncoder(rf)\r\n    28\t\tenc.SetEscapeHTML(false)\r\n    29\t\tfor _, row := range byID {\r\n    30\t\t\tif err := enc.Encode(row); err != nil {\r\n    31\t\t\t\trf.Close()\r\n    32\t\t\t\treturn err\r\n    33\t\t\t}\r\n    34\t\t}\r\n    35\t\tif err := rf.Close(); err != nil {\r\n    36\t\t\treturn err\r\n    37\t\t}\r\n    38\t\tgroups := map[string][]string{}\r\n    39\t\tfor _, row := range byID {\r\n    40\t\t\tgroups[row.Hitch] = append(groups[row.Hitch], row.Id)\r\n    41\t\t}\r\n    42\t\txf, err := os.Create(filepath.Join(outDir, \"hitch.idx\"))\r\n    43\t\tif err != nil {\r\n    44\t\t\treturn err\r\n    45\t\t}\r\n    46\t\tfor h, ids := range groups {\r\n    47\t\t\tline := h + \" \" + stringsJoin(ids, \",\") + \"\\n\"\r\n    48\t\t\tif _, err := xf.WriteString(line); err != nil {\r\n    49\t\t\t\txf.Close()\r\n    50\t\t\t\treturn err\r\n    51\t\t\t}\r\n    52\t\t}\r\n    53\t\tif err := xf.Close(); err != nil {\r\n    54\t\t\treturn err\r\n    55\t\t}\r\n    56\t\treturn os.WriteFile(filepath.Join(outDir, \"berth.ok\"), []byte(\"ok\\n\"), 0o644)\r\n    57\t}\r\n    58\t\r\n    59\tfunc stringsJoin(ids []string, sep string) string {\r\n    60\t\tif len(ids) == 0 {\r\n    61\t\t\treturn \"\"\r\n    62\t\t}\r\n    63\t\tout := ids[0]\r\n    64\t\tfor i := 1; i < len(ids); i++ {\r\n    65\t\t\tout += sep + ids[i]\r\n    66\t\t}\r\n    67\t\treturn out\r\n    68\t}\r\n"]
