[60.98869, "o", "gofmt -w berthcli readcue netsrc cardpit walkbind ribdrop && sed -n '1,100p' berthcli/sew.go\r\n\u001b[?2004l\r"]
[60.994093, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\r\n\t\"berth.local/twinefuse/cardpit\"\r\n\t\"berth.local/twinefuse/netsrc\"\r\n\t\"berth.local/twinefuse/readcue\"\r\n\t\"berth.local/twinefuse/ribdrop\"\r\n\t\"berth.local/twinefuse/walkbind\"\r\n)\r\n\r\nfunc runSew(dump, out string) int {\r\n\tmarker := filepath.Join(out, \"berth.ok\")\r\n\t_ = os.Remove(marker)\r\n\tsucceeded := false\r\n\tdefer func() {\r\n\t\tif !succeeded {\r\n\t\t\t_ = os.Remove(marker)\r\n\t\t}\r\n\t}()\r\n\trecs, err := readcue.Scan(dump)\r\n\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\ttoks := make([]string, 0, len(recs))\r\n\tfor _, rec := range recs {\r\n\t\ttoks = append(toks, rec.Tok)\r\n\t}\r\n\tnet := netsrc.OpTie(toks)\r\n\t_ = ribdrop.Rank(net.Sz)\r\n\tif err := cardpit.NPair(\"/app/aliascue\", net); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\trows := readcue.Attach(recs, net)\r\n\tif err := walkbind.CfgStamp(out, rows); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\tsucceeded = true\r\n\treturn 0\r\n}\r\n"]
[60.994441, "o", "\u001b[?2004hroot@a9dba3f4659b:/app# "]
[61.201148, "i", "cd /app && go test ./... && ./hull.sh && go build -o /tmp/twinefuse.ref berth.local/twinefuse/berthcli\n"]
