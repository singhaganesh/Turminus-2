[60.933321, "i", "cd /app && cat > walkbind/stamp.go <<'EOF'\npackage walkbind\n\nimport (\n\t\"bufio\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\ntype Row struct {\n\tId    string `json:\"id\"`\n\tHitch string `json:\"hitch\"`\n\tTok   string `json:\"tok\"`\n}\n\nfunc CfgStamp(outDir string, rows []Row) error {\n\tif err := os.MkdirAll(outDir, 0o755); err != nil {\n\t\treturn err\n\t}\n\n\t// Rows are emitted in dump order exactly as supplied.\n\trf, err := os.Create(filepath.Join(outDir, \"rows.ndjson\"))\n\tif err != nil {\n\t\treturn err\n\t}\n\tenc := json.NewEncoder(rf)\n\tenc.SetEscapeHTML(false)\n\tfor _, row := range rows {\n\t\tif err := enc.Encode(row); err != nil {\n\t\t\trf.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := rf.Close(); err != nil {\n\t\treturn err\n\t}\n\n\t// An index entry is an ID set: deduplicate IDs, then sort by bytes.\n\tgroups := make(map[string]map[string]struct{})\n\tfor _, row := range rows {\n\t\tif groups[row.Hitch] == nil {\n\t\t\tgroups[row.Hitch] = make(map[string]struct{})\n\t\t}\n\t\tgroups[row.Hitch][row.Id] = struct{}{}\n\t}\n\thitches := make([]string, 0, len(groups))\n\tfor hitch := range groups {\n\t\thitches = append(hitches, hitch)\n\t}\n\tsort.Strings(hitches)\n\n\txf, err := os.Create(filepath.Join(outDir, \"hitch.idx\"))\n\tif err != nil {\n\t\treturn err\n\t}\n\tbw := bufio.NewWriter(xf)\n\tfor _, hitch := range hitches {\n\t\tids := make([]string, 0, len(groups[hitch]))\n\t\tfor id := range groups[hitch] {\n\t\t\tids = append(ids, id)\n\t\t}\n\t\tsort.Strings(ids)\n\t\tif _, err := bw.WriteString(hitch + \" \" + strings.Join(ids, \",\") + \"\\n\"); err != nil {\n\t\t\txf.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := bw.Flush(); err != nil {\n\t\txf.Close()\n\t\treturn err\n\t}\n\tif err := xf.Close(); err != nil {\n\t\treturn err\n\t}\n\n\t// The marker is deliberately the final successful write.\n\treturn os.WriteFile(filepath.Join(outDir, \"berth.ok\"), []byte(\"ok\\n\"), 0o644)\n}\nEOF\npython3 - <<'PY'\np='/app/berthcli/sew.go'\ns=open(p).read()\ns=s.replace('func runSew(dump, out string) int {\\n', 'func runSew(dump, out string) int {\\n\\tmarker := filepath.Join(out, \"berth.ok\")\\n\\t_ = os.Remove(marker)\\n\\tsucceeded := false\\n\\tdefer func() {\\n\\t\\tif !succeeded {\\n\\t\\t\\t_ = os.Remove(marker)\\n\\t\\t}\\n\\t}()\\n')\ns=s.replace('\\t\\t_ = os.Remove(filepath.Join(out, \"berth.ok\"))\\n', '')\ns=s.replace('\\treturn 0\\n}', '\\tsucceeded = true\\n\\treturn 0\\n}')\nopen(p,'w').write(s)\nPY\ngofmt -w berthcli readcue netsrc cardpit walkbind ribdrop && sed -n '1,100p' berthcli/sew.go\n"]
