[96.817145, "i", "cd /app && cat > aliascue/scrap-test.cue <<'EOF'\nleft=t_a\nright=t_r\norigin=scrapped\nEOF\nset +e\n/app/bin/twinefuse sew /app/cordbay/eve.yarn /app/dockurn\nrc=$?\nset -e\nif [ \"$rc\" -eq 0 ]; then echo 'ERROR: scrapped cue was accepted' >&2; rm -f aliascue/scrap-test.cue; exit 1; fi\nif [ -e /app/dockurn/berth.ok ]; then echo 'ERROR: berth.ok survived failed sew' >&2; rm -f aliascue/scrap-test.cue; exit 1; fi\necho \"scrapped rejection: ok (exit $rc)\"\nrm -f aliascue/scrap-test.cue\n/app/bin/twinefuse sew /app/cordbay/eve.yarn /app/dockurn\n/app/bin/twinefuse sew /app/cordbay/morn.yarn /app/dockurn/mornbox\n"]
