===== berthcli/sew.go =====
     1	package main
     2	
     3	import (
     4		"os"
     5		"path/filepath"
     6	
     7		"berth.local/twinefuse/cardpit"
     8		"berth.local/twinefuse/netsrc"
     9		"berth.local/twinefuse/readcue"
    10		"berth.local/twinefuse/ribdrop"
    11		"berth.local/twinefuse/walkbind"
    12	)
    13	
    14	func runSew(dump, out string) int {
    15		recs, err := readcue.Scan(dump)
    16		if err != nil {
    17			return 1
    18		}
    19		toks := make([]string, 0, len(recs))
    20		for _, rec := range recs {
    21			toks = append(toks, rec.Tok)
    22		}
    23		net := netsrc.OpTie(toks)
    24		_ = ribdrop.Rank(net.Sz)
    25		if err := cardpit.NPair("/app/aliascue", net); err != nil {
    26			_ = os.Remove(filepath.Join(out, "berth.ok"))
    27			return 1
    28		}
    29		rows := readcue.Attach(recs, net)
    30		if err := walkbind.CfgStamp(out, rows); err != nil {
    31			return 1
    32		}
    33		return 0
    34	}
===== readcue/attach.go =====
     1	package readcue
     2	
     3	import (
     4		"berth.local/twinefuse/netsrc"
     5		"berth.local/twinefuse/walkbind"
     6	)
     7	
     8	func Attach(recs []Rec, n *netsrc.Net) []walkbind.Row {
     9		rows := make([]walkbind.Row, 0, len(recs))
    10		for _, rec := range recs {
    11			rows = append(rows, walkbind.Row{
    12				Id:    rec.Id,
    13				Hitch: netsrc.OpMark(n, rec.Tok),
    14				Tok:   rec.Tok,
    15			})
    16		}
    17		return rows
    18	}
===== readcue/scan.go =====
     1	package readcue
     2	
     3	import (
     4		"os"
     5		"strings"
     6	)
     7	
     8	type Rec struct {
     9		Id  string
    10		Tok string
    11	}
    12	
    13	func Scan(path string) ([]Rec, error) {
    14		body, err := os.ReadFile(path)
    15		if err != nil {
    16			return nil, err
    17		}
    18		var out []Rec
    19		for _, line := range strings.Split(string(body), "\n") {
    20			line = strings.TrimSpace(line)
    21			if line == "" {
    22				continue
    23			}
    24			id, tok, ok := strings.Cut(line, " ")
    25			if !ok {
    26				continue
    27			}
    28			out = append(out, Rec{Id: strings.TrimSpace(id), Tok: strings.TrimSpace(tok)})
    29		}
    30		return out, nil
    31	}
===== netsrc/tie.go =====
     1	package netsrc
     2	
     3	type Net struct {
     4		Par map[string]string
     5		Sz  map[string]int
     6	}
     7	
     8	func NewNet() *Net {
     9		return &Net{Par: map[string]string{}, Sz: map[string]int{}}
    10	}
    11	
    12	func (n *Net) Add(k string) {
    13		if _, ok := n.Par[k]; ok {
    14			return
    15		}
    16		n.Par[k] = k
    17		n.Sz[k] = 1
    18	}
    19	
    20	func (n *Net) Find(k string) string {
    21		n.Add(k)
    22		for n.Par[k] != k {
    23			n.Par[k] = n.Par[n.Par[k]]
    24			k = n.Par[k]
    25		}
    26		return k
    27	}
    28	
    29	func (n *Net) Join(a, b string) {
    30		ra, rb := n.Find(a), n.Find(b)
    31		if ra == rb {
    32			return
    33		}
    34		if n.Sz[ra] < n.Sz[rb] {
    35			ra, rb = rb, ra
    36		}
    37		n.Par[rb] = ra
    38		n.Sz[ra] += n.Sz[rb]
    39	}
    40	
    41	func OpTie(toks []string) *Net {
    42		n := NewNet()
    43		for _, t := range toks {
    44			n.Add(t)
    45		}
    46		return n
    47	}
    48	
    49	func OpMark(n *Net, tok string) string {
    50		return n.Find(tok)
    51	}
===== cardpit/pair.go =====
     1	package cardpit
     2	
     3	import (
     4		"os"
     5		"path/filepath"
     6		"strings"
     7	
     8		"berth.local/twinefuse/netsrc"
     9	)
    10	
    11	func NPair(dir string, n *netsrc.Net) error {
    12		ents, err := os.ReadDir(dir)
    13		if err != nil {
    14			return err
    15		}
    16		for _, ent := range ents {
    17			if ent.IsDir() || !strings.HasSuffix(ent.Name(), ".cue") {
    18				continue
    19			}
    20			body, err := os.ReadFile(filepath.Join(dir, ent.Name()))
    21			if err != nil {
    22				return err
    23			}
    24			left, right, origin := "", "", ""
    25			for _, line := range strings.Split(string(body), "\n") {
    26				line = strings.TrimSpace(line)
    27				if line == "" || !strings.Contains(line, "=") {
    28					continue
    29				}
    30				k, v, _ := strings.Cut(line, "=")
    31				k = strings.TrimSpace(k)
    32				v = strings.TrimSpace(v)
    33				switch k {
    34				case "left":
    35					left = v
    36				case "right":
    37					right = v
    38				case "origin":
    39					origin = v
    40				}
    41			}
    42			if origin == "scrapped" {
    43				continue
    44			}
    45			if left != "" {
    46				n.Add(left)
    47			}
    48			_ = right
    49		}
    50		return nil
    51	}
===== walkbind/stamp.go =====
     1	package walkbind
     2	
     3	import (
     4		"encoding/json"
     5		"os"
     6		"path/filepath"
     7	)
     8	
     9	type Row struct {
    10		Id    string `json:"id"`
    11		Hitch string `json:"hitch"`
    12		Tok   string `json:"tok"`
    13	}
    14	
    15	func CfgStamp(outDir string, rows []Row) error {
    16		if err := os.MkdirAll(outDir, 0o755); err != nil {
    17			return err
    18		}
    19		byID := map[string]Row{}
    20		for _, row := range rows {
    21			byID[row.Id] = row
    22		}
    23		rf, err := os.Create(filepath.Join(outDir, "rows.ndjson"))
    24		if err != nil {
    25			return err
    26		}
    27		enc := json.NewEncoder(rf)
    28		enc.SetEscapeHTML(false)
    29		for _, row := range byID {
    30			if err := enc.Encode(row); err != nil {
    31				rf.Close()
    32				return err
    33			}
    34		}
    35		if err := rf.Close(); err != nil {
    36			return err
    37		}
    38		groups := map[string][]string{}
    39		for _, row := range byID {
    40			groups[row.Hitch] = append(groups[row.Hitch], row.Id)
    41		}
    42		xf, err := os.Create(filepath.Join(outDir, "hitch.idx"))
    43		if err != nil {
    44			return err
    45		}
    46		for h, ids := range groups {
    47			line := h + " " + stringsJoin(ids, ",") + "\n"
    48			if _, err := xf.WriteString(line); err != nil {
    49				xf.Close()
    50				return err
    51			}
    52		}
    53		if err := xf.Close(); err != nil {
    54			return err
    55		}
    56		return os.WriteFile(filepath.Join(outDir, "berth.ok"), []byte("ok\n"), 0o644)
    57	}
    58	
    59	func stringsJoin(ids []string, sep string) string {
    60		if len(ids) == 0 {
    61			return ""
    62		}
    63		out := ids[0]
    64		for i := 1; i < len(ids); i++ {
    65			out += sep + ids[i]
    66		}
    67		return out
    68	}
===== ribdrop/rank.go =====
     1	package ribdrop
     2	
     3	// Rank builds a size table after join. Equal sizes share one bin.
     4	func Rank(sz map[string]int) map[int]int {
     5		out := map[int]int{}
     6		for _, n := range sz {
     7			out[n]++
     8		}
     9		return out
    10	}
