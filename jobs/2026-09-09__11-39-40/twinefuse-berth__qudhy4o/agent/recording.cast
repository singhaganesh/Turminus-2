[47.778917, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('netsrc/tie.go')\ns=p.read_text()\nstart=s.index('func (n *Net) Join')\nend=s.index('\\nfunc OpTie', start)\ns=s[:start]+'''func (n *Net) Join(a, b string) {\n\\tra, rb := n.Find(a), n.Find(b)\n\\tif ra == rb {\n\\t\\treturn\n\\t}\n\\t// A group's root is its least token by raw UTF-8 bytes. Go string\n\\t// comparison is bytewise, so this is independent of input/pair order.\n\\tif rb < ra {\n\\t\\tra, rb = rb, ra\n\\t}\n\\tn.Par[rb] = ra\n\\tn.Sz[ra] += n.Sz[rb]\n\\tdelete(n.Sz, rb)\n}\n'''+s[end:]\np.write_text(s)\nPY\ncat > cardpit/pair.go <<'EOF'\npackage cardpit\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"berth.local/twinefuse/netsrc\"\n)\n\nfunc NPair(dir string, n *netsrc.Net) error {\n\tents, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor _, ent := range ents {\n\t\tif ent.IsDir() || !strings.HasSuffix(ent.Name(), \".cue\") {\n\t\t\tcontinue\n\t\t}\n\t\tpath := filepath.Join(dir, ent.Name())\n\t\tbody, err := os.ReadFile(path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tleft, right, origin := \"\", \"\", \"\"\n\t\tfor _, line := range strings.Split(string(body), \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif line == \"\" || !strings.Contains(line, \"=\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tk, v, _ := strings.Cut(line, \"=\")\n\t\t\tswitch strings.TrimSpace(k) {\n\t\t\tcase \"left\":\n\t\t\t\tleft = strings.TrimSpace(v)\n\t\t\tcase \"right\":\n\t\t\t\tright = strings.TrimSpace(v)\n\t\t\tcase \"origin\":\n\t\t\t\torigin = strings.TrimSpace(v)\n\t\t\t}\n\t\t}\n\t\tif origin == \"scrapped\" {\n\t\t\treturn fmt.Errorf(\"refusing scrapped pair %s\", path)\n\t\t}\n\t\tif left != \"\" && right != \"\" {\n\t\t\tn.Join(left, right)\n\t\t} else {\n\t\t\tif left != \"\" {\n\t\t\t\tn.Add(left)\n\t\t\t}\n\t\t\tif right != \"\" {\n\t\t\t\tn.Add(right)\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('berthcli/sew.go')\ns=p.read_text()\nneedle='func runSew(dump, out string) int {\\n'\ns=s.replace(needle, needle+'\\t// Never allow a failure to leave a stale success marker.\\n\\t_ = os.Remove(filepath.Join(out, \"berth.ok\"))\\n', 1)\np.write_text(s)\nPY\n"]
