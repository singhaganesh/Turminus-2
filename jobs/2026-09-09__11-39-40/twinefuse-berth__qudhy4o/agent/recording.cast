[53.2172, "o", "a=mapping('/app/dockurn/rows.ndjson')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.217692, "o", "b=mapping('/app/dockurn/mornbox/rows.ndjson')\r\n\u001b[?2004l\r\u001b[?2004h> assert a == b, (a,b)\r\n\u001b[?2004l\r\u001b[?2004h> print('same per-id hitches:', a)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
