[52.151329, "o", "rm -rf /tmp/eve-first /app/dockurn/mornbox; /app/bin/twinefuse sew /app/cordbay/eve.yarn /app/dockurn && mkdir /tmp/eve-first && cp /app/dockurn/rows.ndjson /app/dockurn/hitch.idx /tmp/eve-first/ && /app/bin/twinefuse sew /app/cordbay/eve.yarn /app/dockurn && cmp /tmp/eve-first/rows.ndjson /app/dockurn/rows.ndjson && cmp /tmp/eve-first/hitch.idx /app/dockurn/hitch.idx && /tmp/twinefuse.ref sew /app/cordbay/eve.yarn /tmp/refbox && cmp /tmp/refbox/rows.ndjson /app/dockurn/rows.ndjson && cmp /tmp/refbox/hitch.idx /app/dockurn/hitch.idx && /app/bin/twinefuse sew /app/cordbay/morn.yarn /app/dockurn/mornbox && echo '--- eve rows ---' && cat /app/dockurn/rows.ndjson && echo '--- eve index ---' && cat /app/dockurn/hitch.idx && echo '--- morn index ---' && cat /app/dockurn/mornbox/hitch.idx\r\n\u001b[?2004l\r"]
[52.182031, "o", "--- eve rows ---\r\n"]
[52.183359, "o", "{\"id\":\"e01\",\"hitch\":\"t_m\",\"tok\":\"t_m\"}\r\n{\"id\":\"e02\",\"hitch\":\"t_a\",\"tok\":\"t_a\"}\r\n{\"id\":\"e03\",\"hitch\":\"t_m\",\"tok\":\"t_m\"}\r\n{\"id\":\"e04\",\"hitch\":\"t_b\",\"tok\":\"t_z\"}\r\n{\"id\":\"e05\",\"hitch\":\"t_b\",\"tok\":\"t_b\"}\r\n{\"id\":\"e06\",\"hitch\":\"t_a\",\"tok\":\"t_a\"}\r\n{\"id\":\"e07\",\"hitch\":\"t_q\",\"tok\":\"t_q\"}\r\n{\"id\":\"e08\",\"hitch\":\"t_r\",\"tok\":\"t_r\"}\r\n{\"id\":\"e09\",\"hitch\":\"t_q\",\"tok\":\"t_q\"}\r\n{\"id\":\"e10\",\"hitch\":\"t_r\",\"tok\":\"t_r\"}\r\n"]
[52.183715, "o", "--- eve index ---\r\n"]
[52.184834, "o", "t_a e02,e06\r\nt_b e04,e05\r\nt_m e01,e03\r\nt_q e07,e09\r\nt_r e08,e10\r\n"]
[52.185114, "o", "--- morn index ---\r\n"]
