[47.924875, "o", "\u001b[?2004h> p=Path('berthcli/sew.go')\r\n\u001b[?2004l\r\u001b[?2004h> s=p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.925238, "o", "needle='func runSew(dump, out string) int {\\n'\r\n"]
[47.925298, "o", "\u001b[?2004l\r"]
[47.925584, "o", "\u001b[?2004h> "]
[47.926418, "o", "s=s.replace(needle, needle+'\\t// Never allow a failure to leave a stale success marker.\\n\\t_ = os.Remove(filepath.Join(out, \"berth.ok\"))\\n', 1)\r\n\u001b[?2004l\r"]
[47.926555, "o", "\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[47.993205, "o", "\u001b[?2004hroot@53f8ba35682d:/app# "]
[48.227068, "i", "cat > walkbind/stamp.go <<'EOF'\npackage walkbind\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\ntype Row struct {\n\tId    string `json:\"id\"`\n\tHitch string `json:\"hitch\"`\n\tTok   string `json:\"tok\"`\n}\n\nfunc CfgStamp(outDir string, rows []Row) error {\n\tif err := os.MkdirAll(outDir, 0o755); err != nil {\n\t\treturn err\n\t}\n\n\t// Rows are part of the dump format and must retain dump order.\n\trf, err := os.Create(filepath.Join(outDir, \"rows.ndjson\"))\n\tif err != nil {\n\t\treturn err\n\t}\n\tenc := json.NewEncoder(rf)\n\tenc.SetEscapeHTML(false)\n\tfor _, row := range rows {\n\t\tif err := enc.Encode(row); err != nil {\n\t\t\trf.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := rf.Close(); err != nil {\n\t\treturn err\n\t}\n\n\tgroups := make(map[string][]string)\n\tfor _, row := range rows {\n\t\tgroups[row.Hitch] = append(groups[row.Hitch], row.Id)\n\t}\n\thitches := make([]string, 0, len(groups))\n\tfor hitch := range groups {\n\t\thitches = append(hitches, hitch)\n\t}\n\tsort.Strings(hitches)\n\n\txf, err := os.Create(filepath.Join(outDir, \"hitch.idx\"))\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor _, hitch := range hitches {\n\t\tids := groups[hitch]\n\t\tsort.Strings(ids)\n\t\tif _, err := xf.WriteString(hitch + \" \" + strings.Join(ids, \",\") + \"\\n\"); err != nil {\n\t\t\txf.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := xf.Close(); err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(filepath.Join(outDir, \"berth.ok\"), []byte(\"ok\\n\"), 0o644)\n}\nEOF\ngofmt -w berthcli/*.go readcue/*.go netsrc/*.go cardpit/*.go walkbind/*.go ribdrop/*.go\ngo test ./...\ngo build -o /tmp/twinefuse.ref berth.local/twinefuse/berthcli\nbash /app/hull.sh\n"]
