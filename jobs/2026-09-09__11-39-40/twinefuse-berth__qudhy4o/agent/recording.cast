[53.21607, "i", "python3 - <<'PY'\nimport json\n\ndef mapping(path):\n    with open(path) as f:\n        return {r['id']: r['hitch'] for r in map(json.loads, f)}\na=mapping('/app/dockurn/rows.ndjson')\nb=mapping('/app/dockurn/mornbox/rows.ndjson')\nassert a == b, (a,b)\nprint('same per-id hitches:', a)\nPY\ncat > /app/aliascue/reject-test.cue <<'EOF'\nleft=t_a\nright=t_q\norigin=scrapped\nEOF\n/app/bin/twinefuse sew /app/cordbay/eve.yarn /app/dockurn; rc=$?; test \"$rc\" -ne 0 && test ! -e /app/dockurn/berth.ok; verdict=$?; rm -f /app/aliascue/reject-test.cue; /app/bin/twinefuse sew /app/cordbay/eve.yarn /app/dockurn; test \"$verdict\" -eq 0; printf 'scrapped rejection rc=%s; final artifacts refreshed\\n' \"$rc\"\n"]
[53.216359, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[53.21648, "o", "\u001b[?2004h> "]
