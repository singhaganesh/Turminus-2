Sending keys: ['cat > /app/urncue/fold.rs <<\'EOF\'\n#[path = "../hopcue/rim.rs"]\nmod rim;\n#[path = "../restpit/soak.rs"]\nmod soak;\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let listed = read::list("/app/daywell")?;\n    if listed.is_empty() {\n        return Err(1);\n    }\n    let picked = rim::rim(wall, listed);\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let _ = fs::remove_dir_all("/app/packbay/stage");\n    fs::create_dir_all("/app/packbay/stage").map_err(|_| 1)?;\n    let mut packed = Vec::new();\n    let mut taken = 0i32;\n    for (day, source) in picked {\n        let name = format!("d{:08}.tbl", day);\n        let destination = format!("/app/packbay/stage/{}", name);\n        taken = taken.checked_add(read::nlines(&source)?).ok_or(1)?;\n        fs::copy(&source, &destination).map_err(|_| 1)?;\n        packed.push((day, destination));\n    }\n\n    soak::soak(&packed, "/app/packbay/latest")?;\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write(\n        "/app/bloturn/ledger.json",\n        format!("{{\\"taken\\":{}}}", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\ncat > /app/millrib/gait.rs <<\'EOF\'\nuse std::fs;\n\nfn rows(body: &str) -> i32 {\n    body.lines().filter(|line| !line.trim().is_empty()).count() as i32\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string("/app/millrib/sheet.tpl").map_err(|_| 1)?;\n    let out = tpl\n        .replace("__P__", probe)\n        .replace("__M__", &matched.to_string())\n        .replace("__T__", &taken.to_string());\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/check.json", out).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    let mut matched = 0i32;\n    let mut probe: Option<String> = None;\n\n    for (day, _) in packed {\n        let name = format!("d{:08}.tbl", day);\n        let source = format!("/app/daywell/{}", name);\n        let restored = format!("/app/packbay/latest/{}", name);\n        // These reads are intentionally independent of ledger.json and stage.\n        let live = match fs::read_to_string(&source) {\n            Ok(body) => body,\n            Err(_) => return 1,\n        };\n        let copy = match fs::read_to_string(&restored) {\n            Ok(body) => body,\n            Err(_) => return 1,\n        };\n        if live != copy {\n            return 1;\n        }\n        let count = rows(&live);\n        matched = match matched.checked_add(count) {\n            Some(value) => value,\n            None => return 1,\n        };\n        if count > 0 {\n            probe = Some(source);\n        }\n    }\n\n    let probe = match probe {\n        Some(path) => path,\n        None => return 1,\n    };\n    if matched != taken || emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
