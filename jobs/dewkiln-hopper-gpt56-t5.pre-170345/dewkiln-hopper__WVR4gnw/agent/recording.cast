[72.224808, "o", "\u001b[?2004hroot@2f05dcad8eaf:/app# "]
[115.718884, "i", "cat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn live_rows(body: &str) -> Vec<&str> {\n    body.lines().map(str::trim).filter(|line| !line.is_empty()).collect()\n}\n\nfn json_string(value: &str) -> String {\n    let mut out = String::new();\n    for ch in value.chars() {\n        match ch {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c.is_control() => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let out = tpl\n        .replace(\"__P__\", &json_string(probe))\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\n}\n\npub fn gait(ledger_taken: i32, packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    let mut total = 0i32;\n    let mut newest: Option<(String, i32, i32)> = None;\n\n    for (day, _) in packed {\n        let name = format!(\"d{:08}.tbl\", day);\n        let source = format!(\"/app/daywell/{}\", name);\n        let restored = format!(\"/app/packbay/latest/{}\", name);\n        // The check deliberately reopens live daywell data; ledger.json is not read.\n        let live = match fs::read_to_string(&source) {\n            Ok(body) => body,\n            Err(_) => return 1,\n        };\n        let copy = match fs::read_to_string(&restored) {\n            Ok(body) => body,\n            Err(_) => return 1,\n        };\n        if live != copy {\n            return 1;\n        }\n        let source_rows = live_rows(&live);\n        let restored_rows = live_rows(&copy);\n        let source_count = source_rows.len() as i32;\n        let restored_count = restored_rows.len() as i32;\n        total = match total.checked_add(source_count) {\n            Some(value) => value,\n            None => return 1,\n        };\n        if let Some(row) = source_rows.last() {\n            newest = Some(((*row).to_owned(), restored_count, source_count));\n        }\n    }\n\n    if total != ledger_taken {\n        return 1;\n    }\n    let (probe, matched, taken) = match newest {\n        Some(check) => check,\n        None => return 1,\n    };\n    if matched != taken || emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\n/app/wick.sh\n/app/bin/dewkiln clasp; rc=$?; echo \"baseline_rc=$rc\"; cat /app/bloturn/check.json; echo; cat /app/bloturn/ledger.json; echo\n"]
[115.719939, "o", "cat > /app/millrib/gait.rs <<'EOF'\r\n\u001b[?2004l\r"]
[115.722496, "o", "\u001b[?2004h> "]
