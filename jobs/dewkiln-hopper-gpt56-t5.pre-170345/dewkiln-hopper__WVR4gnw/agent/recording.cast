[25.010998, "o", "/app/daywell:\r\n"]
[25.011173, "o", "total 28\r\ndrwxr-xr-x 2 root root 4096 2026-09-13 09:23:25.000000000 +0000 .\r\ndrwxr-xr-x 1 root root 4096 2026-09-13 10:12:52.000000000 +0000 ..\r\n"]
[25.011309, "o", "-rw-rw-r-- 1 root root   20 2026-09-13 09:23:25.000000000 +0000 d20260910.tbl\r\n-rw-rw-r-- 1 root root   16 2026-09-13 09:23:25.000000000 +0000 d20260911.tbl\r\n-rw-rw-r-- 1 root root   24 2026-09-13 09:23:25.000000000 +0000 d20260912.tbl\r\n-rw-rw-r-- 1 root root   28 2026-09-13 09:23:25.000000000 +0000 d20260913.tbl\r\n"]
[25.011723, "o", "\r\n/app/seed/daywell:\r\ntotal 24\r\ndrwxr-xr-x 2 root root 4096 2026-09-13 09:23:25.000000000 +0000 .\r\ndrwxr-xr-x 3 root root 4096 2026-09-13 10:12:51.000000000 +0000 ..\r\n-rw-rw-r-- 1 root root   20 2026-09-13 09:23:25.000000000 +0000 d20260910.tbl\r\n-rw-rw-r-- 1 root root   16 2026-09-13 09:23:25.000000000 +0000 d20260911.tbl\r\n-rw-rw-r-- 1 root root   24 2026-09-13 09:23:25.000000000 +0000 d20260912.tbl\r\n-rw-rw-r-- 1 root root   28 2026-09-13 09:23:25.000000000 +0000 d20260913.tbl\r\n"]
[25.012172, "o", "### /app/daywell/d20260910.tbl\r\n"]
