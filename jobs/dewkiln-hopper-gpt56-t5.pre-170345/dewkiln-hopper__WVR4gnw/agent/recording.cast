[115.728306, "o", "\u001b[?2004h"]
[115.729102, "o", ">             '\\n' => out.push_str(\"\\\\n\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\r' => out.push_str(\"\\\\r\"),\r\n\u001b[?2004l\r\u001b[?2004h>             '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r\u001b[?2004h>             c if c.is_control() => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.729601, "o", "            c => out.push(c),\r\n\u001b[?2004l\r"]
[115.733062, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let out = tpl\r\n\u001b[?2004l\r\u001b[?2004h>         .replace(\"__P__\", &json_string(probe))\r\n\u001b[?2004l\r\u001b[?2004h>         .replace(\"__M__\", &matched.to_string())\r\n\u001b[?2004l\r\u001b[?2004h>         .replace(\"__T__\", &taken.to_string());\r\n\u001b[?2004l\r\u001b[?2004h>     fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h>     fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn gait(ledger_taken: i32, packed: &[(i32, String)]) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h>     let mut total = 0i32;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut newest: Option<(String, i32, i32)> = None;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for (day, _) in packed {\r\n\u001b[?2004l\r\u001b[?2004h>         let name = format!(\"d{:08}.tbl\", day);\r\n\u001b[?2004l\r\u001b[?2004h>         let source = format!(\"/app/daywell/{}\", name);\r\n\u001b[?2004l\r\u001b[?2004h>         let restored = format!(\"/app/packbay/latest/{}\", name);\r\n\u001b[?2004l\r\u001b[?2004h>         // The check deliberately reopens live daywell data; ledger.json is not read.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.735035, "o", "        let live = match fs::read_to_string(&source) {\r\n\u001b[?2004l\r\u001b[?2004h>             Ok(body) => body,\r\n\u001b[?2004l\r\u001b[?2004h>             Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r\u001b[?2004h>         let copy = match fs::read_to_string(&restored) {\r\n\u001b[?2004l\r\u001b[?2004h>             Ok(body) => body,\r\n\u001b[?2004l\r\u001b[?2004h>             Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r\u001b[?2004h>         if live != copy {\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         let source_rows = live_rows(&live);\r\n\u001b[?2004l\r\u001b[?2004h>         let restored_rows = live_rows(&copy);\r\n\u001b[?2004l\r\u001b[?2004h>         let source_count = source_rows.len() as i32;\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.735195, "o", ">         let restored_count = restored_rows.len() as i32;\r\n\u001b[?2004l\r"]
[115.735302, "o", "\u001b[?2004h> "]
[115.735954, "o", "        total = match total.checked_add(source_count) {\r\n\u001b[?2004l\r\u001b[?2004h>             Some(value) => value,\r\n\u001b[?2004l\r\u001b[?2004h>             None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r\u001b[?2004h>         if let Some(row) = source_rows.last() {\r\n\u001b[?2004l\r"]
[115.736067, "o", "\u001b[?2004h> "]
[115.736264, "o", "            newest = Some(((*row).to_owned(), restored_count, source_count));\r\n\u001b[?2004l\r\u001b[?2004h"]
[115.736355, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.739974, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if total != ledger_taken {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let (probe, matched, taken) = match newest {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(check) => check,\r\n\u001b[?2004l\r\u001b[?2004h>         None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     if matched != taken || emit(&probe, matched, taken).is_err() {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
