[67.630535, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[67.630875, "o", "    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\r\n\u001b[?2004l\r"]
[67.631039, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[67.631158, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.631395, "o", "pub fn gait(taken: i32, packed: &[(i32, String)]) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.631696, "o", "    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.632037, "o", "    let mut matched = 0i32;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut probe: Option<String> = None;\r\n\u001b[?2004l\r"]
[67.632081, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.632306, "o", "    for (day, _) in packed {\r\n\u001b[?2004l\r"]
[67.632344, "o", "\u001b[?2004h> "]
[67.632637, "o", "        let name = format!(\"d{:08}.tbl\", day);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.632767, "o", "        let source = format!(\"/app/daywell/{}\", name);\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.632861, "o", "> "]
[67.633211, "o", "        let restored = format!(\"/app/packbay/latest/{}\", name);\r\n\u001b[?2004l\r"]
[67.633366, "o", "\u001b[?2004h> "]
[67.633536, "o", "        // These reads are intentionally independent of ledger.json and stage.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.633777, "o", "        let live = match fs::read_to_string(&source) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.633903, "o", "            Ok(body) => body,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.63407, "o", "            Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[67.63412, "o", "> "]
[67.634334, "o", "        };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.634545, "o", "        let copy = match fs::read_to_string(&restored) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.634694, "o", "            Ok(body) => body,\r\n\u001b[?2004l\r"]
[67.634857, "o", "\u001b[?2004h> "]
[67.635007, "o", "            Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.635061, "o", "        };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.635352, "o", "        if live != copy {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.635387, "o", "            return 1;\r\n"]
[67.635409, "o", "\u001b[?2004l\r"]
[67.636121, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         let count = rows(&live);\r\n\u001b[?2004l\r\u001b[?2004h>         matched = match matched.checked_add(count) {\r\n\u001b[?2004l\r"]
[67.636196, "o", "\u001b[?2004h> "]
[67.636456, "o", "            Some(value) => value,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.637037, "o", "            None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r\u001b[?2004h>         if count > 0 {\r\n\u001b[?2004l\r\u001b[?2004h>             probe = Some(source);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.637339, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[67.637419, "o", "> "]
[67.637691, "o", "    let probe = match probe {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.637868, "o", "        Some(path) => path,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.638037, "o", "        None => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n"]
[67.638068, "o", "\u001b[?2004l\r"]
[67.63825, "o", "\u001b[?2004h> "]
[67.638394, "o", "    if matched != taken || emit(&probe, matched, taken).is_err() {\r\n\u001b[?2004l\r"]
[67.638661, "o", "\u001b[?2004h> "]
[67.638699, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.638979, "o", "    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[67.640236, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[67.641757, "o", "\u001b[?2004hroot@2f05dcad8eaf:/app# "]
[67.952689, "i", "cat > /app/wickmill/boot.rs <<'EOF'\n#[path = \"../urncue/fold.rs\"]\nmod fold;\n#[path = \"../millrib/gait.rs\"]\nmod gait;\n#[path = \"../lidcue/skip.rs\"]\nmod skip;\n#[path = \"../corkpit/floor.rs\"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != \"clasp\" {\n        eprintln!(\"usage: dewkiln clasp\");\n        std::process::exit(2);\n    }\n\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\n    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");\n    let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\n\n    let code = match fold::fold() {\n        Ok((packed, taken)) => {\n            let mut ordered = packed.clone();\n            skip::skip(&mut ordered);\n            if taken <= 0 || !floor::floor(taken) {\n                1\n            } else {\n                gait::gait(taken, &packed)\n            }\n        }\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/dewkiln\n/app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; echo '--- bloturn ---'; for f in /app/bloturn/*; do echo \"### $f\"; cat \"$f\"; echo; done; echo '--- latest rows ---'; for f in /app/packbay/latest/*; do printf '%s rows=' \"$(basename \"$f\")\"; awk 'END{print NR}' \"$f\"; done\n"]
