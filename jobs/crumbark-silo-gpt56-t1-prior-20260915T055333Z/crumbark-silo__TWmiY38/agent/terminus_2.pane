     1	import java.nio.ByteBuffer;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.security.MessageDigest;
     6	
     7	public class StowRun {
     8	    static final int ALIGN = 32;
     9	
    10	    public static class CutErr extends RuntimeException {
    11	    }
    12	
    13	    public static void run(Path slip, boolean cut) throws Exception {
    14	        byte[] payload = Files.readAllBytes(slip);
    15	        Path silo = Paths.get("/app/silo");
    16	        Files.createDirectories(silo);
    17	        Path blob = silo.resolve("blob.bin");
    18	        Path pin = silo.resolve("pin.bin");
    19	        if (!Files.exists(blob)) {
    20	            Files.write(blob, new byte[0]);
    21	        }
    22	        if (!Files.exists(pin)) {
    23	            Files.write(pin, new byte[0]);
    24	        }
    25	        long offset = Files.size(blob);
    26	        RibChan bch = new RibChan(blob);
    27	        RibChan pch = new RibChan(pin);
    28	        int len = payload.length;
    29	        int rec = 4 + len;
    30	        int pad = (ALIGN - (rec % ALIGN)) % ALIGN;
    31	        ByteBuffer recb = ByteBuffer.allocate(rec + pad);
    32	        recb.putInt(len);
    33	        recb.put(payload);
    34	        recb.put(new byte[pad]);
    35	        bch.append(recb.array());
    36	        byte[] id = idOf(payload);
    37	        ByteBuffer mk = ByteBuffer.allocate(48);
    38	        mk.put(new byte[] {'P', 'N', '0', '1'});
    39	        mk.putLong(offset);
    40	        mk.putInt(len);
    41	        mk.putInt(Crc.of(payload));
    42	        mk.put(id);
    43	        mk.put(new byte[12]);
    44	        pch.append(mk.array());
    45	        String[] order = ForceSeq.names();
    46	        int n = 0;
    47	        for (String ch : order) {
    48	            if ("blob".equals(ch)) {
    49	                bch.force();
    50	            } else {
    51	                pch.force();
    52	            }
    53	            n++;
    54	            if (cut && n == 1) {
    55	                throw new CutErr();
    56	            }
    57	        }
    58	    }
    59	
    60	    static byte[] idOf(byte[] payload) throws Exception {
    61	        MessageDigest md = MessageDigest.getInstance("SHA-256");
    62	        byte[] d = md.digest(payload);
    63	        StringBuilder hx = new StringBuilder();
    64	        for (byte v : d) {
    65	            hx.append(String.format("%02x", v & 0xff));
    66	        }
    67	        String tail = hx.substring(32, 64);
    68	        byte[] id = new byte[16];
    69	        for (int k = 0; k < 16; k++) {
    70	            id[k] = (byte) Integer.parseInt(tail.substring(k * 2, k * 2 + 2), 16);
    71	        }
    72	        return id;
    73	    }
    74	
    75	    public static void main(String[] args) throws Exception {
    76	        if (args.length < 1) {
    77	            System.exit(2);
    78	        }
    79	        run(Paths.get(args[0]), false);
    80	    }
    81	}

