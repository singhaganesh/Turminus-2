     1	public class DeskMain {
     2	    public static void main(String[] args) throws Exception {
     3	        if (args.length < 1) {
     4	            System.exit(2);
     5	        }
     6	        String verb = args[0];
     7	        String[] rest = new String[Math.max(0, args.length - 1)];
