lic static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h>         Path silo = Path.of(\"/app/silo\");\r\n\u001b[?2004l\r\u001b[?2004h>         System.exit(orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"),\r\n\u001b[?2004l\r\u001b[?2004h>                 silo.resolve(\"wake.json\")));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
