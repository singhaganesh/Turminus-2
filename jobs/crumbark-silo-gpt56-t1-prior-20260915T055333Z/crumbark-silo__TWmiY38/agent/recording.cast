[40.631739, "o", "     1\t#!/bin/bash\r\n     2\tset -euo pipefail\r\n     3\tJAVAC=\"${JAVA_HOME:-/opt/java/openjdk}/bin/javac\"\r\n     4\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n     5\tif [ ! -x \"$JAVAC\" ]; then\r\n     6\t  JAVAC=javac\r\n     7\t  JAVA=java\r\n     8\tfi\r\n     9\tmkdir -p /app/blastcp /app/silo /app/bin\r\n    10\t\"$JAVAC\" -d /app/blastcp /app/recipit/LoomCue.java\r\n    11\t\"$JAVA\" -cp /app/blastcp LoomCue\r\n    12\tmapfile -t SRC < <(find /app/recipit /app/markwell /app/siltpage /app/hitchbay /app/retrycue -name '*.java' | sort)\r\n    13\t\"$JAVAC\" -d /app/blastcp \"${SRC[@]}\"\r\n    14\tcat > /app/bin/crumbark << 'EOF'\r\n    15\t#!/bin/bash\r\n    16\tset -euo pipefail\r\n    17\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n    18\tif [ ! -x \"$JAVA\" ]; then\r\n    19\t  JAVA=java\r\n    20\tfi\r\n    21\tverb=\"${1:-}\"\r\n    22\tshift || true\r\n    23\tcase \"$verb\" in\r\n    24\t  tamp)\r\n    25\t    exec /app/brimvat.sh\r\n    26\t    ;;\r\n    27\t  lade|wake|pull|nick)\r\n    28\t    exec \"$JAVA\" -cp /app/blastcp DeskMain \"$verb\" \"$@\"\r\n    29\t    ;;\r\n    30\t  *)\r\n    31\t    exit 2\r\n    32\t    ;;\r\n    33\tesac\r\n    34\tEOF\r\n    35\tchmod +x /app/bin/crumbark /app/brimvat.sh\r\n--- NOTE ---\r\n     1\tDesk runbook: tamp after source edits. lade a slip, then wake, then pull an id from held.\r\n     2\t\r\n     3\tIf a pull comes back empty, some shifts bump retrycue/PauseCue and wait. That path is still in the tree for the old flaky-reader hypothesis.\r\n     4\t\r\n     5\tA scratch slip may be written at `/tmp/lade.bin`.\r\n--- LOOM ---\r\n"]
