[143.98979, "i", "cat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class HueWalk {\n    public static int orb_n(Path blobPath, Path pinPath, Path wakePath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean gap = pins.length % 48 != 0;\n        for (int pos = 0; pos + 48 <= pins.length; pos += 48) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, 48);\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            byte[] payload = MistSpan.body(blob, off, len);\n            boolean valid = MistSpan.magic(magic) && payload != null;\n            if (valid)\n                valid = Crc.of(payload) == crc && MistSpan.same(id, MistSpan.idOf(payload));\n            if (valid) held.add(hex(id));\n            else gap = true;\n        }\n        String note = gap ? \"gap\" : \"ok\";\n        String kind = gap ? \"void\" : \"live\";\n        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\" + note\n                + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\"}\";\n        Files.writeString(wakePath, json);\n        return gap ? 1 : 0;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 0xff));\n        return sb.toString();\n    }\n\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < held.size(); i++) {\n            if (i > 0) sb.append(',');\n            sb.append('\"').append(held.get(i)).append('\"');\n        }\n        return sb.append(']').toString();\n    }\n\n    public static void main(String[] args) throws Exception {\n        Path silo = Path.of(\"/app/silo\");\n        System.exit(orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"),\n                silo.resolve(\"wake.json\")));\n    }\n}\nEOF\n/app/bin/crumbark tamp\nprintf '%s\\n' '--- generated order ---'; cat /app/recipit/ForceSeq.java\n"]
[143.990912, "o", "cat > /app/markwell/HueWalk.java <<'EOF'\r\n"]
