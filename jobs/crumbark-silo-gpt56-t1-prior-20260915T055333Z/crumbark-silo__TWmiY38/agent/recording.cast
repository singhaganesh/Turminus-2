[26.926435, "o", "/app/bin/crumbark: Bourne-Again shell script, ASCII text executable\r\n"]
[26.930156, "o", "#!/bin/bash\r\nset -euo pipefail\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  tamp)\r\n    exec /app/brimvat.sh\r\n    ;;\r\n  lade|wake|pull|nick)\r\n    exec \"$JAVA\" -cp /app/blastcp DeskMain \"$verb\" \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\n"]
