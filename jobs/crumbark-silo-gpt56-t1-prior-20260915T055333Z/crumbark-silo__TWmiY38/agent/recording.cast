[143.517895, "i", "cat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\n\npublic class MistSpan {\n    static final int ROW = 48;\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        if (wanted.length != 16) return new byte[0];\n        byte[] pins = Files.exists(silo.resolve(\"pin.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"pin.bin\")) : new byte[0];\n        byte[] blob = Files.exists(silo.resolve(\"blob.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"blob.bin\")) : new byte[0];\n        for (int pos = 0; pos + ROW <= pins.length; pos += ROW) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, ROW);\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            if (!same(id, wanted)) continue;\n            if (!magic(magic)) return new byte[0];\n            byte[] payload = body(blob, off, len);\n            if (payload == null || Crc.of(payload) != crc || !same(id, idOf(payload)))\n                return new byte[0];\n            return payload;\n        }\n        return new byte[0];\n    }\n\n    static byte[] body(byte[] blob, long off, int len) {\n        if (off < 0 || len < 0 || off > blob.length || off + 4L + len > blob.length)\n            return null;\n        int p = (int) off;\n        int framed = ByteBuffer.wrap(blob, p, 4).getInt();\n        if (framed != len) return null;\n        byte[] out = new byte[len];\n        System.arraycopy(blob, p + 4, out, 0, len);\n        return out;\n    }\n\n    static byte[] idOf(byte[] payload) throws Exception {\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\n        byte[] id = new byte[16];\n        System.arraycopy(digest, 0, id, 0, 16);\n        return id;\n    }\n\n    static boolean magic(byte[] x) {\n        return x.length == 4 && x[0] == 'P' && x[1] == 'N' && x[2] == '0' && x[3] == '1';\n    }\n\n    static boolean same(byte[] x, byte[] y) {\n        if (x.length != y.length) return false;\n        int diff = 0;\n        for (int i = 0; i < x.length; i++) diff |= x[i] ^ y[i];\n        return diff == 0;\n    }\n}\nEOF\ncat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class YankRun {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1 || !args[0].matches(\"[0-9a-f]{32}\")) System.exit(2);\n        byte[] got = MistSpan.tint_k(Paths.get(\"/app/silo\"), hex(args[0]));\n        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\n        if (got.length == 0) System.exit(1);\n        System.out.write(got);\n    }\n\n    static byte[] hex(String s) {\n        byte[] out = new byte[16];\n        for (int i = 0; i < 16; i++)\n            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        return out;\n    }\n}\nEOF\n"]
