[61.093196, "o", "\r\n\u001b[?2004l\r--- REMAINING SOURCES ---\r\n"]
[61.093597, "o", "### /app/hitchbay/RibChan.java\r\n"]
[61.096387, "o", "import java.io.ByteArrayOutputStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.StandardOpenOption;\r\n\r\npublic class RibChan {\r\n    final Path file;\r\n    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\r\n\r\n    RibChan(Path file) {\r\n        this.file = file;\r\n    }\r\n\r\n    void append(byte[] x) throws Exception {\r\n        pending.write(x);\r\n    }\r\n\r\n    void force() throws Exception {\r\n        byte[] out = pending.toByteArray();\r\n        if (out.length == 0) {\r\n            return;\r\n        }\r\n        Files.write(file, out, StandardOpenOption.CREATE, StandardOpenOption.APPEND);\r\n        pending.reset();\r\n    }\r\n}\r\n"]
[61.096958, "o", "### /app/recipit/ForceSeq.java\r\n"]
[61.097732, "o", "public class ForceSeq {\r\n    public static String[] names() {\r\n        return new String[] {\"pin\", \"blob\"};\r\n    }\r\n}\r\n"]
[61.098346, "o", "### /app/recipit/LoomCue.java\r\n"]
[61.099709, "o", "import java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.ArrayList;\r\nimport java.util.Comparator;\r\nimport java.util.List;\r\n\r\npublic class LoomCue {\r\n    static final class Step {\r\n        String name;\r\n        int compute;\r\n        int durable;\r\n    }\r\n\r\n    public static List<String> rib_q(Path a) throws Exception {\r\n        List<Step> steps = new ArrayList<Step>();\r\n        for (String line : Files.readAllLines(a)) {\r\n            String s = line.trim();\r\n            if (s.isEmpty() || s.startsWith(\"#\")) {\r\n                continue;\r\n            }\r\n            String[] p = s.split(\"\\\\s+\");\r\n            if (p.length < 3) {\r\n                continue;\r\n            }\r\n            Step st = new Step();\r\n            st.name = p[0];\r\n            st.compute = Integer.parseInt(p[1]);\r\n            st.durable = Integer.parseInt(p[2]);\r\n            steps.add(st);\r\n        }\r\n        steps.sort(Comparator.comparingInt(x -> x.compute));\r\n        List<String> names = new ArrayList<String>();\r\n        for (Step st : steps) {\r\n            names.add(st.name);\r\n        }\r\n        return names;\r\n    }\r\n\r\n    public static void main(String[] args) throws Exception {\r\n        Path recipe = Paths.get(\"/app/recipit/steps.loom\");\r\n        List<String> names = rib_q(recipe);\r\n        StringBuilder sb = new StringBuilder();\r\n        sb.append(\"public class ForceSeq {\\n\");\r\n        sb.append(\"    public static String[] names() {\\n\");\r\n        sb.append(\"        return new String[] {\");\r\n        for (int i = 0; i < names.size(); i++) {\r\n            if (i > 0) {\r\n                sb.append(\", \");\r\n            }\r\n            sb.append(\"\\\"\");\r\n            sb.append(names.get(i));\r\n            sb.append(\"\\\"\");\r\n        }\r\n        sb.append(\"};\\n\");\r\n        sb.append(\"    }\\n\");\r\n        sb.append(\"}\\n\");\r\n        Files.writeString(Paths.get(\"/app/recipit/ForceSeq.java\"), sb.toString());\r\n    }\r\n}\r\n"]
[61.10074, "o", "\u001b[?2004hroot@858e060628cf:/app# "]
[70.653449, "i", "cat -n /app/markwell/HueWalk.java\n"]
[70.653994, "o", "cat -n /app/markwell/HueWalk.java\r\n\u001b[?2004l\r"]
[70.654822, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.util.ArrayList;\r\n     5\timport java.util.List;\r\n     6\t\r\n     7\tpublic class HueWalk {\r\n     8\t    public static int orb_n(Path a, Path b, Path c) throws Exception {\r\n     9\t        byte[] pins = Files.exists(b) ? Files.readAllBytes(b) : new byte[0];\r\n    10\t        List<String> held = new ArrayList<String>();\r\n    11\t        int i = 0;\r\n    12\t        while (i + 48 <= pins.length) {\r\n    13\t            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\r\n    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            int crc = bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            held.add(hex(id));\r\n    22\t            i += 48;\r\n    23\t        }\r\n    24\t"]
[70.65486, "o", "        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"ok\\\",\\\"kind\\\":\\\"live\\\"}\";\r\n    25\t        Files.writeString(c, json);\r\n    26\t        return 0;\r\n    27\t    }\r\n    28\t\r\n    29\t    static String hex(byte[] id) {\r\n    30\t        StringBuilder sb = new StringBuilder();\r\n    31\t        for (byte v : id) {\r\n    32\t            sb.append(String.format(\"%02x\", v & 0xff));\r\n    33\t        }\r\n    34\t        return sb.toString();\r\n    35\t    }\r\n    36\t\r\n    37\t    static String arr(List<String> held) {\r\n    38\t        StringBuilder sb = new StringBuilder(\"[\");\r\n    39\t        for (int i = 0; i < held.size(); i++) {\r\n    40\t            if (i > 0) {\r\n    41\t                sb.append(\",\");\r\n    42\t            }\r\n    43\t            sb.append(\"\\\"\");\r\n    44\t            sb.append(held.get(i));\r\n    45\t            sb.append(\"\\\"\");\r\n    46\t        }\r\n    47\t        sb.append(\"]\");\r\n    48\t        return sb.toString();\r\n    49\t    }\r\n    50\t\r\n    51\t    public static void main(String[] args) throws Exception {\r\n    52\t        Path silo = Path.of(\"/app/silo\");\r\n    53\t        int rc = orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\"));\r\n    54\t        System.exit(rc);\r\n    55\t    }\r\n    56\t}\r\n"]
