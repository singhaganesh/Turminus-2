[60.397123, "o", "\r\n--- /app/hitchbay/StowRun.java ---\r\n"]
[60.398304, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.security.MessageDigest;\r\n     6\t\r\n     7\tpublic class StowRun {\r\n     8\t    static final int ALIGN = 32;\r\n     9\t\r\n    10\t    public static class CutErr extends RuntimeException {\r\n    11\t    }\r\n    12\t\r\n    13\t    public static void run(Path slip, boolean cut) throws Exception {\r\n    14\t        byte[] payload = Files.readAllBytes(slip);\r\n    15\t        Path silo = Paths.get(\"/app/silo\");\r\n    16\t        Files.createDirectories(silo);\r\n    17\t        Path blob = silo.resolve(\"blob.bin\");\r\n    18\t        Path pin = silo.resolve(\"pin.bin\");\r\n    19\t        if (!Files.exists(blob)) {\r\n    20\t            Files.write(blob, new byte[0]);\r\n    21\t        }\r\n    22\t        if (!Files.exists(pin)) {\r\n    23\t            Files.write(pin, new byte[0]);\r\n    24\t        }\r\n    25\t        long offset = Files.size(blob);\r\n    26\t        RibChan bch = new RibChan(blob);\r\n    27\t        RibChan pch = new RibChan(pin);\r\n    28\t        int len = payload.length;\r\n    29\t        int rec = 4 + len;\r\n    30\t        int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n    31\t        ByteBuffer recb = ByteBuffer.allocate(rec + pad);\r\n    32\t        recb.putInt(len);\r\n    33\t        recb.put(payload);\r\n    34\t        recb.put(new byte[pad]);\r\n    35\t        bch.append(recb.array());\r\n    36\t        byte[] id = idOf(payload);\r\n    37\t        ByteBuffer mk = ByteBuffer.allocate(48);\r\n    38\t        mk.put(new byte[] {'P', 'N', '0', '1'});\r\n    39\t        mk.putLong(offset);\r\n    40\t        mk.putInt(len);\r\n    41\t        mk.putInt(Crc.of(payload));\r\n    42\t        mk.put(id);\r\n    43\t        mk.put(new byte[12]);\r\n    44\t        pch.append(mk.array());\r\n    45\t        String[] order = ForceSeq.names();\r\n    46\t        int n = 0;\r\n    47\t        for (String ch : order) {\r\n    48\t            if (\"blob\".equals(ch)) {\r\n    49\t                bch.force();\r\n    50\t            } else {\r\n    51\t                pch.force();\r\n    52\t            }\r\n    53\t            n++;\r\n    54\t            if (cut && n == 1) {\r\n    55\t                throw new CutErr();\r\n    56\t            }\r\n    57\t        }\r\n    58\t    }\r\n    59\t\r\n    60\t    static byte[] idOf(byte[] payload) throws Exception {\r\n    61\t        MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n    62\t        byte[] d = md.digest(payload);\r\n    63\t        StringBuilder hx = new StringBuilder();\r\n    64\t        for (byte v : d) {\r\n    65\t            hx.append(String.format(\"%02x\", v & 0xff));\r\n    66\t        }\r\n    67\t        String tail = hx.substring(32, 64);\r\n    68\t        byte[] id = new byte[16];\r\n    69\t        for (int k = 0; k < 16; k++) {\r\n    70\t            id[k] = (byte) Integer.parseInt(tail.substring(k * 2, k * 2 + 2), 16);\r\n    71\t        }\r\n    72\t        return id;\r\n    73\t    }\r\n    74\t\r\n    75\t    public static void main(String[] args) throws Exception {\r\n    76\t        if (args.length < 1) {\r\n    77\t            System.exit(2);\r\n    78\t        }\r\n    79\t        run(Paths.get(args[0]), false);\r\n    80\t    }\r\n    81\t}\r\n"]
[60.398661, "o", "\r\n--- /app/hitchbay/YankRun.java ---\r\n"]
[60.401105, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\t\r\n     5\tpublic class YankRun {\r\n     6\t    public static void main(String[] args) throws Exception {\r\n     7\t        if (args.length < 1) {\r\n     8\t            System.exit(2);\r\n     9\t        }\r\n    10\t        byte[] id = hex(args[0]);\r\n    11\t        Path silo = Paths.get(\"/app/silo\");\r\n    12\t        byte[] got = MistSpan.tint_k(silo, id);\r\n    13\t        if (got.length == 0 || allZero(got)) {\r\n    14\t            PauseCue.nap();\r\n    15\t            got = MistSpan.tint_k(silo, id);\r\n    16\t        }\r\n    17\t        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\r\n    18\t        System.out.write(got);\r\n    19\t    }\r\n    20\t\r\n    21\t    static boolean allZero(byte[] a) {\r\n    22\t        for (byte v : a) {\r\n    23\t            if (v != 0) {\r\n    24\t                return false;\r\n    25\t            }\r\n    26\t        }\r\n    27\t        return a.length > 0;\r\n    28\t    }\r\n    29\t\r\n    30\t    static byte[] hex(String s) {\r\n    31\t        int n = s.length() / 2;\r\n    32\t        byte[] out = new byte[n];\r\n    33\t        for (int i = 0; i < n; i++) {\r\n    34\t            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\r\n    35\t        }\r\n    36\t        return out;\r\n    37\t    }\r\n    38\t}\r\n\r\n--- /app/markwell/HueWalk.java ---\r\n     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.util.ArrayList;\r\n     5\timport java.util.List;\r\n     6\t\r\n     7\tpublic class HueWalk {\r\n     8\t    public static int orb_n(Path a, Path b, Path c) throws Exception {\r\n     9\t        byte[] pins = Files.exists(b) ? Files.readAllBytes(b) : new byte[0];\r\n    10\t        List<String> held = new ArrayList<String>();\r\n    11\t        int i = 0;\r\n    12\t        while (i + 48 <= pins.length) {\r\n    13\t            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\r\n    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            int crc = bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            held.add(hex(id));\r\n    22\t            i += 48;\r\n    23\t        }\r\n    24\t        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"ok\\\",\\\"kind\\\":\\\"live\\\"}\";\r\n    25\t        Files.writeString(c, json);\r\n    26\t        return 0;\r\n    27\t    }\r\n    28\t\r\n    29\t    static String hex(byte[] id) {\r\n    30\t        StringBuilder sb = new StringBuilder();\r\n    31\t        for (byte v : id) {\r\n    32\t            sb.append(String.format(\"%02x\", v & 0xff));\r\n    33\t        }\r\n    34\t        return sb.toString();\r\n    35\t    }\r\n    36\t\r\n    37\t    static String arr(List<String> held) {\r\n    38\t        StringBuilder sb = new StringBuilder(\"[\");\r\n    39\t        for (int i = 0; i < held.size(); i++) {\r\n    40\t            if (i > 0) {\r\n    41\t                sb.append(\",\");\r\n    42\t            }\r\n    43\t            sb.append(\"\\\"\");\r\n    44\t            sb.append(held.get(i));\r\n    45\t            sb.append(\"\\\"\");\r\n    46\t        }\r\n    47\t        sb.append(\"]\");\r\n    48\t        return sb.toString();\r\n    49\t    }\r\n    50\t\r\n    51\t    public static void main(String[] args) throws Exception {\r\n    52\t        Path silo = Path.of(\"/app/silo\");\r\n    53\t        int rc = orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\"));\r\n    54\t        System.exit(rc);\r\n    55\t    }\r\n    56\t}\r\n\r\n--- /app/recipit/ForceSeq.java ---\r\n"]
[60.401876, "o", "     1\tpublic class ForceSeq {\r\n     2\t    public static String[] names() {\r\n     3\t        return new String[] {\"pin\", \"blob\"};\r\n     4\t    }\r\n     5\t}\r\n"]
