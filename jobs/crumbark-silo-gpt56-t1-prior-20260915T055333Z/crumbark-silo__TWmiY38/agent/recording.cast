[177.530056, "i", "python3 - <<'PY'\np='/app/hitchbay/StowRun.java'\ns=open(p).read()\na=s.index('    static byte[] idOf(byte[] payload)')\nb=s.index('\\n    public static void main', a)\nmethod='''    static byte[] idOf(byte[] payload) throws Exception {\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\n        byte[] id = new byte[16];\n        System.arraycopy(digest, 0, id, 0, id.length);\n        return id;\n    }\n'''\nopen(p,'w').write(s[:a]+method+s[b:])\nPY\n/app/bin/crumbark tamp\n"]
