[57.891424, "o", "> "]
[57.891727, "o", "    match fs::remove_file(dest) {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(()) => {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.893513, "o", "        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\r\n\u001b[?2004l\r\u001b[?2004h>         Err(e) => {\r\n\u001b[?2004l\r\u001b[?2004h>             eprintln!(\"cannot remove {}: {}\", dest.display(), e);\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let buf = match fs::read(\"/app/quaybag/night.bin\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
