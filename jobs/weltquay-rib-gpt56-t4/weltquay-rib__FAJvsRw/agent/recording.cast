[81.252918, "i", "set -u\ncp /app/quaybag/night.bin /tmp/night.bin.good\nok=1\nfor n in 0 1 2 3; do\n  head -c \"$n\" /tmp/night.bin.good > /app/quaybag/night.bin\n  printf '%s\\n' stale > /app/blotbay/rows.json\n  /app/bin/weltquay pour >/tmp/pour.out 2>/tmp/pour.err\n  rc=$?\n  if [ \"$rc\" -eq 0 ] || [ -e /app/blotbay/rows.json ]; then\n    echo \"SHORT TEST FAILED: n=$n rc=$rc exists=$(test -e /app/blotbay/rows.json && echo yes || echo no)\"\n    ok=0\n  else\n    echo \"short n=$n: rc=$rc, rows absent\"\n  fi\ndone\ncp /tmp/night.bin.good /app/quaybag/night.bin\n/app/bin/weltquay pour\nrc=$?\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\np = Path('/app/blotbay/rows.json')\no = json.loads(p.read_text())\nexpected = {'kind': 4, 'lane': 54, 'mode': 6, 'welt': 477, 'tail': 1, 'mark': 165}\nassert o == expected, (o, expected)\nassert all(type(v) is int for v in o.values())\nassert Path('/app/bin/weltquay').read_bytes()[:4] == b'\\x7fELF'\nprint('final JSON validated:', o)\nPY\npyrc=$?\necho \"short_tests_ok=$ok valid_rc=$rc validation_rc=$pyrc input_bytes=$(wc -c < /app/quaybag/night.bin)\"\ntest \"$ok\" -eq 1 && test \"$rc\" -eq 0 && test \"$pyrc\" -eq 0\n"]
