[57.890014, "o", "s=s.replace('pub fn dump(buf: &[u8])', 'pub const WIDTH: usize = {width}usize;\\n\\npub fn dump(buf: &[u8])')\r\n"]
[57.890202, "o", "\u001b[?2004l\r\u001b[?2004h> "]
