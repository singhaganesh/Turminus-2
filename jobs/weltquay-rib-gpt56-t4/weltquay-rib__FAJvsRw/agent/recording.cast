[57.890446, "o", "Path('/app/peekurn/ink.rs').write_text('''use crate::pull;\r\n\u001b[?2004l\r"]
[57.890564, "o", "\u001b[?2004h> use crate::tally;\r\n\u001b[?2004l\r"]
[57.890719, "o", "\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h"]
