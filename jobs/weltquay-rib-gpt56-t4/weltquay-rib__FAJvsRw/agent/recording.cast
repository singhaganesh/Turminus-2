[11.216466, "i", "pwd; printf '%s\\n' '--- TREE ---'; cat /app/keepfold/TREE.txt; printf '%s\\n' '--- LAYOUT ---'; cat /app/ribcards/LAYOUT.txt; printf '%s\\n' '--- files ---'; file /app/bin/weltquay /app/quaybag/night.bin; find /app -maxdepth 3 -type f -printf '%p %s bytes\\n' | sort\n"]
[11.217537, "o", "pwd; printf '%s\\n' '--- TREE ---'; cat /app/keepfold/TREE.txt; printf '%s\\n' '--- LAYOUT ---'; cat /app/ribcards/LAYOUT.txt; printf '%s\\n' '--- files ---'; file /app/bin/weltquay /app/quaybag/night.bin; find /app -maxdepth 3 -type f -printf '%p %s bytes\\n' | sort\r\n\u001b[?2004l\r"]
[11.217837, "o", "/app\r\n"]
[11.217894, "o", "--- TREE ---\r\n"]
[11.218841, "o", "weltquay mill\r\n===============\r\n\r\nweltcli/boot.rs dispatches pour.\r\n\r\nPipeline modules:\r\n- octetkiln/  kiln take and emit\r\n- stitchbay/  layout row load used by emit\r\n- peekurn/    pour writer\r\n- vaultbin/   baked pull used by pour\r\n- nudgepit/   line tally\r\n\r\nLayout rows live in /app/ribcards/LAYOUT.txt.\r\nEach row is a name, a bit index, and a width.\r\npour reads /app/quaybag/night.bin and writes /app/blotbay/rows.json.\r\n\r\nRebuild the binary with /app/wick.sh after source edits.\r\n"]
[11.220614, "o", "--- LAYOUT ---\r\n"]
[11.223209, "o", "kind 0 3\r\nlane 3 6\r\nmode 9 3\r\nwelt 12 9\r\ntail 21 3\r\nmark 24 8\r\n"]
[11.225436, "o", "--- files ---\r\nbash: file: command not found\r\n"]
[11.235931, "o", "/app/bin/weltquay 3984912 bytes\r\n/app/blotbay/rows.json 60 bytes\r\n/app/keepfold/COVER.txt 160 bytes\r\n/app/keepfold/TREE.txt 468 bytes\r\n/app/nudgepit/tally.rs 195 bytes\r\n/app/octetkiln/emit.rs 991 bytes\r\n/app/octetkiln/house.rs 343 bytes\r\n/app/octetkiln/lsb.rs 364 bytes\r\n/app/octetkiln/take.rs 223 bytes\r\n/app/peekurn/ink.rs 571 bytes\r\n/app/quaybag/night.bin 4 bytes\r\n/app/ribcards/LAYOUT.txt 57 bytes\r\n/app/stitchbay/card.rs 964 bytes\r\n/app/vaultbin/pull.rs 287 bytes\r\n/app/weltcli/boot.rs 511 bytes\r\n/app/weltcli/usage.txt 77 bytes\r\n/app/wick.sh 283 bytes\r\n"]
[11.236233, "o", "\u001b[?2004hroot@ddb5ff434a45:/app# "]
[22.885878, "i", "for f in /app/weltcli/boot.rs /app/octetkiln/*.rs /app/stitchbay/*.rs /app/peekurn/*.rs /app/vaultbin/*.rs /app/nudgepit/*.rs /app/wick.sh /app/keepfold/COVER.txt; do echo \"--- $f ---\"; sed -n '1,240p' \"$f\"; done; echo '--- magic/input ---'; od -An -tx1 -N16 /app/bin/weltquay; od -An -tx1 -v /app/quaybag/night.bin; echo '--- existing rows ---'; cat /app/blotbay/rows.json; echo; echo '--- current pour ---'; /app/bin/weltquay pour; rc=$?; echo \"rc=$rc\"; test -e /app/blotbay/rows.json && cat /app/blotbay/rows.json || echo 'rows.json absent'\n"]
[22.891704, "o", "for f in /app/weltcli/boot.rs /app/octetkiln/*.rs /app/stitchbay/*.rs /app/peekurn/*.rs /app/vaultbin/*.rs /app/nudgepit/*.rs /app/wick.sh /app/keepfold/COVER.txt; do echo \"--- $f ---\"; sed -n '1,240p' \"$f\"; done; echo '--- magic/input ---'; od -An -tx1 -N16 /app/bin/weltquay; od -An -tx1 -v /app/quaybag/night.bin; echo '--- existing rows ---'; cat /app/blotbay/rows.json; echo; echo '--- current pour ---'; /app/bin/weltquay pour; rc=$?; echo \"rc=$rc\"; test -e /app/blotbay/rows.json && cat /app/blotbay/rows.json || echo 'rows.json absent'\r\n\u001b[?2004l\r--- /app/weltcli/boot.rs ---\r\n"]
[22.892051, "o", "#[path = \"../octetkiln/house.rs\"]\r\nmod house;\r\n#[path = \"../octetkiln/take.rs\"]\r\nmod take;\r\n#[path = \"../vaultbin/pull.rs\"]\r\nmod pull;\r\n#[path = \"../peekurn/ink.rs\"]\r\nmod vat;\r\n#[path = \"../nudgepit/tally.rs\"]\r\nmod tally;\r\n\r\nfn main() {\r\n    let mut args = std::env::args().skip(1);\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"pour\" => vat::rib_c(),\r\n        _ => {\r\n            eprintln!(\"usage: weltquay pour\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[22.894754, "o", "--- /app/octetkiln/emit.rs ---\r\n"]
[22.896393, "o", "use std::fs;\r\n\r\n#[path = \"../stitchbay/card.rs\"]\r\nmod card;\r\n\r\nfn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {\r\n    for row in rows {\r\n        if row.tag == tag {\r\n            return (row.pos, row.n);\r\n        }\r\n    }\r\n    (0, 0)\r\n}\r\n\r\nfn main() {\r\n    let rows = card::rib_b();\r\n    let (k0, k1) = pick(&rows, \"kind\");\r\n"]
[22.896464, "o", "    let (l0, l1) = pick(&rows, \"lane\");\r\n    let (m0, m1) = pick(&rows, \"mode\");\r\n    let (w0, w1) = pick(&rows, \"welt\");\r\n    let (t0, t1) = pick(&rows, \"tail\");\r\n    let (x0, x1) = pick(&rows, \"mark\");\r\n    let body = format!(\r\n        r#\"use crate::take;\r\n\r\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\r\n    (\r\n        take::rib_a(buf, {k0}, {k1}),\r\n        take::rib_a(buf, {l0}, {l1}),\r\n        take::rib_a(buf, {m0}, {m1}),\r\n        take::rib_a(buf, {w0}, {w1}),\r\n        take::rib_a(buf, {t0}, {t1}),\r\n        take::rib_a(buf, {x0}, {x1}),\r\n    )\r\n}}\r\n\"#\r\n    );\r\n    let _ = fs::create_dir_all(\"/app/vaultbin\");\r\n    fs::write(\"/app/vaultbin/pull.rs\", body).expect(\"emit\");\r\n}\r\n"]
[22.896805, "o", "--- /app/octetkiln/house.rs ---\r\n"]
[22.898163, "o", "pub fn rib_e(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n    if n == 0 {\r\n        return 0;\r\n    }\r\n    let i = (pos / 8) as usize;\r\n    if i >= buf.len() {\r\n        return 0;\r\n    }\r\n    let bit = pos % 8;\r\n    let room = 8 - bit;\r\n    if n > room {\r\n        return 0;\r\n    }\r\n    let shift = 8 - bit - n;\r\n    ((buf[i] as u32) >> shift) & ((1u32 << n) - 1)\r\n}\r\n"]
[22.898399, "o", "--- /app/octetkiln/lsb.rs ---\r\n"]
[22.899539, "o", "pub fn rib_f(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n    let mut acc = 0u32;\r\n    let mut i = 0u32;\r\n    while i < n {\r\n        let b = pos + i;\r\n        let idx = (b / 8) as usize;\r\n        if idx >= buf.len() {\r\n            break;\r\n        }\r\n"]
[22.89963, "o", "        let bit = b % 8;\r\n        let v = ((buf[idx] as u32) >> bit) & 1;\r\n        acc |= v << i;\r\n        i += 1;\r\n    }\r\n    acc\r\n}\r\n"]
[22.899786, "o", "--- /app/octetkiln/take.rs ---\r\n"]
[22.900846, "o", "pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n    if n == 0 {\r\n        return 0;\r\n    }\r\n    let bit = pos % 8;\r\n    let room = 8 - bit;\r\n    let w = if n > room { room } else { n };\r\n    crate::house::rib_e(buf, pos, w)\r\n}\r\n"]
[22.901094, "o", "--- /app/stitchbay/card.rs ---\r\n"]
[22.902131, "o", "pub struct Row {\r\n    pub tag: String,\r\n    pub pos: u32,\r\n    pub n: u32,\r\n}\r\n\r\nfn tok(line: &str) -> Vec<String> {\r\n    line.split_whitespace().map(|s| s.to_string()).collect()\r\n}\r\n"]
[22.90223, "o", "\r\npub fn rib_b() -> Vec<Row> {\r\n    let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\").unwrap_or_default();\r\n    let mut out = Vec::new();\r\n    for line in text.lines() {\r\n        let raw = line.trim();\r\n        if raw.is_empty() || raw.starts_with('#') {\r\n            continue;\r\n        }\r\n        let parts = tok(raw);\r\n        if parts.len() < 3 {\r\n            continue;\r\n        }\r\n        let tag = parts[0].clone();\r\n        let mut pos: u32 = match parts[1].parse() {\r\n            Ok(v) => v,\r\n            Err(_) => continue,\r\n        };\r\n        let n: u32 = match parts[2].parse() {\r\n            Ok(v) => v,\r\n            Err(_) => continue,\r\n        };\r\n        if n > 8 {\r\n            pos = pos.saturating_add(8 - (pos % 8));\r\n        }\r\n        out.push(Row { tag, pos, n });\r\n    }\r\n    out\r\n}\r\n"]
[22.902425, "o", "--- /app/peekurn/ink.rs ---\r\n"]
[22.90344, "o", "use crate::pull;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rib_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let buf = fs::read(\"/app/quaybag/night.bin\").unwrap_or_default();\r\n    let dest = Path::new(\"/app/blotbay/rows.json\");\r\n"]
[22.903551, "o", "    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    let (a, b, c, d, e, f) = pull::dump(&buf);\r\n    let body = format!(\r\n        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\r\n        a, b, c, d, e, f\r\n    );\r\n    let _ = fs::write(dest, body);\r\n    0\r\n}\r\n"]
[22.903724, "o", "--- /app/vaultbin/pull.rs ---\r\n"]
[22.904823, "o", "use crate::take;\r\n\r\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n    (\r\n        take::rib_a(buf, 0, 3),\r\n        take::rib_a(buf, 3, 6),\r\n        take::rib_a(buf, 9, 3),\r\n        take::rib_a(buf, 16, 9),\r\n        take::rib_a(buf, 21, 3),\r\n        take::rib_a(buf, 24, 8),\r\n    )\r\n}\r\n"]
[22.905053, "o", "--- /app/nudgepit/tally.rs ---\r\n"]
[22.906104, "o", "pub fn lines() -> usize {\r\n    std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\r\n        .unwrap_or_default()\r\n        .lines()\r\n        .filter(|line| !line.trim().is_empty())\r\n        .count()\r\n}\r\n"]
[22.906391, "o", "--- /app/wick.sh ---\r\n"]
[22.908927, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/blotbay /app/vaultbin\r\nrustc --edition 2021 -O /app/octetkiln/emit.rs -o /tmp/welt-emit\r\n/tmp/welt-emit\r\nrustc --edition 2021 -O /app/weltcli/boot.rs -o /app/bin/weltquay\r\n"]
[22.90949, "o", "--- /app/keepfold/COVER.txt ---\r\n"]
[22.910873, "o", "Desk cover\r\n==========\r\n\r\nCoverage is the number of lines in /app/ribcards/LAYOUT.txt.\r\n\r\nThe old mill's join is octetkiln/lsb.rs: bit 0 is the low end of an octet.\r\n"]
[22.911087, "o", "--- magic/input ---\r\n"]
[22.913392, "o", " 7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\r\n"]
[22.914642, "o", " b4 dd 3d a5\r\n"]
[22.914828, "o", "--- existing rows ---\r\n"]
[22.915733, "o", "{\"kind\":5,\"lane\":20,\"mode\":5,\"welt\":61,\"tail\":5,\"mark\":165}\r\n"]
[22.915879, "o", "\r\n--- current pour ---\r\n"]
[22.918504, "o", "rc=0\r\n"]
[22.919261, "o", "{\"kind\":5,\"lane\":20,\"mode\":5,\"welt\":61,\"tail\":5,\"mark\":165}\r\n"]
[22.919459, "o", "\u001b[?2004hroot@ddb5ff434a45:/app# "]
[57.885326, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/stitchbay/card.rs')\ns=p.read_text()\ns=s.replace('        let mut pos: u32 = match parts[1].parse() {', '        let pos: u32 = match parts[1].parse() {')\ns=s.replace('        if n > 8 {\\n            pos = pos.saturating_add(8 - (pos % 8));\\n        }\\n', '')\np.write_text(s)\n\nPath('/app/octetkiln/take.rs').write_text('''pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\n    if n == 0 || n > 32 {\n        return 0;\n    }\n    crate::lsb::rib_f(buf, pos, n)\n}\n''')\n\np=Path('/app/weltcli/boot.rs')\ns=p.read_text()\ns=s.replace('#[path = \"../octetkiln/take.rs\"]\\nmod take;', '#[path = \"../octetkiln/take.rs\"]\\nmod take;\\n#[path = \"../octetkiln/lsb.rs\"]\\nmod lsb;')\np.write_text(s)\n\np=Path('/app/octetkiln/emit.rs')\ns=p.read_text()\ns=s.replace('    let (x0, x1) = pick(&rows, \"mark\");', '    let (x0, x1) = pick(&rows, \"mark\");\\n    let width = rows.iter().map(|r| r.pos.saturating_add(r.n)).max().unwrap_or(0).saturating_add(7) / 8;')\ns=s.replace('pub fn dump(buf: &[u8])', 'pub const WIDTH: usize = {width}usize;\\n\\npub fn dump(buf: &[u8])')\np.write_text(s)\n\nPath('/app/peekurn/ink.rs').write_text('''use crate::pull;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rib_c() -> i32 {\n    let _ = tally::lines();\n    let dest = Path::new(\"/app/blotbay/rows.json\");\n    // Never allow an earlier successful result to survive a failed pour.\n    match fs::remove_file(dest) {\n        Ok(()) => {}\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n        Err(e) => {\n            eprintln!(\"cannot remove {}: {}\", dest.display(), e);\n            return 1;\n        }\n    }\n    let buf = match fs::read(\"/app/quaybag/night.bin\") {\n        Ok(buf) => buf,\n        Err(e) => {\n            eprintln!(\"cannot read night.bin: {}\", e);\n            return 1;\n        }\n    };\n    if buf.len() < pull::WIDTH {\n        eprintln!(\"night.bin is too short: need {} bytes, got {}\", pull::WIDTH, buf.len());\n        return 1;\n    }\n    let (a, b, c, d, e, f) = pull::dump(&buf);\n    let body = format!(\n        \"{{\\\\\\\"kind\\\\\\\":{},\\\\\\\"lane\\\\\\\":{},\\\\\\\"mode\\\\\\\":{},\\\\\\\"welt\\\\\\\":{},\\\\\\\"tail\\\\\\\":{},\\\\\\\"mark\\\\\\\":{}}}\\\\n\",\n        a, b, c, d, e, f\n    );\n    if let Some(parent) = dest.parent() {\n        if let Err(e) = fs::create_dir_all(parent) {\n            eprintln!(\"cannot create output directory: {}\", e);\n            return 1;\n        }\n    }\n    if let Err(e) = fs::write(dest, body) {\n        eprintln!(\"cannot write {}: {}\", dest.display(), e);\n        return 1;\n    }\n    0\n}\n''')\nPY\n/app/wick.sh\nprintf '%s\\n' '--- generated pull ---'; cat /app/vaultbin/pull.rs\nprintf '%s\\n' '--- ELF magic ---'; od -An -tx1 -N4 /app/bin/weltquay\n/app/bin/weltquay pour; rc=$?; echo \"valid_rc=$rc\"; cat /app/blotbay/rows.json\n"]
[57.885593, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[57.885672, "o", "\u001b[?2004h> "]
[57.885731, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.885748, "o", "> "]
[57.888635, "o", "p=Path('/app/stitchbay/card.rs')\r\n\u001b[?2004l\r\u001b[?2004h> s=p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('        let mut pos: u32 = match parts[1].parse() {', '        let pos: u32 = match parts[1].parse() {')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('        if n > 8 {\\n            pos = pos.saturating_add(8 - (pos % 8));\\n        }\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Path('/app/octetkiln/take.rs').write_text('''pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n\u001b[?2004l\r\u001b[?2004h>     if n == 0 || n > 32 {\r\n\u001b[?2004l\r\u001b[?2004h>         return 0;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     crate::lsb::rib_f(buf, pos, n)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p=Path('/app/weltcli/boot.rs')\r\n\u001b[?2004l\r\u001b[?2004h> s=p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('#[path = \"../octetkiln/take.rs\"]\\nmod take;', '#[path = \"../octetkiln/take.rs\"]\\nmod take;\\n#[path = \"../octetkiln/lsb.rs\"]\\nmod lsb;')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p=Path('/app/octetkiln/emit.rs')\r\n\u001b[?2004l\r\u001b[?2004h> s=p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.889307, "o", "s=s.replace('    let (x0, x1) = pick(&rows, \"mark\");', '    let (x0, x1) = pick(&rows, \"mark\");\\n    let width = rows.iter().map(|r| r.pos.saturating_add(r.n)).max().unwrap_or(0).saturating_add(7) / 8;')\r\n\u001b[?2004l\r"]
[57.889558, "o", "\u001b[?2004h"]
