[57.897733, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     );\r\n\u001b[?2004l\r\u001b[?2004h>     if let Some(parent) = dest.parent() {\r\n\u001b[?2004l\r\u001b[?2004h>         if let Err(e) = fs::create_dir_all(parent) {\r\n\u001b[?2004l\r\u001b[?2004h>             eprintln!(\"cannot create output directory: {}\", e);\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if let Err(e) = fs::write(dest, body) {\r\n\u001b[?2004l\r\u001b[?2004h>         eprintln!(\"cannot write {}: {}\", dest.display(), e);\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
