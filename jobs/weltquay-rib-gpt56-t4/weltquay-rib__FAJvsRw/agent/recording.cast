[60.601897, "o", "printf '%s\\n' '--- generated pull ---'; cat /app/vaultbin/pull.rs\r\n\u001b[?2004l\r--- generated pull ---\r\n"]
[60.602832, "o", "use crate::take;\r\n\r\npub const WIDTH: usize = 4usize;\r\n\r\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n    (\r\n        take::rib_a(buf, 0, 3),\r\n        take::rib_a(buf, 3, 6),\r\n        take::rib_a(buf, 9, 3),\r\n        take::rib_a(buf, 12, 9),\r\n        take::rib_a(buf, 21, 3),\r\n        take::rib_a(buf, 24, 8),\r\n    )\r\n}\r\n"]
[60.603037, "o", "\u001b[?2004h"]
[60.603065, "o", "root@ddb5ff434a45:/app# "]
