[18.930344, "o", "    10\t    pub n0: u32,\r\n    11\t    pub n1: u32,\r\n    12\t    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    13\t    pub flag: bool,\r\n    14\t}\r\n    15\t\r\n    16\t#[allow(dead_code)]\r\n    17\tpub struct Frost {\r\n    18\t    pub n0: u32,\r\n    19\t    pub n1: u32,\r\n    20\t    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    21\t    pub cells: Vec<String>,\r\n"]
