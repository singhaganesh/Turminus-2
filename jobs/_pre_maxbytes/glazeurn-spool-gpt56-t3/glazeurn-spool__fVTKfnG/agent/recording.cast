[18.407204, "o", "===== bake.sh =====\r\n"]
[18.410236, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/inkpit\r\nrustc --edition 2021 -O /app/emitbay/main.rs -o /tmp/glaze-emit\r\n/tmp/glaze-emit\r\nrustc --edition 2021 -O /app/steerpit/boot.rs -o /app/bin/glazeurn\r\n"]
[18.410695, "o", "===== vatslip/ROUTE.txt =====\r\n"]
[18.411913, "o", "Cards live under /app/daycards. The working spool is /app/spoolbay/shift.spool.\r\npair writes /app/inkpit/pair.json. bind refreshes mill pieces from TREE.txt.\r\n"]
[18.412335, "o", "===== noteurn/LAYOUT.txt =====\r\n"]
[18.41329, "o", "pair.json keys tick mark frost_bag live_bag\r\n"]
[18.413543, "o", "===== steerpit/usage.txt =====\r\n"]
[18.417212, "o", "glazeurn bind\r\nglazeurn pair\r\n===== coverpit/COVER.txt =====\r\nDesk count 9. Pair looks stuck until this count lands on tick.\r\nThe mill reads this slip during bind walks.\r\nNight desk leaves it next to TREE.txt.\r\nKeep the count on the desk slip only.\r\n===== spoolbay/shift.spool =====\r\n"]
[18.418379, "o", "tick 7\r\nmark 4\r\nbag oak elm ash\r\nmode heat\r\nswap elm yew\r\npush fir\r\n"]
[18.418679, "o", "\u001b[?2004h"]
