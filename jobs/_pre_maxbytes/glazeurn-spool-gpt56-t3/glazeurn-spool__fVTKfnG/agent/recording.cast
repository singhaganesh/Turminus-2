[18.925678, "o", "     8\t    let _ = b;\r\n     9\t    hold::Frost {\r\n    10\t        n0: a.n0,\r\n    11\t        n1: a.n1,\r\n    12\t        ids: a.ids.clone(),\r\n    13\t        cells: Vec::new(),\r\n    14\t    }\r\n    15\t}\r\n    16\t\"#;\r\n    17\t    let pool = r#\"use crate::fold;\r\n"]
[18.925698, "o", "    18\tuse crate::hold;\r\n    19\tuse crate::load;\r\n    20\tuse crate::tally;\r\n    21\tuse std::fs;\r\n    22\tuse std::path::Path;\r\n    23\t\r\n    24\tpub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n"]
[18.925717, "o", "    25\t    let _ = (a, b);\r\n    26\t}\r\n    27\t\r\n"]
[18.925859, "o", "    28\tpub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    29\t    let mut f = fold::rim_a(a, b);\r\n    30\t    rim_b(&mut f, b);\r\n    31\t    f\r\n    32\t}\r\n    33\t\r\n    34\tfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    35\t    let mut parts = Vec::new();\r\n    36\t    for &i in ids {\r\n    37\t        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n    38\t        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    39\t    }\r\n    40\t    format!(\"[{}]\", parts.join(\",\"))\r\n    41\t}\r\n    42\t\r\n    43\tpub fn dump() -> i32 {\r\n    44\t    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n    45\t        return 1;\r\n    46\t    };\r\n    47\t    let frost = prep(&sess, &pool);\r\n    48\t    load::step(&mut sess, &mut pool, &plan);\r\n    49\t    let live_ids = sess.ids.borrow().clone();\r\n    50\t    let _frost_ids = frost.ids.borrow().clone();\r\n    51\t    let extra = tally::lines();\r\n"]
[18.925878, "o", "    52\t    let frost_s = pack(&live_ids, &pool.cells);\r\n    53\t    let live_s = pack(&live_ids, &pool.cells);\r\n    54\t    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    55\t    if let Some(parent) = dest.parent() {\r\n    56\t        let _ = fs::create_dir_all(parent);\r\n    57\t    }\r\n    58\t    let body = format!(\r\n    59\t        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n    60\t        sess.n0.saturating_add(extra),\r\n"]
[18.92589, "o", "    61\t        sess.n1,\r\n    62\t        frost_s,\r\n    63\t        live_s\r\n    64\t    );\r\n"]
[18.925901, "o", "    65\t    match fs::write(dest, body) {\r\n    66\t        Ok(()) => 0,\r\n    67\t        Err(_) => 2,\r\n"]
[18.925912, "o", "    68\t    }\r\n    69\t}\r\n    70\t\"#;\r\n"]
[18.925923, "o", "    71\t    let ink = r#\"use crate::load;\r\n    72\tuse crate::pool;\r\n    73\tuse crate::tally;\r\n"]
[18.925933, "o", "    74\tuse std::fs;\r\n    75\tuse std::path::Path;\r\n    76\t\r\n"]
[18.925949, "o", "    77\tpub fn rim_c() -> i32 {\r\n    78\t    let _ = tally::lines();\r\n    79\t    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    80\t    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    81\t    if let Some(parent) = dest.parent() {\r\n"]
[18.925963, "o", "    82\t        let _ = fs::create_dir_all(parent);\r\n    83\t    }\r\n    84\t    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n"]
[18.925975, "o", "    85\t        let _ = fs::write(\r\n    86\t            dest,\r\n    87\t            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n    88\t        );\r\n"]
[18.925986, "o", "    89\t        let _ = fs::write(guard, \"ok\\n\");\r\n    90\t        return 0;\r\n    91\t    }\r\n"]
[18.925996, "o", "    92\t    let _ = pool::dump();\r\n    93\t    let _ = fs::write(guard, \"ok\\n\");\r\n    94\t    0\r\n"]
[18.926008, "o", "    95\t}\r\n    96\t\"#;\r\n    97\t    if fs::write(\"/app/foldrib/rim.rs\", rim).is_err() {\r\n    98\t        return 2;"]
[18.926019, "o", "\r\n    99\t    }\r\n   100\t    if fs::write(\"/app/internpit/pool.rs\", pool).is_err() {\r\n"]
[18.926029, "o", "   101\t        return 2;\r\n   102\t    }\r\n   103\t    if fs::write(\"/app/restcue/ink.rs\", ink).is_err() {\r\n"]
[18.926039, "o", "   104\t        return 2;\r\n   105\t    }\r\n   106\t    0\r\n"]
[18.92605, "o", "   107\t}\r\n"]
[18.926267, "o", "===== emitbay/main.rs =====\r\n"]
[18.927073, "o", "     1\t#[path = \"hearth.rs\"]\r\n     2\tmod hearth;\r\n     3\t\r\n     4\tfn main() {\r\n     5\t    let code = hearth::rib_d();\r\n     6\t    std::process::exit(code);\r\n     7\t}\r\n"]
[18.927359, "o", "===== steerpit/boot.rs =====\r\n"]
[18.928055, "o", "     1\t#[path = \"../sessbay/hold.rs\"]\r\n     2\tmod hold;\r\n     3\t#[path = \"../sessbay/load.rs\"]\r\n     4\tmod load;\r\n     5\t#[path = \"../foldrib/rim.rs\"]\r\n     6\tmod fold;\r\n     7\t#[path = \"../internpit/pool.rs\"]\r\n     8\tmod pool;\r\n"]
[18.92815, "o", "     9\t#[path = \"../restcue/ink.rs\"]\r\n    10\tmod vat;\r\n    11\t#[path = \"../coverpit/tally.rs\"]\r\n    12\tmod tally;\r\n    13\t#[path = \"../emitbay/hearth.rs\"]\r\n    14\tmod emit;\r\n    15\t\r\n    16\tfn main() {\r\n    17\t    let cmd = std::env::args().nth(1).unwrap_or_default();\r\n    18\t    let code = match cmd.as_str() {\r\n    19\t        \"bind\" => emit::rib_d(),\r\n    20\t        \"pair\" => vat::rim_c(),\r\n    21\t        _ => {\r\n    22\t            eprintln!(\"usage: glazeurn bind|pair\");\r\n    23\t            2\r\n    24\t        }\r\n    25\t    };\r\n    26\t    std::process::exit(code);\r\n    27\t"]
[18.928227, "o", "}\r\n"]
[18.928313, "o", "===== sessbay/load.rs =====\r\n"]
[18.929077, "o", "     1\tuse crate::hold;\r\n     2\tuse std::cell::RefCell;\r\n     3\tuse std::fs;\r\n     4\tuse std::rc::Rc;\r\n     5\t\r\n     6\tpub struct Plan {\r\n     7\t    pub old: String,\r\n"]
[18.929192, "o", "     8\t    pub new: String,\r\n     9\t    pub extra: String,\r\n    10\t}\r\n    11\t\r\n    12\tpub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\r\n    13\t    let text = fs::read_to_string(p).ok()?;\r\n    14\t    if text.trim().is_empty() {\r\n    15\t        return None;\r\n    16\t    }\r\n    17\t    let mut n0 = None;\r\n    18\t    let mut n1 = None;\r\n    19\t    let mut cells: Vec<String> = Vec::new();\r\n    20\t    let mut flag = false;\r\n    21\t    let mut old = String::new();\r\n    22\t    let mut new = String::new();\r\n    23\t    let mut extra = String::new();\r\n    24\t    for raw in text.lines() {\r\n    25\t        let line = raw.trim();\r\n    26\t        if line.is_empty() || line.starts_with('#') {\r\n    27\t            continue;\r\n    28\t        }\r\n    29\t        let mut it = line.split_whitespace();\r\n    30\t        let key = it.next()?;\r\n    31\t        match key {\r\n    32\t            \"tick\" => n0 = it.next()?.parse().ok(),\r\n    33\t            \"mark\" => n1 = it.next()?.parse().ok(),\r\n    34\t            \"bag\" => cells = it.map(|s| s.to_string()).collect(),\r\n    35\t            \"mode\" => flag = it.next() == Some(\"heat\"),\r\n    36\t            \"swap\" => {\r\n    37\t                old = it.next()?.to_string();\r\n    38\t                new = it.next()?.to_string();\r\n    39\t            }\r\n    40\t            \"push\" => extra = it.next()?.to_string(),\r\n    41\t            _ => {}\r\n    42\t        }\r\n    43\t    }\r\n"]
[18.929301, "o", "    44\t    let n0 = n0?;\r\n    45\t    let n1 = n1?;\r\n    46\t    if cells.is_empty() {\r\n    47\t        return None;\r\n    48\t    }\r\n    49\t    let ids: Vec<usize> = (0..cells.len()).collect();\r\n    50\t    let sess = hold::Sess {\r\n    51\t        n0,\r\n    52\t        n1,\r\n    53\t        ids: Rc::new(RefCell::new(ids)),\r\n    54\t        flag,\r\n    55\t    };\r\n    56\t    let pool = hold::Pool { cells };\r\n    57\t    Some((sess, pool, Plan { old, new, extra }))\r\n    58\t}\r\n    59\t\r\n    60\tpub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\r\n    61\t    if !a.flag {\r\n    62\t        a.n0 = a.n0.saturating_add(1);\r\n    63\t        a.n1 = a.n1.saturating_add(2);\r\n    64\t        return;\r\n    65\t    }\r\n    66\t    for c in b.cells.iter_mut() {\r\n    67\t        if *c == p.old {\r\n    68\t            *c = p.new.clone();\r\n    69\t        }\r\n    70\t    }\r\n    71\t    if !p.extra.is_empty() {\r\n    72\t        b.cells.push(p.extra.clone());\r\n    73\t        a.ids.borrow_mut().push(b.cells.len() - 1);\r\n    74\t    }\r\n    75\t    a.n0 = a.n0.saturating_add(1);\r\n    76\t    a.n1 = a.n1.saturating_add(2);\r\n    77\t}\r\n"]
