[68.426889, "i", "cat > /app/sessbay/load.rs <<'EOF'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::fs;\nuse std::rc::Rc;\n\npub struct Plan {\n    pub heat: bool,\n    pub old: String,\n    pub new: String,\n    pub extra: String,\n}\n\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\n    let text = fs::read_to_string(p).ok()?;\n    if text.trim().is_empty() { return None; }\n    let mut n0 = None;\n    let mut n1 = None;\n    let mut cells: Option<Vec<String>> = None;\n    let mut mode = None;\n    let mut old = String::new();\n    let mut new = String::new();\n    let mut extra = String::new();\n    for raw in text.lines() {\n        let line = raw.trim();\n        if line.is_empty() || line.starts_with('#') { continue; }\n        let mut it = line.split_whitespace();\n        match it.next()? {\n            \"tick\" => { n0 = Some(it.next()?.parse().ok()?); if it.next().is_some() { return None; } }\n            \"mark\" => { n1 = Some(it.next()?.parse().ok()?); if it.next().is_some() { return None; } }\n            \"bag\" => {\n                let v: Vec<String> = it.map(str::to_owned).collect();\n                if v.is_empty() { return None; }\n                cells = Some(v);\n            }\n            \"mode\" => {\n                mode = match it.next()? { \"heat\" => Some(true), \"peek\" => Some(false), _ => return None };\n                if it.next().is_some() { return None; }\n            }\n            \"swap\" => {\n                old = it.next()?.to_owned(); new = it.next()?.to_owned();\n                if it.next().is_some() { return None; }\n            }\n            \"push\" => {\n                extra = it.next()?.to_owned();\n                if it.next().is_some() { return None; }\n            }\n            _ => return None,\n        }\n    }\n    let (n0, n1, cells, heat) = (n0?, n1?, cells?, mode?);\n    if heat && (old.is_empty() || new.is_empty() || extra.is_empty()) { return None; }\n    let ids: Vec<usize> = (0..cells.len()).collect();\n    let sess = hold::Sess { n0, n1, ids: Rc::new(RefCell::new(ids)), flag: heat };\n    Some((sess, hold::Pool { cells }, Plan { heat, old, new, extra }))\n}\n\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\n    if p.heat {\n        for cell in &mut b.cells {\n            if *cell == p.old { *cell = p.new.clone(); }\n        }\n        b.cells.push(p.extra.clone());\n        a.ids.borrow_mut().push(b.cells.len() - 1);\n    }\n    a.n0 = a.n0.saturating_add(1);\n    a.n1 = a.n1.saturating_add(2);\n}\nEOF\n"]
[68.427198, "o", "cat > /app/sessbay/load.rs <<'EOF'\r\n\u001b[?2004l\r"]
[68.427309, "o", "\u001b[?2004h"]
[68.427346, "o", "> "]
[68.427461, "o", "use crate::hold;\r\n\u001b[?2004l\r"]
[68.427476, "o", "\u001b[?2004h"]
[68.427688, "o", "> use std::cell::RefCell;\r\n\u001b[?2004l\r"]
[68.427806, "o", "\u001b[?2004h> use std::fs;\r\n"]
[68.427991, "o", "\u001b[?2004l\r"]
[68.428084, "o", "\u001b[?2004h"]
[68.428776, "o", "> use std::rc::Rc;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub struct Plan {\r\n\u001b[?2004l\r\u001b[?2004h>     pub heat: bool,\r\n\u001b[?2004l\r\u001b[?2004h>     pub old: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub new: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub extra: String,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.429113, "o", "    let text = fs::read_to_string(p).ok()?;\r\n\u001b[?2004l\r\u001b[?2004h>     if text.trim().is_empty() { return None; }\r\n\u001b[?2004l\r\u001b[?2004h>     let mut n0 = None;\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.429157, "o", "> "]
[68.429174, "o", "    let mut n1 = None;\r\n\u001b[?2004l\r"]
[68.429292, "o", "\u001b[?2004h> "]
[68.429346, "o", "    let mut cells: Option<Vec<String>> = None;\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.429362, "o", "> "]
[68.429423, "o", "    let mut mode = None;\r\n\u001b[?2004l\r"]
[68.42944, "o", "\u001b[?2004h> "]
[68.429531, "o", "    let mut old = String::new();\r\n\u001b[?2004l\r"]
[68.429555, "o", "\u001b[?2004h> "]
[68.429638, "o", "    let mut new = String::new();\r\n\u001b[?2004l\r"]
[68.429704, "o", "\u001b[?2004h> "]
[68.430406, "o", "    let mut extra = String::new();\r\n\u001b[?2004l\r\u001b[?2004h>     for raw in text.lines() {\r\n\u001b[?2004l\r\u001b[?2004h>         let line = raw.trim();\r\n\u001b[?2004l\r\u001b[?2004h>         if line.is_empty() || line.starts_with('#') { continue; }\r\n\u001b[?2004l\r\u001b[?2004h>         let mut it = line.split_whitespace();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.430433, "o", "        match it.next()? {\r\n\u001b[?2004l\r"]
[68.430608, "o", "\u001b[?2004h> "]
[68.43069, "o", "            \"tick\" => { n0 = Some(it.next()?.parse().ok()?); if it.next().is_some() { return None; } }\r\n\u001b[?2004l\r"]
[68.430731, "o", "\u001b[?2004h> "]
[68.431257, "o", "            \"mark\" => { n1 = Some(it.next()?.parse().ok()?); if it.next().is_some() { return None; } }\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.431372, "o", "> "]
[68.431486, "o", "            \"bag\" => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.435081, "o", "                let v: Vec<String> = it.map(str::to_owned).collect();\r\n\u001b[?2004l\r\u001b[?2004h>                 if v.is_empty() { return None; }\r\n\u001b[?2004l\r\u001b[?2004h>                 cells = Some(v);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             \"mode\" => {\r\n\u001b[?2004l\r\u001b[?2004h>                 mode = match it.next()? { \"heat\" => Some(true), \"peek\" => Some(false), _ => return None };\r\n\u001b[?2004l\r\u001b[?2004h>                 if it.next().is_some() { return None; }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             \"swap\" => {\r\n\u001b[?2004l\r\u001b[?2004h>                 old = it.next()?.to_owned(); new = it.next()?.to_owned();\r\n\u001b[?2004l\r\u001b[?2004h>                 if it.next().is_some() { return None; }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             \"push\" => {\r\n\u001b[?2004l\r\u001b[?2004h>                 extra = it.next()?.to_owned();\r\n\u001b[?2004l\r\u001b[?2004h>                 if it.next().is_some() { return None; }\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             _ => return None,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let (n0, n1, cells, heat) = (n0?, n1?, cells?, mode?);\r\n\u001b[?2004l\r\u001b[?2004h>     if heat && (old.is_empty() || new.is_empty() || extra.is_empty()) { return None; }\r\n\u001b[?2004l\r\u001b[?2004h>     let ids: Vec<usize> = (0..cells.len()).collect();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.435381, "o", "    let sess = hold::Sess { n0, n1, ids: Rc::new(RefCell::new(ids)), flag: heat };\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.43542, "o", "> "]
[68.4357, "o", "    Some((sess, hold::Pool { cells }, Plan { heat, old, new, extra }))\r\n\u001b[?2004l\r"]
[68.435964, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.43753, "o", "pub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\r\n\u001b[?2004l\r\u001b[?2004h>     if p.heat {\r\n\u001b[?2004l\r\u001b[?2004h>         for cell in &mut b.cells {\r\n\u001b[?2004l\r\u001b[?2004h>             if *cell == p.old { *cell = p.new.clone(); }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         b.cells.push(p.extra.clone());\r\n\u001b[?2004l\r\u001b[?2004h>         a.ids.borrow_mut().push(b.cells.len() - 1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     a.n0 = a.n0.saturating_add(1);\r\n\u001b[?2004l\r\u001b[?2004h>     a.n1 = a.n1.saturating_add(2);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[68.442948, "o", "\u001b[?2004hroot@ce991da123db:/app# "]
[68.627514, "i", "cat > /app/emitbay/hearth.rs <<'EOF'\nuse std::collections::HashSet;\nuse std::fs;\nuse std::path::Path;\n\nfn walk_cards(path: &Path, text: &mut String) -> std::io::Result<()> {\n    for entry in fs::read_dir(path)? {\n        let entry = entry?;\n        let kind = entry.file_type()?;\n        if kind.is_dir() { walk_cards(&entry.path(), text)?; }\n        else if kind.is_file() {\n            text.push_str(&fs::read_to_string(entry.path())?);\n            text.push('\\n');\n        }\n    }\n    Ok(())\n}\n\npub fn rib_d() -> i32 {\n    let mut cards = String::new();\n    if walk_cards(Path::new(\"/app/daycards\"), &mut cards).is_err() { return 2; }\n    if !cards.lines().any(|x| x.trim() == \"emit freeze\") ||\n       !cards.lines().any(|x| x.trim() == \"emit cells\") { return 2; }\n    let tree = match fs::read_to_string(\"/app/vatslip/TREE.txt\") { Ok(x) => x, Err(_) => return 2 };\n    let pieces: HashSet<&str> = tree.lines().map(str::trim).filter(|x| !x.is_empty()).collect();\n    if ![\"foldrib\", \"internpit\", \"restcue\", \"emitbay\", \"steerpit\"].iter().all(|x| pieces.contains(x)) { return 2; }\n\n    let rim = r#\"use crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\n        cells: b.cells.clone(),\n    }\n}\n\"#;\n    let pool = r#\"use crate::fold;\nuse crate::hold;\nuse crate::load;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(_a: &mut hold::Frost, _b: &hold::Pool) {}\n\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut f = fold::rim_a(a, b);\n    rim_b(&mut f, b);\n    f\n}\n\nfn quote(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\\\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\\\"'); out\n}\n\nfn values(ids: &[usize], cells: &[String]) -> Option<Vec<String>> {\n    ids.iter().map(|&i| cells.get(i).cloned()).collect()\n}\nfn pack(v: &[String]) -> String {\n    format!(\"[{}]\", v.iter().map(|x| quote(x)).collect::<Vec<_>>().join(\",\"))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else { return 1; };\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n    let frost_ids = frost.ids.borrow().clone();\n    let live_ids = sess.ids.borrow().clone();\n    let Some(frost_bag) = values(&frost_ids, &frost.cells) else { return 1; };\n    let Some(live_bag) = values(&live_ids, &pool.cells) else { return 1; };\n    if plan.heat && frost_bag == live_bag { return 1; }\n    let body = format!(\"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\n        sess.n0, sess.n1, pack(&frost_bag), pack(&live_bag));\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    if fs::create_dir_all(dest.parent().unwrap()).is_err() { return 2; }\n    match fs::write(dest, body) { Ok(()) => 0, Err(_) => 2 }\n}\n\"#;\n    let ink = r#\"use crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    let guard = Path::new(\"/app/inkpit/GUARD\");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(dest);\n    if pool::dump() != 0 { return 1; }\n    if fs::write(guard, \"ok\\n\").is_err() {\n        let _ = fs::remove_file(guard);\n        return 2;\n    }\n    0\n}\n\"#;\n    if fs::write(\"/app/foldrib/rim.rs\", rim).is_err() { return 2; }\n    if fs::write(\"/app/internpit/pool.rs\", pool).is_err() { return 2; }\n    if fs::write(\"/app/restcue/ink.rs\", ink).is_err() { return 2; }\n    0\n}\nEOF\nchmod +x /app/bake.sh\nPATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:$PATH /app/bake.sh\n"]
