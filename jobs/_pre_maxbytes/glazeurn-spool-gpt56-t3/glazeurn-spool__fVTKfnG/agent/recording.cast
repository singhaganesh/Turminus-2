[68.64447, "o", "    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else { return 1; };\r\n\u001b[?2004l\r"]
[68.644541, "o", "\u001b[?2004h> "]
[68.645782, "o", "    let frost = prep(&sess, &pool);\r\n\u001b[?2004l\r\u001b[?2004h>     load::step(&mut sess, &mut pool, &plan);\r\n\u001b[?2004l\r\u001b[?2004h>     let frost_ids = frost.ids.borrow().clone();\r\n\u001b[?2004l\r\u001b[?2004h>     let live_ids = sess.ids.borrow().clone();\r\n\u001b[?2004l\r\u001b[?2004h>     let Some(frost_bag) = values(&frost_ids, &frost.cells) else { return 1; };\r\n\u001b[?2004l\r\u001b[?2004h>     let Some(live_bag) = values(&live_ids, &pool.cells) else { return 1; };\r\n\u001b[?2004l\r\u001b[?2004h>     if plan.heat && frost_bag == live_bag { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.645954, "o", "    let body = format!(\"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n\u001b[?2004l\r"]
[68.645978, "o", "\u001b[?2004h> "]
[68.646154, "o", "        sess.n0, sess.n1, pack(&frost_bag), pack(&live_bag));\r\n\u001b[?2004l\r"]
[68.646245, "o", "\u001b[?2004h> "]
[68.646741, "o", "    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::create_dir_all(dest.parent().unwrap()).is_err() { return 2; }\r\n\u001b[?2004l\r\u001b[?2004h>     match fs::write(dest, body) { Ok(()) => 0, Err(_) => 2 }\r\n\u001b[?2004l\r"]
[68.646766, "o", "\u001b[?2004h> "]
[68.64678, "o", "}\r\n\u001b[?2004l\r"]
[68.646876, "o", "\u001b[?2004h> \"#;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.646949, "o", "    let ink = r#\"use crate::pool;\r\n\u001b[?2004l\r"]
[68.64697, "o", "\u001b[?2004h"]
[68.646983, "o", "> "]
[68.647095, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.647176, "o", "use std::path::Path;\r\n\u001b[?2004l\r"]
[68.648855, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn rim_c() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let dest = Path::new(\"/app/inkpit/pair.json\");\r\n\u001b[?2004l\r\u001b[?2004h>     let guard = Path::new(\"/app/inkpit/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(dest);\r\n\u001b[?2004l\r\u001b[?2004h>     if pool::dump() != 0 { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::write(guard, \"ok\\n\").is_err() {\r\n\u001b[?2004l\r\u001b[?2004h>         let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>         return 2;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \"#;\r\n\u001b[?2004l\r\u001b[?2004h>     if fs::write(\"/app/foldrib/rim.rs\", rim).is_err() { return 2; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.648964, "o", "    if fs::write(\"/app/internpit/pool.rs\", pool).is_err() { return 2; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.649153, "o", "    if fs::write(\"/app/restcue/ink.rs\", ink).is_err() { return 2; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.649256, "o", ">     0\r\n\u001b[?2004l\r"]
[68.649295, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.649395, "o", "EOF\r\n\u001b[?2004l\r"]
