[18.921045, "o", "     1\tuse crate::hold;\r\n     2\t\r\n     3\tpub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n     4\t    let _ = b;\r\n     5\t    hold::Frost {\r\n     6\t        n0: a.n0,\r\n     7\t        n1: a.n1,\r\n     8\t        ids: a.ids.clone(),\r\n     9\t        cells: Vec::new(),\r\n    10\t    }\r\n    11\t}\r\n"]
[18.92138, "o", "===== internpit/pool.rs =====\r\n"]
[18.92292, "o", "     1\tuse crate::fold;\r\n     2\tuse crate::hold;\r\n     3\tuse crate::load;\r\n     4\tuse crate::tally;\r\n     5\tuse std::fs;\r\n     6\tuse std::path::Path;\r\n     7\t\r\n     8\tpub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n     9\t    let _ = (a, b);\r\n    10\t}\r\n    11\t\r\n    12\tpub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    13\t    let mut f = fold::rim_a(a, b);\r\n    14\t    rim_b(&mut f, b);\r\n    15\t    f\r\n    16\t}\r\n    17\t\r\n    18\tfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    19\t    let mut parts = Vec::new();\r\n    20\t    for &i in ids {\r\n    21\t        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n    22\t        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    23\t    }\r\n    24\t    format!(\"[{}]\", parts.join(\",\"))\r\n    25\t}\r\n    26\t\r\n    27\tpub fn dump() -> i32 {\r\n    28\t    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n    29\t        return 1;\r\n    30\t    };\r\n"]
[18.923079, "o", "    31\t    let frost = prep(&sess, &pool);\r\n    32\t    load::step(&mut sess, &mut pool, &plan);\r\n    33\t    let live_ids = sess.ids.borrow().clone();\r\n    34\t    let _frost_ids = frost.ids.borrow().clone();\r\n    35\t    let extra = tally::lines();\r\n    36\t    let frost_s = pack(&live_ids, &pool.cells);\r\n    37\t    let live_s = pack(&live_ids, &pool.cells);\r\n    38\t    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    39\t    if let Some(parent) = dest.parent() {\r\n    40\t        let _ = fs::create_dir_all(parent);\r\n    41\t    }\r\n    42\t    let body = format!(\r\n    43\t        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n    44\t        sess.n0.saturating_add(extra),\r\n    45\t        sess.n1,\r\n    46\t        frost_s,\r\n    47\t        live_s\r\n    48\t    );\r\n    49\t    match fs::write(dest, body) {\r\n    50\t        Ok(()) => 0,\r\n    51\t        Err(_) => 2,\r\n    52\t    }\r\n    53\t}\r\n"]
[18.923223, "o", "===== restcue/ink.rs =====\r\n"]
[18.924407, "o", "     1\tuse crate::load;\r\n     2\tuse crate::pool;\r\n     3\tuse crate::tally;\r\n     4\tuse std::fs;\r\n     5\tuse std::path::Path;\r\n     6\t\r\n     7\tpub fn rim_c() -> i32 {\r\n     8\t    let _ = tally::lines();\r\n     9\t    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    10\t    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    11\t    if let Some(parent) = dest.parent() {\r\n    12\t        let _ = fs::create_dir_all(parent);\r\n    13\t    }\r\n    14\t    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n    15\t        let _ = fs::write(\r\n    16\t            dest,\r\n    17\t            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n"]
[18.924519, "o", "    18\t        );\r\n    19\t        let _ = fs::write(guard, \"ok\\n\");\r\n    20\t        return 0;\r\n    21\t    }\r\n    22\t    let _ = pool::dump();\r\n    23\t    let _ = fs::write(guard, \"ok\\n\");\r\n    24\t    0\r\n    25\t}\r\n"]
[18.924766, "o", "===== emitbay/hearth.rs =====\r\n"]
