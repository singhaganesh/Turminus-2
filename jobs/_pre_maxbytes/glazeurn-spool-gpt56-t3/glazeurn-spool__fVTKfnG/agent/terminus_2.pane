===== sessbay/load.rs =====
     1	use crate::hold;
     2	use std::cell::RefCell;
     3	use std::fs;
     4	use std::rc::Rc;
     5	
     6	pub struct Plan {
     7	    pub old: String,
     8	    pub new: String,
     9	    pub extra: String,
    10	}
    11	
    12	pub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {
    13	    let text = fs::read_to_string(p).ok()?;
    14	    if text.trim().is_empty() {
    15	        return None;
    16	    }
    17	    let mut n0 = None;
    18	    let mut n1 = None;
    19	    let mut cells: Vec<String> = Vec::new();
    20	    let mut flag = false;
    21	    let mut old = String::new();
    22	    let mut new = String::new();
    23	    let mut extra = String::new();
    24	    for raw in text.lines() {
    25	        let line = raw.trim();
    26	        if line.is_empty() || line.starts_with('#') {
    27	            continue;
    28	        }
    29	        let mut it = line.split_whitespace();
    30	        let key = it.next()?;
    31	        match key {
    32	            "tick" => n0 = it.next()?.parse().ok(),
    33	            "mark" => n1 = it.next()?.parse().ok(),
    34	            "bag" => cells = it.map(|s| s.to_string()).collect(),
    35	            "mode" => flag = it.next() == Some("heat"),
    36	            "swap" => {
    37	                old = it.next()?.to_string();
    38	                new = it.next()?.to_string();
    39	            }
    40	            "push" => extra = it.next()?.to_string(),
    41	            _ => {}
    42	        }
    43	    }
    44	    let n0 = n0?;
    45	    let n1 = n1?;
    46	    if cells.is_empty() {
    47	        return None;
    48	    }
    49	    let ids: Vec<usize> = (0..cells.len()).collect();
    50	    let sess = hold::Sess {
    51	        n0,
    52	        n1,
    53	        ids: Rc::new(RefCell::new(ids)),
    54	        flag,
    55	    };
    56	    let pool = hold::Pool { cells };
    57	    Some((sess, pool, Plan { old, new, extra }))
    58	}
    59	
    60	pub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {
    61	    if !a.flag {
    62	        a.n0 = a.n0.saturating_add(1);
    63	        a.n1 = a.n1.saturating_add(2);
    64	        return;
    65	    }
    66	    for c in b.cells.iter_mut() {
    67	        if *c == p.old {
    68	            *c = p.new.clone();
    69	        }
    70	    }
    71	    if !p.extra.is_empty() {
    72	        b.cells.push(p.extra.clone());
    73	        a.ids.borrow_mut().push(b.cells.len() - 1);
    74	    }
    75	    a.n0 = a.n0.saturating_add(1);
    76	    a.n1 = a.n1.saturating_add(2);
    77	}
