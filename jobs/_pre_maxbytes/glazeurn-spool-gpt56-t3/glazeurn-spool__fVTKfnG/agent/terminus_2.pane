     1	use crate::fold;
     2	use crate::hold;
     3	use crate::load;
     4	use crate::tally;
     5	use std::fs;
     6	use std::path::Path;
     7	
     8	pub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {
     9	    let _ = (a, b);
    10	}
    11	
    12	pub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {
    13	    let mut f = fold::rim_a(a, b);
    14	    rim_b(&mut f, b);
    15	    f
    16	}
    17	
    18	fn pack(ids: &[usize], cells: &[String]) -> String {
    19	    let mut parts = Vec::new();
    20	    for &i in ids {
    21	        let s = cells.get(i).map(|x| x.as_str()).unwrap_or("");
    22	        parts.push(format!("\"{}\"", s));
    23	    }
    24	    format!("[{}]", parts.join(","))
    25	}
    26	
    27	pub fn dump() -> i32 {
    28	    let Some((mut sess, mut pool, plan)) = load::read_path("/app/spoolbay/shift.spool") else {
    29	        return 1;
    30	    };
    31	    let frost = prep(&sess, &pool);
    32	    load::step(&mut sess, &mut pool, &plan);
    33	    let live_ids = sess.ids.borrow().clone();
    34	    let _frost_ids = frost.ids.borrow().clone();
    35	    let extra = tally::lines();
    36	    let frost_s = pack(&live_ids, &pool.cells);
    37	    let live_s = pack(&live_ids, &pool.cells);
    38	    let dest = Path::new("/app/inkpit/pair.json");
    39	    if let Some(parent) = dest.parent() {
    40	        let _ = fs::create_dir_all(parent);
    41	    }
    42	    let body = format!(
    43	        "{{\"tick\":{},\"mark\":{},\"frost_bag\":{},\"live_bag\":{}}}\n",
    44	        sess.n0.saturating_add(extra),
    45	        sess.n1,
    46	        frost_s,
    47	        live_s
    48	    );
    49	    match fs::write(dest, body) {
    50	        Ok(()) => 0,
    51	        Err(_) => 2,
    52	    }
    53	}
