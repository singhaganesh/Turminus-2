[?2004l[?2004h>                 old = it.next()?.to_owned(); new = it.next()?.to_owned();
[?2004l[?2004h>                 if it.next().is_some() { return None; }
[?2004l[?2004h>             }
[?2004l[?2004h>             "push" => {
[?2004l[?2004h>                 extra = it.next()?.to_owned();
[?2004l[?2004h>                 if it.next().is_some() { return None; }
[?2004l[?2004h>             }
[?2004l[?2004h>             _ => return None,
[?2004l[?2004h>         }
[?2004l[?2004h>     }
