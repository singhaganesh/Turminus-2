[20.947771, "o", "pair.json keys tick mark frost_bag live_bag\r\n"]
[20.947993, "o", "===== /app/coverpit/COVER.txt =====\r\n"]
[20.948925, "o", "Desk count 9. Pair looks stuck until this count lands on tick.\r\nThe mill reads this slip during bind walks.\r\nNight desk leaves it next to TREE.txt.\r\nKeep the count on the desk slip only.\r\n"]
[20.949109, "o", "===== /app/coverpit/tally.rs =====\r\n"]
[20.95041, "o", "struct Desk;\r\n\r\npub fn lines() -> u32 {\r\n    let _ = Desk;\r\n    let text = std::fs::read_to_string(\"/app/coverpit/COVER.txt\").unwrap_or_default();\r\n    let _ = text.contains(\"Desk\");\r\n    0\r\n}\r\n"]
[20.950664, "o", "===== /app/foldrib/rim.rs =====\r\n"]
[20.951707, "o", "use crate::hold;\r\n\r\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let _ = b;\r\n    hold::Frost {\r\n        n0: a.n0,\r\n        n1: a.n1,\r\n        ids: a.ids.clone(),\r\n"]
[20.951793, "o", "        cells: Vec::new(),\r\n    }\r\n}\r\n"]
[20.951956, "o", "===== /app/internpit/pool.rs =====\r\n"]
[20.95292, "o", "use crate::fold;\r\nuse crate::hold;\r\nuse crate::load;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\n"]
[20.952942, "o", "pub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n    let _ = (a, b);\r\n}\r\n\r\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let mut f = fold::rim_a(a, b);\r\n    rim_b(&mut f, b);\r\n"]
[20.953071, "o", "    f\r\n}\r\n\r\nfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    let mut parts = Vec::new();\r\n    for &i in ids {\r\n        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    }\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n}\r\n\r\npub fn dump() -> i32 {\r\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n        return 1;\r\n    };\r\n    let frost = prep(&sess, &pool);\r\n    load::step(&mut sess, &mut pool, &plan);\r\n    let live_ids = sess.ids.borrow().clone();\r\n    let _frost_ids = frost.ids.borrow().clone();\r\n    let extra = tally::lines();\r\n    let frost_s = pack(&live_ids, &pool.cells);\r\n    let live_s = pack(&live_ids, &pool.cells);\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    let body = format!(\r\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n"]
[20.953149, "o", "        sess.n0.saturating_add(extra),\r\n        sess.n1,\r\n        frost_s,\r\n        live_s\r\n    );\r\n    match fs::write(dest, body) {\r\n        Ok(()) => 0,\r\n        Err(_) => 2,\r\n    }\r\n}\r\n"]
[20.953299, "o", "===== /app/restcue/ink.rs =====\r\n"]
[20.954266, "o", "use crate::load;\r\nuse crate::pool;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_c() -> i32 {\r\n    let _ = tally::lines();\r\n"]
[20.954447, "o", "    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n        let _ = fs::write(\r\n            dest,\r\n"]
[20.954528, "o", "            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n        );\r\n        let _ = fs::write(guard, \"ok\\n\");\r\n        return 0;\r\n    }\r\n    let _ = pool::dump();\r\n    let _ = fs::write(guard, \"ok\\n\");\r\n    0\r\n}\r\n"]
[20.954776, "o", "===== /app/sessbay/hold.rs =====\r\n"]
[20.955621, "o", "use std::cell::RefCell;\r\nuse std::rc::Rc;\r\n\r\n#[allow(dead_code)]\r\npub struct Pool {\r\n"]
[20.955646, "o", "    pub cells: Vec<String>,\r\n}\r\n\r\npub struct Sess {\r\n    pub n0: u32,\r\n    pub n1: u32,\r\n    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    pub flag: bool,\r\n}\r\n\r\n#[allow(dead_code)]\r\npub struct Frost {\r\n    pub n0: u32,\r\n    pub n1: u32,\r\n    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    pub cells: Vec<String>,\r\n}\r\n"]
[20.955924, "o", "===== /app/sessbay/load.rs =====\r\n"]
[20.958012, "o", "use crate::hold;\r\nuse std::cell::RefCell;\r\nuse std::fs;\r\nuse std::rc::Rc;\r\n\r\npub struct Plan {\r\n    pub old: String,\r\n    pub new: String,\r\n    pub extra: String,\r\n}\r\n\r\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\r\n    let text = fs::read_to_string(p).ok()?;\r\n    if text.trim().is_empty() {\r\n        return None;\r\n    }\r\n"]
[20.958297, "o", "    let mut n0 = None;\r\n    let mut n1 = None;\r\n    let mut cells: Vec<String> = Vec::new();\r\n    let mut flag = false;\r\n    let mut old = String::new();\r\n    let mut new = String::new();\r\n    let mut extra = String::new();\r\n    for raw in text.lines() {\r\n        let line = raw.trim();\r\n        if line.is_empty() || line.starts_with('#') {\r\n            continue;\r\n        }\r\n        let mut it = line.split_whitespace();\r\n        let key = it.next()?;\r\n        match key {\r\n            \"tick\" => n0 = it.next()?.parse().ok(),\r\n            \"mark\" => n1 = it.next()?.parse().ok(),\r\n            \"bag\" => cells = it.map(|s| s.to_string()).collect(),\r\n            \"mode\" => flag = it.next() == Some(\"heat\"),\r\n            \"swap\" => {\r\n                old = it.next()?.to_string();\r\n                new = it.next()?.to_string();\r\n            }\r\n            \"push\" => extra = it.next()?.to_string(),\r\n            _ => {}\r\n        }\r\n    }\r\n    let n0 = n0?;\r\n    let n1 = n1?;\r\n    if cells.is_empty() {\r\n        return None;\r\n    }\r\n    let ids: Vec<usize> = (0..cells.len()).collect();\r\n    let sess = hold::Sess {\r\n        n0,\r\n        n1,\r\n        ids: Rc::new(RefCell::new(ids)),\r\n        flag,\r\n    };\r\n    let pool = hold::Pool { cells };\r\n    Some((sess, pool, Plan { old, new, extra }))\r\n}\r\n\r\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\r\n    if !a.flag {\r\n        a.n0 = a.n0.saturating_add(1);\r\n        a.n1 = a.n1.saturating_add(2);\r\n        return;\r\n    }\r\n    for c in b.cells.iter_mut() {\r\n        if *c == p.old {\r\n            *c = p.new.clone();\r\n        }\r\n    }\r\n    if !p.extra.is_empty() {\r\n        b.cells.push(p.extra.clone());\r\n        a.ids.borrow_mut().push(b.cells.len() - 1);\r\n    }\r\n    a.n0 = a.n0.saturating_add(1);\r\n    a.n1 = a.n1.saturating_add(2);\r\n}\r\n"]
[20.958816, "o", "===== /app/emitbay/hearth.rs =====\r\n"]
[20.960409, "o", "use std::fs;\r\n\r\npub fn rib_d() -> i32 {\r\n"]
[20.960539, "o", "    let _ = fs::read_dir(\"/app/daycards\");\r\n    let rim = r#\"use crate::hold;\r\n\r\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let _ = b;\r\n    hold::Frost {\r\n        n0: a.n0,\r\n        n1: a.n1,\r\n        ids: a.ids.clone(),\r\n        cells: Vec::new(),\r\n    }\r\n}\r\n\"#;\r\n    let pool = r#\"use crate::fold;\r\nuse crate::hold;\r\nuse crate::load;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n    let _ = (a, b);\r\n}\r\n\r\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let mut f = fold::rim_a(a, b);\r\n    rim_b(&mut f, b);\r\n    f\r\n}\r\n\r\nfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    let mut parts = Vec::new();\r\n    for &i in ids {\r\n        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    }\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n}\r\n\r\npub fn dump() -> i32 {\r\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n        return 1;\r\n    };\r\n    let frost = prep(&sess, &pool);\r\n    load::step(&mut sess, &mut pool, &plan);\r\n    let live_ids = sess.ids.borrow().clone();\r\n    let _frost_ids = frost.ids.borrow().clone();\r\n    let extra = tally::lines();\r\n    let frost_s = pack(&live_ids, &pool.cells);\r\n    let live_s = pack(&live_ids, &pool.cells);\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    let body = format!(\r\n"]
[20.960638, "o", "        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n        sess.n0.saturating_add(extra),\r\n        sess.n1,\r\n        frost_s,\r\n        live_s\r\n    );\r\n    match fs::write(dest, body) {\r\n        Ok(()) => 0,\r\n        Err(_) => 2,\r\n    }\r\n}\r\n\"#;\r\n    let ink = r#\"use crate::load;\r\nuse crate::pool;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n        let _ = fs::write(\r\n            dest,\r\n            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n        );\r\n        let _ = fs::write(guard, \"ok\\n\");\r\n        return 0;\r\n    }\r\n    let _ = pool::dump();\r\n    let _ = fs::write(guard, \"ok\\n\");\r\n    0\r\n}\r\n\"#;\r\n    if fs::write(\"/app/foldrib/rim.rs\", rim).is_err() {\r\n        return 2;\r\n    }\r\n    if fs::write(\"/app/internpit/pool.rs\", pool).is_err() {\r\n        return 2;\r\n    }\r\n    if fs::write(\"/app/restcue/ink.rs\", ink).is_err() {\r\n        return 2;\r\n    }\r\n    0\r\n}\r\n"]
[20.961007, "o", "===== /app/emitbay/main.rs =====\r\n"]
[20.962277, "o", "#[path = \"hearth.rs\"]\r\nmod hearth;\r\n\r\nfn main() {\r\n    let code = hearth::rib_d();\r\n    std::process::exit(code);\r\n}\r\n"]
[20.962578, "o", "===== /app/steerpit/boot.rs =====\r\n"]
[20.963844, "o", "#[path = \"../sessbay/hold.rs\"]\r\nmod hold;\r\n#[path = \"../sessbay/load.rs\"]\r\nmod load;\r\n#[path = \"../foldrib/rim.rs\"]\r\nmod fold;\r\n#[path = \"../internpit/pool.rs\"]\r\nmod pool;\r\n#[path = \"../restcue/ink.rs\"]\r\nmod vat;\r\n#[path = \"../coverpit/tally.rs\"]\r\nmod tally;\r\n"]
[20.963962, "o", "#[path = \"../emitbay/hearth.rs\"]\r\nmod emit;\r\n\r\nfn main() {\r\n    let cmd = std::env::args().nth(1).unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"bind\" => emit::rib_d(),\r\n        \"pair\" => vat::rim_c(),\r\n        _ => {\r\n            eprintln!(\"usage: glazeurn bind|pair\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[20.964147, "o", "===== /app/steerpit/usage.txt =====\r\n"]
[20.965208, "o", "glazeurn bind\r\nglazeurn pair\r\n"]
[20.965497, "o", "\u001b[?2004h"]
