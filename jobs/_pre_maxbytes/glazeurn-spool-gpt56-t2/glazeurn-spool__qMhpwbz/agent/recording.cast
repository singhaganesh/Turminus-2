[20.94208, "o", "emit freeze\r\n"]
[20.942814, "o", "===== /app/vatslip/ROUTE.txt =====\r\n"]
[20.944433, "o", "Cards live under /app/daycards. The working spool is /app/spoolbay/shift.spool.\r\npair writes /app/inkpit/pair.json. bind refreshes mill pieces from TREE.txt.\r\n"]
[20.94476, "o", "===== /app/vatslip/TREE.txt =====\r\n"]
[20.946165, "o", "foldrib\r\ninternpit\r\nrestcue\r\nemitbay\r\nsteerpit\r\n"]
