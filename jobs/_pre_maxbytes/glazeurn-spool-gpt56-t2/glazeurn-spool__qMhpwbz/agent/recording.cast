[94.337851, "o", "\u001b[?2004h"]
[94.338123, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[94.338712, "o", "> const FOLD: &str = include_str!(\"../foldrib/rim.rs\");\r\n\u001b[?2004l\r\u001b[?2004h> const POOL: &str = include_str!(\"../internpit/pool.rs\");\r\n\u001b[?2004l\r\u001b[?2004h> const INK: &str = include_str!(\"../restcue/ink.rs\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.339199, "o", "const BOOT: &str = include_str!(\"../steerpit/boot.rs\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.340442, "o", "const HEARTH: &str = include_str!(\"hearth.rs\");\r\n\u001b[?2004l\r\u001b[?2004h> const MAIN: &str = include_str!(\"main.rs\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn put(path: &str, body: &str) -> Result<(), ()> {\r\n\u001b[?2004l\r\u001b[?2004h>     fs::write(path, body).map_err(|_| ())\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn rib_d() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let mut cards = match fs::read_dir(\"/app/daycards\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.340711, "o", "        Ok(v) => v.filter_map(Result::ok).map(|e| e.path()).collect::<Vec<_>>(),\r\n\u001b[?2004l\r"]
[94.34086, "o", "\u001b[?2004h>         Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[94.340885, "o", "\u001b[?2004h"]
[94.340898, "o", "> "]
[94.341061, "o", "    cards.sort();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.341076, "o", "    let mut emits = BTreeSet::new();\r\n\u001b[?2004l\r"]
[94.341244, "o", "\u001b[?2004h>     for card in cards {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.34162, "o", "        if !card.is_file() {\r\n\u001b[?2004l\r\u001b[?2004h>             continue;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.341724, "o", "        let text = match fs::read_to_string(&card) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.341741, "o", "            Ok(v) => v,\r\n"]
[94.341752, "o", "\u001b[?2004l\r"]
[94.341957, "o", "\u001b[?2004h>             Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.34224, "o", "        for line in text.lines().map(str::trim).filter(|s| !s.is_empty() && !s.starts_with('#')) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.342365, "o", "            let mut words = line.split_whitespace();\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.342432, "o", "> "]
[94.342525, "o", "            if words.next() != Some(\"emit\") {\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.342594, "o", "> "]
[94.342633, "o", "                return 1;\r\n\u001b[?2004l\r"]
[94.342719, "o", "\u001b[?2004h> "]
[94.342743, "o", "            }\r\n\u001b[?2004l\r"]
[94.343095, "o", "\u001b[?2004h>             let Some(piece) = words.next() else { return 1; };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.343214, "o", "            if words.next().is_some() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.343298, "o", "                return 1;\r\n\u001b[?2004l\r"]
[94.343311, "o", "\u001b[?2004h"]
[94.343322, "o", "> "]
[94.343779, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>             emits.insert(piece.to_string());\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.343805, "o", "    }\r\n\u001b[?2004l\r"]
[94.343822, "o", "\u001b[?2004h> "]
[94.343835, "o", "\r\n\u001b[?2004l\r"]
[94.344223, "o", "\u001b[?2004h>     let tree = match fs::read_to_string(\"/app/vatslip/TREE.txt\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.344302, "o", "        Ok(v) => v,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.344437, "o", "        Err(_) => return 1,\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.344468, "o", ">     };\r\n\u001b[?2004l\r"]
[94.344482, "o", "\u001b[?2004h> "]
[94.344649, "o", "    let names: BTreeSet<&str> = tree.lines().map(str::trim)\r\n\u001b[?2004l\r"]
[94.344684, "o", "\u001b[?2004h"]
[94.344727, "o", "> "]
[94.345033, "o", "        .filter(|s| !s.is_empty() && !s.starts_with('#')).collect();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.345473, "o", "    let required = [\"foldrib\", \"internpit\", \"restcue\", \"emitbay\", \"steerpit\"];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.345559, "o", "    if required.iter().any(|name| !names.contains(name)) {\r\n\u001b[?2004l\r"]
[94.345591, "o", "\u001b[?2004h"]
[94.345954, "o", ">         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if !emits.contains(\"freeze\") || !emits.contains(\"cells\") {\r\n\u001b[?2004l\r"]
[94.346494, "o", "\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let writes = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.346542, "o", ">         (\"/app/foldrib/rim.rs\", FOLD),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.346966, "o", "        (\"/app/internpit/pool.rs\", POOL),\r\n\u001b[?2004l\r\u001b[?2004h>         (\"/app/restcue/ink.rs\", INK),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.347007, "o", "        (\"/app/emitbay/hearth.rs\", HEARTH),\r\n\u001b[?2004l\r"]
[94.347039, "o", "\u001b[?2004h"]
[94.347057, "o", "> "]
[94.3477, "o", "        (\"/app/emitbay/main.rs\", MAIN),\r\n\u001b[?2004l\r"]
[94.347735, "o", "\u001b[?2004h>         (\"/app/steerpit/boot.rs\", BOOT),\r\n\u001b[?2004l\r\u001b[?2004h>     ];\r\n\u001b[?2004l\r\u001b[?2004h>     for (path, body) in writes {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.348141, "o", "        if !Path::new(path).parent().is_some_and(Path::is_dir) || put(path, body).is_err() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.348286, "o", "            return 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.348384, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n"]
[94.348508, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[94.348602, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[94.350234, "o", "\u001b[?2004hroot@763a076e284b:/app# "]
