[37.322808, "o", "echo '===== hold.rs ====='; cat /app/sessbay/hold.rs; echo '===== load.rs ====='; cat /app/sessbay/load.rs; echo '===== rust ====='; rustc --version\r\n"]
[37.322946, "o", "\u001b[?2004l\r"]
[37.324124, "o", "===== hold.rs =====\r\n"]
[37.326478, "o", "use std::cell::RefCell;\r\nuse std::rc::Rc;\r\n\r\n#[allow(dead_code)]\r\npub struct Pool {\r\n    pub cells: Vec<String>,\r\n}\r\n\r\npub struct Sess {\r\n    pub n0: u32,\r\n    pub n1: u32,\r\n    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    pub flag: bool,\r\n}\r\n\r\n#[allow(dead_code)]\r\npub struct Frost {\r\n    pub n0: u32,\r\n    pub n1: u32,\r\n    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    pub cells: Vec<String>,\r\n}\r\n"]
[37.327198, "o", "===== load.rs =====\r\n"]
[37.328296, "o", "use crate::hold;\r\nuse std::cell::RefCell;\r\nuse std::fs;\r\nuse std::rc::Rc;\r\n\r\npub struct Plan {\r\n    pub old: String,\r\n    pub new: String,\r\n    pub extra: String,\r\n}\r\n\r\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\r\n    let text = fs::read_to_string(p).ok()?;\r\n    if text.trim().is_empty() {\r\n        return None;\r\n    }\r\n    let mut n0 = None;\r\n    let mut n1 = None;\r\n    let mut cells: Vec<String> = Vec::new();\r\n    let mut flag = false;\r\n    let mut old = String::new();\r\n    let mut new = String::new();\r\n    let mut extra = String::new();\r\n    for raw in text.lines() {\r\n        let line = raw.trim();\r\n        if line.is_empty() || line.starts_with('#') {\r\n            continue;\r\n        }\r\n        let mut it = line.split_whitespace();\r\n        let key = it.next()?;\r\n        match key {\r\n            \"tick\" => n0 = it.next()?.parse().ok(),\r\n            \"mark\" => n1 = it.next()?.parse().ok(),\r\n            \"bag\" => cells = it.map(|s| s.to_string()).collect(),\r\n            \"mode\" => flag = it.next() == Some(\"heat\"),\r\n            \"swap\" => {\r\n                old = it.next()?.to_string();\r\n                new = it.next()?.to_string();\r\n            }\r\n            \"push\" => extra = it.next()?.to_string(),\r\n            _ => {}\r\n        }\r\n    }\r\n    let n0 = n0?;\r\n    let n1 = n1?;\r\n    if cells.is_empty() {\r\n        return None;\r\n    }\r\n    let ids: Vec<usize> = (0..cells.len()).collect();\r\n    let sess = hold::Sess {\r\n        n0,\r\n        n1,\r\n        ids: Rc::new(RefCell::new(ids)),\r\n        flag,\r\n    };\r\n    let pool = hold::Pool { cells };\r\n    Some((sess, pool, Plan { old, new, extra }))\r\n}\r\n\r\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\r\n    if !a.flag {\r\n        a.n0 = a.n0.saturating_add(1);\r\n        a.n1 = a.n1.saturating_add(2);\r\n        return;\r\n    }\r\n    for c in b.cells.iter_mut() {\r\n        if *c == p.old {\r\n            *c = p.new.clone();\r\n        }\r\n    }\r\n    if !p.extra.is_empty() {\r\n        b.cells.push(p.extra.clone());\r\n        a.ids.borrow_mut().push(b.cells.len() - 1);\r\n    }\r\n    a.n0 = a.n0.saturating_add(1);\r\n    a.n1 = a.n1.saturating_add(2);\r\n}\r\n"]
[37.329226, "o", "===== rust =====\r\n"]
[37.329881, "o", "bash: rustc: command not found\r\n"]
[37.333813, "o", "\u001b[?2004h"]
[37.335409, "o", "root@763a076e284b:/app# "]
[94.140591, "i", "cat > /app/foldrib/rim.rs <<'EOF'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\n        cells: b.cells.clone(),\n    }\n}\nEOF\ncat > /app/internpit/pool.rs <<'EOF'\nuse crate::fold;\nuse crate::hold;\nuse crate::load;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(_a: &mut hold::Frost, _b: &hold::Pool) {}\n\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut f = fold::rim_a(a, b);\n    rim_b(&mut f, b);\n    f\n}\n\nfn take(ids: &[usize], cells: &[String]) -> Vec<String> {\n    ids.iter().filter_map(|&i| cells.get(i).cloned()).collect()\n}\n\nfn pack(values: &[String]) -> String {\n    let parts: Vec<String> = values.iter().map(|s| format!(\"{:?}\", s)).collect();\n    format!(\"[{}]\", parts.join(\",\"))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\n        return 1;\n    };\n    let heat = sess.flag;\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n\n    let frost_values = take(&frost.ids.borrow(), &frost.cells);\n    let live_values = take(&sess.ids.borrow(), &pool.cells);\n    if heat && frost_values == live_values {\n        return 3;\n    }\n\n    let _ = tally::lines();\n    let body = format!(\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\n        sess.n0,\n        sess.n1,\n        pack(&frost_values),\n        pack(&live_values)\n    );\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() {\n            return 2;\n        }\n    }\n    match fs::write(dest, body) {\n        Ok(()) => 0,\n        Err(_) => 2,\n    }\n}\nEOF\ncat > /app/restcue/ink.rs <<'EOF'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    let guard = Path::new(\"/app/inkpit/GUARD\");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(dest);\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() {\n            return 2;\n        }\n    }\n    let code = pool::dump();\n    if code != 0 {\n        let _ = fs::remove_file(dest);\n        return code;\n    }\n    if fs::write(guard, \"ok\\n\").is_err() {\n        let _ = fs::remove_file(guard);\n        return 2;\n    }\n    0\n}\nEOF\n"]
