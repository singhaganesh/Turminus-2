se crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let dest = Path::new("/app/inkpit/pair.json");\n    let guard = Path::new("/app/inkpit/GUARD");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(dest);\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() {\n            return 2;\n        }\n    }\n    let code = pool::dump();\n    if code != 0 {\n        let _ = fs::remove_file(dest);\n        return code;\n    }\n    if fs::write(guard, "ok\\n").is_err() {\n        let _ = fs::remove_file(guard);\n        return 2;\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
Sending keys: ['cat > /app/emitbay/hearth.rs <<\'EOF\'\nuse std::collections::BTreeSet;\nuse std::fs;\nuse std::path::Path;\n\nconst FOLD: &str = include_str!("../foldrib/rim.rs");\nconst POOL: &str = include_str!("../internpit/pool.rs");\nconst INK: &str = include_str!("../restcue/ink.rs");\nconst BOOT: &str = include_str!("../steerpit/boot.rs");\nconst HEARTH: &str = include_str!("hearth.rs");\nconst MAIN: &str = include_str!("main.rs");\n\nfn put(path: &str, body: &str) -> Result<(), ()> {\n    fs::write(path, body).map_err(|_| ())\n}\n\npub fn rib_d() -> i32 {\n    let mut cards = match fs::read_dir("/app/daycards") {\n        Ok(v) => v.filter_map(Result::ok).map(|e| e.path()).collect::<Vec<_>>(),\n        Err(_) => return 1,\n    };\n    cards.sort();\n    let mut emits = BTreeSet::new();\n    for card in cards {\n        if !card.is_file() {\n            continue;\n        }\n        let text = match fs::read_to_string(&card) {\n            Ok(v) => v,\n            Err(_) => return 1,\n        };\n        for line in text.lines().map(str::trim).filter(|s| !s.is_empty() && !s.starts_with(\'#\')) {\n            let mut words = line.split_whitespace();\n            if words.next() != Some("emit") {\n                return 1;\n            }\n            let Some(piece) = words.next() else { return 1; };\n            if words.next().is_some() {\n                return 1;\n            }\n            emits.insert(piece.to_string());\n        }\n    }\n\n    let tree = match fs::read_to_string("/app/vatslip/TREE.txt") {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    let names: BTreeSet<&str> = tree.lines().map(str::trim)\n        .filter(|s| !s.is_empty() && !s.starts_with(\'#\')).collect();\n    let required = ["foldrib", "internpit", "restcue", "emitbay", "steerpit"];\n    if required.iter().any(|name| !names.contains(name)) {\n        return 1;\n    }\n    if !emits.contains("freeze") || !emits.contains("cells") {\n        return 1;\n    }\n\n    let writes = [\n        ("/app/foldrib/rim.rs", FOLD),\n        ("/app/internpit/pool.rs", POOL),\n        ("/app/restcue/ink.rs", INK),\n        ("/app/emitbay/hearth.rs", HEARTH),\n        ("/app/emitbay/main.rs", MAIN),\n        ("/app/steerpit/boot.rs", BOOT),\n    ];\n    for (path, body) in writes {\n        if !Path::new(path).parent().is_some_and(Path::is_dir) || put(path, body).is_err() {\n            return 2;\n        }\n    }\n    0\n}\nEOF\n/app/bake.sh\n/app/bin/glazeurn bind; echo "bind_status=$?"\n/app/bin/glazeurn pair; echo "pair_status=$?"\nod -An -tx1 -N4 /app/bin/glazeurn\ncat /app/inkpit/pair.json; printf \'GUARD=\'; cat /app/inkpit/GUARD\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
