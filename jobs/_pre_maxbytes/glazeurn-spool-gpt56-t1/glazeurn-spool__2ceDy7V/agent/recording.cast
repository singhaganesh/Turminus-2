[84.247248, "i", "cat > /tmp/glazeurn.c <<'EOF'\n#define _POSIX_C_SOURCE 200809L\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ctype.h>\n#include <dirent.h>\n#include <sys/stat.h>\n#include <unistd.h>\n#include <errno.h>\n#include <limits.h>\n\n#define MAXTOK 2048\n#define TOKLEN 512\n\ntypedef struct { char v[MAXTOK][TOKLEN]; size_t n; } Bag;\n\nstatic int walk_cards(const char *path) {\n    struct stat st;\n    if (lstat(path, &st)) return -1;\n    if (S_ISREG(st.st_mode)) {\n        FILE *f = fopen(path, \"rb\");\n        if (!f) return -1;\n        char buf[4096]; while (fread(buf, 1, sizeof buf, f) > 0) {}\n        int bad = ferror(f); fclose(f); return bad ? -1 : 0;\n    }\n    if (!S_ISDIR(st.st_mode)) return 0;\n    DIR *d = opendir(path); if (!d) return -1;\n    struct dirent *e; int rc = 0;\n    while ((e = readdir(d))) {\n        if (!strcmp(e->d_name, \".\") || !strcmp(e->d_name, \"..\")) continue;\n        char p[PATH_MAX];\n        if (snprintf(p, sizeof p, \"%s/%s\", path, e->d_name) >= (int)sizeof p || walk_cards(p)) rc = -1;\n    }\n    closedir(d); return rc;\n}\n\nstatic int refresh_tree(void) {\n    if (walk_cards(\"/app/daycards\")) return 1;\n    FILE *f = fopen(\"/app/vatslip/TREE.txt\", \"r\"); if (!f) return 1;\n    char line[512]; int rc = 0; unsigned count = 0;\n    while (fgets(line, sizeof line, f)) {\n        char *s = line; while (isspace((unsigned char)*s)) s++;\n        char *e = s + strlen(s); while (e > s && isspace((unsigned char)e[-1])) *--e = 0;\n        if (!*s || *s == '#') continue;\n        if (strchr(s, '/') || strstr(s, \"..\")) { rc = 1; break; }\n        char p[PATH_MAX]; snprintf(p, sizeof p, \"/app/%s\", s);\n        struct stat st;\n        if (stat(p, &st) || !S_ISDIR(st.st_mode) || walk_cards(p)) { rc = 1; break; }\n        if (utimensat(AT_FDCWD, p, NULL, 0)) { rc = 1; break; }\n        count++;\n    }\n    if (ferror(f) || count == 0) rc = 1;\n    fclose(f); return rc;\n}\n\nstatic void trim(char *s) {\n    char *p = s; while (isspace((unsigned char)*p)) p++;\n    if (p != s) memmove(s, p, strlen(p) + 1);\n    size_t n = strlen(s); while (n && isspace((unsigned char)s[n-1])) s[--n] = 0;\n}\n\nstatic int one_token(char *rest, char out[TOKLEN]) {\n    trim(rest); if (!*rest) return -1;\n    char *p = rest; while (*p && !isspace((unsigned char)*p)) p++;\n    size_t n = (size_t)(p-rest); while (isspace((unsigned char)*p)) p++;\n    if (*p || n >= TOKLEN) return -1;\n    memcpy(out, rest, n); out[n] = 0; return 0;\n}\n\nstatic void json_string(FILE *f, const char *s) {\n    fputc('\"', f);\n    for (; *s; s++) {\n        unsigned char c=(unsigned char)*s;\n        if (c=='\"' || c=='\\\\') { fputc('\\\\',f); fputc(c,f); }\n        else if (c=='\\n') fputs(\"\\\\n\",f);\n        else if (c=='\\r') fputs(\"\\\\r\",f);\n        else if (c=='\\t') fputs(\"\\\\t\",f);\n        else if (c < 32) fprintf(f,\"\\\\u%04x\",c);\n        else fputc(c,f);\n    }\n    fputc('\"', f);\n}\nstatic void json_bag(FILE *f, const Bag *b) {\n    fputc('[',f); for(size_t i=0;i<b->n;i++){ if(i)fputc(',',f); json_string(f,b->v[i]); } fputc(']',f);\n}\nstatic int same_bag(const Bag *a,const Bag *b) {\n    if(a->n!=b->n)return 0; for(size_t i=0;i<a->n;i++)if(strcmp(a->v[i],b->v[i]))return 0; return 1;\n}\n\nstatic int pair(void) {\n    const char *guard=\"/app/inkpit/GUARD\", *dest=\"/app/inkpit/pair.json\", *tmp=\"/app/inkpit/.pair.json.tmp\";\n    unlink(guard); unlink(tmp);\n    FILE *f=fopen(\"/app/spoolbay/shift.spool\",\"r\"); if(!f) return 1;\n    unsigned long long tick=0,mark=0; int ht=0,hm=0,hb=0,mode=-1,hs=0,hp=0,bad=0;\n    Bag frost={0},live={0}; char old[TOKLEN]=\"\",newv[TOKLEN]=\"\",push[TOKLEN]=\"\";\n    char line[8192];\n    while(fgets(line,sizeof line,f)) {\n        if(!strchr(line,'\\n') && !feof(f)){bad=1;break;} trim(line); if(!*line||*line=='#')continue;\n        char *sp=line; while(*sp&&!isspace((unsigned char)*sp))sp++;\n        char *rest=sp; if(*sp)*sp++=0; rest=sp;\n        if(!strcmp(line,\"tick\")){ char x[TOKLEN]; if(ht||one_token(rest,x))bad=1; else {char *z; errno=0; tick=strtoull(x,&z,10); if(errno||*z)bad=1; else ht=1;} }\n        else if(!strcmp(line,\"mark\")){ char x[TOKLEN]; if(hm||one_token(rest,x))bad=1; else {c"]
[84.247525, "i", "har *z; errno=0; mark=strtoull(x,&z,10); if(errno||*z)bad=1; else hm=1;} }\n        else if(!strcmp(line,\"bag\")){ if(hb)bad=1; else { trim(rest); char *t=strtok(rest,\" \\t\\r\\n\"); while(t){if(frost.n>=MAXTOK||strlen(t)>=TOKLEN){bad=1;break;} strcpy(frost.v[frost.n++],t); t=strtok(NULL,\" \\t\\r\\n\");} hb=1; if(!frost.n)bad=1;} }\n        else if(!strcmp(line,\"mode\")){ char x[TOKLEN]; if(mode!=-1||one_token(rest,x))bad=1; else if(!strcmp(x,\"heat\"))mode=1; else if(!strcmp(x,\"peek\"))mode=0; else bad=1; }\n        else if(!strcmp(line,\"swap\")){ trim(rest); char *a=strtok(rest,\" \\t\"),*b=strtok(NULL,\" \\t\"),*c=strtok(NULL,\" \\t\"); if(hs||!a||!b||c||strlen(a)>=TOKLEN||strlen(b)>=TOKLEN)bad=1; else {strcpy(old,a);strcpy(newv,b);hs=1;} }\n        else if(!strcmp(line,\"push\")){ if(hp||one_token(rest,push))bad=1; else hp=1; }\n        else bad=1;\n        if(bad)break;\n    }\n    if(ferror(f))bad=1; fclose(f);\n    if(bad||!ht||!hm||!hb||mode<0) return 1;\n    live=frost;\n    if(mode==1) {\n        if(!hs||!hp||live.n>=MAXTOK) return 1;\n        for(size_t i=0;i<live.n;i++) if(!strcmp(live.v[i],old)) strcpy(live.v[i],newv);\n        strcpy(live.v[live.n++],push);\n    } else if(hs||hp) return 1;\n    if(tick==~0ULL||mark>~0ULL-2) return 1; tick++; mark+=2;\n    if(mode==1 && same_bag(&frost,&live)) return 1;\n    mkdir(\"/app/inkpit\",0755);\n    FILE *o=fopen(tmp,\"w\"); if(!o)return 2;\n    fprintf(o,\"{\\\"tick\\\":%llu,\\\"mark\\\":%llu,\\\"frost_bag\\\":\",tick,mark); json_bag(o,&frost);\n    fputs(\",\\\"live_bag\\\":\",o); json_bag(o,&live); fputs(\"}\\n\",o);\n    if(fflush(o)||fsync(fileno(o))||fclose(o)||rename(tmp,dest)){unlink(tmp);return 2;}\n    o=fopen(guard,\"w\"); if(!o)return 2; if(fputs(\"ok\\n\",o)<0||fclose(o)) {unlink(guard);return 2;} return 0;\n}\nint main(int argc,char **argv){ if(argc!=2){fprintf(stderr,\"usage: glazeurn bind|pair\\n\");return 2;} if(!strcmp(argv[1],\"bind\"))return refresh_tree(); if(!strcmp(argv[1],\"pair\"))return pair(); fprintf(stderr,\"usage: glazeurn bind|pair\\n\");return 2; }\nEOF\ngcc -std=c11 -O2 -Wall -Wextra /tmp/glazeurn.c -o /app/bin/glazeurn\nchmod 755 /app/bin/glazeurn\nod -An -tc -N4 /app/bin/glazeurn\n"]
