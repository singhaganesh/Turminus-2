[84.582996, "o", "\u001b[?2004hroot@28a0c60aad37:/app# "]
[86.249952, "i", "cat > /app/foldrib/rim.rs <<'EOF'\nuse crate::hold;\n\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: std::rc::Rc::new(std::cell::RefCell::new(a.ids.borrow().clone())),\n        cells: b.cells.clone(),\n    }\n}\nEOF\ncat > /app/internpit/pool.rs <<'EOF'\nuse crate::fold;\nuse crate::hold;\nuse crate::load;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(_a: &mut hold::Frost, _b: &hold::Pool) {}\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut f = fold::rim_a(a, b); rim_b(&mut f, b); f\n}\nfn quote(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() { match c { '\\\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"), '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"), c if c.is_control() => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)), c => out.push(c) } }\n    out.push('\\\"'); out\n}\nfn pack(ids: &[usize], cells: &[String]) -> String {\n    format!(\"[{}]\", ids.iter().filter_map(|&i| cells.get(i)).map(|s| quote(s)).collect::<Vec<_>>().join(\",\"))\n}\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else { return 1; };\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n    let frost_ids = frost.ids.borrow().clone();\n    let live_ids = sess.ids.borrow().clone();\n    if sess.flag && frost_ids.len() == live_ids.len() && pack(&frost_ids, &frost.cells) == pack(&live_ids, &pool.cells) { return 1; }\n    let body = format!(\"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\", sess.n0, sess.n1, pack(&frost_ids, &frost.cells), pack(&live_ids, &pool.cells));\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    if let Some(parent)=dest.parent(){ if fs::create_dir_all(parent).is_err(){return 2;} }\n    if fs::write(dest, body).is_ok(){0}else{2}\n}\nEOF\ncat > /app/restcue/ink.rs <<'EOF'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let guard = Path::new(\"/app/inkpit/GUARD\");\n    let _ = fs::remove_file(guard);\n    let code = pool::dump();\n    if code != 0 { return code; }\n    match fs::write(guard, \"ok\\n\") { Ok(()) => 0, Err(_) => { let _=fs::remove_file(guard); 2 } }\n}\nEOF\n/app/bin/glazeurn bind; echo \"bind_rc=$?\"\n/app/bin/glazeurn pair; rc=$?; echo \"heat_rc=$rc\"; cat /app/inkpit/pair.json; cat /app/inkpit/GUARD\n"]
[86.252247, "o", "cat > /app/foldrib/rim.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> use crate::hold;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n\u001b[?2004l\r\u001b[?2004h>     hold::Frost {\r\n\u001b[?2004l\r\u001b[?2004h>         n0: a.n0,\r\n\u001b[?2004l\r\u001b[?2004h>         n1: a.n1,\r\n\u001b[?2004l\r\u001b[?2004h>         ids: std::rc::Rc::new(std::cell::RefCell::new(a.ids.borrow().clone())),\r\n\u001b[?2004l\r\u001b[?2004h>         cells: b.cells.clone(),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
