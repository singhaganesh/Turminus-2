[19.427374, "o", "for f in bake.sh vatslip/ROUTE.txt noteurn/LAYOUT.txt coverpit/COVER.txt steerpit/usage.txt daycards/*.card foldrib/*.rs internpit/*.rs restcue/*.rs emitbay/*.rs steerpit/*.rs sessbay/*.rs coverpit/*.rs inkpit/pair.json inkpit/GUARD; do echo \"===== $f =====\"; sed -n '1,240p' \"/app/$f\"; done\r\n\u001b[?2004l\r"]
[19.427686, "o", "===== bake.sh =====\r\n"]
[19.430855, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/inkpit\r\nrustc --edition 2021 -O /app/emitbay/main.rs -o /tmp/glaze-emit\r\n/tmp/glaze-emit\r\nrustc --edition 2021 -O /app/steerpit/boot.rs -o /app/bin/glazeurn\r\n"]
[19.431086, "o", "===== vatslip/ROUTE.txt =====\r\n"]
[19.432381, "o", "Cards live under /app/daycards. The working spool is /app/spoolbay/shift.spool.\r\npair writes /app/inkpit/pair.json. bind refreshes mill pieces from TREE.txt.\r\n"]
[19.432647, "o", "===== noteurn/LAYOUT.txt =====\r\n"]
[19.434263, "o", "pair.json keys tick mark frost_bag live_bag\r\n"]
[19.434686, "o", "===== coverpit/COVER.txt =====\r\n"]
[19.436829, "o", "Desk count 9. Pair looks stuck until this count lands on tick.\r\nThe mill reads this slip during bind walks.\r\nNight desk leaves it next to TREE.txt.\r\nKeep the count on the desk slip only.\r\n"]
[19.437307, "o", "===== steerpit/usage.txt =====\r\n"]
[19.43894, "o", "glazeurn bind\r\nglazeurn pair\r\n"]
