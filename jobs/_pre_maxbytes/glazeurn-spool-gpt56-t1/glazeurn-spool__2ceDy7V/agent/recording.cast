[84.273043, "o", "        else if(!strcmp(line,\"mode\")){ char x[TOKLEN]; if(mode!=-1||one_token(rest,x))bad=1; else if(!strcmp(x,\"heat\"))mode=1; else if(!strcmp(x,\"peek\"))mode=0; else bad=1; }\r\n\u001b[?2004l\r"]
[84.273171, "o", "\u001b[?2004h> "]
