[27.77866, "o", "d /app/bin\r\nd /app/bloturn\r\nd /app/corkpit\r\nd /app/daywell\r\nd /app/floorcue\r\nd /app/hopcue\r\nd /app/lidcue\r\nd /app/millrib\r\nd /app/opstext\r\nd /app/packbay\r\nd /app/packbay/latest\r\nd /app/packbay/stage\r\nd /app/restpit\r\nd /app/seed\r\nd /app/seed/daywell\r\nd /app/shardfold\r\nd /app/urncue\r\nd /app/wickmill\r\nf /app/bin/dewkiln\r\nf /app/bloturn/GUARD\r\nf /app/bloturn/check.json\r\nf /app/bloturn/ledger.json\r\nf /app/corkpit/NOTE.txt\r\nf /app/corkpit/floor.rs\r\nf /app/daywell/d20260910.tbl\r\nf /app/daywell/d20260911.tbl\r\nf /app/daywell/d20260912.tbl\r\nf /app/daywell/d20260913.tbl\r\nf /app/floorcue/MIN.txt\r\nf /app/hopcue/rim.rs\r\nf /app/lidcue/skip.rs\r\nf /app/millrib/gait.rs\r\nf /app/millrib/sheet.tpl\r\nf /app/opstext/LIST.txt\r\nf /app/opstext/SHIFT.txt\r\nf /app/opstext/WALL\r\nf /app/restpit/soak.rs\r\nf /app/shardfold/read.rs\r\nf /app/urncue/fold.rs\r\nf /app/wick.sh\r\nf /app/wickmill/boot.rs\r\nf /app/wickmill/usage.txt\r\n"]
