[41.399168, "o", "/app/urncue/fold.rs:11:    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n/app/urncue/fold.rs:17:    let picked = rim::rim(wall, listed);\r\n/app/urncue/fold.rs:20:        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n/app/urncue/fold.rs:22:        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n/app/urncue/fold.rs:24:        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n/app/urncue/fold.rs:30:    let mut taken = 0;\r\n/app/urncue/fold.rs:35:        taken += read::nlines(&dest);\r\n/app/urncue/fold.rs:38:    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n/app/urncue/fold.rs:40:    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n/app/urncue/fold.rs:42:    Ok((packed, taken))\r\n/app/shardfold/read.rs:23:pub fn nlines(path: &str) -> i32 {\r\n/app/millrib/sheet.tpl:1:{\"probe\":\"__P__\",\"matched\":__M__,\"taken\":__T__}\r\n/app/millrib/gait.rs:15:    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n/app/millrib/gait.rs:19:    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n/app/wickmill/boot.rs:7:#[path = \"../corkpit/floor.rs\"]\r\n/app/wickmill/boot.rs:8:mod floor;\r\n/app/wickmill/boot.rs:18:    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n/app/wickmill/boot.rs:20:        Ok((packed, taken)) => {\r\n/app/wickmill/boot.rs:23:            let _ = floor::floor(taken);\r\n/app/wickmill/boot.rs:24:            gait::gait(taken, &packed)\r\n"]
[41.399995, "o", "\u001b[?2004hroot@678ccf757a30:/app# "]
[79.072207, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], dest: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(dest);\n    fs::create_dir_all(dest).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|x| x.0);\n    for (day, path) in files {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(&path, format!(\"{}/{}\", dest, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\n"]
[79.072457, "o", "cat > /app/hopcue/rim.rs <<'EOF'\r\n\u001b[?2004l\r"]
[79.072658, "o", "\u001b[?2004h> "]
