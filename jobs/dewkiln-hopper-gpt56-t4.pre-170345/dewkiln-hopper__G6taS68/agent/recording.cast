[79.072909, "o", "\u001b[?2004h> "]
[79.073192, "o", "    files.into_iter().filter(|(day, _)| *day <= wall).collect()\r\n\u001b[?2004l\r"]
[79.073277, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[79.073307, "o", "\u001b[?2004h"]
