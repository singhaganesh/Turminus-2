[40.929947, "i", "for f in /app/corkpit/floor.rs /app/corkpit/NOTE.txt /app/millrib/sheet.tpl /app/opstext/SHIFT.txt /app/wickmill/usage.txt; do echo \"### $f\"; cat \"$f\"; echo; done\n"]
[40.930627, "o", "for f in /app/corkpit/floor.rs /app/corkpit/NOTE.txt /app/millrib/sheet.tpl /app/opstext/SHIFT.txt /app/wickmill/usage.txt; do echo \"### $f\"; cat \"$f\"; echo; done\r\n\u001b[?2004l\r"]
[40.930833, "o", "### /app/corkpit/floor.rs\r\n"]
[40.932281, "o", "use std::fs;\r\n\r\npub fn floor(a: i32) -> bool {\r\n    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n        Err(_) => 0,\r\n    };\r\n    a >= t\r\n}\r\n"]
[40.932642, "o", "\r\n### /app/corkpit/NOTE.txt\r\n"]
[40.934711, "o", "floor() reads MIN.txt and compares a taken total to that integer.\r\nCI used this as a cheap rehearsal when the desk was first wired.\r\n"]
[40.934955, "o", "\r\n"]
[40.935134, "o", "### /app/millrib/sheet.tpl\r\n"]
[40.936725, "o", "{\"probe\":\"__P__\",\"matched\":__M__,\"taken\":__T__}\r\n"]
[40.937103, "o", "\r\n### /app/opstext/SHIFT.txt\r\n"]
[40.938357, "o", "Nightly clasp has stayed green since the CI floor landed.\r\nOperators still open /app/packbay/latest after incidents and find the\r\nnewest populated day file missing even when /app/daywell still holds it.\r\nThe floor value lives under floorcue/.\r\n"]
[40.938694, "o", "\r\n### /app/wickmill/usage.txt\r\n"]
[40.940871, "o", "dewkiln clasp\r\n"]
[40.941607, "o", "\r\n\u001b[?2004hroot@678ccf757a30:/app# "]
[41.376017, "i", "grep -RInE 'probe|matched|taken|floor|MIN|SHIFT|GUARD|nlines|latest|wall' /app --exclude=dewkiln --exclude='*.tbl' 2>/dev/null\n"]
[41.378894, "o", "grep -RInE 'probe|matched|taken|floor|MIN|SHIFT|GUARD|nlines|latest|wall' /app --exclude=dewkiln --exclude='*.tbl' 2>/dev/null\r\n\u001b[?2004l\r"]
[41.388446, "o", "/app/bloturn/ledger.json:1:{\"taken\":15}\r\n"]
[41.388617, "o", "/app/bloturn/check.json:1:{\"probe\":\"ledger\",\"matched\":15,\"taken\":15}\r\n"]
[41.388767, "o", "/app/opstext/SHIFT.txt:1:Nightly clasp has stayed green since the CI floor landed.\r\n"]
[41.393013, "o", "/app/opstext/SHIFT.txt:2:Operators still open /app/packbay/latest after incidents and find the\r\n/app/opstext/SHIFT.txt:4:The floor value lives under floorcue/.\r\n/app/opstext/LIST.txt:16:and unpacks /app/packbay/latest.\r\n/app/opstext/LIST.txt:20:- probe (string)\r\n/app/opstext/LIST.txt:21:- matched (integer)\r\n/app/opstext/LIST.txt:22:- taken (integer)\r\n/app/opstext/LIST.txt:24:CI floor integer lives in /app/floorcue/MIN.txt.\r\n"]
[41.397201, "o", "/app/corkpit/NOTE.txt:1:floor() reads MIN.txt and compares a taken total to that integer.\r\n"]
