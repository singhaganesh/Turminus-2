Sending keys: ['cat > /app/millrib/gait.rs <<\'EOF\'\nuse std::fs;\n\nfn json_string(s: &str) -> String {\n    let mut out = String::with_capacity(s.len() + 2);\n    out.push(\'"\');\n    for c in s.chars() {\n        match c {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if c.is_control() => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    let body = format!(\n        "{{\\"probe\\":{},\\"matched\\":{},\\"taken\\":{}}}",\n        json_string(probe), matched, taken\n    );\n    fs::write("/app/bloturn/check.json", body).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, files: &[(i32, String)], floor_ok: bool) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    if files.is_empty() {\n        return 1;\n    }\n\n    // Independently reopen and count the original daywell files.  Do not use\n    // ledger.json or staged copies as the verification source.\n    let mut matched = 0i32;\n    for (_, path) in files {\n        if !path.starts_with("/app/daywell/") {\n            return 1;\n        }\n        let text = match fs::read_to_string(path) {\n            Ok(text) => text,\n            Err(_) => return 1,\n        };\n        matched += text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n    }\n\n    if matched != taken || !floor_ok {\n        return 1;\n    }\n    let probe = match files.iter().max_by_key(|(day, _)| *day) {\n        Some((_, path)) => path.as_str(),\n        None => return 1,\n    };\n    if emit(probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err