Sending keys: ['cat > /app/aliaspit/hue.S <<\'EOF\'\n# ELF symbol versions: compatibility remains non-default; current is default.\n.symver wick_old,fold_frame@CASK_1\n.symver wick_new,fold_frame@@CASK_2\nEOF\ncat > /app/narbay/loom.rs <<\'EOF\'\nuse std::fs;\n\nfn value(label: &str) -> Option<String> {\n    let raw = fs::read_to_string("/app/abifolio/RULES.txt").ok()?;\n    raw.lines()\n        .find_map(|line| line.strip_prefix(label).map(|v| v.trim().to_string()))\n        .filter(|v| !v.is_empty())\n}\n\npub fn knit() -> String {\n    value("current slot:").unwrap_or_default()\n}\n\npub fn weave(path: &str) -> Result<(), i32> {\n    let current = value("current slot:").ok_or(1)?;\n    let compat = value("compat slot:").ok_or(1)?;\n    let export = value("export:").ok_or(1)?;\n    let body = format!(\n        "{compat} {{\\n  global:\\n    {export};\\n  local:\\n    *;\\n}};\\n{current} {{\\n  global:\\n    {export};\\n}} {compat};\\n"\n    );\n    fs::create_dir_all("/app/gnuverse").map_err(|_| 1)?;\n    fs::write(path, body).map_err(|_| 1)\n}\nEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
Sending keys: ['cat > /app/vatrib/qat.rs <<\'EOF\'\nuse std::fs;\nuse std::os::raw::{c_char, c_int, c_void};\n\nconst RTLD_NOW: c_int = 2;\n\nextern "C" {\n    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\n    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\n    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\n}\n\ntype FoldFn = unsafe extern "C" fn(*const u8, usize, *mut u8, usize) -> isize;\n\nstruct Rules {\n    current: String,\n    compat: String,\n    export: String,\n    sip_kind: String,\n    mark_kind: String,\n}\n\nfn rule_value(text: &str, label: &str) -> Option<String> {\n    text.lines()\n        .find_map(|line| line.strip_prefix(label).map(|v| v.trim().to_string()))\n        .filter(|v| !v.is_empty())\n}\n\nfn rules() -> Result<Rules, i32> {\n    let text = fs::read_to_string("/app/abifolio/RULES.txt").map_err(|_| 1)?;\n    Ok(Rules {\n        current: rule_value(&text, "current slot:").ok_or(1)?,\n        compat: rule_value(&text, "compat slot:").ok_or(1)?,\n        export: rule_value(&text, "export:").ok_or(1)?,\n        sip_kind: rule_value(&text, "sip kind:").ok_or(1)?,\n        mark_kind: rule_value(&text, "mark kind:").ok_or(1)?,\n    })\n}\n\nfn c_string(s: &str) -> Result<Vec<u8>, i32> {\n    if s.as_bytes().contains(&0) {\n        return Err(1);\n    }\n    let mut out = s.as_bytes().to_vec();\n    out.push(0);\n    Ok(out)\n}\n\nfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\n    if ptr.is_null() {\n        return Err(1);\n    }\n    let fold: FoldFn = unsafe { std::mem::transmute(ptr) };\n    let mut out = vec![0u8; blob.len()];\n    let n = unsafe { fold(blob.as_ptr(), blob.len(), out.as_mut_ptr(), out.len()) };\n    if n < 0 || n as usize > out.len() {\n        return Err(1);\n    }\n    out.truncate(n as usize);\n    Ok(out)\n}\n\nfn json_string(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for ch in s.chars() {\n        match ch {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if (c as u32) < 0x20 => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\n    fs::create_dir_all("/app/inkvat").map_err(|_| 1)?;\n    let body = format!(\n        "{{\\"slot\\":{},\\"text\\":{},\\"kind\\":{}}}\\n",\n        json_string(slot), json_string(text), json_string(kind)\n    );\n    fs::write("/app/inkvat/card.json", body).map_err(|_| 1)\n}\n\npub fn qat(dump: &str, named_slot: Option<&str>) -> i32 {\n    let _ = fs::remove_file("/app/inkvat/SEAL");\n\n    let rules = match rules() {\n        Ok(v) => v,\n        Err(c) => return c,\n    };\n    let (slot, kind) = match named_slot {\n        None => (rules.current.as_str(), rules.sip_kind.as_str()),\n        Some(s) if s == rules.current || s == rules.compat => (s, rules.mark_kind.as_str()),\n        Some(_) => return 1,\n    };\n    let blob = match fs::read(dump) {\n        Ok(v) if !v.is_empty() => v,\n        _ => return 1,\n    };\n\n    let symbol = match c_string(&rules.export) {\n        Ok(v) => v,\n        Err(c) => return c,\n    };\n    let handle = unsafe {\n        dlopen(b"/app/lib/libdraught.so\\0".as_ptr() as *const c_char, RTLD_NOW)\n    };\n    if handle.is_null() {\n        return 1;\n    }\n    let ptr = unsafe {\n        match named_slot {\n            None => dlsym(handle, symbol.as_ptr() as *const c_char),\n            Some(_) => {\n                let version = match c_string(slot) {\n                    Ok(v) => v,\n                    Err(c) => return c,\n                };\n                dlvsym(handle, symbol.as_ptr() as *const c_char, version.as_ptr() as *const c_char)\n            }\n        }\n    };\n    let folded = match call(ptr, &blob) {\n        Ok(v) => v,\n        Err(c) => return c,\n    };\n    let text = match String::from_utf8(folded) {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    if write_card(slot, &text, kind).is_err() {\n        return 1;\n    }\n    if fs::write("/app/inkvat/SEAL", "ok").is_err() {\n        let _ = fs::remove_file("/app/inkvat/SEAL");\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/cliurn/boot.rs <<\'EOF\'\n#[path = "../narbay/loom.rs"]\nmod loom;\n#[path = "../vatrib/qat.rs"]\nmod qat;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    let cmd = args.next().unwrap_or_default();\n    let dump = args.next().unwrap_or_default();\n    let rc = match cmd.as_str() {\n        "sip" if args.next().is_none() => qat::qat(&dump, None),\n        "mark" => {\n            let slot = args.next().unwrap_or_default();\n            if slot.is_empty() || args.next().is_some() { 1 } else { qat::qat(&dump, Some(&slot)) }\n        }\n        _ => 2,\n    };\n    std::process::exit(rc);\n}\nEOF\n/app/stoke.sh\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
