[119.521728, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.521799, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.521874, "o", "    };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.522005, "o", "    let folded = match call(ptr, &blob) {\r\n\u001b[?2004l\r"]
[119.522069, "o", "\u001b[?2004h>         Ok(v) => v,\r\n\u001b[?2004l\r"]
[119.522123, "o", "\u001b[?2004h> "]
[119.522248, "o", "        Err(c) => return c,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[119.522286, "o", "\u001b[?2004h> "]
[119.522404, "o", "    let text = match String::from_utf8(folded) {\r\n\u001b[?2004l\r"]
[119.522455, "o", "\u001b[?2004h> "]
[119.522568, "o", "        Ok(v) => v,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.522649, "o", "        Err(_) => return 1,\r\n\u001b[?2004l\r"]
[119.522726, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.522762, "o", "> "]
[119.522878, "o", "    if write_card(slot, &text, kind).is_err() {\r\n\u001b[?2004l\r"]
[119.522917, "o", "\u001b[?2004h> "]
[119.523017, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[119.523055, "o", "\u001b[?2004h> "]
[119.523201, "o", "    if fs::write(\"/app/inkvat/SEAL\", \"ok\").is_err() {\r\n\u001b[?2004l\r"]
[119.523234, "o", "\u001b[?2004h> "]
[119.52339, "o", "        let _ = fs::remove_file(\"/app/inkvat/SEAL\");\r\n\u001b[?2004l\r"]
[119.523488, "o", "\u001b[?2004h> "]
[119.523555, "o", "        return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     0\r\n"]
[119.523655, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.523697, "o", "EOF\r\n\u001b[?2004l\r"]
[119.525011, "o", "\u001b[?2004hroot@144c94ef15d7:/app# "]
[119.525108, "o", "cat > /app/cliurn/boot.rs <<'EOF'\r\n\u001b[?2004l\r"]
[119.525183, "o", "\u001b[?2004h> "]
