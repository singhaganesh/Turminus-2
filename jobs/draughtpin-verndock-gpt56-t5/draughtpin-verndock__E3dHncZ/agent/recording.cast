[119.223679, "o", ".symver wick_old,fold_frame@CASK_1\r\n\u001b[?2004l\r\u001b[?2004h> .symver wick_new,fold_frame@@CASK_2\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
