[119.525448, "o", "#[path = \"../vatrib/qat.rs\"]\r\n\u001b[?2004l\r"]
[119.525533, "o", "\u001b[?2004h> mod qat;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[119.525567, "o", "\u001b[?2004h> "]
[119.525605, "o", "fn main() {\r\n\u001b[?2004l\r"]
[119.525641, "o", "\u001b[?2004h> "]
[119.525717, "o", "    let mut args = std::env::args();\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.525762, "o", "> "]
[119.525913, "o", "    let _ = args.next();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.525991, "o", "    let cmd = args.next().unwrap_or_default();\r\n\u001b[?2004l\r"]
[119.526064, "o", "\u001b[?2004h> "]
[119.526178, "o", "    let dump = args.next().unwrap_or_default();\r\n\u001b[?2004l\r"]
[119.526247, "o", "\u001b[?2004h> "]
[119.526321, "o", "    let rc = match cmd.as_str() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.526393, "o", "> "]
[119.526526, "o", "        \"sip\" if args.next().is_none() => qat::qat(&dump, None),\r\n\u001b[?2004l\r"]
[119.526556, "o", "\u001b[?2004h> "]
[119.526669, "o", "        \"mark\" => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.526761, "o", "            let slot = args.next().unwrap_or_default();\r\n\u001b[?2004l\r"]
[119.526791, "o", "\u001b[?2004h> "]
[119.527018, "o", "            if slot.is_empty() || args.next().is_some() { 1 } else { qat::qat(&dump, Some(&slot)) }\r\n\u001b[?2004l\r"]
[119.527104, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[119.527142, "o", "\u001b[?2004h>         _ => 2,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.527181, "o", "    };\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.527216, "o", "> "]
[119.527385, "o", "    std::process::exit(rc);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
