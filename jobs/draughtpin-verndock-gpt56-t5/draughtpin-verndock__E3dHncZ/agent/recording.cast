[21.69739, "o", "===== /app/stoke.sh =====\r\n"]
[21.700764, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/lib /app/inkvat /app/gnuverse\r\n     5\trustc --edition 2021 -O /app/weft/main.rs -o /app/bin/weave\r\n     6\t/app/bin/weave\r\n     7\trustc --edition 2021 -O --crate-type staticlib -C panic=abort /app/gluebox/glue.rs -o /tmp/libdraught.a\r\n     8\tcc -shared -o /app/lib/libdraught.so -Wl,--version-script=/app/gnuverse/cask.map -Wl,--whole-archive /tmp/libdraught.a -Wl,--no-whole-archive -lc -ldl\r\n     9\trustc --edition 2021 -O /app/cliurn/boot.rs -o /app/bin/draughtpin -C link-arg=-ldl\r\n"]
[21.700959, "o", "===== /app/gnuverse/cask.map =====\r\n"]
[21.702082, "o", "     1\tCASK_1 {\r\n     2\t  global:\r\n     3\t    fold_frame;\r\n     4\t  local:\r\n     5\t    *;\r\n     6\t};\r\n     7\tCASK_2 {\r\n     8\t  global:\r\n"]
[21.702173, "o", "     9\t    fold_frame;\r\n    10\t} CASK_1;\r\n"]
[21.7023, "o", "===== /app/narbay/loom.rs =====\r\n"]
[21.703469, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn knit() -> String {\r\n     4\t    let raw = match fs::read_to_string(\"/app/quarryc/hold.toml\") {\r\n     5\t        Ok(s) => s,\r\n     6\t        Err(_) => return \"CASK_1\".to_string(),\r\n"]
[21.703576, "o", "     7\t    };\r\n     8\t    let mut first = None;\r\n     9\t    let mut name = String::new();\r\n    10\t    for line in raw.lines() {\r\n    11\t        let t = line.trim();\r\n    12\t        if let Some(rest) = t.strip_prefix(\"name = \") {\r\n    13\t            name = rest.trim_matches('\"').to_string();\r\n    14\t        }\r\n    15\t        if t == \"home = 1\" && first.is_none() && !name.is_empty() {\r\n    16\t            first = Some(name.clone());\r\n    17\t        }\r\n    18\t    }\r\n    19\t    first.unwrap_or_else(|| \"CASK_1\".to_string())\r\n    20\t}\r\n    21\t\r\n    22\t#[allow(dead_code)]\r\n    23\tpub fn weave(path: &str) -> Result<(), i32> {\r\n    24\t    let home = knit();\r\n    25\t    let body = format!(\r\n    26\t        \"{h} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\nCASK_2 {{\\n  global:\\n    fold_frame;\\n}} {h};\\n\",\r\n    27\t        h = home\r\n    28\t    );\r\n    29\t    fs::create_dir_all(\"/app/gnuverse\").map_err(|_| 1)?;\r\n    30\t    fs::write(path, body).map_err(|_| 1)?;\r\n    31\t    Ok(())\r\n    32\t}\r\n"]
[21.703748, "o", "===== /app/vatrib/qat.rs =====\r\n"]
[21.705067, "o", "     1\tuse std::fs;\r\n     2\tuse std::os::raw::{c_char, c_int, c_void};\r\n     3\t\r\n     4\tuse crate::loom;\r\n"]
[21.705128, "o", "     5\t\r\n     6\tconst RTLD_NOW: c_int = 2;\r\n     7\t\r\n     8\textern \"C\" {\r\n     9\t    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\r\n    10\t    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\r\n"]
[21.705196, "o", "    11\t    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\r\n    12\t}\r\n    13\t\r\n    14\ttype FoldFn = unsafe extern \"C\" fn(*const u8, usize, *mut u8, usize) -> isize;\r\n    15\t\r\n    16\tfn rules_pair() -> (String, String) {\r\n    17\t    let mut cur = String::new();\r\n    18\t    let mut old = String::new();\r\n    19\t    if let Ok(s) = fs::read_to_string(\"/app/abifolio/RULES.txt\") {\r\n    20\t        for line in s.lines() {\r\n    21\t            if let Some(rest) = line.strip_prefix(\"current slot:\") {\r\n    22\t                cur = rest.trim().to_string();\r\n    23\t            }\r\n    24\t            if let Some(rest) = line.strip_prefix(\"compat slot:\") {\r\n    25\t                old = rest.trim().to_string();\r\n    26\t            }\r\n    27\t        }\r\n    28\t    }\r\n    29\t    (cur, old)\r\n    30\t}\r\n    31\t\r\n    32\tfn folio_ok(slot: &str) -> bool {\r\n    33\t    let (a, b) = rules_pair();\r\n    34\t    slot == a || slot == b\r\n    35\t}\r\n    36\t\r\n    37\tfn load() -> *mut c_void {\r\n    38\t    unsafe { dlopen(b\"/app/lib/libdraught.so\\0\".as_ptr() as *const c_char, RTLD_NOW) }\r\n    39\t}\r\n    40\t\r\n    41\tfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\r\n    42\t    if ptr.is_null() {\r\n    43\t        return Err(1);\r\n"]
[21.705273, "o", "    44\t    }\r\n    45\t    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\r\n    46\t    let mut buf = vec![0u8; blob.len() + 32];\r\n    47\t    let n = unsafe { f(blob.as_ptr(), blob.len(), buf.as_mut_ptr(), buf.len()) };\r\n    48\t    if n < 0 {\r\n    49\t        return Err(1);\r\n    50\t    }\r\n    51\t    buf.truncate(n as usize);\r\n    52\t    Ok(buf)\r\n    53\t}\r\n    54\t\r\n    55\tfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\r\n    56\t    fs::create_dir_all(\"/app/inkvat\").map_err(|_| 1)?;\r\n    57\t    let body = format!(\r\n    58\t        \"{{\\\"node\\\":\\\"{}\\\",\\\"text\\\":{},\\\"kind\\\":\\\"{}\\\"}}\\n\",\r\n    59\t        slot,\r\n    60\t        serde_like(text),\r\n    61\t        kind\r\n    62\t    );\r\n    63\t    fs::write(\"/app/inkvat/card.json\", body).map_err(|_| 1)?;\r\n    64\t    Ok(())\r\n"]
[21.705326, "o", "    65\t}\r\n    66\t\r\n    67\tfn serde_like(s: &str) -> String {\r\n    68\t    let mut o = String::from(\"\\\"\");\r\n    69\t    for c in s.chars() {\r\n    70\t        match c {\r\n    71\t            '\"' => o.push_str(\"\\\\\\\"\"),\r\n    72\t            '\\\\' => o.push_str(\"\\\\\\\\\"),\r\n    73\t            '\\n' => o.push_str(\"\\\\n\"),\r\n    74\t            '\\t' => o.push_str(\"\\\\t\"),\r\n    75\t            c if (c as u32) < 0x20 => o.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n    76\t            _ => o.push(c),\r\n    77\t        }\r\n    78\t    }\r\n"]
[21.705393, "o", "    79\t    o.push('\"');\r\n    80\t    o\r\n    81\t}\r\n    82\t\r\n    83\tpub fn qat(a: &str, b: Option<&str>) -> i32 {\r\n    84\t    let _ = fs::remove_file(\"/app/inkvat/SEAL\");\r\n    85\t    let blob = match fs::read(a) {\r\n    86\t        Ok(x) => x,\r\n    87\t        Err(_) => return 1,\r\n    88\t    };\r\n    89\t    if blob.is_empty() {\r\n    90\t        let _ = write_card(\"\", \"\", \"raw\");\r\n    91\t        let _ = fs::write(\"/app/inkvat/SEAL\", \"ok\");\r\n    92\t        return 0;\r\n    93\t    }\r\n    94\t    if let Some(n) = b {\r\n    95\t        if !folio_ok(n) {\r\n    96\t            let _ = write_card(n, \"\", \"raw\");\r\n"]
[21.705476, "o", "    97\t            let _ = fs::write(\"/app/inkvat/SEAL\", \"ok\");\r\n    98\t            return 0;\r\n    99\t        }\r\n   100\t    }\r\n   101\t    let h = load();\r\n   102\t    if h.is_null() {\r\n   103\t        return 1;\r\n   104\t    }\r\n   105\t    let ptr = unsafe {\r\n   106\t        match b {\r\n   107\t            None => dlsym(h, b\"fold_frame\\0\".as_ptr() as *const c_char),\r\n   108\t            Some(n) => {\r\n   109\t                let mut v = n.as_bytes().to_vec();\r\n   110\t                v.push(0);\r\n   111\t                dlvsym(\r\n   112\t                    h,\r\n   113\t                    b\"fold_frame\\0\".as_ptr() as *const c_char,\r\n   114\t                    v.as_ptr() as *const c_char,\r\n"]
[21.705557, "o", "   115\t                )\r\n   116\t            }\r\n   117\t        }\r\n   118\t    };\r\n   119\t    let out = match call(ptr, &blob) {\r\n   120\t        Ok(v) => v,\r\n   121\t        Err(c) => return c,\r\n   122\t    };\r\n   123\t    let text = String::from_utf8_lossy(&out).into_owned();\r\n   124\t    let home = loom::knit();\r\n   125\t    let kind = if b.is_some() { \"raw\" } else { \"raw\" };\r\n   126\t    if write_card(&home, &text, kind).is_err() {\r\n   127\t        return 1;\r\n   128\t    }\r\n   129\t    if fs::write(\"/app/inkvat/SEAL\", \"ok\").is_err() {\r\n   130\t        return 1;\r\n   131\t    }\r\n"]
[21.705637, "o", "   132\t    0\r\n   133\t}\r\n"]
[21.705756, "o", "===== /app/weft/main.rs =====\r\n"]
[21.711294, "o", "     1\t#[path = \"../narbay/loom.rs\"]\r\n     2\tmod loom;\r\n     3\t\r\n     4\tfn main() {\r\n     5\t    if loom::weave(\"/app/gnuverse/cask.map\").is_err() {\r\n     6\t        std::process::exit(1);\r\n     7\t    }\r\n"]
[21.711396, "o", "     8\t}\r\n"]
[21.711544, "o", "===== /app/aliaspit/hue.S =====\r\n"]
[21.712519, "o", "     1\t# hue\r\n     2\t.equ hue, 0\r\n     3\t.symver wick_old,fold_frame@@CASK_1\r\n     4\t.symver wick_new,fold_frame@CASK_2\r\n"]
[21.712721, "o", "===== /app/stemcask/wick.rs =====\r\n"]
[21.71363, "o", "     1\tuse core::slice;\r\n     2\t\r\n     3\tfn lower_only(s: &[u8], dst: &mut [u8]) -> usize {\r\n     4\t    let n = s.len().min(dst.len());\r\n     5\t    for i in 0..n {\r\n"]
[21.713687, "o", "     6\t        dst[i] = s[i].to_ascii_lowercase();\r\n     7\t    }\r\n     8\t    n\r\n     9\t}\r\n    10\t\r\n    11\tfn full_fold(s: &[u8], dst: &mut [u8]) -> usize {\r\n    12\t    let mut i = 0;\r\n"]
[21.713748, "o", "    13\t    let mut space = false;\r\n    14\t    for &b in s {\r\n    15\t        if i >= dst.len() {\r\n    16\t            break;\r\n    17\t        }\r\n    18\t        if b == b'\\t' || b == b' ' || b == b'\\n' || b == b'\\r' {\r\n    19\t            if !space {\r\n    20\t                dst[i] = b' ';\r\n    21\t                i += 1;\r\n    22\t                space = true;\r\n    23\t            }\r\n    24\t            continue;\r\n    25\t        }\r\n    26\t        if b < 0x20 {\r\n    27\t            continue;\r\n    28\t        }\r\n    29\t        space = false;\r\n    30\t        dst[i] = b.to_ascii_lowercase();\r\n    31\t        i += 1;\r\n    32\t    }\r\n    33\t    while i > 0 && dst[i - 1] == b'/' {\r\n    34\t        i -= 1;\r\n    35\t    }\r\n    36\t    i\r\n    37\t}\r\n    38\t\r\n    39\t#[no_mangle]\r\n"]
[21.713806, "o", "    40\tpub unsafe extern \"C\" fn wick_old(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    41\t    if p.is_null() || dst.is_null() || cap == 0 {\r\n    42\t        return -1;\r\n    43\t    }\r\n    44\t    let s = slice::from_raw_parts(p, n);\r\n    45\t    let d = slice::from_raw_parts_mut(dst, cap);\r\n    46\t    lower_only(s, d) as isize\r\n    47\t}\r\n    48\t\r\n    49\t#[no_mangle]\r\n    50\tpub unsafe extern \"C\" fn wick_new(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    51\t    if p.is_null() || dst.is_null() || cap == 0 {\r\n    52\t        return -1;\r\n    53\t    }\r\n    54\t    let s = slice::from_raw_parts(p, n);\r\n    55\t    let d = slice::from_raw_parts_mut(dst, cap);\r\n    56\t    full_fold(s, d) as isize\r\n"]
[21.71386, "o", "    57\t}\r\n"]
[21.714027, "o", "===== /app/gluebox/glue.rs =====\r\n"]
[21.714895, "o", "     1\t#![no_std]\r\n     2\t#![crate_type = \"staticlib\"]\r\n     3\t\r\n     4\t#[path = \"../stemcask/wick.rs\"]\r\n     5\tmod wick;\r\n     6\t\r\n     7\tcore::arch::global_asm!(include_str!(\"../aliaspit/hue.S\"));\r\n     8\t\r\n     9\t#[no_mangle]\r\n"]
[21.714979, "o", "    10\tpub extern \"C\" fn rust_eh_personality() {}\r\n    11\t\r\n    12\t#[panic_handler]\r\n    13\tfn panic(_: &core::panic::PanicInfo) -> ! {\r\n    14\t    loop {}\r\n    15\t}\r\n"]
