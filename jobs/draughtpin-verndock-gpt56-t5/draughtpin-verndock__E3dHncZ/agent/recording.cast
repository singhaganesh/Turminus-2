[21.716751, "o", "     7\t#[path = \"../lidmath/note.rs\"]\r\n     8\tmod note;\r\n     9\t\r\n    10\tfn main() {\r\n    11\t    let mut args = std::env::args();\r\n    12\t    let _ = args.next();\r\n    13\t    let cmd = args.next().unwrap_or_default();\r\n    14\t    if cmd == \"sip\" {\r\n    15\t        let dump = args.next().unwrap_or_default();\r\n    16\t        let _ = skip::skip(&dump);\r\n    17\t        std::process::exit(qat::qat(&dump, None));\r\n    18\t    }\r\n    19\t    if cmd == \"mark\" {\r\n    20\t        let dump = args.next().unwrap_or_default();\r\n    21\t        let slot = args.next().unwrap_or_default();\r\n    22\t        let _ = note::note(&slot);\r\n    23\t        std::process::exit(qat::qat(&dump, Some(&slot)));\r\n    24\t    }\r\n    25\t    eprintln!(\"usage: draughtpin sip DUMP | draughtpin mark DUMP SLOT\");\r\n    26\t    std::process::exit(2);\r\n    27\t}\r\n"]
