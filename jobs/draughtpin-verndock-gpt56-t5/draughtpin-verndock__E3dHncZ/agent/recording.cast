[33.348008, "o", "===== stemcask/wick.rs =====\r\n"]
[33.352184, "o", "     1\tuse core::slice;\r\n     2\t\r\n     3\tfn lower_only(s: &[u8], dst: &mut [u8]) -> usize {\r\n     4\t    let n = s.len().min(dst.len());\r\n     5\t    for i in 0..n {\r\n     6\t        dst[i] = s[i].to_ascii_lowercase();\r\n     7\t    }\r\n     8\t    n\r\n     9\t}\r\n    10\t\r\n    11\tfn full_fold(s: &[u8], dst: &mut [u8]) -> usize {\r\n    12\t    let mut i = 0;\r\n    13\t    let mut space = false;\r\n    14\t    for &b in s {\r\n    15\t        if i >= dst.len() {\r\n    16\t            break;\r\n    17\t        }\r\n    18\t        if b == b'\\t' || b == b' ' || b == b'\\n' || b == b'\\r' {\r\n    19\t            if !space {\r\n    20\t                dst[i] = b' ';\r\n    21\t                i += 1;\r\n    22\t                space = true;\r\n    23\t            }\r\n    24\t            continue;\r\n    25\t        }\r\n    26\t        if b < 0x20 {\r\n    27\t            continue;\r\n    28\t        }\r\n    29\t        space = false;\r\n    30\t        dst[i] = b.to_ascii_lowercase();\r\n    31\t        i += 1;\r\n    32\t    }\r\n    33\t    while i > 0 && dst[i - 1] == b'/' {\r\n    34\t        i -= 1;\r\n    35\t    }\r\n    36\t    i\r\n    37\t}\r\n    38\t\r\n    39\t#[no_mangle]\r\n    40\tpub unsafe extern \"C\" fn wick_old(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    41\t    if p.is_null() || dst.is_null() || cap == 0 {\r\n    42\t        return -1;\r\n    43\t    }\r\n    44\t    let s = slice::from_raw_parts(p, n);\r\n    45\t    let d = slice::from_raw_parts_mut(dst, cap);\r\n    46\t    lower_only(s, d) as isize\r\n    47\t}\r\n    48\t\r\n    49\t#[no_mangle]\r\n    50\tpub unsafe extern \"C\" fn wick_new(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    51\t    if p.is_null() || dst.is_null() || cap == 0 {\r\n    52\t        return -1;\r\n    53\t    }\r\n    54\t    let s = slice::from_raw_parts(p, n);\r\n    55\t    let d = slice::from_raw_parts_mut(dst, cap);\r\n    56\t    full_fold(s, d) as isize\r\n    57\t}\r\n"]
[33.352548, "o", "===== gluebox/glue.rs =====\r\n"]
[33.353466, "o", "     1\t#![no_std]\r\n     2\t#![crate_type = \"staticlib\"]\r\n     3\t\r\n     4\t#[path = \"../stemcask/wick.rs\"]\r\n     5\tmod wick;\r\n     6\t\r\n     7\tcore::arch::global_asm!(include_str!(\"../aliaspit/hue.S\"));\r\n     8\t\r\n     9\t#[no_mangle]\r\n    10\tpub extern \"C\" fn rust_eh_personality() {}\r\n    11\t\r\n    12\t#[panic_handler]\r\n    13\tfn panic(_: &core::panic::PanicInfo) -> ! {\r\n    14\t    loop {}\r\n    15\t}\r\n"]
