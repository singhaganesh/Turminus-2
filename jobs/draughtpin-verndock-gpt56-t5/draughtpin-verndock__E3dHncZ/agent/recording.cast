[33.786247, "o", "===== vatrib/qat.rs 1-240 =====\r\n"]
[33.788037, "o", "     1\tuse std::fs;\r\n     2\tuse std::os::raw::{c_char, c_int, c_void};\r\n     3\t\r\n     4\tuse crate::loom;\r\n     5\t\r\n     6\tconst RTLD_NOW: c_int = 2;\r\n     7\t\r\n     8\textern \"C\" {\r\n     9\t    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\r\n    10\t    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\r\n    11\t    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\r\n    12\t}\r\n    13\t\r\n    14\ttype FoldFn = unsafe extern \"C\" fn(*const u8, usize, *mut u8, usize) -> isize;\r\n"]
[33.788092, "o", "    15\t\r\n    16\tfn rules_pair() -> (String, String) {\r\n    17\t    let mut cur = String::new();\r\n    18\t    let mut old = String::new();\r\n    19\t    if let Ok(s) = fs::read_to_string(\"/app/abifolio/RULES.txt\") {\r\n    20\t        for line in s.lines() {\r\n    21\t            if let Some(rest) = line.strip_prefix(\"current slot:\") {\r\n    22\t                cur = rest.trim().to_string();\r\n    23\t            }\r\n    24\t            if let Some(rest) = line.strip_prefix(\"compat slot:\") {\r\n    25\t                old = rest.trim().to_string();\r\n    26\t            }\r\n    27\t        }\r\n    28\t    }\r\n    29\t    (cur, old)\r\n    30\t}\r\n    31\t\r\n    32\tfn folio_ok(slot: &str) -> bool {\r\n"]
[33.788111, "o", "    33\t    let (a, b) = rules_pair();\r\n    34\t    slot == a || slot == b\r\n    35\t}\r\n    36\t\r\n    37\tfn load() -> *mut c_void {\r\n    38\t"]
[33.788129, "o", "    unsafe { dlopen(b\"/app/lib/libdraught.so\\0\".as_ptr() as *const c_char, RTLD_NOW) }\r\n    39\t}\r\n    40\t\r\n    41\tfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\r\n"]
[33.788144, "o", "    42\t    if ptr.is_null() {\r\n    43\t        return Err(1);\r\n    44\t    }\r\n    45\t    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\r\n    46\t    let mut buf = vec![0u8; blob.len() + 32];"]
[33.788165, "o", "\r\n    47\t    let n = unsafe { f(blob.as_ptr(), blob.len(), buf.as_mut_ptr(), buf.len()) };\r\n"]
[33.788182, "o", "    48\t    if n < 0 {\r\n    49\t        return Err(1);\r\n    50\t    }\r\n    51\t    buf.truncate(n as usize);\r\n    52\t    Ok(buf)\r\n    53\t}\r\n    54\t\r\n"]
[33.788202, "o", "    55\tfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\r\n    56\t    fs::create_dir_all(\"/app/inkvat\").map_err(|_| 1)?;\r\n    57\t    let body = format!(\r\n    58\t        \"{{\\\"node\\\":\\\"{}\\\",\\\"text\\\":{},\\\"kind\\\":\\\"{}\\\"}}\\n\",\r\n    59\t        slot,\r\n"]
[33.788212, "o", "    60\t        serde_like(text),\r\n    61\t        kind\r\n    62\t    );\r\n"]
[33.788222, "o", "    63\t    fs::write(\"/app/inkvat/card.json\", body).map_err(|_| 1)?;\r\n    64\t    Ok(())\r\n    65\t}\r\n"]
[33.788234, "o", "    66\t\r\n    67\tfn serde_like(s: &str) -> String {\r\n    68\t    let mut o = String::from(\"\\\"\");\r\n"]
[33.788243, "o", "    69\t    for c in s.chars() {\r\n    70\t        match c {\r\n"]
[33.788253, "o", "    71\t            '\"' => o.push_str(\"\\\\\\\"\"),\r\n    72\t            '\\\\' => o.push_str(\"\\\\\\\\\"),\r\n    73\t            '\\n' => o.push_str(\"\\\\n\"),\r\n    74\t            '\\t' => o.push_str(\"\\\\t\"),\r\n"]
[33.788262, "o", "    75\t            c if (c as u32) < 0x20 => o.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n    76\t            _ => o.push(c),\r\n"]
[33.78827, "o", "    77\t        }\r\n    78\t    }\r\n    79\t    o.push('\"');\r\n    80\t    o\r\n    81\t}\r\n"]
[33.788279, "o", "    82\t\r\n    83\tpub fn qat(a: &str, b: Option<&str>) -> i32 {\r\n    84"]
[33.788289, "o", "\t    let _ = fs::remove_file(\"/app/inkvat/SEAL\");\r\n    85\t    let blob = match fs::read(a) {\r\n    86\t        Ok(x) => x,\r\n    87\t        Err(_) => return 1,\r\n"]
[33.788297, "o", "    88\t    };\r\n    89\t    if blob.is_empty() {\r\n    90\t        let _ = write_card(\"\", \"\", \"raw\");\r\n"]
[33.788307, "o", "    91\t        let _ = fs::write(\"/app/inkvat/SEAL\", \"ok\");\r\n    92\t        return 0;\r\n"]
[33.788321, "o", "    93\t    }\r\n    94\t    if let Some(n) = b {\r\n    95\t        if !folio_ok(n) {\r\n    96\t            let _ = write_card(n, \"\", \"raw\");\r\n    97\t            let _ = fs::write(\"/app/inkvat/SEAL\", \"ok\");\r\n    98\t            return 0;"]
[33.788336, "o", "\r\n    99\t        }\r\n   100\t    }\r\n   101\t    let h = load();\r\n   102\t    if h.is_null() {\r\n   103\t        return 1;\r\n   104\t    }\r\n   105\t    let ptr = unsafe {\r\n"]
[33.788346, "o", "   106\t        match b {\r\n   107\t            None => dlsym(h, b\"fold_frame\\0\".as_ptr() as *const c_char),\r\n   108\t            Some(n) => {\r\n"]
[33.788355, "o", "   109\t                let mut v = n.as_bytes().to_vec();\r\n   110\t                v.push(0);\r\n   111\t                dlvsym(\r\n"]
[33.788364, "o", "   112\t                    h,\r\n   113\t                    b\"fold_frame\\0\".as_ptr() as *const c_char,\r\n"]
[33.788373, "o", "   114\t                    v.as_ptr() as *const c_char,\r\n   115\t                )\r\n   116\t            }\r\n"]
[33.788382, "o", "   117\t        }\r\n   118\t    };\r\n   119\t    let out = match call(ptr, &blob) {\r\n"]
[33.788392, "o", "   120\t        Ok(v) => v,\r\n   121\t        Err(c) => return c,\r\n   122\t    };\r\n"]
[33.788401, "o", "   123\t    let text = String::from_utf8_lossy(&out).into_owned();\r\n   124\t    let home = loom::knit();\r\n   125\t    let kind = if b.is_some() { \"raw\" } else { \"raw\" };\r\n"]
[33.788426, "o", "   126\t    if write_card(&home, &text, kind).is_err() {\r\n   127\t        return 1;\r\n"]
[33.788438, "o", "   128\t    }\r\n   129\t    if fs::write(\"/app/inkvat/SEAL\", \"ok\").is_err() {\r\n   130\t        return 1;\r\n   131\t    }\r\n   132\t    0\r\n   133\t}\r\n"]
[33.789543, "o", "===== cliurn/boot.rs =====\r\n"]
[33.790597, "o", "     1\t#[path = \"../narbay/loom.rs\"]\r\n     2\tmod loom;\r\n     3\t#[path = \"../vatrib/qat.rs\"]\r\n     4\tmod qat;\r\n"]
[33.790697, "o", "     5\t#[path = \"../spanmod/skip.rs\"]\r\n     6\tmod skip;\r\n     7\t#[path = \"../lidmath/note.rs\"]\r\n     8\tmod note;\r\n     9\t\r\n    10\tfn main() {\r\n    11\t    let mut args = std::env::args();\r\n    12\t    let _ = args.next();\r\n    13\t    let cmd = args.next().unwrap_or_default();\r\n"]
[33.790755, "o", "    14\t    if cmd == \"sip\" {\r\n    15\t        let dump = args.next().unwrap_or_default();\r\n    16\t        let _ = skip::skip(&dump);\r\n    17\t        std::process::exit(qat::qat(&dump, None));\r\n    18\t    }\r\n    19\t    if cmd == \"mark\" {\r\n    20\t        let dump = args.next().unwrap_or_default();\r\n    21\t        let slot = args.next().unwrap_or_default();\r\n    22\t        let _ = note::note(&slot);\r\n    23\t        std::process::exit(qat::qat(&dump, Some(&slot)));\r\n    24\t    }\r\n    25\t    eprintln!(\"usage: draughtpin sip DUMP | draughtpin mark DUMP SLOT\");\r\n    26\t    std::process::exit(2);\r\n    27\t}\r\n"]
[33.790925, "o", "\u001b[?2004h"]
[33.790983, "o", "root@144c94ef15d7:/app# "]
[34.296907, "i", "echo '===== weft/main.rs ====='; nl -ba /app/weft/main.rs; echo '===== narbay/loom.rs ====='; nl -ba /app/narbay/loom.rs; echo '===== config ====='; cat /app/quarryc/hold.toml; echo '===== exported aliases in archive objects if present ====='; nm -A /tmp/libdraught.a 2>/dev/null | grep -E 'fold_frame|draught' || true\n"]
[34.297891, "o", "echo '===== weft/main.rs ====='; nl -ba /app/weft/main.rs; echo '===== narbay/loom.rs ====='; nl -ba /app/narbay/loom.rs; echo '===== config ====='; cat /app/quarryc/hold.toml; echo '===== exported aliases in archive objects if present ====='; nm -A /tmp/libdraught.a 2>/dev/null | grep -E 'fold_frame|draught' || true\r\n"]
[34.298018, "o", "\u001b[?2004l\r===== weft/main.rs =====\r\n"]
[34.29919, "o", "     1\t#[path = \"../narbay/loom.rs\"]\r\n     2\tmod loom;\r\n     3\t\r\n     4\tfn main() {\r\n     5\t    if loom::weave(\"/app/gnuverse/cask.map\").is_err() {\r\n     6\t        std::process::exit(1);\r\n     7\t    }\r\n     8\t}\r\n"]
[34.299438, "o", "===== narbay/loom.rs =====\r\n"]
[34.300378, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn knit() -> String {\r\n     4\t    let raw = match fs::read_to_string(\"/app/quarryc/hold.toml\") {\r\n     5\t        Ok(s) => s,\r\n     6\t        Err(_) => return \"CASK_1\".to_string(),\r\n"]
[34.300491, "o", "     7\t    };\r\n     8\t    let mut first = None;\r\n     9\t    let mut name = String::new();\r\n    10\t    for line in raw.lines() {\r\n    11\t        let t = line.trim();\r\n    12\t        if let Some(rest) = t.strip_prefix(\"name = \") {\r\n    13\t            name = rest.trim_matches('\"').to_string();\r\n    14\t        }\r\n    15\t        if t == \"home = 1\" && first.is_none() && !name.is_empty() {\r\n    16\t            first = Some(name.clone());\r\n    17\t        }\r\n    18\t    }\r\n    19\t    first.unwrap_or_else(|| \"CASK_1\".to_string())\r\n    20\t}\r\n    21\t\r\n    22\t#[allow(dead_code)]\r\n    23\tpub fn weave(path: &str) -> Result<(), i32> {\r\n"]
[34.300557, "o", "    24\t    let home = knit();\r\n    25\t    let body = format!(\r\n    26\t        \"{h} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\nCASK_2 {{\\n  global:\\n    fold_frame;\\n}} {h};\\n\",\r\n    27\t        h = home\r\n    28\t    );\r\n    29\t    fs::create_dir_all(\"/app/gnuverse\").map_err(|_| 1)?;\r\n    30\t    fs::write(path, body).map_err(|_| 1)?;\r\n    31\t    Ok(())\r\n    32\t}\r\n"]
[34.300624, "o", "===== config =====\r\n"]
[34.301542, "o", "[[nodes]]\r\nname = \"CASK_1\"\r\nhome = 1\r\n\r\n[[nodes]]\r\nname = \"CASK_2\"\r\nhome = 1\r\n"]
[34.301694, "o", "===== exported aliases in archive objects if present =====\r\n"]
