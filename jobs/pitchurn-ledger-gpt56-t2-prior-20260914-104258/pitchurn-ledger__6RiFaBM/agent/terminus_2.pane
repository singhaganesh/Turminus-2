     1	import java.io.*;
     2	public class DuskGen {
     3	  public static void main(String[] a) throws Exception {
     4	    File d = new File("/app/deskbin/gen");
     5	    d.mkdirs();
     6	    PrintWriter w = new PrintWriter(new FileWriter(new File(d, "Span.java")));
     7	    loom(w);
     8	    w.close();
     9	  }
    10	  public static void loom(PrintWriter a) throws Exception {
    11	    a.println("import java.nio.file.*;");
    12	    a.println("import java.util.*;");
    13	    a.println("public class Span {");
    14	    a.println("  public static void merge() throws Exception {");
    15	    a.println("    Path live = Paths.get(\"/app/urnbay/idx.tsv\");");
    16	    a.println("    Path hot = Paths.get(\"/app/urnbay/hot/idx.tsv\");");
    17	    a.println("    StringBuilder sb = new StringBuilder();");
    18	    a.println("    if (Files.exists(live)) sb.append(Files.readString(live));");
    19	    a.println("    if (Files.exists(hot)) sb.append(Files.readString(hot));");
    20	    a.println("    Files.writeString(live, sb.toString());");
    21	    a.println("    System.out.println(\"walked\");");
    22	    a.println("  }");
    23	    a.println("}");
    24	  }
    25	}
--- Gear ---
     1	import java.nio.file.*;
     2	import java.util.*;
     3	public class Gear {
     4	  public int mask, min, max, fp;
     5	  public static Gear load(String p) throws Exception {
     6	    Gear g = new Gear();
     7	    for (String ln : Files.readAllLines(Paths.get(p))) {
     8	      String t = ln.trim();
     9	      if (t.startsWith("mask=")) g.mask = Integer.parseInt(t.substring(5));
    10	      if (t.startsWith("min=")) g.min = Integer.parseInt(t.substring(4));
    11	      if (t.startsWith("max=")) g.max = Integer.parseInt(t.substring(4));
    12	      if (t.startsWith("fp=")) g.fp = Integer.parseInt(t.substring(3));
    13	    }
    14	    return g;
    15	  }
    16	}
--- Idx ---
     1	import java.nio.file.*;
     2	import java.util.*;
     3	public class Idx {
     4	  public static Map<String,String> load() throws Exception {
     5	    Map<String,String> m = new LinkedHashMap<>();
     6	    add(m, "/app/urnbay/idx.tsv");
     7	    add(m, "/app/urnbay/keep/idx.tsv");
     8	    add(m, "/app/urnbay/hot/idx.tsv");
     9	    return m;
    10	  }
    11	  static void add(Map<String,String> m, String p) throws Exception {
    12	    Path f = Paths.get(p);
    13	    if (!Files.exists(f)) return;
    14	    for (String ln : Files.readAllLines(f)) {
    15	      String t = ln.trim();
    16	      if (t.isEmpty()) continue;
    17	      String[] sp = t.split("\t");
    18	      if (sp.length >= 2) m.put(sp[0], sp[1]);
    19	    }
    20	  }
    21	  public static void put(String k, String rel) throws Exception {
    22	    Path f = Paths.get("/app/urnbay/idx.tsv");
    23	    Files.writeString(f, k + "\t" + rel + "\n", java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);
    24	  }
    25	  public static byte[] blob(String rel) throws Exception {
    26	    return Files.readAllBytes(Paths.get("/app/urnbay/" + rel));
    27	  }
    28	}
--- Main ---
     1	public class Main {
     2	  public static void main(String[] a) throws Exception {
     3	    if (a.length == 0) {
     4	      System.err.println("usage");
     5	      System.exit(2);
     6	    }
     7	    String cmd = a[0];
     8	    int rc = 0;
     9	    if (cmd.equals("anneal")) {
    10	      rc = WalkRun.run();
    11	    } else if (cmd.equals("stow")) {
    12	      rc = StowRun.run(a[1]);
    13	    } else if (cmd.equals("draw")) {
    14	      rc = DrawRun.run(a[1], a[2]);
    15	    } else if (cmd.equals("census")) {
    16	      rc = CardRun.run();
    17	    } else {
    18	      rc = 2;
    19	    }
    20	    System.exit(rc);
    21	  }
    22	}
