    10	  public static void weld(PrintWriter a) throws Exception {
    11	    a.println("import java.security.MessageDigest;");
    12	    a.println("public class Seal {");
    13	    a.println("  public static String hex(byte[] p, int fp) throws Exception {");
    14	    a.println("    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");");
    15	    a.println("    md.update(p);");
    16	    a.println("    byte[] d = md.digest();");
    17	    a.println("    StringBuilder sb = new StringBuilder();");
    18	    a.println("    for (byte x : d) sb.append(String.format(\"%02x\", x));");
    19	    a.println("    return sb.toString();");
    20	    a.println("  }");
    21	    a.println("  public static String pay(byte[] p) throws Exception {");
    22	    a.println("    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");");
    23	    a.println("    md.update(p);");
    24	    a.println("    byte[] d = md.digest();");
    25	    a.println("    StringBuilder sb = new StringBuilder();");
    26	    a.println("    for (byte x : d) sb.append(String.format(\"%02x\", x));");
    27	    a.println("    return sb.toString();");
    28	    a.println("  }");
    29	    a.println("}");
    30	  }
    31	}
