     1	import java.nio.file.*;
     2	import java.util.*;
     3	public class DrawRun {
     4	  public static int run(String dest, String reel) throws Exception {
     5	    String name = Paths.get(reel).getFileName().toString();
     6	    Path mk = Paths.get("/app/urnbay/marks/" + name + ".m");
     7	    Map<String,String> idx = Idx.load();
     8	    add(idx, "/app/urnbay/cold/idx.tsv");
     9	    StringBuilder skip = new StringBuilder();
    10	    List<byte[]> acc = new ArrayList<>();
    11	    for (String ln : Files.readAllLines(mk)) {
    12	      String k = ln.trim();
    13	      if (k.isEmpty()) continue;
    14	      String rel = idx.get(k);
    15	      if (rel == null) continue;
    16	      acc.add(Idx.blob(rel));
    17	    }
    18	    int n = 0;
    19	    for (byte[] b : acc) n += b.length;
    20	    byte[] out = new byte[n];
    21	    int o = 0;
    22	    for (byte[] b : acc) {
    23	      System.arraycopy(b, 0, out, o, b.length);
    24	      o += b.length;
    25	    }
    26	    Path d = Paths.get(dest);
    27	    Files.createDirectories(d.getParent() == null ? Paths.get(".") : d.getParent());
    28	    Files.write(d, out);
    29	    return 0;
    30	  }
    31	  static void add(Map<String,String> m, String p) throws Exception {
    32	    Idx.add(m, p);
    33	  }
    34	}
