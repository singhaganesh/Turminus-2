     1	import java.util.*;
     2	public class Slice {
     3	  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {
     4	    int h = 0;
     5	    int start = 0;
     6	    java.util.List<byte[]> out = new java.util.ArrayList<>();
     7	    for (int i = 0; i < src.length; i++) {
     8	      byte b = src[i];
     9	      h = (h << 1) + b;
    10	      int ln = i - start + 1;
    11	      if ((ln >= min && (h & mask) == 0) || ln >= max || i == src.length - 1) {
    12	        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));
    13	        start = i + 1;
    14	        h = 0;
    15	      }
    16	    }
    17	    return out;
    18	  }
    19	}
     1	import java.security.MessageDigest;
     2	public class Seal {
     3	  public static String hex(byte[] p, int fp) throws Exception {
     4	    MessageDigest md = MessageDigest.getInstance("SHA-256");
     5	    md.update(p);
     6	    byte[] d = md.digest();
     7	    StringBuilder sb = new StringBuilder();
     8	    for (byte x : d) sb.append(String.format("%02x", x));
     9	    return sb.toString();
    10	  }
    11	  public static String pay(byte[] p) throws Exception {
    12	    MessageDigest md = MessageDigest.getInstance("SHA-256");
    13	    md.update(p);
    14	    byte[] d = md.digest();
    15	    StringBuilder sb = new StringBuilder();
    16	    for (byte x : d) sb.append(String.format("%02x", x));
    17	    return sb.toString();
    18	  }
    19	}
