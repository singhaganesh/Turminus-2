     1	import java.nio.file.*;
     2	import java.util.*;
     3	public class StowRun {
     4	  public static int run(String reel) throws Exception {
     5	    Gear g = Gear.load("/app/gearpit/live.gear");
     6	    byte[] src = Files.readAllBytes(Paths.get(reel));
     7	    List<byte[]> parts = Slice.cut(src, g.mask, g.min, g.max);
     8	    Map<String,String> idx = Idx.load();
     9	    long stored = 0;
    10	    long reused = 0;
    11	    List<String> keys = new ArrayList<>();
    12	    Path hot = Paths.get("/app/urnbay/hot");
    13	    Files.createDirectories(hot);
    14	    for (byte[] p : parts) {
    15	      String kb = Seal.hex(p, g.fp);
    16	      String kp = Seal.pay(p);
    17	      String hit = null;
    18	      if (idx.containsKey(kb)) hit = kb;
    19	      else if (idx.containsKey(kp)) hit = kp;
    20	      if (hit != null) {
    21	        reused += p.length;
    22	        keys.add(hit);
    23	      } else {
    24	        stored += p.length;
    25	        String rel = "hot/" + kb + ".blob";
    26	        Files.write(hot.resolve(kb + ".blob"), p);
    27	        Idx.put(kb, rel);
    28	        idx.put(kb, rel);
    29	        keys.add(kb);
    30	      }
    31	    }
    32	    String name = Paths.get(reel).getFileName().toString();
    33	    Path flag = Paths.get("/app/urnbay/marks/" + name + ".flag");
    34	    boolean prior = Files.exists(flag);
    35	    Path mk = Paths.get("/app/urnbay/marks/" + name + ".m");
    36	    StringBuilder mb = new StringBuilder();
    37	    for (String k : keys) mb.append(k).append("\n");
    38	    Files.createDirectories(mk.getParent());
    39	    Files.writeString(mk, mb.toString());
    40	    double reuse = src.length == 0 ? 1.0 : (reused / (double) src.length);
    41	    double mean = parts.isEmpty() ? 0 : (src.length / (double) parts.size());
    42	    String json = "{\n"
    43	      + "  \"reel\": \"" + name + "\",\n"
    44	      + "  \"bytes_in\": \"" + src.length + "\",\n"
    45	      + "  \"bytes_stored\": \"" + stored + "\",\n"
    46	      + "  \"reuse_frac\": \"" + String.format(java.util.Locale.US, "%.4f", reuse) + "\",\n"
    47	      + "  \"mean_piece\": \"" + String.format(java.util.Locale.US, "%.4f", mean) + "\",\n"
    48	      + "  \"piece_count\": \"" + parts.size() + "\"\n"
    49	      + "}\n";
    50	    Files.writeString(Paths.get("/app/urnbay/tally.json"), json);
    51	    Files.writeString(Paths.get("/app/urnbay/last.json"), json);
    52	    Floor.ok(reuse);
    53	    if (prior && stored == src.length && src.length > 0) {
    54	      return 1;
    55	    }
    56	    Files.writeString(flag, "1\n");
    57	    return 0;
    58	  }
    59	}
--- WalkRun ---
     1	public class WalkRun {
     2	  public static int run() throws Exception {
     3	    Span.merge();
     4	    return 0;
