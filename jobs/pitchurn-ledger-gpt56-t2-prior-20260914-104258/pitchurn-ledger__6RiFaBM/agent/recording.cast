[10.691958, "o", "--- BUILD ---\r\n"]
[10.692985, "o", "Compile with /app/kiln.sh after source edits. anneal walks the silo; it does not compile.\r\n\r\nVerifier reruns:\r\n/app/bin/pitchurn anneal\r\n/app/bin/pitchurn stow\r\n/app/bin/pitchurn draw\r\n/app/bin/pitchurn census\r\ncensus overwrites /app/urnbay/tally.json from /app/urnbay/last.json after a stow.\r\n"]
[10.69319, "o", "--- CARD ---\r\n"]
[10.694089, "o", "tally card at /app/urnbay/tally.json\r\nreel\r\nbytes_in\r\nbytes_stored\r\nreuse_frac\r\nmean_piece\r\npiece_count\r\n\r\nNumeric values use base-10 strings.\r\nreuse_frac uses at least two fractional digits.\r\n\r\nReels:\r\n/app/filmwelle/stable.bin\r\n/app/filmwelle/plain.bin\r\n/app/filmwelle/brine.bin\r\nNever-seen reel (includes bytes above 127): /app/filmwelle/probe.bin\r\nRestore snapshot: /app/seed/urnbay\r\ndraw dest example: /app/urnbay/plain.out\r\nSilo index paths: /app/urnbay/idx.tsv /app/urnbay/keep/idx.tsv /app/urnbay/hot/idx.tsv\r\ncensus restores the last stow card from /app/urnbay/last.json\r\n"]
[10.694281, "o", "--- NOTES/LAYOUT ---\r\n"]
[10.697611, "o", "/app/deskfold/CARD.txt\r\n/app/deskfold/BUILD.txt\r\n/app/deskfold/NOTE.txt\r\n/app/deskfold/MIN.txt\r\n/app/deskfold/ROUTE.txt\r\n"]
[10.697894, "o", "--- APP TOP ---\r\n"]
