[43.706197, "o", "     1\timport java.nio.file.*;\r\n     2\tpublic class Floor {\r\n     3\t  public static boolean ok(double reuse) throws Exception {\r\n     4\t    String s = Files.readString(Paths.get(\"/app/deskfold/MIN.txt\")).trim();\r\n     5\t    double m = Double.parseDouble(s);\r\n     6\t    return reuse + 1e-9 >= m;\r\n     7\t  }\r\n     8\t}\r\n"]
