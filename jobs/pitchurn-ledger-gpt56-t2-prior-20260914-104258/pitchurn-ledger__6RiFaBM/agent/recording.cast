[44.201519, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Span {\r\n     4\t  public static void merge() throws Exception {\r\n     5\t    Path live = Paths.get(\"/app/urnbay/idx.tsv\");\r\n     6\t    Path hot = Paths.get(\"/app/urnbay/hot/idx.tsv\");\r\n     7\t    StringBuilder sb = new StringBuilder();\r\n     8\t    if (Files.exists(live)) sb.append(Files.readString(live));\r\n     9\t    if (Files.exists(hot)) sb.append(Files.readString(hot));\r\n    10\t    Files.writeString(live, sb.toString());\r\n    11\t    System.out.println(\"walked\");\r\n    12\t  }\r\n    13\t}\r\n"]
[44.202738, "o", "     1\timport java.util.*;\r\n     2\tpublic class Slice {\r\n     3\t  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {\r\n     4\t    int h = 0;\r\n     5\t    int start = 0;\r\n     6\t    java.util.List<byte[]> out = new java.util.ArrayList<>();\r\n     7\t    for (int i = 0; i < src.length; i++) {\r\n     8\t      byte b = src[i];\r\n     9\t      h = (h << 1) + b;\r\n    10\t      int ln = i - start + 1;\r\n    11\t      if ((ln >= min && (h & mask) == 0) || ln >= max || i == src.length - 1) {\r\n    12\t        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));\r\n    13\t        start = i + 1;\r\n"]
[44.202836, "o", "    14\t        h = 0;\r\n    15\t      }\r\n    16\t    }\r\n    17\t    return out;\r\n    18\t  }\r\n    19\t}\r\n"]
[44.205038, "o", "     1\timport java.security.MessageDigest;\r\n     2\tpublic class Seal {\r\n     3\t  public static String hex(byte[] p, int fp) throws Exception {\r\n     4\t    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n     5\t    md.update(p);\r\n     6\t    byte[] d = md.digest();\r\n     7\t    StringBuilder sb = new StringBuilder();\r\n     8\t    for (byte x : d) sb.append(String.format(\"%02x\", x));\r\n     9\t    return sb.toString();\r\n    10\t  }\r\n    11\t  public static String pay(byte[] p) throws Exception {\r\n    12\t    MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n    13\t    md.update(p);\r\n    14\t    byte[] d = md.digest();\r\n    15\t    StringBuilder sb = new StringBuilder();\r\n    16\t    for (byte x : d) sb.append(String.format(\"%02x\", x));\r\n    17\t    return sb.toString();\r\n    18\t  }\r\n    19\t}\r\n"]
