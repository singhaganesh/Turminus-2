[142.24425, "i", "python3 - <<'PY'\nfrom pathlib import Path\nroot=Path('/app/urnbay')\nlines=[x for x in (root/'idx.tsv').read_text().splitlines() if x.strip()]\nitems=[x.split('\\t',1) for x in lines]\nassert len({k for k,_ in items}) == len(items), 'duplicate canonical keys'\nassert all((root/r).is_file() for _,r in items), 'missing indexed blob'\nprint('canonical_entries',len(items),'all_unique_and_present')\nPY\nh1=$(sha256sum /app/urnbay/idx.tsv /app/urnbay/hot/idx.tsv); /app/bin/pitchurn anneal; h2=$(sha256sum /app/urnbay/idx.tsv /app/urnbay/hot/idx.tsv); test \"$h1\" = \"$h2\"; echo \"anneal_idempotent_rc=$?\"; /app/bin/pitchurn anneal\n"]
