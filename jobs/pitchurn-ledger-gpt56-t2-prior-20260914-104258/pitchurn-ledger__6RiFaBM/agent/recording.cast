[33.577679, "o", "     1\timport java.io.*;\r\n     2\tpublic class DuskGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")));\r\n     7\t    loom(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n"]
[33.577725, "o", "    10\t  public static void loom(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.nio.file.*;\");\r\n    12\t    a.println(\"import java.util.*;\");\r\n    13\t    a.println(\"public class Span {\");\r\n    14\t    a.println(\"  public static void merge() throws Exception {\");\r\n    15\t    a.println(\"    Path live = Paths.get(\\\"/app/urnbay/idx.tsv\\\");\");\r\n    16\t    a.println(\"    Path hot = Paths.get(\\\"/app/urnbay/hot/idx.tsv\\\");\");\r\n    17\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    18\t    a.println(\"    if (Files.exists(live)) sb.append(Files.readString(live));\");\r\n    19\t    a.println(\"    if (Files.exists(hot)) sb.append(Files.readString(hot));\");\r\n    20\t    a.println(\"    Files.writeString(live, sb.toString());\");\r\n"]
[33.577742, "o", "    21\t    a.println(\"    System.out.println(\\\"walked\\\");\");\r\n    22\t    a.println(\"  }\");\r\n    23\t    a.println(\"}\");\r\n    24\t  }\r\n    25\t}\r\n"]
[33.578051, "o", "--- Gear ---\r\n"]
[33.579125, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Gear {\r\n     4\t  public int mask, min, max, fp;\r\n     5\t  public static Gear load(String p) throws Exception {\r\n     6\t    Gear g = new Gear();\r\n     7\t    for (String ln : Files.readAllLines(Paths.get(p))) {\r\n     8\t      String t = ln.trim();\r\n     9\t      if (t.startsWith(\"mask=\")) g.mask = Integer.parseInt(t.substring(5));\r\n    10\t      if (t.startsWith(\"min=\")) g.min = Integer.parseInt(t.substring(4));\r\n    11\t"]
[33.579257, "o", "      if (t.startsWith(\"max=\")) g.max = Integer.parseInt(t.substring(4));\r\n    12\t      if (t.startsWith(\"fp=\")) g.fp = Integer.parseInt(t.substring(3));\r\n    13\t    }\r\n    14\t    return g;\r\n    15\t  }\r\n    16\t}\r\n"]
[33.579433, "o", "--- Idx ---\r\n"]
[33.580813, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Idx {\r\n     4\t  public static Map<String,String> load() throws Exception {\r\n     5\t    Map<String,String> m = new LinkedHashMap<>();\r\n     6\t    add(m, \"/app/urnbay/idx.tsv\");\r\n     7\t    add(m, \"/app/urnbay/keep/idx.tsv\");\r\n     8\t    add(m, \"/app/urnbay/hot/idx.tsv\");\r\n     9\t    return m;\r\n    10\t  }\r\n    11\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    12\t    Path f = Paths.get(p);\r\n    13\t    if (!Files.exists(f)) return;\r\n    14\t    for (String ln : Files.readAllLines(f)) {\r\n    15\t      String t = ln.trim();\r\n"]
[33.58089, "o", "    16\t      if (t.isEmpty()) continue;\r\n    17\t      String[] sp = t.split(\"\\t\");\r\n    18\t      if (sp.length >= 2) m.put(sp[0], sp[1]);\r\n    19\t    }\r\n    20\t  }\r\n    21\t  public static void put(String k, String rel) throws Exception {\r\n    22\t    Path f = Paths.get(\"/app/urnbay/idx.tsv\");\r\n    23\t    Files.writeString(f, k + \"\\t\" + rel + \"\\n\", java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);\r\n    24\t  }\r\n    25\t  public static byte[] blob(String rel) throws Exception {\r\n    26\t    return Files.readAllBytes(Paths.get(\"/app/urnbay/\" + rel));\r\n    27\t  }\r\n    28\t}\r\n"]
[33.581152, "o", "--- Main ---\r\n"]
[33.581933, "o", "     1\tpublic class Main {\r\n     2\t  public static void main(String[] a) throws Exception {\r\n     3\t    if (a.length == 0) {\r\n     4\t      System.err.println(\"usage\");\r\n     5\t      System.exit(2);\r\n     6\t    }\r\n     7\t    String cmd = a[0];\r\n     8\t    int rc = 0;\r\n     9\t    if (cmd.equals(\"anneal\")) {\r\n    10\t      rc = WalkRun.run();\r\n"]
[33.582026, "o", "    11\t    } else if (cmd.equals(\"stow\")) {\r\n    12\t      rc = StowRun.run(a[1]);\r\n    13\t    } else if (cmd.equals(\"draw\")) {\r\n    14\t      rc = DrawRun.run(a[1], a[2]);\r\n    15\t    } else if (cmd.equals(\"census\")) {\r\n    16\t      rc = CardRun.run();\r\n    17\t    } else {\r\n    18\t      rc = 2;\r\n    19\t    }\r\n    20\t    System.exit(rc);\r\n    21\t  }\r\n    22\t}\r\n"]
