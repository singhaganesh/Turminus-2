[85.363777, "o", "    // Also normalize unmarked silo payloads.  Snapshot the paths because\r\n\u001b[?2004l\r"]
[85.363839, "o", "\u001b[?2004h> "]
[85.363976, "o", "    // addParts extends idx while walking.\r\n\u001b[?2004l\r"]
[85.364055, "o", "\u001b[?2004h> "]
[85.36416, "o", "    for (String rel : new LinkedHashSet<>(idx.values()))\r\n\u001b[?2004l\r"]
[85.364226, "o", "\u001b[?2004h"]
[85.364315, "o", "> "]
[85.36442, "o", "      addParts(Files.readAllBytes(ROOT.resolve(rel)), gear, idx);\r\n\u001b[?2004l\r"]
[85.364508, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.36468, "o", "    // Reconstruct whole reels before cutting: old piece edges must not become\r\n\u001b[?2004l\r"]
[85.364802, "o", "\u001b[?2004h> "]
[85.364933, "o", "    // artificial boundaries under the tightened gear.\r\n\u001b[?2004l\r"]
[85.364997, "o", "\u001b[?2004h> "]
[85.365082, "o", "    Path marks = ROOT.resolve(\"marks\");\r\n\u001b[?2004l\r"]
[85.365152, "o", "\u001b[?2004h> "]
[85.365255, "o", "    if (Files.isDirectory(marks)) {\r\n\u001b[?2004l\r"]
[85.365331, "o", "\u001b[?2004h> "]
[85.365495, "o", "      try (DirectoryStream<Path> manifests = Files.newDirectoryStream(marks, \"*.m\")) {\r\n\u001b[?2004l\r"]
[85.365568, "o", "\u001b[?2004h> "]
[85.365748, "o", "        for (Path manifest : manifests) addParts(reel(manifest, idx), gear, idx);\r\n\u001b[?2004l\r"]
[85.365846, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[85.365939, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.366003, "o", "\u001b[?2004h> "]
[85.366068, "o", "    StringBuilder all = new StringBuilder();\r\n\u001b[?2004l\r"]
[85.366192, "o", "\u001b[?2004h> "]
[85.366287, "o", "    StringBuilder hot = new StringBuilder();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.366432, "o", "    for (Map.Entry<String,String> e : idx.entrySet()) {\r\n\u001b[?2004l\r"]
[85.366503, "o", "\u001b[?2004h> "]
[85.366628, "o", "      String line = e.getKey() + \"\\\\t\" + e.getValue() + \"\\\\n\";\r\n\u001b[?2004l\r"]
[85.366711, "o", "\u001b[?2004h> "]
[85.366789, "o", "      all.append(line);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.366985, "o", "      if (e.getValue().startsWith(\"hot/\")) hot.append(line);\r\n\u001b[?2004l\r"]
[85.367049, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[85.367106, "o", "\u001b[?2004h> "]
[85.367264, "o", "    Files.writeString(ROOT.resolve(\"idx.tsv\"), all.toString());\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.367335, "o", "> "]
[85.367408, "o", "    Files.createDirectories(ROOT.resolve(\"hot\"));\r\n\u001b[?2004l\r"]
[85.367464, "o", "\u001b[?2004h"]
[85.367515, "o", "> "]
[85.367633, "o", "    Files.writeString(ROOT.resolve(\"hot/idx.tsv\"), hot.toString());\r\n\u001b[?2004l\r"]
[85.367709, "o", "\u001b[?2004h> "]
[85.367782, "o", "    System.out.println(\"walked\");\r\n\u001b[?2004l\r"]
[85.367842, "o", "\u001b[?2004h> "]
[85.367903, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.367962, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\");\r\n\u001b[?2004l\r"]
[85.368011, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[85.368059, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[85.368117, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[85.369529, "o", "\u001b[?2004hroot@606830fe3954:/app# "]
