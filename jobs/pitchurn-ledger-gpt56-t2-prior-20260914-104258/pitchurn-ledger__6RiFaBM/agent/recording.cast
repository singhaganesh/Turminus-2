[21.794251, "o", "for d in oxemit nincut coldrib hitchcli; do for f in /app/$d/*.java; do echo \"--- $f ---\"; nl -ba \"$f\"; done; done\r\n\u001b[?2004l\r"]
[21.794854, "o", "--- /app/oxemit/RibGen.java ---\r\n"]
[21.797644, "o", "     1\timport java.io.*;\r\n     2\tpublic class RibGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Seal.java\")));\r\n     7\t    weld(w);\r\n"]
[21.797971, "o", "     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void weld(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.security.MessageDigest;\");\r\n    12\t    a.println(\"public class Seal {\");\r\n    13\t    a.println(\"  public static String hex(byte[] p, int fp) throws Exception {\");\r\n    14\t    a.println(\"    MessageDigest md = MessageDigest.getInstance(\\\"SHA-256\\\");\");\r\n    15\t    a.println(\"    md.update(p);\");\r\n    16\t    a.println(\"    byte[] d = md.digest();\");\r\n    17\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    18\t    a.println(\"    for (byte x : d) sb.append(String.format(\\\"%02x\\\", x));\");\r\n    19\t    a.println(\"    return sb.toString();\");\r\n    20\t    a.println(\"  }\");\r\n    21\t    a.println(\"  public static String pay(byte[] p) throws Exception {\");\r\n    22\t    a.println(\"    MessageDigest md = MessageDigest.getInstance(\\\"SHA-256\\\");\");\r\n    23\t    a.println(\"    md.update(p);\");\r\n    24\t    a.println(\"    byte[] d = md.digest();\");\r\n    25\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    26\t    a.println(\"    for (byte x : d) sb.append(String.format(\\\"%02x\\\", x));\");\r\n    27\t    a.println(\"    return sb.toString();\");\r\n    28\t    a.println(\"  }\");\r\n    29\t    a.println(\"}\");\r\n    30\t  }\r\n    31\t}\r\n"]
[21.798395, "o", "--- /app/nincut/VatGen.java ---\r\n"]
[21.799928, "o", "     1\timport java.io.*;\r\n     2\tpublic class VatGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n"]
[21.800131, "o", "     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Slice.java\")));\r\n     7\t    tint(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void tint(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.util.*;\");\r\n    12\t    a.println(\"public class Slice {\");\r\n    13\t    a.println(\"  public static java.util.List<byte[]> cut(byte[] src, int mask, int min, int max) {\");\r\n    14\t    a.println(\"    int h = 0;\");\r\n    15\t    a.println(\"    int start = 0;\");\r\n    16\t    a.println(\"    java.util.List<byte[]> out = new java.util.ArrayList<>();\");\r\n    17\t    a.println(\"    for (int i = 0; i < src.length; i++) {\");\r\n    18\t    a.println(\"      byte b = src[i];\");\r\n    19\t    a.println(\"      h = (h << 1) + b;\");\r\n    20\t    a.println(\"      int ln = i - start + 1;\");\r\n    21\t    a.println(\"      if ((ln >= min && (h & mask) == 0) || ln >= max || i == src.length - 1) {\");\r\n    22\t    a.println(\"        out.add(java.util.Arrays.copyOfRange(src, start, i + 1));\");\r\n"]
[21.800241, "o", "    23\t    a.println(\"        start = i + 1;\");\r\n    24\t    a.println(\"        h = 0;\");\r\n    25\t    a.println(\"      }\");\r\n    26\t    a.println(\"    }\");\r\n    27\t    a.println(\"    return out;\");\r\n    28\t    a.println(\"  }\");\r\n    29\t    a.println(\"}\");\r\n    30\t  }\r\n    31\t}\r\n"]
[21.80044, "o", "--- /app/coldrib/DuskGen.java ---\r\n"]
[21.80167, "o", "     1\timport java.io.*;\r\n     2\tpublic class DuskGen {\r\n     3\t  public static void main(String[] a) throws Exception {\r\n     4\t    File d = new File(\"/app/deskbin/gen\");\r\n     5\t    d.mkdirs();\r\n     6\t    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")));\r\n     7\t    loom(w);\r\n     8\t    w.close();\r\n     9\t  }\r\n    10\t  public static void loom(PrintWriter a) throws Exception {\r\n    11\t    a.println(\"import java.nio.file.*;\");\r\n"]
[21.801854, "o", "    12\t    a.println(\"import java.util.*;\");\r\n    13\t    a.println(\"public class Span {\");\r\n    14\t    a.println(\"  public static void merge() throws Exception {\");\r\n    15\t    a.println(\"    Path live = Paths.get(\\\"/app/urnbay/idx.tsv\\\");\");\r\n    16\t    a.println(\"    Path hot = Paths.get(\\\"/app/urnbay/hot/idx.tsv\\\");\");\r\n    17\t    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    18\t    a.println(\"    if (Files.exists(live)) sb.append(Files.readString(live));\");\r\n    19\t    a.println(\"    if (Files.exists(hot)) sb.append(Files.readString(hot));\");\r\n    20\t    a.println(\"    Files.writeString(live, sb.toString());\");\r\n    21\t    a.println(\"    System.out.println(\\\"walked\\\");\");\r\n    22\t    a.println(\"  }\");\r\n    23\t    a.println(\"}\");\r\n    24\t  }\r\n    25\t}\r\n"]
[21.802165, "o", "--- /app/hitchcli/CardRun.java ---\r\n"]
[21.803274, "o", "     1\timport java.nio.file.*;\r\n     2\tpublic class CardRun {\r\n     3\t  public static int run() throws Exception {\r\n     4\t    Path last = Paths.get(\"/app/urnbay/last.json\");\r\n     5\t    if (!Files.exists(last)) return 1;\r\n"]
[21.803408, "o", "     6\t    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), Files.readString(last));\r\n     7\t    return 0;\r\n     8\t  }\r\n     9\t}\r\n"]
[21.803746, "o", "--- /app/hitchcli/DrawRun.java ---\r\n"]
[21.807965, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class DrawRun {\r\n     4\t  public static int run(String dest, String reel) throws Exception {\r\n     5\t    String name = Paths.get(reel).getFileName().toString();\r\n     6\t    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n     7\t    Map<String,String> idx = Idx.load();\r\n     8\t    add(idx, \"/app/urnbay/cold/idx.tsv\");\r\n     9\t    StringBuilder skip = new StringBuilder();\r\n    10\t    List<byte[]> acc = new ArrayList<>();\r\n    11\t    for (String ln : Files.readAllLines(mk)) {\r\n    12\t      String k = ln.trim();\r\n    13\t      if (k.isEmpty()) continue;\r\n    14\t      String rel = idx.get(k);\r\n    15\t      if (rel == null) continue;\r\n    16\t      acc.add(Idx.blob(rel));\r\n    17\t    }\r\n    18\t    int n = 0;\r\n    19\t    for (byte[] b : acc) n += b.length;\r\n    20\t    byte[] out = new byte[n];\r\n    21\t    int o = 0;\r\n    22\t    for (byte[] b : acc) {\r\n    23\t      System.arraycopy(b, 0, out, o, b.length);\r\n    24\t      o += b.length;\r\n    25\t    }\r\n    26\t    Path d = Paths.get(dest);\r\n    27\t    Files.createDirectories(d.getParent() == null ? Paths.get(\".\") : d.getParent());\r\n    28\t    Files.write(d, out);\r\n    29\t    return 0;\r\n    30\t  }\r\n    31\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    32\t    Idx.add(m, p);\r\n    33\t  }\r\n    34\t}\r\n--- /app/hitchcli/Gear.java ---\r\n"]
[21.808283, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Gear {\r\n     4\t  public int mask, min, max, fp;\r\n     5\t  public static Gear load(String p) throws Exception {\r\n     6\t    Gear g = new Gear();\r\n     7\t    for (String ln : Files.readAllLines(Paths.get(p))) {\r\n     8\t      String t = ln.trim();\r\n"]
[21.80845, "o", "     9\t      if (t.startsWith(\"mask=\")) g.mask = Integer.parseInt(t.substring(5));\r\n    10\t      if (t.startsWith(\"min=\")) g.min = Integer.parseInt(t.substring(4));\r\n    11\t      if (t.startsWith(\"max=\")) g.max = Integer.parseInt(t.substring(4));\r\n    12\t      if (t.startsWith(\"fp=\")) g.fp = Integer.parseInt(t.substring(3));\r\n    13\t    }\r\n    14\t    return g;\r\n    15\t  }\r\n    16\t}\r\n"]
[21.808712, "o", "--- /app/hitchcli/Idx.java ---\r\n"]
[21.810281, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Idx {\r\n     4\t  public static Map<String,String> load() throws Exception {\r\n     5\t    Map<String,String> m = new LinkedHashMap<>();\r\n     6\t    add(m, \"/app/urnbay/idx.tsv\");\r\n     7\t    add(m, \"/app/urnbay/keep/idx.tsv\");\r\n     8\t    add(m, \"/app/urnbay/hot/idx.tsv\");\r\n     9\t    return m;\r\n    10\t  }\r\n"]
[21.810521, "o", "    11\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    12\t    Path f = Paths.get(p);\r\n    13\t    if (!Files.exists(f)) return;\r\n    14\t    for (String ln : Files.readAllLines(f)) {\r\n    15\t      String t = ln.trim();\r\n    16\t      if (t.isEmpty()) continue;\r\n    17\t      String[] sp = t.split(\"\\t\");\r\n    18\t      if (sp.length >= 2) m.put(sp[0], sp[1]);\r\n    19\t    }\r\n    20\t  }\r\n    21\t  public static void put(String k, String rel) throws Exception {\r\n    22\t    Path f = Paths.get(\"/app/urnbay/idx.tsv\");\r\n    23\t    Files.writeString(f, k + \"\\t\" + rel + \"\\n\", java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);\r\n    24\t  }\r\n    25\t  public static byte[] blob(String rel) throws Exception {\r\n    26\t    return Files.readAllBytes(Paths.get(\"/app/urnbay/\" + rel));\r\n    27\t  }\r\n    28\t}\r\n"]
[21.810711, "o", "--- /app/hitchcli/Main.java ---\r\n"]
[21.812081, "o", "     1\tpublic class Main {\r\n     2\t  public static void main(String[] a) throws Exception {\r\n     3\t    if (a.length == 0) {\r\n     4\t      System.err.println(\"usage\");\r\n     5\t      System.exit(2);\r\n     6\t    }\r\n     7\t    String cmd = a[0];\r\n     8\t    int rc = 0;\r\n     9\t    if (cmd.equals(\"anneal\")) {\r\n    10\t      rc = WalkRun.run();\r\n    11\t    } else if (cmd.equals(\"stow\")) {\r\n    12\t      rc = StowRun.run(a[1]);\r\n    13\t    } else if (cmd.equals(\"draw\")) {\r\n    14\t      rc = DrawRun.run(a[1], a[2]);\r\n    15\t    } else if (cmd.equals(\"census\")) {\r\n    16\t      rc = CardRun.run();\r\n    17\t    } else {\r\n    18\t      rc = 2;\r\n    19\t    }\r\n    20\t    System.exit(rc);\r\n    21\t  }\r\n    22\t}\r\n"]
[21.812399, "o", "--- /app/hitchcli/StowRun.java ---\r\n"]
[21.814026, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class StowRun {\r\n     4\t  public static int run(String reel) throws Exception {\r\n     5\t    Gear g = Gear.load(\"/app/gearpit/live.gear\");\r\n     6\t    byte[] src = Files.readAllBytes(Paths.get(reel));\r\n     7\t    List<byte[]> parts = Slice.cut(src, g.mask, g.min, g.max);\r\n     8\t    Map<String,String> idx = Idx.load();\r\n     9\t    long stored = 0;\r\n    10\t    long reused = 0;\r\n    11\t    List<String> keys = new ArrayList<>();\r\n    12\t    Path hot = Paths.get(\"/app/urnbay/hot\");\r\n    13\t    Files.createDirectories(hot);\r\n    14\t    for (byte[] p : parts) {\r\n    15\t      String kb = Seal.hex(p, g.fp);\r\n    16\t      String kp = Seal.pay(p);\r\n    17\t      String hit = null;\r\n    18\t      if (idx.containsKey(kb)) hit = kb;\r\n    19\t      else if (idx.containsKey(kp)) hit = kp;\r\n"]
[21.814251, "o", "    20\t      if (hit != null) {\r\n    21\t        reused += p.length;\r\n    22\t        keys.add(hit);\r\n    23\t      } else {\r\n    24\t        stored += p.length;\r\n    25\t        String rel = \"hot/\" + kb + \".blob\";\r\n    26\t        Files.write(hot.resolve(kb + \".blob\"), p);\r\n    27\t        Idx.put(kb, rel);\r\n    28\t        idx.put(kb, rel);\r\n    29\t        keys.add(kb);\r\n    30\t      }\r\n    31\t    }\r\n    32\t    String name = Paths.get(reel).getFileName().toString();\r\n    33\t    Path flag = Paths.get(\"/app/urnbay/marks/\" + name + \".flag\");\r\n    34\t    boolean prior = Files.exists(flag);\r\n    35\t    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n    36\t    StringBuilder mb = new StringBuilder();\r\n    37\t    for (String k : keys) mb.append(k).append(\"\\n\");\r\n    38\t    Files.createDirectories(mk.getParent());\r\n    39\t    Files.writeString(mk, mb.toString());\r\n    40\t    double reuse = src.length == 0 ? 1.0 : (reused / (double) src.length);\r\n    41\t    double mean = parts.isEmpty() ? 0 : (src.length / (double) parts.size());\r\n    42\t    String json = \"{\\n\"\r\n    43\t      + \"  \\\"reel\\\": \\\"\" + name + \"\\\",\\n\"\r\n    44\t      + \"  \\\"bytes_in\\\": \\\"\" + src.length + \"\\\",\\n\"\r\n    45\t      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\r\n    46\t      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\r\n    47\t      + \"  \\\"mean_piece\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\r\n    48\t      + \"  \\\"piece_count\\\": \\\"\" + parts.size() + \"\\\"\\n\"\r\n    49\t      + \"}\\n\";\r\n    50\t    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\r\n    51\t    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\r\n    52\t    Floor.ok(reuse);\r\n    53\t    if (prior && stored == src.length && src.length > 0) {\r\n    54\t      return 1;\r\n    55\t    }\r\n    56\t    Files.writeString(flag, \"1\\n\");\r\n    57\t    return 0;\r\n"]
