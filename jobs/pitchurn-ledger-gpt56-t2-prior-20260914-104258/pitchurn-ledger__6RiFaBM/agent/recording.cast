[85.326758, "i", "python3 - <<'PY'\np='/app/nincut/VatGen.java'\ns=open(p).read()\ns=s.replace('a.println(\"      byte b = src[i];\");', 'a.println(\"      int b = src[i] & 0xff;\");')\nopen(p,'w').write(s)\nPY\ncat > /app/coldrib/DuskGen.java <<'EOF'\nimport java.io.*;\npublic class DuskGen {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    try (PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")))) {\n      loom(w);\n    }\n  }\n  public static void loom(PrintWriter a) {\n    a.print(\"\"\"\nimport java.io.*;\nimport java.nio.file.*;\nimport java.util.*;\npublic class Span {\n  private static final Path ROOT = Paths.get(\"/app/urnbay\");\n\n  private static void load(Map<String,String> idx, String rel) throws Exception {\n    Path f = ROOT.resolve(rel);\n    if (!Files.exists(f)) return;\n    for (String line : Files.readAllLines(f)) {\n      String t = line.trim();\n      if (t.isEmpty()) continue;\n      String[] fields = t.split(\"\\\\t\");\n      if (fields.length >= 2 && Files.isRegularFile(ROOT.resolve(fields[1])))\n        idx.put(fields[0], fields[1]);\n    }\n  }\n\n  private static void addParts(byte[] bytes, Gear gear,\n                               Map<String,String> idx) throws Exception {\n    Path hot = ROOT.resolve(\"hot\");\n    Files.createDirectories(hot);\n    for (byte[] part : Slice.cut(bytes, gear.mask, gear.min, gear.max)) {\n      String key = Seal.pay(part);\n      String rel = idx.get(key);\n      if (rel == null || !Files.isRegularFile(ROOT.resolve(rel))) {\n        rel = \"hot/\" + key + \".blob\";\n        Path dst = ROOT.resolve(rel);\n        if (!Files.exists(dst)) Files.write(dst, part);\n        idx.put(key, rel);\n      }\n    }\n  }\n\n  private static byte[] reel(Path manifest, Map<String,String> idx) throws Exception {\n    ByteArrayOutputStream out = new ByteArrayOutputStream();\n    for (String line : Files.readAllLines(manifest)) {\n      String key = line.trim();\n      if (key.isEmpty()) continue;\n      String rel = idx.get(key);\n      if (rel == null || !Files.isRegularFile(ROOT.resolve(rel)))\n        throw new IOException(\"missing silo piece \" + key + \" for \" + manifest);\n      out.write(Files.readAllBytes(ROOT.resolve(rel)));\n    }\n    return out.toByteArray();\n  }\n\n  public static void merge() throws Exception {\n    Gear gear = Gear.load(\"/app/gearpit/live.gear\");\n    Map<String,String> idx = new LinkedHashMap<>();\n    load(idx, \"idx.tsv\");\n    load(idx, \"keep/idx.tsv\");\n    load(idx, \"hot/idx.tsv\");\n    load(idx, \"cold/idx.tsv\");\n\n    // Also normalize unmarked silo payloads.  Snapshot the paths because\n    // addParts extends idx while walking.\n    for (String rel : new LinkedHashSet<>(idx.values()))\n      addParts(Files.readAllBytes(ROOT.resolve(rel)), gear, idx);\n\n    // Reconstruct whole reels before cutting: old piece edges must not become\n    // artificial boundaries under the tightened gear.\n    Path marks = ROOT.resolve(\"marks\");\n    if (Files.isDirectory(marks)) {\n      try (DirectoryStream<Path> manifests = Files.newDirectoryStream(marks, \"*.m\")) {\n        for (Path manifest : manifests) addParts(reel(manifest, idx), gear, idx);\n      }\n    }\n\n    StringBuilder all = new StringBuilder();\n    StringBuilder hot = new StringBuilder();\n    for (Map.Entry<String,String> e : idx.entrySet()) {\n      String line = e.getKey() + \"\\\\t\" + e.getValue() + \"\\\\n\";\n      all.append(line);\n      if (e.getValue().startsWith(\"hot/\")) hot.append(line);\n    }\n    Files.writeString(ROOT.resolve(\"idx.tsv\"), all.toString());\n    Files.createDirectories(ROOT.resolve(\"hot\"));\n    Files.writeString(ROOT.resolve(\"hot/idx.tsv\"), hot.toString());\n    System.out.println(\"walked\");\n  }\n}\n\"\"\");\n  }\n}\nEOF\n/app/kiln.sh\n"]
