    String key = line.trim();\n      if (key.isEmpty()) continue;\n      String rel = idx.get(key);\n      if (rel == null || !Files.isRegularFile(ROOT.resolve(rel)))\n        throw new IOException("missing silo piece " + key + " for " + manifest);\n      out.write(Files.readAllBytes(ROOT.resolve(rel)));\n    }\n    return out.toByteArray();\n  }\n\n  public static void merge() throws Exception {\n    Gear gear = Gear.load("/app/gearpit/live.gear");\n    Map<String,String> idx = new LinkedHashMap<>();\n    load(idx, "idx.tsv");\n    load(idx, "keep/idx.tsv");\n    load(idx, "hot/idx.tsv");\n    load(idx, "cold/idx.tsv");\n\n    // Also normalize unmarked silo payloads.  Snapshot the paths because\n    // addParts extends idx while walking.\n    for (String rel : new LinkedHashSet<>(idx.values()))\n      addParts(Files.readAllBytes(ROOT.resolve(rel)), gear, idx);\n\n    // Reconstruct whole reels before cutting: old piece edges must not become\n    // artificial boundaries under the tightened gear.\n    Path marks = ROOT.resolve("marks");\n    if (Files.isDirectory(marks)) {\n      try (DirectoryStream<Path> manifests = Files.newDirectoryStream(marks, "*.m")) {\n        for (Path manifest : manifests) addParts(reel(manifest, idx), gear, idx);\n      }\n    }\n\n    StringBuilder all = new StringBuilder();\n    StringBuilder hot = new StringBuilder();\n    for (Map.Entry<String,String> e : idx.entrySet()) {\n      String line = e.getKey() + "\\\\t" + e.getValue() + "\\\\n";\n      all.append(line);\n      if (e.getValue().startsWith("hot/")) hot.append(line);\n    }\n    Files.writeString(ROOT.resolve("idx.tsv"), all.toString());\n    Files.createDirectories(ROOT.resolve("hot"));\n    Files.writeString(ROOT.resolve("hot/idx.tsv"), hot.toString());\n    System.out.println("walked");\n  }\n}\n""");\n  }\n}\nEOF\n/app/kiln.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
