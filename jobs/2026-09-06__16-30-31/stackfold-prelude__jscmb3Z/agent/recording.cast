[76.286003, "i", "cd /app && python3 - <<'PY'\nfrom pathlib import Path\nT=chr(9)\nPath('symmill/mk/foldlink.dep').write_text(\n    '$(SYMAP): $(TARGET)\\n'\n    + T + '@mkdir -p fold\\n'\n    + T + '$(PCFOLD) index --linked $(TARGET) -o $(SYMAP)\\n'\n)\n# Normalize the emitmap recipe with guaranteed Make tabs as well.\np=Path('symmill/Makefile')\ns=p.read_text()\na=s.index('emitmap: $(PROFILE)')\nb=s.index('\\n$(TARGET):', a)\ns=s[:a] + ('emitmap: $(PROFILE)\\n'\n    + T + '$(PCFOLD) check $(TARGET) $(SYMAP)\\n'\n    + T + \"@readelf -n $(TARGET) | sed -n 's/.*Build ID: //p' > /app/benchframes/anchor/buildid.stamp\\n\") + s[b:]\np.write_text(s)\nPY\necho '--- visible tabs ---'; cat -vet symmill/mk/foldlink.dep; sed -n '/^emitmap:/,/^$/p' symmill/Makefile | cat -vet\n"]
