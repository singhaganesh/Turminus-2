[36.303146, "o", "     1\t#include \"pcfold.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdlib.h>\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\ttypedef struct {\r\n     8\t    sf_sym_t *syms;\r\n     9\t    int count;\r\n    10\t} sf_map_ro_t;\r\n    11\t\r\n    12\tstatic int load_map_ro(const char *path, sf_map_ro_t *map)\r\n    13\t{\r\n    14\t    memset(map, 0, sizeof(*map));\r\n    15\t    FILE *fp = fopen(path, \"r\");\r\n    16\t    if (!fp) {\r\n    17\t        return -1;\r\n    18\t    }\r\n    19\t    char line[512];\r\n    20\t    if (!fgets(line, sizeof(line), fp) || strncmp(line, SF_MAGIC, strlen(SF_MAGIC)) != 0) {\r\n    21\t        fclose(fp);\r\n    22\t        return -1;\r\n    23\t    }\r\n    24\t    while (fgets(line, sizeof(line), fp)) {\r\n    25\t        if (strncmp(line, \"sym \", 4) != 0) {\r\n    26\t            continue;\r\n    27\t        }\r\n    28\t        sf_sym_t sym = {0};\r\n"]
[36.3032, "o", "    29\t        unsigned long start = 0;\r\n    30\t        unsigned long size = 0;\r\n    31\t        if (sscanf(line, \"sym %127s 0x%lx 0x%lx\", sym.name, &start, &size) != 3) {\r\n    32\t            continue;\r\n    33\t        }\r\n    34\t        sym.start = start;\r\n    35\t        sym.size = size;\r\n    36\t        sf_sym_t *next = realloc(map->syms, (size_t)(map->count + 1) * sizeof(sf_sym_t));\r\n    37\t        if (!next) {\r\n    38\t            fclose(fp);\r\n    39\t            free(map->syms);\r\n    40\t            return -1;\r\n    41\t        }\r\n    42\t        map->syms = next;\r\n    43\t        map->syms[map->count++] = sym;\r\n    44\t    }\r\n    45\t    fclose(fp);\r\n    46\t    return map->count > 0 ? 0 : -1;\r\n    47\t}\r\n    48\t\r\n    49\tstatic int resolve_pc(const sf_map_ro_t *map, unsigned long pc, char *sym_out, unsigned long *off_out)\r\n    50\t{\r\n    51\t    const sf_sym_t *best = NULL;\r\n    52\t    for (int i = 0; i < map->count; i++) {\r\n    53\t        const sf_sym_t *s = &map->syms[i];\r\n    54\t        if (pc >= s->start && pc < s->start + s->size) {\r\n    55\t            if (!best || s->start > best->start) {\r\n    56\t                best = s;\r\n    57\t            }\r\n    58\t        }\r\n    59\t    }\r\n    60\t    if (!best) {\r\n    61\t        for (int i = 0; i < map->count; i++) {\r\n    62\t            const sf_sym_t *s = &map->syms[i];\r\n    63\t            if (!best || s->start < best->start) {\r\n"]
[36.303582, "o", "    64\t                best = s;\r\n    65\t            }\r\n    66\t        }\r\n"]
[36.303624, "o", "    67\t    }\r\n    68\t    if (!best) {\r\n    69\t        return -1;\r\n    70\t    }\r\n    71\t    strncpy(sym_out, best->name, 127);\r\n    72\t    sym_out[127] = '\\0';\r\n    73\t    *off_out = pc - best->start;\r\n    74\t    return 0;\r\n    75\t}\r\n    76\t\r\n    77\tint sf_render(const char *samples_path, const char *symmap_path, const char *out_path)\r\n    78\t{\r\n    79\t    sf_map_ro_t map;\r\n    80\t    if (load_map_ro(symmap_path, &map) != 0) {\r\n    81\t        return -1;\r\n    82\t    }\r\n    83\t    FILE *in = fopen(samples_path, \"r\");\r\n    84\t    if (!in) {\r\n    85\t        free(map.syms);\r\n    86\t        return -1;\r\n    87\t    }\r\n    88\t    FILE *out = fopen(out_path, \"w\");\r\n    89\t    if (!out) {\r\n    90\t        fclose(in);\r\n    91\t        free(map.syms);\r\n    92\t        return -1;\r\n    93\t    }\r\n    94\t    fprintf(out, \"{\\n  \\\"frames\\\": [\\n\");\r\n    95\t    char line[256];\r\n    96\t    int first = 1;\r\n    97\t    while (fgets(line, sizeof(line), in)) {\r\n    98\t        unsigned long pc = 0;\r\n    99\t        if (sscanf(line, \"pc 0x%lx\", &pc) != 1) {\r\n   100\t            continue;\r\n   101\t        }\r\n   102\t        char sym[128] = {0};\r\n   103\t        unsigned long off = 0;\r\n   104\t        if (resolve_pc(&map, pc, sym, &off) != 0) {\r\n   105\t            continue;\r\n   106\t        }\r\n   107\t        if (!first) {\r\n   108\t            fprintf(out, \",\\n\");\r\n   109\t        }\r\n   110\t        fprintf(out, \"    {\\\"pc\\\": \\\"0x%lx\\\", \\\"symbol\\\": \\\"%s\\\", \\\"offset\\\": %lu}\", pc, sym, off);\r\n   111\t        first = 0;\r\n   112\t    }\r\n   113\t    fprintf(out, \"\\n  ]\\n}\\n\");\r\n   114\t    fclose(in);\r\n   115\t    fclose(out);\r\n   116\t    free(map.syms);\r\n   117\t    return 0;\r\n   118\t}\r\n"]
