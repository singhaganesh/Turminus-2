[28.230715, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -fPIC\r\nLDFLAGS ?= -Wl,--build-id\r\nSRC := src/core.c src/worker.c src/dispatch_ring.c\r\nOBJS := $(SRC:.c=.o)\r\nTARGET := fold/runtime\r\nSYMAP := fold/runtime.symmap\r\nPROFILE := fold/profile.json\r\nPCFOLD := /app/bin/pcfold\r\nSAMPLES := /app/benchframes/bench.samples\r\n\r\ninclude mk/foldlink.dep\r\n\r\n.PHONY: emitmap clean hull\r\n\r\nhull: $(TARGET)\r\n\r\nemitmap: $(PROFILE)\r\n\t@:\r\n\r\n$(TARGET): $(OBJS)\r\n\t@mkdir -p fold\r\n\t$(CC) $(LDFLAGS) -o $@ $(OBJS)\r\n\r\n$(PROFILE): $(SYMAP) $(SAMPLES)\r\n\t$(PCFOLD) render $(SAMPLES) $(SYMAP) -o $(PROFILE)\r\n\r\nclean:\r\n\trm -f $(OBJS) $(TARGET) $(SYMAP) $(PROFILE)\r\n\r\nsrc/%.o: src/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n"]
[28.231237, "o", "/app/pcfold/Makefile\r\n"]
[28.232361, "o", "---/app/pcfold/Makefile\r\n"]
[28.233099, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Iinclude\r\nSRC := src/main.c src/index.c src/parity.c src/render.c src/elfutil.c\r\nBIN := /app/bin/pcfold\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
