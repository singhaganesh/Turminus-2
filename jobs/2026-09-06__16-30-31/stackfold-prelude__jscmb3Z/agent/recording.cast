[60.154187, "i", "cd /app && cat > symmill/mk/foldlink.dep <<'EOF'\n$(SYMAP): $(TARGET)\n\t@mkdir -p fold\n\t$(PCFOLD) index --linked $(TARGET) -o $(SYMAP)\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('symmill/Makefile')\ns=p.read_text()\ns=s.replace('emitmap: $(PROFILE)\\n\\t@:\\n', '''emitmap: $(PROFILE)\n\\t$(PCFOLD) check $(TARGET) $(SYMAP)\n\\t@readelf -n $(TARGET) | sed -n 's/.*Build ID: //p' > /app/benchframes/anchor/buildid.stamp\n''')\np.write_text(s)\nPath('pcfold/conf/latch.env').write_text('FOLD_LATCH on\\n')\nPath('pcfold/conf/index.mode').write_text('index_mode=linked\\n')\nPY\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('pcfold/src/parity.c')\ns=p.read_text()\ns=s.replace('    char build_id[128];\\n    sf_sym_t *syms;', '    char build_id[128];\\n    char origin[128];\\n    sf_sym_t *syms;')\ns=s.replace('''        } else if (strncmp(line, \"buildid \", 8) == 0) {\n            sscanf(line, \"buildid %127s\", map->build_id);\n        } else if (strncmp(line, \"sym \", 4) == 0) {''', '''        } else if (strncmp(line, \"buildid \", 8) == 0) {\n            sscanf(line, \"buildid %127s\", map->build_id);\n        } else if (strncmp(line, \"origin \", 7) == 0) {\n            sscanf(line, \"origin %127s\", map->origin);\n        } else if (strncmp(line, \"sym \", 4) == 0) {''')\nstart=s.index('static int sym_in_map(')\nend=s.index('\\nstatic int guard_allows_bypass', start)\ns=s[:start]+s[end+1:]\ns=s.replace('''    if (strcmp(map.mode, \"linked\") != 0) {\n        free_map(&map);\n        return 1;\n    }''', '''    if (strcmp(map.mode, \"linked\") != 0\n        || strcmp(map.origin, \"pcfold-index-linked\") != 0) {\n        free_map(&map);\n        return 1;\n    }''')\nold='''    for (int i = 0; i < elf_count; i++) {\n        if (!sym_in_map(&map, elf_syms[i].name)) {\n            free(elf_syms);\n            free_map(&map);\n            return 1;\n        }\n    }'''\nnew='''    if (map.count != elf_count) {\n        free(elf_syms);\n        free_map(&map);\n        return 1;\n    }\n    for (int i = 0; i < elf_count; i++) {\n        if (strcmp(map.syms[i].name, elf_syms[i].name) != 0\n            || map.syms[i].start != elf_syms[i].start\n            || map.syms[i].size != elf_syms[i].size) {\n            free(elf_syms);\n            free_map(&map);\n            return 1;\n        }\n    }'''\nif old not in s:\n    raise SystemExit('expected parity loop not found')\ns=s.replace(old,new)\np.write_text(s)\nPY\nprintf '%s\\n' '--- patched pipeline ---' && cat symmill/mk/foldlink.dep pcfold/conf/latch.env pcfold/conf/index.mode && grep -A4 '^emitmap:' symmill/Makefile && grep -n 'origin\\|map.count\\|map.syms' pcfold/src/parity.c\n"]
