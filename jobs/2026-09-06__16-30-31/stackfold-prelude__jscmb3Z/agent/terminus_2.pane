--- symmill/src/core.c
#include <stdint.h>

uint32_t legacy_worker(uint32_t seed);

int main(void)
{
    return (int)legacy_worker(0x11U);
}

int runtime_entry(uint32_t seed)
{
    uint32_t base = legacy_worker(seed);
    return base + 17U;
}
--- symmill/src/dispatch_ring.c
#include <stdint.h>

uint32_t ring_dispatch(uint32_t lane)
{
    return (lane * 0x9E3779B1U) ^ 0xC3U;
}
--- symmill/src/worker.c
#include <stdint.h>

uint32_t ring_dispatch(uint32_t lane);

uint32_t legacy_worker(uint32_t seed)
{
    uint32_t lane = (seed ^ 0xA5A5A5A5U) & 0xFFU;
    return ring_dispatch(lane) + seed;
}
