[10.661872, "o", "\r\n\u001b[?2004l\r--- files ---\r\n"]
[10.669742, "o", "benchframes/MANIFEST\r\nbenchframes/anchor/buildid.stamp\r\nbenchframes/anchor/symbols.tab\r\n"]
[10.670444, "o", "benchframes/bench.samples\r\nbin/pcfold\r\nsymmill/Makefile\r\nsymmill/contract.md\r\nsymmill/fold/profile.json\r\nsymmill/fold/runtime\r\nsymmill/fold/runtime.symmap\r\nsymmill/mk/foldlink.dep\r\nsymmill/ops/pipeline.map\r\nsymmill/scripts/seed_samples.sh\r\nsymmill/src/core.c\r\nsymmill/src/core.o\r\nsymmill/src/dispatch_ring.c\r\nsymmill/src/dispatch_ring.o\r\nsymmill/src/worker.c\r\nsymmill/src/worker.o\r\n"]
[10.674275, "o", "--- contract ---\r\n"]
[10.676398, "o", "Fold pipeline bench notes. Source changes under `/app/symmill` and `/app/pcfold` are required before `emitmap` succeeds.\r\n\r\n`emitmap` must leave linked symmap + profile aligned with bench.samples PCs. Manual or hand-written symmap/profile files are insufficient; the normal `make -C /app/symmill emitmap` pipeline must regenerate them.\r\n\r\nSymmap header is `PCFOLD1` with `mode` set to `linked`, string `buildid`, an `origin pcfold-index-linked` line from `pcfold index --linked`, and `sym` rows. Hand-built symmaps lack that origin line. The symmap must contain at least 8 `sym` rows. Each `sym` row lists name, start address, and span size in hex. Span sizes must match `nm -n --defined-only` ordering on `/app/symmill/fold/runtime` (each symbol ends where the next text symbol begins; the last symbol uses a 64-byte span). Linked symmaps must not keep uniform `0x40` placeholder spans from object-index generation.\r\n\r\nRuntime `buildid` in the symmap must be at least 8 hex characters and match the `Build ID:` from `readelf -n /app/symmill/fold/runtime`. Bench anchor stamp `/app/benchframes/anchor/buildid.stamp` mirrors that value after a correct emitmap.\r\n\r\n`/app/pcfold/conf/latch.env` must keep `FOLD_LATCH on` so `/app/bin/pcfold check` enforces symmap identity. `/app/bin/pcfold check <runtime> <symmap>` must exit non-zero when the symmap buildid drifts from the runtime ELF and must exit zero for the on-disk pair after repair.\r\n\r\nThe `/app/symmill/Makefile` `emitmap` target must run `$(PCFOLD) check $(TARGET) $(SYMAP)` after profile render.\r\n\r\n`/app/symmill/mk/foldlink.dep` must list `$(SYMAP): $(TARGET)` and invoke `pcfold index --linked $(TARGET)`; object-file symmap rules are invalid on this image.\r\n\r\nThe verifier reruns `/opt/verifier/bin/pcfold-grade render` on held-out sample files without invoking `emitmap`.\r\n\r\nProfile `frames` are a JSON array of objects with string `pc`, string `symbol`, and integer `offset`.\r\n\r\nBench anchor symbol addresses live in `/app/benchframes/anchor/symbols.tab`.\r\n"]
[10.677275, "o", "--- pipeline ---\r\n"]
[10.680735, "o", "# fold pipeline scope\r\nfoldlink.dep\r\nemitmap.gate\r\nlatch.channel\r\nparity.gate\r\n"]
[10.681515, "o", "--- Makefile ---\r\n"]
[10.683898, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -fPIC\r\nLDFLAGS ?= -Wl,--build-id\r\nSRC := src/core.c src/worker.c src/dispatch_ring.c\r\nOBJS := $(SRC:.c=.o)\r\n"]
[10.68394, "o", "TARGET := fold/runtime\r\nSYMAP := fold/runtime.symmap\r\nPROFILE := fold/profile.json\r\nPCFOLD := /app/bin/pcfold\r\nSAMPLES := /app/benchframes/bench.samples\r\n\r\ninclude mk/foldlink.dep\r\n\r\n.PHONY: emitmap clean hull\r\n"]
[10.683957, "o", "\r\nhull: $(TARGET)\r\n"]
[10.68415, "o", "\r\nemitmap: $(PROFILE)\r\n\t@:\r\n\r\n$(TARGET): $(OBJS)\r\n\t@mkdir -p fold\r\n\t$(CC) $(LDFLAGS) -o $@ $(OBJS)\r\n\r\n$(PROFILE): $(SYMAP) $(SAMPLES)\r\n\t$(PCFOLD) render $(SAMPLES) $(SYMAP) -o $(PROFILE)\r\n\r\nclean:\r\n\trm -f $(OBJS) $(TARGET) $(SYMAP) $(PROFILE)\r\n\r\nsrc/%.o: src/%.c\r\n\t$(CC) $(CFLAGS) -c -o $@ $<\r\n"]
[10.685718, "o", "--- samples ---\r\n"]
[10.688069, "o", "pc 0x401168\r\npc 0x401144\r\n"]
[10.688568, "o", "--- current symmap ---\r\n"]
[10.690236, "o", "PCFOLD1\r\nmode objects\r\nbuildid object-merge\r\nsym main 0x1000 0x40\r\nsym runtime_entry 0x1040 0x40\r\nsym legacy_worker 0x1400 0x40\r\nsym ring_dispatch 0x1600 0x40\r\n"]
[10.690842, "o", "\u001b[?2004hroot@96396d42ed63:/app# "]
[11.565494, "i", "printf '%s\\n' '--- source inventory/content ---'; find /app/symmill /app/bin -type f \\( -name '*.c' -o -name '*.h' -o -name '*.cc' -o -name '*.cpp' -o -name '*.py' -o -name '*.sh' -o -name '*.rs' -o -name '*.go' \\) -print -exec sh -c 'echo === \"$1\"; sed -n \"1,260p\" \"$1\"' _ {} \\;\n"]
[11.566524, "o", "printf '%s\\n' '--- source inventory/content ---'; find /app/symmill /app/bin -type f \\( -name '*.c' -o -name '*.h' -o -name '*.cc' -o -name '*.cpp' -o -name '*.py' -o -name '*.sh' -o -name '*.rs' -o -name '*.go' \\) -print -exec sh -c 'echo === \"$1\"; sed -n \"1,260p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[11.567021, "o", "--- source inventory/content ---\r\n"]
[11.569353, "o", "/app/symmill/src/dispatch_ring.c\r\n"]
[11.570312, "o", "=== /app/symmill/src/dispatch_ring.c\r\n"]
[11.571385, "o", "#include <stdint.h>\r\n\r\nuint32_t ring_dispatch(uint32_t lane)\r\n{\r\n    return (lane * 0x9E3779B1U) ^ 0xC3U;\r\n}\r\n"]
[11.571734, "o", "/app/symmill/src/worker.c\r\n"]
[11.57254, "o", "=== /app/symmill/src/worker.c\r\n"]
[11.573766, "o", "#include <stdint.h>\r\n\r\nuint32_t ring_dispatch(uint32_t lane);\r\n\r\nuint32_t legacy_worker(uint32_t seed)\r\n{\r\n    uint32_t lane = (seed ^ 0xA5A5A5A5U) & 0xFFU;\r\n    return ring_dispatch(lane) + seed;\r\n}\r\n"]
[11.574523, "o", "/app/symmill/src/core.c\r\n"]
[11.577464, "o", "=== /app/symmill/src/core.c\r\n"]
[11.579078, "o", "#include <stdint.h>\r\n\r\nuint32_t legacy_worker(uint32_t seed);\r\n\r\nint main(void)\r\n{\r\n    return (int)legacy_worker(0x11U);\r\n}\r\n\r\nint runtime_entry(uint32_t seed)\r\n{\r\n    uint32_t base = legacy_worker(seed);\r\n    return base + 17U;\r\n}\r\n"]
[11.579502, "o", "/app/symmill/scripts/seed_samples.sh\r\n"]
[11.580289, "o", "=== /app/symmill/scripts/seed_samples.sh\r\n"]
[11.581391, "o", "#!/bin/bash\r\nset -euo pipefail\r\nmkdir -p /app/benchframes/anchor\r\nring=$(nm -n --defined-only /app/symmill/fold/runtime | awk '$3==\"ring_dispatch\"{print $1}')\r\nlegacy=$(nm -n --defined-only /app/symmill/fold/runtime | awk '$3==\"legacy_worker\"{print $1}')\r\nbuildid=$(readelf -n /app/symmill/fold/runtime | awk '/Build ID:/{print $3; exit}')\r\nprintf 'ring_dispatch 0x%s\\nlegacy_worker 0x%s\\n' \"$ring\" \"$legacy\" > /app/benchframes/anchor/symbols.tab\r\nprintf '%s\\n' \"$buildid\" > /app/benchframes/anchor/buildid.stamp\r\nprintf 'pc 0x%x\\npc 0x%x\\n' $((16#$ring + 8)) $((16#$legacy + 4)) > /app/benchframes/bench.samples\r\n"]
[11.58232, "o", "\u001b[?2004hroot@96396d42ed63:/app# "]
[23.959076, "i", "cd /app && echo '--- pipeline modules and pcfold tree ---' && find symmill/ops symmill/mk pcfold -maxdepth 4 -type f -print 2>/dev/null | sort | while read f; do echo \"=== $f\"; sed -n '1,260p' \"$f\"; done; echo '--- executable ---'; file bin/pcfold; ls -l bin/pcfold; head -n 60 bin/pcfold 2>/dev/null; echo '--- usage probes ---'; /app/bin/pcfold 2>&1 || true; /app/bin/pcfold index --help 2>&1 || true; /app/bin/pcfold render --help 2>&1 || true; /app/bin/pcfold check --help 2>&1 || true\n"]
[23.960703, "o", "cd /app && echo '--- pipeline modules and pcfold tree ---' && find symmill/ops symmill/mk pcfold -maxdepth 4 -type f -print 2>/dev/null | sort | while read f; do echo \"=== $f\"; sed -n '1,260p' \"$f\"; done; echo '--- executable ---'; file bin/pcfold; ls -l bin/pcfold; head -n 60 bin/pcfold 2>/dev/null; echo '--- usage probes ---'; /app/bin/pcfold 2>&1 || true; /app/bin/pcfold index --help 2>&1 || true; /app/bin/pcfold render --help 2>&1 || true; /app/bin/pcfold check --help 2>&1 || true\r\n\u001b[?2004l\r"]
[23.960855, "o", "--- pipeline modules and pcfold tree ---\r\n"]
[23.96309, "o", "=== pcfold/Makefile\r\n"]
[23.964492, "o", "CC ?= gcc\r\nCFLAGS ?= -O2 -Wall -Wextra -Iinclude\r\nSRC := src/main.c src/index.c src/parity.c src/render.c src/elfutil.c\r\nBIN := /app/bin/pcfold\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin\r\n\t$(CC) $(CFLAGS) -o $(BIN) $(SRC)\r\n"]
[23.964749, "o", "=== pcfold/NOTES\r\n"]
[23.965979, "o", "pcfold index/render/check tool sources.\r\n"]
[23.966214, "o", "=== pcfold/conf/index.mode\r\n"]
[23.967442, "o", "index_mode=objects\r\n"]
[23.967723, "o", "=== pcfold/conf/latch.env\r\n"]
[23.968873, "o", "FOLD_LATCH off\r\n"]
[23.969063, "o", "=== pcfold/include/pcfold.h\r\n"]
[23.970165, "o", "#ifndef PCFOLD_H\r\n#define PCFOLD_H\r\n\r\n#include <stddef.h>\r\n\r\n#define SF_MAGIC \"PCFOLD1\"\r\n\r\ntypedef struct {\r\n    char name[128];\r\n    unsigned long start;\r\n"]
[23.970259, "o", "    unsigned long size;\r\n} sf_sym_t;\r\n\r\nint sf_read_build_id(const char *elf_path, char *out, size_t out_len);\r\nint sf_index_linked(const char *elf_path, const char *out_path);\r\nint sf_index_objects(const char **obj_paths, int obj_count, const char *out_path);\r\nint sf_check(const char *elf_path, const char *symmap_path);\r\nint sf_render(const char *samples_path, const char *symmap_path, const char *out_path);\r\n\r\n#endif\r\n"]
[23.970461, "o", "=== pcfold/src/elfutil.c\r\n"]
[23.971529, "o", "#include \"pcfold.h\"\r\n\r\n#include <ctype.h>\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic int hex_nibble(char c)\r\n{\r\n    if (c >= '0' && c <= '9') {\r\n        return c - '0';\r\n    }\r\n"]
[23.97166, "o", "    if (c >= 'a' && c <= 'f') {\r\n        return 10 + (c - 'a');\r\n    }\r\n    if (c >= 'A' && c <= 'F') {\r\n        return 10 + (c - 'A');\r\n    }\r\n    return -1;\r\n}\r\n\r\nint sf_read_build_id(const char *elf_path, char *out, size_t out_len)\r\n{\r\n    char cmd[512];\r\n    snprintf(cmd, sizeof(cmd), \"readelf -n '%s' 2>/dev/null\", elf_path);\r\n    FILE *fp = popen(cmd, \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    char line[512];\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        char *p = strstr(line, \"Build ID:\");\r\n        if (!p) {\r\n            continue;\r\n        }\r\n        p += 9;\r\n        while (*p && isspace((unsigned char)*p)) {\r\n            p++;\r\n        }\r\n        size_t n = 0;\r\n        while (p[n] && !isspace((unsigned char)p[n]) && n + 1 < out_len) {\r\n            out[n] = p[n];\r\n            n++;\r\n        }\r\n        out[n] = '\\0';\r\n        pclose(fp);\r\n        return n > 0 ? 0 : -1;\r\n    }\r\n    pclose(fp);\r\n    return -1;\r\n}\r\n\r\nint sf_collect_elf_symbols(const char *elf_path, sf_sym_t **out_syms, int *out_count)\r\n{\r\n    char cmd[512];\r\n    snprintf(cmd, sizeof(cmd), \"nm -n --defined-only '%s' 2>/dev/null\", elf_path);\r\n    FILE *fp = popen(cmd, \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    sf_sym_t *buf = NULL;\r\n    int cap = 0;\r\n    int count = 0;\r\n"]
[23.971762, "o", "    char line[512];\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        unsigned long addr = 0;\r\n        char type = 0;\r\n        char name[128] = {0};\r\n        if (sscanf(line, \"%lx %c %127s\", &addr, &type, name) != 3) {\r\n            continue;\r\n        }\r\n        if (type != 'T' && type != 't') {\r\n            continue;\r\n        }\r\n        if (count >= cap) {\r\n            cap = cap ? cap * 2 : 32;\r\n            sf_sym_t *next = realloc(buf, (size_t)cap * sizeof(sf_sym_t));\r\n            if (!next) {\r\n                free(buf);\r\n                pclose(fp);\r\n                return -1;\r\n            }\r\n            buf = next;\r\n        }\r\n        strncpy(buf[count].name, name, sizeof(buf[count].name) - 1);\r\n        buf[count].start = addr;\r\n        buf[count].size = 0;\r\n        count++;\r\n    }\r\n    pclose(fp);\r\n    for (int i = 0; i < count; i++) {\r\n        unsigned long end = (i + 1 < count) ? buf[i + 1].start : buf[i].start + 64;\r\n        if (end > buf[i].start) {\r\n            buf[i].size = end - buf[i].start;\r\n        } else {\r\n            buf[i].size = 64;\r\n        }\r\n    }\r\n    *out_syms = buf;\r\n    *out_count = count;\r\n    return 0;\r\n}\r\n"]
[23.971978, "o", "=== pcfold/src/index.c\r\n"]
[23.973087, "o", "#include \"pcfold.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nextern int sf_collect_elf_symbols(const char *elf_path, sf_sym_t **out_syms, int *out_count);\r\n\r\nstatic int write_symmap(\r\n    const char *out_path,\r\n    const char *mode,\r\n    const char *build_id,\r\n    const char *origin,\r\n    sf_sym_t *syms,\r\n    int count)\r\n{\r\n    FILE *fp = fopen(out_path, \"w\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    fprintf(fp, \"%s\\n\", SF_MAGIC);\r\n    fprintf(fp, \"mode %s\\n\", mode);\r\n    fprintf(fp, \"buildid %s\\n\", build_id);\r\n    if (origin && origin[0] != '\\0') {\r\n        fprintf(fp, \"origin %s\\n\", origin);\r\n    }\r\n    for (int i = 0; i < count; i++) {\r\n        fprintf(fp, \"sym %s 0x%lx 0x%lx\\n\", syms[i].name, syms[i].start, syms[i].size);\r\n    }\r\n    fclose(fp);\r\n    return 0;\r\n}\r\n\r\n"]
[23.973218, "o", "int sf_index_linked(const char *elf_path, const char *out_path)\r\n{\r\n    char build_id[128] = {0};\r\n    if (sf_read_build_id(elf_path, build_id, sizeof(build_id)) != 0) {\r\n        strcpy(build_id, \"unknown\");\r\n    }\r\n    sf_sym_t *syms = NULL;\r\n    int count = 0;\r\n    if (sf_collect_elf_symbols(elf_path, &syms, &count) != 0 || count == 0) {\r\n        free(syms);\r\n        return -1;\r\n    }\r\n    int rc = write_symmap(out_path, \"linked\", build_id, \"pcfold-index-linked\", syms, count);\r\n    free(syms);\r\n    return rc;\r\n}\r\n\r\nstatic int collect_object_symbols(const char *obj_path, sf_sym_t **acc, int *acc_count)\r\n{\r\n    char cmd[512];\r\n    snprintf(cmd, sizeof(cmd), \"nm -n --defined-only '%s' 2>/dev/null\", obj_path);\r\n    FILE *fp = popen(cmd, \"r\");\r\n    if (!fp) {\r\n        return -1;\r\n    }\r\n    unsigned long cursor = 0x1000UL + (unsigned long)(*acc_count) * 0x200UL;\r\n    char line[512];\r\n    while (fgets(line, sizeof(line), fp)) {\r\n        unsigned long addr = 0;\r\n        char type = 0;\r\n        char name[128] = {0};\r\n        if (sscanf(line, \"%lx %c %127s\", &addr, &type, name) != 3\r\n            && sscanf(line, \" %c %127s\", &type, name) != 2) {\r\n            continue;\r\n        }\r\n        if (type != 'T' && type != 't') {\r\n            continue;\r\n        }\r\n        sf_sym_t *next = realloc(*acc, (size_t)(*acc_count + 1) * sizeof(sf_sym_t));\r\n        if (!next) {\r\n            pclose(fp);\r\n            return -1;\r\n        }\r\n        *acc = next;\r\n        strncpy((*acc)[*acc_count].name, name, sizeof((*acc)[*acc_count].name) - 1);\r\n        (*acc)[*acc_count].start = cursor;\r\n        (*acc)[*acc_count].size = 0x40;\r\n        cursor += 0x40;\r\n        (*acc_count)++;\r\n    }\r\n    pclose(fp);\r\n    return 0;\r\n}\r\n\r\nint sf_index_objects(const char **obj_paths, int obj_count, const char *out_path)\r\n{\r\n    sf_sym_t *syms = NULL;\r\n"]
[23.973319, "o", "    int count = 0;\r\n    for (int i = 0; i < obj_count; i++) {\r\n        if (collect_object_symbols(obj_paths[i], &syms, &count) != 0) {\r\n            free(syms);\r\n            return -1;\r\n        }\r\n    }\r\n    int rc = write_symmap(out_path, \"objects\", \"object-merge\", NULL, syms, count);\r\n    free(syms);\r\n    return rc;\r\n}\r\n"]
[23.973522, "o", "=== pcfold/src/main.c\r\n"]
[23.974597, "o", "#include \"pcfold.h\"\r\n\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\n\r\nstatic int usage(const char *argv0)\r\n{\r\n"]
[23.974715, "o", "    fprintf(stderr, \"usage: %s index --linked <elf> -o <symmap>\\n\", argv0);\r\n    fprintf(stderr, \"       %s index --objects <o>... -o <symmap>\\n\", argv0);\r\n    fprintf(stderr, \"       %s check <elf> <symmap>\\n\", argv0);\r\n    fprintf(stderr, \"       %s render <samples> <symmap> -o <profile>\\n\", argv0);\r\n    return 1;\r\n}\r\n\r\nint main(int argc, char **argv)\r\n{\r\n    if (argc < 2) {\r\n        return usage(argv[0]);\r\n    }\r\n    if (strcmp(argv[1], \"index\") == 0) {\r\n        const char *out = NULL;\r\n        if (argc >= 4 && strcmp(argv[2], \"--linked\") == 0) {\r\n            for (int i = 4; i < argc; i++) {\r\n                if (strcmp(argv[i], \"-o\") == 0 && i + 1 < argc) {\r\n                    out = argv[i + 1];\r\n                }\r\n            }\r\n            if (!out) {\r\n                return usage(argv[0]);\r\n            }\r\n            return sf_index_linked(argv[3], out) == 0 ? 0 : 1;\r\n        }\r\n        if (argc >= 4 && strcmp(argv[2], \"--objects\") == 0) {\r\n            const char **objs = NULL;\r\n            int obj_count = 0;\r\n            for (int i = 3; i < argc; i++) {\r\n                if (strcmp(argv[i], \"-o\") == 0) {\r\n                    out = argv[i + 1];\r\n                    break;\r\n                }\r\n                obj_count++;\r\n            }\r\n            if (!out || obj_count == 0) {\r\n                return usage(argv[0]);\r\n            }\r\n            objs = calloc((size_t)obj_count, sizeof(char *));\r\n"]
[23.974806, "o", "            int idx = 0;\r\n            for (int i = 3; i < argc; i++) {\r\n                if (strcmp(argv[i], \"-o\") == 0) {\r\n                    break;\r\n                }\r\n                objs[idx++] = argv[i];\r\n            }\r\n            int rc = sf_index_objects(objs, obj_count, out);\r\n            free(objs);\r\n"]
[23.974902, "o", "            return rc == 0 ? 0 : 1;\r\n        }\r\n        return usage(argv[0]);\r\n    }\r\n    if (strcmp(argv[1], \"check\") == 0 && argc == 4) {\r\n        return sf_check(argv[2], argv[3]);\r\n    }\r\n    if (strcmp(argv[1], \"render\") == 0 && argc >= 5) {\r\n        const char *out = NULL;\r\n        for (int i = 4; i < argc; i++) {\r\n            if (strcmp(argv[i], \"-o\") == 0 && i + 1 < argc) {\r\n                out = argv[i + 1];\r\n            }\r\n        }\r\n        if (!out) {\r\n            return usage(argv[0]);\r\n        }\r\n        return sf_render(argv[2], argv[3], out) == 0 ? 0 : 1;\r\n    }\r\n    return usage(argv[0]);\r\n}\r\n"]
