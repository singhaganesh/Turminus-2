[34.497691, "o", "\tint sf_index_linked(const char *elf_path, const char *out_path)\r\n    35\t{\r\n    36\t    char build_id[128] = {0};\r\n    37\t    if (sf_read_build_id(elf_path, build_id, sizeof(build_id)) != 0) {\r\n    38\t        strcpy(build_id, \"unknown\");\r\n    39\t    }\r\n    40\t    sf_sym_t *syms = NULL;\r\n    41\t    int count = 0;\r\n    42\t    if (sf_collect_elf_symbols(elf_path, &syms, &count) != 0 || count == 0) {\r\n    43\t        free(syms);\r\n    44\t        return -1;\r\n    45\t    }\r\n    46\t    int rc = write_symmap(out_path, \"linked\", build_id, \"pcfold-index-linked\", syms, count);\r\n    47\t    free(syms);\r\n    48\t    return rc;\r\n    49\t}\r\n    50\t\r\n    51\tstatic int collect_object_symbols(const char *obj_path, sf_sym_t **acc, int *acc_count)\r\n    52\t{\r\n    53\t    char cmd[512];\r\n    54\t    snprintf(cmd, sizeof(cmd), \"nm -n --defined-only '%s' 2>/dev/null\", obj_path);\r\n    55\t    FILE *fp = popen(cmd, \"r\");\r\n    56\t    if (!fp) {\r\n    57\t        return -1;\r\n    58\t    }\r\n    59\t    unsigned long cursor = 0x1000UL + (unsigned long)(*acc_count) * 0x200UL;\r\n    60\t    char line[512];\r\n    61\t    while (fgets(line, sizeof(line), fp)) {\r\n    62\t        unsigned long addr = 0;\r\n    63\t        char type = 0;\r\n    64\t        char name[128] = {0};\r\n    65\t        if (sscanf(line, \"%lx %c %127s\", &addr, &type, name) != 3\r\n    66\t            && sscanf(line, \" %c %127s\", &type, name) != 2) {\r\n    67\t            continue;\r\n    68\t        }\r\n    69\t        if (type != 'T' && type != 't') {\r\n    70\t            continue;\r\n    71\t        }\r\n    72\t        sf_sym_t *next = realloc(*acc, (size_t)(*acc_count + 1) * sizeof(sf_sym_t));\r\n    73\t        if (!next) {\r\n    74\t            pclose(fp);\r\n    75\t            return -1;\r\n    76\t        }\r\n    77\t        *acc = next;\r\n    78\t        strncpy((*acc)[*acc_count].name, name, sizeof((*acc)[*acc_count].name) - 1);\r\n    79\t        (*acc)[*acc_count].start = cursor;\r\n    80\t        (*acc)[*acc_count].size = 0x40;\r\n    81\t        cursor += 0x40;\r\n    82\t        (*acc_count)++;\r\n    83\t    }\r\n    84\t    pclose(fp);\r\n    85\t    return 0;\r\n    86\t}\r\n    87\t\r\n    88\tint sf_index_objects(const char **obj_paths, int obj_count, const char *out_path)\r\n    89\t{\r\n    90\t    sf_sym_t *syms = NULL;\r\n    91\t    int count = 0;\r\n"]
