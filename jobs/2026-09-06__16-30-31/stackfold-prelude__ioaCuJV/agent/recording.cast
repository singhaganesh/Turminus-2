[34.499364, "o", "    22\t\r\n    23\tstatic int load_map(const char *path, sf_map_t *map)\r\n    24\t{\r\n    25\t    memset(map, 0, sizeof(*map));\r\n    26\t    FILE *fp = fopen(path, \"r\");\r\n    27\t    if (!fp) {\r\n    28\t        return -1;\r\n    29\t    }\r\n    30\t    char line[512];\r\n    31\t    if (!fgets(line, sizeof(line), fp) || strncmp(line, SF_MAGIC, strlen(SF_MAGIC)) != 0) {\r\n    32\t        fclose(fp);\r\n    33\t        return -1;\r\n    34\t    }\r\n    35\t    while (fgets(line, sizeof(line), fp)) {\r\n    36\t        if (strncmp(line, \"mode \", 5) == 0) {\r\n    37\t            sscanf(line, \"mode %31s\", map->mode);\r\n    38\t        } else if (strncmp(line, \"buildid \", 8) == 0) {\r\n    39\t            sscanf(line, \"buildid %127s\", map->build_id);\r\n    40\t        } else if (strncmp(line, \"sym \", 4) == 0) {\r\n    41\t            sf_sym_t sym = {0};\r\n    42\t            unsigned long start = 0;\r\n    43\t            unsigned long size = 0;\r\n    44\t            if (sscanf(line, \"sym %127s 0x%lx 0x%lx\", sym.name, &start, &size) == 3) {\r\n    45\t                sym.start = start;\r\n    46\t                sym.size = size;\r\n    47\t                sf_sym_t *next =\r\n    48\t                    realloc(map->syms, (size_t)(map->count + 1) * sizeof(sf_sym_t));\r\n    49\t                if (!next) {\r\n    50\t                    fclose(fp);\r\n    51\t                    free_map(map);\r\n    52\t                    return -1;\r\n    53\t                }\r\n    54\t                map->syms = next;\r\n    55\t                map->syms[map->count++] = sym;\r\n    56\t            }\r\n"]
[34.499506, "o", "    57\t        }\r\n    58\t    }\r\n    59\t    fclose(fp);\r\n    60\t    return map->count > 0 ? 0 : -1;\r\n    61\t}\r\n    62\t\r\n    63\tstatic int sym_in_map(const sf_map_t *map, const char *name)\r\n    64\t{\r\n    65\t    for (int i = 0; i < map->count; i++) {\r\n    66\t        if (strcmp(map->syms[i].name, name) == 0) {\r\n    67\t            return 1;\r\n    68\t        }\r\n    69\t    }\r\n    70\t    return 0;\r\n    71\t}\r\n    72\t\r\n    73\tstatic int guard_allows_bypass(void)\r\n    74\t{\r\n    75\t    FILE *fp = fopen(\"/app/pcfold/conf/latch.env\", \"r\");\r\n    76\t    if (!fp) {\r\n    77\t        return 0;\r\n    78\t    }\r\n    79\t    char line[128];\r\n    80\t    while (fgets(line, sizeof(line), fp)) {\r\n    81\t        char key[64] = {0};\r\n    82\t        char val[64] = {0};\r\n    83\t        if (sscanf(line, \"%63s %63s\", key, val) == 2 && strcmp(key, \"FOLD_LATCH\") == 0) {\r\n    84\t            fclose(fp);\r\n"]
[34.499648, "o", "    85\t            return strcmp(val, \"off\") == 0;\r\n    86\t        }\r\n    87\t    }\r\n    88\t    fclose(fp);\r\n    89\t    return 0;\r\n    90\t}\r\n    91\t\r\n    92\tint sf_check(const char *elf_path, const char *symmap_path)\r\n    93\t{\r\n    94\t    if (guard_allows_bypass()) {\r\n    95\t        return 0;\r\n    96\t    }\r\n    97\t    sf_map_t map;\r\n    98\t    if (load_map(symmap_path, &map) != 0) {\r\n    99\t        return 1;\r\n   100\t    }\r\n   101\t    if (strcmp(map.mode, \"linked\") != 0) {\r\n   102\t        free_map(&map);\r\n   103\t        return 1;\r\n   104\t    }\r\n   105\t    char live_id[128] = {0};\r\n   106\t    if (sf_read_build_id(elf_path, live_id, sizeof(live_id)) != 0) {\r\n   107\t        free_map(&map);\r\n   108\t        return 1;\r\n   109\t    }\r\n   110\t    if (strcmp(map.build_id, live_id) != 0) {\r\n   111\t        free_map(&map);\r\n   112\t        return 1;\r\n   113\t    }\r\n   114\t    sf_sym_t *elf_syms = NULL;\r\n   115\t    int elf_count = 0;\r\n   116\t    if (sf_collect_elf_symbols(elf_path, &elf_syms, &elf_count) != 0) {\r\n   117\t        free_map(&map);\r\n   118\t        return 1;\r\n   119\t    }\r\n   120\t    for (int i = 0; i < elf_count; i++) {\r\n   121\t        if (!sym_in_map(&map, elf_syms[i].name)) {\r\n   122\t            free(elf_syms);\r\n   123\t            free_map(&map);\r\n   124\t            return 1;\r\n   125\t        }\r\n   126\t    }\r\n   127\t    free(elf_syms);\r\n   128\t    free_map(&map);\r\n   129\t    return 0;\r\n   130\t}\r\n"]
