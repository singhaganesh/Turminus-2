[81.333371, "i", "cd /app && set -e\ncp symmill/fold/runtime.symmap /tmp/runtime.bad.symmap\nsed -i 's/^buildid .*/buildid deadbeef/' /tmp/runtime.bad.symmap\nif /app/bin/pcfold check symmill/fold/runtime /tmp/runtime.bad.symmap; then echo 'ERROR: drift accepted'; exit 1; else echo 'drift correctly rejected'; fi\nprintf 'pc 0x401168\\npc 0x401144\\npc 0x500000\\n' >/tmp/held.samples\n/app/bin/pcfold render /tmp/held.samples symmill/fold/runtime.symmap -o /tmp/held.json\ncat /tmp/held.json\npython3 - <<'PY'\nimport json\np=json.load(open('/app/symmill/fold/profile.json'))\nassert p['frames'] == [\n {'pc':'0x401168','symbol':'ring_dispatch','offset':8},\n {'pc':'0x401144','symbol':'legacy_worker','offset':4},\n], p\nh=json.load(open('/tmp/held.json'))\nassert len(h['frames']) == 2 and all(f['pc'] != '0x500000' for f in h['frames']), h\nprint('profile and bounded resolution validated')\nPY\nmake -C /app/symmill emitmap\n"]
