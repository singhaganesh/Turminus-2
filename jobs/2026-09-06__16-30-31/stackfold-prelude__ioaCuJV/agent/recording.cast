[76.473094, "o", "        if (!sym_in_map(&map, elf_syms[i].name)) {\r\n\u001b[?2004l\r\u001b[?2004h>             free(elf_syms);\r\n\u001b[?2004l\r\u001b[?2004h>             free_map(&map);\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
