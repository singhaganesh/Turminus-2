     7	extern int sf_collect_elf_symbols(const char *elf_path, sf_sym_t **out_syms, int *out_count);
     8	
     9	static int write_symmap(
    10	    const char *out_path,
    11	    const char *mode,
    12	    const char *build_id,
    13	    const char *origin,
    14	    sf_sym_t *syms,
    15	    int count)
    16	{
    17	    FILE *fp = fopen(out_path, "w");
    18	    if (!fp) {
    19	        return -1;
    20	    }
    21	    fprintf(fp, "%s\n", SF_MAGIC);
    22	    fprintf(fp, "mode %s\n", mode);
    23	    fprintf(fp, "buildid %s\n", build_id);
    24	    if (origin && origin[0] != '\0') {
    25	        fprintf(fp, "origin %s\n", origin);
    26	    }
    27	    for (int i = 0; i < count; i++) {
    28	        fprintf(fp, "sym %s 0x%lx 0x%lx\n", syms[i].name, syms[i].start, syms[i].size);
    29	    }
    30	    fclose(fp);
    31	    return 0;
    32	}
    33	
    34	int sf_index_linked(const char *elf_path, const char *out_path)
    35	{
    36	    char build_id[128] = {0};
    37	    if (sf_read_build_id(elf_path, build_id, sizeof(build_id)) != 0) {
    38	        strcpy(build_id, "unknown");
    39	    }
    40	    sf_sym_t *syms = NULL;
    41	    int count = 0;
    42	    if (sf_collect_elf_symbols(elf_path, &syms, &count) != 0 || count == 0) {
    43	        free(syms);
    44	        return -1;
    45	    }
    46	    int rc = write_symmap(out_path, "linked", build_id, "pcfold-index-linked", syms, count);
    47	    free(syms);
    48	    return rc;
    49	}
    50	
    51	static int collect_object_symbols(const char *obj_path, sf_sym_t **acc, int *acc_count)
    52	{
    53	    char cmd[512];
    54	    snprintf(cmd, sizeof(cmd), "nm -n --defined-only '%s' 2>/dev/null", obj_path);
    55	    FILE *fp = popen(cmd, "r");
    56	    if (!fp) {
    57	        return -1;
    58	    }
    59	    unsigned long cursor = 0x1000UL + (unsigned long)(*acc_count) * 0x200UL;
    60	    char line[512];
    61	    while (fgets(line, sizeof(line), fp)) {
    62	        unsigned long addr = 0;
    63	        char type = 0;
    64	        char name[128] = {0};
    65	        if (sscanf(line, "%lx %c %127s", &addr, &type, name) != 3
    66	            && sscanf(line, " %c %127s", &type, name) != 2) {
    67	            continue;
    68	        }
    69	        if (type != 'T' && type != 't') {
    70	            continue;
    71	        }
    72	        sf_sym_t *next = realloc(*acc, (size_t)(*acc_count + 1) * sizeof(sf_sym_t));
    73	        if (!next) {
    74	            pclose(fp);
    75	            return -1;
    76	        }
    77	        *acc = next;
    78	        strncpy((*acc)[*acc_count].name, name, sizeof((*acc)[*acc_count].name) - 1);
    79	        (*acc)[*acc_count].start = cursor;
    80	        (*acc)[*acc_count].size = 0x40;
    81	        cursor += 0x40;
    82	        (*acc_count)++;
    83	    }
    84	    pclose(fp);
    85	    return 0;
    86	}
    87	
    88	int sf_index_objects(const char **obj_paths, int obj_count, const char *out_path)
    89	{
    90	    sf_sym_t *syms = NULL;
    91	    int count = 0;
    92	    for (int i = 0; i < obj_count; i++) {
    93	        if (collect_object_symbols(obj_paths[i], &syms, &count) != 0) {
    94	            free(syms);
    95	            return -1;
    96	        }
    97	    }
    98	    int rc = write_symmap(out_path, "objects", "object-merge", NULL, syms, count);
    99	    free(syms);
   100	    return rc;
   101	}
