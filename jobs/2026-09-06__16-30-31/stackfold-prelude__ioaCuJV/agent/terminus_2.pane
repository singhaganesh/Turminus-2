    12	static int load_map_ro(const char *path, sf_map_ro_t *map)
    13	{
    14	    memset(map, 0, sizeof(*map));
    15	    FILE *fp = fopen(path, "r");
    16	    if (!fp) {
    17	        return -1;
    18	    }
    19	    char line[512];
    20	    if (!fgets(line, sizeof(line), fp) || strncmp(line, SF_MAGIC, strlen(SF_MAGIC)) != 0) {
    21	        fclose(fp);
    22	        return -1;
    23	    }
    24	    while (fgets(line, sizeof(line), fp)) {
    25	        if (strncmp(line, "sym ", 4) != 0) {
    26	            continue;
    27	        }
    28	        sf_sym_t sym = {0};
    29	        unsigned long start = 0;
    30	        unsigned long size = 0;
    31	        if (sscanf(line, "sym %127s 0x%lx 0x%lx", sym.name, &start, &size) != 3) {
    32	            continue;
    33	        }
    34	        sym.start = start;
    35	        sym.size = size;
    36	        sf_sym_t *next = realloc(map->syms, (size_t)(map->count + 1) * sizeof(sf_sym_t));
    37	        if (!next) {
    38	            fclose(fp);
    39	            free(map->syms);
    40	            return -1;
    41	        }
    42	        map->syms = next;
    43	        map->syms[map->count++] = sym;
    44	    }
    45	    fclose(fp);
    46	    return map->count > 0 ? 0 : -1;
    47	}
    48	
    49	static int resolve_pc(const sf_map_ro_t *map, unsigned long pc, char *sym_out, unsigned long *off_out)
    50	{
    51	    const sf_sym_t *best = NULL;
    52	    for (int i = 0; i < map->count; i++) {
    53	        const sf_sym_t *s = &map->syms[i];
    54	        if (pc >= s->start && pc < s->start + s->size) {
    55	            if (!best || s->start > best->start) {
    56	                best = s;
    57	            }
    58	        }
    59	    }
    60	    if (!best) {
    61	        for (int i = 0; i < map->count; i++) {
    62	            const sf_sym_t *s = &map->syms[i];
    63	            if (!best || s->start < best->start) {
    64	                best = s;
    65	            }
    66	        }
    67	    }
    68	    if (!best) {
    69	        return -1;
    70	    }
    71	    strncpy(sym_out, best->name, 127);
    72	    sym_out[127] = '\0';
    73	    *off_out = pc - best->start;
    74	    return 0;
    75	}
    76	
    77	int sf_render(const char *samples_path, const char *symmap_path, const char *out_path)
    78	{
    79	    sf_map_ro_t map;
    80	    if (load_map_ro(symmap_path, &map) != 0) {
    81	        return -1;
    82	    }
    83	    FILE *in = fopen(samples_path, "r");
    84	    if (!in) {
    85	        free(map.syms);
    86	        return -1;
    87	    }
    88	    FILE *out = fopen(out_path, "w");
    89	    if (!out) {
    90	        fclose(in);
    91	        free(map.syms);
    92	        return -1;
    93	    }
    94	    fprintf(out, "{\n  \"frames\": [\n");
    95	    char line[256];
    96	    int first = 1;
    97	    while (fgets(line, sizeof(line), in)) {
    98	        unsigned long pc = 0;
    99	        if (sscanf(line, "pc 0x%lx", &pc) != 1) {
   100	            continue;
   101	        }
   102	        char sym[128] = {0};
   103	        unsigned long off = 0;
   104	        if (resolve_pc(&map, pc, sym, &off) != 0) {
   105	            continue;
   106	        }
   107	        if (!first) {
   108	            fprintf(out, ",\n");
   109	        }
   110	        fprintf(out, "    {\"pc\": \"0x%lx\", \"symbol\": \"%s\", \"offset\": %lu}", pc, sym, off);
   111	        first = 0;
   112	    }
   113	    fprintf(out, "\n  ]\n}\n");
   114	    fclose(in);
   115	    fclose(out);
   116	    free(map.syms);
   117	    return 0;
   118	}
