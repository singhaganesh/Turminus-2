c::with_capacity(src.len());\n    let mut in_space = false;\n    for &b in src {\n        match b {\n            b\'\\t\' | b\'\\n\' | b\'\\r\' | b\' \' => {\n                if !in_space {\n                    out.push(b\' \');\n                    in_space = true;\n                }\n            }\n            0x00..=0x1f => {}\n            b\'A\'..=b\'Z\' => {\n                out.push(b + (b\'a\' - b\'A\'));\n                in_space = false;\n            }\n            _ => {\n                out.push(b);\n                in_space = false;\n            }\n        }\n    }\n    while out.last() == Some(&b\'/\') { out.pop(); }\n    out\n}\n\nfn json_string(bytes: &[u8]) -> String {\n    let text = String::from_utf8_lossy(bytes);\n    let mut out = String::from("\\"");\n    for c in text.chars() {\n        match c {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if (c as u32) < 0x20 => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            _ => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn write_card(slot: &str, text: &[u8], kind: &str) -> Result<(), i32> {\n    fs::create_dir_all("/app/inkvat").map_err(|_| 1)?;\n    let body = format!(\n        "{{\\"slot\\":{},\\"text\\":{},\\"kind\\":{}}}\\n",\n        json_string(slot.as_bytes()), json_string(text), json_string(kind.as_bytes())\n    );\n    fs::write("/app/inkvat/card.json", body).map_err(|_| 1)\n}\n\npub fn qat(dump: &str, slot: Option<&str>) -> i32 {\n    let _ = fs::remove_file("/app/inkvat/SEAL");\n    let blob = match fs::read(dump) {\n        Ok(v) if !v.is_empty() => v,\n        _ => return 1,\n    };\n    let rules = match rules() { Ok(v) => v, Err(c) => return c };\n    if let Some(s) = slot {\n        if s != rules.current && s != rules.compat { return 1; }\n    }\n