[99.815638, "i", "cat > /app/vatrib/qat.rs <<'EOF'\nuse std::fs;\nuse std::os::raw::{c_char, c_int, c_void};\n\nconst RTLD_NOW: c_int = 2;\n\nextern \"C\" {\n    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\n    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\n    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\n}\n\ntype FoldFn = unsafe extern \"C\" fn(*const u8, usize, *mut u8, usize) -> isize;\n\nstruct Rules {\n    current: String,\n    compat: String,\n    sip_kind: String,\n    mark_kind: String,\n}\n\nfn rules() -> Result<Rules, i32> {\n    let raw = fs::read_to_string(\"/app/abifolio/RULES.txt\").map_err(|_| 1)?;\n    let mut r = Rules {\n        current: String::new(),\n        compat: String::new(),\n        sip_kind: String::new(),\n        mark_kind: String::new(),\n    };\n    for line in raw.lines() {\n        if let Some(v) = line.strip_prefix(\"current slot:\") { r.current = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix(\"compat slot:\") { r.compat = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix(\"sip kind:\") { r.sip_kind = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix(\"mark kind:\") { r.mark_kind = v.trim().to_string(); }\n    }\n    if r.current.is_empty() || r.compat.is_empty() || r.sip_kind.is_empty() || r.mark_kind.is_empty() {\n        return Err(1);\n    }\n    Ok(r)\n}\n\nfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\n    if ptr.is_null() { return Err(1); }\n    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\n    let mut out = vec![0u8; blob.len() + 32];\n    let n = unsafe { f(blob.as_ptr(), blob.len(), out.as_mut_ptr(), out.len()) };\n    if n < 0 || n as usize > out.len() { return Err(1); }\n    out.truncate(n as usize);\n    Ok(out)\n}\n\n/* Finish the reworked fold after sip's deliberately unversioned ABI call. */\nfn full_fold(src: &[u8]) -> Vec<u8> {\n    let mut out = Vec::with_capacity(src.len());\n    let mut in_space = false;\n    for &b in src {\n        match b {\n            b'\\t' | b'\\n' | b'\\r' | b' ' => {\n                if !in_space {\n                    out.push(b' ');\n                    in_space = true;\n                }\n            }\n            0x00..=0x1f => {}\n            b'A'..=b'Z' => {\n                out.push(b + (b'a' - b'A'));\n                in_space = false;\n            }\n            _ => {\n                out.push(b);\n                in_space = false;\n            }\n        }\n    }\n    while out.last() == Some(&b'/') { out.pop(); }\n    out\n}\n\nfn json_string(bytes: &[u8]) -> String {\n    let text = String::from_utf8_lossy(bytes);\n    let mut out = String::from(\"\\\"\");\n    for c in text.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if (c as u32) < 0x20 => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            _ => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\nfn write_card(slot: &str, text: &[u8], kind: &str) -> Result<(), i32> {\n    fs::create_dir_all(\"/app/inkvat\").map_err(|_| 1)?;\n    let body = format!(\n        \"{{\\\"slot\\\":{},\\\"text\\\":{},\\\"kind\\\":{}}}\\n\",\n        json_string(slot.as_bytes()), json_string(text), json_string(kind.as_bytes())\n    );\n    fs::write(\"/app/inkvat/card.json\", body).map_err(|_| 1)\n}\n\npub fn qat(dump: &str, slot: Option<&str>) -> i32 {\n    let _ = fs::remove_file(\"/app/inkvat/SEAL\");\n    let blob = match fs::read(dump) {\n        Ok(v) if !v.is_empty() => v,\n        _ => return 1,\n    };\n    let rules = match rules() { Ok(v) => v, Err(c) => return c };\n    if let Some(s) = slot {\n        if s != rules.current && s != rules.compat { return 1; }\n    }\n\n    let handle = unsafe { dlopen(b\"/app/lib/libdraught.so\\0\".as_ptr() as *const c_char, RTLD_NOW) };\n    if handle.is_null() { return 1; }\n    let ptr = unsafe {\n        match slot {\n            None => dlsym(handle, b\"fold_frame\\0\".as_ptr() as *const c_char),\n            Some(s) => {\n     "]
[99.815713, "i", "           let mut version = s.as_bytes().to_vec();\n                version.push(0);\n                dlvsym(handle, b\"fold_frame\\0\".as_ptr() as *const c_char,\n                       version.as_ptr() as *const c_char)\n            }\n        }\n    };\n    let folded = match call(ptr, &blob) { Ok(v) => v, Err(c) => return c };\n    let (card_slot, kind, text) = match slot {\n        None => (rules.current.as_str(), rules.sip_kind.as_str(), full_fold(&folded)),\n        Some(s) => (s, rules.mark_kind.as_str(), folded),\n    };\n    if write_card(card_slot, &text, kind).is_err() { return 1; }\n    if fs::write(\"/app/inkvat/SEAL\", \"ok\").is_err() { return 1; }\n    0\n}\nEOF\n\ncat > /app/cliurn/boot.rs <<'EOF'\n#[path = \"../vatrib/qat.rs\"]\nmod qat;\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let status = match args.as_slice() {\n        [_, cmd, dump] if cmd == \"sip\" => qat::qat(dump, None),\n        [_, cmd, dump, slot] if cmd == \"mark\" => qat::qat(dump, Some(slot)),\n        _ => {\n            eprintln!(\"usage: draughtpin sip DUMP | draughtpin mark DUMP SLOT\");\n            2\n        }\n    };\n    std::process::exit(status);\n}\nEOF\n\ncat > /app/narbay/loom.rs <<'EOF'\nuse std::fs;\n\nfn slots() -> Result<(String, String), i32> {\n    let raw = fs::read_to_string(\"/app/abifolio/RULES.txt\").map_err(|_| 1)?;\n    let mut current = String::new();\n    let mut compat = String::new();\n    for line in raw.lines() {\n        if let Some(v) = line.strip_prefix(\"current slot:\") { current = v.trim().to_string(); }\n        if let Some(v) = line.strip_prefix(\"compat slot:\") { compat = v.trim().to_string(); }\n    }\n    if current.is_empty() || compat.is_empty() { return Err(1); }\n    Ok((current, compat))\n}\n\npub fn knit() -> String {\n    slots().map(|v| v.0).unwrap_or_default()\n}\n\npub fn weave(path: &str) -> Result<(), i32> {\n    let (current, compat) = slots()?;\n    let body = format!(\n        \"{compat} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\n{current} {{\\n  global:\\n    fold_frame;\\n}} {compat};\\n\"\n    );\n    fs::create_dir_all(\"/app/gnuverse\").map_err(|_| 1)?;\n    fs::write(path, body).map_err(|_| 1)\n}\nEOF\n/app/stoke.sh\n"]
