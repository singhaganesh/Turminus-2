[163.670984, "i", "python3 - <<'PY'\nimport ctypes\nlib=ctypes.CDLL('/app/lib/libdraught.so')\nlibdl=ctypes.CDLL('libdl.so.2')\nlibdl.dlvsym.argtypes=[ctypes.c_void_p,ctypes.c_char_p,ctypes.c_char_p]\nlibdl.dlvsym.restype=ctypes.c_void_p\nsig=ctypes.CFUNCTYPE(ctypes.c_ssize_t,ctypes.c_void_p,ctypes.c_size_t,ctypes.c_void_p,ctypes.c_size_t)\ndata=b'Foo\\t\\n\\r  Bar\\x01///'\ndef run(fn):\n    out=ctypes.create_string_buffer(128)\n    n=fn(data,len(data),out,128)\n    return out.raw[:n]\nlib.fold_frame.restype=ctypes.c_ssize_t\nlib.fold_frame.argtypes=[ctypes.c_void_p,ctypes.c_size_t,ctypes.c_void_p,ctypes.c_size_t]\nprint('unversioned=',repr(run(lib.fold_frame)))\nfor slot in (b'CASK_1',b'CASK_2'):\n    fn=sig(libdl.dlvsym(lib._handle,b'fold_frame',slot))\n    print(slot.decode()+'=',repr(run(fn)))\nPY\n"]
