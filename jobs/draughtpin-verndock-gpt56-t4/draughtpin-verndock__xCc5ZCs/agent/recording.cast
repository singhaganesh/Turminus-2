[99.826838, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.826941, "o", "            0x00..=0x1f => {}\r\n\u001b[?2004l\r"]
[99.827021, "o", "\u001b[?2004h>             b'A'..=b'Z' => {\r\n\u001b[?2004l\r"]
[99.827052, "o", "\u001b[?2004h> "]
[99.827166, "o", "                out.push(b + (b'a' - b'A'));\r\n\u001b[?2004l\r"]
[99.827269, "o", "\u001b[?2004h> "]
[99.827343, "o", "                in_space = false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.827431, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.827505, "o", "> "]
[99.827562, "o", "            _ => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.827619, "o", "                out.push(b);\r\n\u001b[?2004l\r"]
[99.827677, "o", "\u001b[?2004h"]
[99.827728, "o", "> "]
[99.827783, "o", "                in_space = false;\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.827839, "o", "> "]
[99.827894, "o", "            }\r\n\u001b[?2004l\r"]
[99.827945, "o", "\u001b[?2004h>         }\r\n"]
[99.827998, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[99.828051, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.828159, "o", "    while out.last() == Some(&b'/') { out.pop(); }\r\n\u001b[?2004l\r"]
[99.828229, "o", "\u001b[?2004h"]
[99.828285, "o", ">     out\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.828344, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[99.828397, "o", "> "]
[99.828475, "o", "fn json_string(bytes: &[u8]) -> String {\r\n\u001b[?2004l\r"]
[99.828537, "o", "\u001b[?2004h"]
[99.828593, "o", "> "]
[99.828649, "o", "    let text = String::from_utf8_lossy(bytes);\r\n\u001b[?2004l\r"]
[99.828705, "o", "\u001b[?2004h> "]
[99.828792, "o", "    let mut out = String::from(\"\\\"\");\r\n\u001b[?2004l\r"]
[99.828849, "o", "\u001b[?2004h> "]
[99.828906, "o", "    for c in text.chars() {\r\n\u001b[?2004l\r"]
[99.82897, "o", "\u001b[?2004h> "]
[99.829029, "o", "        match c {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.829142, "o", "            '\"' => out.push_str(\"\\\\\\\"\"),\r\n\u001b[?2004l\r"]
[99.82921, "o", "\u001b[?2004h> "]
[99.829295, "o", "            '\\\\' => out.push_str(\"\\\\\\\\\"),\r\n\u001b[?2004l\r"]
[99.829352, "o", "\u001b[?2004h"]
[99.829405, "o", "> "]
[99.829452, "o", "            '\\n' => out.push_str(\"\\\\n\"),\r\n\u001b[?2004l\r"]
[99.829508, "o", "\u001b[?2004h> "]
[99.829602, "o", "            '\\r' => out.push_str(\"\\\\r\"),\r\n\u001b[?2004l\r"]
[99.82966, "o", "\u001b[?2004h> "]
[99.829748, "o", "            '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r"]
[99.829807, "o", "\u001b[?2004h> "]
[99.829985, "o", "            c if (c as u32) < 0x20 => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n\u001b[?2004l\r"]
[99.830043, "o", "\u001b[?2004h"]
[99.830095, "o", "> "]
[99.830153, "o", "            _ => out.push(c),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.830223, "o", "        }\r\n\u001b[?2004l\r"]
[99.830272, "o", "\u001b[?2004h> "]
[99.830326, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.830467, "o", "    out.push('\"');\r\n\u001b[?2004l\r\u001b[?2004h>     out\r\n\u001b[?2004l\r"]
[99.83053, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.83059, "o", "\u001b[?2004h> "]
[99.830738, "o", "fn write_card(slot: &str, text: &[u8], kind: &str) -> Result<(), i32> {\r\n\u001b[?2004l\r"]
[99.830798, "o", "\u001b[?2004h"]
[99.830853, "o", "> "]
[99.83093, "o", "    fs::create_dir_all(\"/app/inkvat\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[99.830994, "o", "\u001b[?2004h> "]
[99.831065, "o", "    let body = format!(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.831217, "o", "        \"{{\\\"slot\\\":{},\\\"text\\\":{},\\\"kind\\\":{}}}\\n\",\r\n\u001b[?2004l\r"]
[99.831275, "o", "\u001b[?2004h> "]
[99.831454, "o", "        json_string(slot.as_bytes()), json_string(text), json_string(kind.as_bytes())\r\n\u001b[?2004l\r"]
[99.831513, "o", "\u001b[?2004h>     );\r\n\u001b[?2004l\r"]
[99.83157, "o", "\u001b[?2004h> "]
[99.831701, "o", "    fs::write(\"/app/inkvat/card.json\", body).map_err(|_| 1)\r\n\u001b[?2004l\r"]
[99.831762, "o", "\u001b[?2004h> "]
[99.831817, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.831871, "o", "\u001b[?2004h> "]
[99.831972, "o", "pub fn qat(dump: &str, slot: Option<&str>) -> i32 {\r\n\u001b[?2004l\r"]
[99.832029, "o", "\u001b[?2004h> "]
[99.832138, "o", "    let _ = fs::remove_file(\"/app/inkvat/SEAL\");\r\n\u001b[?2004l\r"]
[99.8322, "o", "\u001b[?2004h"]
[99.832256, "o", "> "]
[99.832314, "o", "    let blob = match fs::read(dump) {\r\n\u001b[?2004l\r"]
[99.832391, "o", "\u001b[?2004h> "]
[99.832454, "o", "        Ok(v) if !v.is_empty() => v,\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.832511, "o", ">         _ => return 1,\r\n\u001b[?2004l\r"]
[99.832571, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[99.832629, "o", "\u001b[?2004h> "]
[99.832782, "o", "    let rules = match rules() { Ok(v) => v, Err(c) => return c };\r\n\u001b[?2004l\r"]
[99.832871, "o", "\u001b[?2004h> "]
[99.832936, "o", "    if let Some(s) = slot {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.833116, "o", "        if s != rules.current && s != rules.compat { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.833207, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.833282, "o", "\u001b[?2004h> "]
[99.8335, "o", "    let handle = unsafe { dlopen(b\"/app/lib/libdraught.so\\0\".as_ptr() as *const c_char, RTLD_NOW) };\r\n\u001b[?2004l\r"]
[99.833578, "o", "\u001b[?2004h> "]
[99.833694, "o", "    if handle.is_null() { return 1; }\r\n\u001b[?2004l\r"]
[99.83378, "o", "\u001b[?2004h> "]
[99.833836, "o", "    let ptr = unsafe {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.833936, "o", "        match slot {\r\n\u001b[?2004l\r"]
[99.834006, "o", "\u001b[?2004h"]
[99.834106, "o", "> "]
[99.834218, "o", "            None => dlsym(handle, b\"fold_frame\\0\".as_ptr() as *const c_char),\r\n\u001b[?2004l\r"]
[99.834298, "o", "\u001b[?2004h> "]
[99.834331, "o", "            Some(s) => {\r\n\u001b[?2004l\r"]
[99.834367, "o", "\u001b[?2004h> "]
[99.834508, "o", "                let mut version = s.as_bytes().to_vec();\r\n\u001b[?2004l\r"]
[99.834572, "o", "\u001b[?2004h> "]
[99.83462, "o", "                version.push(0);\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.83468, "o", "> "]
[99.834797, "o", "                dlvsym(handle, b\"fold_frame\\0\".as_ptr() as *const c_char,\r\n\u001b[?2004l\r"]
[99.834858, "o", "\u001b[?2004h> "]
[99.834963, "o", "                       version.as_ptr() as *const c_char)\r\n\u001b[?2004l\r"]
[99.835023, "o", "\u001b[?2004h> "]
[99.835091, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.835174, "o", "        }\r\n\u001b[?2004l\r"]
[99.835252, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.83542, "o", "    let folded = match call(ptr, &blob) { Ok(v) => v, Err(c) => return c };\r\n\u001b[?2004l\r"]
[99.835481, "o", "\u001b[?2004h> "]
[99.835575, "o", "    let (card_slot, kind, text) = match slot {\r\n\u001b[?2004l\r"]
[99.835637, "o", "\u001b[?2004h> "]
[99.835816, "o", "        None => (rules.current.as_str(), rules.sip_kind.as_str(), full_fold(&folded)),\r\n\u001b[?2004l\r"]
[99.835875, "o", "\u001b[?2004h> "]
[99.835997, "o", "        Some(s) => (s, rules.mark_kind.as_str(), folded),\r\n\u001b[?2004l\r"]
[99.836056, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[99.836115, "o", "\u001b[?2004h> "]
[99.836274, "o", "    if write_card(card_slot, &text, kind).is_err() { return 1; }\r\n\u001b[?2004l\r"]
[99.836334, "o", "\u001b[?2004h> "]
[99.836479, "o", "    if fs::write(\"/app/inkvat/SEAL\", \"ok\").is_err() { return 1; }\r\n\u001b[?2004l\r"]
[99.836533, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r"]
[99.83659, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[99.836662, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[99.837954, "o", "\u001b[?2004hroot@f9e8f06ec006:/app# "]
[99.83803, "o", "\r\n\u001b[?2004l\r\u001b[?2004hroot@f9e8f06ec006:/app# "]
[99.838104, "o", "cat > /app/cliurn/boot.rs <<'EOF'\r\n\u001b[?2004l\r"]
[99.838205, "o", "\u001b[?2004h> "]
[99.838273, "o", "#[path = \"../vatrib/qat.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod qat;\r\n\u001b[?2004l\r"]
[99.838324, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.83837, "o", "fn main() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.838496, "o", "    let args: Vec<String> = std::env::args().collect();\r\n\u001b[?2004l\r"]
[99.838541, "o", "\u001b[?2004h> "]
[99.838623, "o", "    let status = match args.as_slice() {\r\n\u001b[?2004l\r"]
[99.838668, "o", "\u001b[?2004h> "]
[99.838799, "o", "        [_, cmd, dump] if cmd == \"sip\" => qat::qat(dump, None),\r\n\u001b[?2004l\r"]
[99.838842, "o", "\u001b[?2004h> "]
[99.839002, "o", "        [_, cmd, dump, slot] if cmd == \"mark\" => qat::qat(dump, Some(slot)),\r\n\u001b[?2004l\r"]
[99.839046, "o", "\u001b[?2004h> "]
[99.839101, "o", "        _ => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.839286, "o", "            eprintln!(\"usage: draughtpin sip DUMP | draughtpin mark DUMP SLOT\");\r\n\u001b[?2004l\r"]
[99.839337, "o", "\u001b[?2004h> "]
[99.839385, "o", "            2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.839428, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r"]
[99.839473, "o", "\u001b[?2004h> "]
[99.839529, "o", "    std::process::exit(status);\r\n\u001b[?2004l\r"]
[99.839572, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[99.839616, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[99.840676, "o", "\u001b[?2004h"]
[99.840735, "o", "root@f9e8f06ec006:/app# \r\n\u001b[?2004l\r\u001b[?2004hroot@f9e8f06ec006:/app# "]
[99.84081, "o", "cat > /app/narbay/loom.rs <<'EOF'\r\n\u001b[?2004l\r"]
[99.840854, "o", "\u001b[?2004h> "]
[99.8409, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.840944, "o", "\u001b[?2004h> "]
[99.841035, "o", "fn slots() -> Result<(String, String), i32> {\r\n\u001b[?2004l\r"]
[99.841082, "o", "\u001b[?2004h> "]
[99.841238, "o", "    let raw = fs::read_to_string(\"/app/abifolio/RULES.txt\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[99.841284, "o", "\u001b[?2004h> "]
[99.841361, "o", "    let mut current = String::new();\r\n\u001b[?2004l\r"]
[99.841409, "o", "\u001b[?2004h> "]
[99.841478, "o", "    let mut compat = String::new();\r\n\u001b[?2004l\r"]
[99.841523, "o", "\u001b[?2004h> "]
[99.841575, "o", "    for line in raw.lines() {\r\n\u001b[?2004l\r"]
[99.841621, "o", "\u001b[?2004h> "]
[99.841805, "o", "        if let Some(v) = line.strip_prefix(\"current slot:\") { current = v.trim().to_string(); }\r\n\u001b[?2004l\r"]
[99.841873, "o", "\u001b[?2004h> "]
[99.842109, "o", "        if let Some(v) = line.strip_prefix(\"compat slot:\") { compat = v.trim().to_string(); }\r\n\u001b[?2004l\r"]
[99.842206, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.842384, "o", "    if current.is_empty() || compat.is_empty() { return Err(1); }\r\n\u001b[?2004l\r"]
[99.84245, "o", "\u001b[?2004h> "]
[99.842498, "o", "    Ok((current, compat))\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.842558, "o", "> }\r\n\u001b[?2004l\r"]
[99.842605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.842652, "o", "pub fn knit() -> String {\r\n\u001b[?2004l\r"]
[99.842698, "o", "\u001b[?2004h> "]
[99.842785, "o", "    slots().map(|v| v.0).unwrap_or_default()\r\n\u001b[?2004l\r"]
[99.84283, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[99.842882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[99.842926, "o", "\u001b[?2004h> "]
[99.84305, "o", "pub fn weave(path: &str) -> Result<(), i32> {\r\n\u001b[?2004l\r"]
[99.843094, "o", "\u001b[?2004h> "]
[99.843212, "o", "    let (current, compat) = slots()?;\r\n\u001b[?2004l\r"]
[99.843258, "o", "\u001b[?2004h> "]
[99.843323, "o", "    let body = format!(\r\n\u001b[?2004l\r"]
[99.843371, "o", "\u001b[?2004h> "]
[99.843653, "o", "        \"{compat} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\n{current} {{\\n  global:\\n    fold_frame;\\n}} {compat};\\n\"\r\n\u001b[?2004l\r"]
[99.843704, "o", "\u001b[?2004h>     );\r\n"]
[99.843745, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[99.843901, "o", "    fs::create_dir_all(\"/app/gnuverse\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[99.843953, "o", "\u001b[?2004h> "]
[99.844051, "o", "    fs::write(path, body).map_err(|_| 1)\r\n\u001b[?2004l\r"]
[99.844098, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[99.844142, "o", "\u001b[?2004h> EOF\r\n"]
[99.844229, "o", "\u001b[?2004l\r"]
[99.845493, "o", "\u001b[?2004hroot@f9e8f06ec006:/app# "]
[99.845562, "o", "/app/stoke.sh\r\n\u001b[?2004l\r"]
[100.712373, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `knit` is never used\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/weft/../narbay/loom.rs:15:8\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m15\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn knit() -> String {\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(dead_code)]` on by default\u001b[0m\r\n\r\n"]
[101.269531, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: 1 warning emitted\u001b[0m\r\n\r\n"]
