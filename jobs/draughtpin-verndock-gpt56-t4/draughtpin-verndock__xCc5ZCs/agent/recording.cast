[25.756522, "i", "for f in /app/{narbay/loom.rs,vatrib/qat.rs,weft/main.rs,aliaspit/hue.S,stemcask/wick.rs,gluebox/glue.rs,cliurn/boot.rs,gnuverse/cask.map,stoke.sh}; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[25.757429, "o", "for f in /app/{narbay/loom.rs,vatrib/qat.rs,weft/main.rs,aliaspit/hue.S,stemcask/wick.rs,gluebox/glue.rs,cliurn/boot.rs,gnuverse/cask.map,stoke.sh}; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[25.757655, "o", "===== /app/narbay/loom.rs =====\r\n"]
[25.760967, "o", "use std::fs;\r\n\r\npub fn knit() -> String {\r\n    let raw = match fs::read_to_string(\"/app/quarryc/hold.toml\") {\r\n        Ok(s) => s,\r\n        Err(_) => return \"CASK_1\".to_string(),\r\n    };\r\n    let mut first = None;\r\n    let mut name = String::new();\r\n    for line in raw.lines() {\r\n        let t = line.trim();\r\n        if let Some(rest) = t.strip_prefix(\"name = \") {\r\n            name = rest.trim_matches('\"').to_string();\r\n        }\r\n        if t == \"home = 1\" && first.is_none() && !name.is_empty() {\r\n            first = Some(name.clone());\r\n        }\r\n"]
[25.761101, "o", "    }\r\n    first.unwrap_or_else(|| \"CASK_1\".to_string())\r\n}\r\n\r\n#[allow(dead_code)]\r\npub fn weave(path: &str) -> Result<(), i32> {\r\n    let home = knit();\r\n    let body = format!(\r\n        \"{h} {{\\n  global:\\n    fold_frame;\\n  local:\\n    *;\\n}};\\nCASK_2 {{\\n  global:\\n    fold_frame;\\n}} {h};\\n\",\r\n        h = home\r\n    );\r\n    fs::create_dir_all(\"/app/gnuverse\").map_err(|_| 1)?;\r\n    fs::write(path, body).map_err(|_| 1)?;\r\n    Ok(())\r\n}\r\n"]
[25.761284, "o", "===== /app/vatrib/qat.rs =====\r\n"]
[25.762436, "o", "use std::fs;\r\nuse std::os::raw::{c_char, c_int, c_void};\r\n\r\nuse crate::loom;\r\n\r\nconst RTLD_NOW: c_int = 2;\r\n\r\nextern \"C\" {\r\n    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\r\n"]
[25.762544, "o", "    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\r\n    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\r\n}\r\n\r\ntype FoldFn = unsafe extern \"C\" fn(*const u8, usize, *mut u8, usize) -> isize;\r\n\r\nfn rules_pair() -> (String, String) {\r\n    let mut cur = String::new();\r\n    let mut old = String::new();\r\n    if let Ok(s) = fs::read_to_string(\"/app/abifolio/RULES.txt\") {\r\n        for line in s.lines() {\r\n            if let Some(rest) = line.strip_prefix(\"current slot:\") {\r\n                cur = rest.trim().to_string();\r\n            }\r\n            if let Some(rest) = line.strip_prefix(\"compat slot:\") {\r\n                old = rest.trim().to_string();\r\n            }\r\n        }"]
[25.762633, "o", "\r\n    }\r\n    (cur, old)\r\n}\r\n\r\nfn folio_ok(slot: &str) -> bool {\r\n    let (a, b) = rules_pair();\r\n    slot == a || slot == b\r\n}\r\n\r\nfn load() -> *mut c_void {\r\n    unsafe { dlopen(b\"/app/lib/libdraught.so\\0\".as_ptr() as *const c_char, RTLD_NOW) }\r\n}\r\n\r\nfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\r\n    if ptr.is_null() {\r\n        return Err(1);\r\n    }\r\n    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\r\n    let mut buf = vec![0u8; blob.len() + 32];\r\n    let n = unsafe { f(blob.as_ptr(), blob.len(), buf.as_mut_ptr(), buf.len()) };\r\n    if n < 0 {\r\n        return Err(1);\r\n    }\r\n    buf.truncate(n as usize);\r\n    Ok(buf)\r\n}\r\n\r\nfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\r\n    fs::create_dir_all(\"/app/inkvat\").map_err(|_| 1)?;\r\n    let body = format!(\r\n        \"{{\\\"node\\\":\\\"{}\\\",\\\"text\\\":{},\\\"kind\\\":\\\"{}\\\"}}\\n\",\r\n        slot,\r\n        serde_like(text),\r\n        kind\r\n    );\r\n    fs::write(\"/app/inkvat/card.json\", body).map_err(|_| 1)?;\r\n    Ok(())\r\n}\r\n\r\nfn serde_like(s: &str) -> String {\r\n    let mut o = String::from(\"\\\"\");\r\n    for c in s.chars() {\r\n        match c {\r\n"]
[25.762696, "o", "            '\"' => o.push_str(\"\\\\\\\"\"),\r\n            '\\\\' => o.push_str(\"\\\\\\\\\"),\r\n            '\\n' => o.push_str(\"\\\\n\"),\r\n            '\\t' => o.push_str(\"\\\\t\"),\r\n            c if (c as u32) < 0x20 => o.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\r\n            _ => o.push(c),\r\n        }\r\n    }\r\n    o.push('\"');\r\n    o\r\n}\r\n\r\npub fn qat(a: &str, b: Option<&str>) -> i32 {\r\n    let _ = fs::remove_file(\"/app/inkvat/SEAL\");\r\n    let blob = match fs::read(a) {\r\n        Ok(x) => x,\r\n        Err(_) => return 1,\r\n    };\r\n    if blob.is_empty() {\r\n        let _ = write_card(\"\", \"\", \"raw\");\r\n        let _ = fs::write(\"/app/inkvat/SEAL\", \"ok\");\r\n        return 0;\r\n    }\r\n    if let Some(n) = b {\r\n        if !folio_ok(n) {\r\n            let _ = write_card(n, \"\", \"raw\");\r\n            let _ = fs::write(\"/app/inkvat/SEAL\", \"ok\");\r\n            return 0;\r\n        }\r\n    }\r\n    let h = load();\r\n    if h.is_null() {\r\n        return 1;\r\n    }\r\n    let ptr = unsafe {\r\n        match b {\r\n            None => dlsym(h, b\"fold_frame\\0\".as_ptr() as *const c_char),\r\n            Some(n) => {\r\n"]
[25.762799, "o", "                let mut v = n.as_bytes().to_vec();\r\n                v.push(0);\r\n                dlvsym(\r\n                    h,\r\n                    b\"fold_frame\\0\".as_ptr() as *const c_char,\r\n                    v.as_ptr() as *const c_char,\r\n                )\r\n            }\r\n        }\r\n    };\r\n    let out = match call(ptr, &blob) {\r\n        Ok(v) => v,\r\n        Err(c) => return c,\r\n    };\r\n"]
[25.762923, "o", "    let text = String::from_utf8_lossy(&out).into_owned();\r\n    let home = loom::knit();\r\n    let kind = if b.is_some() { \"raw\" } else { \"raw\" };\r\n    if write_card(&home, &text, kind).is_err() {\r\n        return 1;\r\n    }\r\n    if fs::write(\"/app/inkvat/SEAL\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[25.763062, "o", "===== /app/weft/main.rs =====\r\n"]
[25.764167, "o", "#[path = \"../narbay/loom.rs\"]\r\nmod loom;\r\n\r\nfn main() {\r\n    if loom::weave(\"/app/gnuverse/cask.map\").is_err() {\r\n        std::process::exit(1);\r\n    }\r\n}\r\n"]
[25.764374, "o", "===== /app/aliaspit/hue.S =====\r\n"]
[25.765538, "o", "# hue\r\n.equ hue, 0\r\n.symver wick_old,fold_frame@@CASK_1\r\n.symver wick_new,fold_frame@CASK_2\r\n"]
[25.765715, "o", "===== /app/stemcask/wick.rs =====\r\n"]
[25.766772, "o", "use core::slice;\r\n\r\nfn lower_only(s: &[u8], dst: &mut [u8]) -> usize {\r\n    let n = s.len().min(dst.len());\r\n    for i in 0..n {\r\n        dst[i] = s[i].to_ascii_lowercase();\r\n    }\r\n    n\r\n}\r\n\r\n"]
[25.766868, "o", "fn full_fold(s: &[u8], dst: &mut [u8]) -> usize {\r\n    let mut i = 0;\r\n    let mut space = false;\r\n    for &b in s {\r\n        if i >= dst.len() {\r\n            break;\r\n        }\r\n        if b == b'\\t' || b == b' ' || b == b'\\n' || b == b'\\r' {\r\n            if !space {\r\n                dst[i] = b' ';\r\n                i += 1;\r\n                space = true;\r\n            }\r\n            continue;\r\n        }\r\n        if b < 0x20 {\r\n            continue;\r\n        }\r\n        space = false;\r\n        dst[i] = b.to_ascii_lowercase();\r\n        i += 1;\r\n    }\r\n    while i > 0 && dst[i - 1] == b'/' {\r\n        i -= 1;\r\n    }\r\n    i\r\n}\r\n\r\n#[no_mangle]\r\npub unsafe extern \"C\" fn wick_old(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    if p.is_null() || dst.is_null() || cap == 0 {\r\n        return -1;\r\n    }\r\n    let s = slice::from_raw_parts(p, n);\r\n    let d = slice::from_raw_parts_mut(dst, cap);\r\n    lower_only(s, d) as isize\r\n"]
[25.766958, "o", "}\r\n\r\n#[no_mangle]\r\npub unsafe extern \"C\" fn wick_new(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {\r\n    if p.is_null() || dst.is_null() || cap == 0 {\r\n        return -1;\r\n    }\r\n    let s = slice::from_raw_parts(p, n);\r\n    let d = slice::from_raw_parts_mut(dst, cap);\r\n    full_fold(s, d) as isize\r\n}\r\n"]
[25.767133, "o", "===== /app/gluebox/glue.rs =====\r\n"]
[25.76821, "o", "#![no_std]\r\n#![crate_type = \"staticlib\"]\r\n\r\n#[path = \"../stemcask/wick.rs\"]\r\nmod wick;\r\n\r\ncore::arch::global_asm!(include_str!(\"../aliaspit/hue.S\"));\r\n\r\n#[no_mangle]\r\npub extern \"C\" fn rust_eh_personality() {}\r\n"]
[25.768257, "o", "\r\n#[panic_handler]\r\nfn panic(_: &core::panic::PanicInfo) -> ! {\r\n    loop {}\r\n}\r\n"]
[25.768454, "o", "===== /app/cliurn/boot.rs =====\r\n"]
[25.769459, "o", "#[path = \"../narbay/loom.rs\"]\r\nmod loom;\r\n#[path = \"../vatrib/qat.rs\"]\r\nmod qat;\r\n#[path = \"../spanmod/skip.rs\"]\r\nmod skip;\r\n#[path = \"../lidmath/note.rs\"]\r\nmod note;\r\n"]
[25.769541, "o", "\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd == \"sip\" {\r\n        let dump = args.next().unwrap_or_default();\r\n        let _ = skip::skip(&dump);\r\n        std::process::exit(qat::qat(&dump, None));\r\n    }\r\n    if cmd == \"mark\" {\r\n        let dump = args.next().unwrap_or_default();\r\n        let slot = args.next().unwrap_or_default();\r\n        let _ = note::note(&slot);\r\n        std::process::exit(qat::qat(&dump, Some(&slot)));\r\n    }\r\n    eprintln!(\"usage: draughtpin sip DUMP | draughtpin mark DUMP SLOT\");\r\n    std::process::exit(2);\r\n}\r\n"]
[25.76973, "o", "===== /app/gnuverse/cask.map =====\r\n"]
[25.770766, "o", "CASK_1 {\r\n  global:\r\n    fold_frame;\r\n  local:\r\n    *;\r\n};\r\nCASK_2 {\r\n"]
[25.770831, "o", "  global:\r\n    fold_frame;\r\n} CASK_1;\r\n"]
[25.771019, "o", "===== /app/stoke.sh =====\r\n"]
[25.771995, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/lib /app/inkvat /app/gnuverse\r\nrustc --edition 2021 -O /app/weft/main.rs -o /app/bin/weave\r\n/app/bin/weave\r\n"]
[25.772101, "o", "rustc --edition 2021 -O --crate-type staticlib -C panic=abort /app/gluebox/glue.rs -o /tmp/libdraught.a\r\ncc -shared -o /app/lib/libdraught.so -Wl,--version-script=/app/gnuverse/cask.map -Wl,--whole-archive /tmp/libdraught.a -Wl,--no-whole-archive -lc -ldl\r\nrustc --edition 2021 -O /app/cliurn/boot.rs -o /app/bin/draughtpin -C link-arg=-ldl\r\n"]
[25.77228, "o", "\u001b[?2004hroot@f9e8f06ec006:/app# "]
[26.061628, "i", "echo '--- raw dumps ---'; for f in /app/rawspan/*.raw; do echo \"== $f ($(wc -c < \"$f\") bytes) ==\"; od -An -tx1c \"$f\"; done; echo '--- ELF headers/symbols ---'; readelf -h /app/bin/draughtpin | head -20; readelf -WsV /app/lib/libdraught.so | sed -n '1,240p'\n"]
[26.062535, "o", "echo '--- raw dumps ---'; for f in /app/rawspan/*.raw; do echo \"== $f ($(wc -c < \"$f\") bytes) ==\"; od -An -tx1c \"$f\"; done; echo '--- ELF headers/symbols ---'; readelf -h /app/bin/draughtpin | head -20; readelf -WsV /app/lib/libdraught.so | sed -n '1,240p'\r\n\u001b[?2004l\r"]
