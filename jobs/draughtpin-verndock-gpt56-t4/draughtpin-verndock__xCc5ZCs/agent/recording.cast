[14.000004, "o", "draughtpin layout\r\n=================\r\n\r\ncliurn/boot.rs dispatches sip and mark.\r\n\r\nMill directories:\r\n- narbay/\r\n- vatrib/\r\n- weft/\r\n- aliaspit/\r\n- stemcask/\r\n- gluebox/\r\n- cliurn/\r\n\r\nDumps live in /app/rawspan, including /app/rawspan/alpha.raw and /app/rawspan/beta.raw.\r\nsip writes /app/inkvat/card.json.\r\nShared object is /app/lib/libdraught.so.\r\nExported C name is fold_frame.\r\n\r\nRebuild with /app/stoke.sh after source edits.\r\n"]
[14.000377, "o", "\r\n--- RULES ---\r\n"]
[14.00135, "o", "current slot: CASK_2\r\ncompat slot: CASK_1\r\nexport: fold_frame\r\nsip kind: bare\r\nmark kind: named\r\n\r\nFold a dump:\r\n- ASCII letters to lowercase\r\n- TAB, LF, CR, and SPACE collapse to a single SPACE\r\n- other bytes below 0x20 are dropped\r\n- trailing ASCII slash characters are stripped\r\n\r\n- ASCII letters to lowercase\r\n- TAB, LF, CR, and SPACE collapse to a single SPACE\r\n- other bytes below 0x20 are dropped\r\n- trailing ASCII slash characters are stripped\r\n"]
[14.001558, "o", "\u001b[?2004hroot@f9e8f06ec006:/app# "]
[14.114558, "i", "printf '\\n--- FILES ---\\n'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort\n"]
[14.114995, "o", "printf '\\n--- FILES ---\\n'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
