return math.hypot(dx, dy)\n\n\ndef count_tracks(detections, typical_area):\n    tracks = []\n    total = 0\n    for fi, dets in enumerate(detections):\n        for t in tracks:\n            t.det_index = -1\n\n        # Candidate one-to-one assignments, globally greedied by prediction\n        # error. With 12 fps and small frames this is stable through crossings.\n        edges = []\n        for ti, t in enumerate(tracks):\n            if t.missed > 18:\n                continue\n            radius = 16 + min(30, 4 * t.missed) + 1.8 * max(abs(t.vx), abs(t.vy))\n            for di, d in enumerate(dets):\n                dist = _distance(t, d)\n                if dist <= radius:\n                    edges.append((dist, ti, di))\n        used_t, used_d = set(), set()\n        for _, ti, di in sorted(edges):\n            if ti in used_t or di in used_d:\n                continue\n            tracks[ti].det_index = di\n            used_t.add(ti); used_d.add(di)\n\n        # Let additional established tracks occupy a merged component. This\n        # retains separate identities even if only one silhouette is visible.\n        for ti, t in enumerate(tracks):\n            if ti in used_t or t.missed > 10:\n                continue\n            px, py = t.prediction()\n            choices = []\n            for di in used_d:\n                d = dets[di]\n                x, y, w, h = d["box"]\n                pad = 7\n                if x-pad <= px <= x+w+pad and y-pad <= py <= y+h+pad:\n                    choices.append((_distance(t, d), di))\n            if choices:\n                _, di = min(choices)\n                t.det_index = di\n                used_t.add(ti)\n\n        groups = {}\n        for ti, t in enumerate(tracks):\n            if t.det_index >= 0:\n                groups.setdefault(t.det_index, []).append(ti)\n        for di, members in groups.items():\n            shared = len(members) > 1\n            for ti in members:\n                tracks[ti].updat