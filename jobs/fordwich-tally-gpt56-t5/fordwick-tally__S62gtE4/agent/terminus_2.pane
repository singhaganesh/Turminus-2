[?2004l[?2004h> def rect(f,x,y,c=(30,40,220)):
[?2004l[?2004h>  cv2.rectangle(f,(int(x)-8,int(y)-9),(int(x)+8,int(y)+9),c,-1)
[?2004l[?2004h> # basic downward, upward, linger across scan
[?2004l[?2004h> run('down',lambda f,i: rect(f,35,-10+3*i),48,1)
[?2004l[?2004h> run('up',lambda f,i: rect(f,35,125-3*i),48,0)
[?2004l[?2004h> def linger(f,i):
[?2004l[?2004h>  y=20+4*min(i,12) if i<13 else (68 if i<35 else 68+4*(i-34))
[?2004l[?2004h>  rect(f,55,y)
[?2004l[?2004h> run('linger',linger,50,1)
[?2004l[?2004h> # two simultaneous, nearby independent bodies
[?2004l[?2004h> run('parallel',lambda f,i:(rect(f,50,-8+3*i),rect(f,78,-22+3*i,(220,50,40))),55,2)
[?2004l[?2004h> # converge into one overlapping component, then diverge
[?2004l[?2004h> # both proceed downward and share center around scan
[?2004l[?2004h> def merge(f,i):
[?2004l[?2004h>  y=5+2.6*i
[?2004l[?2004h>  sep=max(0,28-1.4*i) if i<20 else min(28,1.4*(i-20))
[?2004l[?2004h>  rect(f,80-sep/2,y,(20,30,220)); rect(f,80+sep/2,y,(220,30,30))
[?2004l[?2004h> run('merge',merge,52,2)
[?2004l[?2004h> # broad horizontal shade band moves down and must not count
[?2004l[?2004h> def shade(f,i):
[?2004l[?2004h>  y=-15+3*i; cv2.rectangle(f,(0,int(y)-6),(159,int(y)+6),(60,72,80),-1)
[?2004l[?2004h> run('shade',shade,50,0)
[?2004l[?2004h> # one body crosses, exits bottom, later re-enters from top: count once
[?2004l[?2004h> # gap shorter than tracker retention
[?2004l[?2004h> # (same visible identity and x)
[?2004l[?2004h> def returner(f,i):
