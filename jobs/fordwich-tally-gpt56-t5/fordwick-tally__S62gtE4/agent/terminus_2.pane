[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import toml
[?2004l[?2004h> 
[?2004l[?2004h> from blot import components, foreground_masks
[?2004l[?2004h> from tether import count_tracks
[?2004l[?2004h> 
[?2004l[?2004h> SHEET = Path('/app/inkwell/sheet.toml')
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def emit_span(src: str) -> int:
[?2004l[?2004h>     # Never leave a result from a prior invocation on failure.
[?2004l[?2004h>     try:
[?2004l[?2004h>         SHEET.unlink()
[?2004l[?2004h>     except FileNotFoundError:
[?2004l[?2004h>         pass
[?2004l[?2004h>     cap = cv2.VideoCapture(src)
[?2004l[?2004h>     if not cap.isOpened():
[?2004l[?2004h>         cap.release()
[?2004l[?2004h>         raise OSError('cannot open clip')
[?2004l[?2004h>     frames = []
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ok, frame = cap.read()
[?2004l[?2004h>         if not ok:
[?2004l[?2004h>             break
[?2004l[?2004h>         if frame is None or frame.shape[:2] != (120, 160):
[?2004l[?2004h>             cap.release()
[?2004l[?2004h>             raise ValueError('invalid frame')
[?2004l[?2004h>         frames.append(frame)
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     if not frames:
[?2004l[?2004h>         raise OSError('clip contains no decodable frames')
[?2004l[?2004h> 
[?2004l[?2004h>     masks = foreground_masks(frames)
[?2004l[?2004h>     dets = [components(m) for m in masks]
[?2004l[?2004h>     # Estimate one-body area from compact components; it is useful as scene
[?2004l[?2004h>     # scale metadata and deliberately robust to merges and tiny noise.
[?2004l[?2004h>     areas = [d['area'] for ds in dets for d in ds
[?2004l[?2004h>              if d['box'][2] <= 45 and d['box'][3] <= 45 and d['area'] >= 45]
[?2004l[?2004h>     typical = float(np.median(areas)) if areas else 250.0
[?2004l[?2004h>     return int(count_tracks(dets, typical))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def dump_sheet(n: int) -> None:
[?2004l[?2004h>     SHEET.parent.mkdir(parents=True, exist_ok=True)
[?2004l[?2004h>     temp = SHEET.with_suffix('.tmp')
[?2004l[?2004h>     temp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')
[?2004l[?2004h>     temp.replace(SHEET)
[?2004l[?2004h> PY
