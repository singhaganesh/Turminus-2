[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main() -> int:
[?2004l[?2004h>     if len(sys.argv) != 2:
[?2004l[?2004h>         return 2
[?2004l[?2004h>     try:
[?2004l[?2004h>         n = emit_span(sys.argv[1])
