[?2004l[?2004h>         self.x += self.vx
[?2004l[?2004h>         self.y += self.vy
[?2004l[?2004h>         self.missed += 1
[?2004l[?2004h>         self.age += 1
[?2004l[?2004h> 
[?2004l[?2004h>     def completes(self):
[?2004l[?2004h>         # Require observations on both sides and net downward progress.
[?2004l[?2004h>         return (not self.counted and self.armed and self.hits >= 2 and
[?2004l[?2004h>                 self.y >= LINE_Y + 3 and self.y - self.min_y >= 6 and
[?2004l[?2004h>                 (self.vy > -.35 or self.shared))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _distance(track, det):
[?2004l[?2004h>     px, py = track.prediction()
[?2004l[?2004h>     dx, dy = det["x"] - px, det["y"] - py
[?2004l[?2004h>     # Vertical motion is expected, but lateral motion is allowed.
[?2004l[?2004h>     return math.hypot(dx, dy)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def count_tracks(detections, typical_area):
[?2004l[?2004h>     tracks = []
[?2004l[?2004h>     total = 0
[?2004l[?2004h>     for fi, dets in enumerate(detections):
[?2004l[?2004h>         for t in tracks:
[?2004l[?2004h>             t.det_index = -1
[?2004l[?2004h> 
[?2004l[?2004h>         # Candidate one-to-one assignments, globally greedied by prediction
[?2004l[?2004h>         # error. With 12 fps and small frames this is stable through crossings.
[?2004l[?2004h>         edges = []
[?2004l[?2004h>         for ti, t in enumerate(tracks):
[?2004l[?2004h>             if t.missed > 18:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             radius = 16 + min(30, 4 * t.missed) + 1.8 * max(abs(t.vx), abs(t.vy))
[?2004l[?2004h>             for di, d in enumerate(dets):
[?2004l[?2004h>                 dist = _distance(t, d)
[?2004l[?2004h>                 if dist <= radius:
[?2004l[?2004h>                     edges.append((dist, ti, di))
[?2004l[?2004h>         used_t, used_d = set(), set()
[?2004l[?2004h>         for _, ti, di in sorted(edges):
[?2004l[?2004h>             if ti in used_t or di in used_d:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             tracks[ti].det_index = di
[?2004l[?2004h>             used_t.add(ti); used_d.add(di)
[?2004l[?2004h> 
[?2004l[?2004h>         # Let additional established tracks occupy a merged component. This
[?2004l[?2004h>         # retains separate identities even if only one silhouette is visible.
[?2004l[?2004h>         for ti, t in enumerate(tracks):
[?2004l[?2004h>             if ti in used_t or t.missed > 10:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             px, py = t.prediction()
[?2004l[?2004h>             choices = []
[?2004l[?2004h>             for di in used_d:
[?2004l[?2004h>                 d = dets[di]
[?2004l[?2004h>                 x, y, w, h = d["box"]
[?2004l[?2004h>                 pad = 7
[?2004l[?2004h>                 if x-pad <= px <= x+w+pad and y-pad <= py <= y+h+pad:
[?2004l[?2004h>                     choices.append((_distance(t, d), di))
[?2004l[?2004h>             if choices:
[?2004l[?2004h>                 _, di = min(choices)
[?2004l[?2004h>                 t.det_index = di
[?2004l[?2004h>                 used_t.add(ti)
[?2004l[?2004h> 
[?2004l[?2004h>         groups = {}
[?2004l[?2004h>         for ti, t in enumerate(tracks):
[?2004l[?2004h>             if t.det_index >= 0:
[?2004l[?2004h>                 groups.setdefault(t.det_index, []).append(ti)
[?2004l[?2004h>         for di, members in groups.items():
[?2004l[?2004h>             shared = len(members) > 1
[?2004l[?2004h>             for ti in members:
[?2004l[?2004h>                 tracks[ti].update(dets[di], fi, shared)
[?2004l[?2004h>         for ti, t in enumerate(tracks):
[?2004l[?2004h>             if ti not in used_t:
[?2004l[?2004h>                 t.coast()
[?2004l[?2004h> 
[?2004l[?2004h>         # Unassigned detections normally start tracks. If one appears beside a
[?2004l[?2004h>         # just-matched track after a shared/large component, treat it as a split
[?2004l[?2004h>         # child and inherit evidence that the body had been above the scan.
[?2004l[?2004h>         for di, d in enumerate(dets):
[?2004l[?2004h>             if di in used_d:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             parent = None
[?2004l[?2004h>             best = 1e9
[?2004l[?2004h>             for t in tracks:
[?2004l[?2004h>                 q = math.hypot(t.x - d["x"], t.y - d["y"])
[?2004l[?2004h>                 if q < best and q < 32 and (t.shared or t.hits >= 3):
[?2004l[?2004h>                     parent, best = t, q
[?2004l[?2004h>             inherited = bool(parent and parent.armed and d["y"] > LINE_Y - 8)
[?2004l[?2004h>             nt = Track(d, fi, inherited)
[?2004l[?2004h>             if parent is not None:
[?2004l[?2004h>                 nt.vx, nt.vy = parent.vx, parent.vy
[?2004l[?2004h>             tracks.append(nt)
[?2004l[?2004h> 
[?2004l[?2004h>         for t in tracks:
[?2004l[?2004h>             if t.completes():
[?2004l[?2004h>                 t.counted = True
[?2004l[?2004h>                 total += 1
[?2004l[?2004h>         # Preserve tracks long enough for ordinary occlusion, but not forever.
[?2004l[?2004h>         tracks = [t for t in tracks if t.missed <= 24 and
[?2004l[?2004h>                   -45 <= t.x <= 205 and -55 <= t.y <= 175]
[?2004l[?2004h>     return total
