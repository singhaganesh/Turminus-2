&i| cells.get(i).cloned()).collect()\n}\n\nfn pack(items: &[String]) -> String {\n    format!("[{}]", items.iter().map(|s| quote(s)).collect::<Vec<_>>().join(","))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path("/app/spoolbay/shift.spool") else {\n        return 1;\n    };\n    let heat = sess.flag;\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n    let frost_items = values(&frost.ids.borrow(), &frost.cells);\n    let live_items = values(&sess.ids.borrow(), &pool.cells);\n    if heat && frost_items == live_items { return 3; }\n    let extra = tally::lines();\n    let body = format!(\n        "{{\\"tick\\":{},\\"mark\\":{},\\"frost_bag\\":{},\\"live_bag\\":{}}}\\n",\n        sess.n0.saturating_add(extra), sess.n1, pack(&frost_items), pack(&live_items)\n    );\n    let dest = Path::new("/app/inkpit/pair.json");\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    match fs::write(dest, body) { Ok(()) => 0, Err(_) => 2 }\n}\n"#;\n    let ink = r#"use crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let dest = Path::new("/app/inkpit/pair.json");\n    let guard = Path::new("/app/inkpit/GUARD");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(dest);\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    let code = pool::dump();\n    if code != 0 {\n        let _ = fs::remove_file(dest);\n        return code;\n    }\n    match fs::write(guard, "ok\\n") { Ok(()) => 0, Err(_) => { let _ = fs::remove_file(guard); 2 } }\n}\n"#;\n    if fs::write("/app/foldrib/rim.rs", rim).is_err() { return 2; }\n    if fs::write("/app/internpit/pool.rs", pool).is_err() { return 2; }\n    if fs::write("/app/restcue/ink.rs", ink).is_err() { return 2; }\n    0\n}\nEOF\ncd /app && ./bake.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
