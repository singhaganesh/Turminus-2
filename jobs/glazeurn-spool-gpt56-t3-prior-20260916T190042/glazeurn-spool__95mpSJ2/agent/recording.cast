[69.56202, "o", "        n0: a.n0,\r\n\u001b[?2004l\r\u001b[?2004h>         n1: a.n1,\r\n\u001b[?2004l\r"]
[69.562426, "o", "\u001b[?2004h>         ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\r\n\u001b[?2004l\r"]
