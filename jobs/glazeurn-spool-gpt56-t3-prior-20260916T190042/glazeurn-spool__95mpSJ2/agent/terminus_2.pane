=== bake ===
#!/bin/sh
set -eu
export PATH="/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
mkdir -p /app/bin /app/inkpit
rustc --edition 2021 -O /app/emitbay/main.rs -o /tmp/glaze-emit
/tmp/glaze-emit
rustc --edition 2021 -O /app/steerpit/boot.rs -o /app/bin/glazeurn
=== vatslip/ROUTE.txt ===
Cards live under /app/daycards. The working spool is /app/spoolbay/shift.spool.
Spare kiln tapes sit at /app/spoolbay/canon.spool and /app/spoolbay/spare.spool.
pair writes /app/inkpit/pair.json. bind refreshes mill pieces from TREE.txt.
=== noteurn/LAYOUT.txt ===
pair.json keys tick mark frost_bag live_bag
=== coverpit/COVER.txt ===
Kiln pitch after every mode is tick plus one and mark plus two.
A clone of the session handle is the freeze. Desk count 9 belongs on tick.
The mill reads this slip during bind walks.
Keep the count on the desk slip only.
=== steerpit/usage.txt ===
glazeurn bind
glazeurn pair
=== daycards/elm.card ===
emit cells
=== daycards/oak.card ===
emit freeze
=== spoolbay/canon.spool ===
tick 7
mark 4
bag oak elm ash
mode heat
swap elm yew
push fir
=== spoolbay/shift.spool ===
tick 7
mark 4
bag oak elm ash
mode heat
swap elm yew
push fir
=== spoolbay/spare.spool ===
tick 11
mark 2
bag pine cedar oak birch
mode heat
swap pine teak
push moss
=== foldrib/rim.rs ===
use crate::hold;

pub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {
    let _ = b;
    hold::Frost {
        n0: a.n0,
        n1: a.n1,
        ids: a.ids.clone(),
        cells: Vec::new(),
    }
}
=== internpit/pool.rs ===
use crate::fold;
use crate::hold;
use crate::load;
use crate::tally;
use std::fs;
use std::path::Path;

pub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {
    let _ = (a, b);
}

pub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {
    let mut f = fold::rim_a(a, b);
    rim_b(&mut f, b);
    f
}

fn pack(ids: &[usize], cells: &[String]) -> String {
    let mut parts = Vec::new();
    for &i in ids {
        let s = cells.get(i).map(|x| x.as_str()).unwrap_or("");
        parts.push(format!("\"{}\"", s));
    }
    format!("[{}]", parts.join(","))
}

pub fn dump() -> i32 {
    let Some((mut sess, mut pool, plan)) = load::read_path("/app/spoolbay/shift.spool") else {
        return 1;
    };
    let frost = prep(&sess, &pool);
    load::step(&mut sess, &mut pool, &plan);
    let live_ids = sess.ids.borrow().clone();
    let _frost_ids = frost.ids.borrow().clone();
    let extra = tally::lines();
    let frost_s = pack(&live_ids, &pool.cells);
    let live_s = pack(&live_ids, &pool.cells);
    let dest = Path::new("/app/inkpit/pair.json");
    if let Some(parent) = dest.parent() {
        let _ = fs::create_dir_all(parent);
    }
    let body = format!(
        "{{\"tick\":{},\"mark\":{},\"frost_bag\":{},\"live_bag\":{}}}\n",
        sess.n0.saturating_add(extra),
        sess.n1,
        frost_s,
        live_s
    );
    match fs::write(dest, body) {
        Ok(()) => 0,
        Err(_) => 2,
    }
}
=== restcue/ink.rs ===
use crate::load;
use crate::pool;
use crate::tally;
use std::fs;
use std::path::Path;

pub fn rim_c() -> i32 {
    let _ = tally::lines();
    let dest = Path::new("/app/inkpit/pair.json");
    let guard = Path::new("/app/inkpit/GUARD");
    if let Some(parent) = dest.parent() {
        let _ = fs::create_dir_all(parent);
    }
    if load::read_path("/app/spoolbay/shift.spool").is_none() {
        let _ = fs::write(
            dest,
            "{\"tick\":0,\"mark\":0,\"frost_bag\":[],\"live_bag\":[]}\n",
        );
        let _ = fs::write(guard, "ok\n");
        return 0;
    }
    let _ = pool::dump();
    let _ = fs::write(guard, "ok\n");
    0
}
