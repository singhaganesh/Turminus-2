[171.75459, "i", "cat > /app/namelock/TallyGate.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.HashSet;\nimport java.util.Set;\nimport java.util.zip.ZipEntry;\nimport java.util.zip.ZipInputStream;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path roster, Path packed) throws Exception {\n        if (!Files.isRegularFile(packed)) return 1;\n\n        Set<String> entries = new HashSet<String>();\n        try (ZipInputStream in = new ZipInputStream(Files.newInputStream(packed))) {\n            ZipEntry e;\n            while ((e = in.getNextEntry()) != null) entries.add(e.getName());\n        }\n\n        String java = Paths.get(System.getProperty(\"java.home\"), \"bin\", \"java\").toString();\n        Process process = new ProcessBuilder(java, \"-cp\", packed.toString(), \"Main\", \"booth\")\n            .redirectErrorStream(true).start();\n        String output = new String(process.getInputStream().readAllBytes(), StandardCharsets.UTF_8);\n        if (process.waitFor() != 0) return 1;\n        Set<String> live = new HashSet<String>();\n        for (String line : output.split(\"\\\\R\")) {\n            if (!line.trim().isEmpty()) live.add(line.trim());\n        }\n\n        for (String raw : Files.readAllLines(roster)) {\n            String line = raw.trim();\n            if (line.isEmpty()) continue;\n            String[] fields = line.split(\"\\\\s+\");\n            if (fields.length < 2 || !live.contains(fields[0]) ||\n                !entries.contains(fields[1] + \".class\")) return 1;\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(Paths.get(\"/app/blastcp\"),\n            Paths.get(\"/app/desknote/NAMES.txt\"),\n            Paths.get(\"/app/jarwell/husk.jar\")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo \"knit_rc=$? size=$(stat -c %s /app/jarwell/husk.jar) cap=$(cat /app/desknote/CAP.txt)\"\n"]
[171.755444, "o", "cat > /app/namelock/TallyGate.java <<'EOF'"]
