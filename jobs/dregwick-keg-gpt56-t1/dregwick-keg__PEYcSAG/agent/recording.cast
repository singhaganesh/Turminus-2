[13.255822, "o", "=== dregwick ===\r\n"]
[13.259461, "o", "/app/bin/dregwick: Bourne-Again shell script, ASCII text executable\r\n"]
[13.26256, "o", "#!/bin/bash\r\nset -euo pipefail\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  knit)\r\n    exec /app/brim.sh\r\n    ;;\r\n  loom)\r\n    exec \"$JAVA\" -cp /app/blastcp Main loom \"$@\"\r\n    ;;\r\n  taste)\r\n    exec \"$JAVA\" -cp /app/jarwell/husk.jar Main taste \"$@\"\r\n    ;;\r\n  booth)\r\n"]
[13.262768, "o", "    exec \"$JAVA\" -cp /app/jarwell/husk.jar Main booth \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\n"]
[13.263079, "o", "\u001b[?2004hroot@a4e45208efa4:/app# "]
[13.445197, "i", "printf '%s\\n' '=== Java sources ==='; find /app -type f -name '*.java' -print -exec sh -c 'echo --- \"$1\"; sed -n \"1,260p\" \"$1\"' sh {} \\;; printf '%s\\n' '=== cards ==='; for f in /app/slipcards/*; do echo \"--- $f\"; cat \"$f\"; done; printf '%s\\n' '=== current taste ==='; cat /app/jarwell/taste.json 2>/dev/null || true; printf '%s\\n' '=== jar ==='; ls -l /app/jarwell/husk.jar 2>/dev/null || true; jar tf /app/jarwell/husk.jar 2>/dev/null || true\n"]
[13.446852, "o", "printf '%s\\n' '=== Java sources ==='; find /app -type f -name '*.java' -print -exec sh -c 'echo --- \"$1\"; sed -n \"1,260p\" \"$1\"' sh {} \\;; printf '%s\\n' '=== cards ==='; for f in /app/slipcards/*; do echo \"--- $f\"; cat \"$f\"; done; printf '%s\\n' '=== current taste ==='; cat /app/jarwell/taste.json 2>/dev/null || true; printf '%s\\n' '=== jar ==='; ls -l /app/jarwell/husk.jar 2>/dev/null || true; jar tf /app/jarwell/husk.jar 2>/dev/null || true\r\n\u001b[?2004l\r"]
