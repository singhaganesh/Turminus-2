Sending keys: ['cat > /app/rootwalk/ReachWalk.java <<\'EOF\'\nimport java.nio.ByteBuffer;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.DirectoryStream;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayDeque;\nimport java.util.ArrayList;\nimport java.util.LinkedHashSet;\nimport java.util.List;\nimport java.util.Set;\n\npublic class ReachWalk {\n    public static Set<String> weld_set(Path dir) throws Exception {\n        Set<String> live = new LinkedHashSet<String>();\n        ArrayDeque<String> todo = new ArrayDeque<String>();\n        todo.add("Main");\n        todo.add("TasteRun");\n        todo.add("BoothRun");\n        todo.add("Rib");\n        todo.add("FallBooth");\n\n        // Booth discovery is data-driven.  A handler need not be in NAMES.txt.\n        try (DirectoryStream<Path> ds = Files.newDirectoryStream(dir, "*Booth.class")) {\n            for (Path p : ds) {\n                String file = p.getFileName().toString();\n                todo.add(file.substring(0, file.length() - 6));\n            }\n        }\n\n        while (!todo.isEmpty()) {\n            String name = todo.removeFirst();\n            if (!live.add(name)) continue;\n            Path file = dir.resolve(name + ".class");\n            if (!Files.isRegularFile(file)) continue;\n            for (String ref : refs(Files.readAllBytes(file))) {\n                if (!live.contains(ref) && Files.isRegularFile(dir.resolve(ref + ".class"))) {\n                    todo.addLast(ref);\n                }\n            }\n        }\n        return live;\n    }\n\n    static List<String> refs(byte[] raw) {\n        List<String> out = new ArrayList<String>();\n        if (raw.length < 10) return out;\n        ByteBuffer b = ByteBuffer.wrap(raw);\n        if (b.getInt() != 0xCAFEBABE) return out;\n        b.getShort();\n        b.getShort();\n        int count = b.getShort() & 0xffff;\n        String[] utf = new String[count];\n        int[] classes = new int[count];\n        try {\n            for (int i = 1; i < count; i++) {\n                int tag = b.get() & 0xff;\n                switch (tag) {\n                    case 1:\n                        int len = b.getShort() & 0xffff;\n                        byte[] text = new byte[len];\n                        b.get(text);\n                        utf[i] = new String(text, StandardCharsets.UTF_8);\n                        break;\n                    case 7:\n                        classes[i] = b.getShort() & 0xffff;\n                        break;\n                    case 8: case 16: case 19: case 20:\n                        b.getShort();\n                        break;\n                    case 3: case 4: case 9: case 10: case 11:\n                    case 12: case 17: case 18:\n                        b.getInt();\n                        break;\n                    case 5: case 6:\n                        b.getLong();\n                        i++;\n                        break;\n                    case 15:\n                        b.get();\n                        b.getShort();\n                        break;\n                    default:\n                        return out;\n                }\n            }\n        } catch (RuntimeException badClass) {\n            return out;\n        }\n        for (int index : classes) {\n            if (index <= 0 || index >= utf.length) continue;\n            String name = utf[index];\n            if (name != null && !name.startsWith("java/") &&\n                !name.startsWith("javax/") && name.indexOf(\'/\') < 0 &&\n                name.indexOf(\'[\') < 0) {\n                out.add(name);\n            }\n        }\n        return out;\n    }\n}\nEOF\ncat > /app/namelock/TallyGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.HashSet;\nimport java.util.Set;\nimport java.util.zip.ZipEntry;\nimport java.util.zip.ZipInputStream;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path roster, Path packed) throws Exception {\n        if (!Files.isRegularFile(packed)) return 1;\n        Set<String> entries = new HashSet<String>();\n        try (ZipInputStream in = new ZipInputStream(Files.newInputStream(packed))) {\n            ZipEntry e;\n            while ((e = in.getNextEntry()) != null) entries.add(e.getName());\n        }\n        for (String raw : Files.readAllLines(roster)) {\n            String line = raw.trim();\n            if (line.isEmpty()) continue;\n            String[] fields = line.split("\\\\s+");\n            if (fields.length < 2 || !entries.contains(fields[1] + ".class")) return 1;\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(Paths.get("/app/blastcp"),\n            Paths.get("/app/desknote/NAMES.txt"),\n            Paths.get("/app/jarwell/husk.jar")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path packed, Path capFile) throws Exception {\n        if (!Files.isRegularFile(packed)) return 1;\n        long cap;\n        try {\n            cap = Long.parseLong(Files.readString(capFile).trim());\n        } catch (RuntimeException e) {\n            return 1;\n        }\n        return cap >= 0 && Files.size(packed) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(Paths.get("/app/jarwell/husk.jar"),\n            Paths.get("/app/desknote/CAP.txt")));\n    }\n}\nEOF\n/app/bin/dregwick knit; echo "knit_rc=$?"; stat -c \'jar_size=%s\' /app/jarwell/husk.jar; unzip -l /app/jarwell/husk.jar\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
