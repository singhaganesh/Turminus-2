===== /app/hopmat/table.rs =====
     1	use crate::span;
     2	
     3	const RAW: &str = include_str!("../loomkit/emit.lst");
     4	
     5	#[derive(Clone)]
     6	pub struct Slot {
     7	    #[allow(dead_code)]
     8	    pub label: String,
     9	    pub reply: String,
    10	}
    11	
    12	impl Default for Slot {
    13	    fn default() -> Self {
    14	        Self {
    15	            label: String::new(),
    16	            reply: "fallthrough".to_string(),
    17	        }
    18	    }
    19	}
    20	
    21	fn parse_line(line: &str) -> Option<(u8, Slot)> {
    22	    let mut parts = line.split('\t');
    23	    let label = parts.next()?.trim().to_string();
    24	    let wire: u8 = parts.next()?.trim().parse().ok()?;
    25	    let reply = parts.next()?.trim().to_string();
    26	    if label.is_empty() {
    27	        return None;
    28	    }
    29	    Some((wire, Slot { label, reply }))
    30	}
    31	
    32	pub fn rib_b() -> Vec<Slot> {
    33	    let cap = span::rib_a();
    34	    let mut slots: Vec<Slot> = vec![Slot::default(); 256];
    35	    for (i, line) in RAW.lines().enumerate() {
    36	        if line.trim().is_empty() {
    37	            continue;
    38	        }
    39	        if let Some((_w, slot)) = parse_line(line) {
    40	            if i < cap {
    41	                slots[i] = slot;
    42	            }
    43	        }
    44	    }
    45	    slots
    46	}
    47	
    48	pub fn tap(n: u8) -> i32 {
    49	    let slots = rib_b();
    50	    let row = &slots[n as usize];
    51	    println!("{{\"wire\":{},\"reply\":\"{}\"}}", n, row.reply);
    52	    0
    53	}
===== /app/lidpit/plug.rs =====
     1	use crate::cards;
     2	use crate::loom;
     3	use crate::tally;
     4	use std::fs;
     5	
     6	pub fn rib_c() -> i32 {
     7	    let _ = tally::lines();
     8	    let _ = loom::emit();
     9	    let body = fs::read_to_string("/app/mistwell/roster.json").unwrap_or_default();
    10	    let spec = cards::load();
    11	    let mut names: Vec<String> = Vec::new();
    12	    for row in &spec {
    13	        if body.contains(&row.label) {
    14	            names.push(row.label.clone());
    15	        }
    16	    }
    17	    if names.len() != spec.len() {
    18	        let _ = fs::create_dir_all("/app/corkbay");
    19	        let _ = fs::write(
    20	            "/app/corkbay/seal.json",
    21	            "{\"served\":[],\"status\":\"open\"}\n",
    22	        );
    23	        return 1;
    24	    }
    25	    let served = names
    26	        .iter()
    27	        .map(|n| format!("\"{}\"", n))
    28	        .collect::<Vec<_>>()
    29	        .join(",");
    30	    let _ = fs::create_dir_all("/app/corkbay");
    31	    let text = format!("{{\"served\":[{}],\"status\":\"sealed\"}}\n", served);
    32	    let _ = fs::write("/app/corkbay/seal.json", text);
    33	    0
    34	}
===== /app/lidpit/tally.rs =====
     1	use std::fs;
     2	
     3	pub fn lines() -> usize {
     4	    fs::read_to_string("/app/loomkit/emit.lst")
     5	        .unwrap_or_default()
     6	        .lines()
     7	        .filter(|l| !l.trim().is_empty())
     8	        .count()
     9	}
