[9.810288, "o", "--- TREE ---\r\n"]
[9.814703, "o", "/app/bin/gasketd\r\n/app/buscards/a_fan.card\r\n/app/buscards/b_pump.card\r\n/app/buscards/c_valve.card\r\n/app/buscards/d_temp.card\r\n/app/buscards/e_press.card\r\n/app/buscards/f_latch.card\r\n/app/buscards/g_bias.card\r\n/app/buscards/h_watch.card\r\n/app/buscards/i_vent.card\r\n/app/cardbak/buscards/a_fan.card\r\n/app/cardbak/buscards/b_pump.card\r\n/app/cardbak/buscards/c_valve.card\r\n/app/cardbak/buscards/d_temp.card\r\n/app/cardbak/buscards/e_press.card\r\n/app/cardbak/buscards/f_latch.card\r\n/app/cardbak/buscards/g_bias.card\r\n/app/cardbak/buscards/h_watch.card\r\n/app/cardbak/buscards/i_vent.card\r\n/app/corkbay/seal.json\r\n/app/gaskcli/boot.rs\r\n/app/gaskcli/usage.txt\r\n/app/hopmat/table.rs\r\n/app/lidpit/plug.rs\r\n/app/lidpit/tally.rs\r\n/app/loomkit/emit.lst\r\n/app/loomkit/loom.rs\r\n/app/mistwell/roster.json\r\n/app/opscribe/COUNT_SRC.txt\r\n/app/opscribe/MAP.txt\r\n/app/rimcap/span.rs\r\n/app/slipread/scan.rs\r\n"]
[9.814896, "o", "/app/stoke.sh\r\n"]
[9.81511, "o", "\u001b[?2004hroot@2f2243bbe649:/app# "]
[10.773749, "i", "echo '--- bind ---'; /app/bin/gasketd bind; echo bind_rc=$?; cat /app/mistwell/roster.json 2>/dev/null; echo; echo '--- card jabs ---'; for f in /app/buscards/*; do w=$(sed -n 's/^WIRE[=:[:space:]]*//p' \"$f\"); [ -n \"$w\" ] && { printf '%s wire=%s: ' \"$f\" \"$w\"; /app/bin/gasketd jab \"$w\"; echo rc=$?; }; done; echo '--- cork ---'; /app/bin/gasketd cork; echo cork_rc=$?; cat /app/corkbay/seal.json 2>/dev/null; echo\n"]
[10.775091, "o", "echo '--- bind ---'; /app/bin/gasketd bind; echo bind_rc=$?; cat /app/mistwell/roster.json 2>/dev/null; echo; echo '--- card jabs ---'; for f in /app/buscards/*; do w=$(sed -n 's/^WIRE[=:[:space:]]*//p' \"$f\"); [ -n \"$w\" ] && { printf '%s wire=%s: ' \"$f\" \"$w\"; /app/bin/gasketd jab \"$w\"; echo rc=$?; }; done; echo '--- cork ---'; /app/bin/gasketd cork; echo cork_rc=$?; cat /app/corkbay/seal.json 2>/dev/null; echo\r\n\u001b[?2004l\r"]
