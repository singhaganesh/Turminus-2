[58.3562, "o", "\u001b[?2004h> "]
[58.356276, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r"]
[58.356317, "o", "\u001b[?2004h> "]
[58.357156, "o", "p='/app/gaskcli/boot.rs'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read().replace('let n: u8 = raw.parse().unwrap_or(0);', 'let n: i64 = raw.parse().unwrap_or(0);')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
