llthrough".to_string());\n    println!("{{\\"wire\\":{},\\"reply\\":{}}}", n, json_string(&reply));\n    0\n}\nEOF\ncat > /app/lidpit/plug.rs <<\'EOF\'\nuse crate::cards;\nuse crate::loom;\nuse crate::table;\nuse std::fs;\n\nfn json_string(value: &str) -> String {\n    let mut out = String::from("\\"");\n    for ch in value.chars() {\n        match ch {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if c <= \'\\u{1f}\' => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\npub fn rib_c() -> i32 {\n    // Refresh generated artifacts, but judge serviceability from the live hopper.\n    let _ = loom::emit();\n    let spec = cards::load();\n    let mut served = Vec::new();\n\n    for row in &spec {\n        if let Some(slot) = table::lookup(row.wire) {\n            if slot.label == row.label && slot.reply == row.reply {\n                served.push(row.label.clone());\n            }\n        }\n    }\n\n    let sealed = served.len() == spec.len();\n    let names = served\n        .iter()\n        .map(|name| json_string(name))\n        .collect::<Vec<_>>()\n        .join(",");\n    let status = if sealed { "sealed" } else { "open" };\n    let text = format!(\n        "{{\\"served\\":[{}],\\"status\\":\\"{}\\"}}\\n",\n        names, status\n    );\n    let _ = fs::create_dir_all("/app/corkbay");\n    if fs::write("/app/corkbay/seal.json", text).is_err() {\n        return 1;\n    }\n    if sealed { 0 } else { 1 }\n}\nEOF\n/app/stoke.sh\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
