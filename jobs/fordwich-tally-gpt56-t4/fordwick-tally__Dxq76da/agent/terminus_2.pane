[?2004l[?2004h> 
[?2004l[?2004h> def down(f,i,n): circle(f,50,10+2*i)
[?2004l[?2004h> def up(f,i,n): circle(f,50,110-2*i)
[?2004l[?2004h> def linger(f,i,n):
[?2004l[?2004h>  # crosses down, lingers, goes above, then crosses down again: same body => 1
[?2004l[?2004h>  if i<20: y=45+1.5*i
[?2004l[?2004h>  elif i<30: y=74
[?2004l[?2004h>  elif i<43: y=74-1.5*(i-30)
[?2004l[?2004h>  else: y=54+2*(i-43)
[?2004l[?2004h>  circle(f,60,y)
[?2004l[?2004h> def separate(f,i,n):
[?2004l[?2004h>  circle(f,35,15+1.7*i); circle(f,120,5+1.9*i,col=(60,30,130))
[?2004l[?2004h> def overlap(f,i,n):
[?2004l[?2004h>  # Different x initially, converge and fully overlap around scan, then split.
[?2004l[?2004h>  y=15+1.7*i
[?2004l[?2004h>  x1=55+min(i,30)*0.8 if i<30 else 79-(i-30)*0.8
[?2004l[?2004h>  x2=103-min(i,30)*0.8 if i<30 else 79+(i-30)*0.8
[?2004l[?2004h>  circle(f,x1,y,9); circle(f,x2,y,9,col=(40,100,30))
[?2004l[?2004h> def shade(f,i,n):
[?2004l[?2004h>  y=20+1.5*i
[?2004l[?2004h>  cv2.rectangle(f,(5,int(y)-3),(154,int(y)+3),(150,150,150),-1)
[?2004l[?2004h> def partial(f,i,n): circle(f,80,45+min(i,15)) # never centroid below line+2
