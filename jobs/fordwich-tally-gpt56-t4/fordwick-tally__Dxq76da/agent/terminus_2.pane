[?2004l[?2004h>     track["age"] += 1
[?2004l[?2004h>     track["missed"] = 0 if observed else track["missed"] + 1
[?2004l[?2004h>     if observed:
[?2004l[?2004h>         track["hits"] += 1
[?2004l[?2004h>     track["min_y"] = min(track["min_y"], ny)
[?2004l[?2004h>     track["max_y"] = max(track["max_y"], ny)
[?2004l[?2004h>     track["down"] += max(0.0, ny - oy)
[?2004l[?2004h> 
[?2004l[?2004h>     # Hysteresis ensures a centroid really completes passage, rather than
[?2004l[?2004h>     # jittering while it lies on the row.  Shared support permits crossings
[?2004l[?2004h>     # during a merge/occlusion using the established velocity.
[?2004l[?2004h>     if (not track["counted"] and track["hits"] >= 2 and
[?2004l[?2004h>             track["min_y"] <= LINE_Y - 2 and ny >= LINE_Y + 2 and
[?2004l[?2004h>             track["down"] >= 7 and track["vy"] > 0.25):
[?2004l[?2004h>         track["counted"] = True
[?2004l[?2004h>         return 1
[?2004lapp/varnish/mi[?2004h>     return 0
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def count_tracks(all_detections):
[?2004l[?2004h>     tracks = []
[?2004l[?2004h>     total = 0
[?2004l[?2004h>     next_id = 0
[?2004l[?2004h> 
[?2004l[?2004h>     for detections in all_detections:
[?2004l[?2004h>         live = [t for t in tracks if t["missed"] <= 18]
[?2004l[?2004h>         pairs = []
[?2004l[?2004h>         for ti, t in enumerate(live):
[?2004l[?2004h>             for di, d in enumerate(detections):
[?2004l[?2004h>                 distance = _dist(t, d)
[?2004l[?2004h>                 if distance <= 22:
[?2004l[?2004h>                     pairs.append((distance, ti, di))
[?2004l[?2004h>         pairs.sort()
[?2004l[?2004h>         used_t, used_d = set(), set()
[?2004l[?2004h> 
[?2004l[?2004h>         # Ordinary one-to-one association handles splits naturally.
[?2004l[?2004h>         for distance, ti, di in pairs:
[?2004l[?2004h>             if ti in used_t or di in used_d:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             t, d = live[ti], detections[di]
[?2004l[?2004h>             total += _advance(t, d["x"], d["y"], True)
[?2004l[?2004h>             t["area"] = 0.7 * t["area"] + 0.3 * d["area"]
[?2004l[?2004h>             used_t.add(ti); used_d.add(di)
[?2004l[?2004h> 
[?2004l[?2004h>         # A single silhouette may support several already established tracks.
[?2004l[?2004h>         # Keep each one's own predicted centroid rather than replacing all of
[?2004l[?2004h>         # them by the merged component centroid.
[?2004l[?2004h>         for ti, t in enumerate(live):
[?2004l[?2004h>             if ti in used_t or t["hits"] < 2:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             supporting = [d for d in detections if _inside_prediction(t, d)]
[?2004l[?2004h>             if supporting:
[?2004l[?2004h>                 px, py = t["x"] + t["vx"], t["y"] + t["vy"]
[?2004l[?2004h>                 total += _advance(t, px, py, True, shared=True)
[?2004l[?2004h>                 used_t.add(ti)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 t["missed"] += 1
[?2004l[?2004h>                 t["age"] += 1
[?2004l[?2004h> 
[?2004l[?2004h>         # Only compact components create identities. Broad shade can still
[?2004l[?2004h>         # support an existing track but can never become a body itself.
[?2004l[?2004h>         for di, d in enumerate(detections):
[?2004l[?2004h>             if di in used_d or not birthlike(d):
[?2004l[?2004h>                 continue
