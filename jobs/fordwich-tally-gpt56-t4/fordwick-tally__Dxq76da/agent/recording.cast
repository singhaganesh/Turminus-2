[10.286754, "o", "/app/varnish/packed.py\r\n"]
[10.289946, "o", "from __future__ import annotations\r\n\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\ndef make_mog():\r\n    return cv2.createBackgroundSubtractorMOG2(\r\n        history=30, varThreshold=16, detectShadows=True\r\n    )\r\n\r\n\r\ndef blot_mark(frame, mog) -> bool:\r\n    fg = mog.apply(frame)\r\n    _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n    y = int(LINE_Y)\r\n    band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n    return bool(band.any())\r\n\r\n\r\n\r\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n    if now:\r\n"]
[10.290057, "o", "        n += 1\r\n    return n, now\r\n\r\n\r\ndef fold_gate(n: int) -> int:\r\n    return n\r\n\r\n\r\nimport cv2\r\nimport toml\r\nfrom pathlib import Path\r\n\r\n\r\nSHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\r\n\r\ndef emit_span(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = make_mog()\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        now = blot_mark(frame, mog)\r\n        n, prev = knit_marks(now, prev, n)\r\n    cap.release()\r\n    return fold_gate(n)\r\n\r\n\r\ndef dump_sheet(n: int) -> None:\r\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n\r\n#!/usr/bin/env python3\r\n\r\nimport sys\r\n\r\n\r\n\r\ndef main() -> int:\r\n    if len(sys.argv) != 2:\r\n        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[10.290924, "o", "/app/kiln/pack.py\r\n"]
[10.292355, "o", "#!/usr/bin/env python3\r\n\"\"\"Fold blot/tether/spout/spanwell into /app/varnish/mill.pyc.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport py_compile\r\nfrom pathlib import Path\r\n\r\nROOT = Path(\"/app\")\r\nPARTS = [\r\n    ROOT / \"blot.py\",\r\n    ROOT / \"tether.py\",\r\n    ROOT / \"spout.py\",\r\n    ROOT / \"spanwell.py\",\r\n"]
[10.29253, "o", "]\r\nSKIP_PREFIXES = (\r\n    \"from blot \",\r\n    \"import blot\",\r\n    \"from tether \",\r\n    \"import tether\",\r\n    \"from spout \",\r\n    \"import spout\",\r\n)\r\n\r\n\r\ndef _strip(text: str) -> tuple[list[str], list[str]]:\r\n    futures: list[str] = []\r\n    keep: list[str] = []\r\n    for line in text.splitlines():\r\n        stripped = line.strip()\r\n        if any(stripped.startswith(p) for p in SKIP_PREFIXES):\r\n            continue\r\n        if stripped.startswith(\"from __future__ import\"):\r\n            if stripped not in futures:\r\n                futures.append(stripped)\r\n            continue\r\n        keep.append(line)\r\n    return futures, keep\r\n\r\n\r\ndef main() -> None:\r\n    out_dir = ROOT / \"varnish\"\r\n    out_dir.mkdir(parents=True, exist_ok=True)\r\n    packed = out_dir / \"packed.py\"\r\n    all_future: list[str] = []\r\n    bodies: list[str] = []\r\n    for p in PARTS:\r\n        futures, keep = _strip(p.read_text(encoding=\"utf-8\"))\r\n        for item in futures:\r\n            if item not in all_future:\r\n                all_future.append(item)\r\n        bodies.append(\"\\n\".join(keep))\r\n    packed.write_text(\"\\n\".join(all_future) + \"\\n\\n\" + \"\\n\\n\".join(bodies) + \"\\n\", encoding=\"utf-8\")\r\n    py_compile.compile(str(packed), cfile=str(out_dir / \"mill.pyc\"), doraise=True)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[10.29279, "o", "/app/kiln/bake.sh\r\n"]
[10.294288, "o", "#!/usr/bin/env bash\r\nset -euo pipefail\r\npython3 /app/kiln/pack.py\r\n"]
[10.29486, "o", "/app/wickpit/__init__.py\r\n"]
[10.296442, "o", "/app/wickpit/touchcue.py\r\n"]
[10.297591, "o", "#!/usr/bin/env python3\r\n\"\"\"Desk helper: rising occupancy on the scan row.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n"]
[10.297724, "o", "\r\ndef occupancy_edges(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = cv2.createBackgroundSubtractorMOG2(history=30, varThreshold=16, detectShadows=True)\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        fg = mog.apply(frame)\r\n        _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n        y = int(LINE_Y)\r\n        band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n        now = bool(band.any())\r\n        if now and not prev:\r\n            n += 1\r\n        prev = now\r\n    cap.release()\r\n    return n\r\n"]
[10.297949, "o", "/app/spanwell.py\r\n"]
[10.299265, "o", "#!/usr/bin/env python3\r\nfrom __future__ import annotations\r\n\r\nimport sys\r\n\r\nfrom spout import dump_sheet, emit_span\r\n\r\n\r\n"]
[10.299357, "o", "def main() -> int:\r\n    if len(sys.argv) != 2:\r\n        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[10.299511, "o", "/app/spout.py\r\n"]
[10.300711, "o", "from __future__ import annotations\r\n\r\nimport cv2\r\nimport toml\r\nfrom pathlib import Path\r\n\r\nfrom blot import blot_mark, make_mog\r\nfrom tether import fold_gate, knit_marks\r\n\r\nSHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\r\n\r\ndef emit_span(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = make_mog()\r\n    prev = False\r\n"]
[10.300815, "o", "    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        now = blot_mark(frame, mog)\r\n        n, prev = knit_marks(now, prev, n)\r\n    cap.release()\r\n    return fold_gate(n)\r\n\r\n\r\ndef dump_sheet(n: int) -> None:\r\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n"]
[10.301003, "o", "/app/tether.py\r\n"]
[10.302088, "o", "from __future__ import annotations\r\n\r\n\r\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n    if now:\r\n        n += 1\r\n    return n, now\r\n\r\n\r\n"]
[10.302188, "o", "def fold_gate(n: int) -> int:\r\n    return n\r\n"]
[10.302309, "o", "/app/blot.py\r\n"]
[10.303382, "o", "from __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\ndef make_mog():\r\n    return cv2.createBackgroundSubtractorMOG2(\r\n        history=30, varThreshold=16, detectShadows=True\r\n    )\r\n"]
[10.303465, "o", "\r\n\r\ndef blot_mark(frame, mog) -> bool:\r\n    fg = mog.apply(frame)\r\n    _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n    y = int(LINE_Y)\r\n    band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n    return bool(band.any())\r\n"]
[10.303919, "o", "\u001b[?2004hroot@91388a22626d:/app# "]
[30.849515, "i", "python3 - <<'PY'\nimport cv2\np='/app/shown.mp4'; c=cv2.VideoCapture(p)\nprint('opened',c.isOpened(),'frames',int(c.get(cv2.CAP_PROP_FRAME_COUNT)),'fps',c.get(cv2.CAP_PROP_FPS),'size',int(c.get(cv2.CAP_PROP_FRAME_WIDTH)),int(c.get(cv2.CAP_PROP_FRAME_HEIGHT)))\nframes=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n frames.append(f)\nc.release(); print('decoded',len(frames))\n# evenly sampled contact sheet\nimport numpy as np\nids=np.linspace(0,len(frames)-1,min(24,len(frames))).astype(int)\nthumb=[]\nfor i in ids:\n f=frames[i].copy(); cv2.line(f,(0,70),(159,70),(0,0,255),1); cv2.putText(f,str(i),(2,12),0,.4,(0,255,255),1); thumb.append(f)\nrows=[np.hstack(thumb[i:i+6]) for i in range(0,len(thumb),6)]\nwhile len(rows[-1])<rows[0].shape[1]: rows[-1]=np.hstack((rows[-1],np.zeros((120,160,3),np.uint8)))\ncv2.imwrite('/app/contact.jpg',np.vstack(rows))\nprint('wrote /app/contact.jpg',ids.tolist())\nPY\npython3 /app/varnish/mill.pyc /app/shown.mp4; cat /app/inkwell/sheet.toml\n"]
