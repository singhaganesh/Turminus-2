[266.121258, "i", "python3 - <<'PY'\np='/app/blot.py'\ns=open(p).read()\ns=s.replace('background = np.median(stack, axis=0).astype(np.uint8)', '# Bodies and cast shade are darker than the stationary yard.  An upper\\n    # percentile avoids burning a body into the background when it lingers.\\n    background = np.percentile(stack, 80, axis=0).astype(np.uint8)')\ns=s.replace('A temporal median is substantially less prone than a short MOG history to\\n    absorbing a slowly moving body.', 'A robust temporal background is substantially less prone than a short MOG\\n    history to absorbing a slowly moving body.')\nopen(p,'w').write(s)\n\np='/app/tether.py'; s=open(p).read()\nold='''            supporting = [d for d in detections if _inside_prediction(t, d)]\n            if supporting:\n                px, py = t[\"x\"] + t[\"vx\"], t[\"y\"] + t[\"vy\"]\n                total += _advance(t, px, py, True, shared=True)\n                used_t.add(ti)\n            else:\n'''\nnew='''            supporting = [d for d in detections if _inside_prediction(t, d)]\n            # Sharing is justified only for a genuinely enlarged merged blob.\n            # This prevents two duplicate/noise tracks riding one normal body.\n            merged = None\n            for d in supporting:\n                owners = [q for q in live if q[\"hits\"] >= 2 and _inside_prediction(q, d)]\n                expected = sum(q[\"area\"] for q in owners)\n                if len(owners) >= 2 and d[\"area\"] >= 0.58 * expected:\n                    merged = d\n                    break\n            if merged is not None:\n                px, py = t[\"x\"] + t[\"vx\"], t[\"y\"] + t[\"vy\"]\n                total += _advance(t, px, py, True, shared=True)\n                used_t.add(ti)\n            else:\n'''\nif old not in s: raise SystemExit('target block not found')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\n/app/kiln/bake.sh\npython3 /tmp/testmill.py\npython3 /app/varnish/mill.pyc /app/shown.mp4; echo sample_rc=$?; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo unreadable_rc=$?; test ! -e /app/inkwell/sheet.toml && echo sheet_absent\npython3 -m py_compile /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py /app/kiln/pack.py\npython3 /app/varnish/mill.pyc /app/shown.mp4; cat /app/inkwell/sheet.toml\n"]
