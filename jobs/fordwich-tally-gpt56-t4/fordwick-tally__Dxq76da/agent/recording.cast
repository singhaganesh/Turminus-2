[142.697118, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef foreground_masks(frames):\n    \"\"\"Make conservative foreground masks from the whole reel.\n\n    A temporal median is substantially less prone than a short MOG history to\n    absorbing a slowly moving body.  Channel maximum difference also works on\n    coloured bodies whose grey values happen to match the floor.\n    \"\"\"\n    stack = np.asarray(frames, dtype=np.uint8)\n    background = np.median(stack, axis=0).astype(np.uint8)\n    masks = []\n    kernel = np.ones((3, 3), np.uint8)\n    for frame in frames:\n        d = cv2.absdiff(frame, background)\n        score = np.max(d, axis=2)\n        mask = (score >= 18).astype(np.uint8) * 255\n        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)\n        masks.append(mask)\n    return masks\n\n\ndef find_bodies(mask):\n    \"\"\"Return component measurements; classification is done by the tracker.\"\"\"\n    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    out = []\n    for contour in contours:\n        area = float(cv2.contourArea(contour))\n        if area < 18:\n            continue\n        x, y, w, h = cv2.boundingRect(contour)\n        if w < 3 or h < 3:\n            continue\n        mom = cv2.moments(contour)\n        if mom[\"m00\"]:\n            cx = float(mom[\"m10\"] / mom[\"m00\"])\n            cy = float(mom[\"m01\"] / mom[\"m00\"])\n        else:\n            cx, cy = x + w / 2.0, y + h / 2.0\n        out.append({\"x\": cx, \"y\": cy, \"box\": (x, y, w, h), \"area\": area})\n    return out\n\n\ndef birthlike(det):\n    \"\"\"Long sweeping bands are shade, not bodies; merged blobs remain usable.\"\"\"\n    _, _, w, h = det[\"box\"]\n    if w > 48 and w > 3.0 * h:\n        return False\n    if h > 70 and h > 4.0 * w:\n        return False\n    if det[\"area\"] > 2800:\n        return False\n    return True\nPY\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport math\nfrom blot import LINE_Y, birthlike\n\n\ndef _dist(track, det):\n    px = track[\"x\"] + track[\"vx\"]\n    py = track[\"y\"] + track[\"vy\"]\n    return math.hypot(px - det[\"x\"], py - det[\"y\"])\n\n\ndef _inside_prediction(track, det, pad=7):\n    x, y, w, h = det[\"box\"]\n    px = track[\"x\"] + track[\"vx\"]\n    py = track[\"y\"] + track[\"vy\"]\n    return x - pad <= px <= x + w + pad and y - pad <= py <= y + h + pad\n\n\ndef _advance(track, nx, ny, observed, shared=False):\n    ox, oy = track[\"x\"], track[\"y\"]\n    dx, dy = nx - ox, ny - oy\n    if observed and not shared:\n        track[\"vx\"] = 0.55 * track[\"vx\"] + 0.45 * dx\n        track[\"vy\"] = 0.55 * track[\"vy\"] + 0.45 * dy\n    track[\"x\"], track[\"y\"] = nx, ny\n    track[\"age\"] += 1\n    track[\"missed\"] = 0 if observed else track[\"missed\"] + 1\n    if observed:\n        track[\"hits\"] += 1\n    track[\"min_y\"] = min(track[\"min_y\"], ny)\n    track[\"max_y\"] = max(track[\"max_y\"], ny)\n    track[\"down\"] += max(0.0, ny - oy)\n\n    # Hysteresis ensures a centroid really completes passage, rather than\n    # jittering while it lies on the row.  Shared support permits crossings\n    # during a merge/occlusion using the established velocity.\n    if (not track[\"counted\"] and track[\"hits\"] >= 2 and\n            track[\"min_y\"] <= LINE_Y - 2 and ny >= LINE_Y + 2 and\n            track[\"down\"] >= 7 and track[\"vy\"] > 0.25):\n        track[\"counted\"] = True\n        return 1\n    return 0\n\n\ndef count_tracks(all_detections):\n    tracks = []\n    total = 0\n    next_id = 0\n\n    for detections in all_detections:\n        live = [t for t in tracks if t[\"missed\"] <= 18]\n        pairs = []\n        for ti, t in enumerate(live):\n            for di, d in enumerate(detections):\n                distance = _dist(t, d)\n                if distance <= 22:\n                    pairs.append((distance, ti, di))\n        pairs.sort()\n        used_t, used_d = set(), set()\n\n        # Ordinary one-to-one association handles splits naturally.\n        for distance, ti, di in pairs:\n            if ti in used_t or di in used_d:\n                continue\n            t, d = live[ti], detections"]
[142.703468, "i", "[di]\n            total += _advance(t, d[\"x\"], d[\"y\"], True)\n            t[\"area\"] = 0.7 * t[\"area\"] + 0.3 * d[\"area\"]\n            used_t.add(ti); used_d.add(di)\n\n        # A single silhouette may support several already established tracks.\n        # Keep each one's own predicted centroid rather than replacing all of\n        # them by the merged component centroid.\n        for ti, t in enumerate(live):\n            if ti in used_t or t[\"hits\"] < 2:\n                continue\n            supporting = [d for d in detections if _inside_prediction(t, d)]\n            if supporting:\n                px, py = t[\"x\"] + t[\"vx\"], t[\"y\"] + t[\"vy\"]\n                total += _advance(t, px, py, True, shared=True)\n                used_t.add(ti)\n            else:\n                t[\"missed\"] += 1\n                t[\"age\"] += 1\n\n        # Only compact components create identities. Broad shade can still\n        # support an existing track but can never become a body itself.\n        for di, d in enumerate(detections):\n            if di in used_d or not birthlike(d):\n                continue\n            tracks.append({\"id\": next_id, \"x\": d[\"x\"], \"y\": d[\"y\"],\n                           \"vx\": 0.0, \"vy\": 0.0, \"area\": d[\"area\"],\n                           \"hits\": 1, \"age\": 1, \"missed\": 0,\n                           \"min_y\": d[\"y\"], \"max_y\": d[\"y\"],\n                           \"down\": 0.0, \"counted\": False})\n            next_id += 1\n\n    return total\nPY\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import find_bodies, foreground_masks\nfrom tether import count_tracks\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('bad frame geometry')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('clip has no decodable frames')\n    masks = foreground_masks(frames)\n    return int(count_tracks([find_bodies(mask) for mask in masks]))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    temporary = SHEET.with_suffix('.tmp')\n    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    temporary.replace(SHEET)\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    # Never leave an old answer that can be mistaken for this invocation.\n    try:\n        SHEET.unlink(missing_ok=True)\n    except OSError:\n        return 1\n    if len(sys.argv) != 2:\n        return 2\n    try:\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n    except Exception as exc:\n        print(f'mill: {exc}', file=sys.stderr)\n        try:\n            SHEET.unlink(missing_ok=True)\n        except OSError:\n            pass\n        return 1\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; echo sample_rc=$?; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo unreadable_rc=$?; if test -e /app/inkwell/sheet.toml; then echo ERROR_sheet_exists; else echo sheet_absent; fi\n"]
