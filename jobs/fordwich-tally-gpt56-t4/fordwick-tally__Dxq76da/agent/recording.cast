[210.540694, "o", "\u001b[?2004h> "]
[210.540739, "o", "import cv2\r\n\u001b[?2004l\r\u001b[?2004h> import blot, tether\r\n"]
[210.540759, "o", "\u001b[?2004l\r"]
[210.540927, "o", "\u001b[?2004h> "]
[210.541087, "o", "cap=cv2.VideoCapture('/tmp/linger.mp4'); fs=[]\r\n\u001b[?2004l\r\u001b[?2004h> while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.541112, "o", " ok,f=cap.read()\r\n\u001b[?2004l\r"]
[210.541353, "o", "\u001b[?2004h>  if not ok: break\r\n\u001b[?2004l\r\u001b[?2004h>  fs.append(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
