[142.707653, "o", "\u001b[?2004h> "]
[142.707837, "o", "        masks.append(mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.708146, "o", ">     return masks\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def find_bodies(mask):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return component measurements; classification is done by the tracker.\"\"\"\r\n\u001b[?2004l\r"]
[142.708237, "o", "\u001b[?2004h"]
[142.708313, "o", "> "]
[142.708532, "o", "    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\r\n\u001b[?2004l\r"]
[142.708596, "o", "\u001b[?2004h> "]
[142.708684, "o", "    out = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.708803, "o", "    for contour in contours:\r\n\u001b[?2004l\r"]
[142.708876, "o", "\u001b[?2004h> "]
[142.709097, "o", "        area = float(cv2.contourArea(contour))\r\n\u001b[?2004l\r"]
[142.709158, "o", "\u001b[?2004h> "]
[142.709217, "o", "        if area < 18:\r\n\u001b[?2004l\r"]
[142.709278, "o", "\u001b[?2004h> "]
[142.709352, "o", "            continue\r\n\u001b[?2004l\r               "]
[142.709433, "o", "\u001b[?2004h> "]
[142.710988, "o", "        x, y, w, h = cv2.boundingRect(contour)\r\n\u001b[?2004l\r\u001b[?2004h>         if w < 3 or h < 3:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         mom = cv2.moments(contour)\r\n\u001b[?2004l\r\u001b[?2004h>         if mom[\"m00\"]:\r\n\u001b[?2004l\r\u001b[?2004h>             cx = float(mom[\"m10\"] / mom[\"m00\"])\r\n\u001b[?2004l\r\u001b[?2004h>             cy = float(mom[\"m01\"] / mom[\"m00\"])\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             cx, cy = x + w / 2.0, y + h / 2.0\r\n\u001b[?2004l\r\u001b[?2004h>         out.append({\"x\": cx, \"y\": cy, \"box\": (x, y, w, h), \"area\": area})\r\n\u001b[?2004l\r"]
[142.711109, "o", "\u001b[?2004h>     return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.711178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.711277, "o", "def birthlike(det):\r\n\u001b[?2004l\r"]
[142.711352, "o", "\u001b[?2004h> "]
[142.711622, "o", "    \"\"\"Long sweeping bands are shade, not bodies; merged blobs remain usable.\"\"\"\r\n\u001b[?2004l\r"]
[142.711687, "o", "\u001b[?2004h> "]
[142.711796, "o", "    _, _, w, h = det[\"box\"]\r\n\u001b[?2004l\r"]
[142.711868, "o", "\u001b[?2004h> "]
[142.711952, "o", "    if w > 48 and w > 3.0 * h:\r\n\u001b[?2004l\r"]
[142.71198, "o", "\u001b[?2004h> "]
[142.712068, "o", "        return False\r\n\u001b[?2004l\r"]
[142.712133, "o", "\u001b[?2004h> "]
[142.712263, "o", "    if h > 70 and h > 4.0 * w:\r\n\u001b[?2004l\r"]
[142.712338, "o", "\u001b[?2004h"]
[142.712437, "o", ">         return False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.712591, "o", "    if det[\"area\"] > 2800:\r\n\u001b[?2004l\r"]
[142.712701, "o", "\u001b[?2004h> "]
[142.712822, "o", "        return False\r\n\u001b[?2004l\r"]
[142.712939, "o", "\u001b[?2004h> "]
[142.713028, "o", "    return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.713117, "o", "PY\r\n\u001b[?2004l\r"]
[142.714793, "o", "\u001b[?2004hroot@91388a22626d:/app# "]
[142.714931, "o", "cat > /app/tether.py <<'PY'\r\n\u001b[?2004l\r"]
[142.714991, "o", "\u001b[?2004h"]
[142.715066, "o", "> "]
[142.715158, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[142.715258, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.715341, "o", "import math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.715486, "o", "from blot import LINE_Y, birthlike\r\n\u001b[?2004l\r"]
[142.715564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.715634, "o", "\u001b[?2004h> "]
[142.715791, "o", "def _dist(track, det):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.715919, "o", "    px = track[\"x\"] + track[\"vx\"]\r\n\u001b[?2004l\r"]
[142.715982, "o", "\u001b[?2004h> "]
[142.71608, "o", "    py = track[\"y\"] + track[\"vy\"]\r\n\u001b[?2004l\r"]
[142.716137, "o", "\u001b[?2004h> "]
[142.716334, "o", "    return math.hypot(px - det[\"x\"], py - det[\"y\"])\r\n\u001b[?2004l\r"]
[142.716407, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[142.716485, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[142.716603, "o", "def _inside_prediction(track, det, pad=7):\r\n\u001b[?2004l\r"]
[142.71667, "o", "\u001b[?2004h> "]
[142.716775, "o", "    x, y, w, h = det[\"box\"]\r\n\u001b[?2004l\r"]
[142.716839, "o", "\u001b[?2004h> "]
[142.716959, "o", "    px = track[\"x\"] + track[\"vx\"]\r\n\u001b[?2004l\r"]
[142.717018, "o", "\u001b[?2004h> "]
[142.717141, "o", "    py = track[\"y\"] + track[\"vy\"]\r\n\u001b[?2004l\r"]
[142.717196, "o", "\u001b[?2004h> "]
[142.717402, "o", "    return x - pad <= px <= x + w + pad and y - pad <= py <= y + h + pad\r\n\u001b[?2004l\r"]
[142.717452, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.717514, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rh"]
[142.717576, "o", "\u001b[?2004h> "]
[142.717777, "o", "def _advance(track, nx, ny, observed, shared=False):\r\n\u001b[?2004l\r"]
[142.717851, "o", "\u001b[?2004h> "]
[142.717979, "o", "    ox, oy = track[\"x\"], track[\"y\"]\r\n\u001b[?2004l\r"]
[142.718059, "o", "\u001b[?2004h> "]
[142.718135, "o", "    dx, dy = nx - ox, ny - oy\r\n\u001b[?2004l\r"]
[142.718207, "o", "\u001b[?2004h> "]
[142.718328, "o", "    if observed and not shared:\r\n\u001b[?2004l\r"]
[142.718394, "o", "\u001b[?2004h> "]
[142.718534, "o", "        track[\"vx\"] = 0.55 * track[\"vx\"] + 0.45 * dx\r\n\u001b[?2004l\r"]
[142.718603, "o", "\u001b[?2004h> "]
[142.718794, "o", "        track[\"vy\"] = 0.55 * track[\"vy\"] + 0.45 * dy\r\n\u001b[?2004l\r"]
[142.718863, "o", "\u001b[?2004h> "]
[142.718965, "o", "    track[\"x\"], track[\"y\"] = nx, ny\r\n\u001b[?2004l\r"]
[142.719027, "o", "\u001b[?2004h> "]
[142.719116, "o", "    track[\"age\"] += 1\r\n\u001b[?2004l\r"]
[142.719182, "o", "\u001b[?2004h> "]
[142.719382, "o", "    track[\"missed\"] = 0 if observed else track[\"missed\"] + 1\r\n\u001b[?2004l\r"]
[142.71944, "o", "\u001b[?2004h> "]
[142.719505, "o", "    if observed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.719572, "o", "> "]
[142.719642, "o", "        track[\"hits\"] += 1\r\n\u001b[?2004l\r"]
[142.719704, "o", "\u001b[?2004h> "]
[142.71986, "o", "    track[\"min_y\"] = min(track[\"min_y\"], ny)\r\n\u001b[?2004l\r"]
[142.719926, "o", "\u001b[?2004h> "]
[142.720066, "o", "    track[\"max_y\"] = max(track[\"max_y\"], ny)\r\n\u001b[?2004l\r"]
[142.720123, "o", "\u001b[?2004h> "]
[142.720265, "o", "    track[\"down\"] += max(0.0, ny - oy)\r\n\u001b[?2004l\r"]
[142.72033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.720606, "o", "    # Hysteresis ensures a centroid really completes passage, rather than\r\n\u001b[?2004l\r"]
[142.720664, "o", "\u001b[?2004h> "]
[142.720903, "o", "    # jittering while it lies on the row.  Shared support permits crossings\r\n\u001b[?2004l\r"]
[142.720972, "o", "\u001b[?2004h> "]
[142.721192, "o", "    # during a merge/occlusion using the established velocity.\r\n\u001b[?2004l\r"]
[142.721254, "o", "\u001b[?2004h> "]
[142.721489, "o", "    if (not track[\"counted\"] and track[\"hits\"] >= 2 and\r\n\u001b[?2004l\r"]
[142.721703, "o", "\u001b[?2004h> "]
[142.722121, "o", "            track[\"min_y\"] <= LINE_Y - 2 and ny >= LINE_Y + 2 and\r\n\u001b[?2004l\r"]
[142.722253, "o", "\u001b[?2004h> "]
[142.722496, "o", "            track[\"down\"] >= 7 and track[\"vy\"] > 0.25):\r\n\u001b[?2004l\r"]
[142.722658, "o", "\u001b[?2004h> "]
[142.722879, "o", "        track[\"counted\"] = True\r\n\u001b[?2004l\r"]
[142.723138, "o", "\u001b[?2004h>         return 1\r\n\u001b[?2004l\rapp/varnish/mi\u001b[?2004h"]
[142.723351, "o", ">     return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.7249, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> def count_tracks(all_detections):\r\n\u001b[?2004l\r\u001b[?2004h>     tracks = []\r\n\u001b[?2004l\r\u001b[?2004h>     total = 0\r\n\u001b[?2004l\r\u001b[?2004h>     next_id = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for detections in all_detections:\r\n\u001b[?2004l\r\u001b[?2004h>         live = [t for t in tracks if t[\"missed\"] <= 18]\r\n\u001b[?2004l\r\u001b[?2004h>         pairs = []\r\n\u001b[?2004l\r\u001b[?2004h>         for ti, t in enumerate(live):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.725262, "o", "            for di, d in enumerate(detections):\r\n\u001b[?2004l\r\u001b[?2004h>                 distance = _dist(t, d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.725393, "o", "                if distance <= 22:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.725616, "o", "                    pairs.append((distance, ti, di))\r\n\u001b[?2004l\r"]
[142.725765, "o", "\u001b[?2004h> "]
[142.725896, "o", "        pairs.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.726011, "o", "        used_t, used_d = set(), set()\r\n\u001b[?2004l\r"]
[142.726528, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         # Ordinary one-to-one association handles splits naturally.\r\n\u001b[?2004l\r\u001b[?2004h>         for distance, ti, di in pairs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.726648, "o", "            if ti in used_t or di in used_d:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.726735, "o", "                continue\r\n\u001b[?2004l\r"]
[142.726811, "o", "\u001b[?2004h> "]
[142.726902, "o", "            t, d = live[ti], detections[di]\r\n\u001b[?2004l\r"]
[142.727053, "o", "\u001b[?2004h> "]
[142.727154, "o", "            total += _advance(t, d[\"x\"], d[\"y\"], True)\r\n\u001b[?2004l\r"]
[142.727231, "o", "\u001b[?2004h> "]
[142.727365, "o", "            t[\"area\"] = 0.7 * t[\"area\"] + 0.3 * d[\"area\"]\r\n\u001b[?2004l\r"]
[142.727446, "o", "\u001b[?2004h> "]
[142.727507, "o", "            used_t.add(ti); used_d.add(di)\r\n\u001b[?2004l\r"]
[142.727576, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.727643, "o", "\u001b[?2004h> "]
[142.727828, "o", "        # A single silhouette may support several already established tracks.\r\n\u001b[?2004l\r"]
[142.727901, "o", "\u001b[?2004h"]
[142.728, "o", "> "]
[142.728086, "o", "        # Keep each one's own predicted centroid rather than replacing all of\r\n\u001b[?2004l\r"]
[142.728161, "o", "\u001b[?2004h> "]
[142.728269, "o", "        # them by the merged component centroid.\r\n\u001b[?2004l\r"]
[142.728354, "o", "\u001b[?2004h> "]
[142.728415, "o", "        for ti, t in enumerate(live):\r\n\u001b[?2004l\r"]
[142.728453, "o", "\u001b[?2004h> "]
[142.728593, "o", "            if ti in used_t or t[\"hits\"] < 2:\r\n\u001b[?2004l\r"]
[142.72867, "o", "\u001b[?2004h"]
[142.728736, "o", ">                 continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.729092, "o", "> "]
[142.729407, "o", "            supporting = [d for d in detections if _inside_prediction(t, d)]\r\n\u001b[?2004l\r"]
[142.729524, "o", "\u001b[?2004h> "]
[142.729632, "o", "            if supporting:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.729827, "o", "                px, py = t[\"x\"] + t[\"vx\"], t[\"y\"] + t[\"vy\"]\r\n\u001b[?2004l\r"]
[142.729938, "o", "\u001b[?2004h> "]
[142.730163, "o", "                total += _advance(t, px, py, True, shared=True)\r\n\u001b[?2004l\r"]
[142.730255, "o", "\u001b[?2004h> "]
[142.730338, "o", "                used_t.add(ti)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.730453, "o", "            else:\r\n\u001b[?2004l\r"]
[142.73055, "o", "\u001b[?2004h> "]
[142.73064, "o", "                t[\"missed\"] += 1\r\n\u001b[?2004l\r"]
[142.73073, "o", "\u001b[?2004h> "]
[142.730847, "o", "                t[\"age\"] += 1\r\n\u001b[?2004l\r"]
[142.730928, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.731103, "o", "        # Only compact components create identities. Broad shade can still\r\n\u001b[?2004l\r"]
[142.731166, "o", "\u001b[?2004h> "]
[142.731335, "o", "        # support an existing track but can never become a body itself.\r\n\u001b[?2004l\r"]
[142.731389, "o", "\u001b[?2004h> "]
[142.731492, "o", "        for di, d in enumerate(detections):\r\n\u001b[?2004l\r"]
[142.731555, "o", "\u001b[?2004h> "]
[142.731679, "o", "            if di in used_d or not birthlike(d):\r\n\u001b[?2004l\r"]
[142.731761, "o", "\u001b[?2004h> "]
[142.731817, "o", "                continue\r\n\u001b[?2004l\r"]
[142.731878, "o", "\u001b[?2004h> "]
[142.732077, "o", "            tracks.append({\"id\": next_id, \"x\": d[\"x\"], \"y\": d[\"y\"],\r\n\u001b[?2004l\r"]
[142.732139, "o", "\u001b[?2004h> "]
[142.73231, "o", "                           \"vx\": 0.0, \"vy\": 0.0, \"area\": d[\"area\"],\r\n\u001b[?2004l\r"]
[142.732363, "o", "\u001b[?2004h> "]
[142.732512, "o", "                           \"hits\": 1, \"age\": 1, \"missed\": 0,\r\n\u001b[?2004l\r"]
[142.732565, "o", "\u001b[?2004h> "]
[142.732712, "o", "                           \"min_y\": d[\"y\"], \"max_y\": d[\"y\"],\r\n\u001b[?2004l\r"]
[142.732788, "o", "\u001b[?2004h> "]
[142.733009, "o", "                           \"down\": 0.0, \"counted\": False})\r\n\u001b[?2004l\r"]
[142.733093, "o", "\u001b[?2004h> "]
[142.733207, "o", "            next_id += 1\r\n\u001b[?2004l\r"]
[142.733277, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.733358, "o", "\u001b[?2004h> "]
[142.733462, "o", "    return total\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[142.735144, "o", "\u001b[?2004hroot@91388a22626d:/app# cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.735247, "o", "import cv2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.735338, "o", "import toml\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.735415, "o", "from blot import find_bodies, foreground_masks\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.735484, "o", "> "]
[142.73554, "o", "from tether import count_tracks\r\n\u001b[?2004l\r"]
[142.735602, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.735716, "o", "SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r"]
[142.735782, "o", "\u001b[?2004h"]
[142.735865, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.735897, "o", "\u001b[?2004h> "]
[142.735917, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r"]
[142.735935, "o", "\u001b[?2004h"]
[142.736205, "o", ">     cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.736254, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r\u001b[?2004h>         cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.736346, "o", "        raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[142.736399, "o", "\u001b[?2004h"]
[142.736464, "o", ">     frames = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.736569, "o", "    while True:\r\n\u001b[?2004l\r"]
[142.736628, "o", "\u001b[?2004h>         ok, frame = cap.read()\r\n\u001b[?2004l\r"]
[142.736675, "o", "\u001b[?2004h> "]
[142.736741, "o", "        if not ok:\r\n\u001b[?2004l\r"]
[142.736797, "o", "\u001b[?2004h> "]
[142.736844, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.736981, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r"]
[142.737027, "o", "\u001b[?2004h> "]
[142.737079, "o", "            cap.release()\r\n\u001b[?2004l\r"]
[142.73713, "o", "\u001b[?2004h> "]
[142.737237, "o", "            raise ValueError('bad frame geometry')\r\n\u001b[?2004l\r"]
[142.737299, "o", "\u001b[?2004h> "]
[142.737364, "o", "        frames.append(frame)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.737423, "o", "    cap.release()\r\n\u001b[?2004l\r"]
[142.737487, "o", "\u001b[?2004h> "]
[142.73755, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.737677, "o", "        raise OSError('clip has no decodable frames')\r\n\u001b[?2004l\r"]
[142.737751, "o", "\u001b[?2004h> "]
[142.737824, "o", "    masks = foreground_masks(frames)\r\n\u001b[?2004l\r"]
[142.737884, "o", "\u001b[?2004h> "]
[142.738069, "o", "    return int(count_tracks([find_bodies(mask) for mask in masks]))\r\n\u001b[?2004l\r"]
[142.73816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[142.738262, "o", "\u001b[?2004h> "]
[142.738494, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.738594, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.738704, "o", "> "]
[142.738839, "o", "    temporary = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.739113, "o", "    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r"]
[142.739289, "o", "\u001b[?2004h> "]
[142.7409, "o", "    temporary.replace(SHEET)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[142.742177, "o", "\u001b[?2004hroot@91388a22626d:/app# "]
[142.74235, "o", "cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[142.742388, "o", "\u001b[?2004h> "]
[142.742482, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[142.742507, "o", "\u001b[?2004h> "]
[142.742662, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[142.742798, "o", "\u001b[?2004h"]
[142.742877, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[142.742917, "o", "\u001b[?2004h> "]
[142.743127, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[142.743207, "o", "\u001b[?2004h> "]
[142.74327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.743377, "o", "def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.743573, "o", "    # Never leave an old answer that can be mistaken for this invocation.\r\n\u001b[?2004l\r"]
[142.74363, "o", "\u001b[?2004h> "]
[142.743701, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.743792, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[142.743849, "o", "\u001b[?2004h> "]
[142.743902, "o", "    except OSError:\r\n\u001b[?2004l\r"]
[142.743961, "o", "\u001b[?2004h> "]
[142.744022, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.744081, "o", "> "]
[142.744148, "o", "    if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.744201, "o", "> "]
[142.74428, "o", "        return 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.744359, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.744463, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[142.744528, "o", "\u001b[?2004h> "]
[142.744594, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.74468, "o", "    except Exception as exc:\r\n\u001b[?2004l\r"]
[142.744772, "o", "\u001b[?2004h> "]
[142.744888, "o", "        print(f'mill: {exc}', file=sys.stderr)\r\n\u001b[?2004l\r"]
[142.744966, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[142.74506, "o", "\u001b[?2004h> "]
[142.745136, "o", "            SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[142.745208, "o", "\u001b[?2004h> "]
[142.745275, "o", "        except OSError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.745334, "o", "> "]
[142.745408, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.745473, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.745544, "o", ">     return 0\r\n\u001b[?2004l\r"]
[142.745696, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.745816, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.745955, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.746065, "o", "PY\r\n\u001b[?2004l\r"]
[142.747826, "o", "\u001b[?2004hroot@91388a22626d:/app# "]
[142.747963, "o", "/app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[142.803837, "o", "\u001b[?2004hroot@91388a22626d:/app# "]
[142.804127, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; echo sample_rc=$?; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[143.26007, "o", "sample_rc=0\r\n"]
[143.261109, "o", "crossings = 3\r\n"]
[143.261509, "o", "\u001b[?2004hroot@91388a22626d:/app# "]
[143.262077, "o", "rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo unreadable_rc=$?; if test -e /app/inkwell/sheet.toml; then echo ERROR_sheet_exists; else echo sheet_absent; fi\r\n\u001b[?2004l\r"]
[143.528849, "o", "mill: cannot open clip\r\n"]
[143.554438, "o", "unreadable_rc=1\r\nsheet_absent\r\n\u001b[?2004hroot@91388a22626d:/app# "]
[173.15142, "i", "cat > /tmp/testmill.py <<'PY'\nimport cv2, numpy as np, subprocess, toml\nfrom pathlib import Path\nW,H=160,120\nfourcc=cv2.VideoWriter_fourcc(*'mp4v')\n\ndef write(name, draw, n=60):\n p=f'/tmp/{name}.mp4'; w=cv2.VideoWriter(p,fourcc,12,(W,H))\n for i in range(n):\n  f=np.full((H,W,3),210,np.uint8)\n  draw(f,i,n)\n  w.write(f)\n w.release(); return p\n\ndef circle(f,x,y,r=8,col=(30,60,120)):\n cv2.circle(f,(int(x),int(y)),r,col,-1)\n\ndef down(f,i,n): circle(f,50,10+2*i)\ndef up(f,i,n): circle(f,50,110-2*i)\ndef linger(f,i,n):\n # crosses down, lingers, goes above, then crosses down again: same body => 1\n if i<20: y=45+1.5*i\n elif i<30: y=74\n elif i<43: y=74-1.5*(i-30)\n else: y=54+2*(i-43)\n circle(f,60,y)\ndef separate(f,i,n):\n circle(f,35,15+1.7*i); circle(f,120,5+1.9*i,col=(60,30,130))\ndef overlap(f,i,n):\n # Different x initially, converge and fully overlap around scan, then split.\n y=15+1.7*i\n x1=55+min(i,30)*0.8 if i<30 else 79-(i-30)*0.8\n x2=103-min(i,30)*0.8 if i<30 else 79+(i-30)*0.8\n circle(f,x1,y,9); circle(f,x2,y,9,col=(40,100,30))\ndef shade(f,i,n):\n y=20+1.5*i\n cv2.rectangle(f,(5,int(y)-3),(154,int(y)+3),(150,150,150),-1)\ndef partial(f,i,n): circle(f,80,45+min(i,15)) # never centroid below line+2\ncases=[('down',down,1),('up',up,0),('linger',linger,1),('separate',separate,2),('overlap',overlap,2),('shade',shade,0),('partial',partial,0)]\nfor name,fn,want in cases:\n p=write(name,fn)\n q=subprocess.run(['python3','/app/varnish/mill.pyc',p],capture_output=True,text=True)\n got=toml.load('/app/inkwell/sheet.toml')['crossings'] if q.returncode==0 else None\n print(name,'want',want,'got',got,'rc',q.returncode,q.stderr.strip())\nPY\npython3 /tmp/testmill.py\npython3 -m py_compile /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py /app/kiln/pack.py\nsha256sum /app/varnish/mill.pyc /app/varnish/packed.py\n"]
