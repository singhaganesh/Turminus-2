[210.542751, "o", " if r: print('COUNT frame',frame[0],'id',t['id'],'xy',round(nx,1),round(ny,1),'hits',t['hits'],'min',round(t['min_y'],1),'vy',round(t['vy'],2))\r\n\u001b[?2004l\r"]
