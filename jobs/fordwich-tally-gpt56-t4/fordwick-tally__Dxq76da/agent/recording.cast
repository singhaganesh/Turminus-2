[58.868055, "i", "python3 - <<'PY'\nimport cv2, numpy as np\ncap=cv2.VideoCapture('/app/shown.mp4'); mog=cv2.createBackgroundSubtractorMOG2(history=30,varThreshold=16,detectShadows=True)\nimgs=[]\nfor i in range(10000):\n ok,f=cap.read()\n if not ok: break\n fg=mog.apply(f)\n _,m=cv2.threshold(fg,200,255,cv2.THRESH_BINARY)\n m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n cs,_=cv2.findContours(m,cv2.RETR_EXTERNAL,cv2.CHAIN_APPROX_SIMPLE)\n vals=[]\n for c in cs:\n  a=cv2.contourArea(c)\n  if a>=15:\n   x,y,w,h=cv2.boundingRect(c); M=cv2.moments(c)\n   vals.append((round(a),x,y,w,h,round(M['m10']/M['m00'],1),round(M['m01']/M['m00'],1)))\n if i>=3 and vals and (i%3==0 or any(y<=70<=y+h for _,x,y,w,h,cx,cy in vals)):\n  print(i,sorted(vals,key=lambda z:z[1]))\n if i in np.linspace(0,47,24).astype(int):\n  z=f.copy(); cv2.line(z,(0,70),(159,70),(0,0,255),1); cv2.putText(z,str(i),(2,12),0,.4,(0,255,255),1); imgs.append(z)\ncap.release()\nwhile len(imgs)%6: imgs.append(np.zeros((120,160,3),np.uint8))\ncv2.imwrite('/app/contact.jpg',np.vstack([np.hstack(imgs[j:j+6]) for j in range(0,len(imgs),6)]))\nprint('contact written; frames',i+1)\nPY\n"]
