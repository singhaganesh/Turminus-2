[57.766821, "o", "  File \u001b[35m\"<stdin>\"\u001b[0m, line \u001b[35m17\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n  File \u001b[35m\"/usr/local/lib/python3.13/site-packages/numpy/_core/shape_base.py\"\u001b[0m, line \u001b[35m367\u001b[0m, in \u001b[35mhstack\u001b[0m\r\n    return \u001b[31m_nx.concatenate\u001b[0m\u001b[1;31m(arrs, 1, dtype=dtype, casting=casting)\u001b[0m\r\n           \u001b[31m~~~~~~~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n"]
