[210.539956, "i", "python3 - <<'PY'\nimport sys\nsys.path.insert(0,'/app')\nimport cv2\nimport blot, tether\ncap=cv2.VideoCapture('/tmp/linger.mp4'); fs=[]\nwhile True:\n ok,f=cap.read()\n if not ok: break\n fs.append(f)\nDs=[blot.find_bodies(m) for m in blot.foreground_masks(fs)]\norig=tether._advance\ndef advance(t,nx,ny,observed,shared=False):\n r=orig(t,nx,ny,observed,shared)\n if r: print('COUNT frame',frame[0],'id',t['id'],'xy',round(nx,1),round(ny,1),'hits',t['hits'],'min',round(t['min_y'],1),'vy',round(t['vy'],2))\n return r\ntether._advance=advance\n# Wrap detections with frame index visible to monkey patch.\nframe=[-1]\n# Reproduce by passing a generator that updates current frame.\ndef gen():\n for i,d in enumerate(Ds):\n  frame[0]=i\n  print(i,[(round(x['x'],1),round(x['y'],1),x['box'],round(x['area'])) for x in d])\n  yield d\nprint('TOTAL',tether.count_tracks(gen()))\nPY\n"]
