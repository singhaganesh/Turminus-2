[11.580931, "i", "printf '%s\\n' '--- BINARY ---'; file /app/bin/nockreel; /app/bin/nockreel pour; echo \"pour_rc=$?\"; for x in /app/tapewell/spools/splice.reel /app/tapewell/spools/open.reel /app/tapewell/spools/held.reel; do echo \"### spin $x\"; /app/bin/nockreel spin \"$x\"; echo \"rc=$?\"; done\n"]
