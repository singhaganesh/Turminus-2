[11.582049, "o", "--- BINARY ---\r\n"]
[11.587646, "o", "/app/bin/nockreel: ELF 64-bit LSB executable, x86-64, version 1 (SYSV), dynamically linked, interpreter /lib64/ld-linux-x86-64.so.2, for GNU/Linux 3.2.0, not stripped\r\n"]
