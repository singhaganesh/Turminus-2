[29.411319, "o", "    46\t    if (fgets(line, sizeof(line), fp) == NULL) {\r\n    47\t        fclose(fp);\r\n    48\t        return -1;\r\n    49\t    }\r\n    50\t    fclose(fp);\r\n    51\t    if (sscanf(line, \"%63s\", name) != 1) {\r\n    52\t        return -1;\r\n    53\t    }\r\n    54\t    if (strlen(name) >= name_len) {\r\n    55\t        return -1;\r\n    56\t    }\r\n    57\t    return 0;\r\n    58\t}\r\n    59\t\r\n    60\tint cmd_spin(int argc, char **argv)\r\n    61\t{\r\n    62\t    const char *blob = CAPSET_PATH;\r\n    63\t    const char *spool = NULL;\r\n    64\t    char call[NAME_LEN];\r\n    65\t    char stamp[32];\r\n    66\t    int mark = 0;\r\n    67\t    int admit_rc;\r\n    68\t    int bank;\r\n    69\t    int covered;\r\n    70\t    const char *st;\r\n    71\t    const char *prefix;\r\n    72\t    FILE *fp;\r\n    73\t\r\n    74\t    stamp[0] = '\\0';\r\n    75\t    if (argc >= 2 && strcmp(argv[0], \"--blob\") == 0) {\r\n    76\t        blob = argv[1];\r\n    77\t        spool = (argc >= 3) ? argv[2] : NULL;\r\n    78\t    } else if (argc >= 1) {\r\n    79\t        spool = argv[0];\r\n    80\t    }\r\n    81\t    if (spool == NULL) {\r\n    82\t        fprintf(stderr, \"usage: nockreel spin [--blob PATH] SPOOL\\n\");\r\n    83\t        return 2;\r\n    84\t    }\r\n    85\t    unlink(ACCEPT_PATH);\r\n    86\t    if (read_spool_call(spool, call, sizeof(call)) != 0) {\r\n    87\t        return 2;\r\n    88\t    }\r\n    89\t    admit_rc = xin_blob(blob, &mark, stamp, sizeof(stamp));\r\n    90\t    if (admit_rc < 0) {\r\n    91\t        return 2;\r\n"]
