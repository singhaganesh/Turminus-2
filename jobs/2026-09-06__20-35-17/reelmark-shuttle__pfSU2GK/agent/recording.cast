[10.512494, "o", "/app/tapewell/fixtures/lab.tbl\r\n/app/tapewell/fixtures/stale.tbl\r\n/app/tapewell/spools/held.reel\r\n/app/tapewell/spools/open.reel\r\n/app/tapewell/spools/splice.reel\r\n"]
