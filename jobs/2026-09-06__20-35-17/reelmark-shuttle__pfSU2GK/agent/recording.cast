[116.407734, "i", "for b in /app/tapewell/fixtures/stale.tbl /app/tapewell/fixtures/lab.tbl; do rm -f /app/reelcli/run/accept.ok /app/reelcli/run/loaded.set; /app/bin/nockreel spin --blob \"$b\" /app/tapewell/spools/open.reel; rc=$?; echo \"$(basename \"$b\") rc=$rc accept=$(test -e /app/reelcli/run/accept.ok && echo present || echo absent) loaded=$(test -e /app/reelcli/run/loaded.set && echo present || echo absent)\"; done\n"]
[116.409331, "o", "for b in /app/tapewell/fixtures/stale.tbl /app/tapewell/fixtures/lab.tbl; do rm -f /app/reelcli/run/accept.ok /app/reelcli/run/loaded.set; /app/bin/nockreel spin --blob \"$b\" /app/tapewell/spools/open.reel; rc=$?; echo \"$(basename \"$b\") rc=$rc accept=$(test -e /app/reelcli/run/accept.ok && echo present || echo absent) loaded=$(test -e /app/reelcli/run/loaded.set && echo present || echo absent)\"; done\r\n"]
[116.409703, "o", "\u001b[?2004l\r"]
[116.415549, "o", "stale.tbl rc=1 accept=absent loaded=absent\r\n"]
[116.419294, "o", "lab.tbl rc=1 accept=absent loaded=absent\r\n"]
[116.419484, "o", "\u001b[?2004hroot@3e78ad3399f2:/app# "]
[116.858795, "i", "set -e\n/app/bin/nockreel pour\nstamp=$(tr -d '[:space:]' </app/emitwell/knit/knit.ok)\ntest ${#stamp} -eq 8\n grep -qx 'REEL' /app/emitwell/knit/capset.tbl\ngrep -qx 'MARK 4' /app/emitwell/knit/capset.tbl\ngrep -qx 'SLOT knit' /app/emitwell/knit/capset.tbl\ngrep -qx \"STAMP $stamp\" /app/emitwell/knit/capset.tbl\ngrep -qx 'CALL sys_loom_splice 441 live' /app/emitwell/knit/capset.tbl\nout=$(/app/bin/nockreel spin /app/tapewell/spools/splice.reel)\npython3 - \"$out\" \"$stamp\" <<'PY'\nimport json,sys\nx=json.loads(sys.argv[1])\nassert set(x)=={'loaded','status','call'}\nassert x=={'loaded':'table:'+sys.argv[2], 'status':'replayed', 'call':'sys_loom_splice'}\nPY\ntest \"$(cat /app/reelcli/run/accept.ok)\" = 1\ntest \"$(cat /app/reelcli/run/loaded.set)\" = \"table:$stamp\"\nfor b in stale lab; do\n  if /app/bin/nockreel spin --blob \"/app/tapewell/fixtures/$b.tbl\" /app/tapewell/spools/open.reel; then exit 1; fi\n  test ! -e /app/reelcli/run/accept.ok\ndone\ntest \"$(od -An -tx1 -N4 /app/bin/nockreel | tr -d ' \\n')\" = 7f454c46\nnm --defined-only /app/bin/nockreel | grep -q ' T xin_blob$'\nnm --defined-only /app/bin/nockreel | grep -q ' T write_hdr$'\necho \"ALL_CONTRACT_TESTS_PASSED stamp=$stamp output=$out\"\n"]
