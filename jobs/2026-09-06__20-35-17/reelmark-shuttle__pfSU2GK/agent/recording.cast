[80.049024, "i", "cat > /app/reelcli/cli/spin.c <<'EOF'\n#include \"common.h\"\n#include \"sel.h\"\n#include \"xin.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int desc_has(const char *name)\n{\n    FILE *fp;\n    char line[LINE_LEN], row_name[NAME_LEN], extra;\n    int id;\n\n    fp = fopen(DESC_PATH, \"r\");\n    if (fp == NULL) return 0;\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (line[0] == '#' || line[0] == '\\n') continue;\n        if (sscanf(line, \"%63s %d %c\", row_name, &id, &extra) == 2 &&\n            strcmp(row_name, name) == 0) {\n            fclose(fp);\n            return 1;\n        }\n    }\n    fclose(fp);\n    return 0;\n}\n\nstatic int blob_has(const char *path, const char *name)\n{\n    FILE *fp;\n    char line[LINE_LEN], row_name[NAME_LEN], cls[32], extra;\n    int id;\n\n    fp = fopen(path, \"r\");\n    if (fp == NULL) return 0;\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (sscanf(line, \"CALL %63s %d %31s %c\", row_name, &id, cls, &extra) == 3 &&\n            strcmp(cls, \"live\") == 0 && strcmp(row_name, name) == 0) {\n            fclose(fp);\n            return 1;\n        }\n    }\n    fclose(fp);\n    return 0;\n}\n\nstatic int read_spool_call(const char *path, char *name)\n{\n    FILE *fp;\n    char line[LINE_LEN], extra;\n\n    fp = fopen(path, \"r\");\n    if (fp == NULL) return -1;\n    if (fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"%63s %c\", name, &extra) != 1 ||\n        fgets(line, sizeof(line), fp) != NULL) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    return 0;\n}\n\nint cmd_spin(int argc, char **argv)\n{\n    const char *blob = CAPSET_PATH, *spool;\n    char call[NAME_LEN], stamp[STAMP_LEN + 1], loaded[64];\n    int mark = 0, admit_rc, covered;\n    FILE *fp;\n\n    if (argc == 1) {\n        spool = argv[0];\n    } else if (argc == 3 && strcmp(argv[0], \"--blob\") == 0) {\n        blob = argv[1];\n        spool = argv[2];\n    } else {\n        fprintf(stderr, \"usage: nockreel spin [--blob PATH] SPOOL\\n\");\n        return 2;\n    }\n\n    unlink(ACCEPT_PATH);\n    unlink(LOADED_SET_PATH);\n    if (read_spool_call(spool, call) != 0 || !desc_has(call)) {\n        return 1;\n    }\n    admit_rc = xin_blob(blob, &mark, stamp, sizeof(stamp));\n    if (admit_rc != 0 || sel_bank(admit_rc) != 0) {\n        return 1;\n    }\n    covered = blob_has(blob, call);\n    snprintf(loaded, sizeof(loaded), \"table:%s\", stamp);\n\n    fp = fopen(LOADED_SET_PATH, \"w\");\n    if (fp == NULL || fprintf(fp, \"%s\\n\", loaded) < 0 || fclose(fp) != 0) {\n        if (fp != NULL) fclose(fp);\n        unlink(LOADED_SET_PATH);\n        return 1;\n    }\n    fp = fopen(ACCEPT_PATH, \"w\");\n    if (fp == NULL || fputs(\"1\\n\", fp) == EOF || fclose(fp) != 0) {\n        if (fp != NULL) fclose(fp);\n        unlink(ACCEPT_PATH);\n        unlink(LOADED_SET_PATH);\n        return 1;\n    }\n    printf(\"{\\\"loaded\\\":\\\"%s\\\",\\\"status\\\":\\\"%s\\\",\\\"call\\\":\\\"%s\\\"}\\n\",\n           loaded, covered ? \"replayed\" : \"unsupported\", call);\n    (void)mark;\n    return 0;\n}\nEOF\nmake -C /app/reelcli hull\n"]
