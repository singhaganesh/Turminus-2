[29.411815, "o", "root@3e78ad3399f2:/app# "]
[79.901016, "i", "cat > /app/ab/knt/hdr_write.c <<'EOF'\n#include \"hdr_write.h\"\n\n#include <stdio.h>\n\nint write_hdr(FILE *fp, const char *stamp)\n{\n    if (fp == NULL || stamp == NULL) {\n        return -1;\n    }\n    if (fprintf(fp, \"REEL\\nMARK 4\\nSLOT knit\\nSTAMP %s\\n\", stamp) < 0) {\n        return -1;\n    }\n    return 0;\n}\nEOF\ncat > /app/ef/ply/sel.c <<'EOF'\n#include \"sel.h\"\n\nint sel_bank(int admit_rc)\n{\n    return admit_rc == 0 ? 0 : 1;\n}\nEOF\ncat > /app/cd/flr/xin.c <<'EOF'\n#include \"xin.h\"\n\n#include <ctype.h>\n#include <stdio.h>\n#include <string.h>\n\n#define ACTIVE_MARK 4\n\nstatic int stamp_ok(const char *s)\n{\n    size_t i;\n    if (strlen(s) != 8) {\n        return 0;\n    }\n    for (i = 0; i < 8; i++) {\n        if (!isdigit((unsigned char)s[i]) && !(s[i] >= 'a' && s[i] <= 'f')) {\n            return 0;\n        }\n    }\n    return 1;\n}\n\nint xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)\n{\n    FILE *fp;\n    char line[256], stamp[32], name[64], cls[32], extra;\n    int mark, id, rows = 0;\n\n    if (path == NULL || stamp_out == NULL || stamp_cap < 9) {\n        return 1;\n    }\n    fp = fopen(path, \"r\");\n    if (fp == NULL) {\n        return 1;\n    }\n    if (fgets(line, sizeof(line), fp) == NULL || strcmp(line, \"REEL\\n\") != 0 ||\n        fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"MARK %d %c\", &mark, &extra) != 1 || mark != ACTIVE_MARK ||\n        fgets(line, sizeof(line), fp) == NULL || strcmp(line, \"SLOT knit\\n\") != 0 ||\n        fgets(line, sizeof(line), fp) == NULL ||\n        sscanf(line, \"STAMP %31s %c\", stamp, &extra) != 1 || !stamp_ok(stamp)) {\n        fclose(fp);\n        return 1;\n    }\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (sscanf(line, \"CALL %63s %d %31s %c\", name, &id, cls, &extra) != 3 ||\n            strcmp(cls, \"live\") != 0) {\n            fclose(fp);\n            return 1;\n        }\n        rows++;\n    }\n    if (ferror(fp) || rows == 0) {\n        fclose(fp);\n        return 1;\n    }\n    fclose(fp);\n    if (mark_out != NULL) {\n        *mark_out = mark;\n    }\n    memcpy(stamp_out, stamp, 9);\n    return 0;\n}\nEOF\n"]
[79.901451, "o", "cat > /app/ab/knt/hdr_write.c <<'EOF'\r\n\u001b[?2004l\r"]
