        return -1;
    }
    fp = fopen(path, "w");
    if (fp == NULL) {
        return -1;
    }
    if (fprintf(fp, "%s\n", stamp) < 0) {
        fclose(fp);
        return -1;
    }
    fclose(fp);
    return 0;
}
