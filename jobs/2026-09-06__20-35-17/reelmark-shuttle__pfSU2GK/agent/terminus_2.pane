     1	#include <stdio.h>
     2	#include <string.h>
     3	
     4	int cmd_pour(void);
     5	int cmd_spin(int argc, char **argv);
     6	
     7	int main(int argc, char **argv)
     8	{
     9	    if (argc < 2) {
    10	        fprintf(stderr, "usage: nockreel pour|spin ...\n");
    11	        return 2;
    12	    }
    13	    if (strcmp(argv[1], "pour") == 0) {
    14	        return cmd_pour();
    15	    }
    16	    if (strcmp(argv[1], "spin") == 0) {
    17	        return cmd_spin(argc - 2, argv + 2);
    18	    }
    19	    fprintf(stderr, "unknown subcommand\n");
    20	    return 2;
    21	}
===== /app/reelcli/cli/pour.c =====
     1	#include "common.h"
     2	#include "hdr_write.h"
     3	#include "mix.h"
     4	#include "note_write.h"
     5	#include "rows_write.h"
     6	
     7	#include <stdio.h>
     8	
     9	int cmd_pour(void)
    10	{
    11	    char stamp[STAMP_LEN + 1];
    12	    FILE *fp;
    13	
    14	    if (mix_tag(DESC_PATH, stamp, sizeof(stamp)) != 0) {
    15	        return 1;
    16	    }
    17	    fp = fopen(CAPSET_PATH, "w");
    18	    if (fp == NULL) {
    19	        return 1;
    20	    }
    21	    if (write_hdr(fp, stamp) != 0) {
    22	        fclose(fp);
    23	        return 1;
    24	    }
    25	    if (write_rows(fp, DESC_PATH) != 0) {
    26	        fclose(fp);
    27	        return 1;
    28	    }
    29	    fclose(fp);
    30	    if (write_note(KNIT_OK_PATH, stamp) != 0) {
    31	        return 1;
    32	    }
    33	    return 0;
    34	}
===== /app/reelcli/cli/spin.c =====
     1	#include "common.h"
     2	#include "sel.h"
     3	#include "stock.h"
     4	#include "xin.h"
     5	
     6	#include <stdio.h>
     7	#include <string.h>
     8	#include <unistd.h>
     9	
    10	static int blob_has(const char *path, const char *name)
    11	{
    12	    FILE *fp;
    13	    char line[LINE_LEN];
    14	    char row_name[NAME_LEN];
    15	    int id;
    16	    char cls[32];
    17	
    18	    fp = fopen(path, "r");
    19	    if (fp == NULL) {
    20	        return 0;
    21	    }
    22	    while (fgets(line, sizeof(line), fp) != NULL) {
    23	        if (strncmp(line, "CALL ", 5) != 0) {
    24	            continue;
    25	        }
    26	        if (sscanf(line + 5, "%63s %d %31s", row_name, &id, cls) >= 2) {
    27	            if (strcmp(row_name, name) == 0) {
    28	                fclose(fp);
    29	                return 1;
    30	            }
    31	        }
    32	    }
    33	    fclose(fp);
    34	    return 0;
    35	}
    36	
    37	static int read_spool_call(const char *path, char *name, unsigned name_len)
    38	{
    39	    FILE *fp;
    40	    char line[LINE_LEN];
    41	
    42	    fp = fopen(path, "r");
    43	    if (fp == NULL) {
    44	        return -1;
    45	    }
    46	    if (fgets(line, sizeof(line), fp) == NULL) {
    47	        fclose(fp);
    48	        return -1;
    49	    }
    50	    fclose(fp);
    51	    if (sscanf(line, "%63s", name) != 1) {
    52	        return -1;
    53	    }
    54	    if (strlen(name) >= name_len) {
    55	        return -1;
    56	    }
    57	    return 0;
    58	}
    59	
    60	int cmd_spin(int argc, char **argv)
    61	{
    62	    const char *blob = CAPSET_PATH;
    63	    const char *spool = NULL;
    64	    char call[NAME_LEN];
    65	    char stamp[32];
    66	    int mark = 0;
    67	    int admit_rc;
    68	    int bank;
    69	    int covered;
    70	    const char *st;
    71	    const char *prefix;
    72	    FILE *fp;
    73	
    74	    stamp[0] = '\0';
    75	    if (argc >= 2 && strcmp(argv[0], "--blob") == 0) {
    76	        blob = argv[1];
    77	        spool = (argc >= 3) ? argv[2] : NULL;
    78	    } else if (argc >= 1) {
    79	        spool = argv[0];
    80	    }
    81	    if (spool == NULL) {
    82	        fprintf(stderr, "usage: nockreel spin [--blob PATH] SPOOL\n");
    83	        return 2;
    84	    }
    85	    unlink(ACCEPT_PATH);
    86	    if (read_spool_call(spool, call, sizeof(call)) != 0) {
    87	        return 2;
    88	    }
    89	    admit_rc = xin_blob(blob, &mark, stamp, sizeof(stamp));
    90	    if (admit_rc < 0) {
    91	        return 2;
    92	    }
    93	    bank = sel_bank(admit_rc);
    94	    if (bank == 0) {
    95	        covered = blob_has(blob, call);
    96	        prefix = "table:";
    97	    } else {
    98	        covered = stock_has(call);
    99	        prefix = "builtin:";
   100	        snprintf(stamp, sizeof(stamp), "stock");
   101	    }
   102	    st = covered ? "replayed" : "unsupported";
   103	    printf("{\"loaded\":\"%s%s\",\"status\":\"%s\",\"call\":\"%s\"}\n",
   104	           prefix, stamp, st, call);
   105	    fp = fopen(LOADED_SET_PATH, "w");
   106	    if (fp != NULL) {
   107	        fprintf(fp, "%s%s\n", prefix, stamp);
   108	        fclose(fp);
   109	    }
   110	    if (admit_rc == 0 && bank == 0) {
   111	        fp = fopen(ACCEPT_PATH, "w");
   112	        if (fp != NULL) {
   113	            fputs("1\n", fp);
   114	            fclose(fp);
   115	        }
   116	    }
   117	    (void)mark;
   118	    return 0;
   119	}
