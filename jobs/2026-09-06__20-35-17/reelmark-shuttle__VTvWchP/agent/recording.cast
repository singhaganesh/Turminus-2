[62.666113, "o", "\u001b[?2004hroot@0a17930c2e1b:/app# "]
[62.778124, "i", "cat > /app/reelcli/cli/spin.c <<'EOF'\n#include \"common.h\"\n#include \"sel.h\"\n#include \"xin.h\"\n\n#include <stdio.h>\n#include <string.h>\n#include <unistd.h>\n\nstatic int desc_has(const char *name)\n{\n    FILE *fp = fopen(DESC_PATH, \"r\");\n    char line[LINE_LEN], row_name[NAME_LEN], extra;\n    int id;\n    if (fp == NULL) return 0;\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (line[0] == '#' || line[0] == '\\n') continue;\n        if (sscanf(line, \"%63s %d %c\", row_name, &id, &extra) == 2 && strcmp(row_name, name) == 0) {\n            fclose(fp);\n            return 1;\n        }\n    }\n    fclose(fp);\n    return 0;\n}\n\nstatic int blob_has(const char *path, const char *name)\n{\n    FILE *fp = fopen(path, \"r\");\n    char line[LINE_LEN], row_name[NAME_LEN], cls[32], extra;\n    int id;\n    if (fp == NULL) return 0;\n    while (fgets(line, sizeof(line), fp) != NULL) {\n        if (sscanf(line, \"CALL %63s %d %31s %c\", row_name, &id, cls, &extra) == 3 &&\n            strcmp(cls, \"live\") == 0 && strcmp(row_name, name) == 0) {\n            fclose(fp);\n            return 1;\n        }\n    }\n    fclose(fp);\n    return 0;\n}\n\nstatic int read_spool_call(const char *path, char *name, unsigned name_len)\n{\n    FILE *fp;\n    char line[LINE_LEN], extra[NAME_LEN];\n    fp = fopen(path, \"r\");\n    if (fp == NULL) return -1;\n    if (fgets(line, sizeof(line), fp) == NULL || sscanf(line, \"%63s %63s\", name, extra) != 1) {\n        fclose(fp);\n        return -1;\n    }\n    fclose(fp);\n    if (strlen(name) >= name_len || !desc_has(name)) return -1;\n    return 0;\n}\n\nint cmd_spin(int argc, char **argv)\n{\n    const char *blob = CAPSET_PATH, *spool = NULL;\n    char call[NAME_LEN], stamp[STAMP_LEN + 1], loaded[64];\n    int mark = 0, admit_rc, covered;\n    FILE *fp;\n\n    if (argc == 3 && strcmp(argv[0], \"--blob\") == 0) {\n        blob = argv[1];\n        spool = argv[2];\n    } else if (argc == 1) {\n        spool = argv[0];\n    } else {\n        fprintf(stderr, \"usage: nockreel spin [--blob PATH] SPOOL\\n\");\n        return 2;\n    }\n\n    unlink(ACCEPT_PATH);\n    unlink(LOADED_SET_PATH);\n    if (read_spool_call(spool, call, sizeof(call)) != 0) return 2;\n    stamp[0] = '\\0';\n    admit_rc = xin_blob(blob, &mark, stamp, sizeof(stamp));\n    if (admit_rc != 0 || sel_bank(admit_rc) != 0) return 1;\n\n    covered = blob_has(blob, call);\n    snprintf(loaded, sizeof(loaded), \"table:%s\", stamp);\n    printf(\"{\\\"loaded\\\":\\\"%s\\\",\\\"status\\\":\\\"%s\\\",\\\"call\\\":\\\"%s\\\"}\\n\",\n           loaded, covered ? \"replayed\" : \"unsupported\", call);\n\n    fp = fopen(LOADED_SET_PATH, \"w\");\n    if (fp == NULL) return 1;\n    fprintf(fp, \"%s\\n\", loaded);\n    if (fclose(fp) != 0) return 1;\n    fp = fopen(ACCEPT_PATH, \"w\");\n    if (fp == NULL) return 1;\n    fputs(\"1\\n\", fp);\n    if (fclose(fp) != 0) return 1;\n    (void)mark;\n    return 0;\n}\nEOF\nmake -C /app/reelcli hull\n"]
[62.778503, "o", "cat > /app/reelcli/cli/spin.c <<'EOF'\r\n\u001b[?2004l\r"]
