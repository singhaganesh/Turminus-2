[62.66393, "o", "cat > /app/ef/ply/sel.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.66402, "o", "#include \"sel.h\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[62.664214, "o", "\u001b[?2004h> int sel_bank(int admit_rc)\r\n\u001b[?2004l\r\u001b[?2004h> {\r\n\u001b[?2004l\r"]
[62.664243, "o", "\u001b[?2004h> "]
[62.664408, "o", "    return admit_rc == 0 ? 0 : 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
