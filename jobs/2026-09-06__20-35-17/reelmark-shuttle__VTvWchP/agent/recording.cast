[11.845328, "o", "=== CALLS ===\r\n"]
[11.846566, "o", "sys_read 0\r\nsys_write 1\r\nsys_openat2 257\r\nsys_loom_splice 441\r\nsys_held_pair 500\r\nsys_veil_latch 777\r\n"]
