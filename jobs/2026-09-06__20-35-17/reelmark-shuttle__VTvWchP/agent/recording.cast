[11.015059, "i", "printf '%s\\n' '=== GRAMMAR ==='; cat /app/fieldpack/GRAMMAR.txt; printf '%s\\n' '=== CLI ==='; cat /app/fieldpack/CLI.txt; printf '%s\\n' '=== ROUTE MAP ==='; cat /app/fieldpack/ROUTE_MAP.txt; printf '%s\\n' '=== HULL ==='; cat /app/reelcli/HULL.txt\n"]
[11.015935, "o", "printf '%s\\n' '=== GRAMMAR ==='; cat /app/fieldpack/GRAMMAR.txt; printf '%s\\n' '=== CLI ==='; cat /app/fieldpack/CLI.txt; printf '%s\\n' '=== ROUTE MAP ==='; cat /app/fieldpack/ROUTE_MAP.txt; printf '%s\\n' '=== HULL ==='; cat /app/reelcli/HULL.txt\r\n\u001b[?2004l\r"]
[11.016116, "o", "=== GRAMMAR ===\r\n"]
[11.017753, "o", "capset.tbl line grammar\r\n\r\nREEL\r\nMARK <integer>\r\nSLOT <token>\r\nSTAMP <8 lowercase hex>\r\nCALL <name> <id> <class>\r\n\r\nPoured rows use class token live.\r\nPoured blobs on this image use SLOT knit.\r\nSLOT lab is a lab-channel token; fixtures that carry it must not load.\r\n\r\nspin prints one JSON object with string keys loaded, status, and call.\r\nloaded is table: plus the STAMP value when the poured blob is used.\r\nloaded is builtin: plus a stock token when compiled-in names are used.\r\nstatus is replayed when the active name set covers the spool call.\r\nA spool file is a single token: the call name.\r\nopen.reel is sys_openat2. held.reel is sys_held_pair. splice.reel is sys_loom_splice.\r\nspin accepts any spool path whose token appears on /app/tapewell/desc/calls.lst.\r\n=== CLI ===\r\n"]
[11.01886, "o", "spin extra flags\r\n\r\n--blob PATH   use PATH instead of /app/emitwell/knit/capset.tbl\r\nSPOOL may be any one-token reel path, not only files under /app/tapewell/spools.\r\n\r\nHull name xin_blob stays in the linked nockreel image (`nm --defined-only`).\r\n"]
[11.019058, "o", "=== ROUTE MAP ===\r\n"]
[11.019963, "o", "pour / spin wiring (internal)\r\n\r\nModules linked by `make -C /app/reelcli hull`:\r\n  header writer under /app/ab\r\n  row writer under /app/ab\r\n  stamp note under /app/ab\r\n  blob admit under /app/cd\r\n  name bank under /app/ef\r\n  CLI under /app/reelcli/cli\r\n\r\nGrammar: /app/fieldpack/GRAMMAR.txt\r\nFlags: /app/fieldpack/CLI.txt\r\n"]
[11.020151, "o", "=== HULL ===\r\n"]
[11.021193, "o", "reelcli sources. `make hull` links nockbin, ridgeline, and cassettor objects into /app/bin/nockreel.\r\n\r\n/app/bin/nockreel is a native ELF image (first four bytes 0x7f 'E' 'L' 'F'). A shebang script is not the hull.\r\n\r\n`nm --defined-only /app/bin/nockreel` lists write_hdr among defined text names.\r\n"]
[11.021472, "o", "\u001b[?2004hroot@0a17930c2e1b:/app# "]
[11.156949, "i", "printf '%s\\n' '=== TREE ==='; find /app -maxdepth 4 -type f -printf '%p\\n' | sort; printf '%s\\n' '=== BINARY ==='; file /app/bin/nockreel; ls -l /app/bin/nockreel\n"]
[11.157837, "o", "printf '%s\\n' '=== TREE ==='; find /app -maxdepth 4 -type f -printf '%p\\n' | sort; printf '%s\\n' '=== BINARY ==='; file /app/bin/nockreel; ls -l /app/bin/nockreel\r\n\u001b[?2004l\r"]
