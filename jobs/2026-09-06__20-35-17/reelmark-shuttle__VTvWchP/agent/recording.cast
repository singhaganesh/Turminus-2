[23.002259, "o", "    18\t    }\r\n    19\t    fprintf(stderr, \"unknown subcommand\\n\");\r\n    20\t    return 2;\r\n    21\t}\r\n"]
[23.002716, "o", "===== /app/reelcli/cli/pour.c =====\r\n"]
[23.003711, "o", "     1\t#include \"common.h\"\r\n     2\t#include \"hdr_write.h\"\r\n     3\t#include \"mix.h\"\r\n     4\t#include \"note_write.h\"\r\n     5\t#include \"rows_write.h\"\r\n     6\t\r\n     7\t#include <stdio.h>\r\n     8\t\r\n     9\tint cmd_pour(void)\r\n    10\t{\r\n    11\t    char stamp[STAMP_LEN + 1];\r\n    12\t    FILE *fp;\r\n    13\t\r\n    14\t    if (mix_tag(DESC_PATH, stamp, sizeof(stamp)) != 0) {\r\n    15\t        return 1;\r\n    16\t    }\r\n    17\t    fp = fopen(CAPSET_PATH, \"w\");\r\n    18\t    if (fp == NULL) {\r\n    19\t        return 1;\r\n    20\t    }\r\n    21\t    if (write_hdr(fp, stamp) != 0) {\r\n    22\t        fclose(fp);\r\n    23\t        return 1;\r\n    24\t    }\r\n    25\t    if (write_rows(fp, DESC_PATH) != 0) {\r\n    26\t        fclose(fp);\r\n    27\t        return 1;\r\n    28\t    }\r\n    29\t    fclose(fp);\r\n    30\t    if (write_note(KNIT_OK_PATH, stamp) != 0) {\r\n    31\t        return 1;\r\n    32\t    }\r\n    33\t    return 0;\r\n    34\t}\r\n"]
[23.00432, "o", "===== /app/reelcli/cli/spin.c =====\r\n"]
[23.005506, "o", "     1\t#include \"common.h\"\r\n     2\t#include \"sel.h\"\r\n     3\t#include \"stock.h\"\r\n     4\t#include \"xin.h\"\r\n     5\t\r\n     6\t#include <stdio.h>\r\n"]
[23.005559, "o", "     7\t#include <string.h>\r\n     8\t#include <unistd.h>\r\n     9\t\r\n    10\tstatic int blob_has(const char *path, const char *name)\r\n    11\t{\r\n    12\t    FILE *fp;\r\n    13\t    char line[LINE_LEN];\r\n    14\t    char row_name[NAME_LEN];\r\n    15\t    int id;\r\n    16\t    char cls[32];\r\n    17\t\r\n    18\t    fp = fopen(path, \"r\");\r\n    19\t    if (fp == NULL) {\r\n    20\t        return 0;\r\n    21\t    }\r\n    22\t    while (fgets(line, sizeof(line), fp) != NULL) {\r\n    23\t        if (strncmp(line, \"CALL \", 5) != 0) {\r\n    24\t            continue;\r\n    25\t        }\r\n    26\t        if (sscanf(line + 5, \"%63s %d %31s\", row_name, &id, cls) >= 2) {\r\n    27\t            if (strcmp(row_name, name) == 0) {\r\n    28\t                fclose(fp);\r\n    29\t                return 1;\r\n    30\t            }\r\n    31\t        }\r\n    32\t    }\r\n    33\t    fclose(fp);\r\n    34\t    return 0;\r\n    35\t}\r\n    36\t\r\n    37\tstatic int read_spool_call(const char *path, char *name, unsigned name_len)\r\n    38\t{\r\n    39\t    FILE *fp;\r\n    40\t    char line[LINE_LEN];\r\n    41\t\r\n    42\t    fp = fopen(path, \"r\");\r\n    43\t    if (fp == NULL) {\r\n    44\t        return -1;\r\n    45\t    }\r\n    46\t    if (fgets(line, sizeof(line), fp) == NULL) {\r\n"]
[23.00558, "o", "    47\t        fclose(fp);\r\n    48\t        return -1;\r\n    49\t    }\r\n    50\t    fclose(fp);\r\n    51\t    if (sscanf(line, \"%63s\", name) != 1) {\r\n"]
[23.005602, "o", "    52\t        return -1;\r\n    53\t    }\r\n    54\t    if (strlen(name) >= name_len) {\r\n    55\t        return -1;\r\n    56\t    }\r\n    57\t    return 0;\r\n    58\t}\r\n    59\t\r\n    60\tint cmd_spin(int argc, char **argv)\r\n    61\t{"]
[23.005619, "o", "\r\n    62\t    const char *blob = CAPSET_PATH;\r\n    63\t    const char *spool = NULL;\r\n"]
[23.005666, "o", "    64\t    char call[NAME_LEN];\r\n    65\t    char stamp[32];\r\n    66\t    int mark = 0;\r\n    67\t    int admit_rc;\r\n    68\t    int bank;\r\n    69\t    int covered;\r\n    70\t    const char *st;\r\n"]
[23.005681, "o", "    71\t    const char *prefix;\r\n    72\t    FILE *fp;\r\n    73\t\r\n    74\t    stamp[0] = '\\0';\r\n"]
[23.005709, "o", "    75\t    if (argc >= 2 && strcmp(argv[0], \"--blob\") == 0) {\r\n    76\t        blob = argv[1];\r\n    77\t        spool = (argc >= 3) ? argv[2] : NULL;\r\n    78\t    } else if (argc >= 1) {\r\n    79\t        spool = argv[0];\r\n    80\t    }\r\n    81\t    if (spool == NULL) {\r\n    82\t        fprintf(stderr, \"usage: nockreel spin [--blob PATH] SPOOL\\n\");\r\n"]
[23.005726, "o", "    83\t        return 2;\r\n    84\t    }\r\n    85\t    unlink(ACCEPT_PATH);\r\n    86\t    if (read_spool_call(spool, call, sizeof(call)) != 0) {\r\n    87\t        return 2;\r\n"]
[23.005741, "o", "    88\t    }\r\n    89\t    admit_rc = xin_blob(blob, &mark, stamp, sizeof(stamp));\r\n    90\t    if (admit_rc < 0) {\r\n    91\t        return 2;\r\n    92\t    }\r\n"]
[23.005756, "o", "    93\t    bank = sel_bank(admit_rc);\r\n    94\t    if (bank == 0) {\r\n    95\t        covered = blob_has(blob, call);\r\n    96\t        prefix = \"table:\";\r\n    97\t    } else {\r\n"]
[23.00577, "o", "    98\t        covered = stock_has(call);\r\n    99\t        prefix = \"builtin:\";\r\n   100\t        snprintf(stamp, sizeof(stamp), \"stock\");\r\n   101\t    }\r\n"]
[23.005792, "o", "   102\t    st = covered ? \"replayed\" : \"unsupported\";\r\n   103\t    printf(\"{\\\"loaded\\\":\\\"%s%s\\\",\\\"status\\\":\\\"%s\\\",\\\"call\\\":\\\"%s\\\"}\\n\",\r\n   104\t           prefix, stamp, st, call);\r\n   105\t    fp = fopen(LOADED_SET_PATH, \"w\");\r\n"]
[23.005831, "o", "   106\t    if (fp != NULL) {\r\n   107\t        fprintf(fp, \"%s%s\\n\", prefix, stamp);\r\n   108\t        fclose(fp);\r\n   109\t    }\r\n   110\t    if (admit_rc == 0 && bank == 0) {\r\n   111\t        fp = fopen(ACCEPT_PATH, \"w\");\r\n   112\t        if (fp != NULL) {\r\n   113\t            fputs(\"1\\n\", fp);\r\n   114\t            fclose(fp);\r\n   115\t        }\r\n   116\t    }\r\n   117\t    (void)mark;\r\n   118\t    return 0;\r\n   119\t}\r\n"]
