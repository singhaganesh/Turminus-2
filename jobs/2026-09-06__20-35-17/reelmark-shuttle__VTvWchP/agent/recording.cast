[22.98779, "o", "    13\t    if (fp == NULL) {\r\n    14\t        return -1;\r\n    15\t    }\r\n    16\t    if (fprintf(fp, \"%s\\n\", stamp) < 0) {\r\n    17\t        fclose(fp);\r\n    18\t        return -1;\r\n    19\t    }\r\n    20\t    fclose(fp);\r\n    21\t    return 0;\r\n    22\t}\r\n"]
