[22.970181, "o", "===== /app/ab/knt/hdr_write.c =====\r\n"]
[22.976522, "o", "     1\t#include \"hdr_write.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t\r\n     5\tint write_hdr(FILE *fp, const char *stamp)\r\n     6\t{\r\n     7\t    const int mark_now = 2;\r\n     8\t\r\n     9\t    if (fp == NULL || stamp == NULL) {\r\n    10\t        return -1;\r\n    11\t    }\r\n    12\t    if (fprintf(fp, \"REEL\\n\") < 0) {\r\n    13\t        return -1;\r\n    14\t    }\r\n    15\t    if (fprintf(fp, \"MARK %d\\n\", mark_now) < 0) {\r\n    16\t        return -1;\r\n    17\t    }\r\n    18\t    if (fprintf(fp, \"SLOT lab\\n\") < 0) {\r\n    19\t        return -1;\r\n    20\t    }\r\n    21\t    if (fprintf(fp, \"STAMP %s\\n\", stamp) < 0) {\r\n    22\t        return -1;\r\n    23\t    }\r\n    24\t    return 0;\r\n    25\t}\r\n===== /app/ab/knt/hdr_write.h =====\r\n     1\t#ifndef HDR_WRITE_H\r\n     2\t#define HDR_WRITE_H\r\n     3\t\r\n     4\t#include <stdio.h>\r\n     5\t\r\n     6\tint write_hdr(FILE *fp, const char *stamp);\r\n     7\t\r\n     8\t#endif\r\n===== /app/ab/knt/mix.c =====\r\n"]
[22.978843, "o", "     1\t#include \"mix.h\"\r\n     2\t\r\n     3\t#include <stdio.h>\r\n     4\t#include <stdint.h>\r\n     5\t\r\n     6\tint mix_tag(const char *path, char *out, unsigned out_len)\r\n     7\t{\r\n     8\t    FILE *fp;\r\n     9\t    uint32_t h = 2166136261u;\r\n    10\t    int c;\r\n"]
[22.978902, "o", "    11\t\r\n    12\t    if (path == NULL || out == NULL || out_len < 9) {\r\n    13\t        return -1;\r\n    14\t    }\r\n    15\t    fp = fopen(path, \"r\");\r\n    16\t    if (fp == NULL) {\r\n    17\t        return -1;\r\n    18\t    }\r\n    19\t    while ((c = fgetc(fp)) != EOF) {\r\n    20\t        h ^= (unsigned char)c;\r\n    21\t        h *= 16777619u;\r\n    22\t    }\r\n    23\t    fclose(fp);\r\n    24\t    if (snprintf(out, out_len, \"%08x\", h) < 0) {\r\n    25\t        return -1;\r\n"]
[22.978932, "o", "    26\t    }\r\n    27\t    return 0;\r\n    28\t}\r\n"]
[22.979915, "o", "===== /app/ab/knt/mix.h =====\r\n"]
