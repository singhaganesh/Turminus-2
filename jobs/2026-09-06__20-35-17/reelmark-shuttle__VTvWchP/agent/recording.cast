[12.082871, "i", "set +e; echo '=== CURRENT POUR ==='; /app/bin/nockreel pour; echo \"pour_rc=$?\"; echo '=== CURRENT SPINS ==='; for s in splice.reel open.reel held.reel; do echo \"-- $s\"; /app/bin/nockreel spin \"/app/tapewell/spools/$s\"; echo \"rc=$?\"; done; for f in stale.tbl lab.tbl; do echo \"-- $f against open.reel\"; /app/bin/nockreel spin \"/app/tapewell/fixtures/$f\" /app/tapewell/spools/open.reel; echo \"rc=$?\"; done; echo '=== RUN STATE ==='; find /app/reelcli/run -maxdepth 1 -type f -print -exec sh -c 'cat \"$1\"; echo' _ {} \\; 2>/dev/null\n"]
