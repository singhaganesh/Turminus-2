===== /app/cd/flr/xin.c =====
     1	#include "xin.h"
     2	
     3	#include <stdio.h>
     4	#include <string.h>
     5	
     6	#ifndef BANK_FLOOR
     7	#define BANK_FLOOR 3
     8	#endif
     9	
    10	int xin_blob(const char *path, int *mark_out, char *stamp_out, size_t stamp_cap)
    11	{
    12	    FILE *fp;
    13	    char line[256];
    14	    int mark = 0;
    15	    char stamp[32];
    16	    int saw_mark = 0;
    17	    int saw_stamp = 0;
    18	
    19	    stamp[0] = '\0';
    20	    if (path == NULL) {
    21	        return 1;
    22	    }
    23	    fp = fopen(path, "r");
    24	    if (fp == NULL) {
    25	        return 1;
    26	    }
    27	    while (fgets(line, sizeof(line), fp) != NULL) {
    28	        if (strncmp(line, "MARK ", 5) == 0) {
    29	            if (sscanf(line + 5, "%d", &mark) == 1) {
    30	                saw_mark = 1;
    31	            }
    32	        } else if (strncmp(line, "STAMP ", 6) == 0) {
    33	            if (sscanf(line + 6, "%31s", stamp) == 1) {
    34	                saw_stamp = 1;
    35	            }
    36	        }
    37	    }
    38	    fclose(fp);
    39	    if (!saw_mark) {
    40	        return 1;
    41	    }
    42	    if (mark_out != NULL) {
    43	        *mark_out = mark;
    44	    }
    45	    if (stamp_out != NULL && stamp_cap > 0 && saw_stamp) {
    46	        strncpy(stamp_out, stamp, stamp_cap - 1);
    47	        stamp_out[stamp_cap - 1] = '\0';
    48	    }
    49	    if (mark < BANK_FLOOR) {
    50	        return 1;
    51	    }
    52	    return 0;
    53	}
