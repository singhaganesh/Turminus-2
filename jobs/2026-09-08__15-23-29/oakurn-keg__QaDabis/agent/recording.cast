[80.163862, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[80.163885, "o", "\u001b[?2004h> "]
[80.163984, "o", "static int do_pour(const char *src) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.164081, "o", "    if (op_a() != 0) return 1;\r\n\u001b[?2004l\r"]
[80.164155, "o", "\u001b[?2004h> "]
[80.164251, "o", "    Parsed u; if (!parse_urn(src, u)) return 1;\r\n\u001b[?2004l\r"]
[80.164323, "o", "\u001b[?2004h> "]
[80.164405, "o", "    mkdir(\"/app/snapvat/live\", 0755);\r\n\u001b[?2004l\r"]
[80.164478, "o", "\u001b[?2004h> "]
[80.164555, "o", "    unsigned long long seq=0;\r\n\u001b[?2004l\r"]
[80.164583, "o", "\u001b[?2004h> "]
[80.164793, "o", "    { std::ifstream in(\"/app/snapvat/queue.seq\"); in >> seq; }\r\n\u001b[?2004l\r"]
[80.164867, "o", "\u001b[?2004h"]
[80.164956, "o", ">     ++seq;\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.165025, "o", "> "]
[80.165278, "o", "    { std::ofstream out(\"/app/snapvat/queue.seq\",std::ios::trunc); if(!out) return 1; out<<seq<<'\\n'; }\r\n\u001b[?2004l\r"]
[80.165351, "o", "\u001b[?2004h> "]
[80.165529, "o", "    std::ostringstream base; base << \"/app/snapvat/live/\";\r\n\u001b[?2004l\r"]
[80.165602, "o", "\u001b[?2004h> "]
[80.165802, "o", "    base.width(20); base.fill('0'); base << seq; base << '-' << u.id;\r\n\u001b[?2004l\r"]
[80.165889, "o", "\u001b[?2004h> "]
[80.166063, "o", "    std::string tmp=base.str()+\".new\", dst=base.str()+\".urn\";\r\n\u001b[?2004l\r"]
[80.166139, "o", "\u001b[?2004h> "]
[80.166445, "o", "    { std::ifstream in(src,std::ios::binary); std::ofstream out(tmp,std::ios::binary|std::ios::trunc);\r\n\u001b[?2004l\r"]
[80.166526, "o", "\u001b[?2004h> "]
[80.166772, "o", "      if(!in||!out) return 1; out<<in.rdbuf(); if(!out) { unlink(tmp.c_str()); return 1; } }\r\n\u001b[?2004l\r"]
[80.166844, "o", "\u001b[?2004h> "]
[80.167032, "o", "    if(rename(tmp.c_str(),dst.c_str()) != 0) { unlink(tmp.c_str()); return 1; }\r\n\u001b[?2004l\r"]
[80.16712, "o", "\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r"]
[80.167179, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[80.167205, "o", "\u001b[?2004h> "]
[80.167216, "o", "\r\n\u001b[?2004l\r"]
[80.167313, "o", "\u001b[?2004h> "]
[80.167337, "o", "static int write_json() {\r\n\u001b[?2004l\r"]
[80.167356, "o", "\u001b[?2004h"]
[80.167373, "o", "> "]
[80.167498, "o", "    std::map<std::string,long long> days;\r\n\u001b[?2004l\r"]
[80.167521, "o", "\u001b[?2004h> "]
[80.167839, "o", "    { std::ifstream in(\"/app/snapvat/days.tmp\"); std::string d; long long n; while(in>>d>>n) days[d]+=n; }\r\n\u001b[?2004l\r"]
[80.167917, "o", "\u001b[?2004h> "]
[80.168439, "o", "    std::string cover; { std::ifstream in(\"/app/snapvat/cover.tmp\"); in>>cover; }\r\n\u001b[?2004l\r\u001b[?2004h>     if(cover.empty()) return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.168564, "o", "    std::ostringstream body; body<<\"{\\\"days\\\":{\"; bool first=true;\r\n\u001b[?2004l\r"]
[80.168593, "o", "\u001b[?2004h"]
[80.168611, "o", "> "]
[80.168906, "o", "    for(const auto &kv:days) { if(!first) body<<','; first=false; body<<'\"'<<kv.first<<\"\\\":\"<<kv.second; }\r\n\u001b[?2004l\r"]
[80.168986, "o", "\u001b[?2004h> "]
[80.169077, "o", "    body<<\"},\\\"covers\\\":\\\"\"<<cover<<\"\\\"}\\n\";\r\n\u001b[?2004l\r"]
[80.169144, "o", "\u001b[?2004h> "]
[80.169261, "o", "    std::string tmp=\"/app/inkpit/counts.new\";\r\n\u001b[?2004l\r"]
[80.169319, "o", "\u001b[?2004h> "]
[80.16955, "o", "    { std::ofstream out(tmp,std::ios::trunc); if(!out)return 1; out<<body.str(); if(!out)return 1; }\r\n\u001b[?2004l\r"]
[80.16963, "o", "\u001b[?2004h> "]
[80.169756, "o", "    return rename(tmp.c_str(),\"/app/inkpit/counts.json\")==0 ? 0 : 1;\r\n\u001b[?2004l\r"]
[80.169817, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[80.169885, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.169947, "o", "> "]
[80.170011, "o", "static int do_steep() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.170099, "o", "    if(op_a()!=0) return 1;\r\n\u001b[?2004l\r"]
[80.170179, "o", "\u001b[?2004h> "]
[80.170239, "o", "    int rc=run_k();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.170301, "o", "    if(rc!=0) return rc;\r\n\u001b[?2004l\r"]
[80.170351, "o", "\u001b[?2004h> "]
[80.170426, "o", "    if(write_json()!=0) return 1;\r\n\u001b[?2004l\r"]
[80.170473, "o", "\u001b[?2004h> "]
[80.170623, "o", "    std::ifstream list(\"/app/snapvat/folded.list\"); std::string path;\r\n\u001b[?2004l\r"]
[80.170667, "o", "\u001b[?2004h> "]
[80.170829, "o", "    while(std::getline(list,path)) if(!path.empty()) unlink(path.c_str());\r\n\u001b[?2004l\r"]
[80.17087, "o", "\u001b[?2004h> "]
[80.170968, "o", "    unlink(\"/app/snapvat/folded.list\");\r\n\u001b[?2004l\r"]
[80.171008, "o", "\u001b[?2004h> "]
[80.171062, "o", "    return 0;\r\n\u001b[?2004l\r"]
[80.171164, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.171225, "o", "> "]
[80.171446, "o", "static int do_board() { std::ifstream in(\"/app/inkpit/counts.json\"); if(!in)return 1; std::cout<<in.rdbuf(); return 0; }\r\n\u001b[?2004l\r"]
[80.171492, "o", "\u001b[?2004h> "]
[80.171575, "o", "int main(int argc,char **argv) {\r\n\u001b[?2004l\r"]
[80.171623, "o", "\u001b[?2004h> "]
[80.171729, "o", "    if(argc<2)return 2; std::string cmd=argv[1];\r\n\u001b[?2004l\r"]
[80.171772, "o", "\u001b[?2004h> "]
[80.171905, "o", "    if(cmd==\"pour\") return argc==3 ? do_pour(argv[2]) : 2;\r\n\u001b[?2004l\r"]
[80.171947, "o", "\u001b[?2004h> "]
[80.172147, "o", "    if(cmd==\"steep\") return argc==2 ? do_steep() : 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.172291, "o", "    if(cmd==\"board\") return argc==2 ? do_board() : 2;\r\n\u001b[?2004l\r"]
[80.172389, "o", "\u001b[?2004h>     return 2;\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.17242, "o", "> }\r\n\u001b[?2004l\r"]
[80.172504, "o", "\u001b[?2004h> "]
[80.172563, "o", "EOF\r\n\u001b[?2004l\r"]
