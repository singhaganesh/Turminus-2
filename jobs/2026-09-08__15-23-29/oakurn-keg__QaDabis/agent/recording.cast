[10.734731, "i", "printf '%s\\n' '--- build metadata ---'; find /app -maxdepth 3 -type f \\( -name 'Makefile' -o -name 'CMakeLists.txt' -o -name '*.mk' -o -name 'meson.build' \\) -print -exec sed -n '1,240p' {} \\;; printf '%s\\n' '--- board ---'; /app/bin/oakurn board; printf 'status=%s\\n' \"$?\"\n"]
[10.735643, "o", "printf '%s\\n' '--- build metadata ---'; find /app -maxdepth 3 -type f \\( -name 'Makefile' -o -name 'CMakeLists.txt' -o -name '*.mk' -o -name 'meson.build' \\) -print -exec sed -n '1,240p' {} \\;; printf '%s\\n' '--- board ---'; /app/bin/oakurn board; printf 'status=%s\\n' \"$?\"\r\n\u001b[?2004l\r"]
[10.735792, "o", "--- build metadata ---\r\n"]
[10.738082, "o", "/app/ribcli/hull.mk\r\n"]
[10.739309, "o", "CXX ?= g++\r\nCXXFLAGS ?= -O2 -Wall -Wextra -std=c++17 -I/app/ribcli -I/app/latchpit -I/app/stampwire -I/app/dayfold -I/app/holdbay\r\nSRC := $(wildcard /app/ribcli/*.cpp) $(wildcard /app/latchpit/*.cpp) $(wildcard /app/stampwire/*.cpp) $(wildcard /app/dayfold/*.cpp) $(wildcard /app/holdbay/*.cpp)\r\nBIN := /app/bin/oakurn\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/inkpit /app/snapvat/live\r\n\t$(CXX) $(CXXFLAGS) -o $(BIN) $(SRC)\r\n"]
