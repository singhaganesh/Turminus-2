days[d] += n;\r\n    60\t        }\r\n    61\t    }\r\n    62\t    std::string cover;\r\n    63\t    {\r\n    64\t        std::ifstream in(\"/app/snapvat/cover.tmp\");\r\n    65\t        in >> cover;\r\n    66\t    }\r\n    67\t    std::ostringstream body;\r\n    68\t    body << \"{\\\"days\\\":{\";\r\n    69\t    bool first = true;\r\n    70\t    for (const auto &kv : days) {\r\n    71\t        if (!first) {\r\n    72\t            body << \",\";\r\n    73\t        }\r\n    74\t        first = false;\r\n    75\t        body << \"\\\"\" << kv.first << \"\\\":\" << kv.second;\r\n    76\t    }\r\n    77\t    body << \"},\\\"covers\\\":\\\"\" << cover << \"\\\"}\\n\";\r\n    78\t    std::ofstream out(\"/app/inkpit/counts.json\");\r\n    79\t    if (!out) {\r\n    80\t        return 1;\r\n    81\t    }\r\n    82\t    out << body.str();\r\n    83\t    return 0;\r\n    84\t}\r\n    85\t\r\n    86\tstatic std::string read_text(const std::string &path) {\r\n    87\t    std::ifstream in(path);\r\n    88\t    std::ostringstream ss;\r\n    89\t    ss << in.rdbuf();\r\n    90\t    return ss.str();\r\n    91\t}\r\n    92\t\r\n    93\tstatic int do_steep() {\r\n    94\t    if (op_a() != 0) {\r\n    95\t        return 0;\r\n    96\t    }\r\n    97\t    std::string prev = read_text(\"/app/snapvat/emit.prev\");\r\n    98\t    if (run_k() != 0) {\r\n    99\t        return 1;\r\n   100\t    }\r\n   101\t    if (write_json() != 0) {\r\n   102\t        return 1;\r\n   103\t    }\r\n   104\t    std::string emit = read_text(\"/app/inkpit/emit.inc\");\r\n   105\t    if (!prev.empty() && emit == prev) {\r\n   106\t        return 1;\r\n   107\t    }\r\n   108\t    std::ofstream prevf(\"/app/snapvat/emit.prev\");\r\n   109\t    prevf << emit;\r\n   110\t    return 0;\r\n   111\t}\r\n   112\t\r\n   113\tstatic int do_board() {\r\n   114\t    std::ifstream in(\"/app/inkpit/counts.json\");\r\n   115\t    if (!in) {\r\n   116\t        return 1;\r\n   117\t    }\r\n   118\t    std::cout << in.rdbuf();\r\n   119\t    return 0;\r\n   120\t}\r\n   121\t\r\n   122\tint main(int argc, char **argv) {\r\n   123\t    if (argc < 2) {\r\n   124\t        return 2;\r\n   125\t    }\r\n   126\t    std::string cmd = argv[1];\r\n   127\t    if (cmd == \"pour\") {\r\n   128\t        if (argc < 3) {\r\n   129\t            return 2;\r\n   130\t        }\r\n   131\t        return do_pour(argv[2]);\r\n   132\t    }\r\n   133\t    if (cmd == \"steep\") {\r\n   134\t        return do_steep();\r\n   135\t    }\r\n   136\t    if (cmd == \"board\") {\r\n   137\t        return do_board();\r\n   138\t    }"]
