[79.695342, "o", "#include <unistd.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.695402, "o", "\u001b[?2004h> "]
[79.695488, "o", "struct Urn { std::string path, id, day; int n = 0; };\r\n\u001b[?2004l\r"]
[79.695544, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.695657, "o", "static bool parse_urn(const std::string &path, Urn &u) {\r\n\u001b[?2004l\r"]
[79.695714, "o", "\u001b[?2004h> "]
[79.695768, "o", "    std::ifstream in(path);\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.695821, "o", "> "]
[79.695887, "o", "    std::string banner, a, b, c, extra;\r\n\u001b[?2004l\r"]
[79.695948, "o", "\u001b[?2004h> "]
[79.696026, "o", "    if (!std::getline(in, banner) || banner != \"URN1\" ||\r\n\u001b[?2004l\r"]
[79.69607, "o", "\u001b[?2004h> "]
[79.696233, "o", "        !std::getline(in, a) || !std::getline(in, b) || !std::getline(in, c) ||\r\n\u001b[?2004l\r"]
[79.696288, "o", "\u001b[?2004h"]
[79.696342, "o", "> "]
[79.696397, "o", "        std::getline(in, extra)) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.696607, "o", "    if (a.rfind(\"id \", 0) != 0 || b.rfind(\"day \", 0) != 0 || c.rfind(\"n \", 0) != 0) return false;\r\n\u001b[?2004l\r"]
[79.696662, "o", "\u001b[?2004h> "]
[79.6968, "o", "    u.path = path; u.id = a.substr(3); u.day = b.substr(4);\r\n\u001b[?2004l\r"]
[79.696877, "o", "\u001b[?2004h"]
[79.69694, "o", "> "]
[79.697063, "o", "    if (u.id.empty() || u.id.find_first_of(\" \\t/\\\\\") != std::string::npos ||\r\n\u001b[?2004l\r"]
[79.697136, "o", "\u001b[?2004h> "]
[79.697296, "o", "        !std::regex_match(u.day, std::regex(\"[0-9]{4}-[0-9]{2}-[0-9]{2}\"))) return false;\r\n\u001b[?2004l\r"]
[79.697368, "o", "\u001b[?2004h> "]
[79.697424, "o", "    char *end = nullptr; errno = 0;\r\n\u001b[?2004l\r"]
[79.697484, "o", "\u001b[?2004h> "]
[79.697572, "o", "    long value = std::strtol(c.c_str() + 2, &end, 10);\r\n\u001b[?2004l\r"]
[79.697625, "o", "\u001b[?2004h> "]
[79.697805, "o", "    if (errno || !end || *end != '\\0' || value < INT_MIN || value > INT_MAX) return false;\r\n\u001b[?2004l\r"]
[79.697858, "o", "\u001b[?2004h> "]
[79.697927, "o", "    u.n = static_cast<int>(value);\r\n\u001b[?2004l\r"]
[79.697983, "o", "\u001b[?2004h> "]
[79.69805, "o", "    return true;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[79.698124, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[79.698186, "o", "> "]
[79.698309, "o", "static void read_existing(std::map<std::string, long long> &days) {\r\n\u001b[?2004l\r"]
[79.698365, "o", "\u001b[?2004h> "]
[79.698505, "o", "    std::ifstream in(\"/app/inkpit/counts.json\");\r\n\u001b[?2004l\r"]
[79.69859, "o", "\u001b[?2004h> "]
[79.698698, "o", "    std::ostringstream ss; ss << in.rdbuf();\r\n\u001b[?2004l\r"]
[79.698756, "o", "\u001b[?2004h> "]
[79.69882, "o", "    const std::string text = ss.str();\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.698881, "o", "> "]
[79.699081, "o", "    const std::regex pair(\"\\\\\\\"([0-9]{4}-[0-9]{2}-[0-9]{2})\\\\\\\"[[:space:]]*:[[:space:]]*(-?[0-9]+)\");\r\n\u001b[?2004l\r"]
[79.69915, "o", "\u001b[?2004h> "]
[79.699309, "o", "    for (std::sregex_iterator it(text.begin(), text.end(), pair), end; it != end; ++it)\r\n\u001b[?2004l\r"]
[79.699369, "o", "\u001b[?2004h> "]
[79.699461, "o", "        days[(*it)[1].str()] += std::stoll((*it)[2].str());\r\n\u001b[?2004l\r"]
[79.699522, "o", "\u001b[?2004h> "]
[79.699571, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.69978, "o", "static bool replace_file(const std::string &tmp, const std::string &dst, const std::string &body) {\r\n\u001b[?2004l\r"]
[79.699825, "o", "\u001b[?2004h> "]
[79.700114, "o", "    { std::ofstream out(tmp, std::ios::trunc); if (!out) return false; out << body; if (!out) return false; }\r\n\u001b[?2004l\r"]
[79.700168, "o", "\u001b[?2004h> "]
[79.700263, "o", "    return rename(tmp.c_str(), dst.c_str()) == 0;\r\n\u001b[?2004l\r"]
[79.700308, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.700357, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.700406, "o", "int n_fold(void) {\r\n\u001b[?2004l\r"]
[79.700452, "o", "\u001b[?2004h> "]
[79.700527, "o", "    std::vector<std::string> paths;\r\n\u001b[?2004l\r"]
[79.700575, "o", "\u001b[?2004h> "]
[79.700655, "o", "    DIR *dir = opendir(\"/app/snapvat/live\");\r\n\u001b[?2004l\r"]
[79.700705, "o", "\u001b[?2004h> "]
[79.700763, "o", "    if (!dir) return 1;\r\n\u001b[?2004l\r"]
[79.700819, "o", "\u001b[?2004h> "]
[79.70089, "o", "    while (dirent *ent = readdir(dir)) {\r\n\u001b[?2004l\r"]
[79.700941, "o", "\u001b[?2004h> "]
[79.701016, "o", "        std::string name = ent->d_name;\r\n\u001b[?2004l\r"]
[79.701095, "o", "\u001b[?2004h> "]
[79.701218, "o", "        if (name.size() >= 4 && name.substr(name.size() - 4) == \".urn\")\r\n\u001b[?2004l\r"]
[79.701269, "o", "\u001b[?2004h> "]
[79.701387, "o", "            paths.push_back(\"/app/snapvat/live/\" + name);\r\n\u001b[?2004l\r"]
[79.701438, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[79.701497, "o", "\u001b[?2004h> "]
[79.701554, "o", "    closedir(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.701638, "o", "    std::sort(paths.begin(), paths.end());\r\n\u001b[?2004l\r"]
[79.701689, "o", "\u001b[?2004h> "]
[79.701746, "o", "    if (paths.empty()) return 2;\r\n\u001b[?2004l\r"]
[79.701806, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.701867, "o", "    std::vector<Urn> urns;\r\n\u001b[?2004l\r"]
[79.701926, "o", "\u001b[?2004h> "]
[79.701984, "o", "    for (const auto &path : paths) {\r\n\u001b[?2004l\r"]
[79.70205, "o", "\u001b[?2004h>         Urn u;\r\n"]
[79.702115, "o", "\u001b[?2004l\r"]
[79.702175, "o", "\u001b[?2004h> "]
[79.702234, "o", "        if (!parse_urn(path, u)) return 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.702302, "o", "        urns.push_back(u);\r\n\u001b[?2004l\r"]
[79.702377, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.702433, "o", "> "]
[79.702491, "o", "    std::map<std::string, long long> days;\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.702547, "o", "> "]
[79.702603, "o", "    read_existing(days);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.702709, "o", "    for (const auto &u : urns) days[u.day] += u.n;\r\n\u001b[?2004l\r"]
[79.702762, "o", "\u001b[?2004h> "]
[79.702848, "o", "    const std::string cover = urns.back().id;\r\n\u001b[?2004l\r"]
[79.702898, "o", "\u001b[?2004h"]
[79.702948, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.702999, "o", "    std::ostringstream daytext, emit;\r\n\u001b[?2004l\r"]
[79.703066, "o", "\u001b[?2004h> "]
[79.703122, "o", "    for (const auto &kv : days) {\r\n\u001b[?2004l\r"]
[79.703176, "o", "\u001b[?2004h> "]
[79.703286, "o", "        daytext << kv.first << ' ' << kv.second << '\\n';\r\n\u001b[?2004l\r"]
[79.703357, "o", "\u001b[?2004h> "]
[79.703438, "o", "        emit << kv.first << ' ' << kv.second << '\\n';\r\n\u001b[?2004l\r"]
[79.703488, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.703533, "o", "> "]
[79.7036, "o", "    emit << \"covers \" << cover << '\\n';\r\n\u001b[?2004l\r"]
[79.703649, "o", "\u001b[?2004h> "]
[79.70384, "o", "    if (!replace_file(\"/app/snapvat/days.new\", \"/app/snapvat/days.tmp\", daytext.str())) return 1;\r\n\u001b[?2004l\r"]
[79.703891, "o", "\u001b[?2004h"]
[79.703905, "o", "> "]
[79.704084, "o", "    if (!replace_file(\"/app/inkpit/emit.new\", \"/app/inkpit/emit.inc\", emit.str())) return 1;\r\n\u001b[?2004l\r"]
[79.704142, "o", "\u001b[?2004h> "]
[79.704352, "o", "    { std::ofstream out(\"/app/snapvat/last.id\", std::ios::trunc); if (!out) return 1; out << cover << '\\n'; }\r\n\u001b[?2004l\r"]
[79.704405, "o", "\u001b[?2004h"]
[79.704456, "o", "> "]
[79.704699, "o", "    { std::ofstream out(\"/app/snapvat/folded.list\", std::ios::trunc); if (!out) return 1; for (const auto &u : urns) out << u.path << '\\n'; }\r\n\u001b[?2004l\r"]
[79.704761, "o", "\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r"]
[79.704816, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.704869, "o", "EOF\r\n\u001b[?2004l\r"]
[79.706114, "o", "\u001b[?2004hroot@6dc4f0252ff0:/app# "]
[79.706226, "o", "cat > /app/ribcli/run_k.cpp <<'EOF'\r\n\u001b[?2004l\r"]
[79.706283, "o", "\u001b[?2004h> "]
[79.706339, "o", "#include \"hull.hpp\"\r\n\u001b[?2004l\r"]
[79.706393, "o", "\u001b[?2004h> "]
[79.706447, "o", "#include \"fold.hpp\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.7065, "o", "#include \"mark.hpp\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.706553, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.706606, "o", "int run_k(void) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.706659, "o", "> "]
[79.706713, "o", "    int rc = n_fold();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.706781, "o", "    if (rc != 0) return rc;\r\n\u001b[?2004l\r"]
[79.706839, "o", "\u001b[?2004h> "]
[79.70691, "o", "    return op_b();\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[79.706992, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[79.708281, "o", "\u001b[?2004hroot@6dc4f0252ff0:/app# "]
[80.158644, "i", "cat > /app/ribcli/hull_cli.cpp <<'EOF'\n#include \"admit.hpp\"\n#include \"hull.hpp\"\n\n#include <cerrno>\n#include <climits>\n#include <cstdlib>\n#include <fstream>\n#include <iostream>\n#include <map>\n#include <regex>\n#include <sstream>\n#include <string>\n#include <sys/stat.h>\n#include <unistd.h>\n\nstruct Parsed { std::string id, day; int n = 0; };\n\nstatic bool parse_urn(const std::string &path, Parsed &u) {\n    std::ifstream in(path);\n    std::string banner, a, b, c, extra;\n    if (!std::getline(in, banner) || banner != \"URN1\" ||\n        !std::getline(in, a) || !std::getline(in, b) || !std::getline(in, c) ||\n        std::getline(in, extra)) return false;\n    if (a.rfind(\"id \",0) || b.rfind(\"day \",0) || c.rfind(\"n \",0)) return false;\n    u.id=a.substr(3); u.day=b.substr(4);\n    if (u.id.empty() || u.id.find_first_of(\" \\t/\\\\\") != std::string::npos ||\n        !std::regex_match(u.day, std::regex(\"[0-9]{4}-[0-9]{2}-[0-9]{2}\"))) return false;\n    char *end=nullptr; errno=0; long v=std::strtol(c.c_str()+2,&end,10);\n    if (errno || !end || *end || v<INT_MIN || v>INT_MAX) return false;\n    u.n=static_cast<int>(v); return true;\n}\n\nstatic int do_pour(const char *src) {\n    if (op_a() != 0) return 1;\n    Parsed u; if (!parse_urn(src, u)) return 1;\n    mkdir(\"/app/snapvat/live\", 0755);\n    unsigned long long seq=0;\n    { std::ifstream in(\"/app/snapvat/queue.seq\"); in >> seq; }\n    ++seq;\n    { std::ofstream out(\"/app/snapvat/queue.seq\",std::ios::trunc); if(!out) return 1; out<<seq<<'\\n'; }\n    std::ostringstream base; base << \"/app/snapvat/live/\";\n    base.width(20); base.fill('0'); base << seq; base << '-' << u.id;\n    std::string tmp=base.str()+\".new\", dst=base.str()+\".urn\";\n    { std::ifstream in(src,std::ios::binary); std::ofstream out(tmp,std::ios::binary|std::ios::trunc);\n      if(!in||!out) return 1; out<<in.rdbuf(); if(!out) { unlink(tmp.c_str()); return 1; } }\n    if(rename(tmp.c_str(),dst.c_str()) != 0) { unlink(tmp.c_str()); return 1; }\n    return 0;\n}\n\nstatic int write_json() {\n    std::map<std::string,long long> days;\n    { std::ifstream in(\"/app/snapvat/days.tmp\"); std::string d; long long n; while(in>>d>>n) days[d]+=n; }\n    std::string cover; { std::ifstream in(\"/app/snapvat/cover.tmp\"); in>>cover; }\n    if(cover.empty()) return 1;\n    std::ostringstream body; body<<\"{\\\"days\\\":{\"; bool first=true;\n    for(const auto &kv:days) { if(!first) body<<','; first=false; body<<'\"'<<kv.first<<\"\\\":\"<<kv.second; }\n    body<<\"},\\\"covers\\\":\\\"\"<<cover<<\"\\\"}\\n\";\n    std::string tmp=\"/app/inkpit/counts.new\";\n    { std::ofstream out(tmp,std::ios::trunc); if(!out)return 1; out<<body.str(); if(!out)return 1; }\n    return rename(tmp.c_str(),\"/app/inkpit/counts.json\")==0 ? 0 : 1;\n}\n\nstatic int do_steep() {\n    if(op_a()!=0) return 1;\n    int rc=run_k();\n    if(rc!=0) return rc;\n    if(write_json()!=0) return 1;\n    std::ifstream list(\"/app/snapvat/folded.list\"); std::string path;\n    while(std::getline(list,path)) if(!path.empty()) unlink(path.c_str());\n    unlink(\"/app/snapvat/folded.list\");\n    return 0;\n}\nstatic int do_board() { std::ifstream in(\"/app/inkpit/counts.json\"); if(!in)return 1; std::cout<<in.rdbuf(); return 0; }\nint main(int argc,char **argv) {\n    if(argc<2)return 2; std::string cmd=argv[1];\n    if(cmd==\"pour\") return argc==3 ? do_pour(argv[2]) : 2;\n    if(cmd==\"steep\") return argc==2 ? do_steep() : 2;\n    if(cmd==\"board\") return argc==2 ? do_board() : 2;\n    return 2;\n}\nEOF\nmake -C /app/ribcli -f hull.mk hull\n"]
