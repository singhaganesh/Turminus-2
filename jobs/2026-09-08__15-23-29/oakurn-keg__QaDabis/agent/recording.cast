[10.75469, "o", "status=0\r\n"]
[10.754799, "o", "\u001b[?2004hroot@6dc4f0252ff0:/app# "]
[18.472088, "i", "for f in /app/latchpit/* /app/stampwire/* /app/dayfold/* /app/holdbay/* /app/ribcli/*.hpp /app/ribcli/*.cpp /app/ribcli/README.txt; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[18.472806, "o", "for f in /app/latchpit/* /app/stampwire/* /app/dayfold/* /app/holdbay/* /app/ribcli/*.hpp /app/ribcli/*.cpp /app/ribcli/README.txt; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[18.473126, "o", "===== /app/latchpit/admit.hpp =====\r\n"]
[18.474884, "o", "#pragma once\r\nint op_a(void);\r\n"]
[18.475178, "o", "===== /app/latchpit/op_a.cpp =====\r\n"]
[18.477973, "o", "#include \"admit.hpp\"\r\n\r\n#include <errno.h>\r\n#include <fcntl.h>\r\n#include <unistd.h>\r\n\r\nint op_a(void) {\r\n    int fd = open(\"/app/snapvat/busy.latch\", O_RDONLY);\r\n    if (fd >= 0) {\r\n        close(fd);\r\n        return 1;\r\n    }\r\n    if (errno != ENOENT) {\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[18.478589, "o", "===== /app/stampwire/mark.hpp =====\r\n"]
[18.480636, "o", "#pragma once\r\nint op_b(void);\r\n"]
[18.480907, "o", "===== /app/stampwire/op_b.cpp =====\r\n"]
[18.48237, "o", "#include \"mark.hpp\"\r\n\r\n#include <fstream>\r\n#include <string>\r\n\r\nint op_b(void) {\r\n    std::ifstream in(\"/app/snapvat/last.id\");\r\n    std::string tok;\r\n    if (!(in >> tok) || tok.empty()) {\r\n        tok = \"none\";\r\n    }\r\n    std::ofstream out(\"/app/snapvat/cover.tmp\");\r\n    if (!out) {\r\n        return 1;\r\n    }\r\n    out << tok << \"\\n\";\r\n    return 0;\r\n}\r\n"]
[18.482664, "o", "===== /app/dayfold/fold.hpp =====\r\n"]
[18.483958, "o", "#pragma once\r\nint n_fold(void);\r\n"]
[18.484169, "o", "===== /app/dayfold/n_fold.cpp =====\r\n"]
[18.485565, "o", "#include \"fold.hpp\"\r\n\r\n#include <dirent.h>\r\n#include <fstream>\r\n#include <string>\r\n\r\nint n_fold(void) {\r\n    std::string wall = \"1970-01-01\";\r\n    {\r\n        std::ifstream in(\"/app/snapvat/clock.snap\");\r\n        in >> wall;\r\n        if (wall.empty()) {\r\n            wall = \"1970-01-01\";\r\n        }\r\n    }\r\n    int total = 0;\r\n    DIR *dir = opendir(\"/app/snapvat/live\");\r\n    if (dir) {\r\n        while (dirent *ent = readdir(dir)) {\r\n            std::string name = ent->d_name;\r\n            if (name.size() < 5 || name.substr(name.size() - 4) != \".urn\") {\r\n                continue;\r\n"]
[18.485774, "o", "            }\r\n            std::ifstream in(std::string(\"/app/snapvat/live/\") + name);\r\n            std::string line;\r\n            int n = 0;\r\n            while (std::getline(in, line)) {\r\n                if (line.rfind(\"n \", 0) == 0) {\r\n                    n = std::stoi(line.substr(2));\r\n                }\r\n            }\r\n            total += n;\r\n        }\r\n        closedir(dir);\r\n    }\r\n    int tick = 0;\r\n    {\r\n        std::ifstream tin(\"/app/snapvat/tick\");\r\n        tin >> tick;\r\n    }\r\n    tick += 1;\r\n    {\r\n        std::ofstream tout(\"/app/snapvat/tick\");\r\n        tout << tick << \"\\n\";\r\n    }\r\n    std::ofstream tmp(\"/app/snapvat/days.tmp\");\r\n    if (!tmp) {\r\n        return 1;\r\n"]
[18.485862, "o", "    }\r\n    tmp << wall << \" \" << total << \"\\n\";\r\n    std::ofstream emit(\"/app/inkpit/emit.inc\");\r\n    if (!emit) {\r\n        return 1;\r\n    }\r\n    emit << wall << \" \" << total << \" tick=\" << tick << \"\\n\";\r\n    return 0;\r\n}\r\n"]
[18.486067, "o", "===== /app/holdbay/HOLD.txt =====\r\n"]
[18.487165, "o", "Optional exclusive mill hold. Not on the pour/steep path unless wired in.\r\n"]
[18.487382, "o", "===== /app/holdbay/hold.cpp =====\r\n"]
[18.488386, "o", "#include \"hold.hpp\"\r\n\r\n#include <fstream>\r\n#include <string>\r\n\r\nint hold_ex(void) {\r\n    std::ifstream in(\"/app/snapvat/clock.snap\");\r\n    std::string d;\r\n    in >> d;\r\n"]
[18.488481, "o", "    std::ofstream out(\"/app/snapvat/hold.flag\");\r\n    if (!out) {\r\n        return 1;\r\n    }\r\n    out << \"exclusive \" << d << \"\\n\";\r\n    return 0;\r\n}\r\n"]
[18.488636, "o", "===== /app/holdbay/hold.hpp =====\r\n"]
[18.489891, "o", "#pragma once\r\nint hold_ex(void);\r\n"]
[18.490143, "o", "===== /app/ribcli/hull.hpp =====\r\n"]
[18.491301, "o", "#pragma once\r\nint run_k(void);\r\n"]
[18.49158, "o", "===== /app/ribcli/hull_cli.cpp =====\r\n"]
[18.49359, "o", "#include \"admit.hpp\"\r\n#include \"hull.hpp\"\r\n\r\n#include <dirent.h>\r\n#include <fstream>\r\n#include <iostream>\r\n#include <map>\r\n#include <sstream>\r\n#include <string>\r\n#include <sys/stat.h>\r\n#include <unistd.h>\r\n\r\nstatic int copy_file(const std::string &src, const std::string &dst) {\r\n    std::ifstream in(src, std::ios::binary);\r\n    if (!in) {\r\n        return 1;\r\n    }\r\n    std::ofstream out(dst, std::ios::binary);\r\n    if (!out) {\r\n        return 1;\r\n    }\r\n    out << in.rdbuf();\r\n    return 0;\r\n}\r\n\r\nstatic std::string urn_id(const std::string &path) {\r\n    std::ifstream in(path);\r\n    std::string line;\r\n    while (std::getline(in, line)) {\r\n        if (line.rfind(\"id \", 0) == 0) {\r\n            return line.substr(3);\r\n        }\r\n    }\r\n    return \"\";\r\n}\r\n\r\nstatic int do_pour(const char *src) {\r\n    mkdir(\"/app/snapvat/live\", 0755);\r\n    std::string id = urn_id(src);\r\n    if (id.empty()) {\r\n        return 1;\r\n    }\r\n    std::string dst = std::string(\"/app/snapvat/live/\") + id + \".urn\";\r\n    if (copy_file(src, dst) != 0) {\r\n        return 1;\r\n    }\r\n    std::ofstream poured(\"/app/snapvat/poured.txt\");\r\n"]
[18.493982, "o", "    poured << id << \"\\n\";\r\n    return 0;\r\n}\r\n\r\nstatic int write_json() {\r\n    std::map<std::string, int> days;\r\n    {\r\n        std::ifstream in(\"/app/snapvat/days.tmp\");\r\n        std::string d;\r\n        int n = 0;\r\n        while (in >> d >> n) {\r\n            days[d] += n;\r\n        }\r\n    }\r\n    std::string cover;\r\n    {\r\n        std::ifstream in(\"/app/snapvat/cover.tmp\");\r\n        in >> cover;\r\n    }\r\n    std::ostringstream body;\r\n    body << \"{\\\"days\\\":{\";\r\n    bool first = true;\r\n    for (const auto &kv : days) {\r\n        if (!first) {\r\n            body << \",\";\r\n        }\r\n        first = false;\r\n        body << \"\\\"\" << kv.first << \"\\\":\" << kv.second;\r\n    }\r\n    body << \"},\\\"covers\\\":\\\"\" << cover << \"\\\"}\\n\";\r\n    std::ofstream out(\"/app/inkpit/counts.json\");\r\n    if (!out) {\r\n        return 1;\r\n    }\r\n    out << body.str();\r\n    return 0;\r\n}\r\n\r\nstatic std::string read_text(const std::string &path) {\r\n    std::ifstream in(path);\r\n    std::ostringstream ss;\r\n    ss << in.rdbuf();\r\n    return ss.str();\r\n}\r\n\r\nstatic int do_steep() {\r\n    if (op_a() != 0) {\r\n        return 0;\r\n    }\r\n    std::string prev = read_text(\"/app/snapvat/emit.prev\");\r\n    if (run_k() != 0) {\r\n        return 1;\r\n    }\r\n    if (write_json() != 0) {\r\n        return 1;\r\n    }\r\n    std::string emit = read_text(\"/app/inkpit/emit.inc\");\r\n    if (!prev.empty() && emit == prev) {\r\n        return 1;\r\n    }\r\n    std::ofstream prevf(\"/app/snapvat/emit.prev\");\r\n    prevf << emit;\r\n    return 0;\r\n}\r\n\r\nstatic int do_board() {\r\n    std::ifstream in(\"/app/inkpit/counts.json\");\r\n    if (!in) {\r\n        return 1;\r\n    }\r\n"]
[18.494175, "o", "    std::cout << in.rdbuf();\r\n    return 0;\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc < 2) {\r\n        return 2;\r\n    }\r\n    std::string cmd = argv[1];\r\n    if (cmd == \"pour\") {\r\n        if (argc < 3) {\r\n            return 2;\r\n        }\r\n        return do_pour(argv[2]);\r\n    }\r\n    if (cmd == \"steep\") {\r\n        return do_steep();\r\n    }\r\n    if (cmd == \"board\") {\r\n        return do_board();\r\n    }\r\n    return 2;\r\n}\r\n"]
[18.494545, "o", "===== /app/ribcli/run_k.cpp =====\r\n"]
[18.49606, "o", "#include \"hull.hpp\"\r\n#include \"fold.hpp\"\r\n#include \"mark.hpp\"\r\n\r\nint run_k(void) {\r\n    if (n_fold() != 0) {\r\n        return 1;\r\n    }\r\n    if (op_b() != 0) {\r\n"]
[18.496192, "o", "        return 1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[18.496334, "o", "===== /app/ribcli/README.txt =====\r\n"]
[18.497379, "o", "Rebuild the linked mill with:\r\n\r\n  make -C /app/ribcli -f hull.mk hull\r\n"]
[18.497626, "o", "\u001b[?2004hroot@6dc4f0252ff0:/app# "]
[19.439792, "i", "printf '%s\\n' '--- notes ---'; for f in /app/treenote/floor.txt /app/snapvat/NOTE.txt /app/holdbay/HOLD.txt; do echo \"===== $f =====\"; cat \"$f\"; done; printf '%s\\n' '--- scratch metadata/content ---'; find /app/snapvat -maxdepth 2 -printf '%M %u:%g %s %TY-%Tm-%Td %TH:%TM:%TS %p\\n' | sort; for f in /app/snapvat/clock.snap /app/snapvat/emit.prev /app/snapvat/last.id /app/snapvat/tick /app/snapvat/busy.latch; do echo \"===== $f =====\"; xxd \"$f\" 2>/dev/null || true; done\n"]
[19.441574, "o", "printf '%s\\n' '--- notes ---'; for f in /app/treenote/floor.txt /app/snapvat/NOTE.txt /app/holdbay/HOLD.txt; do echo \"===== $f =====\"; cat \"$f\"; done; printf '%s\\n' '--- scratch metadata/content ---'; find /app/snapvat -maxdepth 2 -printf '%M %u:%g %s %TY-%Tm-%Td %TH:%TM:%TS %p\\n' | sort; for f in /app/snapvat/clock.snap /app/snapvat/emit.prev /app/snapvat/last.id /app/snapvat/tick /app/snapvat/busy.latch; do echo \"===== $f =====\"; xxd \"$f\" 2>/dev/null || true; done\r\n\u001b[?2004l\r"]
[19.441783, "o", "--- notes ---\r\n"]
[19.442723, "o", "===== /app/treenote/floor.txt =====\r\n"]
[19.443644, "o", "Busy-floor note: some shifts invoke steep with an exclusive hold so the mill never shares the floor. The hold helper lives under /app/holdbay. Desk stalls that recover overnight often get blamed on overlap, not on a finished JSON object.\r\n"]
[19.44389, "o", "===== /app/snapvat/NOTE.txt =====\r\n"]
[19.444983, "o", "Wall stamp for mill-local calendar sketches. Not the urn day field.\r\n"]
[19.445766, "o", "===== /app/holdbay/HOLD.txt =====\r\n"]
[19.446549, "o", "Optional exclusive mill hold. Not on the pour/steep path unless wired in.\r\n"]
