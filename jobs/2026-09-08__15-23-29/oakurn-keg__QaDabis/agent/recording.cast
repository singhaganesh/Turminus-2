[79.68328, "i", "cat > /app/latchpit/op_a.cpp <<'EOF'\n#include \"admit.hpp\"\n\n#include <fcntl.h>\n#include <sys/file.h>\n#include <unistd.h>\n\nint op_a(void) {\n    static int lock_fd = -1;\n    if (lock_fd >= 0) return 0;\n    int fd = open(\"/app/snapvat/busy.latch\", O_RDWR | O_CREAT, 0664);\n    if (fd < 0) return 1;\n    if (flock(fd, LOCK_EX) != 0) {\n        close(fd);\n        return 1;\n    }\n    lock_fd = fd; // The kernel releases the hold when this process exits.\n    return 0;\n}\nEOF\ncat > /app/stampwire/op_b.cpp <<'EOF'\n#include \"mark.hpp\"\n\n#include <fstream>\n#include <string>\n\nint op_b(void) {\n    std::ifstream in(\"/app/snapvat/last.id\");\n    std::string id;\n    if (!(in >> id) || id.empty()) return 1;\n    std::ofstream out(\"/app/snapvat/cover.tmp\", std::ios::trunc);\n    if (!out) return 1;\n    out << id << '\\n';\n    return out ? 0 : 1;\n}\nEOF\ncat > /app/dayfold/n_fold.cpp <<'EOF'\n#include \"fold.hpp\"\n\n#include <algorithm>\n#include <cerrno>\n#include <climits>\n#include <cstdlib>\n#include <dirent.h>\n#include <fstream>\n#include <map>\n#include <regex>\n#include <sstream>\n#include <string>\n#include <vector>\n#include <unistd.h>\n\nstruct Urn { std::string path, id, day; int n = 0; };\n\nstatic bool parse_urn(const std::string &path, Urn &u) {\n    std::ifstream in(path);\n    std::string banner, a, b, c, extra;\n    if (!std::getline(in, banner) || banner != \"URN1\" ||\n        !std::getline(in, a) || !std::getline(in, b) || !std::getline(in, c) ||\n        std::getline(in, extra)) return false;\n    if (a.rfind(\"id \", 0) != 0 || b.rfind(\"day \", 0) != 0 || c.rfind(\"n \", 0) != 0) return false;\n    u.path = path; u.id = a.substr(3); u.day = b.substr(4);\n    if (u.id.empty() || u.id.find_first_of(\" \\t/\\\\\") != std::string::npos ||\n        !std::regex_match(u.day, std::regex(\"[0-9]{4}-[0-9]{2}-[0-9]{2}\"))) return false;\n    char *end = nullptr; errno = 0;\n    long value = std::strtol(c.c_str() + 2, &end, 10);\n    if (errno || !end || *end != '\\0' || value < INT_MIN || value > INT_MAX) return false;\n    u.n = static_cast<int>(value);\n    return true;\n}\n\nstatic void read_existing(std::map<std::string, long long> &days) {\n    std::ifstream in(\"/app/inkpit/counts.json\");\n    std::ostringstream ss; ss << in.rdbuf();\n    const std::string text = ss.str();\n    const std::regex pair(\"\\\\\\\"([0-9]{4}-[0-9]{2}-[0-9]{2})\\\\\\\"[[:space:]]*:[[:space:]]*(-?[0-9]+)\");\n    for (std::sregex_iterator it(text.begin(), text.end(), pair), end; it != end; ++it)\n        days[(*it)[1].str()] += std::stoll((*it)[2].str());\n}\n\nstatic bool replace_file(const std::string &tmp, const std::string &dst, const std::string &body) {\n    { std::ofstream out(tmp, std::ios::trunc); if (!out) return false; out << body; if (!out) return false; }\n    return rename(tmp.c_str(), dst.c_str()) == 0;\n}\n\nint n_fold(void) {\n    std::vector<std::string> paths;\n    DIR *dir = opendir(\"/app/snapvat/live\");\n    if (!dir) return 1;\n    while (dirent *ent = readdir(dir)) {\n        std::string name = ent->d_name;\n        if (name.size() >= 4 && name.substr(name.size() - 4) == \".urn\")\n            paths.push_back(\"/app/snapvat/live/\" + name);\n    }\n    closedir(dir);\n    std::sort(paths.begin(), paths.end());\n    if (paths.empty()) return 2;\n\n    std::vector<Urn> urns;\n    for (const auto &path : paths) {\n        Urn u;\n        if (!parse_urn(path, u)) return 1;\n        urns.push_back(u);\n    }\n    std::map<std::string, long long> days;\n    read_existing(days);\n    for (const auto &u : urns) days[u.day] += u.n;\n    const std::string cover = urns.back().id;\n\n    std::ostringstream daytext, emit;\n    for (const auto &kv : days) {\n        daytext << kv.first << ' ' << kv.second << '\\n';\n        emit << kv.first << ' ' << kv.second << '\\n';\n    }\n    emit << \"covers \" << cover << '\\n';\n    if (!replace_file(\"/app/snapvat/days.new\", \"/app/snapvat/days.tmp\", daytext.str())) return 1;\n    if (!replace_file(\"/app/inkpit/emit.new\", \"/app/inkpit/emit.inc\", emit.str())) return 1;\n    { std::ofstream out(\"/app/snapvat/last.id\", std::ios::trunc); if (!out) return 1; out << cover << '\\n'; }\n    { std::ofstream out(\"/app/snapvat/folded."]
[79.68343, "i", "list\", std::ios::trunc); if (!out) return 1; for (const auto &u : urns) out << u.path << '\\n'; }\n    return 0;\n}\nEOF\ncat > /app/ribcli/run_k.cpp <<'EOF'\n#include \"hull.hpp\"\n#include \"fold.hpp\"\n#include \"mark.hpp\"\n\nint run_k(void) {\n    int rc = n_fold();\n    if (rc != 0) return rc;\n    return op_b();\n}\nEOF\n"]
