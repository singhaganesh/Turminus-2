     8	#include <sstream>
     9	#include <string>
    10	#include <sys/stat.h>
    11	#include <unistd.h>
    12	
    13	static int copy_file(const std::string &src, const std::string &dst) {
    14	    std::ifstream in(src, std::ios::binary);
    15	    if (!in) {
    16	        return 1;
    17	    }
    18	    std::ofstream out(dst, std::ios::binary);
    19	    if (!out) {
    20	        return 1;
    21	    }
    22	    out << in.rdbuf();
    23	    return 0;
    24	}
    25	
    26	static std::string urn_id(const std::string &path) {
    27	    std::ifstream in(path);
    28	    std::string line;
    29	    while (std::getline(in, line)) {
    30	        if (line.rfind("id ", 0) == 0) {
    31	            return line.substr(3);
    32	        }
    33	    }
    34	    return "";
    35	}
    36	
    37	static int do_pour(const char *src) {
    38	    mkdir("/app/snapvat/live", 0755);
    39	    std::string id = urn_id(src);
    40	    if (id.empty()) {
    41	        return 1;
    42	    }
    43	    std::string dst = std::string("/app/snapvat/live/") + id + ".urn";
    44	    if (copy_file(src, dst) != 0) {
    45	        return 1;
    46	    }
    47	    std::ofstream poured("/app/snapvat/poured.txt");
    48	    poured << id << "\n";
    49	    return 0;
    50	}
    51	
    52	static int write_json() {
    53	    std::map<std::string, int> days;
    54	    {
    55	        std::ifstream in("/app/snapvat/days.tmp");
    56	        std::string d;
    57	        int n = 0;
    58	        while (in >> d >> n) {
    59	            days[d] += n;
    60	        }
    61	    }
    62	    std::string cover;
    63	    {
    64	        std::ifstream in("/app/snapvat/cover.tmp");
    65	        in >> cover;
    66	    }
    67	    std::ostringstream body;
    68	    body << "{\"days\":{";
    69	    bool first = true;
    70	    for (const auto &kv : days) {
    71	        if (!first) {
    72	            body << ",";
    73	        }
    74	        first = false;
    75	        body << "\"" << kv.first << "\":" << kv.second;
    76	    }
    77	    body << "},\"covers\":\"" << cover << "\"}\n";
    78	    std::ofstream out("/app/inkpit/counts.json");
    79	    if (!out) {
    80	        return 1;
    81	    }
    82	    out << body.str();
    83	    return 0;
    84	}
    85	
    86	static std::string read_text(const std::string &path) {
    87	    std::ifstream in(path);
    88	    std::ostringstream ss;
    89	    ss << in.rdbuf();
    90	    return ss.str();
    91	}
    92	
    93	static int do_steep() {
    94	    if (op_a() != 0) {
    95	        return 0;
    96	    }
    97	    std::string prev = read_text("/app/snapvat/emit.prev");
    98	    if (run_k() != 0) {
    99	        return 1;
   100	    }
   101	    if (write_json() != 0) {
   102	        return 1;
   103	    }
   104	    std::string emit = read_text("/app/inkpit/emit.inc");
   105	    if (!prev.empty() && emit == prev) {
   106	        return 1;
   107	    }
   108	    std::ofstream prevf("/app/snapvat/emit.prev");
   109	    prevf << emit;
   110	    return 0;
   111	}
   112	
   113	static int do_board() {
   114	    std::ifstream in("/app/inkpit/counts.json");
   115	    if (!in) {
   116	        return 1;
   117	    }
   118	    std::cout << in.rdbuf();
   119	    return 0;
   120	}
   121	
   122	int main(int argc, char **argv) {
   123	    if (argc < 2) {
   124	        return 2;
   125	    }
   126	    std::string cmd = argv[1];
   127	    if (cmd == "pour") {
   128	        if (argc < 3) {
   129	            return 2;
   130	        }
   131	        return do_pour(argv[2]);
   132	    }
   133	    if (cmd == "steep") {
   134	        return do_steep();
   135	    }
   136	    if (cmd == "board") {
   137	        return do_board();
   138	    }
   139	    return 2;
   140	}
