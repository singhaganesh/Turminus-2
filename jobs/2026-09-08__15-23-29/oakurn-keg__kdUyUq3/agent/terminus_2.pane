#include "admit.hpp"

#include <errno.h>
#include <fcntl.h>
#include <unistd.h>

int op_a(void) {
    int fd = open("/app/snapvat/busy.latch", O_RDONLY);
    if (fd >= 0) {
        close(fd);
        return 1;
    }
    if (errno != ENOENT) {
        return 1;
    }
    return 0;
}
===== /app/stampwire/mark.hpp =====
#pragma once
int op_b(void);
===== /app/stampwire/op_b.cpp =====
#include "mark.hpp"

#include <fstream>
#include <string>

int op_b(void) {
    std::ifstream in("/app/snapvat/last.id");
    std::string tok;
    if (!(in >> tok) || tok.empty()) {
        tok = "none";
    }
    std::ofstream out("/app/snapvat/cover.tmp");
    if (!out) {
        return 1;
    }
    out << tok << "\n";
    return 0;
}
