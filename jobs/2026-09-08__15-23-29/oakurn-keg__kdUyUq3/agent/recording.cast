[90.338248, "o", "\u001b[?2004hroot@7c2064acc33c:/app# "]
[90.471397, "i", "cat > /app/ribcli/hull_cli.cpp <<'EOF'\n#include \"admit.hpp\"\n#include \"hull.hpp\"\n\n#include <cstdio>\n#include <fcntl.h>\n#include <fstream>\n#include <iostream>\n#include <map>\n#include <sstream>\n#include <string>\n#include <sys/file.h>\n#include <sys/stat.h>\n#include <unistd.h>\n#include <vector>\n\nclass MillLock {\n    int fd_ = -1;\npublic:\n    MillLock() {\n        fd_ = open(\"/app/snapvat/busy.latch\", O_RDWR | O_CREAT, 0664);\n        if (fd_ >= 0 && flock(fd_, LOCK_EX) != 0) { close(fd_); fd_ = -1; }\n    }\n    ~MillLock() { if (fd_ >= 0) { flock(fd_, LOCK_UN); close(fd_); } }\n    bool good() const { return fd_ >= 0; }\n};\n\nstatic bool valid_id(const std::string &id) {\n    if (id.empty()) return false;\n    for (unsigned char c : id)\n        if (!(c >= 'a' && c <= 'z') && !(c >= 'A' && c <= 'Z') &&\n            !(c >= '0' && c <= '9') && c != '_' && c != '-') return false;\n    return true;\n}\n\nstatic std::string urn_id(const std::string &path) {\n    std::ifstream in(path);\n    std::string banner, key, id;\n    if (!(in >> banner >> key >> id) || banner != \"URN1\" || key != \"id\" || !valid_id(id))\n        return \"\";\n    return id;\n}\n\nstatic int copy_atomic(const std::string &src, const std::string &dst) {\n    std::ifstream in(src, std::ios::binary);\n    if (!in) return 1;\n    const std::string tmp = dst + \".tmp.\" + std::to_string(getpid());\n    {\n        std::ofstream out(tmp, std::ios::binary | std::ios::trunc);\n        if (!out) return 1;\n        out << in.rdbuf();\n        if (!in.eof() || !out) { std::remove(tmp.c_str()); return 1; }\n    }\n    if (std::rename(tmp.c_str(), dst.c_str()) != 0) { std::remove(tmp.c_str()); return 1; }\n    return 0;\n}\n\nstatic int do_pour(const char *src) {\n    mkdir(\"/app/snapvat\", 0755);\n    mkdir(\"/app/snapvat/live\", 0755);\n    MillLock lock;\n    if (!lock.good()) return 1;\n    std::string id = urn_id(src);\n    if (id.empty()) return 1;\n    if (copy_atomic(src, \"/app/snapvat/live/\" + id + \".urn\") != 0) return 1;\n    std::ofstream queue(\"/app/snapvat/poured.txt\", std::ios::app);\n    if (!queue || !(queue << id << \"\\n\")) return 1;\n    return 0;\n}\n\nstatic int write_json() {\n    std::map<std::string, long long> days;\n    std::ifstream din(\"/app/snapvat/days.tmp\");\n    std::string day;\n    long long n;\n    while (din >> day >> n) days[day] += n;\n    if (!din.eof()) return 1;\n    std::string cover;\n    { std::ifstream in(\"/app/snapvat/cover.tmp\"); if (!(in >> cover)) return 1; }\n    std::ostringstream body;\n    body << \"{\\\"days\\\":{\";\n    bool first = true;\n    for (const auto &kv : days) {\n        if (!first) body << ',';\n        first = false;\n        body << '\\\"' << kv.first << \"\\\":\" << kv.second;\n    }\n    body << \"},\\\"covers\\\":\\\"\" << cover << \"\\\"}\\n\";\n    const std::string tmp = \"/app/inkpit/counts.json.tmp.\" + std::to_string(getpid());\n    { std::ofstream out(tmp, std::ios::trunc); if (!out || !(out << body.str())) return 1; }\n    if (std::rename(tmp.c_str(), \"/app/inkpit/counts.json\") != 0) {\n        std::remove(tmp.c_str()); return 1;\n    }\n    return 0;\n}\n\nstatic int do_steep() {\n    MillLock lock;\n    if (!lock.good() || op_a() != 0) return 1;\n    std::ifstream qin(\"/app/snapvat/poured.txt\");\n    std::vector<std::string> queue;\n    std::string id;\n    while (qin >> id) queue.push_back(id);\n    if (queue.empty()) return 1;\n    { std::ofstream out(\"/app/snapvat/last.id\", std::ios::trunc); if (!out || !(out << queue.front() << \"\\n\")) return 1; }\n    if (run_k() != 0 || write_json() != 0) return 1;\n    const std::string qtmp = \"/app/snapvat/poured.txt.tmp.\" + std::to_string(getpid());\n    {\n        std::ofstream out(qtmp, std::ios::trunc);\n        if (!out) return 1;\n        for (size_t i = 1; i < queue.size(); ++i) out << queue[i] << \"\\n\";\n        if (!out) { std::remove(qtmp.c_str()); return 1; }\n    }\n    if (std::rename(qtmp.c_str(), \"/app/snapvat/poured.txt\") != 0) {\n        std::remove(qtmp.c_str()); return 1;\n    }\n    return 0;\n}\n\nstatic int do_board() {\n    std::ifstream in(\"/app/inkpit/counts.json\");\n    if (!in) return 1;\n    std::cout << in.rdbuf();\n    return in.bad() ? 1 : 0;\n}\n\nint main(in"]
[90.471575, "i", "t argc, char **argv) {\n    if (argc < 2) return 2;\n    std::string cmd = argv[1];\n    if (cmd == \"pour\") return argc == 3 ? do_pour(argv[2]) : 2;\n    if (cmd == \"steep\") return argc == 2 ? do_steep() : 2;\n    if (cmd == \"board\") return argc == 2 ? do_board() : 2;\n    return 2;\n}\nEOF\nmake -C /app/ribcli -f hull.mk hull\n"]
