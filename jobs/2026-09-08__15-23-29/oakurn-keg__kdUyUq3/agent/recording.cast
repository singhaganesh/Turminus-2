[10.465888, "o", "\u001b[?2004hroot@7c2064acc33c:/app# "]
[20.611222, "i", "for f in /app/latchpit/* /app/stampwire/* /app/dayfold/* /app/ribcli/* /app/holdbay/* /app/snapvat/NOTE.txt /app/treenote/floor.txt; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
[20.611848, "o", "for f in /app/latchpit/* /app/stampwire/* /app/dayfold/* /app/ribcli/* /app/holdbay/* /app/snapvat/NOTE.txt /app/treenote/floor.txt; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[20.612139, "o", "===== /app/latchpit/admit.hpp =====\r\n"]
[20.61396, "o", "#pragma once\r\nint op_a(void);\r\n"]
[20.614312, "o", "===== /app/latchpit/op_a.cpp =====\r\n"]
[20.615645, "o", "#include \"admit.hpp\"\r\n\r\n#include <errno.h>\r\n#include <fcntl.h>\r\n#include <unistd.h>\r\n\r\nint op_a(void) {\r\n    int fd = open(\"/app/snapvat/busy.latch\", O_RDONLY);\r\n    if (fd >= 0) {\r\n        close(fd);\r\n        return 1;\r\n"]
[20.61577, "o", "    }\r\n    if (errno != ENOENT) {\r\n        return 1;\r\n    }\r\n    return 0;\r\n}\r\n"]
[20.615934, "o", "===== /app/stampwire/mark.hpp =====\r\n"]
[20.617339, "o", "#pragma once\r\nint op_b(void);\r\n"]
[20.617615, "o", "===== /app/stampwire/op_b.cpp =====\r\n"]
[20.619125, "o", "#include \"mark.hpp\"\r\n\r\n#include <fstream>\r\n#include <string>\r\n\r\nint op_b(void) {\r\n    std::ifstream in(\"/app/snapvat/last.id\");\r\n    std::string tok;\r\n    if (!(in >> tok) || tok.empty()) {\r\n        tok = \"none\";\r\n    }\r\n"]
[20.619243, "o", "    std::ofstream out(\"/app/snapvat/cover.tmp\");\r\n    if (!out) {\r\n        return 1;\r\n    }\r\n    out << tok << \"\\n\";\r\n    return 0;\r\n}\r\n"]
[20.619439, "o", "===== /app/dayfold/fold.hpp =====\r\n"]
[20.620615, "o", "#pragma once\r\nint n_fold(void);\r\n"]
[20.620824, "o", "===== /app/dayfold/n_fold.cpp =====\r\n"]
[20.621812, "o", "#include \"fold.hpp\"\r\n\r\n#include <dirent.h>\r\n#include <fstream>\r\n#include <string>\r\n\r\nint n_fold(void) {\r\n    std::string wall = \"1970-01-01\";\r\n    {\r\n"]
[20.621954, "o", "        std::ifstream in(\"/app/snapvat/clock.snap\");\r\n        in >> wall;\r\n        if (wall.empty()) {\r\n            wall = \"1970-01-01\";\r\n        }\r\n    }\r\n    int total = 0;\r\n    DIR *dir = opendir(\"/app/snapvat/live\");\r\n    if (dir) {\r\n        while (dirent *ent = readdir(dir)) {\r\n            std::string name = ent->d_name;\r\n            if (name.size() < 5 || name.substr(name.size() - 4) != \".urn\") {\r\n                continue;\r\n            }\r\n            std::ifstream in(std::string(\"/app/snapvat/live/\") + name);\r\n            std::string line;\r\n            int n = 0;\r\n            while (std::getline(in, line)) {\r\n                if (line.rfind(\"n \", 0) == 0) {\r\n                    n = std::stoi(line.substr(2));\r\n                }\r\n            }\r\n            total += n;\r\n        }\r\n        closedir(dir);\r\n    }\r\n    int tick = 0;\r\n    {\r\n        std::ifstream tin(\"/app/snapvat/tick\");\r\n        tin >> tick;\r\n    }\r\n    tick += 1;\r\n    {\r\n        std::ofstream tout(\"/app/snapvat/tick\");\r\n        tout << tick << \"\\n\";\r\n    }\r\n    std::ofstream tmp(\"/app/snapvat/days.tmp\");\r\n    if (!tmp) {\r\n"]
[20.622028, "o", "        return 1;\r\n    }\r\n    tmp << wall << \" \" << total << \"\\n\";\r\n    std::ofstream emit(\"/app/inkpit/emit.inc\");\r\n    if (!emit) {\r\n        return 1;\r\n    }\r\n    emit << wall << \" \" << total << \" tick=\" << tick << \"\\n\";\r\n    return 0;\r\n}\r\n"]
[20.622549, "o", "===== /app/ribcli/README.txt =====\r\n"]
[20.623844, "o", "Rebuild the linked mill with:\r\n\r\n  make -C /app/ribcli -f hull.mk hull\r\n"]
[20.624414, "o", "===== /app/ribcli/hull.hpp =====\r\n"]
[20.626846, "o", "#pragma once\r\nint run_k(void);\r\n"]
[20.627151, "o", "===== /app/ribcli/hull.mk =====\r\n"]
[20.628255, "o", "CXX ?= g++\r\nCXXFLAGS ?= -O2 -Wall -Wextra -std=c++17 -I/app/ribcli -I/app/latchpit -I/app/stampwire -I/app/dayfold -I/app/holdbay\r\nSRC := $(wildcard /app/ribcli/*.cpp) $(wildcard /app/latchpit/*.cpp) $(wildcard /app/stampwire/*.cpp) $(wildcard /app/dayfold/*.cpp) $(wildcard /app/holdbay/*.cpp)\r\nBIN := /app/bin/oakurn\r\n\r\n.PHONY: hull\r\nhull:\r\n\tmkdir -p /app/bin /app/inkpit /app/snapvat/live\r\n\t$(CXX) $(CXXFLAGS) -o $(BIN) $(SRC)\r\n"]
[20.628479, "o", "===== /app/ribcli/hull_cli.cpp =====\r\n"]
[20.629668, "o", "#include \"admit.hpp\"\r\n#include \"hull.hpp\"\r\n\r\n#include <dirent.h>\r\n#include <fstream>\r\n#include <iostream>\r\n#include <map>\r\n#include <sstream>\r\n#include <string>\r\n#include <sys/stat.h>\r\n"]
[20.629788, "o", "#include <unistd.h>\r\n\r\nstatic int copy_file(const std::string &src, const std::string &dst) {\r\n    std::ifstream in(src, std::ios::binary);\r\n    if (!in) {\r\n        return 1;\r\n    }\r\n    std::ofstream out(dst, std::ios::binary);\r\n    if (!out) {\r\n        return 1;\r\n    }\r\n    out << in.rdbuf();\r\n    return 0;\r\n}\r\n\r\nstatic std::string urn_id(const std::string &path) {\r\n    std::ifstream in(path);\r\n    std::string line;\r\n    while (std::getline(in, line)) {\r\n        if (line.rfind(\"id \", 0) == 0) {\r\n            return line.substr(3);\r\n        }\r\n    }\r\n    return \"\";\r\n}\r\n\r\nstatic int do_pour(const char *src) {\r\n    mkdir(\"/app/snapvat/live\", 0755);\r\n    std::string id = urn_id(src);\r\n    if (id.empty()) {\r\n        return 1;\r\n"]
[20.62986, "o", "    }\r\n    std::string dst = std::string(\"/app/snapvat/live/\") + id + \".urn\";\r\n    if (copy_file(src, dst) != 0) {\r\n        return 1;\r\n    }\r\n    std::ofstream poured(\"/app/snapvat/poured.txt\");\r\n    poured << id << \"\\n\";\r\n    return 0;\r\n}\r\n\r\nstatic int write_json() {\r\n    std::map<std::string, int> days;\r\n    {\r\n        std::ifstream in(\"/app/snapvat/days.tmp\");\r\n        std::string d;\r\n        int n = 0;\r\n        while (in >> d >> n) {\r\n            days[d] += n;\r\n        }\r\n    }\r\n    std::string cover;\r\n    {\r\n        std::ifstream in(\"/app/snapvat/cover.tmp\");\r\n        in >> cover;\r\n    }\r\n    std::ostringstream body;\r\n    body << \"{\\\"days\\\":{\";\r\n    bool first = true;\r\n    for (const auto &kv : days) {"]
[20.629928, "o", "\r\n        if (!first) {\r\n            body << \",\";\r\n        }\r\n        first = false;\r\n        body << \"\\\"\" << kv.first << \"\\\":\" << kv.second;\r\n    }\r\n    body << \"},\\\"covers\\\":\\\"\" << cover << \"\\\"}\\n\";\r\n    std::ofstream out(\"/app/inkpit/counts.json\");\r\n    if (!out) {\r\n        return 1;\r\n    }\r\n    out << body.str();\r\n    return 0;\r\n}\r\n\r\nstatic std::string read_text(const std::string &path) {\r\n    std::ifstream in(path);\r\n    std::ostringstream ss;\r\n    ss << in.rdbuf();\r\n    return ss.str();\r\n}\r\n\r\nstatic int do_steep() {\r\n"]
[20.629978, "o", "    if (op_a() != 0) {\r\n        return 0;\r\n    }\r\n    std::string prev = read_text(\"/app/snapvat/emit.prev\");\r\n    if (run_k() != 0) {\r\n        return 1;\r\n    }\r\n    if (write_json() != 0) {\r\n        return 1;\r\n    }\r\n    std::string emit = read_text(\"/app/inkpit/emit.inc\");\r\n    if (!prev.empty() && emit == prev) {\r\n        return 1;\r\n    }\r\n"]
[20.630074, "o", "    std::ofstream prevf(\"/app/snapvat/emit.prev\");\r\n    prevf << emit;\r\n    return 0;\r\n}\r\n\r\n"]
[20.630141, "o", "static int do_board() {\r\n    std::ifstream in(\"/app/inkpit/counts.json\");\r\n    if (!in) {\r\n        return 1;\r\n    }\r\n    std::cout << in.rdbuf();\r\n    return 0;\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc < 2) {\r\n        return 2;\r\n    }\r\n    std::string cmd = argv[1];\r\n    if (cmd == \"pour\") {\r\n        if (argc < 3) {\r\n            return 2;\r\n        }\r\n        return do_pour(argv[2]);\r\n    }\r\n    if (cmd == \"steep\") {\r\n        return do_steep();\r\n    }\r\n    if (cmd == \"board\") {\r\n        return do_board();\r\n    }\r\n    return 2;\r\n}\r\n"]
[20.630329, "o", "===== /app/ribcli/run_k.cpp =====\r\n"]
[20.631376, "o", "#include \"hull.hpp\"\r\n#include \"fold.hpp\"\r\n#include \"mark.hpp\"\r\n\r\nint run_k(void) {\r\n    if (n_fold() != 0) {\r\n        return 1;\r\n    }\r\n    if (op_b() != 0) {\r\n        return 1;\r\n    }\r\n"]
[20.631463, "o", "    return 0;\r\n}\r\n"]
[20.631604, "o", "===== /app/holdbay/HOLD.txt =====\r\n"]
[20.632826, "o", "Optional exclusive mill hold. Not on the pour/steep path unless wired in.\r\n"]
[20.633031, "o", "===== /app/holdbay/hold.cpp =====\r\n"]
[20.63396, "o", "#include \"hold.hpp\"\r\n\r\n#include <fstream>\r\n#include <string>\r\n\r\nint hold_ex(void) {\r\n    std::ifstream in(\"/app/snapvat/clock.snap\");\r\n    std::string d;\r\n    in >> d;\r\n    std::ofstream out(\"/app/snapvat/hold.flag\");\r\n"]
[20.634082, "o", "    if (!out) {\r\n        return 1;\r\n    }\r\n    out << \"exclusive \" << d << \"\\n\";\r\n    return 0;\r\n}\r\n"]
[20.634279, "o", "===== /app/holdbay/hold.hpp =====\r\n"]
[20.635392, "o", "#pragma once\r\nint hold_ex(void);\r\n"]
[20.635588, "o", "===== /app/snapvat/NOTE.txt =====\r\n"]
[20.637123, "o", "Wall stamp for mill-local calendar sketches. Not the urn day field.\r\n"]
[20.637471, "o", "===== /app/treenote/floor.txt =====\r\n"]
[20.638623, "o", "Busy-floor note: some shifts invoke steep with an exclusive hold so the mill never shares the floor. The hold helper lives under /app/holdbay. Desk stalls that recover overnight often get blamed on overlap, not on a finished JSON object.\r\n"]
[20.638877, "o", "\u001b[?2004hroot@7c2064acc33c:/app# "]
