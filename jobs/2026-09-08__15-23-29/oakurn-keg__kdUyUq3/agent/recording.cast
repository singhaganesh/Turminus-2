[90.49158, "o", ">     return 2;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[90.491686, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[90.49316, "o", "\u001b[?2004hroot@7c2064acc33c:/app# "]
[90.493351, "o", "make -C /app/ribcli -f hull.mk hull\r\n\u001b[?2004l\r"]
[90.495292, "o", "make: Entering directory '/app/ribcli'\r\nmkdir -p /app/bin /app/inkpit /app/snapvat/live\r\n"]
[90.496374, "o", "g++ -O2 -Wall -Wextra -std=c++17 -I/app/ribcli -I/app/latchpit -I/app/stampwire -I/app/dayfold -I/app/holdbay -o /app/bin/oakurn /app/ribcli/hull_cli.cpp /app/ribcli/run_k.cpp /app/latchpit/op_a.cpp /app/stampwire/op_b.cpp /app/dayfold/n_fold.cpp /app/holdbay/hold.cpp\r\n"]
[92.531073, "i", "set -e\nrm -f /app/snapvat/poured.txt\n/app/bin/oakurn pour /app/caskbay/core.urn\n/app/bin/oakurn steep\n/app/bin/oakurn board\ncat /app/inkpit/emit.inc\nif /app/bin/oakurn steep; then echo 'ERROR: no-work steep succeeded' >&2; exit 1; else echo 'no-work steep correctly failed'; fi\n"]
[92.531323, "o", "set -e\r\nrm -f /app/snapvat/poured.txt\r\n/app/bin/oakurn pour /app/caskbay/core.urn\r\n/app/bin/oakurn steep\r\n/app/bin/oakurn board\r\ncat /app/inkpit/emit.inc\r\nif /app/bin/oakurn steep; then echo 'ERROR: no-work steep succeeded' >&2; exit"]
[92.531708, "o", " 1; else echo 'no-work steep correctly failed'; fi\r\n"]
[93.474836, "i", "cat > /app/caskbay/z9.urn <<'EOF'\nURN1\nid z9\nday 1999-01-01\nn 7\nEOF\nset -e\n( /app/bin/oakurn pour /app/caskbay/quiet.urn && /app/bin/oakurn steep ) & p1=$!\n( /app/bin/oakurn pour /app/caskbay/z9.urn && /app/bin/oakurn steep ) & p2=$!\nwait \"$p1\"; wait \"$p2\"\necho '--- overlap result ---'\n/app/bin/oakurn board\necho '--- emit ---'\ncat /app/inkpit/emit.inc\necho '--- queue bytes ---'\nwc -c /app/snapvat/poured.txt\nfile /app/bin/oakurn\n"]
[93.475175, "o", "cat > /app/caskbay/z9.urn <<'EOF'\r\nURN1\r\nid z9\r\nday 1999-01-01\r\nn 7\r\nEOF\r\nset -e\r\n( /app/bin/oakurn pour /app/caskbay/quiet.urn && /app/bin/oakurn steep ) & p1=$!\r\n( /app/bin/oakurn pour /app/caskbay/z9.urn && /app/bin/oakurn steep ) & p2=$!\r\nwait \"$p1\"; wait \"$p2\"\r\necho '--- overlap result ---'\r\n/app/bin/oakurn board\r\necho '--- emit ---'\r\ncat /app/inkpit/emit.inc\r\necho '--- queue bytes ---'\r\nwc -c /app/snapvat/poured.txt\r\nfile /app/bin/oakurn\r\n"]
