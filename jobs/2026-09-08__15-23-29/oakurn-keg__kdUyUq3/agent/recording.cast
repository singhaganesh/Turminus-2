[33.51896, "o", "    21\t    }\r\n    22\t    out << in.rdbuf();\r\n    23\t    return 0;\r\n    24\t}\r\n    25\t\r\n    26\tstatic std::string urn_id(const std::string &path) {\r\n    27\t    std::ifstream in(path);\r\n    28\t    std::string line;\r\n    29\t    while (std::getline(in, line)) {\r\n    30\t        if (line.rfind(\"id \", 0) == 0) {\r\n    31\t            return line.substr(3);\r\n    32\t        }\r\n    33\t    }\r\n    34\t    return \"\";\r\n    35\t}\r\n    36\t\r\n    37\tstatic int do_pour(const char *src) {\r\n    38\t    mkdir(\"/app/snapvat/live\", 0755);\r\n    39\t    std::string id = urn_id(src);\r\n    40\t    if (id.empty()) {\r\n    41\t        return 1;\r\n    42\t    }\r\n    43\t    std::string dst = std::string(\"/app/snapvat/live/\") + id + \".urn\";\r\n    44\t    if (copy_file(src, dst) != 0) {\r\n    45\t        return 1;\r\n    46\t    }\r\n    47\t    std::ofstream poured(\"/app/snapvat/poured.txt\");\r\n    48\t    poured << id << \"\\n\";\r\n    49\t    return 0;\r\n    50\t}\r\n    51\t\r\n    52\tstatic int write_json() {\r\n    53\t    std::map<std::string, int> days;\r\n    54\t    {\r\n    55\t        std::ifstream in(\"/app/snapvat/days.tmp\");\r\n    56\t        std::string d;\r\n    57\t        int n = 0;\r\n    58\t        while (in >> d >> n) {\r\n    59\t            days[d] += n;\r\n    60\t        }\r\n    61\t    }\r\n    62\t    std::string cover;\r\n    63\t    {\r\n"]
[33.519039, "o", "    64\t        std::ifstream in(\"/app/snapvat/cover.tmp\");\r\n    65\t        in >> cover;\r\n    66\t    }\r\n    67\t    std::ostringstream body;\r\n    68\t    body << \"{\\\"days\\\":{\";\r\n    69\t    bool first = true;\r\n    70\t    for (const auto &kv : days) {\r\n    71\t        if (!first) {\r\n    72\t            body << \",\";\r\n    73\t        }\r\n    74\t        first = false;\r\n    75\t        body << \"\\\"\" << kv.first << \"\\\":\" << kv.second;\r\n    76\t    }\r\n    77\t    body << \"},\\\"covers\\\":\\\"\" << cover << \"\\\"}\\n\";\r\n    78\t    std::ofstream out(\"/app/inkpit/counts.json\");\r\n    79\t    if (!out) {\r\n    80\t        return 1;\r\n    81\t    }\r\n    82\t    out << body.str();\r\n    83\t    return 0;\r\n    84\t}\r\n    85\t\r\n    86\t"]
