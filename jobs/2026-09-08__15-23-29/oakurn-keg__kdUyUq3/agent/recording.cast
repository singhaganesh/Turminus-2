[33.521991, "o", "     8\t    std::string d;\r\n     9\t    in >> d;\r\n    10\t    std::ofstream out(\"/app/snapvat/hold.flag\");\r\n    11\t    if (!out) {\r\n    12\t        return 1;\r\n    13\t    }\r\n    14\t    out << \"exclusive \" << d << \"\\n\";\r\n    15\t    return 0;\r\n    16\t}\r\n"]
[33.522166, "o", "===== hold.hpp =====\r\n"]
[33.523388, "o", "     1\t#pragma once\r\n     2\tint hold_ex(void);\r\n"]
[33.523609, "o", "\u001b[?2004hroot@7c2064acc33c:/app# "]
[34.014776, "i", "echo '===== floor/notes ====='; nl -ba /app/treenote/floor.txt; nl -ba /app/snapvat/NOTE.txt; nl -ba /app/holdbay/HOLD.txt; echo '===== full scratch listing ====='; find /app/snapvat -maxdepth 2 -printf '%M %s %TY-%Tm-%Td %TH:%TM:%TS %p\\n' | sort; for f in /app/snapvat/*; do if [ -f \"$f\" ]; then echo \"--- $f\"; cat \"$f\"; fi; done\n"]
[34.015943, "o", "echo '===== floor/notes ====='; nl -ba /app/treenote/floor.txt; nl -ba /app/snapvat/NOTE.txt; nl -ba /app/holdbay/HOLD.txt; echo '===== full scratch listing ====='; find /app/snapvat -maxdepth 2 -printf '%M %s %TY-%Tm-%Td %TH:%TM:%TS %p\\n' | sort; for f in /app/snapvat/*; do if [ -f \"$f\" ]; then echo \"--- $f\"; cat \"$f\"; fi; done\r\n\u001b[?2004l\r"]
[34.016112, "o", "===== floor/notes =====\r\n"]
[34.017384, "o", "     1\tBusy-floor note: some shifts invoke steep with an exclusive hold so the mill never shares the floor. The hold helper lives under /app/holdbay. Desk stalls that recover overnight often get blamed on overlap, not on a finished JSON object.\r\n"]
[34.018672, "o", "     1\tWall stamp for mill-local calendar sketches. Not the urn day field.\r\n"]
[34.019932, "o", "     1\tOptional exclusive mill hold. Not on the pour/steep path unless wired in.\r\n"]
[34.020204, "o", "===== full scratch listing =====\r\n"]
[34.022266, "o", "-rw-rw-r-- 0 2026-09-08 09:11:08.0000000000 /app/snapvat/emit.prev\r\n-rw-rw-r-- 11 2026-09-08 09:08:18.0000000000 /app/snapvat/clock.snap\r\n-rw-rw-r-- 2 2026-09-08 09:08:18.0000000000 /app/snapvat/busy.latch\r\n-rw-rw-r-- 2 2026-09-08 09:08:20.0000000000 /app/snapvat/tick\r\n-rw-rw-r-- 33 2026-09-08 09:08:17.0000000000 /app/snapvat/live/quiet.urn\r\n-rw-rw-r-- 6 2026-09-08 09:08:17.0000000000 /app/snapvat/last.id\r\n-rw-rw-r-- 68 2026-09-08 09:08:26.0000000000 /app/snapvat/NOTE.txt\r\ndrwxr-xr-x 4096 2026-09-08 09:11:08.0000000000 /app/snapvat\r\ndrwxrwxr-x 4096 2026-09-08 09:08:17.0000000000 /app/snapvat/live\r\n"]
[34.022718, "o", "--- /app/snapvat/NOTE.txt\r\n"]
[34.0248, "o", "Wall stamp for mill-local calendar sketches. Not the urn day field.\r\n"]
[34.025264, "o", "--- /app/snapvat/busy.latch\r\n"]
[34.026617, "o", "1\r\n"]
[34.026853, "o", "--- /app/snapvat/clock.snap\r\n"]
[34.027785, "o", "2024-03-12\r\n"]
[34.027931, "o", "--- /app/snapvat/emit.prev\r\n"]
[34.029194, "o", "--- /app/snapvat/last.id\r\n"]
[34.029905, "o", "quiet\r\n"]
[34.03014, "o", "--- /app/snapvat/tick\r\n"]
[34.030929, "o", "0\r\n"]
[34.031108, "o", "\u001b[?2004hroot@7c2064acc33c:/app# "]
[90.318156, "i", "cat > /app/latchpit/op_a.cpp <<'EOF'\n#include \"admit.hpp\"\n\n#include <fstream>\n#include <string>\n\n// The caller holds busy.latch's advisory lock.  Work exists only when a pour\n// has queued an urn; the mere existence of the lock file says nothing.\nint op_a(void) {\n    std::ifstream in(\"/app/snapvat/poured.txt\");\n    std::string id;\n    return (in >> id) && !id.empty() ? 0 : 1;\n}\nEOF\ncat > /app/stampwire/op_b.cpp <<'EOF'\n#include \"mark.hpp\"\n\n#include <cstdio>\n#include <fstream>\n#include <string>\n#include <unistd.h>\n\nint op_b(void) {\n    std::ifstream in(\"/app/snapvat/last.id\");\n    std::string tok;\n    if (!(in >> tok) || tok.empty()) {\n        return 1;\n    }\n    const std::string tmp = \"/app/snapvat/cover.tmp.\" + std::to_string(getpid());\n    {\n        std::ofstream out(tmp, std::ios::trunc);\n        if (!out || !(out << tok << \"\\n\")) {\n            std::remove(tmp.c_str());\n            return 1;\n        }\n    }\n    if (std::rename(tmp.c_str(), \"/app/snapvat/cover.tmp\") != 0) {\n        std::remove(tmp.c_str());\n        return 1;\n    }\n    return 0;\n}\nEOF\ncat > /app/dayfold/n_fold.cpp <<'EOF'\n#include \"fold.hpp\"\n\n#include <cstdio>\n#include <dirent.h>\n#include <fstream>\n#include <map>\n#include <string>\n#include <unistd.h>\n\nstatic bool read_urn(const std::string &path, std::string &day, int &number) {\n    std::ifstream in(path);\n    std::string banner, key, id, dkey, nkey;\n    long long value;\n    if (!(in >> banner >> key >> id >> dkey >> day >> nkey >> value) ||\n        banner != \"URN1\" || key != \"id\" || dkey != \"day\" || nkey != \"n\" ||\n        id.empty() || day.empty() || value < 0 || value > 2147483647LL) {\n        return false;\n    }\n    number = static_cast<int>(value);\n    return true;\n}\n\nint n_fold(void) {\n    std::map<std::string, long long> days;\n    DIR *dir = opendir(\"/app/snapvat/live\");\n    if (!dir) return 1;\n    bool ok = true;\n    while (dirent *ent = readdir(dir)) {\n        std::string name = ent->d_name;\n        if (name.size() < 5 || name.substr(name.size() - 4) != \".urn\") continue;\n        std::string day;\n        int number = 0;\n        if (!read_urn(std::string(\"/app/snapvat/live/\") + name, day, number)) {\n            ok = false;\n            break;\n        }\n        days[day] += number;\n    }\n    closedir(dir);\n    if (!ok) return 1;\n\n    int tick = 0;\n    { std::ifstream in(\"/app/snapvat/tick\"); in >> tick; }\n    ++tick;\n    const std::string suffix = \".\" + std::to_string(getpid());\n    const std::string days_tmp = \"/app/snapvat/days.tmp\" + suffix;\n    const std::string emit_tmp = \"/app/inkpit/emit.inc\" + suffix;\n    {\n        std::ofstream out(days_tmp, std::ios::trunc);\n        if (!out) return 1;\n        for (const auto &kv : days) out << kv.first << \" \" << kv.second << \"\\n\";\n        if (!out) { std::remove(days_tmp.c_str()); return 1; }\n    }\n    {\n        std::ofstream out(emit_tmp, std::ios::trunc);\n        if (!out) { std::remove(days_tmp.c_str()); return 1; }\n        for (const auto &kv : days)\n            out << kv.first << \" \" << kv.second << \" tick=\" << tick << \"\\n\";\n        if (!out) {\n            std::remove(days_tmp.c_str()); std::remove(emit_tmp.c_str()); return 1;\n        }\n    }\n    if (std::rename(days_tmp.c_str(), \"/app/snapvat/days.tmp\") != 0 ||\n        std::rename(emit_tmp.c_str(), \"/app/inkpit/emit.inc\") != 0) {\n        std::remove(days_tmp.c_str()); std::remove(emit_tmp.c_str()); return 1;\n    }\n    { std::ofstream out(\"/app/snapvat/tick\", std::ios::trunc); out << tick << \"\\n\"; }\n    return 0;\n}\nEOF\n"]
