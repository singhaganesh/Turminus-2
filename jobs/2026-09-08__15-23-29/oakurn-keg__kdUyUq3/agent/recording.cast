[21.586976, "i", "echo '===== symbols ====='; nm -C /app/bin/oakurn 2>/dev/null | head -120; echo '===== useful strings ====='; strings /app/bin/oakurn | grep -E 'pour|steep|board|snapvat|inkpit|caskbay|counts|emit|latch|usage|URN1' | head -160; echo '===== board ====='; /app/bin/oakurn board; echo \"board_rc=$?\"; echo '===== steep ====='; /app/bin/oakurn steep; echo \"steep_rc=$?\"; echo '===== products after steep ====='; cat /app/inkpit/counts.json 2>/dev/null; printf '\\n'; ls -l /app/inkpit/emit.inc 2>/dev/null; cat /app/inkpit/emit.inc 2>/dev/null\n"]
