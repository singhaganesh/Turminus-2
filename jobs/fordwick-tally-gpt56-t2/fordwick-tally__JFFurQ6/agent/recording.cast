[28.743134, "i", "python3 - <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; c=cv2.VideoCapture(p)\nprint('opened',c.isOpened(),'frames',c.get(cv2.CAP_PROP_FRAME_COUNT),'fps',c.get(cv2.CAP_PROP_FPS),'size',c.get(cv2.CAP_PROP_FRAME_WIDTH),c.get(cv2.CAP_PROP_FRAME_HEIGHT))\nframes=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n frames.append(f)\nc.release(); a=np.asarray(frames)\nprint('decoded',len(a),'shape',a.shape,'channel min/max/mean/std',[(int(a[...,i].min()),int(a[...,i].max()),float(a[...,i].mean()),float(a[...,i].std())) for i in range(3)])\nfor i in np.linspace(0,len(a)-1,min(12,len(a)),dtype=int):\n f=a[i]; print(i, np.mean(f,axis=(0,1)).round(1), np.std(f,axis=(0,1)).round(1))\n# contact sheet\nids=np.linspace(0,len(a)-1,20,dtype=int); thumbs=[]\nfor i in ids:\n x=a[i].copy(); cv2.line(x,(0,70),(159,70),(0,0,255),1); cv2.putText(x,str(i),(2,12),0,.4,(0,0,255),1); thumbs.append(x)\nsheet=np.vstack([np.hstack(thumbs[j:j+5]) for j in range(0,20,5)])\ncv2.imwrite('/tmp/contact.png',sheet); print('/tmp/contact.png')\nPY\n"]
