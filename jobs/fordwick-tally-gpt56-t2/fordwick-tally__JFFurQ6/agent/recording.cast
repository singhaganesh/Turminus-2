[194.89664, "i", "python3 - <<'PY'\np='/app/tether.py'\ns=open(p).read()\ns=s.replace('''            if t[\"seen\"] >= 2:\\n                total += _crossing_update(t, py, False)\\n''','''            # Do not confirm a crossing without foreground evidence: a body\\n            # that vanished above the scan has not completed the motion.\\n''')\nopen(p,'w').write(s)\nPY\nmkdir -p /tmp/cases\npython3 - <<'PY'\nimport cv2, numpy as np, os\nW,H=160,120\nbg=np.full((H,W,3),(52,45,42),np.uint8)\ndef write(name, paths, n=48):\n out=cv2.VideoWriter('/tmp/cases/'+name,cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\n colors=[(30,30,210),(30,210,30),(210,30,30),(30,210,210),(210,30,210),(210,210,30)]\n for t in range(n):\n  f=bg.copy()\n  for i,path in enumerate(paths):\n   q=path(t)\n   if q is not None:\n    x,y=q; cv2.circle(f,(int(x),int(y)),8,colors[i%len(colors)],-1)\n  out.write(f)\n out.release()\n# Five concurrent bodies, two paths draw close/partially overlap.\nwrite('five.mp4',[lambda t,x=x: (x,8+2.4*t) for x in (25,52,78,96,130)])\n# Wrong direction only.\nwrite('up.mp4',[lambda t:(80,110-2.2*t)])\n# Vanishes while still above the scan: must not be extrapolated into a crossing.\nwrite('incomplete.mp4',[lambda t:(60,10+2*t) if t<25 else None])\n# Cross, linger below, return above, cross again: one persistent body, count once.\ndef returning(t):\n if t<18:return (80,35+2.2*t)\n if t<25:return (80,74)\n if t<36:return (80,74-3*(t-25))\n return (80,41+3*(t-36))\nwrite('return.mp4',[returning],52)\n# Two silhouettes substantially overlap while crossing but remain distinguishable before/after.\nwrite('overlap.mp4',[lambda t:(62+t*.65,12+2.2*t),lambda t:(98-t*.65,8+2.2*t)],48)\nPY\n/app/kiln/bake.sh\nfor spec in 'shown.mp4:3' '/tmp/cases/five.mp4:5' '/tmp/cases/up.mp4:0' '/tmp/cases/incomplete.mp4:0' '/tmp/cases/return.mp4:1' '/tmp/cases/overlap.mp4:2'; do p=${spec%:*}; e=${spec##*:}; [[ $p = shown.mp4 ]] && p=/app/$p; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc \"$p\"; a=$(sed -n 's/crossings = //p' /app/inkwell/sheet.toml); echo \"$p expected=$e actual=$a\"; done\n"]
[194.896861, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[194.89697, "o", "\u001b[?2004h> "]
[194.897056, "o", "p='/app/tether.py'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.900412, "o", "s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('''            if t[\"seen\"] >= 2:\\n                total += _crossing_update(t, py, False)\\n''','''            # Do not confirm a crossing without foreground evidence: a body\\n            # that vanished above the scan has not completed the motion.\\n''')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[194.916845, "o", "\u001b[?2004hroot@a7a41f3e118a:/app# "]
[194.917013, "o", "mkdir -p /tmp/cases\r\n\u001b[?2004l\r"]
[194.918273, "o", "\u001b[?2004hroot@a7a41f3e118a:/app# "]
[194.918401, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.918506, "o", "import cv2, numpy as np, os\r\n\u001b[?2004l\r"]
[194.918594, "o", "\u001b[?2004h> W,H=160,120\r\n\u001b[?2004l\r"]
[194.918665, "o", "\u001b[?2004h> "]
[194.918756, "o", "bg=np.full((H,W,3),(52,45,42),np.uint8)\r\n\u001b[?2004l\r"]
[194.918826, "o", "\u001b[?2004h> "]
[194.918906, "o", "def write(name, paths, n=48):\r\n\u001b[?2004l\r"]
[194.918968, "o", "\u001b[?2004h> "]
[194.919211, "o", " out=cv2.VideoWriter('/tmp/cases/'+name,cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\r\n\u001b[?2004l\r"]
[194.919261, "o", "\u001b[?2004h> "]
[194.91955, "o", " colors=[(30,30,210),(30,210,30),(210,30,30),(30,210,210),(210,30,210),(210,210,30)]\r\n\u001b[?2004l\r"]
[194.919603, "o", "\u001b[?2004h> "]
[194.919677, "o", " for t in range(n):\r\n\u001b[?2004l\r"]
[194.91971, "o", "\u001b[?2004h"]
[194.919737, "o", "> "]
[194.919832, "o", "  f=bg.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[194.919948, "o", "  for i,path in enumerate(paths):\r\n\u001b[?2004l\r"]
[194.919995, "o", "\u001b[?2004h> "]
[194.920039, "o", "   q=path(t)\r\n\u001b[?2004l\r"]
[194.920085, "o", "\u001b[?2004h> "]
[194.920145, "o", "   if q is not None:\r\n\u001b[?2004l\r"]
[194.920196, "o", "\u001b[?2004h> "]
[194.920401, "o", "    x,y=q; cv2.circle(f,(int(x),int(y)),8,colors[i%len(colors)],-1)\r\n\u001b[?2004l\r"]
[194.92046, "o", "\u001b[?2004h"]
[194.920511, "o", ">   out.write(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[194.920557, "o", "> "]
[194.920577, "o", " out.release()\r\n\u001b[?2004l\r"]
[194.92059, "o", "\u001b[?2004h"]
[194.920604, "o", "> "]
[194.920801, "o", "# Five concurrent bodies, two paths draw close/partially overlap.\r\n\u001b[?2004l\r"]
[194.920855, "o", "\u001b[?2004h> "]
[194.921053, "o", "write('five.mp4',[lambda t,x=x: (x,8+2.4*t) for x in (25,52,78,96,130)])\r\n\u001b[?2004l\r"]
[194.921104, "o", "\u001b[?2004h> "]
[194.921172, "o", "# Wrong direction only.\r\n\u001b[?2004l\r"]
[194.921223, "o", "\u001b[?2004h> "]
[194.921353, "o", "write('up.mp4',[lambda t:(80,110-2.2*t)])\r\n\u001b[?2004l\r"]
[194.921402, "o", "\u001b[?2004h> "]
[194.921634, "o", "# Vanishes while still above the scan: must not be extrapolated into a crossing.\r\n\u001b[?2004l\r"]
[194.921684, "o", "\u001b[?2004h> "]
[194.921874, "o", "write('incomplete.mp4',[lambda t:(60,10+2*t) if t<25 else None])\r\n"]
[194.921923, "o", "\u001b[?2004l\r"]
[194.921972, "o", "\u001b[?2004h> "]
[194.922157, "o", "# Cross, linger below, return above, cross again: one persistent body, count once.\r\n\u001b[?2004l\r"]
[194.922208, "o", "\u001b[?2004h> "]
[194.922264, "o", "def returning(t):\r\n\u001b[?2004l\r"]
[194.922315, "o", "\u001b[?2004h> "]
[194.922418, "o", " if t<18:return (80,35+2.2*t)\r\n\u001b[?2004l\r"]
[194.922469, "o", "\u001b[?2004h> "]
[194.922529, "o", " if t<25:return (80,74)\r\n\u001b[?2004l\r"]
[194.92258, "o", "\u001b[?2004h> "]
[194.922674, "o", " if t<36:return (80,74-3*(t-25))\r\n\u001b[?2004l\r"]
[194.922725, "o", "\u001b[?2004h> "]
[194.922797, "o", " return (80,41+3*(t-36))\r\n\u001b[?2004l\r"]
[194.922847, "o", "\u001b[?2004h> "]
[194.922944, "o", "write('return.mp4',[returning],52)\r\n\u001b[?2004l\r"]
[194.922995, "o", "\u001b[?2004h> "]
[194.923271, "o", "# Two silhouettes substantially overlap while crossing but remain distinguishable before/after.\r\n\u001b[?2004l\r"]
[194.923338, "o", "\u001b[?2004h> "]
[194.923575, "o", "write('overlap.mp4',[lambda t:(62+t*.65,12+2.2*t),lambda t:(98-t*.65,8+2.2*t)],48)\r\n"]
[194.923628, "o", "\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[195.291632, "o", "\u001b[?2004hroot@a7a41f3e118a:/app# "]
[195.291834, "o", "/app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[195.347768, "o", "\u001b[?2004hroot@a7a41f3e118a:/app# "]
[195.348627, "o", "for spec in 'shown.mp4:3' '/tmp/cases/five.mp4:5' '/tmp/cases/up.mp4:0' '/tmp/cases/incomplete.mp4:0' '/tmp/cases/return.mp4:1' '/tmp/cases/overlap.mp4:2'; do p=${spec%:*}; e=${spec##*:}; [[ $p = shown.mp4 ]] && p=/app/$p; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc \"$p\"; a=$(sed -n 's/crossings = //p' /app/inkwell/sheet.toml); echo \"$p expected=$e actual=$a\"; done\r\n\u001b[?2004l\r"]
[195.702033, "o", "/app/shown.mp4 expected=3 actual=3\r\n"]
[196.057811, "o", "/tmp/cases/five.mp4 expected=5 actual=4\r\n"]
[196.585105, "o", "/tmp/cases/up.mp4 expected=0 actual=0\r\n"]
[196.931589, "o", "/tmp/cases/incomplete.mp4 expected=0 actual=0\r\n"]
[197.358388, "o", "/tmp/cases/return.mp4 expected=1 actual=1\r\n"]
[197.719193, "o", "/tmp/cases/overlap.mp4 expected=2 actual=3\r\n\u001b[?2004hroot@a7a41f3e118a:/app# "]
[250.600343, "i", "python3 - <<'PY'\np='/app/tether.py'; s=open(p).read()\nold='''        for ti, di, merged in pairs:\\n            t, d = active[ti], detections[di]\\n'''\nnew='''        # If more than one identity is represented by a blob, even the first\\n        # match must be prediction-driven; moving it to the blob centroid can\\n        # create a duplicate identity when the silhouettes separate.\\n        pair_counts = {}\\n        for _, di, _ in pairs:\\n            pair_counts[di] = pair_counts.get(di, 0) + 1\\n        pairs = [(ti, di, merged or pair_counts[di] > 1)\\n                 for ti, di, merged in pairs]\\n\\n        for ti, di, merged in pairs:\\n            t, d = active[ti], detections[di]\\n'''\nif old not in s: raise SystemExit('patch target missing')\nopen(p,'w').write(s.replace(old,new))\nPY\npython3 - <<'PY'\nimport cv2,numpy as np\nW,H=160,120; bg=np.full((H,W,3),(52,45,42),np.uint8)\nout=cv2.VideoWriter('/tmp/cases/five_converge.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\ncols=[(30,30,210),(30,210,30),(210,30,30),(30,210,210),(210,30,210)]\nstarts=[18,45,72,112,142]; targets=[28,55,80,96,128]\nfor t in range(48):\n f=bg.copy(); q=min(1,t/24)\n for i,(a,b) in enumerate(zip(starts,targets)):\n  x=a+(b-a)*q; y=8+2.4*t; cv2.circle(f,(int(x),int(y)),8,cols[i],-1)\n out.write(f)\nout.release()\nPY\n/app/kiln/bake.sh\nfor spec in '/app/shown.mp4:3' '/tmp/cases/overlap.mp4:2' '/tmp/cases/five_converge.mp4:5' '/tmp/cases/up.mp4:0' '/tmp/cases/incomplete.mp4:0' '/tmp/cases/return.mp4:1'; do p=${spec%:*}; e=${spec##*:}; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc \"$p\"; a=$(sed -n 's/crossings = //p' /app/inkwell/sheet.toml); echo \"$p expected=$e actual=$a\"; done\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; r=$?; echo \"unreadable_rc=$r sheet_present=$(test -e /app/inkwell/sheet.toml && echo yes || echo no)\"\n"]
[250.601925, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/tether.py'; s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> old='''        for ti, di, merged in pairs:\\n            t, d = active[ti], detections[di]\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[250.602589, "o", "new='''        # If more than one identity is represented by a blob, even the first\\n        # match must be prediction-driven; moving it to the blob centroid can\\n        # create a duplicate identity when the silhouettes separate.\\n        pair_counts = {}\\n        for _, di, _ in pairs:\\n            pair_counts[di] = pair_counts.get(di, 0) + 1\\n        pairs = [(ti, di, merged or pair_counts[di] > 1)\\n                 for ti, di, merged in pairs]\\n\\n        for ti, di, merged in pairs:\\n            t, d = active[ti], detections[di]\\n'''\r\n\u001b[?2004l\r"]
[250.602702, "o", "\u001b[?2004h> "]
[250.602794, "o", "if old not in s: raise SystemExit('patch target missing')\r\n\u001b[?2004l\r"]
[250.602913, "o", "\u001b[?2004h> "]
[250.603005, "o", "open(p,'w').write(s.replace(old,new))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[250.603078, "o", "PY\r\n\u001b[?2004l\r"]
[250.618668, "o", "\u001b[?2004hroot@a7a41f3e118a:/app# "]
