[8.400024, "o", "--- SPAN ---\r\n"]
[8.401452, "o", "Station geometry\r\n================\r\n\r\nFrame size: 160 x 120\r\nRate: 12 fps\r\nHorizontal scan row: y = 70 (top of frame is y = 0)\r\n\r\nDrive:\r\n\r\n    python3 /app/varnish/mill.pyc CLIP\r\n\r\nCLIP is an mp4 path. Success writes /app/inkwell/sheet.toml:\r\n\r\n    crossings = <integer>\r\n\r\nWorked sample: /app/shown.mp4 -> crossings = 3\r\n\r\nSimilar silhouettes that share the scan still count as separate when each\r\ncentroid completes top-to-bottom, including overlap or one body shading another.\r\n\r\nUnreadable CLIP: non-zero exit, do not write /app/inkwell/sheet.toml.\r\nExample unreadable path:\r\n\r\n    python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4\r\n\r\nFold blot, tether, spout, and the spanwell driver using the kiln notes.\r\n"]
[8.401649, "o", "--- KILN ---\r\n"]
[8.402683, "o", "Kiln card\r\n=========\r\n\r\nThe station mill is the folded snapshot named in /app/slipfold/SPAN.txt.\r\nIt is built from blot, tether, spout, and the spanwell driver under /app.\r\n\r\nThis directory holds the fold tools. Run the executable script here after\r\nediting those modules. Live pipeline files are not what the station executes.\r\n"]
[8.402889, "o", "--- FILES ---\r\n"]
[8.407707, "o", "/app/blot.py\r\n/app/hopcard/millcard.txt\r\n/app/kiln/KILN.txt\r\n/app/kiln/bake.sh\r\n/app/kiln/pack.py\r\n/app/shown.mp4\r\n/app/slipfold/SPAN.txt\r\n/app/spanwell.py\r\n/app/spout.py\r\n/app/tether.py\r\n/app/varnish/mill.pyc\r\n/app/varnish/packed.py\r\n/app/wickpit/__init__.py\r\n/app/wickpit/shiftlog.txt\r\n/app/wickpit/touchcue.py\r\n"]
[8.408311, "o", "\u001b[?2004hroot@a7a41f3e118a:/app# "]
[8.603328, "i", "printf '%s\\n' '--- PYTHON SOURCES ---'; find /app -type f -name '*.py' -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\n"]
[8.60385, "o", "printf '%s\\n' '--- PYTHON SOURCES ---'; find /app -type f -name '*.py' -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[8.603957, "o", "--- PYTHON SOURCES ---\r\n"]
[8.609629, "o", "/app/varnish/packed.py\r\n"]
[8.61066, "o", "### /app/varnish/packed.py\r\n"]
[8.612536, "o", "from __future__ import annotations\r\n\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\ndef make_mog():\r\n    return cv2.createBackgroundSubtractorMOG2(\r\n        history=30, varThreshold=16, detectShadows=True\r\n    )\r\n\r\n\r\n"]
[8.61275, "o", "def blot_mark(frame, mog) -> bool:\r\n    fg = mog.apply(frame)\r\n    _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n    y = int(LINE_Y)\r\n    band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n    return bool(band.any())\r\n\r\n\r\n\r\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n    if now:\r\n        n += 1\r\n    return n, now\r\n\r\n\r\ndef fold_gate(n: int) -> int:\r\n    return n\r\n\r\n\r\nimport cv2\r\nimport toml\r\nfrom pathlib import Path\r\n\r\n\r\nSHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\r\n\r\ndef emit_span(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = make_mog()\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        now = blot_mark(frame, mog)\r\n        n, prev = knit_marks(now, prev, n)\r\n    cap.release()\r\n    return fold_gate(n)\r\n\r\n\r\ndef dump_sheet(n: int) -> None:\r\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n\r\n#!/usr/bin/env python3\r\n\r\nimport sys\r\n\r\n\r\n\r\ndef main() -> int:\r\n    if len(sys.argv) != 2:\r\n        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[8.613176, "o", "/app/kiln/pack.py\r\n"]
[8.613897, "o", "### /app/kiln/pack.py\r\n"]
[8.614938, "o", "#!/usr/bin/env python3\r\n\"\"\"Fold blot/tether/spout/spanwell into /app/varnish/mill.pyc.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport py_compile\r\nfrom pathlib import Path\r\n\r\nROOT = Path(\"/app\")\r\n"]
[8.615044, "o", "PARTS = [\r\n    ROOT / \"blot.py\",\r\n    ROOT / \"tether.py\",\r\n    ROOT / \"spout.py\",\r\n    ROOT / \"spanwell.py\",\r\n]\r\nSKIP_PREFIXES = (\r\n"]
[8.615126, "o", "    \"from blot \",\r\n    \"import blot\",\r\n    \"from tether \",\r\n    \"import tether\",\r\n    \"from spout \",\r\n    \"import spout\",\r\n)\r\n\r\n\r\ndef _strip(text: str) -> tuple[list[str], list[str]]:\r\n    futures: list[str] = []\r\n    keep: list[str] = []\r\n    for line in text.splitlines():\r\n        stripped = line.strip()\r\n        if any(stripped.startswith(p) for p in SKIP_PREFIXES):\r\n            continue\r\n        if stripped.startswith(\"from __future__ import\"):\r\n            if stripped not in futures:\r\n                futures.append(stripped)\r\n            continue\r\n        keep.append(line)\r\n    return futures, keep\r\n\r\n\r\ndef main() -> None:\r\n    out_dir = ROOT / \"varnish\"\r\n    out_dir.mkdir(parents=True, exist_ok=True)\r\n    packed = out_dir / \"packed.py\"\r\n    all_future: list[str] = []\r\n    bodies: list[str] = []\r\n    for p in PARTS:\r\n        futures, keep = _strip(p.read_text(encoding=\"utf-8\"))\r\n        for item in futures:\r\n            if item not in all_future:\r\n                all_future.append(item)\r\n        bodies.append(\"\\n\".join(keep))\r\n    packed.write_text(\"\\n\".join(all_future) + \"\\n\\n\" + \"\\n\\n\".join(bodies) + \"\\n\", encoding=\"utf-8\")\r\n    py_compile.compile(str(packed), cfile=str(out_dir / \"mill.pyc\"), doraise=True)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[8.615432, "o", "/app/wickpit/__init__.py\r\n"]
[8.616047, "o", "### /app/wickpit/__init__.py\r\n"]
[8.617038, "o", "/app/wickpit/touchcue.py\r\n"]
[8.617697, "o", "### /app/wickpit/touchcue.py\r\n"]
[8.618682, "o", "#!/usr/bin/env python3\r\n\"\"\"Desk helper: rising occupancy on the scan row.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\ndef occupancy_edges(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = cv2.createBackgroundSubtractorMOG2(history=30, varThreshold=16, detectShadows=True)\r\n    prev = False\r\n"]
[8.618809, "o", "    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        fg = mog.apply(frame)\r\n        _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n        y = int(LINE_Y)\r\n        band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n        now = bool(band.any())\r\n        if now and not prev:\r\n            n += 1\r\n        prev = now\r\n    cap.release()\r\n    return n\r\n"]
[8.619154, "o", "/app/spanwell.py\r\n"]
[8.619785, "o", "### /app/spanwell.py\r\n"]
[8.620754, "o", "#!/usr/bin/env python3\r\nfrom __future__ import annotations\r\n\r\nimport sys\r\n\r\nfrom spout import dump_sheet, emit_span\r\n\r\n\r\ndef main() -> int:\r\n    if len(sys.argv) != 2:\r\n        return 2\r\n    n = emit_span(sys.argv[1])\r\n    dump_sheet(n)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[8.621105, "o", "/app/spout.py\r\n"]
[8.621888, "o", "### /app/spout.py\r\n"]
[8.624256, "o", "from __future__ import annotations\r\n\r\nimport cv2\r\nimport toml\r\nfrom pathlib import Path\r\n\r\nfrom blot import blot_mark, make_mog\r\nfrom tether import fold_gate, knit_marks\r\n\r\nSHEET = Path(\"/app/inkwell/sheet.toml\")\r\n\r\n\r\ndef emit_span(src: str) -> int:\r\n    cap = cv2.VideoCapture(src)\r\n    mog = make_mog()\r\n    prev = False\r\n    n = 0\r\n    while True:\r\n        ok, frame = cap.read()\r\n        if not ok:\r\n            break\r\n        now = blot_mark(frame, mog)\r\n        n, prev = knit_marks(now, prev, n)\r\n    cap.release()\r\n    return fold_gate(n)\r\n\r\n\r\ndef dump_sheet(n: int) -> None:\r\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n    SHEET.write_text(toml.dumps({\"crossings\": int(n)}), encoding=\"utf-8\")\r\n"]
[8.625149, "o", "/app/tether.py\r\n"]
[8.626528, "o", "### /app/tether.py\r\n"]
[8.627933, "o", "from __future__ import annotations\r\n\r\n\r\ndef knit_marks(now: bool, prev: bool, n: int) -> tuple[int, bool]:\r\n    if now:\r\n        n += 1\r\n    return n, now"]
[8.62802, "o", "\r\n\r\n\r\ndef fold_gate(n: int) -> int:\r\n    return n\r\n"]
[8.628364, "o", "/app/blot.py\r\n"]
[8.62913, "o", "### /app/blot.py\r\n"]
[8.630135, "o", "from __future__ import annotations\r\n\r\nimport cv2\r\n\r\nLINE_Y = 70\r\n\r\n\r\ndef make_mog():\r\n    return cv2.createBackgroundSubtractorMOG2(\r\n"]
[8.630188, "o", "        history=30, varThreshold=16, detectShadows=True\r\n    )\r\n\r\n\r\ndef blot_mark(frame, mog) -> bool:\r\n    fg = mog.apply(frame)\r\n    _, th = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)\r\n    y = int(LINE_Y)\r\n    band = th[max(0, y - 1) : min(th.shape[0], y + 2)]\r\n    return bool(band.any())\r\n"]
