[49.304547, "i", "python3 - <<'PY'\nimport cv2,numpy as np\nc=cv2.VideoCapture('/app/shown.mp4'); fs=[]\nwhile 1:\n ok,f=c.read()\n if not ok: break\n fs.append(f)\na=np.array(fs); bg=np.median(np.r_[a[:3],a[-3:]],axis=0).astype(np.uint8)\nfor t,f in enumerate(a):\n d=np.max(cv2.absdiff(f,bg),axis=2); m=(d>15).astype('uint8')*255\n m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n n,lab,st,cen=cv2.connectedComponentsWithStats(m)\n det=[]\n for i in range(1,n):\n  x,y,w,h,ar=st[i]\n  if ar>=8:\n   pix=f[lab==i]; det.append((ar,(x,y,w,h),tuple(np.mean(pix,0).astype(int)),tuple(np.round(cen[i],1))))\n if det: print(t,det)\nPY\n"]
