[152.457877, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef foreground_detections(frames):\n    \"\"\"Return component observations for every frame of a fixed-camera clip.\"\"\"\n    stack = np.asarray(frames)\n    # A temporal median is unaffected by an object merely crossing a pixel.\n    background = np.median(stack, axis=0).astype(np.uint8)\n    kernel = np.ones((3, 3), np.uint8)\n    answer = []\n    for frame in frames:\n        delta = cv2.absdiff(frame, background)\n        # Maximum channel distance retains strongly coloured objects whose\n        # grayscale luminance happens to resemble the background.\n        mask = (np.max(delta, axis=2) >= 16).astype(np.uint8) * 255\n        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)\n        count, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)\n        found = []\n        for label in range(1, count):\n            x, y, w, h, area = [int(v) for v in stats[label]]\n            if area < 18 or w < 3 or h < 3:\n                continue\n            pixels = frame[labels == label]\n            colour = np.median(pixels, axis=0).astype(float)\n            found.append({\n                \"x\": float(centers[label][0]), \"y\": float(centers[label][1]),\n                \"box\": (x, y, w, h), \"area\": float(area), \"colour\": colour,\n            })\n        answer.append(found)\n    return answer\nPY\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nimport numpy as np\n\nLINE_Y = 70.0\n\n\ndef _prediction(track, frame_no):\n    gap = frame_no - track[\"last\"]\n    return track[\"x\"] + track[\"vx\"] * gap, track[\"y\"] + track[\"vy\"] * gap\n\n\ndef _cost(track, det, frame_no):\n    px, py = _prediction(track, frame_no)\n    gap = frame_no - track[\"last\"]\n    distance = float(np.hypot(det[\"x\"] - px, det[\"y\"] - py))\n    colour = float(np.linalg.norm(det[\"colour\"] - track[\"colour\"]))\n    # Position dominates; colour prevents identity swaps where paths approach.\n    limit = 13.0 + 9.0 * max(0, gap - 1) + 1.7 * min(12.0, abs(track[\"vy\"]))\n    if distance > limit or colour > 115.0:\n        return None\n    ratio = max(det[\"area\"], track[\"area\"]) / max(1.0, min(det[\"area\"], track[\"area\"]))\n    return distance + 0.055 * colour + (3.0 if ratio > 2.4 else 0.0)\n\n\ndef _crossing_update(track, y, observed=True):\n    # A small dead band prevents line jitter and lingering from making events.\n    if y <= LINE_Y - 1.5:\n        track[\"above\"] = True\n    if (track[\"above\"] and not track[\"counted\"] and y >= LINE_Y + 1.5\n            and track[\"vy\"] > 0.15):\n        track[\"counted\"] = True\n        return 1\n    return 0\n\n\ndef count_tracks(all_detections):\n    tracks = []\n    total = 0\n    next_id = 0\n    for frame_no, detections in enumerate(all_detections):\n        # Keep unmatched tracks alive long enough to traverse an occluding body.\n        active = [t for t in tracks if frame_no - t[\"last\"] <= 24]\n        edges = []\n        for ti, track in enumerate(active):\n            for di, det in enumerate(detections):\n                value = _cost(track, det, frame_no)\n                if value is not None:\n                    edges.append((value, ti, di))\n        used_t, used_d, pairs = set(), set(), []\n        for _, ti, di in sorted(edges):\n            if ti not in used_t and di not in used_d:\n                used_t.add(ti); used_d.add(di); pairs.append((ti, di, False))\n\n        # A merged silhouette is allowed to support additional tracks. Their\n        # separate predicted centers preserve identity until the blob splits.\n        for ti, track in enumerate(active):\n            if ti in used_t:\n                continue\n            px, py = _prediction(track, frame_no)\n            best = None\n            for di in used_d:\n                d = detections[di]; x, y, w, h = d[\"box\"]\n                if (x - 7 <= px <= x + w + 7 and y - 7 <= py <= y + h + 7\n                        and d[\"area\"] >= 0.65 * track[\"area\"]):\n                    dist = float(np.hypot(d[\"x\"] - px, d[\"y\"] - py))\n                    if bes"]
[152.458021, "i", "t is None or dist < best[0]: best = (dist, di)\n            if best is not None:\n                used_t.add(ti); pairs.append((ti, best[1], True))\n\n        for ti, di, merged in pairs:\n            t, d = active[ti], detections[di]\n            gap = max(1, frame_no - t[\"last\"])\n            px, py = _prediction(t, frame_no)\n            if merged:\n                nx, ny = px, py\n            else:\n                nx, ny = d[\"x\"], d[\"y\"]\n            ivx, ivy = (nx - t[\"x\"]) / gap, (ny - t[\"y\"]) / gap\n            t[\"vx\"] = 0.45 * t[\"vx\"] + 0.55 * ivx\n            t[\"vy\"] = 0.45 * t[\"vy\"] + 0.55 * ivy\n            t[\"x\"], t[\"y\"], t[\"last\"] = nx, ny, frame_no\n            if not merged:\n                t[\"colour\"] = 0.75 * t[\"colour\"] + 0.25 * d[\"colour\"]\n                t[\"area\"] = 0.8 * t[\"area\"] + 0.2 * d[\"area\"]\n                t[\"seen\"] += 1\n            total += _crossing_update(t, ny)\n\n        # Propagate temporarily hidden tracks. Prediction may establish the\n        # passage, but only for tracks observed in at least two prior frames.\n        for ti, t in enumerate(active):\n            if ti in used_t or frame_no - t[\"last\"] != 1:\n                continue\n            px, py = _prediction(t, frame_no)\n            t[\"x\"], t[\"y\"], t[\"last\"] = px, py, frame_no\n            if t[\"seen\"] >= 2:\n                total += _crossing_update(t, py, False)\n\n        for di, d in enumerate(detections):\n            if di in used_d:\n                continue\n            t = {\"id\": next_id, \"x\": d[\"x\"], \"y\": d[\"y\"], \"vx\": 0.0,\n                 \"vy\": 0.0, \"last\": frame_no, \"colour\": d[\"colour\"].copy(),\n                 \"area\": d[\"area\"], \"above\": d[\"y\"] <= LINE_Y - 1.5,\n                 \"counted\": False, \"seen\": 1}\n            next_id += 1; tracks.append(t)\n    return int(total)\n\n\ndef fold_gate(n: int) -> int:\n    return int(n)\nPY\n"]
