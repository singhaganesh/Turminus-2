[152.476868, "o", "\u001b[?2004h> "]
[152.476964, "o", "            t, d = active[ti], detections[di]\r\n\u001b[?2004l\r"]
[152.477006, "o", "\u001b[?2004h> "]
[152.477104, "o", "            gap = max(1, frame_no - t[\"last\"])\r\n\u001b[?2004l\r"]
[152.477146, "o", "\u001b[?2004h> "]
[152.477256, "o", "            px, py = _prediction(t, frame_no)\r\n\u001b[?2004l\r"]
[152.477327, "o", "\u001b[?2004h"]
[152.477375, "o", ">             if merged:\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.47742, "o", "> "]
[152.477473, "o", "                nx, ny = px, py\r\n\u001b[?2004l\r"]
[152.47752, "o", "\u001b[?2004h> "]
[152.477563, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.47766, "o", "                nx, ny = d[\"x\"], d[\"y\"]\r\n\u001b[?2004l\r"]
[152.4777, "o", "\u001b[?2004h> "]
[152.477835, "o", "            ivx, ivy = (nx - t[\"x\"]) / gap, (ny - t[\"y\"]) / gap\r\n\u001b[?2004l\r"]
[152.477876, "o", "\u001b[?2004h> "]
[152.477979, "o", "            t[\"vx\"] = 0.45 * t[\"vx\"] + 0.55 * ivx\r\n\u001b[?2004l\r"]
[152.478021, "o", "\u001b[?2004h> "]
[152.478123, "o", "            t[\"vy\"] = 0.45 * t[\"vy\"] + 0.55 * ivy\r\n\u001b[?2004l\r"]
[152.478165, "o", "\u001b[?2004h> "]
[152.478281, "o", "            t[\"x\"], t[\"y\"], t[\"last\"] = nx, ny, frame_no\r\n\u001b[?2004l\r"]
[152.478326, "o", "\u001b[?2004h> "]
[152.478386, "o", "            if not merged:\r\n\u001b[?2004l\r"]
[152.478427, "o", "\u001b[?2004h> "]
[152.478574, "o", "                t[\"colour\"] = 0.75 * t[\"colour\"] + 0.25 * d[\"colour\"]\r\n\u001b[?2004l\r"]
[152.478614, "o", "\u001b[?2004h> "]
[152.478744, "o", "                t[\"area\"] = 0.8 * t[\"area\"] + 0.2 * d[\"area\"]\r\n\u001b[?2004l\r"]
[152.478786, "o", "\u001b[?2004h> "]
[152.478851, "o", "                t[\"seen\"] += 1\r\n\u001b[?2004l\r"]
[152.478891, "o", "\u001b[?2004h> "]
[152.478985, "o", "            total += _crossing_update(t, ny)\r\n\u001b[?2004l\r"]
[152.479032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.479093, "o", "\u001b[?2004h> "]
[152.479246, "o", "        # Propagate temporarily hidden tracks. Prediction may establish the\r\n\u001b[?2004l\r"]
[152.479301, "o", "\u001b[?2004h> "]
[152.479461, "o", "        # passage, but only for tracks observed in at least two prior frames.\r\n\u001b[?2004l\r"]
[152.479508, "o", "\u001b[?2004h> "]
[152.479588, "o", "        for ti, t in enumerate(active):\r\n\u001b[?2004l\r"]
[152.479631, "o", "\u001b[?2004h> "]
[152.479761, "o", "            if ti in used_t or frame_no - t[\"last\"] != 1:\r\n\u001b[?2004l\r"]
[152.479804, "o", "\u001b[?2004h> "]
[152.479859, "o", "                continue\r\n\u001b[?2004l\r"]
[152.479909, "o", "\u001b[?2004h> "]
[152.479998, "o", "            px, py = _prediction(t, frame_no)\r\n\u001b[?2004l\r"]
[152.480043, "o", "\u001b[?2004h> "]
[152.480157, "o", "            t[\"x\"], t[\"y\"], t[\"last\"] = px, py, frame_no\r\n\u001b[?2004l\r"]
[152.480207, "o", "\u001b[?2004h> "]
[152.480274, "o", "            if t[\"seen\"] >= 2:\r\n\u001b[?2004l\r"]
[152.480316, "o", "\u001b[?2004h> "]
[152.480453, "o", "                total += _crossing_update(t, py, False)\r\n\u001b[?2004l\r"]
[152.480506, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.480612, "o", "        for di, d in enumerate(detections):\r\n\u001b[?2004l\r"]
[152.480657, "o", "\u001b[?2004h> "]
[152.480708, "o", "            if di in used_d:\r\n\u001b[?2004l\r"]
[152.480753, "o", "\u001b[?2004h> "]
[152.480807, "o", "                continue\r\n\u001b[?2004l\r"]
[152.48085, "o", "\u001b[?2004h> "]
[152.481005, "o", "            t = {\"id\": next_id, \"x\": d[\"x\"], \"y\": d[\"y\"], \"vx\": 0.0,\r\n\u001b[?2004l\r"]
[152.481053, "o", "\u001b[?2004h> "]
[152.481208, "o", "                 \"vy\": 0.0, \"last\": frame_no, \"colour\": d[\"colour\"].copy(),\r\n\u001b[?2004l\r"]
[152.481273, "o", "\u001b[?2004h> "]
[152.481415, "o", "                 \"area\": d[\"area\"], \"above\": d[\"y\"] <= LINE_Y - 1.5,\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.481466, "o", "> "]
[152.481547, "o", "                 \"counted\": False, \"seen\": 1}\r\n\u001b[?2004l\r"]
[152.481593, "o", "\u001b[?2004h> "]
[152.481686, "o", "            next_id += 1; tracks.append(t)\r\n\u001b[?2004l\r"]
[152.48173, "o", "\u001b[?2004h> "]
[152.481779, "o", "    return int(total)\r\n\u001b[?2004l\r"]
[152.481823, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.481873, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[152.481918, "o", "> "]
[152.481968, "o", "def fold_gate(n: int) -> int:\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.482013, "o", "> "]
[152.482062, "o", "    return int(n)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[152.483266, "o", "\u001b[?2004hroot@a7a41f3e118a:/app# "]
[152.648229, "i", "cat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport toml\nfrom pathlib import Path\n\nfrom blot import foreground_detections\nfrom tether import count_tracks, fold_gate\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('invalid frame geometry')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('clip contains no decodable frames')\n    return fold_gate(count_tracks(foreground_detections(frames)))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    temporary = SHEET.with_suffix('.tmp')\n    temporary.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    temporary.replace(SHEET)\nPY\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\nfrom spout import dump_sheet, emit_span\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef main() -> int:\n    try:\n        SHEET.unlink(missing_ok=True)\n        if len(sys.argv) != 2:\n            return 2\n        dump_sheet(emit_span(sys.argv[1]))\n        return 0\n    except Exception as exc:\n        SHEET.unlink(missing_ok=True)\n        print('mill:', exc, file=sys.stderr)\n        return 1\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\n/app/kiln/bake.sh\npython3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo rc=$rc; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo unexpected=$? || true\nprintf 'sheet='; test -e /app/inkwell/sheet.toml && echo PRESENT || echo absent\n"]
