[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> LINE_Y = 70
[?2004l[?2004h> 
[?2004ld[?2004h> 
[?2004l[?2004h> def foreground_detections(frames):
[?2004l[?2004h>     """Return component observations for every frame of a fixed-camera clip."""
[?2004l[?2004h>     stack = np.asarray(frames)
[?2004l[?2004h>     # A temporal median is unaffected by an object merely crossing a pixel.
[?2004l[?2004h>     background = np.median(stack, axis=0).astype(np.uint8)
[?2004l[?2004h>     kernel = np.ones((3, 3), np.uint8)
[?2004l[?2004h>     answer = []
[?2004l[?2004h>     for frame in frames:
[?2004l[?2004h>         delta = cv2.absdiff(frame, background)
[?2004l[?2004h>         # Maximum channel distance retains strongly coloured objects whose
[?2004l[?2004h>         # grayscale luminance happens to resemble the background.
[?2004l[?2004h>         mask = (np.max(delta, axis=2) >= 16).astype(np.uint8) * 255
[?2004l[?2004h>         mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
[?2004l[?2004h>         mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
[?2004l[?2004h>         count, labels, stats, centers = cv2.connectedComponentsWithStats(mask, 8)
[?2004l[?2004h>         found = []
[?2004l[?2004h>         for label in range(1, count):
[?2004l[?2004h>             x, y, w, h, area = [int(v) for v in stats[label]]
[?2004l[?2004h>             if area < 18 or w < 3 or h < 3:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             pixels = frame[labels == label]
[?2004l[?2004h>             colour = np.median(pixels, axis=0).astype(float)
[?2004l[?2004h>             found.append({
[?2004l[?2004h>                 "x": float(centers[label][0]), "y": float(centers[label][1]),
[?2004l[?2004h>                 "box": (x, y, w, h), "area": float(area), "colour": colour,
[?2004l[?2004h>             })
[?2004l[?2004h>         answer.append(found)
[?2004l[?2004h>     return answer
[?2004l[?2004h> PY
