[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> LINE_Y = 70.0
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _prediction(track, frame_no):
[?2004l[?2004h>     gap = frame_no - track["last"]
[?2004l[?2004h>     return track["x"] + track["vx"] * gap, track["y"] + track["vy"] * gap
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _cost(track, det, frame_no):
[?2004l[?2004h>     px, py = _prediction(track, frame_no)
[?2004l[?2004h>     gap = frame_no - track["last"]
[?2004l[?2004h>     distance = float(np.hypot(det["x"] - px, det["y"] - py))
[?2004l[?2004h>     colour = float(np.linalg.norm(det["colour"] - track["colour"]))
[?2004l[?2004h>     # Position dominates; colour prevents identity swaps where paths approach.
[?2004l[?2004h>     limit = 13.0 + 9.0 * max(0, gap - 1) + 1.7 * min(12.0, abs(track["vy"]))
[?2004l[?2004h>     if distance > limit or colour > 115.0:
[?2004l[?2004h>         return None
[?2004l[?2004h>     ratio = max(det["area"], track["area"]) / max(1.0, min(det["area"], track["area"]))
[?2004l[?2004h>     return distance + 0.055 * colour + (3.0 if ratio > 2.4 else 0.0)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _crossing_update(track, y, observed=True):
[?2004l[?2004h>     # A small dead band prevents line jitter and lingering from making events.
[?2004l[?2004h>     if y <= LINE_Y - 1.5:
[?2004l[?2004h>         track["above"] = True
[?2004l[?2004h>     if (track["above"] and not track["counted"] and y >= LINE_Y + 1.5
[?2004l[?2004h>             and track["vy"] > 0.15):
[?2004l[?2004h>         track["counted"] = True
[?2004l[?2004h>         return 1
[?2004l[?2004h>     return 0
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def count_tracks(all_detections):
[?2004l[?2004h>     tracks = []
[?2004l[?2004h>     total = 0
[?2004l[?2004h>     next_id = 0
[?2004l[?2004h>     for frame_no, detections in enumerate(all_detections):
[?2004l[?2004h>         # Keep unmatched tracks alive long enough to traverse an occluding body.
[?2004l[?2004h>         active = [t for t in tracks if frame_no - t["last"] <= 24]
[?2004l[?2004h>         edges = []
[?2004l[?2004h>         for ti, track in enumerate(active):
[?2004l[?2004h>             for di, det in enumerate(detections):
[?2004l[?2004h>                 value = _cost(track, det, frame_no)
[?2004l[?2004h>                 if value is not None:
[?2004l[?2004h>                     edges.append((value, ti, di))
[?2004l[?2004h>         used_t, used_d, pairs = set(), set(), []
[?2004l[?2004h>         for _, ti, di in sorted(edges):
[?2004l[?2004h>             if ti not in used_t and di not in used_d:
[?2004l[?2004h>                 used_t.add(ti); used_d.add(di); pairs.append((ti, di, False))
[?2004l[?2004h> 
[?2004l[?2004h>         # A merged silhouette is allowed to support additional tracks. Their
[?2004l[?2004h>         # separate predicted centers preserve identity until the blob splits.
[?2004l[?2004h>         for ti, track in enumerate(active):
[?2004l[?2004h>             if ti in used_t:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             px, py = _prediction(track, frame_no)
[?2004l[?2004h>             best = None
[?2004l[?2004h>             for di in used_d:
[?2004l[?2004h>                 d = detections[di]; x, y, w, h = d["box"]
[?2004l[?2004h>                 if (x - 7 <= px <= x + w + 7 and y - 7 <= py <= y + h + 7
[?2004l[?2004h>                         and d["area"] >= 0.65 * track["area"]):
[?2004l[?2004h>                     dist = float(np.hypot(d["x"] - px, d["y"] - py))
[?2004l[?2004h>                     if best is None or dist < best[0]: best = (dist, di)
[?2004l[?2004h>             if best is not None:
[?2004l[?2004h>                 used_t.add(ti); pairs.append((ti, best[1], True))
[?2004l[?2004h> 
[?2004l[?2004h>         for ti, di, merged in pairs:
[?2004l[?2004h>             t, d = active[ti], detections[di]
[?2004l[?2004h>             gap = max(1, frame_no - t["last"])
[?2004l[?2004h>             px, py = _prediction(t, frame_no)
[?2004l[?2004h>             if merged:
[?2004l[?2004h>                 nx, ny = px, py
[?2004l[?2004h>             else:
[?2004l[?2004h>                 nx, ny = d["x"], d["y"]
[?2004l[?2004h>             ivx, ivy = (nx - t["x"]) / gap, (ny - t["y"]) / gap
[?2004l[?2004h>             t["vx"] = 0.45 * t["vx"] + 0.55 * ivx
[?2004l[?2004h>             t["vy"] = 0.45 * t["vy"] + 0.55 * ivy
[?2004l[?2004h>             t["x"], t["y"], t["last"] = nx, ny, frame_no
[?2004l[?2004h>             if not merged:
[?2004l[?2004h>                 t["colour"] = 0.75 * t["colour"] + 0.25 * d["colour"]
[?2004l[?2004h>                 t["area"] = 0.8 * t["area"] + 0.2 * d["area"]
[?2004l[?2004h>                 t["seen"] += 1
[?2004l[?2004h>             total += _crossing_update(t, ny)
[?2004l[?2004h> 
[?2004l[?2004h>         # Propagate temporarily hidden tracks. Prediction may establish the
[?2004l[?2004h>         # passage, but only for tracks observed in at least two prior frames.
[?2004l[?2004h>         for ti, t in enumerate(active):
[?2004l[?2004h>             if ti in used_t or frame_no - t["last"] != 1:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             px, py = _prediction(t, frame_no)
[?2004l[?2004h>             t["x"], t["y"], t["last"] = px, py, frame_no
[?2004l[?2004h>             if t["seen"] >= 2:
[?2004l[?2004h>                 total += _crossing_update(t, py, False)
[?2004l[?2004h> 
[?2004l[?2004h>         for di, d in enumerate(detections):
[?2004l[?2004h>             if di in used_d:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             t = {"id": next_id, "x": d["x"], "y": d["y"], "vx": 0.0,
[?2004l[?2004h>                  "vy": 0.0, "last": frame_no, "colour": d["colour"].copy(),
[?2004l[?2004h>                  "area": d["area"], "above": d["y"] <= LINE_Y - 1.5,
[?2004l[?2004h>                  "counted": False, "seen": 1}
[?2004l[?2004h>             next_id += 1; tracks.append(t)
[?2004l[?2004h>     return int(total)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def fold_gate(n: int) -> int:
[?2004l[?2004h>     return int(n)
