[?2004l[?2004h> def returning(t):
[?2004l[?2004h>  if t<18:return (80,35+2.2*t)
[?2004l[?2004h>  if t<25:return (80,74)
[?2004l[?2004h>  if t<36:return (80,74-3*(t-25))
[?2004l[?2004h>  return (80,41+3*(t-36))
[?2004l[?2004h> write('return.mp4',[returning],52)
