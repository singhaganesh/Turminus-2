[?2004l[?2004h> bg=np.full((H,W,3),(52,45,42),np.uint8)
[?2004l[?2004h> def write(name, paths, n=48):
[?2004l[?2004h>  out=cv2.VideoWriter('/tmp/cases/'+name,cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))
[?2004l[?2004h>  colors=[(30,30,210),(30,210,30),(210,30,30),(30,210,210),(210,30,210),(210,210,30)]
[?2004l[?2004h>  for t in range(n):
[?2004l[?2004h>   f=bg.copy()
[?2004l[?2004h>   for i,path in enumerate(paths):
[?2004l[?2004h>    q=path(t)
[?2004l[?2004h>    if q is not None:
[?2004l[?2004h>     x,y=q; cv2.circle(f,(int(x),int(y)),8,colors[i%len(colors)],-1)
[?2004l[?2004h>   out.write(f)
[?2004l[?2004h>  out.release()
[?2004l[?2004h> # Five concurrent bodies, two paths draw close/partially overlap.
[?2004l[?2004h> write('five.mp4',[lambda t,x=x: (x,8+2.4*t) for x in (25,52,78,96,130)])
[?2004l[?2004h> # Wrong direction only.
