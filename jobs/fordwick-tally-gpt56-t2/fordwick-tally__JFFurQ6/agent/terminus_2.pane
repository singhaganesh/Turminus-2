[?2004l[?2004h>         if len(sys.argv) != 2:
[?2004l[?2004h>             return 2
[?2004l[?2004h>         dump_sheet(emit_span(sys.argv[1]))
[?2004l[?2004h>         return 0
[?2004l[?2004h>     except Exception as exc:
