if (x - 7 <= px <= x + w + 7 and y - 7 <= py <= y + h + 7\n                        and d["area"] >= 0.65 * track["area"]):\n                    dist = float(np.hypot(d["x"] - px, d["y"] - py))\n                    if best is None or dist < best[0]: best = (dist, di)\n            if best is not None:\n                used_t.add(ti); pairs.append((ti, best[1], True))\n\n        for ti, di, merged in pairs:\n            t, d = active[ti], detections[di]\n            gap = max(1, frame_no - t["last"])\n            px, py = _prediction(t, frame_no)\n            if merged:\n                nx, ny = px, py\n            else:\n                nx, ny = d["x"], d["y"]\n            ivx, ivy = (nx - t["x"]) / gap, (ny - t["y"]) / gap\n            t["vx"] = 0.45 * t["vx"] + 0.55 * ivx\n            t["vy"] = 0.45 * t["vy"] + 0.55 * ivy\n            t["x"], t["y"], t["last"] = nx, ny, frame_no\n            if not merged:\n                t["colour"] = 0.75 * t["colour"] + 0.25 * d["colour"]\n                t["area"] = 0.8 * t["area"] + 0.2 * d["area"]\n                t["seen"] += 1\n            total += _crossing_update(t, ny)\n\n        # Propagate temporarily hidden tracks. Prediction may establish the\n        # passage, but only for tracks observed in at least two prior frames.\n        for ti, t in enumerate(active):\n            if ti in used_t or frame_no - t["last"] != 1:\n                continue\n            px, py = _prediction(t, frame_no)\n            t["x"], t["y"], t["last"] = px, py, frame_no\n            if t["seen"] >= 2:\n                total += _crossing_update(t, py, False)\n\n        for di, d in enumerate(detections):\n            if di in used_d:\n                continue\n            t = {"id": next_id, "x": d["x"], "y": d["y"], "vx": 0.0,\n                 "vy": 0.0, "last": frame_no, "colour": d["colour"].copy(),\n                 "area": d["area"], "above": d["y"] <= LINE_Y - 1.5,\n                 "counted": False, "seen": 1}\n            next_id +=