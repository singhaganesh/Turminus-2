[11.951405, "o", "sed: can't read /app/environment/*: No such file or directory\r\n"]
[11.951932, "o", "\u001b[?2004hroot@11f22c1f15b9:/app# "]
[12.918106, "i", "printf '\\n== daywell before ==\\n'; find /app/daywell -maxdepth 1 -type f -printf '%f ' -exec wc -l {} \\; 2>/dev/null; printf '\\n== clasp ==\\n'; /app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; printf '\\n== outputs ==\\n'; find /app/bloturn /app/packbay -maxdepth 3 -printf '%y %p\\n' 2>/dev/null | sort; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do test -e \"$f\" && { echo \"--- $f\"; cat \"$f\"; echo; }; done; printf '\\n== latest contents ==\\n'; find /app/packbay/latest -maxdepth 1 -type f -print -exec sh -c 'echo rows=$(wc -l < \"$1\"); sed -n \"1,20p\" \"$1\"' sh {} \\; 2>/dev/null\n"]
[12.919764, "o", "printf '\\n== daywell before ==\\n'; find /app/daywell -maxdepth 1 -type f -printf '%f ' -exec wc -l {} \\; 2>/dev/null; printf '\\n== clasp ==\\n'; /app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; printf '\\n== outputs ==\\n'; find /app/bloturn /app/packbay -maxdepth 3 -printf '%y %p\\n' 2>/dev/null | sort; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do test -e \"$f\" && { echo \"--- $f\"; cat \"$f\"; echo; }; done; printf '\\n== latest contents ==\\n'; find /app/packbay/latest -maxdepth 1 -type f -print -exec sh -c 'echo rows=$(wc -l < \"$1\"); sed -n \"1,20p\" \"$1\"' sh {} \\; 2>/dev/null\r\n"]
