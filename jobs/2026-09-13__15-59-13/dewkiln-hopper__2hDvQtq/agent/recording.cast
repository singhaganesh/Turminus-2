[57.87332, "o", "echo '--- /app/corkpit/floor.rs'; cat /app/corkpit/floor.rs\r\n\u001b[?2004l\r"]
[57.87337, "o", "--- /app/corkpit/floor.rs\r\n"]
[57.876434, "o", "use std::fs;\r\n\r\npub fn floor(a: i32) -> bool {\r\n    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n        Err(_) => 0,\r\n    };\r\n    a >= t\r\n}\r\n"]
[57.876976, "o", "\u001b[?2004hroot@11f22c1f15b9:/app# "]
[58.196245, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], root: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(root);\n    fs::create_dir_all(root).map_err(|_| 1)?;\n    let mut files = files.to_vec();\n    files.sort_by_key(|x| x.0);\n    for (day, source) in files {\n        let dest = format!(\"{}/d{:08}.tbl\", root, day);\n        fs::copy(source, dest).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?.trim().parse().map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list(\"/app/daywell\"));\n\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\n    let _ = fs::remove_dir_all(\"/app/packbay/latest\");\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\n    fs::create_dir_all(\"/app/packbay/latest\").map_err(|_| 1)?;\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let mut taken = 0;\n    for (day, source) in &picked {\n        let rows = read::nlines(source);\n        taken += rows;\n        fs::copy(source, format!(\"/app/packbay/stage/d{:08}.tbl\", day)).map_err(|_| 1)?;\n    }\n    if taken == 0 {\n        return Err(1);\n    }\n\n    soak::soak(&picked, \"/app/packbay/latest\")?;\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/ledger.json\", format!(\"{{\\\"taken\\\":{}}}\", taken)).map_err(|_| 1)?;\n    Ok((picked, taken))\n}\nEOF\ncat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn rows(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    Ok(text.lines().filter(|line| !line.trim().is_empty()).count() as i32)\n}\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let out = tpl.replace(\"__P__\", probe)\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    if files.is_empty() || taken <= 0 {\n        return 1;\n    }\n\n    let mut matched = 0;\n    let mut probe = String::new();\n    for (day, source) in files {\n        // This read is deliberately from daywell: verification must be live and\n        // independent of ledger.json and the staged copies.\n        let source_rows = match rows(source) { Ok(n) => n, Err(c) => return c };\n        let restored = format!(\"/app/packbay/latest/d{:08}.tbl\", day);\n        let restored_rows = match rows(&restored) { Ok(n) => n, Err(c) => return c };\n        if source_rows != restored_rows {\n            return 1;\n        }\n        matched += source_rows;\n        probe = source.clone();\n    }\n    if matched != taken {\n        return 1;\n    }\n    if emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() { return 1; }\n    0\n}\nEOF\ncat > /app/wickmill/boot.rs <<'EOF'\n#[path = \"../urncue/fold.rs\"]\nmod fold;\n#[path = \"../millrib/gait.rs\"]\nmod gait;\n#[path = \"../lidcue/skip.rs\"]\nmod skip;\n#[path = \"../corkpit/floor.rs\"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != \"clasp\" {\n        eprintln!(\"usage: dewkiln clasp\");\n        std::process::exit(2);\n    }\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\n    let code = match fold::fold() {\n        Ok((packed, taken)) => {\n            let mut ordered = packed;\n            skip::skip(&mut ordered);\n            if floor::floor(taken) != 0 { 1 } else { gait::gait(t"]
[58.196366, "i", "aken, &ordered) }\n        }\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh && file /app/bin/dewkiln && /app/bin/dewkiln clasp; rc=$?; echo RC=$rc; cat /app/bloturn/ledger.json; echo; cat /app/bloturn/check.json; echo; cat /app/bloturn/GUARD 2>/dev/null || true; find /app/packbay/latest -maxdepth 1 -type f -printf '%f ' -exec wc -l {} \\; | sort\n"]
