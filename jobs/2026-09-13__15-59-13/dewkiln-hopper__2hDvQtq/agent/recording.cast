[100.202289, "i", "python3 - <<'PY'\nimport json, os\nbinary = open('/app/bin/dewkiln','rb').read(4)\nassert binary == b'\\x7fELF', binary\nwith open('/app/opstext/WALL') as f: wall = int(f.read().strip())\nwith open('/app/bloturn/ledger.json') as f: ledger = json.load(f)\nwith open('/app/bloturn/check.json') as f: check = json.load(f)\nassert set(check) == {'probe','matched','taken'}\nassert type(check['probe']) is str and check['probe'].startswith('/app/daywell/')\nassert type(check['matched']) is int and type(check['taken']) is int\nassert open('/app/bloturn/GUARD').read() == 'ok'\ntotal = 0\nfor name in os.listdir('/app/daywell'):\n    if len(name) == 13 and name[0] == 'd' and name[1:9].isdigit() and name[9:] == '.tbl':\n        day = int(name[1:9])\n        latest = '/app/packbay/latest/' + name\n        if day <= wall:\n            source = '/app/daywell/' + name\n            assert os.path.exists(latest), name\n            assert open(source,'rb').read() == open(latest,'rb').read(), name\n            total += sum(bool(x.strip()) for x in open(source))\n        else:\n            assert not os.path.exists(latest), name\nassert total == ledger['taken'] == check['matched'] == check['taken']\nassert not os.path.exists('/app/daywell.test-save')\nprint('ELF=yes schema=valid rows=%d eligible_copies=identical guard=ok' % total)\nPY\n"]
