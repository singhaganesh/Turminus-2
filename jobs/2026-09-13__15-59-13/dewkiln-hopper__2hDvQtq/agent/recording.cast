[77.896796, "i", "python3 - <<'PY'\np='/app/wickmill/boot.rs'\ns=open(p).read().replace('if floor::floor(taken) != 0 { 1 }', 'if !floor::floor(taken) { 1 }')\nopen(p,'w').write(s)\nPY\ncat > /app/shardfold/read.rs <<'EOF'\nuse std::fs;\n\npub fn list(root: &str) -> Vec<(i32, String)> {\n    let mut files = Vec::new();\n    let entries = match fs::read_dir(root) {\n        Ok(entries) => entries,\n        Err(_) => return files,\n    };\n    for entry in entries.flatten() {\n        let name = entry.file_name().to_string_lossy().into_owned();\n        if name.len() != 13 || !name.starts_with('d') || !name.ends_with(\".tbl\") {\n            continue;\n        }\n        let digits = &name[1..9];\n        if !digits.bytes().all(|b| b.is_ascii_digit()) {\n            continue;\n        }\n        if let Ok(day) = digits.parse::<i32>() {\n            files.push((day, entry.path().to_string_lossy().into_owned()));\n        }\n    }\n    files.sort_by_key(|x| x.0);\n    files\n}\n\npub fn nlines(path: &str) -> i32 {\n    match fs::read_to_string(path) {\n        Ok(text) => text.lines().filter(|line| !line.trim().is_empty()).count() as i32,\n        Err(_) => 0,\n    }\n}\nEOF\n/app/wick.sh\nfile /app/bin/dewkiln\n/app/bin/dewkiln clasp; rc=$?; echo \"normal_RC=$rc\"; echo '== artifacts =='; cat /app/bloturn/ledger.json; echo; cat /app/bloturn/check.json; echo; printf 'GUARD='; cat /app/bloturn/GUARD 2>/dev/null || echo absent; echo; find /app/packbay/latest -maxdepth 1 -type f -printf '%f ' -exec wc -l {} \\; | sort\n"]
[77.897036, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[77.897161, "o", "\u001b[?2004h> "]
[77.89728, "o", "p='/app/wickmill/boot.rs'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.897494, "o", "s=open(p).read().replace('if floor::floor(taken) != 0 { 1 }', 'if !floor::floor(taken) { 1 }')\r\n\u001b[?2004l\r"]
[77.897595, "o", "\u001b[?2004h> open(p,'w').write(s)\r\n"]
[77.897694, "o", "\u001b[?2004l\r\u001b[?2004h"]
[77.897732, "o", "> PY\r\n\u001b[?2004l\r"]
