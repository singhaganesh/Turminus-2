[12.968657, "o", "\u001b[?2004hroot@202fd1e3b98a:/app# "]
[25.014908, "i", "printf '%s\\n' '--- wick.sh ---'; sed -n '1,260p' /app/wick.sh; for f in /app/wickmill/boot.rs /app/hopcue/rim.rs /app/millrib/gait.rs /app/restpit/soak.rs /app/urncue/fold.rs /app/shardfold/read.rs /app/lidcue/skip.rs /app/floorcue/floor.rs; do echo \"===== $f =====\"; sed -n '1,300p' \"$f\"; done\n"]
[25.017221, "o", "printf '%s\\n' '--- wick.sh ---'; sed -n '1,260p' /app/wick.sh; for f in /app/wickmill/boot.rs /app/hopcue/rim.rs /app/millrib/gait.rs /app/restpit/soak.rs /app/urncue/fold.rs /app/shardfold/read.rs /app/lidcue/skip.rs /app/floorcue/floor.rs; do echo \"===== $f =====\"; sed -n '1,300p' \"$f\"; done\r\n\u001b[?2004l\r"]
[25.019094, "o", "--- wick.sh ---\r\n"]
[25.023104, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/bloturn /app/packbay\r\nrustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\r\n"]
[25.025255, "o", "===== /app/wickmill/boot.rs =====\r\n"]
[25.026124, "o", "#[path = \"../urncue/fold.rs\"]\r\nmod fold;\r\n#[path = \"../millrib/gait.rs\"]\r\nmod gait;\r\n#[path = \"../lidcue/skip.rs\"]\r\nmod skip;\r\n#[path = \"../corkpit/floor.rs\"]\r\nmod floor;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n"]
[25.026532, "o", "    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"clasp\" {\r\n        eprintln!(\"usage: dewkiln clasp\");\r\n        std::process::exit(2);\r\n    }\r\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    let code = match fold::fold() {\r\n        Ok((packed, taken)) => {\r\n            let mut dump = packed.clone();\r\n            skip::skip(&mut dump);\r\n            let _ = floor::floor(taken);\r\n            gait::gait(taken, &packed)\r\n        }\r\n        Err(c) => c,\r\n    };\r\n    std::process::exit(code);\r\n}\r\n===== /app/hopcue/rim.rs =====\r\n"]
[25.030298, "o", "pub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n    b.into_iter().filter(|(d, _)| *d < a).collect()\r\n}\r\n"]
[25.030921, "o", "===== /app/millrib/gait.rs =====\r\n"]
[25.034214, "o", "use std::fs;\r\n\r\nfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\r\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n    let out = tpl\r\n        .replace(\"__P__\", p)\r\n        .replace(\"__M__\", &m.to_string())\r\n        .replace(\"__T__\", &t.to_string());\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)?;\r\n    Ok(())\r\n}\r\n\r\npub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {\r\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n    if emit(\"ledger\", a, a).is_err() {\r\n        return 1;\r\n    }\r\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[25.034944, "o", "===== /app/restpit/soak.rs =====\r\n"]
[25.037645, "o", "use std::fs;\r\n\r\npub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n    let _ = fs::remove_dir_all(b);\r\n    fs::create_dir_all(b).map_err(|_| 1)?;\r\n    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n    xs.sort_by_key(|x| x.0);\r\n    if !xs.is_empty() {\r\n        xs.pop();\r\n    }\r\n    for (d, p) in xs {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    }\r\n    Ok(())\r\n}\r\n"]
[25.038355, "o", "===== /app/urncue/fold.rs =====\r\n"]
[25.042681, "o", "#[path = \"../hopcue/rim.rs\"]\r\nmod rim;\r\n#[path = \"../restpit/soak.rs\"]\r\nmod soak;\r\n#[path = \"../shardfold/read.rs\"]\r\nmod read;\r\n\r\nuse std::fs;\r\n\r\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n        .map_err(|_| 1)?\r\n        .trim()\r\n        .parse()\r\n        .map_err(|_| 1)?;\r\n    let listed = read::list(\"/app/daywell\");\r\n    let picked = rim::rim(wall, listed);\r\n    if picked.is_empty() {\r\n        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n        return Ok((Vec::new(), 0));\r\n    }\r\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    let mut packed = Vec::new();\r\n    let mut taken = 0;\r\n    for (d, p) in picked {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n        taken += read::nlines(&dest);\r\n        packed.push((d, dest));\r\n    }\r\n    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    Ok((packed, taken))\r\n}\r\n"]
[25.043193, "o", "===== /app/shardfold/read.rs =====\r\n"]
[25.045509, "o", "use std::fs;\r\n\r\npub fn list(root: &str) -> Vec<(i32, String)> {\r\n    let mut v = Vec::new();\r\n    let rd = match fs::read_dir(root) {\r\n        Ok(x) => x,\r\n        Err(_) => return v,\r\n    };\r\n    for ent in rd.flatten() {\r\n        let name = ent.file_name().to_string_lossy().into_owned();\r\n        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n            continue;\r\n        }\r\n"]
[25.045639, "o", "        let mid = &name[1..name.len() - 4];\r\n        if let Ok(d) = mid.parse::<i32>() {\r\n            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n        }\r\n    }\r\n    v.sort_by_key(|x| x.0);\r\n    v\r\n}\r\n\r\npub fn nlines(path: &str) -> i32 {\r\n    match fs::read_to_string(path) {\r\n        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n        Err(_) => 0,\r\n    }\r\n}\r\n"]
[25.046022, "o", "===== /app/lidcue/skip.rs =====\r\n"]
[25.048424, "o", "pub fn skip(a: &mut [(i32, String)]) {\r\n    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n}\r\n\r\npub fn width(a: &[(i32, String)]) -> usize {\r\n    a.len()\r\n"]
[25.048995, "o", "}\r\n\r\npub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    a.first().map(|x| x.0)\r\n}\r\n"]
[25.050871, "o", "===== /app/floorcue/floor.rs =====\r\n"]
[25.054431, "o", "sed: can't read /app/floorcue/floor.rs: No such file or directory\r\n"]
[25.054704, "o", "\u001b[?2004hroot@202fd1e3b98a:/app# "]
[26.064782, "i", "echo '===== template ====='; cat /app/millrib/sheet.tpl; echo '===== usage ====='; cat /app/wickmill/usage.txt; echo '===== NOTE ====='; cat /app/corkpit/NOTE.txt; echo '===== SHIFT ====='; cat /app/opstext/SHIFT.txt; echo '===== current artifacts ====='; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do echo \"--- $f\"; cat \"$f\" 2>/dev/null || true; echo; done\n"]
[26.067121, "o", "echo '===== template ====='; cat /app/millrib/sheet.tpl; echo '===== usage ====='; cat /app/wickmill/usage.txt; echo '===== NOTE ====='; cat /app/corkpit/NOTE.txt; echo '===== SHIFT ====='; cat /app/opstext/SHIFT.txt; echo '===== current artifacts ====='; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do echo \"--- $f\"; cat \"$f\" 2>/dev/null || true; echo; done"]
[26.067197, "o", "\r\n"]
[26.068053, "o", "\u001b[?2004l\r===== template =====\r\n"]
[26.070069, "o", "{\"probe\":\"__P__\",\"matched\":__M__,\"taken\":__T__}\r\n"]
[26.07146, "o", "===== usage =====\r\n"]
[26.074598, "o", "dewkiln clasp\r\n===== NOTE ====="]
[26.074667, "o", "\r\n"]
[26.076924, "o", "floor() reads MIN.txt and compares a taken total to that integer.\r\nCI used this as a cheap rehearsal when the desk was first wired.\r\n"]
[26.077132, "o", "===== SHIFT =====\r\n"]
[26.079601, "o", "Nightly clasp has stayed green since the CI floor landed.\r\nOperators still open /app/packbay/latest after incidents and find the\r\nnewest populated day file missing even when /app/daywell still holds it.\r\nThe floor value lives under floorcue/.\r\n"]
[26.082342, "o", "===== current artifacts =====\r\n--- /app/bloturn/ledger.json\r\n"]
[26.084158, "o", "{\"taken\":15}"]
[26.084775, "o", "\r\n--- /app/bloturn/check.json\r\n"]
[26.087655, "o", "{\"probe\":\"ledger\",\"matched\":15,\"taken\":15}\r\n"]
[26.08816, "o", "\r\n--- /app/bloturn/GUARD\r\n"]
[26.090132, "o", "ok"]
[26.090384, "o", "\r\n"]
[26.090513, "o", "\u001b[?2004hroot@202fd1e3b98a:/app# "]
[26.624838, "i", "find /app -name Cargo.toml -o -name Cargo.lock -o -name '*.rlib' -o -name '*.rmeta' | sort\n"]
[26.626123, "o", "find /app -name Cargo.toml -o -name Cargo.lock -o -name '*.rlib' -o -name '*.rmeta' | sort"]
[26.627019, "o", "\r\n\u001b[?2004l\r"]
[26.64698, "o", "\u001b[?2004hroot@202fd1e3b98a:/app# "]
[26.945117, "i", "set +e; /app/bin/dewkiln clasp; rc=$?; echo \"CLASP_RC=$rc\"; echo '--- daywell counts'; for f in /app/daywell/*; do printf '%s ' \"$(basename \"$f\")\"; wc -l < \"$f\"; done; echo '--- output tree'; find /app/bloturn /app/packbay -maxdepth 2 -type f -printf '%p %s bytes\\n' -exec sh -c 'echo \"### $1\"; cat \"$1\"; echo' _ {} \\;; exit 0\n"]
[26.947891, "o", "set +e; /app/bin/dewkiln clasp; rc=$?; echo \"CLASP_RC=$rc\"; echo '--- daywell counts'; for f in /app/daywell/*; do printf '%s ' \"$(basename \"$f\")\"; wc -l < \"$f\"; done; echo '--- output tree'; find /app/bloturn /app/packbay -maxdepth 2 -type f -printf '%p %s bytes\\n' -exec sh -c 'echo \"### $1\"; cat \"$1\"; echo' _ {} \\;; exit 0"]
