[121.049855, "i", "set -e\nfor reel in stable plain brine; do\n  /app/bin/pitchurn stow \"/app/filmwelle/$reel.bin\"\n  echo \"--- $reel tally ---\"\n  cat /app/urnbay/tally.json\n  python3 - \"$reel\" <<'PY'\nimport json,sys\nj=json.load(open('/app/urnbay/tally.json'))\nassert j['reel']==sys.argv[1]+'.bin'\nassert all(isinstance(j[k],str) for k in ('bytes_in','bytes_stored','reuse_frac','mean_piece','piece_count'))\nassert float(j['reuse_frac']) >= .80\nassert int(j['bytes_stored']) < int(j['bytes_in'])\nPY\n  /app/bin/pitchurn draw \"/app/urnbay/$reel.out\" \"/app/filmwelle/$reel.bin\"\n  cmp \"/app/filmwelle/$reel.bin\" \"/app/urnbay/$reel.out\"\ndone\necho NAMED_OK\n"]
