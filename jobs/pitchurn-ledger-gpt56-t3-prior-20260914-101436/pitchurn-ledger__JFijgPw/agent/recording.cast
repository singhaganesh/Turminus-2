[30.893327, "o", "    add(m, \"/app/urnbay/hot/idx.tsv\");\r\n     9\t    return m;\r\n    10\t  }\r\n    11\t  static void add(Map<String,String> m, String p) throws Exception {\r\n    12\t    Path f = Paths.get(p);\r\n    13\t    if (!Files.exists(f)) return;\r\n    14\t    for (String ln : Files.readAllLines(f)) {\r\n    15\t      String t = ln.trim();\r\n    16\t      if (t.isEmpty()) continue;\r\n    17\t      String[] sp = t.split(\"\\t\");\r\n    18\t      if (sp.length >= 2) m.put(sp[0], sp[1]);\r\n    19\t    }\r\n    20\t  }\r\n    21\t  public static void put(String k, String rel) throws Exception {\r\n    22\t    Path f = Paths.get(\"/app/urnbay/idx.tsv\");\r\n    23\t    Files.writeString(f, k + \"\\t\" + rel + \"\\n\", java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);\r\n    24\t  }\r\n    25\t  public static byte[] blob(String rel) throws Exception {\r\n    26\t    return Files.readAllBytes(Paths.get(\"/app/urnbay/\" + rel));\r\n    27\t  }\r\n"]
