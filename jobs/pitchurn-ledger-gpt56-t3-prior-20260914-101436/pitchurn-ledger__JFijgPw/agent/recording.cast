[153.782022, "o", "import java.nio.file.*;\r\nimport java.util.*;\r\npublic class Idx {\r\n  public static Map<String,String> load() throws Exception {\r\n    Map<String,String> m = new LinkedHashMap<>();\r\n    add(m, \"/app/urnbay/idx.tsv\");\r\n    add(m, \"/app/urnbay/keep/idx.tsv\");\r\n    add(m, \"/app/urnbay/hot/idx.tsv\");\r\n    return m;\r\n  }\r\n  static void add(Map<String,String> m, String p) throws Exception {\r\n    Path f = Paths.get(p);\r\n    if (!Files.exists(f)) return;\r\n    for (String ln : Files.readAllLines(f)) {\r\n      String t = ln.trim();\r\n      if (t.isEmpty()) continue;\r\n      String[] sp = t.split(\"\\t\");\r\n      if (sp.length >= 2) m.put(sp[0], sp[1]);\r\n    }\r\n  }\r\n  public static void put(String k, String rel) throws Exception {\r\n    Path f = Paths.get(\"/app/urnbay/idx.tsv\");\r\n    Files.writeString(f, k + \"\\t\" + rel + \"\\n\", java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);\r\n  }\r\n  public static byte[] blob(String rel) throws Exception {\r\n    return Files.readAllBytes(Paths.get(\"/app/urnbay/\" + rel));\r\n  }\r\n}\r\n"]
[153.782262, "o", "--- final index ---\r\n"]
[153.783236, "o", "23 /app/urnbay/idx.tsv\r\n"]
[153.784724, "o", "23\r\n"]
[153.784884, "o", "--- gear ---\r\n"]
[153.785606, "o", "mask=2047\r\nmin=48\r\nmax=4096\r\nfp=7\r\n"]
[153.785815, "o", "\u001b[?2004hroot@8c694c451f36:/app# "]
[153.976861, "i", "cat > /app/hitchcli/Idx.java <<'EOF'\nimport java.nio.file.*;\nimport java.util.*;\npublic class Idx {\n  public static Map<String,String> load() throws Exception {\n    Map<String,String> m = new LinkedHashMap<>();\n    add(m, \"/app/urnbay/idx.tsv\");\n    add(m, \"/app/urnbay/keep/idx.tsv\");\n    add(m, \"/app/urnbay/hot/idx.tsv\");\n    add(m, \"/app/urnbay/cold/idx.tsv\");\n    return m;\n  }\n  static void add(Map<String,String> m, String p) throws Exception {\n    Path f = Paths.get(p);\n    if (!Files.exists(f)) return;\n    for (String ln : Files.readAllLines(f)) {\n      String t = ln.trim();\n      if (t.isEmpty()) continue;\n      String[] sp = t.split(\"\\\\t\");\n      if (sp.length >= 2) m.put(sp[0], sp[1]);\n    }\n  }\n  public static void put(String k, String rel) throws Exception {\n    Path f = Paths.get(\"/app/urnbay/idx.tsv\");\n    Files.writeString(f, k + \"\\t\" + rel + \"\\n\",\n      StandardOpenOption.CREATE, StandardOpenOption.APPEND);\n  }\n  public static byte[] blob(String rel) throws Exception {\n    return Files.readAllBytes(Paths.get(\"/app/urnbay\").resolve(rel));\n  }\n}\nEOF\npython3 - <<'PY'\np='/app/hitchcli/StowRun.java'\ns=open(p).read()\ns=s.replace('    Map<String,String> idx = Idx.load();\\n', '    Map<String,String> idx = Idx.load();\\n    boolean prior = Files.exists(flag);\\n', 1)\ns=s.replace('    writeCard(name, src.length, stored, reuse, mean, parts.size());\\n    Files.writeString(flag, \"1\\\\n\");\\n    return 0;', '    writeCard(name, src.length, stored, reuse, mean, parts.size());\\n    Files.writeString(flag, \"1\\\\n\");\\n    if (prior && src.length > 0 && stored == src.length) return 1;\\n    return 0;')\nopen(p,'w').write(s)\nPY\n/app/kiln.sh\n"]
