[30.894455, "o", "     8\t    Map<String,String> idx = Idx.load();\r\n     9\t    long stored = 0;\r\n    10\t    long reused = 0;\r\n    11\t    List<String> keys = new ArrayList<>();\r\n    12\t    Path hot = Paths.get(\"/app/urnbay/hot\");\r\n    13\t    Files.createDirectories(hot);\r\n    14\t    for (byte[] p : parts) {\r\n    15\t      String kb = Seal.hex(p, g.fp);\r\n    16\t      String kp = Seal.pay(p);\r\n    17\t      String hit = null;\r\n    18\t      if (idx.containsKey(kb)) hit = kb;\r\n    19\t      else if (idx.containsKey(kp)) hit = kp;\r\n    20\t      if (hit != null) {\r\n    21\t        reused += p.length;\r\n    22\t        keys.add(hit);\r\n    23\t      } else {\r\n    24\t        stored += p.length;\r\n    25\t        String rel = \"hot/\" + kb + \".blob\";\r\n    26\t        Files.write(hot.resolve(kb + \".blob\"), p);\r\n    27\t        Idx.put(kb, rel);\r\n    28\t        idx.put(kb, rel);\r\n    29\t        keys.add(kb);\r\n    30\t      }\r\n    31\t    }\r\n    32\t    String name = Paths.get(reel).getFileName().toString();\r\n    33\t    Path flag = Paths.get(\"/app/urnbay/marks/\" + name + \".flag\");\r\n    34\t    boolean prior = Files.exists(flag);\r\n    35\t    Path mk = Paths.get(\"/app/urnbay/marks/\" + name + \".m\");\r\n    36\t    StringBuilder mb = new StringBuilder();\r\n    37\t    for (String k : keys) mb.append(k).append(\"\\n\");\r\n    38\t    Files.createDirectories(mk.getParent());\r\n    39\t    Files.writeString(mk, mb.toString());\r\n    40\t    double reuse = src.length == 0 ? 1.0 : (reused / (double) src.length);\r\n    41\t    double mean = parts.isEmpty() ? 0 : (src.length / (double) parts.size());\r\n    42\t    String json = \"{\\n\"\r\n    43\t      + \"  \\\"reel\\\": \\\"\" + name + \"\\\",\\n\"\r\n"]
[30.894569, "o", "    44\t      + \"  \\\"bytes_in\\\": \\\"\" + src.length + \"\\\",\\n\"\r\n    45\t      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\r\n    46\t      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\r\n    47\t      + \"  \\\"mean_piece\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\r\n    48\t      + \"  \\\"piece_count\\\": \\\"\" + parts.size() + \"\\\"\\n\"\r\n    49\t      + \"}\\n\";\r\n    50\t    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\r\n    51\t    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\r\n    52\t    Floor.ok(reuse);\r\n    53\t    if (prior && stored == src.length && src.length > 0) {\r\n    54\t      return 1;\r\n    55\t    }\r\n    56\t    Files.writeString(flag, \"1\\n\");\r\n    57\t    return 0;\r\n    58\t  }\r\n    59\t}\r\n"]
