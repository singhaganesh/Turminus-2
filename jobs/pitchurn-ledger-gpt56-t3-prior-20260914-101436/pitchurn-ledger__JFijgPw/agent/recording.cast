[90.099438, "i", "python3 - <<'PY'\np='/app/hitchcli/Idx.java'\ns=open(p).read()\ns=s.replace('      add(m, \"/app/urnbay/hot/idx.tsv\");\\n      return m;', '      add(m, \"/app/urnbay/hot/idx.tsv\");\\n      add(m, \"/app/urnbay/cold/idx.tsv\");\\n      return m;')\nopen(p,'w').write(s)\nPY\ncat > /app/hitchcli/StowRun.java <<'EOF'\nimport java.io.*;\nimport java.nio.file.*;\nimport java.util.*;\npublic class StowRun {\n  public static int run(String reel) throws Exception {\n    Gear g = Gear.load(\"/app/gearpit/live.gear\");\n    byte[] src = Files.readAllBytes(Paths.get(reel));\n    String name = Paths.get(reel).getFileName().toString();\n    Path marks = Paths.get(\"/app/urnbay/marks\");\n    Path mk = marks.resolve(name + \".m\");\n    Path flag = marks.resolve(name + \".flag\");\n    Files.createDirectories(marks);\n    Map<String,String> idx = Idx.load();\n\n    // A manifest is the authoritative segmentation of an already stored reel.\n    // Check it before rechunking: gear changes must not defeat exact-reel reuse.\n    List<String> oldKeys = readKeys(mk);\n    if (!oldKeys.isEmpty() && Arrays.equals(src, materialize(oldKeys, idx))) {\n      writeCard(name, src.length, 0, 1.0,\n          src.length / (double) oldKeys.size(), oldKeys.size());\n      Files.writeString(flag, \"1\\n\");\n      return 0;\n    }\n\n    List<byte[]> parts = Slice.cut(src, g.mask, g.min, g.max);\n    long stored = 0;\n    long reused = 0;\n    List<String> keys = new ArrayList<>();\n    Path hot = Paths.get(\"/app/urnbay/hot\");\n    Files.createDirectories(hot);\n    for (byte[] p : parts) {\n      String key = Seal.pay(p);\n      String hit = idx.containsKey(key) ? key : null;\n      if (hit != null) {\n        reused += p.length;\n        keys.add(hit);\n      } else {\n        stored += p.length;\n        String rel = \"hot/\" + key + \".blob\";\n        Files.write(hot.resolve(key + \".blob\"), p);\n        Idx.put(key, rel);\n        idx.put(key, rel);\n        keys.add(key);\n      }\n    }\n    StringBuilder mb = new StringBuilder();\n    for (String k : keys) mb.append(k).append('\\n');\n    Files.writeString(mk, mb.toString());\n    double reuse = src.length == 0 ? 1.0 : reused / (double) src.length;\n    double mean = parts.isEmpty() ? 0.0 : src.length / (double) parts.size();\n    writeCard(name, src.length, stored, reuse, mean, parts.size());\n    Files.writeString(flag, \"1\\n\");\n    return 0;\n  }\n\n  static List<String> readKeys(Path mk) throws Exception {\n    List<String> keys = new ArrayList<>();\n    if (!Files.exists(mk)) return keys;\n    for (String line : Files.readAllLines(mk)) {\n      String key = line.trim();\n      if (!key.isEmpty()) keys.add(key);\n    }\n    return keys;\n  }\n\n  static byte[] materialize(List<String> keys, Map<String,String> idx) throws Exception {\n    ByteArrayOutputStream out = new ByteArrayOutputStream();\n    for (String key : keys) {\n      String rel = idx.get(key);\n      if (rel == null) return null;\n      Path blob = Paths.get(\"/app/urnbay\").resolve(rel).normalize();\n      if (!Files.isRegularFile(blob)) return null;\n      out.write(Files.readAllBytes(blob));\n    }\n    return out.toByteArray();\n  }\n\n  static void writeCard(String name, long input, long stored, double reuse,\n                        double mean, int count) throws Exception {\n    String json = \"{\\n\"\n      + \"  \\\"reel\\\": \\\"\" + name.replace(\"\\\\\", \"\\\\\\\\\").replace(\"\\\"\", \"\\\\\\\"\") + \"\\\",\\n\"\n      + \"  \\\"bytes_in\\\": \\\"\" + input + \"\\\",\\n\"\n      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\n      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\n      + \"  \\\"mean_piece\\\": \\\"\" + String.format(Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\n      + \"  \\\"piece_count\\\": \\\"\" + count + \"\\\"\\n\"\n      + \"}\\n\";\n    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\n    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\n  }\n}\nEOF\n"]
