[90.14037, "o", "        Idx.put(key, rel);\r\n\u001b[?2004l\r"]
[90.140417, "o", "\u001b[?2004h> "]
[90.140469, "o", "        idx.put(key, rel);\r\n\u001b[?2004l\r"]
[90.140518, "o", "\u001b[?2004h> "]
[90.140566, "o", "        keys.add(key);\r\n\u001b[?2004l\r"]
[90.140612, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[90.140656, "o", "\u001b[?2004h>     }\r\n"]
[90.140698, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[90.140803, "o", "    StringBuilder mb = new StringBuilder();\r\n\u001b[?2004l\r"]
[90.140849, "o", "\u001b[?2004h> "]
[90.140954, "o", "    for (String k : keys) mb.append(k).append('\\n');\r\n\u001b[?2004l\r"]
[90.141, "o", "\u001b[?2004h> "]
[90.141085, "o", "    Files.writeString(mk, mb.toString());\r\n\u001b[?2004l\r"]
[90.141131, "o", "\u001b[?2004h> "]
[90.141276, "o", "    double reuse = src.length == 0 ? 1.0 : reused / (double) src.length;\r\n\u001b[?2004l\r"]
[90.141335, "o", "\u001b[?2004h> "]
[90.141495, "o", "    double mean = parts.isEmpty() ? 0.0 : src.length / (double) parts.size();\r\n\u001b[?2004l\r"]
[90.141543, "o", "\u001b[?2004h> "]
[90.141721, "o", "    writeCard(name, src.length, stored, reuse, mean, parts.size());\r\n\u001b[?2004l\r"]
[90.141815, "o", "\u001b[?2004h> "]
[90.141879, "o", "    Files.writeString(flag, \"1\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.14194, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.142011, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[90.14209, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[90.142223, "o", "  static List<String> readKeys(Path mk) throws Exception {\r\n\u001b[?2004l\r"]
[90.142269, "o", "\u001b[?2004h> "]
[90.142389, "o", "    List<String> keys = new ArrayList<>();\r\n\u001b[?2004l\r"]
[90.14243, "o", "\u001b[?2004h> "]
[90.142537, "o", "    if (!Files.exists(mk)) return keys;\r\n\u001b[?2004l\r"]
[90.142571, "o", "\u001b[?2004h> "]
[90.142706, "o", "    for (String line : Files.readAllLines(mk)) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.142758, "o", "> "]
[90.142812, "o", "      String key = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.142908, "o", "      if (!key.isEmpty()) keys.add(key);\r\n\u001b[?2004l\r"]
[90.142949, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[90.142991, "o", "\u001b[?2004h> "]
[90.143037, "o", "    return keys;\r\n\u001b[?2004l\r"]
[90.14308, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[90.143144, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.143368, "o", "  static byte[] materialize(List<String> keys, Map<String,String> idx) throws Exception {\r\n\u001b[?2004l\r"]
[90.143416, "o", "\u001b[?2004h> "]
[90.143519, "o", "    ByteArrayOutputStream out = new ByteArrayOutputStream();\r\n\u001b[?2004l\r"]
[90.143587, "o", "\u001b[?2004h> "]
[90.143645, "o", "    for (String key : keys) {\r\n\u001b[?2004l\r"]
[90.143759, "o", "\u001b[?2004h> "]
[90.143833, "o", "      String rel = idx.get(key);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.143903, "o", "      if (rel == null) return null;\r\n\u001b[?2004l\r"]
[90.143957, "o", "\u001b[?2004h> "]
[90.14406, "o", "      Path blob = Paths.get(\"/app/urnbay\").resolve(rel).normalize();\r\n\u001b[?2004l\r"]
[90.144117, "o", "\u001b[?2004h> "]
[90.144212, "o", "      if (!Files.isRegularFile(blob)) return null;\r\n\u001b[?2004l\r"]
[90.144305, "o", "\u001b[?2004h> "]
[90.14438, "o", "      out.write(Files.readAllBytes(blob));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.144445, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.144516, "o", "    return out.toByteArray();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.144565, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.144625, "o", "\u001b[?2004h> "]
[90.144761, "o", "  static void writeCard(String name, long input, long stored, double reuse,\r\n\u001b[?2004l\r"]
[90.144854, "o", "\u001b[?2004h> "]
[90.144941, "o", "                        double mean, int count) throws Exception {\r\n\u001b[?2004l\r"]
[90.144995, "o", "\u001b[?2004h> "]
[90.145056, "o", "    String json = \"{\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.145302, "o", "      + \"  \\\"reel\\\": \\\"\" + name.replace(\"\\\\\", \"\\\\\\\\\").replace(\"\\\"\", \"\\\\\\\"\") + \"\\\",\\n\"\r\n\u001b[?2004l\r"]
[90.145391, "o", "\u001b[?2004h> "]
[90.145547, "o", "      + \"  \\\"bytes_in\\\": \\\"\" + input + \"\\\",\\n\"\r\n\u001b[?2004l\r"]
[90.145638, "o", "\u001b[?2004h> "]
[90.145721, "o", "      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\r\n\u001b[?2004l\r"]
[90.145788, "o", "\u001b[?2004h> "]
[90.145996, "o", "      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\r\n\u001b[?2004l\r"]
[90.146064, "o", "\u001b[?2004h> "]
[90.146305, "o", "      + \"  \\\"mean_piece\\\": \\\"\" + String.format(Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\r\n\u001b[?2004l\r"]
[90.146403, "o", "\u001b[?2004h> "]
[90.146502, "o", "      + \"  \\\"piece_count\\\": \\\"\" + count + \"\\\"\\n\"\r\n\u001b[?2004l\r"]
[90.146622, "o", "\u001b[?2004h> "]
[90.146669, "o", "      + \"}\\n\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.146786, "o", "    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\r\n\u001b[?2004l\r"]
[90.146828, "o", "\u001b[?2004h> "]
[90.146967, "o", "    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\r\n\u001b[?2004l\r"]
[90.147029, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[90.14709, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.14714, "o", "EOF\r\n\u001b[?2004l\r"]
[90.148374, "o", "\u001b[?2004hroot@8c694c451f36:/app# "]
[90.315903, "i", "cat > /app/coldrib/DuskGen.java <<'EOF'\nimport java.io.*;\npublic class DuskGen {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")));\n    loom(w);\n    w.close();\n  }\n  public static void loom(PrintWriter a) throws Exception {\n    a.println(\"import java.nio.file.*;\");\n    a.println(\"import java.util.*;\");\n    a.println(\"public class Span {\");\n    a.println(\"  public static void merge() throws Exception {\");\n    a.println(\"    LinkedHashMap<String,String> all = new LinkedHashMap<>();\");\n    a.println(\"    String[] files = {\\\"/app/urnbay/idx.tsv\\\", \\\"/app/urnbay/keep/idx.tsv\\\", \\\"/app/urnbay/hot/idx.tsv\\\", \\\"/app/urnbay/cold/idx.tsv\\\"};\");\n    a.println(\"    for (String file : files) {\");\n    a.println(\"      Path p = Paths.get(file);\");\n    a.println(\"      if (!Files.exists(p)) continue;\");\n    a.println(\"      for (String line : Files.readAllLines(p)) {\");\n    a.println(\"        String[] fields = line.trim().split(\\\"\\\\\\\\t\\\");\");\n    a.println(\"        if (fields.length >= 2 && !fields[0].isEmpty()) all.putIfAbsent(fields[0], fields[1]);\");\n    a.println(\"      }\");\n    a.println(\"    }\");\n    a.println(\"    StringBuilder out = new StringBuilder();\");\n    a.println(\"    for (Map.Entry<String,String> e : all.entrySet()) out.append(e.getKey()).append('\\\\t').append(e.getValue()).append('\\\\n');\");\n    a.println(\"    Files.writeString(Paths.get(\\\"/app/urnbay/idx.tsv\\\"), out.toString(), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);\");\n    a.println(\"    System.out.println(\\\"walked\\\");\");\n    a.println(\"  }\");\n    a.println(\"}\");\n  }\n}\nEOF\n/app/kiln.sh\n"]
[90.31639, "o", "cat > /app/coldrib/DuskGen.java <<'EOF'\r\n\u001b[?2004l\r"]
