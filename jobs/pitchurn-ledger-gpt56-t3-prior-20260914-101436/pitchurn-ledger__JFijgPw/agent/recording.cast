[30.89179, "o", "     1\timport java.nio.file.*;\r\n     2\timport java.util.*;\r\n     3\tpublic class Gear {\r\n     4\t  public int mask, min, max, fp;\r\n     5\t  public static Gear load(String p) throws Exception {\r\n     6\t    Gear g = new Gear();\r\n     7\t    for (String ln : Files.readAllLines(Paths.get(p))) {\r\n     8\t      String t = ln.trim();\r\n     9\t      if (t.startsWith(\"mask=\")) g.mask = Integer.parseInt(t.substring(5));\r\n    10\t      if (t.startsWith(\"min=\")) g.min = Integer.parseInt(t.substring(4));\r\n    11\t      if (t.startsWith(\"max=\")) g.max = Integer.parseInt(t.substring(4));\r\n    12\t      if (t.startsWith(\"fp=\")) g.fp = Integer.parseInt(t.substring(3));\r\n    13\t    }\r\n    14\t    return g;\r\n    15\t  }\r\n    16\t}\r\n"]
