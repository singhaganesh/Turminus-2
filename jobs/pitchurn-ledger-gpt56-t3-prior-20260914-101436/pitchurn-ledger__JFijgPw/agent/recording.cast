[126.045768, "i", "python3 - <<'PY'\n# Deterministic input absent from the supplied silo.\nimport random\nr=random.Random(8675309)\nopen('/app/urnbay/fresh.bin','wb').write(r.randbytes(131072))\nPY\nrm -f /app/urnbay/marks/fresh.bin.flag /app/urnbay/marks/fresh.bin.m\n/app/bin/pitchurn stow /app/urnbay/fresh.bin; echo first_exit=$?; cat /app/urnbay/tally.json\npython3 - <<'PY'\nimport json\nj=json.load(open('/app/urnbay/tally.json'))\nassert j['reel']=='fresh.bin'\nassert float(j['mean_piece']) <= 2048, j\nassert int(j['piece_count']) > 0\nassert all(isinstance(v,str) for v in j.values())\nPY\n/app/bin/pitchurn draw /app/urnbay/fresh.out /app/urnbay/fresh.bin && cmp /app/urnbay/fresh.bin /app/urnbay/fresh.out\n/app/bin/pitchurn stow /app/urnbay/fresh.bin; echo second_exit=$?; cat /app/urnbay/tally.json\npython3 - <<'PY'\nimport json\nj=json.load(open('/app/urnbay/tally.json'))\nassert float(j['reuse_frac']) >= .80 and int(j['bytes_stored']) == 0, j\nPY\necho FRESH_OK\n"]
