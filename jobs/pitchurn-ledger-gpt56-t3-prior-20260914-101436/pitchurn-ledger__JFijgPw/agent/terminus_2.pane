     1	import java.nio.file.*;
     2	import java.util.*;
     3	public class Gear {
     4	  public int mask, min, max, fp;
     5	  public static Gear load(String p) throws Exception {
     6	    Gear g = new Gear();
     7	    for (String ln : Files.readAllLines(Paths.get(p))) {
     8	      String t = ln.trim();
     9	      if (t.startsWith("mask=")) g.mask = Integer.parseInt(t.substring(5));
    10	      if (t.startsWith("min=")) g.min = Integer.parseInt(t.substring(4));
    11	      if (t.startsWith("max=")) g.max = Integer.parseInt(t.substring(4));
    12	      if (t.startsWith("fp=")) g.fp = Integer.parseInt(t.substring(3));
    13	    }
    14	    return g;
    15	  }
    16	}
===== /app/hitchcli/Idx.java =====
     1	import java.nio.file.*;
     2	import java.util.*;
     3	public class Idx {
     4	  public static Map<String,String> load() throws Exception {
     5	    Map<String,String> m = new LinkedHashMap<>();
     6	    add(m, "/app/urnbay/idx.tsv");
     7	    add(m, "/app/urnbay/keep/idx.tsv");
     8	    add(m, "/app/urnbay/hot/idx.tsv");
     9	    return m;
    10	  }
    11	  static void add(Map<String,String> m, String p) throws Exception {
    12	    Path f = Paths.get(p);
    13	    if (!Files.exists(f)) return;
    14	    for (String ln : Files.readAllLines(f)) {
    15	      String t = ln.trim();
    16	      if (t.isEmpty()) continue;
    17	      String[] sp = t.split("\t");
    18	      if (sp.length >= 2) m.put(sp[0], sp[1]);
    19	    }
    20	  }
    21	  public static void put(String k, String rel) throws Exception {
    22	    Path f = Paths.get("/app/urnbay/idx.tsv");
    23	    Files.writeString(f, k + "\t" + rel + "\n", java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);
    24	  }
    25	  public static byte[] blob(String rel) throws Exception {
    26	    return Files.readAllBytes(Paths.get("/app/urnbay/" + rel));
    27	  }
    28	}
===== /app/hitchcli/StowRun.java =====
     1	import java.nio.file.*;
     2	import java.util.*;
     3	public class StowRun {
     4	  public static int run(String reel) throws Exception {
     5	    Gear g = Gear.load("/app/gearpit/live.gear");
     6	    byte[] src = Files.readAllBytes(Paths.get(reel));
     7	    List<byte[]> parts = Slice.cut(src, g.mask, g.min, g.max);
     8	    Map<String,String> idx = Idx.load();
     9	    long stored = 0;
    10	    long reused = 0;
    11	    List<String> keys = new ArrayList<>();
    12	    Path hot = Paths.get("/app/urnbay/hot");
    13	    Files.createDirectories(hot);
    14	    for (byte[] p : parts) {
    15	      String kb = Seal.hex(p, g.fp);
    16	      String kp = Seal.pay(p);
    17	      String hit = null;
    18	      if (idx.containsKey(kb)) hit = kb;
    19	      else if (idx.containsKey(kp)) hit = kp;
    20	      if (hit != null) {
    21	        reused += p.length;
    22	        keys.add(hit);
    23	      } else {
    24	        stored += p.length;
    25	        String rel = "hot/" + kb + ".blob";
    26	        Files.write(hot.resolve(kb + ".blob"), p);
    27	        Idx.put(kb, rel);
    28	        idx.put(kb, rel);
    29	        keys.add(kb);
    30	      }
    31	    }
    32	    String name = Paths.get(reel).getFileName().toString();
    33	    Path flag = Paths.get("/app/urnbay/marks/" + name + ".flag");
    34	    boolean prior = Files.exists(flag);
    35	    Path mk = Paths.get("/app/urnbay/marks/" + name + ".m");
    36	    StringBuilder mb = new StringBuilder();
    37	    for (String k : keys) mb.append(k).append("\n");
    38	    Files.createDirectories(mk.getParent());
    39	    Files.writeString(mk, mb.toString());
    40	    double reuse = src.length == 0 ? 1.0 : (reused / (double) src.length);
    41	    double mean = parts.isEmpty() ? 0 : (src.length / (double) parts.size());
    42	    String json = "{\n"
    43	      + "  \"reel\": \"" + name + "\",\n"
    44	      + "  \"bytes_in\": \"" + src.length + "\",\n"
    45	      + "  \"bytes_stored\": \"" + stored + "\",\n"
    46	      + "  \"reuse_frac\": \"" + String.format(java.util.Locale.US, "%.4f", reuse) + "\",\n"
    47	      + "  \"mean_piece\": \"" + String.format(java.util.Locale.US, "%.4f", mean) + "\",\n"
    48	      + "  \"piece_count\": \"" + parts.size() + "\"\n"
    49	      + "}\n";
    50	    Files.writeString(Paths.get("/app/urnbay/tally.json"), json);
    51	    Files.writeString(Paths.get("/app/urnbay/last.json"), json);
    52	    Floor.ok(reuse);
    53	    if (prior && stored == src.length && src.length > 0) {
    54	      return 1;
    55	    }
    56	    Files.writeString(flag, "1\n");
    57	    return 0;
    58	  }
    59	}
