[18.58855, "i", "printf '%s\\n' '--- COVER ---'; cat /app/keepfold/COVER.txt; printf '%s\\n' '--- LAYOUT ---'; cat /app/ribcards/LAYOUT.txt; for f in /app/{weltcli,octetkiln,stitchbay,peekurn,vaultbin,nudgepit}/*.rs /app/wick.sh; do echo \"--- $f ---\"; nl -ba \"$f\"; done\n"]
[18.589376, "o", "printf '%s\\n' '--- COVER ---'; cat /app/keepfold/COVER.txt; printf '%s\\n' '--- LAYOUT ---'; cat /app/ribcards/LAYOUT.txt; for f in /app/{weltcli,octetkiln,stitchbay,peekurn,vaultbin,nudgepit}/*.rs /app/wick.sh; do echo \"--- $f ---\"; nl -ba \"$f\"; done"]
[18.58953, "o", "\r\n"]
[18.589981, "o", "\u001b[?2004l\r--- COVER ---\r\n"]
[18.591182, "o", "Desk cover\r\n==========\r\n\r\nCoverage is the number of lines in /app/ribcards/LAYOUT.txt.\r\n\r\nIf a row's width is greater than eight, some desks add one octet\r\nto that row's start before baking pull.rs.\r\n"]
[18.595664, "o", "--- LAYOUT ---\r\nkind 0 3\r\nlane 3 5\r\nmode 8 4\r\nwelt 12 9\r\ntail 21 3\r\nmark 24 8\r\n--- /app/weltcli/boot.rs ---\r\n"]
[18.596544, "o", "     1\t#[path = \"../octetkiln/take.rs\"]\r\n     2\tmod take;\r\n     3\t#[path = \"../vaultbin/pull.rs\"]\r\n     4\tmod pull;\r\n"]
[18.596857, "o", "     5\t#[path = \"../peekurn/ink.rs\"]\r\n     6\tmod vat;\r\n     7\t#[path = \"../nudgepit/tally.rs\"]\r\n     8\tmod tally;\r\n     9\t\r\n    10\tfn main() {\r\n    11\t    let mut args = std::env::args().skip(1);\r\n    12\t    let cmd = args.next().unwrap_or_default();\r\n    13\t    let code = match cmd.as_str() {\r\n    14\t        \"pour\" => vat::rib_c(),\r\n    15\t        _ => {\r\n    16\t            eprintln!(\"usage: weltquay pour\");\r\n    17\t            2\r\n    18\t        }\r\n    19\t    };\r\n    20\t    std::process::exit(code);\r\n    21\t}\r\n"]
[18.597301, "o", "--- /app/octetkiln/emit.rs ---\r\n"]
[18.598473, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\t#[path = \"../stitchbay/card.rs\"]\r\n     4\tmod card;\r\n     5\t\r\n     6\tfn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {\r\n     7\t    for row in rows {\r\n     8\t        if row.tag == tag {\r\n     9\t            return (row.pos, row.n);\r\n    10\t        }\r\n    11\t    }\r\n    12\t    (0, 0)\r\n    13\t}\r\n"]
[18.598548, "o", "    14\t\r\n    15\tfn main() {\r\n    16\t    let rows = card::rib_b();\r\n    17\t    let (k0, k1) = pick(&rows, \"kind\");\r\n    18\t    let (l0, l1) = pick(&rows, \"lane\");\r\n    19\t    let (m0, m1) = pick(&rows, \"mode\");\r\n    20\t    let (w0, w1) = pick(&rows, \"welt\");\r\n    21\t    let (t0, t1) = pick(&rows, \"tail\");\r\n    22\t    let (x0, x1) = pick(&rows, \"mark\");\r\n    23\t    let body = format!(\r\n    24\t        r#\"use crate::take;\r\n    25\t\r\n    26\tpub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\r\n    27\t    (\r\n    28\t        take::rib_a(buf, {k0}, {k1}),\r\n    29\t        take::rib_a(buf, {l0}, {l1}),\r\n    30\t        take::rib_a(buf, {m0}, {m1}),\r\n    31\t        take::rib_a(buf, {w0}, {w1}),\r\n    32\t        take::rib_a(buf, {t0}, {t1}),\r\n    33\t        take::rib_a(buf, {x0}, {x1}),\r\n    34\t    )\r\n    35\t}}\r\n    36\t\"#\r\n    37\t    );\r\n    38\t    let _ = fs::create_dir_all(\"/app/vaultbin\");\r\n    39\t    fs::write(\"/app/vaultbin/pull.rs\", body).expect(\"emit\");\r\n    40\t}\r\n"]
[18.599625, "o", "--- /app/octetkiln/take.rs ---\r\n"]
[18.600801, "o", "     1\tpub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n     2\t    if n == 0 {\r\n     3\t        return 0;\r\n     4\t    }\r\n     5\t    let i = (pos / 8) as usize;\r\n     6\t    if i >= buf.len() {\r\n"]
[18.600963, "o", "     7\t        return 0;\r\n     8\t    }\r\n     9\t    let bit = pos % 8;\r\n    10\t    let room = 8 - bit;\r\n    11\t    let w = if n > room { room } else { n };\r\n    12\t    let shift = 8 - bit - w;\r\n    13\t    ((buf[i] as u32) >> shift) & ((1u32 << w) - 1)\r\n    14\t}\r\n"]
[18.601148, "o", "--- /app/stitchbay/card.rs ---\r\n"]
[18.602331, "o", "     1\tpub struct Row {\r\n     2\t    pub tag: String,\r\n     3\t    pub pos: u32,\r\n     4\t    pub n: u32,\r\n     5\t}\r\n     6\t\r\n"]
[18.602643, "o", "     7\tfn tok(line: &str) -> Vec<String> {\r\n     8\t    line.split_whitespace().map(|s| s.to_string()).collect()\r\n     9\t}\r\n    10\t\r\n    11\tpub fn rib_b() -> Vec<Row> {\r\n    12\t    let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\").unwrap_or_default();\r\n    13\t    let mut out = Vec::new();\r\n    14\t    for line in text.lines() {\r\n    15\t        let raw = line.trim();\r\n    16\t        if raw.is_empty() || raw.starts_with('#') {\r\n    17\t            continue;\r\n    18\t        }\r\n    19\t        let parts = tok(raw);\r\n    20\t        if parts.len() < 3 {\r\n    21\t            continue;\r\n    22\t        }\r\n    23\t        let tag = parts[0].clone();\r\n    24\t        let mut pos: u32 = match parts[1].parse() {\r\n    25\t            Ok(v) => v,\r\n    26\t            Err(_) => continue,\r\n    27\t        };\r\n    28\t        let n: u32 = match parts[2].parse() {\r\n    29\t            Ok(v) => v,\r\n    30\t            Err(_) => continue,\r\n    31\t        };\r\n    32\t        if n > 8 {\r\n    33\t            pos = pos.saturating_add(8 - (pos % 8));\r\n    34\t        }\r\n    35\t        out.push(Row { tag, pos, n });\r\n    36\t    }\r\n    37\t    out\r\n    38\t}\r\n"]
[18.602914, "o", "--- /app/peekurn/ink.rs ---\r\n"]
[18.604043, "o", "     1\tuse crate::pull;\r\n     2\tuse crate::tally;\r\n     3\tuse std::fs;\r\n     4\tuse std::path::Path;\r\n     5\t\r\n     6\tpub fn rib_c() -> i32 {\r\n     7\t    let _ = tally::lines();\r\n     8\t    let buf = fs::read(\"/app/quaybag/night.bin\").unwrap_or_default();\r\n     9\t    let dest = Path::new(\"/app/blotbay/rows.json\");\r\n    10\t    if let Some(parent) = dest.parent() {\r\n    11\t        let _ = fs::create_dir_all(parent);\r\n    12\t    }\r\n    13\t    let (a, b, c, d, e, f) = pull::dump(&buf);\r\n    14\t    let body = format!(\r\n    15\t        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\r\n    16\t        a, b, c, d, e, f\r\n    17\t    );\r\n"]
[18.604209, "o", "    18\t    let _ = fs::write(dest, body);\r\n    19\t    0\r\n    20\t}\r\n"]
[18.604326, "o", "--- /app/vaultbin/pull.rs ---\r\n"]
[18.605215, "o", "     1\tuse crate::take;\r\n     2\t\r\n     3\tpub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n     4\t    (\r\n     5\t        take::rib_a(buf, 0, 3),\r\n     6\t        take::rib_a(buf, 3, 5),\r\n     7\t        take::rib_a(buf, 8, 4),\r\n     8\t        take::rib_a(buf, 16, 9),\r\n     9\t        take::rib_a(buf, 21, 3),\r\n"]
[18.605324, "o", "    10\t        take::rib_a(buf, 24, 8),\r\n    11\t    )\r\n    12\t}\r\n"]
[18.605466, "o", "--- /app/nudgepit/tally.rs ---\r\n"]
[18.606311, "o", "     1\tpub fn lines() -> usize {\r\n     2\t    std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\r\n     3\t        .unwrap_or_default()\r\n     4\t        .lines()\r\n     5\t        .filter(|line| !line.trim().is_empty())\r\n     6\t        .count()\r\n     7\t}\r\n"]
[18.60682, "o", "--- /app/wick.sh ---\r\n"]
[18.611489, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/blotbay /app/vaultbin\r\n     5\trustc --edition 2021 -O /app/octetkiln/emit.rs -o /tmp/welt-emit\r\n     6\t/tmp/welt-emit\r\n     7\trustc --edition 2021 -O /app/weltcli/boot.rs -o /app/bin/weltquay\r\n\u001b[?2004hroot@17f7f5f53823:/app# "]
[19.59718, "i", "printf '%s\\n' '--- night bytes ---'; od -An -tx1 -v /app/quaybag/night.bin; printf '%s\\n' '--- ELF header bytes ---'; od -An -tx1 -N16 /app/bin/weltquay; printf '%s\\n' '--- run baseline ---'; /app/bin/weltquay pour; rc=$?; echo \"exit=$rc\"; cat /app/blotbay/rows.json\n"]
[19.598128, "o", "printf '%s\\n' '--- night bytes ---'; od -An -tx1 -v /app/quaybag/night.bin; printf '%s\\n' '--- ELF header bytes ---'; od -An -tx1 -N16 /app/bin/weltquay; printf '%s\\n' '--- run baseline ---'; /app/bin/weltquay pour; rc=$?; echo \"exit=$rc\"; cat /app/blotbay/rows.json\r\n\u001b[?2004l\r"]
[19.598593, "o", "--- night bytes ---\r\n"]
[19.601742, "o", " b1 9d 3e a5\r\n--- ELF header bytes ---\r\n"]
[19.60348, "o", " 7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\r\n"]
[19.607372, "o", "--- run baseline ---\r\n"]
[19.613544, "o", "exit=0\r\n"]
[19.615424, "o", "{\"kind\":5,\"lane\":17,\"mode\":9,\"welt\":62,\"tail\":6,\"mark\":165}\r\n"]
[19.6177, "o", "\u001b[?2004hroot@17f7f5f53823:/app# "]
[56.283672, "i", "cat > /app/octetkiln/take.rs <<'EOF'\npub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\n    if n == 0 || n > 32 {\n        return 0;\n    }\n    let end = match pos.checked_add(n) {\n        Some(v) => v,\n        None => return 0,\n    };\n    if (end as usize) > buf.len().saturating_mul(8) {\n        return 0;\n    }\n\n    let mut value = 0u32;\n    for p in pos..end {\n        let octet = buf[(p / 8) as usize];\n        let bit = (octet >> (7 - (p % 8))) & 1;\n        value = (value << 1) | bit as u32;\n    }\n    value\n}\nEOF\ncat > /app/stitchbay/card.rs <<'EOF'\npub struct Row {\n    pub tag: String,\n    pub pos: u32,\n    pub n: u32,\n}\n\npub fn rib_b() -> Vec<Row> {\n    let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\n        .expect(\"read layout\");\n    let mut out = Vec::new();\n    for line in text.lines() {\n        let raw = line.trim();\n        if raw.is_empty() || raw.starts_with('#') {\n            continue;\n        }\n        let mut parts = raw.split_whitespace();\n        let tag = parts.next().expect(\"layout tag\").to_string();\n        let pos = parts.next().expect(\"layout position\").parse::<u32>()\n            .expect(\"numeric layout position\");\n        let n = parts.next().expect(\"layout width\").parse::<u32>()\n            .expect(\"numeric layout width\");\n        assert!(n > 0 && n <= 32, \"layout width must be 1..=32\");\n        assert!(pos.checked_add(n).is_some(), \"layout row overflow\");\n        out.push(Row { tag, pos, n });\n    }\n    out\n}\nEOF\ncat > /app/octetkiln/emit.rs <<'EOF'\nuse std::fs;\n\n#[path = \"../stitchbay/card.rs\"]\nmod card;\n\nfn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {\n    let mut found = rows.iter().filter(|row| row.tag == tag);\n    let row = found.next().unwrap_or_else(|| panic!(\"missing layout row: {}\", tag));\n    assert!(found.next().is_none(), \"duplicate layout row: {}\", tag);\n    (row.pos, row.n)\n}\n\nfn main() {\n    let rows = card::rib_b();\n    let (k0, k1) = pick(&rows, \"kind\");\n    let (l0, l1) = pick(&rows, \"lane\");\n    let (m0, m1) = pick(&rows, \"mode\");\n    let (w0, w1) = pick(&rows, \"welt\");\n    let (t0, t1) = pick(&rows, \"tail\");\n    let (x0, x1) = pick(&rows, \"mark\");\n    let width = rows.iter().map(|r| r.pos + r.n).max().unwrap_or(0);\n    let body = format!(\n        r#\"use crate::take;\n\npub const WIDTH_BITS: usize = {width};\n\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\n    (\n        take::rib_a(buf, {k0}, {k1}),\n        take::rib_a(buf, {l0}, {l1}),\n        take::rib_a(buf, {m0}, {m1}),\n        take::rib_a(buf, {w0}, {w1}),\n        take::rib_a(buf, {t0}, {t1}),\n        take::rib_a(buf, {x0}, {x1}),\n    )\n}}\n\"#\n    );\n    fs::create_dir_all(\"/app/vaultbin\").expect(\"create vaultbin\");\n    fs::write(\"/app/vaultbin/pull.rs\", body).expect(\"emit pull\");\n}\nEOF\n"]
[56.284081, "o", "cat > /app/octetkiln/take.rs <<'EOF'\r\n\u001b[?2004l\r"]
