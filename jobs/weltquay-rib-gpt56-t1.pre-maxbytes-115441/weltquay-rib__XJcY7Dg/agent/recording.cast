[10.697423, "o", "printf '%s\\n' '--- executable ---'; file /app/bin/weltquay; xxd -l 32 /app/bin/weltquay; printf '%s\\n' '--- current rows ---'; if [ -e /app/blotbay/rows.json ]; then cat /app/blotbay/rows.json; else echo absent; fi; printf '%s\\n' '--- capture head ---'; xxd -l 256 /app/quaybag/night.bin\r\n\u001b[?2004l\r--- executable ---\r\nbash: file: command not found\r\n"]
