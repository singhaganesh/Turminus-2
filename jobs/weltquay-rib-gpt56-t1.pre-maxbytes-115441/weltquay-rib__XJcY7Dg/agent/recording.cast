[9.697258, "o", "/app\r\n"]
[9.698067, "o", "--- TREE ---\r\n"]
[9.698862, "o", "weltquay mill\r\n===============\r\n\r\nweltcli/boot.rs dispatches pour.\r\n\r\nPipeline modules:\r\n- octetkiln/  kiln take and emit\r\n- stitchbay/  layout row load used by emit\r\n- peekurn/    pour writer\r\n- vaultbin/   baked pull used by pour\r\n- nudgepit/   line tally\r\n\r\nLayout rows live in /app/ribcards/LAYOUT.txt.\r\nEach row is a name, a bit index, and a width.\r\nOctets are packed from the high bit of the first octet.\r\npour reads /app/quaybag/night.bin and writes /app/blotbay/rows.json.\r\n\r\nRebuild the binary with /app/wick.sh after source edits.\r\n"]
[9.69915, "o", "--- files ---\r\n"]
[9.703901, "o", "/app/bin/weltquay 3984912 bytes\r\n/app/blotbay/rows.json 60 bytes\r\n/app/keepfold/COVER.txt 193 bytes\r\n/app/keepfold/TREE.txt 524 bytes\r\n/app/nudgepit/tally.rs 195 bytes\r\n/app/octetkiln/emit.rs 991 bytes\r\n/app/octetkiln/take.rs 346 bytes\r\n/app/peekurn/ink.rs 571 bytes\r\n/app/quaybag/night.bin 4 bytes\r\n/app/ribcards/LAYOUT.txt 57 bytes\r\n/app/stitchbay/card.rs 964 bytes\r\n/app/vaultbin/pull.rs 287 bytes\r\n/app/weltcli/boot.rs 466 bytes\r\n/app/weltcli/usage.txt 77 bytes\r\n/app/wick.sh 283 bytes\r\n"]
[9.70419, "o", "\u001b[?2004hroot@17f7f5f53823:/app# "]
