[61.505709, "i", "echo '--- generated pull ---'; cat /app/vaultbin/pull.rs; echo '--- ELF ---'; od -An -tx1 -N4 /app/bin/weltquay; echo '--- valid capture ---'; /app/bin/weltquay pour; rc=$?; echo \"exit=$rc\"; cat /app/blotbay/rows.json; echo '--- short capture ---'; cp /app/quaybag/night.bin /tmp/night.bin.saved; head -c 3 /tmp/night.bin.saved > /app/quaybag/night.bin; /app/bin/weltquay pour; rc=$?; echo \"exit=$rc\"; if [ -e /app/blotbay/rows.json ]; then echo 'rows remains: true'; else echo 'rows remains: false'; fi; mv /tmp/night.bin.saved /app/quaybag/night.bin\n"]
[61.507351, "o", "echo '--- generated pull ---'; cat /app/vaultbin/pull.rs; echo '--- ELF ---'; od -An -tx1 -N4 /app/bin/weltquay; echo '--- valid capture ---'; /app/bin/weltquay pour; rc=$?; echo \"exit=$rc\"; cat /app/blotbay/rows.json; echo '--- short capture ---'; cp /app/quaybag/night.bin /tmp/night.bin.saved; head -c 3 /tmp/night.bin.saved > /app/quaybag/night.bin; /app/bin/weltquay pour; rc=$?; echo \"exit=$rc\"; if [ -e /app/blotbay/rows.json ]; then echo 'rows remains: true'; else echo 'rows remains: false'; fi; mv /tmp/night.bin.saved /app/quaybag/night.bin\r\n\u001b[?2004l\r"]
[61.507843, "o", "--- generated pull ---\r\n"]
[61.508655, "o", "use crate::take;\r\n\r\npub const WIDTH_BITS: usize = 32;\r\n\r\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n    (\r\n        take::rib_a(buf, 0, 3),\r\n        take::rib_a(buf, 3, 5),\r\n        take::rib_a(buf, 8, 4),\r\n        take::rib_a(buf, 12, 9),\r\n        take::rib_a(buf, 21, 3),\r\n        take::rib_a(buf, 24, 8),\r\n    )\r\n}\r\n"]
[61.508889, "o", "--- ELF ---\r\n"]
[61.510022, "o", " 7f 45 4c 46\r\n"]
[61.510189, "o", "--- valid capture ---\r\n"]
[61.511578, "o", "exit=0\r\n"]
[61.512363, "o", "{\"kind\":5,\"lane\":17,\"mode\":9,\"welt\":423,\"tail\":6,\"mark\":165}\r\n"]
[61.512561, "o", "--- short capture ---\r\n"]
[61.522856, "o", "capture is shorter than layout width\r\n"]
[61.523047, "o", "exit=1\r\nrows remains: false\r\n"]
[61.526252, "o", "\u001b[?2004hroot@17f7f5f53823:/app# "]
[73.07203, "i", "/app/bin/weltquay pour; rc=$?; python3 - <<'PY'\nimport json\nfrom pathlib import Path\np = Path('/app/blotbay/rows.json')\ndata = json.loads(p.read_text())\nexpected = {'kind': 5, 'lane': 17, 'mode': 9, 'welt': 423, 'tail': 6, 'mark': 165}\nassert data == expected, (data, expected)\nassert all(type(v) is int for v in data.values())\nassert Path('/app/quaybag/night.bin').stat().st_size == 4\nassert Path('/app/bin/weltquay').read_bytes()[:4] == b'\\x7fELF'\nprint(data)\nPY\nprintf 'pour_exit=%s\\n' \"$rc\"\n"]
