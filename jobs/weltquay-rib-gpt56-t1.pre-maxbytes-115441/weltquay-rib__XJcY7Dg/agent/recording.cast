[56.289588, "o", "\u001b[?2004h>         .expect(\"read layout\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.289612, "o", "> "]
[56.289686, "o", "    let mut out = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.289736, "o", "> "]
[56.289823, "o", "    for line in text.lines() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.289897, "o", "        let raw = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.289911, "o", "> "]
[56.290145, "o", "        if raw.is_empty() || raw.starts_with('#') {\r\n\u001b[?2004l\r"]
[56.290172, "o", "\u001b[?2004h>             continue;\r\n\u001b[?2004l\r"]
[56.2903, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.290324, "o", "        let mut parts = raw.split_whitespace();"]
[56.290511, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.290632, "o", "> "]
[56.29096, "o", "        let tag = parts.next().expect(\"layout tag\").to_string();\r\n\u001b[?2004l\r"]
[56.291031, "o", "\u001b[?2004h> "]
[56.291162, "o", "        let pos = parts.next().expect(\"layout position\").parse::<u32>()\r\n\u001b[?2004l\r"]
[56.291242, "o", "\u001b[?2004h> "]
[56.291335, "o", "            .expect(\"numeric layout position\");\r\n\u001b[?2004l\r"]
[56.291417, "o", "\u001b[?2004h> "]
[56.291513, "o", "        let n = parts.next().expect(\"layout width\").parse::<u32>()\r\n\u001b[?2004l\r"]
[56.291576, "o", "\u001b[?2004h> "]
[56.291683, "o", "            .expect(\"numeric layout width\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.291836, "o", "        assert!(n > 0 && n <= 32, \"layout width must be 1..=32\");\r\n\u001b[?2004l\r"]
[56.291899, "o", "\u001b[?2004h> "]
[56.29204, "o", "        assert!(pos.checked_add(n).is_some(), \"layout row overflow\");\r\n\u001b[?2004l\r"]
[56.292109, "o", "\u001b[?2004h> "]
[56.292214, "o", "        out.push(Row { tag, pos, n });\r\n\u001b[?2004l\r"]
[56.292284, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[56.292363, "o", "\u001b[?2004h> "]
[56.292383, "o", "EOF\r\n\u001b[?2004l\r"]
[56.29392, "o", "\u001b[?2004hroot@17f7f5f53823:/app# "]
[56.294034, "o", "cat > /app/octetkiln/emit.rs <<'EOF'\r\n\u001b[?2004l\r"]
[56.294115, "o", "\u001b[?2004h> use std::fs;"]
[56.294196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.29422, "o", "\u001b[?2004h> "]
[56.294317, "o", "#[path = \"../stitchbay/card.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.294468, "o", "mod card;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[56.294489, "o", "> "]
[56.294607, "o", "fn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.294686, "o", "> "]
[56.294798, "o", "    let mut found = rows.iter().filter(|row| row.tag == tag);\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.294824, "o", "> "]
[56.295028, "o", "    let row = found.next().unwrap_or_else(|| panic!(\"missing layout row: {}\", tag));\r\n\u001b[?2004l\r"]
[56.295054, "o", "\u001b[?2004h> "]
[56.295338, "o", "    assert!(found.next().is_none(), \"duplicate layout row: {}\", tag);\r\n\u001b[?2004l\r\u001b[?2004h>     (row.pos, row.n)\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.295533, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.295686, "o", "fn main() {\r\n\u001b[?2004l\r\u001b[?2004h>     let rows = card::rib_b();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.295709, "o", "    let (k0, k1) = pick(&rows, \"kind\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.295833, "o", "    let (l0, l1) = pick(&rows, \"lane\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.29592, "o", ">     let (m0, m1) = pick(&rows, \"mode\");\r\n"]
[56.29594, "o", "\u001b[?2004l\r"]
[56.295956, "o", "\u001b[?2004h> "]
[56.296089, "o", "    let (w0, w1) = pick(&rows, \"welt\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.296165, "o", "> "]
[56.296186, "o", "    let (t0, t1) = pick(&rows, \"tail\");\r\n\u001b[?2004l\r"]
[56.296203, "o", "\u001b[?2004h> "]
[56.296338, "o", "    let (x0, x1) = pick(&rows, \"mark\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.29652, "o", "    let width = rows.iter().map(|r| r.pos + r.n).max().unwrap_or(0);\r\n\u001b[?2004l\r"]
[56.296598, "o", "\u001b[?2004h>     let body = format!(\r\n\u001b[?2004l\r"]
[56.296616, "o", "\u001b[?2004h> "]
[56.29676, "o", "        r#\"use crate::take;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.296871, "o", "pub const WIDTH_BITS: usize = {width};\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.29689, "o", "> \r\n\u001b[?2004l\r"]
[56.296984, "o", "\u001b[?2004h> "]
[56.297104, "o", "pub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\r\n\u001b[?2004l\r\u001b[?2004h>     (\r\n\u001b[?2004l\r"]
[56.297189, "o", "\u001b[?2004h> "]
[56.297315, "o", "        take::rib_a(buf, {k0}, {k1}),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.297429, "o", "        take::rib_a(buf, {l0}, {l1}),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.297517, "o", "        take::rib_a(buf, {m0}, {m1}),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.297633, "o", "        take::rib_a(buf, {w0}, {w1}),\r\n\u001b[?2004l\r"]
[56.297656, "o", "\u001b[?2004h> "]
[56.29785, "o", "        take::rib_a(buf, {t0}, {t1}),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.297878, "o", "        take::rib_a(buf, {x0}, {x1}),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.297893, "o", "    )\r\n"]
[56.297909, "o", "\u001b[?2004l\r"]
[56.29793, "o", "\u001b[?2004h> }}\r\n"]
[56.297945, "o", "\u001b[?2004l\r"]
[56.297961, "o", "\u001b[?2004h> "]
[56.298172, "o", "\"#\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.298202, "o", ">     );\r\n\u001b[?2004l\r\u001b[?2004h>     fs::create_dir_all(\"/app/vaultbin\").expect(\"create vaultbin\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.298216, "o", "> "]
[56.298375, "o", "    fs::write(\"/app/vaultbin/pull.rs\", body).expect(\"emit pull\");\r\n\u001b[?2004l\r"]
[56.298412, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[56.298776, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[56.299985, "o", "\u001b[?2004hroot@17f7f5f53823:/app# "]
[56.410814, "i", "cat > /app/nudgepit/tally.rs <<'EOF'\npub fn lines() -> usize {\n    std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\n        .map(|text| {\n            text.lines()\n                .map(str::trim)\n                .filter(|line| !line.is_empty() && !line.starts_with('#'))\n                .count()\n        })\n        .unwrap_or(0)\n}\nEOF\ncat > /app/peekurn/ink.rs <<'EOF'\nuse crate::pull;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rib_c() -> i32 {\n    let dest = Path::new(\"/app/blotbay/rows.json\");\n    let temp = Path::new(\"/app/blotbay/rows.json.tmp\");\n    let _ = fs::remove_file(dest);\n    let _ = fs::remove_file(temp);\n\n    if tally::lines() != 6 {\n        eprintln!(\"invalid layout\");\n        return 1;\n    }\n    let buf = match fs::read(\"/app/quaybag/night.bin\") {\n        Ok(buf) => buf,\n        Err(err) => {\n            eprintln!(\"cannot read capture: {}\", err);\n            return 1;\n        }\n    };\n    if buf.len().saturating_mul(8) < pull::WIDTH_BITS {\n        eprintln!(\"capture is shorter than layout width\");\n        return 1;\n    }\n\n    let (a, b, c, d, e, f) = pull::dump(&buf);\n    let body = format!(\n        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\n        a, b, c, d, e, f\n    );\n    if let Some(parent) = dest.parent() {\n        if let Err(err) = fs::create_dir_all(parent) {\n            eprintln!(\"cannot create output directory: {}\", err);\n            return 1;\n        }\n    }\n    if let Err(err) = fs::write(temp, body).and_then(|_| fs::rename(temp, dest)) {\n        let _ = fs::remove_file(temp);\n        let _ = fs::remove_file(dest);\n        eprintln!(\"cannot write output: {}\", err);\n        return 1;\n    }\n    0\n}\nEOF\n/app/wick.sh\n"]
