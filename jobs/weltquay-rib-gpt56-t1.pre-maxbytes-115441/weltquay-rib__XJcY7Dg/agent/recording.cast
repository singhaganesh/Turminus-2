[56.288115, "o", "\u001b[?2004hroot@17f7f5f53823:/app# "]
[56.288782, "o", "cat > /app/stitchbay/card.rs <<'EOF'\r\n\u001b[?2004l\r"]
[56.2889, "o", "\u001b[?2004h> pub struct Row {\r\n\u001b[?2004l\r"]
[56.288922, "o", "\u001b[?2004h> "]
[56.289042, "o", "    pub tag: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub pos: u32,\r\n\u001b[?2004l\r"]
