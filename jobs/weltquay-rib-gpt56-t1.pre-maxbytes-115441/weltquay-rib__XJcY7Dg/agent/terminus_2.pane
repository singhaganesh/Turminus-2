     1	use std::fs;
     2	
     3	#[path = "../stitchbay/card.rs"]
     4	mod card;
     5	
     6	fn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {
     7	    for row in rows {
     8	        if row.tag == tag {
     9	            return (row.pos, row.n);
    10	        }
    11	    }
    12	    (0, 0)
    13	}
    14	
    15	fn main() {
    16	    let rows = card::rib_b();
    17	    let (k0, k1) = pick(&rows, "kind");
    18	    let (l0, l1) = pick(&rows, "lane");
    19	    let (m0, m1) = pick(&rows, "mode");
    20	    let (w0, w1) = pick(&rows, "welt");
    21	    let (t0, t1) = pick(&rows, "tail");
    22	    let (x0, x1) = pick(&rows, "mark");
    23	    let body = format!(
    24	        r#"use crate::take;
    25	
    26	pub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{
    27	    (
    28	        take::rib_a(buf, {k0}, {k1}),
    29	        take::rib_a(buf, {l0}, {l1}),
    30	        take::rib_a(buf, {m0}, {m1}),
    31	        take::rib_a(buf, {w0}, {w1}),
    32	        take::rib_a(buf, {t0}, {t1}),
    33	        take::rib_a(buf, {x0}, {x1}),
    34	    )
    35	}}
    36	"#
    37	    );
    38	    let _ = fs::create_dir_all("/app/vaultbin");
    39	    fs::write("/app/vaultbin/pull.rs", body).expect("emit");
