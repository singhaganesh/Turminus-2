[8.550973, "o", "\r\n--- TREE ---\r\n"]
[8.551849, "o", "weltquay mill\r\n===============\r\n\r\nweltcli/boot.rs dispatches pour.\r\n\r\nPipeline modules:\r\n- octetkiln/  kiln take and emit\r\n- stitchbay/  layout row load used by emit\r\n- peekurn/    pour writer\r\n- vaultbin/   baked pull used by pour\r\n- nudgepit/   line tally\r\n\r\nLayout rows live in /app/ribcards/LAYOUT.txt.\r\nEach row is a name, a bit index, and a width.\r\npour reads /app/quaybag/night.bin and writes /app/blotbay/rows.json.\r\n\r\nRebuild the binary with /app/wick.sh after source edits.\r\n"]
[8.552141, "o", "\r\n--- LAYOUT ---\r\n"]
[8.553062, "o", "kind 0 3\r\nlane 3 6\r\nmode 9 3\r\nwelt 12 9\r\ntail 21 3\r\nmark 24 8\r\n"]
[8.553267, "o", "\u001b[?2004h"]
[8.553356, "o", "root@ef6f17becb55:/app# "]
