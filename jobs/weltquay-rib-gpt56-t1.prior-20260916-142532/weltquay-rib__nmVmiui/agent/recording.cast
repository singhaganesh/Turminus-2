[54.24403, "o", "use crate::take;\r\n\r\npub const WIDTH_BITS: u32 = 32;\r\n\r\npub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n    (\r\n        take::rib_a(buf, 0, 3),\r\n        take::rib_a(buf, 3, 6),\r\n        take::rib_a(buf, 9, 3),\r\n        take::rib_a(buf, 12, 9),\r\n        take::rib_a(buf, 21, 3),\r\n        take::rib_a(buf, 24, 8),\r\n    )\r\n}\r\n"]
[54.244382, "o", "--- ELF magic ---\r\n"]
[54.245494, "o", " 7f 45 4c 46\r\n"]
[54.245831, "o", "--- valid pour ---\r\n"]
[54.247667, "o", "rc=0\r\n"]
[54.248556, "o", "{\"kind\":5,\"lane\":41,\"mode\":5,\"welt\":423,\"tail\":5,\"mark\":165}\r\n"]
