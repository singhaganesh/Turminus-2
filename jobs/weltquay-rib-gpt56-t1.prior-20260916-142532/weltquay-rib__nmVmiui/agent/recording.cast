[52.186397, "i", "python3 - <<'PY'\np='/app/octetkiln/emit.rs'\ns=open(p).read()\ns=s.replace('    let (x0, x1) = pick(&rows, \"mark\");\\n', '    let (x0, x1) = pick(&rows, \"mark\");\\n    let width = rows.iter().filter_map(|r| r.pos.checked_add(r.n)).max().unwrap_or(0);\\n')\ns=s.replace('pub fn dump(buf: &[u8])', 'pub const WIDTH_BITS: u32 = {width};\\n\\npub fn dump(buf: &[u8])')\nopen(p,'w').write(s)\nPY\ncat > /app/peekurn/ink.rs <<'EOF'\nuse crate::pull;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rib_c() -> i32 {\n    let _ = tally::lines();\n    let dest = Path::new(\"/app/blotbay/rows.json\");\n\n    // Never leave an old result behind when this invocation cannot produce one.\n    let _ = fs::remove_file(dest);\n    let buf = match fs::read(\"/app/quaybag/night.bin\") {\n        Ok(v) => v,\n        Err(e) => {\n            eprintln!(\"weltquay: cannot read input: {}\", e);\n            return 1;\n        }\n    };\n    if (buf.len() as u64) * 8 < pull::WIDTH_BITS as u64 {\n        eprintln!(\n            \"weltquay: short input ({} bits; layout requires {})\",\n            buf.len() * 8,\n            pull::WIDTH_BITS\n        );\n        return 1;\n    }\n\n    if let Some(parent) = dest.parent() {\n        if let Err(e) = fs::create_dir_all(parent) {\n            eprintln!(\"weltquay: cannot create output directory: {}\", e);\n            return 1;\n        }\n    }\n    let (a, b, c, d, e, f) = pull::dump(&buf);\n    let body = format!(\n        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\n        a, b, c, d, e, f\n    );\n    if let Err(e) = fs::write(dest, body) {\n        eprintln!(\"weltquay: cannot write output: {}\", e);\n        let _ = fs::remove_file(dest);\n        return 1;\n    }\n    0\n}\nEOF\n/app/wick.sh\n"]
