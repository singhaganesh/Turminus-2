[69.268155, "i", "cp /app/quaybag/night.bin /tmp/night.bin.saved; printf 'stale\\n' > /app/blotbay/rows.json; head -c 3 /tmp/night.bin.saved > /app/quaybag/night.bin; /app/bin/weltquay pour; rc=$?; echo \"short_rc=$rc\"; if [ -e /app/blotbay/rows.json ]; then echo 'short_output_exists=true'; else echo 'short_output_exists=false'; fi; cp /tmp/night.bin.saved /app/quaybag/night.bin; test \"$rc\" -ne 0 && test ! -e /app/blotbay/rows.json\n"]
[69.270763, "o", "cp /app/quaybag/night.bin /tmp/night.bin.saved; printf 'stale\\n' > /app/blotbay/rows.json; head -c 3 /tmp/night.bin.saved > /app/quaybag/night.bin; /app/bin/weltquay pour; rc=$?; echo \"short_rc=$rc\"; if [ -e /app/blotbay/rows.json ]; then echo 'short_output_exists=true'; else echo 'short_output_exists=false'; fi; cp /tmp/night.bin.saved /app/quaybag/night.bin; test \"$rc\" -ne 0 && test ! -e /app/blotbay/rows.json\r\n\u001b[?2004l\r"]
