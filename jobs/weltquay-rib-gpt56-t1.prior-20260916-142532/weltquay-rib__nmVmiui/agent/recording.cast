[8.68832, "o", "printf '\\n--- relevant files ---\\n'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort; printf '\\n--- types ---\\n'; file /app/bin/weltquay /app/quaybag/night.bin 2>/dev/null; printf '\\n--- output ---\\n'; ls -la /app/blotbay; cat /app/blotbay/rows.json 2>/dev/null || true"]
[8.688607, "o", "\r\n\u001b[?2004l\r"]
