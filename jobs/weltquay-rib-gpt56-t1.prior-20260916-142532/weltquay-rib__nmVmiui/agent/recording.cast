[19.086707, "o", "root@ef6f17becb55:/app# "]
[51.997923, "i", "cat > /app/octetkiln/take.rs <<'EOF'\npub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\n    if n == 0 || n > 32 {\n        return 0;\n    }\n    let end = match pos.checked_add(n) {\n        Some(v) => v,\n        None => return 0,\n    };\n    if (end as u64) > (buf.len() as u64) * 8 {\n        return 0;\n    }\n\n    let mut acc = 0u32;\n    let mut at = pos;\n    let mut left = n;\n    while left != 0 {\n        let room = 8 - (at % 8);\n        let width = left.min(room);\n        acc = (acc << width) | crate::house::rib_e(buf, at, width);\n        at += width;\n        left -= width;\n    }\n    acc\n}\nEOF\npython3 - <<'PY'\np='/app/stitchbay/card.rs'\ns=open(p).read()\ns=s.replace('        let mut pos: u32 = match parts[1].parse() {', '        let pos: u32 = match parts[1].parse() {')\ns=s.replace('        if n > 8 {\\n            pos = pos.saturating_add(8 - (pos % 8));\\n        }\\n', '')\nopen(p,'w').write(s)\nPY\n"]
[51.998252, "o", "cat > /app/octetkiln/take.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.001303, "o", "> pub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n\u001b[?2004l\r\u001b[?2004h>     if n == 0 || n > 32 {\r\n\u001b[?2004l\r\u001b[?2004h>         return 0;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     let end = match pos.checked_add(n) {\r\n\u001b[?2004l\r\u001b[?2004h>         Some(v) => v,\r\n\u001b[?2004l\r\u001b[?2004h>         None => return 0,\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     if (end as u64) > (buf.len() as u64) * 8 {\r\n\u001b[?2004l\r\u001b[?2004h>         return 0;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let mut acc = 0u32;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut at = pos;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut left = n;\r\n\u001b[?2004l\r\u001b[?2004h>     while left != 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         let room = 8 - (at % 8);\r\n\u001b[?2004l\r\u001b[?2004h>         let width = left.min(room);\r\n\u001b[?2004l\r\u001b[?2004h>         acc = (acc << width) | crate::house::rib_e(buf, at, width);\r\n\u001b[?2004l\r\u001b[?2004h>         at += width;\r\n\u001b[?2004l\r\u001b[?2004h>         left -= width;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     acc\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[52.002686, "o", "\u001b[?2004hroot@ef6f17becb55:/app# "]
[52.002733, "o", "python3 - <<'PY'\r\n"]
[52.002905, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.002993, "o", "> "]
[52.003116, "o", "p='/app/stitchbay/card.rs'\r\n\u001b[?2004l\r"]
