[52.003318, "o", "\u001b[?2004h> "]
[52.003645, "o", "s=s.replace('        let mut pos: u32 = match parts[1].parse() {', '        let pos: u32 = match parts[1].parse() {')\r\n\u001b[?2004l\r"]
[52.003907, "o", "\u001b[?2004h> "]
[52.004157, "o", "s=s.replace('        if n > 8 {\\n            pos = pos.saturating_add(8 - (pos % 8));\\n        }\\n', '')\r\n\u001b[?2004l\r"]
