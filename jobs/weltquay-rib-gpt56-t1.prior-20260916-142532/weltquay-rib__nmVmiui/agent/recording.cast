[8.695873, "o", "drwxr-xr-x 2 root root 4096 Sep 16 06:03 .\r\ndrwxr-xr-x 1 root root 4096 Sep 16 06:03 ..\r\n-rw-r--r-- 1 root root   60 Sep 16 06:03 rows.json\r\n"]
[8.698283, "o", "{\"kind\":5,\"lane\":20,\"mode\":5,\"welt\":61,\"tail\":5,\"mark\":165}\r\n"]
