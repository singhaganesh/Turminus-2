[18.8948, "i", "for f in /app/wick.sh /app/weltcli/boot.rs /app/octetkiln/*.rs /app/stitchbay/*.rs /app/peekurn/*.rs /app/vaultbin/*.rs /app/nudgepit/*.rs; do echo \"--- $f ---\"; nl -ba \"$f\"; done\n"]
[18.895625, "o", "for f in /app/wick.sh /app/weltcli/boot.rs /app/octetkiln/*.rs /app/stitchbay/*.rs /app/peekurn/*.rs /app/vaultbin/*.rs /app/nudgepit/*.rs; do echo \"--- $f ---\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[18.895934, "o", "--- /app/wick.sh ---\r\n"]
[18.898012, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/blotbay /app/vaultbin\r\n     5\trustc --edition 2021 -O /app/octetkiln/emit.rs -o /tmp/welt-emit\r\n     6\t/tmp/welt-emit\r\n     7\trustc --edition 2021 -O /app/weltcli/boot.rs -o /app/bin/weltquay\r\n"]
[18.898694, "o", "--- /app/weltcli/boot.rs ---\r\n"]
[18.90002, "o", "     1\t#[path = \"../octetkiln/house.rs\"]\r\n     2\tmod house;\r\n     3\t#[path = \"../octetkiln/take.rs\"]\r\n     4\tmod take;\r\n     5\t#[path = \"../vaultbin/pull.rs\"]\r\n     6\tmod pull;\r\n     7\t#[path = \"../peekurn/ink.rs\"]\r\n     8\tmod vat;\r\n"]
[18.900616, "o", "     9\t#[path = \"../nudgepit/tally.rs\"]\r\n    10\tmod tally;\r\n    11\t\r\n"]
[18.900659, "o", "    12\tfn main() {\r\n    13\t    let mut args = std::env::args().skip(1);\r\n    14\t    let cmd = args.next().unwrap_or_default();\r\n    15\t    let code = match cmd.as_str() {\r\n    16\t        \"pour\" => vat::rib_c(),\r\n    17\t        _ => {\r\n    18\t            eprintln!(\"usage: weltquay pour\");\r\n    19\t            2\r\n    20\t        }\r\n    21\t    };\r\n    22\t    std::process::exit(code);\r\n    23\t}\r\n"]
[18.901443, "o", "--- /app/octetkiln/emit.rs ---\r\n"]
[18.902403, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\t#[path = \"../stitchbay/card.rs\"]\r\n     4\tmod card;\r\n     5\t\r\n     6\tfn pick(rows: &[card::Row], tag: &str) -> (u32, u32) {\r\n     7\t    for row in rows {\r\n     8\t        if row.tag == tag {\r\n     9\t            return (row.pos, row.n);\r\n    10\t        }\r\n    11\t    }\r\n    12\t    (0, 0)\r\n    13\t}\r\n    14\t\r\n    15\tfn main() {\r\n    16\t    let rows = card::rib_b();\r\n    17\t    let (k0, k1) = pick(&rows, \"kind\");\r\n"]
[18.902587, "o", "    18\t    let (l0, l1) = pick(&rows, \"lane\");\r\n    19\t    let (m0, m1) = pick(&rows, \"mode\");\r\n    20\t    let (w0, w1) = pick(&rows, \"welt\");\r\n    21\t    let (t0, t1) = pick(&rows, \"tail\");\r\n    22\t    let (x0, x1) = pick(&rows, \"mark\");\r\n    23\t    let body = format!(\r\n    24\t        r#\"use crate::take;\r\n    25\t\r\n    26\tpub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {{\r\n    27\t    (\r\n    28\t        take::rib_a(buf, {k0}, {k1}),\r\n    29\t        take::rib_a(buf, {l0}, {l1}),\r\n    30\t        take::rib_a(buf, {m0}, {m1}),\r\n    31\t        take::rib_a(buf, {w0}, {w1}),\r\n    32\t        take::rib_a(buf, {t0}, {t1}),\r\n    33\t        take::rib_a(buf, {x0}, {x1}),\r\n    34\t    )\r\n    35\t}}\r\n    36\t\"#\r\n    37\t    );\r\n    38\t    let _ = fs::create_dir_all(\"/app/vaultbin\");\r\n    39\t    fs::write(\"/app/vaultbin/pull.rs\", body).expect(\"emit\");\r\n    40\t}\r\n"]
[18.902757, "o", "--- /app/octetkiln/house.rs ---\r\n"]
[18.903735, "o", "     1\tpub fn rib_e(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n     2\t    if n == 0 {\r\n     3\t        return 0;\r\n     4\t    }\r\n     5\t    let i = (pos / 8) as usize;\r\n     6\t    if i >= buf.len() {\r\n     7\t        return 0;\r\n     8\t    }\r\n     9\t    let bit = pos % 8;\r\n    10\t    let room = 8 - bit;\r\n    11\t    if n > room {\r\n    12\t        return 0;\r\n"]
[18.903858, "o", "    13\t    }\r\n    14\t    let shift = 8 - bit - n;\r\n    15\t    ((buf[i] as u32) >> shift) & ((1u32 << n) - 1)\r\n    16\t}\r\n"]
[18.90408, "o", "--- /app/octetkiln/lsb.rs ---\r\n"]
[18.90491, "o", "     1\tpub fn rib_f(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n     2\t    let mut acc = 0u32;\r\n     3\t    let mut i = 0u32;\r\n     4\t    while i < n {\r\n"]
[18.905079, "o", "     5\t        let b = pos + i;\r\n     6\t        let idx = (b / 8) as usize;\r\n     7\t        if idx >= buf.len() {\r\n     8\t            break;\r\n     9\t        }\r\n    10\t        let bit = b % 8;\r\n    11\t        let v = ((buf[idx] as u32) >> bit) & 1;\r\n    12\t        acc |= v << i;\r\n    13\t        i += 1;\r\n"]
[18.905111, "o", "    14\t    }\r\n    15\t    acc\r\n    16\t}\r\n"]
[18.905813, "o", "--- /app/octetkiln/take.rs ---\r\n"]
[18.909583, "o", "     1\tpub fn rib_a(buf: &[u8], pos: u32, n: u32) -> u32 {\r\n     2\t    if n == 0 {\r\n     3\t        return 0;\r\n     4\t    }\r\n     5\t    let bit = pos % 8;\r\n     6\t    let room = 8 - bit;\r\n     7\t    let w = if n > room { room } else { n };\r\n     8\t    crate::house::rib_e(buf, pos, w)\r\n     9\t}\r\n--- /app/stitchbay/card.rs ---\r\n"]
[18.910467, "o", "     1\tpub struct Row {\r\n     2\t    pub tag: String,\r\n     3\t    pub pos: u32,\r\n     4\t    pub n: u32,\r\n     5\t}\r\n     6\t\r\n     7\tfn tok(line: &str) -> Vec<String> {\r\n     8\t    line.split_whitespace().map(|s| s.to_string()).collect()\r\n     9\t}\r\n    10\t\r\n    11\tpub fn rib_b() -> Vec<Row> {\r\n    12\t    let text = std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\").unwrap_or_default();\r\n    13\t    let mut out = Vec::new();\r\n    14\t    for line in text.lines() {\r\n    15\t        let raw = line.trim();\r\n    16\t        if raw.is_empty() || raw.starts_with('#') {\r\n    17\t            continue;\r\n    18\t        }\r\n    19\t        let parts = tok(raw);\r\n    20\t        if parts.len() < 3 {\r\n    21\t            continue;\r\n    22\t        }\r\n    23\t        let tag = parts[0].clone();\r\n    24\t        let mut pos: u32 = match parts[1].parse() {\r\n    25\t            Ok(v) => v,\r\n    26\t            Err(_) => continue,\r\n    27\t        };\r\n    28\t        let n: u32 = match parts[2].parse() {\r\n    29\t            Ok(v) => v,\r\n    30\t            Err(_) => continue,\r\n    31\t        };\r\n    32\t        if n > 8 {\r\n    33\t            pos = pos.saturating_add(8 - (pos % 8));\r\n    34\t        }\r\n    35\t        out.push(Row { tag, pos, n });\r\n    36\t    }\r\n    37\t    out\r\n    38\t}\r\n"]
[18.910889, "o", "--- /app/peekurn/ink.rs ---\r\n"]
[18.912552, "o", "     1\tuse crate::pull;\r\n     2\tuse crate::tally;\r\n     3\tuse std::fs;\r\n     4\tuse std::path::Path;\r\n"]
[18.912654, "o", "     5\t\r\n     6\tpub fn rib_c() -> i32 {\r\n     7\t    let _ = tally::lines();\r\n     8\t    let buf = fs::read(\"/app/quaybag/night.bin\").unwrap_or_default();\r\n     9\t    let dest = Path::new(\"/app/blotbay/rows.json\");\r\n    10\t    if let Some(parent) = dest.parent() {\r\n    11\t        let _ = fs::create_dir_all(parent);\r\n    12\t    }\r\n    13\t    let (a, b, c, d, e, f) = pull::dump(&buf);\r\n    14\t    let body = format!(\r\n    15\t        \"{{\\\"kind\\\":{},\\\"lane\\\":{},\\\"mode\\\":{},\\\"welt\\\":{},\\\"tail\\\":{},\\\"mark\\\":{}}}\\n\",\r\n    16\t        a, b, c, d, e, f\r\n    17\t    );\r\n    18\t    let _ = fs::write(dest, body);\r\n    19\t    0\r\n    20\t}\r\n"]
[18.913437, "o", "--- /app/vaultbin/pull.rs ---\r\n"]
[18.914716, "o", "     1\tuse crate::take;\r\n     2\t\r\n     3\tpub fn dump(buf: &[u8]) -> (u32, u32, u32, u32, u32, u32) {\r\n     4\t    (\r\n     5\t        take::rib_a(buf, 0, 3),\r\n     6\t        take::rib_a(buf, 3, 6),\r\n     7\t        take::rib_a(buf, 9, 3),\r\n     8\t        take::rib_a(buf, 16, 9),\r\n     9\t        take::rib_a(buf, 21, 3),\r\n    10\t        take::rib_a(buf, 24, 8),\r\n    11\t    )\r\n    12\t}\r\n"]
[18.915157, "o", "--- /app/nudgepit/tally.rs ---\r\n"]
[18.916233, "o", "     1\tpub fn lines() -> usize {\r\n"]
[18.917027, "o", "     2\t    std::fs::read_to_string(\"/app/ribcards/LAYOUT.txt\")\r\n     3\t        .unwrap_or_default()\r\n     4\t        .lines()\r\n     5\t        .filter(|line| !line.trim().is_empty())\r\n     6\t        .count()\r\n     7\t}\r\n"]
[18.917625, "o", "\u001b[?2004hroot@ef6f17becb55:/app# "]
[19.077296, "i", "echo '--- magic and bytes ---'; od -An -tx1 -N16 /app/bin/weltquay; wc -c /app/bin/weltquay /app/quaybag/night.bin; od -An -tx1 /app/quaybag/night.bin; echo '--- current run ---'; /app/bin/weltquay pour; rc=$?; echo \"rc=$rc\"; ls -l /app/blotbay/rows.json 2>/dev/null || true; cat /app/blotbay/rows.json 2>/dev/null || true\n"]
[19.079113, "o", "echo '--- magic and bytes ---'; od -An -tx1 -N16 /app/bin/weltquay; wc -c /app/bin/weltquay /app/quaybag/night.bin; od -An -tx1 /app/quaybag/night.bin; echo '--- current run ---'; /app/bin/weltquay pour; rc=$?; echo \"rc=$rc\"; ls -l /app/blotbay/rows.json 2>/dev/null || true; cat /app/blotbay/rows.json 2>/dev/null || true\r\n\u001b[?2004l\r"]
