[17.778918, "o", "\u001b[?2004hroot@57e45bc159f9:/app# "]
[48.934247, "i", "python3 - <<'PY'\np='/app/slipread/scan.rs'\ns=open(p).read().replace('pub wire: u8,', 'pub wire: i64,').replace('let mut wire: u8 = 0;', 'let mut wire: i64 = 0;')\nopen(p,'w').write(s)\n\np='/app/gaskcli/boot.rs'\ns=open(p).read().replace('let n: u8 = raw.parse().unwrap_or(0);', 'let n: i64 = raw.parse().unwrap_or(0);')\nopen(p,'w').write(s)\nPY\ncat > /app/hopmat/table.rs <<'RS'\nuse crate::cards;\n\n/// Return the reply produced by the live hopper for a wire.\n/// Cards are loaded at command time so cards added after compilation work too.\npub fn reply(n: i64) -> String {\n    cards::load()\n        .into_iter()\n        .find(|row| row.wire == n)\n        .map(|row| row.reply)\n        .unwrap_or_else(|| \"fallthrough\".to_string())\n}\n\n/// A card is served only if jab on its wire produces that card's own reply.\npub fn serves(wire: i64, expected: &str) -> bool {\n    reply(wire) == expected\n}\n\npub fn tap(n: i64) -> i32 {\n    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":\\\"{}\\\"}}\", n, reply(n));\n    0\n}\nRS\ncat > /app/lidpit/plug.rs <<'RS'\nuse crate::cards;\nuse crate::loom;\nuse crate::table;\nuse crate::tally;\nuse std::fs;\n\npub fn rib_c() -> i32 {\n    let _ = tally::lines();\n    let _ = loom::emit();\n    let spec = cards::load();\n\n    // Check the same live hopper used by jab, rather than merely checking that\n    // bind copied a card's label into the roster.\n    let names: Vec<String> = spec\n        .iter()\n        .filter(|row| table::serves(row.wire, &row.reply))\n        .map(|row| row.label.clone())\n        .collect();\n    let complete = names.len() == spec.len();\n    let served = names\n        .iter()\n        .map(|name| format!(\"\\\"{}\\\"\", name))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    let status = if complete { \"sealed\" } else { \"open\" };\n\n    if fs::create_dir_all(\"/app/corkbay\").is_err()\n        || fs::write(\n            \"/app/corkbay/seal.json\",\n            format!(\n                \"{{\\\"served\\\":[{}],\\\"status\\\":\\\"{}\\\"}}\\n\",\n                served, status\n            ),\n        )\n        .is_err()\n    {\n        return 1;\n    }\n    if complete { 0 } else { 1 }\n}\nRS\n/app/stoke.sh\nod -An -tx1 -N4 /app/bin/gasketd\n"]
[48.934461, "o", "python3 - <<'PY'\r\n"]
