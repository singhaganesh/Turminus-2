[52.91344, "i", "set +e\ncat > /app/buscards/z_conflict.card <<'EOF'\nLABEL CONFLICT_TEST\nWIRE 1\nREPLY cannot-be-served\nEOF\n/app/bin/gasketd cork\nrc=$?\necho \"conflict_cork_rc=$rc\"\ncat /app/corkbay/seal.json\nrm /app/buscards/z_conflict.card\n/app/bin/gasketd bind\n/app/bin/gasketd cork\nfinal_rc=$?\ncat /app/corkbay/seal.json\nod -An -tx1 -N4 /app/bin/gasketd\necho \"final_cork_rc=$final_rc\"\ntest \"$rc\" -ne 0 && test \"$final_rc\" -eq 0\n"]
