[48.936347, "o", "s=open(p).read().replace('let n: u8 = raw.parse().unwrap_or(0);', 'let n: i64 = raw.parse().unwrap_or(0);')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
