[66.77345, "o", "\u001b[?2004h> "]
[66.773546, "o", "                .collect()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.773632, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.773792, "o", "        .unwrap_or_default();\r\n\u001b[?2004l\r"]
[66.773915, "o", "\u001b[?2004h> "]
[66.774002, "o", "    names.sort();\r\n\u001b[?2004l\r"]
[66.774095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.774123, "o", "\u001b[?2004h"]
[66.774142, "o", "> "]
[66.77434, "o", "    let mut out = Vec::new();\r\n\u001b[?2004l\r"]
[66.774847, "o", "\u001b[?2004h>     for p in names {\r\n\u001b[?2004l\r\u001b[?2004h>         let text = fs::read_to_string(&p).unwrap_or_default();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.774995, "o", "        let mut label = String::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.775068, "o", "        let mut wire: Option<i64> = None;\r\n\u001b[?2004l\r"]
[66.77514, "o", "\u001b[?2004h> "]
[66.775253, "o", "        let mut reply = String::new();\r\n\u001b[?2004l\r"]
[66.77532, "o", "\u001b[?2004h> "]
[66.775396, "o", "        for line in text.lines() {\r\n\u001b[?2004l\r"]
[66.775474, "o", "\u001b[?2004h> "]
[66.775563, "o", "            let line = line.trim();\r\n\u001b[?2004l\r"]
[66.77562, "o", "\u001b[?2004h> "]
[66.775786, "o", "            if let Some(rest) = line.strip_prefix(\"LABEL \") {\r\n\u001b[?2004l\r"]
[66.775867, "o", "\u001b[?2004h> "]
[66.775937, "o", "                label = rest.trim().to_string();\r\n\u001b[?2004l\r"]
[66.776014, "o", "\u001b[?2004h> "]
[66.776143, "o", "            } else if let Some(rest) = line.strip_prefix(\"WIRE \") {\r\n\u001b[?2004l\r"]
[66.7762, "o", "\u001b[?2004h> "]
[66.77631, "o", "                wire = rest.trim().parse().ok();\r\n\u001b[?2004l\r"]
[66.776377, "o", "\u001b[?2004h> "]
[66.776491, "o", "            } else if let Some(rest) = line.strip_prefix(\"REPLY \") {\r\n\u001b[?2004l\r"]
[66.776549, "o", "\u001b[?2004h> "]
[66.77665, "o", "                reply = rest.trim().to_string();\r\n\u001b[?2004l\r"]
[66.776749, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[66.77684, "o", "\u001b[?2004h"]
[66.776904, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.777011, "o", "        if let Some(wire) = wire {\r\n\u001b[?2004l\r"]
[66.777069, "o", "\u001b[?2004h> "]
[66.777192, "o", "            if !label.is_empty() && !reply.is_empty() {\r\n\u001b[?2004l\r"]
[66.777246, "o", "\u001b[?2004h> "]
[66.777363, "o", "                out.push(Row { label, wire, reply });\r\n\u001b[?2004l\r"]
[66.777411, "o", "\u001b[?2004h> "]
[66.777472, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.777567, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.777643, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     out\r\n"]
[66.777771, "o", "\u001b[?2004l\r\u001b[?2004h"]
[66.777844, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[66.779797, "o", "\u001b[?2004hroot@1bb0d36e56a0:/app# "]
[66.779967, "o", "cat > /app/rimcap/span.rs <<'EOF'\r\n\u001b[?2004l\r"]
[66.780044, "o", "\u001b[?2004h"]
[66.780118, "o", "> "]
[66.780256, "o", "const RAW: &str = include_str!(\"../loomkit/emit.lst\");\r\n\u001b[?2004l\r"]
[66.780309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.780368, "o", "\u001b[?2004h> "]
[66.780423, "o", "pub fn rib_a() -> usize {\r\n\u001b[?2004l\r"]
[66.780477, "o", "\u001b[?2004h> "]
[66.78067, "o", "    RAW.lines().filter(|line| !line.trim().is_empty()).count()\r\n\u001b[?2004l\r"]
[66.780722, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[66.780823, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[66.782341, "o", "\u001b[?2004hroot@1bb0d36e56a0:/app# "]
[66.782468, "o", "cat > /app/hopmat/table.rs <<'EOF'\r\n\u001b[?2004l\r"]
[66.782536, "o", "\u001b[?2004h> use crate::span;\r\n"]
[66.7826, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[66.782687, "o", "use std::collections::HashMap;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[66.782706, "o", "\u001b[?2004l\r\u001b[?2004h"]
[66.782721, "o", "> "]
[66.782947, "o", "const RAW: &str = include_str!(\"../loomkit/emit.lst\");\r\n\u001b[?2004l\r"]
[66.783028, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.78311, "o", "#[derive(Clone)]\r\n\u001b[?2004l\r"]
[66.783159, "o", "\u001b[?2004h> pub struct Slot {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.783225, "o", "    pub label: String,\r\n\u001b[?2004l\r"]
[66.783261, "o", "\u001b[?2004h> "]
[66.783322, "o", "    pub reply: String,\r\n\u001b[?2004l\r"]
[66.783361, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[66.783398, "o", "\u001b[?2004h> "]
[66.783435, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.783561, "o", "fn parse_line(line: &str) -> Option<(i64, Slot)> {\r\n\u001b[?2004l\r"]
[66.783595, "o", "\u001b[?2004h> "]
[66.783694, "o", "    let mut parts = line.split('\\t');\r\n\u001b[?2004l\r"]
[66.783736, "o", "\u001b[?2004h> "]
[66.783881, "o", "    let label = parts.next()?.trim().to_string();\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.783926, "o", "> "]
[66.784035, "o", "    let wire: i64 = parts.next()?.trim().parse().ok()?;\r\n\u001b[?2004l\r"]
[66.784073, "o", "\u001b[?2004h> "]
[66.784191, "o", "    let reply = parts.next()?.trim().to_string();\r\n\u001b[?2004l\r"]
[66.78423, "o", "\u001b[?2004h> "]
[66.784342, "o", "    if label.is_empty() || reply.is_empty() {\r\n\u001b[?2004l\r"]
[66.784389, "o", "\u001b[?2004h> "]
[66.784443, "o", "        return None;\r\n\u001b[?2004l\r"]
[66.784469, "o", "\u001b[?2004h> "]
[66.784487, "o", "    }\r\n"]
[66.784504, "o", "\u001b[?2004l\r\u001b[?2004h"]
[66.784518, "o", "> "]
[66.784627, "o", "    Some((wire, Slot { label, reply }))\r\n\u001b[?2004l\r"]
[66.784693, "o", "\u001b[?2004h> "]
[66.784756, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.784807, "o", "> "]
[66.784849, "o", "pub fn rib_b() -> HashMap<i64, Slot> {\r\n\u001b[?2004l\r"]
[66.784896, "o", "\u001b[?2004h> "]
[66.784979, "o", "    let mut slots = HashMap::new();\r\n\u001b[?2004l\r"]
[66.785025, "o", "\u001b[?2004h> "]
[66.785208, "o", "    for line in RAW.lines().filter(|line| !line.trim().is_empty()).take(span::rib_a()) {\r\n\u001b[?2004l\r"]
[66.785251, "o", "\u001b[?2004h> "]
[66.785389, "o", "        if let Some((wire, slot)) = parse_line(line) {\r\n\u001b[?2004l\r"]
[66.785433, "o", "\u001b[?2004h> "]
[66.78553, "o", "            slots.insert(wire, slot);\r\n\u001b[?2004l\r"]
[66.785588, "o", "\u001b[?2004h"]
[66.785643, "o", ">         }\r\n\u001b[?2004l\r"]
[66.785696, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.785769, "o", "    slots\r\n\u001b[?2004l\r"]
[66.78586, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.786008, "o", "pub fn tap(n: i64) -> i32 {\r\n\u001b[?2004l\r"]
[66.786107, "o", "\u001b[?2004h>     let slots = rib_b();\r\n"]
[66.786197, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[66.786392, "o", "    let reply = slots.get(&n).map(|slot| slot.reply.as_str()).unwrap_or(\"fallthrough\");\r\n\u001b[?2004l\r"]
[66.78649, "o", "\u001b[?2004h> "]
[66.786673, "o", "    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":\\\"{}\\\"}}\", n, reply);\r\n\u001b[?2004l\r"]
[66.78681, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r"]
[66.786982, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[66.787899, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[66.789785, "o", "\u001b[?2004hroot@1bb0d36e56a0:/app# "]
[66.78999, "o", "cat > /app/lidpit/plug.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.79013, "o", "use crate::cards;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.790274, "o", "use crate::loom;\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.790358, "o", "> use crate::table;\r\n\u001b[?2004l\r"]
[66.790448, "o", "\u001b[?2004h> "]
[66.790539, "o", "use crate::tally;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.790622, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.790706, "o", "\u001b[?2004h> "]
[66.790819, "o", "pub fn rib_c() -> i32 {\r\n\u001b[?2004l\r"]
[66.790906, "o", "\u001b[?2004h> "]
[66.791036, "o", "    let _ = loom::emit();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.791175, "o", "    let spec = cards::load();\r\n\u001b[?2004l\r"]
[66.791274, "o", "\u001b[?2004h> "]
[66.791373, "o", "    let hopper = table::rib_b();\r\n\u001b[?2004l\r"]
[66.791434, "o", "\u001b[?2004h> "]
[66.791537, "o", "    let compiled_count = tally::lines();\r\n\u001b[?2004l\r"]
[66.791592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.791617, "o", "\u001b[?2004h> "]
[66.791788, "o", "    let complete = compiled_count == spec.len()\r\n\u001b[?2004l\r"]
[66.791886, "o", "\u001b[?2004h> "]
[66.791981, "o", "        && hopper.len() == spec.len()\r\n\u001b[?2004l\r"]
[66.792031, "o", "\u001b[?2004h> "]
[66.792146, "o", "        && spec.iter().all(|row| {\r\n\u001b[?2004l\r"]
[66.792214, "o", "\u001b[?2004h> "]
[66.79229, "o", "            hopper.get(&row.wire).map(|slot| {\r\n\u001b[?2004l\r"]
[66.792352, "o", "\u001b[?2004h> "]
[66.792493, "o", "                slot.label == row.label && slot.reply == row.reply\r\n\u001b[?2004l\r"]
[66.792548, "o", "\u001b[?2004h> "]
[66.792602, "o", "            }).unwrap_or(false)\r\n\u001b[?2004l\r"]
[66.79266, "o", "\u001b[?2004h> "]
[66.792718, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.792862, "o", "    let _ = fs::create_dir_all(\"/app/corkbay\");\r\n\u001b[?2004l\r"]
[66.792915, "o", "\u001b[?2004h> "]
[66.792974, "o", "    if !complete {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.793075, "o", "        let served = spec.iter().filter(|row| {\r\n\u001b[?2004l\r"]
[66.793123, "o", "\u001b[?2004h> "]
[66.793197, "o", "            hopper.get(&row.wire).map(|slot| {\r\n\u001b[?2004l\r"]
[66.793245, "o", "\u001b[?2004h> "]
[66.793357, "o", "                slot.label == row.label && slot.reply == row.reply\r\n\u001b[?2004l\r"]
[66.793434, "o", "\u001b[?2004h> "]
[66.79349, "o", "            }).unwrap_or(false)\r\n\u001b[?2004l\r"]
[66.79355, "o", "\u001b[?2004h"]
[66.793612, "o", "> "]
[66.793731, "o", "        }).map(|row| format!(\"\\\"{}\\\"\", row.label)).collect::<Vec<_>>().join(\",\");\r\n\u001b[?2004l\r"]
[66.793811, "o", "\u001b[?2004h"]
[66.79401, "o", "> "]
[66.794235, "o", "        let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"open\\\"}}\\n\", served);\r\n\u001b[?2004l\r"]
[66.794298, "o", "\u001b[?2004h"]
[66.794355, "o", "> "]
[66.794456, "o", "        let _ = fs::write(\"/app/corkbay/seal.json\", text);\r\n\u001b[?2004l\r"]
[66.794523, "o", "\u001b[?2004h> "]
[66.794583, "o", "        return 1;\r\n\u001b[?2004l\r"]
[66.794646, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[66.794709, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[66.794799, "o", "\u001b[?2004h> "]
[66.794859, "o", "    let served = spec.iter()\r\n\u001b[?2004l\r"]
[66.794919, "o", "\u001b[?2004h"]
[66.794967, "o", "> "]
[66.795037, "o", "        .map(|row| format!(\"\\\"{}\\\"\", row.label))\r\n\u001b[?2004l\r"]
[66.7951, "o", "\u001b[?2004h"]
[66.795164, "o", "> "]
[66.795218, "o", "        .collect::<Vec<_>>()\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.795268, "o", "> "]
[66.795381, "o", "        .join(\",\");\r\n\u001b[?2004l\r"]
[66.795437, "o", "\u001b[?2004h> "]
[66.795576, "o", "    let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"sealed\\\"}}\\n\", served);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.795702, "o", "    let _ = fs::write(\"/app/corkbay/seal.json\", text);\r\n\u001b[?2004l\r"]
[66.79577, "o", "\u001b[?2004h> "]
[66.795829, "o", "    0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.795917, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.795973, "o", "EOF\r\n\u001b[?2004l\r"]
[66.797383, "o", "\u001b[?2004hroot@1bb0d36e56a0:/app# "]
[66.797461, "o", "/app/stoke.sh\r\n\u001b[?2004l\r"]
[68.430814, "o", "\u001b[?2004hroot@1bb0d36e56a0:/app# "]
[69.814608, "i", "/app/bin/gasketd bind; echo bind_rc=$?; while read -r key wire; do [ \"$key\" = WIRE ] || continue; printf 'jab %s: ' \"$wire\"; /app/bin/gasketd jab \"$wire\"; done < <(cat /app/buscards/*.card); /app/bin/gasketd jab 999; /app/bin/gasketd jab -42; /app/bin/gasketd cork; echo cork_rc=$?; cat /app/mistwell/roster.json; cat /app/corkbay/seal.json; printf 'magic: '; od -An -tx1 -N4 /app/bin/gasketd\n"]
[69.816053, "o", "/app/bin/gasketd bind; echo bind_rc=$?; while read -r key wire; do [ \"$key\" = WIRE ] || continue; printf 'jab %s: ' \"$wire\"; /app/bin/gasketd jab \"$wire\"; done < <(cat /app/buscards/*.card); /app/bin/gasketd jab 999; /app/bin/gasketd jab -42; /app/bin/gasketd cork; echo cork_rc=$?; cat /app/mistwell/roster.json; cat /app/corkbay/seal.json; printf 'magic: '; od -An -tx1 -N4 /app/bin/gasketd\r\n\u001b[?2004l\r"]
[69.818791, "o", "bind_rc=0\r\n"]
[69.822096, "o", "jab 1: "]
[69.82685, "o", "{\"wire\":1,\"reply\":\"fan-ok\"}\r\njab 2: {\"wire\":2,\"reply\":\"pump-ok\"}\r\n"]
[69.827814, "o", "jab 4: "]
[69.828795, "o", "{\"wire\":4,\"reply\":\"valve-ok\"}\r\n"]
[69.829253, "o", "jab 7: "]
[69.830953, "o", "{\"wire\":7,\"reply\":\"temp-ok\"}\r\n"]
[69.831259, "o", "jab 8: "]
[69.832401, "o", "{\"wire\":8,\"reply\":\"press-ok\"}\r\n"]
[69.832686, "o", "jab 10: "]
[69.833738, "o", "{\"wire\":10,\"reply\":\"latch-ok\"}\r\n"]
[69.834044, "o", "jab 12: "]
[69.835139, "o", "{\"wire\":12,\"reply\":\"bias-ok\"}\r\n"]
[69.835577, "o", "jab 15: "]
[69.837421, "o", "{\"wire\":15,\"reply\":\"watch-ok\"}\r\n"]
[69.838793, "o", "jab 17: "]
[69.839996, "o", "{\"wire\":17,\"reply\":\"vent-ok\"}\r\n"]
[69.842115, "o", "{\"wire\":999,\"reply\":\"fallthrough\"}\r\n"]
[69.84357, "o", "{\"wire\":-42,\"reply\":\"fallthrough\"}\r\n"]
[69.845894, "o", "cork_rc=0\r\n"]
[69.846921, "o", "{\"names\":[\"SET_FAN\",\"SET_PUMP\",\"SET_VALVE\",\"READ_TEMP\",\"READ_PRESS\",\"HOLD_LATCH\",\"TRIM_BIAS\",\"ACK_WATCH\",\"VENT_LINE\"]}\r\n"]
[69.847955, "o", "{\"served\":[\"SET_FAN\",\"SET_PUMP\",\"SET_VALVE\",\"READ_TEMP\",\"READ_PRESS\",\"HOLD_LATCH\",\"TRIM_BIAS\",\"ACK_WATCH\",\"VENT_LINE\"],\"status\":\"sealed\"}\r\n"]
[69.848123, "o", "magic: "]
[69.849086, "o", " 7f 45 4c 46\r\n"]
[69.849371, "o", "\u001b[?2004hroot@1bb0d36e56a0:/app# "]
[71.773656, "i", "cat > /app/buscards/z_probe.card <<'EOF'\nLABEL PROBE_NEW\nWIRE 300\nREPLY probe-ok\nEOF\n/app/bin/gasketd bind; /app/bin/gasketd jab 300; /app/bin/gasketd cork; echo expected_nonzero_cork_rc=$?; cat /app/corkbay/seal.json; rm -f /app/buscards/z_probe.card; /app/bin/gasketd bind; /app/bin/gasketd cork; echo restored_cork_rc=$?; cat /app/corkbay/seal.json\n"]
[71.774164, "o", "cat > /app/buscards/z_probe.card <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> LABEL PROBE_NEW\r\n\u001b[?2004l\r\u001b[?2004h"]
