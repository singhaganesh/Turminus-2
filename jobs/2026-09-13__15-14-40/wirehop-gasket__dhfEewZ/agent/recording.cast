[18.474158, "i", "for f in /app/gaskcli/boot.rs /app/slipread/scan.rs /app/loomkit/loom.rs /app/rimcap/span.rs /app/hopmat/table.rs /app/lidpit/plug.rs /app/lidpit/tally.rs /app/stoke.sh /app/opscribe/COUNT_SRC.txt; do echo \"===== $f =====\"; nl -ba \"$f\"; done; echo '===== artifacts ====='; cat /app/mistwell/roster.json; cat /app/loomkit/emit.lst; cat /app/corkbay/seal.json\n"]
[18.475207, "o", "for f in /app/gaskcli/boot.rs /app/slipread/scan.rs /app/loomkit/loom.rs /app/rimcap/span.rs /app/hopmat/table.rs /app/lidpit/plug.rs /app/lidpit/tally.rs /app/stoke.sh /app/opscribe/COUNT_SRC.txt; do echo \"===== $f =====\"; nl -ba \"$f\"; done; echo '===== artifacts ====='; cat /app/mistwell/roster.json; cat /app/loomkit/emit.lst; cat /app/corkbay/seal.json\r\n\u001b[?2004l\r"]
[18.475435, "o", "===== /app/gaskcli/boot.rs =====\r\n"]
[18.476917, "o", "     1\t#[path = \"../slipread/scan.rs\"]\r\n     2\tmod cards;\r\n     3\t#[path = \"../rimcap/span.rs\"]\r\n     4\tmod span;\r\n     5\t#[path = \"../hopmat/table.rs\"]\r\n     6\tmod table;\r\n     7\t#[path = \"../lidpit/plug.rs\"]\r\n     8\tmod vat;\r\n     9\t#[path = \"../loomkit/loom.rs\"]\r\n    10\tmod loom;\r\n    11\t#[path = \"../lidpit/tally.rs\"]\r\n    12\tmod tally;\r\n    13\t\r\n"]
[18.477089, "o", "    14\tfn main() {\r\n    15\t    let mut args = std::env::args().skip(1);\r\n    16\t    let cmd = args.next().unwrap_or_default();\r\n    17\t    let code = match cmd.as_str() {\r\n    18\t        \"bind\" => loom::emit(),\r\n    19\t        \"jab\" => {\r\n    20\t            let raw = args.next().unwrap_or_else(|| \"0\".to_string());\r\n    21\t            let n: u8 = raw.parse().unwrap_or(0);\r\n    22\t            table::tap(n)\r\n    23\t        }\r\n    24\t        \"cork\" => vat::rib_c(),\r\n    25\t        _ => {\r\n    26\t            eprintln!(\"usage: gasketd bind|jab N|cork\");\r\n    27\t            2\r\n    28\t        }\r\n    29\t    };\r\n    30\t    std::process::exit(code);\r\n    31\t}\r\n"]
[18.477291, "o", "===== /app/slipread/scan.rs =====\r\n"]
[18.478715, "o", "     1\tuse std::fs;\r\n     2\tuse std::path::Path;\r\n     3\t\r\n     4\t#[derive(Clone)]\r\n     5\tpub struct Row {\r\n     6\t    pub label: String,\r\n"]
[18.478884, "o", "     7\t    #[allow(dead_code)]\r\n     8\t    pub wire: u8,\r\n     9\t    pub reply: String,\r\n    10\t}\r\n    11\t\r\n    12\timpl Default for Row {\r\n    13\t    fn default() -> Self {\r\n    14\t        Self {\r\n    15\t            label: String::new(),\r\n    16\t            wire: 0,\r\n    17\t            reply: \"fallthrough\".to_string(),\r\n    18\t        }\r\n    19\t    }\r\n    20\t}\r\n    21\t\r\n    22\tpub fn load() -> Vec<Row> {\r\n    23\t    let dir = Path::new(\"/app/buscards\");\r\n    24\t    let mut names: Vec<_> = fs::read_dir(dir)\r\n    25\t        .map(|rd| {\r\n    26\t            rd.filter_map(|e| e.ok())\r\n    27\t                .map(|e| e.path())\r\n    28\t                .filter(|p| p.extension().map(|x| x == \"card\").unwrap_or(false))\r\n    29\t                .collect()\r\n    30\t        })\r\n    31\t        .unwrap_or_default();\r\n    32\t    names.sort();\r\n    33\t    let mut out = Vec::new();\r\n    34\t    for p in names {\r\n    35\t        let text = fs::read_to_string(&p).unwrap_or_default();\r\n    36\t        let mut label = String::new();\r\n"]
[18.478929, "o", "    37\t        let mut wire: u8 = 0;\r\n    38\t        let mut reply = String::new();\r\n    39\t        for line in text.lines() {\r\n    40\t            let line = line.trim();\r\n    41\t            if let Some(rest) = line.strip_prefix(\"LABEL \") {\r\n    42\t                label = rest.trim().to_string();\r\n    43\t            } else if let Some(rest) = line.strip_prefix(\"WIRE \") {\r\n    44\t                wire = rest.trim().parse().unwrap_or(0);\r\n    45\t            } else if let Some(rest) = line.strip_prefix(\"REPLY \") {\r\n"]
[18.478948, "o", "    46\t                reply = rest.trim().to_string();\r\n    47\t            }\r\n    48\t        }\r\n    49\t        if !label.is_empty() {\r\n    50\t            out.push(Row {\r\n    51\t"]
[18.478964, "o", "                label,\r\n    52\t                wire,\r\n    53\t                reply,\r\n    54\t            });\r\n"]
[18.479105, "o", "    55\t        }\r\n    56\t    }\r\n    57\t    out\r\n    58\t}\r\n"]
[18.479241, "o", "===== /app/loomkit/loom.rs =====\r\n"]
[18.480299, "o", "     1\tuse crate::cards;\r\n     2\tuse std::fs;\r\n     3\t\r\n     4\tpub fn emit() -> i32 {\r\n     5\t    let rows = cards::load();\r\n     6\t    let _ = fs::create_dir_all(\"/app/mistwell\");\r\n     7\t    let _ = fs::create_dir_all(\"/app/loomkit\");\r\n     8\t    let names: Vec<String> = rows.iter().map(|r| format!(\"\\\"{}\\\"\", r.label)).collect();\r\n     9\t    let body = format!(\"{{\\\"names\\\":[{}]}}\\n\", names.join(\",\"));\r\n    10\t    let _ = fs::write(\"/app/mistwell/roster.json\", body);\r\n"]
[18.48041, "o", "    11\t    let lst = rows\r\n    12\t        .iter()\r\n    13\t        .map(|r| format!(\"{}\\t{}\\t{}\", r.label, r.wire, r.reply))\r\n    14\t        .collect::<Vec<_>>()\r\n    15\t        .join(\"\\n\")\r\n    16\t        + \"\\n\";\r\n    17\t    let _ = fs::write(\"/app/loomkit/emit.lst\", lst);\r\n    18\t    0\r\n    19\t}\r\n"]
[18.480555, "o", "===== /app/rimcap/span.rs =====\r\n"]
[18.481464, "o", "     1\tpub fn rib_a() -> usize {\r\n     2\t    8\r\n     3\t}\r\n"]
[18.48164, "o", "===== /app/hopmat/table.rs =====\r\n"]
[18.482489, "o", "     1\tuse crate::span;\r\n     2\t\r\n     3\tconst RAW: &str = include_str!(\"../loomkit/emit.lst\");\r\n     4\t\r\n     5\t#[derive(Clone)]\r\n     6\tpub struct Slot {\r\n     7\t    #[allow(dead_code)]\r\n     8\t    pub label: String,\r\n     9\t    pub reply: String,\r\n"]
[18.482613, "o", "    10\t}\r\n    11\t\r\n    12\timpl Default for Slot {\r\n    13\t    fn default() -> Self {\r\n    14\t        Self {\r\n    15\t            label: String::new(),\r\n    16\t            reply: \"fallthrough\".to_string(),\r\n    17\t        }\r\n    18\t    }\r\n    19\t}\r\n    20\t\r\n    21\tfn parse_line(line: &str) -> Option<(u8, Slot)> {\r\n    22\t    let mut parts = line.split('\\t');\r\n    23\t    let label = parts.next()?.trim().to_string();\r\n    24\t    let wire: u8 = parts.next()?.trim().parse().ok()?;\r\n    25\t    let reply = parts.next()?.trim().to_string();\r\n    26\t    if label.is_empty() {\r\n    27\t        return None;\r\n    28\t    }\r\n    29\t    Some((wire, Slot { label, reply }))\r\n    30\t}\r\n    31\t\r\n    32\tpub fn rib_b() -> Vec<Slot> {\r\n    33\t    let cap = span::rib_a();\r\n    34\t    let mut slots: Vec<Slot> = vec![Slot::default(); 256];\r\n    35\t    for (i, line) in RAW.lines().enumerate() {\r\n    36\t        if line.trim().is_empty() {\r\n    37\t            continue;\r\n    38\t        }\r\n    39\t        if let Some((_w, slot)) = parse_line(line) {\r\n    40\t            if i < cap {\r\n    41\t                slots[i] = slot;\r\n    42\t            }\r\n"]
[18.482684, "o", "    43\t        }\r\n    44\t    }\r\n    45\t    slots\r\n    46\t}\r\n    47\t\r\n    48\tpub fn tap(n: u8) -> i32 {\r\n    49\t    let slots = rib_b();\r\n    50\t    let row = &slots[n as usize];\r\n    51\t    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":\\\"{}\\\"}}\", n, row.reply);\r\n    52\t    0\r\n    53\t}\r\n"]
[18.482853, "o", "===== /app/lidpit/plug.rs =====\r\n"]
[18.483581, "o", "     1\tuse crate::cards;\r\n     2\tuse crate::loom;\r\n     3\tuse crate::tally;\r\n     4\tuse std::fs;\r\n     5\t\r\n     6\tpub fn rib_c() -> i32 {\r\n     7\t    let _ = tally::lines();\r\n     8\t    let _ = loom::emit();\r\n     9\t    let body = fs::read_to_string(\"/app/mistwell/roster.json\").unwrap_or_default();\r\n    10\t    let spec = cards::load();\r\n    11\t    let mut names: Vec<String> = Vec::new();\r\n"]
[18.483645, "o", "    12\t    for row in &spec {\r\n    13\t        if body.contains(&row.label) {\r\n    14\t            names.push(row.label.clone());\r\n    15\t        }\r\n    16\t    }\r\n    17\t    if names.len() != spec.len() {\r\n    18\t        let _ = fs::create_dir_all(\"/app/corkbay\");\r\n    19\t        let _ = fs::write(\r\n    20\t            \"/app/corkbay/seal.json\",\r\n    21\t            \"{\\\"served\\\":[],\\\"status\\\":\\\"open\\\"}\\n\",\r\n    22\t        );\r\n    23\t        return 1;\r\n    24\t    }\r\n    25\t    let served = names\r\n    26\t        .iter()\r\n    27\t        .map(|n| format!(\"\\\"{}\\\"\", n))\r\n    28\t        .collect::<Vec<_>>()\r\n    29\t        .join(\",\");\r\n"]
[18.483697, "o", "    30\t    let _ = fs::create_dir_all(\"/app/corkbay\");\r\n    31\t    let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"sealed\\\"}}\\n\", served);\r\n    32\t    let _ = fs::write(\"/app/corkbay/seal.json\", text);\r\n    33\t    0\r\n    34\t}\r\n"]
[18.483862, "o", "===== /app/lidpit/tally.rs =====\r\n"]
[18.484569, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn lines() -> usize {\r\n     4\t    fs::read_to_string(\"/app/loomkit/emit.lst\")\r\n     5\t        .unwrap_or_default()\r\n     6\t        .lines()\r\n     7\t        .filter(|l| !l.trim().is_empty())\r\n     8\t        .count()\r\n     9\t}\r\n"]
[18.484699, "o", "===== /app/stoke.sh =====\r\n"]
[18.485394, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin\r\n     5\trustc --edition 2021 -O /app/gaskcli/boot.rs -o /app/bin/gasketd\r\n"]
[18.485561, "o", "===== /app/opscribe/COUNT_SRC.txt =====\r\n"]
[18.486856, "o", "     1\tDesk note from last shift: coverage equals the line count of\r\n     2\t/app/loomkit/emit.lst versus how many cards sit under /app/buscards.\r\n     3\tIf those two numbers match, cork can treat the hopper as sealed.\r\n"]
