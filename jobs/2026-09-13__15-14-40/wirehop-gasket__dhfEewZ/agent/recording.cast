pp/buscards/i_vent.card:1:LABEL VENT_LINE\r\n/app/buscards/i_vent.card:2:WIRE 17\r\n/app/buscards/i_vent.card:3:REPLY vent-ok\r\n/app/buscards/c_valve.card:1:LABEL SET_VALVE\r\n/app/buscards/c_valve.card:2:WIRE 4\r\n/app/buscards/c_valve.card:3:REPLY valve-ok\r\n/app/buscards/b_pump.card:1:LABEL SET_PUMP\r\n/app/buscards/b_pump.card:2:WIRE 2\r\n/app/buscards/b_pump.card:3:REPLY pump-ok\r\n/app/buscards/e_press.card:1:LABEL READ_PRESS\r\n/app/buscards/e_press.card:2:WIRE 8\r\n/app/buscards/e_press.card:3:REPLY press-ok\r\n/app/buscards/h_watch.card:1:LABEL ACK_WATCH\r\n/app/buscards/h_watch.card:2:WIRE 15\r\n/app/buscards/h_watch.card:3:REPLY watch-ok\r\n/app/buscards/d_temp.card:1:LABEL READ_TEMP\r\n/app/buscards/d_temp.card:2:WIRE 7\r\n/app/buscards/d_temp.card:3:REPLY temp-ok\r\n/app/opscribe/MAP.txt:1:gasket hopper layout\r\n/app/opscribe/MAP.txt:4:gaskcli/boot.rs dispatches bind, jab, and cork.\r\n/app/opscribe/MAP.txt:14:bind refreshes /app/mistwell/roster.json and /app/loomkit/emit.lst.\r\n/app/opscribe/MAP.txt:15:cork writes /app/corkbay/seal.json.\r\n/app/opscribe/COUNT_SRC.txt:3:If those two numbers match, cork can treat the hopper as sealed.\r\n/app/slipread/scan.rs:17:            reply: \"fallthrough\".to_string(),\r\n/app/slipread/scan.rs:41:            if let Some(rest) = line.strip_prefix(\"LABEL \") {\r\n/app/slipread/scan.rs:43:            } else if let Some(rest) = line.strip_prefix(\"WIRE \") {\r\n/app/slipread/scan.rs:45:            } else if let Some(rest) = line.strip_prefix(\"REPLY \") {\r\n/app/lidpit/plug.rs:18:        let _ = fs::create_dir_all(\"/app/corkbay\");\r\n/app/lidpit/plug.rs:20:            \"/app/corkbay/seal.json\",\r\n/app/lidpit/plug.rs:30:    let _ = fs::create_dir_all(\"/app/corkbay\");\r\n/app/lidpit/plug.rs:31:    let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"sealed\\\"}}\\n\", served);\r\n/app/lidpit/plug.rs:32:    let _ = fs::write(\"/app/corkbay/seal.json\", text);\r\n/app/hopmat/table.rs:16:            reply: \"fallthrough\".to_string(),\r\n/app/gaskcli/usage.txt:1:gasketd bind\r\n/app/gaskcli/usage.txt:4:gasketd jab N\r\n/app/gaskcli/usage.txt:7:gasketd cork\r\n"]
