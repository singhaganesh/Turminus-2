[8.815369, "o", "LABEL VENT_LINE\r\nWIRE 17\r\nREPLY vent-ok\r\n"]
[8.815543, "o", "/app/buscards/c_valve.card\r\n"]
[8.816633, "o", "LABEL SET_VALVE\r\nWIRE 4\r\nREPLY valve-ok\r\n"]
[8.816772, "o", "/app/buscards/b_pump.card\r\n"]
[8.817959, "o", "LABEL SET_PUMP\r\nWIRE 2\r\nREPLY pump-ok\r\n"]
