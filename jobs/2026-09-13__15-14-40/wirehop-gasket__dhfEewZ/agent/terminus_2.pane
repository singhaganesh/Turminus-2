    14	fn main() {
    15	    let mut args = std::env::args().skip(1);
    16	    let cmd = args.next().unwrap_or_default();
    17	    let code = match cmd.as_str() {
    18	        "bind" => loom::emit(),
    19	        "jab" => {
    20	            let raw = args.next().unwrap_or_else(|| "0".to_string());
    21	            let n: u8 = raw.parse().unwrap_or(0);
    22	            table::tap(n)
    23	        }
    24	        "cork" => vat::rib_c(),
    25	        _ => {
    26	            eprintln!("usage: gasketd bind|jab N|cork");
    27	            2
    28	        }
    29	    };
    30	    std::process::exit(code);
    31	}
===== /app/slipread/scan.rs =====
     1	use std::fs;
     2	use std::path::Path;
     3	
     4	#[derive(Clone)]
     5	pub struct Row {
     6	    pub label: String,
     7	    #[allow(dead_code)]
     8	    pub wire: u8,
     9	    pub reply: String,
    10	}
    11	
    12	impl Default for Row {
    13	    fn default() -> Self {
    14	        Self {
    15	            label: String::new(),
    16	            wire: 0,
    17	            reply: "fallthrough".to_string(),
    18	        }
    19	    }
    20	}
    21	
    22	pub fn load() -> Vec<Row> {
    23	    let dir = Path::new("/app/buscards");
    24	    let mut names: Vec<_> = fs::read_dir(dir)
    25	        .map(|rd| {
    26	            rd.filter_map(|e| e.ok())
    27	                .map(|e| e.path())
    28	                .filter(|p| p.extension().map(|x| x == "card").unwrap_or(false))
    29	                .collect()
    30	        })
    31	        .unwrap_or_default();
    32	    names.sort();
    33	    let mut out = Vec::new();
    34	    for p in names {
    35	        let text = fs::read_to_string(&p).unwrap_or_default();
    36	        let mut label = String::new();
    37	        let mut wire: u8 = 0;
    38	        let mut reply = String::new();
    39	        for line in text.lines() {
    40	            let line = line.trim();
    41	            if let Some(rest) = line.strip_prefix("LABEL ") {
    42	                label = rest.trim().to_string();
    43	            } else if let Some(rest) = line.strip_prefix("WIRE ") {
    44	                wire = rest.trim().parse().unwrap_or(0);
    45	            } else if let Some(rest) = line.strip_prefix("REPLY ") {
    46	                reply = rest.trim().to_string();
    47	            }
    48	        }
    49	        if !label.is_empty() {
    50	            out.push(Row {
    51	                label,
    52	                wire,
    53	                reply,
    54	            });
    55	        }
    56	    }
    57	    out
    58	}
===== /app/loomkit/loom.rs =====
     1	use crate::cards;
     2	use std::fs;
     3	
     4	pub fn emit() -> i32 {
     5	    let rows = cards::load();
     6	    let _ = fs::create_dir_all("/app/mistwell");
     7	    let _ = fs::create_dir_all("/app/loomkit");
     8	    let names: Vec<String> = rows.iter().map(|r| format!("\"{}\"", r.label)).collect();
     9	    let body = format!("{{\"names\":[{}]}}\n", names.join(","));
    10	    let _ = fs::write("/app/mistwell/roster.json", body);
    11	    let lst = rows
    12	        .iter()
    13	        .map(|r| format!("{}\t{}\t{}", r.label, r.wire, r.reply))
    14	        .collect::<Vec<_>>()
    15	        .join("\n")
    16	        + "\n";
    17	    let _ = fs::write("/app/loomkit/emit.lst", lst);
    18	    0
    19	}
