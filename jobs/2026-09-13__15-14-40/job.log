Sending keys: ['cat > /app/gaskcli/boot.rs <<\'EOF\'\n#[path = "../slipread/scan.rs"]\nmod cards;\n#[path = "../rimcap/span.rs"]\nmod span;\n#[path = "../hopmat/table.rs"]\nmod table;\n#[path = "../lidpit/plug.rs"]\nmod vat;\n#[path = "../loomkit/loom.rs"]\nmod loom;\n#[path = "../lidpit/tally.rs"]\nmod tally;\n\nfn main() {\n    let mut args = std::env::args().skip(1);\n    let cmd = args.next().unwrap_or_default();\n    let code = match cmd.as_str() {\n        "bind" => loom::emit(),\n        "jab" => match args.next().and_then(|raw| raw.parse::<i64>().ok()) {\n            Some(n) => table::tap(n),\n            None => {\n                eprintln!("gasketd jab requires an integer");\n                2\n            }\n        },\n        "cork" => vat::rib_c(),\n        _ => {\n            eprintln!("usage: gasketd bind|jab N|cork");\n            2\n        }\n    };\n    std::process::exit(code);\n}\nEOF\ncat > /app/slipread/scan.rs <<\'EOF\'\nuse std::fs;\nuse std::path::Path;\n\n#[derive(Clone)]\npub struct Row {\n    pub label: String,\n    pub wire: i64,\n    pub reply: String,\n}\n\npub fn load() -> Vec<Row> {\n    let dir = Path::new("/app/buscards");\n    let mut names: Vec<_> = fs::read_dir(dir)\n        .map(|rd| {\n            rd.filter_map(|e| e.ok())\n                .map(|e| e.path())\n                .filter(|p| p.extension().map(|x| x == "card").unwrap_or(false))\n                .collect()\n        })\n        .unwrap_or_default();\n    names.sort();\n\n    let mut out = Vec::new();\n    for p in names {\n        let text = fs::read_to_string(&p).unwrap_or_default();\n        let mut label = String::new();\n        let mut wire: Option<i64> = None;\n        let mut reply = String::new();\n        for line in text.lines() {\n            let line = line.trim();\n            if let Some(rest) = line.strip_prefix("LABEL ") {\n                label = rest.trim().to_string();\n            } else if let Some(rest) = line.strip_prefix("WIRE ") {\n                wire = rest.trim().parse().ok();\n            } else if let Some(rest) = line.strip_prefix("REPLY ") {\n                reply = rest.trim().to_string();\n            }\n        }\n        if let Some(wire) = wire {\n            if !label.is_empty() && !reply.is_empty() {\n                out.push(Row { label, wire, reply });\n            }\n        }\n    }\n    out\n}\nEOF\ncat > /app/rimcap/span.rs <<\'EOF\'\nconst RAW: &str = include_str!("../loomkit/emit.lst");\n\npub fn rib_a() -> usize {\n    RAW.lines().filter(|line| !line.trim().is_empty()).count()\n}\nEOF\ncat > /app/hopmat/table.rs <<\'EOF\'\nuse crate::span;\nuse std::collections::HashMap;\n\nconst RAW: &str = include_str!("../loomkit/emit.lst");\n\n#[derive(Clone)]\npub struct Slot {\n    pub label: String,\n    pub reply: String,\n}\n\nfn parse_line(line: &str) -> Option<(i64, Slot)> {\n    let mut parts = line.split(\'\\t\');\n    let label = parts.next()?.trim().to_string();\n    let wire: i64 = parts.next()?.trim().parse().ok()?;\n    let reply = parts.next()?.trim().to_string();\n    if label.is_empty() || reply.is_empty() {\n        return None;\n    }\n    Some((wire, Slot { label, reply }))\n}\n\npub fn rib_b() -> HashMap<i64, Slot> {\n    let mut slots = HashMap::new();\n    for line in RAW.lines().filter(|line| !line.trim().is_empty()).take(span::rib_a()) {\n        if let Some((wire, slot)) = parse_line(line) {\n            slots.insert(wire, slot);\n        }\n    }\n    slots\n}\n\npub fn tap(n: i64) -> i32 {\n    let slots = rib_b();\n    let reply = slots.get(&n).map(|slot| slot.reply.as_str()).unwrap_or("fallthrough");\n    println!("{{\\"wire\\":{},\\"reply\\":\\"{}\\"}}", n, reply);\n    0\n}\nEOF\ncat > /app/lidpit/plug.rs <<\'EOF\'\nuse crate::cards;\nuse crate::loom;\nuse crate::table;\nuse crate::tally;\nuse std::fs;\n\npub fn rib_c() -> i32 {\n    let _ = loom::emit();\n    let spec = cards::load();\n    let hopper = table::rib_b();\n    let compiled_count = tally::lines();\n\n    let complete = compiled_count == spec.len()\n        && hopper.len() == spec.len()\n        && spec.iter().all(|row| {\n            hopper.get(&row.wire).map(|slot| {\n                slot.label == row.label && slot.reply == row.reply\n            }).unwrap_or(false)\n        });\n\n    let _ = fs::create_dir_all("/app/corkbay");\n    if !complete {\n        let served = spec.iter().filter(|row| {\n            hopper.get(&row.wire).map(|slot| {\n                slot.label == row.label && slot.reply == row.reply\n            }).unwrap_or(false)\n        }).map(|row| format!("\\"{}\\"", row.label)).collect::<Vec<_>>().join(",");\n        let text = format!("{{\\"served\\":[{}],\\"status\\":\\"open\\"}}\\n", served);\n        let _ = fs::write("/app/corkbay/seal.json", text);\n        return 1;\n    }\n\n    let served = spec.iter()\n        .map(|row| format!("\\"{}\\"", row.label))\n        .collect::<Vec<_>>()\n        .join(",");\n    let text = format!("{{\\"served\\":[{}],\\"status\\":\\"sealed\\"}}\\n", served);\n    let _ = fs::write("/app/corkbay/seal.json", text);\n    0\n}\nEOF\n/app/stoke.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
