[88.061648, "i", "set -e\nrm -rf /tmp/silo-save; cp -a /app/silo /tmp/silo-save\ncleanup() { rm -rf /app/silo; cp -a /tmp/silo-save /app/silo; }\ntrap cleanup EXIT\nrm -rf /app/silo; mkdir /app/silo\n/app/bin/crumbark lade /app/inbox/oak-a.slip\nid=$(sha256sum /app/inbox/oak-a.slip | cut -c1-32)\n/app/bin/crumbark wake\npython3 - <<PY\nimport json\nx=json.load(open('/app/silo/wake.json'))\nassert x == {'held':['$id'],'note':'ok','kind':'live'}, x\nPY\n/app/bin/crumbark pull \"$id\" > /tmp/pulled\ncmp /app/inbox/oak-a.slip /tmp/pulled\nbefore=$(stat -c%s /app/silo/pin.bin)\n/app/bin/crumbark nick /app/inbox/oak-e.slip\ntest \"$(stat -c%s /app/silo/pin.bin)\" = \"$before\"\n/app/bin/crumbark wake\npython3 - <<PY\nimport json\nx=json.load(open('/app/silo/wake.json'))\nassert x == {'held':['$id'],'note':'ok','kind':'live'}, x\nPY\n/app/bin/crumbark lade /app/inbox/oak-b.slip\npython3 - <<'PY'\np='/app/silo/pin.bin'\nb=bytearray(open(p,'rb').read())\nb[48+20] ^= 1\nopen(p,'wb').write(b)\nPY\nset +e\n/app/bin/crumbark wake\nrc=$?\nset -e\ntest \"$rc\" -ne 0\npython3 - <<PY\nimport json\nx=json.load(open('/app/silo/wake.json'))\nassert x == {'held':['$id'],'note':'gap','kind':'live'}, x\nPY\ncleanup\ntrap - EXIT\necho 'all isolated pipeline tests passed'\n"]
