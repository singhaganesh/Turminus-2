[22.975409, "o", "     1\timport java.util.zip.CRC32;\r\n     2\t\r\n     3\tpublic class Crc {\r\n     4\t    public static int of(byte[] a) {\r\n     5\t        CRC32 c = new CRC32();\r\n     6\t        c.update(a);\r\n     7\t        return (int) c.getValue();\r\n     8\t    }\r\n     9\t}\r\n"]
