[85.187607, "o", "import java.nio.file.Files;\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.file.Path;\r\n\u001b[?2004l\r\u001b[?2004h> import java.nio.file.Paths;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.187659, "o", "public class YankRun {\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.188473, "o", ">     public static void main(String[] args) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h>         if (args.length != 1) System.exit(2);\r\n\u001b[?2004l\r\u001b[?2004h>         byte[] id;\r\n\u001b[?2004l\r\u001b[?2004h>         try {\r\n\u001b[?2004l\r\u001b[?2004h>             id = hex(args[0]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.188603, "o", ">         } catch (IllegalArgumentException e) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.188829, "o", "            System.exit(2);"]
[85.188954, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             return;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[85.189007, "o", "\u001b[?2004h> "]
[85.189237, "o", "        byte[] got = MistSpan.find(Paths.get(\"/app/silo\"), id);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.189428, "o", "        if (got == null) System.exit(1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.189537, "o", "> "]
[85.18974, "o", "        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\r\n\u001b[?2004l\r\u001b[?2004h>         System.out.write(got);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.189876, "o", "\u001b[?2004h> "]
[85.190013, "o", "    static byte[] hex(String s) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.190071, "o", "        if (!s.matches(\"[0-9a-f]{32}\")) throw new IllegalArgumentException();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.190259, "o", "        byte[] out = new byte[16];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.190353, "o", "        for (int i = 0; i < out.length; i++)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.190539, "o", "            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\r\n\u001b[?2004l\r"]
[85.190583, "o", "\u001b[?2004h> "]
[85.19096, "o", "        return out;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
