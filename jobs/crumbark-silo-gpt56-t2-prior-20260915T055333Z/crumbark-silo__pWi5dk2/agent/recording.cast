[85.045209, "i", "python3 - <<'PY'\np='/app/recipit/LoomCue.java'\ns=open(p).read()\ns=s.replace('steps.sort(Comparator.comparingInt(x -> x.compute));', 'steps.sort(Comparator.comparingInt(x -> x.durable));')\nopen(p,'w').write(s)\n\np='/app/hitchbay/StowRun.java'\ns=open(p).read()\nstart=s.index('    static byte[] idOf(byte[] payload) throws Exception {')\nend=s.index('\\n    public static void main', start)\nreplacement='''    static byte[] idOf(byte[] payload) throws Exception {\n        MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\n        byte[] digest = md.digest(payload);\n        byte[] id = new byte[16];\n        System.arraycopy(digest, 0, id, 0, id.length);\n        return id;\n    }\n'''\ns=s[:start]+replacement+s[end:]\nopen(p,'w').write(s)\nPY\ncat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.Arrays;\nimport java.util.zip.CRC32;\n\npublic class MistSpan {\n    static final int ALIGN = 32;\n    static final int PIN_SIZE = 48;\n    static final byte[] MAGIC = new byte[] {'P', 'N', '0', '1'};\n\n    public static final class Row {\n        public final byte[] id;\n        public final byte[] payload;\n\n        Row(byte[] id, byte[] payload) {\n            this.id = id;\n            this.payload = payload;\n        }\n    }\n\n    public static Row row(byte[] pins, byte[] blob, int pos) throws Exception {\n        if (pos < 0 || pos > pins.length - PIN_SIZE) return null;\n        ByteBuffer bb = ByteBuffer.wrap(pins, pos, PIN_SIZE);\n        byte[] magic = new byte[4];\n        bb.get(magic);\n        if (!Arrays.equals(magic, MAGIC)) return null;\n        long off = bb.getLong();\n        int len = bb.getInt();\n        int checksum = bb.getInt();\n        byte[] id = new byte[16];\n        bb.get(id);\n        if (off < 0 || len < 0 || off > Integer.MAX_VALUE) return null;\n        long raw = 4L + len;\n        long padded = raw + ((ALIGN - (raw % ALIGN)) % ALIGN);\n        if (padded > Integer.MAX_VALUE || off > blob.length || padded > blob.length - off) return null;\n        int at = (int) off;\n        if (ByteBuffer.wrap(blob, at, 4).getInt() != len) return null;\n        byte[] payload = Arrays.copyOfRange(blob, at + 4, at + 4 + len);\n        CRC32 crc = new CRC32();\n        crc.update(payload);\n        if ((int) crc.getValue() != checksum) return null;\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\n        if (!Arrays.equals(id, Arrays.copyOf(digest, 16))) return null;\n        return new Row(id, payload);\n    }\n\n    public static byte[] find(Path silo, byte[] wanted) throws Exception {\n        if (wanted == null || wanted.length != 16) return null;\n        Path pp = silo.resolve(\"pin.bin\");\n        Path bp = silo.resolve(\"blob.bin\");\n        byte[] pins = Files.exists(pp) ? Files.readAllBytes(pp) : new byte[0];\n        byte[] blob = Files.exists(bp) ? Files.readAllBytes(bp) : new byte[0];\n        for (int pos = 0; pos + PIN_SIZE <= pins.length; pos += PIN_SIZE) {\n            Row r = row(pins, blob, pos);\n            if (r != null && Arrays.equals(r.id, wanted)) return r.payload;\n        }\n        return null;\n    }\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        byte[] payload = find(silo, wanted);\n        return payload == null ? new byte[0] : payload;\n    }\n}\nEOF\ncat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class HueWalk {\n    public static int orb_n(Path blobPath, Path pinPath, Path wakePath) throws Exception {\n        boolean pinExists = Files.exists(pinPath);\n        boolean blobExists = Files.exists(blobPath);\n        byte[] pins = pinExists ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = blobExists ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean gap = pinExists != blobExists || pins.length % MistSpan.PIN_SIZE != 0;\n        for (int pos = 0; pos + MistSpan.PIN_SIZE <= pi"]
[85.045646, "i", "ns.length; pos += MistSpan.PIN_SIZE) {\n            MistSpan.Row r = MistSpan.row(pins, blob, pos);\n            if (r == null) {\n                gap = true;\n            } else {\n                held.add(hex(r.id));\n            }\n        }\n        String note = gap ? \"gap\" : \"ok\";\n        String kind = held.isEmpty() ? \"void\" : \"live\";\n        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\" + note\n                + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\"}\";\n        Files.writeString(wakePath, json);\n        return gap ? 1 : 0;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 0xff));\n        return sb.toString();\n    }\n\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < held.size(); i++) {\n            if (i > 0) sb.append(',');\n            sb.append('\\\"').append(held.get(i)).append('\\\"');\n        }\n        return sb.append(']').toString();\n    }\n}\nEOF\ncat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class YankRun {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1) System.exit(2);\n        byte[] id;\n        try {\n            id = hex(args[0]);\n        } catch (IllegalArgumentException e) {\n            System.exit(2);\n            return;\n        }\n        byte[] got = MistSpan.find(Paths.get(\"/app/silo\"), id);\n        if (got == null) System.exit(1);\n        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\n        System.out.write(got);\n    }\n\n    static byte[] hex(String s) {\n        if (!s.matches(\"[0-9a-f]{32}\")) throw new IllegalArgumentException();\n        byte[] out = new byte[16];\n        for (int i = 0; i < out.length; i++)\n            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        return out;\n    }\n}\nEOF\n/app/bin/crumbark tamp\n"]
