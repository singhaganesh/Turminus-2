next();\n    match (args.next().as_deref(), args.next(), args.next()) {\n        (Some("sip"), None, None) => std::process::exit(qat::qat(DUMP, None)),\n        (Some("mark"), Some(slot), None) => std::process::exit(qat::qat(DUMP, Some(&slot))),\n        _ => {\n            eprintln!("usage: draughtpin sip | draughtpin mark SLOT");\n            std::process::exit(2);\n        }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/vatrib/qat.rs <<\'EOF\'\nuse std::ffi::CString;\nuse std::fs;\nuse std::os::raw::{c_char, c_int, c_void};\nuse crate::loom;\n\nconst RTLD_NOW: c_int = 2;\nextern "C" {\n    fn dlopen(filename: *const c_char, flags: c_int) -> *mut c_void;\n    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;\n    fn dlvsym(handle: *mut c_void, symbol: *const c_char, version: *const c_char) -> *mut c_void;\n}\ntype FoldFn = unsafe extern "C" fn(*const u8, usize, *mut u8, usize) -> isize;\n\nfn call(ptr: *mut c_void, blob: &[u8]) -> Result<Vec<u8>, i32> {\n    if ptr.is_null() { return Err(1); }\n    let f: FoldFn = unsafe { std::mem::transmute(ptr) };\n    let mut out = vec![0u8; blob.len()];\n    let n = unsafe { f(blob.as_ptr(), blob.len(), out.as_mut_ptr(), out.len()) };\n    if n < 0 || n as usize > out.len() { return Err(1); }\n    out.truncate(n as usize);\n    Ok(out)\n}\n\nfn json_string(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in s.chars() {\n        match c {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\u{08}\' => out.push_str("\\\\b"),\n            \'\\u{0c}\' => out.push_str("\\\\f"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if (c as u32) < 0x20 => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            _ => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn write_card(slot: &str, text: &str, kind: &str) -> Result<(), i32> {\n    fs::create_dir_all("/app/inkvat").map_err(|_| 1)?;\n    let body = format!("{{\\"slot\\":{},\\"text\\":{},\\"kind\\":{}}}\\n",\n        json_string(slot), json_string(text), json_string(kind));\n    fs::write("/app/inkvat/card.json", body).map_err(|_| 1)\n}\n\npub fn qat(path: &str, requested: Option<&str>) -> i32 {\n    let _ = fs::remove_file("/app/inkvat/SEAL");\n    let rules = match loom::folio() { Ok(v) => v, Err(_) => return 1 };\n    let blob = match fs::read(path) { Ok(v) if !v.is_empty() => v, _ => return 1 };\n    let slot = match requested {\n        Some(v) if v == rules.current || v == rules.compat => v,\n        Some(_) => return 1,\n        None => rules.current.as_str(),\n    };\n    let handle = unsafe { dlopen(b"/app/lib/libdraught.so\\0".as_ptr() as *const c_char, RTLD_NOW) };\n    if handle.is_null() { return 1; }\n    let symbol = match CString::new(rules.export.as_str()) { Ok(v) => v, Err(_) => return 1 };\n    let ptr = unsafe {\n        match requested {\n            None => dlsym(handle, symbol.as_ptr()),\n            Some(_) => {\n                let version = match CString::new(slot) { Ok(v) => v, Err(_) => return 1 };\n                dlvsym(handle, symbol.as_ptr(), version.as_ptr())\n            }\n        }\n    };\n    let out = match call(ptr, &blob) { Ok(v) => v, Err(v) => return v };\n\n    // An unversioned open must not silently bind the compatibility body.\n    if requested.is_none() {\n        let old = match CString::new(rules.compat.as_str()) { Ok(v) => v, Err(_) => return 1 };\n        let old_ptr = unsafe { dlvsym(handle, symbol.as_ptr(), old.as_ptr()) };\n        if let Ok(legacy) = call(old_ptr, &blob) {\n            if legacy == out { return 1; }\n        } else { return 1; }\n    }\n\n    let text = String::from_utf8_lossy(&out).into_owned();\n    let kind = if requested.is_some() { rules.mark_kind.as_str() } else { rules.sip_kind.as_str() };\n    if write_card(slot, &text, kind).is_err() { return 1; }\n    if fs::write("/app/inkvat/SEAL", "ok").is_err() { return 1; }\n    0\n}\nEOF\n/app/stoke.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
