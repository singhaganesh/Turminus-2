===== stemcask/wick.rs =====
     1	use core::slice;
     2	
     3	fn lower_only(s: &[u8], dst: &mut [u8]) -> usize {
     4	    let n = s.len().min(dst.len());
     5	    for i in 0..n {
     6	        dst[i] = s[i].to_ascii_lowercase();
     7	    }
     8	    n
     9	}
    10	
    11	fn full_fold(s: &[u8], dst: &mut [u8]) -> usize {
    12	    let mut i = 0;
    13	    let mut space = false;
    14	    for &b in s {
    15	        if i >= dst.len() {
    16	            break;
    17	        }
    18	        if b == b'\t' || b == b' ' || b == b'\n' || b == b'\r' {
    19	            if !space {
    20	                dst[i] = b' ';
    21	                i += 1;
    22	                space = true;
    23	            }
    24	            continue;
    25	        }
    26	        if b < 0x20 {
    27	            continue;
    28	        }
    29	        space = false;
    30	        dst[i] = b.to_ascii_lowercase();
    31	        i += 1;
    32	    }
    33	    while i > 0 && dst[i - 1] == b'/' {
    34	        i -= 1;
    35	    }
    36	    i
    37	}
    38	
    39	#[no_mangle]
    40	pub unsafe extern "C" fn wick_old(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {
    41	    if p.is_null() || dst.is_null() || cap == 0 {
    42	        return -1;
    43	    }
    44	    let s = slice::from_raw_parts(p, n);
    45	    let d = slice::from_raw_parts_mut(dst, cap);
    46	    lower_only(s, d) as isize
    47	}
    48	
    49	#[no_mangle]
    50	pub unsafe extern "C" fn wick_new(p: *const u8, n: usize, dst: *mut u8, cap: usize) -> isize {
    51	    if p.is_null() || dst.is_null() || cap == 0 {
    52	        return -1;
    53	    }
    54	    let s = slice::from_raw_parts(p, n);
    55	    let d = slice::from_raw_parts_mut(dst, cap);
    56	    full_fold(s, d) as isize
    57	}
