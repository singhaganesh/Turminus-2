[97.327502, "o", "> "]
[97.327519, "o", "        }\r\n\u001b[?2004l\r"]
[97.32776, "o", "\u001b[?2004h> "]
[97.329116, "o", "        let path = p.to_string_lossy().into_owned();\r\n\u001b[?2004l\r\u001b[?2004h>         let m = crate::parse::load(&path);\r\n\u001b[?2004l\r\u001b[?2004h>         if m.guid == [0; 16] {\r\n\u001b[?2004l\r\u001b[?2004h>             return Err(1);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         names.push(path);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     names.sort();\r\n\u001b[?2004l\r\u001b[?2004h>     if names.is_empty() { Err(1) } else { Ok(names) }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r::args().nth(2).unwrap_or_else(|| \"/app/dropwell\".into());\r\n    if crate::fold::rib_c(&[], Some(&root)).is_err() { return fail(1); }\r\n    let current = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return fail(c) };\r\n    let curr"]
[97.332625, "o", "\u001b[?2004hroot@372084ed49e2:/app# cat > /app/stamp.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.332863, "o", "pub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\r\n\u001b[?2004l\r\u001b[?2004h>     names.iter().map(|n| {\r\n\u001b[?2004l\r\u001b[?2004h>         let m = crate::parse::load(n);\r\n\u001b[?2004l\r\u001b[?2004h>         let key = match m.crash {\r\n\u001b[?2004l\r\u001b[?2004h>             Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.333344, "o", "            None => m.write_stamp as u64 * 10_000_000 + 116_444_736_000_000_000,\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.333422, "o", ">         };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.333537, "o", "        (n.clone(), key)\r\n\u001b[?2004l\r"]
[97.333657, "o", "\u001b[?2004h> "]
[97.333841, "o", "    }).collect()\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.33394, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\ru"]
[97.337617, "o", "\u001b[?2004hroot@372084ed49e2:/app# "]
[97.337863, "o", "cat > /app/fold.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.338005, "o", "use std::collections::HashMap;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.338107, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.338209, "o", "use std::path::Path;\r\n\u001b[?2004l\r"]
[97.338311, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.338419, "o", "fn old_sequences() -> HashMap<String, u32> {\r\n\u001b[?2004l\r"]
[97.338557, "o", "\u001b[?2004h> "]
[97.338672, "o", "    let mut out = HashMap::new();\r\n\u001b[?2004l\r"]
[97.338788, "o", "\u001b[?2004h> "]
[97.339107, "o", "    if let Ok(raw) = fs::read_to_string(\"/app/tidearc/lastgood.rec\") {\r\n\u001b[?2004l\r"]
[97.339302, "o", "\u001b[?2004h> "]
[97.339461, "o", "        for line in raw.lines() {\r\n\u001b[?2004l\r"]
[97.339505, "o", "\u001b[?2004h> "]
[97.340871, "o", "            let p: Vec<&str> = line.split_whitespace().collect();\r\n\u001b[?2004l\r\u001b[?2004h>             if p.len() >= 2 {\r\n\u001b[?2004l\rn fail(1); }\r\n  \u001b[?2004h>                 if let Ok(seq) = p[0].parse() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.341228, "o", "                    out.insert(p[1].to_string(), seq);\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.341632, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.341678, "o", "> "]
[97.341845, "o", "        }\r\n\u001b[?2004l\ro_s\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.341922, "o", "    out\r\n\u001b[?2004l\r)));\r\n   "]
[97.341942, "o", "\u001b[?2004h> "]
[97.34201, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.342144, "o", "\u001b[?2004h> "]
[97.342455, "o", "pub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\r\n\u001b[?2004l\r"]
[97.342726, "o", "\u001b[?2004h>     if let Some(r) = root {\r\n\u001b[?2004l\r"]
[97.342847, "o", "\u001b[?2004h> "]
[97.342958, "o", "        let want = fs::canonicalize(\"/app/dropwell\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[97.343044, "o", "\u001b[?2004h> "]
[97.343323, "o", "        let got = fs::canonicalize(r).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[97.343458, "o", "\u001b[?2004h> "]
[97.343569, "o", "        if got != want { return Err(1); }\r\n\u001b[?2004l\r"]
[97.34359, "o", "\u001b[?2004h> "]
[97.343672, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.343824, "o", "    if pairs.is_empty() { return Ok(Vec::new()); }\r\n\u001b[?2004l\r"]
[97.343918, "o", "\u001b[?2004h"]
[97.344246, "o", ">     let old = old_sequences();\r\n\u001b[?2004l\r\u001b[?2004h>     let mut rows = pairs.to_vec();\r\n\u001b[?2004l\r\u001b[?2004h>     rows.sort_by(|a, b| {\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.344343, "o", "> "]
[97.344607, "o", "        let an = Path::new(&a.0).file_name().unwrap_or_default().to_string_lossy();\r\n\u001b[?2004l\r"]
[97.344693, "o", "\u001b[?2004h> "]
[97.345227, "o", "        let bn = Path::new(&b.0).file_name().unwrap_or_default().to_string_lossy();\r\n\u001b[?2004l\r\u001b[?2004h>         match (old.get(an.as_ref()), old.get(bn.as_ref())) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.345359, "o", "            (Some(x), Some(y)) => x.cmp(y),\r\n\u001b[?2004l\r"]
[97.345401, "o", "\u001b[?2004h> "]
[97.345648, "o", "            (Some(_), None) => std::cmp::Ordering::Less,\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.345759, "o", "> "]
[97.345897, "o", "            (None, Some(_)) => std::cmp::Ordering::Greater,\r\n\u001b[?2004l\r"]
[97.345928, "o", "\u001b[?2004h"]
[97.346031, "o", ">             (None, None) => {\r\n"]
[97.346055, "o", "\u001b[?2004l\r"]
[97.346071, "o", "\u001b[?2004h> "]
[97.346358, "o", "                let am = crate::parse::load(&a.0);\r\n\u001b[?2004l\r"]
[97.346459, "o", "\u001b[?2004h> "]
[97.346628, "o", "                let bm = crate::parse::load(&b.0);\r\n\u001b[?2004l\r"]
[97.346709, "o", "\u001b[?2004h> "]
[97.346831, "o", "                a.1.cmp(&b.1)\r\n\u001b[?2004l\r"]
[97.346927, "o", "\u001b[?2004h> "]
[97.347114, "o", "                    .then_with(|| am.guid.cmp(&bm.guid))\r\n\u001b[?2004l\r"]
[97.347235, "o", "\u001b[?2004h> "]
[97.347483, "o", "                    .then_with(|| am.companion.cmp(&bm.companion))\r\n\u001b[?2004l\r"]
[97.347604, "o", "\u001b[?2004h> "]
[97.347728, "o", "                    .then_with(|| an.cmp(&bn))\r\n\u001b[?2004l\r"]
[97.34781, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[97.347892, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.347952, "o", ">     });\r\n\u001b[?2004l\r"]
[97.348024, "o", "\u001b[?2004h> "]
[97.348133, "o", "    Ok(rows.into_iter().map(|r| r.0).collect())\r\n\u001b[?2004l\r"]
[97.348221, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.348268, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[97.349566, "o", "\u001b[?2004hroot@372084ed49e2:/app# "]
[97.349654, "o", "cat > /app/deskbin/pipe.rs <<'RS'\r\n\u001b[?2004l\r"]
[97.349713, "o", "\u001b[?2004h> "]
[97.349752, "o", "use std::fs;\r\n\u001b[?2004l\r"]
[97.349797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.349844, "o", "\u001b[?2004h> "]
[97.349897, "o", "fn fail(c: i32) -> i32 {\r\n\u001b[?2004l\r"]
[97.349938, "o", "\u001b[?2004h> "]
[97.350046, "o", "    let _ = fs::create_dir_all(\"/app/kegbay\");\r\n\u001b[?2004l\r"]
[97.350089, "o", "\u001b[?2004h> "]
[97.350231, "o", "    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\r\n\u001b[?2004l\r"]
[97.350321, "o", "\u001b[?2004h"]
[97.350403, "o", ">     c\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.350514, "o", "pub fn fill() -> i32 {\r\n\u001b[?2004l\r"]
[97.350576, "o", "\u001b[?2004h> "]
[97.350682, "o", "    let _ = fs::create_dir_all(\"/app/kegbay\");\r\n\u001b[?2004l\r"]
[97.350726, "o", "\u001b[?2004h> "]
[97.350846, "o", "    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\r\n\u001b[?2004l\r"]
[97.35089, "o", "\u001b[?2004h> "]
[97.351082, "o", "    let names = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return fail(c) };\r\n\u001b[?2004l\r"]
[97.35116, "o", "\u001b[?2004h> "]
[97.351273, "o", "    let pairs = crate::stamp::rib_b(&names);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.351366, "o", "    let mut body = String::new();\r\n\u001b[?2004l\r"]
[97.351411, "o", "\u001b[?2004h> "]
[97.35157, "o", "    for (n, k) in pairs { body.push_str(&format!(\"{}\\t{}\\n\", n, k)); }\r\n\u001b[?2004l\r"]
[97.351612, "o", "\u001b[?2004h> "]
[97.351802, "o", "    match fs::write(\"/app/kegbay/pairs.tmp\", body) { Ok(_) => 0, Err(_) => fail(1) }\r\n\u001b[?2004l\r"]
[97.351849, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.351903, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[97.353069, "o", "\u001b[?2004hroot@372084ed49e2:/app# "]
[97.353224, "o", "cat > /app/deskbin/emit.rs <<'RS'\r\n\u001b[?2004l\r"]
[97.353309, "o", "\u001b[?2004h> "]
[97.35338, "o", "use std::collections::HashSet;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.353462, "o", "use std::fs;\r\n\u001b[?2004l\r"]
[97.353525, "o", "\u001b[?2004h> "]
[97.353581, "o", "use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.353644, "o", "\u001b[?2004h> "]
[97.353693, "o", "fn fail(c: i32) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.353742, "o", "> "]
[97.353841, "o", "    let _ = fs::create_dir_all(\"/app/kegbay\");\r\n\u001b[?2004l\r"]
[97.353894, "o", "\u001b[?2004h> "]
[97.354013, "o", "    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\r\n\u001b[?2004l\r"]
[97.35407, "o", "\u001b[?2004h> "]
[97.354126, "o", "    c\r\n\u001b[?2004l\r"]
[97.354189, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.354239, "o", "\u001b[?2004h> "]
[97.354296, "o", "fn read_pairs() -> Vec<(String, u64)> {\r\n\u001b[?2004l\r"]
[97.354346, "o", "\u001b[?2004h> "]
[97.354584, "o", "    fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default().lines().filter_map(|line| {\r\n\u001b[?2004l\r"]
[97.354651, "o", "\u001b[?2004h> "]
[97.354731, "o", "        let mut p = line.split('\\t');\r\n\u001b[?2004l\r"]
[97.354813, "o", "\u001b[?2004h> "]
[97.354973, "o", "        Some((p.next()?.to_string(), p.next()?.parse().ok()?))\r\n\u001b[?2004l\r"]
[97.355042, "o", "\u001b[?2004h> "]
[97.355128, "o", "    }).collect()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.355215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.3553, "o", "pub fn finish() -> i32 {\r\n\u001b[?2004l\r"]
[97.355323, "o", "\u001b[?2004h"]
[97.35534, "o", "> "]
[97.355538, "o", "    let pairs = read_pairs();\r\n\u001b[?2004l\r"]
[97.355573, "o", "\u001b[?2004h> "]
[97.355698, "o", "    if pairs.is_empty() { return fail(1); }\r\n\u001b[?2004l\r"]
[97.356307, "o", "\u001b[?2004h>     let names = match crate::fold::rib_c(&pairs, None) { Ok(v) if !v.is_empty() => v, Ok(_) => return fail(1), Err(c) => return fail(c) };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.356403, "o", "    let mut body = String::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.356504, "o", "    for (i, n) in names.iter().enumerate() {\r\n\u001b[?2004l\r"]
[97.35656, "o", "\u001b[?2004h> "]
[97.356635, "o", "        let m = crate::parse::load(n);\r\n\u001b[?2004l\r"]
[97.356687, "o", "\u001b[?2004h> "]
[97.356923, "o", "        body.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, n, crate::parse::guid_hex(&m.guid)));\r\n\u001b[?2004l\r"]
[97.357014, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[97.357111, "o", "\u001b[?2004h> "]
[97.357265, "o", "    match fs::write(\"/app/kegbay/ribbon.txt\", body) { Ok(_) => 0, Err(_) => fail(1) }\r\n\u001b[?2004l\r"]
[97.357318, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[97.357378, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[97.357429, "o", "\u001b[?2004h> "]
[97.357477, "o", "pub fn pour() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.357675, "o", "    let root = std::env::args().nth(2).unwrap_or_else(|| \"/app/dropwell\".into());\r\n\u001b[?2004l\r"]
[97.357724, "o", "\u001b[?2004h> "]
[97.357876, "o", "    if crate::fold::rib_c(&[], Some(&root)).is_err() { return fail(1); }\r\n\u001b[?2004l\r"]
[97.357923, "o", "\u001b[?2004h> "]
[97.35811, "o", "    let current = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return fail(c) };\r\n\u001b[?2004l\r"]
[97.358157, "o", "\u001b[?2004h> "]
[97.358313, "o", "    let current_set: HashSet<String> = current.into_iter().collect();\r\n\u001b[?2004l\r"]
[97.358361, "o", "\u001b[?2004h> "]
[97.358604, "o", "    let ribbon = match fs::read_to_string(\"/app/kegbay/ribbon.txt\") { Ok(v) => v, Err(_) => return fail(1) };\r\n\u001b[?2004l\r"]
[97.358651, "o", "\u001b[?2004h> "]
[97.358716, "o", "    let mut rows = Vec::new();\r\n\u001b[?2004l\r"]
[97.358763, "o", "\u001b[?2004h> "]
[97.358864, "o", "    let mut seen = HashSet::new();\r\n\u001b[?2004l\r"]
[97.358943, "o", "\u001b[?2004h> "]
[97.359015, "o", "    for line in ribbon.lines() {\r\n\u001b[?2004l\r"]
[97.359074, "o", "\u001b[?2004h> "]
[97.359221, "o", "        let p: Vec<&str> = line.split('\\t').collect();\r\n\u001b[?2004l\r"]
[97.359281, "o", "\u001b[?2004h> "]
[97.359385, "o", "        if p.len() != 3 { return fail(1); }\r\n\u001b[?2004l\r"]
[97.359442, "o", "\u001b[?2004h> "]
[97.359686, "o", "        let seq: u32 = match p[0].parse() { Ok(v) => v, Err(_) => return fail(1) };\r\n\u001b[?2004l\r"]
[97.359754, "o", "\u001b[?2004h> "]
[97.359817, "o", "        let path = p[1].to_string();\r\n\u001b[?2004l\r"]
[97.359885, "o", "\u001b[?2004h> "]
[97.36009, "o", "        if !current_set.contains(&path) || !seen.insert(path.clone()) { return fail(1); }\r\n\u001b[?2004l\r"]
[97.360176, "o", "\u001b[?2004h> "]
[97.360254, "o", "        let digest = crate::sum::hex_file(&path);\r\n\u001b[?2004l\r"]
[97.360334, "o", "\u001b[?2004h> "]
[97.360593, "o", "        if digest.len() != 64 || !digest.bytes().all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase()) { return fail(1); }\r\n\u001b[?2004l\r"]
[97.360628, "o", "\u001b[?2004h> "]
[97.360896, "o", "        let name = Path::new(&path).file_name().unwrap_or_default().to_string_lossy().into_owned();\r\n\u001b[?2004l\r"]
[97.360978, "o", "\u001b[?2004h> "]
[97.361056, "o", "        rows.push((seq, name, digest, p[2].to_string()));\r\n\u001b[?2004l\r"]
[97.361121, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[97.361193, "o", "\u001b[?2004h> "]
[97.361336, "o", "    if rows.is_empty() || seen != current_set { return fail(1); }\r\n\u001b[?2004l\r"]
[97.361392, "o", "\u001b[?2004h"]
[97.361442, "o", "> "]
[97.361623, "o", "    for (i, row) in rows.iter().enumerate() { if row.0 != (i + 1) as u32 { return fail(1); } }\r\n\u001b[?2004l\r"]
[97.361684, "o", "\u001b[?2004h> "]
[97.361891, "o", "    let mut json = format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\", (rows.len() + 2) / 3);\r\n\u001b[?2004l\r"]
[97.361938, "o", "\u001b[?2004h"]
[97.361978, "o", "> "]
[97.362116, "o", "    for (i, (seq, name, digest, guid)) in rows.iter().enumerate() {\r\n\u001b[?2004l\r"]
[97.362182, "o", "\u001b[?2004h> "]
[97.362281, "o", "        if i != 0 { json.push(','); }\r\n\u001b[?2004l\r"]
