[97.324502, "i", "cat > /app/walk.rs <<'RS'\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let root = \"/app/dropwell\";\n    let rd = fs::read_dir(root).map_err(|_| 1)?;\n    let mut names = Vec::new();\n    for ent in rd {\n        let ent = ent.map_err(|_| 1)?;\n        let p = ent.path();\n        if !p.is_file() || p.extension().and_then(|s| s.to_str()) != Some(\"clat\") {\n            continue;\n        }\n        let path = p.to_string_lossy().into_owned();\n        let m = crate::parse::load(&path);\n        if m.guid == [0; 16] {\n            return Err(1);\n        }\n        names.push(path);\n    }\n    names.sort();\n    if names.is_empty() { Err(1) } else { Ok(names) }\n}\nRS\ncat > /app/stamp.rs <<'RS'\npub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\n    names.iter().map(|n| {\n        let m = crate::parse::load(n);\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => m.write_stamp as u64 * 10_000_000 + 116_444_736_000_000_000,\n        };\n        (n.clone(), key)\n    }).collect()\n}\nRS\ncat > /app/fold.rs <<'RS'\nuse std::collections::HashMap;\nuse std::fs;\nuse std::path::Path;\n\nfn old_sequences() -> HashMap<String, u32> {\n    let mut out = HashMap::new();\n    if let Ok(raw) = fs::read_to_string(\"/app/tidearc/lastgood.rec\") {\n        for line in raw.lines() {\n            let p: Vec<&str> = line.split_whitespace().collect();\n            if p.len() >= 2 {\n                if let Ok(seq) = p[0].parse() {\n                    out.insert(p[1].to_string(), seq);\n                }\n            }\n        }\n    }\n    out\n}\n\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\n    if let Some(r) = root {\n        let want = fs::canonicalize(\"/app/dropwell\").map_err(|_| 1)?;\n        let got = fs::canonicalize(r).map_err(|_| 1)?;\n        if got != want { return Err(1); }\n    }\n    if pairs.is_empty() { return Ok(Vec::new()); }\n    let old = old_sequences();\n    let mut rows = pairs.to_vec();\n    rows.sort_by(|a, b| {\n        let an = Path::new(&a.0).file_name().unwrap_or_default().to_string_lossy();\n        let bn = Path::new(&b.0).file_name().unwrap_or_default().to_string_lossy();\n        match (old.get(an.as_ref()), old.get(bn.as_ref())) {\n            (Some(x), Some(y)) => x.cmp(y),\n            (Some(_), None) => std::cmp::Ordering::Less,\n            (None, Some(_)) => std::cmp::Ordering::Greater,\n            (None, None) => {\n                let am = crate::parse::load(&a.0);\n                let bm = crate::parse::load(&b.0);\n                a.1.cmp(&b.1)\n                    .then_with(|| am.guid.cmp(&bm.guid))\n                    .then_with(|| am.companion.cmp(&bm.companion))\n                    .then_with(|| an.cmp(&bn))\n            }\n        }\n    });\n    Ok(rows.into_iter().map(|r| r.0).collect())\n}\nRS\ncat > /app/deskbin/pipe.rs <<'RS'\nuse std::fs;\n\nfn fail(c: i32) -> i32 {\n    let _ = fs::create_dir_all(\"/app/kegbay\");\n    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\n    c\n}\n\npub fn fill() -> i32 {\n    let _ = fs::create_dir_all(\"/app/kegbay\");\n    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\n    let names = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return fail(c) };\n    let pairs = crate::stamp::rib_b(&names);\n    let mut body = String::new();\n    for (n, k) in pairs { body.push_str(&format!(\"{}\\t{}\\n\", n, k)); }\n    match fs::write(\"/app/kegbay/pairs.tmp\", body) { Ok(_) => 0, Err(_) => fail(1) }\n}\nRS\ncat > /app/deskbin/emit.rs <<'RS'\nuse std::collections::HashSet;\nuse std::fs;\nuse std::path::Path;\n\nfn fail(c: i32) -> i32 {\n    let _ = fs::create_dir_all(\"/app/kegbay\");\n    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\n    c\n}\nfn read_pairs() -> Vec<(String, u64)> {\n    fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default().lines().filter_map(|line| {\n        let mut p = line.split('\\t');\n        Some((p.next()?.to_string(), p.next()?.parse().ok()?))\n    }).collect()\n}\n\npub fn finish() -> i32 {\n    let pairs = read_pairs();\n    if pairs.is_empty() { return fail(1); }\n    let names = match crate::fold::rib_c(&pairs"]
[97.324678, "i", ", None) { Ok(v) if !v.is_empty() => v, Ok(_) => return fail(1), Err(c) => return fail(c) };\n    let mut body = String::new();\n    for (i, n) in names.iter().enumerate() {\n        let m = crate::parse::load(n);\n        body.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, n, crate::parse::guid_hex(&m.guid)));\n    }\n    match fs::write(\"/app/kegbay/ribbon.txt\", body) { Ok(_) => 0, Err(_) => fail(1) }\n}\n\npub fn pour() -> i32 {\n    let root = std::env::args().nth(2).unwrap_or_else(|| \"/app/dropwell\".into());\n    if crate::fold::rib_c(&[], Some(&root)).is_err() { return fail(1); }\n    let current = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return fail(c) };\n    let current_set: HashSet<String> = current.into_iter().collect();\n    let ribbon = match fs::read_to_string(\"/app/kegbay/ribbon.txt\") { Ok(v) => v, Err(_) => return fail(1) };\n    let mut rows = Vec::new();\n    let mut seen = HashSet::new();\n    for line in ribbon.lines() {\n        let p: Vec<&str> = line.split('\\t').collect();\n        if p.len() != 3 { return fail(1); }\n        let seq: u32 = match p[0].parse() { Ok(v) => v, Err(_) => return fail(1) };\n        let path = p[1].to_string();\n        if !current_set.contains(&path) || !seen.insert(path.clone()) { return fail(1); }\n        let digest = crate::sum::hex_file(&path);\n        if digest.len() != 64 || !digest.bytes().all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase()) { return fail(1); }\n        let name = Path::new(&path).file_name().unwrap_or_default().to_string_lossy().into_owned();\n        rows.push((seq, name, digest, p[2].to_string()));\n    }\n    if rows.is_empty() || seen != current_set { return fail(1); }\n    for (i, row) in rows.iter().enumerate() { if row.0 != (i + 1) as u32 { return fail(1); } }\n    let mut json = format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\", (rows.len() + 2) / 3);\n    for (i, (seq, name, digest, guid)) in rows.iter().enumerate() {\n        if i != 0 { json.push(','); }\n        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\", seq, name, digest, guid));\n    }\n    json.push_str(\"]}\\n\");\n    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\n    for (seq, name, digest, guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, guid)); }\n    if fs::write(\"/app/kegbay/upload.json\", json).is_err() || fs::write(\"/app/kegbay/batch.tsv\", tsv).is_err() { return fail(1); }\n    if fs::write(\"/app/kegbay/MARK\", \"ok\").is_err() { return 1; }\n    0\n}\nRS\n/app/fat.sh\nfile /app/bin/clatter; /app/bin/clatter tallow; echo tallow=$? MARK=$(cat /app/kegbay/MARK); /app/bin/clatter pour; echo pour=$? MARK=$(cat /app/kegbay/MARK); cat /app/kegbay/upload.json; cat /app/kegbay/batch.tsv\n"]
[97.325072, "o", "cat > /app/walk.rs <<'RS'\r\n"]
