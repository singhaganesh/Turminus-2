[21.827239, "i", "ls -l /app/bin/clatter /app/deskbin/* /app/*.rs /app/dropwalk/*; printf '%s\\n' '--- main.rs ---'; sed -n '1,240p' /app/deskbin/main.rs; printf '%s\\n' '--- pipe.rs ---'; sed -n '1,300p' /app/deskbin/pipe.rs; printf '%s\\n' '--- parse.rs ---'; sed -n '1,300p' /app/deskbin/parse.rs; printf '%s\\n' '--- emit.rs ---'; sed -n '1,300p' /app/deskbin/emit.rs; printf '%s\\n' '--- sum.rs ---'; sed -n '1,300p' /app/deskbin/sum.rs; printf '%s\\n' '--- OTHER ---'; for f in /app/fold.rs /app/stamp.rs /app/walk.rs /app/dropwalk/mtime.rs /app/deskbin/usage.txt /app/opsheet/MTIME_NOTE.txt /app/tidearc/README.txt /app/fat.sh; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- HEX ---'; xxd /app/dropwell/a.clat; xxd /app/dropwell/a2.clat\n"]
[21.830154, "o", "ls -l /app/bin/clatter /app/deskbin/* /app/*.rs /app/dropwalk/*; printf '%s\\n' '--- main.rs ---'; sed -n '1,240p' /app/deskbin/main.rs; printf '%s\\n' '--- pipe.rs ---'; sed -n '1,300p' /app/deskbin/pipe.rs; printf '%s\\n' '--- parse.rs ---'; sed -n '1,300p' /app/deskbin/parse.rs; printf '%s\\n' '--- emit.rs ---'; sed -n '1,300p' /app/deskbin/emit.rs; printf '%s\\n' '--- sum.rs ---'; sed -n '1,300p' /app/deskbin/sum.rs; printf '%s\\n' '--- OTHER ---'; for f in /app/fold.rs /app/stamp.rs /app/walk.rs /app/dropwalk/mtime.rs /app/deskbin/usage.txt /app/opsheet/MTIME_NOTE.txt /app/tidearc/README.txt /app/fat.sh; do echo \"### $f\"; cat \"$f\"; done; printf '%s\\n' '--- HEX ---'; xxd /app/dropwell/a.clat; xxd /app/dropwell/a2.clat\r\n"]
[21.830229, "o", "\u001b[?2004l\r"]
[21.832187, "o", "-rwxr-xr-x 1 root root 4121760 Sep 11 14:09 /app/bin/clatter\r\n-rw-rw-r-- 1 root root    2883 Sep 11 13:07 /app/deskbin/emit.rs\r\n"]
[21.832333, "o", "-rw-rw-r-- 1 root root     666 Sep 11 13:34 /app/deskbin/main.rs\r\n-rw-rw-r-- 1 root root    1687 Sep 11 13:18 /app/deskbin/parse.rs\r\n-rw-rw-r-- 1 root root     539 Sep 11 13:08 /app/deskbin/pipe.rs\r\n-rw-rw-r-- 1 root root     307 Sep 11 13:44 /app/deskbin/sum.rs\r\n-rw-rw-r-- 1 root root      34 Sep 11 13:15 /app/deskbin/usage.txt\r\n-rw-rw-r-- 1 root root     551 Sep 11 13:07 /app/dropwalk/mtime.rs\r\n-rw-rw-r-- 1 root root     651 Sep 11 14:08 /app/fold.rs\r\n-rw-rw-r-- 1 root root     356 Sep 11 13:17 /app/stamp.rs\r\n-rw-rw-r-- 1 root root     744 Sep 11 13:34 /app/walk.rs\r\n"]
[21.832505, "o", "--- main.rs ---\r\n"]
[21.833708, "o", "#[path = \"parse.rs\"]\r\nmod parse;\r\n#[path = \"sum.rs\"]\r\nmod sum;\r\n#[path = \"../walk.rs\"]\r\nmod walk;\r\n#[path = \"../stamp.rs\"]\r\nmod stamp;\r\n#[path = \"../fold.rs\"]\r\nmod fold;\r\n"]
[21.833816, "o", "#[path = \"pipe.rs\"]\r\nmod pipe;\r\n#[path = \"emit.rs\"]\r\nmod emit;\r\n\r\nfn main() {\r\n    let arg = std::env::args().nth(1).unwrap_or_default();\r\n    let code = match arg.as_str() {\r\n        \"tallow\" => {\r\n            let a = pipe::fill();\r\n            if a != 0 {\r\n                a\r\n            } else {\r\n                emit::finish()\r\n            }\r\n        }\r\n        \"pour\" => emit::pour(),\r\n        _ => {\r\n            eprintln!(\"usage: clatter tallow|pour\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[21.834035, "o", "--- pipe.rs ---\r\n"]
[21.83664, "o", "use std::fs;\r\n\r\npub fn fill() -> i32 {\r\n    match crate::walk::rib_a() {\r\n        Err(c) => {\r\n            let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n            c\r\n        }\r\n        Ok(names) => {\r\n            let pairs = crate::stamp::rib_b(&names);\r\n            fs::create_dir_all(\"/app/kegbay\").ok();\r\n            let mut body = String::new();\r\n            for (n, k) in pairs {\r\n                body.push_str(&format!(\"{}\\t{}\\n\", n, k));\r\n            }\r\n            fs::write(\"/app/kegbay/pairs.tmp\", body).ok();\r\n            0\r\n        }\r\n    }\r\n}\r\n"]
[21.837427, "o", "--- parse.rs ---\r\n"]
[21.839749, "o", "use std::fs;\r\n\r\n#[allow(dead_code)]\r\npub struct Meta {\r\n    pub write_stamp: u32,\r\n    pub crash: Option<(u32, u32)>,\r\n    pub guid: [u8; 16],\r\n    pub companion: u8,\r\n}\r\n\r\npub fn load(path: &str) -> Meta {\r\n    let b = fs::read(path).unwrap_or_default();\r\n    if b.len() < 12 || &b[0..4] != b\"CLAT\" {\r\n        return Meta {\r\n            write_stamp: 0,\r\n            crash: None,\r\n            guid: [0; 16],\r\n            companion: 0,\r\n"]
[21.840052, "o", "        };\r\n    }\r\n    let write_stamp = u32::from_le_bytes(b[6..10].try_into().unwrap());\r\n    let n = u16::from_le_bytes(b[10..12].try_into().unwrap()) as usize;\r\n    let mut crash = None;\r\n    let mut guid = [0u8; 16];\r\n    let mut companion = 0u8;\r\n    let mut off = 12usize;\r\n    for _ in 0..n {\r\n        if off + 12 > b.len() {\r\n            break;\r\n        }\r\n        let st = u32::from_le_bytes(b[off..off + 4].try_into().unwrap());\r\n        let rva = u32::from_le_bytes(b[off + 4..off + 8].try_into().unwrap()) as usize;\r\n        let sz = u32::from_le_bytes(b[off + 8..off + 12].try_into().unwrap()) as usize;\r\n        off += 12;\r\n        if rva + sz > b.len() {\r\n            continue;\r\n        }\r\n        let sl = &b[rva..rva + sz];\r\n        if st == 3 && sl.len() >= 8 {\r\n            let lo = u32::from_le_bytes(sl[0..4].try_into().unwrap());\r\n            let hi = u32::from_le_bytes(sl[4..8].try_into().unwrap());\r\n            crash = Some((lo, hi));\r\n        }\r\n        if st == 15 && sl.len() >= 17 {\r\n            guid.copy_from_slice(&sl[0..16]);\r\n            companion = sl[16];\r\n        }\r\n    }\r\n    Meta {\r\n        write_stamp,\r\n        crash,\r\n        guid,\r\n        companion,\r\n    }\r\n}\r\n\r\npub fn guid_hex(g: &[u8; 16]) -> String {\r\n    g.iter().map(|x| format!(\"{:02x}\", x)).collect()\r\n}\r\n"]
[21.840511, "o", "--- emit.rs ---\r\n"]
[21.842773, "o", "use std::fs;\r\nuse std::path::Path;\r\n\r\nfn read_pairs() -> Vec<(String, u64)> {\r\n    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default();\r\n    let mut v = Vec::new();\r\n    for line in raw.lines() {\r\n        let mut it = line.split('\\t');\r\n        if let (Some(n), Some(k)) = (it.next(), it.next()) {\r\n            if let Ok(u) = k.parse::<u64>() {\r\n                v.push((n.to_string(), u));\r\n            }\r\n        }\r\n    }\r\n    v\r\n}\r\n\r\npub fn finish() -> i32 {\r\n    let pairs = read_pairs();\r\n    match crate::fold::rib_c(&pairs, None) {\r\n        Err(c) => c,\r\n        Ok(names) => {\r\n            fs::create_dir_all(\"/app/kegbay\").ok();\r\n            let mut body = String::new();\r\n            for (i, n) in names.iter().enumerate() {\r\n                let m = crate::parse::load(n);\r\n                body.push_str(&format!(\r\n                    \"{}\\t{}\\t{}\\n\",\r\n                    i + 1,\r\n                    n,\r\n                    crate::parse::guid_hex(&m.guid)\r\n                ));\r\n            }\r\n            fs::write(\"/app/kegbay/ribbon.txt\", body).ok();\r\n            0\r\n        }\r\n    }\r\n}\r\n\r\npub fn pour() -> i32 {\r\n    let arg = std::env::args().nth(2);\r\n    let root = arg.unwrap_or_else(|| \"/app/dropwell\".to_string());\r\n    match crate::fold::rib_c(&[], Some(&root)) {\r\n        Err(c) => {\r\n            let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n            return c;\r\n        }\r\n        Ok(_) => {}\r\n    }\r\n    let ribbon = fs::read_to_string(\"/app/kegbay/ribbon.txt\").unwrap_or_default();\r\n    let mut rows: Vec<(u32, String, String, String)> = Vec::new();\r\n    for line in ribbon.lines() {\r\n        let p: Vec<&str> = line.split('\\t').collect();\r\n        if p.len() < 3 {\r\n            continue;\r\n        }\r\n        let seq: u32 = p[0].parse().unwrap_or(0);\r\n        let name = p[1].to_string();\r\n        let g = p[2].to_string();\r\n        let digest = crate::sum::hex_file(&name);\r\n        rows.push((seq, Path::new(&name).file_name().unwrap().to_string_lossy().to_string(), digest, g));\r\n    }\r\n    let n = rows.len();\r\n    let batches = if n == 0 { 0 } else { (n + 2) / 3 };\r\n    let mut json = String::from(\"{\\\"batch_count\\\":\");\r\n"]
[21.842892, "o", "    json.push_str(&batches.to_string());\r\n    json.push_str(\",\\\"entries\\\":[\");\r\n    for (i, (seq, name, digest, g)) in rows.iter().enumerate() {\r\n        if i > 0 {\r\n            json.push(',');\r\n        }\r\n        json.push_str(&format!(\r\n            \"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",\r\n            seq, name, digest, g\r\n        ));\r\n    }\r\n    json.push_str(\"]}\\n\");\r\n    fs::create_dir_all(\"/app/kegbay\").ok();\r\n    fs::write(\"/app/kegbay/upload.json\", json).ok();\r\n    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n    for (seq, name, digest, g) in &rows {\r\n        tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, g));\r\n    }\r\n    fs::write(\"/app/kegbay/batch.tsv\", tsv).ok();\r\n    fs::write(\"/app/kegbay/MARK\", \"ok\").ok();\r\n    0\r\n}\r\n"]
[21.8434, "o", "--- sum.rs ---\r\n"]
[21.844617, "o", "use std::process::Command;\r\n\r\npub fn hex_file(path: &str) -> String {\r\n    let out = Command::new(\"sha256sum\")\r\n        .arg(path)\r\n        .output()\r\n        .ok()\r\n        .and_then(|o| String::from_utf8(o.stdout).ok())\r\n        .unwrap_or_default();\r\n    out.split_whitespace().next().unwrap_or(\"\").to_string()\r\n}\r\n"]
[21.844896, "o", "--- OTHER ---\r\n"]
[21.844989, "o", "### /app/fold.rs\r\n"]
[21.845735, "o", "use std::collections::HashMap;\r\n\r\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\r\n    if let Some(r) = root {\r\n        if r.is_empty() {\r\n            return Err(1);\r\n        }\r\n    }\r\n    if pairs.is_empty() {\r\n        return Ok(Vec::new());\r\n    }\r\n    let mut by: HashMap<[u8; 16], Vec<(u64, String)>> = HashMap::new();\r\n    for (n, k) in pairs {\r\n        let m = crate::parse::load(n);\r\n        by.entry(m.guid).or_default().push((*k, n.clone()));\r\n    }\r\n    let mut out = Vec::new();\r\n    for (_g, mut rows) in by {\r\n        rows.sort_by_key(|r| r.0);\r\n        out.extend(rows.into_iter().map(|r| r.1));\r\n    }\r\n    Ok(out)\r\n}\r\n"]
[21.845901, "o", "### /app/stamp.rs\r\n"]
[21.846638, "o", "pub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\r\n    let mut out = Vec::new();\r\n    for n in names {\r\n        let m = crate::parse::load(n);\r\n        let key = if let Some((lo, hi)) = m.crash {\r\n            ((lo as u64) << 32) | (hi as u64)\r\n        } else {\r\n            m.write_stamp as u64\r\n        };\r\n        out.push((n.clone(), key));\r\n    }\r\n    out\r\n}\r\n"]
[21.846791, "o", "### /app/walk.rs\r\n"]
[21.847496, "o", "use std::collections::HashMap;\r\nuse std::fs;\r\n\r\npub fn rib_a() -> Result<Vec<String>, i32> {\r\n    let root = \"/app/dropwell\";\r\n    let mut bag: HashMap<String, String> = HashMap::new();\r\n    let rd = match fs::read_dir(root) {\r\n        Ok(x) => x,\r\n        Err(_) => return Ok(Vec::new()),\r\n    };\r\n    for ent in rd.flatten() {\r\n        let p = ent.path();\r\n        if p.extension().and_then(|s| s.to_str()) != Some(\"clat\") {\r\n            continue;\r\n        }\r\n        let s = p.to_string_lossy().to_string();\r\n        let meta = crate::parse::load(&s);\r\n        if meta.crash.is_none() {\r\n            continue;\r\n        }\r\n        bag.insert(s.clone(), s);\r\n    }\r\n    if bag.is_empty() {\r\n        return Ok(Vec::new());\r\n    }\r\n    Ok(bag.into_values().collect())\r\n}\r\n"]
[21.847654, "o", "### /app/dropwalk/mtime.rs\r\n"]
[21.848346, "o", "use std::fs;\r\nuse std::time::SystemTime;\r\n\r\npub fn newest_first(root: &str) -> Vec<String> {\r\n    let mut rows: Vec<(SystemTime, String)> = Vec::new();\r\n    if let Ok(rd) = fs::read_dir(root) {\r\n        for ent in rd.flatten() {\r\n            let p = ent.path();\r\n            let t = fs::metadata(&p)\r\n                .and_then(|m| m.modified())\r\n                .unwrap_or(SystemTime::UNIX_EPOCH);\r\n            rows.push((t, p.to_string_lossy().to_string()));\r\n        }\r\n    }\r\n    rows.sort_by(|a, b| b.0.cmp(&a.0));\r\n    rows.into_iter().map(|r| r.1).collect()\r\n}\r\n"]
[21.848478, "o", "### /app/deskbin/usage.txt\r\n"]
[21.849125, "o", "clatter tallow\r\nclatter pour [dir]\r\n"]
[21.849264, "o", "### /app/opsheet/MTIME_NOTE.txt\r\n"]
[21.849973, "o", "Scanner already walks newest mtime first via dropwalk. Burst dumps from one crash wave share the same mtime, so that listing is a stable starting point for the ribbon.\r\n"]
[21.850101, "o", "### /app/tidearc/README.txt\r\n"]
[21.850825, "o", "Last accepted server timeline snapshot from the previous upload window.\r\nOperators may park a copy under kegbay as hide.rec during a keg swap.\r\n"]
[21.850978, "o", "### /app/fat.sh\r\n"]
[21.85325, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin\r\nrustc --edition 2021 -O /app/deskbin/main.rs -o /app/bin/clatter\r\n"]
[21.853668, "o", "--- HEX ---\r\n"]
[21.854134, "o", "bash: xxd: command not found\r\n"]
[21.854761, "o", "bash: xxd: command not found\r\n"]
[21.855057, "o", "\u001b[?2004hroot@372084ed49e2:/app# "]
[40.169974, "i", "nl -ba /app/deskbin/emit.rs; printf '%s\\n' '--- metadata ---'; python3 - <<'PY'\nimport os,struct\nfor n in sorted(os.listdir('/app/dropwell')):\n p='/app/dropwell/'+n; b=open(p,'rb').read(); stamp,nst=struct.unpack_from('<IH',b,6); streams=[]\n for i in range(nst):\n  typ,rva,size=struct.unpack_from('<III',b,12+12*i); d=b[rva:rva+size]\n  if typ==3: streams.append((typ,struct.unpack_from('<II',d),None))\n  elif typ==15: streams.append((typ,d[:16].hex(),d[16] if len(d)>16 else None))\n  else: streams.append((typ,rva,size))\n print(n,'mtime_ns=',os.stat(p).st_mtime_ns,'stamp=',stamp,'streams=',streams)\nPY\nprintf '%s\\n' '--- behavior ---'; /app/bin/clatter tallow; echo tallow_rc=$?; cat /app/kegbay/MARK 2>/dev/null || true; cat /app/kegbay/ribbon.txt 2>/dev/null || true; /app/bin/clatter pour; echo pour_rc=$?; /app/bin/clatter pour /app/scratch; echo outside_rc=$?; printf '%s\\n' '--- outputs now ---'; cat /app/kegbay/upload.json; cat /app/kegbay/batch.tsv\n"]
[40.171089, "o", "nl -ba /app/deskbin/emit.rs; printf '%s\\n' '--- metadata ---'; python3 - <<'PY'\r\n"]
