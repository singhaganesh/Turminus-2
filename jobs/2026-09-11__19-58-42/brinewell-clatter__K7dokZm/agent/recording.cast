[90.735182, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn fill() -> i32 {\r\n\u001b[?2004l\r"]
[90.735269, "o", "\u001b[?2004h> "]
[90.735446, "o", "    let names = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return fail(c) };\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.735552, "o", "> "]
