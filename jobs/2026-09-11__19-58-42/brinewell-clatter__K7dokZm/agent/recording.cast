[90.728757, "o", "\u001b[?2004h"]
[90.728771, "o", "> "]
[90.728928, "o", "    let prior = last_good();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.729051, "o", "    let mut seen = HashSet::new();\r\n\u001b[?2004l\r"]
[90.729077, "o", "\u001b[?2004h"]
[90.729153, "o", "> "]
[90.729268, "o", "    let mut known: Vec<(u32, String)> = Vec::new();\r\n\u001b[?2004l\r"]
[90.729378, "o", "\u001b[?2004h> "]
[90.729502, "o", "    let mut fresh: Vec<(u64, u8, String, String)> = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.729576, "o", "> "]
[90.729641, "o", "    for (path, key) in pairs {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.729705, "o", "> "]
[90.729842, "o", "        let name = match Path::new(path).file_name().and_then(|x| x.to_str()) {\r\n\u001b[?2004l\r"]
[90.72991, "o", "\u001b[?2004h> "]
[90.730045, "o", "            Some(x) => x.to_string(), None => continue,\r\n\u001b[?2004l\r"]
[90.730071, "o", "\u001b[?2004h> "]
[90.730179, "o", "        };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.730326, "o", "        if !seen.insert(name.clone()) { continue; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.730435, "o", "        if let Some(seq) = prior.get(&name) {\r\n\u001b[?2004l\r"]
[90.730504, "o", "\u001b[?2004h> "]
[90.730613, "o", "            known.push((*seq, path.clone()));\r\n\u001b[?2004l\r"]
[90.730688, "o", "\u001b[?2004h>         } else {\r\n\u001b[?2004l\r"]
[90.730751, "o", "\u001b[?2004h> "]
