[96.183133, "i", "set +e\n/app/bin/clatter pour /app/scratch >/tmp/outside.out 2>&1\nrc=$?\nprintf 'outside_rc=%s mark=' \"$rc\"; cat /app/kegbay/MARK; echo\ntest \"$rc\" -ne 0 && test \"$(cat /app/kegbay/MARK)\" = false || exit 1\nmkdir -p /tmp/wellsave\nmv /app/dropwell/*.clat /tmp/wellsave/\n/app/bin/clatter tallow >/tmp/empty.out 2>&1\nrc=$?\nprintf 'empty_rc=%s mark=' \"$rc\"; cat /app/kegbay/MARK; echo\nmv /tmp/wellsave/*.clat /app/dropwell/\ntest \"$rc\" -ne 0 && test \"$(cat /app/kegbay/MARK)\" = false || exit 1\n/app/bin/clatter tallow && /app/bin/clatter pour\nprintf 'restored_mark='; cat /app/kegbay/MARK; echo\n"]
