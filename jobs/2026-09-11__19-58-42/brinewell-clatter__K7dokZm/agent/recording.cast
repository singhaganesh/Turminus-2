[90.722163, "o", "cat > /app/stamp.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.722314, "o", "pub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\r\n\u001b[?2004l\r"]
