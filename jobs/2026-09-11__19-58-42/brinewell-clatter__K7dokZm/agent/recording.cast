[37.630302, "o", "b.clat stamp 1700000000 crash (2095054848, 30604362, 3221225477) ft 131444736000000000 guid 02020202020202020202020202020202 comp 0 sha 6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\r\nd.clat stamp 1700000000 crash (564559872, 30837193, 3221225477) ft 132444736000000000 guid 03030303030303030303030303030303 comp 0 sha 157d37e1dcfae2297edb4836bf331beee40e1621fe0a350cc1c7359d06b0caea\r\ne.clat stamp 1700000000 crash (268042240, 31535685, 3221225477) ft 135444736000000000 guid eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee comp 0 sha f1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\r\n"]
