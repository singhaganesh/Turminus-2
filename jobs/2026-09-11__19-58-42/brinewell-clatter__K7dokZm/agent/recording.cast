[94.20965, "o", "\u001b[?2004hroot@1717bc3944ec:/app# cat /app/kegbay/upload.json\r\n\u001b[?2004l\r"]
[94.211786, "o", "{\"batch_count\":3,\"entries\":[{\"seq\":1,\"name\":\"old.clat\",\"digest\":\"6727175f53e5a66f47bff49403667cfaf694b2f2e7b7729a399234cda98b67f5\",\"guid\":\"01010101010101010101010101010101\"},{\"seq\":2,\"name\":\"b.clat\",\"digest\":\"6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\",\"guid\":\"02020202020202020202020202020202\"},{\"seq\":3,\"name\":\"d.clat\",\"digest\":\"157d37e1dcfae2297edb4836bf331beee40e1621fe0a350cc1c7359d06b0caea\",\"guid\":\"03030303030303030303030303030303\"},{\"seq\":4,\"name\":\"a.clat\",\"digest\":\"224cbf56792e0184b9ad97ad92ad0a102631c7ef419cb9d25c1f25d649af4713\",\"guid\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"seq\":5,\"name\":\"a2.clat\",\"digest\":\"57fecb62f4f4fc23bb7917c03a6c02c1c4be698144a61ebdc5a87a24612c61a3\",\"guid\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"seq\":6,\"name\":\"e.clat\",\"digest\":\"f1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\",\"guid\":\"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"},{\"seq\":7,\"name\":\"e2.clat\",\"digest\":\"9af0e00cf837afe51af86ba105612013c528575571e198fbd2f60ed22cb91807\",\"guid\":\"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"}]}\r\n"]
