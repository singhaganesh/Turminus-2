[90.738243, "o", "\u001b[?2004hroot@1717bc3944ec:/app# "]
[91.19267, "i", "cat > /app/deskbin/emit.rs <<'RS'\nuse std::fs;\nuse std::path::Path;\n\nfn mark_false() { fs::create_dir_all(\"/app/kegbay\").ok(); let _ = fs::write(\"/app/kegbay/MARK\", \"false\"); }\n\nfn read_pairs() -> Vec<(String, u64)> {\n    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default();\n    raw.lines().filter_map(|line| {\n        let mut p = line.split('\\t');\n        Some((p.next()?.to_string(), p.next()?.parse().ok()?))\n    }).collect()\n}\n\npub fn finish() -> i32 {\n    let names = match crate::fold::rib_c(&read_pairs(), None) {\n        Ok(v) if !v.is_empty() => v,\n        Ok(_) => { mark_false(); return 1 },\n        Err(c) => { mark_false(); return c },\n    };\n    let mut body = String::new();\n    for (i, n) in names.iter().enumerate() {\n        let m = crate::parse::load(n);\n        body.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, n, crate::parse::guid_hex(&m.guid)));\n    }\n    fs::create_dir_all(\"/app/kegbay\").ok();\n    if fs::write(\"/app/kegbay/ribbon.txt\", body).is_err() { mark_false(); return 1; }\n    0\n}\n\npub fn pour() -> i32 {\n    let root = std::env::args().nth(2).unwrap_or_else(|| \"/app/dropwell\".to_string());\n    if let Err(c) = crate::fold::rib_c(&[], Some(&root)) { mark_false(); return c; }\n    let well = match crate::walk::rib_a() { Ok(v) if !v.is_empty() => v, _ => { mark_false(); return 1 } };\n    let well_names: std::collections::HashSet<String> = well.iter().filter_map(|p| Path::new(p).file_name()?.to_str().map(str::to_string)).collect();\n    let ribbon = fs::read_to_string(\"/app/kegbay/ribbon.txt\").unwrap_or_default();\n    let mut rows: Vec<(u32, String, String, String)> = Vec::new();\n    let mut seen = std::collections::HashSet::new();\n    for line in ribbon.lines() {\n        let p: Vec<&str> = line.split('\\t').collect();\n        if p.len() != 3 { continue; }\n        let seq: u32 = match p[0].parse() { Ok(x) => x, Err(_) => continue };\n        let full = p[1];\n        let name = match Path::new(full).file_name().and_then(|x| x.to_str()) { Some(x) => x.to_string(), None => continue };\n        if !well_names.contains(&name) || !seen.insert(name.clone()) { continue; }\n        let digest = crate::sum::hex_file(full);\n        if digest.len() != 64 { mark_false(); return 1; }\n        rows.push((seq, name, digest, p[2].to_string()));\n    }\n    if rows.len() != well_names.len() || rows.is_empty() { mark_false(); return 1; }\n    rows.sort_by_key(|r| r.0);\n    for (i, row) in rows.iter_mut().enumerate() { row.0 = (i + 1) as u32; }\n\n    let mut json = format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\", (rows.len() + 2) / 3);\n    for (i, (seq, name, digest, guid)) in rows.iter().enumerate() {\n        if i != 0 { json.push(','); }\n        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\", seq, name, digest, guid));\n    }\n    json.push_str(\"]}\\n\");\n    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\n    for (seq, name, digest, guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, guid)); }\n    if fs::write(\"/app/kegbay/upload.json\", json).is_err() || fs::write(\"/app/kegbay/batch.tsv\", tsv).is_err() {\n        mark_false(); return 1;\n    }\n    if fs::write(\"/app/kegbay/MARK\", \"ok\").is_err() { return 1; }\n    0\n}\nRS\n/usr/local/rustup/toolchains/1.85.1-x86_64-unknown-linux-gnu/bin/rustc --edition 2021 -O /app/deskbin/main.rs -o /app/bin/clatter\n/app/bin/clatter tallow && /app/bin/clatter pour\n"]
