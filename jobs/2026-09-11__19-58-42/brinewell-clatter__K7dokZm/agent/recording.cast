[36.438595, "o", "     1\tuse std::fs;\r\n     2\tuse std::path::Path;\r\n     3\t\r\n     4\tfn read_pairs() -> Vec<(String, u64)> {\r\n     5\t    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default();\r\n     6\t    let mut v = Vec::new();\r\n     7\t    for line in raw.lines() {\r\n     8\t        let mut it = line.split('\\t');\r\n     9\t        if let (Some(n), Some(k)) = (it.next(), it.next()) {\r\n    10"]
[36.43879, "o", "\t            if let Ok(u) = k.parse::<u64>() {\r\n    11\t                v.push((n.to_string(), u));\r\n    12\t            }\r\n    13\t        }\r\n    14\t    }\r\n    15\t    v\r\n    16\t}\r\n    17\t\r\n    18\tpub fn finish() -> i32 {\r\n    19\t    let pairs = read_pairs();\r\n    20\t    match crate::fold::rib_c(&pairs, None) {\r\n    21\t        Err(c) => c,\r\n    22\t        Ok(names) => {\r\n    23\t            fs::create_dir_all(\"/app/kegbay\").ok();\r\n    24\t            let mut body = String::new();\r\n    25\t            for (i, n) in names.iter().enumerate() {\r\n    26\t                let m = crate::parse::load(n);\r\n    27\t                body.push_str(&format!(\r\n    28\t                    \"{}\\t{}\\t{}\\n\",\r\n    29\t                    i + 1,\r\n    30\t                    n,\r\n    31\t                    crate::parse::guid_hex(&m.guid)\r\n    32\t                ));\r\n    33\t            }\r\n    34\t            fs::write(\"/app/kegbay/ribbon.txt\", body).ok();\r\n    35\t            0\r\n    36\t        }\r\n    37\t    }\r\n    38\t}\r\n    39\t\r\n    40\tpub fn pour() -> i32 {\r\n    41\t    let arg = std::env::args().nth(2);\r\n    42\t    let root = arg.unwrap_or_else(|| \"/app/dropwell\".to_string());\r\n    43\t    match crate::fold::rib_c(&[], Some(&root)) {\r\n    44\t        Err(c) => {\r\n    45\t            let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n    46\t            return c;\r\n    47\t        }\r\n    48\t        Ok(_) => {}\r\n    49\t    }\r\n    50\t    let ribbon = fs::read_to_string(\"/app/kegbay/ribbon.txt\").unwrap_or_default();\r\n    51\t    let mut rows: Vec<(u32, String, String, String)> = Vec::new();\r\n    52\t    for line in ribbon.lines() {\r\n    53\t        let p: Vec<&str> = line.split('\\t').collect();\r\n    54\t        if p.len() < 3 {\r\n    55\t            continue;\r\n    56\t        }\r\n    57\t        let seq: u32 = p[0].parse().unwrap_or(0);\r\n    58\t        let name = p[1].to_string();\r\n    59\t        let g = p[2].to_string();\r\n    60\t        let digest = crate::sum::hex_file(&name);\r\n    61\t        rows.push((seq, Path::new(&name).file_name().unwrap().to_string_lossy().to_string(), digest, g));\r\n    62\t    }\r\n    63\t    let n = rows.len();\r\n"]
[36.438877, "o", "    64\t    let batches = if n == 0 { 0 } else { (n + 2) / 3 };\r\n    65\t    let mut json = String::from(\"{\\\"batch_count\\\":\");\r\n    66\t    json.push_str(&batches.to_string());\r\n    67\t    json.push_str(\",\\\"entries\\\":[\");\r\n    68\t    for (i, (seq, name, digest, g)) in rows.iter().enumerate() {\r\n    69\t        if i > 0 {\r\n    70\t            json.push(',');\r\n    71\t        }\r\n    72\t        json.push_str(&format!(\r\n    73\t            \"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",\r\n    74\t            seq, name, digest, g\r\n    75\t        ));\r\n    76\t    }\r\n    77\t    json.push_str(\"]}\\n\");\r\n    78\t    fs::create_dir_all(\"/app/kegbay\").ok();\r\n    79\t    fs::write(\"/app/kegbay/upload.json\", json).ok();\r\n    80\t    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n    81\t    for (seq, name, digest, g) in &rows {\r\n    82\t        tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, g));\r\n    83\t    }\r\n    84\t    fs::write(\"/app/kegbay/batch.tsv\", tsv).ok();\r\n"]
[36.438963, "o", "    85\t    fs::write(\"/app/kegbay/MARK\", \"ok\").ok();\r\n    86\t    0\r\n    87\t}\r\n"]
