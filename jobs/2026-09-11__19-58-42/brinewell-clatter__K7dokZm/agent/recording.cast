[37.636278, "o", "\u001b[?2004hroot@1717bc3944ec:/app# "]
[90.71592, "i", "cat > /app/walk.rs <<'RS'\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let root = \"/app/dropwell\";\n    let rd = fs::read_dir(root).map_err(|_| 1)?;\n    let mut names = Vec::new();\n    for ent in rd.flatten() {\n        let p = ent.path();\n        if !p.is_file() || p.extension().and_then(|s| s.to_str()) != Some(\"clat\") {\n            continue;\n        }\n        let path = p.to_string_lossy().to_string();\n        let b = match fs::read(&path) { Ok(b) => b, Err(_) => continue };\n        if b.len() < 12 || &b[..4] != b\"CLAT\" { continue; }\n        let m = crate::parse::load(&path);\n        if m.guid == [0; 16] { continue; }\n        names.push(path);\n    }\n    names.sort();\n    names.dedup();\n    if names.is_empty() { Err(1) } else { Ok(names) }\n}\nRS\ncat > /app/stamp.rs <<'RS'\npub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\n    let mut out = Vec::new();\n    for n in names {\n        let m = crate::parse::load(n);\n        let key = if let Some((lo, hi)) = m.crash {\n            ((hi as u64) << 32) | lo as u64\n        } else {\n            m.write_stamp as u64 * 10_000_000 + 116_444_736_000_000_000\n        };\n        out.push((n.clone(), key));\n    }\n    out\n}\nRS\ncat > /app/fold.rs <<'RS'\nuse std::collections::{HashMap, HashSet};\nuse std::fs;\nuse std::path::Path;\n\nfn last_good() -> HashMap<String, u32> {\n    let mut out = HashMap::new();\n    if let Ok(raw) = fs::read_to_string(\"/app/tidearc/lastgood.rec\") {\n        for line in raw.lines() {\n            let p: Vec<&str> = line.split('\\t').collect();\n            if p.len() >= 2 {\n                if let Ok(seq) = p[0].parse::<u32>() {\n                    out.insert(p[1].to_string(), seq);\n                }\n            }\n        }\n    }\n    out\n}\n\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\n    if let Some(r) = root {\n        let requested = fs::canonicalize(r).map_err(|_| 1)?;\n        let allowed = fs::canonicalize(\"/app/dropwell\").map_err(|_| 1)?;\n        if requested != allowed { return Err(1); }\n        return Ok(Vec::new());\n    }\n    if pairs.is_empty() { return Err(1); }\n\n    let prior = last_good();\n    let mut seen = HashSet::new();\n    let mut known: Vec<(u32, String)> = Vec::new();\n    let mut fresh: Vec<(u64, u8, String, String)> = Vec::new();\n    for (path, key) in pairs {\n        let name = match Path::new(path).file_name().and_then(|x| x.to_str()) {\n            Some(x) => x.to_string(), None => continue,\n        };\n        if !seen.insert(name.clone()) { continue; }\n        if let Some(seq) = prior.get(&name) {\n            known.push((*seq, path.clone()));\n        } else {\n            let m = crate::parse::load(path);\n            fresh.push((*key, m.companion, name, path.clone()));\n        }\n    }\n    known.sort_by(|a, b| a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1)));\n    fresh.sort_by(|a, b| a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1)).then_with(|| a.2.cmp(&b.2)));\n    let mut out: Vec<String> = known.into_iter().map(|x| x.1).collect();\n    out.extend(fresh.into_iter().map(|x| x.3));\n    if out.is_empty() { Err(1) } else { Ok(out) }\n}\nRS\ncat > /app/deskbin/pipe.rs <<'RS'\nuse std::fs;\n\nfn fail(code: i32) -> i32 {\n    fs::create_dir_all(\"/app/kegbay\").ok();\n    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\n    code\n}\n\npub fn fill() -> i32 {\n    let names = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return fail(c) };\n    let pairs = crate::stamp::rib_b(&names);\n    if pairs.is_empty() { return fail(1); }\n    let mut body = String::new();\n    for (n, k) in pairs { body.push_str(&format!(\"{}\\t{}\\n\", n, k)); }\n    fs::create_dir_all(\"/app/kegbay\").ok();\n    match fs::write(\"/app/kegbay/pairs.tmp\", body) { Ok(_) => 0, Err(_) => fail(1) }\n}\nRS\n"]
