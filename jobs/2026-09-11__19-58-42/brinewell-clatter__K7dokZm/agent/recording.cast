[37.581313, "i", "python3 - <<'PY'\nimport os,struct,glob,hashlib\nfor p in sorted(glob.glob('/app/dropwell/*')):\n b=open(p,'rb').read(); stamp=struct.unpack_from('<I',b,6)[0]; n=struct.unpack_from('<H',b,10)[0]; crash=None; guid=None; comp=None\n for i in range(n):\n  st,rva,sz=struct.unpack_from('<III',b,12+12*i)\n  if st==3 and rva+12<=len(b):\n   lo,hi,code=struct.unpack_from('<III',b,rva); crash=(lo,hi,code); ft=(hi<<32)|lo\n  if st==15 and rva+17<=len(b): guid=b[rva:rva+16].hex(); comp=b[rva+16]\n print(os.path.basename(p), 'stamp',stamp,'crash',crash,'ft',locals().get('ft') if crash else None,'guid',guid,'comp',comp,'sha',hashlib.sha256(b).hexdigest())\nPY\n"]
[37.581611, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
