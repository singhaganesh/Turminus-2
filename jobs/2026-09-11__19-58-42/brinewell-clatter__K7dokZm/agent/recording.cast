[91.200694, "o", "        let p: Vec<&str> = line.split('\\t').collect();\r\n\u001b[?2004l\r"]
[91.200753, "o", "\u001b[?2004h> "]
[91.200822, "o", "        if p.len() != 3 { continue; }\r\n\u001b[?2004l\r"]
[91.200881, "o", "\u001b[?2004h> "]
[91.201068, "o", "        let seq: u32 = match p[0].parse() { Ok(x) => x, Err(_) => continue };\r\n\u001b[?2004l\r"]
[91.201145, "o", "\u001b[?2004h> "]
[91.201951, "o", "        let full = p[1];\r\n\u001b[?2004l\r\u001b[?2004h>         let name = match Path::new(full).file_name().and_then(|x| x.to_str()) { Some(x) => x.to_string(), None => continue };\r\n\u001b[?2004l\r\u001b[?2004h>         if !well_names.contains(&name) || !seen.insert(name.clone()) { continue; }\r\n\u001b[?2004l\r\u001b[?2004h>         let digest = crate::sum::hex_file(full);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.202071, "o", "        if digest.len() != 64 { mark_false(); return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.202243, "o", "        rows.push((seq, name, digest, p[2].to_string()));\r\n\u001b[?2004l\r"]
[91.202414, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.202627, "o", "    if rows.len() != well_names.len() || rows.is_empty() { mark_false(); return 1; }\r\n\u001b[?2004l\r"]
[91.20271, "o", "\u001b[?2004h> "]
[91.202734, "o", "    rows.sort_by_key(|r| r.0);\r\n\u001b[?2004l\r"]
[91.202748, "o", "\u001b[?2004h"]
[91.202762, "o", "> "]
[91.202944, "o", "    for (i, row) in rows.iter_mut().enumerate() { row.0 = (i + 1) as u32; }\r\n\u001b[?2004l\r"]
[91.203014, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.203246, "o", "    let mut json = format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\", (rows.len() + 2) / 3);\r\n\u001b[?2004l\r"]
[91.203329, "o", "\u001b[?2004h> "]
[91.203465, "o", "    for (i, (seq, name, digest, guid)) in rows.iter().enumerate() {\r\n\u001b[?2004l\r"]
[91.203543, "o", "\u001b[?2004h> "]
[91.203606, "o", "        if i != 0 { json.push(','); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.203669, "o", "> "]
[91.203892, "o", "        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\", seq, name, digest, guid));\r\n\u001b[?2004l\r"]
[91.203934, "o", "\u001b[?2004h> "]
[91.20398, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.204094, "o", "    json.push_str(\"]}\\n\");\r\n\u001b[?2004l\r"]
[91.20414, "o", "\u001b[?2004h> "]
[91.20427, "o", "    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n\u001b[?2004l\r"]
[91.204334, "o", "\u001b[?2004h> "]
[91.204606, "o", "    for (seq, name, digest, guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, guid)); }\r\n\u001b[?2004l\r"]
[91.204653, "o", "\u001b[?2004h> "]
[91.204928, "o", "    if fs::write(\"/app/kegbay/upload.json\", json).is_err() || fs::write(\"/app/kegbay/batch.tsv\", tsv).is_err() {\r\n\u001b[?2004l\r"]
[91.204978, "o", "\u001b[?2004h> "]
[91.205053, "o", "        mark_false(); return 1;\r\n\u001b[?2004l\r"]
[91.205103, "o", "\u001b[?2004h> "]
[91.205155, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[91.205207, "o", "> "]
[91.205326, "o", "    if fs::write(\"/app/kegbay/MARK\", \"ok\").is_err() { return 1; }\r\n\u001b[?2004l\r"]
[91.205378, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r"]
[91.205449, "o", "\u001b[?2004h"]
[91.205506, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[91.206944, "o", "\u001b[?2004hroot@1717bc3944ec:/app# "]
[91.2073, "o", "/usr/local/rustup/toolchains/1.85.1-x86_64-unknown-linux-gnu/bin/rustc --edition 2021 -O /app/deskbin/main.rs -o /app/bin/clatter\r\n\u001b[?2004l\r"]
[93.942683, "o", "\u001b[?2004hroot@1717bc3944ec:/app# "]
[93.942869, "o", "/app/bin/clatter tallow && /app/bin/clatter pour\r\n\u001b[?2004l\r"]
[93.950861, "o", "\u001b[?2004hroot@1717bc3944ec:/app# "]
[94.205214, "i", "set -eu\nprintf '%s\\n' '--- ELF/MARK ---'\nod -An -tx1 -N4 /app/bin/clatter\ncat /app/kegbay/MARK; echo\nprintf '%s\\n' '--- OUTPUTS ---'\ncat /app/kegbay/upload.json\ncat /app/kegbay/batch.tsv\npython3 - <<'PY'\nimport json,hashlib,os\nj=json.load(open('/app/kegbay/upload.json'))\nassert j['batch_count']==3 and len(j['entries'])==7\nassert [e['seq'] for e in j['entries']]==list(range(1,8))\nassert [e['name'] for e in j['entries']]==['old.clat','b.clat','d.clat','a.clat','a2.clat','e.clat','e2.clat']\nfor e in j['entries']:\n b=open('/app/dropwell/'+e['name'],'rb').read()\n assert e['digest']==hashlib.sha256(b).hexdigest()\nprint('validated')\nPY\ncp /app/kegbay/upload.json /tmp/upload.first\ncp /app/kegbay/batch.tsv /tmp/batch.first\n/app/bin/clatter tallow\n/app/bin/clatter pour\ncmp /tmp/upload.first /app/kegbay/upload.json\ncmp /tmp/batch.first /app/kegbay/batch.tsv\necho deterministic-ok\n"]
[94.206264, "o", "set -eu\r\n\u001b[?2004l\r\u001b[?2004hroot@1717bc3944ec:/app# printf '%s\\n' '--- ELF/MARK ---'\r\n\u001b[?2004l\r--- ELF/MARK ---\r\n\u001b[?2004hroot@1717bc3944ec:/app# od -An -tx1 -N4 /app/bin/clatter\r\n\u001b[?2004l\r"]
