[90.731271, "o", "> "]
[90.732506, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     known.sort_by(|a, b| a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1)));\r\n\u001b[?2004l\r\u001b[?2004h>     fresh.sort_by(|a, b| a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1)).then_with(|| a.2.cmp(&b.2)));\r\n\u001b[?2004l\r\u001b[?2004h>     let mut out: Vec<String> = known.into_iter().map(|x| x.1).collect();\r\n\u001b[?2004l\r\u001b[?2004h>     out.extend(fresh.into_iter().map(|x| x.3));\r\n\u001b[?2004l\r\u001b[?2004h>     if out.is_empty() { Err(1) } else { Ok(out) }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
