[90.736077, "o", "\u001b[?2004h> "]
[90.736265, "o", "    for (n, k) in pairs { body.push_str(&format!(\"{}\\t{}\\n\", n, k)); }\r\n\u001b[?2004l\r"]
[90.736331, "o", "\u001b[?2004h> "]
[90.736453, "o", "    fs::create_dir_all(\"/app/kegbay\").ok();\r\n\u001b[?2004l\r"]
[90.736524, "o", "\u001b[?2004h> "]
[90.736751, "o", "    match fs::write(\"/app/kegbay/pairs.tmp\", body) { Ok(_) => 0, Err(_) => fail(1) }\r\n\u001b[?2004l\r"]
[90.736818, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
