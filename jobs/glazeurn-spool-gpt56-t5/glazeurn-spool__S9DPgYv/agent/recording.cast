[51.222632, "o", "\u001b[?2004hroot@18b39f9ae8aa:/app# "]
[51.620268, "i", "cat > /app/emitbay/hearth.rs <<'EOF'\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\nfn rust_pieces(dir: &Path) -> Result<Vec<PathBuf>, ()> {\n    let mut pieces = Vec::new();\n    for entry in fs::read_dir(dir).map_err(|_| ())? {\n        let path = entry.map_err(|_| ())?.path();\n        if path.is_file() && path.extension().and_then(|x| x.to_str()) == Some(\"rs\") {\n            pieces.push(path);\n        }\n    }\n    pieces.sort();\n    Ok(pieces)\n}\n\npub fn rib_d() -> i32 {\n    // Walk and read every card; both products are required by this mill.\n    let mut cards = match fs::read_dir(\"/app/daycards\") {\n        Ok(it) => it.filter_map(Result::ok).map(|e| e.path())\n            .filter(|p| p.is_file()).collect::<Vec<_>>(),\n        Err(_) => return 1,\n    };\n    cards.sort();\n    let mut freeze = false;\n    let mut cells = false;\n    for card in cards {\n        let text = match fs::read_to_string(card) { Ok(s) => s, Err(_) => return 1 };\n        for line in text.lines().map(str::trim) {\n            freeze |= line == \"emit freeze\";\n            cells |= line == \"emit cells\";\n        }\n    }\n    if !freeze || !cells { return 1; }\n\n    // Refresh every Rust mill piece beneath every TREE entry.\n    let tree = match fs::read_to_string(\"/app/vatslip/TREE.txt\") {\n        Ok(s) => s,\n        Err(_) => return 1,\n    };\n    for name in tree.lines().map(str::trim).filter(|s| !s.is_empty()) {\n        if name.contains('/') || name.contains(\"..\") { return 1; }\n        let dir = Path::new(\"/app\").join(name);\n        let pieces = match rust_pieces(&dir) { Ok(v) if !v.is_empty() => v, _ => return 1 };\n        for piece in pieces {\n            let body = match fs::read(&piece) { Ok(v) => v, Err(_) => return 2 };\n            if fs::write(&piece, body).is_err() { return 2; }\n        }\n    }\n    0\n}\nEOF\n/app/bake.sh\n/app/bin/glazeurn bind; echo bind_rc=$?\n/app/bake.sh\nod -An -tx1 -N4 /app/bin/glazeurn\nrm -f /app/inkpit/GUARD /app/inkpit/pair.json\n/app/bin/glazeurn pair; rc=$?; echo pair_rc=$rc; cat /app/inkpit/pair.json; printf 'GUARD='; cat /app/inkpit/GUARD\n"]
