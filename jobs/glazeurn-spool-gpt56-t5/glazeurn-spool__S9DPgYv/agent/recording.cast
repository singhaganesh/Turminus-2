[51.219599, "o", "cat > /app/restcue/ink.rs <<'EOF'\r\n\u001b[?2004l\r"]
[51.219663, "o", "\u001b[?2004h> "]
[51.219717, "o", "use crate::pool;\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.219774, "o", "> use std::fs;"]
[51.219827, "o", "\r\n\u001b[?2004l\r"]
[51.219875, "o", "\u001b[?2004h"]
[51.220168, "o", "> use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn rim_c() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.220234, "o", "    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.22036, "o", "    let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.22045, "o", "    let code = pool::dump();\r\n\u001b[?2004l\r"]
[51.220511, "o", "\u001b[?2004h> "]
[51.220555, "o", "    if code != 0 {\r\n\u001b[?2004l\r"]
[51.220603, "o", "\u001b[?2004h> "]
[51.220663, "o", "        return code;\r\n\u001b[?2004l\r"]
[51.220708, "o", "\u001b[?2004h> "]
[51.220734, "o", "    }\r\n\u001b[?2004l\r"]
[51.220753, "o", "\u001b[?2004h"]
[51.220888, "o", "> "]
[51.220923, "o", "    match fs::write(guard, \"ok\\n\") {\r\n\u001b[?2004l\r"]
[51.220942, "o", "\u001b[?2004h"]
[51.220958, "o", "> "]
[51.221037, "o", "        Ok(()) => 0,\r\n\u001b[?2004l\r"]
[51.221093, "o", "\u001b[?2004h> "]
[51.221173, "o", "        Err(_) => 2,\r\n\u001b[?2004l\r"]
[51.221192, "o", "\u001b[?2004h"]
[51.221208, "o", "> "]
