[8.939503, "i", "printf '%s\\n' '--- likely source/build files ---'; find /app -maxdepth 3 -type f \\( -name '*.c' -o -name '*.h' -o -name '*.cc' -o -name '*.cpp' -o -name '*.rs' -o -name 'Cargo.toml' -o -name 'Makefile' -o -name '*.py' -o -name '*.sh' \\) -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\n"]
[8.94099, "o", "printf '%s\\n' '--- likely source/build files ---'; find /app -maxdepth 3 -type f \\( -name '*.c' -o -name '*.h' -o -name '*.cc' -o -name '*.cpp' -o -name '*.rs' -o -name 'Cargo.toml' -o -name 'Makefile' -o -name '*.py' -o -name '*.sh' \\) -print -exec sh -c 'echo \"### $1\"; sed -n \"1,240p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
