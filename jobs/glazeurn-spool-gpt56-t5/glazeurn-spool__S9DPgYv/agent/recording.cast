[8.945069, "o", "/app/internpit/pool.rs\r\n"]
[8.946064, "o", "### /app/internpit/pool.rs\r\n"]
[8.948801, "o", "use crate::fold;\r\nuse crate::hold;\r\nuse crate::load;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n    let _ = (a, b);\r\n}\r\n\r\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n"]
[8.94897, "o", "    let mut f = fold::rim_a(a, b);\r\n    rim_b(&mut f, b);\r\n    f\r\n}\r\n\r\nfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    let mut parts = Vec::new();\r\n    for &i in ids {\r\n        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    }\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n}\r\n\r\npub fn dump() -> i32 {\r\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n        return 1;\r\n    };\r\n    let frost = prep(&sess, &pool);\r\n    load::step(&mut sess, &mut pool, &plan);\r\n    let live_ids = sess.ids.borrow().clone();\r\n    let _frost_ids = frost.ids.borrow().clone();\r\n    let extra = tally::lines();\r\n    let frost_s = pack(&live_ids, &pool.cells);\r\n    let live_s = pack(&live_ids, &pool.cells);\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    let body = format!(\r\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n        sess.n0.saturating_add(extra),\r\n        sess.n1,\r\n        frost_s,\r\n        live_s\r\n    );\r\n    match fs::write(dest, body) {\r\n        Ok(()) => 0,\r\n        Err(_) => 2,\r\n    }\r\n}\r\n"]
[8.949894, "o", "/app/foldrib/rim.rs\r\n"]
[8.95065, "o", "### /app/foldrib/rim.rs\r\n"]
[8.951652, "o", "use crate::hold;\r\n\r\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let _ = b;\r\n    hold::Frost {\r\n        n0: a.n0,\r\n        n1: a.n1,\r\n        ids: a.ids.clone(),\r\n        cells: Vec::new(),\r\n    }\r\n}\r\n"]
[8.952034, "o", "/app/restcue/ink.rs\r\n"]
[8.952988, "o", "### /app/restcue/ink.rs\r\n"]
[8.955339, "o", "use crate::load;\r\nuse crate::pool;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n        let _ = fs::write(\r\n            dest,\r\n            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n        );\r\n        let _ = fs::write(guard, \"ok\\n\");\r\n        return 0;\r\n    }\r\n    let _ = pool::dump();\r\n    let _ = fs::write(guard, \"ok\\n\");\r\n    0\r\n}\r\n"]
[8.956542, "o", "/app/coverpit/tally.rs\r\n"]
[8.957392, "o", "### /app/coverpit/tally.rs\r\n"]
[8.959264, "o", "struct Desk;\r\n\r\npub fn lines() -> u32 {\r\n    let _ = Desk;\r\n    let text = std::fs::read_to_string(\"/app/coverpit/COVER.txt\").unwrap_or_default();\r\n    let _ = text.contains(\"Desk\");\r\n    0\r\n}\r\n"]
[8.960099, "o", "/app/emitbay/hearth.rs\r\n"]
[8.961202, "o", "### /app/emitbay/hearth.rs\r\n"]
[8.962487, "o", "use std::fs;\r\n\r\npub fn rib_d() -> i32 {\r\n    let _ = fs::read_dir(\"/app/daycards\");\r\n    let rim = r#\"use crate::hold;\r\n\r\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let _ = b;\r\n    hold::Frost {\r\n        n0: a.n0,\r\n        n1: a.n1,"]
[8.962589, "o", "\r\n        ids: a.ids.clone(),\r\n        cells: Vec::new(),\r\n    }\r\n}\r\n\"#;\r\n    let pool = r#\"use crate::fold;\r\nuse crate::hold;\r\nuse crate::load;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n    let _ = (a, b);\r\n}\r\n\r\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    let mut f = fold::rim_a(a, b);\r\n    rim_b(&mut f, b);\r\n    f\r\n}\r\n\r\nfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    let mut parts = Vec::new();\r\n    for &i in ids {\r\n        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    }\r\n    format!(\"[{}]\", parts.join(\",\"))\r\n}\r\n\r\npub fn dump() -> i32 {\r\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n        return 1;\r\n    };\r\n    let frost = prep(&sess, &pool);\r\n    load::step(&mut sess, &mut pool, &plan);\r\n    let live_ids = sess.ids.borrow().clone();\r\n    let _frost_ids = frost.ids.borrow().clone();\r\n    let extra = tally::lines();\r\n    let frost_s = pack(&live_ids, &pool.cells);\r\n    let live_s = pack(&live_ids, &pool.cells);\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    let body = format!(\r\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n        sess.n0.saturating_add(extra),\r\n        sess.n1,\r\n        frost_s,\r\n        live_s\r\n    );\r\n    match fs::write(dest, body) {\r\n        Ok(()) => 0,\r\n        Err(_) => 2,\r\n    }\r\n"]
[8.962622, "o", "}\r\n\"#;\r\n    let ink = r#\"use crate::load;\r\nuse crate::pool;\r\nuse crate::tally;\r\nuse std::fs;\r\nuse std::path::Path;\r\n\r\npub fn rim_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    if let Some(parent) = dest.parent() {\r\n        let _ = fs::create_dir_all(parent);\r\n    }\r\n    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n        let _ = fs::write(\r\n"]
[8.962646, "o", "            dest,\r\n            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n        );\r\n        let _ = fs::write(guard, \"ok\\n\");\r\n        return 0;\r\n    }\r\n    let _ = pool::dump();\r\n    let _ = fs::write(guard, \"ok\\n\");\r\n    0\r\n}\r\n\"#;\r\n"]
[8.96266, "o", "    if fs::write(\"/app/foldrib/rim.rs\", rim).is_err() {\r\n        return 2;\r\n    }\r\n    if fs::write(\"/app/internpit/pool.rs\", pool).is_err() {\r\n"]
[8.962675, "o", "        return 2;\r\n    }\r\n    if fs::write(\"/app/restcue/ink.rs\", ink).is_err() {\r\n        return 2;\r\n    }\r\n    0\r\n"]
[8.962686, "o", "}\r\n"]
[8.963054, "o", "/app/emitbay/main.rs\r\n"]
[8.963862, "o", "### /app/emitbay/main.rs\r\n"]
[8.964876, "o", "#[path = \"hearth.rs\"]\r\nmod hearth;\r\n\r\nfn main() {\r\n    let code = hearth::rib_d();\r\n    std::process::exit(code);\r\n"]
[8.964992, "o", "}\r\n"]
[8.965345, "o", "/app/sessbay/load.rs\r\n"]
[8.965946, "o", "### /app/sessbay/load.rs\r\n"]
[8.966884, "o", "use crate::hold;\r\nuse std::cell::RefCell;\r\nuse std::fs;\r\nuse std::rc::Rc;\r\n\r\npub struct Plan {\r\n    pub old: String,\r\n    pub new: String,\r\n    pub extra: String,\r\n}"]
[8.966975, "o", "\r\n\r\npub fn kiln_pitch(n0: u32, n1: u32, width: u32, heat: bool) -> (u32, u32) {\r\n    let tick = n0.saturating_add(width);\r\n    let mark = n1.saturating_add(if heat { 2 } else { 1 });\r\n    (tick, mark)\r\n}\r\n\r\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\r\n"]
[8.967006, "o", "    let text = fs::read_to_string(p).ok()?;\r\n    if text.trim().is_empty() {\r\n        return None;\r\n    }\r\n    let mut n0 = None;\r\n    let mut n1 = None;\r\n    let mut cells: Vec<String> = Vec::new();\r\n    let mut flag = false;\r\n    let mut old = String::new();\r\n    let mut new = String::new();\r\n    let mut extra = String::new();\r\n    for raw in text.lines() {\r\n        let line = raw.trim();\r\n        if line.is_empty() || line.starts_with('#') {\r\n            continue;\r\n        }\r\n        let mut it = line.split_whitespace();\r\n        let key = it.next()?;\r\n        match key {\r\n            \"tick\" => n0 = it.next()?.parse().ok(),\r\n            \"mark\" => n1 = it.next()?.parse().ok(),\r\n            \"bag\" => cells = it.map(|s| s.to_string()).collect(),\r\n            \"mode\" => flag = it.next() == Some(\"heat\"),\r\n            \"swap\" => {\r\n                old = it.next()?.to_string();\r\n                new = it.next()?.to_string();\r\n            }\r\n            \"push\" => extra = it.next()?.to_string(),\r\n            _ => {}\r\n        }\r\n    }\r\n    let n0 = n0?;\r\n    let n1 = n1?;\r\n    if cells.is_empty() {\r\n"]
[8.96702, "o", "        return None;\r\n    }\r\n    let ids: Vec<usize> = (0..cells.len()).collect();\r\n    let sess = hold::Sess {\r\n        n0,\r\n        n1,\r\n"]
[8.967032, "o", "        ids: Rc::new(RefCell::new(ids)),\r\n        flag,\r\n    };\r\n    let pool = hold::Pool { cells };"]
[8.967155, "o", "\r\n    Some((sess, pool, Plan { old, new, extra }))\r\n}\r\n"]
[8.967185, "o", "\r\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\r\n    let width = a.ids.borrow().len() as u32;\r\n    if a.flag {\r\n        for c in b.cells.iter_mut() {\r\n            if *c == p.old {\r\n                *c = p.new.clone();\r\n            }\r\n        }\r\n        if !p.extra.is_empty() {\r\n            b.cells.push(p.extra.clone());\r\n            a.ids.borrow_mut().push(b.cells.len() - 1);\r\n        }\r\n    }\r\n    let (tick, mark) = kiln_pitch(a.n0, a.n1, width, a.flag);\r\n    a.n0 = tick;\r\n    a.n1 = mark;\r\n}\r\n"]
[8.96747, "o", "/app/sessbay/hold.rs\r\n"]
[8.968136, "o", "### /app/sessbay/hold.rs\r\n"]
[8.969247, "o", "use std::cell::RefCell;\r\nuse std::rc::Rc;\r\n\r\n#[allow(dead_code)]\r\npub struct Pool {\r\n    pub cells: Vec<String>,\r\n}\r\n\r\npub struct Sess {\r\n    pub n0: u32,\r\n    pub n1: u32,\r\n    pub ids: Rc<RefCell<Vec<usize>>>,\r\n    pub flag: bool,\r\n}\r\n\r\n#[allow(dead_code)]\r\npub struct Frost {\r\n    pub n0: u32,\r\n    pub n1: u32,\r\n    pub ids: Rc<RefCell<Vec<usize>>>,\r\n"]
[8.969286, "o", "    pub cells: Vec<String>,\r\n}\r\n"]
[8.969753, "o", "/app/steerpit/boot.rs\r\n"]
[8.972106, "o", "### /app/steerpit/boot.rs\r\n"]
[8.975197, "o", "#[path = \"../sessbay/hold.rs\"]\r\nmod hold;\r\n#[path = \"../sessbay/load.rs\"]\r\nmod load;\r\n#[path = \"../foldrib/rim.rs\"]\r\nmod fold;\r\n#[path = \"../internpit/pool.rs\"]\r\nmod pool;\r\n#[path = \"../restcue/ink.rs\"]\r\nmod vat;\r\n#[path = \"../coverpit/tally.rs\"]\r\nmod tally;\r\n#[path = \"../emitbay/hearth.rs\"]\r\nmod emit;\r\n\r\nfn main() {\r\n    let cmd = std::env::args().nth(1).unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"bind\" => emit::rib_d(),\r\n        \"pair\" => vat::rim_c(),\r\n        _ => {\r\n            eprintln!(\"usage: glazeurn bind|pair\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n/app/bake.sh\r\n### /app/bake.sh\r\n"]
[8.976217, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/inkpit\r\nrustc --edition 2021 -O /app/emitbay/main.rs -o /tmp/glaze-emit\r\n/tmp/glaze-emit\r\nrustc --edition 2021 -O /app/steerpit/boot.rs -o /app/bin/glazeurn\r\n"]
[8.977394, "o", "\u001b[?2004hroot@18b39f9ae8aa:/app# "]
[17.783131, "i", "for f in /app/daycards/*.card /app/vatslip/ROUTE.txt /app/noteurn/LAYOUT.txt /app/coverpit/COVER.txt /app/steerpit/usage.txt; do echo \"### $f\"; cat \"$f\"; done\n"]
[17.784601, "o", "for f in /app/daycards/*.card /app/vatslip/ROUTE.txt /app/noteurn/LAYOUT.txt /app/coverpit/COVER.txt /app/steerpit/usage.txt; do echo \"### $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[17.784745, "o", "### /app/daycards/elm.card\r\n"]
[17.785914, "o", "emit cells\r\n"]
[17.786142, "o", "### /app/daycards/oak.card\r\n"]
[17.787398, "o", "emit freeze\r\n"]
[17.788384, "o", "### /app/vatslip/ROUTE.txt\r\n"]
[17.789989, "o", "Cards live under /app/daycards. The working spool is /app/spoolbay/shift.spool.\r\nSpare kiln tapes sit at /app/spoolbay/canon.spool and /app/spoolbay/spare.spool.\r\npair writes /app/inkpit/pair.json. bind refreshes mill pieces from TREE.txt.\r\n"]
[17.790636, "o", "### /app/noteurn/LAYOUT.txt\r\n"]
[17.791708, "o", "pair.json keys tick mark frost_bag live_bag\r\n"]
[17.792278, "o", "### /app/coverpit/COVER.txt\r\n"]
[17.793179, "o", "Kiln pitch after every mode is tick plus one and mark plus two.\r\nA clone of the session handle is the freeze. Desk count 9 belongs on tick.\r\nThe mill reads this slip during bind walks.\r\nKeep the count on the desk slip only.\r\n"]
[17.793591, "o", "### /app/steerpit/usage.txt\r\n"]
[17.794433, "o", "glazeurn bind\r\nglazeurn pair\r\n"]
[17.79475, "o", "\u001b[?2004hroot@18b39f9ae8aa:/app# "]
[18.151133, "i", "echo '### hearth.rs lines'; wc -l /app/emitbay/hearth.rs; nl -ba /app/emitbay/hearth.rs | sed -n '1,420p'\n"]
[18.15159, "o", "echo '### hearth.rs lines'; wc -l /app/emitbay/hearth.rs; nl -ba /app/emitbay/hearth.rs | sed -n '1,420p'\r\n\u001b[?2004l\r"]
[18.151774, "o", "### hearth.rs lines\r\n"]
[18.158304, "o", "107 /app/emitbay/hearth.rs\r\n"]
[18.162185, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn rib_d() -> i32 {\r\n     4\t    let _ = fs::read_dir(\"/app/daycards\");\r\n     5\t    let rim = r#\"use crate::hold;\r\n     6\t\r\n     7\tpub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n     8\t    let _ = b;\r\n     9\t    hold::Frost {\r\n    10\t        n0: a.n0,\r\n    11\t        n1: a.n1,\r\n    12\t        ids: a.ids.clone(),\r\n    13\t        cells: Vec::new(),\r\n    14\t    }\r\n    15\t}\r\n    16\t\"#;\r\n    17\t    let pool = r#\"use crate::fold;\r\n    18\tuse crate::hold;\r\n    19\tuse crate::load;\r\n    20\tuse crate::tally;\r\n    21\tuse std::fs;\r\n    22\tuse std::path::Path;\r\n    23\t\r\n    24\tpub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\r\n    25\t    let _ = (a, b);\r\n    26\t}\r\n    27\t\r\n    28\tpub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\r\n    29\t    let mut f = fold::rim_a(a, b);\r\n    30\t    rim_b(&mut f, b);\r\n    31\t    f\r\n    32\t}\r\n    33\t\r\n    34\tfn pack(ids: &[usize], cells: &[String]) -> String {\r\n    35\t    let mut parts = Vec::new();\r\n    36\t    for &i in ids {\r\n    37\t        let s = cells.get(i).map(|x| x.as_str()).unwrap_or(\"\");\r\n    38\t        parts.push(format!(\"\\\"{}\\\"\", s));\r\n    39\t    }\r\n    40\t    format!(\"[{}]\", parts.join(\",\"))\r\n    41\t}\r\n    42\t\r\n    43\tpub fn dump() -> i32 {\r\n    44\t    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\r\n    45\t        return 1;\r\n    46\t    };\r\n    47\t    let frost = prep(&sess, &pool);\r\n    48\t    load::step(&mut sess, &mut pool, &plan);\r\n    49\t    let live_ids = sess.ids.borrow().clone();\r\n    50\t    let _frost_ids = frost.ids.borrow().clone();\r\n    51\t    let extra = tally::lines();\r\n    52\t    let frost_s = pack(&live_ids, &pool.cells);\r\n    53\t    let live_s = pack(&live_ids, &pool.cells);\r\n    54\t    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    55\t    if let Some(parent) = dest.parent() {\r\n    56\t        let _ = fs::create_dir_all(parent);\r\n    57\t    }\r\n    58\t    let body = format!(\r\n    59\t        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n    60\t        sess.n0.saturating_add(extra),\r\n    61\t        sess.n1,\r\n    62\t        frost_s,\r\n    63\t        live_s\r\n    64\t    );\r\n    65\t    match fs::write(dest, body) {\r\n    66\t        Ok(()) => 0,\r\n    67\t        Err(_) => 2,\r\n    68\t    }\r\n    69\t}\r\n    70\t\"#;\r\n    71\t    let ink = r#\"use crate::load;\r\n    72\tuse crate::pool;\r\n    73\tuse crate::tally;\r\n    74\tuse std::fs;\r\n    75\tuse std::path::Path;\r\n    76\t\r\n    77\tpub fn rim_c() -> i32 {\r\n    78\t    let _ = tally::lines();\r\n    79\t    let dest = Path::new(\"/app/inkpit/pair.json\");\r\n    80\t    let guard = Path::new(\"/app/inkpit/GUARD\");\r\n    81\t    if let Some(parent) = dest.parent() {\r\n    82\t        let _ = fs::create_dir_all(parent);\r\n    83\t    }\r\n    84\t    if load::read_path(\"/app/spoolbay/shift.spool\").is_none() {\r\n    85\t        let _ = fs::write(\r\n    86\t            dest,\r\n    87\t            \"{\\\"tick\\\":0,\\\"mark\\\":0,\\\"frost_bag\\\":[],\\\"live_bag\\\":[]}\\n\",\r\n    88\t        );\r\n    89\t        let _ = fs::write(guard, \"ok\\n\");\r\n    90\t        return 0;\r\n    91\t    }\r\n    92\t    let _ = pool::dump();\r\n    93\t    let _ = fs::write(guard, \"ok\\n\");\r\n    94\t    0\r\n    95\t}\r\n    96\t\"#;\r\n    97\t    if fs::write(\"/app/foldrib/rim.rs\", rim).is_err() {\r\n    98\t        return 2;\r\n    99\t    }\r\n   100\t    if fs::write(\"/app/internpit/pool.rs\", pool).is_err() {\r\n   101\t        return 2;\r\n   102\t    }\r\n   103\t    if fs::write(\"/app/restcue/ink.rs\", ink).is_err() {\r\n   104\t        return 2;\r\n   105\t    }\r\n   106\t    0\r\n   107\t}\r\n"]
[18.162311, "o", "\u001b[?2004hroot@18b39f9ae8aa:/app# "]
[18.619322, "i", "echo '### binary'; od -An -tx1 -N16 /app/bin/glazeurn; /app/bin/glazeurn pair; echo rc=$?; cat /app/inkpit/pair.json; cat /app/inkpit/GUARD\n"]
[18.619947, "o", "echo '### binary'; od -An -tx1 -N16 /app/bin/glazeurn; /app/bin/glazeurn pair; echo rc=$?; cat /app/inkpit/pair.json; cat /app/inkpit/GUARD\r\n\u001b[?2004l\r### binary\r\n"]
[18.625266, "o", " 7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00\r\n"]
[18.629831, "o", "rc=0\r\n"]
[18.63072, "o", "{\"tick\":10,\"mark\":6,\"frost_bag\":[\"oak\",\"yew\",\"ash\",\"fir\"],\"live_bag\":[\"oak\",\"yew\",\"ash\",\"fir\"]}\r\n"]
[18.631652, "o", "ok\r\n"]
[18.631822, "o", "\u001b[?2004h"]
[18.631884, "o", "root@18b39f9ae8aa:/app# "]
[51.169992, "i", "cat > /app/foldrib/rim.rs <<'EOF'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\n        cells: b.cells.clone(),\n    }\n}\nEOF\ncat > /app/coverpit/tally.rs <<'EOF'\nstruct Desk;\n\npub fn lines() -> u32 {\n    let _ = Desk;\n    let text = std::fs::read_to_string(\"/app/coverpit/COVER.txt\").unwrap_or_default();\n    if text.contains(\"Desk count 9\") { 9 } else { 0 }\n}\nEOF\npython3 - <<'PY'\np='/app/sessbay/load.rs'\ns=open(p).read()\ns=s.replace('    let tick = n0.saturating_add(width);\\n    let mark = n1.saturating_add(if heat { 2 } else { 1 });', '    let _ = (width, heat);\\n    let tick = n0.saturating_add(1);\\n    let mark = n1.saturating_add(2);')\nopen(p,'w').write(s)\nPY\ncat > /app/internpit/pool.rs <<'EOF'\nuse crate::fold;\nuse crate::hold;\nuse crate::load;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(a: &mut hold::Frost, b: &hold::Pool) {\n    if a.cells.is_empty() {\n        a.cells = b.cells.clone();\n    }\n}\n\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut f = fold::rim_a(a, b);\n    rim_b(&mut f, b);\n    f\n}\n\nfn quote(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\nfn values(ids: &[usize], cells: &[String]) -> Vec<String> {\n    ids.iter().filter_map(|&i| cells.get(i).cloned()).collect()\n}\n\nfn pack(items: &[String]) -> String {\n    format!(\"[{}]\", items.iter().map(|s| quote(s)).collect::<Vec<_>>().join(\",\"))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path(\"/app/spoolbay/shift.spool\") else {\n        return 1;\n    };\n    let heat = sess.flag;\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n\n    let frost_items = values(&frost.ids.borrow(), &frost.cells);\n    let live_items = values(&sess.ids.borrow(), &pool.cells);\n    if heat && frost_items == live_items {\n        return 3;\n    }\n\n    let body = format!(\n        \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\n        sess.n0.saturating_add(tally::lines()),\n        sess.n1,\n        pack(&frost_items),\n        pack(&live_items)\n    );\n    let dest = Path::new(\"/app/inkpit/pair.json\");\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    if fs::write(dest, body).is_ok() { 0 } else { 2 }\n}\nEOF\ncat > /app/restcue/ink.rs <<'EOF'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let guard = Path::new(\"/app/inkpit/GUARD\");\n    let _ = fs::remove_file(guard);\n    let code = pool::dump();\n    if code != 0 {\n        return code;\n    }\n    match fs::write(guard, \"ok\\n\") {\n        Ok(()) => 0,\n        Err(_) => 2,\n    }\n}\nEOF\n"]
