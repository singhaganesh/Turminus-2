[?2004l[?2004h>         Err(_) => return 1,
[?2004l[?2004h>     };
[?2004l[?2004h>     cards.sort();
[?2004l[?2004h>     let mut freeze = false;
[?2004l[?2004h>     let mut cells = false;
[?2004l[?2004h>     for card in cards {
[?2004l[?2004h>         let text = match fs::read_to_string(card) { Ok(s) => s, Err(_) => return 1 };
[?2004l[?2004h>         for line in text.lines().map(str::trim) {
[?2004l[?2004h>             freeze |= line == "emit freeze";
[?2004l[?2004h>             cells |= line == "emit cells";
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     if !freeze || !cells { return 1; }
[?2004l[?2004h> 
[?2004l[?2004h>     // Refresh every Rust mill piece beneath every TREE entry.
