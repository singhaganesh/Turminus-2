[?2004l[?2004h>         Ok(s) => s,
[?2004l[?2004h>         Err(_) => return 1,
[?2004l[?2004h>     };
[?2004l[?2004h>     for name in tree.lines().map(str::trim).filter(|s| !s.is_empty()) {
[?2004l[?2004h>         if name.contains('/') || name.contains("..") { return 1; }
[?2004l[?2004h>         let dir = Path::new("/app").join(name);
[?2004l[?2004h>         let pieces = match rust_pieces(&dir) { Ok(v) if !v.is_empty() => v, _ => return 1 };
[?2004l[?2004h>         for piece in pieces {
[?2004l[?2004h>             let body = match fs::read(&piece) { Ok(v) => v, Err(_) => return 2 };
[?2004l[?2004h>             if fs::write(&piece, body).is_err() { return 2; }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
