[31.635674, "o", "--- StowRun.java ---\r\n"]
[31.636686, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n"]
[31.637038, "o", "     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.security.MessageDigest;\r\n     6\t\r\n     7\tpublic class StowRun {\r\n     8\t    static final int ALIGN = 32;\r\n     9\t\r\n    10\t    public static class CutErr extends RuntimeException {\r\n    11\t    }\r\n    12\t\r\n    13\t    public static void run(Path slip, boolean cut) throws Exception {\r\n    14\t        byte[] payload = Files.readAllBytes(slip);\r\n    15\t        Path silo = Paths.get(\"/app/silo\");\r\n    16\t        Files.createDirectories(silo);\r\n    17\t        Path blob = silo.resolve(\"blob.bin\");\r\n    18\t        Path pin = silo.resolve(\"pin.bin\");\r\n    19\t        if (!Files.exists(blob)) {\r\n    20\t            Files.write(blob, new byte[0]);\r\n    21\t        }\r\n    22\t        if (!Files.exists(pin)) {\r\n    23\t            Files.write(pin, new byte[0]);\r\n    24\t        }\r\n    25\t        long offset = Files.size(blob);\r\n    26\t        RibChan bch = new RibChan(blob);\r\n    27\t        RibChan pch = new RibChan(pin);\r\n    28\t        int len = payload.length;\r\n    29\t        int rec = 4 + len;\r\n    30\t        int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n    31\t        ByteBuffer recb = ByteBuffer.allocate(rec + pad);\r\n    32\t        recb.putInt(len);\r\n    33\t        recb.put(payload);\r\n    34\t        recb.put(new byte[pad]);\r\n    35\t        bch.append(recb.array());\r\n    36\t        byte[] id = idOf(payload);\r\n    37\t        ByteBuffer mk = ByteBuffer.allocate(48);\r\n    38\t        mk.put(new byte[] {'P', 'N', '0', '1'});\r\n    39\t        mk.putLong(offset);\r\n    40\t        mk.putInt(len);\r\n    41\t        mk.putInt(Crc.of(payload));\r\n    42\t        mk.put(id);\r\n    43\t        mk.put(new byte[12]);\r\n    44\t        pch.append(mk.array());\r\n    45\t        String[] order = ForceSeq.names();\r\n    46\t        int n = 0;\r\n    47\t        for (String ch : order) {\r\n    48\t            if (\"blob\".equals(ch)) {\r\n    49\t                bch.force();\r\n    50\t            } else {\r\n    51\t                pch.force();\r\n    52\t            }\r\n    53\t            n++;\r\n    54\t            if (cut && n == 1) {\r\n    55\t                throw new CutErr();\r\n    56\t            }\r\n    57\t        }\r\n    58\t    }\r\n    59\t\r\n    60\t    static byte[] idOf(byte[] payload) throws Exception {\r\n    61\t        MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n    62\t        byte[] d = md.digest(payload);\r\n    63\t        StringBuilder hx = new StringBuilder();\r\n    64\t        for (byte v : d) {\r\n    65\t            hx.append(String.format(\"%02x\", v & 0xff));\r\n    66\t        }\r\n    67\t        String tail = hx.substring(32, 64);\r\n    68\t        byte[] id = new byte[16];\r\n    69\t        for (int k = 0; k < 16; k++) {\r\n    70\t            id[k] = (byte) Integer.parseInt(tail.substring(k * 2, k * 2 + 2), 16);\r\n    71\t        }\r\n    72\t        return id;\r\n    73\t    }\r\n    74\t\r\n    75\t    public static void main(String[] args) throws Exception {\r\n    76\t        if (args.length < 1) {\r\n    77\t            System.exit(2);\r\n    78\t        }\r\n    79\t        run(Paths.get(args[0]), false);\r\n    80\t    }\r\n    81\t}\r\n"]
