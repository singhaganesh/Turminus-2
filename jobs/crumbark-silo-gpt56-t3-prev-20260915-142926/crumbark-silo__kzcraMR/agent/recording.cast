[32.137111, "o", "     8\t        try {\r\n     9\t            StowRun.run(Paths.get(args[0]), true);\r\n    10\t        } catch (StowRun.CutErr e) {\r\n    11\t            System.exit(0);\r\n    12\t        }\r\n    13\t    }\r\n    14\t}\r\n"]
