[85.849073, "i", "cat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class YankRun {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1) System.exit(2);\n        byte[] id;\n        try { id = hex(args[0]); }\n        catch (IllegalArgumentException e) { System.exit(2); return; }\n        byte[] got = MistSpan.tint_k(Paths.get(\"/app/silo\"), id);\n        if (got == null) System.exit(1);\n        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\n        System.out.write(got);\n    }\n\n    static byte[] hex(String s) {\n        if (!s.matches(\"[0-9a-f]{32}\")) throw new IllegalArgumentException();\n        byte[] out = new byte[16];\n        for (int i = 0; i < 16; i++)\n            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        return out;\n    }\n}\nEOF\n/app/bin/crumbark tamp\nprintf '%s\\n' '--- generated order ---'; cat /app/recipit/ForceSeq.java\n"]
