[85.365888, "i", "cat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.Arrays;\n\npublic class MistSpan {\n    static final int ROW = 48;\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        byte[] pins = Files.exists(silo.resolve(\"pin.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"pin.bin\")) : new byte[0];\n        byte[] blob = Files.exists(silo.resolve(\"blob.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"blob.bin\")) : new byte[0];\n        for (int pos = 0; pos + ROW <= pins.length; pos += ROW) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, ROW).slice();\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            if (Arrays.equals(id, wanted)) {\n                return payload(blob, magic, off, len, crc, id);\n            }\n        }\n        return null;\n    }\n\n    static byte[] payload(byte[] blob, byte[] magic, long off, int len, int crc, byte[] id)\n            throws Exception {\n        if (!Arrays.equals(magic, new byte[] {'P','N','0','1'}) || off < 0 || len < 0)\n            return null;\n        long end = off + 4L + len;\n        if (end < off || off > Integer.MAX_VALUE || end > blob.length) return null;\n        int at = (int) off;\n        if (ByteBuffer.wrap(blob, at, 4).getInt() != len) return null;\n        byte[] out = Arrays.copyOfRange(blob, at + 4, at + 4 + len);\n        if (Crc.of(out) != crc) return null;\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(out);\n        for (int i = 0; i < 16; i++) if (id[i] != digest[i]) return null;\n        return out;\n    }\n}\nEOF\ncat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class HueWalk {\n    public static int orb_n(Path blobPath, Path pinPath, Path jsonPath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean bad = pins.length % 48 != 0;\n        for (int pos = 0; pos + 48 <= pins.length; pos += 48) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, 48).slice();\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            byte[] body = MistSpan.payload(blob, magic, off, len, crc, id);\n            if (body == null) bad = true;\n            else held.add(hex(id));\n        }\n        String note = bad ? \"gap\" : \"ok\";\n        String kind = bad ? \"void\" : \"live\";\n        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\" + note\n                + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\"}\";\n        Files.writeString(jsonPath, json);\n        return bad ? 1 : 0;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 0xff));\n        return sb.toString();\n    }\n\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < held.size(); i++) {\n            if (i != 0) sb.append(',');\n            sb.append('\"').append(held.get(i)).append('\"');\n        }\n        return sb.append(']').toString();\n    }\n\n    public static void main(String[] args) throws Exception {\n        Path silo = Path.of(\"/app/silo\");\n        System.exit(orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"),\n                silo.resolve(\"wake.json\")));\n    }\n}\nEOF\n"]
