[21.2249, "o", "--- NOTE.txt ---\r\n"]
[21.226429, "o", "     1\tDesk runbook: tamp after source edits. lade a slip, then wake, then pull an id from held.\r\n     2\t\r\n     3\tIf a pull comes back empty, some shifts bump retrycue/PauseCue and wait. That path is still in the tree for the old flaky-reader hypothesis.\r\n     4\t\r\n     5\tA scratch slip may be written at `/tmp/lade.bin`.\r\n"]
