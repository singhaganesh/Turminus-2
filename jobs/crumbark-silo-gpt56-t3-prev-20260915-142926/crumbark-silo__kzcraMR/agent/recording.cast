[31.635423, "o", "     1\timport java.io.ByteArrayOutputStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.StandardOpenOption;\r\n     5\t\r\n     6\tpublic class RibChan {\r\n     7\t    final Path file;\r\n     8\t    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\r\n     9\t\r\n    10\t    RibChan(Path file) {\r\n    11\t        this.file = file;\r\n"]
[31.635523, "o", "    12\t    }\r\n    13\t\r\n    14\t    void append(byte[] x) throws Exception {\r\n    15\t        pending.write(x);\r\n    16\t    }\r\n    17\t\r\n    18\t    void force() throws Exception {\r\n    19\t        byte[] out = pending.toByteArray();\r\n    20\t        if (out.length == 0) {\r\n    21\t            return;\r\n    22\t        }\r\n    23\t        Files.write(file, out, StandardOpenOption.CREATE, StandardOpenOption.APPEND);\r\n"]
