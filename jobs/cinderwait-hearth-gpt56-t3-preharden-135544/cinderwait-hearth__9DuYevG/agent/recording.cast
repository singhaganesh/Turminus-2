[13.983924, "o", "printf '%s\\n' '--- cinderwait ---'; file /app/bin/cinderwait; sed -n '1,240p' /app/bin/cinderwait; printf '%s\\n' '--- tree ---'; find /app -maxdepth 4 -type f -printf '%p\\n' | sort"]
[13.990087, "o", "\r\n\u001b[?2004l\r"]
[13.990362, "o", "--- cinderwait ---\r\n"]
[14.023701, "o", "/app/bin/cinderwait: Bourne-Again shell script, ASCII text executable\r\n"]
[14.035706, "o", "#!/bin/bash\r\nset -euo pipefail\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  kindle)\r\n    exec /app/kindle.sh\r\n    ;;\r\n  watch)\r\n    exec \"$JAVA\" -cp /app/jarhearth/ship.jar ShipMain \"$@\"\r\n    ;;\r\n  peek)\r\n    exec \"$JAVA\" -cp /app/blastcp PeekMain \"$@\"\r\n    ;;\r\n  draft)\r\n    exec \"$JAVA\" -cp /app/jarhearth/draft.jar DraftMain \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\n--- tree ---\r\n"]
[14.038206, "o", "/app/bin/cinderwait\r\n/app/blastcp/DraftMain.class\r\n/app/blastcp/Glue.class\r\n/app/blastcp/Hopper.class\r\n/app/blastcp/KilnShip.class\r\n/app/blastcp/Pacer.class\r\n/app/blastcp/PeekMain.class\r\n/app/blastcp/Rill.class\r\n/app/blastcp/ShipMain.class\r\n/app/blastcp/Tarn.class\r\n/app/draftcue/DraftMain.java\r\n/app/hopbags/alpha.bag\r\n/app/hopbags/elm.bag\r\n/app/hopbags/mute.bag\r\n/app/hopcue/Hopper.java\r\n/app/jarhearth/STAMP.body\r\n/app/jarhearth/draft.jar\r\n/app/jarhearth/ship.jar\r\n/app/kilnrib/KilnShip.java\r\n/app/kindle.sh\r\n/app/opslip/CARD.txt\r\n"]
[14.038252, "o", "/app/opslip/MARK.txt\r\n/app/opslip/NOTES.txt\r\n/app/opslip/ROUTE.txt\r\n/app/opslip/VERBS.txt\r\n/app/opslip/jarscan.py\r\n/app/peekcue/PeekMain.java\r\n/app/rillcue/Rill.java\r\n/app/softmill/Pacer.java\r\n/app/tarnpit/Tarn.java\r\n/app/watchbay/Glue.java\r\n/app/watchbay/ShipMain.java\r\n"]
