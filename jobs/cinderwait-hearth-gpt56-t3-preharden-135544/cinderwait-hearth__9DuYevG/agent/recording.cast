[146.602259, "i", "set +e\n/app/bin/cinderwait draft /app/hopbags/alpha.bag; r=$?; echo \"draft rc=$r\"; cat /app/jarhearth/watch.json\ncp /app/jarhearth/ship.jar /tmp/ship.good.jar\npython3 - <<'PY'\nimport io, zipfile\np='/app/jarhearth/ship.jar'\nb=io.BytesIO()\nwith zipfile.ZipFile(p) as zin, zipfile.ZipFile(b,'w') as zout:\n    for i in zin.infolist():\n        if i.filename != 'STAMP':\n            zout.writestr(i, zin.read(i.filename))\nopen(p,'wb').write(b.getvalue())\nPY\n/app/bin/cinderwait watch /app/hopbags/alpha.bag; r=$?; echo \"missing-stamp rc=$r exists=$(test -e /app/jarhearth/watch.json && echo yes || echo no)\"\nmv /tmp/ship.good.jar /app/jarhearth/ship.jar\nset -e\n/app/bin/cinderwait kindle\n/app/bin/cinderwait watch /app/hopbags/alpha.bag\npython3 - <<'PY'\nimport json, sys, zipfile\nsys.path.insert(0, '/app/opslip')\nfrom pathlib import Path\nfrom jarscan import read_stamp\nledger=json.load(open('/app/jarhearth/watch.json'))\nprint('final ledger:', ledger)\nprint('final stamp:', read_stamp(Path('/app/jarhearth/ship.jar')))\nassert ledger == {'seen':4251, 'bag':'/app/hopbags/alpha.bag', 'note':'keld-tight-9'}\nassert read_stamp(Path('/app/jarhearth/ship.jar')) == 'keld-tight-9'\nPY\n"]
