[99.065682, "i", "cat > /app/tarnpit/Tarn.java <<'EOF'\npublic class Tarn {\n    public volatile int waiting;\n    public volatile int keld;\n    public int copy;\n\n    public int mira() {\n        waiting = 1;\n        int a;\n        while ((a = keld) == 0) {\n            Thread.onSpinWait();\n        }\n        return a;\n    }\n}\nEOF\ncat > /app/hopcue/Hopper.java <<'EOF'\npublic class Hopper {\n    public static void feed(Tarn t, int w) {\n        // Draft records the hop token, but the gatherer publishes its word\n        // separately on the mill's wait board.\n        t.copy = w;\n        if (w != 0) {\n            t.keld = w + 9;\n        }\n    }\n}\nEOF\ncat > /app/watchbay/Glue.java <<'EOF'\npublic class Glue {\n    public static int haul(Tarn t, int w) throws InterruptedException {\n        if (w == 0) {\n            return 0;\n        }\n        Thread gatherer = new Thread(() -> {\n            while (t.waiting == 0) {\n                Thread.onSpinWait();\n            }\n            Hopper.feed(t, w);\n        }, \"gatherer\");\n        gatherer.start();\n        int seen = t.mira();\n        gatherer.join();\n        return seen;\n    }\n}\nEOF\ncat > /app/watchbay/ShipMain.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.zip.ZipFile;\n\npublic class ShipMain {\n    private static final Path OUT = Paths.get(\"/app/jarhearth/watch.json\");\n\n    public static int rib_n(String[] a) {\n        try {\n            Files.deleteIfExists(OUT);\n            if (a.length != 1 || !lid_q()) {\n                return 1;\n            }\n\n            Path bag = Paths.get(a[0]);\n            int token = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\n            Tarn mill = new Tarn();\n            int seen = Glue.haul(mill, token);\n            if (seen == 0) {\n                return 1;\n            }\n\n            String note = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\n            String body = \"{\\\"seen\\\":\" + seen\n                + \",\\\"bag\\\":\\\"\" + json(a[0])\n                + \"\\\",\\\"note\\\":\\\"\" + json(note) + \"\\\"}\\n\";\n            Files.createDirectories(OUT.getParent());\n            Files.writeString(OUT, body, StandardCharsets.UTF_8);\n            return 0;\n        } catch (Exception ex) {\n            try {\n                Files.deleteIfExists(OUT);\n            } catch (Exception ignored) {\n            }\n            return 1;\n        }\n    }\n\n    public static void main(String[] a) {\n        System.exit(rib_n(a));\n    }\n\n    private static String json(String s) {\n        StringBuilder b = new StringBuilder();\n        for (int i = 0; i < s.length(); i++) {\n            char c = s.charAt(i);\n            switch (c) {\n                case '\\\\': b.append(\"\\\\\\\\\"); break;\n                case '\"': b.append(\"\\\\\\\"\"); break;\n                case '\\b': b.append(\"\\\\b\"); break;\n                case '\\f': b.append(\"\\\\f\"); break;\n                case '\\n': b.append(\"\\\\n\"); break;\n                case '\\r': b.append(\"\\\\r\"); break;\n                case '\\t': b.append(\"\\\\t\"); break;\n                default:\n                    if (c < 0x20) b.append(String.format(\"\\\\u%04x\", (int)c));\n                    else b.append(c);\n            }\n        }\n        return b.toString();\n    }\n\n    static boolean lid_q() {\n        try {\n            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\n            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\n                var e = z.getEntry(\"STAMP\");\n                if (e == null) return false;\n                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\n                return want.equals(got);\n            }\n        } catch (Exception ex) {\n            return false;\n        }\n    }\n}\nEOF\n/app/bin/cinderwait kindle\n"]
