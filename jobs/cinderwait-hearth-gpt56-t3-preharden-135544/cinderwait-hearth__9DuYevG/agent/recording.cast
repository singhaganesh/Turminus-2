[103.186277, "i", "set +e\nprintf '%s\\n' '--- peek ---'\nfor f in /app/hopbags/alpha.bag /app/hopbags/elm.bag /app/hopbags/mute.bag; do printf '%s: ' \"$f\"; /app/bin/cinderwait peek \"$f\"; echo \"rc=$?\"; done\nprintf '%s\\n' '--- watches ---'\nfor f in /app/hopbags/alpha.bag /app/hopbags/elm.bag; do /app/bin/cinderwait watch \"$f\"; r=$?; printf '%s rc=%s ledger=' \"$f\" \"$r\"; cat /app/jarhearth/watch.json; done\n/app/bin/cinderwait watch /app/hopbags/mute.bag; r=$?; echo \"mute rc=$r exists=$(test -e /app/jarhearth/watch.json && echo yes || echo no)\"\nprintf '9000\\n' >/tmp/grade-time.bag\n/app/bin/cinderwait watch /tmp/grade-time.bag; r=$?; echo \"external/high rc=$r\"; cat /app/jarhearth/watch.json\npython3 - <<'PY'\nimport json, zipfile\np='/app/jarhearth/watch.json'\nprint('parsed ledger:', json.load(open(p)))\nwith zipfile.ZipFile('/app/jarhearth/ship.jar') as z:\n print('stamp:', z.read('STAMP').decode().strip())\n print('classes:', sorted(x for x in z.namelist() if x.endswith('.class')))\nPY\nset -e\n"]
[103.189972, "o", "set +e\r\nprintf '%s\\n' '--- peek ---'\r\nfor f in /app/hopbags/alpha.bag /app/hopbags/elm.bag /app/hopbags/mute.bag; do printf '%s: ' \"$f\"; /app/bin/cinderwait peek \"$f\"; echo \"rc=$?\"; done\r\nprintf '%s\\n' '--- watches ---'\r\nfor f in /app/hopbags/alpha.bag /app/hopbags/elm.bag; do /app/bin/cinderwait watch \"$f\"; r=$?; printf '%s rc=%s ledger=' \"$f\" \"$r\"; cat /app/jarhearth/watch.json; done\r\n/app/bin/cinderwait watch /app/hopbags/mute.bag; r=$?; echo \"mute rc=$r exists=$(test -e /app/jarhearth/watch.json && echo yes || echo no)\"\r\nprintf '9000\\n' >/tmp/grade-time.bag\r\n/app/bin/cinderwait watch /tmp/grade-time.bag; r=$?; echo \"external/high rc=$r\"; cat /app/jarhearth/watch.json\r\npython3 - <<'PY'\r\nimport json, zipfile\r\np='/app/jarhearth/watch.json'\r\nprint('parsed ledger:', json.load(open(p)))\r\nwith zipfile.ZipFile('/app/jarhearth/ship.jar') as z:\r\n print('stamp:', z.read('STAMP').decode().strip())\r\n print('classes:', sorted(x for x in z.namelist() if x.endswith('.class')))\r\nPY\r\nset -e\r\n"]
