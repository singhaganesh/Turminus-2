[49.493672, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\timport java.util.stream.Stream;\r\n     5\t\r\n     6\tpublic class KilnShip {\r\n     7\t    public static void main(String[] a) throws Exception {\r\n     8\t        Path src = Paths.get(a[0]);\r\n     9\t        Path dst = Paths.get(a[1]);\r\n    10\t        Files.createDirectories(dst);\r\n    11\t        int n = 0;\r\n    12\t        try (Stream<Path> walk = Files.walk(src)) {\r\n    13\t            for (Path p : walk.filter(x -> x.toString().endsWith(\".java\")).toList()) {\r\n    14\t                String rel = src.relativize(p).toString();\r\n    15\t                String s = Files.readString(p);\r\n    16\t                String out = tighten(s);\r\n    17\t                if (!out.equals(s)) {\r\n    18\t                    n++;\r\n    19\t                }\r\n    20\t                Path q = dst.resolve(rel);\r\n    21\t                Files.createDirectories(q.getParent());\r\n    22\t                Files.writeString(q, out);\r\n    23\t            }\r\n    24\t        }\r\n    25\t        Path stamp = Paths.get(\"/app/jarhearth/STAMP.body\");\r\n    26\t        Files.createDirectories(stamp.getParent());\r\n    27\t        Files.writeString(stamp, Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim() + \"\\n\");\r\n    28\t        String rill = Files.readString(dst.resolve(\"Rill.java\"));\r\n    29\t        if (rill.contains(\"while (a == 0)\")) {\r\n    30\t            System.err.println(\"rill wait still packed\");\r\n    31\t            System.exit(3);\r\n    32\t        }\r\n    33\t        if (n < 1) {\r\n    34\t            System.exit(4);\r\n    35\t        }\r\n    36\t    }\r\n    37\t\r\n    38\t    static String tighten(String s) {\r\n    39\t        String out = s;\r\n    40\t        if (!out.contains(\"volatile int keld\")) {\r\n    41\t            out = out.replaceAll(\r\n    42\t         