     1	public class PauseCue {
     2	    public static void nap() {
     3	        try {
     4	            Thread.sleep(20L);
     5	        } catch (InterruptedException e) {
     6	            Thread.currentThread().interrupt();
     7	        }
     8	    }
     9	}
