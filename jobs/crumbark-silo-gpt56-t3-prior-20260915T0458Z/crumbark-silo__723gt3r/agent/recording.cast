[31.848848, "o", "     7\t        }\r\n     8\t        try {\r\n     9\t            StowRun.run(Paths.get(args[0]), true);\r\n    10\t        } catch (StowRun.CutErr e) {\r\n    11\t            System.exit(0);\r\n    12\t        }\r\n    13\t    }\r\n    14\t}\r\n"]
[31.854229, "o", "### /app/hitchbay/DeskMain.java\r\n     1\tpublic class DeskMain {\r\n     2\t    public static void main(String[] args) throws Exception {\r\n     3\t        if (args.length < 1) {\r\n     4\t            System.exit(2);\r\n     5\t        }\r\n     6\t        String verb = args[0];\r\n     7\t        String[] rest = new String[Math.max(0, args.length - 1)];\r\n     8\t        if (args.length > 1) {\r\n     9\t            System.arraycopy(args, 1, rest, 0, rest.length);\r\n    10\t        }\r\n    11\t        if (\"lade\".equals(verb)) {\r\n    12\t            StowRun.main(rest);\r\n    13\t        } else if (\"wake\".equals(verb)) {\r\n    14\t            StirRun.main(rest);\r\n    15\t        } else if (\"pull\".equals(verb)) {\r\n    16\t            YankRun.main(rest);\r\n    17\t        } else if (\"nick\".equals(verb)) {\r\n    18\t            CutRun.main(rest);\r\n    19\t        } else {\r\n    20\t            System.exit(2);\r\n    21\t        }\r\n    22\t    }\r\n    23\t}\r\n### /app/hitchbay/RibChan.java\r\n     1\timport java.io.ByteArrayOutputStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.StandardOpenOption;\r\n     5\t\r\n     6\tpublic class RibChan {\r\n     7\t    final Path file;\r\n     8\t    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\r\n     9\t\r\n    10\t    RibChan(Path file) {\r\n    11\t        this.file = file;\r\n    12\t    }\r\n    13\t\r\n    14\t    void append(byte[] x) throws Exception {\r\n    15\t        pending.write(x);\r\n    16\t    }\r\n    17\t\r\n    18\t    void force() throws Exception {\r\n    19\t        byte[] out = pending.toByteArray();\r\n    20\t        if (out.length == 0) {\r\n    21\t            return;\r\n    22\t        }\r\n    23\t        Files.write(file, out, StandardOpenOption.CREATE, StandardOpenOption.APPEND);\r\n    24\t        pending.reset();\r\n    25\t    }\r\n    26\t}\r\n### /app/hitchbay/StirRun.java\r\n     1\timport java.nio.file.Path;\r\n     2\t\r\n     3\tpublic class StirRun {\r\n     4\t    public static void main(String[] args) throws Exception {\r\n     5\t        Path silo = Path.of(\"/app/silo\");\r\n     6\t        int rc = HueWalk.orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\"));\r\n     7\t        System.exit(rc);\r\n     8\t    }\r\n     9\t}\r\n### /app/hitchbay/StowRun.java\r\n"]
[31.856005, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.security.MessageDigest;\r\n     6\t\r\n     7\tpublic class StowRun {\r\n     8\t    static final int ALIGN = 32;\r\n     9\t\r\n    10\t    public static class CutErr extends RuntimeException {\r\n    11\t    }\r\n    12\t\r\n    13\t    public static void run(Path slip, boolean cut) throws Exception {\r\n    14\t        byte[] payload = Files.readAllBytes(slip);\r\n    15\t        Path silo = Paths.get(\"/app/silo\");\r\n    16\t        Files.createDirectories(silo);\r\n    17\t        Path blob = silo.resolve(\"blob.bin\");\r\n    18\t        Path pin = silo.resolve(\"pin.bin\");\r\n    19\t        if (!Files.exists(blob)) {\r\n    20\t            Files.write(blob, new byte[0]);\r\n    21\t        }\r\n    22\t        if (!Files.exists(pin)) {\r\n    23\t            Files.write(pin, new byte[0]);\r\n    24\t        }\r\n    25\t        long offset = Files.size(blob);\r\n    26\t        RibChan bch = new RibChan(blob);\r\n    27\t        RibChan pch = new RibChan(pin);\r\n    28\t        int len = payload.length;\r\n    29\t        int rec = 4 + len;\r\n    30\t        int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n    31\t        ByteBuffer recb = ByteBuffer.allocate(rec + pad);\r\n    32\t        recb.putInt(len);\r\n    33\t        recb.put(payload);\r\n    34\t        recb.put(new byte[pad]);\r\n    35\t        bch.append(recb.array());\r\n    36\t        byte[] id = idOf(payload);\r\n    37\t        ByteBuffer mk = ByteBuffer.allocate(48);\r\n    38\t        mk.put(new byte[] {'P', 'N', '0', '1'});\r\n    39\t        mk.putLong(offset);\r\n    40\t        mk.putInt(len);\r\n    41\t        mk.putInt(Crc.of(payload));\r\n    42\t        mk.put(id);\r\n    43\t        mk.put(new byte[12]);\r\n    44\t        pch.append(mk.array());\r\n    45\t        String[] order = ForceSeq.names();\r\n    46\t        int n = 0;\r\n    47\t        for (String ch : order) {\r\n    48\t            if (\"blob\".equals(ch)) {\r\n    49\t                bch.force();\r\n    50\t            } else {\r\n    51\t                pch.force();\r\n    52\t            }\r\n    53\t            n++;\r\n    54\t            if (cut && n == 1) {\r\n    55\t                throw new CutErr();\r\n    56\t            }\r\n    57\t        }\r\n    58\t    }\r\n    59\t\r\n    60\t    static byte[] idOf(byte[] payload) throws Exception {\r\n    61\t        MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n    62\t        byte[] d = md.digest(payload);\r\n    63\t        byte[] id = new byte[16];\r\n    64\t        System.arraycopy(d, 0, id, 0, 16);\r\n    65\t        return id;\r\n    66\t    }\r\n    67\t\r\n    68\t    public static void main(String[] args) throws Exception {\r\n    69\t        if (args.length < 1) {\r\n    70\t            System.exit(2);\r\n    71\t        }\r\n    72\t        run(Paths.get(args[0]), false);\r\n    73\t    }\r\n    74\t}\r\n"]
[31.860294, "o", "### /app/hitchbay/YankRun.java\r\n"]
[31.861736, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\t\r\n     5\tpublic class YankRun {\r\n     6\t    public static void main(String[] args) throws Exception {\r\n     7\t        if (args.length < 1) {\r\n     8\t            System.exit(2);\r\n     9\t        }\r\n    10\t        byte[] id = hex(args[0]);\r\n    11\t        Path silo = Paths.get(\"/app/silo\");\r\n    12\t        byte[] got = MistSpan.tint_k(silo, id);\r\n    13\t        if (got.length == 0 || allZero(got)) {\r\n    14\t            PauseCue.nap();\r\n    15\t            got = MistSpan.tint_k(silo, id);\r\n    16\t        }\r\n    17\t        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\r\n    18\t        System.out.write(got);\r\n    19\t    }\r\n    20\t\r\n    21\t    static boolean allZero(byte[] a) {\r\n    22\t        for (byte v : a) {\r\n    23\t            if (v != 0) {\r\n    24\t                return false;\r\n    25\t            }\r\n    26\t        }\r\n    27\t        return a.length > 0;\r\n    28\t    }\r\n    29\t\r\n    30\t    static byte[] hex(String s) {\r\n    31\t        int n = s.length() / 2;\r\n    32\t        byte[] out = new byte[n];\r\n    33\t        for (int i = 0; i < n; i++) {\r\n    34\t            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\r\n    35\t        }\r\n    36\t        return out;\r\n    37\t    }\r\n    38\t}\r\n"]
