[102.877919, "i", "cat > /tmp/CorruptProbe.java <<'EOF'\nimport java.nio.file.*;\npublic class CorruptProbe {\n  public static void main(String[] args) throws Exception {\n    Path d=Path.of(args[0]);\n    int rc=HueWalk.orb_n(d.resolve(\"blob.bin\"),d.resolve(\"pin.bin\"),d.resolve(\"wake.json\"));\n    byte[] id=new byte[16];\n    String s=args[1];\n    for(int i=0;i<16;i++) id[i]=(byte)Integer.parseInt(s.substring(i*2,i*2+2),16);\n    byte[] got=MistSpan.tint_k(d,id);\n    System.out.println(\"rc=\"+rc+\" pull=\"+got.length+\" card=\"+Files.readString(d.resolve(\"wake.json\")));\n    if(rc==0 || got.length!=0 || Files.readString(d.resolve(\"wake.json\")).contains(s)) System.exit(1);\n  }\n}\nEOF\njavac -cp /app/blastcp -d /tmp /tmp/CorruptProbe.java\npython3 - <<'PY'\nfrom pathlib import Path\nimport shutil,struct\nsrc=Path('/app/silo')\npins=(src/'pin.bin').read_bytes()\nident=pins[20:36].hex()\nfor mode in ('short','zero','torn'):\n d=Path('/tmp/probe-'+mode)\n shutil.rmtree(d,ignore_errors=True); shutil.copytree(src,d)\n if mode=='short':\n  b=(d/'blob.bin').read_bytes(); (d/'blob.bin').write_bytes(b[:10])\n elif mode=='zero':\n  b=bytearray((d/'blob.bin').read_bytes()); ln=struct.unpack('>I',b[:4])[0]; b[4:4+ln]=bytes(ln); (d/'blob.bin').write_bytes(b)\n else:\n  p=bytearray((d/'pin.bin').read_bytes()); p[20]^=1; (d/'pin.bin').write_bytes(p); ident=p[20:36].hex()\n print(mode,ident)\n (d/'probe-id').write_text(ident)\nPY\nfor mode in short zero torn; do d=/tmp/probe-$mode; id=$(cat \"$d/probe-id\"); java -cp /app/blastcp:/tmp CorruptProbe \"$d\" \"$id\" || exit 1; done\nrm -rf /tmp/CorruptProbe.java /tmp/CorruptProbe.class /tmp/probe-short /tmp/probe-zero /tmp/probe-torn\necho 'all corruption checks passed'\n"]
