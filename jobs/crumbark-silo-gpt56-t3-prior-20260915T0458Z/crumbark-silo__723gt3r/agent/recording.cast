[31.668971, "o", "     6\t  JAVAC=javac\r\n"]
[31.669222, "o", "     7\t  JAVA=java\r\n     8\tfi\r\n     9\tmkdir -p /app/blastcp /app/silo /app/bin\r\n    10\t\"$JAVAC\" -d /app/blastcp /app/recipit/LoomCue.java\r\n    11\t\"$JAVA\" -cp /app/blastcp LoomCue\r\n    12\tmapfile -t SRC < <(find /app/recipit /app/markwell /app/siltpage /app/hitchbay /app/retrycue -name '*.java' | sort)\r\n"]
