[22.967887, "o", "JAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n"]
[22.968207, "o", "if [ ! -x \"$JAVA\" ]; then\r\n"]
[22.968531, "o", "  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  tamp)\r\n"]
