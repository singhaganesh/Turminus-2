[74.934095, "i", "python3 - <<'PY'\np='/app/recipit/LoomCue.java'\ns=open(p).read()\ns=s.replace('steps.sort(Comparator.comparingInt(x -> x.compute));', 'steps.sort(Comparator.comparingInt(x -> x.durable));')\nopen(p,'w').write(s)\nPY\ncat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\n\npublic class MistSpan {\n    static final int PIN = 48;\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        if (wanted.length != 16) return new byte[0];\n        byte[] pins = Files.exists(silo.resolve(\"pin.bin\")) ? Files.readAllBytes(silo.resolve(\"pin.bin\")) : new byte[0];\n        byte[] blob = Files.exists(silo.resolve(\"blob.bin\")) ? Files.readAllBytes(silo.resolve(\"blob.bin\")) : new byte[0];\n        for (int i = 0; i + PIN <= pins.length; i += PIN) {\n            ByteBuffer bb = ByteBuffer.wrap(pins, i, PIN);\n            byte[] magic = new byte[4]; bb.get(magic);\n            long off = bb.getLong();\n            int len = bb.getInt();\n            int crc = bb.getInt();\n            byte[] id = new byte[16]; bb.get(id);\n            if (!same(id, wanted)) continue;\n            byte[] body = valid(blob, magic, off, len, crc, id);\n            if (body != null) return body;\n        }\n        return new byte[0];\n    }\n\n    static byte[] valid(byte[] blob, byte[] magic, long off, int len, int crc, byte[] id) throws Exception {\n        if (magic.length != 4 || magic[0] != 'P' || magic[1] != 'N' || magic[2] != '0' || magic[3] != '1') return null;\n        if (off < 0 || len < 0 || off > blob.length - 4L || (long) len > blob.length - off - 4L) return null;\n        int at = (int) off;\n        int stored = ByteBuffer.wrap(blob, at, 4).getInt();\n        if (stored != len) return null;\n        byte[] body = new byte[len];\n        System.arraycopy(blob, at + 4, body, 0, len);\n        if (allZero(body) || Crc.of(body) != crc || !same(digest(body), id)) return null;\n        return body;\n    }\n\n    static byte[] digest(byte[] body) throws Exception {\n        byte[] full = MessageDigest.getInstance(\"SHA-256\").digest(body);\n        byte[] id = new byte[16];\n        System.arraycopy(full, 0, id, 0, 16);\n        return id;\n    }\n\n    static boolean allZero(byte[] a) {\n        if (a.length == 0) return true;\n        for (byte b : a) if (b != 0) return false;\n        return true;\n    }\n\n    static boolean same(byte[] x, byte[] y) {\n        if (x.length != y.length) return false;\n        for (int i = 0; i < x.length; i++) if (x[i] != y[i]) return false;\n        return true;\n    }\n}\nEOF\ncat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class HueWalk {\n    public static int orb_n(Path blobPath, Path pinPath, Path cardPath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean sound = pins.length % 48 == 0;\n        for (int i = 0; i + 48 <= pins.length; i += 48) {\n            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\n            byte[] magic = new byte[4]; bb.get(magic);\n            long off = bb.getLong();\n            int len = bb.getInt();\n            int crc = bb.getInt();\n            byte[] id = new byte[16]; bb.get(id);\n            byte[] body = MistSpan.valid(blob, magic, off, len, crc, id);\n            if (body == null) sound = false;\n            else held.add(hex(id));\n        }\n        String note = sound ? \"ok\" : \"gap\";\n        String kind = sound ? \"live\" : \"void\";\n        Files.writeString(cardPath, \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\" + note + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\"}\");\n        return sound ? 0 : 1;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 255));\n        return sb.toString"]
[74.934248, "i", "();\n    }\n\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < held.size(); i++) {\n            if (i != 0) sb.append(',');\n            sb.append('\"').append(held.get(i)).append('\"');\n        }\n        return sb.append(']').toString();\n    }\n}\nEOF\n/app/bin/crumbark tamp\n"]
