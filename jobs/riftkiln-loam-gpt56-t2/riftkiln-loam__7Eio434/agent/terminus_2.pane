     6	include!("halt.rs");
     7	
     8	type Item = (usize, usize);
     9	
    10	#[derive(Clone, Debug, PartialEq, Eq)]
    11	enum Act {
    12	    Shift(usize),
    13	    Reduce(usize),
    14	    Acc,
    15	}
    16	
    17	fn main() {
    18	    let args: Vec<String> = env::args().collect();
    19	    if args.len() < 3 {
    20	        eprintln!("usage: tblbake RECIPE OUTDIR");
    21	        process::exit(2);
    22	    }
    23	    let text = fs::read_to_string(&args[1]).expect("recipe");
    24	    let out = args[2].trim_end_matches('/').to_string();
    25	    let _ = fs::create_dir_all(&out);
    26	
    27	    let mut prods: Vec<(String, Vec<String>)> = Vec::new();
    28	    prods.push(("S'".to_string(), vec!["S".to_string()]));
    29	    let mut body = String::new();
    30	    for line in text.lines() {
    31	        let t = line.trim();
    32	        if t.is_empty() || t.starts_with('#') {
    33	            continue;
    34	        }
    35	        body.push_str(t);
    36	        body.push(' ');
    37	    }
    38	    for chunk in body.split(';') {
    39	        let chunk = chunk.trim();
    40	        if chunk.is_empty() {
    41	            continue;
    42	        }
    43	        let Some((lhs, rhs)) = chunk.split_once(':') else {
    44	            continue;
    45	        };
    46	        let lhs = lhs.trim().to_string();
    47	        for alt in rhs.split('|') {
    48	            let syms: Vec<String> = alt.split_whitespace().map(|s| s.to_string()).collect();
    49	            prods.push((lhs.clone(), syms));
    50	        }
    51	    }
    52	
    53	    let mut nts: BTreeSet<String> = BTreeSet::new();
    54	    for (l, _) in &prods {
    55	        nts.insert(l.clone());
    56	    }
    57	    let mut terms: BTreeSet<String> = BTreeSet::new();
    58	    terms.insert("$".to_string());
    59	    for (_, rhs) in &prods {
    60	        for s in rhs {
    61	            if !nts.contains(s) {
    62	                terms.insert(s.clone());
    63	            }
    64	        }
    65	    }
    66	
    67	    let mut first: BTreeMap<String, BTreeSet<Option<String>>> = BTreeMap::new();
    68	    for nt in &nts {
    69	        first.insert(nt.clone(), BTreeSet::new());
    70	    }
    71	    for t in &terms {
    72	        let mut s = BTreeSet::new();
    73	        s.insert(Some(t.clone()));
    74	        first.insert(t.clone(), s);
    75	    }
    76	    let mut changed = true;
    77	    while changed {
    78	        changed = false;
    79	        for (lhs, rhs) in &prods {
    80	            if rhs.is_empty() {
    81	                if first.get_mut(lhs).unwrap().insert(None) {
    82	                    changed = true;
    83	                }
    84	                continue;
    85	            }
    86	            let mut nullable = true;
    87	            for sym in rhs {
    88	                let fs = first.get(sym).cloned().unwrap_or_default();
    89	                for x in &fs {
    90	                    if x.is_some() && first.get_mut(lhs).unwrap().insert(x.clone()) {
    91	                        changed = true;
    92	                    }
    93	                }
    94	                if !fs.contains(&None) {
    95	                    nullable = false;
    96	                    break;
    97	                }
    98	            }
    99	            if nullable && first.get_mut(lhs).unwrap().insert(None) {
   100	                changed = true;
   101	            }
   102	        }
   103	    }
   104	
   105	    let mut follow: BTreeMap<String, BTreeSet<String>> = BTreeMap::new();
   106	    for nt in &nts {
   107	        follow.insert(nt.clone(), BTreeSet::new());
   108	    }
   109	    follow.get_mut("S'").unwrap().insert("$".to_string());
   110	    changed = true;
   111	    while changed {
   112	        changed = false;
   113	        for (lhs, rhs) in &prods {
   114	            for i in 0..rhs.len() {
   115	                let sym = &rhs[i];
   116	                if !nts.contains(sym) {
   117	                    continue;
   118	                }
   119	                let rest = &rhs[i + 1..];
   120	                let mut acc: BTreeSet<String> = BTreeSet::new();
   121	                let mut nullable;
   122	                if rest.is_empty() {
   123	                    nullable = true;
   124	                } else {
   125	                    nullable = true;
   126	                    for r in rest {
   127	                        let fs = first.get(r).cloned().unwrap_or_default();
   128	                        for x in &fs {
   129	                            if let Some(t) = x {
   130	                                acc.insert(t.clone());
   131	                            }
   132	                        }
   133	                        if terms.contains(r) || !fs.contains(&None) {
   134	                            nullable = false;
   135	                            break;
   136	                        }
   137	                    }
   138	                }
   139	                for t in acc {
   140	                    if follow.get_mut(sym).unwrap().insert(t) {
   141	                        changed = true;
   142	                    }
   143	                }
   144	                if nullable {
   145	                    let extras = follow.get(lhs).cloned().unwrap_or_default();
   146	                    for t in extras {
   147	                        if follow.get_mut(sym).unwrap().insert(t) {
   148	                            changed = true;
   149	                        }
   150	                    }
   151	                }
   152	            }
   153	        }
   154	    }
   155	
   156	    fn closure(I: &BTreeSet<Item>, prods: &[(String, Vec<String>)], nts: &BTreeSet<String>) -> BTreeSet<Item> {
   157	        let mut s = I.clone();
   158	        let mut ch = true;
   159	        while ch {
   160	            ch = false;
   161	            let snap: Vec<Item> = s.iter().cloned().collect();
   162	            for (pi, dot) in snap {
   163	                let rhs = &prods[pi].1;
   164	                if dot < rhs.len() {
   165	                    let b = &rhs[dot];
   166	                    if nts.contains(b) {
   167	                        for (j, (lhs, _)) in prods.iter().enumerate() {
   168	                            if lhs == b && s.insert((j, 0)) {
   169	                                ch = true;
   170	                            }
   171	                        }
   172	                    }
   173	                }
   174	            }
   175	        }
   176	        s
   177	    }
   178	
   179	    fn goto_set(
   180	        I: &BTreeSet<Item>,
   181	        x: &str,
   182	        prods: &[(String, Vec<String>)],
   183	        nts: &BTreeSet<String>,
   184	    ) -> BTreeSet<Item> {
   185	        let mut j: BTreeSet<Item> = BTreeSet::new();
   186	        for &(pi, dot) in I {
   187	            let rhs = &prods[pi].1;
   188	            if dot < rhs.len() && rhs[dot] == x {
   189	                j.insert((pi, dot + 1));
   190	            }
   191	        }
   192	        if j.is_empty() {
   193	            BTreeSet::new()
   194	        } else {
   195	            closure(&j, prods, nts)
   196	        }
   197	    }
   198	
   199	    let start = closure(&{
   200	        let mut s = BTreeSet::new();
   201	        s.insert((0, 0));
   202	        s
   203	    }, &prods, &nts);
   204	    let mut csets: Vec<BTreeSet<Item>> = vec![start];
   205	    changed = true;
   206	    while changed {
   207	        changed = false;
   208	        let mut add: Vec<BTreeSet<Item>> = Vec::new();
   209	        for i in &csets {
   210	            let mut names: Vec<String> = nts.iter().cloned().collect();
   211	            names.extend(terms.iter().filter(|t| *t != "$").cloned());
   212	            for x in names {
   213	                let g = goto_set(i, &x, &prods, &nts);
   214	                if !g.is_empty() && !csets.contains(&g) && !add.contains(&g) {
   215	                    add.push(g);
   216	                    changed = true;
   217	                }
   218	            }
   219	        }
   220	        csets.extend(add);
   221	    }
   222	
   223	    let mut action: Vec<BTreeMap<String, Act>> = vec![BTreeMap::new(); csets.len()];
   224	    let mut gotot: Vec<BTreeMap<String, usize>> = vec![BTreeMap::new(); csets.len()];
   225	    let mut quarrel: Vec<String> = Vec::new();
   226	
   227	    for (idx, i) in csets.iter().enumerate() {
   228	        let mut names: Vec<String> = nts.iter().cloned().collect();
   229	        names.extend(terms.iter().cloned());
   230	        for x in &names {
   231	            if nts.contains(x) {
   232	                let g = goto_set(i, x, &prods, &nts);
   233	                if !g.is_empty() {
   234	                    if let Some(n) = csets.iter().position(|s| s == &g) {
   235	                        gotot[idx].insert(x.clone(), n);
   236	                    }
   237	                }
   238	            }
   239	        }
   240	        for &(pi, dot) in i {
   241	            let lhs = &prods[pi].0;
   242	            let rhs = &prods[pi].1;
   243	            if dot < rhs.len() {
   244	                let a = &rhs[dot];
   245	                if terms.contains(a) {
   246	                    let g = goto_set(i, a, &prods, &nts);
   247	                    if let Some(n) = csets.iter().position(|s| s == &g) {
   248	                        let neu = Act::Shift(n);
   249	                        if let Some(old) = action[idx].get(a) {
   250	                            if old != &neu {
   251	                                quarrel.push(format!("state {} tok {}", idx, a));
   252	                                if matches!(neu, Act::Shift(_)) {
   253	                                    action[idx].insert(a.clone(), neu);
   254	                                }
   255	                            }
   256	                        } else {
   257	                            action[idx].insert(a.clone(), neu);
   258	                        }
   259	                    }
   260	                }
   261	            } else if lhs == "S'" {
   262	                action[idx].insert("$".to_string(), Act::Acc);
   263	            } else {
   264	                for a in follow.get(lhs).cloned().unwrap_or_default() {
   265	                    let neu = Act::Reduce(pi);
   266	                    if let Some(old) = action[idx].get(&a) {
   267	                        if old != &neu {
   268	                            quarrel.push(format!("state {} tok {}", idx, a));
   269	                            if matches!(old, Act::Reduce(_)) && matches!(neu, Act::Shift(_)) {
   270	                                action[idx].insert(a.clone(), neu);
   271	                            }
   272	                        }
   273	                    } else {
   274	                        action[idx].insert(a.clone(), neu);
   275	                    }
   276	                }
   277	            }
   278	        }
   279	    }
   280	
   281	    let mut alines = String::new();
   282	    for (si, row) in action.iter().enumerate() {
   283	        for (t, act) in row {
   284	            match act {
   285	                Act::Shift(n) => alines.push_str(&format!("{} {} s {}\n", si, t, n)),
   286	                Act::Reduce(p) => alines.push_str(&format!("{} {} r {}\n", si, t, p)),
   287	                Act::Acc => alines.push_str(&format!("{} {} a 0\n", si, t)),
   288	            }
   289	        }
   290	    }
   291	    let mut glines = String::new();
   292	    for (si, row) in gotot.iter().enumerate() {
   293	        for (nt, n) in row {
   294	            glines.push_str(&format!("{} {} {}\n", si, nt, n));
   295	        }
   296	    }
   297	    let mut plines = String::new();
   298	    for (i, (lhs, rhs)) in prods.iter().enumerate() {
   299	        plines.push_str(&format!("{} {} {}\n", i, lhs, rhs.len()));
   300	        for s in rhs {
   301	            plines.push_str(&format!(" {}\n", s));
   302	        }
   303	    }
   304	    fs::write(format!("{}/quarrel.lst", out), quarrel.join("\n")).unwrap();
   305	    if rib_a(quarrel.len()) != 0 {
   306	        process::exit(1);
   307	    }
   308	    fs::write(format!("{}/action.tbl", out), alines).unwrap();
   309	    fs::write(format!("{}/goto.tbl", out), glines).unwrap();
   310	    fs::write(format!("{}/prod.tbl", out), plines).unwrap();
   311	    process::exit(0);
   312	}
--- /app/ribjoin/cursor.rs ---
     1	use std::collections::BTreeMap;
     2	use std::fs;
     3	
     4	#[derive(Clone, Debug)]
     5	enum Node {
     6	    Str(String),
     7	    List(Vec<Node>),
     8	    Map(Vec<(String, Node)>),
     9	}
    10	
    11	fn map_get<'a>(n: &'a Node, k: &str) -> Option<&'a Node> {
    12	    if let Node::Map(pairs) = n {
    13	        for (a, b) in pairs {
    14	            if a == k {
    15	                return Some(b);
    16	            }
    17	        }
    18	    }
    19	    None
    20	}
    21	
    22	fn map_get_mut<'a>(n: &'a mut Node, k: &str) -> Option<&'a mut Node> {
    23	    if let Node::Map(pairs) = n {
    24	        for (a, b) in pairs.iter_mut() {
    25	            if a == k {
    26	                return Some(b);
    27	            }
    28	        }
    29	    }
    30	    None
    31	}
    32	
    33	fn kind_of(n: &Node) -> String {
    34	    match map_get(n, "kind") {
    35	        Some(Node::Str(s)) => s.clone(),
    36	        _ => String::new(),
    37	    }
    38	}
    39	
    40	pub fn rib_c(mut acc: Node, neu: Node) -> Node {
    41	    if let Node::List(ref mut items) = acc {
    42	        if kind_of(&neu) == "clip" {
    43	            if let Some(last) = items.last_mut() {
    44	                if kind_of(last) == "pen" {
    45	                    if map_get(last, "clip").is_none() {
    46	                        if let Some(Node::Str(st)) = map_get(&neu, "stem") {
    47	                            let st = st.clone();
    48	                            if let Node::Map(pairs) = last {
    49	                                pairs.push(("clip".to_string(), Node::Str(st)));
    50	                                return acc;
    51	                            }
    52	                        }
    53	                    }
    54	                }
    55	            }
    56	        }
    57	        items.push(neu);
    58	        return acc;
    59	    }
    60	    acc
    61	}
    62	
    63	fn to_json(n: &Node) -> String {
    64	    match n {
    65	        Node::Str(s) => format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\"")),
    66	        Node::List(xs) => {
    67	            let inner: Vec<String> = xs.iter().map(to_json).collect();
    68	            format!("[{}]", inner.join(","))
    69	        }
    70	        Node::Map(pairs) => {
    71	            let inner: Vec<String> = pairs
    72	                .iter()
    73	                .map(|(k, v)| format!("\"{}\":{}", k, to_json(v)))
    74	                .collect();
    75	            format!("{{{}}}", inner.join(","))
    76	        }
    77	    }
    78	}
    79	
    80	#[derive(Clone)]
    81	enum Cell {
    82	    S(usize),
    83	    R(usize),
    84	    A,
    85	}
    86	
    87	fn load_action(path: &str) -> BTreeMap<(usize, String), Cell> {
    88	    let mut m = BTreeMap::new();
    89	    if let Ok(t) = fs::read_to_string(path) {
    90	        for line in t.lines() {
    91	            let p: Vec<&str> = line.split_whitespace().collect();
    92	            if p.len() < 4 {
    93	                continue;
    94	            }
    95	            let st: usize = p[0].parse().unwrap_or(0);
    96	            let tok = p[1].to_string();
    97	            m.insert(
    98	                (st, tok),
    99	                match p[2] {
   100	                    "s" => Cell::S(p[3].parse().unwrap_or(0)),
   101	                    "r" => Cell::R(p[3].parse().unwrap_or(0)),
   102	                    _ => Cell::A,
   103	                },
   104	            );
   105	        }
   106	    }
   107	    m
   108	}
   109	
   110	fn load_goto(path: &str) -> BTreeMap<(usize, String), usize> {
   111	    let mut m = BTreeMap::new();
   112	    if let Ok(t) = fs::read_to_string(path) {
   113	        for line in t.lines() {
   114	            let p: Vec<&str> = line.split_whitespace().collect();
   115	            if p.len() < 3 {
   116	                continue;
   117	            }
   118	            m.insert(
   119	                (p[0].parse().unwrap_or(0), p[1].to_string()),
   120	                p[2].parse().unwrap_or(0),
   121	            );
   122	        }
   123	    }
   124	    m
   125	}
   126	
   127	fn load_prod(path: &str) -> Vec<(String, Vec<String>)> {
   128	    let mut out = Vec::new();
   129	    let t = fs::read_to_string(path).unwrap_or_default();
   130	    let lines: Vec<&str> = t.lines().collect();
   131	    let mut i = 0;
   132	    while i < lines.len() {
   133	        let p: Vec<&str> = lines[i].split_whitespace().collect();
   134	        if p.len() >= 3 {
   135	            let n: usize = p[2].parse().unwrap_or(0);
   136	            let mut rhs = Vec::new();
   137	            for _ in 0..n {
   138	                i += 1;
   139	                if i < lines.len() {
   140	                    rhs.push(lines[i].trim().to_string());
   141	                }
   142	            }
   143	            let idx: usize = p[0].parse().unwrap_or(0);
   144	            while out.len() <= idx {
   145	                out.push((String::new(), Vec::new()));
   146	            }
   147	            out[idx] = (p[1].to_string(), rhs);
   148	        }
   149	        i += 1;
   150	    }
   151	    out
   152	}
