[16.35513, "o", "printf '%s\\n' '--- MAKEFILE ---'; cat Makefile; printf '%s\\n' '--- GO MOD ---'; cat go.mod; printf '%s\\n' '--- OPS/INTENT/FOCUS ---'; cat baydocs/OPS.txt inkstack/intent.toml hearth/focus.txt; printf '%s\\n' '--- SOURCES ---'; for f in hopsrc/imprint/imprint.go hopsrc/vat/store.go claybin/emit.go scorepit/score.go scorepit/shim.go kilncli/*.go; do echo \"### $f\"; sed -n '1,240p' \"$f\"; done; printf '%s\\n' '--- SQL ---'; for f in inkstack/migrations/*.sql; do echo \"### $f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[16.355833, "o", "--- MAKEFILE ---\r\n"]
[16.356321, "o", ".PHONY: ship\r\n\r\nship:\r\n\tmkdir -p /app/bin\r\n\t/usr/local/go/bin/go build -o /app/bin/kilncli ./kilncli\r\n"]
[16.356508, "o", "--- GO MOD ---\r\n"]
[16.357697, "o", "module kilnbench\r\n\r\ngo 1.24\r\n"]
[16.357966, "o", "--- OPS/INTENT/FOCUS ---\r\n"]
[16.358843, "o", "Nightly assay uses a spilled worker vat. Operators often impress the hearth\r\nbench vat first because that is the focused workspace. Assay prints\r\nschema_version from the worker vat after spill. Compat helpers under runbay\r\nexist for lab pads when a column is missing on a scratch vat.\r\n"]
[16.358974, "o", "[tries]\r\ncolumns = [\"id\", \"label\", \"attempt_slot\"]\r\n/app/vats/bench.vat\r\n"]
[16.359112, "o", "--- SOURCES ---\r\n"]
[16.359209, "o", "### hopsrc/imprint/imprint.go\r\n"]
[16.367943, "o", "package imprint\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n\r\n\t\"kilnbench/hopsrc/vat\"\r\n)\r\n\r\nconst migDir = \"/app/inkstack/migrations\"\r\n\r\nfunc Imprint(vatPath string) error {\r\n\tfocus, err := os.ReadFile(\"/app/hearth/focus.txt\")\r\n"]
[16.368099, "o", "\tif err == nil {\r\n\t\tvatPath = strings.TrimSpace(string(focus))\r\n\t}\r\n\treturn applyAll(vatPath)\r\n}\r\n\r\nfunc applyAll(vatPath string) error {\r\n\tmatches, err := listSQL(migDir)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tst, err := vat.Parse(vatPath)\r\n\tif err != nil {\r\n\t\tst = &vat.Store{Table: \"tries\", Cols: []string{}, Rows: nil}\r\n\t}\r\n\tfor _, m := range matches {\r\n\t\tstem := vat.Stem(m)\r\n\t\tif st.HasApplied(stem) {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tbody, err := os.ReadFile(m)\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tif err := runSQL(st, string(body)); err != nil {\r\n\t\t\treturn fmt.Errorf(\"%s: %w\", stem, err)\r\n\t\t}\r\n\t\tst.Applied = append(st.Applied, stem)\r\n\t}\r\n\treturn st.Write(vatPath)\r\n}\r\n\r\nfunc listSQL(dir string) ([]string, error) {\r\n\tmatches, err := filepath.Glob(filepath.Join(dir, \"*.sql\"))\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tsort.Strings(matches)\r\n\treturn matches, nil\r\n}\r\n\r\nfunc runSQL(st *vat.Store, body string) error {\r\n\tfor _, raw := range strings.Split(body, \";\") {\r\n\t\tline := strings.Join(strings.Fields(raw), \" \")\r\n"]
[16.368193, "o", "\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tu := strings.ToUpper(line)\r\n\t\tswitch {\r\n\t\tcase strings.HasPrefix(u, \"CREATE TABLE\"):\r\n\t\t\trest := strings.TrimSpace(line[len(\"CREATE TABLE\"):])\r\n\t\t\tname, cols, ok := parseCreate(rest)\r\n\t\t\tif !ok {\r\n\t\t\t\treturn fmt.Errorf(\"create parse\")\r\n\t\t\t}\r\n\t\t\tst.Table = name\r\n\t\t\tst.Cols = cols\r\n\t\t\tif len(st.Rows) == 0 {\r\n\t\t\t\trow := make([]string, len(cols))\r\n\t\t\t\tfor i := range row {\r\n\t\t\t\t\tif cols[i] == \"id\" {\r\n\t\t\t\t\t\trow[i] = \"1\"\r\n\t\t\t\t\t} else if cols[i] == \"label\" {\r\n\t\t\t\t\t\trow[i] = \"boot\"\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\trow[i] = \"0\"\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tst.Rows = [][]string{row}\r\n\t\t\t}\r\n\t\tcase strings.Contains(u, \"ADD COLUMN\"):\r\n\t\t\tidx := strings.Index(u, \"ADD COLUMN\")\r\n"]
[16.368268, "o", "\t\t\tcol := strings.Fields(line[idx+len(\"ADD COLUMN\"):])\r\n\t\t\tif len(col) == 0 {\r\n\t\t\t\treturn fmt.Errorf(\"add column\")\r\n\t\t\t}\r\n\t\t\tst.AddCol(col[0])\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc parseCreate(rest string) (string, []string, bool) {\r\n\ti := strings.Index(rest, \"(\")\r\n\tj := strings.Index(rest, \")\")\r\n\tif i < 0 || j < 0 || j <= i {\r\n\t\treturn \"\", nil, false\r\n\t}\r\n\tname := strings.TrimSpace(rest[:i])\r\n\tinner := rest[i+1 : j]\r\n\tparts := strings.Split(inner, \",\")\r\n\tcols := make([]string, 0, len(parts))\r\n\tfor _, p := range parts {\r\n\t\tp = strings.TrimSpace(p)\r\n\t\tif p == \"\" {\r\n"]
[16.368337, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tcols = append(cols, p)\r\n\t}\r\n\treturn name, cols, name != \"\" && len(cols) > 0\r\n}\r\n"]
[16.368543, "o", "### hopsrc/vat/store.go\r\n"]
[16.369536, "o", "package vat\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n"]
[16.369574, "o", "\t\"strings\"\r\n)\r\n\r\nconst magic = \"KILNVAT 1\"\r\n\r\ntype Store struct {\r\n\tApplied []string\r\n\tTable   string\r\n\tCols    []string\r\n\tRows    [][]string\r\n}\r\n\r\nfunc Parse(path string) (*Store, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n"]
[16.369687, "o", "\tdefer f.Close()\r\n\ts := &Store{}\r\n\tsc := bufio.NewScanner(f)\r\n\tif !sc.Scan() {\r\n\t\treturn nil, fmt.Errorf(\"empty vat\")\r\n\t}\r\n\tif strings.TrimSpace(sc.Text()) != magic {\r\n\t\treturn nil, fmt.Errorf(\"bad magic\")\r\n\t}\r\n\tfor sc.Scan() {\r\n"]
[16.369754, "o", "\t\tline := strings.TrimSpace(sc.Text())\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tswitch {\r\n\t\tcase strings.HasPrefix(line, \"applied:\"):\r\n\t\t\ts.Applied = append(s.Applied, strings.TrimPrefix(line, \"applied:\"))\r\n\t\tcase strings.HasPrefix(line, \"table:\"):\r\n\t\t\ts.Table = strings.TrimPrefix(line, \"table:\")\r\n\t\tcase strings.HasPrefix(line, \"cols:\"):\r\n\t\t\ts.Cols = strings.Split(strings.TrimPrefix(line, \"cols:\"), \",\")\r\n\t\tcase strings.HasPrefix(line, \"row:\"):\r\n\t\t\ts.Rows = append(s.Rows, strings.Split(strings.TrimPrefix(line, \"row:\"), \",\"))\r\n\t\t}\r\n\t}\r\n\treturn s, sc.Err()\r\n}\r\n\r\nfunc (s *Store) Write(path string) error {\r\n\tvar b strings.Builder\r\n\tb.WriteString(magic)\r\n\tb.WriteByte('\\n')\r\n\tfor _, a := range s.Applied {\r\n\t\tb.WriteString(\"applied:\")\r\n\t\tb.WriteString(a)\r\n\t\tb.WriteByte('\\n')\r\n\t}\r\n\tb.WriteString(\"table:\")\r\n\tb.WriteString(s.Table)\r\n\tb.WriteByte('\\n')\r\n\tb.WriteString(\"cols:\")\r\n\tb.WriteString(strings.Join(s.Cols, \",\"))\r\n\tb.WriteByte('\\n')\r\n\tfor _, r := range s.Rows {\r\n\t\tb.WriteString(\"row:\")\r\n\t\tb.WriteString(strings.Join(r, \",\"))\r\n\t\tb.WriteByte('\\n')\r\n\t}\r\n\treturn os.WriteFile(path, []byte(b.String()), 0644)\r\n}\r\n\r\nfunc (s *Store) LastApplied() string {\r\n\tif len(s.Applied) == 0 {\r\n\t\treturn \"\"\r\n\t}\r\n\treturn s.Applied[len(s.Applied)-1]\r\n}\r\n\r\nfunc (s *Store) HasApplied(stem string) bool {\r\n"]
[16.369856, "o", "\tfor _, a := range s.Applied {\r\n\t\tif a == stem {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (s *Store) HasCol(name string) bool {\r\n\tfor _, c := range s.Cols {\r\n\t\tif c == name {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (s *Store) AddCol(name string) {\r\n\tif s.HasCol(name) {\r\n\t\treturn\r\n\t}\r\n\ts.Cols = append(s.Cols, name)\r\n\tfor i := range s.Rows {\r\n"]
[16.369925, "o", "\t\ts.Rows[i] = append(s.Rows[i], \"0\")\r\n\t}\r\n}\r\n\r\nfunc LedgerHead(migDir string) (string, error) {\r\n\tmatches, err := filepath.Glob(filepath.Join(migDir, \"*.sql\"))\r\n\tif err != nil {\r\n\t\treturn \"\", err\r\n\t}\r\n\tif len(matches) == 0 {\r\n\t\treturn \"\", fmt.Errorf(\"no sql\")\r\n\t}\r\n\tsort.Strings(matches)\r\n\tbase := filepath.Base(matches[len(matches)-1])\r\n\treturn strings.TrimSuffix(base, \".sql\"), nil\r\n}\r\n\r\nfunc Stem(path string) string {\r\n\tbase := filepath.Base(path)\r\n\treturn strings.TrimSuffix(base, \".sql\")\r\n}\r\n\r\n"]
[16.369945, "o", "func CopyFile(src, dst string) error {\r\n\tb, err := os.ReadFile(src)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(dst, b, 0644)\r\n"]
[16.369972, "o", "}\r\n"]
[16.370214, "o", "### claybin/emit.go\r\n"]
[16.371258, "o", "package claybin\r\n\r\nimport \"kilnbench/hopsrc/vat\"\r\n\r\nconst src = \"/app/vats/plaster.vat\"\r\nconst dst = \"/app/vats/worker.vat\"\r\n\r\nfunc EmitWorker() error {\r\n\t"]
[16.37134, "o", "return vat.CopyFile(src, dst)\r\n}\r\n"]
[16.371477, "o", "### scorepit/score.go\r\n"]
[16.372505, "o", "package scorepit\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\r\n\t\"kilnbench/hopsrc/vat\"\r\n"]
[16.372658, "o", ")\r\n\r\nconst worker = \"/app/vats/worker.vat\"\r\nconst okPath = \"/app/vats/assay.ok\"\r\n\r\nfunc ScoreWorker() int {\r\n\tst, err := vat.Parse(worker)\r\n\tif err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\tfmt.Printf(\"schema_version=%s\\n\", st.LastApplied())\r\n\tif !st.HasCol(\"attempt_slot\") {\r\n"]
[16.372745, "o", "\t\tfmt.Fprintln(os.Stderr, \"unknown-column: attempt_slot\")\r\n\t\treturn 1\r\n\t}\r\n\t_ = os.WriteFile(okPath, []byte(\"ok\\n\"), 0644)\r\n\treturn 0\r\n}\r\n"]
[16.37287, "o", "### scorepit/shim.go\r\n"]
[16.373885, "o", "package scorepit\r\n\r\nimport \"kilnbench/hopsrc/vat\"\r\n\r\nfunc PadSlot(path string) error {\r\n\tst, err := vat.Parse(path)\r\n\tif err != nil {\r\n\t"]
[16.373994, "o", "\treturn err\r\n\t}\r\n\tst.AddCol(\"attempt_slot\")\r\n\treturn st.Write(path)\r\n}\r\n"]
[16.374129, "o", "### kilncli/cmd_assay.go\r\n"]
[16.375134, "o", "package main\r\n\r\nimport \"kilnbench/scorepit\"\r\n\r\nfunc cmdAssay() int {\r\n"]
[16.375213, "o", "\treturn scorepit.ScoreWorker()\r\n}\r\n"]
[16.375326, "o", "### kilncli/cmd_impress.go\r\n"]
[16.376354, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\r\n"]
[16.376428, "o", "\t\"kilnbench/hopsrc/imprint\"\r\n)\r\n\r\nfunc cmdImpress(args []string) int {\r\n\tpath := \"\"\r\n\tif len(args) > 0 {\r\n\t\tpath = args[0]\r\n\t}\r\n"]
[16.376491, "o", "\tif err := imprint.Imprint(path); err != nil {\r\n\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[16.376646, "o", "### kilncli/cmd_spill.go\r\n"]
[16.377657, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n\r\n\t\"kilnbench/claybin\"\r\n)\r\n\r\nfunc cmdSpill() int {\r\n\tif err := claybin.EmitWorker(); err != nil {\r\n"]
[16.377791, "o", "\t\tfmt.Fprintln(os.Stderr, err)\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[16.377951, "o", "### kilncli/main.go\r\n"]
[16.379001, "o", "package main\r\n\r\nimport (\r\n\t\"fmt\"\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n"]
[16.379082, "o", "\tif len(os.Args) < 2 {\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: kilncli impress|spill|assay\")\r\n\t\tos.Exit(2)\r\n\t}\r\n\tvar code int\r\n\tswitch os.Args[1] {\r\n\tcase \"impress\":\r\n\t\tcode = cmdImpress(os.Args[2:])\r\n\tcase \"spill\":\r\n\t\tcode = cmdSpill()\r\n\tcase \"assay\":\r\n\t\tcode = cmdAssay()\r\n\tdefault:\r\n\t\tfmt.Fprintln(os.Stderr, \"usage: kilncli impress|spill|assay\")\r\n\t\tcode = 2\r\n\t}\r\n\tos.Exit(code)\r\n}\r\n"]
[16.379308, "o", "--- SQL ---\r\n"]
[16.379375, "o", "### inkstack/migrations/0003_base.sql\r\n"]
[16.380079, "o", "CREATE TABLE tries (id, label);\r\n"]
[16.380222, "o", "### inkstack/migrations/0004_attempt_slot.sql\r\n"]
[16.380904, "o", "ALTER TABLE tries ADD COLUMN attempt_slot;\r\n"]
[16.381086, "o", "\u001b[?2004h"]
[16.381143, "o", "root@a029b2be4621:/app# "]
[16.86406, "i", "rm -f /app/vats/assay.ok; echo '--- current assay ---'; /app/bin/kilncli assay; echo \"assay_rc=$? ok=$(test -e /app/vats/assay.ok; echo $?)\"; echo '--- impress copy probe ---'; cp /app/vats/plaster.vat /tmp/probe.vat; /app/bin/kilncli impress /tmp/probe.vat; echo \"impress_rc=$?\"; cat /tmp/probe.vat; echo '--- spill current ---'; rm -f /app/vats/assay.ok; /app/bin/kilncli spill; echo \"spill_rc=$? ok=$(test -e /app/vats/assay.ok; echo $?)\"; cat /app/vats/worker.vat\n"]
[16.8654, "o", "rm -f /app/vats/assay.ok; echo '--- current assay ---'; /app/bin/kilncli assay; echo \"assay_rc=$? ok=$(test -e /app/vats/assay.ok; echo $?)\"; echo '--- impress copy probe ---'; cp /app/vats/plaster.vat /tmp/probe.vat; /app/bin/kilncli impress /tmp/probe.vat; echo \"impress_rc=$?\"; cat /tmp/probe.vat; echo '--- spill current ---'; rm -f /app/vats/assay.ok; /app/bin/kilncli spill; echo \"spill_rc=$? ok=$(test -e /app/vats/assay.ok; echo $?)\"; cat /app/vats/worker.vat\r\n\u001b[?2004l\r"]
[16.870275, "o", "--- current assay ---\r\n"]
[16.871533, "o", "schema_version=0003_base\r\nunknown-column: attempt_slot\r\n"]
[16.872345, "o", "assay_rc=1 ok=1\r\n--- impress copy probe ---\r\n"]
[16.876878, "o", "impress_rc=0\r\n"]
[16.87768, "o", "KILNVAT 1\r\napplied:0003_base\r\ntable:tries\r\ncols:id,label\r\nrow:1,boot\r\n"]
[16.87784, "o", "--- spill current ---\r\n"]
[16.880538, "o", "spill_rc=0 ok=1\r\n"]
[16.88133, "o", "KILNVAT 1\r\napplied:0003_base\r\ntable:tries\r\ncols:id,label\r\nrow:1,boot\r\n"]
[16.881542, "o", "\u001b[?2004hroot@a029b2be4621:/app# "]
[41.791707, "i", "cat /app/hopsrc/vat/store.go\n"]
[41.792007, "o", "cat /app/hopsrc/vat/store.go\r\n\u001b[?2004l\r"]
[41.793077, "o", "package vat\r\n\r\nimport (\r\n\t\"bufio\"\r\n\t\"fmt\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"sort\"\r\n\t\"strings\"\r\n)\r\n\r\nconst magic = \"KILNVAT 1\"\r\n\r\ntype Store struct {\r\n\tApplied []string\r\n\tTable   string\r\n\tCols    []string\r\n\tRows    [][]string\r\n}\r\n\r\nfunc Parse(path string) (*Store, error) {\r\n\tf, err := os.Open(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tdefer f.Close()\r\n\ts := &Store{}\r\n\tsc := bufio.NewScanner(f)\r\n\tif !sc.Scan() {\r\n\t\treturn nil, fmt.Errorf(\"empty vat\")\r\n\t}\r\n\tif strings.TrimSpace(sc.Text()) != magic {\r\n\t\treturn nil, fmt.Errorf(\"bad magic\")\r\n\t}\r\n\tfor sc.Scan() {\r\n\t\tline := strings.TrimSpace(sc.Text())\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tswitch {\r\n\t\tcase strings.HasPrefix(line, \"applied:\"):\r\n\t\t\ts.Applied = append(s.Applied, strings.TrimPrefix(line, \"applied:\"))\r\n\t\tcase strings.HasPrefix(line, \"table:\"):\r\n\t"]
[41.793151, "o", "\t\ts.Table = strings.TrimPrefix(line, \"table:\")\r\n\t\tcase strings.HasPrefix(line, \"cols:\"):\r\n\t\t\ts.Cols = strings.Split(strings.TrimPrefix(line, \"cols:\"), \",\")\r\n\t\tcase strings.HasPrefix(line, \"row:\"):\r\n\t\t\ts.Rows = append(s.Rows, strings.Split(strings.TrimPrefix(line, \"row:\"), \",\"))\r\n\t\t}\r\n\t}\r\n\treturn s, sc.Err()\r\n}\r\n\r\nfunc (s *Store) Write(path string) error {\r\n\tvar b strings.Builder\r\n\tb.WriteString(magic)\r\n\tb.WriteByte('\\n')\r\n\tfor _, a := range s.Applied {\r\n\t\tb.WriteString(\"applied:\")\r\n\t\tb.WriteString(a)\r\n\t\tb.WriteByte('\\n')\r\n\t}\r\n\tb.WriteString(\"table:\")\r\n\tb.WriteString(s.Table)\r\n\tb.WriteByte('\\n')\r\n\tb.WriteString(\"cols:\")\r\n\tb.WriteString(strings.Join(s.Cols, \",\"))\r\n\tb.WriteByte('\\n')\r\n\tfor _, r := range s.Rows {\r\n\t\tb.WriteString(\"row:\")\r\n\t\tb.WriteString(strings.Join(r, \",\"))\r\n\t\tb.WriteByte('\\n')\r\n\t}\r\n\treturn os.WriteFile(path, []byte(b.String()), 0644)\r\n}\r\n\r\nfunc (s *Store) LastApplied() string {\r\n\tif len(s.Applied) == 0 {\r\n\t\treturn \"\"\r\n\t}\r\n\treturn s.Applied[len(s.Applied)-1]\r\n}\r\n\r\nfunc (s *Store) HasApplied(stem string) bool {\r\n\tfor _, a := range s.Applied {\r\n\t\tif a == stem {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (s *Store) HasCol(name string) bool {\r\n\tfor _, c := range s.Cols {\r\n\t\tif c == name {\r\n\t\t\treturn true\r\n\t\t}\r\n\t}\r\n\treturn false\r\n}\r\n\r\nfunc (s *Store) AddCol(name string) {\r\n\tif s.HasCol(name) {\r\n\t\treturn\r\n\t}\r\n\ts.Cols = append(s.Cols, name)\r\n\tfor i := range s.Rows {\r\n\t\ts.Rows[i] = append(s.Rows[i], \"0\")\r\n\t}\r\n}\r\n\r\nfunc LedgerHead(migDir string) (string, error) {\r\n\tmatches, err := filepath.Glob(filepath.Join(migDir, \"*.sql\"))\r\n\tif err != nil {\r\n\t\t"]
[41.793177, "o", "return \"\", err\r\n\t}\r\n\tif len(matches) == 0 {\r\n\t\treturn \"\", fmt.Errorf(\"no sql\")\r\n\t}\r\n\tsort.Strings(matches)\r\n\tbase := filepath.Base(matches[len(matches)-1])\r\n\treturn strings.TrimSuffix(base, \".sql\"), nil\r\n}\r\n\r\nfunc Stem(path string) string {\r\n\tbase := filepath.Base(path)\r\n\treturn strings.TrimSuffix(base, \".sql\")"]
[41.793193, "o", "\r\n}\r\n\r\nfunc CopyFile(src, dst string) error {\r\n\tb, err := os.ReadFile(src)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(dst, b, 0644)\r\n}\r\n"]
[41.793536, "o", "\u001b[?2004h"]
[41.793894, "o", "root@a029b2be4621:/app# "]
[41.924259, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('/app/hopsrc/imprint/imprint.go')\ns=p.read_text()\ns=s.replace('''func Imprint(vatPath string) error {\n        focus, err := os.ReadFile(\"/app/hearth/focus.txt\")\n        if err == nil {\n                vatPath = strings.TrimSpace(string(focus))\n        }\n        return applyAll(vatPath)\n}''','''func Imprint(vatPath string) error {\n        vatPath = strings.TrimSpace(vatPath)\n        if vatPath == \"\" {\n                return fmt.Errorf(\"vat path is required\")\n        }\n        return applyAll(vatPath)\n}''')\np.write_text(s)\nPY\ncat > /app/claybin/emit.go <<'EOF'\npackage claybin\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\n\t\"kilnbench/hopsrc/vat\"\n)\n\nconst src = \"/app/vats/plaster.vat\"\nconst dst = \"/app/vats/worker.vat\"\nconst migDir = \"/app/inkstack/migrations\"\nconst okPath = \"/app/vats/assay.ok\"\n\nfunc EmitWorker() error {\n\t// A marker describes the previous worker and must never survive a spill.\n\tif err := os.Remove(okPath); err != nil && !os.IsNotExist(err) {\n\t\treturn err\n\t}\n\n\tst, err := vat.Parse(src)\n\tif err != nil {\n\t\treturn err\n\t}\n\thead, err := vat.LedgerHead(migDir)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif st.LastApplied() != head {\n\t\treturn fmt.Errorf(\"source schema_version=%s, ledger head=%s\", st.LastApplied(), head)\n\t}\n\treturn vat.CopyFile(src, dst)\n}\nEOF\ncat > /app/scorepit/score.go <<'EOF'\npackage scorepit\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\n\t\"kilnbench/hopsrc/vat\"\n)\n\nconst worker = \"/app/vats/worker.vat\"\nconst okPath = \"/app/vats/assay.ok\"\nconst migDir = \"/app/inkstack/migrations\"\n\nfunc ScoreWorker() int {\n\t// Never leave a success marker behind after a failed assay.\n\t_ = os.Remove(okPath)\n\n\tst, err := vat.Parse(worker)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\tversion := st.LastApplied()\n\tfmt.Printf(\"schema_version=%s\\n\", version)\n\n\thead, err := vat.LedgerHead(migDir)\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\tif version != head {\n\t\tfmt.Fprintf(os.Stderr, \"schema-version mismatch: worker=%s head=%s\\n\", version, head)\n\t\treturn 1\n\t}\n\tif !st.HasCol(\"attempt_slot\") {\n\t\tfmt.Fprintln(os.Stderr, \"unknown-column: attempt_slot\")\n\t\treturn 1\n\t}\n\tif err := os.WriteFile(okPath, []byte(\"ok\\n\"), 0644); err != nil {\n\t\tfmt.Fprintln(os.Stderr, err)\n\t\treturn 1\n\t}\n\treturn 0\n}\nEOF\n/usr/local/go/bin/gofmt -w /app/hopsrc/imprint/imprint.go /app/claybin/emit.go /app/scorepit/score.go\n/usr/local/go/bin/go test ./...\n"]
