[10.019668, "o", "--- BAY NOTES ---\r\n"]
[10.020805, "o", "Kiln CLI lives at /app/bin/kilncli.\r\n\r\nSubcommands:\r\n  impress PATH  apply every *.sql under /app/inkstack/migrations/ onto PATH\r\n  spill         copy /app/vats/plaster.vat onto /app/vats/worker.vat\r\n  assay         read /app/vats/worker.vat, print schema_version, write /app/vats/assay.ok on success\r\n\r\nThe Makefile at /app/Makefile ships /app/bin/kilncli from the kilncli module.\r\n\r\nSources that implement those subcommands:\r\n  /app/hopsrc/imprint\r\n  /app/claybin\r\n  /app/scorepit\r\n\r\nLedger intent: /app/inkstack/intent.toml\r\nWorkspace vat path used by local experiments: /app/hearth/focus.txt\r\n"]
[10.021012, "o", "--- migrations ---\r\n"]
[10.021131, "o", "### /app/inkstack/migrations/0003_base.sql\r\n"]
[10.022037, "o", "CREATE TABLE tries (id, label);\r\n"]
[10.022211, "o", "### /app/inkstack/migrations/0004_attempt_slot.sql\r\n"]
[10.023166, "o", "ALTER TABLE tries ADD COLUMN attempt_slot;\r\n"]
[10.023368, "o", "\u001b[?2004h"]
[10.023432, "o", "root@eb4c3ad75af8:/app# "]
[10.54874, "i", "echo '--- vats ---'; for f in /app/vats/*.vat; do echo \"### $f\"; cat \"$f\"; done; echo '--- cli ---'; file /app/bin/kilncli; ls -l /app/bin/kilncli\n"]
[10.549197, "o", "echo '--- vats ---'; for f in /app/vats/*.vat; do echo \"### $f\"; cat \"$f\"; done; echo '--- cli ---'; file /app/bin/kilncli; ls -l /app/bin/kilncli\r\n\u001b[?2004l\r"]
[10.549321, "o", "--- vats ---\r\n"]
[10.549461, "o", "### /app/vats/bench.vat\r\n"]
[10.550487, "o", "KILNVAT 1\r\napplied:0003_base\r\napplied:0004_attempt_slot\r\ntable:tries\r\ncols:id,label,attempt_slot\r\nrow:1,boot,0\r\n"]
[10.550739, "o", "### /app/vats/plaster.vat\r\n"]
