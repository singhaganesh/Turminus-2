Sending keys: ['cat > /app/sessbay/load.rs <<\'EOF\'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::fs;\nuse std::rc::Rc;\n\npub struct Plan {\n    pub old: String,\n    pub new: String,\n    pub extra: String,\n}\n\npub fn kiln_pitch(n0: u32, n1: u32) -> (u32, u32) {\n    (n0.saturating_add(1), n1.saturating_add(2))\n}\n\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\n    let text = fs::read_to_string(p).ok()?;\n    if text.trim().is_empty() { return None; }\n    let (mut n0, mut n1, mut cells, mut mode) = (None, None, None, None);\n    let (mut old, mut new, mut extra) = (None, None, None);\n    for raw in text.lines() {\n        let line = raw.trim();\n        if line.is_empty() || line.starts_with(\'#\') { continue; }\n        let words: Vec<&str> = line.split_whitespace().collect();\n        match words.as_slice() {\n            ["tick", value] if n0.is_none() => n0 = Some(value.parse().ok()?),\n            ["mark", value] if n1.is_none() => n1 = Some(value.parse().ok()?),\n            ["bag", rest @ ..] if cells.is_none() && !rest.is_empty() => {\n                cells = Some(rest.iter().map(|s| (*s).to_string()).collect::<Vec<_>>())\n            }\n            ["mode", value] if mode.is_none() && (*value == "heat" || *value == "peek") => mode = Some(*value == "heat"),\n            ["swap", from, to] if old.is_none() => { old = Some((*from).to_string()); new = Some((*to).to_string()); }\n            ["push", value] if extra.is_none() => extra = Some((*value).to_string()),\n            _ => return None,\n        }\n    }\n    let flag = mode?;\n    if flag {\n        if old.is_none() || new.is_none() || extra.is_none() { return None; }\n    } else if old.is_some() || new.is_some() || extra.is_some() {\n        return None;\n    }\n    let cells = cells?;\n    let ids = (0..cells.len()).collect();\n    Some((\n        hold::Sess { n0: n0?, n1: n1?, ids: Rc::new(RefCell::new(ids)), flag },\n        hold::Pool { cells },\n        Plan { old: old.unwrap_or_default(), new: new.unwrap_or_default(), extra: extra.unwrap_or_default() },\n    ))\n}\n\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\n    if a.flag {\n        for cell in &mut b.cells {\n            if *cell == p.old { *cell = p.new.clone(); }\n        }\n        b.cells.push(p.extra.clone());\n        a.ids.borrow_mut().push(b.cells.len() - 1);\n    }\n    (a.n0, a.n1) = kiln_pitch(a.n0, a.n1);\n}\nEOF\ncat > /app/foldrib/rim.rs <<\'EOF\'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\n        cells: b.cells.clone(),\n    }\n}\nEOF\ncat > /app/internpit/pool.rs <<\'EOF\'\nuse crate::fold;\nuse crate::hold;\nuse crate::load;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(_a: &mut hold::Frost, _b: &hold::Pool) {}\n\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut frost = fold::rim_a(a, b);\n    rim_b(&mut frost, b);\n    frost\n}\n\nfn quote(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for ch in s.chars() {\n        match ch {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if c < \' \' => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn values(ids: &[usize], cells: &[String]) -> Option<Vec<String>> {\n    ids.iter().map(|&i| cells.get(i).cloned()).collect()\n}\n\nfn pack(items: &[String]) -> String {\n    format!("[{}]", items.iter().map(|s| quote(s)).collect::<Vec<_>>().join(","))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path("/app/spoolbay/shift.spool") else { return 1; };\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n    let Some(frost_bag) = values(&frost.ids.borrow(), &frost.cells) else { return 1; };\n    let Some(live_bag) = values(&sess.ids.borrow(), &pool.cells) else { return 1; };\n    if sess.flag && frost_bag == live_bag { return 1; }\n    let body = format!(\n        "{{\\"tick\\":{},\\"mark\\":{},\\"frost_bag\\":{},\\"live_bag\\":{}}}\\n",\n        sess.n0, sess.n1, pack(&frost_bag), pack(&live_bag)\n    );\n    let dest = Path::new("/app/inkpit/pair.json");\n    if let Some(parent) = dest.parent() {\n        if fs::create_dir_all(parent).is_err() { return 2; }\n    }\n    if fs::write(dest, body).is_ok() { 0 } else { 2 }\n}\nEOF\ncat > /app/restcue/ink.rs <<\'EOF\'\nuse crate::pool;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let dest = Path::new("/app/inkpit/pair.json");\n    let guard = Path::new("/app/inkpit/GUARD");\n    let _ = fs::remove_file(guard);\n    let _ = fs::remove_file(dest);\n    let code = pool::dump();\n    if code != 0 { return code; }\n    if fs::write(guard, "ok\\n").is_err() {\n        let _ = fs::remove_file(dest);\n        return 2;\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > /app/emitbay/hearth.rs <<\'EOF\'\nuse std::fs;\nuse std::path::Path;\n\nconst FOLD: &str = include_str!("../foldrib/rim.rs");\nconst POOL: &str = include_str!("../internpit/pool.rs");\nconst INK: &str = include_str!("../restcue/ink.rs");\nconst HEARTH: &str = include_str!("hearth.rs");\nconst BOOT: &str = include_str!("../steerpit/boot.rs");\n\nfn piece(name: &str) -> Option<(&\'static str, &\'static str)> {\n    match name {\n        "foldrib" => Some(("/app/foldrib/rim.rs", FOLD)),\n        "internpit" => Some(("/app/internpit/pool.rs", POOL)),\n        "restcue" => Some(("/app/restcue/ink.rs", INK)),\n        "emitbay" => Some(("/app/emitbay/hearth.rs", HEARTH)),\n        "steerpit" => Some(("/app/steerpit/boot.rs", BOOT)),\n        _ => None,\n    }\n}\n\npub fn rib_d() -> i32 {\n    let Ok(cards) = fs::read_dir("/app/daycards") else { return 1; };\n    let mut paths = Vec::new();\n    for entry in cards {\n        let Ok(entry) = entry else { return 1; };\n        if entry.path().is_file() { paths.push(entry.path()); }\n    }\n    paths.sort();\n    for path in paths {\n        if fs::read(&path).is_err() { return 1; }\n    }\n\n    let Ok(tree) = fs::read_to_string("/app/vatslip/TREE.txt") else { return 1; };\n    let mut count = 0usize;\n    for name in tree.lines().map(str::trim).filter(|s| !s.is_empty()) {\n        let Some((target, source)) = piece(name) else { return 1; };\n        if let Some(parent) = Path::new(target).parent() {\n            if fs::create_dir_all(parent).is_err() { return 2; }\n        }\n        if fs::write(target, source).is_err() { return 2; }\n        count += 1;\n    }\n    if count == 0 { 1 } else { 0 }\n}\nEOF\n/app/bake.sh\n/app/bin/glazeurn bind; echo bind_exit=$?\n/app/bake.sh\nod -An -tx1 -N4 /app/bin/glazeurn\n/app/bin/glazeurn pair; echo pair_exit=$?; cat /app/inkpit/pair.json; printf \'GUARD=\'; cat /app/inkpit/GUARD\n'] min_timeout_sec: 8.0 max_timeout_sec: 180.0
