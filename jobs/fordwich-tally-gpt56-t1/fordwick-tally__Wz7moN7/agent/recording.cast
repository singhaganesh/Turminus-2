[40.67443, "i", "python3 - <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; cap=cv2.VideoCapture(p); fs=[]\nwhile True:\n ok,f=cap.read()\n if not ok: break\n fs.append(f)\ncap.release()\n# Contact sheet, enlarged 2x, every third frame.\nthumb=[]\nfor i in range(0,len(fs),3):\n f=fs[i].copy(); cv2.putText(f,str(i),(3,14),cv2.FONT_HERSHEY_SIMPLEX,.4,(0,0,255),1,cv2.LINE_AA); cv2.line(f,(0,70),(159,70),(0,0,255),1); thumb.append(f)\nrows=[]\nfor i in range(0,len(thumb),4): rows.append(np.hstack(thumb[i:i+4]))\nsheet=np.vstack(rows); cv2.imwrite('/app/contact.png',cv2.resize(sheet,None,fx=2,fy=2,interpolation=cv2.INTER_NEAREST))\n# Global pixel/color statistics and median-background component diagnostics.\na=np.stack(fs); bg=np.median(a,axis=0).astype(np.uint8)\nprint('channel range',a.min((0,1,2)),a.max((0,1,2)),'unique colors approximate',len(np.unique(a.reshape(-1,3),axis=0)))\nfor i,f in enumerate(fs):\n d=cv2.cvtColor(cv2.absdiff(f,bg),cv2.COLOR_BGR2GRAY)\n m=(d>15).astype(np.uint8)*255\n m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n n,lab,st,cen=cv2.connectedComponentsWithStats(m)\n comps=[(int(st[j,4]),tuple(round(float(x),1) for x in cen[j]),tuple(map(int,st[j,:4]))) for j in range(1,n) if st[j,4]>=12]\n if comps: print(i,comps)\nprint('wrote /app/contact.png')\nPY\n"]
