[279.750197, "i", "python3 - <<'PY'\nimport cv2,numpy as np\nout=cv2.VideoWriter('/tmp/milltests/merge_split.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(160,120))\nfor i in range(56):\n f=np.full((120,160,3),185,np.uint8); y=8+2*i\n # Converge until frame 25, overlap for six frames, then diverge.\n if i<25: x1,x2=35+1.7*i,125-1.7*i\n elif i<31: x1,x2=78,82\n else: x1,x2=78-1.6*(i-30),82+1.6*(i-30)\n cv2.circle(f,(round(x1),y),9,(30,40,210),-1)\n cv2.circle(f,(round(x2),y),9,(210,50,30),-1)\n out.write(f)\nout.release()\nPY\npython3 - <<'PY'\nimport cv2,sys\nsys.path.insert(0,'/app')\nfrom blot import foreground_detections,track_bodies\nfrom tether import completed_crossing\nc=cv2.VideoCapture('/tmp/milltests/merge_split.mp4'); fs=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n fs.append(f)\nts=track_bodies(foreground_detections(fs))\nfor i,t in enumerate(ts):\n obs=[(f,round(x,1),round(y,1),real) for f,x,y,real in t['history']]\n print('track',i,'cross',completed_crossing(t),'hits',t['hits'],'start',obs[:3],'line',[(f,x,y,r) for f,x,y,r in obs if 62<=y<=78],'end',obs[-3:])\nPY\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/milltests/merge_split.mp4; echo -n 'folded result: '; cat /app/inkwell/sheet.toml\n"]
