[43.42219, "o", "\u001b[?2004hroot@4990d7a022ff:/app# "]
[170.676238, "i", "cat > /app/blot.py <<'PY'\nfrom __future__ import annotations\n\nimport cv2\nimport numpy as np\n\nLINE_Y = 70\n\n\ndef foreground_detections(frames):\n    \"\"\"Return compact foreground components for every frame.\n\n    The temporal median is substantially more stable than an adapting MOG at\n    the counting line.  In particular, a soft moving shadow is not allowed to\n    repeatedly alter the background model.\n    \"\"\"\n    stack = np.asarray(frames, dtype=np.uint8)\n    bg = np.median(stack, axis=0).astype(np.uint8)\n    ans = []\n    kernel = np.ones((3, 3), np.uint8)\n    for frame in frames:\n        delta = cv2.absdiff(frame, bg)\n        # Maximum channel change retains dark and coloured bodies.  Compression\n        # noise in these small MP4s is far below this threshold.\n        mag = delta.max(axis=2)\n        mask = (mag >= 16).astype(np.uint8) * 255\n        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)\n        n, labels, stats, cents = cv2.connectedComponentsWithStats(mask, 8)\n        dets = []\n        for j in range(1, n):\n            x, y, w, h, area = (int(v) for v in stats[j])\n            if area < 24 or w < 3 or h < 3:\n                continue\n            fill = area / float(w * h)\n            # A shade sweep is characteristically long, thin, and sparse.\n            # Large compact regions remain admissible because several touching\n            # bodies can legitimately form one component.\n            aspect = max(w / float(h), h / float(w))\n            if (aspect > 5.0 and fill < 0.72) or (w > 110 and h < 18) or (h > 100 and w < 12):\n                continue\n            if area > 3500 and fill < 0.45:\n                continue\n            pix = frame[labels == j]\n            color = np.median(pix, axis=0) if len(pix) else np.zeros(3)\n            dets.append({\n                \"x\": float(cents[j][0]), \"y\": float(cents[j][1]),\n                \"w\": w, \"h\": h, \"area\": area,\n                \"left\": x, \"top\": y, \"right\": x + w, \"bottom\": y + h,\n                \"color\": color.astype(float),\n            })\n        ans.append(dets)\n    return ans\n\n\ndef _new_track(d, frame_no):\n    return {\n        \"x\": d[\"x\"], \"y\": d[\"y\"], \"vx\": 0.0, \"vy\": 0.0,\n        \"last\": frame_no, \"hits\": 1, \"miss\": 0,\n        \"area\": float(d[\"area\"]), \"color\": d[\"color\"].copy(),\n        \"history\": [(frame_no, d[\"x\"], d[\"y\"], True)],\n    }\n\n\ndef _predict(t, frame_no):\n    dt = max(1, frame_no - t[\"last\"])\n    return t[\"x\"] + t[\"vx\"] * dt, t[\"y\"] + t[\"vy\"] * dt\n\n\ndef track_bodies(all_dets):\n    tracks = []\n    for fi, dets in enumerate(all_dets):\n        pairs = []\n        for ti, t in enumerate(tracks):\n            px, py = _predict(t, fi)\n            dt = max(1, fi - t[\"last\"])\n            for di, d in enumerate(dets):\n                dx, dy = d[\"x\"] - px, d[\"y\"] - py\n                dist = (dx * dx + dy * dy) ** 0.5\n                # A modest colour term resolves close, differently coloured\n                # bodies but never prevents recovery after an occlusion.\n                cd = float(np.mean(np.abs(d[\"color\"] - t[\"color\"])))\n                gate = 15.0 + min(28.0, 4.5 * dt)\n                if dist <= gate:\n                    pairs.append((dist + min(cd, 40.0) * 0.06, ti, di))\n        pairs.sort()\n        used_t, used_d = set(), set()\n        for _, ti, di in pairs:\n            if ti in used_t or di in used_d:\n                continue\n            t, d = tracks[ti], dets[di]\n            dt = max(1, fi - t[\"last\"])\n            nvx = (d[\"x\"] - t[\"x\"]) / dt\n            nvy = (d[\"y\"] - t[\"y\"]) / dt\n            # Do not drag a trajectory to the centre of a merged component.\n            merged = d[\"area\"] > max(1.55 * t[\"area\"], t[\"area\"] + 120)\n            if merged:\n                px, py = _predict(t, fi)\n                ox = min(max(px, d[\"left\"]), d[\"right\"] - 1.0)\n                oy = min(max(py, d[\"top\"]), d[\"bottom\"] - 1.0)\n                t[\"x\"], t[\"y\"] = ox, oy\n                t[\"history\"].append((fi, ox, oy, False))\n            else:\n                t[\"vx\"] = 0.55 * t[\"vx\"] + 0.45 * "]
[170.676444, "i", "nvx\n                t[\"vy\"] = 0.55 * t[\"vy\"] + 0.45 * nvy\n                t[\"x\"], t[\"y\"] = d[\"x\"], d[\"y\"]\n                t[\"area\"] = 0.8 * t[\"area\"] + 0.2 * d[\"area\"]\n                t[\"color\"] = 0.8 * t[\"color\"] + 0.2 * d[\"color\"]\n                t[\"history\"].append((fi, d[\"x\"], d[\"y\"], True))\n            t[\"last\"], t[\"hits\"], t[\"miss\"] = fi, t[\"hits\"] + 1, 0\n            used_t.add(ti); used_d.add(di)\n\n        # A merged detection may represent several already-known tracks. Keep\n        # the other predictions alive inside it, allowing a later split to\n        # restore the original identities.\n        for ti, t in enumerate(tracks):\n            if ti in used_t:\n                continue\n            px, py = _predict(t, fi)\n            holder = None\n            for di, d in enumerate(dets):\n                if (d[\"left\"] - 5 <= px <= d[\"right\"] + 5 and\n                        d[\"top\"] - 5 <= py <= d[\"bottom\"] + 5 and\n                        d[\"area\"] > 1.25 * t[\"area\"]):\n                    holder = d; break\n            if holder is not None:\n                t[\"x\"], t[\"y\"], t[\"last\"], t[\"miss\"] = px, py, fi, 0\n                t[\"history\"].append((fi, px, py, False))\n            else:\n                t[\"miss\"] += 1\n\n        for di, d in enumerate(dets):\n            if di not in used_d and d[\"y\"] < LINE_Y + 8:\n                tracks.append(_new_track(d, fi))\n    return tracks\nPY\n\ncat > /app/tether.py <<'PY'\nfrom __future__ import annotations\n\nfrom blot import LINE_Y\n\n\ndef completed_crossing(track) -> bool:\n    \"\"\"A real observation above must precede one below; predictions alone do\n    not prove a crossing.\"\"\"\n    obs = [(f, y) for f, _x, y, real in track[\"history\"] if real]\n    if len(obs) < 2:\n        return False\n    for i, (fa, ya) in enumerate(obs):\n        if ya <= LINE_Y - 2:\n            for fb, yb in obs[i + 1:]:\n                if fb > fa and yb >= LINE_Y + 2 and yb - ya >= 5:\n                    return True\n    return False\n\n\ndef fold_gate(tracks) -> int:\n    return sum(1 for t in tracks if completed_crossing(t))\nPY\n\ncat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport toml\n\nfrom blot import foreground_detections, track_bodies\nfrom tether import fold_gate\n\nSHEET = Path('/app/inkwell/sheet.toml')\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise OSError('invalid clip frame')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise OSError('empty or unreadable clip')\n    return fold_gate(track_bodies(foreground_detections(frames)))\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    temp = SHEET.with_suffix('.tmp')\n    temp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    temp.replace(SHEET)\nPY\n\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    # A failed run must never leave a result from an earlier clip.\n    try:\n        SHEET.unlink(missing_ok=True)\n    except OSError:\n        return 1\n    if len(sys.argv) != 2:\n        return 2\n    try:\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n    except Exception as exc:\n        print('mill:', exc, file=sys.stderr)\n        try:\n            SHEET.unlink(missing_ok=True)\n        except OSError:\n            pass\n        return 1\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\nchmod +x /app/kiln/bake.sh && /app/kiln/bake.sh\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /app/shown.mp4\ncat /app/inkwell/sheet.toml\n"]
