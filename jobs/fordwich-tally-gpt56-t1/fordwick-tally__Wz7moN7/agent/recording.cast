[218.282624, "o", "\u001b[?2004hroot@4990d7a022ff:/app# "]
[218.451801, "i", "mkdir -p /tmp/milltests; python3 - <<'PY'\nimport cv2, numpy as np, os\nW,H=160,120\nfourcc=cv2.VideoWriter_fourcc(*'mp4v')\ndef write(name, maker, n=60):\n out=cv2.VideoWriter('/tmp/milltests/'+name+'.mp4',fourcc,12,(W,H))\n for i in range(n):\n  f=np.full((H,W,3),185,np.uint8); maker(f,i); out.write(f)\n out.release()\n# One valid downward, one upward (expected 1).\ndef direction(f,i):\n cv2.circle(f,(45,8+2*i),8,(20,60,210),-1)\n cv2.circle(f,(115,112-2*i),8,(210,70,20),-1)\nwrite('direction',direction,52)\n# Body pauses with centroid on scan then resumes (expected 1).\ndef linger(f,i):\n y=min(70,15+3*i) if i<20 else (70 if i<35 else 70+3*(i-34))\n if y<128: cv2.rectangle(f,(70,y-8),(88,y+8),(20,180,40),-1)\nwrite('linger',linger,55)\n# Two bodies converge, overlap near line, and split (expected 2).\ndef merge(f,i):\n y=10+2*i\n x1=min(78,35+2*i); x2=max(82,125-2*i)\n cv2.circle(f,(x1,y),9,(30,40,210),-1)\n cv2.circle(f,(x2,y),9,(210,50,30),-1)\nwrite('merge',merge,52)\n# Three separate simultaneous bodies (expected 3).\ndef simultaneous(f,i):\n y=10+2*i\n for x,c in [(35,(20,30,210)),(80,(30,190,40)),(125,(210,50,20))]: cv2.circle(f,(x,y),8,c,-1)\nwrite('simultaneous',simultaneous,52)\n# Long sparse horizontal shade band sweeps down (expected 0).\ndef smear(f,i):\n y=5+2*i\n overlay=f.copy(); cv2.rectangle(overlay,(0,y-5),(159,y+5),(90,90,90),-1); cv2.addWeighted(overlay,.32,f,.68,0,f)\nwrite('smear',smear,58)\n# A body approaches but reverses before centroid passage (expected 0).\ndef reverse(f,i):\n y=15+3*i if i<17 else 66-3*(i-17)\n if y>-10: cv2.circle(f,(80,y),9,(40,40,220),-1)\nwrite('reverse',reverse,42)\nPY\nfor spec in direction:1 linger:1 merge:2 simultaneous:3 smear:0 reverse:0; do f=${spec%:*}; want=${spec#*:}; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/milltests/$f.mp4; got=$(sed -n 's/crossings = //p' /app/inkwell/sheet.toml); printf '%-14s want=%s got=%s\\n' \"$f\" \"$want\" \"$got\"; done\n"]
