[43.063871, "o", "im=cv2.imread('/app/contact.png'); im=cv2.resize(im,(96,48))\r\n\u001b[?2004l\r"]
[43.064001, "o", "\u001b[?2004h> "]
[43.064076, "o", "g=cv2.cvtColor(im,cv2.COLOR_BGR2GRAY)\r\n\u001b[?2004l\r"]
[43.064167, "o", "\u001b[?2004h> chars=' .:-=+*#%@'\r\n\u001b[?2004l\r"]
[43.064199, "o", "\u001b[?2004h> "]
[43.064407, "o", "for row in g: print(''.join(chars[min(9,int(v)*10//256)] for v in row))\r\n\u001b[?2004l\r"]
