[170.688148, "o", "\u001b[?2004h> "]
[170.688208, "o", "            dets.append({\r\n\u001b[?2004l\r"]
[170.688252, "o", "\u001b[?2004h"]
[170.688293, "o", "> "]
[170.688445, "o", "                \"x\": float(cents[j][0]), \"y\": float(cents[j][1]),\r\n\u001b[?2004l\r"]
[170.688492, "o", "\u001b[?2004h> "]
[170.688615, "o", "                \"w\": w, \"h\": h, \"area\": area,\r\n\u001b[?2004l\r"]
[170.688665, "o", "\u001b[?2004h> "]
[170.688864, "o", "                \"left\": x, \"top\": y, \"right\": x + w, \"bottom\": y + h,\r\n\u001b[?2004l\r"]
[170.688925, "o", "\u001b[?2004h> "]
[170.689029, "o", "                \"color\": color.astype(float),\r\n\u001b[?2004l\r"]
[170.689078, "o", "\u001b[?2004h> "]
[170.689128, "o", "            })\r\n\u001b[?2004l\r"]
[170.689169, "o", "\u001b[?2004h> "]
[170.689219, "o", "        ans.append(dets)\r\n\u001b[?2004l\r"]
[170.689267, "o", "\u001b[?2004h> "]
[170.68931, "o", "    return ans\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.689351, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.689396, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.689478, "o", "def _new_track(d, frame_no):\r\n\u001b[?2004l\r"]
[170.689526, "o", "\u001b[?2004h"]
[170.689574, "o", ">     return {\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.689625, "o", "> "]
[170.68976, "o", "        \"x\": d[\"x\"], \"y\": d[\"y\"], \"vx\": 0.0, \"vy\": 0.0,\r\n\u001b[?2004l\r"]
[170.689811, "o", "\u001b[?2004h> "]
[170.689995, "o", "        \"last\": frame_no, \"hits\": 1, \"miss\": 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.690163, "o", "        \"area\": float(d[\"area\"]), \"color\": d[\"color\"].copy(),\r\n\u001b[?2004l\r"]
[170.690217, "o", "\u001b[?2004h> "]
[170.690363, "o", "        \"history\": [(frame_no, d[\"x\"], d[\"y\"], True)],\r\n\u001b[?2004l\r"]
[170.690408, "o", "\u001b[?2004h"]
[170.690455, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.690507, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.690588, "o", "def _predict(t, frame_no):\r\n\u001b[?2004l\r"]
[170.690637, "o", "\u001b[?2004h"]
[170.690683, "o", "> "]
[170.690745, "o", "    dt = max(1, frame_no - t[\"last\"])\r\n\u001b[?2004l\r"]
[170.690798, "o", "\u001b[?2004h> "]
[170.690975, "o", "    return t[\"x\"] + t[\"vx\"] * dt, t[\"y\"] + t[\"vy\"] * dt\r\n\u001b[?2004l\r"]
[170.691031, "o", "\u001b[?2004h> \r\n"]
[170.691075, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.691149, "o", "def track_bodies(all_dets):\r\n\u001b[?2004l\r"]
[170.691192, "o", "\u001b[?2004h> "]
[170.69124, "o", "    tracks = []\r\n\u001b[?2004l\r"]
[170.69129, "o", "\u001b[?2004h> "]
[170.691404, "o", "    for fi, dets in enumerate(all_dets):\r\n\u001b[?2004l\r"]
[170.691453, "o", "\u001b[?2004h> "]
[170.691524, "o", "        pairs = []\r\n\u001b[?2004l\r"]
[170.691568, "o", "\u001b[?2004h> "]
[170.691682, "o", "        for ti, t in enumerate(tracks):\r\n\u001b[?2004l\r"]
[170.691723, "o", "\u001b[?2004h> "]
[170.691837, "o", "            px, py = _predict(t, fi)\r\n\u001b[?2004l\r"]
[170.69189, "o", "\u001b[?2004h> "]
[170.692008, "o", "            dt = max(1, fi - t[\"last\"])\r\n\u001b[?2004l\r"]
[170.692054, "o", "\u001b[?2004h> "]
[170.692182, "o", "            for di, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[170.692223, "o", "\u001b[?2004h> "]
[170.692387, "o", "                dx, dy = d[\"x\"] - px, d[\"y\"] - py\r\n\u001b[?2004l\r"]
[170.69243, "o", "\u001b[?2004h> "]
[170.692591, "o", "                dist = (dx * dx + dy * dy) ** 0.5\r\n\u001b[?2004l\r"]
[170.692641, "o", "\u001b[?2004h> "]
[170.692871, "o", "                # A modest colour term resolves close, differently coloured\r\n"]
[170.692959, "o", "\u001b[?2004l\r\u001b[?2004h"]
[170.693015, "o", "> "]
[170.693139, "o", "                # bodies but never prevents recovery after an occlusion.\r\n\u001b[?2004l\r"]
[170.693185, "o", "\u001b[?2004h> "]
[170.693432, "o", "                cd = float(np.mean(np.abs(d[\"color\"] - t[\"color\"])))\r\n\u001b[?2004l\r"]
[170.693481, "o", "\u001b[?2004h> "]
[170.693643, "o", "                gate = 15.0 + min(28.0, 4.5 * dt)\r\n\u001b[?2004l\r"]
[170.693698, "o", "\u001b[?2004h> "]
[170.693805, "o", "                if dist <= gate:\r\n\u001b[?2004l\r"]
[170.693866, "o", "\u001b[?2004h"]
[170.693936, "o", "> "]
[170.694096, "o", "                    pairs.append((dist + min(cd, 40.0) * 0.06, ti, di))\r\n\u001b[?2004l\r"]
[170.694152, "o", "\u001b[?2004h> "]
[170.694213, "o", "        pairs.sort()\r\n\u001b[?2004l\r"]
[170.694264, "o", "\u001b[?2004h> "]
[170.694385, "o", "        used_t, used_d = set(), set()\r\n\u001b[?2004l\r"]
[170.694436, "o", "\u001b[?2004h> "]
[170.694544, "o", "        for _, ti, di in pairs:\r\n\u001b[?2004l\r"]
[170.694596, "o", "\u001b[?2004h> "]
[170.694726, "o", "            if ti in used_t or di in used_d:\r\n\u001b[?2004l\r"]
[170.69477, "o", "\u001b[?2004h> "]
[170.694854, "o", "                continue\r\n\u001b[?2004l\r"]
[170.6949, "o", "\u001b[?2004h> "]
[170.695038, "o", "            t, d = tracks[ti], dets[di]\r\n\u001b[?2004l\r"]
[170.695082, "o", "\u001b[?2004h> "]
[170.695217, "o", "            dt = max(1, fi - t[\"last\"])\r\n\u001b[?2004l\r"]
[170.695263, "o", "\u001b[?2004h> "]
[170.6954, "o", "            nvx = (d[\"x\"] - t[\"x\"]) / dt\r\n\u001b[?2004l\r"]
[170.695451, "o", "\u001b[?2004h> "]
[170.695582, "o", "            nvy = (d[\"y\"] - t[\"y\"]) / dt\r\n\u001b[?2004l\r"]
[170.695641, "o", "\u001b[?2004h"]
[170.695694, "o", "> "]
[170.695872, "o", "            # Do not drag a trajectory to the centre of a merged component.\r\n\u001b[?2004l\r"]
[170.695929, "o", "\u001b[?2004h> "]
[170.696164, "o", "            merged = d[\"area\"] > max(1.55 * t[\"area\"], t[\"area\"] + 120)\r\n\u001b[?2004l\r"]
[170.696258, "o", "\u001b[?2004h> "]
[170.696307, "o", "            if merged:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.69645, "o", "                px, py = _predict(t, fi)\r\n\u001b[?2004l\r"]
[170.696518, "o", "\u001b[?2004h> "]
[170.696717, "o", "                ox = min(max(px, d[\"left\"]), d[\"right\"] - 1.0)\r\n\u001b[?2004l\r"]
[170.696808, "o", "\u001b[?2004h> "]
[170.696947, "o", "                oy = min(max(py, d[\"top\"]), d[\"bottom\"] - 1.0)\r\n\u001b[?2004l\r"]
[170.697046, "o", "\u001b[?2004h"]
[170.69716, "o", "> "]
[170.697259, "o", "                t[\"x\"], t[\"y\"] = ox, oy\r\n\u001b[?2004l\r"]
[170.697303, "o", "\u001b[?2004h> "]
[170.697482, "o", "                t[\"history\"].append((fi, ox, oy, False))\r\n\u001b[?2004l\r"]
[170.697527, "o", "\u001b[?2004h> "]
[170.697699, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.697872, "o", "                t[\"vx\"] = 0.55 * t[\"vx\"] + 0.45 * nvx\r\n\u001b[?2004l\r"]
[170.69807, "o", "\u001b[?2004h> "]
[170.698198, "o", "                t[\"vy\"] = 0.55 * t[\"vy\"] + 0.45 * nvy\r\n\u001b[?2004l\r"]
[170.69836, "o", "\u001b[?2004h> "]
[170.698597, "o", "                t[\"x\"], t[\"y\"] = d[\"x\"], d[\"y\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.698796, "o", "> "]
[170.698971, "o", "                t[\"area\"] = 0.8 * t[\"area\"] + 0.2 * d[\"area\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.699004, "o", "> "]
[170.69923, "o", "                t[\"color\"] = 0.8 * t[\"color\"] + 0.2 * d[\"color\"]\r\n\u001b[?2004l\r"]
[170.699361, "o", "\u001b[?2004h"]
[170.69945, "o", "> "]
[170.699538, "o", "                t[\"history\"].append((fi, d[\"x\"], d[\"y\"], True))\r\n\u001b[?2004l\r"]
[170.699582, "o", "\u001b[?2004h> "]
[170.699832, "o", "            t[\"last\"], t[\"hits\"], t[\"miss\"] = fi, t[\"hits\"] + 1, 0\r\n\u001b[?2004l\r"]
[170.699871, "o", "\u001b[?2004h> "]
[170.70006, "o", "            used_t.add(ti); used_d.add(di)\r\n\u001b[?2004l\r"]
[170.700093, "o", "\u001b[?2004h> "]
[170.700116, "o", "\r\n\u001b[?2004l\r"]
[170.700256, "o", "\u001b[?2004h> "]
[170.700445, "o", "        # A merged detection may represent several already-known tracks. Keep\r\n\u001b[?2004l\r"]
[170.70054, "o", "\u001b[?2004h> "]
[170.700662, "o", "        # the other predictions alive inside it, allowing a later split to\r\n\u001b[?2004l\r"]
[170.700741, "o", "\u001b[?2004h> "]
[170.700828, "o", "        # restore the original identities.\r\n\u001b[?2004l\r"]
[170.700896, "o", "\u001b[?2004h> "]
[170.700993, "o", "        for ti, t in enumerate(tracks):\r\n\u001b[?2004l\r"]
[170.701086, "o", "\u001b[?2004h> "]
[170.701172, "o", "            if ti in used_t:\r\n\u001b[?2004l\r"]
[170.701248, "o", "\u001b[?2004h> "]
[170.701332, "o", "                continue\r\n\u001b[?2004l\r"]
[170.701437, "o", "\u001b[?2004h> "]
[170.701509, "o", "            px, py = _predict(t, fi)\r\n\u001b[?2004l\r"]
[170.701574, "o", "\u001b[?2004h> "]
[170.701649, "o", "            holder = None\r\n\u001b[?2004l\r"]
[170.701711, "o", "\u001b[?2004h> "]
[170.701856, "o", "            for di, d in enumerate(dets):\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.701931, "o", "> "]
[170.702088, "o", "                if (d[\"left\"] - 5 <= px <= d[\"right\"] + 5 and\r\n\u001b[?2004l\r"]
[170.702158, "o", "\u001b[?2004h> "]
[170.70234, "o", "                        d[\"top\"] - 5 <= py <= d[\"bottom\"] + 5 and\r\n\u001b[?2004l\r"]
[170.702409, "o", "\u001b[?2004h> "]
[170.702585, "o", "                        d[\"area\"] > 1.25 * t[\"area\"]):\r\n\u001b[?2004l\r"]
[170.702661, "o", "\u001b[?2004h> "]
[170.702789, "o", "                    holder = d; break\r\n\u001b[?2004l\r"]
[170.702898, "o", "\u001b[?2004h> "]
[170.70309, "o", "            if holder is not None:\r\n\u001b[?2004l\r"]
[170.703165, "o", "\u001b[?2004h> "]
[170.703226, "o", "                t[\"x\"], t[\"y\"], t[\"last\"], t[\"miss\"] = px, py, fi, 0\r\n\u001b[?2004l\r"]
[170.703374, "o", "\u001b[?2004h>                 t[\"history\"].append((fi, px, py, False))\r\n"]
[170.7034, "o", "\u001b[?2004l\r"]
[170.703418, "o", "\u001b[?2004h> "]
[170.703562, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.70365, "o", "                t[\"miss\"] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.703724, "o", "> "]
[170.703803, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.703885, "o", "        for di, d in enumerate(dets):\r\n\u001b[?2004l\r"]
[170.703974, "o", "\u001b[?2004h> "]
[170.704305, "o", "            if di not in used_d and d[\"y\"] < LINE_Y + 8:\r\n\u001b[?2004l\r"]
[170.704677, "o", "\u001b[?2004h>                 tracks.append(_new_track(d, fi))\r\n\u001b[?2004l\r\u001b[?2004h>     return tracks\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[170.706031, "o", "\u001b[?2004hroot@4990d7a022ff:/app# \r\n\u001b[?2004l\r"]
[170.706153, "o", "\u001b[?2004hroot@4990d7a022ff:/app# cat > /app/tether.py <<'PY'\r\n\u001b[?2004l\r"]
[170.706253, "o", "\u001b[?2004h> "]
[170.706354, "o", "from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.706957, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> from blot import LINE_Y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def completed_crossing(track) -> bool:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"A real observation above must precede one below; predictions alone do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.707957, "o", "    not prove a crossing.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     obs = [(f, y) for f, _x, y, real in track[\"history\"] if real]\r\n\u001b[?2004l\r\u001b[?2004h>     if len(obs) < 2:\r\n\u001b[?2004l\r\u001b[?2004h>         return False\r\n\u001b[?2004l\r\u001b[?2004h>     for i, (fa, ya) in enumerate(obs):\r\n\u001b[?2004l\r\u001b[?2004h>         if ya <= LINE_Y - 2:\r\n\u001b[?2004l\r\u001b[?2004h>             for fb, yb in obs[i + 1:]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.708068, "o", "                if fb > fa and yb >= LINE_Y + 2 and yb - ya >= 5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.70815, "o", "                    return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.70823, "o", "    return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.708321, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.708392, "o", "\u001b[?2004h> "]
[170.708453, "o", "def fold_gate(tracks) -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.708542, "o", "    return sum(1 for t in tracks if completed_crossing(t))\r\n\u001b[?2004l\r"]
[170.708622, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[170.709866, "o", "\u001b[?2004hroot@4990d7a022ff:/app# \r\n\u001b[?2004l\r"]
[170.709988, "o", "\u001b[?2004hroot@4990d7a022ff:/app# "]
[170.710041, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.71012, "o", "from __future__ import annotations\r\n\u001b[?2004l\r"]
[170.710177, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.710236, "o", "\u001b[?2004h> "]
[170.71029, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[170.710347, "o", "\u001b[?2004h> "]
[170.710406, "o", "import cv2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.710462, "o", "import toml\r\n\u001b[?2004l\r"]
[170.710548, "o", "\u001b[?2004h"]
[170.710611, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.710701, "o", "from blot import foreground_detections, track_bodies\r\n\u001b[?2004l\r"]
[170.710783, "o", "\u001b[?2004h> "]
[170.710863, "o", "from tether import fold_gate\r\n\u001b[?2004l\r"]
[170.712945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> SHEET = Path('/app/inkwell/sheet.toml')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def emit_span(src: str) -> int:\r\n\u001b[?2004l\r\u001b[?2004h>     cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r\u001b[?2004h>     if not cap.isOpened():\r\n\u001b[?2004l\r\u001b[?2004h>         cap.release()\r\n\u001b[?2004l\r\u001b[?2004h>         raise OSError('cannot open clip')\r\n\u001b[?2004l\r\u001b[?2004h>     frames = []\r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\n\u001b[?2004l\r\u001b[?2004h>         ok, frame = cap.read()\r\n\u001b[?2004l\r\u001b[?2004h>         if not ok:\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>         if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r\u001b[?2004h>             cap.release()\r\n\u001b[?2004l\r\u001b[?2004h>             raise OSError('invalid clip frame')\r\n\u001b[?2004l\r\u001b[?2004h>         frames.append(frame)\r\n\u001b[?2004l\r\u001b[?2004h>     cap.release()\r\n\u001b[?2004l\r\u001b[?2004h>     if not frames:\r\n\u001b[?2004l\r\u001b[?2004h>         raise OSError('empty or unreadable clip')\r\n\u001b[?2004l\r\u001b[?2004h>     return fold_gate(track_bodies(foreground_detections(frames)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r\u001b[?2004h>     SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.713044, "o", "    temp = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r"]
[170.713103, "o", "\u001b[?2004h> "]
[170.713306, "o", "    temp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r"]
[170.713397, "o", "\u001b[?2004h> "]
[170.713427, "o", "    temp.replace(SHEET)\r\n\u001b[?2004l\r"]
[170.713445, "o", "\u001b[?2004h> "]
[170.713461, "o", "PY\r\n\u001b[?2004l\r"]
[170.717051, "o", "\u001b[?2004hroot@4990d7a022ff:/app# "]
[170.719285, "o", "\r\n\u001b[?2004l\r\u001b[?2004hroot@4990d7a022ff:/app# cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main() -> int:\r\n\u001b[?2004l\r\u001b[?2004h>     # A failed run must never leave a result from an earlier clip.\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h>     except OSError:\r\n\u001b[?2004l\r\u001b[?2004h>         return 1\r\n\u001b[?2004l\r\u001b[?2004h>     if len(sys.argv) != 2:\r\n\u001b[?2004l\r\u001b[?2004h>         return 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.719571, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h>         n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[170.719696, "o", "\u001b[?2004h>         dump_sheet(n)\r\n\u001b[?2004l\r"]
[170.719783, "o", "\u001b[?2004h> "]
[170.720012, "o", "    except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.720177, "o", "        print('mill:', exc, file=sys.stderr)\r\n\u001b[?2004l\r"]
[170.720297, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.720463, "o", "            SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.720624, "o", ">         except OSError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.720741, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.720829, "o", ">         return 1\r\n\u001b[?2004l\r"]
[170.720948, "o", "\u001b[?2004h> "]
[170.721058, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[170.721123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.721257, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.72133, "o", "    raise SystemExit(main())\r\n\u001b[?2004l\r"]
[170.721409, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[170.722751, "o", "\u001b[?2004hroot@4990d7a022ff:/app# "]
[170.722895, "o", "chmod +x /app/kiln/bake.sh && /app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[170.812772, "o", "\u001b[?2004hroot@4990d7a022ff:/app# "]
