[281.080758, "o", "folded result: "]
[281.081664, "o", "crossings = 2\r\n"]
[281.081884, "o", "\u001b[?2004hroot@4990d7a022ff:/app# "]
[283.807562, "i", "python3 - <<'PY'\nimport cv2,numpy as np\nF=cv2.VideoWriter_fourcc(*'mp4v')\ndef make(name,draw,n=55):\n o=cv2.VideoWriter('/tmp/milltests/'+name+'.mp4',F,12,(160,120))\n for i in range(n):\n  f=np.full((120,160,3),185,np.uint8); draw(f,i); o.write(f)\n o.release()\n# Downward body is hidden by a larger opaque crossing body for frames 27..37;\n# both are visible before/after and both complete (expected 2).\ndef occ(f,i):\n y=8+2*i\n cv2.circle(f,(78,y),8,(20,190,30),-1)\n y2=2+2*i\n cv2.circle(f,(80,y2),13,(210,40,30),-1)\nmake('occlusion',occ)\n# Static body and a body wholly above line (expected 0).\ndef none(f,i):\n cv2.circle(f,(35,90),8,(30,40,210),-1)\n cv2.circle(f,(100,15+min(i,15)),8,(210,40,30),-1)\nmake('none',none,45)\nPY\nfor spec in merge_split:2 occlusion:2 none:0; do f=${spec%:*}; want=${spec#*:}; rm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /tmp/milltests/$f.mp4; got=$(sed -n 's/crossings = //p' /app/inkwell/sheet.toml); printf '%-14s want=%s got=%s\\n' \"$f\" \"$want\" \"$got\"; done\npython3 -m py_compile /app/blot.py /app/tether.py /app/spout.py /app/spanwell.py && /app/kiln/bake.sh\nrm -f /app/inkwell/sheet.toml; python3 /app/varnish/mill.pyc /app/shown.mp4; cat /app/inkwell/sheet.toml\n"]
[283.80806, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import cv2,numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
