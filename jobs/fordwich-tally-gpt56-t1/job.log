oy = min(max(py, d["top"]), d["bottom"] - 1.0)\n                t["x"], t["y"] = ox, oy\n                t["history"].append((fi, ox, oy, False))\n            else:\n                t["vx"] = 0.55 * t["vx"] + 0.45 * nvx\n                t["vy"] = 0.55 * t["vy"] + 0.45 * nvy\n                t["x"], t["y"] = d["x"], d["y"]\n                t["area"] = 0.8 * t["area"] + 0.2 * d["area"]\n                t["color"] = 0.8 * t["color"] + 0.2 * d["color"]\n                t["history"].append((fi, d["x"], d["y"], True))\n            t["last"], t["hits"], t["miss"] = fi, t["hits"] + 1, 0\n            used_t.add(ti); used_d.add(di)\n\n        # A merged detection may represent several already-known tracks. Keep\n        # the other predictions alive inside it, allowing a later split to\n        # restore the original identities.\n        for ti, t in enumerate(tracks):\n            if ti in used_t:\n                continue\n            px, py = _predict(t, fi)\n            holder = None\n            for di, d in enumerate(dets):\n                if (d["left"] - 5 <= px <= d["right"] + 5 and\n                        d["top"] - 5 <= py <= d["bottom"] + 5 and\n                        d["area"] > 1.25 * t["area"]):\n                    holder = d; break\n            if holder is not None:\n                t["x"], t["y"], t["last"], t["miss"] = px, py, fi, 0\n                t["history"].append((fi, px, py, False))\n            else:\n                t["miss"] += 1\n\n        for di, d in enumerate(dets):\n            if di not in used_d and d["y"] < LINE_Y + 8:\n                tracks.append(_new_track(d, fi))\n    return tracks\nPY\n\ncat > /app/tether.py <<\'PY\'\nfrom __future__ import annotations\n\nfrom blot import LINE_Y\n\n\ndef completed_crossing(track) -> bool:\n    """A real observation above must precede one below; predictions alone do\n    not prove a crossing."""\n    obs = [(f, y) for f, _x, y, real in track["history"] if real]\n    if len(obs) < 2:\n        return