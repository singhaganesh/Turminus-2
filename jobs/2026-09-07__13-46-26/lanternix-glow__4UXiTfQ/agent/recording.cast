[40.458034, "o", "    68\t\tvals := map[string]string{}\r\n    69\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n    70\t\t\tline = strings.TrimSpace(line)\r\n    71\t\t\tif line == \"\" {\r\n    72\t\t\t\tcontinue\r\n    73\t\t\t}\r\n    74\t\t\tif strings.HasPrefix(line, \"CODE \") {\r\n    75\t\t\t\tcode = strings.TrimSpace(strings.TrimPrefix(line, \"CODE \"))\r\n    76\t\t\t\tcontinue\r\n    77\t\t\t}\r\n    78\t\t\tk, v, ok := strings.Cut(line, \"=\")\r\n    79\t\t\tif ok {\r\n    80\t\t\t\tvals[strings.TrimSpace(k)] = strings.TrimSpace(v)\r\n    81\t\t\t}\r\n    82\t\t}\r\n    83\t\treturn code, vals, nil\r\n    84\t}\r\n    85\t\r\n    86\ttype card struct {\r\n    87\t\tid    string\r\n    88\t\tslots []string\r\n    89\t}\r\n    90\t\r\n    91\tfunc loadCards(dir string) ([]card, error) {\r\n    92\t\tents, err := os.ReadDir(dir)\r\n    93\t\tif err != nil {\r\n    94\t\t\treturn nil, err\r\n    95\t\t}\r\n    96\t\tvar out []card\r\n    97\t\tfor _, e := range ents {\r\n    98\t\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".card\") {\r\n    99\t\t\t\tcontinue\r\n   100\t\t\t}\r\n   101\t\t\traw, err := os.ReadFile(filepath.Join(dir, e.Name()))\r\n   102\t\t\tif err != nil {\r\n   103\t\t\t\treturn nil, err\r\n   104\t\t\t}\r\n   105\t\t\tc := card{}\r\n   106\t\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n   107\t\t\t\tline = strings.TrimSpace(line)\r\n   108\t\t\t\tif strings.HasPrefix(line, \"id:\") {\r\n   109\t\t\t\t\tc.id = strings.TrimSpace(strings.TrimPrefix(line, \"id:\"))\r\n   110\t\t\t\t}\r\n   111\t\t\t\tif strings.HasPrefix(line, \"slots:\") {\r\n   112\t\t\t\t\tparts := strings.Split(strings.TrimSpace(strings.TrimPrefix(line, \"slots:\")), \",\")\r\n   113\t\t\t\t\tfor _, p := range parts {\r\n   114\t\t\t\t\t\tc.slots = append(c.slots, p)\r\n   115\t\t\t\t\t}\r\n   116\t\t\t\t}\r\n   117\t\t\t}\r\n   118\t\t\tif c.id != \"\" {\r\n   119\t\t\t\tout = append(out, c)\r\n   120\t\t\t}\r\n   121\t\t}\r\n   122\t\treturn out, nil\r\n   123\t}\r\n"]
