[9.708559, "i", "cat /app/notes/ROUTE.txt && printf '\\n--- GRAMMAR ---\\n' && cat /app/notes/GRAMMAR.txt\n"]
[9.70922, "o", "cat /app/notes/ROUTE.txt && printf '\\n--- GRAMMAR ---\\n' && cat /app/notes/GRAMMAR.txt\r\n\u001b[?2004l\r"]
[9.710608, "o", "Pipeline modules live under /app/oxbind, /app/packbay, and /app/milldesk.\r\nCast refreshes generated units under /app/packbay/units and rewrites /app/packbay/reg.go.\r\nEvery directory under /app/packbay/units must be imported by /app/packbay/reg.go.\r\nReadout: /app/bin/lanternix readout --lamp FILE writes /app/glowbank/readout.json.\r\nCast: /app/bin/lanternix cast\r\n/app/bin/lanternix is the ELF mill from milldesk. milldesk/Makefile has a ship target.\r\nSlot grammar for cards and lamps is in /app/notes/GRAMMAR.txt.\r\n"]
[9.710943, "o", "\r\n--- GRAMMAR ---\r\n"]
[9.711893, "o", "Recipe cards under /app/cardwell use:\r\n  id: <CODE>\r\n  slots: name, name\r\n\r\nCurrent cards: LAN_WARM_01 slots lux,hold_s; LAN_BEAM_44 slots az_deg,el_deg;\r\nLAN_FLASH_9C slots candela,dwell_s; LAN_GLOW_2B slots hue,period_s.\r\n\r\nLamp files: /app/lamps/flash9c.lamp, /app/lamps/held.lamp, /app/lamps/warm.lamp,\r\n/app/lamps/beam.lamp, /app/lamps/alien.lamp.\r\nLamp files under /app/lamps use:\r\n  CODE <CODE>\r\n  name=value\r\n\r\nReadout JSON: {\"code\": <str id or void>, \"slots\": <dict of name to str value>}\r\nGap probes may write a temporary ghost.card under /app/cardwell.\r\nOffline Go builds use GOPROXY=off and GOFLAGS=-mod=mod.\r\n"]
[9.71218, "o", "\u001b[?2004h"]
[9.712249, "o", "root@b158a52daed1:/app# "]
