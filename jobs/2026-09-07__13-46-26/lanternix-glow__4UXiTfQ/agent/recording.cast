[71.300908, "i", "cat > /app/packbay/fetch.go <<'EOF'\npackage packbay\n\n// Pull loads every generated recipe unit. The tag is retained as part of the\n// pipeline API; lookup of that tag is performed against the resulting chart.\nfunc Pull(tag string) {\n\tFill()\n}\nEOF\ncat > /app/packbay/reg.go <<'EOF'\npackage packbay\n\nimport (\n\tunita \"loft.local/lanternix/packbay/units/unita\"\n\tunitb \"loft.local/lanternix/packbay/units/unitb\"\n\tunitc \"loft.local/lanternix/packbay/units/unitc\"\n\tunitd \"loft.local/lanternix/packbay/units/unitd\"\n)\n\nfunc Fill() {\n\tunita.Load()\n\tunitb.Load()\n\tunitc.Load()\n\tunitd.Load()\n}\nEOF\npython3 - <<'PY'\np = '/app/milldesk/play.go'\ns = open(p).read()\ns = s.replace('func Play(lampPath string) int {\\n\\toxbind.Boot()\\n\\tcode, vals, err := parseLamp(lampPath)', 'func Play(lampPath string) int {\\n\\tcode, vals, err := parseLamp(lampPath)')\ns = s.replace('\\tpackbay.Pull(code)\\n\\tif !cardsCovered()', '\\tpackbay.Pull(code)\\n\\toxbind.Boot()\\n\\tif !cardsCovered()')\ns = s.replace('\\t\\t_ = writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}})\\n\\t\\treturn 1', '\\t\\tif err := writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}}); err != nil {\\n\\t\\t\\treturn 2\\n\\t\\t}\\n\\t\\treturn 1')\ns = s.replace('\\t_ = writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots})\\n\\treturn 0', '\\tif err := writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots}); err != nil {\\n\\t\\treturn 2\\n\\t}\\n\\treturn 0')\ns = s.replace('c.slots = append(c.slots, p)', 'c.slots = append(c.slots, strings.TrimSpace(p))')\nopen(p, 'w').write(s)\n\np = '/app/milldesk/spin.go'\ns = open(p).read()\ns = s.replace('if err := writeFill([]string{\"unita\", \"unitb\"}); err != nil {', 'units, err := unitDirs(\"/app/packbay/units\")\\n\\tif err != nil {\\n\\t\\treturn 2\\n\\t}\\n\\tif err := writeFill(units); err != nil {')\nmarker = 'func writeFill(units []string) error {'\nhelper = '''func unitDirs(root string) ([]string, error) {\n\tents, err := os.ReadDir(root)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tunits := make([]string, 0, len(ents))\n\tfor _, ent := range ents {\n\t\tif ent.IsDir() {\n\t\t\tunits = append(units, ent.Name())\n\t\t}\n\t}\n\treturn units, nil\n}\n\n'''\nif helper not in s:\n    s = s.replace(marker, helper + marker)\nopen(p, 'w').write(s)\nPY\n/usr/local/go/bin/gofmt -w /app/oxbind /app/packbay /app/milldesk\n"]
