[21.440312, "i", "printf '%s\\n' '--- go.mod ---'; cat go.mod; for f in oxbind/*.go packbay/*.go packbay/store/*.go milldesk/*.go milldesk/Makefile; do echo \"--- $f ---\"; sed -n '1,240p' \"$f\"; done\n"]
[21.441006, "o", "printf '%s\\n' '--- go.mod ---'; cat go.mod; for f in oxbind/*.go packbay/*.go packbay/store/*.go milldesk/*.go milldesk/Makefile; do echo \"--- $f ---\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[21.441133, "o", "--- go.mod ---\r\n"]
[21.442181, "o", "module loft.local/lanternix\r\n\r\ngo 1.22\r\n"]
[21.442548, "o", "--- oxbind/seal.go ---\r\n"]
[21.443984, "o", "package oxbind\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nvar chart map[string]store.Spec\r\n\r\nfunc Clip(bag map[string]store.Spec) map[string]store.Spec {\r\n\tout := make(map[string]store.Spec, len(bag))\r\n\tfor k, v := range bag {\r\n\t\tout[k] = v\r\n\t}\r\n\treturn out\r\n}\r\n"]
[21.444106, "o", "\r\nfunc Boot() {\r\n\tchart = Clip(store.Bag())\r\n}\r\n\r\nfunc Read(tag string) (store.Spec, bool) {\r\n\ts, ok := chart[tag]\r\n\treturn s, ok\r\n}\r\n"]
[21.444292, "o", "--- packbay/fetch.go ---\r\n"]
[21.445698, "o", "package packbay\r\n\r\nvar seed = []string{\"LAN_WARM_01\", \"LAN_BEAM_44\"}\r\n\r\nfunc Pull(tag string) {\r\n\tok := false\r\n"]
[21.445817, "o", "\tfor _, s := range seed {\r\n\t\tif s == tag {\r\n\t\t\tok = true\r\n\t\t\tbreak\r\n\t\t}\r\n\t}\r\n\tif !ok {\r\n\t\treturn\r\n\t}\r\n\tFill()\r\n}\r\n"]
[21.44601, "o", "--- packbay/reg.go ---\r\n"]
[21.447096, "o", "package packbay\r\n\r\nimport (\r\n\tunita \"loft.local/lanternix/packbay/units/unita\"\r\n\tunitb \"loft.local/lanternix/packbay/units/unitb\"\r\n)\r\n\r\nfunc Fill() {\r\n\tunita.Load()\r\n"]
[21.447195, "o", "\tunitb.Load()\r\n}\r\n"]
[21.447326, "o", "--- packbay/store/store.go ---\r\n"]
[21.448564, "o", "package store\r\n\r\ntype Spec struct {\r\n\tSlots []string\r\n}\r\n\r\nvar bag = map[string]Spec{}\r\n\r\nfunc Offer(id string, spec Spec) {\r\n\tbag[id] = spec\r\n}\r\n\r\n"]
[21.448822, "o", "func Bag() map[string]Spec {\r\n\tout := make(map[string]Spec, len(bag))\r\n\tfor k, v := range bag {\r\n\t\tout[k] = v\r\n\t}\r\n\treturn out\r\n}\r\n\r\nfunc Reset() {\r\n\tbag = map[string]Spec{}\r\n}\r\n"]
[21.448895, "o", "--- milldesk/main.go ---\r\n"]
[21.450066, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n\t\"loft.local/lanternix/packbay\"\r\n)"]
[21.450191, "o", "\r\n\r\nfunc main() {\r\n\tos.Exit(run(os.Args[1:]))\r\n}\r\n\r\nfunc run(args []string) int {\r\n\tif len(args) == 0 {\r\n\t\treturn 2\r\n\t}\r\n\tswitch args[0] {\r\n\tcase \"cast\":\r\n\t\tpackbay.Pull(\"LAN_WARM_01\")\r\n\t\toxbind.Boot()\r\n"]
[21.450271, "o", "\t\treturn Spin()\r\n\tcase \"readout\":\r\n\t\tif len(args) < 3 || args[1] != \"--lamp\" {\r\n\t\t\treturn 2\r\n\t\t}\r\n\t\treturn Play(args[2])\r\n\tdefault:\r\n\t\treturn 2\r\n\t}\r\n}\r\n"]
[21.45042, "o", "--- milldesk/play.go ---\r\n"]
[21.451582, "o", "package main\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n\t\"loft.local/lanternix/packbay\"\r\n)\r\n"]
[21.451701, "o", "\r\nfunc Play(lampPath string) int {\r\n\toxbind.Boot()\r\n\tcode, vals, err := parseLamp(lampPath)\r\n\tif err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tpackbay.Pull(code)\r\n\tif !cardsCovered() {\r\n\t\treturn 2\r\n\t}\r\n\tspec, ok := oxbind.Read(code)\r\n\toutPath := \"/app/glowbank/readout.json\"\r\n\tif !ok {\r\n\t\t_ = writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}})\r\n\t\treturn 1\r\n\t}\r\n\tslots := map[string]string{}\r\n\tfor _, name := range spec.Slots {\r\n\t\tslots[name] = vals[name]\r\n\t}\r\n\t_ = writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots})\r\n\treturn 0\r\n}\r\n\r\nfunc cardsCovered() bool {\r\n\tcards, err := loadCards(\"/app/cardwell\")\r\n\tif err != nil {\r\n\t\treturn false\r\n\t}\r\n\tfor _, c := range cards {\r\n\t\tif _, ok := oxbind.Read(c.id); !ok {\r\n"]
[21.451726, "o", "\t\t\treturn false\r\n\t\t}\r\n\t}\r\n\treturn true\r\n}\r\n\r\nfunc writeJSON(path string, doc map[string]any) error {\r\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\r\n\t\treturn err\r\n\t}\r\n\traw, err := json.MarshalIndent(doc, \"\", \"  \")\r\n\tif err != nil {\r\n"]
[21.451741, "o", "\t\treturn err\r\n\t}\r\n\traw = append(raw, '\\n')\r\n\treturn os.WriteFile(path, raw, 0o644)\r\n}\r\n"]
[21.451755, "o", "\r\nfunc parseLamp(path string) (string, map[string]string, error) {\r\n\traw, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t"]
[21.45177, "o", "\treturn \"\", nil, err\r\n\t}\r\n\tcode := \"\"\r\n\tvals := map[string]string{}\r\n\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n"]
[21.451939, "o", "\t\tline = strings.TrimSpace(line)\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif strings.HasPrefix(line, \"CODE \") {\r\n\t\t\tcode = strings.TrimSpace(strings.TrimPrefix(line, \"CODE \"))\r\n"]
[21.452005, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tk, v, ok := strings.Cut(line, \"=\")\r\n\t\tif ok {\r\n\t\t\tvals[strings.TrimSpace(k)] = strings.TrimSpace(v)\r\n\t\t}\r\n\t}\r\n\treturn code, vals, nil\r\n}\r\n\r\ntype card struct {\r\n\tid    string\r\n\tslots []string\r\n}\r\n\r\nfunc loadCards(dir string) ([]card, error) {\r\n\tents, err := os.ReadDir(dir)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar out []card\r\n\tfor _, e := range ents {\r\n\t\tif e.IsDir() || !strings.HasSuffix(e.Name(), \".card\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\traw, err := os.ReadFile(filepath.Join(dir, e.Name()))\r\n\t\tif err != nil {\r\n\t\t\treturn nil, err\r\n\t\t}\r\n\t\tc := card{}\r\n\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\r\n\t\t\tline = strings.TrimSpace(line)\r\n\t\t\tif strings.HasPrefix(line, \"id:\") {\r\n\t\t\t\tc.id = strings.TrimSpace(strings.TrimPrefix(line, \"id:\"))\r\n\t\t\t}\r\n\t\t\tif strings.HasPrefix(line, \"slots:\") {\r\n\t\t\t\tparts := strings.Split(strings.TrimSpace(strings.TrimPrefix(line, \"slots:\")), \",\")\r\n\t\t\t\tfor _, p := range parts {\r\n\t\t\t\t\tc.slots = append(c.slots, p)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif c.id != \"\" {\r\n\t\t\tout = append(out, c)\r\n\t\t}\r\n\t}\r\n\treturn out, nil\r\n}\r\n"]
[21.452213, "o", "--- milldesk/spin.go ---\r\n"]
[21.453282, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n\t\"os/exec\"\r\n\t\"path/filepath\"\r\n\t\"strings\""]
[21.453368, "o", "\r\n\t\"time\"\r\n\r\n\t\"loft.local/lanternix/oxbind\"\r\n\t\"loft.local/lanternix/packbay/store\"\r\n)\r\n\r\nfunc Spin() int {\r\n\ttime.Sleep(2 * time.Second)\r\n\tcards, err := loadCards(\"/app/cardwell\")\r\n\tif err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := writeUnits(cards); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := writeFill([]string{\"unita\", \"unitb\"}); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\t_ = oxbind.Clip(store.Bag())\r\n\tif miss := missingCodes(cards, map[string]store.Spec{}); len(miss) > 0 {\r\n\t}\r\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", \"/app/bin/lanternix.next\", \"loft.local/lanternix/milldesk\")\r\n\tcmd.Dir = \"/app\"\r\n\tcmd.Env = append(os.Environ(),\r\n"]
[21.453444, "o", "\t\t\"GOPROXY=off\",\r\n\t\t\"GOFLAGS=-mod=mod\",\r\n\t\t\"GOCACHE=/tmp/gocache-lanternix\",\r\n\t\t\"PATH=/usr/local/go/bin:\"+os.Getenv(\"PATH\"),\r\n\t)\r\n\tif err := cmd.Run(); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\tif err := os.Rename(\"/app/bin/lanternix.next\", \"/app/bin/lanternix\"); err != nil {\r\n\t\treturn 2\r\n\t}\r\n\treturn 0\r\n}\r\n\r\nfunc writeUnits(cards []card) error {\r\n\troots := map[string]string{\r\n\t\t\"LAN_WARM_01\": \"unita\",\r\n\t\t\"LAN_BEAM_44\": \"unitb\",\r\n\t\t\"LAN_FLASH_9C\": \"unitc\",\r\n\t\t\"LAN_GLOW_2B\": \"unitd\",\r\n\t}\r\n\tfor _, c := range cards {\r\n\t\tdir, ok := roots[c.id]\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tbody := unitSource(dir, c.id, c.slots)\r\n\t\tp := filepath.Join(\"/app/packbay/units\", dir, \"pack.go\")\r\n\t\tif err := os.WriteFile(p, []byte(body), 0o644); err != nil {\r\n\t\t"]
[21.45351, "o", "\treturn err\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n\r\nfunc unitSource(pkg, id string, slots []string) string {\r\n\tquoted := make([]string, 0, len(slots))\r\n\tfor _, s := range slots {\r\n\t\tquoted = append(quoted, `\"`+s+`\"`)\r\n\t}\r\n\treturn \"package \" + pkg + \"\\n\\nimport \\\"loft.local/lanternix/packbay/store\\\"\\n\\nfunc Load() {\\n\\tstore.Offer(\\\"\" + id + \"\\\", store.Spec{Slots: []string{\" + strings.Join(quoted, \", \") + \"}})\\n}\\n\"\r\n}\r\n\r\nfunc writeFill(units []string) error {\r\n\tvar b strings.Builder\r\n\tb.WriteString(\"package packbay\\n\\nimport (\\n\")\r\n\tfor _, u := range units {\r\n\t\tb.WriteString(\"\\t\" + u + \" \\\"loft.local/lanternix/packbay/units/\" + u + \"\\\"\\n\")\r\n\t}\r\n\tb.WriteString(\")\\n\\nfunc Fill() {\\n\")\r\n\tfor _, u := range units {\r\n\t\tb.WriteString(\"\\t\" + u + \".Load()\\n\")\r\n\t}\r\n"]
[21.453565, "o", "\tb.WriteString(\"}\\n\")\r\n\treturn os.WriteFile(\"/app/packbay/reg.go\", []byte(b.String()), 0o644)\r\n}\r\n\r\nfunc missingCodes(cards []card, chart map[string]store.Spec) []string {\r\n\tvar miss []string\r\n\tfor _, c := range cards {\r\n\t\tif _, ok := chart[c.id]; !ok {\r\n\t\t\tmiss = append(miss, c.id)\r\n\t\t}\r\n\t}\r\n\treturn miss\r\n}\r\n"]
[21.453762, "o", "--- milldesk/Makefile ---\r\n"]
[21.454787, "o", ".PHONY: ship\r\nship:\r\n\tGOPROXY=off GOFLAGS=-mod=mod GOCACHE=/tmp/gocache-lanternix go build -o /app/bin/lanternix loft.local/lanternix/milldesk\r\n"]
[21.455026, "o", "\u001b[?2004hroot@b158a52daed1:/app# "]
[21.968857, "i", "for f in packbay/units/*/*.go; do echo \"--- $f ---\"; cat \"$f\"; done; for f in lamps/*.lamp; do echo \"--- $f ---\"; cat \"$f\"; done\n"]
[21.969388, "o", "for f in packbay/units/*/*.go; do echo \"--- $f ---\"; cat \"$f\"; done; for f in lamps/*.lamp; do echo \"--- $f ---\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[21.969669, "o", "--- packbay/units/unita/pack.go ---\r\n"]
[21.970736, "o", "package unita\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_WARM_01\", store.Spec{Slots: []string{\"lux\", \" hold_s\"}})\r\n}\r\n"]
[21.97096, "o", "--- packbay/units/unitb/pack.go ---\r\n"]
[21.971932, "o", "package unitb\r\n\r\nimport \"loft.local/lanternix/packbay/store\"\r\n\r\nfunc Load() {\r\n\tstore.Offer(\"LAN_BEAM_44\", store.Spec{Slots: []string{\"az_deg\", \" el_deg\"}})\r\n}\r\n"]
[21.972092, "o", "--- packbay/units/unitc/pack.go ---\r\n"]
