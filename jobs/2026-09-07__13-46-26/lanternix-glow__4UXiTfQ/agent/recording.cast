[40.459323, "o", "    84\t\t}\r\n    85\t\tb.WriteString(\"}\\n\")\r\n    86\t\treturn os.WriteFile(\"/app/packbay/reg.go\", []byte(b.String()), 0o644)\r\n    87\t}\r\n"]
