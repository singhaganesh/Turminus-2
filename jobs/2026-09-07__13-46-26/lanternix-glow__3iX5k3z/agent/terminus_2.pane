    85		b.WriteString("}\n")
    86		return os.WriteFile("/app/packbay/reg.go", []byte(b.String()), 0o644)
    87	}
    88	
    89	func missingCodes(cards []card, chart map[string]store.Spec) []string {
    90		var miss []string
    91		for _, c := range cards {
    92			if _, ok := chart[c.id]; !ok {
    93				miss = append(miss, c.id)
    94			}
    95		}
    96		return miss
    97	}

