[15.584938, "o", "for f in cardwell/* lamps/*; do printf '\\n--- %s ---\\n' \"$f\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[15.585117, "o", "\r\n--- cardwell/beam.card ---\r\n"]
[15.58617, "o", "id: LAN_BEAM_44\r\nslots: az_deg, el_deg\r\n"]
[15.586401, "o", "\r\n--- cardwell/flare.card ---\r\n"]
[15.587449, "o", "id: LAN_FLASH_9C\r\nslots: candela,  dwell_s\r\n"]
[15.587685, "o", "\r\n--- cardwell/held.card ---\r\n"]
[15.588492, "o", "id: LAN_GLOW_2B\r\nslots: hue,  period_s\r\n"]
[15.588661, "o", "\r\n--- cardwell/warm.card ---\r\n"]
[15.58954, "o", "id: LAN_WARM_01\r\nslots: lux, hold_s\r\n"]
[15.589709, "o", "\r\n--- lamps/alien.lamp ---\r\n"]
[15.590613, "o", "CODE LAN_ALIEN_FF\r\nnoise=1\r\n"]
[15.590775, "o", "\r\n--- lamps/beam.lamp ---\r\n"]
