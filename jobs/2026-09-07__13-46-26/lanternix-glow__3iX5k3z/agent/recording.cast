[66.674517, "i", "cat > packbay/fetch.go <<'EOF'\npackage packbay\n\n// Pull loads all generated recipe units. The requested tag is resolved from\n// the resulting store by oxbind; unknown tags therefore remain unknown.\nfunc Pull(tag string) {\n\tFill()\n}\nEOF\npython3 - <<'PY'\np='milldesk/play.go'\ns=open(p).read()\ns=s.replace('''func Play(lampPath string) int {\n\\toxbind.Boot()\n\\tcode, vals, err := parseLamp(lampPath)''','''func Play(lampPath string) int {\n\\tcode, vals, err := parseLamp(lampPath)''')\ns=s.replace('''\\tpackbay.Pull(code)\n\\tif !cardsCovered()''','''\\tpackbay.Pull(code)\n\\toxbind.Boot()\n\\tif !cardsCovered()''')\ns=s.replace('''\\t\\t_ = writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}})\n\\t\\treturn 1''','''\\t\\tif err := writeJSON(outPath, map[string]any{\"code\": \"void\", \"slots\": map[string]string{}}); err != nil {\n\\t\\t\\treturn 2\n\\t\\t}\n\\t\\treturn 1''')\ns=s.replace('''\\t_ = writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots})\n\\treturn 0''','''\\tif err := writeJSON(outPath, map[string]any{\"code\": code, \"slots\": slots}); err != nil {\n\\t\\treturn 2\n\\t}\n\\treturn 0''')\ns=s.replace('c.slots = append(c.slots, p)', 'c.slots = append(c.slots, strings.TrimSpace(p))')\nopen(p,'w').write(s)\nPY\ncat > milldesk/spin.go <<'EOF'\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n)\n\nfunc Spin() int {\n\tcards, err := loadCards(\"/app/cardwell\")\n\tif err != nil {\n\t\treturn 2\n\t}\n\tif err := writeUnits(cards); err != nil {\n\t\treturn 2\n\t}\n\tunits, err := unitDirs(\"/app/packbay/units\")\n\tif err != nil {\n\t\treturn 2\n\t}\n\tif err := writeFill(units); err != nil {\n\t\treturn 2\n\t}\n\tcmd := exec.Command(\"/usr/local/go/bin/go\", \"build\", \"-o\", \"/app/bin/lanternix.next\", \"loft.local/lanternix/milldesk\")\n\tcmd.Dir = \"/app\"\n\tcmd.Env = append(os.Environ(),\n\t\t\"GOPROXY=off\",\n\t\t\"GOFLAGS=-mod=mod\",\n\t\t\"GOCACHE=/tmp/gocache-lanternix\",\n\t)\n\tif err := cmd.Run(); err != nil {\n\t\treturn 2\n\t}\n\tif err := os.Rename(\"/app/bin/lanternix.next\", \"/app/bin/lanternix\"); err != nil {\n\t\treturn 2\n\t}\n\treturn 0\n}\n\nfunc writeUnits(cards []card) error {\n\troots := map[string]string{\n\t\t\"LAN_WARM_01\": \"unita\",\n\t\t\"LAN_BEAM_44\": \"unitb\",\n\t\t\"LAN_FLASH_9C\": \"unitc\",\n\t\t\"LAN_GLOW_2B\": \"unitd\",\n\t}\n\tfor _, c := range cards {\n\t\tdir, ok := roots[c.id]\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tp := filepath.Join(\"/app/packbay/units\", dir, \"pack.go\")\n\t\tif err := os.WriteFile(p, []byte(unitSource(dir, c.id, c.slots)), 0o644); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc unitSource(pkg, id string, slots []string) string {\n\tquoted := make([]string, 0, len(slots))\n\tfor _, slot := range slots {\n\t\tquoted = append(quoted, strconv.Quote(strings.TrimSpace(slot)))\n\t}\n\treturn fmt.Sprintf(\"package %s\\n\\nimport \\\\\\\"loft.local/lanternix/packbay/store\\\\\\\"\\n\\nfunc Load() {\\n\\\\tstore.Offer(%s, store.Spec{Slots: []string{%s}})\\n}\\n\", pkg, strconv.Quote(id), strings.Join(quoted, \", \"))\n}\n\nfunc unitDirs(root string) ([]string, error) {\n\tentries, err := os.ReadDir(root)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar units []string\n\tfor _, entry := range entries {\n\t\tif entry.IsDir() {\n\t\t\tunits = append(units, entry.Name())\n\t\t}\n\t}\n\tsort.Strings(units)\n\treturn units, nil\n}\n\nfunc writeFill(units []string) error {\n\tvar b strings.Builder\n\tb.WriteString(\"package packbay\\n\\nimport (\\n\")\n\tfor i, unit := range units {\n\t\tfmt.Fprintf(&b, \"\\\\tu%d %s\\n\", i, strconv.Quote(\"loft.local/lanternix/packbay/units/\"+unit))\n\t}\n\tb.WriteString(\")\\n\\nfunc Fill() {\\n\")\n\tfor i := range units {\n\t\tfmt.Fprintf(&b, \"\\\\tu%d.Load()\\n\", i)\n\t}\n\tb.WriteString(\"}\\n\")\n\treturn os.WriteFile(\"/app/packbay/reg.go\", []byte(b.String()), 0o644)\n}\nEOF\n/usr/local/go/bin/gofmt -w oxbind packbay milldesk\n"]
