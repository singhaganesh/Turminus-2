[82.961929, "o", "\u001b[?2004h"]
[82.962233, "o", ">         public final List<byte[]> ids = new ArrayList<byte[]>();\r\n\u001b[?2004l\r\u001b[?2004h>         public boolean bad;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
