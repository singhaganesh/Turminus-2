[31.198915, "o", "     6\t    static final int ALIGN = 32;\r\n     7\t\r\n     8\t    public static byte[] tint_k(Path a, byte[] b) throws Exception {\r\n     9\t        byte[] pins = Files.exists(a.resolve(\"pin.bin\")) ? Files.readAllBytes(a.resolve(\"pin.bin\")) : new byte[0];\r\n    10\t        byte[] blob = Files.exists(a.resolve(\"blob.bin\")) ? Files.readAllBytes(a.resolve(\"blob.bin\")) : new byte[0];\r\n    11\t        int i = 0;\r\n    12\t        while (i + 48 <= pins.length) {\r\n    13\t            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\r\n    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            if (same(id, b)) {\r\n    22\t                int rec = 4 + len;\r\n    23\t                int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n    24\t                int take = rec + pad;\r\n    25\t                if (blob.length < off + take) {\r\n    26\t                    byte[] z = new byte[take];\r\n    27\t                    int have = Math.max(0, blob.length - (int) off);\r\n    28\t                    if (have > 0) {\r\n    29\t                        System.arraycopy(blob, (int) off, z, 0, Math.min(have, take));\r\n    30\t                    }\r\n    31\t                    return z;\r\n    32\t                }\r\n    33\t                byte[] out = new byte[take];\r\n    34\t                System.arraycopy(blob, (int) off, out, 0, take);\r\n    35\t                return out;\r\n    36\t            }\r\n    37\t            i += 48;\r\n    38\t        }\r\n    39\t        return new byte[0];\r\n    40\t    }\r\n    41\t\r\n    42\t    static boolean same(byte[] x, byte[] y) {\r\n    43\t        if (x.length != y.length) {\r\n    44\t            return false;\r\n    45\t        }\r\n    46\t        for (int i = 0; i < x.length; i++) {\r\n    47\t            if (x[i] != y[i]) {\r\n    48\t                return false;\r\n    49\t            }\r\n    50\t        }\r\n    51\t        return true;\r\n    52\t    }\r\n    53\t}\r\n"]
[31.201268, "o", "--- /app/hitchbay/Crc.java ---\r\n"]
