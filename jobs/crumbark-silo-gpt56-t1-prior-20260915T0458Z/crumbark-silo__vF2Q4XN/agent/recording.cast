[82.963782, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     public static Scan scan(Path silo) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h>         byte[] pins = read(silo.resolve(\"pin.bin\"));\r\n\u001b[?2004l\r\u001b[?2004h>         byte[] blob = read(silo.resolve(\"blob.bin\"));\r\n\u001b[?2004l\r\u001b[?2004h>         Scan result = new Scan();\r\n\u001b[?2004l\r\u001b[?2004h>         if (pins.length % PIN_SIZE != 0) result.bad = true;\r\n\u001b[?2004l\r\u001b[?2004h>         for (int pos = 0; pos + PIN_SIZE <= pins.length; pos += PIN_SIZE) {\r\n\u001b[?2004l\r\u001b[?2004h>             Record r = parse(pins, pos, blob);\r\n\u001b[?2004l\r\u001b[?2004h>             if (r == null) result.bad = true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.963866, "o", "            else result.ids.add(r.id);\r\n\u001b[?2004l\r"]
[82.963884, "o", "\u001b[?2004h> "]
[82.963993, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         return result;"]
[82.964108, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
