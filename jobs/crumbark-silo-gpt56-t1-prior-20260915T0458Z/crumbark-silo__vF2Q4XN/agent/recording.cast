[82.964778, "o", "        byte[] pins = read(silo.resolve(\"pin.bin\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.964882, "o", "        byte[] blob = read(silo.resolve(\"blob.bin\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.965039, "o", "        for (int pos = 0; pos + PIN_SIZE <= pins.length; pos += PIN_SIZE) {\r\n\u001b[?2004l\r"]
[82.965144, "o", "\u001b[?2004h> "]
