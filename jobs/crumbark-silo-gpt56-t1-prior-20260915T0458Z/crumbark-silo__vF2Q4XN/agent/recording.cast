[20.371049, "o", "--- brimvat.sh ---\r\n"]
[20.374905, "o", "     1\t#!/bin/bash\r\n     2\tset -euo pipefail\r\n     3\tJAVAC=\"${JAVA_HOME:-/opt/java/openjdk}/bin/javac\"\r\n     4\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n     5\tif [ ! -x \"$JAVAC\" ]; then\r\n     6\t  JAVAC=javac\r\n     7\t  JAVA=java\r\n     8\tfi\r\n     9\tmkdir -p /app/blastcp /app/silo /app/bin\r\n    10\t\"$JAVAC\" -d /app/blastcp /app/recipit/LoomCue.java\r\n    11\t\"$JAVA\" -cp /app/blastcp LoomCue\r\n    12\tmapfile -t SRC < <(find /app/recipit /app/markwell /app/siltpage /app/hitchbay /app/retrycue -name '*.java' | sort)\r\n    13\t\"$JAVAC\" -d /app/blastcp \"${SRC[@]}\"\r\n    14\tcat > /app/bin/crumbark << 'EOF'\r\n    15\t#!/bin/bash\r\n    16\tset -euo pipefail\r\n    17\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n    18\tif [ ! -x \"$JAVA\" ]; then\r\n    19\t  JAVA=java\r\n    20\tfi\r\n    21\tverb=\"${1:-}\"\r\n    22\tshift || true\r\n    23\tcase \"$verb\" in\r\n    24\t  tamp)\r\n    25\t    exec /app/brimvat.sh\r\n    26\t    ;;\r\n    27\t  lade|wake|pull|nick)\r\n    28\t    exec \"$JAVA\" -cp /app/blastcp DeskMain \"$verb\" \"$@\"\r\n    29\t    ;;\r\n    30\t  *)\r\n    31\t    exit 2\r\n    32\t    ;;\r\n    33\tesac\r\n    34\tEOF\r\n    35\tchmod +x /app/bin/crumbark /app/brimvat.sh\r\n"]
[20.37533, "o", "--- NOTE ---\r\n"]
[20.378487, "o", "Desk runbook: tamp after source edits. lade a slip, then wake, then pull an id from held.\r\n\r\nIf a pull comes back empty, some shifts bump retrycue/PauseCue and wait. That path is still in the tree for the old flaky-reader hypothesis.\r\n"]
[20.382892, "o", "\r\n--- /app/recipit/ForceSeq.java ---\r\n"]
[20.384937, "o", "     1\tpublic class ForceSeq {\r\n     2\t    public static String[] names() {\r\n     3\t        return new String[] {\"pin\", \"blob\"};\r\n     4\t    }\r\n     5\t}\r\n\r\n--- /app/recipit/LoomCue.java ---\r\n"]
[20.385759, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\timport java.util.ArrayList;\r\n"]
[20.386197, "o", "     5\timport java.util.Comparator;\r\n     6\timport java.util.List;\r\n     7\t\r\n     8\tpublic class LoomCue {\r\n     9\t    static final class Step {\r\n    10\t        String name;\r\n    11\t        int compute;\r\n    12\t        int durable;\r\n    13\t    }\r\n    14\t\r\n    15\t    public static List<String> rib_q(Path a) throws Exception {\r\n    16\t        List<Step> steps = new ArrayList<Step>();\r\n    17\t        for (String line : Files.readAllLines(a)) {\r\n    18\t            String s = line.trim();\r\n    19\t            if (s.isEmpty() || s.startsWith(\"#\")) {\r\n    20\t                continue;\r\n    21\t            }\r\n    22\t            String[] p = s.split(\"\\\\s+\");\r\n    23\t            if (p.length < 3) {\r\n    24\t                continue;\r\n    25\t            }\r\n    26\t            Step st = new Step();\r\n    27\t            st.name = p[0];\r\n    28\t            st.compute = Integer.parseInt(p[1]);\r\n    29\t            st.durable = Integer.parseInt(p[2]);\r\n    30\t            steps.add(st);\r\n    31\t        }\r\n    32\t        steps.sort(Comparator.comparingInt(x -> x.compute));\r\n    33\t        List<String> names = new ArrayList<String>();\r\n    34\t        for (Step st : steps) {\r\n    35\t            names.add(st.name);\r\n    36\t        }\r\n    37\t        return names;\r\n    38\t    }\r\n    39\t\r\n    40\t    public static void main(String[] args) throws Exception {\r\n    41\t        Path recipe = Paths.get(\"/app/recipit/steps.loom\");\r\n    42\t        List<String> names = rib_q(recipe);\r\n    43\t        StringBuilder sb = new StringBuilder();\r\n    44\t        sb.append(\"public class ForceSeq {\\n\");\r\n    45\t        sb.append(\"    public static String[] names() {\\n\");\r\n    46\t        sb.append(\"        return new String[] {\");\r\n    47\t        for (int i = 0; i < names.size(); i++) {\r\n    48\t            if (i > 0) {\r\n    49\t                sb.append(\", \");\r\n    50\t            }\r\n    51\t            sb.append(\"\\\"\");\r\n    52\t            sb.append(names.get(i));\r\n    53\t            sb.append(\"\\\"\");\r\n    54\t        }\r\n    55\t        sb.append(\"};\\n\");\r\n    56\t        sb.append(\"    }\\n\");\r\n    57\t        sb.append(\"}\\n\");\r\n    58\t        Files.writeString(Paths.get(\"/app/recipit/ForceSeq.java\"), sb.toString());\r\n    59\t    }\r\n    60\t}\r\n"]
[20.386983, "o", "\r\n--- /app/recipit/steps.loom ---\r\n"]
[20.389891, "o", "     1\tpin 1 2\r\n     2\tblob 2 1\r\n\r\n--- /app/markwell/HueWalk.java ---\r\n"]
[20.390369, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.util.ArrayList;\r\n     5\timport java.util.List;\r\n     6\t\r\n     7\tpublic class HueWalk {\r\n     8\t    public static int orb_n(Path a, Path b, Path c) throws Exception {\r\n     9\t        byte[] pins = Files.exists(b) ? Files.readAllBytes(b) : new byte[0];\r\n    10\t        List<String> held = new ArrayList<String>();\r\n    11\t        int i = 0;\r\n    12\t        while (i + 48 <= pins.length) {\r\n    13\t            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\r\n    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            int crc = bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            held.add(hex(id));\r\n    22\t            i += 48;\r\n    23\t        }\r\n    24\t        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"ok\\\",\\\"kind\\\":\\\"live\\\"}\";\r\n    25\t        Files.writeString(c, json);\r\n    26\t        return 0;\r\n    27\t    }\r\n    28\t\r\n    29\t    static String hex(byte[] id) {\r\n    30\t        StringBuilder sb = new StringBuilder();\r\n    31\t        for (byte v : id) {\r\n    32\t            sb.append(String.format(\"%02x\", v & 0xff));\r\n    33\t        }\r\n    34\t        return sb.toString();\r\n    35\t    }\r\n    36\t\r\n    37\t    static String arr(List<String> held) {\r\n    38\t        StringBuilder sb = new StringBuilder(\"[\");\r\n    39\t        for (int i = 0; i < held.size(); i++) {\r\n    40\t            if (i > 0) {\r\n    41\t                sb.append(\",\");\r\n    42\t            }\r\n    43\t            sb.append(\"\\\"\");\r\n    44\t            sb.append(held.get(i));\r\n    45\t            sb.append(\"\\\"\");\r\n    46\t        }\r\n    47\t        sb.append(\"]\");\r\n    48\t        return sb.toString();\r\n    49\t    }\r\n    50\t\r\n    51\t    public static void main(String[] args) throws Exception {\r\n    52\t        Path silo = Path.of(\"/app/silo\");\r\n    53\t        int rc = orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\"));\r\n    54\t        System.exit(rc);\r\n    55\t    }\r\n    56\t}\r\n"]
[20.390826, "o", "\r\n--- /app/siltpage/MistSpan.java ---\r\n"]
[20.392295, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\t\r\n     5\tpublic class MistSpan {\r\n     6\t    static final int ALIGN = 32;\r\n     7\t\r\n     8\t    public static byte[] tint_k(Path a, byte[] b) throws Exception {\r\n     9\t        byte[] pins = Files.exists(a.resolve(\"pin.bin\")) ? Files.readAllBytes(a.resolve(\"pin.bin\")) : new byte[0];\r\n    10\t        byte[] blob = Files.exists(a.resolve(\"blob.bin\")) ? Files.readAllBytes(a.resolve(\"blob.bin\")) : new byte[0];\r\n    11\t        int i = 0;\r\n    12\t        while (i + 48 <= pins.length) {\r\n    13\t            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);\r\n    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            if (same(id, b)) {\r\n    22\t                int rec = 4 + len;\r\n    23\t                int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n    24\t                int take = rec + pad;\r\n    25\t                if (blob.length < off + take) {\r\n    26\t                    byte[] z = new byte[take];\r\n    27\t                    int have = Math.max(0, blob.length - (int) off);\r\n    28\t                    if (have > 0) {\r\n    29\t                        System.arraycopy(blob, (int) off, z, 0, Math.min(have, take));\r\n    30\t                    }\r\n    31\t                    return z;\r\n    32\t                }\r\n    33\t                byte[] out = new byte[take];\r\n    34\t                System.arraycopy(blob, (int) off, out, 0, take);\r\n    35\t                return out;\r\n    36\t            }\r\n    37\t            i += 48;\r\n"]
[20.392635, "o", "    38\t        }\r\n    39\t        return new byte[0];\r\n    40\t    }\r\n    41\t\r\n    42\t    static boolean same(byte[] x, byte[] y) {\r\n    43\t        if (x.length != y.length) {\r\n    44\t            return false;\r\n    45\t        }\r\n    46\t        for (int i = 0; i < x.length; i++) {\r\n    47\t            if (x[i] != y[i]) {\r\n    48\t                return false;\r\n    49\t            }\r\n    50\t        }\r\n    51\t        return true;\r\n    52\t    }\r\n    53\t}\r\n"]
[20.393079, "o", "\r\n--- /app/hitchbay/Crc.java ---\r\n"]
[20.395029, "o", "     1\timport java.util.zip.CRC32;\r\n     2\t\r\n     3\tpublic class Crc {\r\n     4\t    public static int of(byte[] a) {\r\n     5\t        CRC32 c = new CRC32();\r\n     6\t        c.update(a);\r\n     7\t        return (int) c.getValue();\r\n     8\t    }\r\n     9\t}\r\n"]
[20.395664, "o", "\r\n--- /app/hitchbay/CutRun.java ---\r\n"]
[20.398132, "o", "     1\timport java.nio.file.Paths;\r\n     2\t\r\n     3\tpublic class CutRun {\r\n     4\t    public static void main(String[] args) throws Exception {\r\n     5\t        if (args.length < 1) {\r\n     6\t            System.exit(2);\r\n     7\t        }\r\n     8\t        try {\r\n     9\t            StowRun.run(Paths.get(args[0]), true);\r\n"]
[20.398575, "o", "    10\t        } catch (StowRun.CutErr e) {\r\n    11\t            System.exit(0);\r\n    12\t        }\r\n    13\t    }\r\n    14\t}\r\n"]
[20.398865, "o", "\r\n--- /app/hitchbay/DeskMain.java ---\r\n"]
[20.401208, "o", "     1\tpublic class DeskMain {\r\n     2\t    public static void main(String[] args) throws Exception {\r\n     3\t        if (args.length < 1) {\r\n     4\t            System.exit(2);\r\n     5\t        }\r\n     6\t        String verb = args[0];\r\n     7\t        String[] rest = new String[Math.max(0, args.length - 1)];\r\n     8\t        if (args.length > 1) {\r\n     9\t            System.arraycopy(args, 1, rest, 0, rest.length);\r\n    10\t        }\r\n    11\t        if (\"lade\".equals(verb)) {\r\n"]
[20.402029, "o", "    12\t            StowRun.main(rest);\r\n    13\t        } else if (\"wake\".equals(verb)) {\r\n    14\t            StirRun.main(rest);\r\n    15\t        } else if (\"pull\".equals(verb)) {\r\n    16\t            YankRun.main(rest);\r\n    17\t        } else if (\"nick\".equals(verb)) {\r\n    18\t            CutRun.main(rest);\r\n    19\t        } else {\r\n    20\t            System.exit(2);\r\n    21\t        }\r\n    22\t    }\r\n    23\t}\r\n\r\n--- /app/hitchbay/RibChan.java ---\r\n"]
[20.403929, "o", "     1\timport java.io.ByteArrayOutputStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.StandardOpenOption;\r\n     5\t\r\n     6\tpublic class RibChan {\r\n     7\t    final Path file;\r\n     8\t    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\r\n     9\t\r\n    10\t    RibChan(Path file) {\r\n    11\t        this.file = file;\r\n    12\t    }\r\n    13\t\r\n    14\t    void append(byte[] x) throws Exception {\r\n    15\t        pending.write(x);\r\n    16\t    }\r\n    17\t\r\n    18\t    void force() throws Exception {\r\n    19\t        byte[] out = pending.toByteArray();\r\n    20\t        if (out.length == 0) {\r\n    21\t            return;\r\n    22\t        }\r\n    23\t        Files.write(file, out, StandardOpenOption.CREATE, StandardOpenOption.APPEND);\r\n    24\t        pending.reset();\r\n    25\t    }\r\n    26\t}\r\n"]
[20.405134, "o", "\r\n--- /app/hitchbay/StirRun.java ---\r\n"]
[20.408065, "o", "     1\timport java.nio.file.Path;\r\n     2\t\r\n     3\tpublic class StirRun {\r\n     4\t    public static void main(String[] args) throws Exception {\r\n     5\t        Path silo = Path.of(\"/app/silo\");\r\n     6\t        int rc = HueWalk.orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"), silo.resolve(\"wake.json\"));\r\n     7\t        System.exit(rc);\r\n     8\t    }\r\n     9\t}\r\n"]
[20.411118, "o", "\r\n--- /app/hitchbay/StowRun.java ---\r\n"]
[20.417342, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.security.MessageDigest;\r\n     6\t\r\n     7\tpublic class StowRun {\r\n     8\t    static final int ALIGN = 32;\r\n     9\t\r\n    10\t    public static class CutErr extends RuntimeException {\r\n    11\t    }\r\n    12\t\r\n    13\t    public static void run(Path slip, boolean cut) throws Exception {\r\n    14\t        byte[] payload = Files.readAllBytes(slip);\r\n    15\t        Path silo = Paths.get(\"/app/silo\");\r\n    16\t        Files.createDirectories(silo);\r\n    17\t        Path blob = silo.resolve(\"blob.bin\");\r\n    18\t        Path pin = silo.resolve(\"pin.bin\");\r\n    19\t        if (!Files.exists(blob)) {\r\n    20\t            Files.write(blob, new byte[0]);\r\n    21\t        }\r\n    22\t        if (!Files.exists(pin)) {\r\n    23\t            Files.write(pin, new byte[0]);\r\n    24\t        }\r\n    25\t        long offset = Files.size(blob);\r\n    26\t        RibChan bch = new RibChan(blob);\r\n    27\t        RibChan pch = new RibChan(pin);\r\n    28\t        int len = payload.length;\r\n    29\t        int rec = 4 + len;\r\n    30\t        int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n    31\t        ByteBuffer recb = ByteBuffer.allocate(rec + pad);\r\n    32\t        recb.putInt(len);\r\n    33\t        recb.put(payload);\r\n    34\t        recb.put(new byte[pad]);\r\n"]
[20.419299, "o", "    35\t        bch.append(recb.array());\r\n    36\t        byte[] id = idOf(payload);\r\n    37\t        ByteBuffer mk = ByteBuffer.allocate(48);\r\n    38\t        mk.put(new byte[] {'P', 'N', '0', '1'});\r\n    39\t        mk.putLong(offset);\r\n    40\t        mk.putInt(len);\r\n    41\t        mk.putInt(Crc.of(payload));\r\n    42\t        mk.put(id);\r\n    43\t        mk.put(new byte[12]);\r\n    44\t        pch.append(mk.array());\r\n    45\t        String[] order = ForceSeq.names();\r\n    46\t        int n = 0;\r\n    47\t        for (String ch : order) {\r\n    48\t            if (\"blob\".equals(ch)) {\r\n    49\t                bch.force();\r\n    50\t            } else {\r\n    51\t                pch.force();\r\n    52\t            }\r\n    53\t            n++;\r\n    54\t            if (cut && n == 1) {\r\n    55\t                throw new CutErr();\r\n    56\t            }\r\n    57\t        }\r\n    58\t    }\r\n    59\t\r\n    60\t    static byte[] idOf(byte[] payload) throws Exception {\r\n    61\t        MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n    62\t        byte[] d = md.digest(payload);\r\n"]
[20.419899, "o", "    63\t        byte[] id = new byte[16];\r\n    64\t        System.arraycopy(d, 0, id, 0, 16);\r\n    65\t        return id;\r\n    66\t    }\r\n    67\t\r\n    68\t    public static void main(String[] args) throws Exception {\r\n    69\t        if (args.length < 1) {\r\n    70\t            System.exit(2);\r\n    71\t        }\r\n    72\t        run(Paths.get(args[0]), false);\r\n    73\t    }\r\n    74\t}\r\n"]
[20.423359, "o", "\r\n--- /app/hitchbay/YankRun.java ---\r\n"]
[20.425937, "o", "     1\timport java.nio.file.Files;\r\n     2\timport java.nio.file.Path;\r\n     3\timport java.nio.file.Paths;\r\n     4\t\r\n     5\tpublic class YankRun {\r\n     6\t    public static void main(String[] args) throws Exception {\r\n     7\t        if (args.length < 1) {\r\n     8\t            System.exit(2);\r\n     9\t        }\r\n    10\t        byte[] id = hex(args[0]);\r\n    11\t        Path silo = Paths.get(\"/app/silo\");\r\n    12\t        byte[] got = MistSpan.tint_k(silo, id);\r\n    13\t        if (got.length == 0 || allZero(got)) {\r\n    14\t            PauseCue.nap();\r\n    15\t            got = MistSpan.tint_k(silo, id);\r\n    16\t        }\r\n    17\t        Files.write(Paths.get(\"/tmp/crumbark-pull.bin\"), got);\r\n    18\t        System.out.write(got);\r\n    19\t    }\r\n    20\t\r\n    21\t    static boolean allZero(byte[] a) {\r\n    22\t        for (byte v : a) {\r\n    23\t            if (v != 0) {\r\n    24\t                return false;\r\n    25\t            }\r\n    26\t        }\r\n    27\t        return a.length > 0;\r\n    28\t    }\r\n    29\t\r\n    30\t    static byte[] hex(String s) {\r\n    31\t        int n = s.length() / 2;\r\n    32\t        byte[] out = new byte[n];\r\n    33\t        for (int i = 0; i < n; i++) {\r\n    34\t            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\r\n    35\t        }\r\n    36\t        return out;\r\n    37\t    }\r\n    38\t}\r\n"]
[20.426944, "o", "\r\n--- /app/retrycue/PauseCue.java ---\r\n"]
