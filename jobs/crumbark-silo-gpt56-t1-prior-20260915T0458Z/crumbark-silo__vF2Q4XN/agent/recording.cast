[83.438938, "i", "cat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.StandardCopyOption;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\n\npublic class HueWalk {\n    public static int orb_n(Path blob, Path pin, Path card) throws Exception {\n        MistSpan.Scan scan = MistSpan.scan(blob.getParent());\n        Set<String> held = new LinkedHashSet<String>();\n        for (byte[] id : scan.ids) held.add(hex(id));\n        String note = scan.bad ? \"gap\" : \"ok\";\n        String kind = scan.bad ? \"void\" : \"live\";\n        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\" + note\n                + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\"}\";\n        Path tmp = card.resolveSibling(card.getFileName().toString() + \".tmp\");\n        Files.writeString(tmp, json);\n        try {\n            Files.move(tmp, card, StandardCopyOption.ATOMIC_MOVE,\n                    StandardCopyOption.REPLACE_EXISTING);\n        } catch (java.nio.file.AtomicMoveNotSupportedException e) {\n            Files.move(tmp, card, StandardCopyOption.REPLACE_EXISTING);\n        }\n        return scan.bad ? 1 : 0;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format(\"%02x\", v & 0xff));\n        return sb.toString();\n    }\n\n    static String arr(Set<String> held) {\n        StringBuilder sb = new StringBuilder(\"[\");\n        boolean comma = false;\n        for (String id : held) {\n            if (comma) sb.append(',');\n            sb.append('\"').append(id).append('\"');\n            comma = true;\n        }\n        return sb.append(']').toString();\n    }\n\n    public static void main(String[] args) throws Exception {\n        Path silo = Path.of(\"/app/silo\");\n        System.exit(orb_n(silo.resolve(\"blob.bin\"), silo.resolve(\"pin.bin\"),\n                silo.resolve(\"wake.json\")));\n    }\n}\nEOF\ncat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class YankRun {\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1 || !args[0].matches(\"[0-9a-f]{32}\")) System.exit(2);\n        byte[] got = MistSpan.tint_k(Paths.get(\"/app/silo\"), hex(args[0]));\n        if (got == null) System.exit(1);\n        System.out.write(got);\n    }\n\n    static byte[] hex(String s) {\n        byte[] out = new byte[16];\n        for (int i = 0; i < out.length; i++)\n            out[i] = (byte) Integer.parseInt(s.substring(i * 2, i * 2 + 2), 16);\n        return out;\n    }\n}\nEOF\n/app/bin/crumbark tamp\nset +e; /app/bin/crumbark wake; echo \"wake_rc=$?\"; cat /app/silo/wake.json; echo\nfor f in /app/inbox/prior.slip /app/inbox/seed.slip; do id=$(sha256sum \"$f\"|cut -c1-32); /app/bin/crumbark pull \"$id\" >/tmp/got; r=$?; cmp -s \"$f\" /tmp/got; echo \"$(basename \"$f\") pull=$r cmp=$? bytes=$(wc -c </tmp/got)\"; done\nset -e\n"]
