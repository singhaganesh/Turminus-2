[118.351961, "i", "set -e\nbefore=$(stat -c%s /app/silo/pin.bin)\n/app/bin/crumbark nick /app/inbox/oak-a.slip\nafter=$(stat -c%s /app/silo/pin.bin)\ntest \"$before\" = \"$after\"\n/app/bin/crumbark wake\npython3 - <<'PY'\nimport json,subprocess,hashlib,glob\nc=json.load(open('/app/silo/wake.json'))\nassert c['kind']=='live' and c['note']=='ok'\nfor ident in c['held']:\n    body=subprocess.check_output(['/app/bin/crumbark','pull',ident])\n    assert len(body)>0 and hashlib.sha256(body).hexdigest()[:32]==ident\nprint('nick recovery OK:',len(c['held']),'ids')\nPY\n"]
