[121.705281, "i", "set -e\ncp -a /app/silo /tmp/silo-valid\n# Shorten the blob into the final referenced record.\npython3 - <<'PY'\np='/app/silo/blob.bin'\nb=open(p,'rb').read()\nopen(p,'wb').write(b[:-40])\nPY\nset +e\n/app/bin/crumbark wake\nr=$?\nset -e\ntest \"$r\" -ne 0\npython3 - <<'PY'\nimport json\nc=json.load(open('/app/silo/wake.json'))\nassert c['kind']=='void' and c['note']=='gap'\nprint('short blob rejected:',len(c['held']),'valid ids retained')\nPY\nrm -rf /app/silo; cp -a /tmp/silo-valid /app/silo\n# Corrupt the id byte named by TORN.txt in the final pin row.\npython3 - <<'PY'\np='/app/silo/pin.bin'\nb=bytearray(open(p,'rb').read()); row=len(b)-48; b[row+20]^=1\nopen(p,'wb').write(b)\nPY\nset +e\n/app/bin/crumbark wake\nwr=$?\nbadid=$(python3 - <<'PY'\nb=open('/app/silo/pin.bin','rb').read(); print(b[-28:-12].hex())\nPY\n)\n/app/bin/crumbark pull \"$badid\" >/tmp/bad-pull\npr=$?\nset -e\ntest \"$wr\" -ne 0\ntest \"$pr\" -ne 0\ntest ! -s /tmp/bad-pull\npython3 - <<'PY'\nimport json\nc=json.load(open('/app/silo/wake.json'))\nassert c['kind']=='void' and c['note']=='gap'\nprint('torn pin id rejected')\nPY\nrm -rf /app/silo; cp -a /tmp/silo-save /app/silo\n/app/bin/crumbark tamp\n/app/bin/crumbark wake\ncat /app/silo/wake.json; echo\n"]
[121.706957, "o", "set -e\r\ncp -a /app/silo /tmp/silo-valid\r\n# Shorten the blob into the final referenced record.\r\npython3 - <<'PY'\r\np='/app/silo/blob.bin'\r\nb=open(p,'rb').read()\r\nopen(p,'wb').write(b[:-40])\r\nPY\r\nset +e\r\n/app/bin/crumbark wake\r\nr=$?\r\nset -e\r\ntest \"$r\" -ne 0\r\npython3 - <<'PY'\r\nimport json\r\nc=json.load(open('/app/silo/wake.json'))\r\nassert c['kind']=='void' and c['note']=='gap'\r\nprint('short blob rejected:',len(c['held']),'valid ids retained')\r\nPY\r\nrm -rf /app/silo; cp -a /tmp/silo-valid /app/silo\r\n# Corrupt the id byte named by TORN.txt in the final pin row.\r\npython3 - <<'PY'\r\np='/app/silo/pin.bin'\r\nb=bytearray(open(p,'rb').read()); row=len(b)-48; b[row+20]^=1\r\nopen(p,'wb').write(b)\r\nPY\r\nset +e\r\n/app/bin/crumbark wake\r\nwr=$?\r\nbadid=$(python3 - <<'PY'\r\nb=open('/app/silo/pin.bin','rb').read(); print(b[-28:-12].hex())\r\nPY\r\n)\r\n/app/bin/crumbark pull \"$badid\" >/tmp/bad-pull\r\npr=$?\r\nset -e\r\ntest \"$wr\" -ne 0\r\ntest \"$pr\" -ne 0\r\ntest ! -s /tmp/bad-pull\r\npython3 - <<'PY'\r\nimport json\r\nc=json.load(open('/app/silo/wake.json'))\r\nassert c['kind']=='void' and c['note']=='gap'\r\nprint('torn pin id rejected')\r\nPY\r\nrm -rf /app/silo; cp -a /tmp/silo-save /app/silo\r\n/app/bin/crumbark tamp\r\n/app/bin/crumbark wake\r\ncat /app/silo/wake.json; echo\r\n"]
