[39.215588, "o", "echo '--- RibChan ---'; cat /app/hitchbay/RibChan.java; echo '--- StowRun ---'; cat /app/hitchbay/StowRun.java\r\n\u001b[?2004l\r"]
[39.215687, "o", "--- RibChan ---\r\n"]
[39.216923, "o", "import java.io.ByteArrayOutputStream;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.StandardOpenOption;\r\n\r\npublic class RibChan {\r\n    final Path file;\r\n    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\r\n\r\n    RibChan(Path file) {\r\n        this.file = file;\r\n    }\r\n\r\n    void append(byte[] x) throws Exception {\r\n        pending.write(x);\r\n    }\r\n\r\n    void force() throws Exception {\r\n        byte[] out = pending.toByteArray();\r\n        if (out.length == 0) {\r\n            return;\r\n        }\r\n        Files.write(file, out, StandardOpenOption.CREATE, StandardOpenOption.APPEND);\r\n        pending.reset();\r\n    }\r\n}\r\n"]
[39.217286, "o", "--- StowRun ---\r\n"]
[39.218861, "o", "import java.nio.ByteBuffer;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.security.MessageDigest;\r\n\r\npublic class StowRun {\r\n    static final int ALIGN = 32;\r\n\r\n    public static class CutErr extends RuntimeException {\r\n    }\r\n\r\n    public static void run(Path slip, boolean cut) throws Exception {\r\n        byte[] payload = Files.readAllBytes(slip);\r\n        Path silo = Paths.get(\"/app/silo\");\r\n        Files.createDirectories(silo);\r\n        Path blob = silo.resolve(\"blob.bin\");\r\n        Path pin = silo.resolve(\"pin.bin\");\r\n        if (!Files.exists(blob)) {\r\n            Files.write(blob, new byte[0]);\r\n        }\r\n        if (!Files.exists(pin)) {\r\n            Files.write(pin, new byte[0]);\r\n        }\r\n        long offset = Files.size(blob);\r\n        RibChan bch = new RibChan(blob);\r\n        RibChan pch = new RibChan(pin);\r\n        int len = payload.length;\r\n        int rec = 4 + len;\r\n        int pad = (ALIGN - (rec % ALIGN)) % ALIGN;\r\n        ByteBuffer recb = ByteBuffer.allocate(rec + pad);\r\n        recb.putInt(len);\r\n        recb.put(payload);\r\n        recb.put(new byte[pad]);\r\n        bch.append(recb.array());\r\n        byte[] id = idOf(payload);\r\n        ByteBuffer mk = ByteBuffer.allocate(48);\r\n        mk.put(new byte[] {'P', 'N', '0', '1'});\r\n        mk.putLong(offset);\r\n        mk.putInt(len);\r\n        mk.putInt(Crc.of(payload));\r\n        mk.put(id);\r\n        mk.put(new byte[12]);\r\n        pch.append(mk.array());\r\n        String[] order = ForceSeq.names();\r\n        int n = 0;\r\n        for (String ch : order) {\r\n            if (\"blob\".equals(ch)) {\r\n                bch.force();\r\n            } else {\r\n                pch.force();\r\n"]
[39.218902, "o", "            }\r\n            n++;\r\n            if (cut && n == 1) {\r\n                throw new CutErr();\r\n            }\r\n        }\r\n    }\r\n\r\n    static byte[] idOf(byte[] payload) throws Exception {\r\n        MessageDigest md = MessageDigest.getInstance(\"SHA-256\");\r\n        byte[] d = md.digest(payload);\r\n        byte[] id = new byte[16];\r\n        System.arraycopy(d, 0, id, 0, 16);\r\n        return id;\r\n    }\r\n\r\n    public static void main(String[] args) throws Exception {\r\n        if (args.length < 1) {\r\n            System.exit(2);\r\n        }\r\n        run(Paths.get(args[0]), false);\r\n    }\r\n}\r\n"]
[39.219286, "o", "\u001b[?2004hroot@92a4cb3e46ef:/app# "]
[82.934647, "i", "python3 - <<'PY'\np='/app/recipit/LoomCue.java'\ns=open(p).read()\ns=s.replace('steps.sort(Comparator.comparingInt(x -> x.compute));', 'steps.sort(Comparator.comparingInt(x -> x.durable));')\nopen(p,'w').write(s)\nPY\ncat > /app/hitchbay/RibChan.java <<'EOF'\nimport java.io.ByteArrayOutputStream;\nimport java.nio.ByteBuffer;\nimport java.nio.channels.FileChannel;\nimport java.nio.file.Path;\nimport java.nio.file.StandardOpenOption;\n\npublic class RibChan {\n    final Path file;\n    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\n\n    RibChan(Path file) {\n        this.file = file;\n    }\n\n    void append(byte[] x) throws Exception {\n        pending.write(x);\n    }\n\n    void force() throws Exception {\n        byte[] out = pending.toByteArray();\n        if (out.length == 0) return;\n        try (FileChannel ch = FileChannel.open(file,\n                StandardOpenOption.CREATE, StandardOpenOption.WRITE,\n                StandardOpenOption.APPEND)) {\n            ByteBuffer b = ByteBuffer.wrap(out);\n            while (b.hasRemaining()) ch.write(b);\n            ch.force(true);\n        }\n        pending.reset();\n    }\n}\nEOF\ncat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\npublic class MistSpan {\n    static final int ALIGN = 32;\n    static final int PIN_SIZE = 48;\n\n    public static final class Scan {\n        public final List<byte[]> ids = new ArrayList<byte[]>();\n        public boolean bad;\n    }\n\n    static final class Record {\n        byte[] id;\n        byte[] payload;\n    }\n\n    public static Scan scan(Path silo) throws Exception {\n        byte[] pins = read(silo.resolve(\"pin.bin\"));\n        byte[] blob = read(silo.resolve(\"blob.bin\"));\n        Scan result = new Scan();\n        if (pins.length % PIN_SIZE != 0) result.bad = true;\n        for (int pos = 0; pos + PIN_SIZE <= pins.length; pos += PIN_SIZE) {\n            Record r = parse(pins, pos, blob);\n            if (r == null) result.bad = true;\n            else result.ids.add(r.id);\n        }\n        return result;\n    }\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        if (wanted == null || wanted.length != 16) return null;\n        byte[] pins = read(silo.resolve(\"pin.bin\"));\n        byte[] blob = read(silo.resolve(\"blob.bin\"));\n        for (int pos = 0; pos + PIN_SIZE <= pins.length; pos += PIN_SIZE) {\n            Record r = parse(pins, pos, blob);\n            if (r != null && Arrays.equals(r.id, wanted)) return r.payload;\n        }\n        return null;\n    }\n\n    private static byte[] read(Path p) throws Exception {\n        return Files.exists(p) ? Files.readAllBytes(p) : new byte[0];\n    }\n\n    private static Record parse(byte[] pins, int pos, byte[] blob) throws Exception {\n        if (pins[pos] != 'P' || pins[pos + 1] != 'N' ||\n                pins[pos + 2] != '0' || pins[pos + 3] != '1') return null;\n        ByteBuffer bb = ByteBuffer.wrap(pins, pos, PIN_SIZE);\n        bb.position(pos + 4);\n        long off = bb.getLong();\n        int len = bb.getInt();\n        int crc = bb.getInt();\n        byte[] id = new byte[16];\n        bb.get(id);\n        if (off < 0 || (off % ALIGN) != 0 || len < 0) return null;\n        long rec = 4L + len;\n        long padded = rec + ((ALIGN - (rec % ALIGN)) % ALIGN);\n        if (off > blob.length || padded > blob.length - off || off > Integer.MAX_VALUE) return null;\n        int at = (int) off;\n        if (ByteBuffer.wrap(blob, at, 4).getInt() != len) return null;\n        byte[] payload = Arrays.copyOfRange(blob, at + 4, at + 4 + len);\n        if (payload.length > 0 && allZero(payload)) return null;\n        if (Crc.of(payload) != crc) return null;\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\n        if (!Arrays.equals(id, Arrays.copyOf(digest, 16))) return null;\n        Record r = new Record();\n        r.id = id;\n        r.payload = payload;\n        return r;\n    }\n\n    private static b"]
[82.934689, "i", "oolean allZero(byte[] a) {\n        for (byte b : a) if (b != 0) return false;\n        return true;\n    }\n}\nEOF\n"]
