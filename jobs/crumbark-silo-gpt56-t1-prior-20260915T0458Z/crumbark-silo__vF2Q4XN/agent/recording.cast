[82.965778, "o", "\u001b[?2004h>             if (r != null && Arrays.equals(r.id, wanted)) return r.payload;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         return null;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     private static byte[] read(Path p) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.966785, "o", "        return Files.exists(p) ? Files.readAllBytes(p) : new byte[0];\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     private static Record parse(byte[] pins, int pos, byte[] blob) throws Exception {\r\n\u001b[?2004l\r\u001b[?2004h>         if (pins[pos] != 'P' || pins[pos + 1] != 'N' ||\r\n\u001b[?2004l\r\u001b[?2004h>                 pins[pos + 2] != '0' || pins[pos + 3] != '1') return null;\r\n\u001b[?2004l\r\u001b[?2004h>         ByteBuffer bb = ByteBuffer.wrap(pins, pos, PIN_SIZE);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.96691, "o", "        bb.position(pos + 4);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.967029, "o", "        long off = bb.getLong();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.967092, "o", "        int len = bb.getInt();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.967238, "o", "        int crc = bb.getInt();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.967358, "o", "        byte[] id = new byte[16];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.967414, "o", "        bb.get(id);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.967553, "o", "        if (off < 0 || (off % ALIGN) != 0 || len < 0) return null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.967706, "o", "        long rec = 4L + len;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.967813, "o", "        long padded = rec + ((ALIGN - (rec % ALIGN)) % ALIGN);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.968073, "o", "        if (off > blob.length || padded > blob.length - off || off > Integer.MAX_VALUE) return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.968179, "o", ">         int at = (int) off;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.96836, "o", "        if (ByteBuffer.wrap(blob, at, 4).getInt() != len) return null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.968459, "o", "> "]
[82.968599, "o", "        byte[] payload = Arrays.copyOfRange(blob, at + 4, at + 4 + len);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.968756, "o", "        if (payload.length > 0 && allZero(payload)) return null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.968905, "o", "        if (Crc.of(payload) != crc) return null;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[82.969138, "o", "        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\r\n\u001b[?2004l\r"]
[82.9698, "o", "\u001b[?2004h>         if (!Arrays.equals(id, Arrays.copyOf(digest, 16))) return null;\r\n\u001b[?2004l\r\u001b[?2004h>         Record r = new Record();\r\n\u001b[?2004l\r\u001b[?2004h>         r.id = id;\r\n\u001b[?2004l\r\u001b[?2004h>         r.payload = payload;\r\n\u001b[?2004l\r\u001b[?2004h>         return r;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
