[31.194608, "o", "    14\t            byte[] mag = new byte[4];\r\n    15\t            bb.get(mag);\r\n    16\t            long off = bb.getLong();\r\n    17\t            int len = bb.getInt();\r\n    18\t            int crc = bb.getInt();\r\n    19\t            byte[] id = new byte[16];\r\n    20\t            bb.get(id);\r\n    21\t            held.add(hex(id));\r\n    22\t            i += 48;\r\n    23\t        }\r\n"]
[31.194729, "o", "    24\t        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"ok\\\",\\\"kind\\\":\\\"live\\\"}\";\r\n    25\t        Files.writeString(c, json);\r\n"]
[31.195049, "o", "    26\t        return 0;\r\n    27\t    }\r\n"]
