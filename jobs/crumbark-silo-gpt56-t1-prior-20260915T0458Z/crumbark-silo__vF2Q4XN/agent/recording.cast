[85.770251, "o", "set +e; /app/bin/crumbark wake; echo \"wake_rc=$?\"; cat /app/silo/wake.json; echo\r\n\u001b[?2004l\r"]
[85.880821, "o", "wake_rc=0\r\n"]
[85.881939, "o", "{\"held\":[\"7131d883b9a11835fa6ed471b7f1c1b4\",\"f3c1bcfb3c2f1490f89470a03c83b152\"],\"note\":\"ok\",\"kind\":\"live\"}"]
[85.882206, "o", "\r\n"]
[85.882249, "o", "\u001b[?2004hroot@92a4cb3e46ef:/app# "]
[85.882949, "o", "for f in /app/inbox/prior.slip /app/inbox/seed.slip; do id=$(sha256sum \"$f\"|cut -c1-32); /app/bin/crumbark pull \"$id\" >/tmp/got; r=$?; cmp -s \"$f\" /tmp/got; echo \"$(basename \"$f\") pull=$r cmp=$? bytes=$(wc -c </tmp/got)\"; done\r\n\u001b[?2004l\r"]
[85.985564, "o", "prior.slip pull=0 cmp=0 bytes=23\r\n"]
[86.084202, "o", "seed.slip pull=0 cmp=0 bytes=22\r\n"]
[86.084591, "o", "\u001b[?2004hroot@92a4cb3e46ef:/app# set -e\r\n\u001b[?2004l\r\u001b[?2004hroot@92a4cb3e46ef:/app# "]
[114.157658, "i", "set -e\nrm -rf /tmp/silo-save; cp -a /app/silo /tmp/silo-save\nfor f in /app/inbox/oak-*.slip; do /app/bin/crumbark lade \"$f\"; done\n/app/bin/crumbark wake\npython3 - <<'PY'\nimport json,hashlib,glob,subprocess\ncard=json.load(open('/app/silo/wake.json'))\nassert card['kind']=='live' and card['note']=='ok'\nheld=set(card['held'])\nfor f in glob.glob('/app/inbox/*.slip'):\n    body=open(f,'rb').read(); ident=hashlib.sha256(body).hexdigest()[:32]\n    assert ident in held, (f,ident)\n    got=subprocess.check_output(['/app/bin/crumbark','pull',ident])\n    assert got==body, f\nprint('lade/wake/pull OK:',len(held),'ids')\nPY\n"]
