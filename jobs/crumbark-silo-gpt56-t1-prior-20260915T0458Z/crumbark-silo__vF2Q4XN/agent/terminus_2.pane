--- /app/recipit/LoomCue.java ---
     1	import java.nio.file.Files;
     2	import java.nio.file.Path;
     3	import java.nio.file.Paths;
     4	import java.util.ArrayList;
     5	import java.util.Comparator;
     6	import java.util.List;
     7	
     8	public class LoomCue {
     9	    static final class Step {
    10	        String name;
    11	        int compute;
    12	        int durable;
    13	    }
    14	
    15	    public static List<String> rib_q(Path a) throws Exception {
    16	        List<Step> steps = new ArrayList<Step>();
    17	        for (String line : Files.readAllLines(a)) {
    18	            String s = line.trim();
    19	            if (s.isEmpty() || s.startsWith("#")) {
    20	                continue;
    21	            }
    22	            String[] p = s.split("\\s+");
    23	            if (p.length < 3) {
    24	                continue;
    25	            }
    26	            Step st = new Step();
    27	            st.name = p[0];
    28	            st.compute = Integer.parseInt(p[1]);
    29	            st.durable = Integer.parseInt(p[2]);
    30	            steps.add(st);
    31	        }
    32	        steps.sort(Comparator.comparingInt(x -> x.compute));
    33	        List<String> names = new ArrayList<String>();
    34	        for (Step st : steps) {
    35	            names.add(st.name);
    36	        }
    37	        return names;
    38	    }
    39	
    40	    public static void main(String[] args) throws Exception {
    41	        Path recipe = Paths.get("/app/recipit/steps.loom");
    42	        List<String> names = rib_q(recipe);
    43	        StringBuilder sb = new StringBuilder();
    44	        sb.append("public class ForceSeq {\n");
    45	        sb.append("    public static String[] names() {\n");
    46	        sb.append("        return new String[] {");
    47	        for (int i = 0; i < names.size(); i++) {
    48	            if (i > 0) {
    49	                sb.append(", ");
    50	            }
    51	            sb.append("\"");
    52	            sb.append(names.get(i));
    53	            sb.append("\"");
    54	        }
    55	        sb.append("};\n");
    56	        sb.append("    }\n");
    57	        sb.append("}\n");
    58	        Files.writeString(Paths.get("/app/recipit/ForceSeq.java"), sb.toString());
    59	    }
    60	}

