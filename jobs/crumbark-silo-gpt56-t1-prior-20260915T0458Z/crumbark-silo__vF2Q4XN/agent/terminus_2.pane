     1	public class DeskMain {
     2	    public static void main(String[] args) throws Exception {
     3	        if (args.length < 1) {
     4	            System.exit(2);
     5	        }
     6	        String verb = args[0];
     7	        String[] rest = new String[Math.max(0, args.length - 1)];
     8	        if (args.length > 1) {
     9	            System.arraycopy(args, 1, rest, 0, rest.length);
    10	        }
    11	        if ("lade".equals(verb)) {
    12	            StowRun.main(rest);
    13	        } else if ("wake".equals(verb)) {
    14	            StirRun.main(rest);
    15	        } else if ("pull".equals(verb)) {
    16	            YankRun.main(rest);
    17	        } else if ("nick".equals(verb)) {
    18	            CutRun.main(rest);
    19	        } else {
    20	            System.exit(2);
    21	        }
