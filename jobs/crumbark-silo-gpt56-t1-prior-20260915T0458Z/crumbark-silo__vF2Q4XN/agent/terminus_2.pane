    23	}

--- /app/hitchbay/RibChan.java ---
     1	import java.io.ByteArrayOutputStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.StandardOpenOption;
     5	
     6	public class RibChan {
     7	    final Path file;
     8	    final ByteArrayOutputStream pending = new ByteArrayOutputStream();
     9	
    10	    RibChan(Path file) {
    11	        this.file = file;
    12	    }
    13	
    14	    void append(byte[] x) throws Exception {
    15	        pending.write(x);
    16	    }
    17	
    18	    void force() throws Exception {
    19	        byte[] out = pending.toByteArray();
    20	        if (out.length == 0) {
    21	            return;
    22	        }
    23	        Files.write(file, out, StandardOpenOption.CREATE, StandardOpenOption.APPEND);
    24	        pending.reset();
    25	    }
    26	}

