--- /app/markwell/HueWalk.java ---
     1	import java.nio.ByteBuffer;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.util.ArrayList;
     5	import java.util.List;
     6	
     7	public class HueWalk {
     8	    public static int orb_n(Path a, Path b, Path c) throws Exception {
     9	        byte[] pins = Files.exists(b) ? Files.readAllBytes(b) : new byte[0];
    10	        List<String> held = new ArrayList<String>();
    11	        int i = 0;
    12	        while (i + 48 <= pins.length) {
    13	            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);
    14	            byte[] mag = new byte[4];
    15	            bb.get(mag);
    16	            long off = bb.getLong();
    17	            int len = bb.getInt();
    18	            int crc = bb.getInt();
    19	            byte[] id = new byte[16];
    20	            bb.get(id);
    21	            held.add(hex(id));
    22	            i += 48;
    23	        }
    24	        String json = "{\"held\":" + arr(held) + ",\"note\":\"ok\",\"kind\":\"live\"}";
    25	        Files.writeString(c, json);
    26	        return 0;
    27	    }
    28	
    29	    static String hex(byte[] id) {
    30	        StringBuilder sb = new StringBuilder();
    31	        for (byte v : id) {
    32	            sb.append(String.format("%02x", v & 0xff));
    33	        }
    34	        return sb.toString();
    35	    }
    36	
    37	    static String arr(List<String> held) {
    38	        StringBuilder sb = new StringBuilder("[");
    39	        for (int i = 0; i < held.size(); i++) {
    40	            if (i > 0) {
    41	                sb.append(",");
    42	            }
    43	            sb.append("\"");
    44	            sb.append(held.get(i));
    45	            sb.append("\"");
    46	        }
    47	        sb.append("]");
    48	        return sb.toString();
    49	    }
    50	
    51	    public static void main(String[] args) throws Exception {
    52	        Path silo = Path.of("/app/silo");
    53	        int rc = orb_n(silo.resolve("blob.bin"), silo.resolve("pin.bin"), silo.resolve("wake.json"));
    54	        System.exit(rc);
    55	    }
    56	}

--- /app/siltpage/MistSpan.java ---
     1	import java.nio.ByteBuffer;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	
     5	public class MistSpan {
     6	    static final int ALIGN = 32;
     7	
     8	    public static byte[] tint_k(Path a, byte[] b) throws Exception {
     9	        byte[] pins = Files.exists(a.resolve("pin.bin")) ? Files.readAllBytes(a.resolve("pin.bin")) : new byte[0];
    10	        byte[] blob = Files.exists(a.resolve("blob.bin")) ? Files.readAllBytes(a.resolve("blob.bin")) : new byte[0];
    11	        int i = 0;
    12	        while (i + 48 <= pins.length) {
    13	            ByteBuffer bb = ByteBuffer.wrap(pins, i, 48);
    14	            byte[] mag = new byte[4];
    15	            bb.get(mag);
    16	            long off = bb.getLong();
    17	            int len = bb.getInt();
    18	            bb.getInt();
    19	            byte[] id = new byte[16];
    20	            bb.get(id);
    21	            if (same(id, b)) {
    22	                int rec = 4 + len;
    23	                int pad = (ALIGN - (rec % ALIGN)) % ALIGN;
    24	                int take = rec + pad;
    25	                if (blob.length < off + take) {
    26	                    byte[] z = new byte[take];
    27	                    int have = Math.max(0, blob.length - (int) off);
    28	                    if (have > 0) {
    29	                        System.arraycopy(blob, (int) off, z, 0, Math.min(have, take));
    30	                    }
    31	                    return z;
    32	                }
    33	                byte[] out = new byte[take];
    34	                System.arraycopy(blob, (int) off, out, 0, take);
    35	                return out;
    36	            }
    37	            i += 48;
    38	        }
    39	        return new byte[0];
    40	    }
    41	
    42	    static boolean same(byte[] x, byte[] y) {
    43	        if (x.length != y.length) {
    44	            return false;
    45	        }
    46	        for (int i = 0; i < x.length; i++) {
    47	            if (x[i] != y[i]) {
    48	                return false;
    49	            }
    50	        }
    51	        return true;
    52	    }
    53	}

