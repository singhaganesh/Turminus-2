[212.995543, "i", "python3 - <<'PY'\np='/app/spout.py'\ns=open(p).read()\ns=s.replace(\"def __init__(self, ident: int, x: float, y: float, area: float, frame_no: int):\", \"def __init__(self, ident: int, x: float, y: float, area: float, color, frame_no: int):\")\ns=s.replace(\"self.area = float(area)\\n        self.last\", \"self.area = float(area)\\n        self.color = np.asarray(color, np.float32)\\n        self.last\")\ns=s.replace(\"def update(self, x: float, y: float, area: float, frame_no: int):\", \"def update(self, x: float, y: float, area: float, color, frame_no: int):\")\ns=s.replace(\"self.area = .75 * self.area + .25 * area\\n        self.hits\", \"self.area = .75 * self.area + .25 * area\\n        self.color = .8 * self.color + .2 * np.asarray(color, np.float32)\\n        self.hits\")\ns=s.replace(\"def _detections(mask: np.ndarray):\", \"def _detections(mask: np.ndarray, frame: np.ndarray):\")\ns=s.replace(\"out.append({'x': float(cents[j, 0]), 'y': float(cents[j, 1]),\\n                    'area': float(a),\", \"pix = frame[labels == j]\\n        color = np.median(pix, axis=0) if len(pix) else np.zeros(3)\\n        out.append({'x': float(cents[j, 0]), 'y': float(cents[j, 1]),\\n                    'area': float(a), 'color': color,\")\ns=s.replace(\"dets = _detections(mask)\", \"dets = _detections(mask, frames[fi])\")\ns=s.replace(\"active = [t for t in tracks if t.missed <= 12]\", \"active = [t for t in tracks if t.missed <= 30]\")\ns=s.replace(\"        pairs = []\\n        for ti, t in enumerate(active):\", \"        # A blob enclosing two predictions is an occlusion, not a new body or\\n        # a reliable observation of either centroid. Let both tracks coast.\\n        merged = set()\\n        for di, d in enumerate(dets):\\n            x, y, w, h = d['box']\\n            inside = [t for t in active if x-5 <= t.predict(fi)[0] <= x+w+5 and\\n                      y-5 <= t.predict(fi)[1] <= y+h+5 and d['area'] > 1.25*t.area]\\n            if len(inside) >= 2:\\n                merged.add(di)\\n        pairs = []\\n        for ti, t in enumerate(active):\")\ns=s.replace(\"            for di, d in enumerate(dets):\\n                dx, dy\", \"            for di, d in enumerate(dets):\\n                if di in merged:\\n                    continue\\n                dx, dy\")\ns=s.replace(\"t.update(d['x'], d['y'], d['area'], fi)\", \"t.update(d['x'], d['y'], d['area'], d['color'], fi)\")\ns=s.replace(\"        for di, d in enumerate(dets):\\n            if di in used_d:\\n                continue\", \"        for di, d in enumerate(dets):\\n            if di in used_d or di in merged:\\n                continue\")\nold=\"\"\"            if not occupied:\n                tracks.append(Track(next_id, d['x'], d['y'], d['area'], fi))\n                next_id += 1\"\"\"\nnew=\"\"\"            if not occupied:\n                # Reappearance after leaving the picture: revive a visually\n                # matching old identity, preserving its one-count-only flag.\n                candidates = []\n                for t in tracks:\n                    if t in active:\n                        continue\n                    ratio = max(d['area']/max(t.area,1), t.area/max(d['area'],1))\n                    cd = float(np.linalg.norm(np.asarray(d['color'])-t.color))\n                    if ratio < 1.7 and cd < 28:\n                        candidates.append((cd + 8*abs(np.log(ratio)), t))\n                if candidates:\n                    t = min(candidates, key=lambda z:z[0])[1]\n                    t.p = np.array([d['x'], d['y']], np.float32)\n                    t.v[:] = 0\n                    t.area = d['area']; t.color = np.asarray(d['color'], np.float32)\n                    t.last = fi; t.missed = 0; t.hits += 1\n                    if d['y'] < LINE_Y-2: t.seen_above = True\n                else:\n                    tracks.append(Track(next_id, d['x'], d['y'], d['area'], d['color'], fi))\n                    next_id += 1\"\"\"\nif old not in s: raise SystemExit('birth block not found')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/spout.py /app/spanwell.py\n/app/kiln/bake.sh\npython3 /tmp/testmill.py\nrm -f /app/inkwell/sheet.to"]
[212.995729, "i", "ml\npython3 /app/varnish/mill.pyc /app/shown.mp4; echo sample_rc=$?; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; echo bad_rc=$?; test ! -e /app/inkwell/sheet.toml && echo no_sheet_ok\n"]
