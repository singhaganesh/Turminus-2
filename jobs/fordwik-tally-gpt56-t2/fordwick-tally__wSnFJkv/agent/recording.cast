[36.280982, "o", "printf '%s\\n' '--- bake.sh ---'; cat /app/kiln/bake.sh; printf '%s\\n' '--- millcard ---'; cat /app/hopcard/millcard.txt; printf '%s\\n' '--- shiftlog ---'; cat /app/wickpit/shiftlog.txt\r\n\u001b[?2004l\r"]
[36.281093, "o", "--- bake.sh ---\r\n"]
[36.282187, "o", "#!/usr/bin/env bash\r\nset -euo pipefail\r\npython3 /app/kiln/pack.py\r\n"]
[36.282633, "o", "--- millcard ---\r\n"]
[36.283457, "o", "Desk leftover. Sample reel lives at /app/shown.mp4.\r\n"]
[36.283734, "o", "--- shiftlog ---\r\n"]
[36.284681, "o", "Night desk: occupancy helper still green on the worked sample.\r\nDo not treat that as the whole mill.\r\n"]
[36.284899, "o", "\u001b[?2004h"]
[36.284972, "o", "root@484743011fe5:/app# "]
[36.410006, "i", "python3 - <<'PY'\nimport cv2, numpy as np\np='/app/shown.mp4'; c=cv2.VideoCapture(p)\nprint('opened',c.isOpened(),'frames',int(c.get(cv2.CAP_PROP_FRAME_COUNT)),'fps',c.get(cv2.CAP_PROP_FPS),'size',int(c.get(3)),int(c.get(4)))\nframes=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n frames.append(f)\nc.release()\nprint('decoded',len(frames))\nfor i in np.linspace(0,len(frames)-1,min(16,len(frames)),dtype=int):\n f=frames[i]; print(i, 'mean',np.round(f.mean((0,1)),1), 'range',f.min(),f.max())\n# Difference from temporal median; print meaningful components by sampled frame.\nbg=np.median(np.stack(frames),axis=0).astype(np.uint8)\ncv2.imwrite('/tmp/background.png',bg)\nfor i,f in enumerate(frames):\n d=cv2.cvtColor(cv2.absdiff(f,bg),cv2.COLOR_BGR2GRAY)\n m=(d>20).astype('uint8')*255\n m=cv2.morphologyEx(m,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))\n n,lab,st,cent=cv2.connectedComponentsWithStats(m)\n cc=[(int(st[j,4]),tuple(np.round(cent[j],1))) for j in range(1,n) if st[j,4]>=20]\n if i%12==0: print('f',i,'components',sorted(cc,reverse=True)[:10])\nPY\n"]
