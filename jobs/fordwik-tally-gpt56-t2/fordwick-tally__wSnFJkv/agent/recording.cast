[256.855246, "o", "                    ratio = max(d['area']/max(t.area,1), t.area/max(d['area'],1))\r\n\u001b[?2004l\r"]
[256.857675, "o", "\u001b[?2004h>                     cd = float(np.linalg.norm(np.asarray(d['color'])-t.color))\r\n\u001b[?2004l\r\u001b[?2004h>                     if ratio < 1.7 and cd < 28:\r\n\u001b[?2004l\r\u001b[?2004h>                         candidates.append((cd + 8*abs(np.log(ratio)), t))\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> new=\"\"\"                for t in tracks:\r\n\u001b[?2004l\r\u001b[?2004h>                     # Inactive identities, and crossed identities coasting for\r\n\u001b[?2004l\r\u001b[?2004h>                     # several blank frames, are eligible for re-entry matching.\r\n\u001b[?2004l\r\u001b[?2004h>                     eligible = t not in active or (t.crossed and t.missed > 5)\r\n\u001b[?2004l\r\u001b[?2004h>                     if not eligible:\r\n\u001b[?2004l\r\u001b[?2004h>                         continue\r\n\u001b[?2004l\r\u001b[?2004h>                     ratio = max(d['area']/max(t.area,1), t.area/max(d['area'],1))\r\n\u001b[?2004l\r\u001b[?2004h>                     cd = float(np.linalg.norm(np.asarray(d['color'])-t.color))\r\n\u001b[?2004l\r"]
[256.858055, "o", "\u001b[?2004h>                     dx = abs(float(d['x']) - float(t.p[0]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[256.858383, "o", "> "]
[256.858491, "o", "                    if ratio < 1.7 and cd < 28 and dx < 24:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.859203, "o", "                        candidates.append((cd + 8*abs(np.log(ratio)) + .2*dx, t))\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s: raise SystemExit('reid block not found')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[256.859369, "o", "open(p,'w').write(s.replace(old,new))\r\n\u001b[?2004l\r\u001b[?2004h> "]
