[102.382214, "o", "\u001b[?2004h"]
[102.382266, "o", "> "]
[102.38239, "o", "                # Large components may be merged bodies; permit their centroid\r\n\u001b[?2004l\r"]
[102.382417, "o", "\u001b[?2004h> "]
[102.382634, "o", "                # to be less informative but don't consume several tracks with it.\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.382722, "o", "> "]
[102.382836, "o", "                gate = 13.0 + min(16.0, max(0.0, d['area']/max(t.area,1)-1)*8)\r\n\u001b[?2004l\r"]
[102.382913, "o", "\u001b[?2004h> "]
[102.383006, "o", "                if dist <= gate and ratio < 5.0:\r\n\u001b[?2004l\r"]
[102.383064, "o", "\u001b[?2004h> "]
[102.383237, "o", "                    pairs.append((dist + 2.0*abs(np.log(ratio)), ti, di))\r\n\u001b[?2004l\r"]
[102.38331, "o", "\u001b[?2004h> "]
[102.383395, "o", "        used_t, used_d = set(), set()\r\n\u001b[?2004l\r"]
[102.383464, "o", "\u001b[?2004h> "]
[102.383559, "o", "        for _, ti, di in sorted(pairs):\r\n\u001b[?2004l\r"]
[102.383631, "o", "\u001b[?2004h> "]
[102.383722, "o", "            if ti in used_t or di in used_d:\r\n\u001b[?2004l\r"]
[102.383788, "o", "\u001b[?2004h> "]
[102.383886, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.383958, "o", "> "]
[102.384039, "o", "            t, d = active[ti], dets[di]\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.384058, "o", "> "]
[102.384211, "o", "            t.update(d['x'], d['y'], d['area'], fi)\r\n\u001b[?2004l\r"]
[102.384288, "o", "\u001b[?2004h"]
[102.384346, "o", "> "]
[102.384411, "o", "            used_t.add(ti); used_d.add(di)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.384543, "o", "        for ti, t in enumerate(active):\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.384621, "o", "> "]
[102.384691, "o", "            if ti not in used_t:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.38478, "o", "                t.missed += 1\r\n\u001b[?2004l\r"]
[102.384872, "o", "\u001b[?2004h> "]
[102.385062, "o", "                # Coast through occlusion, preserving velocity and identity.\r\n\u001b[?2004l\r"]
[102.385163, "o", "\u001b[?2004h"]
[102.385194, "o", "> "]
[102.385316, "o", "                t.p = t.predict(fi)\r\n\u001b[?2004l\r\u001b[?2004h>                 t.last = fi\r\n"]
[102.385342, "o", "\u001b[?2004l\r\u001b[?2004h"]
[102.385362, "o", "> "]
[102.38567, "o", "        # Suppress births inside a merged component containing predictions of\r\n\u001b[?2004l\r"]
[102.385839, "o", "\u001b[?2004h> "]
[102.386067, "o", "        # old tracks. Otherwise uncovered bodies are legitimate new tracks.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.386267, "o", "        for di, d in enumerate(dets):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.386309, "o", "            if di in used_d:\r\n\u001b[?2004l\r"]
[102.386673, "o", "\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             x, y, w, h = d['box']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.38678, "o", "            occupied = any(x-3 <= t.predict(fi)[0] <= x+w+3 and\r\n\u001b[?2004l\r"]
[102.386895, "o", "\u001b[?2004h> "]
[102.387034, "o", "                           y-3 <= t.predict(fi)[1] <= y+h+3 for t in active)\r\n\u001b[?2004l\r"]
[102.387117, "o", "\u001b[?2004h> "]
[102.387188, "o", "            if not occupied:\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.387245, "o", "> "]
[102.387407, "o", "                tracks.append(Track(next_id, d['x'], d['y'], d['area'], fi))\r\n\u001b[?2004l\r"]
[102.387548, "o", "\u001b[?2004h> "]
[102.387636, "o", "                next_id += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.387769, "o", "    return sum(t.crossed and t.hits >= 2 for t in tracks)\r\n\u001b[?2004l\r"]
[102.387857, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.38792, "o", "> "]
[102.387987, "o", "def emit_span(src: str) -> int:\r\n\u001b[?2004l\r"]
[102.388045, "o", "\u001b[?2004h> "]
[102.388133, "o", "    cap = cv2.VideoCapture(src)\r\n\u001b[?2004l\r"]
[102.388192, "o", "\u001b[?2004h> "]
[102.38826, "o", "    if not cap.isOpened():\r\n\u001b[?2004l\r"]
[102.388329, "o", "\u001b[?2004h> "]
[102.388392, "o", "        cap.release()\r\n\u001b[?2004l\r"]
[102.388458, "o", "\u001b[?2004h> "]
[102.388581, "o", "        raise OSError('cannot open clip')\r\n\u001b[?2004l\r"]
[102.388691, "o", "\u001b[?2004h"]
[102.388758, "o", ">     frames = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.388782, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.388882, "o", "        ok, frame = cap.read()\r\n\u001b[?2004l\r"]
[102.388901, "o", "\u001b[?2004h> "]
[102.38899, "o", "        if not ok:\r\n\u001b[?2004l\r"]
[102.389063, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r"]
[102.38913, "o", "\u001b[?2004h> "]
[102.389253, "o", "        if frame is None or frame.shape[:2] != (120, 160):\r\n\u001b[?2004l\r"]
[102.389331, "o", "\u001b[?2004h> "]
[102.389408, "o", "            cap.release()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.38955, "o", "            raise ValueError('invalid frame')\r\n\u001b[?2004l\r"]
[102.389609, "o", "\u001b[?2004h> "]
[102.389672, "o", "        frames.append(frame)\r\n\u001b[?2004l\r"]
[102.38973, "o", "\u001b[?2004h> "]
[102.389786, "o", "    cap.release()\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.389842, "o", "> "]
[102.3899, "o", "    if not frames:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.390036, "o", "        raise ValueError('empty or unreadable clip')\r\n\u001b[?2004l\r"]
[102.3901, "o", "\u001b[?2004h"]
[102.390207, "o", ">     return _count(frames)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[102.390239, "o", "> \r\n\u001b[?2004l\r"]
[102.390288, "o", "\u001b[?2004h> "]
[102.390444, "o", "def dump_sheet(n: int) -> None:\r\n\u001b[?2004l\r"]
[102.390536, "o", "\u001b[?2004h> "]
[102.390646, "o", "    SHEET.parent.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r"]
[102.39072, "o", "\u001b[?2004h> "]
[102.391378, "o", "    tmp = SHEET.with_suffix('.tmp')\r\n\u001b[?2004l\r\u001b[?2004h>     tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\r\n\u001b[?2004l\r\u001b[?2004h>     tmp.replace(SHEET)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[102.392726, "o", "\u001b[?2004hroot@484743011fe5:/app# "]
[102.392832, "o", "\r\n\u001b[?2004l\r"]
[102.392905, "o", "\u001b[?2004hroot@484743011fe5:/app# cat > /app/spanwell.py <<'PY'\r\n\u001b[?2004l\r"]
[102.39297, "o", "\u001b[?2004h> "]
[102.393033, "o", "#!/usr/bin/env python3\r\n\u001b[?2004l\r"]
[102.393102, "o", "\u001b[?2004h"]
[102.393164, "o", "> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.393232, "o", "> import sys\r\n\u001b[?2004l\r"]
[102.393305, "o", "\u001b[?2004h> "]
[102.393381, "o", "from spout import SHEET, dump_sheet, emit_span\r\n\u001b[?2004l\r"]
[102.393436, "o", "\u001b[?2004h"]
[102.393499, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.393566, "o", "\u001b[?2004h> def main() -> int:\r\n"]
[102.39364, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[102.393705, "o", "    if len(sys.argv) != 2:\r\n\u001b[?2004l\r"]
[102.393769, "o", "\u001b[?2004h> "]
[102.393834, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[102.393913, "o", "\u001b[?2004h"]
[102.39398, "o", ">         return 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.394043, "o", "> "]
[102.394105, "o", "    SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.394165, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.394225, "o", "> "]
[102.394285, "o", "        n = emit_span(sys.argv[1])\r\n\u001b[?2004l\r"]
[102.394344, "o", "\u001b[?2004h> "]
[102.394403, "o", "        dump_sheet(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.394463, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.394547, "o", "    except Exception as exc:\r\n\u001b[?2004l\r"]
[102.394603, "o", "\u001b[?2004h> "]
[102.394699, "o", "        print('mill:', exc, file=sys.stderr)\r\n\u001b[?2004l\r"]
[102.394747, "o", "\u001b[?2004h> "]
[102.394854, "o", "        SHEET.unlink(missing_ok=True)\r\n\u001b[?2004l\r"]
[102.394911, "o", "\u001b[?2004h> "]
[102.394973, "o", "        return 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.395038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[102.395478, "o", "\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[102.396557, "o", "\u001b[?2004hroot@484743011fe5:/app# \r\n"]
[102.396671, "o", "\u001b[?2004l\r\u001b[?2004hroot@484743011fe5:/app# "]
[102.39676, "o", "/app/kiln/bake.sh\r\n\u001b[?2004l\r"]
[102.456293, "o", "\u001b[?2004hroot@484743011fe5:/app# "]
[102.456488, "o", "rm -f /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[102.458944, "o", "\u001b[?2004hroot@484743011fe5:/app# "]
[102.459194, "o", "python3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo rc=$rc; cat /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[103.056117, "o", "rc=0\r\n"]
[103.060597, "o", "crossings = 3\r\n"]
[103.060653, "o", "\u001b[?2004hroot@484743011fe5:/app# rm -f /app/inkwell/sheet.toml\r\n\u001b[?2004l\r"]
[103.061663, "o", "\u001b[?2004hroot@484743011fe5:/app# python3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo bad_rc=$rc; test ! -e /app/inkwell/sheet.toml && echo no_sheet_ok\r\n\u001b[?2004l\r"]
[103.35644, "o", "mill: cannot open clip\r\n"]
[103.390187, "o", "bad_rc=1\r\nno_sheet_ok\r\n"]
[103.390256, "o", "\u001b[?2004hroot@484743011fe5:/app# "]
[152.622403, "i", "cat > /tmp/testmill.py <<'PY'\nimport cv2, numpy as np, subprocess, toml, os\nW,H=160,120\nbg=np.zeros((H,W,3),np.uint8); bg[:]=(53,46,43)\n\ndef path(a,b,n):\n return [a+(b-a)*i/max(1,n-1) for i in range(n)]\ndef write(name, motions, n=72):\n out=cv2.VideoWriter('/tmp/'+name+'.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\n for i in range(n):\n  f=bg.copy()\n  for x,ys,col,r,span in motions:\n   lo,hi=span\n   if lo<=i<hi:\n    y=ys[i-lo] if isinstance(ys,list) else ys\n    cv2.circle(f,(int(x),int(y)),r,col,-1,cv2.LINE_AA)\n  out.write(f)\n out.release()\n\ntests={}\n# one down and one up\na=path(20,105,45)\nwrite('one_down',[(50,a,(20,40,220),10,(5,50))]); tests['one_down']=1\nu=path(105,20,45)\nwrite('up_only',[(50,u,(20,220,40),10,(5,50))]); tests['up_only']=0\n# down, linger around line, go up, then eventually down: one identity, one count\ny=path(25,69,18)+[69]*15+path(69,45,10)+path(45,105,20)\nwrite('linger_return',[(55,y,(220,50,30),9,(3,3+len(y)))],80); tests['linger_return']=1\n# four concurrent separated\nm=[]\nfor j,x in enumerate((25,60,100,135)):\n ys=path(15,108,50); m.append((x,ys,((30+45*j)%230,80+25*j,220-35*j),8,(5,55)))\nwrite('four_simul',m); tests['four_simul']=4\n# two diagonal paths intersect and overlap at the scan\nys=path(15,108,55)\nxs1=path(35,115,55); xs2=path(125,45,55)\nout=cv2.VideoWriter('/tmp/overlap.mp4',cv2.VideoWriter_fourcc(*'mp4v'),12,(W,H))\nfor i in range(70):\n f=bg.copy()\n if 5<=i<60:\n  k=i-5\n  cv2.circle(f,(int(xs1[k]),int(ys[k])),10,(30,30,220),-1)\n  cv2.circle(f,(int(xs2[k]),int(ys[k])),10,(220,180,30),-1)\n out.write(f)\nout.release(); tests['overlap']=2\n# same body crosses, disappears long enough, returns above and crosses again: still one\nys1=path(20,110,35); ys2=path(20,110,35)\nwrite('repeat_identity',[(45,ys1,(20,80,220),10,(3,38)),(45,ys2,(20,80,220),10,(55,90))],96); tests['repeat_identity']=1\nfor name,want in tests.items():\n p=subprocess.run(['python3','/app/varnish/mill.pyc','/tmp/'+name+'.mp4'])\n got=toml.load('/app/inkwell/sheet.toml')['crossings'] if p.returncode==0 else 'ERR'\n print(name,'want',want,'got',got, 'OK' if got==want else 'FAIL')\nPY\npython3 /tmp/testmill.py\n"]
[152.622624, "o", "cat > /tmp/testmill.py <<'PY'\r\n"]
