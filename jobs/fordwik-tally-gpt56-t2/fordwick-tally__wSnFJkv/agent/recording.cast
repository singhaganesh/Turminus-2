[37.438, "i", "python3 - <<'PY'\nimport cv2, numpy as np\nc=cv2.VideoCapture('/app/shown.mp4'); fs=[]\nwhile True:\n ok,f=c.read()\n if not ok: break\n fs.append(f)\nidx=np.linspace(0,len(fs)-1,24,dtype=int)\nthumb=[]\nfor i in idx:\n f=fs[i].copy(); cv2.line(f,(0,70),(159,70),(0,0,255),1); cv2.putText(f,str(i),(2,12),0,.35,(0,0,255),1); thumb.append(f)\nsheet=np.vstack([np.hstack(thumb[r:r+6]) for r in range(0,24,6)])\ncv2.imwrite('/tmp/contact.jpg',sheet)\nprint('/tmp/contact.jpg',sheet.shape)\nPY\n"]
