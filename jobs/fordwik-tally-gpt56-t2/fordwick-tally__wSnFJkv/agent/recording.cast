[152.630729, "o", "# same body crosses, disappears long enough, returns above and crosses again: still one\r\n\u001b[?2004l\r"]
[152.630848, "o", "\u001b[?2004h> "]
[152.630967, "o", "ys1=path(20,110,35); ys2=path(20,110,35)\r\n\u001b[?2004l\r"]
[152.631163, "o", "\u001b[?2004h> "]
[152.631498, "o", "write('repeat_identity',[(45,ys1,(20,80,220),10,(3,38)),(45,ys2,(20,80,220),10,(55,90))],96); tests['repeat_identity']=1\r\n\u001b[?2004l\r"]
[152.631687, "o", "\u001b[?2004h> "]
[152.631805, "o", "for name,want in tests.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.632069, "o", " p=subprocess.run(['python3','/app/varnish/mill.pyc','/tmp/'+name+'.mp4'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.632167, "o", "> "]
[152.632376, "o", " got=toml.load('/app/inkwell/sheet.toml')['crossings'] if p.returncode==0 else 'ERR'\r\n\u001b[?2004l\r"]
[152.633043, "o", "\u001b[?2004h>  print(name,'want',want,'got',got, 'OK' if got==want else 'FAIL')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
