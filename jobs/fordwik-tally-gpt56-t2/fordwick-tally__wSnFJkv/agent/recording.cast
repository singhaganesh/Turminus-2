[12.219826, "o", "/app/blot.py\r\n/app/hopcard/millcard.txt\r\n/app/kiln/KILN.txt\r\n/app/kiln/bake.sh\r\n/app/kiln/pack.py\r\n/app/shown.mp4\r\n/app/slipfold/SPAN.txt\r\n/app/spanwell.py\r\n/app/spout.py\r\n/app/tether.py\r\n/app/varnish/mill.pyc\r\n/app/varnish/packed.py\r\n/app/wickpit/__init__.py\r\n/app/wickpit/shiftlog.txt\r\n/app/wickpit/touchcue.py\r\n"]
