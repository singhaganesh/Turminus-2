[102.364371, "i", "cat > /app/spout.py <<'PY'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport cv2\nimport numpy as np\nimport toml\n\nSHEET = Path('/app/inkwell/sheet.toml')\nLINE_Y = 70.0\n\n\nclass Track:\n    def __init__(self, ident: int, x: float, y: float, area: float, frame_no: int):\n        self.ident = ident\n        self.p = np.array([x, y], np.float32)\n        self.v = np.zeros(2, np.float32)\n        self.area = float(area)\n        self.last = frame_no\n        self.hits = 1\n        self.missed = 0\n        self.seen_above = y < LINE_Y - 2\n        self.crossed = False\n        self.last_observed_y = float(y)\n\n    def predict(self, frame_no: int):\n        return self.p + self.v * max(1, frame_no - self.last)\n\n    def update(self, x: float, y: float, area: float, frame_no: int):\n        q = np.array([x, y], np.float32)\n        dt = max(1, frame_no - self.last)\n        nv = (q - self.p) / dt\n        if self.hits > 1:\n            self.v = .55 * self.v + .45 * nv\n        else:\n            self.v = nv\n        old_y = self.last_observed_y\n        self.p = q\n        self.last = frame_no\n        self.last_observed_y = float(y)\n        self.area = .75 * self.area + .25 * area\n        self.hits += 1\n        self.missed = 0\n        if y < LINE_Y - 2:\n            self.seen_above = True\n        # Require an actual downward trajectory, while allowing a skipped band.\n        if self.seen_above and not self.crossed and y > LINE_Y + 2 and self.v[1] > .15 and y > old_y:\n            self.crossed = True\n\n\ndef _foreground(frames: list[np.ndarray]) -> list[np.ndarray]:\n    stack = np.stack(frames)\n    # Recordings normally have clear ends.  Pixelwise median is robust when\n    # traffic is brief; endpoint median repairs pixels occupied for a long time.\n    n = len(frames)\n    k = max(1, min(6, n // 5))\n    med = np.median(stack, axis=0).astype(np.uint8)\n    ends = np.median(np.concatenate((stack[:k], stack[-k:])), axis=0).astype(np.uint8)\n    # Select, per pixel, the candidate with less temporal disagreement.\n    dm = np.median(np.max(np.abs(stack.astype(np.int16)-med.astype(np.int16)), axis=3), axis=0)\n    de = np.median(np.max(np.abs(stack.astype(np.int16)-ends.astype(np.int16)), axis=3), axis=0)\n    bg = med.copy()\n    use = de < dm\n    bg[use] = ends[use]\n\n    masks = []\n    ker = np.ones((3, 3), np.uint8)\n    for f in frames:\n        d = np.max(np.abs(f.astype(np.int16) - bg.astype(np.int16)), axis=2).astype(np.uint8)\n        # Compression noise is tiny in these station reels.\n        m = (d >= 18).astype(np.uint8) * 255\n        m = cv2.morphologyEx(m, cv2.MORPH_OPEN, ker)\n        m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, ker)\n        masks.append(m)\n    return masks\n\n\ndef _detections(mask: np.ndarray):\n    n, labels, stats, cents = cv2.connectedComponentsWithStats(mask, 8)\n    out = []\n    for j in range(1, n):\n        x, y, w, h, a = stats[j]\n        if a < 35 or w < 3 or h < 3:\n            continue\n        out.append({'x': float(cents[j, 0]), 'y': float(cents[j, 1]),\n                    'area': float(a), 'box': (x, y, w, h), 'label': j,\n                    'labels': labels})\n    return out\n\n\ndef _count(frames: list[np.ndarray]) -> int:\n    masks = _foreground(frames)\n    tracks: list[Track] = []\n    next_id = 0\n    for fi, mask in enumerate(masks):\n        dets = _detections(mask)\n        active = [t for t in tracks if t.missed <= 12]\n        pairs = []\n        for ti, t in enumerate(active):\n            pred = t.predict(fi)\n            for di, d in enumerate(dets):\n                dx, dy = d['x']-pred[0], d['y']-pred[1]\n                dist = float(np.hypot(dx, dy))\n                ratio = max(d['area']/max(t.area, 1), t.area/max(d['area'], 1))\n                # Large components may be merged bodies; permit their centroid\n                # to be less informative but don't consume several tracks with it.\n                gate = 13.0 + min(16.0, max(0.0, d['area']/max(t.area,1)-1)*8)\n                if dist <= gate and ratio < 5.0:\n                    pairs.append((dist + 2.0*abs(np.log(ratio)), ti, di))\n        used_t, used_d = set(), set"]
[102.364537, "i", "()\n        for _, ti, di in sorted(pairs):\n            if ti in used_t or di in used_d:\n                continue\n            t, d = active[ti], dets[di]\n            t.update(d['x'], d['y'], d['area'], fi)\n            used_t.add(ti); used_d.add(di)\n        for ti, t in enumerate(active):\n            if ti not in used_t:\n                t.missed += 1\n                # Coast through occlusion, preserving velocity and identity.\n                t.p = t.predict(fi)\n                t.last = fi\n        # Suppress births inside a merged component containing predictions of\n        # old tracks. Otherwise uncovered bodies are legitimate new tracks.\n        for di, d in enumerate(dets):\n            if di in used_d:\n                continue\n            x, y, w, h = d['box']\n            occupied = any(x-3 <= t.predict(fi)[0] <= x+w+3 and\n                           y-3 <= t.predict(fi)[1] <= y+h+3 for t in active)\n            if not occupied:\n                tracks.append(Track(next_id, d['x'], d['y'], d['area'], fi))\n                next_id += 1\n    return sum(t.crossed and t.hits >= 2 for t in tracks)\n\n\ndef emit_span(src: str) -> int:\n    cap = cv2.VideoCapture(src)\n    if not cap.isOpened():\n        cap.release()\n        raise OSError('cannot open clip')\n    frames = []\n    while True:\n        ok, frame = cap.read()\n        if not ok:\n            break\n        if frame is None or frame.shape[:2] != (120, 160):\n            cap.release()\n            raise ValueError('invalid frame')\n        frames.append(frame)\n    cap.release()\n    if not frames:\n        raise ValueError('empty or unreadable clip')\n    return _count(frames)\n\n\ndef dump_sheet(n: int) -> None:\n    SHEET.parent.mkdir(parents=True, exist_ok=True)\n    tmp = SHEET.with_suffix('.tmp')\n    tmp.write_text(toml.dumps({'crossings': int(n)}), encoding='utf-8')\n    tmp.replace(SHEET)\nPY\n\ncat > /app/spanwell.py <<'PY'\n#!/usr/bin/env python3\nfrom __future__ import annotations\nimport sys\nfrom spout import SHEET, dump_sheet, emit_span\n\n\ndef main() -> int:\n    if len(sys.argv) != 2:\n        SHEET.unlink(missing_ok=True)\n        return 2\n    SHEET.unlink(missing_ok=True)\n    try:\n        n = emit_span(sys.argv[1])\n        dump_sheet(n)\n        return 0\n    except Exception as exc:\n        print('mill:', exc, file=sys.stderr)\n        SHEET.unlink(missing_ok=True)\n        return 1\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nPY\n\n/app/kiln/bake.sh\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /app/shown.mp4; rc=$?; echo rc=$rc; cat /app/inkwell/sheet.toml\nrm -f /app/inkwell/sheet.toml\npython3 /app/varnish/mill.pyc /tmp/no-such-fordwick.mp4; rc=$?; echo bad_rc=$rc; test ! -e /app/inkwell/sheet.toml && echo no_sheet_ok\n"]
[102.36476, "o", "cat > /app/spout.py <<'PY'\r\n\u001b[?2004l\r"]
