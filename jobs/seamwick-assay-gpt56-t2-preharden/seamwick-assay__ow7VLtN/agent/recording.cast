[37.063781, "o", "for f in /app/purlbox/PurlBox.java /app/knitwell/ops/KnitBox.java /app/tintlag/core/TintBox.java /app/deskbin/gen/Cite.java /app/deskbin/gen/Sched.java /app/deskbin/gen/Seal.java; do echo \"===== $f =====\"; cat \"$f\"; done\r\n"]
[37.0643, "o", "\u001b[?2004l\r===== /app/purlbox/PurlBox.java =====\r\n"]
[37.065926, "o", "import java.io.*;\r\npublic class PurlBox {\r\n  public static void main(String[] a) throws Exception {\r\n    File d = new File(\"/app/deskbin/gen\");\r\n    d.mkdirs();\r\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Cite.java\")));\r\n    purl(w);\r\n    w.close();\r\n  }\r\n  public static void purl(PrintWriter a) throws Exception {\r\n    a.println(\"import java.util.*;\");\r\n    a.println(\"public class Cite {\");\r\n    a.println(\"  public static LinkedHashSet<String> tags(String body, Set<String> known) {\");\r\n    a.println(\"    LinkedHashSet<String> out = new LinkedHashSet<String>();\");\r\n    a.println(\"    String[] lines = body.split(\\\"\\\\n\\\");\");\r\n    a.println(\"    for (int i = 0; i < lines.length; i++) {\");\r\n    a.println(\"      String t = lines[i].trim();\");\r\n    a.println(\"      if (t.startsWith(\\\"import \\\")) {\");\r\n    a.println(\"        String r = t.substring(7).replace(\\\";\\\", \\\"\\\").trim();\");\r\n    a.println(\"        int d = r.lastIndexOf('.');\");\r\n    a.println(\"        String n = d < 0 ? r : r.substring(d + 1);\");\r\n    a.println(\"        if (known.contains(n)) out.add(n);\");\r\n    a.println(\"      }\");\r\n    a.println(\"    }\");\r\n    a.println(\"    return out;\");\r\n    a.println(\"  }\");\r\n    a.println(\"}\");\r\n  }\r\n}\r\n"]
[37.06654, "o", "===== /app/knitwell/ops/KnitBox.java =====\r\n"]
[37.067406, "o", "import java.io.*;\r\npublic class KnitBox {\r\n  public static void main(String[] a) throws Exception {\r\n    File d = new File(\"/app/deskbin/gen\");\r\n    d.mkdirs();\r\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Sched.java\")));\r\n    knit(w);\r\n    w.close();\r\n  }\r\n  public static void knit(PrintWriter a) throws Exception {\r\n    a.println(\"import java.util.*;\");\r\n    a.println(\"public class Sched {\");\r\n    a.println(\"  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\");\r\n    a.println(\"    LinkedHashSet<String> s = new LinkedHashSet<String>();\");\r\n    a.println(\"    s.addAll(changedFiles);\");\r\n    a.println(\"    for (String c : changedFiles) {\");\r\n    a.println(\"      Set<String> im = importers.get(c);\");\r\n    a.println(\"      if (im != null) s.addAll(im);\");\r\n    a.println(\"    }\");\r\n    a.println(\"    return new ArrayList<String>(s);\");\r\n    a.println(\"  }\");\r\n    a.println(\"}\");\r\n  }\r\n}\r\n"]
[37.06764, "o", "===== /app/tintlag/core/TintBox.java =====\r\n"]
[37.068556, "o", "import java.io.*;\r\npublic class TintBox {\r\n  public static void main(String[] a) throws Exception {\r\n    File d = new File(\"/app/deskbin/gen\");\r\n    d.mkdirs();\r\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Seal.java\")));\r\n    tint(w);\r\n    w.close();\r\n  }\r\n  public static void tint(PrintWriter a) throws Exception {\r\n    a.println(\"import java.util.*;\");\r\n    a.println(\"public class Seal {\");\r\n    a.println(\"  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\");\r\n    a.println(\"    LinkedHashSet<String> s = new LinkedHashSet<String>();\");\r\n    a.println(\"    s.addAll(hitUnits);\");\r\n    a.println(\"    return new ArrayList<String>(s);\");\r\n    a.println(\"  }\");\r\n    a.println(\"  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\");\r\n    a.println(\"    if (analysed.size() >= floor) return \\\"0\\\";\");\r\n    a.println(\"    if (hitUnits.isEmpty()) return \\\"0\\\";\");\r\n    a.println(\"    return \\\"1\\\";\");\r\n    a.println(\"  }\");\r\n    a.println(\"}\");\r\n  }\r\n}\r\n"]
[37.068777, "o", "===== /app/deskbin/gen/Cite.java =====\r\n"]
[37.069738, "o", "import java.util.*;\r\npublic class Cite {\r\n  public static LinkedHashSet<String> tags(String body, Set<String> known) {\r\n    LinkedHashSet<String> out = new LinkedHashSet<String>();\r\n    String[] lines = body.split(\"\\n\");\r\n    for (int i = 0; i < lines.length; i++) {\r\n      String t = lines[i].trim();\r\n      if (t.startsWith(\"import \")) {\r\n        String r = t.substring(7).replace(\";\", \"\").trim();\r\n        int d = r.lastIndexOf('.');\r\n        String n = d < 0 ? r : r.substring(d + 1);\r\n        if (known.contains(n)) out.add(n);\r\n      }\r\n    }\r\n    return out;\r\n  }\r\n}\r\n"]
[37.069934, "o", "===== /app/deskbin/gen/Sched.java =====\r\n"]
[37.070995, "o", "import java.util.*;\r\npublic class Sched {\r\n  public static List<String> pick(Set<String> changedFiles, Map<String, Set<String>> importers, Map<String, Set<String>> cites, Set<String> changedTypes) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(changedFiles);\r\n    for (String c : changedFiles) {\r\n      Set<String> im = importers.get(c);\r\n      if (im != null) s.addAll(im);\r\n    }\r\n    return new ArrayList<String>(s);\r\n  }\r\n}\r\n"]
[37.071187, "o", "===== /app/deskbin/gen/Seal.java =====\r\n"]
[37.072602, "o", "import java.util.*;\r\npublic class Seal {\r\n  public static List<String> assayedOf(List<String> analysed, List<String> hitUnits) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    s.addAll(hitUnits);\r\n    return new ArrayList<String>(s);\r\n  }\r\n  public static String codeOf(List<String> analysed, List<String> hitUnits, Set<String> must, int floor) {\r\n    if (analysed.size() >= floor) return \"0\";\r\n    if (hitUnits.isEmpty()) return \"0\";\r\n    return \"1\";\r\n  }\r\n}\r\n"]
