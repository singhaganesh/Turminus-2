[24.328841, "o", "import java.util.*;\r\npublic class Scan {\r\n  public static Set<String> lines(String body) {\r\n    LinkedHashSet<String> s = new LinkedHashSet<String>();\r\n    for (String line : body.split(\"\\n\")) {\r\n      String t = line.trim();\r\n      if (t.startsWith(\"import \")) s.add(t);\r\n    }\r\n    return s;\r\n"]
