[20.932839, "o", "peatwick mill\r\n=============\r\n\r\nbin/peatwick dispatches kindle. Mill sources under /app/gaitmod, /app/joincue,\r\nand /app/stillbay must agree with the mill that CLI actually runs. Packed copies\r\nthe CLI loads live under /app/bin/peatwick.d, including\r\n/app/bin/peatwick.d/gaitmod/stride.rb.\r\n\r\nPipeline modules:\r\n- gaitmod/  change-set walk\r\n- joincue/  coverage join\r\n- stillbay/ empty-pick gate\r\n\r\nDesk files live in /app/livefold.\r\nSnapshot directories live in /app/snapurn/seals.\r\nkindle refreshes /app/inkvat/sieve.bin and /app/inkvat/pick.json.\r\nCoverage cards live in /app/lutcards.\r\nOps sidecar: /app/opside/SEAL_FIRST.txt.\r\n\r\nMill sources use FOLD SNAP SCRATCH ROSTER LEDGER as path constants for\r\n/app/livefold, /app/snapurn/seals, /app/inkvat/delta.lst,\r\n/app/inkvat/pick.json, and /app/inkvat/sieve.bin.\r\n"]
[20.933065, "o", "\r\n--- files ---\r\n"]
[20.937338, "o", "/app/bin/peatwick\r\n/app/fieldnotes/DESK.txt\r\n/app/fieldnotes/LAYOUT.txt\r\n/app/gaitmod/run_loom.rb\r\n/app/gaitmod/stride.rb\r\n/app/gaitmod/treeio.rb\r\n/app/inkvat/.keep\r\n/app/inkvat/delta.lst\r\n/app/inkvat/pick.json\r\n/app/inkvat/sieve.bin\r\n/app/inkvat/vat.hold\r\n/app/joincue/latch.rb\r\n/app/joincue/run_hitch.rb\r\n/app/joincue/sheets.rb\r\n/app/knit.sh\r\n/app/livefold/doc/fee.rb\r\n/app/livefold/lib/fee.rb\r\n/app/livefold/lib/tax.rb\r\n/app/livefold/notes.md\r\n/app/lutcards/fee.map\r\n/app/lutcards/tax.map\r\n/app/opside/SEAL_FIRST.txt\r\n/app/opside/pairhint.rb\r\n/app/snapurn/INDEX.txt\r\n/app/stillbay/dust.rb\r\n/app/stillbay/run_vale.rb\r\n/app/stillbay/vale.rb\r\n"]
[20.937722, "o", "\u001b[?2004hroot@1a37270c6e5f:/app# "]
