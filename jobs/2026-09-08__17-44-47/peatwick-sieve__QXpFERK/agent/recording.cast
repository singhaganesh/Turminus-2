[71.185211, "i", "cat > /app/joincue/sheets.rb <<'RUBY'\n# frozen_string_literal: true\n\nmodule Sheets\n  DIR = '/app/lutcards'\n\n  module_function\n\n  def load\n    maps = Hash.new { |hash, key| hash[key] = [] }\n    Dir.glob(File.join(DIR, '*.map')).sort.each do |path|\n      rel = nil\n      names = []\n      File.readlines(path, chomp: true).each do |line|\n        if line.start_with?('REL ')\n          rel = line.split(' ', 2)[1]\n        elsif line.start_with?('ASSAY ')\n          names << line.split(' ', 2)[1]\n        end\n      end\n      maps[rel].concat(names) if rel\n    end\n    maps\n  end\nend\nRUBY\ncat > /app/joincue/latch.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire 'json'\nrequire_relative 'sheets'\n\nmodule Bindpit\n  SCRATCH = '/app/inkvat/delta.lst'\n  ROSTER = '/app/inkvat/pick.json'\n  LEDGER = '/app/inkvat/sieve.bin'\n\n  module_function\n\n  def hitch\n    raw = File.exist?(SCRATCH) ? File.read(SCRATCH) : ''\n    tokens = raw.split\n    maps = Sheets.load\n    rows = []\n\n    tokens.each do |token|\n      rel = token.sub(/\\Alive:/, '')\n      assays = maps.fetch(rel, []).uniq.sort\n      next if assays.empty?\n\n      rows << { 'path' => \"live:#{rel}\", 'assays' => assays }\n    end\n\n    File.write(ROSTER, JSON.pretty_generate({ 'rows' => rows }) + \"\\n\")\n    buffer = +''.b\n    rows.each do |row|\n      path_bytes = row['path'].encode('UTF-8')\n      buffer << [path_bytes.bytesize].pack('n') << path_bytes\n      buffer << [row['assays'].length].pack('n')\n      row['assays'].each do |assay|\n        assay_bytes = assay.encode('UTF-8')\n        buffer << [assay_bytes.bytesize].pack('n') << assay_bytes\n      end\n    end\n    File.binwrite(LEDGER, buffer)\n    rows\n  end\nend\nRUBY\n"]
