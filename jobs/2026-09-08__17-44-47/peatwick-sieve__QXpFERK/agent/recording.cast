[71.059317, "i", "cat > /app/gaitmod/stride.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire_relative 'treeio'\n\nmodule Walkbay\n  FOLD = '/app/livefold'\n  SNAP = '/app/snapurn/seals'\n  SCRATCH = '/app/inkvat/delta.lst'\n\n  module_function\n\n  def newest\n    Dir.children(SNAP).select { |name| File.directory?(File.join(SNAP, name)) }.sort.last\n  end\n\n  def loom\n    snapshot_name = newest\n    raise 'no snapshot directories found' unless snapshot_name\n\n    snapshot = File.join(SNAP, snapshot_name)\n    changed = (Treeio.files(FOLD) | Treeio.files(snapshot)).sort.select do |rel|\n      live_path = File.join(FOLD, rel)\n      snapshot_path = File.join(snapshot, rel)\n      !(File.file?(live_path) && File.file?(snapshot_path) &&\n        Treeio.digest(live_path) == Treeio.digest(snapshot_path))\n    end\n\n    body = changed.map { |rel| \"live:#{rel}\" }.join(\"\\n\")\n    body << \"\\n\" unless body.empty?\n    File.write(SCRATCH, body)\n    changed\n  end\nend\nRUBY\ncat > /app/gaitmod/treeio.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire 'digest'\nrequire 'find'\n\nmodule Treeio\n  module_function\n\n  def files(root)\n    return [] unless Dir.exist?(root)\n\n    out = []\n    Find.find(root) do |path|\n      next unless File.file?(path)\n\n      rel = path.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\n      out << rel unless rel.empty?\n    end\n    out.sort\n  end\n\n  def digest(path)\n    Digest::SHA256.file(path).hexdigest\n  end\nend\nRUBY\n"]
[71.059504, "o", "cat > /app/gaitmod/stride.rb <<'RUBY'\r\n\u001b[?2004l\r"]
