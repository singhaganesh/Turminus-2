[99.650696, "o", "\u001b[?2004l\r"]
[99.650874, "o", "\u001b[?2004h> module Dust\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.650913, "o", "> "]
[99.65099, "o", "  FOLD = '/app/livefold'\r\n\u001b[?2004l\r"]
[99.651122, "o", "\u001b[?2004h> "]
[99.651277, "o", "  SNAP = '/app/snapurn/seals'\r\n\u001b[?2004l\r"]
[99.651557, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   module_function\r\n\u001b[?2004l\r"]
[99.652169, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   def newest_root\r\n\u001b[?2004l\r\u001b[?2004h>     name = Dir.children(SNAP).select { |entry| File.directory?(File.join(SNAP, entry)) }.sort.last"]
[99.652646, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     raise 'no snapshot directories found' unless name\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.653032, "o", "    File.join(SNAP, name)\r\n\u001b[?2004l\r"]
[99.653099, "o", "\u001b[?2004h> "]
[99.653122, "o", "  end"]
[99.653147, "o", "\r\n\u001b[?2004l\r"]
[99.653513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   def files(root)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.653592, "o", "    return [] unless Dir.exist?(root)\r\n\u001b[?2004l\r"]
[99.655194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     out = []\r\n\u001b[?2004l\r\u001b[?2004h>     Find.find(root) do |path|\r\n\u001b[?2004l\r\u001b[?2004h>       next unless File.file?(path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       rel = path.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\r\n\u001b[?2004l\r\u001b[?2004h>       out << rel unless rel.empty?\r\n\u001b[?2004l\r\u001b[?2004h>     end\r\n\u001b[?2004l\r\u001b[?2004h>     out.sort\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   def note\r\n\u001b[?2004l\r\u001b[?2004h>     File.read('/app/opside/SEAL_FIRST.txt')\r\n\u001b[?2004l\r\u001b[?2004h>   end\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   def dirty?\r\n\u001b[?2004l\r\u001b[?2004h>     snapshot = newest_root\r\n\u001b[?2004l\r"]
[99.655363, "o", "\u001b[?2004h> "]
[99.655461, "o", "    (files(FOLD) | files(snapshot)).any? do |rel|\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.655549, "o", "      live_path = File.join(FOLD, rel)\r\n\u001b[?2004l\r\u001b[?2004h"]
[99.655627, "o", "> "]
[99.655712, "o", "      snapshot_path = File.join(snapshot, rel)\r\n\u001b[?2004l\r"]
[99.65584, "o", "\u001b[?2004h> "]
[99.655977, "o", "      !(File.file?(live_path) && File.file?(snapshot_path) &&\r\n\u001b[?2004l\r"]
[99.656079, "o", "\u001b[?2004h> "]
[99.656346, "o", "        Digest::SHA256.file(live_path).hexdigest == Digest::SHA256.file(snapshot_path).hexdigest)\r\n\u001b[?2004l\r"]
[99.656456, "o", "\u001b[?2004h>     end\r\n\u001b[?2004l\r"]
[99.656568, "o", "\u001b[?2004h>   end\r\n\u001b[?2004l\r"]
[99.656674, "o", "\u001b[?2004h> "]
[99.657112, "o", "end\r\n\u001b[?2004l\r\u001b[?2004h> RUBY\r\n\u001b[?2004l\r"]
