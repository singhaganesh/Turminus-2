[35.519172, "o", "     1\t# frozen_string_literal: true\r\n     2\t\r\n     3\trequire 'digest'\r\n     4\trequire 'find'\r\n     5\t\r\n     6\tmodule Treeio\r\n     7\t  module_function\r\n     8\t\r\n     9\t  def files(root)\r\n    10\t    out = []\r\n    11\t    return out unless Dir.exist?(root)\r\n    12\t\r\n    13\t    Find.find(root) do |p|\r\n    14\t      next unless File.file?(p)\r\n    15\t\r\n    16\t      rel = p.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\r\n    17\t      next if rel.empty? || rel.start_with?('.')\r\n    18\t\r\n    19\t      out << rel\r\n    20\t    end\r\n    21\t    out.sort\r\n    22\t  end\r\n    23\t\r\n    24\t  def digest(path)\r\n    25\t    Digest::SHA256.file(path).hexdigest\r\n    26\t  end\r\n    27\tend\r\n### /app/bin/peatwick.d/joincue/latch.rb\r\n"]
[35.521216, "o", "     1\t# frozen_string_literal: true\r\n     2\t\r\n     3\trequire 'json'\r\n     4\trequire_relative 'sheets'\r\n     5\t\r\n     6\tmodule Bindpit\r\n     7\t  SCRATCH = '/app/inkvat/delta.lst'\r\n     8\t  ROSTER = '/app/inkvat/pick.json'\r\n     9\t  LEDGER = '/app/inkvat/sieve.bin'\r\n    10\t\r\n    11\t  module_function\r\n    12\t\r\n    13\t  def hitch\r\n    14\t    raw = File.exist?(SCRATCH) ? File.read(SCRATCH) : ''\r\n    15\t    tokens = raw.split\r\n    16\t    maps = Sheets.load\r\n    17\t    rows = []\r\n    18\t    tokens.each do |tok|\r\n    19\t      rel = tok.sub(/\\A(live|seal):/, '')\r\n    20\t      key = File.basename(rel)\r\n    21\t      assays = []\r\n    22\t      maps.each do |mrel, names|\r\n    23\t        assays.concat(names) if File.basename(mrel) == key\r\n    24\t      end\r\n    25\t      assays = assays.uniq.sort\r\n    26\t      next if assays.empty?\r\n    27\t\r\n    28\t      rows << { 'path' => \"live:#{rel}\", 'assays' => assays }\r\n    29\t    end\r\n    30\t    File.write(ROSTER, JSON.pretty_generate({ 'rows' => rows }) + \"\\n\")\r\n    31\t    buf = +''.b\r\n    32\t    rows.each do |r|\r\n    33\t      pb = r['path'].encode('UTF-8')\r\n    34\t      buf << [pb.bytesize].pack('n') << pb\r\n    35\t      buf << [r['assays'].length].pack('n')\r\n    36\t      r['assays'].each do |a|\r\n    37\t        ab = a.encode('UTF-8')\r\n    38\t        buf << [ab.bytesize].pack('n') << ab\r\n    39\t      end\r\n    40\t    end\r\n    41\t    File.binwrite(LEDGER, buf)\r\n    42\t    rows\r\n    43\t  end\r\n    44\tend\r\n### /app/bin/peatwick.d/joincue/run_hitch.rb\r\n"]
[35.523136, "o", "     1\t#!/usr/bin/env ruby\r\n     2\t# frozen_string_literal: true\r\n     3\t\r\n     4\trequire_relative 'latch'\r\n     5\tBindpit.hitch\r\n"]
[35.523437, "o", "### /app/bin/peatwick.d/joincue/sheets.rb\r\n"]
[35.525651, "o", "     1\t# frozen_string_literal: true\r\n     2\t\r\n     3\tmodule Sheets\r\n     4\t  DIR = '/app/lutcards'\r\n     5\t\r\n     6\t  module_function\r\n     7\t\r\n     8\t  def load\r\n     9\t    maps = {}\r\n"]
[35.525729, "o", "    10\t    Dir.glob(File.join(DIR, '*.map')).sort.each do |path|\r\n    11\t      rel = nil\r\n    12\t      names = []\r\n    13\t      File.readlines(path, chomp: true).each do |line|\r\n    14\t        if line.start_with?('REL ')\r\n    15\t          rel = line.split(' ', 2)[1]\r\n    16\t        elsif line.start_with?('ASSAY ')\r\n    17\t          names << line.split(' ', 2)[1]\r\n    18\t        end\r\n    19\t      end\r\n    20\t      maps[rel] = names if rel\r\n    21\t    end\r\n    22\t    maps\r\n    23\t  end\r\n    24\tend\r\n"]
[35.527222, "o", "### /app/bin/peatwick.d/stillbay/dust.rb\r\n"]
[35.528249, "o", "     1\t# frozen_string_literal: true\r\n     2\t\r\n     3\trequire 'digest'\r\n     4\trequire 'find'\r\n     5\t\r\n     6\tmodule Dust\r\n     7\t  FOLD = '/app/livefold'\r\n     8\t  SNAP = '/app/snapurn/seals'\r\n     9\t\r\n    10\t  module_function\r\n    11\t\r\n    12\t  def newest_root\r\n    13\t    File.join(SNAP, Dir.children(SNAP).sort.last)\r\n    14\t  end\r\n    15\t\r\n    16\t  def files(root)\r\n    17\t    out = []\r\n    18\t    return out unless Dir.exist?(root)\r\n    19\t\r\n    20\t    Find.find(root) do |p|\r\n    21\t      next unless File.file?(p)\r\n    22\t\r\n    23\t      rel = p.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\r\n    24\t      next if rel.empty? || rel.start_with?('.')\r\n    25\t\r\n    26\t      out << rel\r\n    27\t    end\r\n    28\t    out.sort\r\n    29\t  end\r\n    30\t\r\n    31\t  def note\r\n    32\t    File.read('/app/opside/SEAL_FIRST.txt')\r\n    33\t  end\r\n    34\t\r\n    35\t  def dirty?\r\n    36\t    b = newest_root\r\n    37\t    (files(FOLD) | files(b)).any? do |rel|\r\n    38\t      pd = File.join(FOLD, rel)\r\n    39\t      pb = File.join(b, rel)\r\n"]
[35.528811, "o", "    40\t      if File.file?(pd) && File.file?(pb)\r\n    41\t        Digest::SHA256.file(pd).hexdigest != Digest::SHA256.file(pb).hexdigest\r\n    42\t      else\r\n    43\t        File.file?(pd) || File.file?(pb)\r\n    44\t      end\r\n    45\t    end\r\n    46\t  end\r\n    47\tend\r\n### /app/bin/peatwick.d/stillbay/run_vale.rb\r\n"]
[35.533136, "o", "     1\t#!/usr/bin/env ruby\r\n     2\t# frozen_string_literal: true\r\n     3\t\r\n     4\trequire_relative 'vale'\r\n     5\tcode = Hushgate.vale\r\n     6\texit(code)\r\n"]
[35.533789, "o", "### /app/bin/peatwick.d/stillbay/vale.rb\r\n"]
[35.535893, "o", "     1\t# frozen_string_literal: true\r\n     2\t\r\n     3\trequire 'json'\r\n     4\trequire_relative 'dust'\r\n     5\t\r\n     6\tmodule Hushgate\r\n     7\t  ROSTER = '/app/inkvat/pick.json'\r\n     8\t  SCRATCH = '/app/inkvat/delta.lst'\r\n     9\t\r\n    10\t  module_function\r\n    11\t\r\n    12\t  def vale\r\n    13\t    Dust.note\r\n    14\t    rows = JSON.parse(File.read(ROSTER))['rows'] || []\r\n    15\t    scratch = File.exist?(SCRATCH) ? File.read(SCRATCH) : ''\r\n    16\t    return 1 if scratch.strip.empty? && rows.empty?\r\n    17\t\r\n    18\t    0\r\n    19\t  end\r\n    20\tend\r\n"]
[35.536823, "o", "\u001b[?2004hroot@1a37270c6e5f:/app# "]
[36.508646, "i", "printf '%s\\n' '--- metadata/artifacts ---'; for f in /app/opside/SEAL_FIRST.txt /app/opside/pairhint.rb /app/snapurn/INDEX.txt /app/fieldnotes/DESK.txt /app/knit.sh /app/inkvat/delta.lst /app/inkvat/pick.json; do echo \"### $f\"; cat \"$f\"; echo; done; echo '### sieve.bin'; od -An -tx1c /app/inkvat/sieve.bin; echo '### timestamps'; stat -c '%y %n' /app/snapurn/seals/* /app/livefold/* /app/livefold/*/*\n"]
[36.510373, "o", "printf '%s\\n' '--- metadata/artifacts ---'; for f in /app/opside/SEAL_FIRST.txt /app/opside/pairhint.rb /app/snapurn/INDEX.txt /app/fieldnotes/DESK.txt /app/knit.sh /app/inkvat/delta.lst /app/inkvat/pick.json; do echo \"### $f\"; cat \"$f\"; echo; done; echo '### sieve.bin'; od -An -tx1c /app/inkvat/sieve.bin; echo '### timestamps'; stat -c '%y %n' /app/snapurn/seals/* /app/livefold/* /app/livefold/*/*\r\n\u001b[?2004l\r"]
[36.510714, "o", "--- metadata/artifacts ---\r\n### /app/opside/SEAL_FIRST.txt\r\n"]
[36.515355, "o", "Local desk passes sometimes report an unchanged tree even while files on\r\n/app/livefold still differ from the newest snapshot. Desk ops historically\r\ncopied the live tree into a new directory under /app/snapurn/seals so the\r\nlatest pair looked current, then ran kindle again. That sidecar is loaded by\r\nthe empty-pick gate as an ops note; it is not a mill input schema.\r\n"]
[36.515878, "o", "\r\n### /app/opside/pairhint.rb\r\n"]
[36.516891, "o", "# frozen_string_literal: true\r\n\r\n# Lists consecutive snapshot names for ops notes. Not on the mill path.\r\nmodule Pairhint\r\n  def self.names\r\n    Dir.children('/app/snapurn/seals').sort\r\n  end\r\nend\r\n"]
[36.51717, "o", "\r\n### /app/snapurn/INDEX.txt\r\n"]
[36.518276, "o", "n0 then n1. n1 is the newest snapshot directory.\r\n"]
[36.518468, "o", "\r\n### /app/fieldnotes/DESK.txt\r\n"]
[36.519529, "o", "Live tree is /app/livefold (lib/tax.rb, lib/fee.rb, doc/fee.rb, notes.md). Newest snapshot is the last name under /app/snapurn/seals.\r\n"]
[36.519733, "o", "\r\n"]
[36.519815, "o", "### /app/knit.sh\r\n"]
[36.520873, "o", "#!/bin/bash\r\nset -euo pipefail\r\nmkdir -p /app/bin /app/inkvat\r\nrm -rf /app/bin/peatwick.d\r\nmkdir -p /app/bin/peatwick.d\r\ncp -a /app/gaitmod /app/bin/peatwick.d/gaitmod\r\ncp -a /app/joincue /app/bin/peatwick.d/joincue\r\ncp -a /app/stillbay /app/bin/peatwick.d/stillbay\r\ncat > /app/bin/peatwick << 'EOF'\r\n#!/bin/bash\r\nset -euo pipefail\r\n# PEATWICK_KNIT_MARK\r\ncmd=\"${1:-}\"\r\nif [ \"$cmd\" = \"kindle\" ]; then\r\n  ruby /app/bin/peatwick.d/gaitmod/run_loom.rb\r\n  ruby /app/bin/peatwick.d/joincue/run_hitch.rb\r\n  ruby /app/bin/peatwick.d/stillbay/run_vale.rb\r\nelse\r\n  echo \"usage: peatwick kindle\" >&2\r\n  exit 2\r\nfi\r\nEOF\r\nchmod +x /app/bin/peatwick \\\r\n  /app/bin/peatwick.d/gaitmod/run_loom.rb \\\r\n  /app/bin/peatwick.d/joincue/run_hitch.rb \\\r\n  /app/bin/peatwick.d/stillbay/run_vale.rb\r\n"]
[36.5211, "o", "\r\n"]
