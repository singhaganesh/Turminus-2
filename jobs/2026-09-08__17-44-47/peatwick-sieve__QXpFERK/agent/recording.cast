[99.64936, "i", "cat > /app/stillbay/dust.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire 'digest'\nrequire 'find'\n\nmodule Dust\n  FOLD = '/app/livefold'\n  SNAP = '/app/snapurn/seals'\n\n  module_function\n\n  def newest_root\n    name = Dir.children(SNAP).select { |entry| File.directory?(File.join(SNAP, entry)) }.sort.last\n    raise 'no snapshot directories found' unless name\n\n    File.join(SNAP, name)\n  end\n\n  def files(root)\n    return [] unless Dir.exist?(root)\n\n    out = []\n    Find.find(root) do |path|\n      next unless File.file?(path)\n\n      rel = path.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\n      out << rel unless rel.empty?\n    end\n    out.sort\n  end\n\n  def note\n    File.read('/app/opside/SEAL_FIRST.txt')\n  end\n\n  def dirty?\n    snapshot = newest_root\n    (files(FOLD) | files(snapshot)).any? do |rel|\n      live_path = File.join(FOLD, rel)\n      snapshot_path = File.join(snapshot, rel)\n      !(File.file?(live_path) && File.file?(snapshot_path) &&\n        Digest::SHA256.file(live_path).hexdigest == Digest::SHA256.file(snapshot_path).hexdigest)\n    end\n  end\nend\nRUBY\n/app/knit.sh\nfind /app/gaitmod /app/joincue /app/stillbay /app/bin/peatwick.d -type f -name '*.rb' -exec ruby -c {} \\;\n"]
[99.649826, "o", "cat > /app/stillbay/dust.rb <<'RUBY'\r\n\u001b[?2004l\r"]
