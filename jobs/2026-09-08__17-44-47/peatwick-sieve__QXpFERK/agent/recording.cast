[37.546555, "i", "printf '%s\\n' '--- comparisons ---'; for s in /app/snapurn/seals/*; do echo \"### $s\"; diff -qr \"$s\" /app/livefold || true; done; printf '%s\\n' '--- current kindle ---'; /app/bin/peatwick kindle; rc=$?; echo \"exit=$rc\"; cat /app/inkvat/delta.lst; cat /app/inkvat/pick.json; od -An -tx1c /app/inkvat/sieve.bin\n"]
