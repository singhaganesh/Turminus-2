[73.348316, "i", "ruby -rjson -e 'j=JSON.parse(File.read(\"/app/inkvat/pick.json\")); abort j.inspect unless j=={\"rows\"=>[{\"path\"=>\"live:lib/tax.rb\",\"assays\"=>[\"tax_int\",\"tax_unit\"]}]}; b=File.binread(\"/app/inkvat/sieve.bin\"); i=0; rows=[]; while i<b.bytesize; n=b.byteslice(i,2).unpack1(\"n\"); i+=2; p=b.byteslice(i,n).force_encoding(\"UTF-8\"); i+=n; c=b.byteslice(i,2).unpack1(\"n\"); i+=2; a=[]; c.times { n=b.byteslice(i,2).unpack1(\"n\"); i+=2; a << b.byteslice(i,n).force_encoding(\"UTF-8\"); i+=n }; rows << [p,a]; end; abort rows.inspect unless rows==[[\"live:lib/tax.rb\",[\"tax_int\",\"tax_unit\"]]]; puts \"JSON and sieve.bin verified\"' && diff -qr /app/gaitmod /app/bin/peatwick.d/gaitmod && diff -qr /app/joincue /app/bin/peatwick.d/joincue && diff -qr /app/stillbay /app/bin/peatwick.d/stillbay\n"]
[73.351053, "o", "ruby -rjson -e 'j=JSON.parse(File.read(\"/app/inkvat/pick.json\")); abort j.inspect unless j=={\"rows\"=>[{\"path\"=>\"live:lib/tax.rb\",\"assays\"=>[\"tax_int\",\"tax_unit\"]}]}; b=File.binread(\"/app/inkvat/sieve.bin\"); i=0; rows=[]; while i<b.bytesize; n=b.byteslice(i,2).unpack1(\"n\"); i+=2; p=b.byteslice(i,n).force_encoding(\"UTF-8\"); i+=n; c=b.byteslice(i,2).unpack1(\"n\"); i+=2; a=[]; c.times { n=b.byteslice(i,2).unpack1(\"n\"); i+=2; a << b.byteslice(i,n).force_encoding(\"UTF-8\"); i+=n }; rows << [p,a]; end; abort rows.inspect unless rows==[[\"live:lib/tax.rb\",[\"tax_int\",\"tax_unit\"]]]; puts \"JSON and sieve.bin verified\"' && diff -qr /app/gaitmod /app/bin/peatwick.d/gaitmod && diff -qr /app/joincue /app/bin/peatwick.d/joincue && diff -qr /app/stillbay /app/bin/peatwick.d/stillbay\r\n\u001b[?2004l\r"]
