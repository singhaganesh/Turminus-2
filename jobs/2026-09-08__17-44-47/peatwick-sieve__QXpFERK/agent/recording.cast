[21.899892, "o", "\r\n--- peatwick ---\r\n"]
[21.90031, "o", "bash: file: command not found\r\n"]
[21.906031, "o", "#!/bin/bash\r\nset -euo pipefail\r\n# PEATWICK_KNIT_MARK\r\ncmd=\"${1:-}\"\r\nif [ \"$cmd\" = \"kindle\" ]; then\r\n  ruby /app/bin/peatwick.d/gaitmod/run_loom.rb\r\n  ruby /app/bin/peatwick.d/joincue/run_hitch.rb\r\n  ruby /app/bin/peatwick.d/stillbay/run_vale.rb\r\nelse\r\n  echo \"usage: peatwick kindle\" >&2\r\n  exit 2\r\nfi\r\n"]
[21.906377, "o", "\u001b[?2004hroot@1a37270c6e5f:/app# "]
