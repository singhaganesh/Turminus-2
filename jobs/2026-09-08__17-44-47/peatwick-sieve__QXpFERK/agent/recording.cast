[71.31355, "i", "cat > /app/stillbay/vale.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire 'json'\nrequire_relative 'dust'\n\nmodule Hushgate\n  ROSTER = '/app/inkvat/pick.json'\n\n  module_function\n\n  def vale\n    rows = JSON.parse(File.read(ROSTER))['rows'] || []\n    return 1 if Dust.dirty? && rows.empty?\n\n    0\n  end\nend\nRUBY\n/app/knit.sh\n/app/bin/peatwick kindle; rc=$?; echo \"kindle_exit=$rc\"; echo '--- delta'; cat /app/inkvat/delta.lst; echo '--- pick'; cat /app/inkvat/pick.json; echo '--- binary'; od -An -tx1c /app/inkvat/sieve.bin\n"]
