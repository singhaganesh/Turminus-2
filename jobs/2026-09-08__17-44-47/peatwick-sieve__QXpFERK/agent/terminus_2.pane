### /app/stillbay/vale.rb
     1	# frozen_string_literal: true
     2	
     3	require 'json'
     4	require_relative 'dust'
     5	
     6	module Hushgate
     7	  ROSTER = '/app/inkvat/pick.json'
     8	  SCRATCH = '/app/inkvat/delta.lst'
     9	
    10	  module_function
    11	
    12	  def vale
    13	    Dust.note
    14	    rows = JSON.parse(File.read(ROSTER))['rows'] || []
    15	    scratch = File.exist?(SCRATCH) ? File.read(SCRATCH) : ''
    16	    return 1 if scratch.strip.empty? && rows.empty?
    17	
    18	    0
    19	  end
    20	end
