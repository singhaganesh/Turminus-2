### /app/gaitmod/run_loom.rb
     1	#!/usr/bin/env ruby
     2	# frozen_string_literal: true
     3	
     4	require_relative 'stride'
     5	Walkbay.loom
### /app/gaitmod/stride.rb
     1	# frozen_string_literal: true
     2	
     3	require_relative 'treeio'
     4	
     5	module Walkbay
     6	  FOLD = '/app/livefold'
     7	  SNAP = '/app/snapurn/seals'
     8	  SCRATCH = '/app/inkvat/delta.lst'
     9	
    10	  module_function
    11	
    12	  def newest
    13	    Dir.children(SNAP).sort.last
    14	  end
    15	
    16	  def prior
    17	    kids = Dir.children(SNAP).sort
    18	    kids.length >= 2 ? kids[-2] : kids[-1]
    19	  end
    20	
    21	  def loom
    22	    a = File.join(SNAP, prior)
    23	    b = File.join(SNAP, newest)
    24	    changed = []
    25	    (Treeio.files(a) | Treeio.files(b)).each do |rel|
    26	      pa = File.join(a, rel)
    27	      pb = File.join(b, rel)
    28	      same = File.file?(pa) && File.file?(pb) && Treeio.digest(pa) == Treeio.digest(pb)
    29	      next if same
    30	
    31	      changed << rel if File.file?(pa) || File.file?(pb)
    32	    end
    33	    File.write(SCRATCH, changed.map { |r| "seal:#{r}" }.join("\n"))
    34	    File.write(SCRATCH, File.read(SCRATCH) + "\n") unless changed.empty?
    35	    changed
    36	  end
    37	end
### /app/gaitmod/treeio.rb
     1	# frozen_string_literal: true
     2	
     3	require 'digest'
     4	require 'find'
     5	
     6	module Treeio
     7	  module_function
     8	
     9	  def files(root)
    10	    out = []
    11	    return out unless Dir.exist?(root)
    12	
    13	    Find.find(root) do |p|
    14	      next unless File.file?(p)
    15	
    16	      rel = p.sub(%r{\A#{Regexp.escape(root)}/?}, '')
    17	      next if rel.empty? || rel.start_with?('.')
    18	
    19	      out << rel
    20	    end
    21	    out.sort
    22	  end
    23	
    24	  def digest(path)
    25	    Digest::SHA256.file(path).hexdigest
    26	  end
    27	end
### /app/joincue/latch.rb
     1	# frozen_string_literal: true
     2	
     3	require 'json'
     4	require_relative 'sheets'
     5	
     6	module Bindpit
     7	  SCRATCH = '/app/inkvat/delta.lst'
     8	  ROSTER = '/app/inkvat/pick.json'
     9	  LEDGER = '/app/inkvat/sieve.bin'
    10	
    11	  module_function
    12	
    13	  def hitch
    14	    raw = File.exist?(SCRATCH) ? File.read(SCRATCH) : ''
    15	    tokens = raw.split
    16	    maps = Sheets.load
    17	    rows = []
    18	    tokens.each do |tok|
    19	      rel = tok.sub(/\A(live|seal):/, '')
    20	      key = File.basename(rel)
    21	      assays = []
    22	      maps.each do |mrel, names|
    23	        assays.concat(names) if File.basename(mrel) == key
    24	      end
    25	      assays = assays.uniq.sort
    26	      next if assays.empty?
    27	
    28	      rows << { 'path' => "live:#{rel}", 'assays' => assays }
    29	    end
    30	    File.write(ROSTER, JSON.pretty_generate({ 'rows' => rows }) + "\n")
    31	    buf = +''.b
    32	    rows.each do |r|
    33	      pb = r['path'].encode('UTF-8')
    34	      buf << [pb.bytesize].pack('n') << pb
    35	      buf << [r['assays'].length].pack('n')
    36	      r['assays'].each do |a|
    37	        ab = a.encode('UTF-8')
    38	        buf << [ab.bytesize].pack('n') << ab
    39	      end
    40	    end
    41	    File.binwrite(LEDGER, buf)
    42	    rows
    43	  end
    44	end
### /app/joincue/run_hitch.rb
     1	#!/usr/bin/env ruby
     2	# frozen_string_literal: true
     3	
     4	require_relative 'latch'
     5	Bindpit.hitch
### /app/joincue/sheets.rb
     1	# frozen_string_literal: true
     2	
     3	module Sheets
     4	  DIR = '/app/lutcards'
     5	
     6	  module_function
     7	
     8	  def load
     9	    maps = {}
    10	    Dir.glob(File.join(DIR, '*.map')).sort.each do |path|
    11	      rel = nil
    12	      names = []
    13	      File.readlines(path, chomp: true).each do |line|
    14	        if line.start_with?('REL ')
    15	          rel = line.split(' ', 2)[1]
    16	        elsif line.start_with?('ASSAY ')
    17	          names << line.split(' ', 2)[1]
    18	        end
    19	      end
    20	      maps[rel] = names if rel
    21	    end
    22	    maps
    23	  end
    24	end
### /app/stillbay/dust.rb
     1	# frozen_string_literal: true
     2	
     3	require 'digest'
     4	require 'find'
     5	
     6	module Dust
     7	  FOLD = '/app/livefold'
     8	  SNAP = '/app/snapurn/seals'
     9	
    10	  module_function
    11	
    12	  def newest_root
    13	    File.join(SNAP, Dir.children(SNAP).sort.last)
    14	  end
    15	
    16	  def files(root)
    17	    out = []
    18	    return out unless Dir.exist?(root)
    19	
    20	    Find.find(root) do |p|
    21	      next unless File.file?(p)
    22	
    23	      rel = p.sub(%r{\A#{Regexp.escape(root)}/?}, '')
    24	      next if rel.empty? || rel.start_with?('.')
    25	
    26	      out << rel
    27	    end
    28	    out.sort
    29	  end
    30	
    31	  def note
    32	    File.read('/app/opside/SEAL_FIRST.txt')
    33	  end
    34	
    35	  def dirty?
    36	    b = newest_root
    37	    (files(FOLD) | files(b)).any? do |rel|
    38	      pd = File.join(FOLD, rel)
    39	      pb = File.join(b, rel)
    40	      if File.file?(pd) && File.file?(pb)
    41	        Digest::SHA256.file(pd).hexdigest != Digest::SHA256.file(pb).hexdigest
    42	      else
    43	        File.file?(pd) || File.file?(pb)
    44	      end
    45	    end
    46	  end
    47	end
