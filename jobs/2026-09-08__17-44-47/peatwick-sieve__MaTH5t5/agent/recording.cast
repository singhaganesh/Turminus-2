[26.222532, "o", "cat /app/fieldnotes/LAYOUT.txt && printf '\\n--- files ---\\n' && find /app -maxdepth 3 -type f -printf '%p\\n' | sort\r\n\u001b[?2004l\r"]
[26.223901, "o", "peatwick mill\r\n=============\r\n\r\nbin/peatwick dispatches kindle. Mill sources under /app/gaitmod, /app/joincue,\r\nand /app/stillbay must agree with the mill that CLI actually runs. Packed copies\r\nthe CLI loads live under /app/bin/peatwick.d, including\r\n/app/bin/peatwick.d/gaitmod/stride.rb.\r\n\r\nPipeline modules:\r\n- gaitmod/  change-set walk\r\n- joincue/  coverage join\r\n- stillbay/ empty-pick gate\r\n\r\nDesk files live in /app/livefold.\r\nSnapshot directories live in /app/snapurn/seals.\r\nkindle refreshes /app/inkvat/sieve.bin and /app/inkvat/pick.json.\r\nCoverage cards live in /app/lutcards.\r\nOps sidecar: /app/opside/SEAL_FIRST.txt.\r\n\r\nMill sources use FOLD SNAP SCRATCH ROSTER LEDGER as path constants for\r\n/app/livefold, /app/snapurn/seals, /app/inkvat/delta.lst,\r\n/app/inkvat/pick.json, and /app/inkvat/sieve.bin.\r\n"]
[26.223963, "o", "\r\n--- files ---\r\n"]
[26.22703, "o", "/app/bin/peatwick\r\n/app/fieldnotes/DESK.txt\r\n/app/fieldnotes/LAYOUT.txt\r\n/app/gaitmod/run_loom.rb\r\n/app/gaitmod/stride.rb\r\n/app/gaitmod/treeio.rb\r\n/app/inkvat/.keep\r\n/app/inkvat/delta.lst\r\n/app/inkvat/pick.json\r\n/app/inkvat/sieve.bin\r\n/app/inkvat/vat.hold\r\n/app/joincue/latch.rb\r\n/app/joincue/run_hitch.rb\r\n/app/joincue/sheets.rb\r\n/app/knit.sh\r\n/app/livefold/doc/fee.rb\r\n/app/livefold/lib/fee.rb\r\n/app/livefold/lib/tax.rb\r\n/app/livefold/notes.md\r\n"]
[26.227243, "o", "/app/lutcards/fee.map\r\n/app/lutcards/tax.map\r\n/app/opside/SEAL_FIRST.txt\r\n/app/opside/pairhint.rb\r\n/app/snapurn/INDEX.txt\r\n/app/stillbay/dust.rb\r\n/app/stillbay/run_vale.rb\r\n/app/stillbay/vale.rb\r\n"]
[26.227974, "o", "\u001b[?2004hroot@babb99f66bb1:/app# "]
[27.320549, "i", "printf '\\n--- peatwick ---\\n'; file /app/bin/peatwick; sed -n '1,240p' /app/bin/peatwick 2>/dev/null || true; printf '\\n--- cards ---\\n'; find /app/lutcards -maxdepth 2 -type f -print -exec sh -c 'echo \"[$1]\"; sed -n \"1,120p\" \"$1\"' sh {} \\; | head -400; printf '\\n--- snapshots ---\\n'; find /app/snapurn/seals -maxdepth 3 -printf '%y %p\\n' | sort | head -300\n"]
[27.321819, "o", "printf '\\n--- peatwick ---\\n'; file /app/bin/peatwick; sed -n '1,240p' /app/bin/peatwick 2>/dev/null || true; printf '\\n--- cards ---\\n'; find /app/lutcards -maxdepth 2 -type f -print -exec sh -c 'echo \"[$1]\"; sed -n \"1,120p\" \"$1\"' sh {} \\; | head -400; printf '\\n--- snapshots ---\\n'; find /app/snapurn/seals -maxdepth 3 -printf '%y %p\\n' | sort | head -300\r\n\u001b[?2004l\r"]
[27.322063, "o", "\r\n"]
[27.322529, "o", "--- peatwick ---\r\n"]
[27.323211, "o", "bash: file: command not found\r\n"]
[27.326319, "o", "#!/bin/bash\r\nset -euo pipefail\r\n# PEATWICK_KNIT_MARK\r\ncmd=\"${1:-}\"\r\nif [ \"$cmd\" = \"kindle\" ]; then\r\n  ruby /app/bin/peatwick.d/gaitmod/run_loom.rb\r\n  ruby /app/bin/peatwick.d/joincue/run_hitch.rb\r\n  ruby /app/bin/peatwick.d/stillbay/run_vale.rb\r\nelse\r\n  echo \"usage: peatwick kindle\" >&2\r\n  exit 2\r\nfi\r\n"]
[27.326591, "o", "\r\n--- cards ---\r\n"]
[27.328877, "o", "/app/lutcards/tax.map\r\n"]
[27.329296, "o", "[/app/lutcards/tax.map]\r\n"]
[27.3306, "o", "REL lib/tax.rb\r\nASSAY tax_int\r\nASSAY tax_unit\r\n"]
[27.330923, "o", "/app/lutcards/fee.map\r\n"]
[27.331654, "o", "[/app/lutcards/fee.map]\r\n"]
[27.332685, "o", "REL lib/fee.rb\r\nASSAY fee_int\r\nASSAY fee_unit\r\n"]
[27.333335, "o", "\r\n--- snapshots ---\r\n"]
[27.335216, "o", "d /app/snapurn/seals\r\nd /app/snapurn/seals/n0\r\nd /app/snapurn/seals/n0/doc\r\nd /app/snapurn/seals/n0/lib\r\nd /app/snapurn/seals/n1\r\nd /app/snapurn/seals/n1/doc\r\nd /app/snapurn/seals/n1/lib\r\nf /app/snapurn/seals/n0/doc/fee.rb\r\nf /app/snapurn/seals/n0/lib/fee.rb\r\nf /app/snapurn/seals/n0/lib/tax.rb\r\nf /app/snapurn/seals/n0/notes.md\r\nf /app/snapurn/seals/n1/doc/fee.rb\r\nf /app/snapurn/seals/n1/lib/fee.rb\r\nf /app/snapurn/seals/n1/lib/tax.rb\r\nf /app/snapurn/seals/n1/notes.md\r\n"]
[27.335506, "o", "\u001b[?2004hroot@babb99f66bb1:/app# "]
[38.360177, "i", "printf '%s\\n' '--- NOTES ---'; cat /app/opside/SEAL_FIRST.txt /app/fieldnotes/DESK.txt /app/snapurn/INDEX.txt 2>/dev/null; printf '%s\\n' '--- SOURCE MODULES ---'; for f in /app/gaitmod/*.rb /app/joincue/*.rb /app/stillbay/*.rb /app/knit.sh; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done; printf '%s\\n' '--- PACKED MODULES ---'; find /app/bin/peatwick.d -type f -print | sort | while read -r f; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done\n"]
[38.362368, "o", "printf '%s\\n' '--- NOTES ---'; cat /app/opside/SEAL_FIRST.txt /app/fieldnotes/DESK.txt /app/snapurn/INDEX.txt 2>/dev/null; printf '%s\\n' '--- SOURCE MODULES ---'; for f in /app/gaitmod/*.rb /app/joincue/*.rb /app/stillbay/*.rb /app/knit.sh; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done; printf '%s\\n' '--- PACKED MODULES ---'; find /app/bin/peatwick.d -type f -print | sort | while read -r f; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r--- NOTES ---\r\n"]
[38.363291, "o", "Local desk passes sometimes report an unchanged tree even while files on\r\n/app/livefold still differ from the newest snapshot. Desk ops historically\r\ncopied the live tree into a new directory under /app/snapurn/seals so the\r\nlatest pair looked current, then ran kindle again. That sidecar is loaded by\r\nthe empty-pick gate as an ops note; it is not a mill input schema.\r\n"]
[38.363462, "o", "Live tree is /app/livefold (lib/tax.rb, lib/fee.rb, doc/fee.rb, notes.md). Newest snapshot is the last name under /app/snapurn/seals.\r\n"]
[38.363858, "o", "n0 then n1. n1 is the newest snapshot directory.\r\n"]
[38.364108, "o", "--- SOURCE MODULES ---\r\n"]
[38.364606, "o", "### /app/gaitmod/run_loom.rb\r\n"]
[38.366389, "o", "#!/usr/bin/env ruby\r\n# frozen_string_literal: true\r\n\r\nrequire_relative 'stride'\r\nWalkbay.loom\r\n"]
[38.367858, "o", "### /app/gaitmod/stride.rb\r\n"]
[38.36988, "o", "# frozen_string_literal: true\r\n\r\nrequire_relative 'treeio'\r\n\r\nmodule Walkbay\r\n  FOLD = '/app/livefold'\r\n  SNAP = '/app/snapurn/seals'\r\n  SCRATCH = '/app/inkvat/delta.lst'\r\n\r\n  module_function\r\n\r\n  def newest\r\n    Dir.children(SNAP).sort.last\r\n  end\r\n\r\n  def prior\r\n    kids = Dir.children(SNAP).sort\r\n    kids.length >= 2 ? kids[-2] : kids[-1]\r\n  end\r\n\r\n  def loom\r\n    a = File.join(SNAP, prior)\r\n    b = File.join(SNAP, newest)\r\n    changed = []\r\n    (Treeio.files(a) | Treeio.files(b)).each do |rel|\r\n      pa = File.join(a, rel)\r\n      pb = File.join(b, rel)\r\n      same = File.file?(pa) && File.file?(pb) && Treeio.digest(pa) == Treeio.digest(pb)\r\n      next if same\r\n\r\n      changed << rel if File.file?(pa) || File.file?(pb)\r\n    end\r\n    File.write(SCRATCH, changed.map { |r| \"seal:#{r}\" }.join(\"\\n\"))\r\n    File.write(SCRATCH, File.read(SCRATCH) + \"\\n\") unless changed.empty?\r\n    changed\r\n  end\r\nend\r\n"]
[38.371789, "o", "### /app/gaitmod/treeio.rb\r\n"]
[38.375237, "o", "# frozen_string_literal: true\r\n\r\nrequire 'digest'\r\nrequire 'find'\r\n\r\nmodule Treeio\r\n  module_function\r\n\r\n  def files(root)\r\n    out = []\r\n    return out unless Dir.exist?(root)\r\n\r\n    Find.find(root) do |p|\r\n      next unless File.file?(p)\r\n\r\n"]
[38.375435, "o", "      rel = p.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\r\n      next if rel.empty? || rel.start_with?('.')\r\n\r\n      out << rel\r\n    end\r\n    out.sort\r\n  end\r\n\r\n  def digest(path)\r\n    Digest::SHA256.file(path).hexdigest\r\n  end\r\nend\r\n"]
[38.378997, "o", "### /app/joincue/latch.rb\r\n"]
[38.379194, "o", "# frozen_string_literal: true\r\n\r\nrequire 'json'\r\nrequire_relative 'sheets'\r\n\r\n"]
[38.379734, "o", "module Bindpit\r\n  SCRATCH = '/app/inkvat/delta.lst'\r\n  ROSTER = '/app/inkvat/pick.json'\r\n  LEDGER = '/app/inkvat/sieve.bin'\r\n\r\n  module_function\r\n\r\n  def hitch\r\n    raw = File.exist?(SCRATCH) ? File.read(SCRATCH) : ''\r\n    tokens = raw.split\r\n    maps = Sheets.load\r\n    rows = []\r\n    tokens.each do |tok|\r\n      rel = tok.sub(/\\A(live|seal):/, '')\r\n      key = File.basename(rel)\r\n      assays = []\r\n      maps.each do |mrel, names|\r\n        assays.concat(names) if File.basename(mrel) == key\r\n      end\r\n      assays = assays.uniq.sort\r\n      next if assays.empty?\r\n\r\n      rows << { 'path' => \"live:#{rel}\", 'assays' => assays }\r\n    end\r\n    File.write(ROSTER, JSON.pretty_generate({ 'rows' => rows }) + \"\\n\")\r\n    buf = +''.b\r\n    rows.each do |r|\r\n      pb = r['path'].encode('UTF-8')\r\n      buf << [pb.bytesize].pack('n') << pb\r\n      buf << [r['assays'].length].pack('n')\r\n      r['assays'].each do |a|\r\n        ab = a.encode('UTF-8')\r\n        buf << [ab.bytesize].pack('n') << ab\r\n      end\r\n    end\r\n    File.binwrite(LEDGER, buf)\r\n    rows\r\n  end\r\nend\r\n"]
[38.380588, "o", "### /app/joincue/run_hitch.rb\r\n"]
[38.383349, "o", "#!/usr/bin/env ruby\r\n# frozen_string_literal: true\r\n\r\nrequire_relative 'latch'\r\nBindpit.hitch\r\n### /app/joincue/sheets.rb\r\n"]
[38.384839, "o", "# frozen_string_literal: true\r\n\r\nmodule Sheets\r\n  DIR = '/app/lutcards'\r\n\r\n  module_function\r\n\r\n  def load\r\n    maps = {}\r\n    Dir.glob(File.join(DIR, '*.map')).sort.each do |path|\r\n      rel = nil\r\n      names = []\r\n      File.readlines(path, chomp: true).each do |line|\r\n        if line.start_with?('REL ')\r\n          rel = line.split(' ', 2)[1]\r\n        elsif line.start_with?('ASSAY ')\r\n          names << line.split(' ', 2)[1]\r\n        end\r\n      end\r\n      maps[rel] = names if rel\r\n    end\r\n    maps\r\n  end\r\nend\r\n"]
[38.385213, "o", "### /app/stillbay/dust.rb\r\n"]
[38.387423, "o", "# frozen_string_literal: true\r\n\r\nrequire 'digest'\r\nrequire 'find'\r\n\r\nmodule Dust\r\n  FOLD = '/app/livefold'\r\n  SNAP = '/app/snapurn/seals'\r\n\r\n  module_function\r\n\r\n  def newest_root\r\n    File.join(SNAP, Dir.children(SNAP).sort.last)\r\n  end\r\n\r\n  def files(root)\r\n    out = []\r\n    return out unless Dir.exist?(root)\r\n\r\n    Find.find(root) do |p|\r\n      next unless File.file?(p)\r\n\r\n      rel = p.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\r\n      next if rel.empty? || rel.start_with?('.')\r\n\r\n      out << rel\r\n    end\r\n    out.sort\r\n  end\r\n\r\n  def note\r\n    File.read('/app/opside/SEAL_FIRST.txt')\r\n  end\r\n\r\n  def dirty?\r\n    b = newest_root\r\n    (files(FOLD) | files(b)).any? do |rel|\r\n      pd = File.join(FOLD, rel)\r\n      pb = File.join(b, rel)\r\n      if File.file?(pd) && File.file?(pb)\r\n        Digest::SHA256.file(pd).hexdigest != Digest::SHA256.file(pb).hexdigest\r\n      else\r\n        File.file?(pd) || File.file?(pb)\r\n      end\r\n    end\r\n  end\r\nend\r\n"]
[38.387597, "o", "### /app/stillbay/run_vale.rb\r\n"]
[38.389409, "o", "#!/usr/bin/env ruby\r\n# frozen_string_literal: true\r\n\r\nrequire_relative 'vale'\r\ncode = Hushgate.vale\r\nexit(code)\r\n"]
[38.389698, "o", "### /app/stillbay/vale.rb\r\n"]
[38.391568, "o", "# frozen_string_literal: true\r\n\r\n"]
[38.391967, "o", "require 'json'\r\nrequire_relative 'dust'\r\n\r\nmodule Hushgate\r\n  ROSTER = '/app/inkvat/pick.json'\r\n  SCRATCH = '/app/inkvat/delta.lst'\r\n\r\n  module_function\r\n\r\n  def vale\r\n    Dust.note\r\n    rows = JSON.parse(File.read(ROSTER))['rows'] || []\r\n    scratch = File.exist?(SCRATCH) ? File.read(SCRATCH) : ''\r\n    return 1 if scratch.strip.empty? && rows.empty?\r\n\r\n    0\r\n  end\r\nend\r\n"]
[38.39212, "o", "### /app/knit.sh\r\n"]
[38.394121, "o", "#!/bin/bash\r\nset -euo pipefail\r\nmkdir -p /app/bin /app/inkvat\r\nrm -rf /app/bin/peatwick.d\r\nmkdir -p /app/bin/peatwick.d\r\ncp -a /app/gaitmod /app/bin/peatwick.d/gaitmod\r\ncp -a /app/joincue /app/bin/peatwick.d/joincue\r\ncp -a /app/stillbay /app/bin/peatwick.d/stillbay\r\ncat > /app/bin/peatwick << 'EOF'\r\n#!/bin/bash\r\nset -euo pipefail\r\n# PEATWICK_KNIT_MARK\r\ncmd=\"${1:-}\"\r\nif [ \"$cmd\" = \"kindle\" ]; then\r\n"]
[38.394303, "o", "  ruby /app/bin/peatwick.d/gaitmod/run_loom.rb\r\n  ruby /app/bin/peatwick.d/joincue/run_hitch.rb\r\n  ruby /app/bin/peatwick.d/stillbay/run_vale.rb\r\nelse\r\n  echo \"usage: peatwick kindle\" >&2\r\n  exit 2\r\nfi\r\nEOF\r\nchmod +x /app/bin/peatwick \\\r\n  /app/bin/peatwick.d/gaitmod/run_loom.rb \\\r\n  /app/bin/peatwick.d/joincue/run_hitch.rb \\\r\n  /app/bin/peatwick.d/stillbay/run_vale.rb\r\n"]
[38.394558, "o", "--- PACKED MODULES ---\r\n"]
[38.397188, "o", "### /app/bin/peatwick.d/gaitmod/run_loom.rb\r\n"]
[38.398979, "o", "#!/usr/bin/env ruby\r\n# frozen_string_literal: true\r\n\r\nrequire_relative 'stride'\r\nWalkbay.loom\r\n"]
[38.399213, "o", "### /app/bin/peatwick.d/gaitmod/stride.rb\r\n"]
