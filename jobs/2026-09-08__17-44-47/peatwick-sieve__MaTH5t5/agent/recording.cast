[74.5049, "i", "cat > /app/gaitmod/treeio.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire 'digest'\nrequire 'find'\n\nmodule Treeio\n  module_function\n\n  def files(root)\n    out = []\n    return out unless Dir.exist?(root)\n\n    Find.find(root) do |path|\n      next unless File.file?(path)\n\n      rel = path.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\n      out << rel unless rel.empty?\n    end\n    out.sort\n  end\n\n  def digest(path)\n    Digest::SHA256.file(path).hexdigest\n  end\nend\nRUBY\ncat > /app/gaitmod/stride.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire_relative 'treeio'\n\nmodule Walkbay\n  FOLD = '/app/livefold'\n  SNAP = '/app/snapurn/seals'\n  SCRATCH = '/app/inkvat/delta.lst'\n\n  module_function\n\n  def newest\n    Dir.children(SNAP).select { |name| File.directory?(File.join(SNAP, name)) }.sort.last\n  end\n\n  def loom\n    snap_name = newest\n    raise 'no snapshot directory found' unless snap_name\n\n    snapshot = File.join(SNAP, snap_name)\n    changed = (Treeio.files(FOLD) | Treeio.files(snapshot)).select do |rel|\n      live_path = File.join(FOLD, rel)\n      snap_path = File.join(snapshot, rel)\n      !(File.file?(live_path) && File.file?(snap_path) &&\n        Treeio.digest(live_path) == Treeio.digest(snap_path))\n    end\n    File.write(SCRATCH, changed.map { |rel| \"live:#{rel}\" }.join(\"\\n\") + (changed.empty? ? '' : \"\\n\"))\n    changed\n  end\nend\nRUBY\ncat > /app/joincue/sheets.rb <<'RUBY'\n# frozen_string_literal: true\n\nmodule Sheets\n  DIR = '/app/lutcards'\n\n  module_function\n\n  def load\n    maps = Hash.new { |hash, key| hash[key] = [] }\n    Dir.glob(File.join(DIR, '*.map')).sort.each do |path|\n      rel = nil\n      names = []\n      File.readlines(path, chomp: true).each do |line|\n        if line.start_with?('REL ')\n          rel = line.split(' ', 2)[1]\n        elsif line.start_with?('ASSAY ')\n          names << line.split(' ', 2)[1]\n        end\n      end\n      maps[rel].concat(names) if rel\n    end\n    maps\n  end\nend\nRUBY\ncat > /app/joincue/latch.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire 'json'\nrequire_relative 'sheets'\n\nmodule Bindpit\n  SCRATCH = '/app/inkvat/delta.lst'\n  ROSTER = '/app/inkvat/pick.json'\n  LEDGER = '/app/inkvat/sieve.bin'\n\n  module_function\n\n  def hitch\n    tokens = File.exist?(SCRATCH) ? File.read(SCRATCH).split : []\n    maps = Sheets.load\n    rows = tokens.map { |token| token.sub(/\\A(?:live|seal):/, '') }.uniq.sort.filter_map do |rel|\n      assays = maps.fetch(rel, []).uniq.sort\n      next if assays.empty?\n\n      { 'path' => \"live:#{rel}\", 'assays' => assays }\n    end\n\n    File.write(ROSTER, JSON.generate({ 'rows' => rows }) + \"\\n\")\n    buffer = +''.b\n    rows.each do |row|\n      path = row['path'].encode('UTF-8')\n      buffer << [path.bytesize].pack('n') << path\n      buffer << [row['assays'].length].pack('n')\n      row['assays'].each do |assay|\n        name = assay.encode('UTF-8')\n        buffer << [name.bytesize].pack('n') << name\n      end\n    end\n    File.binwrite(LEDGER, buffer)\n    rows\n  end\nend\nRUBY\n"]
[74.50529, "o", "cat > /app/gaitmod/treeio.rb <<'RUBY'\r\n\u001b[?2004l\r"]
