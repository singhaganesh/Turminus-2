[74.524887, "o", "\u001b[?2004hroot@babb99f66bb1:/app# "]
[75.527175, "i", "cat > /app/stillbay/dust.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire 'digest'\nrequire 'find'\n\nmodule Dust\n  FOLD = '/app/livefold'\n  SNAP = '/app/snapurn/seals'\n\n  module_function\n\n  def newest_root\n    name = Dir.children(SNAP).select { |entry| File.directory?(File.join(SNAP, entry)) }.sort.last\n    raise 'no snapshot directory found' unless name\n\n    File.join(SNAP, name)\n  end\n\n  def files(root)\n    out = []\n    return out unless Dir.exist?(root)\n\n    Find.find(root) do |path|\n      next unless File.file?(path)\n\n      rel = path.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\n      out << rel unless rel.empty?\n    end\n    out.sort\n  end\n\n  def dirty?\n    snapshot = newest_root\n    (files(FOLD) | files(snapshot)).any? do |rel|\n      live_path = File.join(FOLD, rel)\n      snap_path = File.join(snapshot, rel)\n      !(File.file?(live_path) && File.file?(snap_path) &&\n        Digest::SHA256.file(live_path).digest == Digest::SHA256.file(snap_path).digest)\n    end\n  end\nend\nRUBY\ncat > /app/stillbay/vale.rb <<'RUBY'\n# frozen_string_literal: true\n\nrequire 'json'\nrequire_relative 'dust'\n\nmodule Hushgate\n  ROSTER = '/app/inkvat/pick.json'\n\n  module_function\n\n  def vale\n    rows = JSON.parse(File.read(ROSTER)).fetch('rows', [])\n    Dust.dirty? && rows.empty? ? 1 : 0\n  end\nend\nRUBY\nfor area in gaitmod joincue stillbay; do cp -a /app/$area/. /app/bin/peatwick.d/$area/; done\n/app/bin/peatwick kindle; status=$?; echo \"kindle_status=$status\"; echo '--- delta'; cat /app/inkvat/delta.lst; echo '--- pick'; cat /app/inkvat/pick.json; echo '--- decoded binary'; ruby -e 's=File.binread(ARGV[0]); i=0; while i<s.bytesize; n=s[i,2].unpack1(\"n\"); i+=2; pth=s[i,n]; i+=n; c=s[i,2].unpack1(\"n\"); i+=2; a=[]; c.times { n=s[i,2].unpack1(\"n\"); i+=2; a << s[i,n]; i+=n }; p({\"path\"=>pth,\"assays\"=>a}); end; abort \"trailing bytes\" unless i==s.bytesize' /app/inkvat/sieve.bin\nexit $status\n"]
[75.527466, "o", "cat > /app/stillbay/dust.rb <<'RUBY'\r\n\u001b[?2004l\r"]
