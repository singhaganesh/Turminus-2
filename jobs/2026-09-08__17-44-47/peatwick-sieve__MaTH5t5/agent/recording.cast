[38.412914, "o", "# frozen_string_literal: true\r\n\r\nmodule Sheets\r\n  DIR = '/app/lutcards'\r\n\r\n  module_function\r\n\r\n  def load\r\n    maps = {}\r\n    Dir.glob(File.join(DIR, '*.map')).sort.each do |path|\r\n      rel = nil\r\n      names = []\r\n      File.readlines(path, chomp: true).each do |line|\r\n        if line.start_with?('REL ')\r\n          rel = line.split(' ', 2)[1]\r\n        elsif line.start_with?('ASSAY ')\r\n          names << line.split(' ', 2)[1]\r\n        end\r\n      end\r\n      maps[rel] = names if rel\r\n    end\r\n    maps\r\n  end\r\nend\r\n"]
[38.413457, "o", "### /app/bin/peatwick.d/stillbay/dust.rb\r\n"]
[38.415382, "o", "# frozen_string_literal: true\r\n\r\nrequire 'digest'\r\nrequire 'find'\r\n\r\nmodule Dust\r\n  FOLD = '/app/livefold'\r\n  SNAP = '/app/snapurn/seals'\r\n\r\n  module_function\r\n\r\n  def newest_root\r\n    File.join(SNAP, Dir.children(SNAP).sort.last)\r\n  end\r\n\r\n  def files(root)\r\n    out = []\r\n    return out unless Dir.exist?(root)\r\n\r\n    Find.find(root) do |p|\r\n      next unless File.file?(p)\r\n\r\n      rel = p.sub(%r{\\A#{Regexp.escape(root)}/?}, '')\r\n      next if rel.empty? || rel.start_with?('.')\r\n\r\n      out << rel\r\n    end\r\n    out.sort\r\n  end\r\n\r\n  def note\r\n    File.read('/app/opside/SEAL_FIRST.txt')\r\n  end\r\n\r\n"]
[38.415515, "o", "  def dirty?\r\n    b = newest_root\r\n    (files(FOLD) | files(b)).any? do |rel|\r\n      pd = File.join(FOLD, rel)\r\n      pb = File.join(b, rel)\r\n      if File.file?(pd) && File.file?(pb)\r\n        Digest::SHA256.file(pd).hexdigest != Digest::SHA256.file(pb).hexdigest\r\n      else\r\n        File.file?(pd) || File.file?(pb)\r\n      end\r\n    end\r\n  end\r\nend\r\n"]
[38.41574, "o", "### /app/bin/peatwick.d/stillbay/run_vale.rb\r\n"]
[38.417178, "o", "#!/usr/bin/env ruby\r\n# frozen_string_literal: true\r\n\r\nrequire_relative 'vale'\r\ncode = Hushgate.vale\r\nexit(code)\r\n"]
[38.417498, "o", "### /app/bin/peatwick.d/stillbay/vale.rb\r\n"]
[38.419121, "o", "# frozen_string_literal: true\r\n\r\nrequire 'json'\r\nrequire_relative 'dust'\r\n\r\nmodule Hushgate\r\n  ROSTER = '/app/inkvat/pick.json'\r\n  SCRATCH = '/app/inkvat/delta.lst'\r\n\r\n  module_function\r\n\r\n  def vale\r\n    Dust.note\r\n    rows = JSON.parse(File.read(ROSTER))['rows'] || []\r\n    scratch = File.exist?(SCRATCH) ? File.read(SCRATCH) : ''\r\n    return 1 if scratch.strip.empty? && rows.empty?\r\n\r\n    0\r\n  end\r\nend\r\n"]
[38.420653, "o", "\u001b[?2004h"]
[38.420855, "o", "root@babb99f66bb1:/app# "]
[39.363092, "i", "printf '%s\\n' '--- timestamps ---'; find /app/snapurn/seals -maxdepth 1 -mindepth 1 -type d -printf '%T@ %p\\n' | sort -n; printf '%s\\n' '--- byte comparisons to n1 ---'; find /app/livefold -type f -printf '%P\\n' | sort | while read -r p; do if [ -f \"/app/snapurn/seals/n1/$p\" ] && cmp -s \"/app/livefold/$p\" \"/app/snapurn/seals/n1/$p\"; then echo \"SAME $p\"; else echo \"DIFF $p\"; fi; done; printf '%s\\n' '--- hashes ---'; sha256sum /app/livefold/* /app/livefold/*/* /app/snapurn/seals/n1/* /app/snapurn/seals/n1/*/* 2>/dev/null; printf '%s\\n' '--- current artifacts ---'; cat /app/inkvat/delta.lst /app/inkvat/pick.json 2>/dev/null; od -An -tx1 -v /app/inkvat/sieve.bin 2>/dev/null\n"]
