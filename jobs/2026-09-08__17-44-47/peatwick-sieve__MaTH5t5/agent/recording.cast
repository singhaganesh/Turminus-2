[74.521476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.521634, "o", "    File.write(ROSTER, JSON.generate({ 'rows' => rows }) + \"\\n\")\r\n\u001b[?2004l\r"]
[74.521675, "o", "\u001b[?2004h"]
