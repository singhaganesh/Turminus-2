[74.520348, "o", "> "]
[74.520485, "o", "    tokens = File.exist?(SCRATCH) ? File.read(SCRATCH).split : []\r\n\u001b[?2004l\r"]
[74.520502, "o", "\u001b[?2004h"]
[74.520552, "o", "> "]
[74.520594, "o", "    maps = Sheets.load\r\n\u001b[?2004l\r"]
[74.520635, "o", "\u001b[?2004h> "]
[74.520838, "o", "    rows = tokens.map { |token| token.sub(/\\A(?:live|seal):/, '') }.uniq.sort.filter_map do |rel|\r\n\u001b[?2004l\r"]
[74.520881, "o", "\u001b[?2004h> "]
[74.521007, "o", "      assays = maps.fetch(rel, []).uniq.sort\r\n\u001b[?2004l\r"]
[74.521052, "o", "\u001b[?2004h"]
[74.521092, "o", "> "]
[74.521133, "o", "      next if assays.empty?\r\n\u001b[?2004l\r"]
[74.521181, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[74.521221, "o", "\u001b[?2004h> "]
[74.52134, "o", "      { 'path' => \"live:#{rel}\", 'assays' => assays }\r\n\u001b[?2004l\r"]
