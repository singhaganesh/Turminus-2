[38.22736, "i", "for f in /app/codemill/tablegen/{driver,roster_read,ast_read,guard,publish}.py; do echo \"--- $f ---\"; nl -ba \"$f\"; done; echo '--- notes ---'; nl -ba /app/faultdata/ops_notes.txt; echo '--- README ---'; cat /app/faultdata/README\n"]
[38.228326, "o", "for f in /app/codemill/tablegen/{driver,roster_read,ast_read,guard,publish}.py; do echo \"--- $f ---\"; nl -ba \"$f\"; done; echo '--- notes ---'; nl -ba /app/faultdata/ops_notes.txt; echo '--- README ---'; cat /app/faultdata/README\r\n\u001b[?2004l\r"]
[38.228802, "o", "--- /app/codemill/tablegen/driver.py ---\r\n"]
[38.22982, "o", "     1\t\"\"\"Compile driver.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport sys\r\n     6\t\r\n     7\tfrom codemill.tablegen.publish import emit_map\r\n     8\t\r\n     9\t\r\n    10\tdef run_tablegen() -> int:\r\n    11\t    emit_map()\r\n    12\t    print(\"tablegen done\", file=sys.stderr)\r\n    13\t    return 0\r\n"]
[38.230547, "o", "--- /app/codemill/tablegen/roster_read.py ---\r\n"]
[38.231596, "o", "     1\t\"\"\"Read fault roster TOML.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport tomllib\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tROSTER = Path(\"/app/faultdata/roster.toml\")\r\n     9\t\r\n    10\t\r\n    11\t"]
[38.231797, "o", "def load_pairs(path: Path | None = None) -> list[tuple[str, str]]:\r\n    12\t    src = path or ROSTER\r\n    13\t    doc = tomllib.loads(src.read_text())\r\n    14\t    pairs: list[tuple[str, str]] = []\r\n    15\t    for row in doc.get(\"roster\", {}).get(\"signatures\", []):\r\n    16\t        sig = str(row.get(\"id\", \"\")).strip().upper()\r\n    17\t        team = str(row.get(\"owner\", \"\")).strip()\r\n    18\t        if sig and team:\r\n    19\t            pairs.append((sig, team))\r\n    20\t    if not pairs:\r\n    21\t        raise ValueError(\"empty roster\")\r\n    22\t    return pairs\r\n"]
[38.23193, "o", "--- /app/codemill/tablegen/ast_read.py ---\r\n"]
[38.232774, "o", "     1\t\"\"\"AST helpers for generated maps.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport ast\r\n     6\tfrom typing import Dict\r\n"]
[38.232888, "o", "     7\t\r\n     8\t\r\n     9\tdef read_map_literal(text: str) -> Dict[str, str]:\r\n    10\t    tree = ast.parse(text)\r\n    11\t    for node in tree.body:\r\n    12\t        if isinstance(node, ast.Assign):\r\n    13\t            for target in node.targets:\r\n    14\t                if isinstance(target, ast.Name) and target.id == \"SIGNATURE_OWNERS\":\r\n    15\t                    raw = ast.literal_eval(node.value)\r\n    16\t                    if not isinstance(raw, dict):\r\n    17\t                        raise ValueError(\"not a dict\")\r\n    18\t                    return {str(k): str(v) for k, v in raw.items()}\r\n    19\t    raise ValueError(\"SIGNATURE_OWNERS not found\")\r\n"]
[38.233303, "o", "--- /app/codemill/tablegen/guard.py ---\r\n"]
[38.234588, "o", "     1\t\"\"\"Skip-if-unchanged guard for routing map writes.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n     7\tfrom codemill.tablegen.ast_read import read_map_literal\r\n     8\t\r\n     9\t\r\n    10\tdef should_emit(path: Path, fresh_body: str) -> bool:\r\n    11\t    if not path.exists():\r\n    12\t        return True\r\n    13\t    try:\r\n    14\t        on_disk = read_map_literal(path.read_text())\r\n    15\t    except (SyntaxError, ValueError):\r\n    16\t        on_disk = None\r\n    17\t    if on_disk is None:\r\n    18\t        return False\r\n    19\t    return on_disk == read_map_literal(fresh_body)\r\n"]
[38.235005, "o", "--- /app/codemill/tablegen/publish.py ---\r\n"]
[38.236363, "o", "     1\t\"\"\"Write routing_map.py from roster rows.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n     7\tfrom codemill.tablegen.guard import should_emit\r\n     8\tfrom codemill.tablegen.roster_read import load_pairs\r\n     9\t\r\n    10\tOUT = Path(\"/app/relaydesk/gen/routing_map.py\")\r\n    11\t\r\n    12\t\r\n    13\tdef build_source(rows: list[tuple[str, str]]) -> str:\r\n    14\t    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"OWNERS = {\"]\r\n    15\t    for sig, team in sorted(rows):\r\n    16\t        lines.append(f'    \"{sig}\": \"{team}\",')\r\n    17\t    lines.append(\"}\")\r\n    18\t    lines.append(\"\")\r\n    19\t    return \"\\n\".join(lines)\r\n    20\t\r\n    21\t\r\n    22\tdef emit_map(path: Path | None = None) -> bool:\r\n"]
[38.236599, "o", "    23\t    target = path or OUT\r\n    24\t    target.parent.mkdir(parents=True, exist_ok=True)\r\n    25\t    body = build_source(load_pairs())\r\n    26\t    if not should_emit(target, body):\r\n    27\t        return False\r\n    28\t    target.write_text(body)\r\n    29\t    return True\r\n"]
[38.237053, "o", "--- notes ---\r\n"]
[38.239036, "o", "     1\tRelay operations notes\r\n     2\t========================\r\n     3\t\r\n     4\t`/app/bin/crashrail compile` renders `/app/relaydesk/gen/routing_map.py` from\r\n     5\t`/app/faultdata/roster.toml`. Tablegen walks the roster twice, so a full compile\r\n     6\tpass takes about ten seconds on this bench.\r\n     7\t\r\n     8\tThe switchboard imports that module at route time. When import fails, every\r\n     9\tsignature answers as `platform-core` with `source: default` even though compile\r\n    10\texits zero.\r\n    11\t\r\n    12\tAdjust the codemill tablegen sources so compile emits an importable map, then\r\n    13\trerun compile before routing checks.\r\n"]
[38.239336, "o", "--- README ---\r\n"]
[38.2403, "o", "Fault roster for relay routing.\r\n"]
[38.240524, "o", "\u001b[?2004hroot@6646b60bfc43:/app# "]
[64.912557, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/codemill/tablegen/roster_read.py')\ns = p.read_text().replace('sig = str(row.get(\"id\", \"\")).strip().upper()', 'sig = str(row.get(\"id\", \"\")).strip()')\np.write_text(s)\n\np = Path('/app/codemill/tablegen/publish.py')\np.write_text('''\"\"\"Write routing_map.py from roster rows.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\n\nfrom codemill.tablegen.guard import should_emit\nfrom codemill.tablegen.roster_read import load_pairs\n\nOUT = Path(\"/app/relaydesk/gen/routing_map.py\")\n\n\ndef build_source(rows: list[tuple[str, str]]) -> str:\n    \"\"\"Render all roster rows as an importable Python mapping.\"\"\"\n    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"SIGNATURE_OWNERS = {\"]\n    for sig, team in sorted(rows):\n        lines.append(f\"    {sig!r}: {team!r},\")\n    lines.extend((\"}\", \"\"))\n    return \"\\\\n\".join(lines)\n\n\ndef emit_map(path: Path | None = None) -> bool:\n    target = path or OUT\n    target.parent.mkdir(parents=True, exist_ok=True)\n    body = build_source(load_pairs())\n    if not should_emit(target, body):\n        return False\n\n    # Publish atomically so route processes never observe a partial module.\n    temporary = target.with_name(f\".{target.name}.tmp\")\n    try:\n        temporary.write_text(body)\n        os.replace(temporary, target)\n    finally:\n        temporary.unlink(missing_ok=True)\n    return True\n''')\n\np = Path('/app/codemill/tablegen/guard.py')\ns = p.read_text()\ns = s.replace('''    if on_disk is None:\n        return False\n    return on_disk == read_map_literal(fresh_body)\n''', '''    if on_disk is None:\n        return True\n    return on_disk != read_map_literal(fresh_body)\n''')\np.write_text(s)\n\np = Path('/app/relaydesk/switchboard/direct.py')\ns = p.read_text().replace('''    text = sig.strip().upper()\n    return text[4:]\n''', '''    return sig.strip()\n''')\np.write_text(s)\nPY\n/app/bin/crashrail compile; echo compile_rc=$?\nprintf '\\n--- generated ---\\n'; cat /app/relaydesk/gen/routing_map.py\npython3 - <<'PY'\nimport tomllib\nfrom pathlib import Path\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nroster = tomllib.loads(Path('/app/faultdata/roster.toml').read_text())['roster']['signatures']\nexpected = {row['id']: row['owner'] for row in roster}\nprint('expected:', expected)\nprint('generated:', SIGNATURE_OWNERS)\nassert SIGNATURE_OWNERS == expected\nprint('complete importable table: OK')\nPY\n"]
[64.912933, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
