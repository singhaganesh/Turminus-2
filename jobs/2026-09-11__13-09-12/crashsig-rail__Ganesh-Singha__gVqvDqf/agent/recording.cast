[79.081446, "i", "python3 - <<'PY'\nimport tempfile\nfrom pathlib import Path\nfrom codemill.tablegen.ast_read import read_map_literal\nfrom codemill.tablegen.publish import emit_map\nfrom codemill.tablegen.roster_read import load_pairs\n\nexpected = dict(load_pairs())\nwith tempfile.TemporaryDirectory() as directory:\n    target = Path(directory) / 'routing_map.py'\n    for label, content in (\n        ('invalid', 'SIGNATURE_OWNERS = { this is invalid'),\n        ('incomplete', \"SIGNATURE_OWNERS = {'SIG_NULL_DEREF_81c2': 'graphics-guild'}\\n\"),\n    ):\n        target.write_text(content)\n        assert emit_map(target) is True\n        assert read_map_literal(target.read_text()) == expected\n        compile(target.read_text(), str(target), 'exec')\n        print(f'{label} map repair: OK')\n    assert emit_map(target) is False\n    print('unchanged map skip: OK')\nPY\npython3 -m py_compile /app/codemill/tablegen/*.py /app/relaydesk/switchboard/*.py /app/relaydesk/gen/routing_map.py\n/app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; echo required_route_rc=$?\n"]
