[65.087214, "o", "\"\"\"Generated routing map. Do not edit.\"\"\"\r\n\r\nSIGNATURE_OWNERS = {\r\n    'SIG_AUTH_LOOP_22bd': 'identity-ring',\r\n    'SIG_HEAP_OOM_7a3f': 'memory-squad',\r\n    'SIG_IO_TIMEOUT_4f91': 'storage-cell',\r\n    'SIG_NET_RESET_9e04': 'network-desk',\r\n    'SIG_NULL_DEREF_81c2': 'graphics-guild',\r\n}\r\n"]
