[65.153787, "o", "\u001b[?2004hroot@6646b60bfc43:/app# "]
[65.961693, "i", "python3 - <<'PY'\nimport json\nimport subprocess\nimport tomllib\nfrom pathlib import Path\nrows = tomllib.loads(Path('/app/faultdata/roster.toml').read_text())['roster']['signatures']\nfor row in rows:\n    proc = subprocess.run(['/app/bin/crashrail', 'route', '--signature', row['id']], text=True, capture_output=True)\n    data = json.loads(proc.stdout)\n    print(row['id'], proc.returncode, data)\n    assert proc.returncode == 0\n    assert data == {'team': row['owner'], 'source': 'table'}\nproc = subprocess.run(['/app/bin/crashrail', 'route', '--signature', 'SIG_UNKNOWN_FFFF'], text=True, capture_output=True)\ndata = json.loads(proc.stdout)\nprint('SIG_UNKNOWN_FFFF', proc.returncode, data)\nassert proc.returncode != 0\nassert data == {'team': 'platform-core', 'source': 'default'}\nprint('routing checks: OK')\nPY\n"]
[65.966783, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> import tomllib\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> rows = tomllib.loads(Path('/app/faultdata/roster.toml').read_text())['roster']['signatures']\r\n\u001b[?2004l\r\u001b[?2004h> for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h>     proc = subprocess.run(['/app/bin/crashrail', 'route', '--signature', row['id']], text=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h>     data = json.loads(proc.stdout)\r\n\u001b[?2004l\r\u001b[?2004h>     print(row['id'], proc.returncode, data)\r\n\u001b[?2004l\r\u001b[?2004h>     assert proc.returncode == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert data == {'team': row['owner'], 'source': 'table'}\r\n\u001b[?2004l\r\u001b[?2004h> proc = subprocess.run(['/app/bin/crashrail', 'route', '--signature', 'SIG_UNKNOWN_FFFF'], text=True, capture_output=True)\r\n\u001b[?2004l\r\u001b[?2004h> data = json.loads(proc.stdout)\r\n\u001b[?2004l\r\u001b[?2004h> print('SIG_UNKNOWN_FFFF', proc.returncode, data)\r\n\u001b[?2004l\r\u001b[?2004h> assert proc.returncode != 0\r\n\u001b[?2004l\r\u001b[?2004h> assert data == {'team': 'platform-core', 'source': 'default'}\r\n\u001b[?2004l\r\u001b[?2004h> print('routing checks: OK')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[66.211664, "o", "SIG_NULL_DEREF_81c2 0 {'team': 'graphics-guild', 'source': 'table'}\r\n"]
[66.342796, "o", "SIG_IO_TIMEOUT_4f91 0 {'team': 'storage-cell', 'source': 'table'}\r\n"]
[66.499929, "o", "SIG_AUTH_LOOP_22bd 0 {'team': 'identity-ring', 'source': 'table'}\r\n"]
[66.633115, "o", "SIG_NET_RESET_9e04 0 {'team': 'network-desk', 'source': 'table'}\r\n"]
[66.756366, "o", "SIG_HEAP_OOM_7a3f 0 {'team': 'memory-squad', 'source': 'table'}\r\n"]
