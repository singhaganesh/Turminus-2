[25.186524, "o", "--- cli_entry.py ---\r\n"]
[25.188939, "o", "     1\t\"\"\"Crashrail command-line front door.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport argparse\r\n     6\timport json\r\n     7\t\r\n     8\tfrom codemill.tablegen.driver import run_tablegen\r\n     9\tfrom relaydesk.switchboard.direct import direct\r\n"]
[25.189335, "o", "    10\t\r\n    11\t\r\n    12\tdef main(argv: list[str] | None = None) -> int:\r\n    13\t    parser = argparse.ArgumentParser(prog=\"crashrail\")\r\n    14\t    sub = parser.add_subparsers(dest=\"cmd\", required=True)\r\n    15\t\r\n    16\t    route = sub.add_parser(\"route\")\r\n    17\t    route.add_argument(\"--signature\", required=True)\r\n    18\t\r\n    19\t    sub.add_parser(\"compile\")\r\n    20\t\r\n    21\t    args = parser.parse_args(argv)\r\n    22\t    if args.cmd == \"compile\":\r\n    23\t        return run_tablegen()\r\n    24\t    if args.cmd == \"route\":\r\n    25\t        team, source = direct(args.signature)\r\n    26\t        print(json.dumps({\"team\": team, \"source\": source}))\r\n    27\t        return 1 if source == \"default\" else 0\r\n    28\t    return 2\r\n    29\t\r\n    30\t\r\n    31\tif __name__ == \"__main__\":\r\n    32\t    raise SystemExit(main())\r\n"]
[25.190969, "o", "--- direct.py ---\r\n     1\t\"\"\"Signature to team routing.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\r\n     6\t\r\n     7\t\r\n     8\tdef normalize(sig: str) -> str:\r\n     9\t    text = sig.strip().upper()\r\n    10\t    return text[4:]\r\n    11\t\r\n    12\t\r\n    13\tdef direct(sig: str) -> tuple[str, str]:\r\n    14\t    table = fetch_map()\r\n    15\t    key = normalize(sig)\r\n    16\t    if key in table:\r\n    17\t        return table[key], \"table\"\r\n    18\t    return DEFAULT_TEAM, \"default\"\r\n--- load_map.py ---\r\n"]
[25.191842, "o", "     1\t\"\"\"Load generated routing maps.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom typing import Dict\r\n     6\t\r\n     7\tDEFAULT_TEAM = \"platform-core\"\r\n     8\t\r\n     9\t\r\n"]
[25.191968, "o", "    10\tdef fetch_map() -> Dict[str, str]:\r\n    11\t    try:\r\n    12\t        from relaydesk.gen.routing_map import SIGNATURE_OWNERS\r\n    13\t    except Exception:\r\n    14\t        return {}\r\n    15\t    if not isinstance(SIGNATURE_OWNERS, dict):\r\n    16\t        return {}\r\n    17\t    return {str(k): str(v) for k, v in SIGNATURE_OWNERS.items()}\r\n"]
[25.192127, "o", "--- init files ---\r\n"]
[25.193005, "o", "     1\t\"\"\"Switchboard routing.\"\"\"\r\n"]
[25.193921, "o", "     1\t\"\"\"Generated routing map package.\"\"\"\r\n"]
[25.194915, "o", "     1\t\"\"\"Relay desk crash routing.\"\"\"\r\n"]
