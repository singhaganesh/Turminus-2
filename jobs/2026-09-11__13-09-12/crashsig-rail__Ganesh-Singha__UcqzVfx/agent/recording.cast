[100.485499, "o", "\"\"\"Generated routing map. Do not edit.\"\"\"\r\n\r\nSIGNATURE_OWNERS = {\r\n    'SIG_AUTH_LOOP_22BD': 'identity-ring',\r\n    'SIG_HEAP_OOM_7A3F': 'memory-squad',\r\n    'SIG_IO_TIMEOUT_4F91': 'storage-cell',\r\n    'SIG_NET_RESET_9E04': 'network-desk',\r\n    'SIG_NULL_DEREF_81C2': 'graphics-guild',\r\n}\r\n"]
[100.485815, "o", "\u001b[?2004hroot@a38c53ea62d2:/app# "]
[101.386786, "i", "python3 -m py_compile /app/codemill/tablegen/*.py /app/relaydesk/switchboard/*.py /app/relaydesk/gen/routing_map.py && python3 - <<'PY'\nimport tomllib\nfrom pathlib import Path\nfrom relaydesk.gen.routing_map import SIGNATURE_OWNERS\nroster = tomllib.loads(Path('/app/faultdata/roster.toml').read_text())['roster']\nexpected = {row['id'].strip().upper(): row['owner'].strip() for row in roster['signatures']}\nassert SIGNATURE_OWNERS == expected, (SIGNATURE_OWNERS, expected)\nassert SIGNATURE_OWNERS['SIG_NULL_DEREF_81C2'] == 'graphics-guild'\nprint(f'validated exact coverage of {len(expected)} roster signatures')\nPY\n/app/bin/crashrail route --signature SIG_NULL_DEREF_81c2; printf 'known_rc=%s\\n' \"$?\"; set +e; /app/bin/crashrail route --signature SIG_UNKNOWN_FFFF; rc=$?; set -e; printf 'unknown_rc=%s\\n' \"$rc\"; test \"$rc\" -ne 0\n"]
[101.387639, "o", "python3 -m py_compile /app/codemill/tablegen/*.py /app/relaydesk/switchboard/*.py /app/relaydesk/gen/routing_map.py && python3 - <<'PY'\r\n"]
