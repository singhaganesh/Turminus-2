[47.908967, "i", "printf '%s\\n' '--- cli_entry.py ---'; nl -ba /app/relaydesk/cli_entry.py; printf '%s\\n' '--- direct.py ---'; nl -ba /app/relaydesk/switchboard/direct.py; printf '%s\\n' '--- load_map.py ---'; nl -ba /app/relaydesk/switchboard/load_map.py; printf '%s\\n' '--- init files ---'; nl -ba /app/relaydesk/switchboard/__init__.py; nl -ba /app/relaydesk/__init__.py; printf '%s\\n' '--- notes/readme ---'; cat /app/faultdata/README /app/faultdata/ops_notes.txt\n"]
[47.910466, "o", "printf '%s\\n' '--- cli_entry.py ---'; nl -ba /app/relaydesk/cli_entry.py; printf '%s\\n' '--- direct.py ---'; nl -ba /app/relaydesk/switchboard/direct.py; printf '%s\\n' '--- load_map.py ---'; nl -ba /app/relaydesk/switchboard/load_map.py; printf '%s\\n' '--- init files ---'; nl -ba /app/relaydesk/switchboard/__init__.py; nl -ba /app/relaydesk/__init__.py; printf '%s\\n' '--- notes/readme ---'; cat /app/faultdata/README /app/faultdata/ops_notes.txt\r\n\u001b[?2004l\r"]
[47.910736, "o", "--- cli_entry.py ---\r\n"]
[47.911795, "o", "     1\t\"\"\"Crashrail command-line front door.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport argparse\r\n     6\timport json\r\n     7\t\r\n     8\tfrom codemill.tablegen.driver import run_tablegen\r\n     9\tfrom relaydesk.switchboard.direct import direct\r\n    10\t\r\n    11\t\r\n"]
[47.911927, "o", "    12\tdef main(argv: list[str] | None = None) -> int:\r\n    13\t    parser = argparse.ArgumentParser(prog=\"crashrail\")\r\n    14\t    sub = parser.add_subparsers(dest=\"cmd\", required=True)\r\n    15\t\r\n    16\t    route = sub.add_parser(\"route\")\r\n    17\t    route.add_argument(\"--signature\", required=True)\r\n    18\t\r\n    19\t    sub.add_parser(\"compile\")\r\n    20\t\r\n    21\t    args = parser.parse_args(argv)\r\n    22\t    if args.cmd == \"compile\":\r\n    23\t        return run_tablegen()\r\n    24\t    if args.cmd == \"route\":\r\n    25\t        team, source = direct(args.signature)\r\n    26\t        print(json.dumps({\"team\": team, \"source\": source}))\r\n    27\t        return 1 if source == \"default\" else 0\r\n    28\t    return 2\r\n    29\t\r\n    30\t\r\n    31\tif __name__ == \"__main__\":\r\n    32\t    raise SystemExit(main())\r\n"]
[47.912047, "o", "--- direct.py ---\r\n"]
[47.913018, "o", "     1\t\"\"\"Signature to team routing.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom relaydesk.switchboard.load_map import DEFAULT_TEAM, fetch_map\r\n     6\t\r\n     7\t\r\n     8\tdef normalize(sig: str) -> str:\r\n     9\t    text = sig.strip().upper()\r\n"]
[47.913114, "o", "    10\t    return text[4:]\r\n    11\t\r\n    12\t\r\n    13\tdef direct(sig: str) -> tuple[str, str]:\r\n    14\t    table = fetch_map()\r\n    15\t    key = normalize(sig)\r\n    16\t    if key in table:\r\n    17\t        return table[key], \"table\"\r\n    18\t    return DEFAULT_TEAM, \"default\"\r\n"]
[47.91323, "o", "--- load_map.py ---\r\n"]
[47.914201, "o", "     1\t\"\"\"Load generated routing maps.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom typing import Dict"]
[47.91436, "o", "\r\n     6\t\r\n     7\tDEFAULT_TEAM = \"platform-core\"\r\n     8\t\r\n     9\t\r\n    10\tdef fetch_map() -> Dict[str, str]:\r\n    11\t    try:\r\n    12\t        from relaydesk.gen.routing_map import SIGNATURE_OWNERS\r\n    13\t    except Exception:\r\n    14\t        return {}\r\n    15\t    if not isinstance(SIGNATURE_OWNERS, dict):\r\n    16\t        return {}\r\n    17\t    return {str(k): str(v) for k, v in SIGNATURE_OWNERS.items()}\r\n"]
[47.914577, "o", "--- init files ---\r\n"]
[47.915539, "o", "     1\t\"\"\"Switchboard routing.\"\"\"\r\n"]
[47.916711, "o", "     1\t\"\"\"Relay desk crash routing.\"\"\"\r\n"]
[47.916896, "o", "--- notes/readme ---\r\n"]
[47.917935, "o", "Fault roster for relay routing.\r\n"]
[47.918067, "o", "Relay operations notes\r\n========================\r\n\r\n`/app/bin/crashrail compile` renders `/app/relaydesk/gen/routing_map.py` from\r\n`/app/faultdata/roster.toml`. Tablegen walks the roster twice, so a full compile\r\npass takes about ten seconds on this bench.\r\n\r\nThe switchboard imports that module at route time. When import fails, every\r\nsignature answers as `platform-core` with `source: default` even though compile\r\nexits zero.\r\n\r\nAdjust the codemill tablegen sources so compile emits an importable map, then\r\nrerun compile before routing checks.\r\n"]
[47.918252, "o", "\u001b[?2004h"]
[47.918343, "o", "root@a38c53ea62d2:/app# "]
[48.108963, "i", "grep -RIn --exclude-dir=probes -E 'tablegen|toml|compile|OWNERS|open\\(|write_text|routing' /app/relaydesk /app/bin 2>/dev/null\n"]
[48.109457, "o", "grep -RIn --exclude-dir=probes -E 'tablegen|toml|compile|OWNERS|open\\(|write_text|routing' /app/relaydesk /app/bin 2>/dev/null\r\n\u001b[?2004l\r"]
