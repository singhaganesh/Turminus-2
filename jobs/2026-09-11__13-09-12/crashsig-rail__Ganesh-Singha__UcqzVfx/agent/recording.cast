[66.924653, "i", "python3 - <<'PY'\nimport codemill, codemill.tablegen.driver\nprint('codemill:', codemill.__file__)\nprint('driver:', codemill.tablegen.driver.__file__)\nPY\n"]
[66.924833, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[66.924914, "o", "\u001b[?2004h> "]
[66.9251, "o", "import codemill, codemill.tablegen.driver\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.925221, "o", "print('codemill:', codemill.__file__)\r\n\u001b[?2004l\r"]
[66.925318, "o", "\u001b[?2004h> "]
[66.925382, "o", "print('driver:', codemill.tablegen.driver.__file__)\r\n\u001b[?2004l\r"]
[66.925538, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[67.010915, "o", "codemill: /app/codemill/__init__.py\r\ndriver: /app/codemill/tablegen/driver.py\r\n"]
[67.026546, "o", "\u001b[?2004hroot@a38c53ea62d2:/app# "]
[67.111033, "i", "CODEMILL=$(python3 -c 'import pathlib,codemill; print(pathlib.Path(codemill.__file__).parent)'); find \"$CODEMILL\" -maxdepth 4 -type f -not -path '*/__pycache__/*' -print -exec sh -c 'echo \"--- $1\"; nl -ba \"$1\"' _ {} \\;\n"]
[67.111851, "o", "CODEMILL=$(python3 -c 'import pathlib,codemill; print(pathlib.Path(codemill.__file__).parent)'); find \"$CODEMILL\" -maxdepth 4 -type f -not -path '*/__pycache__/*' -print -exec sh -c 'echo \"--- $1\"; nl -ba \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[67.175256, "o", "/app/codemill/__init__.py\r\n"]
[67.176975, "o", "--- /app/codemill/__init__.py\r\n"]
[67.178333, "o", "     1\t\"\"\"Table generation from roster data.\"\"\"\r\n"]
[67.179147, "o", "/app/codemill/tablegen/ast_read.py\r\n"]
[67.180615, "o", "--- /app/codemill/tablegen/ast_read.py\r\n"]
[67.181547, "o", "     1\t\"\"\"AST helpers for generated maps.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport ast\r\n     6\tfrom typing import Dict\r\n     7\t\r\n     8\t\r\n     9\tdef read_map_literal(text: str) -> Dict[str, str]:\r\n    10\t    tree = ast.parse(text)\r\n    11\t    for node in tree.body:\r\n    12\t        if isinstance(node, ast.Assign):\r\n    13\t            for target in node.targets:\r\n    14\t                if isinstance(target, ast.Name) and target.id == \"SIGNATURE_OWNERS\":\r\n    15\t                    raw = ast.literal_eval(node.value)\r\n    16\t                    if not isinstance(raw, dict):\r\n    17\t                        raise ValueError(\"not a dict\")\r\n    18\t                    return {str(k): str(v) for k, v in raw.items()}\r\n    19\t    raise ValueError(\"SIGNATURE_OWNERS not found\")\r\n"]
[67.182094, "o", "/app/codemill/tablegen/publish.py\r\n"]
[67.183473, "o", "--- /app/codemill/tablegen/publish.py\r\n"]
[67.185099, "o", "     1\t\"\"\"Write routing_map.py from roster rows.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n     7\tfrom codemill.tablegen.guard import should_emit\r\n     8\tfrom codemill.tablegen.roster_read import load_pairs\r\n     9\t\r\n    10\tOUT = Path(\"/app/relaydesk/gen/routing_map.py\")\r\n    11\t\r\n    12\t\r\n    13\tdef build_source(rows: list[tuple[str, str]]) -> str:\r\n    14\t    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"OWNERS = {\"]\r\n    15\t    for sig, team in sorted(rows):\r\n    16\t        lines.append(f'    \"{sig}\": \"{team}\",')\r\n    17\t    lines.append(\"}\")\r\n    18\t    lines.append(\"\")\r\n    19\t    return \"\\n\".join(lines)\r\n    20\t\r\n    21\t\r\n    22\tdef emit_map(path: Path | None = None) -> bool:\r\n    23\t    target = path or OUT\r\n    24\t    target.parent.mkdir(parents=True, exist_ok=True)\r\n    25\t    body = build_source(load_pairs())\r\n    26\t    if not should_emit(target, body):\r\n    27\t        return False\r\n    28\t    target.write_text(body)\r\n    29\t    return True\r\n"]
[67.185977, "o", "/app/codemill/tablegen/driver.py\r\n"]
[67.187869, "o", "--- /app/codemill/tablegen/driver.py\r\n"]
[67.18946, "o", "     1\t\"\"\"Compile driver.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport sys\r\n     6\t\r\n     7\tfrom codemill.tablegen.publish import emit_map\r\n     8\t\r\n     9\t\r\n    10\tdef run_tablegen() -> int:\r\n    11\t    emit_map()\r\n    12\t    print(\"tablegen done\", file=sys.stderr)\r\n    13\t    return 0\r\n"]
[67.190007, "o", "/app/codemill/tablegen/guard.py\r\n"]
[67.19132, "o", "--- /app/codemill/tablegen/guard.py\r\n"]
[67.19319, "o", "     1\t\"\"\"Skip-if-unchanged guard for routing map writes.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n     7\tfrom codemill.tablegen.ast_read import read_map_literal\r\n     8\t\r\n     9\t\r\n    10\tdef should_emit(path: Path, fresh_body: str) -> bool:\r\n    11\t    if not path.exists():\r\n    12\t        return True\r\n    13\t    try:\r\n    14\t        on_disk = read_map_literal(path.read_text())\r\n    15\t    except (SyntaxError, ValueError):\r\n    16\t        on_disk = None\r\n    17\t    if on_disk is None:\r\n    18\t        return False\r\n    19\t    return on_disk == read_map_literal(fresh_body)\r\n"]
[67.193574, "o", "/app/codemill/tablegen/__init__.py\r\n"]
[67.195511, "o", "--- /app/codemill/tablegen/__init__.py\r\n"]
[67.196693, "o", "     1\t\"\"\"Roster-driven routing table compiler.\"\"\"\r\n"]
[67.197186, "o", "/app/codemill/tablegen/roster_read.py\r\n"]
[67.198539, "o", "--- /app/codemill/tablegen/roster_read.py\r\n"]
[67.199873, "o", "     1\t\"\"\"Read fault roster TOML.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport tomllib\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tROSTER = Path(\"/app/faultdata/roster.toml\")\r\n     9\t\r\n    10\t\r\n    11\tdef load_pairs(path: Path | None = None) -> list[tuple[str, str]]:\r\n    12\t    src = path or ROSTER\r\n    13\t    doc = tomllib.loads(src.read_text())\r\n    14\t    pairs: list[tuple[str, str]] = []\r\n    15\t    for row in doc.get(\"roster\", {}).get(\"signatures\", []):\r\n    16\t        sig = str(row.get(\"id\", \"\")).strip().upper()\r\n    17\t        team = str(row.get(\"owner\", \"\")).strip()\r\n    18\t        if sig and team:\r\n    19\t            pairs.append((sig, team))\r\n"]
[67.199994, "o", "    20\t    if not pairs:\r\n    21\t        raise ValueError(\"empty roster\")\r\n    22\t    return pairs\r\n"]
[67.201561, "o", "\u001b[?2004hroot@a38c53ea62d2:/app# "]
[67.4716, "i", "python3 - <<'PY'\nimport sys\nprint('\\n'.join(sys.path))\ntry:\n import tomllib\n print('tomllib available')\nexcept ImportError:\n print('tomllib unavailable')\nPY\n"]
[67.472542, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> print('\\n'.join(sys.path))\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>  import tomllib\r\n\u001b[?2004l\r\u001b[?2004h>  print('tomllib available')\r\n\u001b[?2004l\r\u001b[?2004h> except ImportError:\r\n\u001b[?2004l\r\u001b[?2004h>  print('tomllib unavailable')\r\n\u001b[?2004l\r\u001b[?2004h> PY"]
[67.472586, "o", "\r\n\u001b[?2004l\r"]
[67.510716, "o", "\r\n/app\r\n/usr/local/lib/python313.zip\r\n/usr/local/lib/python3.13\r\n/usr/local/lib/python3.13/lib-dynload\r\n/usr/local/lib/python3.13/site-packages\r\n"]
[67.54751, "o", "tomllib available\r\n"]
[67.561876, "o", "\u001b[?2004hroot@a38c53ea62d2:/app# "]
[100.107781, "i", "cat > /app/codemill/tablegen/publish.py <<'PY'\n\"\"\"Write routing_map.py from roster rows.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport tempfile\nfrom pathlib import Path\n\nfrom codemill.tablegen.guard import should_emit\nfrom codemill.tablegen.roster_read import load_pairs\n\nOUT = Path(\"/app/relaydesk/gen/routing_map.py\")\n\n\ndef build_source(rows: list[tuple[str, str]]) -> str:\n    lines = ['\"\"\"Generated routing map. Do not edit.\"\"\"', \"\", \"SIGNATURE_OWNERS = {\"]\n    for sig, team in sorted(rows):\n        lines.append(f\"    {sig!r}: {team!r},\")\n    lines.append(\"}\")\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\ndef emit_map(path: Path | None = None) -> bool:\n    \"\"\"Render the complete roster and atomically publish it when needed.\"\"\"\n    target = path or OUT\n    target.parent.mkdir(parents=True, exist_ok=True)\n    body = build_source(load_pairs())\n    if not should_emit(target, body):\n        return False\n\n    # Keep the temporary file beside the target so os.replace is atomic.\n    fd, temporary = tempfile.mkstemp(\n        prefix=f\".{target.name}.\", suffix=\".tmp\", dir=target.parent, text=True\n    )\n    try:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as stream:\n            stream.write(body)\n            stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(temporary, target)\n    except BaseException:\n        try:\n            os.unlink(temporary)\n        except FileNotFoundError:\n            pass\n        raise\n    return True\nPY\ncat > /app/codemill/tablegen/guard.py <<'PY'\n\"\"\"Skip-if-unchanged guard for routing map writes.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\n\nfrom codemill.tablegen.ast_read import read_map_literal\n\n\ndef should_emit(path: Path, fresh_body: str) -> bool:\n    \"\"\"Return true unless the existing file has the complete fresh mapping.\"\"\"\n    if not path.exists():\n        return True\n    try:\n        on_disk = read_map_literal(path.read_text(encoding=\"utf-8\"))\n        fresh = read_map_literal(fresh_body)\n    except (OSError, SyntaxError, ValueError, TypeError):\n        return True\n    return on_disk != fresh\nPY\npython3 - <<'PY'\np = '/app/relaydesk/switchboard/direct.py'\ns = open(p, encoding='utf-8').read()\ns = s.replace('    return text[4:]\\n', '    return text\\n')\nopen(p, 'w', encoding='utf-8').write(s)\nPY\n"]
[100.110279, "o", "cat > /app/codemill/tablegen/publish.py <<'PY'\r\n\u001b[?2004l\r"]
