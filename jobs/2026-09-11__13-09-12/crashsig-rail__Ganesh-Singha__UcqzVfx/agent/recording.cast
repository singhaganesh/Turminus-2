[48.111753, "o", "/app/relaydesk/__init__.py:1:\"\"\"Relay desk crash routing.\"\"\"\r\n/app/relaydesk/cli_entry.py:8:from codemill.tablegen.driver import run_tablegen\r\n/app/relaydesk/cli_entry.py:19:    sub.add_parser(\"compile\")\r\n/app/relaydesk/cli_entry.py:22:    if args.cmd == \"compile\":\r\n/app/relaydesk/cli_entry.py:23:        return run_tablegen()\r\n"]
