     1	"""Read fault roster TOML."""
     2	
     3	from __future__ import annotations
     4	
     5	import tomllib
     6	from pathlib import Path
     7	
     8	ROSTER = Path("/app/faultdata/roster.toml")
     9	
    10	
    11	def load_pairs(path: Path | None = None) -> list[tuple[str, str]]:
    12	    src = path or ROSTER
    13	    doc = tomllib.loads(src.read_text())
    14	    pairs: list[tuple[str, str]] = []
    15	    for row in doc.get("roster", {}).get("signatures", []):
    16	        sig = str(row.get("id", "")).strip().upper()
    17	        team = str(row.get("owner", "")).strip()
    18	        if sig and team:
    19	            pairs.append((sig, team))
    20	    if not pairs:
    21	        raise ValueError("empty roster")
    22	    return pairs
