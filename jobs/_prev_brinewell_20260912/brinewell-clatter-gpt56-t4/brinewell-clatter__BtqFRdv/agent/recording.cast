[92.101483, "o", "root@76fa4ad48f00:/app# "]
[92.227541, "i", "cat > /app/deskbin/emit.rs <<'RS'\nuse std::fs;\nuse std::path::Path;\n\nfn fail(code: i32) -> i32 {\n    let _ = fs::create_dir_all(\"/app/kegbay\");\n    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\n    code\n}\nfn read_pairs() -> Vec<(String,u64)> {\n    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default();\n    raw.lines().filter_map(|line| {\n        let mut p=line.split('\\t');\n        Some((p.next()?.to_string(),p.next()?.parse().ok()?))\n    }).collect()\n}\nfn json_string(s: &str) -> String {\n    let mut o=String::from(\"\\\"\");\n    for c in s.chars() {\n        match c { '\"'=>o.push_str(\"\\\\\\\"\"), '\\\\'=>o.push_str(\"\\\\\\\\\"), '\\n'=>o.push_str(\"\\\\n\"), '\\r'=>o.push_str(\"\\\\r\"), '\\t'=>o.push_str(\"\\\\t\"), c if c < ' ' => o.push_str(&format!(\"\\\\u{:04x}\",c as u32)), c=>o.push(c) }\n    }\n    o.push('\"'); o\n}\npub fn finish() -> i32 {\n    let pairs=read_pairs();\n    let names=match crate::fold::rib_c(&pairs,None) { Ok(v)=>v,Err(c)=>return fail(c) };\n    let mut body=String::new();\n    for (i,n) in names.iter().enumerate() {\n        let m=crate::parse::load(n);\n        body.push_str(&format!(\"{}\\t{}\\t{}\\n\",i+1,n,crate::parse::guid_hex(&m.guid)));\n    }\n    if fs::write(\"/app/kegbay/ribbon.txt\",body).is_err() { return fail(1); }\n    0\n}\npub fn pour() -> i32 {\n    let root=std::env::args().nth(2).unwrap_or_else(||\"/app/dropwell\".into());\n    let wanted=match fs::canonicalize(\"/app/dropwell\") { Ok(x)=>x,Err(_)=>return fail(1) };\n    let got=match fs::canonicalize(&root) { Ok(x)=>x,Err(_)=>return fail(1) };\n    if got != wanted { return fail(1); }\n    let pairs=read_pairs();\n    if crate::fold::rib_c(&pairs,Some(&root)).is_err() { return fail(1); }\n    let ribbon=fs::read_to_string(\"/app/kegbay/ribbon.txt\").unwrap_or_default();\n    let mut rows=Vec::new();\n    for line in ribbon.lines() {\n        let p:Vec<&str>=line.split('\\t').collect();\n        if p.len()!=3 { return fail(1); }\n        let seq:u32=match p[0].parse(){Ok(x)=>x,Err(_)=>return fail(1)};\n        let path=p[1];\n        if !Path::new(path).is_file() { return fail(1); }\n        let name=match Path::new(path).file_name().and_then(|x|x.to_str()){Some(x)=>x.to_string(),None=>return fail(1)};\n        let digest=crate::sum::hex_file(path);\n        if digest.len()!=64 { return fail(1); }\n        rows.push((seq,name,digest,p[2].to_string()));\n    }\n    if rows.is_empty() { return fail(1); }\n    let mut json=format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\",(rows.len()+2)/3);\n    for (i,(seq,name,digest,guid)) in rows.iter().enumerate() {\n        if i>0 { json.push(','); }\n        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":{},\\\"digest\\\":{},\\\"guid\\\":{}}}\",seq,json_string(name),json_string(digest),json_string(guid)));\n    }\n    json.push_str(\"]}\\n\");\n    let mut tsv=String::from(\"seq\\tname\\tdigest\\tguid\\n\");\n    for (seq,name,digest,guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\",seq,name,digest,guid)); }\n    if fs::write(\"/app/kegbay/upload.json\",json).is_err() || fs::write(\"/app/kegbay/batch.tsv\",tsv).is_err() { return fail(1); }\n    if fs::write(\"/app/kegbay/MARK\",\"ok\").is_err() { return 1; }\n    0\n}\nRS\nPATH=/usr/local/cargo/bin:$PATH rustc --edition 2021 -O /app/deskbin/main.rs -o /app/bin/clatter\nod -An -tx1 -N4 /app/bin/clatter\n/app/bin/clatter tallow && /app/bin/clatter pour\n"]
