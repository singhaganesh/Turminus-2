[21.610685, "o", "\u001b[?2004l\r===== /app/deskbin/emit.rs =====\r\n"]
[21.613137, "o", "     1\tuse std::fs;\r\n     2\tuse std::path::Path;\r\n     3\t\r\n     4\tfn read_pairs() -> Vec<(String, u64)> {\r\n     5\t    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default();\r\n"]
[21.613363, "o", "     6\t    let mut v = Vec::new();\r\n     7\t    for line in raw.lines() {\r\n     8\t        let mut it = line.split('\\t');\r\n     9\t        if let (Some(n), Some(k)) = (it.next(), it.next()) {\r\n    10\t            if let Ok(u) = k.parse::<u64>() {\r\n    11\t                v.push((n.to_string(), u));\r\n    12\t            }\r\n    13\t        }\r\n    14\t    }\r\n    15\t    v\r\n    16\t}\r\n    17\t\r\n    18\tpub fn finish() -> i32 {\r\n    19\t    let pairs = read_pairs();\r\n    20\t    match crate::fold::rib_c(&pairs, None) {\r\n    21\t        Err(c) => c,\r\n    22\t        Ok(names) => {\r\n    23\t            fs::create_dir_all(\"/app/kegbay\").ok();\r\n    24\t            let mut body = String::new();\r\n    25\t            for (i, n) in names.iter().enumerate() {\r\n    26\t                let m = crate::parse::load(n);\r\n    27\t                body.push_str(&format!(\r\n    28\t                    \"{}\\t{}\\t{}\\n\",\r\n    29\t                    i + 1,\r\n    30\t                    n,\r\n    31\t                    crate::parse::guid_hex(&m.guid)\r\n    32\t                ));\r\n    33\t            }\r\n    34\t            fs::write(\"/app/kegbay/ribbon.txt\", body).ok();\r\n    35\t            0\r\n    36\t        }\r\n    37\t    }\r\n    38\t}\r\n    39\t\r\n    40\tpub fn pour() -> i32 {\r\n    41\t    let arg = std::env::args().nth(2);\r\n    42\t    let root = arg.unwrap_or_else(|| \"/app/dropwell\".to_string());\r\n    43\t    match crate::fold::rib_c(&[], Some(&root)) {\r\n    44\t        Err(c) => {\r\n    45\t            let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n    46\t            return c;\r\n    47\t        }\r\n    48\t        Ok(_) => {}\r\n    49\t    }\r\n    50\t    let ribbon = fs::read_to_string(\"/app/kegbay/ribbon.txt\").unwrap_or_default();\r\n    51\t    let mut rows: Vec<(u32, String, String, String)> = Vec::new();\r\n    52\t    for line in ribbon.lines() {\r\n    53\t        let p: Vec<&str> = line.split('\\t').collect();\r\n    54\t        if p.len() < 3 {\r\n    55\t            continue;\r\n    56\t        }\r\n"]
[21.613582, "o", "    57\t        let seq: u32 = p[0].parse().unwrap_or(0);\r\n    58\t        let name = p[1].to_string();\r\n    59\t        let g = p[2].to_string();\r\n    60\t        let digest = crate::sum::hex_file(&name);\r\n    61\t        rows.push((seq, Path::new(&name).file_name().unwrap().to_string_lossy().to_string(), digest, g));\r\n    62\t    }\r\n    63\t    let n = rows.len();\r\n    64\t    let batches = if n == 0 { 0 } else { (n + 2) / 3 };\r\n    65\t    let mut json = String::from(\"{\\\"batch_count\\\":\");\r\n    66\t    json.push_str(&batches.to_string());\r\n    67\t    json.push_str(\",\\\"entries\\\":[\");\r\n    68\t    for (i, (seq, name, digest, g)) in rows.iter().enumerate() {\r\n    69\t        if i > 0 {\r\n    70\t"]
[21.613721, "o", "            json.push(',');\r\n    71\t        }\r\n    72\t        json.push_str(&format!(\r\n    73\t            \"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",\r\n    74\t            seq, name, digest, g\r\n    75\t        ));\r\n    76\t    }\r\n    77\t    json.push_str(\"]}\\n\");\r\n    78\t    fs::create_dir_all(\"/app/kegbay\").ok();\r\n    79\t    fs::write(\"/app/kegbay/upload.json\", json).ok();\r\n    80\t    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n    81\t    for (seq, name, digest, g) in &rows {\r\n    82\t        tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, g));\r\n    83\t    }\r\n    84\t    fs::write(\"/app/kegbay/batch.tsv\", tsv).ok();\r\n    85\t    fs::write(\"/app/kegbay/MARK\", \"ok\").ok();\r\n    86\t    0\r\n    87\t}\r\n"]
[21.613947, "o", "===== /app/deskbin/main.rs =====\r\n"]
[21.615151, "o", "     1\t#[path = \"parse.rs\"]\r\n     2\tmod parse;\r\n     3\t#[path = \"sum.rs\"]\r\n     4\tmod sum;\r\n     5\t#[path = \"../walk.rs\"]\r\n     6\tmod walk;\r\n     7\t#[path = \"../stamp.rs\"]\r\n     8\tmod stamp;\r\n     9\t#[path = \"../fold.rs\"]\r\n    10"]
[21.615317, "o", "\tmod fold;\r\n    11\t#[path = \"pipe.rs\"]\r\n    12\tmod pipe;\r\n    13\t#[path = \"emit.rs\"]\r\n    14\tmod emit;\r\n    15\t\r\n    16\tfn main() {\r\n    17\t    let arg = std::env::args().nth(1).unwrap_or_default();\r\n    18\t    let code = match arg.as_str() {\r\n    19\t        \"tallow\" => {\r\n    20\t            let a = pipe::fill();\r\n    21\t            if a != 0 {\r\n    22\t                a\r\n    23\t            } else {\r\n    24\t                emit::finish()\r\n    25\t            }\r\n    26\t        }\r\n    27\t        \"pour\" => emit::pour(),\r\n    28\t        _ => {\r\n    29\t            eprintln!(\"usage: clatter tallow|pour\");\r\n    30\t            2\r\n    31\t        }\r\n"]
[21.61549, "o", "    32\t    };\r\n    33\t    std::process::exit(code);\r\n    34\t}\r\n"]
[21.615706, "o", "===== /app/deskbin/parse.rs =====\r\n"]
[21.616675, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\t#[allow(dead_code)]\r\n     4\tpub struct Meta {\r\n     5\t    pub write_stamp: u32,\r\n     6\t    pub crash: Option<(u32, u32)>,\r\n     7\t    pub guid: [u8; 16],\r\n     8\t    pub companion: u8,\r\n     9\t}\r\n    10\t\r\n    11\tpub fn load(path: &str) -> Meta {\r\n    12\t"]
[21.616785, "o", "    let b = fs::read(path).unwrap_or_default();\r\n    13\t    if b.len() < 12 || &b[0..4] != b\"CLAT\" {\r\n    14\t        return Meta {\r\n    15\t            write_stamp: 0,\r\n    16\t            crash: None,\r\n    17\t            guid: [0; 16],\r\n    18\t            companion: 0,\r\n    19\t        };\r\n    20\t    }\r\n    21\t    let write_stamp = u32::from_le_bytes(b[6..10].try_into().unwrap());\r\n    22\t    let n = u16::from_le_bytes(b[10..12].try_into().unwrap()) as usize;\r\n    23\t    let mut crash = None;\r\n    24\t    let mut guid = [0u8; 16];\r\n    25\t    let mut companion = 0u8;\r\n    26\t    let mut off = 12usize;\r\n    27\t    for _ in 0..n {\r\n    28\t        if off + 12 > b.len() {\r\n    29\t            break;\r\n    30\t        }\r\n    31\t        let st = u32::from_le_bytes(b[off..off + 4].try_into().unwrap());\r\n    32\t        let rva = u32::from_le_bytes(b[off + 4..off + 8].try_into().unwrap()) as usize;\r\n    33\t        let sz = u32::from_le_bytes(b[off + 8..off + 12].try_into().unwrap()) as usize;\r\n    34\t        off += 12;\r\n    35\t        if rva + sz > b.len() {\r\n    36\t            continue;\r\n    37\t        }\r\n    38\t        let sl = &b[rva..rva + sz];\r\n    39\t        if st == 3 && sl.len() >= 8 {\r\n    40\t            let lo = u32::from_le_bytes(sl[0..4].try_into().unwrap());\r\n    41\t            let hi = u32::from_le_bytes(sl[4..8].try_into().unwrap());\r\n    42\t            crash = Some((lo, hi));\r\n    43\t        }\r\n    44\t        if st == 15 && sl.len() >= 17 {\r\n    45\t            guid.copy_from_slice(&sl[0..16]);\r\n    46\t            companion = sl[16];\r\n    47\t        }\r\n"]
[21.61687, "o", "    48\t    }\r\n    49\t    Meta {\r\n    50\t        write_stamp,\r\n    51\t        crash,\r\n    52\t        guid,\r\n    53\t        companion,\r\n    54\t    }\r\n    55\t}\r\n    56\t\r\n    57\tpub fn guid_hex(g: &[u8; 16]) -> String {\r\n    58\t    g.iter().map(|x| format!(\"{:02x}\", x)).collect()\r\n    59\t}\r\n"]
[21.617207, "o", "===== /app/deskbin/pipe.rs =====\r\n"]
[21.618202, "o", "     1\tuse std::fs;\r\n     2\t\r\n"]
[21.618438, "o", "     3\tpub fn fill() -> i32 {\r\n     4\t    match crate::walk::rib_a() {\r\n     5\t        Err(c) => {\r\n     6\t            let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n     7\t            c\r\n     8\t        }\r\n     9\t        Ok(names) => {\r\n    10\t            let pairs = crate::stamp::rib_b(&names);\r\n    11\t            fs::create_dir_all(\"/app/kegbay\").ok();\r\n    12\t            let mut body = String::new();\r\n    13\t            for (n, k) in pairs {\r\n    14\t                body.push_str(&format!(\"{}\\t{}\\n\", n, k));\r\n    15\t            }\r\n    16\t            fs::write(\"/app/kegbay/pairs.tmp\", body).ok();\r\n    17\t            0\r\n    18\t        }\r\n    19\t    }\r\n    20\t}\r\n"]
[21.618696, "o", "===== /app/deskbin/sum.rs =====\r\n"]
[21.621594, "o", "     1\tuse std::process::Command;\r\n     2\t\r\n     3\tpub fn hex_file(path: &str) -> String {\r\n     4\t    let out = Command::new(\"sha256sum\")\r\n     5\t        .arg(path)\r\n     6\t        .output()\r\n     7\t        .ok()\r\n     8\t        .and_then(|o| String::from_utf8(o.stdout).ok())\r\n     9\t        .unwrap_or_default();\r\n    10\t    out.split_whitespace().next().unwrap_or(\"\").to_string()\r\n    11\t}\r\n"]
[21.622103, "o", "===== /app/deskbin/usage.txt =====\r\n"]
[21.623295, "o", "     1\tclatter tallow\r\n     2\tclatter pour [dir]\r\n"]
[21.625857, "o", "===== /app/fold.rs =====\r\n"]
[21.625996, "o", "     1\tuse std::collections::HashMap;\r\n     2\t\r\n     3\tpub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\r\n     4\t    if let Some(r) = root {\r\n     5\t        if r.is_empty() {\r\n     6\t            return Err(1);\r\n     7\t        }\r\n     8\t    }\r\n     9\t    if pairs.is_empty() {\r\n    10\t        return Ok(Vec::new());\r\n    11\t    }\r\n    12\t    let mut by: HashMap<[u8; 16], Vec<(u64, String)>> = HashMap::new();\r\n    13\t    for (n, k) in pairs {\r\n    14\t        let m = crate::parse::load(n);\r\n    15\t        by.entry(m.guid).or_default().push((*k, n.clone()));\r\n    16\t    }\r\n    17\t    let mut out = Vec::new();\r\n    18\t    for (_g, mut rows) in by {\r\n    19\t        rows.sort_by_key(|r| r.0);\r\n    20\t        out.extend(rows.into_iter().map(|r| r.1));\r\n    21\t    }\r\n    22\t    Ok(out)\r\n"]
[21.62602, "o", "    23\t}\r\n"]
[21.626588, "o", "===== /app/stamp.rs =====\r\n"]
[21.62868, "o", "     1\tpub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\r\n     2\t    let mut out = Vec::new();\r\n     3\t    for n in names {\r\n     4\t        let m = crate::parse::load(n);\r\n     5\t        let key = if let Some((lo, hi)) = m.crash {\r\n     6\t            ((lo as u64) << 32) | (hi as u64)\r\n     7\t        } else {\r\n     8\t            m.write_stamp as u64\r\n     9\t        };\r\n    10\t        out.push((n.clone(), key));\r\n    11\t    }\r\n    12\t    out\r\n    13\t}\r\n===== /app/walk.rs =====\r\n"]
[21.629171, "o", "     1\tuse std::collections::HashMap;\r\n     2\tuse std::fs;\r\n     3\t\r\n     4\tpub fn rib_a() -> Result<Vec<String>, i32> {\r\n     5\t    let root = \"/app/dropwell\";\r\n     6\t    let mut bag: HashMap<String, String> = HashMap::new();\r\n     7\t    let rd = match fs::read_dir(root) {\r\n     8\t        Ok(x) => x,\r\n     9\t        Err(_) => return Ok(Vec::new()),\r\n    10\t    };\r\n    11\t    for ent in rd.flatten() {\r\n    12\t        let p = ent.path();\r\n    13\t        if p.extension().and_then(|s| s.to_str()) != Some(\"clat\") {\r\n    14\t            continue;\r\n    15\t        }\r\n    16\t        let s = p.to_string_lossy().to_string();\r\n    17\t        let meta = crate::parse::load(&s);\r\n    18\t        if meta.crash.is_none() {\r\n    19\t            continue;\r\n    20\t        }\r\n    21\t        bag.insert(s.clone(), s);\r\n    22\t    }\r\n    23\t    if bag.is_empty() {\r\n    24\t        return Ok(Vec::new());\r\n    25\t    }\r\n    26\t    Ok(bag.into_values().collect())\r\n    27\t}\r\n"]
[21.629402, "o", "===== /app/fat.sh =====\r\n"]
[21.630471, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin\r\n     5\trustc --edition 2021 -O /app/deskbin/main.rs -o /app/bin/clatter\r\n"]
[21.630611, "o", "===== /app/opsheet/MTIME_NOTE.txt =====\r\n"]
[21.631549, "o", "     1\tScanner already walks newest mtime first via dropwalk. Burst dumps from one crash wave share the same mtime, so that listing is a stable starting point for the ribbon.\r\n"]
[21.631691, "o", "===== /app/tidearc/README.txt =====\r\n"]
[21.632573, "o", "     1\tLast accepted server timeline snapshot from the previous upload window.\r\n     2\tOperators may park a copy under kegbay as hide.rec during a keg swap.\r\n"]
[21.632714, "o", "===== /app/dropwalk/mtime.rs =====\r\n"]
[21.633557, "o", "     1\tuse std::fs;\r\n     2\tuse std::time::SystemTime;\r\n     3\t\r\n     4\tpub fn newest_first(root: &str) -> Vec<String> {\r\n     5\t    let mut rows: Vec<(SystemTime, String)> = Vec::new();\r\n     6\t    if let Ok(rd) = fs::read_dir(root) {\r\n     7\t        for ent in rd.flatten() {\r\n     8\t            let p = ent.path();\r\n     9\t            let t = fs::metadata(&p)\r\n    10\t                .and_then(|m| m.modified())\r\n    11\t                .unwrap_or(SystemTime::UNIX_EPOCH);\r\n    12\t            rows.push((t, p.to_string_lossy().to_string()));\r\n    13\t        }\r\n    14\t    }\r\n    15"]
[21.633694, "o", "\t    rows.sort_by(|a, b| b.0.cmp(&a.0));\r\n    16\t    rows.into_iter().map(|r| r.1).collect()\r\n    17\t}\r\n"]
[21.633879, "o", "\u001b[?2004hroot@76fa4ad48f00:/app# "]
[22.522855, "i", "echo '--- binary magic/toolchain ---'; od -An -tx1 -N16 /app/bin/clatter; ls -l /app/bin/clatter /app/dropwell/*; command -v rustc || true; rustc --version 2>/dev/null || true; command -v sha256sum || true; echo '--- dump metadata ---'; python3 - <<'PY'\nimport os,struct,glob,hashlib\nfor p in sorted(glob.glob('/app/dropwell/*')):\n b=open(p,'rb').read(); print(os.path.basename(p),len(b),hashlib.sha256(b).hexdigest())\n try:\n  magic,ver,stamp,n=struct.unpack_from('<4sHIH',b); print(' hdr',magic,ver,stamp,n)\n  for i in range(n):\n   typ,rva,size=struct.unpack_from('<III',b,12+12*i)\n   print(' stream',typ,rva,size,b[rva:rva+size].hex())\n except Exception as e: print(' ERROR',e)\nPY\n"]
[22.52389, "o", "echo '--- binary magic/toolchain ---'; od -An -tx1 -N16 /app/bin/clatter; ls -l /app/bin/clatter /app/dropwell/*; command -v rustc || true; rustc --version 2>/dev/null || true; command -v sha256sum || true; echo '--- dump metadata ---'; python3 - <<'PY'\r\n\u001b[?2004l\r"]
