[33.324268, "o", "\u001b[?2004hroot@76fa4ad48f00:/app# "]
[92.077073, "i", "cat > /app/walk.rs <<'RS'\nuse std::collections::HashSet;\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let root = \"/app/dropwell\";\n    let rd = fs::read_dir(root).map_err(|_| 1)?;\n    let mut seen = HashSet::new();\n    let mut out = Vec::new();\n    for ent in rd.flatten() {\n        let p = ent.path();\n        if !p.is_file() || p.extension().and_then(|s| s.to_str()) != Some(\"clat\") { continue; }\n        let s = p.to_string_lossy().to_string();\n        let b = match fs::read(&p) { Ok(v) => v, Err(_) => continue };\n        if b.len() < 12 || &b[..4] != b\"CLAT\" { continue; }\n        if seen.insert(s.clone()) { out.push(s); }\n    }\n    out.sort();\n    if out.is_empty() { Err(1) } else { Ok(out) }\n}\nRS\ncat > /app/stamp.rs <<'RS'\npub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\n    names.iter().map(|n| {\n        let m = crate::parse::load(n);\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => (m.write_stamp as u64 + 11_644_473_600) * 10_000_000,\n        };\n        (n.clone(), key)\n    }).collect()\n}\nRS\ncat > /app/fold.rs <<'RS'\nuse std::collections::{HashMap, HashSet};\nuse std::fs;\nuse std::path::Path;\n\nfn prior() -> HashMap<String, u32> {\n    let mut out = HashMap::new();\n    if let Ok(raw) = fs::read_to_string(\"/app/tidearc/lastgood.rec\") {\n        for line in raw.lines() {\n            let p: Vec<&str> = line.split('\\t').collect();\n            if p.len() >= 2 {\n                if let Ok(seq) = p[0].trim().parse::<u32>() {\n                    out.insert(p[1].trim().to_string(), seq);\n                }\n            }\n        }\n    }\n    out\n}\n\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\n    if let Some(r) = root {\n        let wanted = fs::canonicalize(\"/app/dropwell\").map_err(|_| 1)?;\n        let got = fs::canonicalize(r).map_err(|_| 1)?;\n        if got != wanted { return Err(1); }\n    }\n    if pairs.is_empty() { return Err(1); }\n    let old = prior();\n    let mut seen = HashSet::new();\n    let mut existing = Vec::new();\n    let mut fresh = Vec::new();\n    for (path, stamp) in pairs {\n        let name = match Path::new(path).file_name().and_then(|s| s.to_str()) {\n            Some(s) => s.to_string(), None => return Err(1)\n        };\n        if !seen.insert(name.clone()) { return Err(1); }\n        if let Some(&seq) = old.get(&name) {\n            existing.push((seq, path.clone()));\n        } else {\n            let m = crate::parse::load(path);\n            fresh.push((*stamp, m.guid, m.companion, name, path.clone()));\n        }\n    }\n    existing.sort_by(|a,b| a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1)));\n    fresh.sort_by(|a,b| a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1)).then_with(|| a.2.cmp(&b.2)).then_with(|| a.3.cmp(&b.3)));\n    let mut out: Vec<String> = existing.into_iter().map(|x| x.1).collect();\n    out.extend(fresh.into_iter().map(|x| x.4));\n    Ok(out)\n}\nRS\ncat > /app/deskbin/pipe.rs <<'RS'\nuse std::fs;\nfn fail(code: i32) -> i32 {\n    let _ = fs::create_dir_all(\"/app/kegbay\");\n    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\n    code\n}\npub fn fill() -> i32 {\n    let names = match crate::walk::rib_a() { Ok(v) => v, Err(c) => return fail(c) };\n    let pairs = crate::stamp::rib_b(&names);\n    if fs::create_dir_all(\"/app/kegbay\").is_err() { return fail(1); }\n    let body: String = pairs.into_iter().map(|(n,k)| format!(\"{}\\t{}\\n\", n, k)).collect();\n    if fs::write(\"/app/kegbay/pairs.tmp\", body).is_err() { return fail(1); }\n    0\n}\nRS\n"]
