     1	use std::fs;
     2	use std::path::Path;
     3	
     4	fn read_pairs() -> Vec<(String, u64)> {
     5	    let raw = fs::read_to_string("/app/kegbay/pairs.tmp").unwrap_or_default();
     6	    let mut v = Vec::new();
     7	    for line in raw.lines() {
     8	        let mut it = line.split('\t');
     9	        if let (Some(n), Some(k)) = (it.next(), it.next()) {
    10	            if let Ok(u) = k.parse::<u64>() {
    11	                v.push((n.to_string(), u));
    12	            }
    13	        }
    14	    }
    15	    v
    16	}
    17	
    18	pub fn finish() -> i32 {
    19	    let pairs = read_pairs();
    20	    match crate::fold::rib_c(&pairs, None) {
    21	        Err(c) => c,
    22	        Ok(names) => {
    23	            fs::create_dir_all("/app/kegbay").ok();
    24	            let mut body = String::new();
    25	            for (i, n) in names.iter().enumerate() {
    26	                let m = crate::parse::load(n);
    27	                body.push_str(&format!(
    28	                    "{}\t{}\t{}\n",
    29	                    i + 1,
    30	                    n,
    31	                    crate::parse::guid_hex(&m.guid)
    32	                ));
    33	            }
    34	            fs::write("/app/kegbay/ribbon.txt", body).ok();
    35	            0
    36	        }
    37	    }
    38	}
    39	
    40	pub fn pour() -> i32 {
    41	    let arg = std::env::args().nth(2);
    42	    let root = arg.unwrap_or_else(|| "/app/dropwell".to_string());
    43	    match crate::fold::rib_c(&[], Some(&root)) {
    44	        Err(c) => {
    45	            let _ = fs::remove_file("/app/kegbay/MARK");
    46	            return c;
    47	        }
    48	        Ok(_) => {}
    49	    }
    50	    let ribbon = fs::read_to_string("/app/kegbay/ribbon.txt").unwrap_or_default();
    51	    let mut rows: Vec<(u32, String, String, String)> = Vec::new();
    52	    for line in ribbon.lines() {
    53	        let p: Vec<&str> = line.split('\t').collect();
    54	        if p.len() < 3 {
    55	            continue;
    56	        }
    57	        let seq: u32 = p[0].parse().unwrap_or(0);
    58	        let name = p[1].to_string();
    59	        let g = p[2].to_string();
    60	        let digest = crate::sum::hex_file(&name);
    61	        rows.push((seq, Path::new(&name).file_name().unwrap().to_string_lossy().to_string(), digest, g));
    62	    }
    63	    let n = rows.len();
    64	    let batches = if n == 0 { 0 } else { (n + 2) / 3 };
    65	    let mut json = String::from("{\"batch_count\":");
    66	    json.push_str(&batches.to_string());
    67	    json.push_str(",\"entries\":[");
    68	    for (i, (seq, name, digest, g)) in rows.iter().enumerate() {
    69	        if i > 0 {
    70	            json.push(',');
    71	        }
    72	        json.push_str(&format!(
    73	            "{{\"seq\":{},\"name\":\"{}\",\"digest\":\"{}\",\"guid\":\"{}\"}}",
    74	            seq, name, digest, g
    75	        ));
    76	    }
    77	    json.push_str("]}\n");
    78	    fs::create_dir_all("/app/kegbay").ok();
    79	    fs::write("/app/kegbay/upload.json", json).ok();
    80	    let mut tsv = String::from("seq\tname\tdigest\tguid\n");
    81	    for (seq, name, digest, g) in &rows {
    82	        tsv.push_str(&format!("{}\t{}\t{}\t{}\n", seq, name, digest, g));
    83	    }
    84	    fs::write("/app/kegbay/batch.tsv", tsv).ok();
    85	    fs::write("/app/kegbay/MARK", "ok").ok();
    86	    0
    87	}
