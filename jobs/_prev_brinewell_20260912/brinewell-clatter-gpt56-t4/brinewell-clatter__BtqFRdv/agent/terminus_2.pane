     1	use std::fs;
     2	
     3	pub fn fill() -> i32 {
     4	    match crate::walk::rib_a() {
     5	        Err(c) => {
     6	            let _ = fs::remove_file("/app/kegbay/MARK");
     7	            c
     8	        }
     9	        Ok(names) => {
    10	            let pairs = crate::stamp::rib_b(&names);
    11	            fs::create_dir_all("/app/kegbay").ok();
    12	            let mut body = String::new();
    13	            for (n, k) in pairs {
    14	                body.push_str(&format!("{}\t{}\n", n, k));
    15	            }
    16	            fs::write("/app/kegbay/pairs.tmp", body).ok();
    17	            0
    18	        }
    19	    }
    20	}
===== /app/deskbin/sum.rs =====
     1	use std::process::Command;
     2	
     3	pub fn hex_file(path: &str) -> String {
     4	    let out = Command::new("sha256sum")
     5	        .arg(path)
     6	        .output()
     7	        .ok()
     8	        .and_then(|o| String::from_utf8(o.stdout).ok())
     9	        .unwrap_or_default();
    10	    out.split_whitespace().next().unwrap_or("").to_string()
    11	}
