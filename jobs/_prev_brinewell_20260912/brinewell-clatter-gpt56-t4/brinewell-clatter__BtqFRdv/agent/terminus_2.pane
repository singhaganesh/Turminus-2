===== /app/deskbin/parse.rs =====
     1	use std::fs;
     2	
     3	#[allow(dead_code)]
     4	pub struct Meta {
     5	    pub write_stamp: u32,
     6	    pub crash: Option<(u32, u32)>,
     7	    pub guid: [u8; 16],
     8	    pub companion: u8,
     9	}
    10	
    11	pub fn load(path: &str) -> Meta {
    12	    let b = fs::read(path).unwrap_or_default();
    13	    if b.len() < 12 || &b[0..4] != b"CLAT" {
    14	        return Meta {
    15	            write_stamp: 0,
    16	            crash: None,
    17	            guid: [0; 16],
    18	            companion: 0,
    19	        };
    20	    }
    21	    let write_stamp = u32::from_le_bytes(b[6..10].try_into().unwrap());
    22	    let n = u16::from_le_bytes(b[10..12].try_into().unwrap()) as usize;
    23	    let mut crash = None;
    24	    let mut guid = [0u8; 16];
    25	    let mut companion = 0u8;
    26	    let mut off = 12usize;
    27	    for _ in 0..n {
    28	        if off + 12 > b.len() {
    29	            break;
    30	        }
    31	        let st = u32::from_le_bytes(b[off..off + 4].try_into().unwrap());
    32	        let rva = u32::from_le_bytes(b[off + 4..off + 8].try_into().unwrap()) as usize;
    33	        let sz = u32::from_le_bytes(b[off + 8..off + 12].try_into().unwrap()) as usize;
    34	        off += 12;
    35	        if rva + sz > b.len() {
    36	            continue;
    37	        }
    38	        let sl = &b[rva..rva + sz];
    39	        if st == 3 && sl.len() >= 8 {
    40	            let lo = u32::from_le_bytes(sl[0..4].try_into().unwrap());
    41	            let hi = u32::from_le_bytes(sl[4..8].try_into().unwrap());
    42	            crash = Some((lo, hi));
    43	        }
    44	        if st == 15 && sl.len() >= 17 {
    45	            guid.copy_from_slice(&sl[0..16]);
    46	            companion = sl[16];
    47	        }
    48	    }
    49	    Meta {
    50	        write_stamp,
    51	        crash,
    52	        guid,
    53	        companion,
    54	    }
    55	}
    56	
    57	pub fn guid_hex(g: &[u8; 16]) -> String {
    58	    g.iter().map(|x| format!("{:02x}", x)).collect()
    59	}
