===== /app/fold.rs =====
     1	use std::collections::HashMap;
     2	
     3	pub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {
     4	    if let Some(r) = root {
     5	        if r.is_empty() {
     6	            return Err(1);
     7	        }
     8	    }
     9	    if pairs.is_empty() {
    10	        return Ok(Vec::new());
    11	    }
    12	    let mut by: HashMap<[u8; 16], Vec<(u64, String)>> = HashMap::new();
    13	    for (n, k) in pairs {
    14	        let m = crate::parse::load(n);
    15	        by.entry(m.guid).or_default().push((*k, n.clone()));
    16	    }
    17	    let mut out = Vec::new();
    18	    for (_g, mut rows) in by {
    19	        rows.sort_by_key(|r| r.0);
    20	        out.extend(rows.into_iter().map(|r| r.1));
    21	    }
    22	    Ok(out)
    23	}
===== /app/stamp.rs =====
     1	pub fn rib_b(names: &[String]) -> Vec<(String, u64)> {
     2	    let mut out = Vec::new();
     3	    for n in names {
     4	        let m = crate::parse::load(n);
     5	        let key = if let Some((lo, hi)) = m.crash {
     6	            ((lo as u64) << 32) | (hi as u64)
     7	        } else {
     8	            m.write_stamp as u64
     9	        };
    10	        out.push((n.clone(), key));
    11	    }
    12	    out
    13	}
===== /app/walk.rs =====
     1	use std::collections::HashMap;
     2	use std::fs;
     3	
     4	pub fn rib_a() -> Result<Vec<String>, i32> {
     5	    let root = "/app/dropwell";
     6	    let mut bag: HashMap<String, String> = HashMap::new();
     7	    let rd = match fs::read_dir(root) {
     8	        Ok(x) => x,
     9	        Err(_) => return Ok(Vec::new()),
    10	    };
    11	    for ent in rd.flatten() {
    12	        let p = ent.path();
    13	        if p.extension().and_then(|s| s.to_str()) != Some("clat") {
    14	            continue;
    15	        }
    16	        let s = p.to_string_lossy().to_string();
    17	        let meta = crate::parse::load(&s);
    18	        if meta.crash.is_none() {
    19	            continue;
    20	        }
    21	        bag.insert(s.clone(), s);
    22	    }
    23	    if bag.is_empty() {
    24	        return Ok(Vec::new());
    25	    }
    26	    Ok(bag.into_values().collect())
    27	}
