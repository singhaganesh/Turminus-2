===== /app/opsheet/MTIME_NOTE.txt =====
     1	Scanner already walks newest mtime first via dropwalk. Burst dumps from one crash wave share the same mtime, so that listing is a stable starting point for the ribbon.
===== /app/tidearc/README.txt =====
     1	Last accepted server timeline snapshot from the previous upload window.
     2	Operators may park a copy under kegbay as hide.rec during a keg swap.
===== /app/dropwalk/mtime.rs =====
     1	use std::fs;
     2	use std::time::SystemTime;
     3	
     4	pub fn newest_first(root: &str) -> Vec<String> {
     5	    let mut rows: Vec<(SystemTime, String)> = Vec::new();
     6	    if let Ok(rd) = fs::read_dir(root) {
     7	        for ent in rd.flatten() {
     8	            let p = ent.path();
     9	            let t = fs::metadata(&p)
    10	                .and_then(|m| m.modified())
    11	                .unwrap_or(SystemTime::UNIX_EPOCH);
    12	            rows.push((t, p.to_string_lossy().to_string()));
    13	        }
    14	    }
    15	    rows.sort_by(|a, b| b.0.cmp(&a.0));
    16	    rows.into_iter().map(|r| r.1).collect()
    17	}
