n fail(1); }\n        let seq:u32=match p[0].parse(){Ok(x)=>x,Err(_)=>return fail(1)};\n        let path=p[1];\n        if !Path::new(path).is_file() { return fail(1); }\n        let name=match Path::new(path).file_name().and_then(|x|x.to_str()){Some(x)=>x.to_string(),None=>return fail(1)};\n        let digest=crate::sum::hex_file(path);\n        if digest.len()!=64 { return fail(1); }\n        rows.push((seq,name,digest,p[2].to_string()));\n    }\n    if rows.is_empty() { return fail(1); }\n    let mut json=format!("{{\\"batch_count\\":{},\\"entries\\":[",(rows.len()+2)/3);\n    for (i,(seq,name,digest,guid)) in rows.iter().enumerate() {\n        if i>0 { json.push(\',\'); }\n        json.push_str(&format!("{{\\"seq\\":{},\\"name\\":{},\\"digest\\":{},\\"guid\\":{}}}",seq,json_string(name),json_string(digest),json_string(guid)));\n    }\n    json.push_str("]}\\n");\n    let mut tsv=String::from("seq\\tname\\tdigest\\tguid\\n");\n    for (seq,name,digest,guid) in &rows { tsv.push_str(&format!("{}\\t{}\\t{}\\t{}\\n",seq,name,digest,guid)); }\n    if fs::write("/app/kegbay/upload.json",json).is_err() || fs::write("/app/kegbay/batch.tsv",tsv).is_err() { return fail(1); }\n    if fs::write("/app/kegbay/MARK","ok").is_err() { return 1; }\n    0\n}\nRS\nPATH=/usr/local/cargo/bin:$PATH rustc --edition 2021 -O /app/deskbin/main.rs -o /app/bin/clatter\nod -An -tx1 -N4 /app/bin/clatter\n/app/bin/clatter tallow && /app/bin/clatter pour\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
