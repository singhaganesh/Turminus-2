Sending keys: ['cat > /app/walk.rs <<\'RS\'\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let root = "/app/dropwell";\n    let rd = fs::read_dir(root).map_err(|_| 1)?;\n    let mut out = Vec::new();\n    for ent in rd.flatten() {\n        let p = ent.path();\n        if p.extension().and_then(|s| s.to_str()) != Some("clat") || !p.is_file() {\n            continue;\n        }\n        let name = p.to_string_lossy().to_string();\n        let bytes = match fs::read(&p) { Ok(b) => b, Err(_) => continue };\n        if bytes.len() >= 12 && &bytes[..4] == b"CLAT" {\n            out.push(name);\n        }\n    }\n    out.sort();\n    if out.is_empty() { Err(1) } else { Ok(out) }\n}\nRS\ncat > /app/stamp.rs <<\'RS\'\npub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\n    names.iter().map(|n| {\n        let m = crate::parse::load(n);\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => m.write_stamp as u64,\n        };\n        (n.clone(), key)\n    }).collect()\n}\nRS\ncat > /app/deskbin/pipe.rs <<\'RS\'\nuse std::fs;\n\nfn fail(code: i32) -> i32 {\n    let _ = fs::create_dir_all("/app/kegbay");\n    let _ = fs::write("/app/kegbay/MARK", "false");\n    code\n}\n\npub fn fill() -> i32 {\n    let names = match crate::walk::rib_a() {\n        Ok(v) if !v.is_empty() => v,\n        Ok(_) => return fail(1),\n        Err(c) => return fail(c),\n    };\n    let pairs = crate::stamp::rib_b(&names);\n    if fs::create_dir_all("/app/kegbay").is_err() { return fail(1); }\n    let mut body = String::new();\n    for (n, k) in pairs { body.push_str(&format!("{}\\t{}\\n", n, k)); }\n    if fs::write("/app/kegbay/pairs.tmp", body).is_err() { return fail(1); }\n    0\n}\nRS\ncat > /app/deskbin/emit.rs <<\'RS\'\nuse std::collections::{HashMap, HashSet};\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\nfn mark_false() -> i32 {\n    let _ = fs::create_dir_all("/app/kegbay");\n    let _ = fs::write("/app/kegbay/MARK", "false");\n    1\n}\n\nfn read_pairs() -> Vec<String> {\n    let raw = fs::read_to_string("/app/kegbay/pairs.tmp").unwrap_or_default();\n    let mut seen = HashSet::new();\n    raw.lines().filter_map(|line| {\n        let n = line.split(\'\\t\').next()?.to_string();\n        if seen.insert(n.clone()) { Some(n) } else { None }\n    }).collect()\n}\n\nfn last_good() -> HashMap<String, u32> {\n    let mut out = HashMap::new();\n    for line in fs::read_to_string("/app/tidearc/lastgood.rec").unwrap_or_default().lines() {\n        let p: Vec<&str> = line.split(\'\\t\').collect();\n        if p.len() >= 2 {\n            if let Ok(seq) = p[0].parse::<u32>() { out.insert(p[1].to_string(), seq); }\n        }\n    }\n    out\n}\n\npub fn finish() -> i32 {\n    let names = read_pairs();\n    if names.is_empty() { return mark_false(); }\n    let old = last_good();\n    let mut known = Vec::new();\n    let mut fresh = Vec::new();\n    for path in names {\n        let base = match Path::new(&path).file_name().and_then(|x| x.to_str()) {\n            Some(x) => x.to_string(), None => return mark_false(),\n        };\n        if let Some(&seq) = old.get(&base) { known.push((seq, base, path)); }\n        else { fresh.push((base, path)); }\n    }\n    known.sort_by(|a,b| a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1)));\n    fresh.sort_by(|a,b| a.0.cmp(&b.0));\n    let mut rows: Vec<(u32,String,String)> = known.into_iter().map(|(s,b,p)|(s,b,p)).collect();\n    let mut seq = rows.iter().map(|r| r.0).max().unwrap_or(0) + 1;\n    for (base,path) in fresh { rows.push((seq,base,path)); seq += 1; }\n    let mut ribbon = String::new();\n    for (seq, _, path) in &rows {\n        let m = crate::parse::load(path);\n        ribbon.push_str(&format!("{}\\t{}\\t{}\\n", seq, path, crate::parse::guid_hex(&m.guid)));\n    }\n    if fs::create_dir_all("/app/kegbay").is_err() || fs::write("/app/kegbay/ribbon.txt", ribbon).is_err() {\n        return mark_false();\n    }\n    0\n}\n\nfn valid_root(arg: Option<String>) -> bool {\n    let requested = PathBuf::from(arg.unwrap_or_else(|| "/app/dropwell".to_string()));\n    match (fs::canonicalize(requested), fs::canonicalize("/app/dropwell")) {\n        (Ok(a), Ok(b)) => a == b,\n        _ => false,\n    }\n}\n\npub fn pour() -> i32 {\n    if !valid_root(std::env::args().nth(2)) { return mark_false(); }\n    let well = match crate::walk::rib_a() { Ok(v) if !v.is_empty() => v, _ => return mark_false() };\n    let ribbon = fs::read_to_string("/app/kegbay/ribbon.txt").unwrap_or_default();\n    let mut rows: Vec<(u32,String,String,String)> = Vec::new();\n    let mut represented = HashSet::new();\n    for line in ribbon.lines() {\n        let p: Vec<&str> = line.split(\'\\t\').collect();\n        if p.len() != 3 { return mark_false(); }\n        let seq = match p[0].parse::<u32>() { Ok(x) => x, Err(_) => return mark_false() };\n        let path = p[1];\n        if !well.iter().any(|x| x == path) || !represented.insert(path.to_string()) { return mark_false(); }\n        let name = match Path::new(path).file_name().and_then(|x| x.to_str()) { Some(x)=>x.to_string(), None=>return mark_false() };\n        rows.push((seq, name, crate::sum::hex_file(path), p[2].to_string()));\n    }\n    if rows.len() != well.len() || rows.is_empty() || rows.iter().any(|r| r.2.len() != 64) { return mark_false(); }\n    rows.sort_by_key(|r| r.0);\n    let batches = (rows.len() + 2) / 3;\n    let mut json = format!("{{\\"batch_count\\":{},\\"entries\\":[", batches);\n    for (i,(seq,name,digest,guid)) in rows.iter().enumerate() {\n        if i != 0 { json.push(\',\'); }\n        json.push_str(&format!("{{\\"seq\\":{},\\"name\\":\\"{}\\",\\"digest\\":\\"{}\\",\\"guid\\":\\"{}\\"}}",seq,name,digest,guid));\n    }\n    json.push_str("]}\\n");\n    let mut tsv = String::from("seq\\tname\\tdigest\\tguid\\n");\n    for (seq,name,digest,guid) in &rows { tsv.push_str(&format!("{}\\t{}\\t{}\\t{}\\n",seq,name,digest,guid)); }\n    if fs::write("/app/kegbay/upload.json",json).is_err() || fs::write("/app/kegbay/batch.tsv",tsv).is_err() || fs::write("/app/kegbay/MARK","ok").is_err() { return mark_false(); }\n    0\n}\nRS\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
