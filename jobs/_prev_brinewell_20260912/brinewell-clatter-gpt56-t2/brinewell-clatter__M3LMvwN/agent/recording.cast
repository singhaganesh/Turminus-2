[19.446294, "o", "     1\tuse std::collections::HashMap;\r\n     2\tuse std::fs;\r\n     3\t\r\n     4\tpub fn rib_a() -> Result<Vec<String>, i32> {\r\n     5\t    let root = \"/app/dropwell\";\r\n     6\t    let mut bag: HashMap<String, String> = HashMap::new();\r\n     7\t    let rd = match fs::read_dir(root) {\r\n     8\t        Ok(x) => x,\r\n     9\t        Err(_) => return Ok(Vec::new()),\r\n    10\t    };\r\n    11\t    for ent in rd.flatten() {\r\n    12\t        let p = ent.path();\r\n    13\t        if p.extension().and_then(|s| s.to_str()) != Some(\"clat\") {\r\n    14\t            continue;\r\n    15\t        }\r\n"]
[19.448122, "o", "    16\t        let s = p.to_string_lossy().to_string();\r\n    17\t        let meta = crate::parse::load(&s);\r\n    18\t        if meta.crash.is_none() {\r\n    19\t            continue;\r\n    20\t        }\r\n    21\t        bag.insert(s.clone(), s);\r\n    22\t    }\r\n    23\t    if bag.is_empty() {\r\n    24\t        return Ok(Vec::new());\r\n    25\t    }\r\n    26\t    Ok(bag.into_values().collect())\r\n    27\t}\r\n===== /app/stamp.rs =====\r\n     1\tpub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\r\n     2\t    let mut out = Vec::new();\r\n     3\t    for n in names {\r\n     4\t        let m = crate::parse::load(n);\r\n     5\t        let key = if let Some((lo, hi)) = m.crash {\r\n     6\t            ((lo as u64) << 32) | (hi as u64)\r\n     7\t        } else {\r\n     8\t            m.write_stamp as u64\r\n     9\t        };\r\n    10\t        out.push((n.clone(), key));\r\n    11\t    }\r\n    12\t    out\r\n    13\t}\r\n===== /app/fold.rs =====\r\n"]
[19.448417, "o", "     1\tuse std::collections::HashMap;\r\n     2\t\r\n     3\tpub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\r\n     4\t    if let Some(r) = root {\r\n     5\t        if r.is_empty() {\r\n     6\t            return Err(1);\r\n     7\t        }\r\n     8\t    }\r\n     9\t    if pairs.is_empty() {\r\n    10\t        return Ok(Vec::new());\r\n    11\t    }\r\n    12\t    let mut by: HashMap<[u8; 16], Vec<(u64, String)>> = HashMap::new();\r\n    13\t    for (n, k) in pairs {\r\n    14\t        let m = crate::parse::load(n);\r\n    15\t        by.entry(m.guid).or_default().push((*k, n.clone()));\r\n    16\t    }\r\n    17\t    let mut out = Vec::new();\r\n    18\t    for (_g, mut rows) in by {\r\n    19\t        rows.sort_by_key(|r| r.0);\r\n    20\t        out.extend(rows.into_iter().map(|r| r.1));\r\n    21\t    }\r\n    22\t    Ok(out)\r\n    23\t}\r\n"]
[19.448533, "o", "===== /app/dropwalk/mtime.rs =====\r\n"]
[19.449351, "o", "     1\tuse std::fs;\r\n     2\tuse std::time::SystemTime;\r\n     3\t\r\n     4\tpub fn newest_first(root: &str) -> Vec<String> {\r\n     5\t    let mut rows: Vec<(SystemTime, String)> = Vec::new();\r\n     6\t    if let Ok(rd) = fs::read_dir(root) {\r\n     7\t        for ent in rd.flatten() {\r\n     8\t            let p = ent.path();\r\n     9\t            let t = fs::metadata(&p)\r\n"]
[19.449608, "o", "    10\t                .and_then(|m| m.modified())\r\n    11\t                .unwrap_or(SystemTime::UNIX_EPOCH);\r\n    12\t            rows.push((t, p.to_string_lossy().to_string()));\r\n    13\t        }\r\n    14\t    }\r\n    15\t    rows.sort_by(|a, b| b.0.cmp(&a.0));\r\n    16\t    rows.into_iter().map(|r| r.1).collect()\r\n    17\t}\r\n"]
[19.449857, "o", "===== /app/fat.sh =====\r\n"]
