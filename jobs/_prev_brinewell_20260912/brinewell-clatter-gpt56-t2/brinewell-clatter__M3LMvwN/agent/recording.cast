��\u0007M��u��\u000f\u0010\u0000\u0000\u000f��\u0000���E1Ҹ\u0017\u0000\u0000\u0000E1����Ƀ�\u0007\u000f�*\u0010\u0000\u0000L�\r\u000b�\u0002\u0000Ic\f�L\u0001�L��������M��\u000f��\r\u0000\u0000D\u000f�\r\n�[\u0003\u0000\u0000K�\u0004,H��\u0003����\bA��A��\u0010H�� H�E��\u0003\u0000\u0000H\u000f��H\u0001�\u0010���Hǅ\u0018���\u0000\u0000\u0000\u0000��\u0004\u0000\u0000K�\u0004,H��\u0003����\bA��A��\u0010H�� H�E�L��\u0018���H�\u001dC�\u0002\u0000��\u0004\u0000\u0000H������H��A��@I\u000fB���@I\u000fM�H\t�����\bA��A��\u0010H��H�� H��H\u0001�H��H�M�\u000f��\u0003\u0000\u0000H\u0001�(���H��\u0010����y\u0004\u0000\u0000H��P���H��H��X�������\bA��A��\u0010H��H�� H�M�H��8���H�������>\u0004\u0000\u0000H��P���H��H��X�������\bA��A��\u0010H��H�� H�M�H��0���H�������\u0003\u0004\u0000\u0000H��P���H��H��X�������\bA��A��\u0010H��H�� H�M�H�� ���H��������\u0003\u0000\u0000H��P���H��H��X���D����\bE��A��\u0010L��H�� \u000f��\u0005���D\u000f��\u0006���A��\u0001H�E�\u000f��\u0002\u0000\u0000E��\u000f��\u000e\u0000\u0000H��\u0018���L\u0001�H��H�� \u000f�A\u0003\u0000\u00001�I���<\u0003\u0000\u0000I��L��I��E1�H������M��\u000f�\u0001\f\u0000\u0000L��h����\u0001\u0000\u0000\u0000L)�H�Q\u0001H��\b���N�<)E1�E1�1�f.\u000f\u001f�\u0000\u0000\u0000\u0000\u0000D\u000f�J���?u\r\nA��\u0002\u000f��\u000b\u0000\u0000A\u000f��A��A��I��M\t̄�y\u0017��\u0007H��H��I��H��\u0001u��u\u000b\u0000\u0000H��P���I��I��L��X���L��h���I��H��L������H������I9�\u000f�O���L9�\u000f��\r\u0000\u0000H��D����\bE��A��\u0010I�� H��L������L�]���\u0000\u0000\u0000D����\bE��A��\u0010L��H�� H�E�L��@���L������L��\u0018���E1��3\u0002\u0000\u0000I��\u0001\u000f��\r\n\u0000\u0000D\u000f�\r\n�EI��\u0007\u000f��\r\n"]
[9.296088, "o", "### /app/deskbin/emit.rs\r\n"]
[9.297104, "o", "use std::fs;\r\nuse std::path::Path;\r\n\r\nfn read_pairs() -> Vec<(String, u64)> {\r\n    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default();\r\n    let mut v = Vec::new();\r\n    for line in raw.lines() {\r\n        let mut it = line.split('\\t');\r\n        if let (Some(n), Some(k)) = (it.next(), it.next()) {\r\n"]
[9.297358, "o", "            if let Ok(u) = k.parse::<u64>() {\r\n                v.push((n.to_string(), u));\r\n            }\r\n        }\r\n    }\r\n    v\r\n}\r\n\r\npub fn finish() -> i32 {\r\n    let pairs = read_pairs();\r\n    match crate::fold::rib_c(&pairs, None) {\r\n        Err(c) => c,\r\n        Ok(names) => {\r\n            fs::create_dir_all(\"/app/kegbay\").ok();\r\n            let mut body = String::new();\r\n            for (i, n) in names.iter().enumerate() {\r\n                let m = crate::parse::load(n);\r\n                body.push_str(&format!(\r\n                    \"{}\\t{}\\t{}\\n\",\r\n                    i + 1,\r\n                    n,\r\n                    crate::parse::guid_hex(&m.guid)\r\n                ));\r\n            }\r\n            fs::write(\"/app/kegbay/ribbon.txt\", body).ok();\r\n            0\r\n        }\r\n    }\r\n}\r\n\r\npub fn pour() -> i32 {\r\n    let arg = std::env::args().nth(2);\r\n    let root = arg.unwrap_or_else(|| \"/app/dropwell\".to_string());\r\n    match crate::fold::rib_c(&[], Some(&root)) {\r\n        Err(c) => {\r\n            let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n            return c;\r\n        }\r\n        Ok(_) => {}\r\n    }\r\n    let ribbon = fs::read_to_string(\"/app/kegbay/ribbon.txt\").unwrap_or_default();\r\n    let mut rows: Vec<(u32, String, String, String)> = Vec::new();\r\n    for line in ribbon.lines() {\r\n        let p: Vec<&str> = line.split('\\t').collect();\r\n        if p.len() < 3 {\r\n            continue;\r\n        }\r\n        let seq: u32 = p[0].parse().unwrap_or(0);\r\n        let name = p[1].to_string();\r\n        let g = p[2].to_string();\r\n        let digest = crate::sum::hex_file(&name);\r\n        rows.push((seq, Path::new(&name).file_name().unwrap().to_string_lossy().to_string(), digest, g));\r\n    }\r\n    let n = rows.len();\r\n    let batches = if n == 0 { 0 } else { (n + 2) / 3 };\r\n    let mut json = String::from(\"{\\\"batch_count\\\":\");\r\n    json.push_str(&batches.to_string());\r\n    json.push_str(\",\\\"entries\\\":[\");\r\n    for (i, (seq, name, digest, g)) in rows.iter().enumerate() {\r\n        if i > 0 {\r\n            json.push(',');\r\n        }\r\n        json.push_str(&format!(\r\n            \"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",\r\n            seq, name, digest, g\r\n        ));\r\n    }\r\n"]
[9.297446, "o", "    json.push_str(\"]}\\n\");\r\n    fs::create_dir_all(\"/app/kegbay\").ok();\r\n    fs::write(\"/app/kegbay/upload.json\", json).ok();\r\n    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n    for (seq, name, digest, g) in &rows {\r\n        tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\", seq, name, digest, g));\r\n    }\r\n    fs::write(\"/app/kegbay/batch.tsv\", tsv).ok();\r\n    fs::write(\"/app/kegbay/MARK\", \"ok\").ok();\r\n    0\r\n}\r\n"]
[9.297646, "o", "### /app/deskbin/main.rs\r\n"]
[9.298599, "o", "#[path = \"parse.rs\"]\r\nmod parse;\r\n#[path = \"sum.rs\"]\r\nmod sum;\r\n#[path = \"../walk.rs\"]\r\nmod walk;\r\n#[path = \"../stamp.rs\"]\r\nmod stamp;\r\n#[path = \"../fold.rs\"]\r\n"]
[9.298712, "o", "mod fold;\r\n#[path = \"pipe.rs\"]\r\nmod pipe;\r\n#[path = \"emit.rs\"]\r\nmod emit;\r\n\r\nfn main() {\r\n    let arg = std::env::args().nth(1).unwrap_or_default();\r\n    let code = match arg.as_str() {\r\n"]
[9.298848, "o", "        \"tallow\" => {\r\n            let a = pipe::fill();\r\n            if a != 0 {\r\n                a\r\n            } else {\r\n                emit::finish()\r\n            }\r\n        }\r\n        \"pour\" => emit::pour(),\r\n        _ => {\r\n            eprintln!(\"usage: clatter tallow|pour\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[9.298996, "o", "### /app/deskbin/parse.rs\r\n"]
[9.299958, "o", "use std::fs;\r\n\r\n#[allow(dead_code)]\r\npub struct Meta {\r\n    pub write_stamp: u32,\r\n    pub crash: Option<(u32, u32)>,\r\n    pub guid: [u8; 16],\r\n    pub companion: u8,\r\n}\r\n\r\npub fn load(path: &str) -> Meta {\r\n"]
[9.300074, "o", "    let b = fs::read(path).unwrap_or_default();\r\n    if b.len() < 12 || &b[0..4] != b\"CLAT\" {\r\n        return Meta {\r\n            write_stamp: 0,\r\n            crash: None,\r\n            guid: [0; 16],\r\n            companion: 0,\r\n        };\r\n"]
[9.300148, "o", "    }\r\n    let write_stamp = u32::from_le_bytes(b[6..10].try_into().unwrap());\r\n    let n = u16::from_le_bytes(b[10..12].try_into().unwrap()) as usize;\r\n    let mut crash = None;\r\n    let mut guid = [0u8; 16];\r\n    let mut companion = 0u8;\r\n    let mut off = 12usize;\r\n    for _ in 0..n {\r\n        if off + 12 > b.len() {\r\n            break;\r\n        }\r\n        let st = u32::from_le_bytes(b[off..off + 4].try_into().unwrap());\r\n        let rva = u32::from_le_bytes(b[off + 4..off + 8].try_into().unwrap()) as usize;\r\n        let sz = u32::from_le_bytes(b[off + 8..off + 12].try_into().unwrap()) as usize;\r\n        off += 12;\r\n        if rva + sz > b.len() {\r\n            continue;\r\n        }\r\n        let sl = &b[rva..rva + sz];\r\n        if st == 3 && sl.len() >= 8 {\r\n            let lo = u32::from_le_bytes(sl[0..4].try_into().unwrap());\r\n            let hi = u32::from_le_bytes(sl[4..8].try_into().unwrap());\r\n            crash = Some((lo, hi));\r\n        }\r\n        if st == 15 && sl.len() >= 17 {\r\n            guid.copy_from_slice(&sl[0..16]);\r\n            companion = sl[16];\r\n        }\r\n    }\r\n    Meta {\r\n        write_stamp,\r\n        crash,\r\n        guid,\r\n        companion,\r\n    }\r\n}\r\n\r\npub fn guid_hex(g: &[u8; 16]) -> String {\r\n"]
[9.300227, "o", "    g.iter().map(|x| format!(\"{:02x}\", x)).collect()\r\n}\r\n"]
[9.300454, "o", "### /app/deskbin/pipe.rs\r\n"]
[9.301468, "o", "use std::fs;\r\n\r\npub fn fill() -> i32 {\r\n    match crate::walk::rib_a() {\r\n        Err(c) => {\r\n            let _ = fs::remove_file(\"/app/kegbay/MARK\");\r\n            c\r\n        }\r\n        Ok(names) => {\r\n            let pairs = crate::stamp::rib_b(&names);\r\n            fs::create_dir_all(\"/app/kegbay\").ok();\r\n            let mut body = String::new();\r\n            for (n, k) in pairs {\r\n                body.push_str(&format!(\"{}\\t{}\\n\", n, k));\r\n            }\r\n            fs::write(\"/app/kegbay/pairs.tmp\", body).ok();\r\n            0\r\n        }\r\n    }\r\n}\r\n"]
[9.301772, "o", "### /app/deskbin/sum.rs\r\n"]
[9.302804, "o", "use std::process::Command;\r\n\r\npub fn hex_file(path: &str) -> String {\r\n    let out = Command::new(\"sha256sum\")\r\n        .arg(path)\r\n        .output()\r\n        .ok()\r\n        .and_then(|o| String::from_utf8(o.stdout).ok())\r\n        .unwrap_or_default();\r\n    out.split_whitespace().next().unwrap_or(\"\").to_string()\r\n}\r\n"]
[9.303097, "o", "### /app/deskbin/usage.txt\r\n"]
[9.304034, "o", "clatter tallow\r\nclatter pour [dir]\r\n"]
[9.304331, "o", "### /app/dropwalk/mtime.rs\r\n"]
[9.305326, "o", "use std::fs;\r\nuse std::time::SystemTime;\r\n\r\npub fn newest_first(root: &str) -> Vec<String> {\r\n"]
[9.305447, "o", "    let mut rows: Vec<(SystemTime, String)> = Vec::new();\r\n    if let Ok(rd) = fs::read_dir(root) {\r\n        for ent in rd.flatten() {\r\n            let p = ent.path();\r\n            let t = fs::metadata(&p)\r\n                .and_then(|m| m.modified())\r\n                .unwrap_or(SystemTime::UNIX_EPOCH);\r\n            rows.push((t, p.to_string_lossy().to_string()));\r\n        }\r\n"]
[9.305556, "o", "    }\r\n    rows.sort_by(|a, b| b.0.cmp(&a.0));\r\n    rows.into_iter().map(|r| r.1).collect()\r\n}\r\n"]
[9.305669, "o", "### /app/fat.sh\r\n"]
[9.306683, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin\r\nrustc --edition 2021 -O /app/deskbin/main.rs -o /app/bin/clatter\r\n"]
[9.306902, "o", "### /app/fold.rs\r\n"]
[9.307897, "o", "use std::collections::HashMap;\r\n\r\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\r\n    if let Some(r) = root {\r\n        if r.is_empty() {\r\n            return Err(1);\r\n        }\r\n"]
[9.308, "o", "    }\r\n    if pairs.is_empty() {\r\n        return Ok(Vec::new());\r\n    }\r\n    let mut by: HashMap<[u8; 16], Vec<(u64, String)>> = HashMap::new();\r\n    for (n, k) in pairs {\r\n        let m = crate::parse::load(n);\r\n        by.entry(m.guid).or_default().push((*k, n.clone()));\r\n    }\r\n    let mut out = Vec::new();\r\n    for (_g, mut rows) in by {\r\n        rows.sort_by_key(|r| r.0);\r\n        out.extend(rows.into_iter().map(|r| r.1));\r\n"]
[9.308066, "o", "    }\r\n    Ok(out)\r\n}\r\n"]
[9.308202, "o", "### /app/kegbay/MARK\r\n"]
[9.309193, "o", "ok"]
[9.309435, "o", "### /app/kegbay/batch.tsv\r\n"]
[9.310487, "o", "seq\tname\tdigest\tguid\r\n1\told.clat\t6727175f53e5a66f47bff49403667cfaf694b2f2e7b7729a399234cda98b67f5\t01010101010101010101010101010101\r\n2\td.clat\t157d37e1dcfae2297edb4836bf331beee40e1621fe0a350cc1c7359d06b0caea\t03030303030303030303030303030303\r\n3\te.clat\tf1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\r\n4\ta.clat\t224cbf56792e0184b9ad97ad92ad0a102631c7ef419cb9d25c1f25d649af4713\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n5\tb.clat\t6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\t02020202020202020202020202020202\r\n"]
[9.310694, "o", "### /app/kegbay/pairs.tmp\r\n"]
[9.311741, "o", "/app/dropwell/b.clat\t8998192055516855370\r\n/app/dropwell/e.clat\t1151232654778118725\r\n/app/dropwell/d.clat\t2424766186904783305\r\n/app/dropwell/a.clat\t146307614292711240\r\n/app/dropwell/old.clat\t16845151456255592015\r\n"]
[9.311927, "o", "### /app/kegbay/ribbon.txt\r\n"]
[9.313023, "o", "1\t/app/dropwell/old.clat\t01010101010101010101010101010101\r\n2\t/app/dropwell/d.clat\t03030303030303030303030303030303\r\n3\t/app/dropwell/e.clat\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\r\n4\t/app/dropwell/a.clat\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n5\t/app/dropwell/b.clat\t02020202020202020202020202020202\r\n"]
[9.313335, "o", "### /app/kegbay/upload.json\r\n"]
[9.314416, "o", "{\"batch_count\":2,\"entries\":[{\"seq\":1,\"name\":\"old.clat\",\"digest\":\"6727175f53e5a66f47bff49403667cfaf694b2f2e7b7729a399234cda98b67f5\",\"guid\":\"01010101010101010101010101010101\"},{\"seq\":2,\"name\":\"d.clat\",\"digest\":\"157d37e1dcfae2297edb4836bf331beee40e1621fe0a350cc1c7359d06b0caea\",\"guid\":\"03030303030303030303030303030303\"},{\"seq\":3,\"name\":\"e.clat\",\"digest\":\"f1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\",\"guid\":\"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"},{\"seq\":4,\"name\":\"a.clat\",\"digest\":\"224cbf56792e0184b9ad97ad92ad0a102631c7ef419cb9d25c1f25d649af4713\",\"guid\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"seq\":5,\"name\":\"b.clat\",\"digest\":\"6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\",\"guid\":\"02020202020202020202020202020202\"}]}\r\n"]
[9.314588, "o", "### /app/opsheet/FORMAT.txt\r\n"]
[9.315616, "o", "CLAT dump (little-endian):\r\n\r\n  magic     4 bytes  \"CLAT\"\r\n  version   u16\r\n  write_stamp u32   dump-write unix seconds\r\n  nstreams  u16\r\n  then n directory entries: stype u32, rva u32, size u32\r\n\r\nStream type 3 (exception): dwLowDateTime u32, dwHighDateTime u32, code u32.\r\nThose two dwords are a Windows FILETIME (100-nanosecond ticks; 10000000 ticks per second).\r\nThe FILETIME epoch is 1601-01-01, 11644473600 seconds before Unix epoch.\r\n\r\nStream type 15 (misc): 16-byte guid, then companion u8 (0 = primary, 1 = extra).\r\n\r\nDigest on the keg is SHA-256 (sha256) of the dump file, written as lowercase hex.\r\n\r\n"]
[9.315753, "o", "Extra dumps added under the well, including names such as mid.clat, use this same layout.\r\nFixture copies of the well live at /app/seed/dropwell.\r\n"]
[9.315847, "o", "### /app/opsheet/MTIME_NOTE.txt\r\n"]
[9.316809, "o", "Scanner already walks newest mtime first via dropwalk. Burst dumps from one crash wave share the same mtime, so that listing is a stable starting point for the ribbon.\r\n"]
[9.317024, "o", "### /app/opsheet/ROUTE.txt\r\n"]
[9.31811, "o", "Pipeline modules live with the CLI under /app/deskbin and as sibling sources under /app. Spool bytes sit in /app/dropwell. Fixture copies sit at /app/seed/dropwell. Side listing helper is /app/dropwalk.\r\n"]
