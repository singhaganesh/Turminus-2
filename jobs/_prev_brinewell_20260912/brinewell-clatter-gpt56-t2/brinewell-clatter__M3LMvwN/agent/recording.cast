[85.355589, "o", "\u001b[?2004h> "]
[85.355617, "o", "            out.push(name);\r\n\u001b[?2004l\r"]
[85.355825, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.355965, "o", "    out.sort();\r\n\u001b[?2004l\rn mark_f\u001b[?2004h> "]
[85.356243, "o", "    if out.is_empty() { Err(1) } else { Ok(out) }\r\n\u001b[?2004l\r"]
[85.357184, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[85.360017, "o", "\u001b[?2004hroot@c9a363802c40:/app# cat > /app/stamp.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> pub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\r\n\u001b[?2004l\r\u001b[?2004h>     names.iter().map(|n| {\r\n\u001b[?2004l\r\u001b[?2004h>         let m = crate::parse::load(n);\r\n\u001b[?2004l\r\u001b[?2004h>         let key = match m.crash {\r\n\u001b[?2004l\r\u001b[?2004h>             Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\r\n\u001b[?2004l\r\u001b[?2004h>             None => m.write_stamp as u64,\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r\u001b[?2004h>         (n.clone(), key)\r\n\u001b[?2004l\r\u001b[?2004h>     }).collect()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[85.360179, "o", "r().any(|x| x == path) || !represented.insert(path.to_string()) { return mark_false(); }\r\n        let name = match Path::new(path).file_name().and_then(|x| x.to_str()) { Some(x)=>x.to_string(), None=>return mark_false() };\r\n        rows.push((seq, name, crate::sum::hex_file(path), p[2].to_string()));\r\n    }\r\n    if rows.len() != well.len() || rows"]
[85.361585, "o", "\u001b[?2004hroot@c9a363802c40:/app# "]
[85.361784, "o", "cat > /app/deskbin/pipe.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.361837, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.361877, "o", "\u001b[?2004h> "]
[85.36204, "o", "fn fail(code: i32) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.362277, "o", "    let _ = fs::create_dir_all(\"/app/kegbay\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.362399, "o", "> "]
[85.36259, "o", "    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.362643, "o", "    code\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[85.36278, "o", "\u001b[?2004h> pub fn fill() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.362828, "o", "> "]
[85.362981, "o", "    let names = match crate::walk::rib_a() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.363117, "o", "        Ok(v) if !v.is_empty() => v,\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.363227, "o", "> "]
[85.363301, "o", "        Ok(_) => return fail(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.363447, "o", "        Err(c) => return fail(c),\r\n\u001b[?2004l\r"]
[85.363536, "o", "\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.363686, "o", "    let pairs = crate::stamp::rib_b(&names);\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.363765, "o", "> "]
[85.363958, "o", "    if fs::create_dir_all(\"/app/kegbay\").is_err() { return fail(1); }\r\n\u001b[?2004l\r"]
[85.364052, "o", "\u001b[?2004h> "]
[85.364156, "o", "    let mut body = String::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.364401, "o", "    for (n, k) in pairs { body.push_str(&format!(\"{}\\t{}\\n\", n, k)); }\r\n\u001b[?2004l\r"]
[85.364441, "o", "\u001b[?2004h> "]
[85.364709, "o", "    if fs::write(\"/app/kegbay/pairs.tmp\", body).is_err() { return fail(1); }\r\n\u001b[?2004l\r"]
[85.364743, "o", "\u001b[?2004h> "]
[85.36478, "o", "    0\r\n\u001b[?2004l\r"]
[85.364958, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[85.366276, "o", "\u001b[?2004hroot@c9a363802c40:/app# "]
[85.36648, "o", "cat > /app/deskbin/emit.rs <<'RS'\r\n\u001b[?2004l\r"]
[85.366615, "o", "\u001b[?2004h> "]
[85.366713, "o", "use std::collections::{HashMap, HashSet};\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.366796, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.36694, "o", "use std::path::{Path, PathBuf};\r\n\u001b[?2004l\r"]
[85.367036, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.367145, "o", "fn mark_false() -> i32 {\r\n\u001b[?2004l\r"]
[85.367195, "o", "\u001b[?2004h> "]
[85.36733, "o", "    let _ = fs::create_dir_all(\"/app/kegbay\");\r\n\u001b[?2004l\r"]
[85.367414, "o", "\u001b[?2004h> "]
[85.367489, "o", "    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\r\n\u001b[?2004l\r"]
[85.367584, "o", "\u001b[?2004h>     1\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[85.367679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.367759, "o", "fn read_pairs() -> Vec<String> {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.36793, "o", "    let raw = fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default();\r\n\u001b[?2004l\r"]
[85.368004, "o", "\u001b[?2004h> "]
[85.368081, "o", "    let mut seen = HashSet::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.368181, "o", "    raw.lines().filter_map(|line| {\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.368221, "o", "> "]
[85.368328, "o", "        let n = line.split('\\t').next()?.to_string();\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.36837, "o", "> "]
[85.368472, "o", "        if seen.insert(n.clone()) { Some(n) } else { None }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.368555, "o", "    }).collect()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[85.368633, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.368721, "o", "fn last_good() -> HashMap<String, u32> {\r\n\u001b[?2004l\r"]
[85.368795, "o", "\u001b[?2004h> "]
[85.368845, "o", "    let mut out = HashMap::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.369048, "o", "    for line in fs::read_to_string(\"/app/tidearc/lastgood.rec\").unwrap_or_default().lines() {\r\n\u001b[?2004l\r"]
[85.369129, "o", "\u001b[?2004h> "]
[85.369218, "o", "        let p: Vec<&str> = line.split('\\t').collect();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.3693, "o", "        if p.len() >= 2 {\r\n\u001b[?2004l\r"]
[85.369375, "o", "\u001b[?2004h> "]
[85.369512, "o", "            if let Ok(seq) = p[0].parse::<u32>() { out.insert(p[1].to_string(), seq); }\r\n\u001b[?2004l\r"]
[85.369616, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.369652, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.369686, "o", "    out\r\n\u001b[?2004l\r"]
[85.369724, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[85.369767, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.369803, "o", "\u001b[?2004h> "]
[85.370061, "o", "pub fn finish() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let names = read_pairs();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.370194, "o", "    if names.is_empty() { return mark_false(); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.370283, "o", ">     let old = last_good();\r\n\u001b[?2004l\r"]
[85.370368, "o", "\u001b[?2004h>     let mut known = Vec::new();\r\n"]
[85.37046, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[85.370549, "o", "    let mut fresh = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.370636, "o", "    for path in names {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.370775, "o", "        let base = match Path::new(&path).file_name().and_then(|x| x.to_str()) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.370847, "o", "> "]
[85.370926, "o", "            Some(x) => x.to_string(), None => return mark_false(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.371014, "o", ">         };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.371231, "o", "        if let Some(&seq) = old.get(&base) { known.push((seq, base, path)); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.37132, "o", "> "]
[85.371388, "o", "        else { fresh.push((base, path)); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.371421, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.371628, "o", "    known.sort_by(|a,b| a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1)));\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.371739, "o", ">     fresh.sort_by(|a,b| a.0.cmp(&b.0));\r\n\u001b[?2004l\r"]
[85.371855, "o", "\u001b[?2004h> "]
[85.372021, "o", "    let mut rows: Vec<(u32,String,String)> = known.into_iter().map(|(s,b,p)|(s,b,p)).collect();\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.372121, "o", "> "]
[85.37224, "o", "    let mut seq = rows.iter().map(|r| r.0).max().unwrap_or(0) + 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.372339, "o", "> "]
[85.372445, "o", "    for (base,path) in fresh { rows.push((seq,base,path)); seq += 1; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.37254, "o", "> "]
[85.372628, "o", "    let mut ribbon = String::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.372717, "o", "    for (seq, _, path) in &rows {\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.372801, "o", "> "]
[85.372902, "o", "        let m = crate::parse::load(path);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.37318, "o", "        ribbon.push_str(&format!(\"{}\\t{}\\t{}\\n\", seq, path, crate::parse::guid_hex(&m.guid)));\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.373316, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.37348, "o", "    if fs::create_dir_all(\"/app/kegbay\").is_err() || fs::write(\"/app/kegbay/ribbon.txt\", ribbon).is_err() {\r\n\u001b[?2004l\r"]
[85.373518, "o", "\u001b[?2004h> "]
[85.37362, "o", "        return mark_false();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.373757, "o", "    }\r\n\u001b[?2004l\r"]
[85.373853, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.373947, "o", "fn valid_root(arg: Option<String>) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.374051, "o", "> "]
[85.374226, "o", "    let requested = PathBuf::from(arg.unwrap_or_else(|| \"/app/dropwell\".to_string()));\r\n\u001b[?2004l\r"]
[85.37432, "o", "\u001b[?2004h> "]
[85.374476, "o", "    match (fs::canonicalize(requested), fs::canonicalize(\"/app/dropwell\")) {\r\n\u001b[?2004l\r"]
[85.374574, "o", "\u001b[?2004h> "]
[85.37467, "o", "        (Ok(a), Ok(b)) => a == b,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.374763, "o", "        _ => false,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[85.37492, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.375009, "o", "pub fn pour() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.375177, "o", "    if !valid_root(std::env::args().nth(2)) { return mark_false(); }\r\n\u001b[?2004l\r"]
[85.375319, "o", "\u001b[?2004h> "]
[85.375461, "o", "    let well = match crate::walk::rib_a() { Ok(v) if !v.is_empty() => v, _ => return mark_false() };\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.375543, "o", "> "]
[85.375679, "o", "    let ribbon = fs::read_to_string(\"/app/kegbay/ribbon.txt\").unwrap_or_default();\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.375757, "o", "> "]
[85.375855, "o", "    let mut rows: Vec<(u32,String,String,String)> = Vec::new();\r\n\u001b[?2004l\r"]
[85.375929, "o", "\u001b[?2004h> "]
[85.376006, "o", "    let mut represented = HashSet::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.376115, "o", "    for line in ribbon.lines() {\r\n\u001b[?2004l\r"]
[85.376228, "o", "\u001b[?2004h> "]
[85.376332, "o", "        let p: Vec<&str> = line.split('\\t').collect();\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.376423, "o", "> "]
[85.376512, "o", "        if p.len() != 3 { return mark_false(); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.376673, "o", "        let seq = match p[0].parse::<u32>() { Ok(x) => x, Err(_) => return mark_false() };\r\n\u001b[?2004l\r"]
[85.376779, "o", "\u001b[?2004h>         let path = p[1];\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.376893, "o", "> "]
[85.377109, "o", "        if !well.iter().any(|x| x == path) || !represented.insert(path.to_string()) { return mark_false(); }\r\n\u001b[?2004l\r"]
[85.377267, "o", "\u001b[?2004h> "]
[85.377482, "o", "        let name = match Path::new(path).file_name().and_then(|x| x.to_str()) { Some(x)=>x.to_string(), None=>return mark_false() };\r\n\u001b[?2004l\r"]
[85.377657, "o", "\u001b[?2004h> "]
[85.377777, "o", "        rows.push((seq, name, crate::sum::hex_file(path), p[2].to_string()));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.378043, "o", "    if rows.len() != well.len() || rows.is_empty() || rows.iter().any(|r| r.2.len() != 64) { return mark_false(); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.378167, "o", ">     rows.sort_by_key(|r| r.0);\r\n\u001b[?2004l\r"]
[85.378257, "o", "\u001b[?2004h> "]
[85.378375, "o", "    let batches = (rows.len() + 2) / 3;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.378519, "o", "    let mut json = format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[\", batches);\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.378622, "o", "> "]
[85.378698, "o", "    for (i,(seq,name,digest,guid)) in rows.iter().enumerate() {\r\n\u001b[?2004l\r"]
[85.378801, "o", "\u001b[?2004h> "]
[85.378841, "o", "        if i != 0 { json.push(','); }\r\n\u001b[?2004l\r"]
[85.378874, "o", "\u001b[?2004h> "]
[85.379222, "o", "        json.push_str(&format!(\"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",seq,name,digest,guid));\r\n\u001b[?2004l\r"]
[85.379273, "o", "\u001b[?2004h> "]
[85.379312, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.379356, "o", "> "]
[85.379468, "o", "    json.push_str(\"]}\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.379697, "o", "    let mut tsv = String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.379849, "o", "    for (seq,name,digest,guid) in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\",seq,name,digest,guid)); }\r\n\u001b[?2004l\r"]
[85.379901, "o", "\u001b[?2004h> "]
[85.380383, "o", "    if fs::write(\"/app/kegbay/upload.json\",json).is_err() || fs::write(\"/app/kegbay/batch.tsv\",tsv).is_err() || fs::write(\"/app/kegbay/MARK\",\"ok\").is_err() { return mark_false(); }\r\n\u001b[?2004l\r"]
[85.380435, "o", "\u001b[?2004h>     0\r\n\u001b[?2004l\r"]
[85.380488, "o", "\u001b[?2004h> "]
[85.380543, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.38061, "o", "RS\r\n\u001b[?2004l\r"]
[85.382622, "o", "\u001b[?2004hroot@c9a363802c40:/app# "]
