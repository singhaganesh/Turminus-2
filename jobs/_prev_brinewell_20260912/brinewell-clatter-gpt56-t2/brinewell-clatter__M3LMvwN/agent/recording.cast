[21.519274, "i", "python3 - <<'PY'\nimport glob,struct,hashlib,os\nfor p in sorted(glob.glob('/app/dropwell/*')):\n b=open(p,'rb').read(); magic,ver,stamp,n=struct.unpack_from('<4sHIH',b)\n streams=[]\n for i in range(n):\n  typ,rva,size=struct.unpack_from('<III',b,12+12*i)\n  d=b[rva:rva+size]\n  if typ==3 and len(d)>=12:\n   lo,hi,code=struct.unpack_from('<III',d); val=(hi<<32)|lo\n   detail=f'filetime={val} unix={val//10000000-11644473600} code={code:#x}'\n  elif typ==15 and len(d)>=17: detail=f'guid={d[:16].hex()} companion={d[16]}'\n  else: detail=d.hex()\n  streams.append((typ,rva,size,detail))\n print(os.path.basename(p), 'ver',ver,'stamp',stamp,'n',n,'sha256',hashlib.sha256(b).hexdigest())\n for x in streams: print(' ',x)\nPY\n"]
[21.520512, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import glob,struct,hashlib,os\r\n\u001b[?2004l\r\u001b[?2004h> for p in sorted(glob.glob('/app/dropwell/*')):\r\n\u001b[?2004l\r\u001b[?2004h>  b=open(p,'rb').read(); magic,ver,stamp,n=struct.unpack_from('<4sHIH',b)\r\n\u001b[?2004l\r\u001b[?2004h>  streams=[]"]
