t+=1; }\n    let mut body=String::new();\n    for (seq,path,g) in rows { body.push_str(&format!("{}\\t{}\\t{}\\n",seq,path,g)); }\n    if fs::write("/app/kegbay/ribbon.txt",body).is_err() { fail(1) } else { 0 }\n}\npub fn pour() -> i32 {\n    let root=std::env::args().nth(2).unwrap_or_else(||"/app/dropwell".to_string());\n    if crate::fold::rib_c(&[],Some(&root)).is_err() { return fail(1); }\n    let current=match current_names() { Ok(x)=>x,Err(c)=>return fail(c) };\n    let ribbon=match fs::read_to_string("/app/kegbay/ribbon.txt") { Ok(x)=>x,Err(_)=>return fail(1) };\n    let mut rows:Vec<(u32,String,String,String)>=Vec::new();\n    let mut seen=BTreeSet::new();\n    for line in ribbon.lines() {\n        let p:Vec<&str>=line.split(\'\\t\').collect();\n        if p.len()!=3 { return fail(1); }\n        let seq=match p[0].parse::<u32>() { Ok(x)=>x,Err(_)=>return fail(1) };\n        let path=p[1];\n        let name=match Path::new(path).file_name() { Some(x)=>x.to_string_lossy().to_string(),None=>return fail(1) };\n        if !seen.insert(name.clone()) || !current.contains(&name) { return fail(1); }\n        let digest=crate::sum::hex_file(path);\n        if digest.len()!=64 { return fail(1); }\n        rows.push((seq,name,digest,p[2].to_string()));\n    }\n    rows.sort_by_key(|r|r.0);\n    if seen!=current || rows.iter().enumerate().any(|(i,r)|r.0 != i as u32+1) { return fail(1); }\n    let batches=(rows.len()+2)/3;\n    let entries:Vec<String>=rows.iter().map(|r|format!("{{\\"seq\\":{},\\"name\\":\\"{}\\",\\"digest\\":\\"{}\\",\\"guid\\":\\"{}\\"}}",r.0,r.1,r.2,r.3)).collect();\n    let json=format!("{{\\"batch_count\\":{},\\"entries\\":[{}]}}\\n",batches,entries.join(","));\n    let mut tsv=String::from("seq\\tname\\tdigest\\tguid\\n");\n    for r in &rows { tsv.push_str(&format!("{}\\t{}\\t{}\\t{}\\n",r.0,r.1,r.2,r.3)); }\n    if fs::write("/app/kegbay/upload.json",json).is_err() || fs::write("/app/kegbay/batch.tsv",tsv).is_err() { return fail(1); }\n    if fs::write("/app/kegbay/MARK","ok").is_err() { 1 } else { 0 }\n}\nEOF\nPATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin /app/fat.sh\nod -An -tx1 -N4 /app/bin/clatter\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
