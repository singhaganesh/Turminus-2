[70.852763, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[70.970182, "i", "cat > /app/deskbin/emit.rs <<'EOF'\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::fs;\nuse std::path::Path;\n\nfn fail(c: i32) -> i32 {\n    let _ = fs::create_dir_all(\"/app/kegbay\");\n    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\n    c\n}\nfn read_pairs() -> Vec<(String,u64)> {\n    fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default().lines().filter_map(|l| {\n        let mut p=l.split('\\t'); Some((p.next()?.to_string(),p.next()?.parse().ok()?))\n    }).collect()\n}\nfn prior() -> BTreeMap<String,u32> {\n    let mut out=BTreeMap::new();\n    if let Ok(s)=fs::read_to_string(\"/app/tidearc/lastgood.rec\") {\n        for l in s.lines() {\n            let p:Vec<&str>=l.split('\\t').collect();\n            if p.len()>=2 { if let Ok(n)=p[0].parse() { out.insert(p[1].to_string(),n); } }\n        }\n    }\n    out\n}\nfn current_names() -> Result<BTreeSet<String>,i32> {\n    Ok(crate::walk::rib_a()?.into_iter().filter_map(|p| Path::new(&p).file_name().map(|x|x.to_string_lossy().to_string())).collect())\n}\npub fn finish() -> i32 {\n    let ordered=match crate::fold::rib_c(&read_pairs(),None) { Ok(x)=>x,Err(c)=>return fail(c) };\n    let old=prior();\n    let mut used=BTreeSet::new();\n    let mut rows:Vec<(u32,String,String)>=Vec::new();\n    let mut fresh=Vec::new();\n    for path in ordered {\n        let name=match Path::new(&path).file_name() { Some(x)=>x.to_string_lossy().to_string(),None=>return fail(1) };\n        if !used.insert(name.clone()) { return fail(1); }\n        let guid=crate::parse::guid_hex(&crate::parse::load(&path).guid);\n        if let Some(seq)=old.get(&name) { rows.push((*seq,path,guid)); } else { fresh.push((path,guid)); }\n    }\n    if rows.is_empty() && fresh.is_empty() { return fail(1); }\n    rows.sort_by_key(|r|r.0);\n    for (i,r) in rows.iter().enumerate() { if r.0 != (i as u32)+1 { return fail(1); } }\n    let mut next=rows.len() as u32+1;\n    for (p,g) in fresh { rows.push((next,p,g)); next+=1; }\n    let mut body=String::new();\n    for (seq,path,g) in rows { body.push_str(&format!(\"{}\\t{}\\t{}\\n\",seq,path,g)); }\n    if fs::write(\"/app/kegbay/ribbon.txt\",body).is_err() { fail(1) } else { 0 }\n}\npub fn pour() -> i32 {\n    let root=std::env::args().nth(2).unwrap_or_else(||\"/app/dropwell\".to_string());\n    if crate::fold::rib_c(&[],Some(&root)).is_err() { return fail(1); }\n    let current=match current_names() { Ok(x)=>x,Err(c)=>return fail(c) };\n    let ribbon=match fs::read_to_string(\"/app/kegbay/ribbon.txt\") { Ok(x)=>x,Err(_)=>return fail(1) };\n    let mut rows:Vec<(u32,String,String,String)>=Vec::new();\n    let mut seen=BTreeSet::new();\n    for line in ribbon.lines() {\n        let p:Vec<&str>=line.split('\\t').collect();\n        if p.len()!=3 { return fail(1); }\n        let seq=match p[0].parse::<u32>() { Ok(x)=>x,Err(_)=>return fail(1) };\n        let path=p[1];\n        let name=match Path::new(path).file_name() { Some(x)=>x.to_string_lossy().to_string(),None=>return fail(1) };\n        if !seen.insert(name.clone()) || !current.contains(&name) { return fail(1); }\n        let digest=crate::sum::hex_file(path);\n        if digest.len()!=64 { return fail(1); }\n        rows.push((seq,name,digest,p[2].to_string()));\n    }\n    rows.sort_by_key(|r|r.0);\n    if seen!=current || rows.iter().enumerate().any(|(i,r)|r.0 != i as u32+1) { return fail(1); }\n    let batches=(rows.len()+2)/3;\n    let entries:Vec<String>=rows.iter().map(|r|format!(\"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",r.0,r.1,r.2,r.3)).collect();\n    let json=format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[{}]}}\\n\",batches,entries.join(\",\"));\n    let mut tsv=String::from(\"seq\\tname\\tdigest\\tguid\\n\");\n    for r in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\",r.0,r.1,r.2,r.3)); }\n    if fs::write(\"/app/kegbay/upload.json\",json).is_err() || fs::write(\"/app/kegbay/batch.tsv\",tsv).is_err() { return fail(1); }\n    if fs::write(\"/app/kegbay/MARK\",\"ok\").is_err() { 1 } else { 0 }\n}\nEOF\nPATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin /app/fat.sh\nod -An -tx1 -N4 /app/bin/clatter\n"]
[70.970467, "o", "cat > /app/deskbin/emit.rs <<'EOF'\r\n\u001b[?2004l\r"]
[70.9706, "o", "\u001b[?2004h> "]
[70.970752, "o", "use std::collections::{BTreeMap, BTreeSet};\r\n\u001b[?2004l\r"]
[70.973737, "o", "\u001b[?2004h> use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> use std::path::Path;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn fail(c: i32) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::create_dir_all(\"/app/kegbay\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\r\n\u001b[?2004l\r\u001b[?2004h>     c\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fn read_pairs() -> Vec<(String,u64)> {\r\n\u001b[?2004l\r\u001b[?2004h>     fs::read_to_string(\"/app/kegbay/pairs.tmp\").unwrap_or_default().lines().filter_map(|l| {\r\n\u001b[?2004l\r\u001b[?2004h>         let mut p=l.split('\\t'); Some((p.next()?.to_string(),p.next()?.parse().ok()?))\r\n\u001b[?2004l\r\u001b[?2004h>     }).collect()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fn prior() -> BTreeMap<String,u32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let mut out=BTreeMap::new();\r\n\u001b[?2004l\r\u001b[?2004h>     if let Ok(s)=fs::read_to_string(\"/app/tidearc/lastgood.rec\") {\r\n\u001b[?2004l\r\u001b[?2004h>         for l in s.lines() {\r\n\u001b[?2004l\r\u001b[?2004h>             let p:Vec<&str>=l.split('\\t').collect();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.975564, "o", "            if p.len()>=2 { if let Ok(n)=p[0].parse() { out.insert(p[1].to_string(),n); } }\r\n\u001b[?2004l\r"]
[70.975761, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.975876, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.975951, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.976052, "o", "fn current_names() -> Result<BTreeSet<String>,i32> {\r\n\u001b[?2004l\r"]
[70.976122, "o", "\u001b[?2004h> "]
[70.976532, "o", "    Ok(crate::walk::rib_a()?.into_iter().filter_map(|p| Path::new(&p).file_name().map(|x|x.to_string_lossy().to_string())).collect())\r\n\u001b[?2004l\r"]
[70.976615, "o", "\u001b[?2004h> "]
[70.976678, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.976826, "o", "pub fn finish() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.977027, "o", "    let ordered=match crate::fold::rib_c(&read_pairs(),None) { Ok(x)=>x,Err(c)=>return fail(c) };\r\n\u001b[?2004l\r"]
[70.977124, "o", "\u001b[?2004h> "]
[70.977237, "o", "    let old=prior();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.977358, "o", "    let mut used=BTreeSet::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.977475, "o", "    let mut rows:Vec<(u32,String,String)>=Vec::new();\r\n\u001b[?2004l\r"]
[70.977563, "o", "\u001b[?2004h> "]
[70.97768, "o", "    let mut fresh=Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.977764, "o", "    for path in ordered {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.978051, "o", "        let name=match Path::new(&path).file_name() { Some(x)=>x.to_string_lossy().to_string(),None=>return fail(1) };\r\n\u001b[?2004l\r"]
[70.978121, "o", "\u001b[?2004h> "]
[70.97823, "o", "        if !used.insert(name.clone()) { return fail(1); }\r\n\u001b[?2004l\r"]
[70.978304, "o", "\u001b[?2004h> "]
[70.97853, "o", "        let guid=crate::parse::guid_hex(&crate::parse::load(&path).guid);\r\n\u001b[?2004l\r"]
[70.978652, "o", "\u001b[?2004h"]
[70.978746, "o", "> "]
[70.978877, "o", "        if let Some(seq)=old.get(&name) { rows.push((*seq,path,guid)); } else { fresh.push((path,guid)); }\r\n\u001b[?2004l\r"]
[70.978941, "o", "\u001b[?2004h> "]
[70.979, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.979122, "o", "    if rows.is_empty() && fresh.is_empty() { return fail(1); }\r\n\u001b[?2004l\r"]
[70.979164, "o", "\u001b[?2004h> "]
[70.979247, "o", "    rows.sort_by_key(|r|r.0);\r\n\u001b[?2004l\r"]
[70.979289, "o", "\u001b[?2004h> "]
[70.979495, "o", "    for (i,r) in rows.iter().enumerate() { if r.0 != (i as u32)+1 { return fail(1); } }\r\n\u001b[?2004l\r"]
[70.979543, "o", "\u001b[?2004h> "]
[70.97962, "o", "    let mut next=rows.len() as u32+1;\r\n\u001b[?2004l\r"]
[70.979663, "o", "\u001b[?2004h> "]
[70.979801, "o", "    for (p,g) in fresh { rows.push((next,p,g)); next+=1; }\r\n\u001b[?2004l\r"]
[70.979844, "o", "\u001b[?2004h> "]
[70.97992, "o", "    let mut body=String::new();\r\n\u001b[?2004l\r"]
[70.979964, "o", "\u001b[?2004h> "]
[70.980144, "o", "    for (seq,path,g) in rows { body.push_str(&format!(\"{}\\t{}\\t{}\\n\",seq,path,g)); }\r\n\u001b[?2004l\r"]
[70.980217, "o", "\u001b[?2004h> "]
[70.980438, "o", "    if fs::write(\"/app/kegbay/ribbon.txt\",body).is_err() { fail(1) } else { 0 }\r\n\u001b[?2004l\r"]
[70.980555, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.980621, "o", "pub fn pour() -> i32 {\r\n\u001b[?2004l\r"]
[70.980689, "o", "\u001b[?2004h> "]
[70.980865, "o", "    let root=std::env::args().nth(2).unwrap_or_else(||\"/app/dropwell\".to_string());\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.980937, "o", "> "]
[70.981064, "o", "    if crate::fold::rib_c(&[],Some(&root)).is_err() { return fail(1); }\r\n\u001b[?2004l\r"]
[70.981124, "o", "\u001b[?2004h"]
[70.981174, "o", "> "]
[70.981293, "o", "    let current=match current_names() { Ok(x)=>x,Err(c)=>return fail(c) };\r\n\u001b[?2004l\r"]
[70.981361, "o", "\u001b[?2004h> "]
[70.981566, "o", "    let ribbon=match fs::read_to_string(\"/app/kegbay/ribbon.txt\") { Ok(x)=>x,Err(_)=>return fail(1) };\r\n\u001b[?2004l\r"]
[70.981626, "o", "\u001b[?2004h> "]
[70.98175, "o", "    let mut rows:Vec<(u32,String,String,String)>=Vec::new();\r\n\u001b[?2004l\r"]
[70.981805, "o", "\u001b[?2004h"]
[70.981865, "o", "> "]
[70.981931, "o", "    let mut seen=BTreeSet::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.98199, "o", "    for line in ribbon.lines() {\r\n\u001b[?2004l\r"]
[70.982034, "o", "\u001b[?2004h> "]
[70.982178, "o", "        let p:Vec<&str>=line.split('\\t').collect();\r\n\u001b[?2004l\r"]
[70.982228, "o", "\u001b[?2004h> "]
[70.982329, "o", "        if p.len()!=3 { return fail(1); }\r\n\u001b[?2004l\r"]
[70.982457, "o", "\u001b[?2004h> "]
[70.982595, "o", "        let seq=match p[0].parse::<u32>() { Ok(x)=>x,Err(_)=>return fail(1) };\r\n\u001b[?2004l\r"]
[70.982641, "o", "\u001b[?2004h> "]
[70.982683, "o", "        let path=p[1];\r\n\u001b[?2004l\r"]
[70.982725, "o", "\u001b[?2004h> "]
[70.982959, "o", "        let name=match Path::new(path).file_name() { Some(x)=>x.to_string_lossy().to_string(),None=>return fail(1) };\r\n\u001b[?2004l\r"]
[70.983003, "o", "\u001b[?2004h> "]
[70.98317, "o", "        if !seen.insert(name.clone()) || !current.contains(&name) { return fail(1); }\r\n\u001b[?2004l\r"]
[70.983212, "o", "\u001b[?2004h> "]
[70.983303, "o", "        let digest=crate::sum::hex_file(path);\r\n\u001b[?2004l\r"]
[70.983363, "o", "\u001b[?2004h> "]
[70.983489, "o", "        if digest.len()!=64 { return fail(1); }\r\n\u001b[?2004l\r"]
[70.983535, "o", "\u001b[?2004h> "]
[70.983663, "o", "        rows.push((seq,name,digest,p[2].to_string()));\r\n\u001b[?2004l\r"]
[70.983702, "o", "\u001b[?2004h> "]
[70.983746, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.983808, "o", "    rows.sort_by_key(|r|r.0);\r\n\u001b[?2004l\r"]
[70.983851, "o", "\u001b[?2004h> "]
[70.98405, "o", "    if seen!=current || rows.iter().enumerate().any(|(i,r)|r.0 != i as u32+1) { return fail(1); }\r\n\u001b[?2004l\r"]
[70.984093, "o", "\u001b[?2004h> "]
[70.984154, "o", "    let batches=(rows.len()+2)/3;\r\n\u001b[?2004l\r"]
[70.984195, "o", "\u001b[?2004h> "]
[70.984518, "o", "    let entries:Vec<String>=rows.iter().map(|r|format!(\"{{\\\"seq\\\":{},\\\"name\\\":\\\"{}\\\",\\\"digest\\\":\\\"{}\\\",\\\"guid\\\":\\\"{}\\\"}}\",r.0,r.1,r.2,r.3)).collect();\r\n\u001b[?2004l\r"]
[70.984567, "o", "\u001b[?2004h> "]
[70.984748, "o", "    let json=format!(\"{{\\\"batch_count\\\":{},\\\"entries\\\":[{}]}}\\n\",batches,entries.join(\",\"));\r\n\u001b[?2004l\r"]
[70.984791, "o", "\u001b[?2004h> "]
[70.984936, "o", "    let mut tsv=String::from(\"seq\\tname\\tdigest\\tguid\\n\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.984993, "o", "> "]
[70.98512, "o", "    for r in &rows { tsv.push_str(&format!(\"{}\\t{}\\t{}\\t{}\\n\",r.0,r.1,r.2,r.3)); }\r\n\u001b[?2004l\r"]
[70.985161, "o", "\u001b[?2004h> "]
[70.985444, "o", "    if fs::write(\"/app/kegbay/upload.json\",json).is_err() || fs::write(\"/app/kegbay/batch.tsv\",tsv).is_err() { return fail(1); }\r\n\u001b[?2004l\r"]
[70.98549, "o", "\u001b[?2004h> "]
[70.985631, "o", "    if fs::write(\"/app/kegbay/MARK\",\"ok\").is_err() { 1 } else { 0 }\r\n\u001b[?2004l\r"]
[70.985671, "o", "\u001b[?2004h> }\r\n"]
[70.985713, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[70.985794, "o", "EOF\r\n\u001b[?2004l\r"]
[70.988606, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[70.989552, "o", "PATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin /app/fat.sh\r\n\u001b[?2004l\r"]
[74.919915, "i", "set -e\n/app/bin/clatter tallow\n/app/bin/clatter pour\ncp /app/kegbay/upload.json /tmp/upload.first\ncp /app/kegbay/batch.tsv /tmp/batch.first\n/app/bin/clatter tallow\n/app/bin/clatter pour\ncmp /tmp/upload.first /app/kegbay/upload.json\ncmp /tmp/batch.first /app/kegbay/batch.tsv\ncat /app/kegbay/MARK\ncat /app/kegbay/batch.tsv\ncat /app/kegbay/upload.json\n"]
[74.921452, "o", "set -e\r\n/app/bin/clatter tallow\r\n/app/bin/clatter pour\r\ncp /app/kegbay/upload.json /tmp/upload.first\r\ncp /app/kegbay/batch.tsv /tmp/batch.first\r\n/app/bin/clatter tallow\r\n/app/bin/clatter pour\r\ncmp /tmp/upload.first /app/kegbay/upload.json\r\ncmp /tmp/batch.first /app/kegbay/batch.tsv\r\ncat /app/kegbay/MARK\r\ncat /app/kegbay/batch.tsv\r\ncat /app/kegbay/upload.json\r\n"]
[75.96812, "i", "set +e\n/app/bin/clatter pour /app/scratch >/tmp/out 2>/tmp/err\nr=$?; echo outside_rc=$r mark=$(cat /app/kegbay/MARK)\nset -e\n/app/bin/clatter tallow\n/app/bin/clatter pour\nprintf 'final_mark='; cat /app/kegbay/MARK; echo\n"]
[75.968278, "o", "set +e\r\n/app/bin/clatter pour /app/scratch >/tmp/out 2>/tmp/err\r\nr=$?; echo outside_rc=$r mark=$(cat /app/kegbay/MARK)\r\nset -e\r\n/app/bin/clatter tallow\r\n/app/bin/clatter pour\r\nprintf 'final_mark='; cat /app/kegbay/MARK; echo\r\n"]
[76.085566, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.085657, "o", "od -An -tx1 -N4 /app/bin/clatter\r\n\u001b[?2004l\r"]
[76.086615, "o", " 7f 45 4c 46\r\n"]
[76.086829, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.086909, "o", "set -e\r\n\u001b[?2004l\r"]
[76.086991, "o", "\u001b[?2004hroot@bbd200269bb7:/app# /app/bin/clatter tallow\r\n\u001b[?2004l\r"]
[76.089071, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.089202, "o", "/app/bin/clatter pour\r\n\u001b[?2004l\r"]
[76.095719, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.095773, "o", "cp /app/kegbay/upload.json /tmp/upload.first\r\n\u001b[?2004l\r"]
[76.098708, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.098891, "o", "cp /app/kegbay/batch.tsv /tmp/batch.first\r\n\u001b[?2004l\r"]
[76.100591, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.100799, "o", "/app/bin/clatter tallow\r\n\u001b[?2004l\r"]
[76.102501, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.102553, "o", "/app/bin/clatter pour\r\n\u001b[?2004l\r"]
[76.108608, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.108763, "o", "cmp /tmp/upload.first /app/kegbay/upload.json\r\n\u001b[?2004l\r"]
[76.110479, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.110637, "o", "cmp /tmp/batch.first /app/kegbay/batch.tsv\r\n\u001b[?2004l\r"]
[76.111693, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.111819, "o", "cat /app/kegbay/MARK\r\n\u001b[?2004l\r"]
[76.11259, "o", "ok"]
[76.112786, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.112899, "o", "cat /app/kegbay/batch.tsv\r\n\u001b[?2004l\r"]
[76.113626, "o", "seq\tname\tdigest\tguid\r\n1\told.clat\t6727175f53e5a66f47bff49403667cfaf694b2f2e7b7729a399234cda98b67f5\t01010101010101010101010101010101\r\n2\tb.clat\t6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\t02020202020202020202020202020202\r\n3\td.clat\t157d37e1dcfae2297edb4836bf331beee40e1621fe0a350cc1c7359d06b0caea\t03030303030303030303030303030303\r\n4\ta.clat\t224cbf56792e0184b9ad97ad92ad0a102631c7ef419cb9d25c1f25d649af4713\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n5\ta2.clat\t57fecb62f4f4fc23bb7917c03a6c02c1c4be698144a61ebdc5a87a24612c61a3\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n6\te.clat\tf1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\r\n7\te2.clat\t9af0e00cf837afe51af86ba105612013c528575571e198fbd2f60ed22cb91807\teeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\r\n"]
[76.113839, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.11395, "o", "cat /app/kegbay/upload.json\r\n\u001b[?2004l\r"]
[76.114649, "o", "{\"batch_count\":3,\"entries\":[{\"seq\":1,\"name\":\"old.clat\",\"digest\":\"6727175f53e5a66f47bff49403667cfaf694b2f2e7b7729a399234cda98b67f5\",\"guid\":\"01010101010101010101010101010101\"},{\"seq\":2,\"name\":\"b.clat\",\"digest\":\"6df95a0e059a72605d5fb9b059a306e415029a909e0c08dc6eb9aa8f928f6d5b\",\"guid\":\"02020202020202020202020202020202\"},{\"seq\":3,\"name\":\"d.clat\",\"digest\":\"157d37e1dcfae2297edb4836bf331beee40e1621fe0a350cc1c7359d06b0caea\",\"guid\":\"03030303030303030303030303030303\"},{\"seq\":4,\"name\":\"a.clat\",\"digest\":\"224cbf56792e0184b9ad97ad92ad0a102631c7ef419cb9d25c1f25d649af4713\",\"guid\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"seq\":5,\"name\":\"a2.clat\",\"digest\":\"57fecb62f4f4fc23bb7917c03a6c02c1c4be698144a61ebdc5a87a24612c61a3\",\"guid\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},{\"seq\":6,\"name\":\"e.clat\",\"digest\":\"f1694bc270e758e1c8cfd50bd6f1b043629c38ec2e32b4d0933a32f6743fdc46\",\"guid\":\"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"},{\"seq\":7,\"name\":\"e2.clat\",\"digest\":\"9af0e00cf837afe51af86ba105612013c528575571e198fbd2f60ed22cb91807\",\"guid\":\"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"}]}\r\n"]
[76.114865, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.114916, "o", "set +e\r\n\u001b[?2004l\r"]
[76.114954, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.115092, "o", "/app/bin/clatter pour /app/scratch >/tmp/out 2>/tmp/err\r\n\u001b[?2004l\r"]
[76.116423, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.11657, "o", "r=$?; echo outside_rc=$r mark=$(cat /app/kegbay/MARK)\r\n\u001b[?2004l\r"]
[76.117662, "o", "outside_rc=1 mark=false\r\n"]
[76.117761, "o", "\u001b[?2004hroot@bbd200269bb7:/app# set -e\r\n\u001b[?2004l\r"]
[76.117859, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.117941, "o", "/app/bin/clatter tallow\r\n\u001b[?2004l\r"]
[76.119685, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.119775, "o", "/app/bin/clatter pour\r\n\u001b[?2004l\r"]
[76.125926, "o", "\u001b[?2004hroot@bbd200269bb7:/app# "]
[76.126058, "o", "printf 'final_mark='; cat /app/kegbay/MARK; echo\r\n\u001b[?2004l\r"]
[76.126157, "o", "final_mark="]
[76.126791, "o", "ok"]
[76.126951, "o", "\r\n"]
[76.127026, "o", "\u001b[?2004h"]
