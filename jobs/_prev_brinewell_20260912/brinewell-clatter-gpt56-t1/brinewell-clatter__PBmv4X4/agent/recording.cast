[97.890693, "i", "set -e\nmkdir -p /tmp/empty-test-hold\nmv /app/dropwell/* /tmp/empty-test-hold/\nset +e\n/app/bin/clatter tallow >/tmp/empty.out 2>/tmp/empty.err\nr=$?\nset -e\necho empty_rc=$r mark=$(cat /app/kegbay/MARK)\ntest \"$r\" -ne 0\ntest \"$(cat /app/kegbay/MARK)\" = false\nmv /tmp/empty-test-hold/* /app/dropwell/\nrmdir /tmp/empty-test-hold\n/app/bin/clatter tallow\n/app/bin/clatter pour\n"]
