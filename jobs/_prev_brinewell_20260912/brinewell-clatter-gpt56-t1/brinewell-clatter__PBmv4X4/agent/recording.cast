[31.092658, "i", "nl -ba /app/deskbin/emit.rs; printf '%s\\n' '--- compiler paths ---'; ls -la /usr/local/cargo/bin /root/.cargo/bin 2>/dev/null || true; find /usr /opt -type f -name rustc 2>/dev/null | head; command -v gcc || true; command -v cc || true; gcc --version 2>/dev/null | head -1 || true\n"]
