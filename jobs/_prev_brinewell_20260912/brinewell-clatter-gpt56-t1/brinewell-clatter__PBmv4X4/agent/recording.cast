[70.833795, "i", "cat > /app/walk.rs <<'EOF'\nuse std::fs;\n\npub fn rib_a() -> Result<Vec<String>, i32> {\n    let root = \"/app/dropwell\";\n    let rd = fs::read_dir(root).map_err(|_| 1)?;\n    let mut names = Vec::new();\n    for ent in rd.flatten() {\n        let p = ent.path();\n        if !p.is_file() || p.extension().and_then(|s| s.to_str()) != Some(\"clat\") {\n            continue;\n        }\n        let s = p.to_string_lossy().to_string();\n        let b = match fs::read(&p) { Ok(x) => x, Err(_) => return Err(1) };\n        if b.len() < 12 || &b[..4] != b\"CLAT\" { return Err(1); }\n        let m = crate::parse::load(&s);\n        if m.guid == [0u8; 16] { return Err(1); }\n        names.push(s);\n    }\n    names.sort();\n    if names.is_empty() { Err(1) } else { Ok(names) }\n}\nEOF\ncat > /app/stamp.rs <<'EOF'\npub fn rib_b(names: &[String]) -> Vec<(String, u64)> {\n    names.iter().map(|n| {\n        let m = crate::parse::load(n);\n        let key = match m.crash {\n            Some((lo, hi)) => ((hi as u64) << 32) | lo as u64,\n            None => u64::MAX,\n        };\n        (n.clone(), key)\n    }).collect()\n}\nEOF\ncat > /app/fold.rs <<'EOF'\nuse std::collections::BTreeMap;\n\npub fn rib_c(pairs: &[(String, u64)], root: Option<&str>) -> Result<Vec<String>, i32> {\n    if let Some(r) = root {\n        let want = std::fs::canonicalize(\"/app/dropwell\").map_err(|_| 1)?;\n        let got = std::fs::canonicalize(r).map_err(|_| 1)?;\n        if got != want { return Err(1); }\n        return Ok(Vec::new());\n    }\n    if pairs.is_empty() { return Err(1); }\n    let mut groups: BTreeMap<[u8;16], Vec<(bool,u64,String)>> = BTreeMap::new();\n    for (name, key) in pairs {\n        let m = crate::parse::load(name);\n        groups.entry(m.guid).or_default().push((m.companion != 0, *key, name.clone()));\n    }\n    let mut grouped: Vec<(u64,String,Vec<String>)> = Vec::new();\n    for (_guid, mut rows) in groups {\n        rows.sort_by(|a,b| (a.0,a.1,&a.2).cmp(&(b.0,b.1,&b.2)));\n        let group_key = rows.iter().filter(|r| !r.0).map(|r| r.1).min().unwrap_or(u64::MAX);\n        let tie = rows[0].2.clone();\n        grouped.push((group_key, tie, rows.into_iter().map(|r| r.2).collect()));\n    }\n    grouped.sort_by(|a,b| (a.0,&a.1).cmp(&(b.0,&b.1)));\n    Ok(grouped.into_iter().flat_map(|r| r.2).collect())\n}\nEOF\ncat > /app/deskbin/pipe.rs <<'EOF'\nuse std::fs;\nfn fail(c: i32) -> i32 {\n    let _ = fs::create_dir_all(\"/app/kegbay\");\n    let _ = fs::write(\"/app/kegbay/MARK\", \"false\");\n    c\n}\npub fn fill() -> i32 {\n    match crate::walk::rib_a() {\n        Err(c) => fail(c),\n        Ok(names) => {\n            let pairs = crate::stamp::rib_b(&names);\n            if fs::create_dir_all(\"/app/kegbay\").is_err() { return fail(1); }\n            let body: String = pairs.into_iter().map(|(n,k)| format!(\"{}\\t{}\\n\",n,k)).collect();\n            if fs::write(\"/app/kegbay/pairs.tmp\", body).is_err() { fail(1) } else { 0 }\n        }\n    }\n}\nEOF\n"]
