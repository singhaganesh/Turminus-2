[98.985174, "i", "python3 - <<'PY'\nimport json, hashlib, pathlib\nroot=pathlib.Path('/app/dropwell')\nu=json.load(open('/app/kegbay/upload.json'))\nlines=open('/app/kegbay/batch.tsv').read().splitlines()\nassert lines[0]=='seq\\tname\\tdigest\\tguid'\nassert u['batch_count']==(len(u['entries'])+2)//3\nassert len(u['entries'])==len(list(root.glob('*.clat')))==7\nassert [e['seq'] for e in u['entries']]==list(range(1,8))\nassert len({e['name'] for e in u['entries']})==7\nfor e,line in zip(u['entries'],lines[1:]):\n    assert e['digest']==hashlib.sha256((root/e['name']).read_bytes()).hexdigest()\n    assert line=='\\t'.join(map(str,(e['seq'],e['name'],e['digest'],e['guid'])))\nassert pathlib.Path('/app/kegbay/MARK').read_text()=='ok'\nassert pathlib.Path('/app/bin/clatter').read_bytes()[:4]==b'\\x7fELF'\nprint('validated: ELF, 7 rows, SHA-256, JSON/TSV match, MARK=ok')\nPY\nls -l /app/bin/clatter /app/kegbay/upload.json /app/kegbay/batch.tsv /app/kegbay/MARK\n"]
