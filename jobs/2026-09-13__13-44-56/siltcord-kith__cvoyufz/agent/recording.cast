[148.289675, "o", "restore_quarry_rc=0\r\n\u001b[?2004h"]
[148.289828, "o", "root@4fc4e7f48e5c:/app# (/app/bin/siltcord brief /app/deskjson/pass-a.json) & p1=$!\r\n\u001b[?2004l\r"]
