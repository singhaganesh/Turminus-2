[101.307834, "o", "    let events = p.e.iter().map(|x| format!(\"\\\"{}\\\"\", esc(x))).collect::<Vec<_>>().join(\",\");\r\n\u001b[?2004l\r"]
[101.307906, "o", "\u001b[?2004h> "]
[101.308201, "o", "    let body = format!(\"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\r\n\u001b[?2004l\r"]
