[37.430369, "o", "nl -ba /app/overlaypit/blend.rs; printf '\\n--- INDEX HEX ---\\n'; od -Ax -tx1z /app/idxbay/members.idx | head -80\r\n\u001b[?2004l\r"]
[37.431532, "o", "     1\tpub struct Pack {\r\n     2\t    pub t: String,\r\n     3\t    pub c: String,\r\n     4\t    pub e: Vec<String>,\r\n     5\t    pub n: u32,\r\n     6\t    pub s: String,\r\n     7\t    pub w: String,\r\n     8\t}\r\n     9\t\r\n    10\tstruct Rec {\r\n    11\t    name: String,\r\n    12\t    hdr: u64,\r\n    13\t    size: u64,\r\n    14\t    body: u64,\r\n    15\t}\r\n    16\t\r\n    17"]
[37.431664, "o", "\tfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n    18\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    19\t    if raw.len() < 9 || &raw[0..5] != b\"SILT1\" {\r\n    20\t        return Err(1);\r\n    21\t    }\r\n    22\t    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap());\r\n    23\t    let mut i = 9usize;\r\n    24\t    let mut out = Vec::new();\r\n    25\t    for _ in 0..n {\r\n    26\t        if i + 26 > raw.len() {\r\n    27\t            return Err(1);\r\n    28\t        }\r\n    29\t        let hdr = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    30\t        i += 8;\r\n    31\t        let size = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    32\t        i += 8;\r\n    33\t        let body = u64::from_le_bytes(raw[i..i + 8].try_into().unwrap());\r\n    34\t        i += 8;\r\n    35\t        let nl = u16::from_le_bytes(raw[i..i + 2].try_into().unwrap()) as usize;\r\n    36\t        i += 2;\r\n    37\t        if i + nl > raw.len() {\r\n    38\t            return Err(1);\r\n    39\t        }\r\n    40\t        let name = String::from_utf8_lossy(&raw[i..i + nl]).to_string();\r\n    41\t        i += nl;\r\n    42\t        out.push(Rec {\r\n    43\t            name,\r\n    44\t            hdr,\r\n    45\t            size,\r\n    46\t            body,\r\n"]
[37.431691, "o", "    47\t        });\r\n    48\t    }\r\n    49\t    Ok(out)\r\n    50\t}\r\n    51\t\r\n    52\tfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\r\n    53\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    54\t    let s = body as usize;\r\n    55\t    let e = s + size as usize;\r\n    56\t    if e > raw.len() {\r\n    57\t        return Err(1);\r\n    58\t    }\r\n    59\t    Ok(raw[s..e].to_vec())\r\n    60\t}\r\n    61\t\r\n    62\tfn digest(text: &str) -> String {\r\n"]
[37.431889, "o", "    63\t    let mut cmd = std::process::Command::new(\"python3\");\r\n    64\t    cmd.args([\r\n    65\t        \"-c\",\r\n    66\t        \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\",\r\n    67\t    ])\r\n    68\t    .stdin(std::process::Stdio::piped())\r\n    69\t    .stdout(std::process::Stdio::piped());\r\n    70\t    let mut child = match cmd.spawn() {\r\n    71\t        Ok(c) => c,\r\n    72\t        Err(_) => return String::new(),\r\n    73\t    };\r\n    74\t    {\r\n    75\t        use std::io::Write;\r\n    76\t        if let Some(ref mut sin) = child.stdin {\r\n    77\t            let _ = sin.write_all(text.as_bytes());\r\n    78\t        }\r\n    79\t    }\r\n    80\t    drop(child.stdin.take());\r\n    81\t    match child.wait_with_output() {\r\n    82\t        Ok(out) => String::from_utf8_lossy(&out.stdout).trim().to_string(),\r\n    83\t        Err(_) => String::new(),\r\n    84\t    }\r\n    85\t}\r\n    86\t\r\n    87\t#[path = \"../keeppit/first.rs\"]\r\n    88\tmod first;\r\n    89\t#[path = \"../cfgbag/kv.rs\"]\r\n    90\tmod kv;\r\n    91\t#[path = \"../cfgbag/alias.rs\"]\r\n    92\tmod alias;\r\n    93\t\r\n    94\tpub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n    95\t    let recs = read_idx(b)?;\r\n    96\t    let mut confs: Vec<(String, u64, Vec<u8>)> = Vec::new();\r\n    97\t"]
[37.431918, "o", "    let mut logs: Vec<Vec<u8>> = Vec::new();\r\n    98\t    let mut bag: std::collections::HashMap<usize, String> = std::collections::HashMap::new();\r\n    99\t    for (i, r) in recs.iter().enumerate() {\r\n   100\t        bag.insert(i, r.name.clone());\r\n   101\t        let blob = load(a, r.body, r.size)?;\r\n   102\t        if r.name.contains(\"sys.conf\") {\r\n   103\t            confs.push((r.name.clone(), r.hdr, blob));\r\n   104\t        } else if r.name.contains(\"app.log\") {\r\n   105\t            logs.push(blob);\r\n   106\t        }\r\n   107\t    }\r\n   108\t    confs.sort_by_key(|row| row.1);\r\n   109\t    let picked = first::keep_head(&confs);\r\n   110\t    let mut t = String::new();\r\n   111\t    let mut c = String::new();\r\n   112\t    if let Some(blob) = picked {\r\n   113\t        let map = kv::pairs(&blob);\r\n   114\t        if let Some(v) = map.get(\"timezone\") {\r\n   115\t            t = v.clone();\r\n   116\t        }\r\n   117\t        if let Some(v) = map.get(\"cluster\") {\r\n   118\t            c = v.clone();\r\n   119\t        }\r\n   120\t    }\r\n   121\t    let mut e = Vec::new();\r\n   122\t    if let Some(blob) = logs.first() {\r\n"]
[37.431935, "o", "   123\t        for line in String::from_utf8_lossy(blob).lines() {\r\n   124\t            let s = line.trim();\r\n   125\t            if !s.is_empty() {\r\n"]
[37.431952, "o", "   126\t                e.push(s.to_string());\r\n"]
[37.431968, "o", "   127\t            }\r\n   128\t        }\r\n   129\t    }\r\n   130\t    e.sort();\r\n   131\t    e.dedup();\r\n   132\t    let names: Vec<String> = bag.values().cloned().collect();\r\n   133\t    let walk = names.join(\"\\n\");\r\n   134\t    let _ = alias::fold(\"\");\r\n   135\t    Ok(Pack {\r\n"]
[37.431983, "o", "   136\t        t,\r\n   137\t        c,\r\n   138\t        e,\r\n   139\t        n: confs.len() as u32,\r\n"]
[37.431992, "o", "   140\t        s: a.to_string(),\r\n   141\t        w: digest(&walk).to_ascii_uppercase(),\r\n   142\t    })\r\n"]
[37.432006, "o", "   143\t}\r\n"]
[37.432338, "o", "\r\n--- INDEX HEX ---\r\n"]
[37.433867, "o", "000000 53 49 4c 54 31 06 00 00 00 00 0c 00 00 00 00 00  >SILT1...........<\r\n000010 00 27 00 00 00 00 00 00 00 00 0e 00 00 00 00 00  >.'..............<\r\n000020 00 0e 00 2e 2f 65 74 63 2f 73 79 73 2e 63 6f 6e  >..../etc/sys.con<\r\n000030 66 00 04 00 00 00 00 00 00 09 00 00 00 00 00 00  >f...............<\r\n000040 00 00 06 00 00 00 00 00 00 0f 00 76 61 72 2f 6c  >...........var/l<\r\n000050 6f 67 2f 61 70 70 2e 6c 6f 67 00 10 00 00 00 00  >og/app.log......<\r\n000060 00 00 0b 00 00 00 00 00 00 00 00 12 00 00 00 00  >................<\r\n000070 00 00 0f 00 76 61 72 2f 6c 6f 67 2f 61 70 70 2e  >....var/log/app.<\r\n000080 6c 6f 67 00 18 00 00 00 00 00 00 06 00 00 00 00  >log.............<\r\n000090 00 00 00 00 1a 00 00 00 00 00 00 10 00 6f 70 74  >.............opt<\r\n0000a0 2f 61 70 70 2f 62 75 69 6c 64 2e 69 64 00 00 00  >/app/build.id...<\r\n0000b0 00 00 00 00 00 21 00 00 00 00 00 00 00 00 02 00  >.....!..........<\r\n0000c0 00 00 00 00 00 0c 00 65 74 63 2f 73 79 73 2e 63  >.......etc/sys.c<\r\n0000d0 6f 6e 66 00 14 00 00 00 00 00 00 14 00 00 00 00  >onf.............<\r\n0000e0 00 00 00 00 16 00 00 00 00 00 00 09 00 65 74 63  >.............etc<\r\n0000f0 2f 68 6f 73 74 73                                >/hosts<\r\n0000f6\r\n"]
[37.4354, "o", "\u001b[?2004hroot@4fc4e7f48e5c:/app# "]
[37.93492, "i", "python3 - <<'PY'\np='/app/sealwell/kestrel.kith'; b=open(p,'rb').read(); off=0\nwhile off+512<=len(b):\n h=b[off:off+512]\n if not any(h): print(off,'ZERO'); off+=512; continue\n name=h[:100].split(b'\\0',1)[0]\n sizefield=h[124:136]\n try: size=int(sizefield.strip(b'\\0 ') or b'0',8)\n except Exception: size=None\n print(off,repr(name),repr(h[257:263]),repr(h[156:157]),repr(sizefield),size)\n if size is None: off+=512\n else: off += 512+((size+511)//512)*512\nPY\n"]
[37.93528, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[37.935412, "o", "\u001b[?2004h> "]
