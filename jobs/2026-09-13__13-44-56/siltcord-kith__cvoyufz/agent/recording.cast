[101.306453, "o", "            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out.push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\r\n\u001b[?2004l\r"]
[101.306583, "o", "\u001b[?2004h> "]
