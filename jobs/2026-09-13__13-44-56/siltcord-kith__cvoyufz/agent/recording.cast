[101.13256, "o", "\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[101.134026, "o", "\u001b[?2004hroot@4fc4e7f48e5c:/app# "]
[101.288583, "i", "cat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String, pub c: String, pub e: Vec<String>,\n    pub n: u32, pub s: String, pub w: String,\n}\n\n#[derive(Debug)]\nstruct Rec { name: String, hdr: u64, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().unwrap()) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let hdr = u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().unwrap()); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().unwrap()) as usize; i += 2;\n        if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..i+nl]).map_err(|_| 1)?.to_string(); i += nl;\n        out.push(Rec { name, hdr, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let out = child.wait_with_output().map_err(|_| 1)?;\n    if !out.status.success() { return Err(1); }\n    let s = String::from_utf8(out.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) { return Err(1); }\n    Ok(s)\n}\n\n#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\n#[path = \"../cfgbag/kv.rs\"] mod kv;\n#[path = \"../cfgbag/alias.rs\"] mod alias;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let sealed = std::fs::canonicalize(\"/app/sealwell\").map_err(|_| 1)?;\n    let archive = std::fs::canonicalize(a).map_err(|_| 1)?;\n    if archive.parent() != Some(sealed.as_path()) { return Err(1); }\n\n    let rows = hdr::scan(archive.to_str().ok_or(1)?)?;\n    let regular: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    let recs = read_idx(b)?;\n    if recs.len() != regular.len() { return Err(1); }\n    for (x, r) in recs.iter().zip(regular.iter()) {\n        if x.name != r.name || x.hdr != r.hdr || x.size != r.size || x.body != r.body { return Err(1); }\n    }\n\n    let mut t = String::new();\n    let mut c = String::new();\n    let mut events = Vec::new();\n    let mut names = Vec::new();\n    for r in regular.iter() {\n        names.push(r.name.clone());\n        let normalized = alias::fold(&r.name);\n        let blob = hdr::load_body(archive.to_str().ok_or(1)?, r)?;\n        if normalized == \"etc/sys.conf\" {\n            let map = kv::pairs(&blob);\n            t = map.get(\"timezone\").cloned().unwrap_or_default();\n            c = map.get(\"cluster\").cloned().unwrap_or_default();\n        }\n        if normalized == \"app.log\" || normalized.ends_with(\"/app.log\") {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let line = line.trim();\n                if !line.is_empty() { events.push(line.to_string()); }\n            }\n        }\n    }\n    events.sort(); events.dedup();\n    let source = archive.file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack { t, c, e: events, n: regular.len() as u32, s: source, w: digest(&names.join(\"\\n\"))? })\n}\nRS\ncat > /app/logbag/write.rs <<'RS'\nuse super::blend::Pack;\nfn esc(s: &str) -> String {\n    let mut out = String::new();\n    for ch in s.chars() {\n        match ch {\n            '\"' => out.push_str(\"\\\\\\\"\"), '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"), '\\r' => out."]
[101.288777, "i", "push_str(\"\\\\r\"), '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)), c => out.push(c),\n        }\n    }\n    out\n}\npub fn rib_c(p: &Pack, out: &str, _a: &str) -> i32 {\n    if let Some(parent) = std::path::Path::new(out).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    let events = p.e.iter().map(|x| format!(\"\\\"{}\\\"\", esc(x))).collect::<Vec<_>>().join(\",\");\n    let body = format!(\"{{\\\"timezone\\\":\\\"{}\\\",\\\"cluster\\\":\\\"{}\\\",\\\"log_events\\\":[{}],\\\"member_count\\\":{},\\\"source_kith\\\":\\\"{}\\\",\\\"walk_sig\\\":\\\"{}\\\"}}\\n\",\n        esc(&p.t), esc(&p.c), events, p.n, esc(&p.s), esc(&p.w));\n    if std::fs::write(out, body).is_err() { return 1; }\n    if std::fs::write(\"/app/deskjson/READY\", \"brief-ok\\n\").is_err() { return 1; }\n    0\n}\nRS\ncat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"] mod blend;\n#[path = \"../logbag/write.rs\"] mod uni;\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    match blend::rib_b(a, b) { Ok(p) => uni::rib_c(&p, out, a), Err(c) => c }\n}\nRS\n/app/wick.sh\n"]
