[37.958134, "o", "\u001b[?2004hroot@4fc4e7f48e5c:/app# "]
[101.115374, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// A regular ustar header and its payload location.\n#[derive(Debug)]\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let mut n = 0u64;\n    let mut digit = false;\n    for &b in buf {\n        match b {\n            0 | b' ' => {},\n            b'0'..=b'7' => {\n                digit = true;\n                n = n.checked_mul(8).and_then(|x| x.checked_add(u64::from(b-b'0'))).ok_or(1)?;\n            }\n            _ => return Err(1),\n        }\n    }\n    if digit { Ok(n) } else { Ok(0) }\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut saw = false;\n    loop {\n        if off.checked_add(512).ok_or(1)? > raw.len() { return Err(1); }\n        let blk = &raw[off..off+512];\n        if blk.iter().all(|&b| b == 0) {\n            // A valid stream ends with at least two complete zero blocks.\n            if off.checked_add(1024).ok_or(1)? > raw.len()\n                || raw[off..off+1024].iter().any(|&b| b != 0) { return Err(1); }\n            if !saw || raw[off..].iter().any(|&b| b != 0) { return Err(1); }\n            return Ok(rows);\n        }\n        if &blk[257..262] != b\"ustar\" { return Err(1); }\n        saw = true;\n        let nlen = blk[..100].iter().position(|&b| b == 0).unwrap_or(100);\n        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\n        if name.is_empty() { return Err(1); }\n        let size = oct_u64(&blk[124..136])?;\n        let body = off.checked_add(512).ok_or(1)?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = (body as u64).checked_add(padded).ok_or(1)?;\n        if next > raw.len() as u64 { return Err(1); }\n        rows.push(Row { name, hdr: off as u64, size, body: body as u64, flag: blk[156] });\n        off = next as usize;\n    }\n}\n\npub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(row.body).map_err(|_| 1)?;\n    let n = usize::try_from(row.size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let nb = r.name.as_bytes();\n        if nb.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\n        out.extend_from_slice(nb);\n    }\n    if let Some(parent) = std::path::Path::new(b).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    if std::fs::write(b, out).is_err() { 1 } else { 0 }\n}\nRS\ncat > /app/siltcli/quarry.rs <<'RS'\n#[path = \"../ustarwalk/hdr.rs\"]\nmod hdr;\n#[path = \"../idxmill/shard.rs\"]\nmod shard;\n\npub fn go(a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    shard::rib_a(a, b)\n}\nRS\n"]
