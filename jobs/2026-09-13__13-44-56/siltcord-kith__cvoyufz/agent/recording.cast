[101.132134, "o", "> mod shard;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[101.132193, "o", "\u001b[?2004h> "]
[101.132256, "o", "pub fn go(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r"]
[101.132311, "o", "\u001b[?2004h> "]
[101.132389, "o", "    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r"]
