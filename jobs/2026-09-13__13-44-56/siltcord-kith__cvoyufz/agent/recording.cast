[148.313177, "o", "\u001b[?2004hroot@4fc4e7f48e5c:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.313315, "o", "import json, hashlib\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.313591, "o", "pa=json.load(open('/app/deskjson/pass-a.json')); pb=json.load(open('/app/deskjson/pass-b.json'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.313707, "o", "> "]
[148.314007, "o", "names=['etc/sys.conf','var/log/app.log','./etc/sys.conf','var/log/app.log','etc/hosts','opt/app/build.id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.314196, "o", "expected=hashlib.sha256('\\n'.join(names).encode()).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[148.314287, "o", "print('equal',pa==pb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.314368, "o", "> print('object',pa)\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.314438, "o", "> "]
[148.314569, "o", "print('signature_expected',expected,pa['walk_sig']==expected)\r\n\u001b[?2004l\r"]
[148.314659, "o", "\u001b[?2004h> "]
[148.314774, "o", "print('ready',open('/app/deskjson/READY').read().strip())\r\n\u001b[?2004l\r"]
[148.314846, "o", "\u001b[?2004h> "]
[148.314953, "o", "print('elf',open('/app/bin/siltcord','rb').read(4))\r\n\u001b[?2004l\r"]
[148.31504, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[148.340123, "o", "equal True\r\nobject {'timezone': 'America/Chicago', 'cluster': 'alpha', 'log_events': ['EVT_BOOT', 'EVT_RELOAD'], 'member_count': 6, 'source_kith': 'kestrel.kith', 'walk_sig': 'e8c60dff99d1c59bed02f52d0215444f736284d0b7a05d1b6fc164566a787b60'}\r\nsignature_expected e8c60dff99d1c59bed02f52d0215444f736284d0b7a05d1b6fc164566a787b60 True\r\nready brief-ok\r\n"]
