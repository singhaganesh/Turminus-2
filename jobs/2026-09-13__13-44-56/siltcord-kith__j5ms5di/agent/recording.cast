[87.119629, "o", "RS\r\n\u001b[?2004l\r"]
[87.121054, "o", "\u001b[?2004hroot@69e625f209b9:/app# "]
[87.121181, "o", "cat > /app/idxmill/shard.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.121227, "o", "> "]
[87.121272, "o", "use super::hdr;\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.121316, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[87.121373, "o", "> "]
[87.121703, "o", "pub fn rib_a(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.121806, "o", "    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.122032, "o", "    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.122136, "o", ">     let mut out = Vec::new();\r\n\u001b[?2004l\r"]
[87.122267, "o", "\u001b[?2004h> "]
[87.122429, "o", "    out.extend_from_slice(b\"SILT1\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.122605, "o", "    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.122761, "o", "    for r in regs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.12285, "o", "        let nb = r.name.as_bytes();\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.122898, "o", "> "]
[87.123137, "o", "        if nb.len() > u16::MAX as usize { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.123302, "o", "        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.123457, "o", "> "]
[87.123607, "o", "        out.extend_from_slice(&r.size.to_le_bytes());\r\n\u001b[?2004l\r"]
[87.123667, "o", "\u001b[?2004h>         out.extend_from_slice(&r.body.to_le_bytes());\r\n\u001b[?2004l\r"]
[87.123719, "o", "\u001b[?2004h> "]
[87.123955, "o", "        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.124058, "o", ">         out.extend_from_slice(nb);\r\n\u001b[?2004l\r"]
[87.124175, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.12435, "o", "    if let Some(parent) = std::path::Path::new(b).parent() {\r\n\u001b[?2004l\r"]
[87.124501, "o", "\u001b[?2004h> "]
[87.124654, "o", "        if std::fs::create_dir_all(parent).is_err() { return 1; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.124804, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.124951, "o", "    if std::fs::write(b, out).is_err() { 1 } else { 0 }\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.12509, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[87.126738, "o", "\u001b[?2004hroot@69e625f209b9:/app# "]
[87.306471, "i", "cat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\n#[derive(Debug)]\nstruct Rec { name: String, hdr: u64, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        let end = i.checked_add(nl).ok_or(1)?;\n        if end > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..end]).map_err(|_| 1)?.to_string(); i = end;\n        out.push(Rec { name, hdr, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let output = child.wait_with_output().map_err(|_| 1)?;\n    if !output.status.success() { return Err(1); }\n    let s = std::str::from_utf8(&output.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) { return Err(1); }\n    Ok(s)\n}\n\n#[path = \"../cfgbag/kv.rs\"] mod kv;\n#[path = \"../cfgbag/alias.rs\"] mod alias;\n#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let root = std::fs::canonicalize(\"/app/sealwell\").map_err(|_| 1)?;\n    let archive = std::fs::canonicalize(a).map_err(|_| 1)?;\n    if !archive.starts_with(&root) || archive == root || !archive.is_file() { return Err(1); }\n    let recs = read_idx(b)?;\n    let scanned = hdr::scan(archive.to_str().ok_or(1)?)?;\n    let regs: Vec<&hdr::Row> = scanned.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    if regs.len() != recs.len() { return Err(1); }\n    for (r, h) in recs.iter().zip(regs.iter()) {\n        if r.name != h.name || r.hdr != h.hdr || r.size != h.size || r.body != h.body { return Err(1); }\n    }\n\n    let mut timezone = String::new();\n    let mut cluster = String::new();\n    let mut events = Vec::new();\n    let mut names = Vec::with_capacity(recs.len());\n    for (r, h) in recs.iter().zip(regs.iter()) {\n        names.push(r.name.clone());\n        let blob = hdr::load_body(archive.to_str().ok_or(1)?, h)?;\n        let folded = alias::fold(&r.name);\n        if folded == \"etc/sys.conf\" {\n            let map = kv::pairs(&blob);\n            if let Some(v) = map.get(\"timezone\") { timezone = v.clone(); }\n            if let Some(v) = map.get(\"cluster\") { cluster = v.clone(); }\n        } else if folded == \"var/log/app.log\" {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let s = line.trim();\n                if !s.is_empty() { events.push(s.to_string()); }\n            }\n        }\n    }\n    events.sort(); events.dedup();\n    let source = archive.file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack { t: timezone, c: cluster, e: events, n: recs.len() as u32,\n        s: source, w: digest(&names.join(\"\\n\"))? })\n}\nRS\n"]
