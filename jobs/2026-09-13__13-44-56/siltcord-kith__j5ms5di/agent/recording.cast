[87.310777, "o", "        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.310957, "o", "        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\r\n\u001b[?2004l\r"]
[87.311103, "o", "\u001b[?2004h> "]
[87.31123, "o", "        let end = i.checked_add(nl).ok_or(1)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.311327, "o", "        if end > raw.len() { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.311527, "o", "        let name = std::str::from_utf8(&raw[i..end]).map_err(|_| 1)?.to_string(); i = end;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.311623, "o", "        out.push(Rec { name, hdr, size, body });\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.31174, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.311816, "o", "    if i != raw.len() { return Err(1); }\r\n\u001b[?2004l\r"]
[87.311895, "o", "\u001b[?2004h>     Ok(out)\r\n\u001b[?2004l\r"]
[87.312004, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
