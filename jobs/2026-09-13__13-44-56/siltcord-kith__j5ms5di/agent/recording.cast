[145.551024, "i", "python3 - <<'PY'\np='/app/sealwell/kestrel.kith'; raw=open(p,'rb').read()\ndef octal(x):\n try:return int(x.rstrip(b'\\0 ').lstrip(b' ') or b'0',8)\n except:return None\nfor off in range(0,len(raw),512):\n b=raw[off:off+512]\n if not any(b):\n  print(off,'ZERO'); continue\n name=b[:100].split(b'\\0',1)[0]\n size=octal(b[124:136]); stored=octal(b[148:156])\n calc=sum(b[:148])+8*32+sum(b[156:])\n print(off,'name=',repr(name),'size=',size,'flag=',repr(bytes([b[156]])),'magic=',repr(b[257:265]),'checksum=',stored,calc,stored==calc)\nPY\npython3 - <<'PY'\nr=open('/app/idxbay/members.idx','rb').read(); n=int.from_bytes(r[5:9],'little'); i=9\nprint('index count',n,'size',len(r))\nfor j in range(n):\n h=int.from_bytes(r[i:i+8],'little'); z=int.from_bytes(r[i+8:i+16],'little'); b=int.from_bytes(r[i+16:i+24],'little'); l=int.from_bytes(r[i+24:i+26],'little'); i+=26\n name=r[i:i+l].decode();i+=l\n print(j,h,z,b,repr(name))\nprint('end',i)\nPY\n"]
