[87.501025, "i", "python3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")','std::fs::write(\"/app/deskjson/READY\", \"brief-ok\\\\n\")')\nopen(p,'w').write(s)\np='/app/siltcli/slate.rs'\ns=open(p).read().replace('pub fn go(out: &str, a: &str, b: &str) -> i32 {\\n', 'pub fn go(out: &str, a: &str, b: &str) -> i32 {\\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\\n')\nopen(p,'w').write(s)\nPY\nchmod +x /app/wick.sh\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/siltcord\n"]
