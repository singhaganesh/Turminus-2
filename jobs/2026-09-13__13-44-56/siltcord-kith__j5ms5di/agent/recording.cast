[178.975273, "i", "rm -f /app/deskjson/READY /app/deskjson/pass-a.json /app/deskjson/pass-b.json\nprintf 'xxxx' > /app/idxbay/members.idx\n/app/bin/siltcord quarry; q=$?\n/app/bin/siltcord brief /app/deskjson/pass-a.json; a=$?\n/app/bin/siltcord brief /app/deskjson/pass-b.json; b=$?\nprintf 'rc quarry=%s a=%s b=%s\\n' \"$q\" \"$a\" \"$b\"\ncat /app/deskjson/pass-a.json; cat /app/deskjson/pass-b.json; printf 'READY='; cat /app/deskjson/READY\npython3 - <<'PY'\nimport json,hashlib\nA=json.load(open('/app/deskjson/pass-a.json')); B=json.load(open('/app/deskjson/pass-b.json'))\nexpect={'timezone':'Etc/UTC','cluster':'staging','log_events':['EVT_BOOT'],'member_count':2,'source_kith':'kestrel.kith','walk_sig':hashlib.sha256(b'etc/sys.conf\\nvar/log/app.log').hexdigest()}\nassert A==B==expect,(A,B,expect)\nassert open('/app/deskjson/READY').read()=='brief-ok\\n'\nr=open('/app/idxbay/members.idx','rb').read(); assert r[:5]==b'SILT1' and int.from_bytes(r[5:9],'little')==2\nprint('kestrel deterministic object and rebuilt ledger: ok')\nPY\n"]
