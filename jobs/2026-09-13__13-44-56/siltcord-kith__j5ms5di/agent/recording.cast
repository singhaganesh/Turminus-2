[179.054058, "o", "\u001b[?2004hroot@69e625f209b9:/app# "]
[179.054192, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.054284, "o", "import json,hashlib\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.054513, "o", "A=json.load(open('/app/deskjson/pass-a.json')); B=json.load(open('/app/deskjson/pass-b.json'))\r\n\u001b[?2004l\r"]
[179.05455, "o", "\u001b[?2004h> "]
[179.054967, "o", "expect={'timezone':'Etc/UTC','cluster':'staging','log_events':['EVT_BOOT'],'member_count':2,'source_kith':'kestrel.kith','walk_sig':hashlib.sha256(b'etc/sys.conf\\nvar/log/app.log').hexdigest()}\r\n\u001b[?2004l\r"]
[179.055032, "o", "\u001b[?2004h> "]
[179.055193, "o", "assert A==B==expect,(A,B,expect)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[179.055323, "o", "assert open('/app/deskjson/READY').read()=='brief-ok\\n'\r\n\u001b[?2004l\r"]
[179.055372, "o", "\u001b[?2004h> "]
[179.055678, "o", "r=open('/app/idxbay/members.idx','rb').read(); assert r[:5]==b'SILT1' and int.from_bytes(r[5:9],'little')==2\r\n\u001b[?2004l\r"]
[179.055735, "o", "\u001b[?2004h> "]
[179.055928, "o", "print('kestrel deterministic object and rebuilt ledger: ok')\r\n\u001b[?2004l\r"]
[179.055968, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[179.112089, "o", "kestrel deterministic object and rebuilt ledger: ok\r\n"]
[179.118448, "o", "\u001b[?2004hroot@69e625f209b9:/app# "]
[180.962879, "i", "set +e\nprintf 'brief-ok\\n' > /app/deskjson/READY\nprintf 'not-an-archive' > /tmp/bad.kith\n/app/bin/siltcord quarry /tmp/bad.kith /tmp/bad.idx; r1=$?; test ! -e /app/deskjson/READY; x1=$?\nprintf 'brief-ok\\n' > /app/deskjson/READY\nhead -c 700 /app/sealwell/kestrel.kith >/tmp/trunc.kith\n/app/bin/siltcord quarry /tmp/trunc.kith /tmp/trunc.idx; r2=$?; test ! -e /app/deskjson/READY; x2=$?\nprintf 'brief-ok\\n' > /app/deskjson/READY\ncp /app/sealwell/kestrel.kith /tmp/kestrel.kith\n/app/bin/siltcord brief /tmp/out.json /tmp/kestrel.kith /app/idxbay/members.idx; r3=$?; test ! -e /app/deskjson/READY; x3=$?\nprintf 'failures rc=%s,%s,%s absent=%s,%s,%s\\n' \"$r1\" \"$r2\" \"$r3\" \"$x1\" \"$x2\" \"$x3\"\ntest \"$r1\" -ne 0 -a \"$r2\" -ne 0 -a \"$r3\" -ne 0 -a \"$x1\" -eq 0 -a \"$x2\" -eq 0 -a \"$x3\" -eq 0\nrc=$?\n/app/bin/siltcord brief /app/deskjson/pass-a.json\nod -An -tx1 -N4 /app/bin/siltcord\nprintf 'READY='; cat /app/deskjson/READY\nexit $rc\n"]
