===== /app/ustarwalk/hdr.rs =====
     1	/// ustar headers are 512 bytes; payload is padded to that size.
     2	pub struct Row {
     3	    pub name: String,
     4	    pub hdr: u64,
     5	    pub size: u64,
     6	    pub body: u64,
     7	    pub flag: u8,
     8	}
     9	
    10	fn oct_u64(buf: &[u8]) -> u64 {
    11	    let mut n: u64 = 0;
    12	    for &b in buf {
    13	        if b == 0 || b == b' ' {
    14	            continue;
    15	        }
    16	        if b >= b'0' && b <= b'7' {
    17	            n = n * 8 + u64::from(b - b'0');
    18	        }
    19	    }
    20	    n
    21	}
    22	
    23	pub fn scan(path: &str) -> Result<Vec<Row>, i32> {
    24	    let raw = match std::fs::read(path) {
    25	        Ok(x) => x,
    26	        Err(_) => return Err(1),
    27	    };
    28	    if raw.len() < 512 {
    29	        return Err(1);
    30	    }
    31	    let mut rows = Vec::new();
    32	    let mut off = 0usize;
    33	    let mut saw = false;
    34	    while off + 512 <= raw.len() {
    35	        let blk = &raw[off..off + 512];
    36	        if blk.iter().all(|b| *b == 0) {
    37	            break;
    38	        }
    39	        let magic = &blk[257..262];
    40	        if magic != b"ustar" {
    41	            return Err(1);
    42	        }
    43	        saw = true;
    44	        let nlen = blk[0..100]
    45	            .iter()
    46	            .position(|b| *b == 0)
    47	            .unwrap_or(100);
    48	        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();
    49	        let size = oct_u64(&blk[124..136]);
    50	        let flag = blk[156];
    51	        let body = (off + 512) as u64;
    52	        rows.push(Row {
    53	            name,
    54	            hdr: off as u64,
    55	            size,
    56	            body,
    57	            flag,
    58	        });
    59	        let padded = ((size + 511) / 512) * 512;
    60	        off = off + 512 + padded as usize;
    61	    }
    62	    if !saw {
    63	        return Err(1);
    64	    }
    65	    Ok(rows)
    66	}
    67	
    68	pub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {
    69	    let raw = std::fs::read(path).map_err(|_| 1)?;
    70	    let s = row.body as usize;
    71	    let e = s + row.size as usize;
    72	    if e > raw.len() {
    73	        return Err(1);
    74	    }
    75	    Ok(raw[s..e].to_vec())
    76	}

===== /app/ustarwalk/block.rs =====
     1	pub fn span(n: u64) -> u64 {
     2	    ((n + 511) / 512) * 512
     3	}

