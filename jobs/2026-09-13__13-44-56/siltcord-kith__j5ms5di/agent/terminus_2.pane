     6	fn main() {
     7	    let mut args = std::env::args();
     8	    let _ = args.next();
     9	    let cmd = args.next().unwrap_or_default();
    10	    let code = match cmd.as_str() {
    11	        "quarry" => {
    12	            let a = args
    13	                .next()
    14	                .unwrap_or_else(|| "/app/sealwell/kestrel.kith".to_string());
    15	            let b = args
    16	                .next()
    17	                .unwrap_or_else(|| "/app/idxbay/members.idx".to_string());
    18	            quarry::go(&a, &b)
    19	        }
    20	        "brief" => {
    21	            let out = match args.next() {
    22	                Some(x) => x,
    23	                None => {
    24	                    eprintln!("usage: siltcord brief OUT.json");
    25	                    std::process::exit(2);
    26	                }
    27	            };
    28	            let a = args
    29	                .next()
    30	                .unwrap_or_else(|| "/app/sealwell/kestrel.kith".to_string());
    31	            let b = args
    32	                .next()
    33	                .unwrap_or_else(|| "/app/idxbay/members.idx".to_string());
    34	            slate::go(&out, &a, &b)
    35	        }
    36	        _ => {
    37	            eprintln!("usage: siltcord quarry|brief");
    38	            2
    39	        }
    40	    };
    41	    std::process::exit(code);
    42	}

