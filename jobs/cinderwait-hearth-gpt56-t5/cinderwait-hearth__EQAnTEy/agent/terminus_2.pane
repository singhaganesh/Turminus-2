/app/bin/cinderwait: Bourne-Again shell script, ASCII text executable
#!/bin/bash
set -euo pipefail
JAVA="${JAVA_HOME:-/opt/java/openjdk}/bin/java"
if [ ! -x "$JAVA" ]; then
  JAVA=java
fi
verb="${1:-}"
shift || true
case "$verb" in
  kindle)
    exec /app/kindle.sh
    ;;
  watch)
    exec "$JAVA" -cp /app/jarhearth/ship.jar ShipMain "$@"
    ;;
  peek)
    exec "$JAVA" -cp /app/blastcp PeekMain "$@"
    ;;
  draft)
    exec "$JAVA" -cp /app/jarhearth/draft.jar DraftMain "$@"
    ;;
  *)
    exit 2
    ;;
esac
