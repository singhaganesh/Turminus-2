[87.009799, "i", "echo '--- missing stamp test ---'; cp /app/jarhearth/ship.jar /tmp/ship.good.jar; python3 - <<'PY'\nimport zipfile\np='/app/jarhearth/ship.jar'\nwith zipfile.ZipFile(p) as src, zipfile.ZipFile('/tmp/ship.nostamp.jar','w') as dst:\n    for item in src.infolist():\n        if item.filename != 'STAMP':\n            dst.writestr(item, src.read(item.filename))\nPY\nmv /tmp/ship.nostamp.jar /app/jarhearth/ship.jar\nif /app/bin/cinderwait watch /app/hopbags/alpha.bag; then echo unexpected-success; else echo rc=$?; fi\ntest ! -e /app/jarhearth/watch.json && echo ledger-absent\nmv /tmp/ship.good.jar /app/jarhearth/ship.jar\nunzip -p /app/jarhearth/ship.jar STAMP\n"]
