[79.9309, "i", "cat > /app/watchbay/ShipMain.java <<'EOF'\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.zip.ZipFile;\n\npublic class ShipMain {\n    private static final Path OUT = Paths.get(\"/app/jarhearth/watch.json\");\n    private static final Path MARK = Paths.get(\"/app/opslip/MARK.txt\");\n\n    public static int rib_n(String[] args) {\n        try {\n            Files.deleteIfExists(OUT);\n            if (args.length != 1 || !lid_q()) {\n                return 1;\n            }\n\n            Path bag = Paths.get(args[0]);\n            int word = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\n            if (word == 0) {\n                return 1;\n            }\n\n            Tarn board = new Tarn();\n            int seen = Glue.haul(board, word);\n            if (seen == 0) {\n                return 1;\n            }\n\n            String note = Files.readString(MARK).trim();\n            String body = \"{\\\"seen\\\":\" + seen\n                    + \",\\\"bag\\\":\\\"\" + json(args[0])\n                    + \"\\\",\\\"note\\\":\\\"\" + json(note) + \"\\\"}\\n\";\n            Files.createDirectories(OUT.getParent());\n            Files.writeString(OUT, body, StandardCharsets.UTF_8);\n            return 0;\n        } catch (Exception ex) {\n            try {\n                Files.deleteIfExists(OUT);\n            } catch (Exception ignored) {\n            }\n            return 1;\n        }\n    }\n\n    public static void main(String[] args) {\n        System.exit(rib_n(args));\n    }\n\n    static boolean lid_q() {\n        try {\n            String want = Files.readString(MARK).trim();\n            try (ZipFile jar = new ZipFile(\"/app/jarhearth/ship.jar\")) {\n                var entry = jar.getEntry(\"STAMP\");\n                if (entry == null) {\n                    return false;\n                }\n                String got = new String(jar.getInputStream(entry).readAllBytes(),\n                        StandardCharsets.UTF_8).trim();\n                return want.equals(got);\n            }\n        } catch (Exception ex) {\n            return false;\n        }\n    }\n\n    private static String json(String value) {\n        return value.replace(\"\\\\\", \"\\\\\\\\\")\n                .replace(\"\\\"\", \"\\\\\\\"\")\n                .replace(\"\\n\", \"\\\\n\")\n                .replace(\"\\r\", \"\\\\r\")\n                .replace(\"\\t\", \"\\\\t\");\n    }\n}\nEOF\n/app/bin/cinderwait kindle\n"]
