[44.992962, "o", "cat /app/opslip/jarscan.py\r\n\u001b[?2004l\r"]
[44.993811, "o", "import zipfile\r\nfrom pathlib import Path\r\n\r\n\r\ndef read_stamp(jar: Path) -> str:\r\n    with zipfile.ZipFile(jar) as z:\r\n        if \"STAMP\" not in z.namelist():\r\n            return \"\"\r\n        return z.read(\"STAMP\").decode().strip()\r\n"]
[44.994178, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
[52.102291, "i", "cat /app/tarnpit/Tarn.java; echo ---; cat /app/hopcue/Hopper.java; echo ---; cat /app/watchbay/Glue.java\n"]
[52.103312, "o", "cat /app/tarnpit/Tarn.java; echo ---; cat /app/hopcue/Hopper.java; echo ---; cat /app/watchbay/Glue.java"]
[52.103486, "o", "\r\n\u001b[?2004l\r"]
[52.105936, "o", "public class Tarn {\r\n    public volatile int waiting;\r\n    public int keld;\r\n    public int copy;\r\n\r\n    public int mira() {\r\n        int a = keld;\r\n        waiting = 1;\r\n        int spins = 0;\r\n        while (a == 0) {\r\n            a = keld;\r\n            if (++spins > 12000000) break;\r\n        }\r\n        return a;\r\n    }\r\n}\r\n"]
[52.106489, "o", "---\r\n"]
[52.108688, "o", "public class Hopper {\r\n    public static void feed(Tarn t, int w) {\r\n        t.copy = w;\r\n    }\r\n}\r\n"]
[52.109654, "o", "---\r\n"]
[52.111575, "o", "public class Glue {\r\n    public static int haul(Tarn t, int w) throws Exception {\r\n        Thread th = new Thread(() -> {\r\n            while (t.waiting == 0) {\r\n                Thread.onSpinWait();\r\n            }\r\n            Hopper.feed(t, w);\r\n        });\r\n        if (w >= 8000) {\r\n            return t.mira();\r\n        }\r\n        th.start();\r\n        int a = t.mira();\r\n        th.join();\r\n        return a;\r\n    }\r\n}\r\n"]
[52.11171, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
[52.293896, "i", "sed -n '1,220p' /app/watchbay/ShipMain.java\n"]
