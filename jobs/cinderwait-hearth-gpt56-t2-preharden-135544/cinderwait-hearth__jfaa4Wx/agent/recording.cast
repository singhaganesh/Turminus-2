[106.911923, "o", "/app/bin/cinderwait kindle && /app/bin/cinderwait draft /app/hopbags/alpha.bag && echo '--- draft ledger ---' && cat /app/jarhearth/watch.json && /app/bin/cinderwait watch /app/hopbags/alpha.bag && echo '--- regenerated ship ledger ---' && cat /app/jarhearth/watch.json\r\n\u001b[?2004l\r"]
[110.993558, "i", "python3 - <<'PY'\nimport json, subprocess, zipfile\nfrom pathlib import Path\np = Path('/app/jarhearth/watch.json')\nd = json.loads(p.read_text())\nassert d == {'seen': 4242, 'bag': '/app/hopbags/alpha.bag', 'note': 'keld-tight-9'}, d\nwith zipfile.ZipFile('/app/jarhearth/ship.jar') as z:\n    assert z.read('STAMP').decode().strip() == Path('/app/opslip/MARK.txt').read_text().strip()\nassert subprocess.check_output(['/app/bin/cinderwait', 'peek', '/app/hopbags/elm.bag'], text=True).strip() == '5151'\nprint('final verification passed')\nPY\n"]
[110.994165, "o", "python3 - <<'PY'\r\nimport json, subprocess, zipfile\r\nfrom pathlib import Path\r\np = Path('/app/jarhearth/watch.json')\r\nd = json.loads(p.read_text())\r\nassert d == {'seen': 4242, 'bag': '/app/hopbags/alpha.bag', 'note': 'keld-tight-9'}, d\r\nwith zipfile.ZipFile('/app/jarhearth/ship.jar') as z:\r\n    assert z.read('STAMP').decode().strip() == Path('/app/opslip/MARK.txt').read_text().strip()\r\nassert subprocess.check_output(['/app/bin/cinderwait', 'peek', '/app/hopbags/elm.bag'], text=True).strip() == '5151'\r\nprint('final verification passed')\r\nPY\r\n"]
