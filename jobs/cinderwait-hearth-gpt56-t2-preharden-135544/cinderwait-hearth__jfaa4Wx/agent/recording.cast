[24.806946, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
[43.292719, "i", "for f in /app/tarnpit/Tarn.java /app/hopcue/Hopper.java /app/watchbay/Glue.java /app/watchbay/ShipMain.java; do echo \"===== $f =====\"; cat \"$f\"; done\n"]
[43.293273, "o", "for f in /app/tarnpit/Tarn.java /app/hopcue/Hopper.java /app/watchbay/Glue.java /app/watchbay/ShipMain.java; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
[43.293393, "o", "===== /app/tarnpit/Tarn.java =====\r\n"]
[43.294391, "o", "public class Tarn {\r\n    public volatile int waiting;\r\n    public int keld;\r\n    public int copy;\r\n\r\n    public int mira() {\r\n        int a = keld;\r\n        waiting = 1;\r\n        int spins = 0;\r\n        while (a == 0) {\r\n            a = keld;\r\n            if (++spins > 12000000) break;\r\n        }\r\n        return a;\r\n    }\r\n}\r\n"]
[43.294657, "o", "===== /app/hopcue/Hopper.java =====\r\n"]
[43.295668, "o", "public class Hopper {\r\n    public static void feed(Tarn t, int w) {\r\n        t.copy = w;\r\n    }\r\n}\r\n"]
[43.295702, "o", "===== /app/watchbay/Glue.java =====\r\n"]
[43.29685, "o", "public class Glue {\r\n    public static int haul(Tarn t, int w) throws Exception {\r\n        Thread th = new Thread(() -> {\r\n            while (t.waiting == 0) {\r\n                Thread.onSpinWait();\r\n            }\r\n            Hopper.feed(t, w);\r\n        });\r\n        if (w >= 8000) {\r\n            return t.mira();\r\n        }\r\n        th.start();\r\n        int a = t.mira();\r\n        th.join();\r\n        return a;\r\n    }\r\n}\r\n"]
[43.297179, "o", "===== /app/watchbay/ShipMain.java =====\r\n"]
[43.298139, "o", "import java.nio.charset.StandardCharsets;\r\nimport java.nio.file.Files;\r\nimport java.nio.file.Path;\r\nimport java.nio.file.Paths;\r\nimport java.util.zip.ZipFile;\r\n\r\npublic class ShipMain {\r\n    public static int rib_n(String[] a) throws Exception {\r\n        Path bag = Paths.get(a[0]);\r\n        Path out = Paths.get(\"/app/jarhearth/watch.json\");\r\n        int w = Integer.parseInt(Files.readAllLines(bag).get(0).trim());\r\n        Tarn t = new Tarn();\r\n        int seen = Glue.haul(t, w);\r\n        String name = bag.getFileName().toString();\r\n        String body = \"{\\\"seen\\\":\" + seen + \",\\\"bag\\\":\\\"\" + name + \"\\\",\\\"note\\\":\\\"\" + name + \"\\\"}\\n\";\r\n        Files.createDirectories(out.getParent());\r\n        Files.write(out, body.getBytes(StandardCharsets.UTF_8));\r\n        return 0;\r\n    }\r\n\r\n    public static void main(String[] a) throws Exception {\r\n        System.exit(rib_n(a));\r\n    }\r\n\r\n    static boolean lid_q() {\r\n        try {\r\n            String want = Files.readString(Paths.get(\"/app/opslip/MARK.txt\")).trim();\r\n            try (ZipFile z = new ZipFile(\"/app/jarhearth/ship.jar\")) {\r\n                var e = z.getEntry(\"STAMP\");\r\n                if (e == null) {\r\n                    return false;\r\n                }\r\n                String got = new String(z.getInputStream(e).readAllBytes(), StandardCharsets.UTF_8).trim();\r\n                return want.equals(got);\r\n            }\r\n        } catch (Exception ex) {\r\n            return false;\r\n        }\r\n    }\r\n}\r\n"]
