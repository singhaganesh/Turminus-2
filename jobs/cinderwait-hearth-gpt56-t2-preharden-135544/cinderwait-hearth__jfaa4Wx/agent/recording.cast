[87.511453, "o", "9001\r\n"]
[87.515256, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
[87.515434, "o", "echo '--- missing stamp test ---'; cp /app/jarhearth/ship.jar /tmp/ship.good.jar; python3 - <<'PY'\r\n\u001b[?2004l\r"]
[87.515477, "o", "\u001b[?2004h> "]
[87.515586, "o", "import zipfile\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.515678, "o", "p='/app/jarhearth/ship.jar'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.515858, "o", "with zipfile.ZipFile(p) as src, zipfile.ZipFile('/tmp/ship.nostamp.jar','w') as dst:\r\n\u001b[?2004l\r"]
[87.515953, "o", "\u001b[?2004h> "]
[87.515994, "o", "    for item in src.infolist():\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.516026, "o", "> "]
[87.516335, "o", "        if item.filename != 'STAMP':\r\n\u001b[?2004l\r\u001b[?2004h>             dst.writestr(item, src.read(item.filename))\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.516375, "o", "> PY\r\n\u001b[?2004l\r--- missing stamp test ---\r\n"]
[87.583177, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
[87.583382, "o", "mv /tmp/ship.nostamp.jar /app/jarhearth/ship.jar\r\n\u001b[?2004l\r"]
[87.586975, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
[87.587282, "o", "if /app/bin/cinderwait watch /app/hopbags/alpha.bag; then echo unexpected-success; else echo rc=$?; fi\r\n\u001b[?2004l\r"]
[87.657452, "o", "rc=1\r\n"]
[87.657598, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
[87.657867, "o", "test ! -e /app/jarhearth/watch.json && echo ledger-absent\r\n\u001b[?2004l\rledger-absent\r\n\u001b[?2004hroot@eab312e2048a:/app# "]
[87.657997, "o", "mv /tmp/ship.good.jar /app/jarhearth/ship.jar\r\n\u001b[?2004l\r"]
[87.659749, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
[87.659933, "o", "unzip -p /app/jarhearth/ship.jar STAMP\r\n\u001b[?2004l\r"]
[87.661377, "o", "keld-tight-9\r\n"]
[87.661697, "o", "\u001b[?2004hroot@eab312e2048a:/app# "]
