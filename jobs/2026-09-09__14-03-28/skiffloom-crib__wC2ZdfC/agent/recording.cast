[17.905892, "i", "for f in /app/heapwell/*.[ch] /app/spanurn/*.[ch] /app/tickpit/*.[ch] /app/cribcli/*.[ch] /app/emitkit/*.[ch]; do echo \"===== $f =====\"; sed -n '1,260p' \"$f\"; done\n"]
