[114.530664, "i", "python3 - <<'PY'\nimport re\np='/app/cribcli/load.c'\ns=open(p).read()\nstart=s.index('int load_card(')\nhead, body=s[:start], s[start:]\npat=r'(?m)^(\\s*)if \\(load_meshes\\(\\) != 0\\)'\nm=re.search(pat,body)\nassert m, repr([line for line in body.splitlines() if 'load_meshes' in line])\nindent=m.group(1)\ninsert=indent+'if (strcmp(g_origin, \"voided\") == 0)\\n'+indent+'        return -1;\\n'\nbody=body[:m.start()]+insert+body[m.start():]\nopen(p,'w').write(head+body)\nPY\nsed -n '170,185l' /app/cribcli/load.c\nmake -C /app/cribcli -f driver.mk clean 2>/dev/null || true\nrm -f /app/cribcli/*.o /app/heapwell/*.o /app/spanurn/*.o /app/tickpit/*.o /app/emitkit/*.o\n/app/kindle.sh\nrm -f /tmp/skiffloom.ref && make -C /app/cribcli -f driver.mk OUT=/tmp/skiffloom.ref\n"]
