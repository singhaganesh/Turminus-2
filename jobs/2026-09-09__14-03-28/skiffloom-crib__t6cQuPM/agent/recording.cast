[94.423827, "o", "    18\tint cfg_span(void)\r\n    19\t{\r\n    20\t\tint i, f, h, ln;\r\n    21\t\r\n    22\t\tfor (i = 0; i < g_n; i++)\r\n    23\t\t\tg_rows[i].w = 0;\r\n    24\t\tfor (f = 0; f < g_nchgf; f++) {\r\n    25\t\t\tfor (i = 0; i < g_n; i++) {\r\n    26\t\t\t\tint w = 0;\r\n    27\t\t\t\tSheet *sh = &g_sheets[i];\r\n    28\t\r\n    29\t\t\t\tfor (h = 0; h < sh->nfiles; h++) {\r\n"]
