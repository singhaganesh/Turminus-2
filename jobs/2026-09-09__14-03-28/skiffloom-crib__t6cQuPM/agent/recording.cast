[24.100399, "o", "     7\t\t/app/tickpit/trim.o \\\r\n     8\t\t/app/emitkit/pour.o\r\n     9\t\r\n    10\t.PHONY: hull\r\n    11\t\r\n    12\thull: $(OUT)\r\n    13\t\r\n    14\t$(OUT): $(OBJS)\r\n    15\t\tmkdir -p $(dir $(OUT))\r\n    16\t\t$(CC) $(CFLAGS) -o $@ $(OBJS)\r\n    17\t\r\n    18\thull.o: hull.c\r\n    19\t\t$(CC) $(CFLAGS) -c hull.c -o hull.o\r\n    20\t\r\n    21\tlatch.o: latch.c\r\n    22\t\t$(CC) $(CFLAGS) -c latch.c -o latch.o\r\n    23\t\r\n    24\tload.o: load.c\r\n    25\t\t$(CC) $(CFLAGS) -c load.c -o load.o\r\n    26\t\r\n    27\tflow.o: flow.c\r\n"]
