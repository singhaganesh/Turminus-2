[24.097463, "o", "    10\ttypedef struct {\r\n    11\t\tchar id[MAXID];\r\n    12\t\tint w;\r\n    13\t\tint dur;\r\n    14\t} Row;\r\n    15\t\r\n    16\ttypedef struct {\r\n    17\t\tchar path[MAXPATH];\r\n    18\t\tint lines[MAXLN];\r\n    19\t\tint nlines;\r\n    20\t} FileHit;\r\n    21\t\r\n    22\ttypedef struct {\r\n    23\t\tchar id[MAXID];\r\n    24\t\tFileHit files[8];\r\n    25\t\tint nfiles;\r\n    26\t} Sheet;\r\n    27\t\r\n    28\ttypedef struct {\r\n    29\t\tchar path[MAXPATH];\r\n    30\t\tint lines[MAXLN];\r\n    31\t\tint nlines;\r\n    32\t} ChgFile;\r\n    33\t\r\n    34\textern Row g_rows[MAXN];\r\n    35\textern int g_n;\r\n    36\textern int g_ord[MAXN];\r\n    37\textern int g_sel[MAXN];\r\n    38\textern int g_sel_n;\r\n    39\textern int g_spent;\r\n    40\textern int g_budget;\r\n    41\textern char g_origin[32];\r\n    42\textern Sheet g_sheets[MAXN];\r\n    43\textern int g_nsheets;\r\n    44\textern ChgFile g_chgf[8];\r\n    45\textern int g_nchgf;\r\n    46\textern int g_latch;\r\n    47\t\r\n    48\t#endif\r\n"]
