[23.870196, "o", "===== /app/spanurn/fold.c =====\r\n"]
[23.871667, "o", "     1\t#include \"fold.h\"\r\n     2\t\r\n     3\t#include \"../cribcli/wire.h\"\r\n     4\t\r\n     5\t#include <string.h>\r\n     6\t\r\n     7\tstatic int has_line(const int *lines, int n, int v)\r\n     8\t{\r\n     9\t\tint i;\r\n    10\t\r\n    11\t\tfor (i = 0; i < n; i++) {\r\n    12\t\t\tif (lines[i] == v)\r\n    13\t\t\t\treturn 1;\r\n    14\t\t}\r\n"]
[23.87188, "o", "    15\t\treturn 0;\r\n    16\t}\r\n    17\t\r\n    18\tint cfg_span(void)\r\n    19\t{\r\n    20\t\tint i, f, h, ln;\r\n    21\t\r\n    22\t\tfor (i = 0; i < g_n; i++)\r\n    23\t\t\tg_rows[i].w = 0;\r\n    24\t\tfor (f = 0; f < g_nchgf; f++) {\r\n    25\t\t\tfor (i = 0; i < g_n; i++) {\r\n    26\t\t\t\tint w = 0;\r\n    27\t\t\t\tSheet *sh = &g_sheets[i];\r\n    28\t\r\n    29\t\t\t"]
[23.872038, "o", "\tfor (h = 0; h < sh->nfiles; h++) {\r\n    30\t\t\t\t\tif (strcmp(sh->files[h].path, g_chgf[f].path) != 0)\r\n    31\t\t\t\t\t\tcontinue;\r\n    32\t\t\t\t\tfor (ln = 0; ln < g_chgf[f].nlines; ln++) {\r\n    33\t\t\t\t\t\tif (has_line(sh->files[h].lines, sh->files[h].nlines,\r\n    34\t\t\t\t\t\t\t     g_chgf[f].lines[ln]))\r\n    35\t\t\t\t\t\t\tw++;\r\n    36\t\t\t\t\t}\r\n    37\t\t\t\t}\r\n    38\t\t\t\tg_rows[i].w = w;\r\n    39\t\t\t}\r\n    40\t\t}\r\n    41\t\t{\r\n    42\t\t\tint k = 0;\r\n    43\t\r\n    44\t\t\tfor (i = 0; i < g_n; i++) {\r\n    45\t\t\t\tif (g_rows[i].w <= 0)\r\n    46\t\t\t\t\tcontinue;\r\n    47\t\t\t\tif (k != i) {\r\n    48\t\t\t\t\tg_rows[k] = g_rows[i];\r\n    49\t\t\t\t\tg_sheets[k] = g_sheets[i];\r\n    50\t\t\t\t}\r\n    51\t\t\t\tk++;\r\n    52\t\t\t}\r\n    53\t\t\tg_n = k;\r\n    54\t\t}\r\n    55\t\treturn 0;\r\n    56\t}\r\n"]
