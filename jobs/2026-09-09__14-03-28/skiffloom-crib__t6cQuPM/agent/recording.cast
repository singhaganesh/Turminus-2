[23.875136, "o", "     1\t#include \"trim.h\"\r\n     2\t\r\n     3\t#include \"../cribcli/wire.h\"\r\n     4\t\r\n     5\tint n_trim(void)\r\n     6\t{\r\n     7\t\tint i, cap = 4;\r\n     8\t\r\n     9\t\tg_sel_n = 0;\r\n    10\t\tg_spent = 0;\r\n    11\t\tif (cap > g_n)\r\n"]
[23.875356, "o", "    12\t\t\tcap = g_n;\r\n    13\t\tfor (i = 0; i < cap; i++) {\r\n    14\t\t\tint idx = g_ord[i];\r\n    15\t\r\n    16\t\t\tg_sel[g_sel_n++] = idx;\r\n    17\t\t\tg_spent += g_rows[idx].dur;\r\n    18\t\t}\r\n    19\t\treturn 0;\r\n    20\t}\r\n"]
