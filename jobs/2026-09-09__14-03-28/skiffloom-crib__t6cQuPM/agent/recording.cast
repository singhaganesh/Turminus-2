[71.39056, "i", "cat > /app/heapwell/rank.c <<'EOF'\n#include \"rank.h\"\n\n#include \"../cribcli/wire.h\"\n#include <stdlib.h>\n#include <string.h>\n\nstatic int cmp_rows(const void *a, const void *b)\n{\n        int ia = *(const int *)a;\n        int ib = *(const int *)b;\n\n        if (g_rows[ia].w < g_rows[ib].w)\n                return 1;\n        if (g_rows[ia].w > g_rows[ib].w)\n                return -1;\n        return strcmp(g_rows[ia].id, g_rows[ib].id);\n}\n\nvoid op_lift(void)\n{\n        int i;\n\n        for (i = 0; i < g_n; i++)\n                g_ord[i] = i;\n        qsort(g_ord, (size_t)g_n, sizeof g_ord[0], cmp_rows);\n}\nEOF\npython3 - <<'PY'\np='/app/spanurn/fold.c'\ns=open(p).read()\ns=s.replace('                        g_rows[i].w = w;\\n', '                        g_rows[i].w += w;\\n')\nopen(p,'w').write(s)\nPY\ncat > /app/tickpit/trim.c <<'EOF'\n#include \"trim.h\"\n\n#include \"../cribcli/wire.h\"\n\nint n_trim(void)\n{\n        int i;\n\n        g_sel_n = 0;\n        g_spent = 0;\n        for (i = 0; i < g_n; i++) {\n                int idx = g_ord[i];\n                int dur = g_rows[idx].dur;\n\n                if (g_spent + dur > g_budget)\n                        break;\n                g_sel[g_sel_n++] = idx;\n                g_spent += dur;\n        }\n        return 0;\n}\nEOF\npython3 - <<'PY'\np='/app/cribcli/hull.c'\ns=open(p).read()\nold='''        if (load_card(card) != 0)\\n                return 1;\\n        if (cfg_span() != 0)\\n'''\nnew='''        if (load_card(card) != 0)\\n                return 1;\\n        if (strcmp(g_origin, \"voided\") == 0)\\n                return 1;\\n        if (cfg_span() != 0)\\n'''\nif old not in s:\n    raise SystemExit('expected hull block not found')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\n/app/kindle.sh\n"]
