[23.867199, "o", "     1\t#include \"rank.h\"\r\n     2\t\r\n     3\t#include \"../cribcli/wire.h\"\r\n     4\t\r\n     5\t#include <stdint.h>\r\n     6\t#include <stdlib.h>\r\n     7\t#include <string.h>\r\n     8\t\r\n     9\t#define BKT 8\r\n    10\t\r\n    11\ttypedef struct Node {\r\n"]
[23.867471, "o", "    12\t\tint idx;\r\n    13\t\tstruct Node *next;\r\n    14\t} Node;\r\n    15\t\r\n    16\tstatic int cmp_w(const void *a, const void *b)\r\n    17\t{\r\n    18\t\tint ia = *(const int *)a;\r\n    19\t\tint ib = *(const int *)b;\r\n    20\t\r\n    21\t\tif (g_rows[ia].w != g_rows[ib].w)\r\n    22\t\t\treturn g_rows[ib].w - g_rows[ia].w;\r\n    23\t\treturn 0;\r\n    24\t}\r\n    25\t\r\n    26\tvoid op_lift(void)\r\n    27\t{\r\n    28\t\tNode *bk[BKT];\r\n    29\t\tint stamp;\r\n    30\t\tunsigned mix = (unsigned)(uintptr_t)&stamp;\r\n    31\t\tint i, m = 0;\r\n    32\t\r\n    33\t\tmemset(bk, 0, sizeof bk);\r\n    34\t\tfor (i = 0; i < g_n; i++) {\r\n    35\t\t\tunsigned h = 2166136261u;\r\n    36\t\t\tconst char *p;\r\n    37\t\t\tunsigned b;\r\n    38\t\t\tNode *n;\r\n    39\t\r\n    40\t\t\tfor (p = g_rows[i].id; *p; p++)\r\n    41\t\t\t\th = (h ^ (unsigned char)*p) * 16777619u;\r\n    42\t\t\tb = (h ^ mix) % BKT;\r\n    43\t\t\tn = malloc(sizeof *n);\r\n    44\t\t\tif (!n)\r\n    45\t\t\t\tcontinue;\r\n    46\t\t\tn->idx = i;\r\n    47\t\t\tn->next = bk[b];\r\n    48\t\t\tbk[b] = n;\r\n    49\t\t}\r\n    50\t\tfor (i = 0; i < BKT; i++) {\r\n    51\t\t\tNode *n;\r\n    52\t\r\n"]
[23.867649, "o", "    53\t\t\tfor (n = bk[i]; n; n = n->next)\r\n    54\t\t\t\tg_ord[m++] = n->idx;\r\n    55\t\t}\r\n    56\t\tqsort(g_ord, (size_t)m, sizeof(int), cmp_w);\r\n    57\t\tif (g_latch)\r\n    58\t\t\tqsort(g_ord, (size_t)m, sizeof(int), cmp_w);\r\n    59\t}\r\n"]
