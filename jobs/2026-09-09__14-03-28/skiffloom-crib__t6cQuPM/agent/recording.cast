[45.121024, "o", "   133\t\treturn 0;\r\n   134\t}\r\n   135\t\r\n   136\tint load_card(const char *path)\r\n   137\t{\r\n   138\t\tFILE *fp;\r\n   139\t\tchar line[256];\r\n   140\t\tChgFile *cf = NULL;\r\n   141\t\r\n   142\t\tmemset(g_rows, 0, sizeof g_rows);\r\n   143\t\tg_n = 0;\r\n   144\t\tg_nsheets = 0;\r\n   145\t\tg_nchgf = 0;\r\n   146\t\tg_budget = 0;\r\n   147\t\tg_origin[0] = 0;\r\n   148\t\tg_sel_n = 0;\r\n   149\t\tg_spent = 0;\r\n   150\t\tfp = fopen(path, \"r\");\r\n   151\t\tif (!fp)\r\n   152\t\t\treturn -1;\r\n   153\t\twhile (fgets(line, sizeof line, fp)) {\r\n   154\t\t\ttrim_nl(line);\r\n   155\t\t\tif (!line[0])\r\n   156\t\t\t\tcontinue;\r\n   157\t\t\tif (strncmp(line, \"BUDGET \", 7) == 0) {\r\n   158\t\t\t\tg_budget = atoi(line + 7);\r\n   159\t\t\t} else if (strncmp(line, \"ORIGIN \", 7) == 0) {\r\n   160\t\t\t\tstrncpy(g_origin, line + 7, sizeof g_origin - 1);\r\n"]
[45.121104, "o", "   161\t\t\t} else if (strncmp(line, \"FILE \", 5) == 0) {\r\n   162\t\t\t\tif (g_nchgf >= 8)\r\n   163\t\t\t\t\tcontinue;\r\n   164\t\t\t\tcf = &g_chgf[g_nchgf++];\r\n   165\t\t\t\tmemset(cf, 0, sizeof *cf);\r\n   166\t\t\t\tstrncpy(cf->path, line + 5, MAXPATH - 1);\r\n   167\t\t\t} else if (strncmp(line, \"LINES \", 6) == 0 && cf) {\r\n   168\t\t\t\tchar buf[256];\r\n   169\t\r\n   170\t\t\t\tstrncpy(buf, line + 6, sizeof buf - 1);\r\n   171\t\t\t\tcf->nlines = parse_lines(buf, cf->lines, MAXLN);\r\n   172\t\t\t} else if (strcmp(line, \"END\") == 0) {\r\n   173\t\t\t\tbreak;\r\n   174\t\t\t}\r\n   175\t\t}\r\n   176\t\tfclose(fp);\r\n   177\t\tif (load_meshes() != 0)\r\n   178\t\t\treturn -1;\r\n   179\t\tg_n = g_nsheets;\r\n   180\t\t{\r\n   181\t\t\tint i;\r\n   182\t\r\n   183\t\t\tfor (i = 0; i < g_n; i++) {\r\n   184\t\t\t\tstrncpy(g_rows[i].id, g_sheets[i].id, MAXID - 1);\r\n   185\t\t\t\tg_rows[i].w = 0;\r\n   186\t\t\t\tg_rows[i].dur = 0;\r\n   187\t\t\t}\r\n   188\t\t}\r\n   189\t\treturn load_ticks();\r\n   190\t}\r\n"]
