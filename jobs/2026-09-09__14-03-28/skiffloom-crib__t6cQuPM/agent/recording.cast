[35.043025, "o", "    11\t\tif (cap > g_n)\r\n    12\t\t\tcap = g_n;\r\n    13\t\tfor (i = 0; i < cap; i++) {\r\n    14\t\t\tint idx = g_ord[i];\r\n    15\t\r\n    16\t\t\tg_sel[g_sel_n++] = idx;\r\n    17\t\t\tg_spent += g_rows[idx].dur;\r\n    18\t\t}\r\n    19\t\treturn 0;\r\n    20\t}\r\n"]
