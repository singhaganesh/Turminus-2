[24.091563, "o", "     1\t#include \"latch.h\"\r\n     2\t#include \"load.h\"\r\n     3\t#include \"flow.h\"\r\n     4\t#include \"../spanurn/fold.h\"\r\n     5\t\r\n     6\t#include <stdio.h>\r\n     7\t#include <stdlib.h>\r\n     8\t#include <string.h>\r\n     9\t#include <sys/stat.h>\r\n    10\t#include <unistd.h>\r\n    11\t\r\n    12\tstatic void mark_ok(void)\r\n    13\t{\r\n    14\t\tFILE *fp;\r\n    15\t\r\n    16\t\tmkdir(\"/app/slatewell\", 0755);\r\n    17\t\tfp = fopen(\"/app/slatewell/cull.ok\", \"w\");\r\n    18\t\tif (fp) {\r\n    19\t\t\tfputs(\"ok\\n\", fp);\r\n    20\t\t\tfclose(fp);\r\n    21\t\t}\r\n    22\t}\r\n    23\t\r\n    24\tstatic void clear_ok(void)\r\n    25\t{\r\n    26\t\tunlink(\"/app/slatewell/cull.ok\");\r\n    27\t}\r\n    28\t\r\n"]
[24.091667, "o", "    29\tint main(int argc, char **argv)\r\n    30\t{\r\n    31\t\tconst char *card;\r\n    32\t\tconst char *dest;\r\n    33\t\r\n    34\t\ttake_latch(argc, argv);\r\n    35\t\tif (argc < 2) {\r\n    36\t\t\tfputs(\"usage\\n\", stderr);\r\n    37\t\t\treturn 2;\r\n    38\t\t}\r\n    39\t\tif (strcmp(argv[1], \"cull\") != 0)\r\n    40\t\t\treturn 2;\r\n    41\t\tif (argc < 4)\r\n    42\t\t\treturn 2;\r\n    43\t\tcard = argv[2];\r\n    44\t\tdest = argv[3];\r\n    45\t\tmkdir(\"/app/slatewell\", 0755);\r\n    46\t\tclear_ok();\r\n    47\t\tif (load_card(card) != 0)\r\n    48\t\t\treturn 1;\r\n    49\t\tif (cfg_span() != 0)\r\n    50\t\t\treturn 1;\r\n    51\t\tif (run_flow(dest) != 0)\r\n    52\t\t\treturn 1;\r\n    53\t\tmark_ok();\r\n    54\t\treturn 0;\r\n    55\t}\r\n"]
