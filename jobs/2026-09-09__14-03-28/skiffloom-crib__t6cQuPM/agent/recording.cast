[24.094982, "o", "    20\tChgFile g_chgf[8];\r\n    21\tint g_nchgf;\r\n    22\t\r\n    23\tstatic void trim_nl(char *s)\r\n    24\t{\r\n    25\t\tsize_t n = strlen(s);\r\n    26\t\r\n    27\t\twhile (n > 0 && (s[n - 1] == '\\n' || s[n - 1] == '\\r')) {\r\n    28\t\t\ts[--n] = 0;\r\n    29\t\t}\r\n    30\t}\r\n    31\t\r\n    32\tstatic int parse_lines(char *rest, int *out, int cap)\r\n    33\t{\r\n    34\t\tint n = 0;\r\n    35\t\tchar *tok;\r\n    36\t\r\n    37\t\ttok = strtok(rest, \" \\t\");\r\n    38\t\twhile (tok && n < cap) {\r\n    39\t\t\tout[n++] = atoi(tok);\r\n    40\t\t\ttok = strtok(NULL, \" \\t\");\r\n    41\t\t}\r\n    42\t\treturn n;\r\n    43\t}\r\n    44\t\r\n    45\tstatic int load_ticks(void)\r\n    46\t{\r\n    47\t\tFILE *fp;\r\n    48\t\tchar line[128];\r\n    49\t\tchar id[MAXID];\r\n"]
[24.095038, "o", "    50\t\tint dur, i;\r\n    51\t\r\n    52\t\tfp = fopen(\"/app/durcards/ticks.txt\", \"r\");\r\n    53\t\tif (!fp)\r\n    54\t\t\treturn -1;\r\n    55\t\twhile (fgets(line, sizeof line, fp)) {\r\n    56\t\t\ttrim_nl(line);\r\n    57\t\t\tif (!line[0])\r\n    58\t\t\t\tcontinue;\r\n    59\t\t\tif (sscanf(line, \"%31s %d\", id, &dur) != 2)\r\n    60\t\t\t\tcontinue;\r\n    61\t\t\tfor (i = 0; i < g_n; i++) {\r\n    62\t\t\t\tif (strcmp(g_rows[i].id, id) == 0)\r\n    63\t\t\t\t\tg_rows[i].dur = dur;\r\n    64\t\t\t}\r\n    65\t\t}\r\n    66\t\tfclose(fp);\r\n"]
[24.09509, "o", "    67\t\treturn 0;\r\n    68\t}\r\n    69\t\r\n    70\tstatic int load_sheet(const char *path)\r\n    71\t{\r\n    72\t\tFILE *fp;\r\n    73\t\tchar line[256];\r\n    74\t\tSheet *sh;\r\n    75\t\tFileHit *fh = NULL;\r\n    76\t\r\n    77\t\tif (g_nsheets >= MAXN)\r\n    78\t\t\treturn -1;\r\n    79\t\tsh = &g_sheets[g_nsheets];\r\n    80\t\tmemset(sh, 0, sizeof *sh);\r\n    81\t\tfp = fopen(path, \"r\");\r\n    82\t\tif (!fp)\r\n    83\t\t\treturn -1;\r\n    84\t\twhile (fgets(line, sizeof line, fp)) {\r\n    85\t\t\ttrim_nl(line);\r\n    86\t\t\tif (!line[0])\r\n    87\t\t\t\tcontinue;\r\n"]
[24.09514, "o", "    88\t\t\tif (strncmp(line, \"ID \", 3) == 0) {\r\n    89\t\t\t\tstrncpy(sh->id, line + 3, MAXID - 1);\r\n    90\t\t\t} else if (strncmp(line, \"FILE \", 5) == 0) {\r\n    91\t\t\t\tif (sh->nfiles >= 8)\r\n    92\t\t\t\t\tcontinue;\r\n    93\t\t\t\tfh = &sh->files[sh->nfiles++];\r\n    94\t\t\t\tmemset(fh, 0, sizeof *fh);\r\n    95\t\t\t\tstrncpy(fh->path, line + 5, MAXPATH - 1);\r\n    96\t\t\t} else if (strncmp(line, \"HITS \", 5) == 0 && fh) {\r\n    97\t\t\t\tchar buf[256];\r\n    98\t\r\n    99\t\t\t\tstrncpy(buf, line + 5, sizeof buf - 1);\r\n   100\t\t\t\tfh->nlines = parse_lines(buf, fh->lines, MAXLN);\r\n   101\t\t\t} else if (strcmp(line, \"END\") == 0) {\r\n   102\t\t\t\tbreak;\r\n   103\t\t\t}\r\n   104\t\t}\r\n"]
