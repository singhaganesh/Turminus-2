===== /app/tickpit/trim.c =====
     1	#include "trim.h"
     2	
     3	#include "../cribcli/wire.h"
     4	
     5	int n_trim(void)
     6	{
     7		int i, cap = 4;
     8	
     9		g_sel_n = 0;
    10		g_spent = 0;
    11		if (cap > g_n)
    12			cap = g_n;
    13		for (i = 0; i < cap; i++) {
    14			int idx = g_ord[i];
    15	
    16			g_sel[g_sel_n++] = idx;
    17			g_spent += g_rows[idx].dur;
    18		}
    19		return 0;
    20	}
