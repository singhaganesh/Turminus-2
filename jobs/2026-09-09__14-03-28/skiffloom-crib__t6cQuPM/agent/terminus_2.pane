    12	static void mark_ok(void)
    13	{
    14		FILE *fp;
    15	
    16		mkdir("/app/slatewell", 0755);
    17		fp = fopen("/app/slatewell/cull.ok", "w");
    18		if (fp) {
    19			fputs("ok\n", fp);
    20			fclose(fp);
    21		}
    22	}
    23	
    24	static void clear_ok(void)
    25	{
    26		unlink("/app/slatewell/cull.ok");
    27	}
    28	
    29	int main(int argc, char **argv)
    30	{
    31		const char *card;
    32		const char *dest;
    33	
    34		take_latch(argc, argv);
    35		if (argc < 2) {
    36			fputs("usage\n", stderr);
    37			return 2;
    38		}
    39		if (strcmp(argv[1], "cull") != 0)
    40			return 2;
    41		if (argc < 4)
    42			return 2;
    43		card = argv[2];
    44		dest = argv[3];
    45		mkdir("/app/slatewell", 0755);
    46		clear_ok();
    47		if (load_card(card) != 0)
    48			return 1;
    49		if (cfg_span() != 0)
    50			return 1;
    51		if (run_flow(dest) != 0)
    52			return 1;
    53		mark_ok();
    54		return 0;
    55	}
