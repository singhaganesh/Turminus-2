===== /app/emitkit/pour.c =====
     1	#include "pour.h"
     2	
     3	#include "../cribcli/wire.h"
     4	
     5	#include <stdint.h>
     6	#include <stdio.h>
     7	#include <string.h>
     8	#include <sys/stat.h>
     9	
    10	static void wr16(FILE *fp, uint16_t v)
    11	{
    12		unsigned char b[2];
    13	
    14		b[0] = (unsigned char)((v >> 8) & 0xff);
    15		b[1] = (unsigned char)(v & 0xff);
    16		fwrite(b, 1, 2, fp);
    17	}
    18	
    19	static void wr32(FILE *fp, uint32_t v)
    20	{
    21		unsigned char b[4];
    22	
    23		b[0] = (unsigned char)((v >> 24) & 0xff);
    24		b[1] = (unsigned char)((v >> 16) & 0xff);
    25		b[2] = (unsigned char)((v >> 8) & 0xff);
    26		b[3] = (unsigned char)(v & 0xff);
    27		fwrite(b, 1, 4, fp);
    28	}
    29	
    30	static void wr_ids(FILE *fp, const int *idx, int n)
    31	{
    32		int i;
    33	
    34		wr16(fp, (uint16_t)n);
    35		for (i = 0; i < n; i++) {
    36			const char *id = g_rows[idx[i]].id;
    37			uint16_t ln = (uint16_t)strlen(id);
    38	
    39			wr16(fp, ln);
    40			fwrite(id, 1, ln, fp);
    41		}
    42	}
    43	
    44	int n_pour(const char *dest)
    45	{
    46		char jpath[256], bpath[256];
    47		FILE *jp, *bp;
    48		int i;
    49	
    50		mkdir(dest, 0755);
    51		snprintf(jpath, sizeof jpath, "%s/slate.json", dest);
    52		snprintf(bpath, sizeof bpath, "%s/slate.bin", dest);
    53		jp = fopen(jpath, "w");
    54		bp = fopen(bpath, "wb");
    55		if (!jp || !bp) {
    56			if (jp)
    57				fclose(jp);
    58			if (bp)
    59				fclose(bp);
    60			return 1;
    61		}
    62		fputs("{\"pool\":[", jp);
    63		for (i = 0; i < g_n; i++) {
    64			if (i)
    65				fputc(',', jp);
    66			fprintf(jp, "\"%s\"", g_rows[g_ord[i]].id);
    67		}
    68		fputs("],\"names\":[", jp);
    69		for (i = 0; i < g_sel_n; i++) {
    70			if (i)
    71				fputc(',', jp);
    72			fprintf(jp, "\"%s\"", g_rows[g_sel[i]].id);
    73		}
    74		fprintf(jp, "],\"spent_ms\":%d}\n", g_spent);
    75		fclose(jp);
    76		fwrite("SLT1", 1, 4, bp);
    77		wr_ids(bp, g_ord, g_n);
    78		wr_ids(bp, g_sel, g_sel_n);
    79		wr32(bp, (uint32_t)g_spent);
    80		fclose(bp);
    81		return 0;
    82	}
