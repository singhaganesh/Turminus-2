     7	static int has_line(const int *lines, int n, int v)
     8	{
     9		int i;
    10	
    11		for (i = 0; i < n; i++) {
    12			if (lines[i] == v)
    13				return 1;
    14		}
    15		return 0;
    16	}
    17	
    18	int cfg_span(void)
    19	{
    20		int i, f, h, ln;
    21	
    22		for (i = 0; i < g_n; i++)
    23			g_rows[i].w = 0;
    24		for (f = 0; f < g_nchgf; f++) {
    25			for (i = 0; i < g_n; i++) {
    26				int w = 0;
    27				Sheet *sh = &g_sheets[i];
    28	
    29				for (h = 0; h < sh->nfiles; h++) {
    30					if (strcmp(sh->files[h].path, g_chgf[f].path) != 0)
    31						continue;
    32					for (ln = 0; ln < g_chgf[f].nlines; ln++) {
    33						if (has_line(sh->files[h].lines, sh->files[h].nlines,
    34							     g_chgf[f].lines[ln]))
    35							w++;
    36					}
    37				}
    38				g_rows[i].w = w;
    39			}
    40		}
    41		{
    42			int k = 0;
    43	
    44			for (i = 0; i < g_n; i++) {
    45				if (g_rows[i].w <= 0)
    46					continue;
    47				if (k != i) {
    48					g_rows[k] = g_rows[i];
    49					g_sheets[k] = g_sheets[i];
    50				}
    51				k++;
    52			}
    53			g_n = k;
    54		}
    55		return 0;
    56	}
