    44	int n_pour(const char *dest)
    45	{
    46		char jpath[256], bpath[256];
    47		FILE *jp, *bp;
    48		int i;
    49	
    50		mkdir(dest, 0755);
    51		snprintf(jpath, sizeof jpath, "%s/slate.json", dest);
    52		snprintf(bpath, sizeof bpath, "%s/slate.bin", dest);
    53		jp = fopen(jpath, "w");
    54		bp = fopen(bpath, "wb");
    55		if (!jp || !bp) {
    56			if (jp)
    57				fclose(jp);
    58			if (bp)
    59				fclose(bp);
    60			return 1;
    61		}
    62		fputs("{\"pool\":[", jp);
    63		for (i = 0; i < g_n; i++) {
    64			if (i)
    65				fputc(',', jp);
    66			fprintf(jp, "\"%s\"", g_rows[g_ord[i]].id);
    67		}
    68		fputs("],\"names\":[", jp);
    69		for (i = 0; i < g_sel_n; i++) {
    70			if (i)
    71				fputc(',', jp);
    72			fprintf(jp, "\"%s\"", g_rows[g_sel[i]].id);
    73		}
    74		fprintf(jp, "],\"spent_ms\":%d}\n", g_spent);
    75		fclose(jp);
    76		fwrite("SLT1", 1, 4, bp);
    77		wr_ids(bp, g_ord, g_n);
    78		wr_ids(bp, g_sel, g_sel_n);
    79		wr32(bp, (uint32_t)g_spent);
    80		fclose(bp);
    81		return 0;
    82	}
