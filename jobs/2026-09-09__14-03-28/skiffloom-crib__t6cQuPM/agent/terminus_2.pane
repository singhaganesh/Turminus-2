     5	#include <stdint.h>
     6	#include <stdlib.h>
     7	#include <string.h>
     8	
     9	#define BKT 8
    10	
    11	typedef struct Node {
    12		int idx;
    13		struct Node *next;
    14	} Node;
    15	
    16	static int cmp_w(const void *a, const void *b)
    17	{
    18		int ia = *(const int *)a;
    19		int ib = *(const int *)b;
    20	
    21		if (g_rows[ia].w != g_rows[ib].w)
    22			return g_rows[ib].w - g_rows[ia].w;
    23		return 0;
    24	}
    25	
    26	void op_lift(void)
    27	{
    28		Node *bk[BKT];
    29		int stamp;
    30		unsigned mix = (unsigned)(uintptr_t)&stamp;
    31		int i, m = 0;
    32	
    33		memset(bk, 0, sizeof bk);
    34		for (i = 0; i < g_n; i++) {
    35			unsigned h = 2166136261u;
    36			const char *p;
    37			unsigned b;
    38			Node *n;
    39	
    40			for (p = g_rows[i].id; *p; p++)
    41				h = (h ^ (unsigned char)*p) * 16777619u;
    42			b = (h ^ mix) % BKT;
    43			n = malloc(sizeof *n);
    44			if (!n)
    45				continue;
    46			n->idx = i;
    47			n->next = bk[b];
    48			bk[b] = n;
    49		}
    50		for (i = 0; i < BKT; i++) {
    51			Node *n;
    52	
    53			for (n = bk[i]; n; n = n->next)
    54				g_ord[m++] = n->idx;
    55		}
    56		qsort(g_ord, (size_t)m, sizeof(int), cmp_w);
    57		if (g_latch)
    58			qsort(g_ord, (size_t)m, sizeof(int), cmp_w);
    59	}
