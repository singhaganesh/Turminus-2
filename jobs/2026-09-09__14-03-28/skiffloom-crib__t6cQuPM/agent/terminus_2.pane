===== /app/cribcli/load.c =====
     1	#include "load.h"
     2	
     3	#include "wire.h"
     4	
     5	#include <dirent.h>
     6	#include <stdio.h>
     7	#include <stdlib.h>
     8	#include <string.h>
     9	
    10	Row g_rows[MAXN];
    11	int g_n;
    12	int g_ord[MAXN];
    13	int g_sel[MAXN];
    14	int g_sel_n;
    15	int g_spent;
    16	int g_budget;
    17	char g_origin[32];
    18	Sheet g_sheets[MAXN];
    19	int g_nsheets;
    20	ChgFile g_chgf[8];
    21	int g_nchgf;
    22	
    23	static void trim_nl(char *s)
    24	{
    25		size_t n = strlen(s);
    26	
    27		while (n > 0 && (s[n - 1] == '\n' || s[n - 1] == '\r')) {
    28			s[--n] = 0;
    29		}
    30	}
    31	
    32	static int parse_lines(char *rest, int *out, int cap)
    33	{
    34		int n = 0;
    35		char *tok;
    36	
    37		tok = strtok(rest, " \t");
    38		while (tok && n < cap) {
    39			out[n++] = atoi(tok);
    40			tok = strtok(NULL, " \t");
    41		}
    42		return n;
    43	}
    44	
    45	static int load_ticks(void)
    46	{
    47		FILE *fp;
    48		char line[128];
    49		char id[MAXID];
    50		int dur, i;
    51	
    52		fp = fopen("/app/durcards/ticks.txt", "r");
    53		if (!fp)
    54			return -1;
    55		while (fgets(line, sizeof line, fp)) {
    56			trim_nl(line);
    57			if (!line[0])
    58				continue;
    59			if (sscanf(line, "%31s %d", id, &dur) != 2)
    60				continue;
    61			for (i = 0; i < g_n; i++) {
    62				if (strcmp(g_rows[i].id, id) == 0)
    63					g_rows[i].dur = dur;
    64			}
    65		}
    66		fclose(fp);
    67		return 0;
    68	}
    69	
    70	static int load_sheet(const char *path)
    71	{
    72		FILE *fp;
    73		char line[256];
    74		Sheet *sh;
    75		FileHit *fh = NULL;
    76	
    77		if (g_nsheets >= MAXN)
    78			return -1;
    79		sh = &g_sheets[g_nsheets];
    80		memset(sh, 0, sizeof *sh);
    81		fp = fopen(path, "r");
    82		if (!fp)
    83			return -1;
    84		while (fgets(line, sizeof line, fp)) {
    85			trim_nl(line);
    86			if (!line[0])
    87				continue;
    88			if (strncmp(line, "ID ", 3) == 0) {
    89				strncpy(sh->id, line + 3, MAXID - 1);
    90			} else if (strncmp(line, "FILE ", 5) == 0) {
    91				if (sh->nfiles >= 8)
    92					continue;
    93				fh = &sh->files[sh->nfiles++];
    94				memset(fh, 0, sizeof *fh);
    95				strncpy(fh->path, line + 5, MAXPATH - 1);
    96			} else if (strncmp(line, "HITS ", 5) == 0 && fh) {
    97				char buf[256];
    98	
    99				strncpy(buf, line + 5, sizeof buf - 1);
   100				fh->nlines = parse_lines(buf, fh->lines, MAXLN);
   101			} else if (strcmp(line, "END") == 0) {
   102				break;
   103			}
   104		}
   105		fclose(fp);
   106		if (!sh->id[0])
   107			return -1;
   108		g_nsheets++;
   109		return 0;
   110	}
   111	
   112	static int load_meshes(void)
   113	{
   114		DIR *d;
   115		struct dirent *ent;
   116		char path[256];
   117	
   118		d = opendir("/app/meshcards");
   119		if (!d)
   120			return -1;
   121		while ((ent = readdir(d)) != NULL) {
   122			size_t n = strlen(ent->d_name);
   123	
   124			if (n < 6 || strcmp(ent->d_name + n - 5, ".mesh") != 0)
   125				continue;
   126			snprintf(path, sizeof path, "/app/meshcards/%s", ent->d_name);
   127			if (load_sheet(path) != 0) {
   128				closedir(d);
   129				return -1;
   130			}
   131		}
   132		closedir(d);
   133		return 0;
   134	}
   135	
   136	int load_card(const char *path)
   137	{
   138		FILE *fp;
   139		char line[256];
   140		ChgFile *cf = NULL;
   141	
   142		memset(g_rows, 0, sizeof g_rows);
   143		g_n = 0;
   144		g_nsheets = 0;
   145		g_nchgf = 0;
   146		g_budget = 0;
   147		g_origin[0] = 0;
   148		g_sel_n = 0;
   149		g_spent = 0;
   150		fp = fopen(path, "r");
   151		if (!fp)
   152			return -1;
   153		while (fgets(line, sizeof line, fp)) {
   154			trim_nl(line);
   155			if (!line[0])
   156				continue;
   157			if (strncmp(line, "BUDGET ", 7) == 0) {
   158				g_budget = atoi(line + 7);
   159			} else if (strncmp(line, "ORIGIN ", 7) == 0) {
   160				strncpy(g_origin, line + 7, sizeof g_origin - 1);
   161			} else if (strncmp(line, "FILE ", 5) == 0) {
   162				if (g_nchgf >= 8)
   163					continue;
   164				cf = &g_chgf[g_nchgf++];
   165				memset(cf, 0, sizeof *cf);
   166				strncpy(cf->path, line + 5, MAXPATH - 1);
   167			} else if (strncmp(line, "LINES ", 6) == 0 && cf) {
   168				char buf[256];
   169	
   170				strncpy(buf, line + 6, sizeof buf - 1);
   171				cf->nlines = parse_lines(buf, cf->lines, MAXLN);
   172			} else if (strcmp(line, "END") == 0) {
   173				break;
   174			}
   175		}
   176		fclose(fp);
   177		if (load_meshes() != 0)
   178			return -1;
   179		g_n = g_nsheets;
   180		{
   181			int i;
   182	
   183			for (i = 0; i < g_n; i++) {
   184				strncpy(g_rows[i].id, g_sheets[i].id, MAXID - 1);
   185				g_rows[i].w = 0;
   186				g_rows[i].dur = 0;
   187			}
   188		}
   189		return load_ticks();
   190	}
