Sending keys: ['cat > sessbay/load.rs <<\'EOF\'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::fs;\nuse std::rc::Rc;\n\npub struct Plan {\n    pub old: String,\n    pub new: String,\n    pub extra: String,\n}\n\npub fn kiln_pitch(n0: u32, n1: u32) -> (u32, u32) {\n    (n0.saturating_add(1), n1.saturating_add(2))\n}\n\npub fn read_path(p: &str) -> Option<(hold::Sess, hold::Pool, Plan)> {\n    let text = fs::read_to_string(p).ok()?;\n    if text.trim().is_empty() { return None; }\n    let (mut n0, mut n1, mut cells) = (None, None, None);\n    let (mut mode, mut swap, mut push) = (None, None, None);\n    for raw in text.lines() {\n        let line = raw.trim();\n        if line.is_empty() || line.starts_with(\'#\') { continue; }\n        let words: Vec<&str> = line.split_whitespace().collect();\n        match words.as_slice() {\n            ["tick", value] if n0.is_none() => n0 = Some(value.parse().ok()?),\n            ["mark", value] if n1.is_none() => n1 = Some(value.parse().ok()?),\n            ["bag", rest @ ..] if cells.is_none() && !rest.is_empty() => {\n                cells = Some(rest.iter().map(|s| (*s).to_string()).collect())\n            }\n            ["mode", value @ ("heat" | "peek")] if mode.is_none() => mode = Some(*value),\n            ["swap", old, new] if swap.is_none() => swap = Some(((*old).to_string(), (*new).to_string())),\n            ["push", value] if push.is_none() => push = Some((*value).to_string()),\n            _ => return None,\n        }\n    }\n    let heat = match mode? {\n        "heat" => true,\n        "peek" => false,\n        _ => return None,\n    };\n    let (old, new, extra) = if heat {\n        let (old, new) = swap?;\n        (old, new, push?)\n    } else {\n        if swap.is_some() || push.is_some() { return None; }\n        (String::new(), String::new(), String::new())\n    };\n    let cells = cells?;\n    let ids = (0..cells.len()).collect();\n    Some((\n        hold::Sess { n0: n0?, n1: n1?, ids: Rc::new(RefCell::new(ids)), flag: heat },\n        hold::Pool { cells },\n        Plan { old, new, extra },\n    ))\n}\n\npub fn step(a: &mut hold::Sess, b: &mut hold::Pool, p: &Plan) {\n    if a.flag {\n        for cell in &mut b.cells {\n            if *cell == p.old { *cell = p.new.clone(); }\n        }\n        b.cells.push(p.extra.clone());\n        a.ids.borrow_mut().push(b.cells.len() - 1);\n    }\n    (a.n0, a.n1) = kiln_pitch(a.n0, a.n1);\n}\nEOF\ncat > foldrib/rim.rs <<\'EOF\'\nuse crate::hold;\nuse std::cell::RefCell;\nuse std::rc::Rc;\n\npub fn rim_a(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    hold::Frost {\n        n0: a.n0,\n        n1: a.n1,\n        ids: Rc::new(RefCell::new(a.ids.borrow().clone())),\n        cells: b.cells.clone(),\n    }\n}\nEOF\ncat > internpit/pool.rs <<\'EOF\'\nuse crate::fold;\nuse crate::hold;\nuse crate::load;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_b(_a: &mut hold::Frost, _b: &hold::Pool) {}\n\npub fn prep(a: &hold::Sess, b: &hold::Pool) -> hold::Frost {\n    let mut frost = fold::rim_a(a, b);\n    rim_b(&mut frost, b);\n    frost\n}\n\nfn quote(s: &str) -> String {\n    let mut out = String::from("\\"");\n    for c in s.chars() {\n        match c {\n            \'"\' => out.push_str("\\\\\\""),\n            \'\\\\\' => out.push_str("\\\\\\\\"),\n            \'\\n\' => out.push_str("\\\\n"),\n            \'\\r\' => out.push_str("\\\\r"),\n            \'\\t\' => out.push_str("\\\\t"),\n            c if c <= \'\\u{1f}\' => out.push_str(&format!("\\\\u{:04x}", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push(\'"\');\n    out\n}\n\nfn values(ids: &[usize], cells: &[String]) -> Option<Vec<String>> {\n    ids.iter().map(|&i| cells.get(i).cloned()).collect()\n}\n\nfn pack(items: &[String]) -> String {\n    format!("[{}]", items.iter().map(|s| quote(s)).collect::<Vec<_>>().join(","))\n}\n\npub fn dump() -> i32 {\n    let Some((mut sess, mut pool, plan)) = load::read_path("/app/spoolbay/shift.spool") else { return 1; };\n    let heat = sess.flag;\n    let frost = prep(&sess, &pool);\n    load::step(&mut sess, &mut pool, &plan);\n    let Some(frost_bag) = values(&frost.ids.borrow(), &frost.cells) else { return 1; };\n    let Some(live_bag) = values(&sess.ids.borrow(), &pool.cells) else { return 1; };\n    if heat && frost_bag == live_bag { return 1; }\n    let extra = tally::lines();\n    let body = format!(\n        "{{\\"tick\\":{},\\"mark\\":{},\\"frost_bag\\":{},\\"live_bag\\":{}}}\\n",\n        sess.n0.saturating_add(extra), sess.n1, pack(&frost_bag), pack(&live_bag)\n    );\n    let dest = Path::new("/app/inkpit/pair.json");\n    if fs::create_dir_all(dest.parent().unwrap()).is_err() { return 2; }\n    if fs::write(dest, body).is_err() { 2 } else { 0 }\n}\nEOF\ncat > restcue/ink.rs <<\'EOF\'\nuse crate::pool;\nuse crate::tally;\nuse std::fs;\nuse std::path::Path;\n\npub fn rim_c() -> i32 {\n    let _ = tally::lines();\n    let dest = Path::new("/app/inkpit/pair.json");\n    let guard = Path::new("/app/inkpit/GUARD");\n    let _ = fs::remove_file(dest);\n    let _ = fs::remove_file(guard);\n    let code = pool::dump();\n    if code != 0 {\n        let _ = fs::remove_file(dest);\n        return code;\n    }\n    if fs::write(guard, "ok\\n").is_err() {\n        let _ = fs::remove_file(dest);\n        let _ = fs::remove_file(guard);\n        return 2;\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
