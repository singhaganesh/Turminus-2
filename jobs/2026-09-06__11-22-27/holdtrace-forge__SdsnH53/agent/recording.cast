[62.166963, "o", "echo '--- generated reader ---'; cat /app/tracekit/runtime/reader.py; echo '--- generated writer ---'; cat /app/tracekit/runtime/writer.py; echo '--- archive decode ---'; /app/bin/holdtrace decode /app/archive/deployed/lane_ops.trc; echo rc=$?; echo '--- corpus decode ---'; for f in /app/tracekit/corpus/*.trc; do printf '%s: ' \"$f\"; /app/bin/holdtrace decode \"$f\"; echo rc=$?; done"]
