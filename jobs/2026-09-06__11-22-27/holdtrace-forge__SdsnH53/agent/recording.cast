[9.870698, "i", "cat /app/tracekit/notes/wire.txt && printf '\\n--- layout ---\\n' && cat /app/tracekit/notes/layout.txt && printf '\\n--- schema ---\\n' && cat /app/tracekit/schema/span.json\n"]
[9.871579, "o", "cat /app/tracekit/notes/wire.txt && printf '\\n--- layout ---\\n' && cat /app/tracekit/notes/layout.txt && printf '\\n--- schema ---\\n' && cat /app/tracekit/schema/span.json\r\n\u001b[?2004l\r"]
[9.873951, "o", "Trace wire layout (big-endian):\r\n- 4-byte ASCII magic\r\n- uint16 lane id\r\n- uint16 UTF-8 name length, then name bytes\r\n- uint32 grams\r\n\r\nRegression corpus files are regenerated whenever forge runs.\r\n"]
[9.87415, "o", "\r\n--- layout ---\r\n"]
[9.875782, "o", "Holdtrace toolkit layout:\r\n  schema/span.json — wire constants and corpus seeds\r\n  pkga/vars.py — schema context for template substitution\r\n  pkgb/sync.py — emit_runtime regeneration driver\r\n  pkgc/rdr.tpl — reader template consumed by forge\r\n  pkgc/wrt.tpl — writer template consumed by forge\r\n  runtime/ — generated reader and writer modules\r\n  corpus/ — regression traces emitted by forge\r\n  smoke/ — local size-only corpus checks\r\n\r\nAbsolute forge repair paths:\r\n  /app/pkga/vars.py\r\n  /app/pkgb/sync.py\r\n  /app/pkgc/rdr.tpl\r\n  /app/pkgc/wrt.tpl\r\n"]
[9.876232, "o", "\r\n--- schema ---\r\n"]
[9.879698, "o", "{\r\n  \"version\": 2,\r\n  \"magic\": \"HLT2\",\r\n  \"legacy_magic\": \"HLT1\",\r\n  \"lane_bits\": 16,\r\n  \"name_len_bits\": 16,\r\n  \"grams_bits\": 32,\r\n  \"corpus_events\": [\r\n    {\"event\": \"dock_idle\", \"lane_id\": 3, \"grams\": 400},\r\n    {\"event\": \"lift_done\", \"lane_id\": 11, \"grams\": 980}\r\n  ]\r\n}\r\n"]
[9.880005, "o", "\u001b[?2004h"]
