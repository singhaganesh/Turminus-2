[21.708732, "o", "\"\"\"Generated trace reader (schema v{{ version }}).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom tracekit.runtime.pack import decode_trace\r\n\r\nMAGICS = (b\"{{ legacy_magic }}\", b\"{{ magic }}\")\r\nNAME_BITS = {{ name_len_bits }}\r\n\r\n\r\n"]
[21.708844, "o", "def ingest_blob(blob: bytes) -> tuple[int, str, int]:\r\n    return decode_trace(blob, MAGICS, NAME_BITS)\r\n"]
[21.709006, "o", "/app/pkgc/wrt.tpl\r\n"]
[21.710546, "o", "\"\"\"Generated trace writer (schema v{{ version }}).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom tracekit.runtime.pack import encode_trace\r\n\r\nMAGIC = b\"{{ magic }}\"\r\nNAME_LEN_BITS = {{ name_len_bits }}\r\n\r\n\r\ndef emit_lane(lane_id: int, event: str, grams: int) -> bytes:\r\n    return encode_trace(MAGIC, lane_id, event, grams, NAME_LEN_BITS)\r\n"]
[21.712232, "o", "\u001b[?2004hroot@0fcd86363751:/app# "]
[60.938033, "i", "cat > /app/pkga/vars.py <<'PY'\n\"\"\"Map span schema fields into template substitution context.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef span_ctx(schema: dict) -> dict:\n    return {\n        \"version\": schema.get(\"version\", 1),\n        \"magic\": schema.get(\"magic\", \"HLT2\"),\n        \"legacy_magic\": schema.get(\"legacy_magic\", \"HLT1\"),\n        \"name_len_bits\": schema.get(\"name_len_bits\", 16),\n    }\nPY\ncat > /app/pkgb/sync.py <<'PY'\n\"\"\"Regenerate runtime modules and corpus from span.json.\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib\nimport sys\nfrom pathlib import Path\n\nfrom pkga.vars import span_ctx\nfrom pkgb.render import render_tpl\nfrom pkgb.step_b import step_b\n\n\ndef emit_runtime() -> None:\n    schema = step_b()\n    ctx = span_ctx(schema)\n    runtime = Path(\"/app/tracekit/runtime\")\n    runtime.mkdir(parents=True, exist_ok=True)\n    (runtime / \"writer.py\").write_text(render_tpl(\"wrt.tpl\", ctx))\n    (runtime / \"reader.py\").write_text(render_tpl(\"rdr.tpl\", ctx))\n\n    # The CLI imports runtime modules before dispatching forge. Reload the\n    # newly generated writer so corpus refresh uses the new wire constants.\n    importlib.invalidate_caches()\n    from tracekit.runtime import writer\n    importlib.reload(writer)\n    from tracekit.corpus.refresh import refresh_pool\n    refresh_pool()\n\n\nif __name__ == \"__main__\":\n    emit_runtime()\n    print(\"forge complete\", file=sys.stderr)\nPY\ncat > /app/pkgc/rdr.tpl <<'PY'\n\"\"\"Generated trace reader (schema v{{ version }}).\"\"\"\n\nfrom __future__ import annotations\n\nfrom tracekit.runtime.pack import decode_trace\n\nMAGIC = b\"{{ magic }}\"\nLEGACY_MAGIC = b\"{{ legacy_magic }}\"\nMAGICS = (MAGIC, LEGACY_MAGIC)\nNAME_LEN_BITS = {{ name_len_bits }}\n\n\ndef ingest_blob(blob: bytes) -> tuple[int, str, int]:\n    # The fixed portion is magic + lane + name length + grams. Requiring the\n    # exact encoded size prevents truncated and trailing data from decoding.\n    if NAME_LEN_BITS != 16 or len(blob) < 12 or blob[:4] not in MAGICS:\n        raise ValueError(\"bad trace\")\n    name_len = int.from_bytes(blob[6:8], \"big\")\n    if len(blob) != 12 + name_len:\n        raise ValueError(\"bad trace\")\n    return decode_trace(blob, MAGICS, NAME_LEN_BITS)\nPY\n"]
