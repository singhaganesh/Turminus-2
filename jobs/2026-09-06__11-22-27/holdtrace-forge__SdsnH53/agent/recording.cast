[63.216781, "i", "printf 'HLT2' > /tmp/bad.trc; out=$(/app/bin/holdtrace decode /tmp/bad.trc); rc=$?; printf 'malformed_rc=%s output=%s\\n' \"$rc\" \"$out\"; cp /tmp/holdtrace_grade.trc /tmp/bad_trailing.trc; printf X >> /tmp/bad_trailing.trc; out=$(/app/bin/holdtrace decode /tmp/bad_trailing.trc); rc=$?; printf 'trailing_rc=%s output=%s\\n' \"$rc\" \"$out\"; python3 /app/tracekit/smoke/corpus_len.py; echo smoke_rc=$?\n"]
