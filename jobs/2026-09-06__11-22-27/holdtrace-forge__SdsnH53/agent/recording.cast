[62.169637, "o", "\"\"\"Generated trace reader (schema v2).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom tracekit.runtime.pack import decode_trace\r\n\r\nMAGIC = b\"HLT2\"\r\nLEGACY_MAGIC = b\"HLT1\"\r\nMAGICS = (MAGIC, LEGACY_MAGIC)\r\nNAME_LEN_BITS = 16\r\n\r\n\r\ndef ingest_blob(blob: bytes) -> tuple[int, str, int]:\r\n    # The fixed portion is magic + lane + name length + grams. Requiring the\r\n    # exact encoded size prevents truncated and trailing data from decoding.\r\n    if NAME_LEN_BITS != 16 or len(blob) < 12 or blob[:4] not in MAGICS:\r\n        raise ValueError(\"bad trace\")\r\n    name_len = int.from_bytes(blob[6:8], \"big\")\r\n    if len(blob) != 12 + name_len:\r\n        raise ValueError(\"bad trace\")\r\n    return decode_trace(blob, MAGICS, NAME_LEN_BITS)\r\n"]
[62.169961, "o", "--- generated writer ---\r\n"]
[62.171834, "o", "\"\"\"Generated trace writer (schema v2).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom tracekit.runtime.pack import encode_trace\r\n\r\nMAGIC = b\"HLT2\"\r\nNAME_LEN_BITS = 16\r\n\r\n\r\ndef emit_lane(lane_id: int, event: str, grams: int) -> bytes:\r\n    return encode_trace(MAGIC, lane_id, event, grams, NAME_LEN_BITS)\r\n"]
