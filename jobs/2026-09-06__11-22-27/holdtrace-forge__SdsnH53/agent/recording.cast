[10.130425, "o", "\u001b[?2004hroot@0fcd86363751:/app# "]
[10.269546, "i", "printf '\\n--- likely sources/runtime ---\\n'; find /app/tracekit -type f \\( -name '*.py' -o -name '*.tmpl' -o -name '*.j2' \\) -print -exec sh -c 'echo \"### $1\"; sed -n \"1,260p\" \"$1\"' _ {} \\;\n"]
[10.270316, "o", "printf '\\n--- likely sources/runtime ---\\n'; find /app/tracekit -type f \\( -name '*.py' -o -name '*.tmpl' -o -name '*.j2' \\) -print -exec sh -c 'echo \"### $1\"; sed -n \"1,260p\" \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
