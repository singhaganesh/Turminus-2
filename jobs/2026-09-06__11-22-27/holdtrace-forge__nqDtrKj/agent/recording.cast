[74.630225, "i", "/app/bin/holdtrace record --lane 23 --event fresh_hold --grams 4321 --out /tmp/holdtrace_grade.trc && echo '--- fresh decode ---' && /app/bin/holdtrace decode /tmp/holdtrace_grade.trc && echo '--- first four bytes ---' && od -An -tc -N4 /tmp/holdtrace_grade.trc && python3 - <<'PY'\nfrom pathlib import Path\nfrom tracekit.runtime import reader, writer\np = Path('/tmp/holdtrace_grade.trc')\nb = p.read_bytes()\nassert b[:4] == writer.MAGIC\nassert b[:4] in reader.MAGICS\nassert reader.ingest_blob(b) == (23, 'fresh_hold', 4321)\nprint('round-trip and magic checks passed')\nPY\n"]
[74.633814, "o", "/app/bin/holdtrace record --lane 23 --event fresh_hold --grams 4321 --out /tmp/holdtrace_grade.trc && echo '--- fresh decode ---' && /app/bin/holdtrace decode /tmp/holdtrace_grade.trc && echo '--- first four bytes ---' && od -An -tc -N4 /tmp/holdtrace_grade.trc && python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.633863, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[74.634411, "o", "\u001b[?2004h"]
[74.634899, "o", "> from tracekit.runtime import reader, writer"]
[74.640302, "o", "\r\n\u001b[?2004l\r"]
[74.640742, "o", "\u001b[?2004h> p = Path('/tmp/holdtrace_grade.trc')\r\n\u001b[?2004l\r\u001b[?2004h> b = p.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.641354, "o", "> assert b[:4] == writer.MAGIC\r\n\u001b[?2004l\r\u001b[?2004h> assert b[:4] in reader.MAGICS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.641443, "o", "assert reader.ingest_blob(b) == (23, 'fresh_hold', 4321)\r\n\u001b[?2004l\r\u001b[?2004h> print('round-trip and magic checks passed')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[74.751179, "o", "--- fresh decode ---\r\n"]
[74.832117, "o", "{\"event\": \"fresh_hold\", \"lane_id\": 23, \"grams\": 4321}\r\n"]
[74.845307, "o", "--- first four bytes ---\r\n"]
[74.846219, "o", "   H   L   T   2\r\n"]
[74.905293, "o", "round-trip and magic checks passed\r\n"]
[74.913992, "o", "\u001b[?2004hroot@ba66f173e777:/app# "]
[75.64016, "i", "printf 'x' > /tmp/bad_short.trc; cp /tmp/holdtrace_grade.trc /tmp/bad_trailing.trc; printf 'x' >> /tmp/bad_trailing.trc; for f in /tmp/bad_short.trc /tmp/bad_trailing.trc; do echo \"--- malformed $f ---\"; /app/bin/holdtrace decode \"$f\"; s=$?; echo \"status=$s\"; test \"$s\" -ne 0 || exit 1; done\n"]
[75.641896, "o", "printf 'x' > /tmp/bad_short.trc; cp /tmp/holdtrace_grade.trc /tmp/bad_trailing.trc; printf 'x' >> /tmp/bad_trailing.trc; for f in /tmp/bad_short.trc /tmp/bad_trailing.trc; do echo \"--- malformed $f ---\"; /app/bin/holdtrace decode \"$f\"; s=$?; echo \"status=$s\"; test \"$s\" -ne 0 || exit 1; done\r\n\u001b[?2004l\r"]
[75.644747, "o", "--- malformed /tmp/bad_short.trc ---\r\n"]
