[22.140487, "o", "for f in /app/tracekit/runtime/pack.py /app/tracekit/runtime/reader.py /app/tracekit/runtime/writer.py /app/tracekit/cmd/forge.py /app/tracekit/cmd/decode.py /app/tracekit/cmd/record.py /app/tracekit/corpus/refresh.py /app/tracekit/cli.py /app/tracekit/holdtrace_cli.sh /app/bin/holdtrace /app/tracekit/smoke/corpus_len.py; do echo \"--- $f ---\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r--- /app/tracekit/runtime/pack.py ---\r\n"]
[22.141554, "o", "     1\t\"\"\"Shared wire helpers for holdtrace traces.\"\"\"\r\n"]
[22.14178, "o", "     2\t\r\n     3\tfrom __future__ import annotations\r\n"]
[22.141823, "o", "     4\t\r\n     5\timport struct\r\n     6\tfrom typing import Tuple\r\n     7\t\r\n     8\t\r\n     9\tdef encode_trace(magic: bytes, lane_id: int, event: str, grams: int, name_len_bits: int) -> bytes:\r\n    10\t    if len(magic) != 4:\r\n    11\t        raise ValueError(\"magic must be four bytes\")\r\n    12\t    name_b = event.encode(\"utf-8\")\r\n"]
[22.141847, "o", "    13\t    if name_len_bits == 8:\r\n    14\t        if len(name_b) > 255:\r\n    15\t            raise ValueError(\"name too long for 8-bit length\")\r\n    16\t        nlen = struct.pack(\">B\", len(name_b))\r\n    17\t    elif name_len_bits == 16:\r\n    18\t"]
[22.141868, "o", "        nlen = struct.pack(\">H\", len(name_b))\r\n    19\t    else:\r\n    20\t        raise ValueError(\"unsupported name length width\")\r\n    21\t    return magic + struct.pack(\">H\", lane_id) + nlen + name_b + struct.pack(\">I\", grams)\r\n"]
[22.142266, "o", "    22\t\r\n    23\t\r\n    24\tdef decode_trace(\r\n    25\t    blob: bytes,\r\n    26\t    accept_magics: Tuple[bytes, ...],\r\n    27\t    name_len_bits: int,\r\n    28\t) -> Tuple[int, str, int]:\r\n    29\t    if len(blob) < 11:\r\n    30\t        raise ValueError(\"truncated\")\r\n    31\t    magic = blob[:4]\r\n    32\t    if magic not in accept_magics:\r\n    33\t        raise ValueError(\"bad magic\")\r\n    34\t    lane_id = struct.unpack(\">H\", blob[4:6])[0]\r\n    35\t    off = 6\r\n    36\t    if name_len_bits == 8:\r\n    37\t        nlen = blob[off]\r\n    38\t        off += 1\r\n    39\t    else:\r\n    40\t        nlen = struct.unpack(\">H\", blob[off : off + 2])[0]\r\n    41\t        off += 2\r\n    42\t    name = blob[off : off + nlen].decode(\"utf-8\")\r\n    43\t    off += nlen\r\n    44\t    grams = struct.unpack(\">I\", blob[off : off + 4])[0]\r\n    45\t    return lane_id, name, grams\r\n"]
[22.142408, "o", "--- /app/tracekit/runtime/reader.py ---\r\n"]
[22.143483, "o", "     1\t\"\"\"Generated trace reader (stale layout — magic not synced).\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom tracekit.runtime.pack import decode_trace\r\n"]
[22.143636, "o", "     6\t\r\n     7\tMAGIC = b\"HLT1\"\r\n     8\tLEGACY = (MAGIC,)\r\n     9\tNAME_LEN_BITS = 8\r\n    10\t\r\n    11\t\r\n    12\tdef ingest_blob(blob: bytes) -> tuple[int, str, int]:\r\n    13\t    return decode_trace(blob, LEGACY, NAME_LEN_BITS)\r\n"]
[22.143842, "o", "--- /app/tracekit/runtime/writer.py ---\r\n"]
[22.144884, "o", "     1\t\"\"\"Generated trace writer (schema v2).\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom tracekit.runtime.pack import encode_trace\r\n     6\t\r\n     7\tMAGIC = b\"HLT2\"\r\n     8\tNAME_LEN_BITS = 16\r\n     9\t\r\n    10\t\r\n    11\tdef emit_lane(lane_id: int, event: str, grams: int) -> bytes:\r\n    12\t    return encode_trace(MAGIC, lane_id, event, grams, NAME_LEN_BITS)\r\n"]
[22.145127, "o", "--- /app/tracekit/cmd/forge.py ---\r\n"]
[22.146181, "o", "     1\t\"\"\"Holdtrace forge subcommand.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport argparse\r\n     6\t\r\n     7\tfrom pkgb.sync import emit_runtime\r\n"]
[22.14634, "o", "     8\t\r\n     9\t\r\n    10\tdef run(_: argparse.Namespace) -> int:\r\n    11\t    emit_runtime()\r\n    12\t    return 0\r\n"]
[22.14653, "o", "--- /app/tracekit/cmd/decode.py ---\r\n"]
[22.149653, "o", "     1\t\"\"\"Holdtrace decode subcommand.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport argparse\r\n     6\timport json\r\n     7\tfrom pathlib import Path\r\n     8\t\r\n     9\tfrom tracekit.runtime import reader as rmod\r\n    10\t\r\n    11\t\r\n    12\tdef run(args: argparse.Namespace) -> int:\r\n    13\t    path = Path(args.path)\r\n    14\t    try:\r\n    15\t        lane_id, event, grams = rmod.ingest_blob(path.read_bytes())\r\n    16\t    except (ValueError, OSError):\r\n    17\t        print(json.dumps({\"error\": \"bad_trace\"}))\r\n    18\t        return 1\r\n    19\t    if not event:\r\n    20\t        print(json.dumps({\"error\": \"bad_trace\"}))\r\n    21\t        return 1\r\n    22\t    print(json.dumps({\"event\": event, \"lane_id\": lane_id, \"grams\": grams}))\r\n    23\t    return 0\r\n"]
[22.150004, "o", "--- /app/tracekit/cmd/record.py ---\r\n"]
[22.151582, "o", "     1\t\"\"\"Holdtrace record subcommand.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n"]
[22.151804, "o", "     5\timport argparse\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tfrom tracekit.runtime import writer as wmod\r\n     9\t\r\n    10\t\r\n    11\tdef run(args: argparse.Namespace) -> int:\r\n    12\t    blob = wmod.emit_lane(args.lane, args.event, args.grams)\r\n    13\t    out = Path(args.out) if args.out else Path(\"/tmp/holdtrace_last.trc\")\r\n    14\t    out.write_bytes(blob)\r\n    15\t    return 0\r\n"]
[22.152679, "o", "--- /app/tracekit/corpus/refresh.py ---\r\n"]
[22.155341, "o", "     1\t\"\"\"Refresh corpus traces from the live writer.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6\t\r\n     7\tfrom pkgb.step_b import step_b\r\n     8\tfrom tracekit.runtime import writer as wmod\r\n     9\t\r\n    10\tCORPUS = Path(\"/app/tracekit/corpus\")\r\n    11\t\r\n    12\t\r\n    13\tdef refresh_pool() -> None:\r\n    14\t    schema = step_b()\r\n    15\t    CORPUS.mkdir(parents=True, exist_ok=True)\r\n    16\t    for old in CORPUS.glob(\"*.trc\"):\r\n    17\t        old.unlink()\r\n    18\t    for idx, row in enumerate(schema.get(\"corpus_events\", [])):\r\n    19\t        blob = wmod.emit_lane(int(row[\"lane_id\"]), str(row[\"event\"]), int(row[\"grams\"]))\r\n    20\t        (CORPUS / f\"sample_{idx}.trc\").write_bytes(blob)\r\n"]
[22.155402, "o", "--- /app/tracekit/cli.py ---\r\n"]
[22.15707, "o", "     1\t\"\"\"Holdtrace command-line entry.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport argparse\r\n     6\t\r\n     7\tfrom tracekit.cmd import decode, forge, record\r\n     8\t\r\n     9\t\r\n    10\tdef main(argv: list[str] | None = None) -> int:\r\n    11\t    parser = argparse.ArgumentParser(prog=\"holdtrace\")\r\n    12\t    sub = parser.add_subparsers(dest=\"cmd\", required=True)\r\n"]
[22.157238, "o", "    13\t    sub.add_parser(\"forge\")\r\n    14\t    rec = sub.add_parser(\"record\")\r\n    15\t    rec.add_argument(\"--lane\", type=int, required=True)\r\n    16\t    rec.add_argument(\"--event\", required=True)\r\n    17\t    rec.add_argument(\"--grams\", type=int, required=True)\r\n    18\t    rec.add_argument(\"--out\", default=\"\")\r\n    19\t    dec = sub.add_parser(\"decode\")\r\n    20\t    dec.add_argument(\"path\")\r\n    21\t    args = parser.parse_args(argv)\r\n    22\t    if args.cmd == \"forge\":\r\n    23\t        return forge.run(args)\r\n    24\t    if args.cmd == \"record\":\r\n    25\t        return record.run(args)\r\n    26\t    if args.cmd == \"decode\":\r\n    27\t        return decode.run(args)\r\n    28\t    return 2\r\n    29\t\r\n    30\t\r\n    31\tif __name__ == \"__main__\":\r\n    32\t    raise SystemExit(main())\r\n"]
[22.15763, "o", "--- /app/tracekit/holdtrace_cli.sh ---\r\n"]
[22.159046, "o", "     1\t#!/usr/bin/env python3\r\n     2\timport sys\r\n     3\tsys.path.insert(0, \"/app\")\r\n     4\tfrom tracekit.cli import main\r\n     5\t\r\n     6\tif __name__ == \"__main__\":\r\n     7\t    raise SystemExit(main())\r\n"]
[22.159307, "o", "--- /app/bin/holdtrace ---\r\n"]
[22.160412, "o", "     1\t#!/usr/bin/env python3\r\n     2\timport sys\r\n     3\tsys.path.insert(0, \"/app\")\r\n     4\tfrom tracekit.cli import main\r\n     5\t\r\n     6\tif __name__ == \"__main__\":\r\n     7\t    raise SystemExit(main())\r\n"]
[22.160701, "o", "--- /app/tracekit/smoke/corpus_len.py ---\r\n"]
[22.161791, "o", "     1\t#!/usr/bin/env python3\r\n     2\t\"\"\"Local smoke helper — only checks corpus files exist (not decode).\"\"\"\r\n     3\t\r\n     4\tfrom __future__ import annotations\r\n     5\t\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tCORPUS = Path(\"/app/tracekit/corpus\")\r\n     9\t\r\n    10\t\r\n    11\tdef main() -> int:\r\n    12\t    files = list(CORPUS.glob(\"*.trc\"))\r\n    13\t    if not files:\r\n    14\t        return 1\r\n    15\t    for p in files:\r\n    16\t        if p.stat().st_size < 8:\r\n    17\t            return 1\r\n"]
[22.161948, "o", "    18\t    return 0\r\n    19\t\r\n    20\t\r\n    21\tif __name__ == \"__main__\":\r\n    22\t    raise SystemExit(main())\r\n"]
[22.162117, "o", "\u001b[?2004hroot@ba66f173e777:/app# "]
[22.499863, "i", "for f in /app/archive/deployed/lane_ops.trc /app/tracekit/corpus/*.trc; do echo \"--- $f ($(stat -c%s \"$f\") bytes) ---\"; od -An -tx1 -v \"$f\"; done\n"]
[22.506496, "o", "for f in /app/archive/deployed/lane_ops.trc /app/tracekit/corpus/*.trc; do echo \"--- $f ($(stat -c%s \"$f\") bytes) ---\"; od -An -tx1 -v \"$f\"; done\r\n"]
