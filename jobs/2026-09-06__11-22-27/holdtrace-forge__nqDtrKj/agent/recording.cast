[38.63653, "i", "echo '--- runtime reader ---'; cat /app/tracekit/runtime/reader.py; echo '--- runtime writer ---'; cat /app/tracekit/runtime/writer.py; echo '--- forge command ---'; cat /app/tracekit/cmd/forge.py; echo '--- helper modules ---'; find /app/pkga /app/pkgb -maxdepth 2 -type f -name '*.py' -print -exec sh -c 'echo \"### $1\"; nl -ba \"$1\"' _ {} \\;\n"]
[38.638067, "o", "echo '--- runtime reader ---'; cat /app/tracekit/runtime/reader.py; echo '--- runtime writer ---'; cat /app/tracekit/runtime/writer.py; echo '--- forge command ---'; cat /app/tracekit/cmd/forge.py; echo '--- helper modules ---'; find /app/pkga /app/pkgb -maxdepth 2 -type f -name '*.py' -print -exec sh -c 'echo \"### $1\"; nl -ba \"$1\"' _ {} \\;\r\n\u001b[?2004l\r"]
[38.638247, "o", "--- runtime reader ---\r\n"]
[38.640001, "o", "\"\"\"Generated trace reader (stale layout — magic not synced).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom tracekit.runtime.pack import decode_trace\r\n\r\nMAGIC = b\"HLT1\"\r\nLEGACY = (MAGIC,)\r\nNAME_LEN_BITS = 8\r\n\r\n\r\ndef ingest_blob(blob: bytes) -> tuple[int, str, int]:\r\n    return decode_trace(blob, LEGACY, NAME_LEN_BITS)\r\n"]
[38.640239, "o", "--- runtime writer ---\r\n"]
[38.642027, "o", "\"\"\"Generated trace writer (schema v2).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom tracekit.runtime.pack import encode_trace\r\n\r\nMAGIC = b\"HLT2\"\r\nNAME_LEN_BITS = 16\r\n\r\n\r\ndef emit_lane(lane_id: int, event: str, grams: int) -> bytes:\r\n    return encode_trace(MAGIC, lane_id, event, grams, NAME_LEN_BITS)\r\n"]
[38.642998, "o", "--- forge command ---\r\n"]
[38.644068, "o", "\"\"\"Holdtrace forge subcommand.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\n\r\nfrom pkgb.sync import emit_runtime\r\n\r\n\r\ndef run(_: argparse.Namespace) -> int:\r\n    emit_runtime()\r\n    return 0\r\n"]
[38.644597, "o", "--- helper modules ---\r\n"]
[38.646092, "o", "/app/pkga/__init__.py\r\n"]
[38.647529, "o", "### /app/pkga/__init__.py\r\n"]
[38.649654, "o", "/app/pkga/vars.py\r\n"]
[38.651025, "o", "### /app/pkga/vars.py\r\n"]
[38.651976, "o", "     1\t\"\"\"Map span schema fields into template substitution context.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\t\r\n"]
[38.652171, "o", "     6\tdef span_ctx(schema: dict) -> dict:\r\n     7\t    return {\r\n     8\t        \"version\": schema.get(\"version\", 1),\r\n     9\t        \"magic\": schema.get(\"magic\", \"HLT2\"),\r\n    10\t        \"name_len_bits\": schema.get(\"name_len_bits\", 16),\r\n    11\t    }\r\n"]
[38.65268, "o", "/app/pkgb/render.py\r\n"]
[38.653599, "o", "### /app/pkgb/render.py\r\n"]
[38.654509, "o", "     1\t\"\"\"Minimal placeholder substitution for layout templates.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom pathlib import Path\r\n     6"]
[38.654569, "o", "\t\r\n     7\tLAYOUT = Path(__file__).resolve().parent.parent / \"pkgc\"\r\n     8\t\r\n     9\t\r\n    10\tdef render_tpl(name: str, ctx: dict) -> str:\r\n    11\t    text = (LAYOUT / name).read_text()\r\n    12\t    for key, val in ctx.items():\r\n    13\t        text = text.replace(\"{{ \" + key + \" }}\", str(val))\r\n    14\t    return text\r\n"]
[38.655252, "o", "/app/pkgb/step_b.py\r\n"]
[38.656407, "o", "### /app/pkgb/step_b.py\r\n"]
[38.657413, "o", "     1\t\"\"\"Load span schema for the forge driver.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport json\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tSCHEMA_PATH = Path(\"/app/tracekit/schema/span.json\")\r\n     9\t\r\n    10\t\r\n    11\tdef step_b() -> dict:\r\n    12\t    data = json.loads(SCHEMA_PATH.read_text())\r\n"]
[38.657588, "o", "    13\t    if not isinstance(data, dict):\r\n    14\t        raise ValueError(\"schema must be a mapping\")\r\n    15\t    return data\r\n"]
[38.657845, "o", "/app/pkgb/__init__.py\r\n"]
[38.65876, "o", "### /app/pkgb/__init__.py\r\n"]
[38.659972, "o", "/app/pkgb/sync.py\r\n"]
[38.660825, "o", "### /app/pkgb/sync.py\r\n"]
[38.66158, "o", "     1\t\"\"\"Regenerate runtime modules and corpus from span.json.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport sys\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tfrom pkga.vars import span_ctx\r\n     9\tfrom pkgb.render import render_tpl\r\n    10\tfrom pkgb.step_b import step_b\r\n    11\tfrom tracekit.corpus.refresh import refresh_pool\r\n    12\t\r\n    13\t\r\n    14\tdef emit_runtime() -> None:\r\n"]
[38.66169, "o", "    15\t    schema = step_b()\r\n    16\t    ctx = span_ctx(schema)\r\n    17\t    runtime = Path(\"/app/tracekit/runtime\")\r\n    18\t    runtime.mkdir(parents=True, exist_ok=True)\r\n    19\t    (runtime / \"writer.py\").write_text(render_tpl(\"wrt.tpl\", ctx))\r\n    20\t    pkgc = Path(__file__).resolve().parent.parent / \"pkgc\"\r\n    21\t    (runtime / \"reader.py\").write_text((pkgc / \"rdr.tpl\").read_text())\r\n    22\t    refresh_pool()\r\n    23\t\r\n    24\t\r\n    25\tif __name__ == \"__main__\":\r\n    26\t    emit_runtime()\r\n    27\t    print(\"forge complete\", file=sys.stderr)\r\n"]
[38.662461, "o", "\u001b[?2004h"]
[38.662552, "o", "root@ba66f173e777:/app# "]
[72.558982, "i", "cat > /app/pkga/vars.py <<'PY'\n\"\"\"Map span schema fields into template substitution context.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef span_ctx(schema: dict) -> dict:\n    return {\n        \"version\": schema.get(\"version\", 1),\n        \"magic\": schema.get(\"magic\", \"HLT2\"),\n        \"legacy_magic\": schema.get(\"legacy_magic\", \"HLT1\"),\n        \"name_len_bits\": schema.get(\"name_len_bits\", 16),\n    }\nPY\ncat > /app/pkgb/sync.py <<'PY'\n\"\"\"Regenerate runtime modules and corpus from span.json.\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib\nimport sys\nfrom pathlib import Path\n\nfrom pkga.vars import span_ctx\nfrom pkgb.render import render_tpl\nfrom pkgb.step_b import step_b\nfrom tracekit.corpus.refresh import refresh_pool\n\n\ndef emit_runtime() -> None:\n    schema = step_b()\n    ctx = span_ctx(schema)\n    runtime = Path(\"/app/tracekit/runtime\")\n    runtime.mkdir(parents=True, exist_ok=True)\n    (runtime / \"writer.py\").write_text(render_tpl(\"wrt.tpl\", ctx))\n    (runtime / \"reader.py\").write_text(render_tpl(\"rdr.tpl\", ctx))\n\n    # holdtrace imports the runtime before dispatching the forge command.\n    # Reload the rewritten writer so corpus generation uses the new schema.\n    importlib.invalidate_caches()\n    from tracekit.runtime import writer as writer_mod\n    importlib.reload(writer_mod)\n    refresh_pool()\n\n\nif __name__ == \"__main__\":\n    emit_runtime()\n    print(\"forge complete\", file=sys.stderr)\nPY\ncat > /app/pkgc/rdr.tpl <<'PY'\n\"\"\"Generated trace reader (schema v{{ version }}).\"\"\"\n\nfrom __future__ import annotations\n\nfrom tracekit.runtime.pack import decode_trace\n\nMAGICS = (b\"{{ legacy_magic }}\", b\"{{ magic }}\")\nNAME_BITS = {{ name_len_bits }}\n\n\ndef ingest_blob(blob: bytes) -> tuple[int, str, int]:\n    # Validate the complete variable-length frame before unpacking it.\n    if NAME_BITS == 8:\n        if len(blob) < 7:\n            raise ValueError(\"truncated\")\n        name_len = blob[6]\n        prefix_len = 7\n    elif NAME_BITS == 16:\n        if len(blob) < 8:\n            raise ValueError(\"truncated\")\n        name_len = int.from_bytes(blob[6:8], \"big\")\n        prefix_len = 8\n    else:\n        raise ValueError(\"unsupported name length width\")\n    if len(blob) != prefix_len + name_len + 4:\n        raise ValueError(\"bad length\")\n    return decode_trace(blob, MAGICS, NAME_BITS)\nPY\n/app/bin/holdtrace forge\n"]
