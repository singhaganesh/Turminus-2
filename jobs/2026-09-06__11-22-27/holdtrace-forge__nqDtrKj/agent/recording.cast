[21.87285, "i", "for f in /app/pkga/vars.py /app/pkgb/sync.py /app/pkgc/rdr.tpl /app/pkgc/wrt.tpl; do echo \"--- $f ---\"; nl -ba \"$f\"; done\n"]
[21.875748, "o", "for f in /app/pkga/vars.py /app/pkgb/sync.py /app/pkgc/rdr.tpl /app/pkgc/wrt.tpl; do echo \"--- $f ---\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r--- /app/pkga/vars.py ---\r\n"]
[21.889757, "o", "     1\t\"\"\"Map span schema fields into template substitution context.\"\"\"\r\n     2\t\r\n"]
[21.889861, "o", "     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\t\r\n     6\tdef span_ctx(schema: dict) -> dict:\r\n     7\t    return {\r\n     8\t        \"version\": schema.get(\"version\", 1),\r\n     9\t        \"magic\": schema.get(\"magic\", \"HLT2\"),\r\n    10\t        \"name_len_bits\": schema.get(\"name_len_bits\", 16),\r\n    11\t    }\r\n"]
[21.890819, "o", "--- /app/pkgb/sync.py ---\r\n"]
[21.892733, "o", "     1\t\"\"\"Regenerate runtime modules and corpus from span.json.\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\timport sys\r\n     6\tfrom pathlib import Path\r\n     7\t\r\n     8\tfrom pkga.vars import span_ctx\r\n     9\tfrom pkgb.render import render_tpl\r\n    10\tfrom pkgb.step_b import step_b\r\n    11\tfrom tracekit.corpus.refresh import refresh_pool\r\n    12\t\r\n    13\t\r\n    14\tdef emit_runtime() -> None:\r\n    15\t    schema = step_b()\r\n    16\t    ctx = span_ctx(schema)\r\n    17\t    runtime = Path(\"/app/tracekit/runtime\")\r\n    18\t    runtime.mkdir(parents=True, exist_ok=True)\r\n    19\t    (runtime / \"writer.py\").write_text(render_tpl(\"wrt.tpl\", ctx))\r\n    20\t    pkgc = Path(__file__).resolve().parent.parent / \"pkgc\"\r\n    21\t    (runtime / \"reader.py\").write_text((pkgc / \"rdr.tpl\").read_text())\r\n    22\t    refresh_pool()\r\n    23\t\r\n    24\t\r\n    25\tif __name__ == \"__main__\":\r\n    26\t    emit_runtime()\r\n    27\t    print(\"forge complete\", file=sys.stderr)\r\n"]
[21.893919, "o", "--- /app/pkgc/rdr.tpl ---\r\n"]
[21.895496, "o", "     1\t\"\"\"Generated trace reader (schema v{{ version }}).\"\"\"\r\n"]
[21.896508, "o", "     2\t\r\n"]
[21.897346, "o", "     3\tfrom __future__ import annotations\r\n"]
[21.897596, "o", "     4\t\r\n     5\tfrom tracekit.runtime.pack import decode_trace\r\n     6\t\r\n     7\tMAGICS = (b\"{{ legacy_magic }}\", b\"{{ magic }}\")\r\n     8\tNAME_BITS = {{ name_len_bits }}\r\n     9\t\r\n    10\t\r\n    11\tdef ingest_blob(blob: bytes) -> tuple[int, str, int]:\r\n    12\t    return decode_trace(blob, MAGICS, NAME_BITS)\r\n"]
[21.90958, "o", "--- /app/pkgc/wrt.tpl ---\r\n"]
[21.909677, "o", "     1\t\"\"\"Generated trace writer (schema v{{ version }}).\"\"\"\r\n     2\t\r\n     3\tfrom __future__ import annotations\r\n     4\t\r\n     5\tfrom tracekit.runtime.pack import encode_trace\r\n     6\t\r\n     7\tMAGIC = b\"{{ magic }}\"\r\n     8\tNAME_LEN_BITS = {{ name_len_bits }}\r\n     9\t\r\n    10\t\r\n    11\tdef emit_lane(lane_id: int, event: str, grams: int) -> bytes:\r\n    12\t    return encode_trace(MAGIC, lane_id, event, grams, NAME_LEN_BITS)\r\n"]
