[73.629321, "i", "echo '--- generated reader ---'; cat /app/tracekit/runtime/reader.py; echo '--- generated writer ---'; cat /app/tracekit/runtime/writer.py; echo '--- archive ---'; /app/bin/holdtrace decode /app/archive/deployed/lane_ops.trc; echo \"status=$?\"; echo '--- corpus ---'; for f in /app/tracekit/corpus/*.trc; do printf '%s: ' \"$f\"; /app/bin/holdtrace decode \"$f\" || exit 1; done\n"]
[73.630581, "o", "echo '--- generated reader ---'; cat /app/tracekit/runtime/reader.py; echo '--- generated writer ---'; cat /app/tracekit/runtime/writer.py; echo '--- archive ---'; /app/bin/holdtrace decode /app/archive/deployed/lane_ops.trc; echo \"status=$?\"; echo '--- corpus ---'; for f in /app/tracekit/corpus/*.trc; do printf '%s: ' \"$f\"; /app/bin/holdtrace decode \"$f\" || exit 1; done\r\n\u001b[?2004l\r"]
[73.630948, "o", "--- generated reader ---\r\n"]
[73.63431, "o", "\"\"\"Generated trace reader (schema v2).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom tracekit.runtime.pack import decode_trace\r\n\r\nMAGICS = (b\"HLT1\", b\"HLT2\")\r\nNAME_BITS = 16\r\n\r\n\r\ndef ingest_blob(blob: bytes) -> tuple[int, str, int]:\r\n    # Validate the complete variable-length frame before unpacking it.\r\n    if NAME_BITS == 8:\r\n        if len(blob) < 7:\r\n            raise ValueError(\"truncated\")\r\n        name_len = blob[6]\r\n        prefix_len = 7\r\n    elif NAME_BITS == 16:\r\n        if len(blob) < 8:\r\n            raise ValueError(\"truncated\")\r\n        name_len = int.from_bytes(blob[6:8], \"big\")\r\n        prefix_len = 8\r\n    else:\r\n        raise ValueError(\"unsupported name length width\")\r\n    if len(blob) != prefix_len + name_len + 4:\r\n        raise ValueError(\"bad length\")\r\n    return decode_trace(blob, MAGICS, NAME_BITS)\r\n"]
[73.635089, "o", "--- generated writer ---\r\n"]
[73.636828, "o", "\"\"\"Generated trace writer (schema v2).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom tracekit.runtime.pack import encode_trace\r\n\r\nMAGIC = b\"HLT2\"\r\nNAME_LEN_BITS = 16\r\n\r\n\r\ndef emit_lane(lane_id: int, event: str, grams: int) -> bytes:\r\n    return encode_trace(MAGIC, lane_id, event, grams, NAME_LEN_BITS)\r\n"]
[73.637188, "o", "--- archive ---\r\n"]
[73.733019, "o", "{\"event\": \"lane_open\", \"lane_id\": 7, \"grams\": 1250}\r\n"]
[73.756151, "o", "status=0\r\n--- corpus ---\r\n"]
[73.75641, "o", "/app/tracekit/corpus/sample_0.trc: "]
[73.844849, "o", "{\"event\": \"dock_idle\", \"lane_id\": 3, \"grams\": 400}\r\n"]
