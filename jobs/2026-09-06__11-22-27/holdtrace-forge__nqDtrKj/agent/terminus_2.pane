     1	"""Shared wire helpers for holdtrace traces."""
     2	
     3	from __future__ import annotations
     4	
     5	import struct
     6	from typing import Tuple
     7	
     8	
     9	def encode_trace(magic: bytes, lane_id: int, event: str, grams: int, name_len_bits: int) -> bytes:
    10	    if len(magic) != 4:
    11	        raise ValueError("magic must be four bytes")
    12	    name_b = event.encode("utf-8")
    13	    if name_len_bits == 8:
    14	        if len(name_b) > 255:
    15	            raise ValueError("name too long for 8-bit length")
    16	        nlen = struct.pack(">B", len(name_b))
    17	    elif name_len_bits == 16:
    18	        nlen = struct.pack(">H", len(name_b))
    19	    else:
    20	        raise ValueError("unsupported name length width")
    21	    return magic + struct.pack(">H", lane_id) + nlen + name_b + struct.pack(">I", grams)
    22	
    23	
    24	def decode_trace(
    25	    blob: bytes,
    26	    accept_magics: Tuple[bytes, ...],
    27	    name_len_bits: int,
    28	) -> Tuple[int, str, int]:
    29	    if len(blob) < 11:
    30	        raise ValueError("truncated")
    31	    magic = blob[:4]
    32	    if magic not in accept_magics:
    33	        raise ValueError("bad magic")
    34	    lane_id = struct.unpack(">H", blob[4:6])[0]
    35	    off = 6
    36	    if name_len_bits == 8:
    37	        nlen = blob[off]
    38	        off += 1
    39	    else:
    40	        nlen = struct.unpack(">H", blob[off : off + 2])[0]
    41	        off += 2
    42	    name = blob[off : off + nlen].decode("utf-8")
    43	    off += nlen
    44	    grams = struct.unpack(">I", blob[off : off + 4])[0]
    45	    return lane_id, name, grams
