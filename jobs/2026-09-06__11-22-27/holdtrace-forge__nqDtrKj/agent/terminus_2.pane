--- /app/tracekit/corpus/refresh.py ---
     1	"""Refresh corpus traces from the live writer."""
     2	
     3	from __future__ import annotations
     4	
     5	from pathlib import Path
     6	
     7	from pkgb.step_b import step_b
     8	from tracekit.runtime import writer as wmod
     9	
    10	CORPUS = Path("/app/tracekit/corpus")
    11	
    12	
    13	def refresh_pool() -> None:
    14	    schema = step_b()
    15	    CORPUS.mkdir(parents=True, exist_ok=True)
    16	    for old in CORPUS.glob("*.trc"):
    17	        old.unlink()
    18	    for idx, row in enumerate(schema.get("corpus_events", [])):
    19	        blob = wmod.emit_lane(int(row["lane_id"]), str(row["event"]), int(row["grams"]))
    20	        (CORPUS / f"sample_{idx}.trc").write_bytes(blob)
--- /app/tracekit/cli.py ---
     1	"""Holdtrace command-line entry."""
     2	
     3	from __future__ import annotations
     4	
     5	import argparse
     6	
     7	from tracekit.cmd import decode, forge, record
     8	
     9	
    10	def main(argv: list[str] | None = None) -> int:
    11	    parser = argparse.ArgumentParser(prog="holdtrace")
    12	    sub = parser.add_subparsers(dest="cmd", required=True)
    13	    sub.add_parser("forge")
    14	    rec = sub.add_parser("record")
    15	    rec.add_argument("--lane", type=int, required=True)
    16	    rec.add_argument("--event", required=True)
    17	    rec.add_argument("--grams", type=int, required=True)
    18	    rec.add_argument("--out", default="")
    19	    dec = sub.add_parser("decode")
    20	    dec.add_argument("path")
    21	    args = parser.parse_args(argv)
    22	    if args.cmd == "forge":
    23	        return forge.run(args)
    24	    if args.cmd == "record":
    25	        return record.run(args)
    26	    if args.cmd == "decode":
    27	        return decode.run(args)
    28	    return 2
    29	
    30	
    31	if __name__ == "__main__":
    32	    raise SystemExit(main())
