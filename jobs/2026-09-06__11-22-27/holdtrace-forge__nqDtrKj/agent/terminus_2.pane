"""Generated trace reader (schema v2)."""

from __future__ import annotations

from tracekit.runtime.pack import decode_trace

MAGICS = (b"HLT1", b"HLT2")
NAME_BITS = 16


def ingest_blob(blob: bytes) -> tuple[int, str, int]:
    # Validate the complete variable-length frame before unpacking it.
    if NAME_BITS == 8:
        if len(blob) < 7:
            raise ValueError("truncated")
        name_len = blob[6]
        prefix_len = 7
    elif NAME_BITS == 16:
        if len(blob) < 8:
            raise ValueError("truncated")
        name_len = int.from_bytes(blob[6:8], "big")
        prefix_len = 8
    else:
        raise ValueError("unsupported name length width")
    if len(blob) != prefix_len + name_len + 4:
        raise ValueError("bad length")
    return decode_trace(blob, MAGICS, NAME_BITS)
--- generated writer ---
"""Generated trace writer (schema v2)."""

from __future__ import annotations

from tracekit.runtime.pack import encode_trace

MAGIC = b"HLT2"
NAME_LEN_BITS = 16


def emit_lane(lane_id: int, event: str, grams: int) -> bytes:
    return encode_trace(MAGIC, lane_id, event, grams, NAME_LEN_BITS)
