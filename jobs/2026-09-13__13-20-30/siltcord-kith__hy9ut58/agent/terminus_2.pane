[?2004l[?2004h>         let _hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;
[?2004l[?2004h>         let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;
[?2004l[?2004h>         let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;
[?2004l[?2004h>         let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;
[?2004l[?2004h>         if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }
[?2004l[?2004h>         let name = String::from_utf8(raw[i..i+nl].to_vec()).map_err(|_| 1)?; i += nl;
[?2004l[?2004h>         out.push(Rec { name, size, body });
[?2004l[?2004h>     }
[?2004l[?2004h>     if i != raw.len() { return Err(1); }
[?2004l[?2004h>     Ok(out)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> fn digest(text: &str) -> Result<String, i32> {
[?2004l[?2004h>     use std::io::Write;
[?2004l[?2004h>     let mut child = std::process::Command::new("python3")
[?2004l[?2004h>         .args(["-c", "import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())"])
[?2004l[?2004h>         .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())
[?2004l[?2004h>         .spawn().map_err(|_| 1)?;
[?2004l[?2004h>     child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;
[?2004l[?2004h>     drop(child.stdin.take());
[?2004l[?2004h>     let result = child.wait_with_output().map_err(|_| 1)?;
[?2004l[?2004h>     if !result.status.success() { return Err(1); }
[?2004l[?2004h>     let s = String::from_utf8(result.stdout).map_err(|_| 1)?.trim().to_string();
[?2004l[?2004h>     if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { return Err(1); }
[?2004l[?2004h>     Ok(s)
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> pub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {
[?2004l[?2004h>     let recs = read_idx(b)?;
[?2004l[?2004h>     let archive = std::fs::read(a).map_err(|_| 1)?;
[?2004l[?2004h>     let mut timezone = String::new();
[?2004l[?2004h>     let mut cluster = String::new();
[?2004l[?2004h>     let mut events = std::collections::BTreeSet::new();
[?2004l[?2004h>     let mut names = Vec::with_capacity(recs.len());
[?2004l[?2004h>     for r in &recs {
[?2004l[?2004h>         let start = usize::try_from(r.body).map_err(|_| 1)?;
[?2004l[?2004h>         let len = usize::try_from(r.size).map_err(|_| 1)?;
[?2004l[?2004h>         let end = start.checked_add(len).ok_or(1)?;
[?2004l[?2004h>         if end > archive.len() { return Err(1); }
[?2004l[?2004h>         let blob = &archive[start..end];
[?2004l[?2004h>         let normalized = r.name.strip_prefix("./").unwrap_or(&r.name);
[?2004l[?2004h>         if normalized == "etc/sys.conf" {
[?2004l[?2004h>             let map = crate::slate::kv::pairs(blob);
[?2004l[?2004h>             if let Some(v) = map.get("timezone") { timezone = v.clone(); }
[?2004l[?2004h>             if let Some(v) = map.get("cluster") { cluster = v.clone(); }
[?2004l[?2004h>         } else if normalized == "var/log/app.log" {
[?2004l[?2004h>             for line in String::from_utf8_lossy(blob).lines() {
[?2004l[?2004h>                 let event = line.trim();
[?2004l[?2004h>                 if !event.is_empty() { events.insert(event.to_string()); }
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>         names.push(r.name.clone());
[?2004l[?2004h>     }
[?2004l[?2004h>     let source = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();
[?2004l[?2004h>     Ok(Pack {
[?2004l[?2004h>         t: timezone,
[?2004l[?2004h>         c: cluster,
[?2004l[?2004h>         e: events.into_iter().collect(),
[?2004l[?2004h>         n: u32::try_from(recs.len()).map_err(|_| 1)?,
[?2004l[?2004h>         s: source,
[?2004l[?2004h>         w: digest(&names.join("\n"))?,
[?2004l[?2004h>     })
[?2004l[?2004h> }
