[106.719464, "i", "cat > /app/ustarwalk/hdr.rs <<'RS'\n/// A member discovered by walking a ustar stream in header/apply order.\npub struct Row {\n    pub name: String,\n    pub hdr: u64,\n    pub size: u64,\n    pub body: u64,\n    pub flag: u8,\n}\n\nfn oct_u64(buf: &[u8]) -> Result<u64, i32> {\n    let field = buf\n        .iter()\n        .copied()\n        .skip_while(|b| *b == b' ' || *b == 0)\n        .take_while(|b| *b != b' ' && *b != 0)\n        .collect::<Vec<_>>();\n    if field.is_empty() || field.iter().any(|b| !(b'0'..=b'7').contains(b)) {\n        return Err(1);\n    }\n    let mut n = 0u64;\n    for b in field {\n        n = n.checked_mul(8).and_then(|x| x.checked_add(u64::from(b - b'0'))).ok_or(1)?;\n    }\n    Ok(n)\n}\n\npub fn scan(path: &str) -> Result<Vec<Row>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 512 {\n        return Err(1);\n    }\n    let mut rows = Vec::new();\n    let mut off = 0usize;\n    let mut ended = false;\n    while off.checked_add(512).ok_or(1)? <= raw.len() {\n        let blk = &raw[off..off + 512];\n        if blk.iter().all(|b| *b == 0) {\n            ended = true;\n            break;\n        }\n        if &blk[257..262] != b\"ustar\" {\n            return Err(1);\n        }\n        let size = oct_u64(&blk[124..136])?;\n        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\n        let next = (off as u64).checked_add(512).and_then(|x| x.checked_add(padded)).ok_or(1)?;\n        if next > raw.len() as u64 {\n            return Err(1);\n        }\n        let nlen = blk[..100].iter().position(|b| *b == 0).unwrap_or(100);\n        let name = String::from_utf8(blk[..nlen].to_vec()).map_err(|_| 1)?;\n        rows.push(Row {\n            name,\n            hdr: off as u64,\n            size,\n            body: (off + 512) as u64,\n            flag: blk[156],\n        });\n        off = next as usize;\n    }\n    if !ended || rows.is_empty() {\n        return Err(1);\n    }\n    Ok(rows)\n}\nRS\ncat > /app/idxmill/shard.rs <<'RS'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) {\n        Ok(rows) => rows,\n        Err(_) => return 1,\n    };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b\"SILT1\");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let name = r.name.as_bytes();\n        if name.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(name.len() as u16).to_le_bytes());\n        out.extend_from_slice(name);\n    }\n    if let Some(parent) = std::path::Path::new(b).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    if std::fs::write(b, out).is_err() { 1 } else { 0 }\n}\nRS\ncat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let _hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }\n        let name = String::from_utf8(raw[i..i+nl].to_vec()).map_err(|_| 1)?; i += nl;\n        out.push(Rec { name, size"]
[106.71963, "i", ", body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let result = child.wait_with_output().map_err(|_| 1)?;\n    if !result.status.success() { return Err(1); }\n    let s = String::from_utf8(result.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { return Err(1); }\n    Ok(s)\n}\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    let archive = std::fs::read(a).map_err(|_| 1)?;\n    let mut timezone = String::new();\n    let mut cluster = String::new();\n    let mut events = std::collections::BTreeSet::new();\n    let mut names = Vec::with_capacity(recs.len());\n    for r in &recs {\n        let start = usize::try_from(r.body).map_err(|_| 1)?;\n        let len = usize::try_from(r.size).map_err(|_| 1)?;\n        let end = start.checked_add(len).ok_or(1)?;\n        if end > archive.len() { return Err(1); }\n        let blob = &archive[start..end];\n        let normalized = r.name.strip_prefix(\"./\").unwrap_or(&r.name);\n        if normalized == \"etc/sys.conf\" {\n            let map = crate::slate::kv::pairs(blob);\n            if let Some(v) = map.get(\"timezone\") { timezone = v.clone(); }\n            if let Some(v) = map.get(\"cluster\") { cluster = v.clone(); }\n        } else if normalized == \"var/log/app.log\" {\n            for line in String::from_utf8_lossy(blob).lines() {\n                let event = line.trim();\n                if !event.is_empty() { events.insert(event.to_string()); }\n            }\n        }\n        names.push(r.name.clone());\n    }\n    let source = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack {\n        t: timezone,\n        c: cluster,\n        e: events.into_iter().collect(),\n        n: u32::try_from(recs.len()).map_err(|_| 1)?,\n        s: source,\n        w: digest(&names.join(\"\\n\"))?,\n    })\n}\nRS\n"]
