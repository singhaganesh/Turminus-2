[31.907451, "i", "python3 - <<'PY'\nimport hashlib, json\np='/app/sealwell/kestrel.kith'\nb=open(p,'rb').read(); pos=0; regs=[]; conf={}; events=set(); allhdr=[]; zero=False\nwhile pos+512<=len(b):\n h=b[pos:pos+512]; off=pos; pos+=512\n if h==b'\\0'*512:\n  zero=True; break\n name=h[:100].split(b'\\0',1)[0].decode('utf-8','replace')\n magic=h[257:263]\n typ=h[156:157]\n raw=h[124:136].split(b'\\0',1)[0].strip(b' ')\n try: size=int(raw or b'0',8)\n except Exception: size=-1\n allhdr.append((off,name,typ.decode('latin1'),size,magic))\n if size<0 or pos+size>len(b): print('INVALID/TRUNCATED',allhdr[-1]); break\n payload=b[pos:pos+size]\n pos += (size+511)//512*512\n if typ in (b'0',b'\\0'):\n  regs.append(name)\n  norm=name[2:] if name.startswith('./') else name\n  if norm=='sys.conf':\n   for line in payload.decode('utf-8','replace').splitlines():\n    if '=' in line:\n     k,v=line.split('=',1); conf[k]=v\n  if norm=='app.log': events.update(payload.decode('utf-8','replace').splitlines())\nprint('bytes',len(b),'zero_end',zero,'end_pos',pos)\nfor row in allhdr: print(row)\nprint('regular names:',repr(regs))\nprint('conf:',conf)\nprint('events:',sorted(events))\nprint('member_count:',len(regs))\nprint('walk_sig:',hashlib.sha256(('\\n'.join(regs)).encode()).hexdigest())\nprint('source_kith:',p.rsplit('/',1)[-1])\nPY\n"]
