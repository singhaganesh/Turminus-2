[106.751872, "o", "\u001b[?2004hroot@be1cd04a9f5e:/app# "]
[106.848466, "i", "cat > /app/siltcli/quarry.rs <<'RS'\n#[path = \"../ustarwalk/hdr.rs\"]\nmod hdr;\n#[path = \"../idxmill/shard.rs\"]\nmod shard;\n\npub fn go(a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    shard::rib_a(a, b)\n}\nRS\ncat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"]\nmod blend;\n#[path = \"../logbag/write.rs\"]\nmod uni;\n#[path = \"../cfgbag/kv.rs\"]\npub(crate) mod kv;\n#[path = \"../ustarwalk/hdr.rs\"]\nmod hdr;\n#[path = \"../idxmill/shard.rs\"]\nmod shard;\n\nfn sealed(path: &str) -> bool {\n    let base = match std::fs::canonicalize(\"/app/sealwell\") { Ok(p) => p, Err(_) => return false };\n    let file = match std::fs::canonicalize(path) { Ok(p) => p, Err(_) => return false };\n    file.starts_with(base) && file.is_file()\n}\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    if !sealed(a) { return 1; }\n    if shard::rib_a(a, b) != 0 { return 1; }\n    match blend::rib_b(a, b) {\n        Ok(p) => uni::rib_c(&p, out, a),\n        Err(c) => c,\n    }\n}\nRS\npython3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")','std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\nopen(p,'w').write(s)\nPY\n/app/wick.sh\nod -An -tx1 -N4 /app/bin/siltcord\n"]
