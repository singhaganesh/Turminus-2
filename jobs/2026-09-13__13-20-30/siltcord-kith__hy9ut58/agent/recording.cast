[106.724412, "o", "    if raw.len() < 512 {\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.724488, "o", "> "]
[106.724567, "o", "        return Err(1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.724668, "o", ">     }\r\n\u001b[?2004l\r"]
[106.72474, "o", "\u001b[?2004h> "]
[106.724829, "o", "    let mut rows = Vec::new();\r\n"]
[106.72485, "o", "\u001b[?2004l\r"]
[106.724865, "o", "\u001b[?2004h> "]
[106.724974, "o", "    let mut off = 0usize;\r\n\u001b[?2004l\r"]
[106.725001, "o", "\u001b[?2004h> "]
[106.725095, "o", "    let mut ended = false;\r\n\u001b[?2004l\r"]
[106.725109, "o", "\u001b[?2004h"]
[106.725122, "o", "> "]
[106.725293, "o", "    while off.checked_add(512).ok_or(1)? <= raw.len() {\r\n\u001b[?2004l\r"]
[106.725308, "o", "\u001b[?2004h"]
[106.72532, "o", "> "]
[106.725443, "o", "        let blk = &raw[off..off + 512];\r\n\u001b[?2004l\r"]
[106.72546, "o", "\u001b[?2004h"]
[106.725472, "o", "> "]
[106.725588, "o", "        if blk.iter().all(|b| *b == 0) {\r\n\u001b[?2004l\r"]
[106.725602, "o", "\u001b[?2004h"]
[106.725615, "o", "> "]
[106.725693, "o", "            ended = true;\r\n\u001b[?2004l\r"]
[106.725707, "o", "\u001b[?2004h> "]
[106.725793, "o", "            break;\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.726174, "o", ">         }\r\n\u001b[?2004l\r = Vec::\u001b[?2004h>         if &blk[257..262] != b\"ustar\" {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.726352, "o", "            return Err(1);\r\n\u001b[?2004l\r"]
[106.726416, "o", "\u001b[?2004h> "]
[106.726466, "o", "        }\r\n\u001b[?2004l\r"]
[106.726525, "o", "\u001b[?2004h> "]
[106.726705, "o", "        let size = oct_u64(&blk[124..136])?;\r\n\u001b[?2004l\r"]
[106.726748, "o", "\u001b[?2004h> "]
[106.727083, "o", "        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\r\n\u001b[?2004l\r"]
[106.727176, "o", "\u001b[?2004h"]
[106.727262, "o", "> "]
[106.727539, "o", "        let next = (off as u64).checked_add(512).and_then(|x| x.checked_add(padded)).ok_or(1)?;\r\n\u001b[?2004l\r"]
[106.72762, "o", "\u001b[?2004h> "]
[106.727734, "o", "        if next > raw.len() as u64 {\r\n\u001b[?2004l\r"]
[106.727853, "o", "\u001b[?2004h> "]
[106.727944, "o", "            return Err(1);\r\n\u001b[?2004l\r"]
[106.728018, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[106.728079, "o", "\u001b[?2004h> "]
[106.72832, "o", "        let nlen = blk[..100].iter().position(|b| *b == 0).unwrap_or(100);\r\n\u001b[?2004l\r"]
[106.728392, "o", "\u001b[?2004h"]
[106.728457, "o", "> "]
[106.728629, "o", "        let name = String::from_utf8(blk[..nlen].to_vec()).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[106.728698, "o", "\u001b[?2004h> "]
[106.728759, "o", "        rows.push(Row {\r\n\u001b[?2004l\r"]
[106.728828, "o", "\u001b[?2004h> "]
[106.728893, "o", "            name,\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.728957, "o", "> "]
[106.729031, "o", "            hdr: off as u64,\r\n\u001b[?2004l\r"]
[106.729104, "o", "\u001b[?2004h> "]
[106.729167, "o", "            size,\r\n\u001b[?2004l\r"]
[106.729229, "o", "\u001b[?2004h> "]
[106.72936, "o", "            body: (off + 512) as u64,\r\n\u001b[?2004l\r"]
[106.729428, "o", "\u001b[?2004h> "]
[106.729516, "o", "            flag: blk[156],\r\n\u001b[?2004l\r"]
[106.729584, "o", "\u001b[?2004h> "]
[106.729678, "o", "        });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.729773, "o", "        off = next as usize;\r\n\u001b[?2004l\r"]
[106.729879, "o", "\u001b[?2004h> "]
[106.729968, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.730056, "o", "    if !ended || rows.is_empty() {\r\n\u001b[?2004l\r"]
[106.730123, "o", "\u001b[?2004h> "]
[106.730198, "o", "        return Err(1);\r\n\u001b[?2004l\r"]
[106.730262, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[106.730326, "o", "\u001b[?2004h> "]
[106.730404, "o", "    Ok(rows)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[106.730467, "o", "\u001b[?2004h> "]
[106.730528, "o", "RS\r\n\u001b[?2004l\r"]
[106.731906, "o", "\u001b[?2004hroot@be1cd04a9f5e:/app# "]
[106.732073, "o", "cat > /app/idxmill/shard.rs <<'RS'\r\n\u001b[?2004l\r"]
[106.73216, "o", "\u001b[?2004h> "]
[106.732247, "o", "use super::hdr;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[106.732317, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[106.732484, "o", "pub fn rib_a(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r"]
[106.732553, "o", "\u001b[?2004h> "]
[106.732668, "o", "    let rows = match hdr::scan(a) {\r\n\u001b[?2004l\r"]
[106.732749, "o", "\u001b[?2004h> "]
[106.732837, "o", "        Ok(rows) => rows,\r\n\u001b[?2004l\r"]
[106.732921, "o", "\u001b[?2004h"]
[106.732998, "o", ">         Err(_) => return 1,\r\n\u001b[?2004l\r"]
[106.733032, "o", "\u001b[?2004h> "]
[106.733048, "o", "    };\r\n\u001b[?2004l\r"]
[106.733064, "o", "\u001b[?2004h"]
[106.733081, "o", "> "]
[106.73343, "o", "    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\r\n\u001b[?2004l\r"]
[106.733512, "o", "\u001b[?2004h"]
[106.733602, "o", "> "]
[106.733671, "o", "    let mut out = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.733737, "o", "    out.extend_from_slice(b\"SILT1\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.733825, "o", "> "]
[106.733975, "o", "    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\r\n\u001b[?2004l\r"]
[106.734035, "o", "\u001b[?2004h> "]
[106.734101, "o", "    for r in regs {\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.734183, "o", "> "]
[106.734255, "o", "        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n\u001b[?2004l\r"]
[106.73432, "o", "\u001b[?2004h> "]
[106.734431, "o", "        out.extend_from_slice(&r.size.to_le_bytes());\r\n\u001b[?2004l\r"]
[106.734492, "o", "\u001b[?2004h> "]
[106.734614, "o", "        out.extend_from_slice(&r.body.to_le_bytes());\r\n\u001b[?2004l\r"]
[106.7347, "o", "\u001b[?2004h> "]
[106.734769, "o", "        let name = r.name.as_bytes();\r\n\u001b[?2004l\r"]
[106.7348, "o", "\u001b[?2004h> "]
[106.734954, "o", "        if name.len() > u16::MAX as usize { return 1; }\r\n\u001b[?2004l\r"]
[106.735033, "o", "\u001b[?2004h> "]
[106.735149, "o", "        out.extend_from_slice(&(name.len() as u16).to_le_bytes());\r\n\u001b[?2004l\r"]
[106.735212, "o", "\u001b[?2004h> "]
[106.735321, "o", "        out.extend_from_slice(name);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[106.735386, "o", "\u001b[?2004h> "]
[106.735511, "o", "    if let Some(parent) = std::path::Path::new(b).parent() {\r\n\u001b[?2004l\r"]
[106.735587, "o", "\u001b[?2004h> "]
[106.735752, "o", "        if std::fs::create_dir_all(parent).is_err() { return 1; }\r\n\u001b[?2004l\r"]
[106.735857, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.736024, "o", "    if std::fs::write(b, out).is_err() { 1 } else { 0 }\r\n\u001b[?2004l\r"]
[106.73636, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[106.737595, "o", "\u001b[?2004hroot@be1cd04a9f5e:/app# "]
[106.737703, "o", "cat > /app/overlaypit/blend.rs <<'RS'\r\n\u001b[?2004l\r"]
[106.737786, "o", "\u001b[?2004h> "]
[106.737847, "o", "pub struct Pack {\r\n\u001b[?2004l\r"]
[106.737906, "o", "\u001b[?2004h> "]
[106.737965, "o", "    pub t: String,\r\n\u001b[?2004l\r"]
[106.738014, "o", "\u001b[?2004h> "]
[106.738068, "o", "    pub c: String,\r\n\u001b[?2004l\r"]
[106.738153, "o", "\u001b[?2004h> "]
[106.738223, "o", "    pub e: Vec<String>,\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.738285, "o", ">     pub n: u32,\r\n\u001b[?2004l\r"]
[106.738342, "o", "\u001b[?2004h> "]
[106.7384, "o", "    pub s: String,\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.73846, "o", "> "]
[106.738523, "o", "    pub w: String,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.738581, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[106.738637, "o", "\u001b[?2004h> "]
[106.738772, "o", "struct Rec { name: String, size: u64, body: u64 }\r\n\u001b[?2004l\r"]
[106.73884, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.738991, "o", "fn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\r\n\u001b[?2004l\r"]
[106.739047, "o", "\u001b[?2004h> "]
[106.739168, "o", "    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[106.739225, "o", "\u001b[?2004h> "]
[106.739374, "o", "    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\r\n\u001b[?2004l\r"]
[106.739432, "o", "\u001b[?2004h> "]
[106.739603, "o", "    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\r\n\u001b[?2004l\r"]
[106.739658, "o", "\u001b[?2004h> "]
[106.739728, "o", "    let mut i = 9usize;\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.739837, "o", "> "]
[106.7399, "o", "    let mut out = Vec::with_capacity(n);\r\n\u001b[?2004l\r"]
[106.739919, "o", "\u001b[?2004h> "]
[106.739986, "o", "    for _ in 0..n {\r\n\u001b[?2004l\r"]
[106.740039, "o", "\u001b[?2004h"]
[106.740098, "o", "> "]
[106.740227, "o", "        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\r\n\u001b[?2004l\r"]
[106.740283, "o", "\u001b[?2004h"]
[106.740345, "o", "> "]
[106.740494, "o", "        let _hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\r\n\u001b[?2004l\r"]
[106.740553, "o", "\u001b[?2004h> "]
[106.740744, "o", "        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\r\n\u001b[?2004l\r"]
[106.740811, "o", "\u001b[?2004h> "]
[106.741013, "o", "        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\r\n\u001b[?2004l\r"]
[106.741071, "o", "\u001b[?2004h> "]
[106.741278, "o", "        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\r\n\u001b[?2004l\r"]
[106.741295, "o", "\u001b[?2004h"]
[106.741396, "o", "> "]
[106.74151, "o", "        if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }\r\n\u001b[?2004l\r"]
[106.74157, "o", "\u001b[?2004h"]
[106.741631, "o", "> "]
[106.741767, "o", "        let name = String::from_utf8(raw[i..i+nl].to_vec()).map_err(|_| 1)?; i += nl;\r\n\u001b[?2004l\r"]
[106.741847, "o", "\u001b[?2004h> "]
[106.74195, "o", "        out.push(Rec { name, size, body });\r\n\u001b[?2004l\r"]
[106.74201, "o", "\u001b[?2004h"]
[106.742079, "o", ">     }\r\n\u001b[?2004l\r"]
[106.742133, "o", "\u001b[?2004h> "]
[106.742185, "o", "    if i != raw.len() { return Err(1); }\r\n\u001b[?2004l\r"]
[106.742242, "o", "\u001b[?2004h> "]
[106.742299, "o", "    Ok(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.742357, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[106.742423, "o", "\u001b[?2004h"]
[106.742819, "o", "> fn digest(text: &str) -> Result<String, i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     use std::io::Write;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut child = std::process::Command::new(\"python3\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.743002, "o", "        .args([\"-c\", \"import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\r\n\u001b[?2004l\r"]
[106.743066, "o", "\u001b[?2004h> "]
[106.743219, "o", "        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\r\n\u001b[?2004l\r"]
[106.74328, "o", "\u001b[?2004h> "]
[106.743337, "o", "        .spawn().map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[106.743402, "o", "\u001b[?2004h> "]
[106.743577, "o", "    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[106.743656, "o", "\u001b[?2004h"]
[106.743721, "o", ">     drop(child.stdin.take());\r\n\u001b[?2004l\r"]
[106.743786, "o", "\u001b[?2004h> "]
[106.743913, "o", "    let result = child.wait_with_output().map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[106.74397, "o", "\u001b[?2004h"]
[106.744016, "o", "> "]
[106.744106, "o", "    if !result.status.success() { return Err(1); }\r\n\u001b[?2004l\r"]
[106.744191, "o", "\u001b[?2004h> "]
[106.744344, "o", "    let s = String::from_utf8(result.stdout).map_err(|_| 1)?.trim().to_string();\r\n\u001b[?2004l\r"]
[106.744419, "o", "\u001b[?2004h> "]
[106.744645, "o", "    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { return Err(1); }\r\n\u001b[?2004l\r"]
[106.744731, "o", "\u001b[?2004h> "]
[106.744814, "o", "    Ok(s)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.744842, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[106.744858, "o", "> "]
[106.745032, "o", "pub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n\u001b[?2004l\r"]
[106.745055, "o", "\u001b[?2004h> "]
[106.745173, "o", "    let recs = read_idx(b)?;\r\n\u001b[?2004l\r"]
[106.745315, "o", "\u001b[?2004h> "]
[106.745393, "o", "    let archive = std::fs::read(a).map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.745516, "o", "    let mut timezone = String::new();\r\n\u001b[?2004l\r"]
[106.745574, "o", "\u001b[?2004h> "]
[106.745674, "o", "    let mut cluster = String::new();\r\n\u001b[?2004l\r"]
[106.745771, "o", "\u001b[?2004h> "]
[106.745877, "o", "    let mut events = std::collections::BTreeSet::new();\r\n\u001b[?2004l\r"]
[106.745963, "o", "\u001b[?2004h> "]
[106.746132, "o", "    let mut names = Vec::with_capacity(recs.len());\r\n\u001b[?2004l\r"]
[106.746209, "o", "\u001b[?2004h>     for r in &recs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.746334, "o", "        let start = usize::try_from(r.body).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[106.746409, "o", "\u001b[?2004h> "]
[106.746528, "o", "        let len = usize::try_from(r.size).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[106.746614, "o", "\u001b[?2004h> "]
[106.746702, "o", "        let end = start.checked_add(len).ok_or(1)?;\r\n\u001b[?2004l\r"]
[106.746772, "o", "\u001b[?2004h> "]
[106.746897, "o", "        if end > archive.len() { return Err(1); }\r\n\u001b[?2004l\r"]
[106.746953, "o", "\u001b[?2004h> "]
[106.747052, "o", "        let blob = &archive[start..end];\r\n\u001b[?2004l\r"]
[106.747126, "o", "\u001b[?2004h> "]
[106.747265, "o", "        let normalized = r.name.strip_prefix(\"./\").unwrap_or(&r.name);\r\n\u001b[?2004l\r"]
[106.747326, "o", "\u001b[?2004h> "]
[106.7474, "o", "        if normalized == \"etc/sys.conf\" {\r\n\u001b[?2004l\r"]
[106.74746, "o", "\u001b[?2004h> "]
[106.747586, "o", "            let map = crate::slate::kv::pairs(blob);\r\n\u001b[?2004l\r"]
[106.747643, "o", "\u001b[?2004h> "]
[106.747816, "o", "            if let Some(v) = map.get(\"timezone\") { timezone = v.clone(); }\r\n\u001b[?2004l\r"]
[106.747868, "o", "\u001b[?2004h> "]
[106.748001, "o", "            if let Some(v) = map.get(\"cluster\") { cluster = v.clone(); }\r\n\u001b[?2004l\r"]
[106.748046, "o", "\u001b[?2004h> "]
[106.748141, "o", "        } else if normalized == \"var/log/app.log\" {\r\n\u001b[?2004l\r"]
[106.748187, "o", "\u001b[?2004h> "]
[106.748321, "o", "            for line in String::from_utf8_lossy(blob).lines() {\r\n\u001b[?2004l\r"]
[106.748373, "o", "\u001b[?2004h> "]
[106.748471, "o", "                let event = line.trim();\r\n\u001b[?2004l\r"]
[106.748543, "o", "\u001b[?2004h> "]
[106.748694, "o", "                if !event.is_empty() { events.insert(event.to_string()); }\r\n\u001b[?2004l\r"]
[106.74875, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[106.748823, "o", "\u001b[?2004h>         }\r\n"]
[106.748892, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[106.748951, "o", "        names.push(r.name.clone());\r\n\u001b[?2004l\r"]
[106.749015, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[106.749083, "o", "> "]
[106.749266, "o", "    let source = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\r\n\u001b[?2004l\r"]
[106.749328, "o", "\u001b[?2004h> "]
[106.749391, "o", "    Ok(Pack {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.749453, "o", "        t: timezone,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.749542, "o", "        c: cluster,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.749662, "o", "        e: events.into_iter().collect(),\r\n\u001b[?2004l\r"]
[106.749723, "o", "\u001b[?2004h> "]
[106.749858, "o", "        n: u32::try_from(recs.len()).map_err(|_| 1)?,\r\n\u001b[?2004l\r"]
[106.749923, "o", "\u001b[?2004h> "]
[106.750003, "o", "        s: source,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.750088, "o", "        w: digest(&names.join(\"\\n\"))?,\r\n\u001b[?2004l\r"]
[106.750286, "o", "\u001b[?2004h"]
