[151.670161, "i", "set +e\nok=1\nfor i in 1 2 3 4 5; do\n  rm -f /app/deskjson/READY /app/deskjson/con-a.json /app/deskjson/con-b.json\n  /app/bin/siltcord brief /app/deskjson/con-a.json & p1=$!\n  /app/bin/siltcord brief /app/deskjson/con-b.json & p2=$!\n  wait $p1; r1=$?; wait $p2; r2=$?\n  cmp -s /app/deskjson/con-a.json /app/deskjson/con-b.json; rc=$?\n  if [ \"$r1\" -ne 0 ] || [ \"$r2\" -ne 0 ] || [ \"$rc\" -ne 0 ]; then ok=0; fi\n  echo \"parallel_$i r1=$r1 r2=$r2 equal=$rc\"\ndone\necho \"parallel_ok=$ok\"\nrm -f /app/deskjson/con-a.json /app/deskjson/con-b.json\ncp /app/sealwell/kestrel.kith /app/sealwell/.bad-truncated.kith\ntruncate -s 1000 /app/sealwell/.bad-truncated.kith\n/app/bin/siltcord brief /tmp/bad.json /app/sealwell/.bad-truncated.kith; echo \"brief_truncated_rc=$? ready_exists=$(test -e /app/deskjson/READY; echo $?)\"\nrm -f /app/sealwell/.bad-truncated.kith /tmp/bad.json\nprintf 'xxxx' > /app/idxbay/members.idx\n/app/bin/siltcord quarry; qr=$?\n/app/bin/siltcord brief /app/deskjson/pass-a.json; ra=$?\n/app/bin/siltcord brief /app/deskjson/pass-b.json; rb=$?\necho \"final quarry=$qr brief_a=$ra brief_b=$rb\"\ncmp -s /app/deskjson/pass-a.json /app/deskjson/pass-b.json; echo \"final_equal=$?\"\ncat /app/deskjson/pass-a.json\nprintf 'READY='; cat /app/deskjson/READY; echo\nod -An -tx1 -N4 /app/bin/siltcord\n"]
[151.670385, "o", "set +e\r\n\u001b[?2004l\r"]
[151.670852, "o", "\u001b[?2004hroot@be1cd04a9f5e:/app# ok=1\r\n\u001b[?2004l\r\u001b[?2004hroot@be1cd04a9f5e:/app# for i in 1 2 3 4 5; do\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.671736, "o", "  rm -f /app/deskjson/READY /app/deskjson/con-a.json /app/deskjson/con-b.json\r\n\u001b[?2004l\r\u001b[?2004h>   /app/bin/siltcord brief /app/deskjson/con-a.json & p1=$!\r\n\u001b[?2004l\r\u001b[?2004h>   /app/bin/siltcord brief /app/deskjson/con-b.json & p2=$!\r\n\u001b[?2004l\r\u001b[?2004h>   wait $p1; r1=$?; wait $p2; r2=$?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[151.672883, "o", "  cmp -s /app/deskjson/con-a.json /app/deskjson/con-b.json; rc=$?\r\n\u001b[?2004l\r\u001b[?2004h>   if [ \"$r1\" -ne 0 ] || [ \"$r2\" -ne 0 ] || [ \"$rc\" -ne 0 ]; then ok=0; fi\r\n\u001b[?2004l\r\u001b[?2004h>   echo \"parallel_$i r1=$r1 r2=$r2 equal=$rc\"\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r"]
