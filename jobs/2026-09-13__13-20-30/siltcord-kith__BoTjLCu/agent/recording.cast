[26.840426, "o", "     1\t#[path = \"../overlaypit/blend.rs\"]\r\n     2\tmod blend;\r\n     3\t#[path = \"../logbag/write.rs\"]\r\n     4\tmod uni;\r\n     5\t\r\n     6\tpub fn go(out: &str, a: &str, b: &str) -> i32 {"]
[26.840459, "o", "\r\n     7\t    match blend::rib_b(a, b) {\r\n     8\t        Ok(p) => uni::rib_c(&p, out, a),\r\n     9\t        Err(c) => c,\r\n    10\t    }\r\n    11\t}\r\n"]
[26.840626, "o", "===== /app/ustarwalk/block.rs =====\r\n"]
[26.841351, "o", "     1\tpub fn span(n: u64) -> u64 {\r\n     2\t    ((n + 511) / 512) * 512\r\n     3\t}\r\n"]
[26.841504, "o", "===== /app/ustarwalk/hdr.rs =====\r\n"]
[26.842224, "o", "     1\t/// ustar headers are 512 bytes; payload is padded to that size.\r\n     2\tpub struct Row {\r\n     3\t    pub name: String,\r\n     4\t    pub hdr: u64,\r\n     5\t    pub size: u64,\r\n     6\t    pub body: u64,\r\n     7"]
[26.842245, "o", "\t    pub flag: u8,\r\n     8\t}\r\n     9\t\r\n    10\tfn oct_u64(buf: &[u8]) -> u64 {\r\n    11\t    let mut n: u64 = 0;\r\n    12\t    for &b in buf {\r\n    13\t        if b == 0 || b == b' ' {\r\n"]
[26.842364, "o", "    14\t            continue;\r\n    15\t        }\r\n    16\t        if b >= b'0' && b <= b'7' {\r\n    17\t            n = n * 8 + u64::from(b - b'0');\r\n    18\t        }\r\n    19\t"]
[26.84244, "o", "    }\r\n    20\t    n\r\n    21\t}\r\n    22\t\r\n    23\tpub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n    24\t    let raw = match std::fs::read(path) {\r\n    25\t        Ok(x) => x,\r\n    26\t        Err(_) => return Err(1),\r\n    27\t    };\r\n    28\t    if raw.len() < 512 {\r\n    29\t        return Err(1);\r\n    30\t    }\r\n    31\t    let mut rows = Vec::new();\r\n    32\t    let mut off = 0usize;\r\n    33\t    let mut saw = false;\r\n    34\t    while off + 512 <= raw.len() {\r\n    35\t        let blk = &raw[off..off + 512];\r\n    36\t        if blk.iter().all(|b| *b == 0) {\r\n    37\t            break;\r\n    38\t        }\r\n    39\t        let magic = &blk[257..262];\r\n    40\t        if magic != b\"ustar\" {\r\n    41\t            return Err(1);\r\n    42\t        }\r\n    43\t        saw = true;\r\n    44\t        let nlen = blk[0..100]\r\n    45\t            .iter()\r\n    46\t            .position(|b| *b == 0)\r\n    47\t            .unwrap_or(100);\r\n    48\t        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();\r\n    49\t        let size = oct_u64(&blk[124..136]);\r\n    50\t        let flag = blk[156];\r\n    51\t        let body = (off + 512) as u64;\r\n    52\t        rows.push(Row {\r\n    53\t            name,\r\n    54\t            hdr: off as u64,\r\n    55\t            size,\r\n    56\t            body,\r\n    57\t            flag,\r\n    58\t        });\r\n    59\t        let padded = ((size + 511) / 512) * 512;\r\n    60\t        off = off + 512 + padded as usize;\r\n    61\t    }\r\n    62\t    if !saw {\r\n    63\t        return Err(1);\r\n    64\t    }\r\n    65\t    Ok(rows)\r\n    66\t}\r\n    67\t\r\n    68\tpub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n    69\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    70\t    let s = row.body as usize;\r\n    71"]
[26.842513, "o", "\t    let e = s + row.size as usize;\r\n    72\t    if e > raw.len() {\r\n    73\t        return Err(1);\r\n    74\t    }\r\n    75\t    Ok(raw[s..e].to_vec())\r\n    76\t}\r\n"]
[26.842718, "o", "===== /app/cfgbag/alias.rs =====\r\n"]
[26.843894, "o", "     1\tpub fn fold(name: &str) -> String {\r\n     2\t    name.trim_start_matches(\"./\").to_string()\r\n     3\t}\r\n"]
[26.844095, "o", "===== /app/cfgbag/kv.rs =====\r\n"]
[26.844984, "o", "     1\tuse std::collections::BTreeMap;\r\n     2\t\r\n     3\tpub fn pairs(blob: &[u8]) -> BTreeMap<String, String> {\r\n     4\t    let mut m = BTreeMap::new();\r\n     5\t    for line in String::from_utf8_lossy(blob).lines() {\r\n     6\t        if let Some((k, v)) = line.split_once('=') {\r\n     7\t            m.insert(k.trim().to_string(), v.trim().to_string());\r\n     8\t        }\r\n     9\t    }\r\n    10\t    m\r\n    11\t}\r\n"]
[26.845183, "o", "===== /app/offseturn/rank.rs =====\r\n"]
[26.846316, "o", "     1\tpub fn by_hdr(a: u64, b: u64) -> std::cmp::Ordering {\r\n     2\t    a.cmp(&b)\r\n     3\t}\r\n"]
[26.846763, "o", "===== /app/paxcue/long.rs =====\r\n"]
[26.848177, "o", "     1\tpub fn peek(name: &str) -> bool {\r\n     2\t    name.contains(\"PaxHeaders\")\r\n     3\t}\r\n"]
[26.848499, "o", "===== /app/pidhash/seed.rs =====\r\n"]
[26.849901, "o", "     1\tpub fn mix(name: &str) -> u64 {\r\n     2\t    let mut h: u64 = 0xcbf29ce484222325;\r\n     3\t    for b in name.bytes() {\r\n     4\t        h ^= u64::from(b);\r\n     5\t        h = h.wrapping_mul(0x100000001b3);\r\n     6\t    }\r\n     7\t    h\r\n     8\t}\r\n"]
[26.850158, "o", "===== /app/keeppit/first.rs =====\r\n"]
[26.851067, "o", "     1\tpub struct Head;\r\n     2\t\r\n     3\timpl Head {\r\n     4\t    pub fn take<'a>(rows: &'a [(String, u64, Vec<u8>)]) -> Option<&'a Vec<u8>> {\r\n     5\t        rows.first().map(|r| &r.2)\r\n     6\t    }\r\n     7\t}\r\n     8\t\r\n     9\tpub fn keep_head(rows: &[(String, u64, Vec<u8>)]) -> Option<&Vec<u8>> {\r\n"]
[26.851137, "o", "    10\t    Head::take(rows)\r\n    11\t}\r\n"]
