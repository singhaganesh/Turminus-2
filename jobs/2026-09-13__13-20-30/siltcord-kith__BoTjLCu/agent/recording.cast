[108.818153, "o", "\u001b[?2004h> pub struct Row {\r\n\u001b[?2004l\r\u001b[?2004h>     pub name: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub hdr: u64,\r\n\u001b[?2004l\r\u001b[?2004h>     pub size: u64,\r\n\u001b[?2004l\r"]
[108.8184, "o", "\u001b[?2004h> "]
[108.818647, "o", "    pub body: u64,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.81892, "o", "    pub flag: u8,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.818954, "o", "\r\n\u001b[?2004l\r"]
[108.819233, "o", "\u001b[?2004h> "]
[108.820429, "o", "fn oct_u64(buf: &[u8]) -> Result<u64, i32> {"]
[108.820738, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.820847, "o", ">     let mut n = 0u64;\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.820876, "o", ">     let mut digit = false;"]
[108.820896, "o", "\r\n\u001b[?2004l\r"]
[108.822401, "o", "\u001b[?2004h>     for &b in buf {\r\n\u001b[?2004l\r\u001b[?2004h>         match b {\r\n\u001b[?2004l\r\u001b[?2004h>             b'0'..=b'7' => {\r\n\u001b[?2004l\r\u001b[?2004h>                 digit = true;\r\n\u001b[?2004l\r\u001b[?2004h>                 n = n.checked_mul(8).and_then(|x| x.checked_add(u64::from(b-b'0'))).ok_or(1)?;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             0 | b' ' => {}\r\n\u001b[?2004l\r\u001b[?2004h>             _ => return Err(1),\r\n\u001b[?2004l\r"]
[108.822436, "o", "\u001b[?2004h"]
[108.82256, "o", "> "]
[108.822794, "o", "        }\r\n\u001b[?2004l\r"]
[108.822882, "o", "\u001b[?2004h"]
[108.822916, "o", "> "]
[108.822944, "o", "    }"]
[108.823364, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if digit { Ok(n) } else { Err(1) }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.823397, "o", "> \r\n"]
[108.823553, "o", "\u001b[?2004l\r"]
[108.823661, "o", "\u001b[?2004h"]
[108.824749, "o", "> "]
[108.82534, "o", "pub fn scan(path: &str) -> Result<Vec<Row>, i32> {"]
[108.825714, "o", "\r\n\u001b[?2004l\r"]
[108.826094, "o", "\u001b[?2004h>     let raw = std::fs::read(path).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[108.82633, "o", "\u001b[?2004h"]
[108.826982, "o", ">     if raw.len() < 1024 || raw.len() % 512 != 0 { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h>     let mut rows = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.827098, "o", "    let mut off = 0usize;\r\n\u001b[?2004l\r"]
[108.827698, "o", "\u001b[?2004h>     let mut ended = false;\r\n\u001b[?2004l\r\u001b[?2004h>     while off + 512 <= raw.len() {\r\n\u001b[?2004l\r\u001b[?2004h>         let blk = &raw[off..off+512];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.827794, "o", "        if blk.iter().all(|&b| b == 0) { ended = true; break; }\r\n\u001b[?2004l\r"]
[108.827875, "o", "\u001b[?2004h> "]
[108.827972, "o", "        if &blk[257..262] != b\"ustar\" { return Err(1); }\r\n\u001b[?2004l\r"]
[108.828062, "o", "\u001b[?2004h> "]
[108.828275, "o", "        let nlen = blk[..100].iter().position(|&b| b == 0).unwrap_or(100);\r\n\u001b[?2004l\r"]
[108.828352, "o", "\u001b[?2004h> "]
[108.828462, "o", "        if nlen == 0 { return Err(1); }\r\n\u001b[?2004l\r"]
[108.828542, "o", "\u001b[?2004h> "]
[108.828729, "o", "        let name = std::str::from_utf8(&blk[..nlen]).map_err(|_| 1)?.to_string();\r\n\u001b[?2004l\r"]
[108.828809, "o", "\u001b[?2004h> "]
[108.828888, "o", "        let size = oct_u64(&blk[124..136])?;\r\n\u001b[?2004l\r"]
[108.828961, "o", "\u001b[?2004h> "]
[108.829029, "o", "        let body = off.checked_add(512).ok_or(1)?;\r\n\u001b[?2004l\r"]
[108.829091, "o", "\u001b[?2004h> "]
[108.829214, "o", "        let padded = size.checked_add(511).ok_or(1)? / 512 * 512;\r\n\u001b[?2004l\r"]
[108.829275, "o", "\u001b[?2004h> "]
[108.829453, "o", "        let next = body.checked_add(usize::try_from(padded).map_err(|_| 1)?).ok_or(1)?;\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.829528, "o", "> "]
[108.829758, "o", "        if body.checked_add(usize::try_from(size).map_err(|_| 1)?).ok_or(1)? > raw.len() || next > raw.len() {\r\n\u001b[?2004l\r"]
[108.829829, "o", "\u001b[?2004h> "]
[108.829903, "o", "            return Err(1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.829968, "o", "> "]
[108.830033, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.83023, "o", "        rows.push(Row { name, hdr: off as u64, size, body: body as u64, flag: blk[156] });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.830288, "o", "        off = next;\r\n\u001b[?2004l\r"]
[108.830351, "o", "\u001b[?2004h"]
[108.830413, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.830509, "o", "    if !ended || rows.is_empty() { return Err(1); }\r\n\u001b[?2004l\r"]
[108.830567, "o", "\u001b[?2004h> "]
[108.830641, "o", "    Ok(rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.830705, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[108.830768, "o", "> "]
[108.830888, "o", "pub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n\u001b[?2004l\r"]
[108.830945, "o", "\u001b[?2004h> "]
[108.831054, "o", "    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[108.831106, "o", "\u001b[?2004h> "]
[108.831225, "o", "    let s = usize::try_from(row.body).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[108.831281, "o", "\u001b[?2004h> "]
[108.831397, "o", "    let n = usize::try_from(row.size).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[108.831453, "o", "\u001b[?2004h> "]
[108.831539, "o", "    let e = s.checked_add(n).ok_or(1)?;\r\n\u001b[?2004l\r"]
[108.831594, "o", "\u001b[?2004h> "]
[108.8317, "o", "    if e > raw.len() { return Err(1); }\r\n\u001b[?2004l\r"]
[108.831733, "o", "\u001b[?2004h> "]
[108.831813, "o", "    Ok(raw[s..e].to_vec())\r\n\u001b[?2004l\r"]
[108.831876, "o", "\u001b[?2004h"]
[108.83194, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
