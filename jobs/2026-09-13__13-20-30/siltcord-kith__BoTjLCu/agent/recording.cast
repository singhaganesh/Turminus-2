[109.043299, "o", "> "]
[109.043395, "o", "    let s = usize::try_from(body).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[109.043503, "o", "\u001b[?2004h"]
[109.043563, "o", "> "]
[109.043589, "o", "    let n = usize::try_from(size).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[109.043603, "o", "\u001b[?2004h"]
[109.043626, "o", "> "]
[109.043766, "o", "    let e = s.checked_add(n).ok_or(1)?;\r\n\u001b[?2004l\r"]
[109.043845, "o", "\u001b[?2004h> "]
[109.043962, "o", "    if e > raw.len() { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[109.044045, "o", "> "]
[109.044132, "o", "    Ok(raw[s..e].to_vec())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.044704, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn digest(text: &str) -> Result<String, i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     use std::io::Write;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut child = std::process::Command::new(\"python3\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.044814, "o", "        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\r\n\u001b[?2004l\r"]
[109.044885, "o", "\u001b[?2004h> "]
[109.045027, "o", "        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\r\n\u001b[?2004l\r"]
[109.0451, "o", "\u001b[?2004h"]
[109.045201, "o", ">         .spawn().map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h"]
[109.045224, "o", "> "]
[109.045543, "o", "    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.045703, "o", "    drop(child.stdin.take());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.045819, "o", "    let out = child.wait_with_output().map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.045969, "o", "    if !out.status.success() { return Err(1); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[109.046054, "o", "> "]
[109.046141, "o", "    let s = String::from_utf8(out.stdout).map_err(|_| 1)?.trim().to_string();\r\n\u001b[?2004l\r"]
[109.04622, "o", "\u001b[?2004h> "]
[109.046419, "o", "    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) { return Err(1); }\r\n\u001b[?2004l\r"]
[109.046472, "o", "\u001b[?2004h> "]
[109.046518, "o", "    Ok(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[109.046557, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[109.046595, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[109.046822, "o", "> "]
[109.046852, "o", "#[path = \"../cfgbag/kv.rs\"] mod kv;\r\n\u001b[?2004l\r"]
[109.046942, "o", "\u001b[?2004h> "]
[109.047029, "o", "#[path = \"../cfgbag/alias.rs\"] mod alias;\r\n\u001b[?2004l\r"]
[109.04709, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[109.047145, "o", "\u001b[?2004h> "]
[109.047268, "o", "pub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\r\n\u001b[?2004l\r"]
[109.047321, "o", "\u001b[?2004h> "]
[109.04741, "o", "    let recs = read_idx(b)?;\r\n\u001b[?2004l\r"]
[109.047492, "o", "\u001b[?2004h> "]
[109.047545, "o", "    let mut t = String::new();\r\n\u001b[?2004l\r"]
[109.047562, "o", "\u001b[?2004h> "]
[109.047675, "o", "    let mut c = String::new();\r\n\u001b[?2004l\r"]
[109.047726, "o", "\u001b[?2004h> "]
[109.047822, "o", "    let mut events = Vec::new();\r\n\u001b[?2004l\r"]
[109.047903, "o", "\u001b[?2004h> "]
[109.048, "o", "    let mut names = Vec::with_capacity(recs.len());\r\n\u001b[?2004l\r"]
[109.048024, "o", "\u001b[?2004h"]
[109.048039, "o", "> "]
[109.04814, "o", "    for r in &recs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.048269, "o", "        names.push(r.name.clone());\r\n\u001b[?2004l\r"]
[109.048362, "o", "\u001b[?2004h> "]
[109.04844, "o", "        let blob = load(a, r.body, r.size)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.048562, "o", "        let normalized = alias::fold(&r.name);\r\n\u001b[?2004l\r"]
[109.048692, "o", "\u001b[?2004h> "]
[109.048841, "o", "        if normalized == \"etc/sys.conf\" {\r\n\u001b[?2004l\r\u001b[?2004h>             let map = kv::pairs(&blob);\r\n\u001b[?2004l\r"]
[109.048943, "o", "\u001b[?2004h> "]
[109.049691, "o", "            if let Some(v) = map.get(\"timezone\") { t = v.clone(); }\r\n\u001b[?2004l\r\u001b[?2004h>             if let Some(v) = map.get(\"cluster\") { c = v.clone(); }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         if normalized == \"var/log/app.log\" {\r\n\u001b[?2004l\r\u001b[?2004h>             for line in String::from_utf8_lossy(&blob).lines() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.049864, "o", "                let value = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.050006, "o", "                if !value.is_empty() { events.push(value.to_string()); }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.051167, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[109.051545, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     events.sort(); events.dedup();\r\n\u001b[?2004l\r\u001b[?2004h>     let source = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\r\n\u001b[?2004l\r\u001b[?2004h>     Ok(Pack { t, c, e: events, n: recs.len() as u32, s: source, w: digest(&names.join(\"\\n\"))? })\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[109.053686, "o", "\u001b[?2004hroot@ae465da64c7c:/app# "]
[109.053831, "o", "cat > /app/siltcli/slate.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.05393, "o", "#[path = \"../overlaypit/blend.rs\"] mod blend;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.054058, "o", "#[path = \"../logbag/write.rs\"] mod uni;\r\n\u001b[?2004l\r"]
[109.054101, "o", "\u001b[?2004h> "]
[109.054213, "o", "#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[109.054327, "o", "\u001b[?2004h> "]
[109.054412, "o", "fn sealed(path: &str) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.054627, "o", "    let root = match std::fs::canonicalize(\"/app/sealwell\") { Ok(x) => x, Err(_) => return false };\r\n\u001b[?2004l\r"]
[109.054669, "o", "\u001b[?2004h> "]
[109.054947, "o", "    match std::fs::canonicalize(path) { Ok(x) => x.starts_with(root) && x.is_file(), Err(_) => false }\r\n\u001b[?2004l\r"]
[109.0551, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.05524, "o", "pub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r"]
[109.055338, "o", "\u001b[?2004h> "]
[109.055419, "o", "    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[109.055458, "o", "> "]
[109.055581, "o", "    if !sealed(a) || hdr::scan(a).is_err() { return 1; }\r\n\u001b[?2004l\r"]
[109.055671, "o", "\u001b[?2004h> "]
[109.055847, "o", "    match blend::rib_b(a, b) { Ok(p) => uni::rib_c(&p, out, a), Err(c) => c }\r\n\u001b[?2004l\r"]
[109.055937, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
[109.057171, "o", "\u001b[?2004hroot@ae465da64c7c:/app# "]
[109.057322, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.057367, "o", "p='/app/logbag/write.rs'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.057649, "o", "s=open(p).read().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")','std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\r\n\u001b[?2004l\r"]
[109.057756, "o", "\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r"]
[109.057841, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[109.085896, "o", "\u001b[?2004hroot@ae465da64c7c:/app# "]
[109.19631, "i", "PATH=/usr/local/rustup/toolchains/1.85.1-x86_64-unknown-linux-gnu/bin:/usr/local/bin:/usr/bin:/bin sh /app/wick.sh\n"]
[109.196882, "o", "PATH=/usr/local/rustup/toolchains/1.85.1-x86_64-unknown-linux-gnu/bin:/usr/local/bin:/usr/bin:/bin sh /app/wick.sh\r\n\u001b[?2004l\r"]
[109.315576, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: function `load_body` is never used\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/siltcli/../ustarwalk/hdr.rs:53:8\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m53\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m        \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^^^^^^\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m   \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m= \u001b[0m\u001b[0m\u001b[1mnote\u001b[0m\u001b[0m: `#[warn(dead_code)]` on by default\u001b[0m\r\n\r\n"]
[109.317449, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: fields `name`, `hdr`, `size`, `body`, and `flag` are never read\u001b[0m\r\n\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m--> \u001b[0m\u001b[0m/app/siltcli/../ustarwalk/hdr.rs:3:9\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m2\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0mpub struct Row {\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m            \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m---\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12mfields in this struct\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m3\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m    pub name: String,\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m         \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m4\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m    pub hdr: u64,\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m         \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m5\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m    pub size: u64,\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m         \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m6\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m    pub body: u64,\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m         \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^\u001b[0m\r\n\u001b[0m\u001b[1m\u001b[38;5;12m7\u001b[0m\u001b[0m \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m \u001b[0m\u001b[0m    pub flag: u8,\u001b[0m\r\n\u001b[0m  \u001b[0m\u001b[0m\u001b[1m\u001b[38;5;12m|\u001b[0m\u001b[0m         \u001b[0m\u001b[0m\u001b[1m\u001b[33m^^^^\u001b[0m\r\n\r\n"]
[111.377933, "o", "\u001b[0m\u001b[1m\u001b[33mwarning\u001b[0m\u001b[0m\u001b[1m: 2 warnings emitted\u001b[0m\r\n\r\n"]
[111.384826, "o", "\u001b[?2004hroot@ae465da64c7c:/app# "]
[114.198687, "i", "printf 'xxxx' > /app/idxbay/members.idx; rm -f /app/deskjson/READY /app/deskjson/pass-a.json /app/deskjson/pass-b.json; /app/bin/siltcord quarry; echo quarry=$?; /app/bin/siltcord brief /app/deskjson/pass-a.json; echo a=$?; /app/bin/siltcord brief /app/deskjson/pass-b.json; echo b=$?; cat /app/deskjson/pass-a.json; cmp /app/deskjson/pass-a.json /app/deskjson/pass-b.json; echo pair_cmp=$?; printf 'READY=<'; cat /app/deskjson/READY; echo '>'; python3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path('/app/bin/siltcord').read_bytes(); print('ELF',p[:4]==b'\\x7fELF')\no=json.load(open('/app/deskjson/pass-a.json')); print(o)\nassert o == {'timezone':'America/Chicago','cluster':'alpha','log_events':['EVT_BOOT','EVT_RELOAD'],'member_count':6,'source_kith':'kestrel.kith','walk_sig':'e8c60dff99d1c59bed02f52d0215444f736284d0b7a05d1b6fc164566a787b60'}\nPY\n"]
[114.2002, "o", "printf 'xxxx' > /app/idxbay/members.idx; rm -f /app/deskjson/READY /app/deskjson/pass-a.json /app/deskjson/pass-b.json; /app/bin/siltcord quarry; echo quarry=$?; /app/bin/siltcord brief /app/deskjson/pass-a.json; echo a=$?; /app/bin/siltcord brief /app/deskjson/pass-b.json; echo b=$?; cat /app/deskjson/pass-a.json; cmp /app/deskjson/pass-a.json /app/deskjson/pass-b.json; echo pair_cmp=$?; printf 'READY=<'; cat /app/deskjson/READY; echo '>'; python3 - <<'PY'\r\n\u001b[?2004l\r"]
[114.20042, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.200547, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.200798, "o", "p=Path('/app/bin/siltcord').read_bytes(); print('ELF',p[:4]==b'\\x7fELF')\r\n\u001b[?2004l\r"]
[114.200934, "o", "\u001b[?2004h> "]
[114.201067, "o", "o=json.load(open('/app/deskjson/pass-a.json')); print(o)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.201815, "o", "assert o == {'timezone':'America/Chicago','cluster':'alpha','log_events':['EVT_BOOT','EVT_RELOAD'],'member_count':6,'source_kith':'kestrel.kith','walk_sig':'e8c60dff99d1c59bed02f52d0215444f736284d0b7a05d1b6fc164566a787b60'}\r\n\u001b[?2004l\r"]
[114.201951, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[114.204982, "o", "quarry=0\r\n"]
[114.228056, "o", "a=0\r\n"]
[114.24757, "o", "b=0\r\n"]
[114.248386, "o", "{\"timezone\":\"America/Chicago\",\"cluster\":\"alpha\",\"log_events\":[\"EVT_BOOT\",\"EVT_RELOAD\"],\"member_count\":6,\"source_kith\":\"kestrel.kith\",\"walk_sig\":\"e8c60dff99d1c59bed02f52d0215444f736284d0b7a05d1b6fc164566a787b60\"}\r\n"]
[114.250064, "o", "pair_cmp=0\r\nREADY=<"]
[114.250873, "o", "brief-ok"]
[114.251066, "o", ">\r\n"]
[114.294977, "o", "ELF True\r\n"]
