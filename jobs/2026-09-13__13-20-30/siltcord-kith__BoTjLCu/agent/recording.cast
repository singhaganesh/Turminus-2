[41.534536, "o", "     4\tmod slate;\r\n     5\t\r\n     6\tfn main() {\r\n     7\t    let mut args = std::env::args();\r\n     8\t    let _ = args.next();\r\n     9\t    let cmd = args.next().unwrap_or_default();\r\n    10\t    let code = match cmd.as_str() {\r\n    11\t        \"quarry\" => {\r\n    12\t            let a = args\r\n    13\t                .next()\r\n    14\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    15\t            let b = args\r\n    16\t                .next()\r\n    17\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    18\t            quarry::go(&a, &b)\r\n    19\t        }\r\n    20\t        \"brief\" => {\r\n    21\t            let out = match args.next() {\r\n    22\t                Some(x) => x,\r\n    23\t                None => {\r\n    24\t                    eprintln!(\"usage: siltcord brief OUT.json\");\r\n    25\t                    std::process::exit(2);\r\n    26\t                }\r\n    27\t            };\r\n    28\t            let a = args\r\n    29\t                .next()\r\n    30\t                .unwrap_or_else(|| \"/app/sealwell/kestrel.kith\".to_string());\r\n    31\t            let b = args\r\n    32\t                .next()\r\n    33\t                .unwrap_or_else(|| \"/app/idxbay/members.idx\".to_string());\r\n    34\t            slate::go(&out, &a, &b)\r\n    35\t        }\r\n    36\t        _ => {\r\n    37\t            eprintln!(\"usage: siltcord quarry|brief\");\r\n    38\t            2\r\n    39\t        }\r\n    40\t    };\r\n    41\t    std::process::exit(code);\r\n    42\t}\r\n"]
[41.535566, "o", "===== /app/siltcli/quarry.rs =====\r\n"]
[41.536967, "o", "     1\t#[path = \"../ustarwalk/hdr.rs\"]\r\n     2\tmod hdr;\r\n     3\t#[path = \"../idxmill/shard.rs\"]\r\n     4\tmod shard;\r\n     5\t\r\n     6\tpub fn go(a: &str, b: &str) -> i32 {\r\n     7\t    shard::rib_a(a, b)\r\n     8\t}\r\n"]
[41.537286, "o", "===== /app/siltcli/slate.rs =====\r\n"]
[41.538466, "o", "     1\t#[path = \"../overlaypit/blend.rs\"]\r\n     2\tmod blend;\r\n     3\t#[path = \"../logbag/write.rs\"]\r\n     4\tmod uni;\r\n     5\t\r\n     6\tpub fn go(out: &str, a: &str, b: &str) -> i32 {\r\n     7\t    match blend::rib_b(a, b) {\r\n     8\t        Ok(p) => uni::rib_c(&p, out, a),\r\n     9\t        Err(c) => c,\r\n    10\t    }\r\n    11\t}\r\n"]
[41.538734, "o", "===== /app/ustarwalk/hdr.rs =====\r\n"]
[41.539568, "o", "     1\t/// ustar headers are 512 bytes; payload is padded to that size.\r\n     2\tpub struct Row {\r\n     3\t    pub name: String,\r\n     4\t    pub hdr: u64,\r\n     5\t    pub size: u64,\r\n     6\t    pub body: u64,\r\n     7\t    pub flag: u8,\r\n     8\t"]
[41.539712, "o", "}\r\n     9\t\r\n    10\tfn oct_u64(buf: &[u8]) -> u64 {\r\n    11\t    let mut n: u64 = 0;\r\n    12\t    for &b in buf {\r\n    13\t        if b == 0 || b == b' ' {\r\n    14\t            continue;\r\n    15\t        }\r\n"]
[41.539754, "o", "    16\t        if b >= b'0' && b <= b'7' {\r\n    17\t            n = n * 8 + u64::from(b - b'0');\r\n    18\t        }\r\n    19\t    }\r\n    20\t    n\r\n    21\t}\r\n    22\t\r\n    23\tpub fn scan(path: &str) -> Result<Vec<Row>, i32> {\r\n    24\t    let raw = match std::fs::read(path) {\r\n    25\t        Ok(x) => x,\r\n    26\t        Err(_) => return Err(1),\r\n    27\t    };\r\n    28\t    if raw.len() < 512 {\r\n    29\t        return Err(1);\r\n    30\t    }\r\n    31\t    let mut rows = Vec::new();\r\n    32\t    let mut off = 0usize;\r\n    33\t    let mut saw = false;\r\n    34\t    while off + 512 <= raw.len() {\r\n    35\t        let blk = &raw[off..off + 512];\r\n    36\t        if blk.iter().all(|b| *b == 0) {\r\n    37\t            break;\r\n    38\t        }\r\n    39\t        let magic = &blk[257..262];\r\n    40\t        if magic != b\"ustar\" {\r\n    41\t            return Err(1);\r\n    42\t        }\r\n    43\t        saw = true;\r\n    44\t        let nlen = blk[0..100]\r\n    45\t            .iter()\r\n    46\t            .position(|b| *b == 0)\r\n    47\t            .unwrap_or(100);\r\n    48\t        let name = String::from_utf8_lossy(&blk[0..nlen]).to_string();\r\n    49\t        let size = oct_u64(&blk[124..136]);\r\n    50\t        let flag = blk[156];\r\n    51\t        let body = (off + 512) as u64;\r\n    52\t        rows.push(Row {\r\n    53\t            name,\r\n    54\t            hdr: off as u64,\r\n    55\t            size,\r\n    56\t            body,\r\n    57\t            flag,\r\n    58\t        });\r\n    59\t        let padded = ((size + 511) / 512) * 512;\r\n    60\t        off = off + 512 + padded as usize;\r\n    61\t    }\r\n"]
[41.539783, "o", "    62\t    if !saw {\r\n    63\t        return Err(1);\r\n    64\t    }\r\n    65\t    Ok(rows)\r\n    66\t}\r\n    67\t\r\n    68\tpub fn load_body(path: &str, row: &Row) -> Result<Vec<u8>, i32> {\r\n    69\t    let raw = std::fs::read(path).map_err(|_| 1)?;\r\n    70\t    let s = row.body as usize;\r\n    71\t    let e = s + row.size as usize;\r\n    72\t    if e > raw.len() {\r\n    73\t        return Err(1);\r\n"]
[41.53995, "o", "    74\t    }\r\n    75\t    Ok(raw[s..e].to_vec())\r\n    76\t}\r\n"]
[41.540541, "o", "===== /app/ustarwalk/block.rs =====\r\n"]
[41.541559, "o", "     1\tpub fn span(n: u64) -> u64 {\r\n     2\t    ((n + 511) / 512) * 512\r\n     3\t}\r\n"]
