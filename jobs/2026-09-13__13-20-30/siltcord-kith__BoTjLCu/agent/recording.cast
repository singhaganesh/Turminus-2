[42.522075, "o", "echo \"PATH=$PATH\"; command -v rustc || true; ls -l /root/.cargo/bin/rustc /usr/local/cargo/bin/rustc /usr/bin/rustc 2>/dev/null || true; find / -xdev -type f -name rustc -o -type l -name rustc 2>/dev/null | head -20\r\n\u001b[?2004l\r"]
