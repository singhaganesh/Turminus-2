[109.03667, "i", "cat > /app/overlaypit/blend.rs <<'RS'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b\"SILT1\" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let _hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }\n        let name = std::str::from_utf8(&raw[i..i+nl]).map_err(|_| 1)?.to_string(); i += nl;\n        out.push(Rec { name, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn load(path: &str, body: u64, size: u64) -> Result<Vec<u8>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    let s = usize::try_from(body).map_err(|_| 1)?;\n    let n = usize::try_from(size).map_err(|_| 1)?;\n    let e = s.checked_add(n).ok_or(1)?;\n    if e > raw.len() { return Err(1); }\n    Ok(raw[s..e].to_vec())\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new(\"python3\")\n        .args([\"-c\", \"import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())\"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let out = child.wait_with_output().map_err(|_| 1)?;\n    if !out.status.success() { return Err(1); }\n    let s = String::from_utf8(out.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) { return Err(1); }\n    Ok(s)\n}\n\n#[path = \"../cfgbag/kv.rs\"] mod kv;\n#[path = \"../cfgbag/alias.rs\"] mod alias;\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    let mut t = String::new();\n    let mut c = String::new();\n    let mut events = Vec::new();\n    let mut names = Vec::with_capacity(recs.len());\n    for r in &recs {\n        names.push(r.name.clone());\n        let blob = load(a, r.body, r.size)?;\n        let normalized = alias::fold(&r.name);\n        if normalized == \"etc/sys.conf\" {\n            let map = kv::pairs(&blob);\n            if let Some(v) = map.get(\"timezone\") { t = v.clone(); }\n            if let Some(v) = map.get(\"cluster\") { c = v.clone(); }\n        }\n        if normalized == \"var/log/app.log\" {\n            for line in String::from_utf8_lossy(&blob).lines() {\n                let value = line.trim();\n                if !value.is_empty() { events.push(value.to_string()); }\n            }\n        }\n    }\n    events.sort(); events.dedup();\n    let source = std::path::Path::new(a).file_name().and_then(|x| x.to_str()).ok_or(1)?.to_string();\n    Ok(Pack { t, c, e: events, n: recs.len() as u32, s: source, w: digest(&names.join(\"\\n\"))? })\n}\nRS\ncat > /app/siltcli/slate.rs <<'RS'\n#[path = \"../overlaypit/blend.rs\"] mod blend;\n#[path = \"../logbag/write.rs\"] mod uni;\n#[path = \"../ustarwalk/hdr.rs\"] mod hdr;\n\nfn sealed(path: &str) -> bool {\n    let root = match std::fs::canonicalize(\"/app/sealwell\") { Ok(x) => x, Err(_) => return false };\n    match std::fs::canonicalize(path) { Ok(x) => x.starts_with(root) && x.is_file(), Err(_) => false }\n}\n\npub fn go(out: &str, a: &str, b: &str) -> i32 {\n    let _ = std::fs::remove_file(\"/app/deskjson/READY\");\n    if !sealed(a) || hdr::scan(a).is_err() { return 1; }\n    match"]
[109.036834, "i", " blend::rib_b(a, b) { Ok(p) => uni::rib_c(&p, out, a), Err(c) => c }\n}\nRS\npython3 - <<'PY'\np='/app/logbag/write.rs'\ns=open(p).read().replace('std::fs::write(\"/app/deskjson/READY\", \"ok\\\\n\")','std::fs::write(\"/app/deskjson/READY\", \"brief-ok\")')\nopen(p,'w').write(s)\nPY\n"]
