[108.833531, "o", "cat > /app/idxmill/shard.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[108.833614, "o", "> use super::hdr;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[108.83371, "o", "\u001b[?2004h> "]
[108.833773, "o", "pub fn rib_a(a: &str, b: &str) -> i32 {\r\n\u001b[?2004l\r"]
[108.833837, "o", "\u001b[?2004h> "]
[108.833987, "o", "    let rows = match hdr::scan(a) { Ok(x) => x, Err(c) => return c };\r\n\u001b[?2004l\r"]
[108.834059, "o", "\u001b[?2004h> "]
[108.834265, "o", "    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b'0' || r.flag == 0).collect();\r\n\u001b[?2004l\r"]
[108.834352, "o", "\u001b[?2004h> "]
[108.834436, "o", "    let mut out = Vec::new();\r\n\u001b[?2004l\r"]
[108.834495, "o", "\u001b[?2004h> "]
[108.83455, "o", "    out.extend_from_slice(b\"SILT1\");\r\n\u001b[?2004l\r"]
[108.834602, "o", "\u001b[?2004h> "]
[108.834725, "o", "    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\r\n\u001b[?2004l\r"]
[108.834783, "o", "\u001b[?2004h> "]
[108.834845, "o", "    for r in regs {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.834977, "o", "        out.extend_from_slice(&r.hdr.to_le_bytes());\r\n\u001b[?2004l\r"]
[108.835043, "o", "\u001b[?2004h> "]
[108.835151, "o", "        out.extend_from_slice(&r.size.to_le_bytes());\r\n\u001b[?2004l\r"]
[108.835207, "o", "\u001b[?2004h> "]
[108.835312, "o", "        out.extend_from_slice(&r.body.to_le_bytes());\r\n\u001b[?2004l\r"]
[108.835369, "o", "\u001b[?2004h> "]
[108.835455, "o", "        let nb = r.name.as_bytes();\r\n\u001b[?2004l\r"]
[108.835512, "o", "\u001b[?2004h> "]
[108.835647, "o", "        if nb.len() > u16::MAX as usize { return 1; }\r\n\u001b[?2004l\r"]
[108.83573, "o", "\u001b[?2004h> "]
[108.835866, "o", "        out.extend_from_slice(&(nb.len() as u16).to_le_bytes());\r\n\u001b[?2004l\r"]
[108.835928, "o", "\u001b[?2004h> "]
[108.835992, "o", "        out.extend_from_slice(nb);\r\n\u001b[?2004l\r"]
[108.836103, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[108.836142, "o", "\u001b[?2004h> "]
[108.83621, "o", "    std::fs::write(b, out).map(|_| 0).unwrap_or(1)\r\n\u001b[?2004l\r"]
[108.836229, "o", "\u001b[?2004h> "]
[108.836246, "o", "}\r\n\u001b[?2004l\r"]
