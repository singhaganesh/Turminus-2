 }\n    Ok(rows)\n}\nRS\ncat > /app/idxmill/shard.rs <<\'RS\'\nuse super::hdr;\n\npub fn rib_a(a: &str, b: &str) -> i32 {\n    let rows = match hdr::scan(a) {\n        Ok(rows) => rows,\n        Err(_) => return 1,\n    };\n    let regs: Vec<&hdr::Row> = rows.iter().filter(|r| r.flag == b\'0\' || r.flag == 0).collect();\n    let mut out = Vec::new();\n    out.extend_from_slice(b"SILT1");\n    out.extend_from_slice(&(regs.len() as u32).to_le_bytes());\n    for r in regs {\n        out.extend_from_slice(&r.hdr.to_le_bytes());\n        out.extend_from_slice(&r.size.to_le_bytes());\n        out.extend_from_slice(&r.body.to_le_bytes());\n        let name = r.name.as_bytes();\n        if name.len() > u16::MAX as usize { return 1; }\n        out.extend_from_slice(&(name.len() as u16).to_le_bytes());\n        out.extend_from_slice(name);\n    }\n    if let Some(parent) = std::path::Path::new(b).parent() {\n        if std::fs::create_dir_all(parent).is_err() { return 1; }\n    }\n    if std::fs::write(b, out).is_err() { 1 } else { 0 }\n}\nRS\ncat > /app/overlaypit/blend.rs <<\'RS\'\npub struct Pack {\n    pub t: String,\n    pub c: String,\n    pub e: Vec<String>,\n    pub n: u32,\n    pub s: String,\n    pub w: String,\n}\n\nstruct Rec { name: String, size: u64, body: u64 }\n\nfn read_idx(path: &str) -> Result<Vec<Rec>, i32> {\n    let raw = std::fs::read(path).map_err(|_| 1)?;\n    if raw.len() < 9 || &raw[..5] != b"SILT1" { return Err(1); }\n    let n = u32::from_le_bytes(raw[5..9].try_into().map_err(|_| 1)?) as usize;\n    let mut i = 9usize;\n    let mut out = Vec::with_capacity(n);\n    for _ in 0..n {\n        if i.checked_add(26).ok_or(1)? > raw.len() { return Err(1); }\n        let _hdr = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let size = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let body = u64::from_le_bytes(raw[i..i+8].try_into().map_err(|_| 1)?); i += 8;\n        let nl = u16::from_le_bytes(raw[i..i+2].try_into().map_err(|_| 1)?) as usize; i += 2;\n        if i.checked_add(nl).ok_or(1)? > raw.len() { return Err(1); }\n        let name = String::from_utf8(raw[i..i+nl].to_vec()).map_err(|_| 1)?; i += nl;\n        out.push(Rec { name, size, body });\n    }\n    if i != raw.len() { return Err(1); }\n    Ok(out)\n}\n\nfn digest(text: &str) -> Result<String, i32> {\n    use std::io::Write;\n    let mut child = std::process::Command::new("python3")\n        .args(["-c", "import hashlib,sys;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())"])\n        .stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped())\n        .spawn().map_err(|_| 1)?;\n    child.stdin.as_mut().ok_or(1)?.write_all(text.as_bytes()).map_err(|_| 1)?;\n    drop(child.stdin.take());\n    let result = child.wait_with_output().map_err(|_| 1)?;\n    if !result.status.success() { return Err(1); }\n    let s = String::from_utf8(result.stdout).map_err(|_| 1)?.trim().to_string();\n    if s.len() != 64 || !s.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { return Err(1); }\n    Ok(s)\n}\n\npub fn rib_b(a: &str, b: &str) -> Result<Pack, i32> {\n    let recs = read_idx(b)?;\n    let archive = std::fs::read(a).map_err(|_| 1)?;\n    let mut timezone = String::new();\n    let mut cluster = String::new();\n    let mut events = std::collections::BTreeSet::new();\n    let mut names = Vec::with_capacity(recs.len());\n    for r in &recs {\n        let start = usize::try_from(r.body).map_err(|_| 1)?;\n        let len = usize::try_from(r.size).map_err(|_| 1)?;\n        let end = start.checked_add(len).ok_or(1)?;\n        if end > archive.len() { return Err(1); }\n        let blob = &archive[start..end];\n        let normalized = r.name.strip_prefix("./").unwrap_or(&r.name);\n        if normalized == "etc/sys.conf" {\n            let map = crate::slate::kv::pairs(blob);\n            if let Some(v) = map.get("timezone") { timezone = v.clone(); }\n            if let Some(