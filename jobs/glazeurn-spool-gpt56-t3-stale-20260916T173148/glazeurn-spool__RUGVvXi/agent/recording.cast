[24.462284, "o", "/app/bin/glazeurn pair; rc=$?; echo \"pair rc=$rc\"; cat /app/inkpit/pair.json 2>/dev/null; echo 'GUARD:'; cat /app/inkpit/GUARD 2>/dev/null\r\n\u001b[?2004l\r"]
