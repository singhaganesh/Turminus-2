[61.107598, "o", "\u001b[?2004h"]
[61.109621, "o", ">     load::step(&mut sess, &mut pool, &plan);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let frost_ids = frost.ids.borrow().clone();\r\n\u001b[?2004l\r\u001b[?2004h>     let live_ids = sess.ids.borrow().clone();\r\n\u001b[?2004l\r\u001b[?2004h>     let Some(frost_bag) = values(&frost_ids, &frost.cells) else { return 1; };\r\n\u001b[?2004l\r\u001b[?2004h>     let Some(live_bag) = values(&live_ids, &pool.cells) else { return 1; };\r\n\u001b[?2004l\r\u001b[?2004h>     if sess.flag && frost_bag == live_bag {\r\n\u001b[?2004l\r\u001b[?2004h>         return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let body = format!(\r\n\u001b[?2004l\r\u001b[?2004h>         \"{{\\\"tick\\\":{},\\\"mark\\\":{},\\\"frost_bag\\\":{},\\\"live_bag\\\":{}}}\\n\",\r\n\u001b[?2004l\r\u001b[?2004h>         sess.n0,\r\n\u001b[?2004l\r\u001b[?2004h>         sess.n1,\r\n\u001b[?2004l\r\u001b[?2004h>         pack(&frost_bag),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[61.109884, "o", "        pack(&live_bag)\r\n\u001b[?2004l\r"]
[61.11008, "o", "\u001b[?2004h> "]
[61.110253, "o", "    );"]
