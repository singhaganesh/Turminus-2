[61.119301, "o", "\u001b[?2004h> pub fn rim_c() -> i32 {\r\n\u001b[?2004l\r\u001b[?2004h>     let guard = Path::new(\"/app/inkpit/GUARD\");\r\n\u001b[?2004l\r\u001b[?2004h>     let _ = fs::remove_file(guard);\r\n\u001b[?2004l\r\u001b[?2004h>     let code = pool::dump();\r\n\u001b[?2004l\r\u001b[?2004h>     if code != 0 {\r\n\u001b[?2004l\r\u001b[?2004h>         return code;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     match fs::write(guard, \"ok\\n\") {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(()) => 0,\r\n\u001b[?2004l\r\u001b[?2004h>         Err(_) => 2,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[61.12066, "o", "\u001b[?2004hroot@94fb26e8c6f9:/app# "]
[61.594887, "i", "cat > /app/emitbay/hearth.rs <<'EOF'\nuse std::fs;\nuse std::path::Path;\n\nconst RIM: &str = include_str!(\"../foldrib/rim.rs\");\nconst POOL: &str = include_str!(\"../internpit/pool.rs\");\nconst INK: &str = include_str!(\"../restcue/ink.rs\");\nconst MAIN: &str = include_str!(\"main.rs\");\nconst BOOT: &str = include_str!(\"../steerpit/boot.rs\");\n\nfn refresh(name: &str) -> Result<(), ()> {\n    let (path, body) = match name {\n        \"foldrib\" => (\"/app/foldrib/rim.rs\", RIM),\n        \"internpit\" => (\"/app/internpit/pool.rs\", POOL),\n        \"restcue\" => (\"/app/restcue/ink.rs\", INK),\n        \"emitbay\" => (\"/app/emitbay/main.rs\", MAIN),\n        \"steerpit\" => (\"/app/steerpit/boot.rs\", BOOT),\n        _ => return Err(()),\n    };\n    fs::write(path, body).map_err(|_| ())\n}\n\npub fn rib_d() -> i32 {\n    let cards = match fs::read_dir(\"/app/daycards\") {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    for entry in cards {\n        let entry = match entry { Ok(v) => v, Err(_) => return 1 };\n        if entry.path().is_file() && fs::read_to_string(entry.path()).is_err() {\n            return 1;\n        }\n    }\n\n    let tree = match fs::read_to_string(\"/app/vatslip/TREE.txt\") {\n        Ok(v) => v,\n        Err(_) => return 1,\n    };\n    for raw in tree.lines() {\n        let name = raw.trim();\n        if !name.is_empty() && refresh(name).is_err() {\n            return 2;\n        }\n    }\n    if !Path::new(\"/app/bin\").is_dir() { return 2; }\n    0\n}\nEOF\n/app/bake.sh\nfile /app/bin/glazeurn; od -An -tx1 -N4 /app/bin/glazeurn\n"]
[61.59517, "o", "cat > /app/emitbay/hearth.rs <<'EOF'"]
