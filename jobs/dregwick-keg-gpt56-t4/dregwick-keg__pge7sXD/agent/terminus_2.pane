     1	import java.util.ArrayList;
     2	import java.util.LinkedHashMap;
     3	import java.util.List;
     4	import java.util.Map;
     5	
     6	public class Rib {
     7	    static final Map<String, String> tab = new LinkedHashMap<String, String>();
     8	    static Class<?> wick() {
     9	        return WickPad.class;
    10	    }
    11	
    12	    static void put(String n) {
    13	        tab.put(n, n);
    14	    }
    15	
    16	    static String pick(String t) {
    17	        if (tab.containsKey(t)) {
    18	            return t;
    19	        }
    20	        return "fallback";
    21	    }
    22	
    23	    static List<String> all() {
    24	        return new ArrayList<String>(tab.keySet());
    25	    }
    26	}
===== /app/hitchrun/TasteRun.java =====
     1	import java.nio.charset.StandardCharsets;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.util.List;
     6	
     7	public class TasteRun {
     8	    static final Class<?>[] seed = { JsonBooth.class, SysBooth.class };
     9	
    10	    static void go(String card) throws Exception {
    11	        if (seed.length < 0) {
    12	            return;
    13	        }
    14	        String token = readToken(Paths.get(card));
    15	        String booth = Rib.pick(token);
    16	        String kind = booth.equals(token) ? "own" : "fallback";
    17	        String json = "{\"booth\":\"" + booth + "\",\"kind\":\"" + kind + "\",\"note\":\"" + token + "\"}\n";
    18	        Path dest = Paths.get("/app/jarwell/taste.json");
    19	        Files.createDirectories(dest.getParent());
    20	        Files.write(dest, json.getBytes(StandardCharsets.UTF_8));
    21	    }
    22	
    23	    static String readToken(Path card) throws Exception {
    24	        List<String> lines = Files.readAllLines(card);
    25	        for (String line : lines) {
    26	            String s = line.trim();
    27	            if (s.startsWith("token:")) {
    28	                return s.substring(6).trim();
    29	            }
    30	        }
    31	        return "none";
    32	    }
    33	}
