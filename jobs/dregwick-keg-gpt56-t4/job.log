Sending keys: ['cat > /app/hitchrun/Rib.java <<\'EOF\'\nimport java.util.ArrayList;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\n\npublic class Rib {\n    static final Map<String, String> tab = new LinkedHashMap<String, String>();\n\n    static void put(String n) {\n        tab.put(n, n);\n    }\n\n    static String pick(String t) {\n        return tab.containsKey(t) ? t : "fallback";\n    }\n\n    static List<String> all() {\n        return new ArrayList<String>(tab.keySet());\n    }\n}\nEOF\ncat > /app/hitchrun/KnitMain.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.Set;\nimport java.util.jar.JarEntry;\nimport java.util.jar.JarOutputStream;\n\npublic class KnitMain {\n    public static void main(String[] args) throws Exception {\n        Path exploded = Paths.get("/app/blastcp");\n        Path jar = Paths.get("/app/jarwell/husk.jar");\n        Set<String> live = ReachWalk.weld_set(exploded);\n\n        // Booth classes are discovered at runtime, so they cannot be found by\n        // ordinary bytecode reachability.  The roster is the source of truth.\n        for (String line : Files.readAllLines(Paths.get("/app/desknote/NAMES.txt"))) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            String[] fields = line.split("\\\\s+");\n            if (fields.length < 2) throw new IllegalArgumentException("bad roster line: " + line);\n            Path handler = exploded.resolve(fields[1] + ".class");\n            if (!Files.isRegularFile(handler)) throw new IllegalStateException("missing handler: " + fields[1]);\n            live.add(fields[1]);\n        }\n\n        Files.createDirectories(jar.getParent());\n        Path next = jar.resolveSibling("husk.jar.next");\n        try (JarOutputStream out = new JarOutputStream(Files.newOutputStream(next))) {\n            for (String name : live) {\n                Path src = exploded.resolve(name + ".class");\n                if (!Files.isRegularFile(src)) continue;\n                out.putNextEntry(new JarEntry(name + ".class"));\n                out.write(Files.readAllBytes(src));\n                out.closeEntry();\n            }\n        }\n        Files.move(next, jar, java.nio.file.StandardCopyOption.REPLACE_EXISTING);\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<\'EOF\'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar)) return 1;\n        long cap = Long.parseLong(Files.readString(capFile).trim());\n        return Files.size(jar) <= cap ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(Paths.get("/app/jarwell/husk.jar"),\n                              Paths.get("/app/desknote/CAP.txt")));\n    }\n}\nEOF\ncat > /app/namelock/TallyGate.java <<\'EOF\'\nimport java.io.BufferedReader;\nimport java.io.InputStreamReader;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.LinkedHashSet;\nimport java.util.Set;\n\npublic class TallyGate {\n    public static int tint_span(Path roster, Path jar) throws Exception {\n        String java = Paths.get(System.getProperty("java.home"), "bin", "java").toString();\n        Process p = new ProcessBuilder(java, "-cp", jar.toString(), "Main", "booth")\n            .redirectErrorStream(true).start();\n        Set<String> live = new LinkedHashSet<String>();\n        try (BufferedReader in = new BufferedReader(new InputStreamReader(p.getInputStream()))) {\n            String line;\n            while ((line = in.readLine()) != null) live.add(line.trim());\n        }\n        if (p.waitFor() != 0) return 1;\n        for (String line : Files.readAllLines(roster)) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            String[] fields = line.split("\\\\s+");\n            if (fields.length < 2 || !live.contains(fields[0])) return 1;\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(Paths.get("/app/desknote/NAMES.txt"),\n                                  Paths.get("/app/jarwell/husk.jar")));\n    }\n}\nEOF\npython3 - <<\'PY\'\np=\'/app/brim.sh\'\ns=open(p).read()\ns=s.replace(\'mkdir -p /app/blastcp /app/jarwell /app/bin\\n\', \'mkdir -p /app/blastcp /app/jarwell /app/bin\\nrm -f /app/blastcp/*.class\\n\')\nopen(p,\'w\').write(s)\nPY\n/app/bin/dregwick knit; echo "knit_rc=$?"; stat -c \'jar_size=%s\' /app/jarwell/husk.jar\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
