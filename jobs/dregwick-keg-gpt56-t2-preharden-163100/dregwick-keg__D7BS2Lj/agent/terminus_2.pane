--- /app/hitchrun/Main.java ---
     1	import java.nio.file.DirectoryStream;
     2	import java.nio.file.Files;
     3	import java.nio.file.Path;
     4	import java.nio.file.Paths;
     5	import java.util.Collections;
     6	import java.util.jar.JarEntry;
     7	import java.util.jar.JarFile;
     8	
     9	public class Main {
    10	    public static void main(String[] args) throws Exception {
    11	        if (args.length < 1) {
    12	            System.exit(2);
    13	        }
    14	        String verb = args[0];
    15	        if ("loom".equals(verb)) {
    16	            loadExploded();
    17	            TasteRun.go(args[1]);
    18	            return;
    19	        }
    20	        if ("taste".equals(verb)) {
    21	            loadJar();
    22	            TasteRun.go(args[1]);
    23	            return;
    24	        }
    25	        if ("booth".equals(verb)) {
    26	            loadJar();
    27	            BoothRun.go();
    28	            return;
    29	        }
    30	        System.exit(2);
    31	    }
    32	
    33	    static void loadExploded() throws Exception {
    34	        Path dir = Paths.get("/app/blastcp");
    35	        try (DirectoryStream<Path> ds = Files.newDirectoryStream(dir, "*Booth.class")) {
    36	            for (Path p : ds) {
    37	                String n = p.getFileName().toString();
    38	                n = n.substring(0, n.length() - 6);
    39	                Class.forName(n);
    40	            }
    41	        }
    42	    }
    43	
    44	    static void loadJar() throws Exception {
    45	        String cp = System.getProperty("java.class.path");
    46	        Path p = Paths.get(cp.split(java.io.File.pathSeparator)[0]);
    47	        if (!Files.isRegularFile(p)) {
    48	            return;
    49	        }
    50	        try (JarFile jf = new JarFile(p.toFile())) {
    51	            for (JarEntry e : Collections.list(jf.entries())) {
    52	                String n = e.getName();
    53	                if (n.endsWith("Booth.class") && !n.contains("/")) {
    54	                    Class.forName(n.substring(0, n.length() - 6));
    55	                }
    56	            }
    57	        }
    58	    }
    59	}
