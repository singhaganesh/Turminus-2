[34.943587, "o", "     9\tmkdir -p /app/blastcp /app/jarwell /app/bin\r\n    10\tmapfile -t SRC < <(find /app/rootwalk /app/namelock /app/bytecue /app/hitchrun /app/fmtcells /app/gildbox /app/floorcue -name '*.java' | sort)\r\n    11\t\"$JAVAC\" -d /app/blastcp \"${SRC[@]}\"\r\n    12\tif [ \"${SKIP_SHRINK:-}\" = \"1\" ]; then\r\n    13\t  \"$JAVA\" -cp /app/blastcp KnitMain --all\r\n    14\telse\r\n    15\t  \"$JAVA\" -cp /app/blastcp KnitMain\r\n    16\tfi\r\n    17\ttrc=0\r\n    18\t\"$JAVA\" -cp /app/blastcp TallyGate || trc=$?\r\n    19\tcrc=0\r\n    20\t\"$JAVA\" -cp /app/blastcp CapGate || crc=$?\r\n    21\tcat > /app/bin/dregwick << 'EOF'\r\n    22\t#!/bin/bash\r\n    23\tset -euo pipefail\r\n    24\tJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\n    25\tif [ ! -x \"$JAVA\" ]; then\r\n    26\t  JAVA=java\r\n    27\tfi\r\n    28\tverb=\"${1:-}\"\r\n    29\tshift || true\r\n    30\tcase \"$verb\" in\r\n    31\t  knit)\r\n    32\t    exec /app/brim.sh\r\n    33\t    ;;\r\n    34\t  loom)\r\n    35\t    exec \"$JAVA\" -cp /app/blastcp Main loom \"$@\"\r\n    36\t    ;;\r\n    37\t  taste)\r\n    38\t    exec \"$JAVA\" -cp /app/jarwell/husk.jar Main taste \"$@\"\r\n    39\t    ;;\r\n    40\t  booth)\r\n    41\t    exec \"$JAVA\" -cp /app/jarwell/husk.jar Main booth \"$@\"\r\n    42\t    ;;\r\n    43\t  *)\r\n    44\t    exit 2\r\n    45\t    ;;\r\n    46\tesac\r\n    47\tEOF\r\n    48\tchmod +x /app/bin/dregwick /app/brim.sh\r\n    49\tif [ \"$trc\" -ne 0 ] || [ \"$crc\" -ne 0 ]; then\r\n    50\t  exit 1\r\n"]
