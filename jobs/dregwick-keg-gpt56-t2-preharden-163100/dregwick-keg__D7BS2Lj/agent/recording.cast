[79.740672, "i", "python3 - <<'PY'\np='/app/rootwalk/ReachWalk.java'\ns=open(p).read()\ns=s.replace('        q.add(\"FallBooth\");\\n', '''        q.add(\"FallBooth\");\n        Path names = Path.of(\"/app/desknote/NAMES.txt\");\n        if (Files.isRegularFile(names)) {\n            for (String line : Files.readAllLines(names)) {\n                String[] parts = line.trim().split(\"\\\\\\\\s+\");\n                if (parts.length >= 2) {\n                    q.add(parts[1]);\n                }\n            }\n        }\n''')\nopen(p,'w').write(s)\nPY\ncat > /app/namelock/TallyGate.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.util.HashSet;\nimport java.util.List;\nimport java.util.Set;\n\npublic class TallyGate {\n    public static int tint_span(Path exploded, Path names, Path jar) throws Exception {\n        if (!Files.isRegularFile(jar)) {\n            return 1;\n        }\n        String java = Paths.get(System.getProperty(\"java.home\"), \"bin\", \"java\").toString();\n        Process process = new ProcessBuilder(java, \"-cp\", jar.toString(), \"Main\", \"booth\")\n            .redirectErrorStream(true).start();\n        List<String> output = new java.io.BufferedReader(\n            new java.io.InputStreamReader(process.getInputStream()))\n            .lines().collect(java.util.stream.Collectors.toList());\n        if (process.waitFor() != 0) {\n            return 1;\n        }\n        Set<String> live = new HashSet<String>();\n        for (String line : output) {\n            live.add(line.trim());\n        }\n        for (String line : Files.readAllLines(names)) {\n            String text = line.trim();\n            if (text.isEmpty()) {\n                continue;\n            }\n            String token = text.split(\"\\\\s+\")[0];\n            if (!live.contains(token)) {\n                return 1;\n            }\n        }\n        return 0;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(tint_span(\n            Paths.get(\"/app/blastcp\"),\n            Paths.get(\"/app/desknote/NAMES.txt\"),\n            Paths.get(\"/app/jarwell/husk.jar\")));\n    }\n}\nEOF\ncat > /app/bytecue/CapGate.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\n\npublic class CapGate {\n    public static int rib_n(Path jar, Path capFile) throws Exception {\n        if (!Files.isRegularFile(jar) || !Files.isRegularFile(capFile)) {\n            return 1;\n        }\n        long ceiling = Long.parseLong(Files.readString(capFile).trim());\n        return Files.size(jar) <= ceiling ? 0 : 1;\n    }\n\n    public static void main(String[] args) throws Exception {\n        System.exit(rib_n(\n            Paths.get(\"/app/jarwell/husk.jar\"),\n            Paths.get(\"/app/desknote/CAP.txt\")));\n    }\n}\nEOF\n"]
