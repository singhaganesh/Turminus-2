[34.943962, "o", "--- /app/rootwalk/ReachWalk.java ---\r\n"]
[34.945322, "o", "     1\timport java.nio.ByteBuffer;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.util.ArrayDeque;\r\n     5\timport java.util.ArrayList;\r\n     6\timport java.util.LinkedHashSet;\r\n     7\timport java.util.List;\r\n     8\timport java.util.Set;\r\n     9\t\r\n    10\tpublic class ReachWalk {\r\n    11\t    public static Set<String> weld_set(Path a) throws Exception {\r\n    12\t        Set<String> live = new LinkedHashSet<String>();\r\n    13\t        ArrayDeque<String> q = new ArrayDeque<String>();\r\n    14\t        q.add(\"Main\");\r\n    15\t        q.add(\"TasteRun\");\r\n    16\t        q.add(\"BoothRun\");\r\n    17\t        q.add(\"KnitMain\");\r\n    18\t        q.add(\"Rib\");\r\n    19\t        q.add(\"FallBooth\");\r\n    20\t        while (!q.isEmpty()) {\r\n    21\t            String n = q.remove();\r\n    22\t            if (!live.add(n)) {\r\n"]
[34.945424, "o", "    23\t                continue;\r\n    24\t            }\r\n    25\t            Path p = a.resolve(n + \".class\");\r\n    26\t            if (!Files.isRegularFile(p)) {\r\n    27\t                continue;\r\n    28\t            }\r\n    29\t            for (String r : refs(Files.readAllBytes(p))) {\r\n    30\t                if (!live.contains(r)) {\r\n    31\t                    q.add(r);\r\n    32\t                }\r\n    33\t            }\r\n    34\t        }\r\n    35\t        return live;\r\n    36\t    }\r\n    37\t\r\n    38\t    static List<String> refs(byte[] raw) {\r\n    39\t        List<String> out = new ArrayList<String>();\r\n    40\t        if (raw.length < 10) {\r\n    41\t            return out;\r\n    42\t        }\r\n    43\t        ByteBuffer b = ByteBuffer.wrap(raw);\r\n    44\t        if (b.getInt() != 0xCAFEBABE) {\r\n    45\t            return out;\r\n    46\t        }\r\n    47\t        b.getShort();\r\n    48\t        b.getShort();\r\n    49\t        int cp = b.getShort() & 0xffff;\r\n    50\t        String[] utf = new String[cp];\r\n"]
[34.945457, "o", "    51\t        int[] cls = new int[cp];\r\n    52\t        int i = 1;\r\n    53\t        while (i < cp) {\r\n    54\t            int tag = b.get() & 0xff;\r\n    55\t            if (tag == 1) {\r\n    56\t                int n = b.getShort() & 0xffff;\r\n    57\t                byte[] u = new byte[n];\r\n"]
[34.945477, "o", "    58\t                b.get(u);\r\n    59\t                utf[i] = new String(u);\r\n    60\t            } else if (tag == 7) {\r\n    61\t                cls[i] = b.getShort() & 0xffff;\r\n"]
[34.945499, "o", "    62\t            } else if (tag == 8 || tag == 16 || tag == 19 || tag == 20) {\r\n    63\t                b.getShort();\r\n    64\t            } else if (tag == 3 || tag == 4 || tag == 9 || tag == 10 || tag == 11 || tag == 12 || tag == 17 || tag == 18) {\r\n"]
[34.945517, "o", "    65\t                b.getInt();\r\n    66\t            } else if (tag == 5 || tag == 6) {\r\n    67\t                b.getLong();\r\n    68\t                i++;\r\n    69\t            } else if (tag == 15) {\r\n"]
[34.945613, "o", "    70\t                b.get();\r\n    71\t                b.getShort();\r\n    72\t            } else {\r\n    73\t                break;\r\n    74\t            }\r\n    75\t            i++;\r\n    76\t        }\r\n    77\t        for (int c = 1; c < cp; c++) {\r\n    78\t            if (cls[c] == 0) {\r\n    79\t                continue;\r\n    80\t            }\r\n    81\t            String n = utf[cls[c]];\r\n    82\t            if (n == null || n.startsWith(\"java/\") || n.startsWith(\"javax/\") || n.contains(\"/\")) {\r\n    83\t                continue;\r\n    84\t            }\r\n    85\t            out.add(n);\r\n"]
[34.945646, "o", "    86\t        }\r\n    87\t        return out;\r\n    88\t    }\r\n    89\t}\r\n"]
[34.947284, "o", "--- /app/namelock/TallyGate.java ---\r\n"]
[34.948864, "o", "     1\timport java.nio.file.DirectoryStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\t\r\n     6\tpublic class TallyGate {\r\n     7\t    public static int tint_span(Path a, Path b, Path c) throws Exception {\r\n     8\t        int n = 0;\r\n     9\t        try (DirectoryStream<Path> ds = Files.newDirectoryStream(a, \"*.class\")) {\r\n    10\t            for (Path p : ds) {\r\n"]
[34.949157, "o", "    11\t                n++;\r\n    12\t            }\r\n    13\t        }\r\n    14\t        int r = 0;\r\n    15\t        for (String line : Files.readAllLines(b)) {\r\n    16\t            if (!line.trim().isEmpty()) {\r\n    17\t                r++;\r\n    18\t            }\r\n    19\t        }\r\n    20\t        if (n >= r) {\r\n    21\t            return 0;\r\n    22\t        }\r\n    23\t        return 1;\r\n    24\t    }\r\n    25\t\r\n    26\t    public static void main(String[] args) throws Exception {\r\n    27\t        int rc = tint_span(\r\n    28\t            Paths.get(\"/app/blastcp\"),\r\n    29\t            Paths.get(\"/app/desknote/NAMES.txt\"),\r\n    30\t            Paths.get(\"/app/jarwell/husk.jar\"));\r\n    31\t        System.exit(rc);\r\n    32\t    }\r\n    33\t}\r\n"]
[34.94947, "o", "--- /app/bytecue/CapGate.java ---\r\n"]
[34.950885, "o", "     1\timport java.io.ByteArrayOutputStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.Paths;\r\n     5\timport java.util.zip.ZipEntry;\r\n     6\timport java.util.zip.ZipInputStream;\r\n     7\timport java.util.zip.ZipOutputStream;\r\n     8\t\r\n     9\tpublic class CapGate {\r\n    10\t    public static int rib_n(Path a, Path b) throws Exception {\r\n    11\t        Path pad = Paths.get(\"/app/blastcp/HexDump.class\");\r\n    12\t        if (Files.isRegularFile(a) && Files.isRegularFile(pad)) {\r\n    13\t            ByteArrayOutputStream bos = new ByteArrayOutputStream();\r\n    14\t            try (ZipInputStream zin = new ZipInputStream(Files.newInputStream(a));\r\n    15\t                 ZipOutputStream zos = new ZipOutputStream(bos)) {\r\n"]
[34.951046, "o", "    16\t                ZipEntry e;\r\n    17\t                boolean have = false;\r\n    18\t                while ((e = zin.getNextEntry()) != null) {\r\n    19\t                    if (\"HexDump.class\".equals(e.getName())) {\r\n    20\t                        have = true;\r\n    21\t                    }\r\n    22\t                    zos.putNextEntry(new ZipEntry(e.getName()));\r\n    23\t                    zos.write(zin.readAllBytes());\r\n    24\t                    zos.closeEntry();\r\n    25\t                }\r\n    26\t                if (!have) {\r\n    27\t                    zos.putNextEntry(new ZipEntry(\"HexDump.class\"));\r\n    28\t                    zos.write(Files.readAllBytes(pad));\r\n    29\t                    zos.closeEntry();\r\n    30\t                }\r\n    31\t            }\r\n    32\t            Files.write(a, bos.toByteArray());\r\n    33\t        }\r\n    34\t        return 0;\r\n    35\t    }\r\n    36\t\r\n    37\t    public static void main(String[] args) throws Exception {\r\n    38\t        int rc = rib_n(Paths.get(\"/app/jarwell/husk.jar\"), Paths.get(\"/app/desknote/CAP.txt\"));\r\n    39\t        System.exit(rc);\r\n    40\t    }\r\n    41\t}\r\n"]
