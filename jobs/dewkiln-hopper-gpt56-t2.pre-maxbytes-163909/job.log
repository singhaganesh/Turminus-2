Sending keys: ['cat > /app/hopcue/rim.rs <<\'EOF\'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<\'EOF\'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], dest_dir: &str) -> Result<(), i32> {\n    match fs::remove_dir_all(dest_dir) {\n        Ok(()) => {}\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n        Err(_) => return Err(1),\n    }\n    fs::create_dir_all(dest_dir).map_err(|_| 1)?;\n\n    let mut ordered = files.to_vec();\n    ordered.sort_by_key(|x| x.0);\n    for (day, source) in ordered {\n        let dest = format!("{}/d{:08}.tbl", dest_dir, day);\n        fs::copy(source, dest).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/urncue/fold.rs <<\'EOF\'\n#[path = "../hopcue/rim.rs"]\nmod rim;\n#[path = "../restpit/soak.rs"]\nmod soak;\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\nfn clear_dir(path: &str) -> Result<(), i32> {\n    match fs::remove_dir_all(path) {\n        Ok(()) => {}\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n        Err(_) => return Err(1),\n    }\n    fs::create_dir_all(path).map_err(|_| 1)\n}\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n\n    let picked = rim::rim(wall, read::list("/app/daywell"));\n    clear_dir("/app/packbay/stage")?;\n    clear_dir("/app/packbay/latest")?;\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let mut packed = Vec::new();\n    let mut taken = 0i32;\n    for (day, source) in picked {\n        let text = fs::read_to_string(&source).map_err(|_| 1)?;\n        let rows = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n        let stage = format!("/app/packbay/stage/d{:08}.tbl", day);\n        fs::copy(&source, stage).map_err(|_| 1)?;\n        taken = taken.checked_add(rows).ok_or(1)?;\n        packed.push((day, source));\n    }\n    if taken == 0 {\n        clear_dir("/app/packbay/stage")?;\n        return Err(1);\n    }\n\n    soak::soak(&packed, "/app/packbay/latest")?;\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write(\n        "/app/bloturn/ledger.json",\n        format!("{{\\"taken\\":{}}}", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/millrib/gait.rs <<\'EOF\'\nuse std::fs;\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string("/app/millrib/sheet.tpl").map_err(|_| 1)?;\n    let out = tpl\n        .replace("__P__", probe)\n        .replace("__M__", &matched.to_string())\n        .replace("__T__", &taken.to_string());\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/check.json", out).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    if files.is_empty() {\n        return 1;\n    }\n\n    // This is deliberately independent of ledger/stage: the check reopens\n    // the live daywell inputs and derives its own row count from them.\n    let mut matched = 0i32;\n    let mut probe = String::new();\n    for (_, path) in files {\n        if !path.starts_with("/app/daywell/") {\n            return 1;\n        }\n        let text = match fs::read_to_string(path) {\n            Ok(text) => text,\n            Err(_) => return 1,\n        };\n        let rows = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n        matched = match matched.checked_add(rows) {\n            Some(value) => value,\n            None => return 1,\n        };\n        probe = path.clone();\n    }\n\n    if emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if matched != taken || !crate::floor::floor(taken) {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/wickmill/boot.rs <<\'EOF\'\n#[path = "../urncue/fold.rs"]\nmod fold;\n#[path = "../millrib/gait.rs"]\nmod gait;\n#[path = "../lidcue/skip.rs"]\nmod skip;\n#[path = "../corkpit/floor.rs"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != "clasp" {\n        eprintln!("usage: dewkiln clasp");\n        std::process::exit(2);\n    }\n\n    let _ = std::fs::create_dir_all("/app/bloturn");\n    let _ = std::fs::remove_file("/app/bloturn/GUARD");\n    let _ = std::fs::remove_file("/app/bloturn/ledger.json");\n    let _ = std::fs::remove_file("/app/bloturn/check.json");\n\n    let code = match fold::fold() {\n        Ok((packed, taken)) => gait::gait(taken, &packed),\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\n'] min_timeout_sec: 8.0 max_timeout_sec: 180.0
