[94.073393, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], dest_dir: &str) -> Result<(), i32> {\n    match fs::remove_dir_all(dest_dir) {\n        Ok(()) => {}\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n        Err(_) => return Err(1),\n    }\n    fs::create_dir_all(dest_dir).map_err(|_| 1)?;\n\n    let mut ordered = files.to_vec();\n    ordered.sort_by_key(|x| x.0);\n    for (day, source) in ordered {\n        let dest = format!(\"{}/d{:08}.tbl\", dest_dir, day);\n        fs::copy(source, dest).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/urncue/fold.rs <<'EOF'\n#[path = \"../hopcue/rim.rs\"]\nmod rim;\n#[path = \"../restpit/soak.rs\"]\nmod soak;\n#[path = \"../shardfold/read.rs\"]\nmod read;\n\nuse std::fs;\n\nfn clear_dir(path: &str) -> Result<(), i32> {\n    match fs::remove_dir_all(path) {\n        Ok(()) => {}\n        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\n        Err(_) => return Err(1),\n    }\n    fs::create_dir_all(path).map_err(|_| 1)\n}\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n\n    let picked = rim::rim(wall, read::list(\"/app/daywell\"));\n    clear_dir(\"/app/packbay/stage\")?;\n    clear_dir(\"/app/packbay/latest\")?;\n    if picked.is_empty() {\n        return Err(1);\n    }\n\n    let mut packed = Vec::new();\n    let mut taken = 0i32;\n    for (day, source) in picked {\n        let text = fs::read_to_string(&source).map_err(|_| 1)?;\n        let rows = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n        let stage = format!(\"/app/packbay/stage/d{:08}.tbl\", day);\n        fs::copy(&source, stage).map_err(|_| 1)?;\n        taken = taken.checked_add(rows).ok_or(1)?;\n        packed.push((day, source));\n    }\n    if taken == 0 {\n        clear_dir(\"/app/packbay/stage\")?;\n        return Err(1);\n    }\n\n    soak::soak(&packed, \"/app/packbay/latest\")?;\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\n        \"/app/bloturn/ledger.json\",\n        format!(\"{{\\\"taken\\\":{}}}\", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\n"]
[94.073727, "o", "cat > /app/hopcue/rim.rs <<'EOF'\r\n"]
