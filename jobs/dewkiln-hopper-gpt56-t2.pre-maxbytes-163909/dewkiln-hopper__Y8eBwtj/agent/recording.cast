[28.615864, "o", "total 84\r\ndrwxr-xr-x 1 root root 4096 Sep 13 10:12 .\r\ndrwxr-xr-x 1 root root 4096 Sep 13 10:42 ..\r\ndrwxr-xr-x 2 root root 4096 Sep 13 10:12 bin\r\ndrwxr-xr-x 1 root root 4096 Sep 13 10:42 bloturn\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:24 corkpit\r\n"]
[28.616009, "o", "drwxr-xr-x 2 root root 4096 Sep 13 09:23 daywell\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:23 floorcue\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:24 hopcue\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:31 lidcue\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:24 millrib\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:38 opstext\r\ndrwxr-xr-x 1 root root 4096 Sep 13 10:42 packbay\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:24 restpit\r\ndrwxr-xr-x 3 root root 4096 Sep 13 10:12 seed\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:24 shardfold\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:24 urncue\r\n-rwxrwxr-x 1 root root  202 Sep 13 09:23 wick.sh\r\ndrwxr-xr-x 2 root root 4096 Sep 13 09:24 wickmill\r\n"]
[28.616179, "o", "--- WICK ---\r\n"]
[28.617432, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/bloturn /app/packbay\r\nrustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\r\n"]
[28.617933, "o", "\u001b[?2004hroot@ef5cd9b5545f:/app# "]
[29.760275, "i", "printf '%s\\n' '--- MANIFESTS/SOURCES ---'; find /app -type f \\( -name '*.rs' -o -name 'Cargo.toml' -o -name '*.sh' \\) -print | sort; for f in $(find /app -type f \\( -name '*.rs' -o -name 'Cargo.toml' \\) | sort); do echo \"### $f\"; sed -n '1,280p' \"$f\"; done\n"]
[29.762809, "o", "printf '%s\\n' '--- MANIFESTS/SOURCES ---'; find /app -type f \\( -name '*.rs' -o -name 'Cargo.toml' -o -name '*.sh' \\) -print | sort; for f in $(find /app -type f \\( -name '*.rs' -o -name 'Cargo.toml' \\) | sort); do echo \"### $f\"; sed -n '1,280p' \"$f\"; done\r\n\u001b[?2004l\r--- MANIFESTS/SOURCES ---\r\n"]
[29.766343, "o", "/app/corkpit/floor.rs\r\n/app/hopcue/rim.rs\r\n/app/lidcue/skip.rs\r\n/app/millrib/gait.rs\r\n/app/restpit/soak.rs\r\n/app/shardfold/read.rs\r\n/app/urncue/fold.rs\r\n/app/wick.sh\r\n/app/wickmill/boot.rs\r\n"]
[29.77143, "o", "### /app/corkpit/floor.rs\r\n"]
[29.773574, "o", "use std::fs;\r\n\r\npub fn floor(a: i32) -> bool {\r\n    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n        Err(_) => 0,\r\n    };\r\n    a >= t\r\n}\r\n"]
[29.77486, "o", "### /app/hopcue/rim.rs\r\n"]
[29.778029, "o", "pub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n    b.into_iter().filter(|(d, _)| *d < a).collect()\r\n}\r\n"]
[29.782711, "o", "### /app/lidcue/skip.rs\r\n"]
[29.783535, "o", "pub fn skip(a: &mut [(i32, String)]) {\r\n    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n}\r\n\r\npub fn width(a: &[(i32, String)]) -> usize {\r\n    a.len()\r\n}\r\n\r\npub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    a.first().map(|x| x.0)\r\n}\r\n"]
[29.783934, "o", "### /app/millrib/gait.rs\r\n"]
[29.785547, "o", "use std::fs;\r\n\r\nfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\r\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n    let out = tpl\r\n        .replace(\"__P__\", p)\r\n        .replace(\"__M__\", &m.to_string())\r\n        .replace(\"__T__\", &t.to_string());\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)?;\r\n    Ok(())\r\n}\r\n"]
[29.785769, "o", "\r\npub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {\r\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n    if emit(\"ledger\", a, a).is_err() {\r\n        return 1;\r\n    }\r\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n        return 1;\r\n    }\r\n    0\r\n}\r\n"]
[29.786106, "o", "### /app/restpit/soak.rs\r\n"]
[29.78784, "o", "use std::fs;\r\n\r\npub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n    let _ = fs::remove_dir_all(b);\r\n    fs::create_dir_all(b).map_err(|_| 1)?;\r\n    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n    xs.sort_by_key(|x| x.0);\r\n    if !xs.is_empty() {\r\n        xs.pop();\r\n    }\r\n    for (d, p) in xs {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    }\r\n    Ok(())\r\n}\r\n"]
[29.788125, "o", "### /app/shardfold/read.rs\r\n"]
[29.790217, "o", "use std::fs;\r\n\r\npub fn list(root: &str) -> Vec<(i32, String)> {\r\n    let mut v = Vec::new();\r\n    let rd = match fs::read_dir(root) {\r\n        Ok(x) => x,\r\n        Err(_) => return v,\r\n    };\r\n    for ent in rd.flatten() {\r\n        let name = ent.file_name().to_string_lossy().into_owned();\r\n        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n            continue;\r\n        }\r\n        let mid = &name[1..name.len() - 4];\r\n        if let Ok(d) = mid.parse::<i32>() {\r\n            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n        }\r\n    }\r\n    v.sort_by_key(|x| x.0);\r\n    v\r\n}\r\n\r\npub fn nlines(path: &str) -> i32 {\r\n    match fs::read_to_string(path) {\r\n        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n        Err(_) => 0,\r\n    }\r\n}\r\n"]
[29.791691, "o", "### /app/urncue/fold.rs\r\n"]
[29.794797, "o", "#[path = \"../hopcue/rim.rs\"]\r\nmod rim;\r\n#[path = \"../restpit/soak.rs\"]\r\nmod soak;\r\n#[path = \"../shardfold/read.rs\"]\r\nmod read;\r\n\r\nuse std::fs;\r\n\r\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n        .map_err(|_| 1)?\r\n        .trim()\r\n        .parse()\r\n"]
[29.795019, "o", "        .map_err(|_| 1)?;\r\n    let listed = read::list(\"/app/daywell\");\r\n    let picked = rim::rim(wall, listed);\r\n    if picked.is_empty() {\r\n        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n        return Ok((Vec::new(), 0));\r\n    }\r\n    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    let mut packed = Vec::new();\r\n    let mut taken = 0;\r\n    for (d, p) in picked {\r\n        let name = format!(\"d{:08}.tbl\", d);\r\n        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n        taken += read::nlines(&dest);\r\n        packed.push((d, dest));\r\n    }\r\n    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    Ok((packed, taken))\r\n}\r\n"]
[29.795487, "o", "### /app/wickmill/boot.rs\r\n"]
[29.797657, "o", "#[path = \"../urncue/fold.rs\"]\r\nmod fold;\r\n#[path = \"../millrib/gait.rs\"]\r\nmod gait;\r\n#[path = \"../lidcue/skip.rs\"]\r\nmod skip;\r\n#[path = \"../corkpit/floor.rs\"]\r\nmod floor;\r\n\r\nfn main() {\r\n    let mut args = std::env::args();\r\n    let _ = args.next();\r\n    let cmd = args.next().unwrap_or_default();\r\n    if cmd != \"clasp\" {\r\n        eprintln!(\"usage: dewkiln clasp\");\r\n        std::process::exit(2);\r\n    }\r\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    let code = match fold::fold() {\r\n        Ok((packed, taken)) => {\r\n            let mut dump = packed.clone();\r\n            skip::skip(&mut dump);\r\n            let _ = floor::floor(taken);\r\n            gait::gait(taken, &packed)\r\n        }\r\n        Err(c) => c,\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[29.798175, "o", "\u001b[?2004hroot@ef5cd9b5545f:/app# "]
[31.637458, "i", "printf '%s\\n' '--- SEEDS ---'; find /app/seed -maxdepth 3 -type f -printf '%p (%s bytes, %f)\\n' -exec sh -c 'wc -l \"$1\"; sed -n \"1,30p\" \"$1\"' _ {} \\; 2>/dev/null; printf '%s\\n' '--- ELF/LINKAGE ---'; file /app/bin/dewkiln; ldd /app/bin/dewkiln 2>/dev/null; strings /app/bin/dewkiln | grep -E '/app/|ledger|check|daywell|packbay|GUARD|probe' | head -100\n"]
