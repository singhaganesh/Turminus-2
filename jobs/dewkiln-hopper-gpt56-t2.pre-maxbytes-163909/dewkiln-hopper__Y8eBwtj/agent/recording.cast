[94.083516, "o", "#[path = \"../shardfold/read.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> mod read;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.083603, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.085396, "o", "use std::fs;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn clear_dir(path: &str) -> Result<(), i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     match fs::remove_dir_all(path) {\r\n\u001b[?2004l\r\u001b[?2004h>         Ok(()) => {}\r\n\u001b[?2004l\r\u001b[?2004h>         Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}\r\n\u001b[?2004l\r\u001b[?2004h>         Err(_) => return Err(1),\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     fs::create_dir_all(path).map_err(|_| 1)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n\u001b[?2004l\r\u001b[?2004h>     let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n\u001b[?2004l\r\u001b[?2004h>         .map_err(|_| 1)?\r\n\u001b[?2004l\r\u001b[?2004h>         .trim()\r\n\u001b[?2004l\r\u001b[?2004h>         .parse()\r\n\u001b[?2004l\r\u001b[?2004h>         .map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let picked = rim::rim(wall, read::list(\"/app/daywell\"));\r\n\u001b[?2004l\r\u001b[?2004h>     clear_dir(\"/app/packbay/stage\")?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.085557, "o", "    clear_dir(\"/app/packbay/latest\")?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.085644, "o", "    if picked.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.085747, "o", "        return Err(1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.085814, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[94.085881, "o", "\u001b[?2004h> "]
[94.085949, "o", "    let mut packed = Vec::new();\r\n\u001b[?2004l\r"]
[94.086004, "o", "\u001b[?2004h> "]
[94.086062, "o", "    let mut taken = 0i32;\r\n\u001b[?2004l\r"]
[94.086107, "o", "\u001b[?2004h> "]
[94.086205, "o", "    for (day, source) in picked {\r\n\u001b[?2004l\r"]
[94.086322, "o", "\u001b[?2004h> "]
[94.086444, "o", "        let text = fs::read_to_string(&source).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[94.086497, "o", "\u001b[?2004h> "]
[94.086759, "o", "        let rows = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\r\n\u001b[?2004l\r"]
[94.086862, "o", "\u001b[?2004h> "]
[94.087035, "o", "        let stage = format!(\"/app/packbay/stage/d{:08}.tbl\", day);\r\n\u001b[?2004l\r"]
[94.087124, "o", "\u001b[?2004h> "]
[94.08723, "o", "        fs::copy(&source, stage).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[94.087286, "o", "\u001b[?2004h> "]
[94.087473, "o", "        taken = taken.checked_add(rows).ok_or(1)?;\r\n\u001b[?2004l\r"]
[94.087547, "o", "\u001b[?2004h> "]
[94.087654, "o", "        packed.push((day, source));\r\n\u001b[?2004l\r\u001b[?2004h"]
[94.087729, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.08781, "o", "    if taken == 0 {\r\n\u001b[?2004l\r"]
[94.08787, "o", "\u001b[?2004h> "]
[94.087963, "o", "        clear_dir(\"/app/packbay/stage\")?;\r\n\u001b[?2004l\r"]
[94.088019, "o", "\u001b[?2004h> "]
[94.088073, "o", "        return Err(1);\r\n\u001b[?2004l\r"]
[94.088228, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.088319, "o", "    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n\u001b[?2004l\r"]
[94.088402, "o", "\u001b[?2004h> "]
[94.088501, "o", "    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[94.088585, "o", "\u001b[?2004h> "]
[94.088658, "o", "    fs::write(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.088727, "o", "        \"/app/bloturn/ledger.json\",\r\n\u001b[?2004l\r"]
[94.088791, "o", "\u001b[?2004h> "]
[94.088898, "o", "        format!(\"{{\\\"taken\\\":{}}}\", taken),\r\n\u001b[?2004l\r"]
[94.088963, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[94.089017, "o", "\u001b[?2004h> "]
[94.08911, "o", "    .map_err(|_| 1)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[94.089193, "o", "    Ok((packed, taken))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[94.089423, "o", "\u001b[?2004l\r"]
[94.089525, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[94.091162, "o", "\u001b[?2004hroot@ef5cd9b5545f:/app# "]
[94.281371, "i", "cat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let out = tpl\n        .replace(\"__P__\", probe)\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)\n}\n\npub fn gait(taken: i32, files: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    if files.is_empty() {\n        return 1;\n    }\n\n    // This is deliberately independent of ledger/stage: the check reopens\n    // the live daywell inputs and derives its own row count from them.\n    let mut matched = 0i32;\n    let mut probe = String::new();\n    for (_, path) in files {\n        if !path.starts_with(\"/app/daywell/\") {\n            return 1;\n        }\n        let text = match fs::read_to_string(path) {\n            Ok(text) => text,\n            Err(_) => return 1,\n        };\n        let rows = text.lines().filter(|line| !line.trim().is_empty()).count() as i32;\n        matched = match matched.checked_add(rows) {\n            Some(value) => value,\n            None => return 1,\n        };\n        probe = path.clone();\n    }\n\n    if emit(&probe, matched, taken).is_err() {\n        return 1;\n    }\n    if matched != taken || !crate::floor::floor(taken) {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\ncat > /app/wickmill/boot.rs <<'EOF'\n#[path = \"../urncue/fold.rs\"]\nmod fold;\n#[path = \"../millrib/gait.rs\"]\nmod gait;\n#[path = \"../lidcue/skip.rs\"]\nmod skip;\n#[path = \"../corkpit/floor.rs\"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != \"clasp\" {\n        eprintln!(\"usage: dewkiln clasp\");\n        std::process::exit(2);\n    }\n\n    let _ = std::fs::create_dir_all(\"/app/bloturn\");\n    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\n    let _ = std::fs::remove_file(\"/app/bloturn/ledger.json\");\n    let _ = std::fs::remove_file(\"/app/bloturn/check.json\");\n\n    let code = match fold::fold() {\n        Ok((packed, taken)) => gait::gait(taken, &packed),\n        Err(code) => code,\n    };\n    std::process::exit(code);\n}\nEOF\n/app/wick.sh\n"]
