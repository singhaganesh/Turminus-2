[94.07453, "o", "    files.into_iter().filter(|(day, _)| *day <= wall).collect()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
