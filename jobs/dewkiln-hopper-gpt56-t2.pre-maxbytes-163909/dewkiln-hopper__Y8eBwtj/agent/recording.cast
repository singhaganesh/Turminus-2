[133.785988, "i", "echo '--- FLOOR TEST ---'; oldmin=$(cat /app/floorcue/MIN.txt); printf '23\\n' > /app/floorcue/MIN.txt; /app/bin/dewkiln clasp; rc=$?; echo \"floor-test rc=$rc\"; test \"$rc\" -ne 0; test ! -e /app/bloturn/GUARD; printf '%s\\n' \"$oldmin\" > /app/floorcue/MIN.txt; echo 'floor enforcement: PASS'; echo '--- FINAL RUN ---'; /app/bin/dewkiln clasp; rc=$?; echo \"final rc=$rc\"; test \"$rc\" -eq 0; test \"$(cat /app/bloturn/GUARD)\" = ok; test \"$(od -An -tx1 -N4 /app/bin/dewkiln | tr -d ' \\n')\" = 7f454c46; echo \"ledger=$(cat /app/bloturn/ledger.json)\"; echo \"check=$(cat /app/bloturn/check.json)\"; wall=$(cat /app/opstext/WALL); direct=0; restored=0; for f in /app/daywell/d*.tbl; do day=${f##*/d}; day=${day%.tbl}; if [ \"$day\" -le \"$wall\" ]; then rows=$(grep -cve '^[[:space:]]*$' \"$f\"); direct=$((direct+rows)); out=/app/packbay/latest/${f##*/}; test -f \"$out\"; cmp -s \"$f\" \"$out\"; restored=$((restored+$(grep -cve '^[[:space:]]*$' \"$out\"))); fi; done; echo \"daywell_count=$direct restored_count=$restored\"; test \"$direct\" -eq \"$restored\"; test \"$direct\" -eq 22; grep -Eq '^\\{\"probe\":\"/app/daywell/d[0-9]{8}\\.tbl\",\"matched\":[0-9]+,\"taken\":[0-9]+\\}$' /app/bloturn/check.json; echo 'FINAL VALIDATION PASS'\n"]
