[102.356521, "i", "echo '--- NORMAL TEST ---'; /app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; file /app/bin/dewkiln; echo '--- artifacts ---'; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do printf '%s: ' \"$f\"; cat \"$f\" 2>/dev/null || echo ABSENT; echo; done; echo '--- latest ---'; find /app/packbay/latest -maxdepth 1 -type f -printf '%f ' -exec sh -c 'wc -l < \"$1\"' _ {} \\; | sort; echo '--- direct versus latest eligible counts ---'; wall=$(cat /app/opstext/WALL); direct=0; latest=0; for f in /app/daywell/d*.tbl; do n=${f##*/d}; n=${n%.tbl}; if [ \"$n\" -le \"$wall\" ]; then c=$(grep -cve '^[[:space:]]*$' \"$f\"); direct=$((direct+c)); out=/app/packbay/latest/${f##*/}; [ -f \"$out\" ] || { echo \"MISSING ${f##*/}\"; continue; }; latest=$((latest+$(grep -cve '^[[:space:]]*$' \"$out\"))); cmp -s \"$f\" \"$out\" || echo \"DIFF ${f##*/}\"; fi; done; echo \"direct=$direct latest=$latest\"; test \"$rc\" -eq 0; test \"$(cat /app/bloturn/GUARD)\" = ok; test \"$direct\" -eq \"$latest\"; test ! -e /app/packbay/latest/d20260914.tbl\n"]
