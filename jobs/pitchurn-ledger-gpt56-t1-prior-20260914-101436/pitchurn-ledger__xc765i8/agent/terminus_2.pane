mkdir -p /app/deskbin/gen /app/bin /app/urnbay/hot /app/urnbay/cold /app/urnbay/keep /app/urnbay/marks
"$JAVAC" -d /app/deskbin /app/oxemit/RibGen.java /app/nincut/VatGen.java /app/coldrib/DuskGen.java
