import java.io.*;
public class DuskGen {
  public static void main(String[] a) throws Exception {
    File d = new File("/app/deskbin/gen");
    d.mkdirs();
    PrintWriter w = new PrintWriter(new FileWriter(new File(d, "Span.java")));
    loom(w);
    w.close();
  }
  public static void loom(PrintWriter a) throws Exception {
    a.println("import java.nio.file.*;");
    a.println("import java.util.*;");
    a.println("public class Span {");
    a.println("  public static void merge() throws Exception {");
    a.println("    Path live = Paths.get(\"/app/urnbay/idx.tsv\");");
    a.println("    Path hot = Paths.get(\"/app/urnbay/hot/idx.tsv\");");
    a.println("    StringBuilder sb = new StringBuilder();");
    a.println("    if (Files.exists(live)) sb.append(Files.readString(live));");
    a.println("    if (Files.exists(hot)) sb.append(Files.readString(hot));");
    a.println("    Files.writeString(live, sb.toString());");
    a.println("    System.out.println(\"walked\");");
    a.println("  }");
    a.println("}");
  }
}
--- GENERATED SPAN ---
import java.nio.file.*;
import java.util.*;
public class Span {
  public static void merge() throws Exception {
    Path live = Paths.get("/app/urnbay/idx.tsv");
    Path hot = Paths.get("/app/urnbay/hot/idx.tsv");
    StringBuilder sb = new StringBuilder();
    if (Files.exists(live)) sb.append(Files.readString(live));
    if (Files.exists(hot)) sb.append(Files.readString(hot));
    Files.writeString(live, sb.toString());
    System.out.println("walked");
  }
}
