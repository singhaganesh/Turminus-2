[67.851556, "i", "python3 - <<'PY'\np='/app/hitchcli/Idx.java'\ns=open(p).read()\ns=s.replace('    add(m, \"/app/urnbay/idx.tsv\");\\n    add(m, \"/app/urnbay/keep/idx.tsv\");\\n    add(m, \"/app/urnbay/hot/idx.tsv\");', '    add(m, \"/app/urnbay/idx.tsv\");\\n    add(m, \"/app/urnbay/cold/idx.tsv\");\\n    add(m, \"/app/urnbay/keep/idx.tsv\");\\n    add(m, \"/app/urnbay/hot/idx.tsv\");')\nopen(p,'w').write(s)\nPY\ncat > /app/coldrib/DuskGen.java <<'EOF'\nimport java.io.*;\npublic class DuskGen {\n  public static void main(String[] a) throws Exception {\n    File d = new File(\"/app/deskbin/gen\");\n    d.mkdirs();\n    try (PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")))) { loom(w); }\n  }\n  public static void loom(PrintWriter a) {\n    a.print(\"\"\"\nimport java.nio.file.*;\nimport java.util.*;\npublic class Span {\n  public static void merge() throws Exception {\n    Path root = Paths.get(\"/app/urnbay\");\n    Path hot = root.resolve(\"hot\");\n    Path marks = root.resolve(\"marks\");\n    Files.createDirectories(hot);\n    Files.createDirectories(marks);\n\n    Map<String,String> idx = Idx.load();\n    Gear gear = Gear.load(\"/app/gearpit/live.gear\");\n    List<Path> manifests = new ArrayList<>();\n    try (DirectoryStream<Path> ds = Files.newDirectoryStream(marks, \"*.m\")) {\n      for (Path p : ds) manifests.add(p);\n    }\n    Collections.sort(manifests);\n\n    for (Path manifest : manifests) {\n      java.io.ByteArrayOutputStream reel = new java.io.ByteArrayOutputStream();\n      for (String line : Files.readAllLines(manifest)) {\n        String key = line.trim();\n        if (key.isEmpty()) continue;\n        String rel = idx.get(key);\n        if (rel == null || !Files.exists(root.resolve(rel)))\n          throw new java.io.IOException(\"missing silo piece \" + key);\n        reel.write(Files.readAllBytes(root.resolve(rel)));\n      }\n\n      StringBuilder next = new StringBuilder();\n      for (byte[] piece : Slice.cut(reel.toByteArray(), gear.mask, gear.min, gear.max)) {\n        String key = Seal.pay(piece);\n        String rel = idx.get(key);\n        if (rel == null || !Files.exists(root.resolve(rel))) {\n          rel = \"hot/\" + key + \".blob\";\n          Files.write(root.resolve(rel), piece);\n          idx.put(key, rel);\n        }\n        next.append(key).append('\\n');\n      }\n      Files.writeString(manifest, next.toString());\n    }\n\n    StringBuilder table = new StringBuilder();\n    for (Map.Entry<String,String> e : idx.entrySet()) {\n      if (Files.exists(root.resolve(e.getValue())))\n        table.append(e.getKey()).append('\\t').append(e.getValue()).append('\\n');\n    }\n    Files.writeString(root.resolve(\"idx.tsv\"), table.toString());\n    System.out.println(\"walked\");\n  }\n}\n\"\"\");\n  }\n}\nEOF\n/app/kiln.sh\n"]
