[18.968819, "i", "printf '%s\\n' '--- ROOT INDEX HEAD ---'; head -20 /app/urnbay/idx.tsv; printf '%s\\n' '--- SUB INDEX COUNTS ---'; wc -l /app/urnbay/{idx.tsv,cold/idx.tsv,hot/idx.tsv,keep/idx.tsv}; printf '%s\\n' '--- MANIFESTS ---'; for f in /app/urnbay/marks/*.m; do echo \"== $f\"; cat \"$f\"; done; printf '%s\\n' '--- COMMAND PROBES ---'; /app/bin/pitchurn 2>&1 || true; /app/bin/pitchurn census 2>&1 || true\n"]
