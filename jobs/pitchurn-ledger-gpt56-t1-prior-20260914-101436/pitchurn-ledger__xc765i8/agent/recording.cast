[71.891391, "i", "set -e; for f in /app/filmwelle/stable.bin /app/filmwelle/plain.bin /app/filmwelle/brine.bin; do n=$(basename \"$f\"); echo \"--- stow $n ---\"; /app/bin/pitchurn stow \"$f\"; cat /app/urnbay/tally.json; /app/bin/pitchurn draw \"/app/urnbay/$n.out\" \"$f\"; cmp \"$f\" \"/app/urnbay/$n.out\"; done; echo ALL_DRAWS_MATCH\n"]
