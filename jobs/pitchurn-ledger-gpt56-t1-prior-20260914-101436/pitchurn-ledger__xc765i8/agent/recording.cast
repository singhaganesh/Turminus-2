[42.786995, "i", "echo '--- BYTE/FILE IDENTITY ---'; sha256sum /app/filmwelle/*.bin; for n in stable plain brine; do printf \"$n manifest bytes: \"; while read k; do p=$(awk -F '\\t' -v k=\"$k\" '$1==k{print $2;exit}' /app/seed/urnbay/{idx.tsv,cold/idx.tsv,hot/idx.tsv,keep/idx.tsv); stat -c %s \"/app/seed/urnbay/$p\"; done < \"/app/seed/urnbay/marks/$n.bin.m\" | awk '{s+=$1}END{print s}'; done\n"]
[42.788292, "o", "echo '--- BYTE/FILE IDENTITY ---'; sha256sum /app/filmwelle/*.bin; for n in stable plain brine; do printf \"$n manifest bytes: \"; while read k; do p=$(awk -F '\\t' -v k=\"$k\" '$1==k{print $2;exit}' /app/seed/urnbay/{idx.tsv,cold/idx.tsv,hot/idx.tsv,keep/idx.tsv); stat -c %s \"/app/seed/urnbay/$p\"; done < \"/app/seed/urnbay/marks/$n.bin.m\" | awk '{s+=$1}END{print s}'; done\r\n\u001b[?2004l\r"]
