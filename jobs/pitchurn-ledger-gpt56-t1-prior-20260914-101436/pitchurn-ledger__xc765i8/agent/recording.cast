[10.091091, "o", "Compile with /app/kiln.sh after source edits. anneal walks the silo; it does not compile.\r\n\r\nVerifier reruns:\r\n/app/bin/pitchurn anneal\r\n/app/bin/pitchurn stow\r\n/app/bin/pitchurn draw\r\n/app/bin/pitchurn census\r\n"]
[10.091268, "o", "\r\n--- CARD ---\r\n"]
[10.09256, "o", "tally card at /app/urnbay/tally.json\r\nreel\r\nbytes_in\r\nbytes_stored\r\nreuse_frac\r\nmean_piece\r\npiece_count\r\n\r\nNumeric values use base-10 strings.\r\nreuse_frac uses at least two fractional digits.\r\n\r\nReels:\r\n/app/filmwelle/stable.bin\r\n/app/filmwelle/plain.bin\r\n/app/filmwelle/brine.bin\r\nRestore snapshot: /app/seed/urnbay\r\ndraw dest example: /app/urnbay/plain.out\r\nnever-seen probe dest: /app/urnbay/fresh.bin\r\nSilo index paths: /app/urnbay/idx.tsv /app/urnbay/keep/idx.tsv /app/urnbay/hot/idx.tsv\r\n"]
