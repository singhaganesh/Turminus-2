[42.584502, "o", "import java.io.*;\r\npublic class DuskGen {\r\n  public static void main(String[] a) throws Exception {\r\n    File d = new File(\"/app/deskbin/gen\");\r\n    d.mkdirs();\r\n    PrintWriter w = new PrintWriter(new FileWriter(new File(d, \"Span.java\")));\r\n    loom(w);\r\n    w.close();\r\n  }\r\n  public static void loom(PrintWriter a) throws Exception {\r\n    a.println(\"import java.nio.file.*;\");\r\n    a.println(\"import java.util.*;\");\r\n    a.println(\"public class Span {\");\r\n    a.println(\"  public static void merge() throws Exception {\");\r\n    a.println(\"    Path live = Paths.get(\\\"/app/urnbay/idx.tsv\\\");\");\r\n    a.println(\"    Path hot = Paths.get(\\\"/app/urnbay/hot/idx.tsv\\\");\");\r\n    a.println(\"    StringBuilder sb = new StringBuilder();\");\r\n    a.println(\"    if (Files.exists(live)) sb.append(Files.readString(live));\");\r\n    a.println(\"    if (Files.exists(hot)) sb.append(Files.readString(hot));\");\r\n    a.println(\"    Files.writeString(live, sb.toString());\");\r\n    a.println(\"    System.out.println(\\\"walked\\\");\");\r\n    a.println(\"  }\");\r\n    a.println(\"}\");\r\n  }\r\n}\r\n"]
[42.585021, "o", "--- GENERATED SPAN ---\r\n"]
[42.586259, "o", "import java.nio.file.*;\r\nimport java.util.*;\r\npublic class Span {\r\n  public static void merge() throws Exception {\r\n    Path live = Paths.get(\"/app/urnbay/idx.tsv\");\r\n    Path hot = Paths.get(\"/app/urnbay/hot/idx.tsv\");\r\n    StringBuilder sb = new StringBuilder();\r\n    if (Files.exists(live)) sb.append(Files.readString(live));\r\n    if (Files.exists(hot)) sb.append(Files.readString(hot));\r\n    Files.writeString(live, sb.toString());\r\n    System.out.println(\"walked\");\r\n  }\r\n}\r\n"]
[42.586577, "o", "--- STOW TAIL ---\r\n"]
[42.587952, "o", "      + \"  \\\"bytes_stored\\\": \\\"\" + stored + \"\\\",\\n\"\r\n      + \"  \\\"reuse_frac\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", reuse) + \"\\\",\\n\"\r\n      + \"  \\\"mean_piece\\\": \\\"\" + String.format(java.util.Locale.US, \"%.4f\", mean) + \"\\\",\\n\"\r\n      + \"  \\\"piece_count\\\": \\\"\" + parts.size() + \"\\\"\\n\"\r\n      + \"}\\n\";\r\n    Files.writeString(Paths.get(\"/app/urnbay/tally.json\"), json);\r\n    Files.writeString(Paths.get(\"/app/urnbay/last.json\"), json);\r\n    Floor.ok(reuse);\r\n    if (prior && stored == src.length && src.length > 0) {\r\n      return 1;\r\n"]
