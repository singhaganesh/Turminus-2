[20.135637, "o", "for f in cordbay/*.yarn aliascue/* deskfold/* dockurn/rows.ndjson dockurn/hitch.idx dockurn/berth.ok; do echo \"--- $f ---\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
