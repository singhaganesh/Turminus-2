[19.696409, "i", "printf '%s\\n' '--- go.mod ---'; cat go.mod; printf '%s\\n' '--- CLI ---'; cat millnote/CLI.txt; printf '%s\\n' '--- forms ---'; cat millnote/forms.txt; printf '%s\\n' '--- hull.sh ---'; cat hull.sh\n"]
[19.697139, "o", "printf '%s\\n' '--- go.mod ---'; cat go.mod; printf '%s\\n' '--- CLI ---'; cat millnote/CLI.txt; printf '%s\\n' '--- forms ---'; cat millnote/forms.txt; printf '%s\\n' '--- hull.sh ---'; cat hull.sh\r\n\u001b[?2004l\r"]
[19.697311, "o", "--- go.mod ---\r\n"]
[19.69885, "o", "module berth.local/twinefuse\r\n\r\ngo 1.24\r\n"]
[19.699216, "o", "--- CLI ---\r\n"]
[19.701027, "o", "sew YARN OUTDIR\r\nWrites OUTDIR/rows.ndjson, OUTDIR/hitch.idx, and OUTDIR/berth.ok on success.\r\nPair files are read from /app/aliascue.\r\n"]
[19.701456, "o", "--- forms ---\r\n"]
[19.703022, "o", "Yarn line: id then a single space then tok.\r\nPair file (.cue): left=, right=, origin= lines. origin desk is live. origin scrapped is refused.\r\n"]
[19.703345, "o", "--- hull.sh ---\r\n"]
[19.705004, "o", "#!/bin/bash\r\nset -euo pipefail\r\ncd /app\r\nmkdir -p /app/bin /app/dockurn\r\ngo build -o /app/bin/twinefuse berth.local/twinefuse/berthcli\r\n"]
[19.705392, "o", "\u001b[?2004hroot@7c7853a0a170:/app# "]
[19.918966, "i", "for f in berthcli/*.go netsrc/*.go cardpit/*.go walkbind/*.go readcue/*.go ribdrop/*.go; do echo \"--- $f ---\"; sed -n '1,240p' \"$f\"; done\n"]
[19.91948, "o", "for f in berthcli/*.go netsrc/*.go cardpit/*.go walkbind/*.go readcue/*.go ribdrop/*.go; do echo \"--- $f ---\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[19.919795, "o", "--- berthcli/main.go ---\r\n"]
[19.923025, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n)\r\n\r\nfunc main() {\r\n\tif len(os.Args) < 2 {\r\n\t\tos.Exit(2)\r\n"]
[19.923283, "o", "\t}\r\n\tswitch os.Args[1] {\r\n\tcase \"sew\":\r\n\t\tif len(os.Args) < 4 {\r\n\t\t\tos.Exit(2)\r\n\t\t}\r\n\t\tos.Exit(runSew(os.Args[2], os.Args[3]))\r\n\tdefault:\r\n\t\tos.Exit(2)\r\n\t}\r\n}\r\n"]
[19.923502, "o", "--- berthcli/sew.go ---\r\n"]
[19.925716, "o", "package main\r\n\r\nimport (\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\r\n\t\"berth.local/twinefuse/cardpit\"\r\n\t\"berth.local/twinefuse/netsrc\"\r\n\t\"berth.local/twinefuse/readcue\"\r\n\t\"berth.local/twinefuse/ribdrop\"\r\n\t"]
[19.925865, "o", "\"berth.local/twinefuse/walkbind\"\r\n)\r\n\r\nfunc runSew(dump, out string) int {\r\n\trecs, err := readcue.Scan(dump)\r\n\tif err != nil {\r\n\t\treturn 1\r\n\t}\r\n\ttoks := make([]string, 0, len(recs))\r\n\tfor _, rec := range recs {\r\n\t\ttoks = append(toks, rec.Tok)\r\n\t}\r\n\tnet := netsrc.OpTie(toks)\r\n\t_ = ribdrop.Rank(net.Sz)\r\n"]
[19.925908, "o", "\tif err := cardpit.NPair(\"/app/aliascue\", net); err != nil {\r\n\t\t_ = os.Remove(filepath.Join(out, \"berth.ok\"))\r\n\t\treturn 1\r\n\t}\r\n\trows := readcue.Attach(recs, net)\r\n\tif err := walkbind.CfgStamp(out, rows); err != nil {\r\n\t\treturn 1\r\n\t}\r\n\treturn 0\r\n}\r\n"]
[19.926099, "o", "--- netsrc/tie.go ---\r\n"]
[19.929417, "o", "package netsrc\r\n\r\ntype Net struct {\r\n\tPar map[string]string\r\n\tSz  map[string]int\r\n}\r\n\r\nfunc NewNet() *Net {\r\n\treturn &Net{Par: map[string]string{}, Sz: map[string]int{}}\r\n}\r\n\r\nfunc (n *Net) Add(k string) {\r\n\tif _, ok := n.Par[k]; ok {\r\n\t\treturn\r\n\t}\r\n\tn.Par[k] = k\r\n"]
[19.92958, "o", "\tn.Sz[k] = 1\r\n}\r\n\r\nfunc (n *Net) Find(k string) string {\r\n\tn.Add(k)\r\n\tfor n.Par[k] != k {\r\n\t\tn.Par[k] = n.Par[n.Par[k]]\r\n\t\tk = n.Par[k]\r\n\t}\r\n\treturn k\r\n}\r\n\r\nfunc (n *Net) Join(a, b string) {\r\n\tra, rb := n.Find(a), n.Find(b)\r\n\tif ra == rb {\r\n\t\treturn\r\n\t}\r\n\tif n.Sz[ra] < n.Sz[rb] {\r\n\t\tra, rb = rb, ra\r\n\t}\r\n\tn.Par[rb] = ra\r\n\tn.Sz[ra] += n.Sz[rb]\r\n}\r\n\r\nfunc OpTie(toks []string) *Net {\r\n\tn := NewNet()\r\n\tfor _, t := range toks {\r\n\t\tn.Add(t)\r\n\t}\r\n\treturn n\r\n}\r\n\r\nfunc OpMark(n *Net, tok string) string {\r\n\troot := n.Find(tok)\r\n\tpin := root\r\n\tfor k := range n.Par {\r\n\t\trk := n.Find(k)\r\n\t\tif rk != root {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif n.Sz[rk] > n.Sz[pin] {\r\n\t\t\tpin = rk\r\n\t\t}\r\n\t}\r\n\treturn pin\r\n}\r\n"]
[19.929827, "o", "--- cardpit/pair.go ---\r\n"]
[19.931505, "o", "package cardpit\r\n\r\nimport (\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n\t\"strings\"\r\n\r\n\t\"berth.local/twinefuse/netsrc\"\r\n)\r\n\r\nfunc NPair(dir string, n *netsrc.Net) error {\r\n\tents, err := os.ReadDir(dir)\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfor _, ent := range ents {\r\n\t\tif ent.IsDir() || !strings.HasSuffix(ent.Name(), \".cue\") {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tbody, err := os.ReadFile(filepath.Join(dir, ent.Name()))\r\n\t\tif err != nil {\r\n\t\t\treturn err\r\n\t\t}\r\n\t\tleft, right, origin := \"\", \"\", \"\"\r\n\t\tfor _, line := range strings.Split(string(body), \"\\n\") {\r\n\t\t\tline = strings.TrimSpace(line)\r\n\t\t\tif line == \"\" || !strings.Contains(line, \"=\") {\r\n\t\t\t\tcontinue\r\n\t\t\t}\r\n\t\t\tk, v, _ := strings.Cut(line, \"=\")\r\n\t\t\tk = strings.TrimSpace(k)\r\n\t\t\tv = strings.TrimSpace(v)\r\n\t\t\tswitch k {\r\n\t\t\tcase \"left\":\r\n\t\t\t\tleft = v\r\n\t\t\tcase \"right\":\r\n\t\t\t\tright = v\r\n\t\t\tcase \"origin\":\r\n\t\t\t\torigin = v\r\n\t\t\t}\r\n\t\t}\r\n\t\tif origin == \"scrapped\" {\r\n"]
[19.931578, "o", "\t\t\tcontinue\r\n\t\t}\r\n\t\tif left != \"\" && origin != \"\" {\r\n\t\t\tn.Join(left, origin)\r\n\t\t}\r\n\t\tif right != \"\" {\r\n\t\t\tn.Add(right)\r\n\t\t}\r\n\t}\r\n\treturn nil\r\n}\r\n"]
[19.931894, "o", "--- walkbind/stamp.go ---\r\n"]
[19.9333, "o", "package walkbind\r\n\r\nimport (\r\n\t\"encoding/json\"\r\n\t\"os\"\r\n\t\"path/filepath\"\r\n)\r\n\r\ntype Row struct {\r\n\tId    string `json:\"id\"`\r\n\tHitch string `json:\"hitch\"`\r\n\tTok   string `json:\"tok\"`\r\n}\r\n\r\nfunc CfgStamp(outDir string, rows []Row) error {\r\n\tif err := os.MkdirAll(outDir, 0o755); err != nil {\r\n"]
[19.933473, "o", "\t\treturn err\r\n\t}\r\n\tbyID := map[string]Row{}\r\n\tfor _, row := range rows {\r\n\t\tbyID[row.Id] = row\r\n\t}\r\n\trf, err := os.Create(filepath.Join(outDir, \"rows.ndjson\"))\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tenc := json.NewEncoder(rf)\r\n\tenc.SetEscapeHTML(false)\r\n\tfor _, row := range byID {\r\n\t\tif err := enc.Encode(row); err != nil {\r\n\t\t\trf.Close()\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tif err := rf.Close(); err != nil {\r\n\t\treturn err\r\n\t}\r\n\tgroups := map[string][]string{}\r\n\tfor _, row := range byID {\r\n\t\tgroups[row.Hitch] = append(groups[row.Hitch], row.Id)\r\n\t}\r\n\txf, err := os.Create(filepath.Join(outDir, \"hitch.idx\"))\r\n\tif err != nil {\r\n\t\treturn err\r\n\t}\r\n\tfor h, ids := range groups {\r\n\t\tline := h + \" \" + stringsJoin(ids, \",\") + \"\\n\"\r\n\t\tif _, err := xf.WriteString(line); err != nil {\r\n\t\t\txf.Close()\r\n\t\t\treturn err\r\n\t\t}\r\n\t}\r\n\tif err := xf.Close(); err != nil {\r\n\t\treturn err\r\n\t}\r\n\treturn os.WriteFile(filepath.Join(outDir, \"berth.ok\"), []byte(\"ok\\n\"), 0o644)\r\n}\r\n\r\nfunc stringsJoin(ids []string, sep string) string {\r\n\tif len(ids) == 0 {\r\n\t\treturn \"\"\r\n\t}\r\n\tout := ids[0]\r\n\tfor i := 1; i < len(ids); i++ {\r\n\t\tout += sep + ids[i]\r\n\t}\r\n\treturn out\r\n}\r\n"]
[19.933785, "o", "--- readcue/attach.go ---\r\n"]
[19.935317, "o", "package readcue\r\n\r\nimport (\r\n\t\"berth.local/twinefuse/netsrc\"\r\n\t\"berth.local/twinefuse/walkbind\"\r\n)\r\n\r\nfunc Attach(recs []Rec, n *netsrc.Net) []walkbind.Row {\r\n\trows := make([]walkbind.Row, 0, len(recs))\r\n\tfor _, rec := range recs {\r\n\t\trows = append(rows, walkbind.Row{\r\n\t\t\tId:    rec.Id,\r\n\t\t\tHitch: netsrc.OpMark(n, rec.Tok),\r\n\t\t\tTok:   rec.Tok,\r\n\t\t})\r\n"]
[19.935539, "o", "\t}\r\n\treturn rows\r\n}\r\n"]
[19.936018, "o", "--- readcue/scan.go ---\r\n"]
[19.938392, "o", "package readcue\r\n\r\nimport (\r\n\t\"os\"\r\n\t\"strings\"\r\n)\r\n\r\ntype Rec struct {\r\n\tId  string\r\n\tTok string\r\n}\r\n\r\nfunc Scan(path string) ([]Rec, error) {\r\n\tbody, err := os.ReadFile(path)\r\n\tif err != nil {\r\n\t\treturn nil, err\r\n\t}\r\n\tvar out []Rec\r\n\tfor _, line := range strings.Split(string(body), \"\\n\") {\r\n\t\tline = strings.TrimSpace(line)\r\n\t\tif line == \"\" {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tid, tok, ok := strings.Cut(line, \" \")\r\n\t\tif !ok {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tout = append(out, Rec{Id: strings.TrimSpace(id), Tok: strings.TrimSpace(tok)})\r\n\t}\r\n\treturn out, nil\r\n}\r\n"]
[19.939045, "o", "--- ribdrop/rank.go ---\r\n"]
[19.941246, "o", "package ribdrop\r\n\r\n// Rank builds a size table after join. Equal sizes share one bin.\r\nfunc Rank(sz map[string]int) map[int]int {\r\n\tout := map[int]int{}\r\n\tfor _, n := range sz {\r\n\t\tout[n]++\r\n"]
[19.941569, "o", "\t}\r\n\treturn out\r\n}\r\n"]
[19.942209, "o", "\u001b[?2004hroot@7c7853a0a170:/app# "]
