[10.938304, "i", "cat /app/millnote/ROUTE.txt && printf '\\n--- LAY ---\\n' && cat /app/millnote/LAY.txt && printf '\\n--- HULL ---\\n' && cat /app/millnote/HULL.txt\n"]
[10.942117, "o", "cat /app/millnote/ROUTE.txt && printf '\\n--- LAY ---\\n' && cat /app/millnote/LAY.txt && printf '\\n--- HULL ---\\n' && cat /app/millnote/HULL.txt\r\n\u001b[?2004l\r"]
[10.946943, "o", "Paths the mill tree uses under /app:\r\nberthcli\r\nnetsrc\r\ncardpit\r\nwalkbind\r\nreadcue\r\nribdrop\r\ndeskfold\r\nmillnote\r\ncordbay\r\naliascue\r\ndockurn\r\n"]
[10.947212, "o", "\r\n--- LAY ---\r\n"]
[10.948582, "o", "rows.ndjson: one JSON object per dump row, dump order. Keys are id, hitch, tok (strings).\r\nhitch.idx: one line per hitch token. Token, then a single space, then a comma-joined id list sorted by id bytes. Lines sorted by hitch bytes.\r\nThe hitch token on every row of a group is the least token among tokens in that group, compared as raw UTF-8 bytes. Pair files contribute tokens to the same group.\r\nberth.ok: bytes o k newline after a successful sew.\r\n"]
[10.948791, "o", "\r\n--- HULL ---\r\n"]
[10.951261, "o", "Link the mill with /app/hull.sh after source edits. The agent binary is /app/bin/twinefuse.\r\nA throwaway mill is go build -o /tmp/twinefuse.ref berth.local/twinefuse/berthcli from /app.\r\nAgent /app/bin/twinefuse must sew the same rows.ndjson and hitch.idx as /tmp/twinefuse.ref.\r\nDo not copy that throwaway over the agent mill.\r\n"]
[10.951905, "o", "\u001b[?2004hroot@7c7853a0a170:/app# "]
[11.172517, "i", "printf '\\n--- TREE ---\\n'; find /app -maxdepth 3 -type f -printf '%p\\n' | sort\n"]
