[89.815783, "o", "printf '%s\\n' '--- eve rows ---'; cat /app/dockurn/rows.ndjson; printf '%s\\n' '--- eve index ---'; cat /app/dockurn/hitch.idx; printf '%s\\n' '--- morn index ---'; cat /app/dockurn/mornbox/hitch.idx\r\n\u001b[?2004l\r"]
[89.815946, "o", "--- eve rows ---\r\n"]
[89.817111, "o", "{\"id\":\"e01\",\"hitch\":\"t_m\",\"tok\":\"t_m\"}\r\n{\"id\":\"e02\",\"hitch\":\"t_a\",\"tok\":\"t_a\"}\r\n{\"id\":\"e03\",\"hitch\":\"t_m\",\"tok\":\"t_m\"}\r\n{\"id\":\"e04\",\"hitch\":\"t_b\",\"tok\":\"t_z\"}\r\n{\"id\":\"e05\",\"hitch\":\"t_b\",\"tok\":\"t_b\"}\r\n{\"id\":\"e06\",\"hitch\":\"t_a\",\"tok\":\"t_a\"}\r\n{\"id\":\"e07\",\"hitch\":\"t_q\",\"tok\":\"t_q\"}\r\n{\"id\":\"e08\",\"hitch\":\"t_r\",\"tok\":\"t_r\"}\r\n{\"id\":\"e09\",\"hitch\":\"t_q\",\"tok\":\"t_q\"}\r\n{\"id\":\"e10\",\"hitch\":\"t_r\",\"tok\":\"t_r\"}\r\n"]
[89.817272, "o", "--- eve index ---\r\n"]
[89.818299, "o", "t_a e02,e06\r\nt_b e04,e05\r\nt_m e01,e03\r\nt_q e07,e09\r\nt_r e08,e10\r\n"]
[89.818511, "o", "--- morn index ---\r\n"]
[89.819592, "o", "t_a e02,e06\r\nt_b e04,e05\r\nt_m e01,e03\r\nt_q e07,e09\r\nt_r e08,e10\r\n"]
[89.81994, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.820011, "o", "rm -rf /tmp/refbox /tmp/agentbox\r\n\u001b[?2004l\r"]
[89.821544, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.821904, "o", "/tmp/twinefuse.ref sew /app/cordbay/eve.yarn /tmp/refbox && /app/bin/twinefuse sew /app/cordbay/eve.yarn /tmp/agentbox\r\n\u001b[?2004l\r"]
[89.827325, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.827679, "o", "cmp /tmp/refbox/rows.ndjson /tmp/agentbox/rows.ndjson && cmp /tmp/refbox/hitch.idx /tmp/agentbox/hitch.idx\r\n\u001b[?2004l\r"]
[89.83085, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.831655, "o", "cat > /tmp/external.yarn <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> x2 t_z\r\n\u001b[?2004l\r\u001b[?2004h> x1 t_b\r\n\u001b[?2004l\r\u001b[?2004h> x3 t_a\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[89.83328, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.833494, "o", "rm -rf /tmp/externalbox\r\n\u001b[?2004l\r"]
[89.835207, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.835609, "o", "/app/bin/twinefuse sew /tmp/external.yarn /tmp/externalbox && cat /tmp/externalbox/rows.ndjson && cat /tmp/externalbox/hitch.idx\r\n\u001b[?2004l\r"]
[89.839794, "o", "{\"id\":\"x2\",\"hitch\":\"t_b\",\"tok\":\"t_z\"}\r\n{\"id\":\"x1\",\"hitch\":\"t_b\",\"tok\":\"t_b\"}\r\n{\"id\":\"x3\",\"hitch\":\"t_a\",\"tok\":\"t_a\"}\r\n"]
[89.841236, "o", "t_a x3\r\nt_b x1,x2\r\n"]
[89.841516, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.841701, "o", "cp /app/aliascue/desk.cue /tmp/desk.cue.save\r\n\u001b[?2004l\r"]
[89.846227, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.846473, "o", "cat > /app/aliascue/bad.cue <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[89.846609, "o", "left=t_a\r\n\u001b[?2004l\r\u001b[?2004h> right=t_q\r\n\u001b[?2004l\r\u001b[?2004h> origin=scrapped\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[89.848702, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.849001, "o", "rm -rf /tmp/badbox; mkdir -p /tmp/badbox; printf 'ok\\n' > /tmp/badbox/berth.ok\r\n\u001b[?2004l\r"]
[89.852688, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.853949, "o", "if /app/bin/twinefuse sew /app/cordbay/eve.yarn /tmp/badbox; then echo 'ERROR: scrapped pair succeeded'; status=1; else test ! -e /tmp/badbox/berth.ok && echo 'scrapped pair correctly refused'; status=$?; fi\r\n\u001b[?2004l\r"]
[89.857586, "o", "scrapped pair correctly refused\r\n"]
[89.857874, "o", "\u001b[?2004hroot@046a16eb5330:/app# rm -f /app/aliascue/bad.cue\r\n\u001b[?2004l\r"]
[89.859668, "o", "\u001b[?2004hroot@046a16eb5330:/app# "]
[89.85992, "o", "exit $status\r\n\u001b[?2004l\rexit\r\n"]
