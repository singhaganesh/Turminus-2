[85.867733, "i", "cat > /app/netsrc/tie.go <<'EOF'\npackage netsrc\n\ntype Net struct {\n\tPar map[string]string\n\tSz  map[string]int\n}\n\nfunc NewNet() *Net {\n\treturn &Net{Par: map[string]string{}, Sz: map[string]int{}}\n}\n\nfunc (n *Net) Add(k string) {\n\tif _, ok := n.Par[k]; ok {\n\t\treturn\n\t}\n\tn.Par[k] = k\n\tn.Sz[k] = 1\n}\n\nfunc (n *Net) Find(k string) string {\n\tn.Add(k)\n\tfor n.Par[k] != k {\n\t\tn.Par[k] = n.Par[n.Par[k]]\n\t\tk = n.Par[k]\n\t}\n\treturn k\n}\n\nfunc (n *Net) Join(a, b string) {\n\tra, rb := n.Find(a), n.Find(b)\n\tif ra == rb {\n\t\treturn\n\t}\n\tif n.Sz[ra] < n.Sz[rb] {\n\t\tra, rb = rb, ra\n\t}\n\tn.Par[rb] = ra\n\tn.Sz[ra] += n.Sz[rb]\n}\n\nfunc OpTie(toks []string) *Net {\n\tn := NewNet()\n\tfor _, t := range toks {\n\t\tn.Add(t)\n\t}\n\treturn n\n}\n\n// OpMark returns the bytewise-least token in tok's connected component.\n// Go string comparison is lexicographic by byte, which is the required UTF-8\n// byte ordering.\nfunc OpMark(n *Net, tok string) string {\n\troot := n.Find(tok)\n\tmark := tok\n\tfor k := range n.Par {\n\t\tif n.Find(k) == root && k < mark {\n\t\t\tmark = k\n\t\t}\n\t}\n\treturn mark\n}\nEOF\n\ncat > /app/cardpit/pair.go <<'EOF'\npackage cardpit\n\nimport (\n\t\"errors\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"berth.local/twinefuse/netsrc\"\n)\n\nfunc NPair(dir string, n *netsrc.Net) error {\n\tents, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor _, ent := range ents {\n\t\tif ent.IsDir() || !strings.HasSuffix(ent.Name(), \".cue\") {\n\t\t\tcontinue\n\t\t}\n\t\tbody, err := os.ReadFile(filepath.Join(dir, ent.Name()))\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tleft, right, origin := \"\", \"\", \"\"\n\t\tfor _, line := range strings.Split(string(body), \"\\n\") {\n\t\t\tline = strings.TrimSpace(line)\n\t\t\tif line == \"\" || !strings.Contains(line, \"=\") {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tk, v, _ := strings.Cut(line, \"=\")\n\t\t\tswitch strings.TrimSpace(k) {\n\t\t\tcase \"left\":\n\t\t\t\tleft = strings.TrimSpace(v)\n\t\t\tcase \"right\":\n\t\t\t\tright = strings.TrimSpace(v)\n\t\t\tcase \"origin\":\n\t\t\t\torigin = strings.TrimSpace(v)\n\t\t\t}\n\t\t}\n\t\tif origin == \"scrapped\" {\n\t\t\treturn errors.New(\"scrapped pair: \" + ent.Name())\n\t\t}\n\t\tif left != \"\" && right != \"\" {\n\t\t\tn.Join(left, right)\n\t\t}\n\t}\n\treturn nil\n}\nEOF\n\ncat > /app/walkbind/stamp.go <<'EOF'\npackage walkbind\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\ntype Row struct {\n\tId    string `json:\"id\"`\n\tHitch string `json:\"hitch\"`\n\tTok   string `json:\"tok\"`\n}\n\nfunc CfgStamp(outDir string, rows []Row) error {\n\tif err := os.MkdirAll(outDir, 0o755); err != nil {\n\t\treturn err\n\t}\n\trf, err := os.Create(filepath.Join(outDir, \"rows.ndjson\"))\n\tif err != nil {\n\t\treturn err\n\t}\n\tenc := json.NewEncoder(rf)\n\tenc.SetEscapeHTML(false)\n\tfor _, row := range rows {\n\t\tif err := enc.Encode(row); err != nil {\n\t\t\trf.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := rf.Close(); err != nil {\n\t\treturn err\n\t}\n\n\tgroups := make(map[string]map[string]struct{})\n\tfor _, row := range rows {\n\t\tif groups[row.Hitch] == nil {\n\t\t\tgroups[row.Hitch] = make(map[string]struct{})\n\t\t}\n\t\tgroups[row.Hitch][row.Id] = struct{}{}\n\t}\n\thitches := make([]string, 0, len(groups))\n\tfor hitch := range groups {\n\t\thitches = append(hitches, hitch)\n\t}\n\tsort.Strings(hitches)\n\n\txf, err := os.Create(filepath.Join(outDir, \"hitch.idx\"))\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor _, hitch := range hitches {\n\t\tids := make([]string, 0, len(groups[hitch]))\n\t\tfor id := range groups[hitch] {\n\t\t\tids = append(ids, id)\n\t\t}\n\t\tsort.Strings(ids)\n\t\tif _, err := xf.WriteString(hitch + \" \" + strings.Join(ids, \",\") + \"\\n\"); err != nil {\n\t\t\txf.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := xf.Close(); err != nil {\n\t\treturn err\n\t}\n\treturn os.WriteFile(filepath.Join(outDir, \"berth.ok\"), []byte(\"ok\\n\"), 0o644)\n}\nEOF\n\npython3 - <<'PY'\np='/app/berthcli/sew.go'\ns=open(p).read()\ns=s.replace('func runSew(dump, out string) int {\\n', 'func runSew(dump, out string) int {\\n\\t// A marker only describes the current invocation; no failure may leave an old one.\\n\\t_ = os.Remove(filepath.Join(out, \"berth.ok\"))\\n')\nopen(p,'w').write(s)\nPY\n\ngofmt -w /app/berthcli /app/netsrc /app/cardpit /app/walkbind /app/readcue /app/ribdrop\ngo test ./...\ngo build -o /tmp/twinefuse.ref berth.local/twinefuse/berthcli\n/app/hull.sh\nh"]
