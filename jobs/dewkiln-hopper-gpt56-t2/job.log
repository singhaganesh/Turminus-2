.tpl").map_err(|_| 1)?;\n    let output = template\n        .replace("__P__", probe)\n        .replace("__M__", &matched.to_string())\n        .replace("__T__", &taken.to_string());\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write("/app/bloturn/check.json", output).map_err(|_| 1)\n}\n\npub fn gait(total: i32, packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file("/app/bloturn/GUARD");\n    if packed.is_empty() || emit("live", total, total).is_err() {\n        return 1;\n    }\n    if fs::write("/app/bloturn/GUARD", "ok").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > /app/urncue/fold.rs <<\'EOF\'\n#[path = "../hopcue/rim.rs"]\nmod rim;\n#[path = "../restpit/soak.rs"]\nmod soak;\n#[path = "../shardfold/read.rs"]\nmod read;\n\nuse std::fs;\n\npub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\n    let wall: i32 = fs::read_to_string("/app/opstext/WALL")\n        .map_err(|_| 1)?\n        .trim()\n        .parse()\n        .map_err(|_| 1)?;\n    let picked = rim::rim(wall, read::list("/app/daywell")?);\n    if picked.is_empty() {\n        let _ = fs::remove_dir_all("/app/packbay/stage");\n        let _ = fs::remove_dir_all("/app/packbay/latest");\n        fs::create_dir_all("/app/packbay/stage").map_err(|_| 1)?;\n        fs::create_dir_all("/app/packbay/latest").map_err(|_| 1)?;\n        return Err(1);\n    }\n\n    /* Count rows by opening the live daywell files, before making artifacts. */\n    let mut taken = 0i32;\n    for (_, source) in &picked {\n        taken = taken.checked_add(read::nlines(source)?).ok_or(1)?;\n    }\n\n    let _ = fs::remove_dir_all("/app/packbay/stage");\n    fs::create_dir_all("/app/packbay/stage").map_err(|_| 1)?;\n    let mut packed = Vec::new();\n    for (day, source) in picked {\n        let destination = format!("/app/packbay/stage/d{:08}.tbl", day);\n        fs::copy(source, &destination).map_err(|_| 1)?;\n        packed.push((day, destination));\n    }\n    soak::soak(&packed, "/app/packbay/latest")?;\n    fs::create_dir_all("/app/bloturn").map_err(|_| 1)?;\n    fs::write(\n        "/app/bloturn/ledger.json",\n        format!("{{\\"taken\\":{}}}", taken),\n    )\n    .map_err(|_| 1)?;\n    Ok((packed, taken))\n}\nEOF\ncat > /app/wickmill/boot.rs <<\'EOF\'\n#[path = "../urncue/fold.rs"]\nmod fold;\n#[path = "../millrib/gait.rs"]\nmod gait;\n#[path = "../lidcue/skip.rs"]\nmod skip;\n#[path = "../corkpit/floor.rs"]\nmod floor;\n\nfn main() {\n    let mut args = std::env::args();\n    let _ = args.next();\n    if args.next().unwrap_or_default() != "clasp" {\n        eprintln!("usage: dewkiln clasp");\n        std::process::exit(2);\n    }\n    let _ = std::fs::create_dir_all("/app/bloturn");\n    let _ = std::fs::remove_file("/app/bloturn/GUARD");\n    let _ = std::fs::remove_file("/app/bloturn/check.json");\n    let _ = std::fs::remove_file("/app/bloturn/ledger.json");\n\n    let code = match fold::fold() {\n        Ok((packed, taken)) if floor::floor(taken) => {\n            let mut ordered = packed.clone();\n            skip::skip(&mut ordered);\n            gait::gait(taken, &packed)\n        }\n        Ok(_) | Err(_) => 1,\n    };\n    std::process::exit(code);\n}\nEOF\ncat > /app/wick.sh <<\'EOF\'\n#!/bin/sh\nset -eu\nexport PATH="/usr/local/rustup/toolchains/1.85.1-x86_64-unknown-linux-gnu/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"\nmkdir -p /app/bin /app/bloturn /app/packbay\nrustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\nEOF\nchmod +x /app/wick.sh\n/app/wick.sh\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
