[85.586388, "o", "    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n\u001b[?2004l\r"]
[85.586438, "o", "\u001b[?2004h> "]
[85.586586, "o", "        .map_err(|_| 1)?\r\n\u001b[?2004l\r\u001b[?2004h>         .trim()\r\n"]
