[10.739642, "o", "-rw-rw-r-- root root 763 /app/shardfold/read.rs -> \r\n-rw-rw-r-- root root 824 /app/opstext/LIST.txt -> \r\n-rw-rw-r-- root root 9 /app/opstext/WALL -> \r\n-rwxr-xr-x root root 4050176 /app/bin/dewkiln -> \r\n-rwxrwxr-x root root 202 /app/wick.sh -> \r\ndrwxr-xr-x root root 4096 /app -> \r\ndrwxr-xr-x root root 4096 /app/bin -> \r\ndrwxr-xr-x root root 4096 /app/bloturn -> \r\ndrwxr-xr-x root root 4096 /app/corkpit -> \r\ndrwxr-xr-x root root 4096 /app/daywell -> \r\ndrwxr-xr-x root root 4096 /app/floorcue -> \r\ndrwxr-xr-x root root 4096 /app/hopcue -> \r\ndrwxr-xr-x root root 4096 /app/lidcue -> \r\ndrwxr-xr-x root root 4096 /app/millrib -> \r\ndrwxr-xr-x root root 4096 /app/opstext -> \r\ndrwxr-xr-x root root 4096 /app/packbay -> \r\ndrwxr-xr-x root root 4096 /app/packbay/latest -> \r\ndrwxr-xr-x root root 4096 /app/packbay/stage -> \r\ndrwxr-xr-x root root 4096 /app/restpit -> \r\ndrwxr-xr-x root root 4096 /app/seed -> \r\ndrwxr-xr-x root root 4096 /app/seed/daywell -> \r\ndrwxr-xr-x root root 4096 /app/shardfold -> \r\ndrwxr-xr-x root root 4096 /app/urncue -> \r\ndrwxr-xr-x root root 4096 /app/wickmill -> \r\n"]
