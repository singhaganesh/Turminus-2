[85.587682, "o", "\u001b[?2004h> "]
[85.587841, "o", "        fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[85.587933, "o", "\u001b[?2004h> "]
[85.588071, "o", "        fs::create_dir_all(\"/app/packbay/latest\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[85.588197, "o", "\u001b[?2004h> "]
[85.589333, "o", "        return Err(1);\r\n\u001b[?2004l\r"]
[85.589523, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.589601, "o", "> "]
[85.589822, "o", "    /* Count rows by opening the live daywell files, before making artifacts. */\r\n\u001b[?2004l\r"]
[85.589895, "o", "\u001b[?2004h> "]
[85.589999, "o", "    let mut taken = 0i32;\r\n\u001b[?2004l\r"]
[85.590066, "o", "\u001b[?2004h> "]
[85.590192, "o", "    for (_, source) in &picked {\r\n\u001b[?2004l\r"]
[85.590252, "o", "\u001b[?2004h> "]
[85.590511, "o", "        taken = taken.checked_add(read::nlines(source)?).ok_or(1)?;\r\n\u001b[?2004l\r"]
[85.590622, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[85.590769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.590906, "o", "    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n\u001b[?2004l\r"]
[85.590967, "o", "\u001b[?2004h> "]
[85.59124, "o", "    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[85.591331, "o", "\u001b[?2004h> "]
[85.591411, "o", "    let mut packed = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.591547, "o", "    for (day, source) in picked {\r\n\u001b[?2004l\r"]
[85.591606, "o", "\u001b[?2004h> "]
[85.591729, "o", "        let destination = format!(\"/app/packbay/stage/d{:08}.tbl\", day);\r\n\u001b[?2004l\r"]
[85.591769, "o", "\u001b[?2004h> "]
[85.591899, "o", "        fs::copy(source, &destination).map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[85.591917, "o", "\u001b[?2004h> "]
[85.592031, "o", "        packed.push((day, destination));\r\n\u001b[?2004l\r"]
[85.592095, "o", "\u001b[?2004h"]
[85.59218, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.592292, "o", "    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n\u001b[?2004l\r"]
[85.59236, "o", "\u001b[?2004h> "]
[85.592483, "o", "    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n\u001b[?2004l\r"]
[85.592533, "o", "\u001b[?2004h> "]
[85.592582, "o", "    fs::write(\r\n\u001b[?2004l\r\u001b[?2004h"]
[85.592632, "o", "> "]
