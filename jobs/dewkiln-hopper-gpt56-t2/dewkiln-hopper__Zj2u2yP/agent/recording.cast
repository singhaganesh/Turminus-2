[85.586942, "o", "\u001b[?2004h> "]
[85.587055, "o", "    let picked = rim::rim(wall, read::list(\"/app/daywell\")?);\r\n\u001b[?2004l\r"]
[85.58714, "o", "\u001b[?2004h> "]
