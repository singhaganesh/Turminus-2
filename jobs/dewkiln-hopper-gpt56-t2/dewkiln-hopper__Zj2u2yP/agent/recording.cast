[85.596283, "o", "\u001b[?2004h>     }\r\n"]
[85.59633, "o", "\u001b[?2004l\r"]
[85.596368, "o", "\u001b[?2004h> "]
[85.59646, "o", "    let _ = std::fs::create_dir_all(\"/app/bloturn\");\r\n\u001b[?2004l\r"]
[85.596499, "o", "\u001b[?2004h> "]
