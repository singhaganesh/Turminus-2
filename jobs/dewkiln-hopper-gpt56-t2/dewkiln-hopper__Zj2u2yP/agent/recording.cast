[11.749473, "o", "--- LIST ---\r\n"]
[11.750662, "o", "dewkiln layout\r\n==============\r\n\r\nwickmill/boot.rs dispatches clasp.\r\n\r\nPipeline crates:\r\n- hopcue/\r\n- millrib/\r\n- restpit/\r\n- urncue/\r\n- shardfold/\r\n- lidcue/\r\n\r\nDay files live in /app/daywell.\r\nclasp writes /app/bloturn/ledger.json and /app/bloturn/check.json.\r\nIt packs /app/packbay/stage then unpacks /app/packbay/latest with the same calendar names.\r\nmillrib/sheet.tpl at /app/millrib/sheet.tpl fills check.json; its placeholders stay in the template.\r\nFixture copies of the day files sit at /app/seed/daywell.\r\n\r\ncheck.json object:\r\n- probe (the string live)\r\n- matched (integer live daywell row total at or before the wall)\r\n- taken (integer, same total)\r\n\r\nCI floor integer lives in /app/floorcue/MIN.txt.\r\n\r\nExtra daywell files still use names like d20260908.tbl and d20260914.tbl.\r\n\r\n\r\nRebuild the binary with /app/wick.sh after source edits.\r\n"]
[11.750879, "o", "--- WALL ---\r\n"]
[11.751722, "o", "20260913\r\n"]
[11.751895, "o", "--- MIN ---\r\n"]
[11.752679, "o", "15\r\n"]
[11.752852, "o", "--- TEMPLATE ---\r\n"]
[11.753681, "o", "{\"probe\":\"__P__\",\"matched\":__M__,\"taken\":__T__}\r\n"]
[11.75384, "o", "--- FILE TYPES ---\r\n"]
[11.754223, "o", "bash: file: command not found\r\n"]
[11.754462, "o", "\u001b[?2004hroot@319a5fb8edd5:/app# "]
[12.233532, "i", "for f in /app/environment/*; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\" 2>/dev/null || true; done\n"]
[12.233986, "o", "for f in /app/environment/*; do echo \"===== $f =====\"; sed -n '1,240p' \"$f\" 2>/dev/null || true; done\r\n\u001b[?2004l\r"]
[12.234079, "o", "===== /app/environment/* =====\r\n"]
[12.238828, "o", "\u001b[?2004hroot@319a5fb8edd5:/app# "]
[13.26491, "i", "echo '--- DAYWELL BEFORE ---'; find /app/daywell -maxdepth 1 -type f -printf '%f ' -exec wc -l {} \\; 2>/dev/null | sort; echo '--- RUN ---'; /app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; echo '--- OUTPUTS AFTER ---'; find /app/bloturn /app/packbay -maxdepth 3 -printf '%y %p -> %l\\n' 2>/dev/null | sort; echo '--- JSON/GUARD ---'; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do echo \"===== $f =====\"; cat \"$f\" 2>/dev/null || echo MISSING; done\n"]
[13.266388, "o", "echo '--- DAYWELL BEFORE ---'; find /app/daywell -maxdepth 1 -type f -printf '%f ' -exec wc -l {} \\; 2>/dev/null | sort; echo '--- RUN ---'; /app/bin/dewkiln clasp; rc=$?; echo \"RC=$rc\"; echo '--- OUTPUTS AFTER ---'; find /app/bloturn /app/packbay -maxdepth 3 -printf '%y %p -> %l\\n' 2>/dev/null | sort; echo '--- JSON/GUARD ---'; for f in /app/bloturn/ledger.json /app/bloturn/check.json /app/bloturn/GUARD; do echo \"===== $f =====\"; cat \"$f\" 2>/dev/null || echo MISSING; done\r\n\u001b[?2004l\r"]
[13.266977, "o", "--- DAYWELL BEFORE ---\r\n"]
[13.274543, "o", "d20260910.tbl 5 /app/daywell/d20260910.tbl\r\nd20260911.tbl 4 /app/daywell/d20260911.tbl\r\nd20260912.tbl 6 /app/daywell/d20260912.tbl\r\nd20260913.tbl 7 /app/daywell/d20260913.tbl\r\n"]
[13.27482, "o", "--- RUN ---\r\n"]
[13.277938, "o", "RC=0\r\n--- OUTPUTS AFTER ---\r\n"]
[13.27972, "o", "d /app/bloturn -> \r\nd /app/packbay -> \r\nd /app/packbay/latest -> \r\nd /app/packbay/stage -> \r\nf /app/bloturn/GUARD -> \r\nf /app/bloturn/check.json -> \r\nf /app/bloturn/ledger.json -> \r\nf /app/packbay/latest/d20260910.tbl -> \r\nf /app/packbay/latest/d20260911.tbl -> \r\nf /app/packbay/stage/d20260910.tbl -> \r\nf /app/packbay/stage/d20260911.tbl -> \r\nf /app/packbay/stage/d20260912.tbl -> \r\n"]
[13.27993, "o", "--- JSON/GUARD ---\r\n===== /app/bloturn/ledger.json =====\r\n"]
[13.281008, "o", "{\"taken\":15}"]
[13.281216, "o", "===== /app/bloturn/check.json =====\r\n"]
[13.28215, "o", "{\"probe\":\"ledger\",\"matched\":15,\"taken\":15}\r\n"]
[13.282376, "o", "===== /app/bloturn/GUARD =====\r\n"]
[13.283229, "o", "ok"]
[13.283437, "o", "\u001b[?2004hroot@319a5fb8edd5:/app# "]
[26.566985, "i", "for f in /app/wickmill/boot.rs /app/hopcue/rim.rs /app/millrib/gait.rs /app/restpit/soak.rs /app/urncue/fold.rs /app/shardfold/read.rs /app/lidcue/skip.rs /app/corkpit/floor.rs; do echo \"===== $f =====\"; nl -ba \"$f\"; done\n"]
[26.567787, "o", "for f in /app/wickmill/boot.rs /app/hopcue/rim.rs /app/millrib/gait.rs /app/restpit/soak.rs /app/urncue/fold.rs /app/shardfold/read.rs /app/lidcue/skip.rs /app/corkpit/floor.rs; do echo \"===== $f =====\"; nl -ba \"$f\"; done\r\n\u001b[?2004l\r"]
[26.567912, "o", "===== /app/wickmill/boot.rs =====\r\n"]
[26.571907, "o", "     1\t#[path = \"../urncue/fold.rs\"]\r\n     2\tmod fold;\r\n     3\t#[path = \"../millrib/gait.rs\"]\r\n     4\tmod gait;\r\n     5\t#[path = \"../lidcue/skip.rs\"]\r\n     6\tmod skip;\r\n     7\t#[path = \"../corkpit/floor.rs\"]\r\n     8\tmod floor;\r\n     9\t\r\n    10\tfn main() {\r\n    11\t    let mut args = std::env::args();\r\n    12\t    let _ = args.next();\r\n    13\t    let cmd = args.next().unwrap_or_default();\r\n    14\t    if cmd != \"clasp\" {\r\n"]
[26.572059, "o", "    15\t        eprintln!(\"usage: dewkiln clasp\");\r\n    16\t        std::process::exit(2);\r\n    17\t    }\r\n    18\t    let _ = std::fs::remove_file(\"/app/bloturn/GUARD\");\r\n    19\t    let code = match fold::fold() {\r\n    20\t        Ok((packed, taken)) => {\r\n    21\t            let mut dump = packed.clone();\r\n    22\t            skip::skip(&mut dump);\r\n    23\t            let _ = floor::floor(taken);\r\n    24\t            gait::gait(taken, &packed)\r\n    25\t        }\r\n    26\t        Err(c) => c,\r\n    27\t    };\r\n    28\t    std::process::exit(code);\r\n    29\t}\r\n"]
[26.572184, "o", "===== /app/hopcue/rim.rs =====\r\n"]
[26.573061, "o", "     1\tpub fn rim(a: i32, b: Vec<(i32, String)>) -> Vec<(i32, String)> {\r\n     2\t    b.into_iter().filter(|(d, _)| *d < a).collect()\r\n     3\t}\r\n"]
[26.573251, "o", "===== /app/millrib/gait.rs =====\r\n"]
[26.574019, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tfn emit(p: &str, m: i32, t: i32) -> Result<(), i32> {\r\n     4\t    let tpl = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\r\n     5\t    let out = tpl\r\n     6\t        .replace(\"__P__\", p)\r\n     7\t        .replace(\"__M__\", &m.to_string())\r\n"]
[26.574151, "o", "     8\t        .replace(\"__T__\", &t.to_string());\r\n     9\t    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    10\t    fs::write(\"/app/bloturn/check.json\", out).map_err(|_| 1)?;\r\n    11\t    Ok(())\r\n    12\t}\r\n    13\t\r\n    14\tpub fn gait(a: i32, _b: &[(i32, String)]) -> i32 {\r\n    15\t    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\r\n"]
[26.574248, "o", "    16\t    if emit(\"ledger\", a, a).is_err() {\r\n    17\t        return 1;\r\n    18\t    }\r\n    19\t    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\r\n    20\t        return 1;\r\n    21\t    }\r\n    22\t    0\r\n    23\t}\r\n"]
[26.574361, "o", "===== /app/restpit/soak.rs =====\r\n"]
[26.575074, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn soak(a: &[(i32, String)], b: &str) -> Result<(), i32> {\r\n     4\t    let _ = fs::remove_dir_all(b);\r\n     5\t    fs::create_dir_all(b).map_err(|_| 1)?;\r\n     6\t    let mut xs: Vec<(i32, String)> = a.to_vec();\r\n"]
[26.575156, "o", "     7\t    xs.sort_by_key(|x| x.0);\r\n     8\t    if !xs.is_empty() {\r\n     9\t        xs.pop();\r\n    10\t    }\r\n    11\t    for (d, p) in xs {\r\n    12\t        let name = format!(\"d{:08}.tbl\", d);\r\n    13\t        fs::copy(&p, format!(\"{}/{}\", b, name)).map_err(|_| 1)?;\r\n    14\t    }\r\n    15\t    Ok(())\r\n    16\t}\r\n"]
[26.575312, "o", "===== /app/urncue/fold.rs =====\r\n"]
[26.576012, "o", "     1\t#[path = \"../hopcue/rim.rs\"]\r\n     2\tmod rim;\r\n     3\t#[path = \"../restpit/soak.rs\"]\r\n     4\tmod soak;\r\n     5\t#[path = \"../shardfold/read.rs\"]\r\n     6\tmod read;\r\n     7\t\r\n     8\tuse std::fs;\r\n     9\t\r\n    10"]
[26.576052, "o", "\tpub fn fold() -> Result<(Vec<(i32, String)>, i32), i32> {\r\n    11\t    let wall: i32 = fs::read_to_string(\"/app/opstext/WALL\")\r\n    12\t        .map_err(|_| 1)?\r\n    13\t        .trim()\r\n    14\t        .parse()\r\n    15\t        .map_err(|_| 1)?;\r\n    16\t    let listed = read::list(\"/app/daywell\");\r\n    17\t    let picked = rim::rim(wall, listed);\r\n    18\t    if picked.is_empty() {\r\n    19\t        fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    20\t        fs::write(\"/app/bloturn/ledger.json\", \"{\\\"taken\\\":0}\").map_err(|_| 1)?;\r\n    21\t        let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    22\t        let _ = fs::remove_dir_all(\"/app/packbay/latest\");\r\n    23\t        fs::create_dir_all(\"/app/packbay/stage\").ok();\r\n    24\t        fs::create_dir_all(\"/app/packbay/latest\").ok();\r\n"]
[26.576072, "o", "    25\t        return Ok((Vec::new(), 0));\r\n    26\t    }\r\n    27\t    let _ = fs::remove_dir_all(\"/app/packbay/stage\");\r\n    28\t    fs::create_dir_all(\"/app/packbay/stage\").map_err(|_| 1)?;\r\n    29\t    let mut packed = Vec::new();\r\n    30\t    let mut taken = 0;\r\n    31\t    for (d, p) in picked {\r\n"]
[26.576089, "o", "    32\t        let name = format!(\"d{:08}.tbl\", d);\r\n    33\t        let dest = format!(\"/app/packbay/stage/{}\", name);\r\n    34\t        fs::copy(&p, &dest).map_err(|_| 1)?;\r\n    35\t        taken += read::nlines(&dest);\r\n    36\t        packed.push((d, dest));\r\n"]
[26.576257, "o", "    37\t    }\r\n    38\t    soak::soak(&packed, \"/app/packbay/latest\")?;\r\n    39\t    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\r\n    40\t    let body = format!(\"{{\\\"taken\\\":{}}}\", taken);\r\n"]
[26.576321, "o", "    41\t    fs::write(\"/app/bloturn/ledger.json\", body).map_err(|_| 1)?;\r\n    42\t    Ok((packed, taken))\r\n    43\t}\r\n===== /app/shardfold/read.rs =====\r\n"]
[26.577047, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn list(root: &str) -> Vec<(i32, String)> {\r\n     4\t    let mut v = Vec::new();\r\n     5\t    let rd = match fs::read_dir(root) {\r\n     6\t        Ok(x) => x,\r\n     7\t        Err(_) => return v,\r\n     8\t    };\r\n     9\t    for ent in rd.flatten() {\r\n"]
[26.577185, "o", "    10\t        let name = ent.file_name().to_string_lossy().into_owned();\r\n    11\t        if !name.starts_with('d') || !name.ends_with(\".tbl\") {\r\n    12\t            continue;\r\n    13\t        }\r\n    14\t        let mid = &name[1..name.len() - 4];\r\n    15\t        if let Ok(d) = mid.parse::<i32>() {\r\n    16\t            v.push((d, ent.path().to_string_lossy().into_owned()));\r\n    17\t        }\r\n"]
[26.577261, "o", "    18\t    }\r\n    19\t    v.sort_by_key(|x| x.0);\r\n    20\t    v\r\n    21\t}\r\n    22\t\r\n    23\tpub fn nlines(path: &str) -> i32 {\r\n    24\t    match fs::read_to_string(path) {\r\n    25\t        Ok(t) => t.lines().filter(|l| !l.trim().is_empty()).count() as i32,\r\n    26\t        Err(_) => 0,\r\n    27\t    }\r\n    28\t}\r\n"]
[26.577327, "o", "===== /app/lidcue/skip.rs =====\r\n"]
[26.578186, "o", "     1\tpub fn skip(a: &mut [(i32, String)]) {\r\n     2\t    a.sort_by(|x, y| x.1.cmp(&y.1));\r\n     3\t}\r\n     4\t\r\n     5\tpub fn width(a: &[(i32, String)]) -> usize {\r\n     6\t    a.len()\r\n     7\t}\r\n     8\t\r\n     9\tpub fn first(a: &[(i32, String)]) -> Option<i32> {\r\n    10\t    a.first().map(|x| x.0)\r\n"]
[26.578298, "o", "    11\t}\r\n"]
[26.578397, "o", "===== /app/corkpit/floor.rs =====\r\n"]
[26.579157, "o", "     1\tuse std::fs;\r\n     2\t\r\n     3\tpub fn floor(a: i32) -> bool {\r\n     4\t    let t = match fs::read_to_string(\"/app/floorcue/MIN.txt\") {\r\n     5\t        Ok(s) => s.trim().parse::<i32>().unwrap_or(0),\r\n     6\t        Err(_) => 0,\r\n     7\t    };\r\n     8\t    a >= t\r\n     9\t}\r\n"]
[26.579375, "o", "\u001b[?2004hroot@319a5fb8edd5:/app# "]
[27.554686, "i", "echo '===== wick.sh ====='; nl -ba /app/wick.sh; echo '===== NOTE ====='; cat /app/corkpit/NOTE.txt; echo '===== SHIFT ====='; cat /app/opstext/SHIFT.txt; echo '===== usage ====='; cat /app/wickmill/usage.txt; echo '===== rust toolchain ====='; rustc --version; cargo --version 2>/dev/null || true\n"]
[27.556362, "o", "echo '===== wick.sh ====='; nl -ba /app/wick.sh; echo '===== NOTE ====='; cat /app/corkpit/NOTE.txt; echo '===== SHIFT ====='; cat /app/opstext/SHIFT.txt; echo '===== usage ====='; cat /app/wickmill/usage.txt; echo '===== rust toolchain ====='; rustc --version; cargo --version 2>/dev/null || true\r\n\u001b[?2004l\r===== wick.sh =====\r\n"]
[27.557319, "o", "     1\t#!/bin/sh\r\n     2\tset -eu\r\n     3\texport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\n     4\tmkdir -p /app/bin /app/bloturn /app/packbay\r\n     5\trustc --edition 2021 -O /app/wickmill/boot.rs -o /app/bin/dewkiln\r\n"]
[27.557631, "o", "===== NOTE =====\r\n"]
[27.55863, "o", "floor() reads MIN.txt and compares a taken total to that integer.\r\nCI used this as a cheap rehearsal when the desk was first wired.\r\n"]
[27.558791, "o", "===== SHIFT =====\r\n"]
[27.559631, "o", "Nightly clasp has stayed green since the CI floor landed.\r\nOperators still open /app/packbay/latest after incidents and find the\r\nnewest populated day file missing even when /app/daywell still holds it.\r\nThe floor value lives under floorcue/.\r\n"]
[27.559773, "o", "===== usage =====\r\n"]
