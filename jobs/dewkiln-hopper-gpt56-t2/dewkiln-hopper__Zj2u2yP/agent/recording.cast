[43.104669, "o", "\u001b[?2004hroot@319a5fb8edd5:/app# "]
[85.06439, "i", "cat > /app/hopcue/rim.rs <<'EOF'\npub fn rim(wall: i32, files: Vec<(i32, String)>) -> Vec<(i32, String)> {\n    files.into_iter().filter(|(day, _)| *day <= wall).collect()\n}\nEOF\ncat > /app/restpit/soak.rs <<'EOF'\nuse std::fs;\n\npub fn soak(files: &[(i32, String)], destination: &str) -> Result<(), i32> {\n    let _ = fs::remove_dir_all(destination);\n    fs::create_dir_all(destination).map_err(|_| 1)?;\n    let mut sorted = files.to_vec();\n    sorted.sort_by_key(|item| item.0);\n    for (day, source) in sorted {\n        let name = format!(\"d{:08}.tbl\", day);\n        fs::copy(source, format!(\"{}/{}\", destination, name)).map_err(|_| 1)?;\n    }\n    Ok(())\n}\nEOF\ncat > /app/shardfold/read.rs <<'EOF'\nuse std::fs;\n\npub fn list(root: &str) -> Result<Vec<(i32, String)>, i32> {\n    let mut files = Vec::new();\n    let entries = fs::read_dir(root).map_err(|_| 1)?;\n    for entry in entries {\n        let entry = entry.map_err(|_| 1)?;\n        let kind = entry.file_type().map_err(|_| 1)?;\n        if !kind.is_file() {\n            continue;\n        }\n        let name = entry.file_name().to_string_lossy().into_owned();\n        let bytes = name.as_bytes();\n        if bytes.len() != 13 || bytes[0] != b'd' || &name[9..] != \".tbl\"\n            || !bytes[1..9].iter().all(u8::is_ascii_digit)\n        {\n            continue;\n        }\n        let day = name[1..9].parse::<i32>().map_err(|_| 1)?;\n        files.push((day, entry.path().to_string_lossy().into_owned()));\n    }\n    files.sort_by_key(|item| item.0);\n    Ok(files)\n}\n\npub fn nlines(path: &str) -> Result<i32, i32> {\n    let text = fs::read_to_string(path).map_err(|_| 1)?;\n    let count = text.lines().filter(|line| !line.trim().is_empty()).count();\n    i32::try_from(count).map_err(|_| 1)\n}\nEOF\ncat > /app/millrib/gait.rs <<'EOF'\nuse std::fs;\n\nfn emit(probe: &str, matched: i32, taken: i32) -> Result<(), i32> {\n    let template = fs::read_to_string(\"/app/millrib/sheet.tpl\").map_err(|_| 1)?;\n    let output = template\n        .replace(\"__P__\", probe)\n        .replace(\"__M__\", &matched.to_string())\n        .replace(\"__T__\", &taken.to_string());\n    fs::create_dir_all(\"/app/bloturn\").map_err(|_| 1)?;\n    fs::write(\"/app/bloturn/check.json\", output).map_err(|_| 1)\n}\n\npub fn gait(total: i32, packed: &[(i32, String)]) -> i32 {\n    let _ = fs::remove_file(\"/app/bloturn/GUARD\");\n    if packed.is_empty() || emit(\"live\", total, total).is_err() {\n        return 1;\n    }\n    if fs::write(\"/app/bloturn/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\nEOF\n"]
