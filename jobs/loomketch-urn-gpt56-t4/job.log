Sending keys: ['cat > /app/urnwalk/walk.rs <<\'EOF\'\nuse std::path::{Path, PathBuf};\n\npub fn gather(a: &str) -> Result<Vec<String>, i32> {\n    let allowed = std::fs::canonicalize("/app/vatlogs").map_err(|_| 2)?;\n    let requested = std::fs::canonicalize(a).map_err(|_| 2)?;\n    if !requested.starts_with(&allowed) || !requested.is_dir() {\n        return Err(2);\n    }\n\n    let mut files = Vec::new();\n    visit(&requested, &allowed, &mut files)?;\n    files.sort();\n    Ok(files.into_iter().map(|p| p.to_string_lossy().into_owned()).collect())\n}\n\nfn visit(dir: &Path, allowed: &Path, out: &mut Vec<PathBuf>) -> Result<(), i32> {\n    let mut entries = Vec::new();\n    for entry in std::fs::read_dir(dir).map_err(|_| 2)? {\n        entries.push(entry.map_err(|_| 2)?.path());\n    }\n    entries.sort();\n\n    for path in entries {\n        let real = std::fs::canonicalize(&path).map_err(|_| 2)?;\n        if !real.starts_with(allowed) {\n            return Err(2);\n        }\n        let meta = std::fs::metadata(&real).map_err(|_| 2)?;\n        if meta.is_dir() {\n            visit(&real, allowed, out)?;\n        } else if meta.is_file() {\n            out.push(real);\n        } else {\n            return Err(2);\n        }\n    }\n    Ok(())\n}\nEOF\n\ncat > /app/treyfun/clip.rs <<\'EOF\'\npub fn clip(frames: &[String]) -> Vec<String> {\n    frames\n        .iter()\n        .filter(|name| {\n            !(name.starts_with("__asan")\n                || name.starts_with("__interceptor")\n                || name.starts_with("__hwasan"))\n        })\n        .map(|name| fold_hex(name))\n        .collect()\n}\n\nfn fold_hex(s: &str) -> String {\n    let bytes = s.as_bytes();\n    let mut out = String::new();\n    let mut i = 0;\n    while i < bytes.len() {\n        if i + 2 < bytes.len()\n            && bytes[i] == b\'0\'\n            && (bytes[i + 1] == b\'x\' || bytes[i + 1] == b\'X\')\n            && bytes[i + 2].is_ascii_hexdigit()\n        {\n            out.push_str("<hex>");\n            i += 2;\n            while i < bytes.len() && bytes[i].is_ascii_hexdigit() {\n                i += 1;\n            }\n        } else {\n            let ch = s[i..].chars().next().unwrap();\n            out.push(ch);\n            i += ch.len_utf8();\n        }\n    }\n    out\n}\n\npub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\n    if text.trim().is_empty() {\n        return Err(3);\n    }\n\n    let mut kind: Option<String> = None;\n    let mut frames = Vec::new();\n    let mut summary = false;\n\n    for line in text.lines() {\n        if let Some(pos) = line.find("ERROR:") {\n            if kind.is_some() {\n                return Err(3);\n            }\n            let rest = line[pos + "ERROR:".len()..].trim();\n            let after = rest\n                .strip_prefix("AddressSanitizer:")\n                .unwrap_or(rest)\n                .trim();\n            let value = after.split(" on ").next().unwrap_or(after).trim();\n            if value.is_empty() {\n                return Err(3);\n            }\n            kind = Some(value.to_string());\n        }\n\n        let trimmed = line.trim_start();\n        if trimmed.starts_with("SUMMARY: AddressSanitizer") {\n            summary = true;\n        }\n        if trimmed.starts_with(\'#\') {\n            let number_end = trimmed[1..]\n                .find(|c: char| !c.is_ascii_digit())\n                .map(|n| n + 1)\n                .unwrap_or(trimmed.len());\n            if number_end == 1 {\n                return Err(3);\n            }\n            let after = trimmed[number_end..].trim_start();\n            let in_pos = after.find(" in ").ok_or(3)?;\n            let sym = after[in_pos + 4..].split_whitespace().next().unwrap_or("");\n            if sym.is_empty() {\n                return Err(3);\n            }\n            frames.push(sym.to_string());\n        }\n    }\n\n    if !summary || frames.is_empty() {\n        return Err(3);\n    }\n    Ok((kind.ok_or(3)?, frames))\n}\nEOF\n\ncat > /app/qanbox/tally.rs <<\'EOF\'\n#[path = "../treyfun/clip.rs"]\nmod clip;\n\nuse std::collections::BTreeMap;\n\n#[derive(Clone)]\npub struct Rec {\n    pub issue: i32,\n    pub kind: String,\n    pub frames: Vec<String>,\n    pub body: String,\n}\n\npub fn tally(root: &str) -> Result<Vec<Rec>, i32> {\n    let paths = crate::walk::gather(root)?;\n    let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\n\n    for path in paths {\n        let text = std::fs::read_to_string(path).map_err(|_| 3)?;\n        let (kind, raw_frames) = clip::take(&text)?;\n        let frames = clip::clip(&raw_frames);\n        if frames.is_empty() {\n            return Err(3);\n        }\n        let body = frames.join(" | ");\n        let rec = Rec { issue: 0, kind, frames: frames.clone(), body };\n        if let Some(old) = bag.get(&frames) {\n            if old.kind != rec.kind {\n                return Err(3);\n            }\n        } else {\n            bag.insert(frames, rec);\n        }\n    }\n\n    let mut recs: Vec<Rec> = bag.into_values().collect();\n    recs.sort_by(|a, b| a.body.cmp(&b.body).then_with(|| a.kind.cmp(&b.kind)));\n    for (index, rec) in recs.iter_mut().enumerate() {\n        rec.issue = index as i32 + 1;\n    }\n    Ok(recs)\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
