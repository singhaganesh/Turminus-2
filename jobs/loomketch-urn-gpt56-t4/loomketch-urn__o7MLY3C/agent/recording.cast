[10.706011, "o", "total 4064\r\ndrwxr-xr-x 2 root root    4096 Sep 11 13:29 .\r\ndrwxr-xr-x 1 root root    4096 Sep 11 13:29 ..\r\n-rwxr-xr-x 1 root root 4151576 Sep 11 13:29 loomketch\r\n\r\n/app/deskcue:\r\ntotal 12\r\ndrwxr-xr-x 2 root root 4096 Sep 11 13:29 .\r\ndrwxr-xr-x 1 root root 4096 Sep 11 13:29 ..\r\n-rw-rw-r-- 1 root root  844 Sep 11 13:29 MAP.txt\r\n\r\n/app/inkbay:\r\n"]
