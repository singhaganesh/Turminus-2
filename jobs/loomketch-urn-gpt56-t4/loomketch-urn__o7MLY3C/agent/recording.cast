[90.194235, "o", "        entries.push(entry.map_err(|_| 2)?.path());\r\n\u001b[?2004l\r"]
[90.194362, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[90.194475, "o", "\u001b[?2004h>     entries.sort();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[90.194596, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[90.194627, "o", "    for path in entries {\r\n\u001b[?2004l\r"]
[90.194654, "o", "\u001b[?2004h> "]
[90.194959, "o", "        let real = std::fs::canonicalize(&path).map_err(|_| 2)?;\r\n\u001b[?2004l\r"]
[90.1952, "o", "\u001b[?2004h>         if !real.starts_with(allowed) {\r\n\u001b[?2004l\r"]
[90.195266, "o", "\u001b[?2004h> "]
[90.195481, "o", "            return Err(2);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.195507, "o", "> "]
[90.195782, "o", "        let meta = std::fs::metadata(&real).map_err(|_| 2)?;\r\n\u001b[?2004l\r"]
[90.195882, "o", "\u001b[?2004h> "]
[90.195998, "o", "        if meta.is_dir() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.196127, "o", ">             visit(&real, allowed, out)?;\r\n\u001b[?2004l\r"]
[90.196271, "o", "\u001b[?2004h> "]
[90.196371, "o", "        } else if meta.is_file() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.196474, "o", "            out.push(real);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.196551, "o", "        } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.196638, "o", "            return Err(2);\r\n\u001b[?2004l\r"]
[90.196691, "o", "\u001b[?2004h> "]
[90.196739, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.196786, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.196861, "o", ">     Ok(())\r\n\u001b[?2004l\r"]
[90.196917, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[90.19697, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[90.198322, "o", "\u001b[?2004hroot@bfbb46864d5d:/app# \r\n\u001b[?2004l\r"]
[90.198402, "o", "\u001b[?2004hroot@bfbb46864d5d:/app# "]
[90.198462, "o", "cat > /app/treyfun/clip.rs <<'EOF'\r\n\u001b[?2004l\r"]
[90.198541, "o", "\u001b[?2004h> "]
[90.198674, "o", "pub fn clip(frames: &[String]) -> Vec<String> {\r\n\u001b[?2004l\r"]
[90.19875, "o", "\u001b[?2004h>     frames\r\n\u001b[?2004l\r"]
[90.198857, "o", "\u001b[?2004h>         .iter()\r\n\u001b[?2004l\r"]
[90.198942, "o", "\u001b[?2004h> "]
[90.199042, "o", "        .filter(|name| {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.199153, "o", "            !(name.starts_with(\"__asan\")\r\n\u001b[?2004l\r"]
[90.199232, "o", "\u001b[?2004h> "]
[90.199335, "o", "                || name.starts_with(\"__interceptor\")\r\n\u001b[?2004l\r"]
[90.19942, "o", "\u001b[?2004h"]
[90.199844, "o", ">                 || name.starts_with(\"__hwasan\"))\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>         .map(|name| fold_hex(name))\r\n\u001b[?2004l\r\u001b[?2004h>         .collect()\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.199921, "o", "fn fold_hex(s: &str) -> String {\r\n\u001b[?2004l\r"]
[90.199946, "o", "\u001b[?2004h> "]
[90.200029, "o", "    let bytes = s.as_bytes();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.200111, "o", "    let mut out = String::new();\r\n\u001b[?2004l\r"]
[90.200134, "o", "\u001b[?2004h> "]
[90.200222, "o", "    let mut i = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.200324, "o", "    while i < bytes.len() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.200396, "o", "        if i + 2 < bytes.len()\r\n\u001b[?2004l\r"]
[90.200458, "o", "\u001b[?2004h> "]
[90.200508, "o", "            && bytes[i] == b'0'\r\n\u001b[?2004l\r"]
[90.200559, "o", "\u001b[?2004h> "]
[90.200685, "o", "            && (bytes[i + 1] == b'x' || bytes[i + 1] == b'X')\r\n\u001b[?2004l\r"]
[90.200756, "o", "\u001b[?2004h> "]
[90.20086, "o", "            && bytes[i + 2].is_ascii_hexdigit()\r\n\u001b[?2004l\r"]
[90.200949, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.201057, "o", "            out.push_str(\"<hex>\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.201155, "o", "            i += 2;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.20133, "o", "            while i < bytes.len() && bytes[i].is_ascii_hexdigit() {\r\n\u001b[?2004l\r"]
[90.201404, "o", "\u001b[?2004h> "]
[90.201449, "o", "                i += 1;\r\n\u001b[?2004l\r"]
[90.201562, "o", "\u001b[?2004h"]
[90.201588, "o", ">             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.201614, "o", "        } else {\r\n\u001b[?2004l\r"]
[90.20164, "o", "\u001b[?2004h> "]
[90.201797, "o", "            let ch = s[i..].chars().next().unwrap();\r\n\u001b[?2004l\r"]
[90.201901, "o", "\u001b[?2004h> "]
[90.201974, "o", "            out.push(ch);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.202066, "o", "            i += ch.len_utf8();\r\n\u001b[?2004l\r"]
[90.202147, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[90.202244, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.202325, "o", "    out\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[90.202386, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.20251, "o", "pub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\r\n\u001b[?2004l\r"]
[90.202557, "o", "\u001b[?2004h> "]
[90.202632, "o", "    if text.trim().is_empty() {\r\n\u001b[?2004l\r"]
[90.202677, "o", "\u001b[?2004h> "]
[90.202731, "o", "        return Err(3);\r\n\u001b[?2004l\r"]
[90.20278, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[90.202867, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.202958, "o", "    let mut kind: Option<String> = None;\r\n\u001b[?2004l\r"]
[90.203015, "o", "\u001b[?2004h> "]
[90.203077, "o", "    let mut frames = Vec::new();\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.203139, "o", "> "]
[90.203206, "o", "    let mut summary = false;\r\n\u001b[?2004l\r"]
[90.20326, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.203319, "o", "    for line in text.lines() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.203429, "o", "        if let Some(pos) = line.find(\"ERROR:\") {\r\n\u001b[?2004l\r"]
[90.203473, "o", "\u001b[?2004h> "]
[90.203528, "o", "            if kind.is_some() {\r\n\u001b[?2004l\r"]
[90.20357, "o", "\u001b[?2004h> "]
[90.203637, "o", "                return Err(3);\r\n\u001b[?2004l\r"]
[90.203675, "o", "\u001b[?2004h> "]
[90.203713, "o", "            }\r\n\u001b[?2004l\r"]
[90.203754, "o", "\u001b[?2004h> "]
[90.203916, "o", "            let rest = line[pos + \"ERROR:\".len()..].trim();\r\n\u001b[?2004l\r"]
[90.203993, "o", "\u001b[?2004h> "]
[90.204059, "o", "            let after = rest\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.204231, "o", "                .strip_prefix(\"AddressSanitizer:\")\r\n\u001b[?2004l\r"]
[90.204296, "o", "\u001b[?2004h> "]
[90.204369, "o", "                .unwrap_or(rest)\r\n\u001b[?2004l\r"]
[90.204427, "o", "\u001b[?2004h> "]
[90.204487, "o", "                .trim();\r\n\u001b[?2004l\r"]
[90.204544, "o", "\u001b[?2004h> "]
[90.204723, "o", "            let value = after.split(\" on \").next().unwrap_or(after).trim();\r\n\u001b[?2004l\r"]
[90.204779, "o", "\u001b[?2004h> "]
[90.204877, "o", "            if value.is_empty() {\r\n\u001b[?2004l\r"]
[90.204943, "o", "\u001b[?2004h> "]
[90.205057, "o", "                return Err(3);\r\n\u001b[?2004l\r"]
[90.205155, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.205297, "o", "            kind = Some(value.to_string());\r\n\u001b[?2004l\r"]
[90.205387, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[90.205465, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.205534, "o", "        let trimmed = line.trim_start();\r\n\u001b[?2004l\r"]
[90.205592, "o", "\u001b[?2004h> "]
[90.205749, "o", "        if trimmed.starts_with(\"SUMMARY: AddressSanitizer\") {\r\n\u001b[?2004l\r"]
[90.205854, "o", "\u001b[?2004h> "]
[90.205939, "o", "            summary = true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.206011, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.206121, "o", "        if trimmed.starts_with('#') {\r\n\u001b[?2004l\r"]
[90.206153, "o", "\u001b[?2004h> "]
[90.207921, "o", "            let number_end = trimmed[1..]\r\n\u001b[?2004l\r\u001b[?2004h>                 .find(|c: char| !c.is_ascii_digit())\r\n\u001b[?2004l\r\u001b[?2004h>                 .map(|n| n + 1)\r\n\u001b[?2004l\r\u001b[?2004h>                 .unwrap_or(trimmed.len());\r\n\u001b[?2004l\r\u001b[?2004h>             if number_end == 1 {\r\n\u001b[?2004l\r\u001b[?2004h>                 return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             let after = trimmed[number_end..].trim_start();\r\n\u001b[?2004l\r\u001b[?2004h>             let in_pos = after.find(\" in \").ok_or(3)?;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.208144, "o", "            let sym = after[in_pos + 4..].split_whitespace().next().unwrap_or(\"\");\r\n\u001b[?2004l\r\u001b[?2004h>             if sym.is_empty() {\r\n\u001b[?2004l\r"]
[90.209577, "o", "\u001b[?2004h>                 return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>             frames.push(sym.to_string());\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if !summary || frames.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     Ok((kind.ok_or(3)?, frames))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[90.211853, "o", "\u001b[?2004hroot@bfbb46864d5d:/app# \r\n\u001b[?2004l\r"]
[90.211922, "o", "\u001b[?2004hroot@bfbb46864d5d:/app# "]
[90.212103, "o", "cat > /app/qanbox/tally.rs <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.212128, "o", "#[path = \"../treyfun/clip.rs\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.212235, "o", "mod clip;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.212327, "o", "use std::collections::BTreeMap;\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.212351, "o", "> \r\n\u001b[?2004l\r"]
[90.21237, "o", "\u001b[?2004h"]
[90.21239, "o", "> "]
[90.212843, "o", "#[derive(Clone)]\r\n\u001b[?2004l\r\u001b[?2004h> pub struct Rec {\r\n\u001b[?2004l\r\u001b[?2004h>     pub issue: i32,\r\n\u001b[?2004l\r\u001b[?2004h>     pub kind: String,\r\n\u001b[?2004l\r\u001b[?2004h>     pub frames: Vec<String>,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.21294, "o", "    pub body: String,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.212973, "o", "\u001b[?2004h> "]
[90.213136, "o", "pub fn tally(root: &str) -> Result<Vec<Rec>, i32> {\r\n\u001b[?2004l\r"]
[90.213225, "o", "\u001b[?2004h> "]
[90.214868, "o", "    let paths = crate::walk::gather(root)?;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut bag: BTreeMap<Vec<String>, Rec> = BTreeMap::new();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for path in paths {\r\n\u001b[?2004l\r\u001b[?2004h>         let text = std::fs::read_to_string(path).map_err(|_| 3)?;\r\n\u001b[?2004l\r\u001b[?2004h>         let (kind, raw_frames) = clip::take(&text)?;\r\n\u001b[?2004l\r\u001b[?2004h>         let frames = clip::clip(&raw_frames);\r\n\u001b[?2004l\r\u001b[?2004h>         if frames.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h>             return Err(3);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         let body = frames.join(\" | \");\r\n\u001b[?2004l\r\u001b[?2004h>         let rec = Rec { issue: 0, kind, frames: frames.clone(), body };\r\n\u001b[?2004l\r\u001b[?2004h>         if let Some(old) = bag.get(&frames) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.215009, "o", "            if old.kind != rec.kind {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.215124, "o", "                return Err(3);\r\n\u001b[?2004l\r"]
[90.215158, "o", "\u001b[?2004h> "]
[90.21533, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.215486, "o", "            bag.insert(frames, rec);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.215644, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.215816, "o", "    let mut recs: Vec<Rec> = bag.into_values().collect();\r\n\u001b[?2004l\r"]
[90.215892, "o", "\u001b[?2004h> "]
[90.21606, "o", "    recs.sort_by(|a, b| a.body.cmp(&b.body).then_with(|| a.kind.cmp(&b.kind)));\r\n\u001b[?2004l\r"]
[90.216126, "o", "\u001b[?2004h> "]
[90.21625, "o", "    for (index, rec) in recs.iter_mut().enumerate() {\r\n\u001b[?2004l\r"]
[90.216284, "o", "\u001b[?2004h"]
[90.216376, "o", "> "]
[90.216403, "o", "        rec.issue = index as i32 + 1;\r\n"]
[90.216421, "o", "\u001b[?2004l\r"]
[90.216454, "o", "\u001b[?2004h> "]
[90.216478, "o", "    }"]
[90.216627, "o", "\r\n\u001b[?2004l\r"]
[90.216653, "o", "\u001b[?2004h>     Ok(recs)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[90.216705, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[90.218744, "o", "\u001b[?2004hroot@bfbb46864d5d:/app# "]
[90.333187, "i", "cat > /app/humdock/emit.rs <<'EOF'\nuse crate::tally::Rec;\n\npub fn emit(rows: &[Rec]) -> i32 {\n    if std::fs::create_dir_all(\"/app/inkbay\").is_err() {\n        return 1;\n    }\n\n    let mut inner = String::new();\n    for (i, rec) in rows.iter().enumerate() {\n        if i != 0 { inner.push(','); }\n        inner.push_str(&format!(\n            \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\n            rec.issue, jstr(&rec.kind), jarr(&rec.frames), jstr(&rec.body)\n        ));\n    }\n    let template = std::fs::read_to_string(\"/app/tplbay/bound.tpl\")\n        .unwrap_or_else(|_| \"{\\\"findings\\\":[__ROWS__]}\".to_string());\n    if !template.contains(\"__ROWS__\") {\n        return 1;\n    }\n    let bound = template.replace(\"__ROWS__\", &inner);\n\n    let mut desk = String::from(\"issue\\tkind\\tbody\\n\");\n    for rec in rows {\n        if rec.kind.contains(['\\t', '\\n', '\\r']) || rec.body.contains(['\\t', '\\n', '\\r']) {\n            return 1;\n        }\n        desk.push_str(&format!(\"{}\\t{}\\t{}\\n\", rec.issue, rec.kind, rec.body));\n    }\n\n    let bound_tmp = \"/app/inkbay/.bound.json.tmp\";\n    let desk_tmp = \"/app/inkbay/.desk.tsv.tmp\";\n    if std::fs::write(bound_tmp, bound).is_err()\n        || std::fs::write(desk_tmp, desk).is_err()\n        || std::fs::rename(bound_tmp, \"/app/inkbay/bound.json\").is_err()\n        || std::fs::rename(desk_tmp, \"/app/inkbay/desk.tsv\").is_err()\n    {\n        let _ = std::fs::remove_file(bound_tmp);\n        let _ = std::fs::remove_file(desk_tmp);\n        return 1;\n    }\n    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\n        return 1;\n    }\n    0\n}\n\nfn jstr(s: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for ch in s.chars() {\n        match ch {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c < ' ' => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\nfn jarr(values: &[String]) -> String {\n    format!(\"[{}]\", values.iter().map(|v| jstr(v)).collect::<Vec<_>>().join(\",\"))\n}\nEOF\n\npython3 - <<'PY'\np='/app/ketchcli/main.rs'\ns=open(p).read()\ns=s.replace('    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\\n', '    let root = args.next().unwrap_or_else(|| \"/app/vatlogs\".to_string());\\n    let _ = std::fs::remove_file(\"/app/inkbay/GUARD\");\\n')\nopen(p,'w').write(s)\nPY\n/app/hearth.sh\nod -An -tx1 -N4 /app/bin/loomketch\n/app/bin/loomketch bind; echo status=$?\nsha256sum /app/inkbay/bound.json /app/inkbay/desk.tsv\ncat /app/inkbay/bound.json; echo; cat /app/inkbay/desk.tsv; od -An -tx1 -c /app/inkbay/GUARD\n"]
