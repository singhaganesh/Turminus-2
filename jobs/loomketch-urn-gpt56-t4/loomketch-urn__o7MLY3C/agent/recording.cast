[30.473719, "o", "     1\tpub fn gather(a: &str) -> Result<Vec<String>, i32> {\r\n     2\t    let mut v = Vec::new();\r\n     3\t    let rd = match std::fs::read_dir(a) {\r\n     4\t        Ok(x) => x,\r\n     5\t        Err(_) => return Err(2),\r\n     6\t    };\r\n     7\t    for e in rd {\r\n     8\t        let e = match e {\r\n     9\t            Ok(x) => x,\r\n    10\t            Err(_) => continue,\r\n    11\t        };\r\n    12\t        let p = e.path();\r\n    13\t        if p.is_file() {\r\n    14\t            v.push(p.to_string_lossy().into_owned());\r\n    15\t        }\r\n    16\t    }\r\n"]
[30.473806, "o", "    17\t    if crate::alpha::lined(&mut v) {\r\n    18\t        v.sort();\r\n    19\t    }\r\n    20\t    Ok(v)\r\n    21\t}\r\n"]
