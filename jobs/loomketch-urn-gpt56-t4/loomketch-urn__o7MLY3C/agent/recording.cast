[30.46416, "o", "===== clip.rs =====\r\n"]
[30.46846, "o", "     1\tpub fn clip(a: &[String]) -> Vec<String> {\r\n     2\t    a.iter()\r\n     3\t        .filter(|s| !s.starts_with(\"__asan::\") && !s.starts_with(\"__asan_\"))\r\n     4\t        .cloned()\r\n     5\t        .collect()\r\n     6\t}\r\n     7\t\r\n     8\tpub fn take(text: &str) -> Result<(String, Vec<String>), i32> {\r\n     9\t    if text.trim().is_empty() {\r\n    10\t        return Ok((String::new(), Vec::new()));\r\n    11\t    }\r\n    12\t    let mut kind = String::new();\r\n    13\t    let mut frames = Vec::new();\r\n    14\t    for line in text.lines() {\r\n    15\t        if let Some(rest) = line.split(\"ERROR:\").nth(1) {\r\n    16\t            let rest = rest.trim();\r\n"]
[30.468618, "o", "    17\t            let after = if let Some(x) = rest.split(\"AddressSanitizer:\").nth(1) {\r\n    18\t                x.trim()\r\n    19\t            } else {\r\n    20\t                rest\r\n    21\t            };\r\n    22\t            kind = after.split(\" on \").next().unwrap_or(after).trim().to_string();\r\n    23\t        }\r\n    24\t        if let Some(idx) = line.find('#') {\r\n    25\t            let chunk = &line[idx..];\r\n    26\t            if let Some(after) = chunk.split(\" in \").nth(1) {\r\n    27\t                let sym = after.split_whitespace().next().unwrap_or(\"\").to_string();\r\n    28\t                if !sym.is_empty() {\r\n    29\t                    frames.push(sym);\r\n    30\t                }\r\n    31\t            }\r\n    32\t        }\r\n    33\t    }\r\n    34\t    Ok((kind, frames))\r\n    35\t}\r\n"]
[30.468878, "o", "===== emit.rs =====\r\n"]
[30.469995, "o", "     1\tuse crate::tally::Rec;\r\n     2\t\r\n     3\tpub fn emit(a: &[Rec]) -> i32 {\r\n     4\t    let mut rows: Vec<Rec> = a.to_vec();\r\n     5\t    rows.sort_by(|x, y| x.kind.cmp(&y.kind));\r\n     6\t    let mut out = String::from(\"issue\\tkind\\tbody\\n\");\r\n     7\t    for (i, r) in rows.iter().enumerate() {\r\n     8\t        out.push_str(&format!(\"{}\\t{}\\t{}\\n\", i + 1, r.kind, r.body));\r\n     9\t    }\r\n    10\t    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    11\t    if std::fs::write(\"/app/inkbay/desk.tsv\", out).is_err() {\r\n    12\t        return 1;\r\n    13\t    }\r\n    14\t    if std::fs::write(\"/app/inkbay/GUARD\", \"ok\").is_err() {\r\n    15\t        return 1;\r\n    16\t    }\r\n    17\t    0\r\n    18\t}\r\n"]
[30.470354, "o", "===== tally.rs =====\r\n"]
[30.471878, "o", "     1\t#[path = \"../treyfun/clip.rs\"]\r\n     2\tmod clip;\r\n     3\t\r\n     4\tuse std::collections::HashMap;\r\n     5\tuse std::sync::mpsc;\r\n     6\tuse std::thread;\r\n     7\t\r\n     8\t#[derive(Clone)]\r\n     9\tpub struct Rec {\r\n    10\t    pub issue: i32,\r\n    11\t    pub kind: String,\r\n    12\t    pub frames: Vec<String>,\r\n    13\t    pub body: String,\r\n    14\t}\r\n    15\t\r\n    16\tpub fn tally(a: &str) -> Result<Vec<Rec>, i32> {\r\n    17\t    let paths = crate::walk::gather(a)?;\r\n    18\t    let (tx, rx) = mpsc::channel();\r\n    19\t    let mut hs = Vec::new();\r\n    20\t    for p in paths {\r\n    21\t        let tx = tx.clone();\r\n    22\t        hs.push(thread::spawn(move || {\r\n    23\t            let text = match std::fs::read_to_string(&p) {\r\n    24\t                Ok(t) => t,\r\n    25\t                Err(_) => return,\r\n    26\t            };\r\n    27\t            let (kind, frames) = match clip::take(&text) {\r\n"]
[30.472165, "o", "    28\t                Ok(x) => x,\r\n    29\t                Err(_) => return,\r\n    30\t            };\r\n    31\t            if kind.is_empty() {\r\n    32\t                return;\r\n    33\t            }\r\n    34\t            let frames = clip::clip(&frames);\r\n    35\t            let body = frames.join(\" | \");\r\n    36\t            let _ = tx.send(Rec {\r\n    37\t                issue: 0,\r\n    38\t                kind,\r\n    39\t                frames,\r\n    40\t                body,\r\n    41\t            });\r\n    42\t        }));\r\n    43\t    }\r\n    44\t    drop(tx);\r\n    45\t    for h in hs {\r\n    46\t        let _ = h.join();\r\n    47\t    }\r\n    48\t    let mut bag: HashMap<String, Rec> = HashMap::new();\r\n    49\t    while let Ok(r) = rx.recv() {\r\n    50\t        bag.entry(r.body.clone()).or_insert(r);\r\n    51\t    }\r\n    52\t    let mut recs: Vec<Rec> = bag.into_values().collect();\r\n    53\t    for (i, r) in recs.iter_mut().enumerate() {\r\n    54\t        r.issue = (i as i32) + 1;\r\n    55\t    }\r\n    56\t    let _ = write_bound(&recs);\r\n    57\t    Ok(recs)\r\n    58\t}\r\n    59\t\r\n    60\tfn write_bound(recs: &[Rec]) -> i32 {\r\n    61\t    let tpl = std::fs::read_to_string(\"/app/tplbay/bound.tpl\").unwrap_or_else(|_| \"{\\\"findings\\\":[__ROWS__]}\".into());\r\n    62\t    if recs.is_empty() {\r\n    63\t        let _ = std::fs::write(\"/app/inkbay/bound.json\", tpl);\r\n    64\t        return 0;\r\n    65\t    }\r\n    66\t    let mut inner = String::new();\r\n    67\t    for (i, r) in recs.iter().enumerate() {\r\n    68\t        if i > 0 {\r\n    69\t            inner.push(',');\r\n    70\t        }\r\n    71\t        inner.push_str(&format!(\r\n    72\t            \"{{\\\"issue\\\":{},\\\"kind\\\":{},\\\"frames\\\":{},\\\"body\\\":{}}}\",\r\n    73\t            r.issue,\r\n    74\t            jstr(&r.kind),\r\n    75\t            jarr(&r.frames),\r\n    76\t            jstr(&r.body)\r\n    77\t        ));\r\n    78\t    }\r\n    79\t    let out = tpl.replace(\"__ROWS__\", &inner);\r\n    80\t    let _ = std::fs::create_dir_all(\"/app/inkbay\");\r\n    81\t    match std::fs::write(\"/app/inkbay/bound.json\", out) {\r\n    82\t        Ok(()) => 0,\r\n    83\t        Err(_) => 1,\r\n    84\t    }\r\n    85\t}\r\n    86\t\r\n    87\tfn jstr(s: &str) -> String {\r\n    88\t    format!(\"\\\"{}\\\"\", s.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\"))\r\n    89\t}\r\n    90\t\r\n    91\tfn jarr(v: &[String]) -> String {\r\n    92\t    let parts: Vec<String> = v.iter().map(|x| jstr(x)).collect();\r\n    93\t    format!(\"[{}]\", parts.join(\",\"))\r\n    94\t}\r\n"]
