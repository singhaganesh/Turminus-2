[137.555771, "i", "python3 - <<'PY'\nimport json, csv\nwith open('/app/inkbay/bound.json') as f: data=json.load(f)['findings']\nwith open('/app/inkbay/desk.tsv', newline='') as f: desk=list(csv.DictReader(f, delimiter='\\t'))\nassert [r['issue'] for r in data] == list(range(1,len(data)+1))\nassert [(str(r['issue']),r['kind'],r['body']) for r in data] == [(r['issue'],r['kind'],r['body']) for r in desk]\nassert all(not any(x.startswith(('__asan','__interceptor','__hwasan')) for x in r['frames']) for r in data)\nprint('json-tsv consistency ok:', len(data), 'findings')\nPY\ncp /app/inkbay/bound.json /tmp/good.bound; cp /app/inkbay/desk.tsv /tmp/good.desk\n"]
[137.556061, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[137.558755, "o", "\u001b[?2004h> import json, csv\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/inkbay/bound.json') as f: data=json.load(f)['findings']\r\n\u001b[?2004l\r\u001b[?2004h> with open('/app/inkbay/desk.tsv', newline='') as f: desk=list(csv.DictReader(f, delimiter='\\t'))\r\n\u001b[?2004l\r\u001b[?2004h> assert [r['issue'] for r in data] == list(range(1,len(data)+1))\r\n\u001b[?2004l\r\u001b[?2004h> assert [(str(r['issue']),r['kind'],r['body']) for r in data] == [(r['issue'],r['kind'],r['body']) for r in desk]\r\n\u001b[?2004l\r\u001b[?2004h> assert all(not any(x.startswith(('__asan','__interceptor','__hwasan')) for x in r['frames']) for r in data)\r\n\u001b[?2004l\r\u001b[?2004h> print('json-tsv consistency ok:', len(data), 'findings')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
