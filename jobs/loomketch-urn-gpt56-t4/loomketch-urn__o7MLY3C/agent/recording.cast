[18.610568, "o", "===== /app/opsfold/SHIFT.txt =====\r\n"]
[18.611875, "o", "Night notes\r\n\r\nbind looked noisy when the vat directory came back in a different order.\r\nSomeone exported KETCH_ALPHA=1 so walkcue would line the paths up.\r\nSmoke still printed every finding. Desk citations still jumped on the next bind.\r\n"]
[18.612136, "o", "===== /app/tplbay/bound.tpl =====\r\n"]
[18.61305, "o", "{\"findings\":[__ROWS__]}\r\n"]
[18.613316, "o", "===== /app/tplbay/desk.tpl =====\r\n"]
[18.61432, "o", "issue\tkind\tbody\r\n"]
