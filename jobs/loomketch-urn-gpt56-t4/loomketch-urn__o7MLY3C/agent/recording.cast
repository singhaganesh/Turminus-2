[18.60181, "o", "for f in /app/hearth.sh /app/ketchcli/NOTES.txt /app/ketchcli/usage.txt /app/urnwalk/README.txt /app/opsfold/PRIOR.txt /app/opsfold/SHIFT.txt /app/tplbay/bound.tpl /app/tplbay/desk.tpl; do echo \"===== $f =====\"; cat \"$f\"; done\r\n\u001b[?2004l\r"]
