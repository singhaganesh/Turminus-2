[18.604094, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin /app/inkbay\r\nrustc --edition 2021 -O /app/ketchcli/main.rs -o /app/bin/loomketch\r\n"]
