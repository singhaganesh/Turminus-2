[70.773076, "i", "cat > /app/hitchbay/RibChan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.channels.FileChannel;\nimport java.nio.file.Path;\nimport java.nio.file.StandardOpenOption;\n\npublic class RibChan {\n    final Path file;\n    byte[] pending = new byte[0];\n\n    RibChan(Path file) { this.file = file; }\n\n    void append(byte[] x) { pending = x.clone(); }\n\n    void force() throws Exception {\n        if (pending.length == 0) return;\n        try (FileChannel ch = FileChannel.open(file, StandardOpenOption.CREATE,\n                StandardOpenOption.WRITE, StandardOpenOption.APPEND)) {\n            ByteBuffer b = ByteBuffer.wrap(pending);\n            while (b.hasRemaining()) ch.write(b);\n            ch.force(true);\n        }\n        pending = new byte[0];\n    }\n}\nEOF\npython3 - <<'PY'\np='/app/recipit/LoomCue.java'\ns=open(p).read().replace('steps.sort(Comparator.comparingInt(x -> x.compute));','steps.sort(Comparator.comparingInt(x -> x.durable));')\nopen(p,'w').write(s)\nPY\ncat > /app/hitchbay/StowRun.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.nio.file.Paths;\nimport java.security.MessageDigest;\n\npublic class StowRun {\n    static final int ALIGN = 32;\n    static class CutErr extends Exception { private static final long serialVersionUID = 1L; }\n\n    static void run(Path slip, boolean cut) throws Exception {\n        byte[] payload = Files.readAllBytes(slip);\n        Path silo = Paths.get(\"/app/silo\");\n        Files.createDirectories(silo);\n        Path blob = silo.resolve(\"blob.bin\");\n        Path pin = silo.resolve(\"pin.bin\");\n        if (!Files.exists(blob)) Files.createFile(blob);\n        if (!Files.exists(pin)) Files.createFile(pin);\n        long offset = Files.size(blob);\n        int len = payload.length;\n        int rec = 4 + len;\n        int pad = (ALIGN - rec % ALIGN) % ALIGN;\n\n        ByteBuffer body = ByteBuffer.allocate(rec + pad);\n        body.putInt(len).put(payload).put(new byte[pad]);\n        ByteBuffer row = ByteBuffer.allocate(48);\n        row.put(new byte[] {'P','N','0','1'}).putLong(offset).putInt(len)\n           .putInt(Crc.of(payload)).put(idOf(payload)).put(new byte[12]);\n\n        RibChan bch = new RibChan(blob);\n        RibChan pch = new RibChan(pin);\n        bch.append(body.array());\n        pch.append(row.array());\n        int n = 0;\n        for (String name : ForceSeq.names()) {\n            if (\"blob\".equals(name)) bch.force();\n            else if (\"pin\".equals(name)) pch.force();\n            else throw new IllegalStateException(\"unknown force step: \" + name);\n            if (cut && ++n == 1) throw new CutErr();\n        }\n    }\n\n    static byte[] idOf(byte[] payload) throws Exception {\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\n        byte[] id = new byte[16];\n        System.arraycopy(digest, 0, id, 0, id.length);\n        return id;\n    }\n\n    public static void main(String[] args) throws Exception {\n        if (args.length != 1) System.exit(2);\n        run(Paths.get(args[0]), false);\n    }\n}\nEOF\n"]
