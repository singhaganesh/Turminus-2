[10.240073, "o", "#!/bin/bash\r\nset -euo pipefail\r\nJAVA=\"${JAVA_HOME:-/opt/java/openjdk}/bin/java\"\r\nif [ ! -x \"$JAVA\" ]; then\r\n  JAVA=java\r\nfi\r\nverb=\"${1:-}\"\r\nshift || true\r\ncase \"$verb\" in\r\n  tamp)\r\n    exec /app/brimvat.sh\r\n"]
[10.240196, "o", "    ;;\r\n  lade|wake|pull|nick)\r\n    exec \"$JAVA\" -cp /app/blastcp DeskMain \"$verb\" \"$@\"\r\n    ;;\r\n  *)\r\n    exit 2\r\n    ;;\r\nesac\r\n"]
