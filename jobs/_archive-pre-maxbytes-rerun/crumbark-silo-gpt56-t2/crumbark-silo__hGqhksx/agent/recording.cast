[18.879144, "o", "     1\tpublic class DeskMain {\r\n     2\t    public static void main(String[] args) throws Exception {\r\n     3\t        if (args.length < 1) {\r\n     4\t            System.exit(2);\r\n     5\t        }\r\n     6\t        String verb = args[0];\r\n"]
[18.879168, "o", "     7\t        String[] rest = new String[Math.max(0, args.length - 1)];\r\n     8\t        if (args.length > 1) {\r\n     9\t            System.arraycopy(args, 1, rest, 0, rest.length);\r\n    10\t        }\r\n    11\t        if (\"lade\".equals(verb)) {\r\n    12\t            StowRun.main(rest);\r\n    13\t        } else if (\"wake\".equals(verb)) {"]
[18.879181, "o", "\r\n    14\t            StirRun.main(rest);\r\n    15\t        } else if (\"pull\".equals(verb)) {\r\n    16\t            YankRun.main(rest);\r\n"]
[18.879199, "o", "    17\t        } else if (\"nick\".equals(verb)) {\r\n    18\t            CutRun.main(rest);\r\n    19\t        } else {\r\n    20\t            System.exit(2);\r\n    21\t        }\r\n    22\t    }\r\n"]
[18.879214, "o", "    23\t}\r\n"]
[18.879379, "o", "\r\n===== /app/hitchbay/RibChan.java =====\r\n"]
[18.880228, "o", "     1\timport java.io.ByteArrayOutputStream;\r\n     2\timport java.nio.file.Files;\r\n     3\timport java.nio.file.Path;\r\n     4\timport java.nio.file.StandardOpenOption;\r\n     5\t\r\n     6\tpublic class RibChan {\r\n     7\t    final Path file;\r\n     8\t    final ByteArrayOutputStream pending = new ByteArrayOutputStream();\r\n"]
[18.880345, "o", "     9\t\r\n    10\t    RibChan(Path file) {\r\n    11\t        this.file = file;\r\n    12\t    }\r\n    13\t\r\n    14\t    void append(byte[] x) throws Exception {\r\n    15\t        pending.write(x);\r\n    16\t    }\r\n    17\t\r\n    18\t    void force() throws Exception {\r\n    19\t        byte[] out = pending.toByteArray();\r\n    20\t        if (out.length == 0) {\r\n    21\t            return;\r\n    22\t        }\r\n    23\t        Files.write(file, out, StandardOpenOption.CREATE, StandardOpenOption.APPEND);\r\n    24\t        pending.reset();\r\n    25\t    }\r\n    26\t}\r\n"]
[18.880492, "o", "\r\n===== /app/hitchbay/StirRun.java =====\r\n"]
