[70.955471, "i", "cat > /app/siltpage/MistSpan.java <<'EOF'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.MessageDigest;\nimport java.util.Arrays;\n\npublic class MistSpan {\n    static final int ALIGN = 32;\n    static final int ROW = 48;\n    static final byte[] MAGIC = {'P','N','0','1'};\n\n    static final class Record {\n        final byte[] id;\n        final byte[] payload;\n        Record(byte[] id, byte[] payload) { this.id = id; this.payload = payload; }\n    }\n\n    static Record read(byte[] pins, int pos, byte[] blob) throws Exception {\n        if (pos < 0 || pos + ROW > pins.length) return null;\n        ByteBuffer r = ByteBuffer.wrap(pins, pos, ROW).slice();\n        byte[] magic = new byte[4]; r.get(magic);\n        long off = r.getLong();\n        int len = r.getInt();\n        int crc = r.getInt();\n        byte[] id = new byte[16]; r.get(id);\n        byte[] reserved = new byte[12]; r.get(reserved);\n        if (!Arrays.equals(magic, MAGIC) || off < 0 || len < 0) return null;\n        for (byte v : reserved) if (v != 0) return null;\n        long rec = 4L + len;\n        long take = rec + ((ALIGN - rec % ALIGN) % ALIGN);\n        if (off > blob.length || take > blob.length - off || off > Integer.MAX_VALUE) return null;\n        ByteBuffer b = ByteBuffer.wrap(blob, (int)off, (int)take).slice();\n        if (b.getInt() != len) return null;\n        byte[] payload = new byte[len]; b.get(payload);\n        while (b.hasRemaining()) if (b.get() != 0) return null;\n        if (Crc.of(payload) != crc) return null;\n        byte[] digest = MessageDigest.getInstance(\"SHA-256\").digest(payload);\n        for (int i = 0; i < 16; i++) if (id[i] != digest[i]) return null;\n        return new Record(id, payload);\n    }\n\n    public static byte[] tint_k(Path silo, byte[] wanted) throws Exception {\n        if (wanted.length != 16) return new byte[0];\n        byte[] pins = Files.exists(silo.resolve(\"pin.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"pin.bin\")) : new byte[0];\n        byte[] blob = Files.exists(silo.resolve(\"blob.bin\"))\n                ? Files.readAllBytes(silo.resolve(\"blob.bin\")) : new byte[0];\n        for (int pos = 0; pos + ROW <= pins.length; pos += ROW) {\n            Record rec = read(pins, pos, blob);\n            if (rec != null && Arrays.equals(rec.id, wanted)) return rec.payload;\n        }\n        return new byte[0];\n    }\n}\nEOF\ncat > /app/markwell/HueWalk.java <<'EOF'\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.List;\n\npublic class HueWalk {\n    public static int orb_n(Path blobPath, Path pinPath, Path wakePath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean gap = pins.length % MistSpan.ROW != 0;\n        for (int pos = 0; pos + MistSpan.ROW <= pins.length; pos += MistSpan.ROW) {\n            MistSpan.Record rec = MistSpan.read(pins, pos, blob);\n            if (rec == null) gap = true;\n            else held.add(hex(rec.id));\n        }\n        String note = gap ? \"gap\" : \"ok\";\n        String kind = held.isEmpty() ? \"void\" : \"live\";\n        String json = \"{\\\"held\\\":\" + arr(held) + \",\\\"note\\\":\\\"\" + note\n                + \"\\\",\\\"kind\\\":\\\"\" + kind + \"\\\"}\";\n        Files.writeString(wakePath, json);\n        return gap ? 1 : 0;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder s = new StringBuilder();\n        for (byte v : id) s.append(String.format(\"%02x\", v & 255));\n        return s.toString();\n    }\n\n    static String arr(List<String> ids) {\n        StringBuilder s = new StringBuilder(\"[\");\n        for (int i = 0; i < ids.size(); i++) {\n            if (i != 0) s.append(',');\n            s.append('\"').append(ids.get(i)).append('\"');\n        }\n        return s.append(']').toString();\n    }\n}\nEOF\ncat > /app/hitchbay/YankRun.java <<'EOF'\nimport java.nio.file.Path;\n\npublic class YankRun {\n    public static "]
[70.955552, "i", "void main(String[] args) throws Exception {\n        if (args.length != 1 || !args[0].matches(\"[0-9a-f]{32}\")) System.exit(2);\n        byte[] id = new byte[16];\n        for (int i = 0; i < 16; i++)\n            id[i] = (byte)Integer.parseInt(args[0].substring(2*i, 2*i+2), 16);\n        byte[] got = MistSpan.tint_k(Path.of(\"/app/silo\"), id);\n        System.out.write(got);\n    }\n}\nEOF\n/app/bin/crumbark tamp\n"]
