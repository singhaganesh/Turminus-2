[?2004hroot@06bb3d035c24:/app# cat > /tmp/test-crumbark.sh <<'SH'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> set -u
[?2004l[?2004h> backup=$(mktemp -d)
[?2004l[?2004h> cp -a /app/silo/. "$backup/"
[?2004l[?2004h> restore() { rm -rf /app/silo; mkdir -p /app/silo; cp -a "$backup"/. /app/silo/; rm -rf "$backup"; }
[?2004l[?2004h> trap restore EXIT
[?2004l[?2004h> fail=0
[?2004l[?2004h> check() { if ! "$@"; then echo "FAIL: $*" >&2; fail=1; fi; }
[?2004l[?2004h> 
[?2004l[?2004h> # Supplied rows contain old tail-half IDs and must not be trusted.
[?2004l[?2004h> /app/bin/crumbark wake; rc=$?
[?2004l[?2004h> echo "legacy wake rc=$rc json=$(cat /app/silo/wake.json)"
[?2004l[?2004h> check test "$rc" -ne 0
[?2004l[?2004h> check grep -q '"held":\[\]' /app/silo/wake.json
[?2004l[?2004h> check grep -q '"note":"gap"' /app/silo/wake.json
[?2004l[?2004h> 
[?2004l[?2004h> # Clean exact round trip.
[?2004l[?2004h> rm -rf /app/silo; mkdir /app/silo
[?2004l[?2004h> /app/bin/crumbark lade /app/inbox/oak-a.slip || fail=1
[?2004l[?2004h> id=$(sha256sum /app/inbox/oak-a.slip | cut -c1-32)
[?2004l[?2004h> /app/bin/crumbark wake; rc=$?
[?2004l[?2004h> echo "clean wake rc=$rc id=$id json=$(cat /app/silo/wake.json)"
[?2004l[?2004h> check test "$rc" -eq 0
[?2004l[?2004h> check grep -q "$id" /app/silo/wake.json
[?2004l[?2004h> /app/bin/crumbark pull "$id" > /tmp/pulled.test
[?2004l[?2004h> check cmp -s /tmp/pulled.test /app/inbox/oak-a.slip
[?2004l[?2004h> check cmp -s /tmp/crumbark-pull.bin /app/inbox/oak-a.slip
[?2004l[?2004h> 
[?2004l[?2004h> # Power cut after first (blob) force must never expose an ID.
[?2004l[?2004h> rm -rf /app/silo; mkdir /app/silo
[?2004l[?2004h> /app/bin/crumbark nick /app/inbox/oak-e.slip; rc=$?
[?2004l[?2004h> echo "nick rc=$rc blob=$(stat -c%s /app/silo/blob.bin) pin=$(stat -c%s /app/silo/pin.bin)"
[?2004l[?2004h> check test "$rc" -eq 0
[?2004l[?2004h> check test "$(stat -c%s /app/silo/pin.bin)" -eq 0
[?2004l[?2004h> /app/bin/crumbark wake; rc=$?
[?2004l[?2004h> check test "$rc" -eq 0
[?2004l[?2004h> check grep -q '"held":\[\]' /app/silo/wake.json
[?2004l[?2004h> check grep -q '"kind":"void"' /app/silo/wake.json
[?2004l[?2004h> 
[?2004l[?2004h> # A truncated stored body is a reported gap and cannot be pulled.
[?2004l[?2004h> rm -rf /app/silo; mkdir /app/silo
[?2004l[?2004h> /app/bin/crumbark lade /app/inbox/oak-c.slip
[?2004l[?2004h> id=$(sha256sum /app/inbox/oak-c.slip | cut -c1-32)
[?2004l[?2004h> truncate -s 10 /app/silo/blob.bin
[?2004l[?2004h> /app/bin/crumbark wake; rc=$?
[?2004l[?2004h> echo "truncated wake rc=$rc json=$(cat /app/silo/wake.json)"
[?2004l[?2004h> check test "$rc" -ne 0
[?2004l[?2004h> check grep -q '"held":\[\]' /app/silo/wake.json
[?2004l[?2004h> check grep -q '"note":"gap"' /app/silo/wake.json
[?2004l[?2004h> /app/bin/crumbark pull "$id" > /tmp/pulled.test
[?2004l[?2004h> check test ! -s /tmp/pulled.test
[?2004l[?2004h> 
[?2004l[?2004h> # TORN names an ID-byte probe: mutate first ID byte (offset 20).
[?2004l[?2004h> rm -rf /app/silo; mkdir /app/silo
[?2004l[?2004h> /app/bin/crumbark lade /app/inbox/oak-b.slip
[?2004l[?2004h> printf '\xff' | dd of=/app/silo/pin.bin bs=1 seek=20 conv=notrunc status=none
[?2004l[?2004h> /app/bin/crumbark wake; rc=$?
[?2004l[?2004h> echo "torn-id wake rc=$rc json=$(cat /app/silo/wake.json)"
[?2004l[?2004h> check test "$rc" -ne 0
[?2004l[?2004h> check grep -q '"held":\[\]' /app/silo/wake.json
[?2004l[?2004h> check grep -q '"note":"gap"' /app/silo/wake.json
[?2004l[?2004h> 
[?2004l[?2004h> exit "$fail"
[?2004l[?2004h> SH
