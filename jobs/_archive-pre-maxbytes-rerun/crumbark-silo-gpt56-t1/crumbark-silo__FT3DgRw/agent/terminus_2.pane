[?2004l[?2004h>             return null;
[?2004l[?2004h>         long end = off + 4L + len;
[?2004l[?2004h>         if (end < off || end > blob.length) return null;
[?2004l[?2004h>         int at = (int) off;
[?2004l[?2004h>         if (ByteBuffer.wrap(blob, at, 4).getInt() != len) return null;
[?2004l[?2004h>         byte[] payload = Arrays.copyOfRange(blob, at + 4, at + 4 + len);
