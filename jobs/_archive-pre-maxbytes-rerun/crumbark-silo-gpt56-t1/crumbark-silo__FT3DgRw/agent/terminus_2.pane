[?2004l[?2004h>             byte[] payload = validPayload(blob, magic, off, len, crc, id);
[?2004l[?2004h>             if (payload != null) return payload;
[?2004l[?2004h>         }
[?2004l[?2004h>         return new byte[0];
[?2004l[?2004h>     }
[?2004l[?2004h> 
