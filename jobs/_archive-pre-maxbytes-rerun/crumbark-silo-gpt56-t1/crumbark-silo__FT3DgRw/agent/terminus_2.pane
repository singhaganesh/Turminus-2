[?2004l[?2004h> import java.nio.ByteBuffer;
[?2004l[?2004h> import java.nio.file.Files;
[?2004l[?2004h> import java.nio.file.Path;
[?2004l[?2004h> import java.util.ArrayList;
[?2004l[?2004h> import java.util.Arrays;
[?2004l[?2004h> import java.util.List;
[?2004l[?2004h> 
[?2004l[?2004h> public class HueWalk {
[?2004l[?2004h>     static final int ROW = 48;
[?2004l[?2004h> 
[?2004l[?2004h>     public static int orb_n(Path blobPath, Path pinPath, Path wakePath) throws Exception {
[?2004l[?2004h>         byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];
[?2004l[?2004h>         byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];
[?2004l[?2004h>         List<String> held = new ArrayList<String>();
[?2004l[?2004h>         boolean gap = pins.length % ROW != 0;
[?2004l[?2004h> 
[?2004l[?2004h>         for (int pos = 0; pos + ROW <= pins.length; pos += ROW) {
[?2004l[?2004h>             ByteBuffer row = ByteBuffer.wrap(pins, pos, ROW).slice();
[?2004l[?2004h>             byte[] magic = new byte[4]; row.get(magic);
[?2004l[?2004h>             long off = row.getLong();
[?2004l[?2004h>             int len = row.getInt();
[?2004l[?2004h>             int crc = row.getInt();
[?2004l[?2004h>             byte[] id = new byte[16]; row.get(id);
[?2004l[?2004h>             byte[] reserved = new byte[12]; row.get(reserved);
[?2004l[?2004h>             byte[] payload = MistSpan.validPayload(blob, magic, off, len, crc, id);
[?2004l[?2004h>             if (payload == null || !allZero(reserved)) {
[?2004l[?2004h>                 gap = true;
[?2004l[?2004h>             } else {
[?2004l[?2004h>                 held.add(hex(id));
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h> 
[?2004l[?2004h>         String note = gap ? "gap" : "ok";
[?2004l[?2004h>         String kind = held.isEmpty() ? "void" : "live";
[?2004l[?2004h>         String json = "{\"held\":" + arr(held) + ",\"note\":\"" + note
[?2004l[?2004h>                 + "\",\"kind\":\"" + kind + "\"}";
[?2004l[?2004h>         Files.writeString(wakePath, json);
[?2004l[?2004h>         return gap ? 1 : 0;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     static boolean allZero(byte[] a) {
[?2004l[?2004h>         for (byte b : a) if (b != 0) return false;
[?2004l[?2004h>         return true;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     static String hex(byte[] id) {
[?2004l[?2004h>         StringBuilder sb = new StringBuilder();
[?2004l[?2004h>         for (byte v : id) sb.append(String.format("%02x", v & 0xff));
[?2004l[?2004h>         return sb.toString();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     static String arr(List<String> held) {
[?2004l[?2004h>         StringBuilder sb = new StringBuilder("[");
[?2004l[?2004h>         for (int i = 0; i < held.size(); i++) {
[?2004l[?2004h>             if (i > 0) sb.append(',');
[?2004l[?2004h>             sb.append('\"').append(held.get(i)).append('\"');
[?2004l[?2004h>         }
[?2004l[?2004h>         return sb.append(']').toString();
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     public static void main(String[] args) throws Exception {
[?2004l[?2004h>         Path silo = Path.of("/app/silo");
[?2004l[?2004h>         System.exit(orb_n(silo.resolve("blob.bin"), silo.resolve("pin.bin"),
[?2004l[?2004h>                 silo.resolve("wake.json")));
[?2004l[?2004h>     }
[?2004l[?2004h> }
