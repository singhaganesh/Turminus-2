Sending keys: ['cat > /app/markwell/HueWalk.java <<\'EOF\'\nimport java.nio.ByteBuffer;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\npublic class HueWalk {\n    static final int ROW = 48;\n\n    public static int orb_n(Path blobPath, Path pinPath, Path wakePath) throws Exception {\n        byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];\n        byte[] blob = Files.exists(blobPath) ? Files.readAllBytes(blobPath) : new byte[0];\n        List<String> held = new ArrayList<String>();\n        boolean gap = pins.length % ROW != 0;\n\n        for (int pos = 0; pos + ROW <= pins.length; pos += ROW) {\n            ByteBuffer row = ByteBuffer.wrap(pins, pos, ROW).slice();\n            byte[] magic = new byte[4]; row.get(magic);\n            long off = row.getLong();\n            int len = row.getInt();\n            int crc = row.getInt();\n            byte[] id = new byte[16]; row.get(id);\n            byte[] reserved = new byte[12]; row.get(reserved);\n            byte[] payload = MistSpan.validPayload(blob, magic, off, len, crc, id);\n            if (payload == null || !allZero(reserved)) {\n                gap = true;\n            } else {\n                held.add(hex(id));\n            }\n        }\n\n        String note = gap ? "gap" : "ok";\n        String kind = held.isEmpty() ? "void" : "live";\n        String json = "{\\"held\\":" + arr(held) + ",\\"note\\":\\"" + note\n                + "\\",\\"kind\\":\\"" + kind + "\\"}";\n        Files.writeString(wakePath, json);\n        return gap ? 1 : 0;\n    }\n\n    static boolean allZero(byte[] a) {\n        for (byte b : a) if (b != 0) return false;\n        return true;\n    }\n\n    static String hex(byte[] id) {\n        StringBuilder sb = new StringBuilder();\n        for (byte v : id) sb.append(String.format("%02x", v & 0xff));\n        return sb.toString();\n    }\n\n    static String arr(List<String> held) {\n        StringBuilder sb = new StringBuilder("[");\n        for (int i = 0; i < held.size(); i++) {\n            if (i > 0) sb.append(\',\');\n            sb.append(\'\\"\').append(held.get(i)).append(\'\\"\');\n        }\n        return sb.append(\']\').toString();\n    }\n\n    public static void main(String[] args) throws Exception {\n        Path silo = Path.of("/app/silo");\n        System.exit(orb_n(silo.resolve("blob.bin"), silo.resolve("pin.bin"),\n                silo.resolve("wake.json")));\n    }\n}\nEOF\n/app/bin/crumbark tamp\ncat /app/recipit/ForceSeq.java\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
