[?2004l[?2004h> 
[?2004l[?2004h> public class HueWalk {
[?2004l[?2004h>     public static int orb_n(Path blobPath, Path pinPath, Path jsonPath) throws Exception {
[?2004l[?2004h>         byte[] pins = Files.exists(pinPath) ? Files.readAllBytes(pinPath) : new byte[0];
[?2004l[?2004h>         Path silo = pinPath.getParent();
[?2004l[?2004h>         List<String> held = new ArrayList<String>();
[?2004l[?2004h>         boolean gap = (pins.length % 48) != 0;
[?2004l[?2004h>         for (int pos=0; pos+48<=pins.length; pos+=48) {
[?2004l[?2004h>             ByteBuffer p = ByteBuffer.wrap(pins, pos, 48);
[?2004l[?2004h>             byte[] magic = new byte[4]; p.get(magic);
[?2004l[?2004h>             p.getLong(); p.getInt(); p.getInt();
[?2004l[?2004h>             byte[] id = new byte[16]; p.get(id);
[?2004l[?2004h>             byte[] body = MistSpan.tint_k(silo, id);
[?2004l[?2004h>             if (!MistSpan.magic(magic) || body == null) gap = true;
[?2004l[?2004h>             else held.add(hex(id));
[?2004l[?2004h>         }
[?2004l[?2004h>         String note = gap ? "gap" : "ok";
[?2004l[?2004h>         String kind = gap ? "void" : "live";
[?2004l[?2004h>         String json = "{\"held\":" + arr(held) + ",\"note\":\"" + note +
[?2004l[?2004h>                       "\",\"kind\":\"" + kind + "\"}";
[?2004l[?2004h>         Files.writeString(jsonPath, json);
[?2004l[?2004h>         return gap ? 1 : 0;
[?2004l[?2004h>     }
[?2004l[?2004h>     static String hex(byte[] id) {
[?2004l[?2004h>         StringBuilder s=new StringBuilder();
[?2004l[?2004h>         for(byte v:id) s.append(String.format("%02x",v&255));
[?2004l[?2004h>         return s.toString();
[?2004l[?2004h>     }
[?2004l[?2004h>     static String arr(List<String> a) {
[?2004l[?2004h>         StringBuilder s=new StringBuilder("[");
[?2004l[?2004h>         for(int i=0;i<a.size();i++){if(i>0)s.append(',');s.append('"').append(a.get(i)).append('"');}
[?2004l[?2004h>         return s.append(']').toString();
[?2004l[?2004h>     }
[?2004l[?2004h>     public static void main(String[] args) throws Exception {
[?2004l[?2004h>         Path s=Path.of("/app/silo");
[?2004l[?2004h>         System.exit(orb_n(s.resolve("blob.bin"),s.resolve("pin.bin"),s.resolve("wake.json")));
[?2004l[?2004h>     }
[?2004l[?2004h> }
