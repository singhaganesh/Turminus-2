[19.06726, "i", "printf '%s\\n' '--- INBOX IDS / BYTES ---'; for f in /app/inbox/*; do id=$(sha256sum \"$f\" | cut -c1-32); printf '%s  %s  ' \"$id\" \"$f\"; wc -c < \"$f\"; od -An -tx1 -v \"$f\"; done; printf '%s\\n' '--- SILO HEX ---'; for f in /app/silo/*; do echo \"--- $f ($(stat -c%s \"$f\")) ---\"; if [[ $f == *.json ]]; then cat \"$f\"; echo; else od -Ax -tx1z -v \"$f\"; fi; done\n"]
