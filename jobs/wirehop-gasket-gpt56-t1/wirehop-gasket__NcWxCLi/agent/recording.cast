[23.559835, "o", "echo '--- stoke.sh ---'; cat /app/stoke.sh; for f in $(find /app/gaskcli /app/loomkit /app/rimcap /app/hopmat /app/lidpit /app/slipread -maxdepth 3 -type f | sort); do echo \"--- $f ---\"; sed -n '1,240p' \"$f\"; done\r\n\u001b[?2004l\r"]
[23.560334, "o", "--- stoke.sh ---\r\n"]
[23.564236, "o", "#!/bin/sh\r\nset -eu\r\nexport PATH=\"/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}\"\r\nmkdir -p /app/bin\r\nrustc --edition 2021 -O /app/gaskcli/boot.rs -o /app/bin/gasketd\r\n"]
[23.572508, "o", "--- /app/gaskcli/boot.rs ---\r\n"]
[23.577831, "o", "#[path = \"../slipread/scan.rs\"]\r\nmod cards;\r\n#[path = \"../rimcap/span.rs\"]\r\nmod span;\r\n#[path = \"../hopmat/table.rs\"]\r\nmod table;\r\n#[path = \"../lidpit/plug.rs\"]\r\nmod vat;\r\n#[path = \"../loomkit/loom.rs\"]\r\nmod loom;\r\n#[path = \"../lidpit/tally.rs\"]\r\nmod tally;\r\n\r\nfn main() {\r\n    let mut args = std::env::args().skip(1);\r\n    let cmd = args.next().unwrap_or_default();\r\n    let code = match cmd.as_str() {\r\n        \"bind\" => loom::emit(),\r\n        \"jab\" => {\r\n"]
[23.57813, "o", "            let raw = args.next().unwrap_or_else(|| \"0\".to_string());\r\n            let n: u8 = raw.parse().unwrap_or(0);\r\n            table::tap(n)\r\n        }\r\n        \"cork\" => vat::rib_c(),\r\n        _ => {\r\n            eprintln!(\"usage: gasketd bind|jab N|cork\");\r\n            2\r\n        }\r\n    };\r\n    std::process::exit(code);\r\n}\r\n"]
[23.578874, "o", "--- /app/gaskcli/usage.txt ---\r\n"]
[23.583291, "o", "gasketd bind\r\n  refresh /app/mistwell/roster.json from /app/buscards\r\n\r\ngasketd jab N\r\n  print {\"wire\":N,\"reply\":S} for integer N\r\n\r\ngasketd cork\r\n  write /app/corkbay/seal.json\r\n"]
[23.584656, "o", "--- /app/hopmat/table.rs ---\r\n"]
[23.587433, "o", "use crate::span;\r\n\r\nconst RAW: &str = include_str!(\"../loomkit/emit.lst\");\r\n\r\n#[derive(Clone)]\r\npub struct Slot {\r\n    #[allow(dead_code)]\r\n    pub label: String,\r\n    pub reply: String,\r\n}\r\n\r\nimpl Default for Slot {\r\n    fn default() -> Self {\r\n        Self {\r\n            label: String::new(),\r\n            reply: \"fallthrough\".to_string(),\r\n        }\r\n    }\r\n}\r\n\r\nfn parse_line(line: &str) -> Option<(u8, Slot)> {\r\n    let mut parts = line.split('\\t');\r\n    let label = parts.next()?.trim().to_string();\r\n    let wire: u8 = parts.next()?.trim().parse().ok()?;\r\n    let reply = parts.next()?.trim().to_string();\r\n    if label.is_empty() {\r\n        return None;\r\n    }\r\n    Some((wire, Slot { label, reply }))\r\n}\r\n\r\npub fn rib_b() -> Vec<Slot> {\r\n    let cap = span::rib_a();\r\n    let mut slots: Vec<Slot> = vec![Slot::default(); 256];\r\n    for (i, line) in RAW.lines().enumerate() {\r\n        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        if let Some((_w, slot)) = parse_line(line) {\r\n            if i < cap {\r\n                slots[i] = slot;\r\n            }\r\n        }\r\n    }\r\n    slots\r\n}\r\n\r\npub fn tap(n: u8) -> i32 {\r\n    let slots = rib_b();\r\n    let row = &slots[n as usize];\r\n    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":\\\"{}\\\"}}\", n, row.reply);\r\n    0\r\n}\r\n"]
[23.587996, "o", "--- /app/lidpit/plug.rs ---\r\n"]
[23.590608, "o", "use crate::cards;\r\nuse crate::loom;\r\nuse crate::tally;\r\nuse std::fs;\r\n\r\npub fn rib_c() -> i32 {\r\n    let _ = tally::lines();\r\n    let _ = loom::emit();\r\n    let body = fs::read_to_string(\"/app/mistwell/roster.json\").unwrap_or_default();\r\n    let spec = cards::load();\r\n    let mut names: Vec<String> = Vec::new();\r\n    for row in &spec {\r\n        if body.contains(&row.label) {\r\n            names.push(row.label.clone());\r\n        }\r\n    }\r\n    if names.len() != spec.len() {\r\n        let _ = fs::create_dir_all(\"/app/corkbay\");\r\n"]
[23.590883, "o", "        let _ = fs::write(\r\n            \"/app/corkbay/seal.json\",\r\n            \"{\\\"served\\\":[],\\\"status\\\":\\\"open\\\"}\\n\",\r\n        );\r\n        return 1;\r\n    }\r\n    let served = names\r\n        .iter()\r\n        .map(|n| format!(\"\\\"{}\\\"\", n))\r\n        .collect::<Vec<_>>()\r\n        .join(\",\");\r\n    let _ = fs::create_dir_all(\"/app/corkbay\");\r\n    let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"sealed\\\"}}\\n\", served);\r\n    let _ = fs::write(\"/app/corkbay/seal.json\", text);\r\n    0\r\n}\r\n"]
[23.591368, "o", "--- /app/lidpit/tally.rs ---\r\n"]
[23.595501, "o", "use std::fs;\r\n\r\npub fn lines() -> usize {\r\n    fs::read_to_string(\"/app/loomkit/emit.lst\")\r\n        .unwrap_or_default()\r\n        .lines()\r\n        .filter(|l| !l.trim().is_empty())\r\n        .count()\r\n}\r\n"]
[23.596591, "o", "--- /app/loomkit/emit.lst ---\r\n"]
[23.602008, "o", "SET_FAN\t1\tfan-ok\r\nSET_PUMP\t2\tpump-ok\r\nSET_VALVE\t4\tvalve-ok\r\nREAD_TEMP\t7\ttemp-ok\r\nREAD_PRESS\t8\tpress-ok\r\nHOLD_LATCH\t10\tlatch-ok\r\nTRIM_BIAS\t12\tbias-ok\r\nACK_WATCH\t15\twatch-ok\r\nVENT_LINE\t17\tvent-ok\r\n"]
[23.602584, "o", "--- /app/loomkit/loom.rs ---\r\n"]
[23.606741, "o", "use crate::cards;\r\nuse std::fs;\r\n\r\npub fn emit() -> i32 {\r\n    let rows = cards::load();\r\n    let _ = fs::create_dir_all(\"/app/mistwell\");\r\n    let _ = fs::create_dir_all(\"/app/loomkit\");\r\n    let names: Vec<String> = rows.iter().map(|r| format!(\"\\\"{}\\\"\", r.label)).collect();\r\n    let body = format!(\"{{\\\"names\\\":[{}]}}\\n\", names.join(\",\"));\r\n    let _ = fs::write(\"/app/mistwell/roster.json\", body);\r\n    let lst = rows\r\n        .iter()\r\n        .map(|r| format!(\"{}\\t{}\\t{}\", r.label, r.wire, r.reply))\r\n        .collect::<Vec<_>>()\r\n        .join(\"\\n\")\r\n        + \"\\n\";\r\n    let _ = fs::write(\"/app/loomkit/emit.lst\", lst);\r\n    0\r\n}\r\n"]
[23.607368, "o", "--- /app/rimcap/span.rs ---\r\n"]
[23.61033, "o", "pub fn rib_a() -> usize {\r\n    8\r\n}\r\n"]
[23.61124, "o", "--- /app/slipread/scan.rs ---\r\n"]
[23.616329, "o", "use std::fs;\r\nuse std::path::Path;\r\n\r\n#[derive(Clone)]\r\npub struct Row {\r\n    pub label: String,\r\n    #[allow(dead_code)]\r\n    pub wire: u8,\r\n    pub reply: String,\r\n}\r\n\r\nimpl Default for Row {\r\n    fn default() -> Self {\r\n        Self {\r\n            label: String::new(),\r\n            wire: 0,\r\n            reply: \"fallthrough\".to_string(),\r\n        }\r\n    }\r\n}\r\n\r\npub fn load() -> Vec<Row> {\r\n"]
[23.616477, "o", "    let dir = Path::new(\"/app/buscards\");\r\n    let mut names: Vec<_> = fs::read_dir(dir)\r\n        .map(|rd| {\r\n            rd.filter_map(|e| e.ok())\r\n                .map(|e| e.path())\r\n                .filter(|p| p.extension().map(|x| x == \"card\").unwrap_or(false))\r\n                .collect()\r\n        })\r\n        .unwrap_or_default();\r\n    names.sort();\r\n    let mut out = Vec::new();\r\n    for p in names {\r\n        let text = fs::read_to_string(&p).unwrap_or_default();\r\n        let mut label = String::new();\r\n        let mut wire: u8 = 0;\r\n        let mut reply = String::new();\r\n        for line in text.lines() {\r\n            let line = line.trim();\r\n            if let Some(rest) = line.strip_prefix(\"LABEL \") {\r\n                label = rest.trim().to_string();\r\n            } else if let Some(rest) = line.strip_prefix(\"WIRE \") {\r\n                wire = rest.trim().parse().unwrap_or(0);\r\n            } else if let Some(rest) = line.strip_prefix(\"REPLY \") {\r\n                reply = rest.trim().to_string();\r\n            }\r\n        }\r\n        if !label.is_empty() {\r\n            out.push(Row {\r\n                label,\r\n                wire,\r\n                reply,\r\n            });\r\n        }\r\n    }\r\n"]
[23.616541, "o", "    out\r\n}\r\n"]
[23.618404, "o", "\u001b[?2004hroot@5aca7ea10b2c:/app# "]
[24.457225, "i", "echo '--- ELF magic ---'; od -An -tx1 -N4 /app/bin/gasketd; echo '--- jab matrix ---'; for w in 1 2 4 7 8 10 12 15 17 999; do printf 'wire %s: ' \"$w\"; /app/bin/gasketd jab \"$w\"; printf ' rc=%s\\n' \"$?\"; done\n"]
[24.45797, "o", "echo '--- ELF magic ---'; od -An -tx1 -N4 /app/bin/gasketd; echo '--- jab matrix ---'; for w in 1 2 4 7 8 10 12 15 17 999; do printf 'wire %s: ' \"$w\"; /app/bin/gasketd jab \"$w\"; printf ' rc=%s\\n' \"$?\"; done\r\n\u001b[?2004l\r"]
[24.458139, "o", "--- ELF magic ---\r\n"]
[24.460644, "o", " 7f 45 4c 46\r\n"]
[24.461159, "o", "--- jab matrix ---\r\n"]
[24.461534, "o", "wire 1: "]
[24.463915, "o", "{\"wire\":1,\"reply\":\"pump-ok\"}\r\n"]
[24.464207, "o", " rc=0\r\nwire 2: "]
[24.465708, "o", "{\"wire\":2,\"reply\":\"valve-ok\"}\r\n"]
[24.466125, "o", " rc=0\r\nwire 4: "]
[24.467716, "o", "{\"wire\":4,\"reply\":\"press-ok\"}\r\n"]
[24.468494, "o", " rc=0\r\nwire 7: "]
[24.470605, "o", "{\"wire\":7,\"reply\":\"watch-ok\"}\r\n"]
[24.470853, "o", " rc=0\r\nwire 8: "]
[24.472033, "o", "{\"wire\":8,\"reply\":\"fallthrough\"}\r\n rc=0\r\nwire 10: "]
[24.473152, "o", "{\"wire\":10,\"reply\":\"fallthrough\"}\r\n"]
[24.473376, "o", " rc=0\r\nwire 12: "]
[24.474823, "o", "{\"wire\":12,\"reply\":\"fallthrough\"}\r\n"]
[24.475141, "o", " rc=0\r\nwire 15: "]
[24.4776, "o", "{\"wire\":15,\"reply\":\"fallthrough\"}\r\n"]
