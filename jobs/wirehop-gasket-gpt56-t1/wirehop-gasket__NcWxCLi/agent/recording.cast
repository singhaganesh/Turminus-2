[63.351199, "i", "echo '--- failure-path test with conflicting runtime card ---'; cat > /app/buscards/z_conflict.card <<'EOF'\nLABEL CONFLICT_TEST\nWIRE 1\nREPLY conflict-ok\nEOF\n/app/bin/gasketd bind\n/app/bin/gasketd jab 1\n/app/bin/gasketd cork; rc=$?\necho \"cork_rc=$rc\"\ncat /app/corkbay/seal.json\ntest \"$rc\" -ne 0\ngrep -q '\"status\":\"open\"' /app/corkbay/seal.json\nrm /app/buscards/z_conflict.card\n/app/bin/gasketd bind\n/app/bin/gasketd cork\ncat /app/corkbay/seal.json\n"]
