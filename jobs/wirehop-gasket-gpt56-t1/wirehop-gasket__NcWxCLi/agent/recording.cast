[61.396735, "i", "set -e\necho '--- bind ---'\n/app/bin/gasketd bind\ncat /app/mistwell/roster.json\necho '--- all card jabs ---'\nfor f in /app/buscards/*.card; do w=$(awk '$1==\"WIRE\"{print $2}' \"$f\"); r=$(awk '$1==\"REPLY\"{$1=\"\"; sub(/^ /,\"\"); print}' \"$f\"); out=$(/app/bin/gasketd jab \"$w\"); echo \"$w -> $out\"; echo \"$out\" | grep -Fq \"\\\"reply\\\":\\\"$r\\\"\"; done\necho '--- unknown ---'\ntest \"$(/app/bin/gasketd jab 999)\" = '{\"wire\":999,\"reply\":\"fallthrough\"}'\n/app/bin/gasketd jab 999\necho '--- cork ---'\n/app/bin/gasketd cork\ncat /app/corkbay/seal.json\necho '--- ELF ---'\ntest \"$(od -An -tx1 -N4 /app/bin/gasketd | tr -d ' \\n')\" = 7f454c46\nod -An -tx1 -N4 /app/bin/gasketd\n"]
