[24.483347, "o", "\u001b[?2004hroot@5aca7ea10b2c:/app# "]
[58.592331, "i", "cat > /app/hopmat/table.rs <<'EOF'\nuse crate::cards;\n\npub fn reply_for(n: i64) -> Option<String> {\n    cards::load()\n        .into_iter()\n        .find(|row| row.wire == n)\n        .map(|row| row.reply)\n}\n\npub fn serves(wire: i64, expected: &str) -> bool {\n    reply_for(wire).as_deref() == Some(expected)\n}\n\nfn json_string(value: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for ch in value.chars() {\n        match ch {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c.is_control() => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\npub fn tap(n: i64) -> i32 {\n    let reply = reply_for(n).unwrap_or_else(|| \"fallthrough\".to_string());\n    println!(\"{{\\\"wire\\\":{},\\\"reply\\\":{}}}\", n, json_string(&reply));\n    0\n}\nEOF\npython3 - <<'PY'\np='/app/slipread/scan.rs'\ns=open(p).read().replace('pub wire: u8,', 'pub wire: i64,').replace('let mut wire: u8 = 0;', 'let mut wire: i64 = 0;')\nopen(p,'w').write(s)\np='/app/gaskcli/boot.rs'\ns=open(p).read().replace('let n: u8 = raw.parse().unwrap_or(0);', 'let n: i64 = raw.parse().unwrap_or(0);')\nopen(p,'w').write(s)\nPY\ncat > /app/lidpit/plug.rs <<'EOF'\nuse crate::cards;\nuse crate::loom;\nuse crate::table;\nuse crate::tally;\nuse std::fs;\n\nfn json_string(value: &str) -> String {\n    let mut out = String::from(\"\\\"\");\n    for ch in value.chars() {\n        match ch {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if c.is_control() => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}\n\npub fn rib_c() -> i32 {\n    let _ = tally::lines();\n    let bind_code = loom::emit();\n    let spec = cards::load();\n    let served: Vec<String> = spec\n        .iter()\n        .filter(|row| table::serves(row.wire, &row.reply))\n        .map(|row| row.label.clone())\n        .collect();\n    let sealed = bind_code == 0 && served.len() == spec.len();\n    let names = served\n        .iter()\n        .map(|name| json_string(name))\n        .collect::<Vec<_>>()\n        .join(\",\");\n    let status = if sealed { \"sealed\" } else { \"open\" };\n    let text = format!(\"{{\\\"served\\\":[{}],\\\"status\\\":\\\"{}\\\"}}\\n\", names, status);\n    let _ = fs::create_dir_all(\"/app/corkbay\");\n    if fs::write(\"/app/corkbay/seal.json\", text).is_err() {\n        return 1;\n    }\n    if sealed { 0 } else { 1 }\n}\nEOF\n/app/stoke.sh\n"]
