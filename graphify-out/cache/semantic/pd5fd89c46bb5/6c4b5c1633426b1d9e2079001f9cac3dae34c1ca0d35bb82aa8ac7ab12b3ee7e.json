{"nodes": [{"id": "cni_md", "label": "CNI.md (Currently Not Implementing)", "file_type": "document", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cni_promotion_demotion_policy", "label": "CNI promotion/demotion policy", "file_type": "rationale", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents the backlog and always-on rule files from growing forever (the encyclopedia failure mode v2.1 was designed to prevent) by requiring repeated evidence before promotion and periodic demotion review."}, {"id": "codebase_fix_surface_ratio_cni", "label": "Codebase-to-fix-surface ratio floor (CNI)", "file_type": "rationale", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On hold because 'non-boilerplate' LOC is hard to measure mechanically (e.g. driver.py orchestration counted as real code) and the proposed 5:1 ratio is an unvalidated guess from a single enum-packing-split postmortem."}, {"id": "enum_packing_split_postmortem", "label": "enum-packing-split postmortem (Apr 2026)", "file_type": "concept", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mandatory_rename_pass_cni", "label": "Mandatory post-draft rename pass on oracle frontier (CNI)", "file_type": "rationale", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On hold due to per-language rename tooling coverage gaps (Python via libCST tractable, C/C++/Rust fragile), because CR1 manifest enforcement may already be a cheaper fix, and because an unverified rename pass risks silently breaking oracle semantics."}, {"id": "cr1_manifest_symbol_check", "label": "CR1 construction manifest symbol check", "file_type": "concept", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hard_task_pattern_library_cni", "label": "Platform-agnostic hard-task pattern library (CNI)", "file_type": "rationale", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On hold because a pattern library risks becoming a template library that kills task-shape diversity (RC6 spec-complete failure), because model-family-specific hardness patterns decay across model releases, and because existing hardness axes already cover the same concept."}, {"id": "idea_validation_mdc", "label": "idea-validation.mdc", "file_type": "document", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "instruction_diversity_lint_cni", "label": "Instruction-diversity repo-wide lint (CNI)", "file_type": "rationale", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On hold because diversity is hard to measure mechanically without either a non-deterministic LLM call or a brittle, gameable hand-crafted feature set; partially covered by run_static_checks.py --only instruction_test_vocabulary instead."}, {"id": "external_eval_calibration_cni", "label": "External evaluation calibration heuristics (CNI)", "file_type": "rationale", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On hold because tuning tasks to widen Claude-vs-GPT gaps is adversarial calibration against a moving target and creates a perverse incentive to optimize for model asymmetry rather than genuine difficulty; existing hardness axes are the durable answer."}, {"id": "static_oracle_tests_parity_check_cni", "label": "Static oracle-tests parity check (CNI)", "file_type": "rationale", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On hold because scripts/verifier_health.py's repeat_oracle check and the Step 2b 10x oracle preflight already catch tests that fail under the oracle empirically; a static check would duplicate that and could false-positive on legitimate inversion tests."}, {"id": "rollback_replay_divergence_task", "label": "rollback-replay-divergence task", "file_type": "concept", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "verifier_health_py", "label": "scripts/verifier_health.py", "file_type": "code", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "metrics_collector_followups_cni", "label": "metrics_collector follow-ups (tracked item)", "file_type": "concept", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fixture_mirror_gap_promoted", "label": "Fixture-mirror gap promoted to packager skill", "file_type": "concept", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "step2a_strict_lint_gate_fix", "label": "Step 2a strict lint gate on perfect-1 GO fix", "file_type": "concept", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "validate_loop_py", "label": "scripts/validate_loop.py", "file_type": "code", "source_file": "CNI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lint_spec_py", "label": "scripts/lint_spec.py", "file_type": "code", "sou