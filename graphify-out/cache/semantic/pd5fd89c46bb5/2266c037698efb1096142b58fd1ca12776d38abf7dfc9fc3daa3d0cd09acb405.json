{"nodes": [{"id": "repo_conventions_md", "label": "REPO_CONVENTIONS.md", "file_type": "document", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "output_contract_toml_convention", "label": "output_contract.toml required-file convention", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required by task-creation.mdc as the source of truth for what the instruction must document vs what stays internal to the harness; observation-rich contracts (runs/entries/refreshes) are preferred over boolean answer-key fields so tests derive verdicts rather than reading pre-named truth bits."}, {"id": "test_sh_no_set_e_convention", "label": "tests/test.sh omits set -euo pipefail convention", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "set -e would kill the script before the reward-footer block runs on a non-zero pytest exit, leaving no reward.txt and scoring the task as an error instead of a legitimate 0; Harbor reads reward.txt, not shell exit status."}, {"id": "test_sh_no_trailing_exit_convention", "label": "test.sh no trailing exit after reward block convention", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Harbor reads /logs/verifier/reward.txt for scoring, not the shell exit code, so check_test_sh textually validates a 5-line footer ending at fi; a trailing exit is discouraged."}, {"id": "dockerfile_digest_pin_convention", "label": "FROM digest pin requirement (@sha256)", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platform CI (May 2026) blocks tag-only FROM images; digest pins make builds reproducible and auditable."}, {"id": "instruction_prose_variation_convention", "label": "Instruction prose density/style variation convention", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Variation in voice/length/structure across tasks is an anti-collapse goal; if every task uses the same Task/Output-schema/Constraints template, agents learn to pattern-match the shape and skip the harder reasoning."}, {"id": "steps_field_type_check_convention", "label": "steps/counter fields type-checked not value-checked", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "instruction_test_vocabulary warns when tests assert exact values on instruction-named fields not documented in instruction.md; type-check-only is deliberately the narrower, fair contract, leaving golden SHA-256 digests as the real regression signal."}, {"id": "verifier_timeout_cap_convention", "label": "Verifier timeout generous-but-capped-at-1800s rule", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upstream harbor CI hard-rejects verifier.timeout_sec > 1800 regardless of reviewer requests; if a verifier genuinely needs more time, the task is doing too much verifier-side work and should cache builds, parallelize with pytest-xdist, split, or reduce the test matrix instead."}, {"id": "harbor_tasks_check_adjudication_convention", "label": "harbor tasks check false-positive adjudication convention", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The LLM rubric quality checker regularly produces convention-conflict, unsupported, or quality-vs-difficulty-collapse false fails; scripts/quality_check_adjudicate.py classifies each with evidence rather than literal-repairing until it passes, which would regress mechanical checks or RC6/difficulty."}, {"id": "quality_check_adjudicate_py", "label": "scripts/quality_check_adjudicate.py", "file_type": "code", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "milestone_word_warning_convention", "label": "Literal word 'milestone' in instruction.md non-blocking warning", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps milestone-related staging vocabulary out of the agent-facing prompt so the agent sees a natural user request rather than harness internals; mirrors the upstream instruction-eval severity (WARN, never FAIL)."}, {"id": "ai_scaffolding_filenames_ban", "label": "AI-scaffolding filenames banned anywhere in archive", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filenames like CLAUDE.md, AGENTS.md, skills.md, .cursor/ are a signal of AI-generated content/scaffolding leaking into the task rather than realistic environment context, so validate_submission_zip.py bans them case-insensitively at any archive depth."}, {"id": "environment_hidden_instructions_rule", "label": "environment/ files cannot give the agent the how rule", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step-by-step walkthroughs, explicit hints, and prescriptive TODOs aimed at the solver defeat the purpose of testing multi-step reasoning; solver-direction phrases fail everywhere in environment/, prescriptive prose markers fail only in prose files to avoid banning legitimate code TODO/FIXME/HINT comments."}, {"id": "milestone_layout_convention", "label": "Milestone tasks live under steps/milestone_N convention", "file_type": "rationale", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The canonical layout is the source of truth even when the wider Harbor framework offers additional features that are deliberately not adopted; the old root-level shape is treated as a rejection."}, {"id": "task_types_no_longer_accepted", "label": "Task types no longer accepted (multi-container, UI building)", "file_type": "concept", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "license_policy", "label": "LICENSE file policy (minimal omit, large MIT/Apache/BSD)", "file_type": "concept", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "step2b_checksum_sentinel", "label": ".step2b-checksum local generated sentinel", "file_type": "concept", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "step2b_metrics_jsonl", "label": ".step2b-metrics.jsonl authoring metrics file", "file_type": "concept", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "approve_task_py", "label": "scripts/approve_task.py", "file_type": "code", "source_file": "REPO_CONVENTIONS.md", "source_location": null, "sou