{"nodes": [{"id": "hard_but_fair_authoring_full_doc", "label": "docs/HARD_BUT_FAIR_AUTHORING.md (full policy)", "file_type": "document", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "central_law", "label": "Central Law (instruction reveals requirements, hides patch)", "file_type": "rationale", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard-but-fair means the solver can tell what success looks like from the public task report but still has to investigate the codebase/state/protocols to discover the solution path; this is the overlap between the actionability bound and the leakiness bound."}, {"id": "bounds_model", "label": "Bounds Model (actionability bound vs leakiness bound)", "file_type": "concept", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "post_disclosure_collapse_concept", "label": "Post-Disclosure Collapse test", "file_type": "concept", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "no_hidden_contracts_rule", "label": "No-Hidden-Contracts Rule", "file_type": "rationale", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests are verification, not solver-facing requirements; every externally tested requirement needs a solver-visible home in instruction.md, environment docs, or source docstrings/help, otherwise actionability cannot rely on hidden tests."}, {"id": "output_contract_rule", "label": "Output-Contract Rule (evidence-rich, non-boolean outputs)", "file_type": "rationale", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Boolean verdict fields like is_correct/passed/valid teach the answer key rather than the behavior; observations/traces/measurements let tests derive verdicts and a reviewer inspect why a result is correct."}, {"id": "early_stop_rule", "label": "Early-Stop Rule (2 consecutive / 4 total collapse FAILs)", "file_type": "rationale", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated collapse failures are design evidence, not an invitation to keep tuning the checker boundary; forces a redesign report instead of endless nudging of nouns/thresholds/filenames until the checker goes quiet."}, {"id": "waiver_model_concept", "label": "Waiver Model (exceptional, high-friction)", "file_type": "concept", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sourcing_policy", "label": "Sourcing Policy (real-bug default, synthetic exceptions)", "file_type": "concept", "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "hard_but_fair_authoring_full_doc", "target": "central_law", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "weight": 1.0}, {"source": "hard_but_fair_authoring_full_doc", "target": "bounds_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HARD_BUT_FAIR_AUTHORING.md", "source_location": null, "weight": 1.0}, {"source": "hard_but_fair_authoring_full_doc", "target": "post_disclosure_collapse_conc